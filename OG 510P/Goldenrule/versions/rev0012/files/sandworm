        def _read_holder() -> dict[str, object] | None:
            try:
                txt = lock_path.read_text(encoding="utf-8", errors="replace").strip()
                if not txt:
                    return None
                obj = json.loads(txt)
                return obj if isinstance(obj, dict) else None
            except Exception:
                return None

        def _pid_probe(pid: int) -> tuple[bool | None, str]:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return False, "missing"
            except PermissionError:
                # Visible lock holder may live in another namespace/user scope.
                return None, "permission_denied"
            except Exception:
                return None, "unknown"
            return True, "alive"

        def _proc_starttime(pid: int) -> str | None:
            try:
                stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
            except Exception:
                return None
            # Format: pid (comm) state ... starttime ...
            # Strip up to ") " so starttime becomes field 20 of the remaining tokens.
            try:
                tail = stat.split(") ", 1)[1]
                parts = tail.split()
                return parts[19] if len(parts) > 19 else None
            except Exception:
                return None

        def _is_held() -> bool:
            if not lock_path.exists():
                return False
            fd = lock_path.open("a+", encoding="utf-8")
            try:
                fcntl.flock(fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fd.fileno(), fcntl.LOCK_UN)
                return False
            except BlockingIOError:
                return True
            finally:
                fd.close()

        holder = _read_holder() or {}
        pid_raw = holder.get("pid") if isinstance(holder, dict) else None
        pid = int(pid_raw) if isinstance(pid_raw, int) else None
        alive, pid_probe = _pid_probe(pid) if isinstance(pid, int) else (None, "absent")
        pst = _proc_starttime(pid) if isinstance(pid, int) else None
        pst_rec = holder.get("proc_starttime") if isinstance(holder, dict) else None
        pst_match = (pst_rec == pst) if (isinstance(pst_rec, str) and isinstance(pst, str)) else None
        held = _is_held()
        holder_state = "unheld"
        if held:
            if pid_probe == "alive":
                holder_state = "active_pid"
            elif pid_probe == "missing":
                holder_state = "held_with_missing_pid"
            elif pid_probe == "permission_denied":
                holder_state = "held_with_inaccessible_pid"
            elif pid_probe == "unknown":
                holder_state = "held_with_unknown_pid"
            else:
                holder_state = "held_without_pid"

