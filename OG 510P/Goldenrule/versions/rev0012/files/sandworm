def _truthy_env(name: str) -> bool:
    v = os.environ.get(name)
    if v is None:
        return False
    return v.strip().lower() in ("1", "true", "yes", "y", "on")


def _provider_tty_mode() -> str:
    raw = os.environ.get("SW_PROVIDER_TTY") or os.environ.get("SANDWORM_PROVIDER_TTY") or ""
    v = str(raw).strip().lower()
    if v in ("force", "on", "1", "true", "yes", "y"):
        return "force"
    if v in ("off", "0", "false", "no", "n", "disable", "disabled"):
        return "off"
    return "auto"


def _stdio_has_tty() -> bool:
    try:
        return bool(sys.stdin.isatty() and sys.stdout.isatty())
    except Exception:
        return False


def _provider_interactive_argv(name: str, argv: list[str]) -> bool:
    if not argv:
        return True
    toks = [str(a or "").strip().lower() for a in argv if str(a or "").strip()]
    # Parser pass-through often keeps a leading `--`; ignore it for command detection.
    while toks and toks[0] == "--":
        toks.pop(0)
    if not toks:
        return True
    # Detect known interactive provider subcommands even when flags precede them.
    if any(t in ("resume", "fork") for t in toks):
        return True
    if name in ("codex", "claude", "gemini") and any(t in ("chat", "repl", "tui") for t in toks):
        return True
    return False


def _provider_force_tty(name: str, argv: list[str]) -> bool:
    mode = _provider_tty_mode()
    if mode == "force":
        return True
    if mode == "off":
        return False
    if not _provider_interactive_argv(name, argv):
        return False
    return not _stdio_has_tty()


