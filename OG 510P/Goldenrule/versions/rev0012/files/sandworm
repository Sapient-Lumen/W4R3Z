def _socket_create_probe() -> tuple[bool, int | None, str | None]:
    """    Best-effort: distinguish "network is misconfigured" from "this environment forbids sockets".

    Some constrained environments (CI / LLM sandboxes) apply seccomp profiles that deny `socket()`
    with EPERM/EACCES. In that case, no amount of DNS config will fix networking inside that
    environment, and Sandworm should be able to say so explicitly.
    """
    forced = (os.environ.get("SW_FORCE_SOCKET_CREATE_PROBE") or os.environ.get("SANDWORM_FORCE_SOCKET_CREATE_PROBE") or "").strip().lower()
    if forced:
        if forced in ("1", "true", "yes", "on", "ok", "allow"):
            return True, None, None
        if forced in ("denied", "deny", "eperm", "forbidden", "blocked"):
            return False, 1, "forced socket probe denial (EPERM)"
        if forced in ("eacces", "access-denied"):
            return False, 13, "forced socket probe denial (EACCES)"
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.close()
        return True, None, None
    except OSError as e:
        return False, getattr(e, 'errno', None), (str(e) or None)
    except Exception as e:
        return False, None, repr(e)


