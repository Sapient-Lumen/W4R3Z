        errors.append(f"{where} must be one of never|always|resume|resume-last")


def _validate_network(errors: list[str], value: Any, where: str) -> None:
    if not isinstance(value, str) or not value.strip():
        errors.append(f"{where} must be {NETWORK_CONTRACT}")
        return
    net = value.strip()
    if net in ALLOWED_NETWORKS:
        return
    if net.startswith("pasta:") and len(net) > len("pasta:"):
        return
    if CUSTOM_NETWORK_NAME_RE.match(net):
        return
    errors.append(f"{where} must be {NETWORK_CONTRACT}")


def _validate_env_allowlist(errors: list[str], value: Any, where: str) -> None:
    if not isinstance(value, list):
        errors.append(f"{where} must be a list")
        return
    if not all(isinstance(x, str) and x.strip() for x in value):
        errors.append(f"{where} entries must be non-empty strings")


def _validate_str_or_null(errors: list[str], value: Any, where: str) -> None:
    if value is None:
        return
    if not isinstance(value, str) or not value.strip():
        errors.append(f"{where} must be a non-empty string when set")


def _validate_backend_posture(errors: list[str], *, step_id: str, backend: str, posture: str) -> None:
    if backend not in ("podman", "bwrap", "kvm"):
        errors.append(f"step {step_id}: invalid backend={backend!r} (expected podman|bwrap|kvm)")
    if posture == "bare-metal":
        errors.append(
            f"step {step_id}: posture=bare-metal is only supported for provider entrypoints "
            "(use dev/unsafe/take-the-wheel for sandboxes or where: host actions)"
        )
    elif posture not in ("safe", "dev", "unsafe", "take-the-wheel"):
        errors.append(f"step {step_id}: invalid posture={posture!r} (expected safe|dev|unsafe|take-the-wheel)")
    if backend == "kvm" and posture != "safe":
        errors.append(f"step {step_id}: backend=kvm only supports posture=safe")


def _uses_legacy_in_sandbox_reentry(argv: list[str]) -> bool:
    # Legacy patterns remain functional in some environments but are not the supported
    # queue/recipe contract for in-sandbox Sandworm re-entry.
    try:
        joined = " ".join([str(x) for x in argv]).lower()
    except Exception:
        joined = ""
    if "sandworm_python" in joined:
        return True
    if "python -m sandworm_core" in joined:
        return True
    if len(argv) >= 3:
        p0 = str(argv[0]).strip().lower()
        p1 = str(argv[1]).strip()
        p2 = str(argv[2]).strip().lower()
        if p1 == "-m" and p2 == "sandworm_core":
            base = p0.rsplit("/", 1)[-1]
            if base.startswith("python"):
                return True
    return False


def _legacy_reentry_message(where: str, *, allow_legacy_in_sandbox_reentry: bool) -> str:
    base = (
        f"{where} uses legacy in-sandbox Sandworm re-entry "
        f"(SANDWORM_PYTHON/python -m sandworm_core); use $SANDWORM_BIN instead"
    )
    if allow_legacy_in_sandbox_reentry:
        return f"{base} (allowed by --allow-legacy-in-sandbox-reentry)"
    return f"{base} (blocked; pass --allow-legacy-in-sandbox-reentry to override)"


