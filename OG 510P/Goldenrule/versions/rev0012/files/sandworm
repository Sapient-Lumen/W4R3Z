    # Podman builds still hardcode it (and may not honor XDG_CONFIG_HOME).
    home_containers_dir = home / ".config" / "containers"
    home_containers_dir.mkdir(parents=True, exist_ok=True)
    home_policy = home_containers_dir / "policy.json"
    home_registries = home_containers_dir / "registries.conf"

    # Also write into XDG for builds that honor it.
    xdg_containers_dir = xdg / "containers"
    xdg_containers_dir.mkdir(parents=True, exist_ok=True)
    xdg_policy = xdg_containers_dir / "policy.json"
    xdg_registries = xdg_containers_dir / "registries.conf"

    try:
        if not home_policy.exists():
            home_policy.write_text(_DEFAULT_CONTAINERS_POLICY_JSON, encoding="utf-8")
            if _progress_enabled():
                print(f"[sandworm] wrote project-local containers policy: {home_policy}", file=sys.stderr)
    except Exception:
        pass
    try:
        if not home_registries.exists():
            home_registries.write_text(_DEFAULT_CONTAINERS_REGISTRIES_CONF, encoding="utf-8")
            if _progress_enabled():
                print(f"[sandworm] wrote project-local containers registries: {home_registries}", file=sys.stderr)
    except Exception:
        pass

    try:
        if not xdg_policy.exists():
            xdg_policy.write_text(_DEFAULT_CONTAINERS_POLICY_JSON, encoding="utf-8")
    except Exception:
        pass
    try:
        if not xdg_registries.exists():
            xdg_registries.write_text(_DEFAULT_CONTAINERS_REGISTRIES_CONF, encoding="utf-8")
    except Exception:
        pass

    # Return the HOME-based paths since they're the most widely supported.
    return home_policy, home_registries


def _podman_bin() -> str | None:
    override = os.environ.get("SW_PODMAN_BIN") or os.environ.get("SANDWORM_PODMAN_BIN")
    if isinstance(override, str) and override.strip():
        cand = override.strip()
        try:
            if os.path.exists(cand) and os.access(cand, os.X_OK):
                return cand
        except Exception:
            return None
    found = shutil.which("podman")
    if found:
        return found
    # Some runtimes (notably nix-portable) can run commands under a reduced PATH.
    # Fall back to common system locations to avoid false negatives.
    candidates = [
        "/run/current-system/sw/bin/podman",  # NixOS
        "/run/wrappers/bin/podman",  # NixOS wrappers
        "/nix/var/nix/profiles/default/bin/podman",  # Nix default profile
        "/usr/local/bin/podman",
        "/usr/local/sbin/podman",
        "/usr/bin/podman",
        "/usr/sbin/podman",
        "/bin/podman",
        "/sbin/podman",
    ]
    for cand in candidates:
        try:
            if os.path.exists(cand) and os.access(cand, os.X_OK):
                return cand
        except Exception:
            continue
    return None

def _ensure_apt_cache_dirs(root: Path) -> tuple[Path, Path]:
    """
    Create (if needed) the project-local apt cache directories used for podman runs.

    These paths live under the control plane (which is masked inside the sandbox) but are
    mounted directly into the container as /var/lib/apt/lists and /var/cache/apt/archives
    to speed up repeated apt operations without persisting a whole mutable rootfs.
    """
    lists_dir = control_dir(root) / "cache" / "apt" / "lists"
    archives_dir = control_dir(root) / "cache" / "apt" / "archives"
    lists_dir.mkdir(parents=True, exist_ok=True)
    archives_dir.mkdir(parents=True, exist_ok=True)
    return lists_dir, archives_dir


def _runtime_base() -> Path:
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        return Path(xdg)
    return Path("/run/user") / str(os.getuid())


def _workspace_hash(root: Path) -> str:
    return hashlib.sha256(str(root).encode("utf-8")).hexdigest()[:12]


def _find_fuse_overlayfs() -> str | None:
    p = shutil.which("fuse-overlayfs")
    return p


def _kernel_native_rootless_overlay_ok() -> bool:
    # v1 behavior: kernel >= 5.11 generally supports native rootless overlay.
    try:
        rel = os.uname().release.split(".", 2)
        maj = int(rel[0])
        minor = int(rel[1]) if len(rel) > 1 else 0
        return maj > 5 or (maj == 5 and minor >= 11)
    except Exception:
        return False


def _looks_like_runroot_mismatch(err: str) -> bool:
    e = err.lower()
    return ("run root" in e and "does not match" in e) or ("database" in e and "mismatch" in e)


def _podman_info_timeout_s() -> int | None:
    raw = (
        os.environ.get("SW_PODMAN_INFO_TIMEOUT_S")
        or os.environ.get("SANDWORM_PODMAN_INFO_TIMEOUT_S")
        or "5"
    )
    try:
        v = int(str(raw).strip())
    except Exception:
        v = 5
    if v <= 0:
        return None
    return v


def _podman_info(podman: str, env: dict[str, str]) -> tuple[bool, str]:
    timeout_s = _podman_info_timeout_s()
    try:
        out = subprocess.run([podman, "info"], env=env, text=True, capture_output=True, timeout=timeout_s)
        ok = out.returncode == 0
        return ok, (out.stderr or "") + (out.stdout or "")
    except subprocess.TimeoutExpired as e:
        timeout_note = f"podman info timed out after {timeout_s}s" if timeout_s else "podman info timed out"
        stderr = str(e.stderr or "")
        stdout = str(e.stdout or "")
        return False, f"{timeout_note}\n{stderr}\n{stdout}".strip()
    except Exception as e:
        return False, repr(e)


def _reset_project_storage(podman: str, env: dict[str, str], graphroot: Path) -> None:
    # Best-effort reset within the project-local storage config (scoped by env).
    subprocess.run([podman, "system", "reset", "--force"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        subprocess.run([podman, "unshare", "rm", "-rf", str(graphroot)], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    shutil.rmtree(graphroot, ignore_errors=True)
    graphroot.mkdir(parents=True, exist_ok=True)


def ensure_storage(root: Path, storage_driver: str = "auto") -> PodmanEnv:
    podman = _podman_bin()
    if not podman:
        raise RuntimeError("podman not found in PATH")

    control = control_dir(root)
    xdg = control / "podman" / "xdg"
    storage_conf = xdg / "containers" / "storage.conf"
    tmpdir = control / "podman" / "tmp"
    graphroot = control / "podman" / "storage"

    storage_conf.parent.mkdir(parents=True, exist_ok=True)
    tmpdir.mkdir(parents=True, exist_ok=True)
    graphroot.mkdir(parents=True, exist_ok=True)
    home = control / "podman" / "home"
    home.mkdir(parents=True, exist_ok=True)

    env_driver = os.environ.get("SW_STORAGE_DRIVER")
    driver_choice = (env_driver or storage_driver).strip() if (env_driver or storage_driver) else "auto"
    driver = "overlay" if driver_choice in ("auto", "overlay") else driver_choice
    fuse_overlayfs = _find_fuse_overlayfs()
    runroot = _runtime_base() / f"sandworm-{_workspace_hash(root)}"
    runroot.mkdir(parents=True, exist_ok=True)
    force_fuse = os.environ.get("SW_FORCE_FUSE_OVERLAYFS") == "1"
    native_ok = _kernel_native_rootless_overlay_ok()

    def write_conf(drv: str) -> None:
        lines = [
            "[storage]",
            f'driver = "{drv}"',
            f'graphroot = "{graphroot}"',
            f'runroot = "{runroot}"',
            "",
            "[storage.options]",
        ]
        if drv == "overlay" and fuse_overlayfs and (force_fuse or not native_ok):
            lines.append(f'mount_program = "{fuse_overlayfs}"')
        storage_conf.write_text("\n".join(lines) + "\n", encoding="utf-8")

    env = dict(os.environ)
    env["CONTAINERS_STORAGE_CONF"] = str(storage_conf)
    env["XDG_DATA_HOME"] = str(xdg)
    env["XDG_CONFIG_HOME"] = str(xdg)
    env["TMPDIR"] = str(tmpdir)
    env["HOME"] = str(home)

    # Project-local containers config (policy.json/registries.conf) for portability.
    policy_path, registries_path = _ensure_project_containers_config(xdg, home)
    # Best-effort overrides for Podman builds that honor these env vars.
    env.setdefault("CONTAINERS_POLICY", str(policy_path))
    env.setdefault("CONTAINERS_REGISTRIES_CONF", str(registries_path))

    write_conf(driver)
    ok, info_err = _podman_info(podman, env)
    if not ok and _looks_like_runroot_mismatch(info_err):
        _reset_project_storage(podman, env, graphroot)
        ok, info_err = _podman_info(podman, env)

    if not ok:
        if driver == "overlay":
            write_conf("vfs")
            ok2, info_err2 = _podman_info(podman, env)
            if not ok2 and _looks_like_runroot_mismatch(info_err2):
                _reset_project_storage(podman, env, graphroot)
                ok2, _info_err3 = _podman_info(podman, env)
            if not ok2:
                raise RuntimeError(f"podman storage init failed (config={storage_conf})")
        else:
            raise RuntimeError(f"podman storage init failed (config={storage_conf})")

    return PodmanEnv(env=env)


def run(
    root: Path,
    argv: list[str],
    *,
    image: str,
    podman_env: PodmanEnv,
    network: str = "host",
    workdir: str = "/workspace",
    timeout_s: int | None = None,
    mounts: list[str] | None = None,
    shares: list[tuple[str, str, str]] | None = None,  # (name, src, mode)
    env: dict[str, str] | None = None,
    stdin: str | None = None,
    user: str | None = None,
    userns: str | None = None,
    expose_control_plane: bool = False,
    security_opts: list[str] | None = None,
    ensure_image: bool = True,
    interactive_stdin: bool = False,
    allocate_tty: bool = False,
    force_tty: bool = False,
    capture_output: bool = True,
) -> subprocess.CompletedProcess[str]:
    podman = _podman_bin()
    if not podman:
        raise RuntimeError("podman not found in PATH")

    if ensure_image:
        try:
            _ensure_image_best_effort(root=root, podman=podman, podman_env=podman_env, image=image)
        except PodmanImageError as e:
            msg = str(e)
            # Make strict supply-chain failures obvious to humans (and tests) while still returning
            # a CompletedProcess so higher layers can log/runbook it consistently.
            print(f"ERROR: {msg}", file=sys.stderr)
            return subprocess.CompletedProcess(args=[podman, "run", image, *argv], returncode=125, stdout="", stderr=msg)

    shared_dir = root / "shared"
    shared_dir.mkdir(parents=True, exist_ok=True)
    mask_dir: Path | None = None
    if not expose_control_plane:
        # Control-plane masking: /workspace/.sandworm must never expose the host workspace control plane.
        #
        # Podman `--tmpfs /workspace/.sandworm` can present a copy-on-write view of the underlying bind mount,
        # which leaks the host control plane (even if writes don't persist). Instead, bind-mount a fresh empty
        # directory and clean it up after the container exits.
        mask_parent = control_dir(root) / "tmp" / "podman-mask"
        mask_parent.mkdir(parents=True, exist_ok=True)
        mask_dir = Path(tempfile.mkdtemp(prefix="mask.", dir=str(mask_parent)))
        (mask_dir / "private").mkdir(parents=True, exist_ok=True)
    hooks_dir = control_dir(root) / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    toolroot_dir = control_dir(root) / "toolroot"
    toolroot_dir.mkdir(parents=True, exist_ok=True)
    sandbox_bin_dir = ensure_sandbox_bin_dir(root)

    mount_args: list[str] = []
    # Persistent apt caches (best-effort). Opt-out via SW_APT_CACHE=0.
    if os.environ.get("SW_APT_CACHE", "1") != "0":
        try:
            lists_dir, archives_dir = _ensure_apt_cache_dirs(root)
            mount_args += [
                "-v",
                f"{lists_dir}:/var/lib/apt/lists:rw",
                "-v",
                f"{archives_dir}:/var/cache/apt/archives:rw",
            ]
        except PodmanImageError:
            raise
        except Exception:
            pass
    if mounts:
        for m in mounts:
            mount_args += ["-v", m]
    if shares:
        for name, src, mode in shares:
            dest = f"/workspace/shared/{name}"
            opts = "ro" if mode == "ro" else "rw"
            mount_args += ["-v", f"{src}:{dest}:{opts}"]

    env_args: list[str] = []
    env2 = dict(env or {})
    env2.setdefault("SANDWORM_BIN", "/run/sandworm/bin/sandworm")
    env2.setdefault("SANDWORM_CLIENTS_BIN", "/run/sandworm/clients/bin")
    if expose_control_plane:
        env2.setdefault("SANDWORM_EXPOSE_CONTROL_PLANE", "1")
    try:
        host_nix = toolroot_dir / "bin" / "nix"
        if host_nix.exists() and os.access(host_nix, os.X_OK):
            env2.setdefault("SANDWORM_NIX", "/run/sandworm/toolroot/bin/nix")
    except Exception:
        pass
    # Avoid putting *secret* env var values on the command line (they can leak via `ps`, run logs, etc).
    # For non-secret env vars, prefer `-e KEY=VALUE` to avoid mutating Podman's own environment (e.g. HOME).
    podman_proc_env = dict(podman_env.env)
    secret_env_keys = {
        "CLAUDE_CODE_OAUTH_TOKEN",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "GOOGLE_API_KEY",
        "GITHUB_TOKEN",
    }
    for k, v in env2.items():
        if k in secret_env_keys:
            podman_proc_env[k] = v
            env_args += ["-e", k]
        else:
            env_args += ["-e", f"{k}={v}"]

    net_args: list[str] = []
    if network and network != "default":
        net_args = ["--network", network]

    user_args: list[str] = []
    if userns:
        user_args += ["--userns", userns]
    if user:
        user_args += ["--user", user]
    security_args: list[str] = []
    for opt in (security_opts or []):
        s = str(opt or "").strip()
        if s:
            security_args += ["--security-opt", s]

    io_args: list[str] = []
    if stdin is not None or interactive_stdin:
        io_args = ["-i"]
    if allocate_tty or force_tty:
        io_args += ["-t"]
    dns_args: list[str] = []
    net_mode = (network or "default").strip()
    if not net_mode:
        net_mode = "default"
    # Podman rejects --dns when --network=none.
    if net_mode != "none":
        dns_args = _podman_dns_args(network=net_mode)
    cidfile: Path | None = None
    cid_args: list[str] = []
    if not capture_output:
        try:
            cid_parent = control_dir(root) / "tmp" / "podman-cid"
            cid_parent.mkdir(parents=True, exist_ok=True)
            fd, cid_path = tempfile.mkstemp(prefix="run.", suffix=".cid", dir=str(cid_parent))
            os.close(fd)
            cidfile = Path(cid_path)
            cid_args = ["--cidfile", str(cidfile)]
        except Exception:
            cidfile = None
            cid_args = []

    argv2 = argv if expose_control_plane else inject_mask_check(argv)
    cmd = [
        podman,
        "run",
        "--rm",
        *_podman_init_args(),
        *cid_args,
        *io_args,
        *net_args,
        *dns_args,
        *user_args,
        *security_args,
        *env_args,
        "-v",
        f"{root}:/workspace:rw",
        "-v",
        f"{shared_dir}:/srv/shared:rw",
        "-v",
        f"{hooks_dir}:/run/sandworm/hooks:ro",
        "-v",
        f"{sandbox_bin_dir}:/run/sandworm/bin:ro",
        "-v",
        f"{(control_dir(root) / 'clients')}:/run/sandworm/clients:ro",
        "-v",
        f"{toolroot_dir}:/run/sandworm/toolroot:ro",
        *mount_args,
        "-w",
        workdir,
        image,
        *argv2,
    ]
    if mask_dir is not None:
        # Insert mask mount immediately after the shared mount for readability.
        insert_at = cmd.index(f"{shared_dir}:/srv/shared:rw") + 1
        cmd[insert_at:insert_at] = ["-v", f"{mask_dir}:/workspace/.sandworm:rw"]
    if force_tty and not capture_output:
        try:
            cmd = wrap_with_pty_if_needed(cmd=cmd, force=True, label="podman attached run")
        except PtyWrapError as e:
            raise RuntimeError(str(e)) from e
    try:
        if capture_output:
            return subprocess.run(cmd, env=podman_proc_env, text=True, capture_output=True, timeout=timeout_s, input=stdin)
        if stdin is not None:
            raise ValueError("podman.run(..., capture_output=False) does not support stdin text input")
        hb_s = _attached_heartbeat_s()
        grace_s = _attached_timeout_grace_s()
        interactive_tty = False
        try:
            interactive_tty = bool(sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty())
        except Exception:
            interactive_tty = False
        heartbeat_enabled = hb_s > 0 and _progress_enabled() and (
            not interactive_tty or _attached_heartbeat_in_interactive_tty()
        )
        deadline = (time.time() + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
        start = time.time()
        proc: subprocess.Popen[str] | None = None
        try:
            proc = subprocess.Popen(cmd, env=podman_proc_env, text=True, start_new_session=True)
            if _progress_enabled():
                _note(f"provider launch: started podman run (image={image}, network={net_mode})")
            next_tick = (start + float(hb_s)) if heartbeat_enabled else float("inf")
            while True:
                rc = proc.poll()
                now = time.time()
                if rc is not None:
                    if _progress_enabled():
                        elapsed = int(now - start)
                        _note(f"provider launch: podman run exited rc={int(rc)} (elapsed {elapsed}s)")
                    return subprocess.CompletedProcess(args=cmd, returncode=int(rc), stdout="", stderr="")
                if deadline is not None and now >= deadline:
                    elapsed = int(now - start)
                    _note(f"provider launch: podman run timed out after {elapsed}s; terminating process group")
                    _terminate_proc_group(proc, grace_s=grace_s)
                    return subprocess.CompletedProcess(
                        args=cmd,
                        returncode=124,
                        stdout="",
                        stderr=f"podman attached run timed out after {int(timeout_s)}s",
                    )
                if heartbeat_enabled and now >= next_tick:
                    elapsed = int(now - start)
                    _note(f"provider launch: podman run still active (elapsed {elapsed}s)")
                    next_tick = now + float(hb_s)
                time.sleep(0.2)
        except KeyboardInterrupt:
            if proc is not None:
                _note("provider launch: interrupt received; terminating podman run")
                _terminate_proc_group(proc, grace_s=grace_s)
            return subprocess.CompletedProcess(args=cmd, returncode=130, stdout="", stderr="interrupted")
    finally:
        if cidfile is not None:
            try:
                _force_remove_cid(podman=podman, env=podman_env.env, cidfile=cidfile)
            finally:
                try:
                    cidfile.unlink(missing_ok=True)
                except Exception:
                    pass
        if mask_dir is not None:
            try:
                shutil.rmtree(mask_dir)
            except Exception:
                try:
                    subprocess.run(
                        [podman, "unshare", "rm", "-rf", str(mask_dir)],
                        env=podman_env.env,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                except Exception:
                    pass
                try:
                    shutil.rmtree(mask_dir, ignore_errors=True)
                except Exception:
                    pass

def run_attached(
    root: Path,
    argv: list[str],
    *,
    image: str,
    podman_env: PodmanEnv,
    network: str = "host",
    workdir: str = "/workspace",
    mounts: list[str] | None = None,
    shares: list[tuple[str, str, str]] | None = None,  # (name, src, mode)
    env: dict[str, str] | None = None,
    user: str | None = None,
    userns: str | None = None,
    expose_control_plane: bool = False,
    ensure_image: bool = True,
    security_opts: list[str] | None = None,
    timeout_s: int | None = None,
    force_tty: bool = False,
) -> tuple[int, dict[str, object]]:
    net = network or "host"
    if net in ("auto", ""):
        net = "host"
    tty = bool(sys.stdin.isatty() and sys.stdout.isatty()) or force_tty
    proc = run(
        root,
        argv,
        image=image,
        podman_env=podman_env,
        network=net,
        workdir=workdir,
        timeout_s=timeout_s,
        mounts=mounts,
        shares=shares,
        env=env,
        stdin=None,
        user=user,
        userns=userns,
        expose_control_plane=expose_control_plane,
        security_opts=security_opts,
        ensure_image=ensure_image,
        interactive_stdin=True,
        allocate_tty=tty,
        force_tty=force_tty,
        capture_output=False,
    )
    rc = int(proc.returncode)
    return rc, {"requested": network, "selected": net, "attempts": [{"network": net, "exit_code": rc}]}


def _podman_is_network_setup_error(s: str) -> bool:
    e = (s or "").lower()
    return (
        "host networking requested" in e
        or "cannot set up namespace" in e
        or "failed to configure network" in e
        or ("failed to create" in e and "netns" in e)
        or ("slirp4netns" in e and "error" in e)
        or ("pasta" in e and "error" in e)
        or ("permission denied" in e and ("netns" in e or "namespace" in e))
    )


def _podman_network_candidates(network: str, *, network_order: str) -> list[str]:
    n = (network or "").strip()
    if n in ("", "auto", "host"):
        if network_order == "rootless_first":
            return ["slirp4netns", "pasta:--map-gw", "default", "host"]
        return ["host", "slirp4netns", "pasta:--map-gw", "default"]
    return [n]


def run_attached_with_network_fallback(
    root: Path,
    argv: list[str],
    *,
    image: str,
    podman_env: PodmanEnv,
    network: str,
    network_order: str = "host_first",
    workdir: str = "/workspace",
    mounts: list[str] | None = None,
    shares: list[tuple[str, str, str]] | None = None,  # (name, src, mode)
    env: dict[str, str] | None = None,
    user: str | None = None,
    userns: str | None = None,
    expose_control_plane: bool = False,
    log: callable | None = None,
    security_opts: list[str] | None = None,
    timeout_s: int | None = None,
    force_tty: bool = False,
) -> tuple[int, dict[str, object]]:
    """
    TTY-attached Podman runs cannot reliably capture stderr for error classification.
    We treat Podman's standard "run invocation error" exit code (125) as a network/setup candidate
    and retry other network modes when the request is host/auto-like.
    """
    if network == "none":
        return run_attached(
            root,
            argv,
            image=image,
            podman_env=podman_env,
            network="none",
            workdir=workdir,
            mounts=mounts,
            shares=shares,
            env=env,
            user=user,
            userns=userns,
            expose_control_plane=expose_control_plane,
            ensure_image=True,
            security_opts=security_opts,
            timeout_s=timeout_s,
            force_tty=force_tty,
        )

    candidates = _podman_network_candidates(network, network_order=("rootless_first" if network_order == "rootless_first" else "host_first"))
    attempts: list[dict[str, object]] = []
    last_rc = 125
    for i, net in enumerate(candidates):
        t0 = time.time()
        rc, _meta = run_attached(
            root,
            argv,
            image=image,
            podman_env=podman_env,
