def run_suite(
    *,
    root: Path,
    suite: str,
    run_dir: Path,
    knobs: dict[str, Any] | None,
) -> dict[str, Any]:
    knobs = knobs or {}
    timeout_s = int(knobs.get("timeout_s") or 7200)
    dry_run = bool(knobs.get("dry_run")) if "dry_run" in knobs else False
    full = bool(knobs.get("full")) if "full" in knobs else (suite == "facility-full")
    vm_matrix = bool(knobs.get("vm_matrix")) if "vm_matrix" in knobs else False
    podman_pulls = bool(knobs.get("podman_pulls")) if "podman_pulls" in knobs else (suite == "facility-full")
    fast = bool(knobs.get("fast")) if "fast" in knobs else True

    if suite in ("facility-core", "facility-full"):
        res = {"suite": suite, "ts": _now_rfc3339_utc(), "ok": True, "tranches": []}
        t1 = _suite_facility_in_kvm(
            root=root,
            run_dir=run_dir,
            full=bool(full),
            vm_matrix=False,  # vm-matrix is host-heavy; keep it separate
            podman_pulls=bool(podman_pulls),
            timeout_s=timeout_s,
        )
        res["tranches"].append({"name": "facility-in-kvm", **t1})
        if not bool(t1.get("ok")):
            res["ok"] = False

        t2 = _suite_kvm_smokes_host(root=root, run_dir=run_dir, timeout_s=timeout_s)
        res["tranches"].append({"name": "kvm-smokes-host", **t2})
        if not bool(t2.get("ok")):
            res["ok"] = False

        if vm_matrix:
            t3 = _suite_vm_matrix_host(root=root, run_dir=run_dir, timeout_s=timeout_s)
            res["tranches"].append({"name": "vm-matrix-host", **t3})
            if not bool(t3.get("ok")):
                res["ok"] = False
        return res

    if suite == "kvm-smokes-host":
        return _suite_kvm_smokes_host(root=root, run_dir=run_dir, timeout_s=timeout_s)
    if suite == "vm-matrix-host":
        return _suite_vm_matrix_host(root=root, run_dir=run_dir, timeout_s=timeout_s)
    if suite == "dev-proof-host":
        return _suite_dev_proof_host(
            root=root,
            run_dir=run_dir,
            timeout_s=timeout_s,
            fast=bool(fast),
            dry_run=bool(dry_run),
        )
    if suite == "oracle-host":
        return _suite_oracle_host(
            root=root,
            run_dir=run_dir,
            timeout_s=timeout_s,
            dry_run=bool(dry_run),
        )

    raise ValueError(f"unknown suite: {suite!r}")


class _Run:
    def __init__(self, *, run_id: str, suite: str, run_dir: Path) -> None:
        self.run_id = run_id
        self.suite = suite
        self.run_dir = run_dir
        self.status: str = "running"
        self.started_at = _now_rfc3339_utc()
        self.ended_at: str | None = None
        self.result: dict[str, Any] | None = None
        self.error: str | None = None
        self.cancel_requested = False


class DevRunner:
    def __init__(self, cfg: RunnerConfig) -> None:
        self.cfg = cfg
        self._runs: dict[str, _Run] = {}
        self._lock = threading.Lock()

    def _new_run(self, *, suite: str) -> _Run:
        rid = f"run-{time.strftime('%Y%m%d-%H%M%S', time.gmtime())}-{secrets.token_hex(4)}"
        p = runner_state_paths(self.cfg.root)
        run_dir = p["runs"] / rid
        _safe_mkdir(run_dir)
        r = _Run(run_id=rid, suite=suite, run_dir=run_dir)
        with self._lock:
            self._runs[rid] = r
        return r

    def run_suite_async(self, *, suite: str, knobs: dict[str, Any] | None) -> dict[str, Any]:
        r = self._new_run(suite=suite)
        meta = {"run_id": r.run_id, "suite": suite, "run_dir": str(r.run_dir)}

        def worker() -> None:
            try:
                _audit_append(self.cfg.root, {"ts": _now_rfc3339_utc(), "event": "suite_start", "suite": suite, "run_id": r.run_id, "knobs": knobs or {}})
                result = run_suite(root=self.cfg.root, suite=suite, run_dir=r.run_dir, knobs=knobs or {})
                r.result = result
                r.status = "ok" if bool(result.get("ok", False)) else "fail"
                _atomic_write(r.run_dir / "result.json", json.dumps(result, indent=2, sort_keys=True) + "\n")
                _audit_append(self.cfg.root, {"ts": _now_rfc3339_utc(), "event": "suite_end", "suite": suite, "run_id": r.run_id, "ok": bool(result.get("ok"))})
            except Exception:
                r.status = "error"
                r.error = traceback.format_exc()
                _atomic_write(r.run_dir / "error.txt", r.error)
                _audit_append(self.cfg.root, {"ts": _now_rfc3339_utc(), "event": "suite_error", "suite": suite, "run_id": r.run_id, "error": str(r.error)})
            finally:
                r.ended_at = _now_rfc3339_utc()

        th = threading.Thread(target=worker, name=f"dev-runner:{suite}:{r.run_id}", daemon=True)
        th.start()
        return meta

    def status(self, run_id: str) -> dict[str, Any]:
        with self._lock:
            r = self._runs.get(run_id)
        if not r:
            return {"ok": False, "error": "unknown run_id"}
        out: dict[str, Any] = {
            "ok": True,
            "run_id": r.run_id,
            "suite": r.suite,
            "status": r.status,
            "started_at": r.started_at,
            "ended_at": r.ended_at,
            "run_dir": str(r.run_dir),
        }
        if r.result is not None:
            out["result"] = r.result
        if r.error is not None:
            out["error"] = r.error
        return out

    def tail(self, run_id: str, n_lines: int) -> dict[str, Any]:
        # Best-effort: tail the most relevant run logs for the suite.
        st = self.status(run_id)
        if not st.get("ok"):
            return st
        run_dir = Path(str(st["run_dir"]))
        candidates = [
            run_dir / "facility-in-kvm.stderr.txt",
            run_dir / "facility-in-kvm.stdout.txt",
            run_dir / "vm-matrix.log",
        ]
        txt = ""
        for p in candidates:
            if p.exists():
                try:
                    data = p.read_text(encoding="utf-8", errors="ignore").splitlines()
                    if data:
                        tail = data[-max(1, int(n_lines)) :]
                        txt += f"== {p.name} ==\n" + "\n".join(tail) + "\n"
                except Exception:
                    pass
        return {"ok": True, "run_id": run_id, "tail": txt}


def _auth_ok(token: str, headers: dict[str, str]) -> bool:
    # Token is required. Accept either:
    # - Authorization: Bearer <token>
    # - X-Sandworm-Token: <token>
    want = (token or "").strip()
    if not want:
        return False
    got = ""
    auth = headers.get("authorization") or headers.get("Authorization")
    if isinstance(auth, str) and auth.lower().startswith("bearer "):
        got = auth.split(" ", 1)[1].strip()
    if not got:
        got = (headers.get("x-sandworm-token") or headers.get("X-Sandworm-Token") or "").strip()
    try:
        return secrets.compare_digest(got, want)
    except Exception:
        return False


class _Handler(BaseHTTPRequestHandler):
    server_version = "sandworm-dev-runner/0"

    def _json(self, code: int, payload: dict[str, Any]) -> None:
        body = (json.dumps(payload, sort_keys=True) + "\n").encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt: str, *args: Any) -> None:
        # Keep server quiet by default; runner has explicit audit logs.
        return

    def _read_json_body(self) -> dict[str, Any]:
        try:
            n = int(self.headers.get("Content-Length") or "0")
        except Exception:
            n = 0
        if n <= 0:
            return {}
        raw = self.rfile.read(n)
        try:
            obj = json.loads(raw.decode("utf-8", errors="replace"))
            return obj if isinstance(obj, dict) else {}
        except Exception:
            return {}

    def do_GET(self) -> None:
        srv: DevRunner = getattr(self.server, "runner")  # type: ignore[attr-defined]
        cfg: RunnerConfig = getattr(self.server, "cfg")  # type: ignore[attr-defined]
        if not _auth_ok(cfg.token, dict(self.headers)):
            self._json(401, {"ok": False, "error": "unauthorized"})
            return
        u = urlparse(self.path)
        qs = parse_qs(u.query or "")
        if u.path == "/v1/status":
            self._json(200, {"ok": True, "ts": _now_rfc3339_utc()})
            return
        if u.path == "/v1/run/status":
            rid = (qs.get("run_id", [""]) or [""])[0]
            self._json(200, srv.status(str(rid)))
            return
        if u.path == "/v1/run/tail":
            rid = (qs.get("run_id", [""]) or [""])[0]
            n = int((qs.get("n", ["200"]) or ["200"])[0] or 200)
            self._json(200, srv.tail(str(rid), int(n)))
            return
        self._json(404, {"ok": False, "error": "not found"})

    def do_POST(self) -> None:
        srv: DevRunner = getattr(self.server, "runner")  # type: ignore[attr-defined]
        cfg: RunnerConfig = getattr(self.server, "cfg")  # type: ignore[attr-defined]
        if not _auth_ok(cfg.token, dict(self.headers)):
            self._json(401, {"ok": False, "error": "unauthorized"})
            return
        if self.path == "/v1/suite/run":
            body = self._read_json_body()
            suite = str(body.get("suite") or "")
            knobs = body.get("knobs") if isinstance(body.get("knobs"), dict) else {}
            if suite not in ("facility-core", "facility-full", "kvm-smokes-host", "vm-matrix-host", "dev-proof-host", "oracle-host"):
                self._json(400, {"ok": False, "error": f"unknown suite: {suite!r}"})
                return
            meta = srv.run_suite_async(suite=suite, knobs=knobs)
            self._json(200, {"ok": True, **meta})
            return
        self._json(404, {"ok": False, "error": "not found"})


def serve(root: Path, *, host: str, port: int, token: str) -> int:
    cfg = RunnerConfig(root=root, host=host, port=int(port), token=token)
    p = runner_state_paths(root)
    _safe_mkdir(p["base"])
    _safe_mkdir(p["runs"])
    _safe_mkdir(p["locks"])
    _atomic_write(p["port"], str(int(port)) + "\n")
    _atomic_write(p["token"], token.strip() + "\n")
    try:
        os.chmod(p["token"], 0o600)
    except Exception:
        pass

    runner = DevRunner(cfg)

    httpd = ThreadingHTTPServer((str(host), int(port)), _Handler)
    setattr(httpd, "runner", runner)
    setattr(httpd, "cfg", cfg)

    _audit_append(root, {"ts": _now_rfc3339_utc(), "event": "runner_listen", "host": host, "port": int(port)})
    try:
