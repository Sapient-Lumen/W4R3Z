                raise SystemExit("runlock stop: no pid recorded in run.lock")
            if isinstance(pst_rec, str) and pst and pst_rec != pst:
                payload = {"ok": False, "stopped": False, "reason": "pid_reused_or_stale_record", "lock_path": str(lock_path), "holder": holder, "proc_starttime": pst}
                if bool(getattr(args, "json", False)):
                    print(json.dumps(payload, indent=2, sort_keys=True))
                    return 2
                raise SystemExit("runlock stop: pid appears to be reused or lock record is stale; refusing to signal")
            alive_now, _probe_now = _pid_probe(pid)
            if alive_now is not True:
                # No longer running; clear stale record only if the lock is not currently held.
                fd = lock_path.open("a+", encoding="utf-8")
                try:
                    fcntl.flock(fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    payload = {"ok": False, "stopped": False, "reason": "held", "lock_path": str(lock_path), "holder": (holder or None)}
                    if bool(getattr(args, "json", False)):
                        print(json.dumps(payload, indent=2, sort_keys=True))
                        return 2
                    raise SystemExit(f"runlock stop: lock is held (use: sandworm runlock status). lock={lock_path}")
                try:
                    fd.seek(0)
                    fd.truncate()
                    fd.flush()
                except Exception:
                    pass
                finally:
                    try:
                        fcntl.flock(fd.fileno(), fcntl.LOCK_UN)
                    except Exception:
                        pass
                    fd.close()
                payload = {"ok": True, "stopped": False, "reason": "already_exited", "lock_path": str(lock_path), "pid": pid}
                if bool(getattr(args, "json", False)):
                    print(json.dumps(payload, indent=2, sort_keys=True))
                    return 0
                print(f"runlock stop: OK (pid {pid} already exited; cleared stale record)")
                return 0
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
            deadline = time.time() + float(getattr(args, "timeout_s", 5.0) or 5.0)
            while time.time() < deadline:
                alive_now, _probe_now = _pid_probe(pid)
                if alive_now is not True:
                    break
                time.sleep(0.1)
            alive_now, _probe_now = _pid_probe(pid)
            if alive_now is True and bool(getattr(args, "kill", False)):
                try:
                    os.kill(pid, signal.SIGKILL)
                except Exception:
                    pass
                time.sleep(0.2)

            # Clear record if the lock is no longer held.
            try:
                fd = lock_path.open("a+", encoding="utf-8")
                try:
                    fcntl.flock(fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                    fd.seek(0)
                    fd.truncate()
                    fd.flush()
                finally:
                    try:
                        fcntl.flock(fd.fileno(), fcntl.LOCK_UN)
                    except Exception:
                        pass
                    fd.close()
            except Exception:
                pass

            alive_now, _probe_now = _pid_probe(pid)
            stopped = alive_now is not True
            payload = {"ok": bool(stopped), "stopped": bool(stopped), "pid": pid, "lock_path": str(lock_path)}
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
                return 0 if stopped else 2
            if stopped:
                print(f"runlock stop: OK (stopped pid {pid})")
                return 0
            raise SystemExit(f"runlock stop: failed to stop pid {pid} (try: sandworm runlock status). lock={lock_path}")

        raise SystemExit(f"unknown runlock subcommand: {args.runlock_cmd}")

    # hostd serve must not take the global run lock; it is a long-lived daemon.
    if args.cmd == "hostd" and getattr(args, "hostd_cmd", None) == "serve":
