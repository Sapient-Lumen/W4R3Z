def hooks_templates_list(*, root: Path) -> list[str]:
    """
    Return template IDs like `sandbox/log`.
    """
    root = root.resolve()
    out: set[str] = set()

    for cls, bundles in _builtin_templates().items():
        for bundle in bundles.keys():
            out.add(f"{cls}/{bundle}")

    td = hooks_templates_dir(root)
    for cls in ("sandbox", "host"):
        base = td / cls
        if not base.is_dir():
            continue
        for p in base.iterdir():
            if p.is_dir():
