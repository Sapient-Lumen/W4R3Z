def _now_rfc3339_utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _truthy(v: object) -> bool:
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return bool(v)
    if isinstance(v, str):
        return v.strip().lower() in ("1", "true", "yes", "y", "on")
    return False


def _truthy_env(name: str) -> bool:
    v = os.environ.get(name)
    if v is None:
        return False
    return _truthy(v)


def _host_integrations_enabled() -> bool:
    return _truthy_env("SW_HOST_INTEGRATIONS") or _truthy_env("SANDWORM_HOST_INTEGRATIONS")


def _provider_dbus_requested() -> bool:
    if "SW_PROVIDER_DBUS" in os.environ:
        return _truthy_env("SW_PROVIDER_DBUS")
    return _host_integrations_enabled()


def _provider_ssh_agent_requested() -> bool:
    if "SW_PROVIDER_SSH_AGENT" in os.environ:
        return _truthy_env("SW_PROVIDER_SSH_AGENT")
    return _host_integrations_enabled()


def _is_socket_file(p: str | Path | None) -> bool:
    if not p:
        return False
    try:
        pp = Path(p)
        return pp.exists() and pp.is_socket()
    except Exception:
        return False


def _observe_control_plane() -> dict[str, object]:
    """
    Best-effort probe of /workspace/.sandworm visibility from the current runtime.
    """
    cp = Path("/workspace/.sandworm")
    mount_masked_local = False
    try:
        mi = Path("/proc/self/mountinfo")
        if mi.exists():
            for line in mi.read_text(encoding="utf-8", errors="replace").splitlines():
                if " - " not in line:
                    continue
                pre, _post = line.split(" - ", 1)
                fields = pre.split()
                if len(fields) < 5:
                    continue
                if fields[4] != "/workspace/.sandworm":
                    continue
                mount_root = fields[3]
                if "/.sandworm/tmp/podman-mask/" in mount_root or "/.sandworm/mask-empty" in mount_root:
                    mount_masked_local = True
                break
    except Exception:
        mount_masked_local = False
    try:
        if not cp.exists():
            return {"observed": "absent", "entries": []}
        if not cp.is_dir():
            return {"observed": "non-directory", "entries": []}
        entries = sorted({p.name for p in cp.iterdir() if p.name not in (".", "..")})
        non_private = [n for n in entries if n != "private"]
        if not entries:
            observed = "empty"
        elif not non_private:
            observed = "private-only"
        else:
            observed = "populated"
        if observed == "populated" and mount_masked_local:
            observed = "masked-local"
        return {"observed": observed, "entries": entries}
    except Exception:
        return {"observed": "unknown", "entries": []}


def _detect_host_bridge(*, root: Path | None, posture: str, backend: str) -> dict[str, object]:
    p = (posture or "").strip().lower()
    b = (backend or "").strip().lower()
    if p == "bare-metal":
        return {
            "available": True,
            "host_root_mount": "direct",
            "host_root_path": "/",
            "gateway": "none",
            "host_execution": "direct",
        }
    if p not in ("unsafe", "take-the-wheel"):
        return {"available": False, "host_root_mount": "none", "gateway": "none"}
    if b == "kvm":
        return {"available": False, "host_root_mount": "none", "gateway": "none"}
    host_root_mount = ("rw" if p == "take-the-wheel" else "none")
    hostd_sock_present: bool | None = None
    if root is not None:
        try:
            host_sock = hostd_socket(root).resolve()
            hostd_sock_present = bool(_is_socket_file(host_sock))
        except Exception:
            hostd_sock_present = None
    return {
        "available": True,
        "host_root_mount": host_root_mount,
        "host_root_path": ("/host" if host_root_mount in ("ro", "rw") else None),
        "gateway": "hostd",
        "hostd_sock": "/run/sandworm/hostd.sock",
        "hostd_sock_present": hostd_sock_present,
    }

def _provider_auth_notes(provider: str | None) -> dict[str, object] | None:
    p = (provider or "").strip().lower()
    if not p:
        return None
    if p == "gemini":
        return {
            "provider": "gemini",
            "primary_auth": "api_key",
            "recommended_setup": "sandbox",
            "notes": [
                "Gemini CLI commonly uses an API key (GEMINI_API_KEY / GOOGLE_API_KEY).",
                "Sandworm can store the API key in the project-local creds store and inject it into sandboxes.",
                "Provider CLIs default to sandbox execution; bare-metal runs them on the host when explicitly requested.",
            ],
        }
    if p == "codex":
        return {
            "provider": "codex",
            "primary_auth": "oauth_device_flow",
            "recommended_setup": "sandbox",
            "notes": [
                "Codex login uses a device flow that should work in sandboxed runs (URL + code).",
                "Sandworm can auto-open allowlisted URLs on the host when permitted.",
                "Provider CLIs default to sandbox execution; bare-metal runs them on the host when explicitly requested.",
            ],
        }
    if p == "claude":
        return {
            "provider": "claude",
            "primary_auth": "oauth_or_api_key",
            "recommended_setup": "sandbox",
            "notes": [
                "Claude Code can store OAuth/token credentials under $HOME/.claude/.credentials.json.",
                "API key auth (ANTHROPIC_API_KEY) may also work for some flows.",
                "Provider CLIs default to sandbox execution; bare-metal runs them on the host when explicitly requested.",
            ],
        }
    return {"provider": p, "primary_auth": "unknown", "recommended_setup": "sandbox", "notes": ["Unknown provider."]}


_KITCHENSINK_OPTIONAL_TOOLS = ["apt", "nix", "nix-shell", "junest"]
_KITCHENSINK_BASELINE_TOOLS = list(DEV_KITCHENSINK_INSTALL_BINS) + list(_KITCHENSINK_OPTIONAL_TOOLS)


def _is_exec(p: Path | None) -> bool:
    try:
        return bool(p and p.exists() and os.access(str(p), os.X_OK))
    except Exception:
        return False


def _tool_mode(*, tool: str, source: str) -> str:
    if source == "missing":
        return "missing"
    # Wrappers under toolroot are compatibility shims for these tools.
    if source == "toolroot" and tool in ("rg", "jq"):
        return "compat"
    return "real"


def _kitchensink_snapshot(
    *,
    root: Path | None,
    dev_toolchain_requested: bool | None = None,
    dev_toolchain_ok: bool | None = None,
    dev_toolchain_bin_in_sandbox: str | None = None,
) -> dict[str, object]:
    toolroot_bin_host: Path | None = None
    dev_bin_host: Path | None = None
    if root is not None:
        try:
            toolroot_bin_host = control_dir(root) / "toolroot" / "bin"
        except Exception:
            toolroot_bin_host = None
        try:
            home_dir = ensure_sandworm_home(root)
            dev_bin_host = home_dir / ".local" / "state" / "nix" / "profiles" / "sandworm-dev" / "bin"
        except Exception:
            dev_bin_host = None
    tools: dict[str, dict[str, object]] = {}
    for t in _KITCHENSINK_BASELINE_TOOLS:
        source = "missing"
        host_path: Path | None = None
        if t in DEV_KITCHENSINK_INSTALL_BINS and bool(dev_toolchain_ok) and _is_exec(dev_bin_host / t if dev_bin_host else None):
            source = "dev_toolchain"
            host_path = dev_bin_host / t if dev_bin_host else None
        elif _is_exec(toolroot_bin_host / t if toolroot_bin_host else None):
            source = "toolroot"
            host_path = toolroot_bin_host / t if toolroot_bin_host else None
        else:
            sys_path = shutil.which(t)
            if sys_path:
                source = "system"
                host_path = Path(sys_path)
        mode = _tool_mode(tool=t, source=source)
        sandbox_path = None
        if source == "dev_toolchain" and isinstance(dev_toolchain_bin_in_sandbox, str) and dev_toolchain_bin_in_sandbox.strip():
            sandbox_path = f"{dev_toolchain_bin_in_sandbox.rstrip('/')}/{t}"
        elif source == "toolroot":
            sandbox_path = f"/run/sandworm/toolroot/bin/{t}"
        tools[t] = {
            "available": source != "missing",
            "mode": mode,
            "source": source,
            "path": (str(host_path) if isinstance(host_path, Path) else None),
            "sandbox_path_hint": sandbox_path,
        }
    return {
        "baseline_tools": list(_KITCHENSINK_BASELINE_TOOLS),
        "toolroot_bin": "/run/sandworm/toolroot/bin",
        "dev_toolchain": {
            "requested": (bool(dev_toolchain_requested) if dev_toolchain_requested is not None else None),
            "ok": (bool(dev_toolchain_ok) if dev_toolchain_ok is not None else None),
            "install_bins": list(DEV_KITCHENSINK_INSTALL_BINS),
            "bin_in_sandbox": (
                str(dev_toolchain_bin_in_sandbox) if isinstance(dev_toolchain_bin_in_sandbox, str) and dev_toolchain_bin_in_sandbox.strip() else None
            ),
        },
        "tools": tools,
    }


def build_caps(
    *,
    root: Path | None = None,
    backend: str,
    posture: str,
    network_requested: str | None = None,
    network_selected: str | None = None,
    network_attempts: list[dict[str, object]] | None = None,
    offline: bool | None = None,
    strict: bool | None = None,
    provider: str | None = None,
    provider_mode: str | None = None,
    image: str | None = None,
    shares: list[dict[str, str]] | None = None,
    expose_private: bool | None = None,
    expose_control_plane: bool | None = None,
    control_plane_observed: str | None = None,
    control_plane_entries: list[str] | None = None,
    dev_toolchain_requested: bool | None = None,
    dev_toolchain_ok: bool | None = None,
    dev_toolchain_bin_in_sandbox: str | None = None,
) -> dict[str, object]:
    b = (backend or "").strip().lower() or "unknown"
    p = (posture or "").strip().lower() or "unknown"
    hb = _detect_host_bridge(root=root, posture=p, backend=b)
    control_plane_expected = ("exposed" if bool(expose_control_plane) else "masked")
    if isinstance(control_plane_observed, str) and control_plane_observed.strip():
        control_plane_obs = {
            "observed": control_plane_observed.strip(),
            "entries": list(control_plane_entries or []),
        }
    else:
        control_plane_obs = _observe_control_plane()
    sandworm_home_path = "/run/sandworm/home"
    mounts: dict[str, object] = {
        "workspace": {"path": "/workspace", "mode": "rw"},
        "control_plane": {
            "path": "/workspace/.sandworm",
            "expected": control_plane_expected,
            "observed": str(control_plane_obs.get("observed") or "unknown"),
            "entries": list(control_plane_obs.get("entries") or []),
        },
        "shared": {"path": "/srv/shared", "mode": "rw"},
        "sandworm_home": {"path": sandworm_home_path, "mode": "rw"},
        "clients": {"path": "/run/sandworm/clients", "mode": "ro"},
        "toolroot": ({"path": "/run/sandworm/toolroot", "mode": "ro"}),
        "hooks": {"path": "/run/sandworm/hooks", "mode": "ro"},
        "host_root": {
            "path": hb.get("host_root_path") if isinstance(hb, dict) else None,
            "mode": hb.get("host_root_mount") if isinstance(hb, dict) else None,
        },
        "expose_private": {"enabled": bool(expose_private) if expose_private is not None else None},
        "shares": shares or [],
    }
    caps: dict[str, object] = {
        "schema": "sandworm_caps.v1",
        "generated_at": _now_rfc3339_utc(),
        "backend": b,
        "posture": p,
        "network": {
            "requested": (network_requested or None),
            "selected": (network_selected or None),
            "attempts": (network_attempts or None),
            "offline": (bool(offline) if offline is not None else None),
            "strict": (bool(strict) if strict is not None else None),
        },
        "paths": {
            "workspace": "/workspace",
            "sandworm_home": sandworm_home_path,
            "clients_bin": "/run/sandworm/clients/bin",
            "toolroot_bin": "/run/sandworm/toolroot/bin",
            "dev_toolchain_bin": (
                str(dev_toolchain_bin_in_sandbox)
                if isinstance(dev_toolchain_bin_in_sandbox, str) and dev_toolchain_bin_in_sandbox.strip()
                else None
            ),
            "hooks": "/run/sandworm/hooks",
            "control_plane_masked_at": "/workspace/.sandworm",
        },
        "mounts": mounts,
        "host_bridge": hb,
        "provider": {
            "name": (provider or None),
            "mode": (provider_mode or None),
            "image": (image or None),
            "auth": _provider_auth_notes(provider),
        },
        "host_integrations": {
            "gui_env_present": bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")),
            "xdg_open_present": bool(shutil.which("xdg-open")),
            "dbus_session_passthrough_requested": _provider_dbus_requested(),
            "dbus_session_address_present": bool(os.environ.get("DBUS_SESSION_BUS_ADDRESS")),
            "xdg_runtime_dir": (os.environ.get("XDG_RUNTIME_DIR") or None),
            "xdg_runtime_bus_present": bool(
                (os.environ.get("XDG_RUNTIME_DIR") and (Path(os.environ.get("XDG_RUNTIME_DIR", "")) / "bus").exists())
            ),
            "xdg_runtime_bus_is_socket": bool(_is_socket_file((Path(os.environ.get("XDG_RUNTIME_DIR", "")) / "bus") if os.environ.get("XDG_RUNTIME_DIR") else None)),
            "ssh_agent_passthrough_requested": _provider_ssh_agent_requested(),
            "ssh_agent_sock": (os.environ.get("SSH_AUTH_SOCK") or None),
            "ssh_agent_sock_present": bool(_is_socket_file(os.environ.get("SSH_AUTH_SOCK") or None)),
        },
        "xdg_open": {
            "auto_open": True,
            "allowlist_hint": "Only https:// URLs under the allowlisted domains for the selected provider are eligible for auto-open.",
        },
        "kitchensink": _kitchensink_snapshot(
            root=root,
            dev_toolchain_requested=dev_toolchain_requested,
            dev_toolchain_ok=dev_toolchain_ok,
            dev_toolchain_bin_in_sandbox=dev_toolchain_bin_in_sandbox,
        ),
    }
    return caps


def build_env_md(*, caps: dict[str, object]) -> str:
    backend = str(caps.get("backend") or "unknown")
    posture = str(caps.get("posture") or "unknown")
    net = caps.get("network") if isinstance(caps.get("network"), dict) else {}
    host_bridge = caps.get("host_bridge") if isinstance(caps.get("host_bridge"), dict) else {}

    paths = caps.get("paths") if isinstance(caps.get("paths"), dict) else {}
    home = str(paths.get("sandworm_home") or "/run/sandworm/home")
    mounts = caps.get("mounts") if isinstance(caps.get("mounts"), dict) else {}
    control_plane = mounts.get("control_plane") if isinstance(mounts.get("control_plane"), dict) else {}
    control_expected = str(control_plane.get("expected") or "masked")
    control_observed = str(control_plane.get("observed") or "unknown")
    lines: list[str] = []
    lines.append("# Sandworm environment (best-effort)")
    lines.append("")
    lines.append(f"- backend: {backend}")
    lines.append(f"- posture: {posture}")
    nm_req = net.get("requested")
    nm_sel = net.get("selected")
    nm = nm_sel or nm_req
    if nm:
        lines.append(f"- network: {nm}")
    if nm_req and nm_sel and nm_req != nm_sel:
        lines.append(f"- network requested: {nm_req}")
        lines.append(f"- network selected: {nm_sel}")
    if net.get("offline") is not None:
        lines.append(f"- offline: {'yes' if _truthy(net.get('offline')) else 'no'}")
    if net.get("strict") is not None:
        lines.append(f"- strict: {'yes' if _truthy(net.get('strict')) else 'no'}")
    lines.append("")
    lines.append("## Key paths")
    lines.append(f"- workspace: `/workspace`")
    lines.append("- workspace env index: `/workspace/.SANDWORM_ENV.md`")
    lines.append(f"- shared handoff: `/srv/shared` (bind of `./shared` on host)")
    if control_expected == "exposed":
        lines.append(f"- control plane: `/workspace/.sandworm` (exposed; dev/self-hosting lane)")
    elif control_observed in ("empty", "private-only", "absent"):
        lines.append(f"- control plane: `/workspace/.sandworm` (masked; should be tmpfs/empty)")
    else:
        lines.append(
            f"- control plane: `/workspace/.sandworm` (expected {control_expected}, observed `{control_observed}`; probe before trusting assumptions)"
        )
    lines.append(f"- sandworm HOME: `{home}` (project-local; shared across backends when mounted)")
    lines.append(f"- provider CLIs: `$SANDWORM_CLIENTS_BIN` (usually `{caps.get('paths', {}).get('clients_bin', '/run/sandworm/clients/bin')}`)")
    lines.append("")
    prov = caps.get("provider") if isinstance(caps.get("provider"), dict) else {}
    auth = prov.get("auth") if isinstance(prov.get("auth"), dict) else None
    if isinstance(auth, dict) and auth.get("provider"):
        lines.append("## Provider auth")
        lines.append(f"- provider: {auth.get('provider')}")
        lines.append(f"- primary auth: {auth.get('primary_auth')}")
        lines.append(f"- recommended setup: {auth.get('recommended_setup')}")
        notes = auth.get("notes")
        if isinstance(notes, list):
            for n in notes:
                if isinstance(n, str) and n.strip():
                    lines.append(f"- note: {n.strip()}")
    lines.append("")
    lines.append("## Notes")
    if isinstance(host_bridge, dict) and _truthy(host_bridge.get("available")):
        m = str(host_bridge.get("host_root_mount") or "none")
        hp = host_bridge.get("host_root_path")
        if hp and m in ("ro", "rw"):
            lines.append(f"- Host root is mounted at `{hp}` ({m}).")
        else:
            lines.append("- No host root mount is present in this posture/backend.")
        lines.append("- Host gateway socket (if mounted): `/run/sandworm/hostd.sock`")
    else:
        lines.append("- No host bridge is available in this context.")
    if control_observed == "populated":
        lines.append(
            "- Control plane is visible here; after `sandworm refresh`, prefer `/workspace/.sandworm/toolroot/bin/*` for freshest wrappers in this root."
        )
    lines.append("- This file and `SANDWORM_CAPS.json` are best-effort hints; always probe reality if something matters.")
    kitchensink = caps.get("kitchensink") if isinstance(caps.get("kitchensink"), dict) else {}
    ks_tools = kitchensink.get("tools") if isinstance(kitchensink.get("tools"), dict) else {}
    ks_dev = kitchensink.get("dev_toolchain") if isinstance(kitchensink.get("dev_toolchain"), dict) else {}
    rg_mode = str((ks_tools.get("rg") or {}).get("mode") or "").strip().lower() if isinstance(ks_tools.get("rg"), dict) else ""
    jq_mode = str((ks_tools.get("jq") or {}).get("mode") or "").strip().lower() if isinstance(ks_tools.get("jq"), dict) else ""
    if rg_mode == "compat":
        lines.append("- `rg` resolves to Sandworm compatibility mode (`rg-compat`); for full ripgrep semantics use `sandworm dev shell -- rg ...`.")
    elif rg_mode == "missing":
        lines.append("- `rg` is not currently available via dev-toolchain/toolroot/system paths in this context.")
    if jq_mode == "compat":
        lines.append("- `jq` resolves to Sandworm compatibility mode (`jq-compat`); for full jq semantics use `sandworm dev shell -- jq ...`.")
    elif jq_mode == "missing":
        lines.append("- `jq` is not currently available via dev-toolchain/toolroot/system paths in this context.")
    if _truthy(ks_dev.get("requested")) and not _truthy(ks_dev.get("ok")):
        lines.append("- DEV toolchain was requested but not provisioned; check `SANDWORM_CAPS.json` -> `kitchensink.dev_toolchain`.")
    try:
        if not shutil.which("sandworm") and Path("/run/sandworm/bin/sandworm").exists():
            lines.append("- `sandworm` may be missing from `PATH` here; use `${SANDWORM_BIN:-/run/sandworm/bin/sandworm}`.")
        if not shutil.which("rg") and Path("/run/sandworm/toolroot/bin/rg").exists():
            lines.append("- `rg` may be missing from `PATH`; use `/run/sandworm/toolroot/bin/rg` or prepend `/run/sandworm/toolroot/bin`.")
    except Exception:
        pass
    lines.append("")
    lines.append("## Quick capability checks")
    lines.append("- `echo backend=$SANDWORM_BACKEND posture=$SANDWORM_POSTURE`")
    lines.append("- `command -v node apt nix nix-shell junest`")
    lines.append("- `node -p 'process.execPath'`")
    lines.append("- `\"${SANDWORM_BIN:-/run/sandworm/bin/sandworm}\" doctor --json | sed -n '1,80p'`")
    lines.append("- `sandworm doctor --json | sed -n '1,120p'`")
    lines.append("- Treat command output as truth; availability varies by backend/posture/host policy.")
    lines.append("")
    lines.append("## Prompting hints by provider")
    lines.append("- Codex: explicit numbered steps + exact output markers reduce drift.")
    lines.append("- Gemini: prefer direct shell-command tool calls; avoid read-file indirection for generated deep paths.")
    lines.append("- Claude: prefer Bash/Write/Edit tools directly for deterministic artifact creation.")
    lines.append("- For all providers: put proof paths in commands and keep final response short.")
    lines.append("")
    return "\n".join(lines) + "\n"


