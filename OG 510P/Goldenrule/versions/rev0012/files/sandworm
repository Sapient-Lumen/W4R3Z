      if [[ "$fetcher" == "curl" ]]; then
        if curl -fsSL "${curl_ca_argv[@]}" -o "$tmp" "$known_good_url"; then fetch_ok=1; fi
      elif [[ "$fetcher" == "wget" ]]; then
        if wget -q "${wget_ca_argv[@]}" -O "$tmp" "$known_good_url"; then fetch_ok=1; fi
      else
        python3 - "$known_good_url" "$tmp" <<'PY'
import sys
import urllib.request

url = sys.argv[1]
dst = sys.argv[2]
try:
    with urllib.request.urlopen(url) as r, open(dst, "wb") as w:
        while True:
            chunk = r.read(1024 * 1024)
            if not chunk:
                break
            w.write(chunk)
except Exception as e:
    print(f"ERROR: download failed: {e}", file=sys.stderr)
    sys.exit(1)
PY
        fetch_ok=1
      fi
      if [[ "$fetch_ok" == "1" && -z "$want_sha" && -n "${known_good_sha:-}" ]]; then
        want_sha="$known_good_sha"
      fi
    fi
    if [[ "$fetch_ok" != "1" ]]; then
      rm -f "$tmp" 2>/dev/null || true
      _sw_err "failed to download nix-portable (stage0)"
      return 1
    fi
    if ! _sw_verify_nix_portable_file "$tmp"; then
      rm -f "$tmp" 2>/dev/null || true
      _sw_err "nix-portable verification failed (download did not look like ELF/shebang binary)"
      return 1
    fi
    if [[ -n "$want_sha" ]]; then
      local got
      got="$(_sw_compute_sha256 "$tmp" || true)"
      if [[ -z "$got" ]]; then
        rm -f "$tmp" 2>/dev/null || true
        _sw_err "cannot compute sha256 for nix-portable (install sha256sum/shasum/openssl or omit pin)"
        return 1
      fi
      if [[ "$got" != "$want_sha" ]]; then
        rm -f "$tmp" 2>/dev/null || true
        _sw_err "nix-portable sha256 mismatch (got $got, want $want_sha)"
        return 1
      fi
    fi
    chmod +x "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$np_bin"
    _sw_write_toolroot_nix_wrapper
  fi

  [[ -x "$nix_bin" ]]
}

_sw_nix_path_usable() {
  local nix_path="${1:-}"
  if [[ -z "$nix_path" ]]; then
    return 1
  fi
  if [[ "$nix_path" == "/run/sandworm/toolroot/bin/nix" ]] && _sw_toolroot_dirname_shim_needs_rewrite "/run/sandworm/toolroot/bin/dirname"; then
    return 1
  fi
  return 0
}

if [[ "$(_sw_first_cmd "$@")" == "bootstrap" ]]; then
  # Strip global args before dispatching bootstrap subcommands.
  argv=("$@")
  i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    a="${argv[$i]}"
    if [[ "$a" == "-h" || "$a" == "--help" || "$a" == "--version" || "$a" == "--yes" ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--root" ]]; then
      i=$((i + 2))
      continue
    fi
    if [[ "$a" == "--root="* ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--" ]]; then
      i=$((i + 1))
      continue
    fi
    break
  done
  set -- "${argv[@]:$i}"

  shift || true
  sub="${1:-doctor}"
  if [[ $# -gt 0 ]]; then shift || true; fi

  case "$sub" in
    doctor)
      want_json=0
      for a in "$@"; do
        if [[ "$a" == "--json" ]]; then
          want_json=1
        fi
      done

      have_python=0
      if command -v python3 >/dev/null 2>&1; then
        if python3 -c 'import yaml' >/dev/null 2>&1; then
          have_python=1
        fi
      fi

      have_nix=0
      have_system_nix=0
      have_toolroot_nix=0
      nix_class="$(_sw_nix_class_for_root || true)"
      case "$nix_class" in
      system:*)
        have_nix=1
        have_system_nix=1
        ;;
      toolroot:*)
        have_nix=1
        have_toolroot_nix=1
        ;;
      esac

      offline=0
      if [[ "${SANDWORM_OFFLINE:-}" == "1" || "${SW_OFFLINE:-}" == "1" ]]; then
        offline=1
      fi
      strict_sc=0
      if [[ "${SW_STRICT_SUPPLYCHAIN:-0}" == "1" ]]; then
        strict_sc=1
      fi

      # Stage0 prerequisites.
      have_fetcher=0
      fetcher=""
      if command -v curl >/dev/null 2>&1; then
        have_fetcher=1
        fetcher="curl"
      elif command -v wget >/dev/null 2>&1; then
        have_fetcher=1
        fetcher="wget"
      elif command -v python3 >/dev/null 2>&1; then
        have_fetcher=1
        fetcher="python3"
      fi

      lf="$root/sandworm.lock"
      have_lock=0
      if [[ -f "$lf" ]]; then have_lock=1; fi
      nix_portable_url="$(_sw_parse_lock_kv nix_portable_url 2>/dev/null || true)"
      nix_portable_sha="$(_sw_parse_lock_kv nix_portable_sha256 2>/dev/null || true)"
      nixpkgs_flake="$(_sw_nixpkgs_flake_primary)"
      nixpkgs_flake_fb="$(_sw_nixpkgs_flake_fallback)"

      plan="unknown"
      if [[ "$have_python" == "1" ]]; then
        plan="python_direct"
      elif [[ "$have_nix" == "1" ]]; then
        plan="python_via_nix"
      else
        plan="stage0_nix_portable"
      fi

      warnings=()
      if [[ "$plan" == "stage0_nix_portable" && "$offline" == "1" ]]; then
        warnings+=("offline mode enabled and no python3/nix available (stage0 nix-portable bootstrap cannot run)")
      fi
      if [[ "$plan" == "stage0_nix_portable" && "$have_fetcher" != "1" ]]; then
        warnings+=("no curl/wget/python3 fetcher available for stage0 nix-portable bootstrap")
      fi
      if [[ "$plan" == "stage0_nix_portable" && ( -z "${nix_portable_sha:-}" || "${nix_portable_sha:-}" == "..." ) ]]; then
        # Avoid backticks here: they trigger command substitution in bash strings.
        warnings+=("stage0 nix-portable download is unpinned (no sha256); run: ./sandworm refresh --update (to pin)")
      fi
      # In strict supply-chain mode, encourage pinned nixpkgs refs whenever nix is available,
      # even if the current bootstrap plan would run Python directly.
      if [[ "$strict_sc" == "1" && "$have_nix" == "1" ]]; then
        if ! _sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake" && ! _sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake_fb"; then
          warnings+=("strict supply chain mode: nixpkgs flake ref looks unpinned; set SW_NIXPKGS_FLAKE or sandworm.lock [nix].nixpkgs_flake to a pinned ref")
        fi
      fi

      if [[ "$want_json" == "1" ]]; then
        # Note: keep JSON construction dependency-free.
        printf '{'
        printf '"root":"%s",' "$(_sw_json_escape "$root")"
        printf '"plan":"%s",' "$(_sw_json_escape "$plan")"
        printf '"strict_supply_chain":%s,' "$strict_sc"
        printf '"offline":%s,' "$offline"
        printf '"have_lockfile":%s,' "$have_lock"
        printf '"python":{"present":%s},' "$have_python"
        printf '"nix":{"present":%s,"system":%s,"toolroot":%s},' "$have_nix" "$have_system_nix" "$have_toolroot_nix"
        printf '"stage0":{"fetcher":"%s","have_fetcher":%s,"nix_portable_sha_pinned":%s},' \
          "$(_sw_json_escape "$fetcher")" \
          "$have_fetcher" \
          "$([[ -n "${nix_portable_sha:-}" && "${nix_portable_sha:-}" != "..." ]] && echo 1 || echo 0)"
        printf '"nixpkgs":{"primary":"%s","fallback":"%s","primary_pinned_enough":%s,"fallback_pinned_enough":%s},' \
          "$(_sw_json_escape "$nixpkgs_flake")" \
          "$(_sw_json_escape "$nixpkgs_flake_fb")" \
          "$(_sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake" && echo 1 || echo 0)" \
          "$(_sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake_fb" && echo 1 || echo 0)"
        printf '"warnings":['
        first=1
        for w in "${warnings[@]}"; do
          if [[ "$first" == "1" ]]; then first=0; else printf ','; fi
          printf '"%s"' "$(_sw_json_escape "$w")"
        done
        printf ']'
        printf '}\n'
      else
        echo "sandworm bootstrap doctor"
        echo "- root: $root"
        echo "- plan: $plan"
        echo "- strict_supply_chain: $strict_sc"
        echo "- offline: $offline"
        echo "- lockfile: $([[ "$have_lock" == "1" ]] && echo present || echo missing) ($lf)"
        echo "- python3+PyYAML: $([[ "$have_python" == "1" ]] && echo yes || echo no)"
        echo "- nix: $([[ "$have_nix" == "1" ]] && echo yes || echo no) (system=$have_system_nix toolroot=$have_toolroot_nix)"
        echo "- nixpkgs primary: $nixpkgs_flake"
        echo "- nixpkgs fallback: $nixpkgs_flake_fb"
        if [[ "$plan" == "stage0_nix_portable" ]]; then
          echo "- stage0 fetcher: ${fetcher:-none}"
          echo "- nix-portable sha pinned: $([[ -n "${nix_portable_sha:-}" && "${nix_portable_sha:-}" != "..." ]] && echo yes || echo no)"
        fi
        if [[ "${#warnings[@]}" -gt 0 ]]; then
          echo "Warnings:"
          for w in "${warnings[@]}"; do
            echo "- $w" >&2
          done
        fi
        echo "Recommended pins (for reproducible-ish bootstrap):"
        echo "- ./sandworm lock init"
        echo "- ./sandworm refresh --update"
        echo "- (optional) set SW_NIXPKGS_FLAKE to a pinned flake ref"
      fi
      exit 0
      ;;
    trace)
      # Show the wrapper-level bootstrap trace log (best-effort, no Python required).
      # Usage:
      #   sandworm bootstrap trace [--tail N]
      want_tail="200"
      for a in "$@"; do
        case "$a" in
          --tail=*)
            want_tail="${a#--tail=}"
            ;;
        esac
      done
      # shellcheck disable=SC2004
      if ! [[ "$want_tail" =~ ^[0-9]+$ ]]; then
        want_tail="200"
      fi
      lf="${SW_BOOTSTRAP_LOG_EFFECTIVE:-$root/.sandworm/logs/bootstrap/latest.log}"
      if [[ ! -f "$lf" ]]; then
        echo "bootstrap trace: missing ($lf)" >&2
        exit 2
      fi
      echo "bootstrap trace: $lf"
      # Use tail when available; otherwise fall back to a tiny awk implementation.
      if command -v tail >/dev/null 2>&1; then
        tail -n "$want_tail" "$lf" 2>/dev/null || true
      else
        awk -v n="$want_tail" '{ buf[NR%n]=$0 } END { start=NR-n+1; if(start<1) start=1; for(i=start;i<=NR;i++){ print buf[i%n] } }' "$lf" 2>/dev/null || true
      fi
      exit 0
      ;;
    verify)
      # Fail-closed verifier for bootstrap determinism. This runs without python and without nix.
      want_json=0
      for a in "$@"; do
        if [[ "$a" == "--json" ]]; then
          want_json=1
        fi
      done

      have_python=0
      if command -v python3 >/dev/null 2>&1; then
        if python3 -c 'import yaml' >/dev/null 2>&1; then
          have_python=1
        fi
      fi

      have_nix=0
      nix_class="$(_sw_nix_class_for_root || true)"
      if [[ "$nix_class" == system:* || "$nix_class" == toolroot:* ]]; then
        have_nix=1
      fi

      # Stage0 prerequisites (used when no python3+PyYAML and no nix are available, or when forced).
      fetcher="none"
      have_fetcher=0
      if command -v curl >/dev/null 2>&1; then
        fetcher="curl"
        have_fetcher=1
      elif command -v wget >/dev/null 2>&1; then
        fetcher="wget"
        have_fetcher=1
      elif command -v python3 >/dev/null 2>&1; then
        # Stage0 fetch uses plain python3; PyYAML is not required.
        fetcher="python3"
        have_fetcher=1
      fi

      have_sha=0
      if command -v sha256sum >/dev/null 2>&1; then
        have_sha=1
      elif command -v shasum >/dev/null 2>&1; then
        have_sha=1
      elif command -v openssl >/dev/null 2>&1; then
        have_sha=1
      fi

      offline=0
      if [[ "${SANDWORM_OFFLINE:-}" == "1" || "${SW_OFFLINE:-}" == "1" ]]; then
        offline=1
      fi
      strict_sc=0
      if [[ "${SW_STRICT_SUPPLYCHAIN:-0}" == "1" ]]; then
        strict_sc=1
      fi

      stage0_required=0
      forced_stage0=0
      if [[ "${SW_FORCE_STAGE0:-0}" == "1" ]]; then
        forced_stage0=1
        stage0_required=1
        # Force stage0 semantics for verifier UX: treat python/nix as unavailable even if this host
        # has absolute-path Nix installs (e.g. /run/current-system/... on NixOS). This makes
        # `bootstrap verify` a faithful "what if python+nix are missing" check.
        have_python=0
        have_nix=0
      elif [[ "$have_python" != "1" && "$have_nix" != "1" ]]; then
        stage0_required=1
      fi

      lf="$root/sandworm.lock"
      have_lock=0
      if [[ -f "$lf" ]]; then have_lock=1; fi
      nix_portable_sha="$(_sw_parse_lock_kv nix_portable_sha256 2>/dev/null || true)"
      nixpkgs_flake="$(_sw_nixpkgs_flake_primary)"
      nixpkgs_flake_fb="$(_sw_nixpkgs_flake_fallback)"

      errors=()
      warnings=()

      # Explicit CA override should never silently misconfigure bootstrap.
      if [[ -n "${SW_NIX_SSL_CERT_FILE:-}" && ! -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
        errors+=("bootstrap: SW_NIX_SSL_CERT_FILE is set but not readable; remediation: unset it, or set it to a readable CA bundle path (e.g. /etc/ssl/certs/ca-certificates.crt)")
      fi
      if [[ -n "${SSL_CERT_FILE:-}" && ! -r "${SSL_CERT_FILE:-}" ]]; then
        warnings+=("bootstrap: SSL_CERT_FILE is set but not readable; ignoring it")
      fi
      if [[ -n "${CURL_CA_BUNDLE:-}" && ! -r "${CURL_CA_BUNDLE:-}" ]]; then
        warnings+=("bootstrap: CURL_CA_BUNDLE is set but not readable; ignoring it")
      fi

      # In strict mode, require pins for the pieces the wrapper may need.
      if [[ "$strict_sc" == "1" ]]; then
        if [[ "$have_lock" != "1" ]]; then
          errors+=("strict supply chain mode: sandworm.lock is missing; remediation: run ./sandworm lock init; ./sandworm refresh --update")
        fi

        if [[ -z "${nix_portable_sha:-}" || "${nix_portable_sha:-}" == "..." ]]; then
          # This affects stage0 (no python/nix) and toolroot refresh pinning.
          errors+=("strict supply chain mode: toolroot.nix_portable_sha256 is not pinned; remediation: run ./sandworm refresh --update")
        fi

        junest_sha="$(_sw_parse_lock_kv junest_sha256 2>/dev/null || true)"
        if [[ -z "${junest_sha:-}" || "${junest_sha:-}" == "..." ]]; then
          errors+=("strict supply chain mode: toolroot.junest_sha256 is not pinned; remediation: run ./sandworm refresh --update")
        fi

        if ! _sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake" && ! _sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake_fb"; then
          errors+=("strict supply chain mode: nixpkgs flake ref must be pinned; remediation: set SW_NIXPKGS_FLAKE (or sandworm.lock [nix].nixpkgs_flake) to a pinned ref, or run ./sandworm refresh --update")
        fi

        if [[ "$stage0_required" == "1" && "$offline" != "1" && "$have_sha" != "1" ]]; then
          errors+=("strict supply chain mode: bootstrap stage0 requires sha256sum/shasum/openssl; remediation: install coreutils (sha256sum) or perl (shasum) or openssl (openssl dgst)")
        fi
      else
        # Non-strict: warn when obviously floating.
        if [[ "$nixpkgs_flake" == "nixpkgs" ]]; then
          warnings+=("nixpkgs flake ref is floating (nixpkgs registry); pin it in sandworm.lock [nix] for reproducible bootstrap")
        fi
        if [[ -z "${nix_portable_sha:-}" || "${nix_portable_sha:-}" == "..." ]]; then
          # Avoid backticks here: they trigger command substitution in bash strings.
          warnings+=("nix-portable sha256 is unpinned; run: ./sandworm refresh --update (to pin)")
        fi
      fi

      # Help the user understand what bootstrap plan is even possible.
      if [[ "$have_python" != "1" && "$have_nix" != "1" ]]; then
        if [[ "$offline" == "1" ]]; then
          errors+=("offline mode enabled but neither python3 nor nix is available; remediation: unset SW_OFFLINE (or install python3 or nix)")
        fi
      fi

      if [[ "$offline" != "1" && "$stage0_required" == "1" && "$have_fetcher" != "1" ]]; then
        errors+=("bootstrap stage0 requires curl, wget, or python3; remediation: install curl or wget (or install python3)")
      fi

      # If stage0 is required and we're online, we need a usable CA bundle for HTTPS downloads.
      if [[ "$offline" != "1" && "$stage0_required" == "1" && "$have_fetcher" == "1" && "$fetcher" != "python3" ]]; then
        ca_ok=0
        if [[ -n "${SW_NIX_SSL_CERT_FILE:-}" && -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
          ca_ok=1
        elif [[ -n "${SSL_CERT_FILE:-}" && -r "${SSL_CERT_FILE:-}" ]]; then
          ca_ok=1
        elif [[ -n "${CURL_CA_BUNDLE:-}" && -r "${CURL_CA_BUNDLE:-}" ]]; then
          ca_ok=1
        elif [[ -r "/etc/ssl/certs/ca-certificates.crt" ]]; then
          ca_ok=1
        elif [[ -r "/etc/pki/tls/certs/ca-bundle.crt" ]]; then
          ca_ok=1
        elif [[ -r "/etc/ssl/certs/ca-bundle.crt" ]]; then
          ca_ok=1
        else
          # NixOS and some sandbox substrates keep CA bundles in the nix store; /etc paths may be
          # missing or symlinked in ways that break inside emptyroots. Prefer nss-cacert/cacert.
          for cand in \
            /nix/store/*-nss-cacert-*/etc/ssl/certs/ca-bundle.crt \
            /nix/store/*-cacert-*/etc/ssl/certs/ca-bundle.crt; do
            if [[ -r "$cand" ]]; then
              ca_ok=1
              break
            fi
          done
        fi
        if [[ "$ca_ok" != "1" ]]; then
          errors+=("bootstrap stage0: missing CA bundle; remediation: install ca-certificates, or set SW_NIX_SSL_CERT_FILE=/path/to/ca-bundle.crt")
        fi
      fi

      ok=1
      if [[ "${#errors[@]}" -gt 0 ]]; then
        ok=0
      fi

      if [[ "$want_json" == "1" ]]; then
        printf '{'
        printf '"ok":%s,' "$ok"
        printf '"strict_supply_chain":%s,' "$strict_sc"
        printf '"offline":%s,' "$offline"
        printf '"have_lockfile":%s,' "$have_lock"
        printf '"pins":{"nix_portable_sha_pinned":%s,"nixpkgs_primary_pinned":%s,"nixpkgs_fallback_pinned":%s},' \
          "$([[ -n "${nix_portable_sha:-}" && "${nix_portable_sha:-}" != "..." ]] && echo 1 || echo 0)" \
          "$(_sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake" && echo 1 || echo 0)" \
          "$(_sw_nixpkgs_ref_is_pinned_enough "$nixpkgs_flake_fb" && echo 1 || echo 0)"
        printf '"nixpkgs":{"primary":"%s","fallback":"%s"},' \
          "$(_sw_json_escape "$nixpkgs_flake")" \
          "$(_sw_json_escape "$nixpkgs_flake_fb")"
        printf '"errors":['
        first=1
        for e in "${errors[@]}"; do
          if [[ "$first" == "1" ]]; then first=0; else printf ','; fi
          printf '"%s"' "$(_sw_json_escape "$e")"
        done
        printf '],'
        printf '"warnings":['
        first=1
        for w in "${warnings[@]}"; do
          if [[ "$first" == "1" ]]; then first=0; else printf ','; fi
          printf '"%s"' "$(_sw_json_escape "$w")"
        done
        printf ']'
        printf '}\n'
      else
        if [[ "$ok" == "1" ]]; then
          echo "bootstrap verify: OK"
        else
          echo "bootstrap verify: FAIL" >&2
        fi
        for e in "${errors[@]}"; do
          _sw_err "$e"
        done
        for w in "${warnings[@]}"; do
          _sw_note "WARNING: $w"
        done
        echo "pins:"
        echo "- nixpkgs primary: $nixpkgs_flake"
        echo "- nixpkgs fallback: $nixpkgs_flake_fb"
        echo "- nix-portable sha pinned: $([[ -n "${nix_portable_sha:-}" && "${nix_portable_sha:-}" != "..." ]] && echo yes || echo no)"
      fi

      if [[ "$ok" == "1" ]]; then
        exit 0
      fi
      # In non-strict mode, `bootstrap verify --json` is a diagnostic report (like `doctor`):
      # signal status via the JSON body, not the process exit code. Strict mode (and explicit
      # stage0 forcing) still fail closed.
      if [[ "$want_json" == "1" && "$strict_sc" != "1" && "${forced_stage0:-0}" != "1" ]]; then
        exit 0
      fi
      exit 2
      ;;
    clean)
      want_json=0
      for a in "$@"; do
        if [[ "$a" == "--json" ]]; then
          want_json=1
        fi
      done

      deleted=()
      warnings=()

      # nix-portable may create a read-only store; make it writable before deleting.
      _sw_rm_np() {
        local base="$1"
        if [[ -z "$base" ]]; then
          return 0
        fi
        if [[ -d "$base/.nix-portable" ]]; then
          chmod -R u+w "$base/.nix-portable/nix/store" 2>/dev/null || true
          rm -rf "$base/.nix-portable" 2>/dev/null || true
          if [[ ! -e "$base/.nix-portable" ]]; then
            deleted+=("$base/.nix-portable")
          else
            warnings+=("failed to delete: $base/.nix-portable")
          fi
        fi
      }

      _sw_rm_np "${NP_LOCATION:-}"
      _sw_rm_np "$root/.sandworm/nix-portable"
      _sw_rm_np "$root/.sandworm/toolroot/nix-portable"
      _sw_rm_np "$root/nix-portable"
      _sw_rm_np "$root/.sandworm/home/.nix-portable"

      if [[ -f "$root/.sandworm/toolroot/bin/nix-portable" ]]; then
        rm -f "$root/.sandworm/toolroot/bin/nix-portable" 2>/dev/null || true
        if [[ ! -e "$root/.sandworm/toolroot/bin/nix-portable" ]]; then
          deleted+=("$root/.sandworm/toolroot/bin/nix-portable")
        else
          warnings+=("failed to delete: $root/.sandworm/toolroot/bin/nix-portable")
        fi
      fi
	      if [[ -f "$root/.sandworm/toolroot/bin/nix" ]]; then
	        rm -f "$root/.sandworm/toolroot/bin/nix" 2>/dev/null || true
	        if [[ ! -e "$root/.sandworm/toolroot/bin/nix" ]]; then
	          deleted+=("$root/.sandworm/toolroot/bin/nix")
	        else
	          warnings+=("failed to delete: $root/.sandworm/toolroot/bin/nix")
	        fi
	      fi

	      # Rootless podman may use shifted UID/GID ownership under the store; plain `rm -rf` can fail.
	      if [[ -d "$root/.sandworm/podman" ]]; then
	        podman_bin=""
	        if command -v podman >/dev/null 2>&1; then
	          podman_bin="$(command -v podman)"
	        elif [[ -x "$root/.sandworm/toolroot/bin/podman" ]]; then
	          podman_bin="$root/.sandworm/toolroot/bin/podman"
	        fi
	        if [[ -n "$podman_bin" ]]; then
	          "$podman_bin" unshare rm -rf "$root/.sandworm/podman" >/dev/null 2>&1 || true
	        fi
	        rm -rf "$root/.sandworm/podman" 2>/dev/null || true
	        if [[ ! -e "$root/.sandworm/podman" ]]; then
	          deleted+=("$root/.sandworm/podman")
	        else
	          if [[ -z "$podman_bin" ]]; then
	            warnings+=("podman store exists but podman is not available to delete it safely: $root/.sandworm/podman")
	          fi
	          warnings+=("failed to delete: $root/.sandworm/podman (try: podman unshare rm -rf \"$root/.sandworm/podman\")")
	        fi
	      fi

	      ok=1
	      if [[ "${#warnings[@]}" -gt 0 ]]; then ok=0; fi

      if [[ "$want_json" == "1" ]]; then
        printf '{'
        printf '"ok":%s,' "$ok"
        printf '"deleted":['
        first=1
        for d in "${deleted[@]}"; do
          if [[ "$first" == "1" ]]; then first=0; else printf ','; fi
          printf '"%s"' "$(_sw_json_escape "$d")"
        done
        printf '],'
        printf '"warnings":['
        first=1
        for w in "${warnings[@]}"; do
          if [[ "$first" == "1" ]]; then first=0; else printf ','; fi
          printf '"%s"' "$(_sw_json_escape "$w")"
        done
        printf ']'
        printf '}\n'
      else
        if [[ "$ok" == "1" ]]; then
          echo "bootstrap clean: OK"
        else
          echo "bootstrap clean: WARNINGS" >&2
        fi
        for d in "${deleted[@]}"; do
          echo "- deleted: $d"
        done
        for w in "${warnings[@]}"; do
          _sw_note "WARNING: $w"
        done
      fi
      exit $([[ "$ok" == "1" ]] && echo 0 || echo 2)
      ;;
    *)
      _sw_err "unknown bootstrap subcommand: $sub"
      _sw_err "usage: ./sandworm bootstrap doctor|verify|clean [--json]"
      exit 2
      ;;
  esac
fi

have_python=0
if command -v python3 >/dev/null 2>&1; then
  need_yaml=0
  need_tomlkit=0
  cmd="$(_sw_first_cmd "$@")"
  if _sw_help_requested "$@"; then
    need_yaml=0
    need_tomlkit=0
  fi
  case "${cmd:-}" in
    queue|loop) need_yaml=1 ;;
    lock) need_tomlkit=1 ;;
    refresh)
      for a in "$@"; do
        if [[ "$a" == "--update" ]]; then
          need_tomlkit=1
          break
        fi
      done
      ;;
    setup)
      have_update_lock=0
      have_dry_run=0
      for a in "$@"; do
        if [[ "$a" == "--update-lock" ]]; then have_update_lock=1; fi
        if [[ "$a" == "--dry-run" ]]; then have_dry_run=1; fi
      done
      if [[ "$have_update_lock" == "1" && "$have_dry_run" != "1" ]]; then
        need_tomlkit=1
      fi
      ;;
    kvm)
      for a in "$@"; do
        if [[ "$a" == "--update-lock" ]]; then
          need_tomlkit=1
          break
        fi
      done
      ;;
    clients)
      for a in "$@"; do
        if [[ "$a" == "--update-lock" ]]; then
          need_tomlkit=1
          break
        fi
      done
      ;;
    codex|gemini|claude|auth)
      if [[ "${SW_STRICT_SUPPLYCHAIN:-0}" == "1" ]]; then
        need_tomlkit=1
      fi
      ;;
  esac
  if [[ "$need_yaml" == "1" && "$need_tomlkit" == "1" ]]; then
    if python3 -c 'import yaml, tomlkit' >/dev/null 2>&1; then have_python=1; fi
  elif [[ "$need_yaml" == "1" ]]; then
    if python3 -c 'import yaml' >/dev/null 2>&1; then have_python=1; fi
  elif [[ "$need_tomlkit" == "1" ]]; then
    if python3 -c 'import tomlkit' >/dev/null 2>&1; then have_python=1; fi
  else
    if python3 -c 'pass' >/dev/null 2>&1; then have_python=1; fi
  fi
fi

if [[ "$have_python" == "1" ]]; then
  _sw_envfs_mode_raw="${SW_BOOTSTRAP_ENVFS_HEALTHCHECK:-${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK:-auto}}"
  _sw_envfs_mode="${_sw_envfs_mode_raw,,}"
  _sw_envfs_enabled=1
  case "$_sw_envfs_mode" in
    0|false|no|off|n|disable|disabled) _sw_envfs_enabled=0 ;;
    auto|"")
      if ! awk '$1 ~ /(^|\/)envfs$/ && $3 == "fuse" && ($2 == "/bin" || $2 == "/usr/bin") { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts >/dev/null 2>&1; then
        _sw_envfs_enabled=0
      fi
      ;;
  esac
  if [[ "$_sw_envfs_enabled" == "1" ]]; then
    _sw_envfs_timeout_s="${SW_BOOTSTRAP_ENVFS_HEALTHCHECK_TIMEOUT_S:-${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK_TIMEOUT_S:-1}}"
    if [[ -z "${_sw_envfs_timeout_s:-}" || ! "${_sw_envfs_timeout_s}" =~ ^[0-9]+$ ]]; then
      _sw_envfs_timeout_s=1
    fi
    if [[ "$_sw_envfs_timeout_s" -lt 1 ]]; then _sw_envfs_timeout_s=1; fi
    if [[ "$_sw_envfs_timeout_s" -gt 10 ]]; then _sw_envfs_timeout_s=10; fi
    _sw_timeout_bin=""
    for _sw_c in /run/current-system/sw/bin/timeout /usr/bin/timeout /bin/timeout; do
      if [[ -x "$_sw_c" ]]; then _sw_timeout_bin="$_sw_c"; break; fi
    done
    if [[ -z "${_sw_timeout_bin:-}" ]] && command -v timeout >/dev/null 2>&1; then
      _sw_timeout_bin="$(command -v timeout)"
    fi
    _sw_stat_bin=""
    for _sw_c in /run/current-system/sw/bin/stat /usr/bin/stat /bin/stat; do
      if [[ -x "$_sw_c" ]]; then _sw_stat_bin="$_sw_c"; break; fi
    done
    if [[ -z "${_sw_stat_bin:-}" ]] && command -v stat >/dev/null 2>&1; then
      _sw_stat_bin="$(command -v stat)"
    fi
    _sw_envfs_ok=1
    _sw_envfs_fail_detail=""
    if [[ "${SW_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL:-0}" == "1" || "${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL:-0}" == "1" ]]; then
      _sw_envfs_ok=0
      _sw_envfs_fail_detail="forced failure via SW_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL"
    elif [[ -n "${_sw_timeout_bin:-}" && -n "${_sw_stat_bin:-}" ]]; then
      for _sw_p in /usr/bin /bin; do
        _sw_envfs_tmp_err="${TMPDIR:-/tmp}/sandworm-envfs-probe.$$.$RANDOM.err"
        "$_sw_timeout_bin" "$_sw_envfs_timeout_s" "$_sw_stat_bin" -f "$_sw_p" >/dev/null 2>"$_sw_envfs_tmp_err"
        _sw_rc=$?
        if [[ "$_sw_rc" -ne 0 ]]; then
          _sw_envfs_ok=0
          _sw_errtxt="$(cat "$_sw_envfs_tmp_err" 2>/dev/null || true)"
          rm -f "$_sw_envfs_tmp_err" >/dev/null 2>&1 || true
          if [[ "$_sw_rc" -eq 1 ]] && printf '%s' "$_sw_errtxt" | grep -qi "No such file or directory"; then
            _sw_envfs_ok=1
            _sw_envfs_fail_detail="path=$_sw_p timeout_s=$_sw_envfs_timeout_s rc=$_sw_rc err=ENOENT (degraded envfs, non-blocking)"
            continue
          fi
          _sw_envfs_fail_detail="path=$_sw_p timeout_s=$_sw_envfs_timeout_s rc=$_sw_rc timeout_bin=$_sw_timeout_bin stat_bin=$_sw_stat_bin err=${_sw_errtxt:-none}"
          break
        fi
        rm -f "$_sw_envfs_tmp_err" >/dev/null 2>&1 || true
      done
      if [[ -n "${_sw_envfs_fail_detail:-}" && "$_sw_envfs_ok" == "1" ]]; then
        _sw_bootstrap_log warn "bootstrap: envfs probe degraded but non-blocking detail=${_sw_envfs_fail_detail}"
      fi
    fi
    if [[ "$_sw_envfs_ok" != "1" ]]; then
      _sw_err "bootstrap blocked: /usr/bin or /bin appears unresponsive (envfs/FUSE). Refusing to continue to avoid host lockup."
      if [[ -n "${_sw_envfs_fail_detail:-}" ]]; then
        _sw_err "hint: envfs probe detail: ${_sw_envfs_fail_detail}"
      fi
      _sw_err "hint: recover envfs/FUSE health first; temporary override: SW_BOOTSTRAP_ENVFS_HEALTHCHECK=0"
      exit 2
    fi
  fi
  exec python3 -m sandworm_core --root "$root" "${forward_argv[@]}"
fi

# Stage0 fallback: `nix-portable nix-shell` can run the Python core inside a restricted user namespace
# (no capabilities; cannot create nested user namespaces), which makes bwrap unusable. When Python
# is not available and the user explicitly asks for `run --backend bwrap`, handle it directly here
# in the wrapper so it runs in the initial namespace.
_sw_stage0_run_bwrap() {
  local -a argv=("$@")
  local backend=""
  local offline=0
  local cwd="/workspace"
  local posture="safe"
  local i=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    case "$a" in
      --backend)
        backend="${argv[$((i + 1))]:-}"
        i=$((i + 2))
        continue
        ;;
      --backend=*)
        backend="${a#--backend=}"
        i=$((i + 1))
        continue
        ;;
      --offline)
        offline=1
        i=$((i + 1))
        continue
        ;;
      --network)
        local v="${argv[$((i + 1))]:-}"
        if [[ "$v" == "none" ]]; then
          offline=1
        fi
        i=$((i + 2))
        continue
        ;;
      --network=*)
        local v="${a#--network=}"
        if [[ "$v" == "none" ]]; then
          offline=1
        fi
        i=$((i + 1))
        continue
        ;;
      --cwd|--chdir)
        cwd="${argv[$((i + 1))]:-}"
        i=$((i + 2))
        continue
        ;;
      --cwd=*|--chdir=*)
        cwd="${a#*=}"
        i=$((i + 1))
        continue
        ;;
      --posture)
        local v="${argv[$((i + 1))]:-}"
        case "$v" in
          safe|unsafe|take-the-wheel) posture="$v" ;;
          *) _sw_err "run: invalid --posture value: $v (expected safe|unsafe|take-the-wheel)"; return 2 ;;
        esac
        i=$((i + 2))
        continue
        ;;
      --posture=*)
        local v="${a#--posture=}"
        case "$v" in
          safe|unsafe|take-the-wheel) posture="$v" ;;
          *) _sw_err "run: invalid --posture value: $v (expected safe|unsafe|take-the-wheel)"; return 2 ;;
        esac
        i=$((i + 1))
        continue
        ;;
      --UNSAFE)
        posture="unsafe"
        i=$((i + 1))
        continue
        ;;
      --TAKE-THE-WHEEL)
        posture="take-the-wheel"
        i=$((i + 1))
        continue
        ;;
      -h|--help)
        cat <<'EOF'
sandworm run (stage0 fallback)

This is a minimal fallback that only supports:
  sandworm run --backend bwrap [--posture safe|unsafe|take-the-wheel] -- <cmd> [args...]
EOF
        exit 0
        ;;
      --)
        i=$((i + 1))
        break
        ;;
      *)
        i=$((i + 1))
        continue
        ;;
    esac
  done
  local -a cmd_argv=("${argv[@]:$i}")

  if [[ "${backend:-}" != "bwrap" ]]; then
    _sw_err "stage0 wrapper fallback only supports: sandworm run --backend bwrap -- <cmd> ..."
    return 2
  fi
  if [[ "${#cmd_argv[@]}" -eq 0 ]]; then
    _sw_err "run: missing command (expected: -- <cmd> ...)"
    return 2
  fi

  local bwrap=""
  bwrap="$(command -v bwrap 2>/dev/null || true)"
  if [[ -z "$bwrap" ]]; then
    _sw_err "bwrap not available (install bubblewrap)"
    return 2
  fi

  mkdir -p "$root/.sandworm/home/tmp" >/dev/null 2>&1 || true
  mkdir -p "$root/shared" >/dev/null 2>&1 || true
  mkdir -p "$root/.sandworm/clients" "$root/.sandworm/toolroot" "$root/.sandworm/hooks" >/dev/null 2>&1 || true
  mkdir -p "$root/.sandworm/mask-empty/private" >/dev/null 2>&1 || true
  # Minimal self-docs expected by stage0 runner semantics tests.
  if [[ ! -f "$root/.sandworm/home/SANDWORM_CAPS.json" ]]; then
    printf '%s\n' '{"caps":{"bwrap":true},"stage0":1}' >"$root/.sandworm/home/SANDWORM_CAPS.json" 2>/dev/null || true
  fi
  if [[ ! -f "$root/.sandworm/home/SANDWORM_RUNBOOK.md" ]]; then
    printf '%b' '# Sandworm (stage0)\n\n(run backend=bwrap)\n' >"$root/.sandworm/home/SANDWORM_RUNBOOK.md" 2>/dev/null || true
  fi

  local ts=""
  ts="$(date -u +%Y%m%d-%H%M%S 2>/dev/null || date +%Y%m%d-%H%M%S)"
  local run_id="${ts}-$$-${RANDOM}"
  local run_dir="$root/.sandworm/runs/$run_id"
  local logs_dir="$run_dir/steps/run/logs"
  mkdir -p "$logs_dir" >/dev/null 2>&1 || true

  local tmp_out tmp_err
  tmp_out="$(mktemp "${TMPDIR:-/tmp}/sandworm-run.XXXXXX" 2>/dev/null || mktemp "/tmp/sandworm-run.XXXXXX")"
  tmp_err="$(mktemp "${TMPDIR:-/tmp}/sandworm-run.XXXXXX" 2>/dev/null || mktemp "/tmp/sandworm-run.XXXXXX")"

  local -a bwrap_cmd
  bwrap_cmd=("$bwrap" "--die-with-parent" "--new-session" "--unshare-all")
  if [[ "$offline" != "1" ]]; then
    bwrap_cmd+=("--share-net")
  fi
  bwrap_cmd+=("--proc" "/proc" "--dev-bind" "/dev" "/dev")

  # Minimal host filesystem views (read-only where possible).
  if [[ -d "/usr" ]]; then bwrap_cmd+=("--ro-bind" "/usr" "/usr"); fi
  if [[ -d "/lib" ]]; then bwrap_cmd+=("--ro-bind" "/lib" "/lib"); fi
  if [[ -d "/lib64" ]]; then bwrap_cmd+=("--ro-bind" "/lib64" "/lib64"); fi
  if [[ -d "/etc" ]]; then bwrap_cmd+=("--ro-bind" "/etc" "/etc"); fi
  if [[ -d "/bin" ]]; then bwrap_cmd+=("--ro-bind" "/bin" "/bin"); fi
  # On some distros (e.g., NixOS), /bin and /usr/bin entries are symlinks into /nix/store.
  # Without a /nix bind, even `sh` may not exist inside the sandbox.
  if [[ -d "/nix" ]]; then bwrap_cmd+=("--ro-bind" "/nix" "/nix"); fi

  # Workspace + control plane masking.
  bwrap_cmd+=("--dir" "/workspace" "--bind" "$root" "/workspace")
  bwrap_cmd+=("--ro-bind" "$root/.sandworm/mask-empty" "/workspace/.sandworm")

  # Home.
  bwrap_cmd+=("--dir" "/home" "--dir" "/home/sandworm" "--bind" "$root/.sandworm/home" "/home/sandworm")
  bwrap_cmd+=("--dir" "/run/sandworm/home" "--bind" "$root/.sandworm/home" "/run/sandworm/home")

  # Writable temp + minimal /var + /run.
  bwrap_cmd+=("--tmpfs" "/tmp" "--dir" "/var" "--dir" "/var/tmp" "--dir" "/run" "--dir" "/run/sandworm")

  # Shared handoff folder (host ./shared -> /srv/shared).
  bwrap_cmd+=("--dir" "/srv" "--dir" "/srv/shared" "--bind" "$root/shared" "/srv/shared")

  # Sandworm-managed directories (read-only; keep control-plane masked).
  bwrap_cmd+=("--dir" "/run/sandworm/clients" "--ro-bind" "$root/.sandworm/clients" "/run/sandworm/clients")
  bwrap_cmd+=("--dir" "/run/sandworm/toolroot" "--ro-bind" "$root/.sandworm/toolroot" "/run/sandworm/toolroot")
  bwrap_cmd+=("--dir" "/run/sandworm/hooks" "--ro-bind" "$root/.sandworm/hooks" "/run/sandworm/hooks")

  # TAKE-THE-WHEEL: explicitly mount host root at /host (rw; extremely dangerous).
  if [[ "$posture" == "take-the-wheel" ]]; then
    bwrap_cmd+=("--dir" "/host" "--bind" "/" "/host")
  fi

  # Env.
  bwrap_cmd+=("--setenv" "HOME" "/run/sandworm/home")
  bwrap_cmd+=("--setenv" "SANDWORM_HOME" "/run/sandworm/home")
  bwrap_cmd+=("--setenv" "TMPDIR" "/run/sandworm/home/tmp")
  bwrap_cmd+=("--setenv" "SANDWORM_BACKEND" "bwrap")
  bwrap_cmd+=("--setenv" "SANDWORM_POSTURE" "$posture")
  if [[ "$posture" == "take-the-wheel" ]]; then
    bwrap_cmd+=("--setenv" "SANDWORM_TAKE_THE_WHEEL" "1")
  fi
  bwrap_cmd+=("--setenv" "PATH" "/usr/bin:/bin:/run/sandworm/toolroot/bin")

  if [[ -n "${cwd:-}" ]]; then
    bwrap_cmd+=("--chdir" "$cwd")
  fi

  bwrap_cmd+=("${cmd_argv[@]}")

  set +e
  "${bwrap_cmd[@]}" >"$tmp_out" 2>"$tmp_err"
  local rc="$?"
  set -e

  cat "$tmp_out" >"$logs_dir/stdout.txt" 2>/dev/null || true
  cat "$tmp_err" >"$logs_dir/stderr.txt" 2>/dev/null || true
  cat "$tmp_out" || true
  cat "$tmp_err" >&2 || true
  rm -f "$tmp_out" "$tmp_err" >/dev/null 2>&1 || true
  return "$rc"
}

cmd="$(_sw_first_cmd "$@")"
if [[ "${cmd:-}" == "run" ]]; then
  # Only intercept explicit bwrap runs; other backends still require the Python core.
  want_bwrap=0
  i=1
  while [[ "$i" -lt "${#forward_argv[@]}" ]]; do
    a="${forward_argv[$i]}"
    [[ "$a" == "--" ]] && break
    if [[ "$a" == "--backend" ]]; then
      v="${forward_argv[$((i + 1))]:-}"
      [[ "$v" == "bwrap" ]] && want_bwrap=1
      break
    fi
    if [[ "$a" == "--backend=bwrap" ]]; then
      want_bwrap=1
      break
    fi
    i=$((i + 1))
  done
  if [[ "$want_bwrap" == "1" ]]; then
    # Only use the stage0 fallback when we're genuinely in a "no python + no nix on PATH" bootstrap posture.
    # On hosts with nix available, prefer the Python core (via nix) so full `sandworm run` semantics (shares, etc)
    # remain available.
    if ! command -v nix >/dev/null 2>&1 && ! command -v python3 >/dev/null 2>&1; then
      _sw_stage0_run_bwrap "${forward_argv[@]:1}"
      exit "$?"
    fi
  fi
fi

need_yaml=0
case "${cmd:-}" in
  queue|loop) need_yaml=1 ;;
esac
need_tomlkit=0
case "${cmd:-}" in
  lock) need_tomlkit=1 ;;
  refresh)
    for a in "$@"; do
      if [[ "$a" == "--update" ]]; then
        need_tomlkit=1
        break
      fi
    done
    ;;
  kvm)
    for a in "$@"; do
      if [[ "$a" == "--update-lock" ]]; then
        need_tomlkit=1
        break
      fi
    done
    ;;
  clients)
    for a in "$@"; do
      if [[ "$a" == "--update-lock" ]]; then
        need_tomlkit=1
        break
      fi
    done
    ;;
  codex|gemini|claude|auth)
    if [[ "${SW_STRICT_SUPPLYCHAIN:-0}" == "1" || "${SANDWORM_STRICT_SUPPLYCHAIN:-0}" == "1" ]]; then
      need_tomlkit=1
    fi
    ;;
esac
if _sw_help_requested "$@"; then
  need_yaml=0
  need_tomlkit=0
fi

provider_live_bootstrap=0
case "${cmd:-}" in
  codex|gemini|claude|auth)
    provider_live_bootstrap=1
    ;;
esac

_sw_find_host_python_for_bootstrap() {
  local cand
  for cand in python3.12 python3.11 python3.10 python3; do
    if command -v "$cand" >/dev/null 2>&1; then
      if "$cand" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
        echo "$cand"
        return 0
      fi
    fi
  done
  return 1
}

_sw_find_host_timeout_bin() {
  local c=""
  for c in /run/current-system/sw/bin/timeout /usr/bin/timeout /bin/timeout; do
    if [[ -x "$c" ]]; then
      echo "$c"
      return 0
    fi
  done
  if command -v timeout >/dev/null 2>&1; then
    command -v timeout
    return 0
  fi
  return 1
}

_sw_find_host_stat_bin() {
  local c=""
  for c in /run/current-system/sw/bin/stat /usr/bin/stat /bin/stat; do
    if [[ -x "$c" ]]; then
      echo "$c"
      return 0
    fi
  done
  if command -v stat >/dev/null 2>&1; then
    command -v stat
    return 0
  fi
  return 1
}

_sw_envfs_mount_active() {
  [[ -r /proc/mounts ]] || return 1
  awk '
    $1 ~ /(^|\/)envfs$/ && $3 == "fuse" && ($2 == "/bin" || $2 == "/usr/bin") { found=1 }
    END { exit(found ? 0 : 1) }
  ' /proc/mounts >/dev/null 2>&1
}

_sw_envfs_health_check() {
  _sw_envfs_health_detail=""
  local mode_raw="${SW_BOOTSTRAP_ENVFS_HEALTHCHECK:-${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK:-auto}}"
  local mode="${mode_raw,,}"
  local enabled=1
  local timeout_s="${SW_BOOTSTRAP_ENVFS_HEALTHCHECK_TIMEOUT_S:-${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK_TIMEOUT_S:-1}}"
  if [[ -z "${timeout_s:-}" || ! "${timeout_s}" =~ ^[0-9]+$ ]]; then
    timeout_s=1
  fi
  if [[ "$timeout_s" -lt 1 ]]; then timeout_s=1; fi
  if [[ "$timeout_s" -gt 10 ]]; then timeout_s=10; fi
  case "$mode" in
    0|false|no|off|n|disable|disabled)
      enabled=0
      ;;
    auto|"")
      if ! _sw_envfs_mount_active; then
        enabled=0
      fi
      ;;
    *)
      enabled=1
      ;;
  esac
  [[ "$enabled" == "1" ]] || return 0

  if [[ "${SW_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL:-0}" == "1" || "${SANDWORM_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL:-0}" == "1" ]]; then
    _sw_envfs_health_detail="forced failure via SW_BOOTSTRAP_ENVFS_HEALTHCHECK_FORCE_FAIL"
    return 1
  fi

  local tbin=""
  local sbin=""
  tbin="$(_sw_find_host_timeout_bin || true)"
  sbin="$(_sw_find_host_stat_bin || true)"
  if [[ -z "${tbin:-}" || -z "${sbin:-}" ]]; then
    # No bounded probe available; do not block startup.
    return 0
  fi

  local p=""
  for p in /usr/bin /bin; do
    local tmp_err="${TMPDIR:-/tmp}/sandworm-envfs-probe.$$.$RANDOM.err"
    "$tbin" "$timeout_s" "$sbin" -f "$p" >/dev/null 2>"$tmp_err"
    local rc=$?
    if [[ "$rc" -ne 0 ]]; then
      local errtxt
      errtxt="$(cat "$tmp_err" 2>/dev/null || true)"
      rm -f "$tmp_err" >/dev/null 2>&1 || true
      if [[ "$rc" -eq 1 ]] && printf '%s' "$errtxt" | grep -qi "No such file or directory"; then
        _sw_envfs_health_detail="path=$p timeout_s=$timeout_s rc=$rc err=ENOENT (degraded envfs, non-blocking)"
        continue
      fi
      _sw_envfs_health_detail="path=$p timeout_s=$timeout_s rc=$rc timeout_bin=$tbin stat_bin=$sbin err=${errtxt:-none}"
      return 1
    fi
    rm -f "$tmp_err" >/dev/null 2>&1 || true
  done
  return 0
}

sw_nix_override="${SW_NIX:-${SANDWORM_NIX:-}}"
sw_bootstrap_prefer_nix="${SW_BOOTSTRAP_PREFER_NIX:-${SANDWORM_BOOTSTRAP_PREFER_NIX:-0}}"

if ! _sw_envfs_health_check; then
  _sw_bootstrap_log warn "bootstrap: envfs health check failed (paths /usr/bin or /bin are unresponsive) detail=${_sw_envfs_health_detail:-none}"
  _sw_err "bootstrap blocked: /usr/bin or /bin appears unresponsive (envfs/FUSE). Refusing to continue to avoid host lockup."
  if [[ -n "${_sw_envfs_health_detail:-}" ]]; then
    _sw_err "hint: envfs probe detail: ${_sw_envfs_health_detail}"
  fi
  _sw_err "hint: recover envfs/FUSE health first; temporary override: SW_BOOTSTRAP_ENVFS_HEALTHCHECK=0"
  exit 2
fi
if [[ -n "${_sw_envfs_health_detail:-}" ]]; then
  _sw_bootstrap_log warn "bootstrap: envfs probe degraded but non-blocking detail=${_sw_envfs_health_detail}"
fi

