from __future__ import annotations

import json
import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from .stateroot import control_dir

_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


@dataclass(frozen=True)
class Share:
    name: str
    src: str
    mode: str  # ro|rw

    def dest(self) -> str:
        return f"/workspace/shared/{self.name}"


def shares_path(root: Path) -> Path:
    # Prefer control-plane location; allow repo-local shared/shares.json for portability.
    cp = control_dir(root) / "shares.json"
    if cp.exists():
        return cp
    return root / "shared" / "shares.json"


def _validate_share(name: str, data: dict[str, Any]) -> Share:
    if not _NAME_RE.match(name) or "/" in name or name in (".", ".."):
        raise ValueError(f"invalid share name: {name!r}")
    if not isinstance(data, dict):
        raise ValueError(f"share {name}: must be an object")
    src = data.get("src")
    mode = (data.get("mode") or "ro").strip().lower()
    if not isinstance(src, str) or not src.strip():
        raise ValueError(f"share {name}: missing src")
    if "," in src:
        raise ValueError(f"share {name}: src must not contain ',' (qemu -fsdev parsing limitation)")
    if mode not in ("ro", "rw"):
        raise ValueError(f"share {name}: invalid mode (expected ro|rw)")
    sp = Path(src).expanduser()
    if not sp.is_absolute():
        raise ValueError(f"share {name}: src must be an absolute path")
    if not sp.exists():
        raise ValueError(f"share {name}: src does not exist: {src}")
    return Share(name=name, src=str(sp), mode=mode)

def _validate_share_src_policy(root: Path, *, name: str, src: str) -> None:
    src_resolved = Path(src).resolve()
    control_plane = control_dir(root).resolve()
    if src_resolved == root.resolve():
        raise ValueError(f"share {name}: refusing to share the workspace root (would expose .sandworm)")
    # Also refuse sources that *contain* the control plane (e.g. sharing a parent directory like /home/user),
    # because it would expose the repo's .sandworm via /workspace/shared/<name>/.../.sandworm.
    try:
        _ = control_plane.relative_to(src_resolved)
        contains_control_plane = True
    except Exception:
        contains_control_plane = False
    if contains_control_plane:
        raise ValueError(f"share {name}: refusing to share a path that contains the Sandworm control plane: {src_resolved}")
    try:
        rel = src_resolved.relative_to(control_plane)
        _ = rel
        is_under = True
    except Exception:
        is_under = False
    if src_resolved == control_plane or is_under:
        raise ValueError(f"share {name}: refusing to share Sandworm control plane path: {src_resolved}")

def validate_share(root: Path, *, name: str, src: str, mode: str) -> Share:
    """
    Public validator used by CLI and backends.

    `src` must be an absolute path on the host and must exist.
    """
    s = _validate_share(name, {"src": src, "mode": mode})
    _validate_share_src_policy(root, name=name, src=s.src)
    return s


def load_shares(root: Path) -> list[Share]:
    shares, _errors = load_shares_checked(root)
    return shares


def load_shares_doc(root: Path) -> dict[str, Any]:
    """
    Load the raw shares.json document.

    This is intended for share management commands so a user can list/remove broken entries.
    """
    p = shares_path(root)
    if not p.exists():
        return {}
    doc = json.loads(p.read_text(encoding="utf-8"))
    if not isinstance(doc, dict):
        raise ValueError("shares.json must be a JSON object mapping name -> {src, mode}")
    return doc  # type: ignore[return-value]


def load_shares_checked(root: Path) -> tuple[list[Share], list[str]]:
    """
    Load shares, returning (valid_shares, errors).

    Share entries that fail validation (e.g. missing src) are skipped and returned as errors,
    so unrelated commands can continue to work.
    """
    try:
        doc = load_shares_doc(root)
    except Exception as e:
        return [], [f"shares.json unreadable: {e}"]
    shares: list[Share] = []
    errors: list[str] = []
    for name in sorted(doc.keys()):
        if not isinstance(name, str):
            continue
        data = doc.get(name)
        try:
            s = _validate_share(name, data)  # type: ignore[arg-type]
            _validate_share_src_policy(root, name=name, src=s.src)
            shares.append(s)
        except Exception as e:
            errors.append(str(e))
    return shares, errors


def save_shares_doc(root: Path, doc: dict[str, Any]) -> Path:
    p = control_dir(root) / "shares.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        os.chmod(p, 0o600)
    except Exception:
        pass
    return p


def save_shares(root: Path, shares: list[Share]) -> Path:
    p = control_dir(root) / "shares.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    doc = {s.name: {"src": s.src, "mode": s.mode} for s in sorted(shares, key=lambda x: x.name)}
    p.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        os.chmod(p, 0o600)
    except Exception:
        pass
    return p
