        "schema": "sandworm.proof_bundle.v0",
        "suite": suite,
        "ok": bool(ok),
        "generated_at": _now_rfc3339_utc(),
        "command": command,
        "run_id": run_dir.name,
        "run_dir": None,
        "events_jsonl": ("events.jsonl" if dst_events.exists() else None),
        "artifacts": artifacts_out,
        "notes": (notes or []),
    }
    try:
