def _rg_wrapper_script() -> str:
    return """#!/bin/sh
# Sandworm scripts are bash, but some sandboxes break /usr/bin/env.
# This prelude re-execs the script under a real bash and ensures `bash` is in PATH.
if [ -z "${BASH_VERSION-}" ]; then
  if [ -n "${SANDWORM_BASH-}" ] && [ -x "${SANDWORM_BASH}" ]; then
    _sw_bash="${SANDWORM_BASH}"
    _sw_bash_dir="${_sw_bash%/*}"
    PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
    exec "$_sw_bash" "$0" "$@"
  fi
  for _sw_bash in /usr/bin/bash /bin/bash /usr/local/bin/bash /run/current-system/sw/bin/bash; do
    if [ -x "$_sw_bash" ]; then
      _sw_bash_dir="${_sw_bash%/*}"
      PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  for _sw_bash in /nix/store/*bash*/bin/bash; do
    if [ -x "$_sw_bash" ]; then
      _sw_bash_dir="${_sw_bash%/*}"
      PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
      exec "$_sw_bash" "$0" "$@"
    fi
  done
  echo "ERROR: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
  exit 127
fi
set -euo pipefail

# Prefer a real ripgrep when one exists outside this wrapper.
self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
for cand in /run/current-system/sw/bin/rg /nix/var/nix/profiles/default/bin/rg /usr/bin/rg /bin/rg; do
  if [[ -x "$cand" ]]; then
    cand_real="$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")"
    if [[ "$cand_real" != "$self" ]]; then
      exec "$cand" "$@"
    fi
  fi
done

# Minimal ripgrep compatibility shim for constrained fallback environments.
# Supports a practical subset used by Sandworm tests and common dev workflows:
# --version/-V, --help/-h, --files, -n, -q, -F, -e, -i, -m, -x, -o, -l, --glob/-g.
grep_flags=()
pattern_args=()
paths=()
glob_flags=()
include_globs=()
exclude_globs=()
files_mode=0

while [[ $# -gt 0 ]]; do
  a="$1"
  shift
  case "$a" in
    --version|-V)
      echo "rg-compat 0.0 (grep backend)"
      exit 0
      ;;
    --help|-h)
      cat <<'EOF'
rg-compat (grep backend)
supported: --version -V --help -h --files -n -q -F -e PATTERN -i -m N -x -o -l --glob/-g [PATTERN] [PATH...]
EOF
      exit 0
      ;;
    --files)
      files_mode=1
      ;;
    -n|-q|-F|-i|-m|-x|-o|-l)
      grep_flags+=("$a")
      if [[ "$a" == "-m" ]]; then
        if [[ $# -eq 0 ]]; then
          echo "rg-compat: -m requires an argument" >&2
          exit 2
        fi
        grep_flags+=("$1")
        shift
      fi
      ;;
    -[A-Za-z][A-Za-z]*)
      chars="${a#-}"
      while [[ -n "${chars:-}" ]]; do
        c="${chars:0:1}"
        chars="${chars:1}"
        case "$c" in
          n|q|F|i|x|o|l)
            grep_flags+=("-$c")
            ;;
          m)
            grep_flags+=("-m")
            if [[ $# -eq 0 ]]; then
              echo "rg-compat: -m requires an argument" >&2
              exit 2
            fi
            grep_flags+=("$1")
            shift
            ;;
          *)
            echo "rg-compat: unsupported flag: -$c (from $a)" >&2
            exit 2
            ;;
        esac
      done
      ;;
    --glob|-g)
      if [[ $# -eq 0 ]]; then
        echo "rg-compat: --glob requires a pattern" >&2
        exit 2
      fi
      g="$1"
      shift
      g_base="${g##*/}"
      if [[ "$g" == '!'* ]]; then
        glob_flags+=("--exclude=${g#!}")
        exclude_globs+=("${g#!}")
        if [[ "$g_base" != "${g#!}" ]]; then
          glob_flags+=("--exclude=${g_base#!}")
          exclude_globs+=("${g_base#!}")
        fi
      else
        glob_flags+=("--include=$g")
        include_globs+=("$g")
        if [[ "$g_base" != "$g" ]]; then
          glob_flags+=("--include=$g_base")
          include_globs+=("$g_base")
        fi
      fi
      ;;
    -e)
      if [[ $# -eq 0 ]]; then
        echo "rg-compat: -e requires a pattern" >&2
        exit 2
      fi
      pattern_args+=("-e" "$1")
      shift
      ;;
    --)
      if [[ "$files_mode" != "1" && ${#pattern_args[@]} -eq 0 && $# -gt 0 ]]; then
        pattern_args+=("-e" "$1")
        shift
      fi
      while [[ $# -gt 0 ]]; do
        paths+=("$1")
        shift
      done
      break
      ;;
    -*)
      echo "rg-compat: unsupported flag: $a" >&2
      exit 2
      ;;
    *)
      if [[ "$files_mode" == "1" ]]; then
        paths+=("$a")
      # First bare token is the pattern (rg default); later bare tokens are paths.
      elif [[ ${#pattern_args[@]} -gt 0 ]]; then
        paths+=("$a")
      elif [[ ${#pattern_args[@]} -eq 0 ]]; then
        pattern_args+=("-e" "$a")
      fi
      ;;
  esac
done

if [[ "$files_mode" == "1" ]]; then
  if [[ ${#pattern_args[@]} -gt 0 ]]; then
    echo "rg-compat: --files does not accept a search pattern" >&2
    exit 2
  fi
  if [[ ${#paths[@]} -eq 0 ]]; then
    paths=(".")
  fi
  if [[ ${#include_globs[@]} -eq 0 && ${#exclude_globs[@]} -eq 0 ]]; then
    { find "${paths[@]}" -type f -print 2>/dev/null || true; }
    exit 0
  fi
  tmp_files="$(mktemp)"
  trap 'rm -f "$tmp_files" 2>/dev/null || true' EXIT
  { find "${paths[@]}" -type f -print 2>/dev/null || true; } >"$tmp_files"
  while IFS= read -r f; do
    rel="${f#./}"
    base="${rel##*/}"
    keep=1
    if [[ ${#include_globs[@]} -gt 0 ]]; then
      keep=0
      for g in "${include_globs[@]}"; do
        if [[ "$rel" == $g || "$base" == $g ]]; then
          keep=1
          break
        fi
      done
    fi
    if [[ "$keep" == "1" && ${#exclude_globs[@]} -gt 0 ]]; then
      for g in "${exclude_globs[@]}"; do
        if [[ "$rel" == $g || "$base" == $g ]]; then
          keep=0
          break
        fi
      done
    fi
    if [[ "$keep" == "1" ]]; then
      printf '%s\n' "$f"
    fi
  done <"$tmp_files"
  exit 0
fi

if [[ ${#pattern_args[@]} -eq 0 ]]; then
  echo "rg-compat: missing pattern" >&2
  exit 2
fi

grep_mode=(-E)
for f in "${grep_flags[@]}"; do
  if [[ "$f" == "-F" ]]; then
    grep_mode=(-F)
    break
  fi
done

if [[ ${#paths[@]} -gt 0 ]]; then
  # GNU grep can return rc=2 on broken symlinks even when matches exist.
  # rg compatibility prefers match semantics over traversal noise.
  tmp_out="$(mktemp)"
  trap 'rm -f "$tmp_out" 2>/dev/null || true' EXIT
  set +e
  grep -I -s -R "${grep_mode[@]}" "${grep_flags[@]}" "${glob_flags[@]}" "${pattern_args[@]}" "${paths[@]}" >"$tmp_out"
  rc=$?
  set -e
  if [[ "$rc" -eq 2 && -s "$tmp_out" ]]; then
    rc=0
  fi
  cat "$tmp_out"
  exit "$rc"
fi

exec grep -I -s "${grep_mode[@]}" "${grep_flags[@]}" "${pattern_args[@]}"
"""


