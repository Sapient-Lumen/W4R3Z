        # scripts that write artifacts directly into dist/proof/<suite>/artifacts/... and then
        # call `sandworm proofbundle write` to generate the summary.
        try:
            rel_in_artifacts = src.resolve().relative_to(artifacts_dir.resolve())
            artifacts_out[k] = str(Path("artifacts") / rel_in_artifacts)
            continue
        except Exception:
            pass
        dst_name = src.name
        if dst_name in used_names:
            dst_name = _artifact_name(k, src)
        used_names.add(dst_name)
        dst = artifacts_dir / dst_name
        try:
            shutil.copyfile(src, dst)
            artifacts_out[k] = str(Path("artifacts") / dst_name)
        except Exception:
