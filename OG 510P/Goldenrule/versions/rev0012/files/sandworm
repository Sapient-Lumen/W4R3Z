from __future__ import annotations

import json
import os
import re
import shutil
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from .stateroot import control_dir


@dataclass(frozen=True)
class PruneItem:
    kind: str
    path: Path
    bytes: int | None


_PROOF_REF_RE = re.compile(r"dist/proof/([A-Za-z0-9._-]+)")
_PROOF_TS_RE = re.compile(r".*-\d{8}-\d{6}$")


def _is_under(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except Exception:
        return False


def _path_bytes(p: Path) -> int:
    try:
        if p.is_symlink():
            return 0
        if p.is_file():
            return int(p.stat().st_size)
        if p.is_dir():
            total = 0
            for root, _dirs, files in os.walk(p):
                for name in files:
                    fp = Path(root) / name
                    try:
                        if fp.is_symlink():
                            continue
                        total += int(fp.stat().st_size)
                    except Exception:
                        pass
            return total
    except Exception:
        return 0
    return 0


def _sorted_children_by_mtime(paths: list[Path]) -> list[Path]:
    def key(p: Path) -> float:
        try:
            return float(p.stat().st_mtime)
        except Exception:
            return 0.0

    return sorted(paths, key=key, reverse=True)


def _keep_newest(paths: list[Path], keep: int) -> tuple[list[Path], list[Path]]:
    keep_n = max(0, int(keep))
    ordered = _sorted_children_by_mtime([p for p in paths if p.exists()])
    return ordered[:keep_n], ordered[keep_n:]


def _load_proof_pins(root: Path) -> set[str]:
    pins: set[str] = set()
    latest_evidence = root / "SPEC" / "LATEST-EVIDENCE.md"
    if latest_evidence.exists():
        try:
            txt = latest_evidence.read_text(encoding="utf-8", errors="ignore")
            for m in _PROOF_REF_RE.finditer(txt):
                name = str(m.group(1)).strip()
                if name:
                    pins.add(name)
        except Exception:
            pass
    return pins


def _proof_kind(name: str) -> str:
    if name.startswith("facility-"):
        return "proof_facility"
    if name.startswith("posture-oracle-") or name.startswith("dev-oracle-"):
        return "proof_oracle"
    if name.startswith("manual-") or name.startswith("manual-baremetal-"):
        return "proof_manual"
    if _PROOF_TS_RE.fullmatch(name):
        return "proof_timestamped"
    return "proof_misc"


def _proof_keep_for_kind(
    *,
    kind: str,
    proof_facility_keep: int,
    proof_oracle_keep: int,
    proof_manual_keep: int,
    proof_timestamped_keep: int,
    proof_misc_keep: int,
) -> int:
    if kind == "proof_facility":
        return max(0, int(proof_facility_keep))
    if kind == "proof_oracle":
        return max(0, int(proof_oracle_keep))
    if kind == "proof_manual":
        return max(0, int(proof_manual_keep))
    if kind == "proof_timestamped":
        return max(0, int(proof_timestamped_keep))
    return max(0, int(proof_misc_keep))


def _tmp_candidate_name(name: str) -> bool:
    if not isinstance(name, str):
        return False
    n = name.strip()
    if not n:
        return False
    # Known run-owned churn sources.
    if n.startswith("nix-"):
        return True
    if n.startswith("sandworm-"):
        return True
    if n.startswith("selftest-"):
        return True
    if n.startswith("tmp."):
        return True
    return False


def _mtime_safe(p: Path) -> float:
    try:
        return float(p.stat().st_mtime)
    except Exception:
        return 0.0


def plan_prune(
    root: Path,
    *,
    runs_keep: int,
    archives_keep: int,
    archive_logs_keep: int,
    host_captures_keep: int,
    proof_facility_keep: int = 20,
    proof_oracle_keep: int = 20,
    proof_manual_keep: int = 30,
    proof_timestamped_keep: int = 25,
    proof_misc_keep: int = 20,
    proof_max_mb: int = 12288,
    proof_min_keep: int = 20,
    proof_keep_latest_evidence: bool = True,
    tmp_runtime_keep: int = 200,
    home_tmp_runtime_keep: int = 500,
    tmp_runtime_min_age_minutes: int = 180,
) -> list[PruneItem]:
    base = control_dir(root)
    if not base.exists():
        return []

    items: list[PruneItem] = []

    # Runs: keep newest N.
    runs_dir = base / "runs"
    if runs_dir.exists():
        candidates = [p for p in runs_dir.iterdir() if p.is_dir()]
        _keep, drop = _keep_newest(candidates, runs_keep)
        for p in drop:
            items.append(PruneItem(kind="run", path=p, bytes=None))

    # Archives: keep newest N.
    archives_dir = base / "archives"
    if archives_dir.exists():
        candidates = [p for p in archives_dir.iterdir() if p.is_file()]
        _keep, drop = _keep_newest(candidates, archives_keep)
        for p in drop:
            items.append(PruneItem(kind="archive", path=p, bytes=None))

    # Archive hook logs: keep newest N.
    logs_dir = base / "logs" / "archive"
    if logs_dir.exists():
        candidates = [p for p in logs_dir.iterdir() if p.is_dir()]
        _keep, drop = _keep_newest(candidates, archive_logs_keep)
        for p in drop:
            items.append(PruneItem(kind="archive_log", path=p, bytes=None))

    # Hostd captures: keep newest N files.
    captures_dir = base / "host" / "captures"
    if captures_dir.exists():
        candidates = [p for p in captures_dir.iterdir() if p.is_file()]
        _keep, drop = _keep_newest(candidates, host_captures_keep)
        for p in drop:
            items.append(PruneItem(kind="host_capture", path=p, bytes=None))

    # Runtime tmp retention under the Sandworm state root.
    # This primarily controls high-churn temp trees (nix-* and sandworm-*), which can
    # pressure Btrfs metadata over long unattended runs if left unbounded.
    age_cutoff = time.time() - (max(0, int(tmp_runtime_min_age_minutes)) * 60)
    tmp_dir = base / "tmp"
    if tmp_dir.exists() and tmp_dir.is_dir():
        candidates = [
            p
            for p in tmp_dir.iterdir()
            if _tmp_candidate_name(p.name)
            and _mtime_safe(p) <= age_cutoff
        ]
        _keep, drop = _keep_newest(candidates, int(tmp_runtime_keep))
        for p in drop:
            items.append(PruneItem(kind="tmp_runtime", path=p, bytes=None))

    home_tmp_dir = base / "home" / "tmp"
    if home_tmp_dir.exists() and home_tmp_dir.is_dir():
        candidates = [
            p
            for p in home_tmp_dir.iterdir()
            if _tmp_candidate_name(p.name)
            and _mtime_safe(p) <= age_cutoff
        ]
        _keep, drop = _keep_newest(candidates, int(home_tmp_runtime_keep))
        for p in drop:
            items.append(PruneItem(kind="home_tmp_runtime", path=p, bytes=None))

    # dist/proof retention policy:
    # - protect latest-evidence pointers and explicit keep markers
    # - keep newest N per proof family
    # - enforce a global proof size budget with a minimum keep floor
    proof_root = root / "dist" / "proof"
    if proof_root.exists() and proof_root.is_dir():
        all_proof_dirs = [p for p in proof_root.iterdir() if p.is_dir()]
        pinned_names = _load_proof_pins(root) if bool(proof_keep_latest_evidence) else set()
        protected: set[Path] = set()
        for p in all_proof_dirs:
            if p.name in pinned_names:
                protected.add(p)
                continue
            if (p / ".sandworm-keep").exists() or (p / ".keep").exists():
                protected.add(p)
                continue

        planned_paths: set[Path] = set()
        family_groups: dict[str, list[Path]] = {}
        for p in all_proof_dirs:
            if p in protected:
                continue
            k = _proof_kind(p.name)
            family_groups.setdefault(k, []).append(p)

        for k, paths in family_groups.items():
            keep_n = _proof_keep_for_kind(
                kind=k,
                proof_facility_keep=proof_facility_keep,
                proof_oracle_keep=proof_oracle_keep,
                proof_manual_keep=proof_manual_keep,
                proof_timestamped_keep=proof_timestamped_keep,
                proof_misc_keep=proof_misc_keep,
            )
            _keep, drop = _keep_newest(paths, keep_n)
            for p in drop:
                items.append(PruneItem(kind=k, path=p, bytes=None))
                planned_paths.add(p)

        max_bytes = max(0, int(proof_max_mb)) * 1024 * 1024
        min_keep_n = max(0, int(proof_min_keep))
        if max_bytes > 0:
            remaining = [p for p in all_proof_dirs if p not in protected and p not in planned_paths]
            if remaining:
                cur_bytes = 0
                for p in remaining:
                    cur_bytes += _path_bytes(p)
                remaining_ordered = sorted(
                    remaining,
                    key=lambda p: float(p.stat().st_mtime) if p.exists() else 0.0,
                )
                while cur_bytes > max_bytes and len(remaining_ordered) > min_keep_n:
                    victim = remaining_ordered.pop(0)
                    b = _path_bytes(victim)
                    items.append(PruneItem(kind="proof_budget", path=victim, bytes=int(b)))
                    planned_paths.add(victim)
                    if cur_bytes >= b:
                        cur_bytes -= b
                    else:
                        cur_bytes = 0

    # Safety: refuse to delete anything outside allowed prune surfaces.
    allowed_proof = (root / "dist" / "proof").resolve()
    safe: list[PruneItem] = []
    for it in items:
        if _is_under(it.path, base) or _is_under(it.path, allowed_proof):
            safe.append(it)
    return safe


def apply_prune(items: list[PruneItem]) -> dict[str, Any]:
    deleted: list[dict[str, Any]] = []
    errors: list[dict[str, Any]] = []
    freed = 0
    for it in items:
        try:
            b = _path_bytes(it.path)
            if it.path.is_dir():
                shutil.rmtree(it.path)
            else:
                it.path.unlink(missing_ok=True)
            freed += int(b)
            deleted.append({"kind": it.kind, "path": str(it.path), "bytes": int(b)})
        except Exception as e:
            errors.append({"kind": it.kind, "path": str(it.path), "error": repr(e)})
    return {"deleted": deleted, "errors": errors, "freed_bytes": int(freed)}


def prune_summary(items: list[PruneItem]) -> dict[str, Any]:
    known_total = 0
    unknown = 0
    for it in items:
        if it.bytes is None:
            unknown += 1
        else:
            known_total += int(it.bytes)
    by_kind: dict[str, int] = {}
    for it in items:
        by_kind[it.kind] = by_kind.get(it.kind, 0) + 1
    return {
