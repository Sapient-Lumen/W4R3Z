def load_lockfile_doc(path: Path):
    if not path.exists():
        raise LockfileError(f"lockfile not found: {path}")
    tomlkit = _require_tomlkit()
    try:
        doc = tomlkit.parse(path.read_text(encoding="utf-8"))
    except Exception as e:
        raise LockfileError(f"failed to parse lockfile: {path}") from e
    return doc


def dump_lockfile_doc(doc) -> str:
    tomlkit = _require_tomlkit()
    try:
        if hasattr(doc, "as_string"):
            return doc.as_string()
    except Exception:
        pass
    return tomlkit.dumps(doc)


def load_lockfile_dict(path: Path) -> dict:
    if not path.exists():
        raise LockfileError(f"lockfile not found: {path}")
    tomllib = _require_tomllib()
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except Exception as e:
        raise LockfileError(f"failed to parse lockfile: {path}") from e


def lockfile_to_dict(doc) -> dict:
    if isinstance(doc, dict):
        return doc
    try:
        return doc.unwrap()
    except Exception:
        # Best-effort: at least stringify.
        return {"_raw": str(doc)}


@dataclass(frozen=True)
class LockfileVerifyResult:
    ok: bool
    errors: list[str]
    warnings: list[str]


def _is_hex_sha256(s: object) -> bool:
    if not isinstance(s, str):
        return False
    if len(s) != 64:
        return False
    try:
        int(s, 16)
        return True
    except Exception:
        return False


def verify_lockfile(doc) -> LockfileVerifyResult:
    d = lockfile_to_dict(doc)
    errors: list[str] = []
    warnings: list[str] = []

    if d.get("version") != 1:
        errors.append("version must be 1")

    toolroot = d.get("toolroot")
    if toolroot is None:
        warnings.append("missing [toolroot] table")
    elif isinstance(toolroot, dict):
        for k in ("junest_sha256", "nix_portable_sha256"):
            v = toolroot.get(k)
            if isinstance(v, str) and v.strip() in ("", "..."):
                continue
            if v is not None and not _is_hex_sha256(v):
                errors.append(f"toolroot.{k} must be hex sha256 (64 chars)")

    nix = d.get("nix")
    if nix is None:
        warnings.append("missing [nix] table (nixpkgs flake refs will use wrapper defaults)")
    elif isinstance(nix, dict):
        for k in ("nixpkgs_flake", "nixpkgs_flake_fallback"):
            v = nix.get(k)
            if v is None:
                continue
            if not isinstance(v, str) or not v.strip():
                errors.append(f"nix.{k} must be a non-empty string")

    kvm = d.get("kvm")
    if isinstance(kvm, dict):
        nixos = kvm.get("nixos")
        if isinstance(nixos, dict):
            v = nixos.get("qcow2_sha256")
            if isinstance(v, str) and v.strip() in ("", "..."):
                v = None
            if v is not None and not _is_hex_sha256(v):
                errors.append("kvm.nixos.qcow2_sha256 must be hex sha256 (64 chars)")

    images = d.get("images")
    if isinstance(images, dict):
        for k in ("podman_default", "providers_sandbox_default"):
            v = images.get(k)
            if v is None:
                continue
            if not isinstance(v, str) or not v.strip():
                errors.append(f"images.{k} must be a non-empty string")
                continue
            vv = v.strip()
            if vv.endswith(":latest") or vv == "latest":
                warnings.append(f"images.{k} uses :latest (not reproducible)")
            if (":" not in vv) and ("@" not in vv):
                warnings.append(f"images.{k} has no tag/digest (not reproducible): {vv}")

    ok = not errors
    return LockfileVerifyResult(ok=ok, errors=errors, warnings=warnings)


def _nixpkgs_ref_is_pinned_enough(ref: object) -> bool:
    if not isinstance(ref, str) or not ref.strip():
        return False
    s = ref.strip()
    if s == "nixpkgs":
        return False
    if "refs/heads/" in s or s.endswith("/nixpkgs"):
        return False
    return True


def verify_all(root: Path) -> dict[str, object]:
    """
    Verify strict readiness of the workspace:
    - lockfile schema is valid
    - toolroot/nixpkgs/client pins are present and pinned enough
    - required local installs are present (toolroot nix-portable + pinned client versions installed)

    Returns a JSON-serializable dict shaped like:
      { ok: bool, errors: [...], warnings: [...], checks: {...} }
    """
    root = root.resolve()
    lf = lockfile_path(root)
    d = load_lockfile_dict(lf)

    out: dict[str, object] = {"ok": True, "errors": [], "warnings": [], "checks": {}}
    errors: list[str] = out["errors"]  # type: ignore[assignment]
    warnings: list[str] = out["warnings"]  # type: ignore[assignment]
    checks: dict[str, object] = out["checks"]  # type: ignore[assignment]

    res = verify_lockfile(d)
    checks["schema"] = {"ok": res.ok, "errors": res.errors, "warnings": res.warnings}
    if res.warnings:
        warnings.extend([str(w) for w in res.warnings])
    if res.errors:
        errors.extend([str(e) for e in res.errors])

    toolroot = d.get("toolroot") if isinstance(d, dict) else None
    url = toolroot.get("nix_portable_url") if isinstance(toolroot, dict) else None
    sha = toolroot.get("nix_portable_sha256") if isinstance(toolroot, dict) else None
    toolroot_ok = True
    if not (isinstance(url, str) and url.strip() and url.strip() != "..."):
        errors.append("toolroot.nix_portable_url is missing (run: sandworm lock pin-all or sandworm refresh --update)")
        toolroot_ok = False
    if not (isinstance(sha, str) and _is_hex_sha256(sha.strip())):
        errors.append("toolroot.nix_portable_sha256 is missing/invalid (run: sandworm lock pin-all or sandworm refresh --update)")
        toolroot_ok = False
    checks["toolroot_pins"] = {"ok": toolroot_ok, "nix_portable_url": url, "nix_portable_sha256": sha}

    nix = d.get("nix") if isinstance(d, dict) else None
    primary = nix.get("nixpkgs_flake") if isinstance(nix, dict) else None
    fb = nix.get("nixpkgs_flake_fallback") if isinstance(nix, dict) else None
    if not _nixpkgs_ref_is_pinned_enough(primary):
        errors.append("nix.nixpkgs_flake is not pinned enough (run: sandworm lock pin-nixpkgs)")
    if not _nixpkgs_ref_is_pinned_enough(fb):
        errors.append("nix.nixpkgs_flake_fallback is not pinned enough (run: sandworm lock pin-nixpkgs)")
    checks["nix_pins"] = {
        "ok": _nixpkgs_ref_is_pinned_enough(primary) and _nixpkgs_ref_is_pinned_enough(fb),
        "nixpkgs_flake": primary,
        "nixpkgs_flake_fallback": fb,
    }

    clients = d.get("clients") if isinstance(d, dict) else None
    pinned_clients: dict[str, str | None] = {}
    for nm in ("codex", "gemini", "claude"):
        ent = clients.get(nm) if isinstance(clients, dict) else None
        ver = ent.get("version") if isinstance(ent, dict) else None
        pinned_clients[nm] = ver.strip() if isinstance(ver, str) and ver.strip() and ver.strip() != "..." else None
        if pinned_clients[nm] is None:
            errors.append(
                f"clients.{nm}.version is missing (run: sandworm clients install --update-lock --all)"
            )
    checks["clients_pins"] = {"ok": all(pinned_clients.values()), "versions": pinned_clients}

    images = d.get("images") if isinstance(d, dict) else None
    img_pins: dict[str, str | None] = {}
    for k in ("podman_default", "providers_sandbox_default"):
        v = images.get(k) if isinstance(images, dict) else None
        s = v.strip() if isinstance(v, str) and v.strip() else None
        if s and "@sha256:" in s:
            img_pins[k] = s
        else:
            img_pins[k] = None
            warnings.append(f"images.{k} is not digest-pinned (@sha256:...)")
    checks["images_pins"] = {"ok": all(img_pins.values()), "pins": img_pins}

    # Local install checks for offline readiness.
    np_bin = control_dir(root) / "toolroot" / "bin" / "nix-portable"
    if not (np_bin.exists() and os.access(np_bin, os.X_OK)):
        errors.append("toolroot nix-portable is not installed (run: sandworm refresh)")

    try:
        from .clients import clients_status

        st = clients_status(root)
        checks["clients_status"] = st
        pins = st.get("pins") if isinstance(st, dict) else None
        mism = pins.get("mismatches") if isinstance(pins, dict) else None
        miss = pins.get("missing") if isinstance(pins, dict) else None
        if isinstance(miss, list) and miss:
            errors.append(
                f"clients missing: {', '.join([str(x) for x in miss])} (run: sandworm clients install --locked --all)"
            )
        if isinstance(mism, list) and mism:
            errors.append(
                f"clients mismatched vs lock: {', '.join([str(x) for x in mism])} (run: sandworm clients install --locked --all)"
            )
    except Exception as e:
        warnings.append(f"clients status check failed: {e}")

    out["ok"] = not errors
    return out


def _strip_tag(image: str) -> str:
    s = (image or "").strip()
    if not s:
        return s
    if "@" in s:
        return s.split("@", 1)[0]
    # Preserve registry ports: only treat ':' after the last '/' as a tag separator.
    slash = s.rfind("/")
    colon = s.rfind(":")
    if colon > slash:
        return s[:colon]
    return s


def _podman_digest(*, podman: str, env: dict[str, str], image: str) -> str:
    proc = subprocess.run(
        [podman, "image", "inspect", image, "--format", "{{.Digest}}"],
        env=env,
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        raise LockfileError(f"podman image inspect failed for {image!r}: {err or 'unknown error'}")
    d = (proc.stdout or "").strip()
    if not d.startswith("sha256:") or len(d) < 20:
        raise LockfileError(f"podman returned an unexpected digest for {image!r}: {d!r}")
    return d


def pin_lockfile_images(root: Path, *, pull_missing: bool) -> dict:
    """
    Resolve OCI image digests via Podman and write @sha256 pins into sandworm.lock [images].

    This is an explicit supply-chain management command (not an implicit runtime pull).
    """
    root = root.resolve()
    lf = lockfile_path(root)
    if not lf.exists():
        raise LockfileError(f"lockfile not found: {lf} (run `sandworm lock init`)")

    try:
        from .podman import _podman_bin

        podman = _podman_bin()
    except Exception:
        podman = shutil.which("podman")
    if not podman:
        raise LockfileError("podman not found in PATH (needed to resolve image digests)")

    # Use project-local Podman storage env so pins reflect the images Sandworm will use.
    try:
        from .podman import ensure_storage

        podman_env = ensure_storage(root)
        env = podman_env.env
    except Exception:
        env = dict(os.environ)

    doc = load_lockfile_doc(lf)
    d = lockfile_to_dict(doc)
    images = d.get("images")
    if not isinstance(images, dict):
        raise LockfileError("lockfile missing [images] table")

    keys = ["podman_default", "providers_sandbox_default"]
    pins: dict[str, str] = {}
    changes: dict[str, dict[str, str]] = {}
    errors: list[str] = []

    for k in keys:
        raw = images.get(k)
        if not isinstance(raw, str) or not raw.strip() or raw.strip() == "...":
            continue
        img = raw.strip()
        if "@sha256:" in img:
            pins[k] = img
            continue

        exists = subprocess.run([podman, "image", "exists", img], env=env).returncode == 0
        if not exists:
            if not pull_missing:
                errors.append(f"image not present locally: {img} (use `podman pull {img}` or omit --no-pull)")
                continue
            proc = subprocess.run([podman, "pull", img], env=env, text=True, capture_output=True)
            if proc.returncode != 0:
                err = (proc.stderr or proc.stdout or "").strip()
                errors.append(f"podman pull failed for {img}: {err or 'unknown error'}")
                continue

        try:
            digest = _podman_digest(podman=podman, env=env, image=img)
        except LockfileError as e:
            errors.append(str(e))
            continue

        base = _strip_tag(img)
        pinned = f"{base}@{digest}"
        pins[k] = pinned

        try:
            before = str(images.get(k))
        except Exception:
            before = img
        changes[k] = {"before": before, "after": pinned}

        # Update tomlkit doc so comments/ordering are preserved.
        try:
            if "images" not in doc:
                raise KeyError("missing images table")
            doc["images"][k] = pinned
        except Exception:
            # Best-effort: fall back to raw dict update (will be dumped without comments).
            images[k] = pinned

    if errors:
        return {"ok": False, "errors": errors, "changed": False, "pins": pins}

    changed = bool(changes)
    if changed:
        lf.write_text(dump_lockfile_doc(doc), encoding="utf-8")
    return {"ok": True, "changed": changed, "pins": pins, "changes": changes, "path": str(lf)}


_GITHUB_TARBALL_RE = re.compile(r"^tarball\+https://github\.com/([^/]+)/([^/]+)/archive/([0-9a-fA-F]{7,})\.tar\.gz$")
_GITHUB_REF_RE = re.compile(r"^github:([^/]+)/([^/]+)/([0-9a-fA-F]{7,})$")


def _nixpkgs_tarball_ref(*, owner: str, repo: str, rev: str) -> str:
    owner = owner.strip()
    repo = repo.strip()
    rev = rev.strip()
    if not owner or not repo or not rev:
        raise LockfileError("cannot build nixpkgs tarball ref: missing owner/repo/rev")
    return f"tarball+https://github.com/{owner}/{repo}/archive/{rev}.tar.gz"


def _extract_pinned_github_ref(ref: str) -> tuple[str, str, str] | None:
    """
    Return (owner, repo, rev) when ref already encodes a pinned GitHub rev in a recognizable form.
    """
    s = (ref or "").strip()
    if not s:
        return None
    m = _GITHUB_TARBALL_RE.match(s)
    if m:
        return m.group(1), m.group(2), m.group(3)
    m = _GITHUB_REF_RE.match(s)
    if m:
        return m.group(1), m.group(2), m.group(3)
    if s.startswith("github:") and "?rev=" in s:
        try:
            base, qs = s.split("?", 1)
            parts = base.split("/")
            if len(parts) >= 3:
                owner = parts[1]
                repo = parts[2]
                for kv in qs.split("&"):
                    if kv.startswith("rev="):
                        rev = kv.split("=", 1)[1].strip()
                        if re.fullmatch(r"[0-9a-fA-F]{7,}", rev or ""):
                            return owner, repo, rev
        except Exception:
            return None
    return None


