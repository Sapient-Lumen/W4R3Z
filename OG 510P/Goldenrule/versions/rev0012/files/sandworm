        if path.is_symlink():
            path.unlink()
    except Exception:
        pass
    fd: int | None = None
    tmp_path: Path | None = None
    try:
        fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".tmp.", dir=str(path.parent))
        tmp_path = Path(tmp_name)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            f.write(content)
        try:
            tmp_path.chmod(0o755)
        except Exception:
            pass
        os.replace(str(tmp_path), str(path))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except Exception:
                pass
        if tmp_path is not None and tmp_path.exists() and tmp_path != path:
            try:
                tmp_path.unlink(missing_ok=True)
            except Exception:
                pass


def _read_installed_versions(root: Path) -> dict[str, str | None]:
    prefix = clients_npm_prefix(root)
    out: dict[str, str | None] = {}
    for name, spec in CLIENT_SPECS.items():
        pkg = spec.npm_package
        pkg_path = prefix / "node_modules" / pkg
        if pkg.startswith("@") and "/" in pkg:
            scope, pkgname = pkg.split("/", 1)
            pkg_path = prefix / "node_modules" / scope / pkgname
        pj = pkg_path / "package.json"
        if not pj.exists():
            out[name] = None
            continue
        try:
            data = json.loads(pj.read_text(encoding="utf-8"))
            v = data.get("version")
            out[name] = str(v) if isinstance(v, str) and v.strip() else None
        except Exception:
            out[name] = None
    return out


def clients_installed_manifest(root: Path) -> dict[str, object] | None:
    p = clients_installed_manifest_path(root.resolve())
    if not p.exists():
        return None
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _parse_rfc3339_utc(ts: object) -> float | None:
    if not isinstance(ts, str) or not ts.strip():
        return None
    try:
        dt = datetime.strptime(ts.strip(), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return float(dt.timestamp())
    except Exception:
        return None


def clients_installed_age_s(root: Path, *, name: str | None = None) -> int | None:
    """
    Best-effort: seconds since the provider clients were last updated (not merely checked).
    Returns None if unknown.
    """
    m = clients_installed_manifest(root)
    if not isinstance(m, dict):
        return None
    if isinstance(name, str) and name.strip():
        by = m.get("updated_at_by_client")
        if isinstance(by, dict):
            ts = by.get(name.strip())
        else:
            ts = None
        if ts is None:
            return None
    else:
        ts = m.get("updated_at") or m.get("checked_at")
    t0 = _parse_rfc3339_utc(ts)
    if t0 is None:
        return None
    age = time.time() - float(t0)
    if age < 0:
        return 0
    return int(age)


def _pinned_node_attr_from_lockfile(root: Path) -> str | None:
    lf = lockfile_path(root)
    if not lf.exists():
        return None
    try:
        d = load_lockfile_dict(lf)
    except Exception:
        return None
    ctab = d.get("clients") if isinstance(d, dict) else None
    if not isinstance(ctab, dict):
        return None
    na = ctab.get("node_attr")
    if isinstance(na, str) and na.strip() and na.strip() != "...":
        return na.strip()
    return None


def _latest_cache_age_s(payload: dict[str, object]) -> int | None:
    ts = payload.get("checked_at")
    t0 = _parse_rfc3339_utc(ts)
    if t0 is None:
        return None
    age = time.time() - float(t0)
    if age < 0:
        return 0
    return int(age)


def _read_latest_cache(root: Path) -> dict[str, object] | None:
    p = clients_latest_manifest_path(root.resolve())
    if not p.exists():
        return None
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _write_latest_cache(root: Path, payload: dict[str, object]) -> Path:
    p = clients_latest_manifest_path(root.resolve())
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return p


def _npm_view_latest_version(*, nix: str, node_attr: str, package: str, cwd: Path) -> str:
    """
    Return the latest published version for an npm package.
    """
    cmd = [
        nix,
        *nix_flags(),
        "shell",
        node_attr,
        "--command",
        "npm",
        "view",
        package,
        "version",
        "--json",
    ]
    proc = subprocess.run(cmd, cwd=str(cwd), text=True, capture_output=True)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        raise ClientsError(f"npm view failed for {package!r}: {err or 'unknown error'}")
    out = (proc.stdout or "").strip()
    if not out:
        raise ClientsError(f"npm view returned empty output for {package!r}")
    try:
        v = json.loads(out)
        if isinstance(v, str) and v.strip():
            return v.strip()
        if isinstance(v, list) and v and isinstance(v[0], str) and v[0].strip():
            return v[0].strip()
    except Exception:
        pass
    # Fallback: strip quotes/newlines.
    return out.strip().strip('"').strip("'")


def clients_latest(
    root: Path,
    *,
    refresh: bool = False,
    ttl_s: int = 24 * 60 * 60,
    write_cache: bool = True,
    node_attr: str = "nixpkgs#nodejs_22",
) -> dict[str, object]:
    """
    Query the latest published provider client versions (from npm), with caching under:
      ./.sandworm/clients/latest.json

    Offline behavior:
    - If cache exists, returns it (marked stale if too old).
    - If cache is missing, returns ok=false.
    """
    root = root.resolve()
    offline = _offline_enabled()
    strict_supply_chain = _truthy_env("SW_STRICT_SUPPLYCHAIN")
    lock_node_attr = _pinned_node_attr_from_lockfile(root)
    if lock_node_attr:
        node_attr = lock_node_attr
    node_attr = _pin_node_attr_if_needed(root, node_attr, strict_supply_chain=strict_supply_chain)

    cached = _read_latest_cache(root)
    cached_age_s = _latest_cache_age_s(cached) if isinstance(cached, dict) else None
    cached_versions = cached.get("versions") if isinstance(cached, dict) else None
    cached_ok = isinstance(cached_versions, dict) and any(isinstance(v, str) and v.strip() for v in cached_versions.values())
    cached_fresh = cached_ok and cached_age_s is not None and int(cached_age_s) <= int(ttl_s)

    if not refresh and cached_fresh:
        out = dict(cached)
        out.setdefault("ok", True)
        out["source"] = "cache"
        out["stale"] = False
        out["cache_path"] = str(clients_latest_manifest_path(root))
        return out

    if offline:
        if cached_ok:
            out = dict(cached)
            out.setdefault("ok", True)
            out["source"] = "cache"
            out["stale"] = True
            out["cache_age_s"] = cached_age_s
            out["cache_path"] = str(clients_latest_manifest_path(root))
            out.setdefault("warnings", []).append("offline mode enabled; using cached latest versions (may be stale)")
            return out
        return {
            "ok": False,
            "error": "offline mode enabled and no latest cache present",
            "cache_path": str(clients_latest_manifest_path(root)),
        }

    # Prefer a native/system nix when available (more stable on NixOS and avoids nix-portable quirks),
    # but fall back to the repo-local toolroot wrapper on hosts without nix.
    nix = find_nix(root)
    if not nix:
        try:
            from .toolroot import ToolrootError, refresh_toolroot

            refresh_toolroot(root, update=False, force=False)
        except Exception as e:
            if isinstance(e, ToolrootError):
                raise ClientsError(f"nix not available and toolroot refresh failed: {e}") from e
            raise ClientsError(f"nix not available and toolroot refresh failed: {e}") from e
        nix = find_nix(root)
        if not nix:
            raise ClientsError("nix not available (needed to query npm); try `sandworm refresh`")

    errors: list[str] = []
    versions: dict[str, str | None] = {k: None for k in CLIENT_SPECS.keys()}
    for name, spec in CLIENT_SPECS.items():
        try:
            versions[name] = _npm_view_latest_version(nix=nix, node_attr=node_attr, package=spec.npm_package, cwd=root)
        except Exception as e:
            errors.append(str(e))
            versions[name] = None

    checked_at = _now_rfc3339_utc()
    payload: dict[str, object] = {
        "ok": not errors and all(isinstance(v, str) and v.strip() for v in versions.values()),
        "checked_at": checked_at,
        "node_attr": node_attr,
        "source": "network",
        "versions": versions,
        "errors": errors,
    }
    if write_cache:
        p = _write_latest_cache(root, payload)
        payload["cache_path"] = str(p)
    else:
        payload["cache_path"] = str(clients_latest_manifest_path(root))
    payload["stale"] = False
    return payload


def clients_check_latest(
    root: Path,
    *,
    refresh: bool = False,
    ttl_s: int = 24 * 60 * 60,
    write_cache: bool = True,
    node_attr: str = "nixpkgs#nodejs_22",
) -> dict[str, object]:
    """
    Compare installed provider CLI versions to the latest published versions.
    """
    root = root.resolve()
    st = clients_status(root)
    installed = st.get("versions") if isinstance(st, dict) else None
    installed = installed if isinstance(installed, dict) else {}

    latest = clients_latest(root, refresh=refresh, ttl_s=ttl_s, write_cache=write_cache, node_attr=node_attr)
    latest_versions = latest.get("versions") if isinstance(latest, dict) else None
    latest_versions = latest_versions if isinstance(latest_versions, dict) else {}

    missing: list[str] = []
    outdated: list[str] = []
    unknown: list[str] = []
    for name in sorted(CLIENT_SPECS.keys()):
        inst = installed.get(name)
        want = latest_versions.get(name)
        if not isinstance(inst, str) or not inst.strip():
            missing.append(name)
            continue
        if not isinstance(want, str) or not want.strip():
            unknown.append(name)
            continue
        if inst.strip() != want.strip():
            outdated.append(name)

    ok = bool(latest.get("ok")) and not missing and not outdated and not unknown
    return {
        "ok": ok,
        "installed": installed,
        "latest": latest,
        "missing": missing,
        "outdated": outdated,
        "unknown": unknown,
    }


def clients_status(root: Path) -> dict[str, object]:
    root = root.resolve()
    base = clients_dir(root)
    prefix = clients_npm_prefix(root)
    bin_dir = clients_bin_dir(root)
    versions = _read_installed_versions(root)
    bins: dict[str, object] = {}
    for name, spec in CLIENT_SPECS.items():
        p = bin_dir / spec.bin_name
        bins[name] = {"path": str(p), "present": p.exists() and os.access(p, os.X_OK)}

    pins: dict[str, str | None] = {k: None for k in CLIENT_SPECS.keys()}
    pinned_node_attr: str | None = None
    lf = lockfile_path(root)
    if lf.exists():
        try:
            d = load_lockfile_dict(lf)
            ctab = d.get("clients") if isinstance(d, dict) else None
            if isinstance(ctab, dict):
                na = ctab.get("node_attr")
                if isinstance(na, str) and na.strip() and na.strip() != "...":
                    pinned_node_attr = na.strip()
                for name in CLIENT_SPECS.keys():
                    ent = ctab.get(name)
                    ver = ent.get("version") if isinstance(ent, dict) else None
                    if isinstance(ver, str) and ver.strip() and ver.strip() != "...":
                        pins[name] = ver.strip()
        except Exception:
            pass

    mismatches: list[str] = []
    missing: list[str] = []
    for name, installed in versions.items():
        want = pins.get(name)
        if want:
            if not installed:
                missing.append(name)
            elif installed != want:
                mismatches.append(name)
    return {
        "updated_at": _now_rfc3339_utc(),
        "paths": {"clients_dir": str(base), "npm_prefix": str(prefix), "bin_dir": str(bin_dir)},
        "pins": {"node_attr": pinned_node_attr, "versions": pins, "mismatches": mismatches, "missing": missing},
        "versions": versions,
        "bins": bins,
    }


def clients_install(
    root: Path,
    *,
    which: list[str],
    force: bool = False,
    npm_tag: str = "latest",
    node_attr: str = "nixpkgs#nodejs_22",
    locked: bool = False,
    update_lock: bool = False,
) -> dict[str, object]:
    """
    Installs provider CLIs into .sandworm/clients without touching host-global installs.

    Current approach: install npm packages into a project-local prefix, and create tiny wrappers in
    .sandworm/clients/bin that run those CLIs under `nix shell <nodejs> --command ...`.
    """
    root = root.resolve()
    if state_root_readonly(root):
        raise ClientsError("clients install: state root is read-only (clear with `sandworm state clear` or remove readonly flag)")
    # Client wrappers are expected to be runnable inside sandboxes/guests via the mounted toolroot.
    # Ensure the control plane exists and that the toolroot has been bootstrapped at least once.
    #
    # Note: even on hosts with a native/system nix, sandboxes may not have access to it; the toolroot
    # provides a consistent "nix + node" substrate (nix-portable + wrappers) under --root.
    from .runctx import ensure_control_plane

    strict_supply_chain = _truthy_env("SW_STRICT_SUPPLYCHAIN")
    offline = _offline_enabled()
    gemini_require_latest = (
        _truthy_env("SW_GEMINI_REQUIRE_LATEST")
        or _truthy_env("SANDWORM_GEMINI_REQUIRE_LATEST")
    )
    if strict_supply_chain and not (locked or update_lock):
        raise ClientsError(
            "strict supply chain mode requires `clients install --locked` or `clients install --update-lock`; "
            "remediation: rerun with one of these so installed versions are pinned in sandworm.lock "
            "(recommended for full lock compliance: `sandworm clients install --locked --all` "
            "or `sandworm clients install --update-lock --all`)"
        )
    if offline and update_lock:
        raise ClientsError("offline mode enabled; refusing `clients install --update-lock` (requires network access)")

    ensure_control_plane(root)
    from .toolroot import ToolrootError, ensure_toolroot_node_wrapper, refresh_toolroot

    np = control_dir(root) / "toolroot" / "bin" / "nix-portable"
    if not np.exists():
        try:
            refresh_toolroot(root, update=False, force=False)
        except ToolrootError as e:
            raise ClientsError(f"clients install: toolroot refresh failed: {e}") from e
    if not ensure_toolroot_node_wrapper(root):
        raise ClientsError("clients install: toolroot node wrapper missing (run: sandworm refresh)")
    # Prefer a native/system nix when available (more stable on NixOS and avoids nix-portable quirks),
    # but fall back to the repo-local toolroot wrapper on hosts without nix.
    nix = find_nix(root)
    if not nix:
        try:
            from .toolroot import ToolrootError, refresh_toolroot

            refresh_toolroot(root, update=False, force=False)
        except Exception as e:
            if isinstance(e, ToolrootError):
                raise ClientsError(f"nix not available and toolroot refresh failed: {e}") from e
            raise ClientsError(f"nix not available and toolroot refresh failed: {e}") from e
        nix = find_nix(root)
        if not nix:
            raise ClientsError("nix not available (needed to install provider CLIs); try `sandworm refresh`")

    selected: list[ClientSpec] = []
    for raw in which:
        name = raw.strip()
        if name not in CLIENT_SPECS:
            raise ClientsError(f"unknown client: {name!r} (expected one of: {', '.join(sorted(CLIENT_SPECS.keys()))})")
        selected.append(CLIENT_SPECS[name])

    if locked:
        lf = lockfile_path(root)
        if not lf.exists():
            raise ClientsError(
                "clients install --locked requires sandworm.lock "
                "(run `sandworm lock init`, then `sandworm clients install --update-lock --all`)"
            )
        try:
            d = load_lockfile_dict(lf)
        except LockfileError as e:
            raise ClientsError(str(e)) from e
        ctab = d.get("clients") if isinstance(d, dict) else None
        if not isinstance(ctab, dict):
            raise ClientsError(
                "clients install --locked: missing [clients] in sandworm.lock "
                "(run `sandworm clients install --update-lock --all` to write client pins)"
            )
        la = ctab.get("node_attr")
        if isinstance(la, str) and la.strip() and la.strip() != "...":
            node_attr = la.strip()

    node_attr = _pin_node_attr_if_needed(root, node_attr, strict_supply_chain=strict_supply_chain)

    if _progress_enabled():
        mode_desc = "locked" if locked else f"tag={npm_tag}"
        _note(
            "clients: ensuring installed: "
            + ", ".join(s.name for s in selected)
            + f" ({mode_desc}; node={node_attr})"
        )

    base = clients_dir(root)
    prefix = clients_npm_prefix(root)
    bin_dir = clients_bin_dir(root)
    prefix.mkdir(parents=True, exist_ok=True)
    bin_dir.mkdir(parents=True, exist_ok=True)
    try:
        from .toolroot import ensure_toolroot_node_wrapper

        ensure_toolroot_node_wrapper(root)
    except Exception:
        pass

    npm_env = dict(os.environ)
    # Make installs resilient to callers that intentionally set a read-only host HOME
    # (SAFE contract: Sandworm state lives under --root/.sandworm/ by default).
    try:
        sw_home = os.environ.get("SANDWORM_HOME") or os.environ.get("HOME") or ""
        if sw_home != "/run/sandworm/home":
            from .creds import ensure_sandworm_home

            home_dir = ensure_sandworm_home(root)
            npm_env["SANDWORM_HOME"] = str(home_dir)
            npm_env["HOME"] = str(home_dir)
            npm_env["XDG_CACHE_HOME"] = str(home_dir / ".cache")
            npm_env["XDG_CONFIG_HOME"] = str(home_dir / ".config")
            npm_env["XDG_DATA_HOME"] = str(home_dir / ".local" / "share")
            npm_env["XDG_STATE_HOME"] = str(home_dir / ".local" / "state")
    except Exception:
        pass
    npm_env.setdefault("npm_config_update_notifier", "false")
    npm_env.setdefault("npm_config_fund", "false")
    npm_env.setdefault("npm_config_audit", "false")
    npm_env.setdefault("npm_config_prefix", str(prefix))
    # Make installs faster and more reliable across runs; users OK with on-disk caching.
    sw_home = os.environ.get("SANDWORM_HOME")
    if sw_home:
        npm_cache = Path(sw_home).expanduser() / ".sandworm" / "cache" / "npm"
    else:
        npm_cache = control_dir(root) / "cache" / "npm"
    try:
        npm_cache.mkdir(parents=True, exist_ok=True)
    except Exception:
        pass
    npm_env.setdefault("npm_config_cache", str(npm_cache))

    def _is_transient_text_file_busy(msg: str) -> bool:
        s = (msg or "").lower()
        return "text file busy" in s or "bad interpreter: text file busy" in s

    def _warmup_nix_shell() -> None:
        """
        Nix-portable can be flaky on the very first invocation for a fresh --root (ETXTBSY).
        Warm up the nix shell once before running npm installs so `sandworm setup` "just works".
        """
        if _progress_enabled():
            _note("warming nix shell (node --version)")
        cmd = [nix, *nix_flags(), "shell", node_attr, "--command", "node", "--version"]
        last = ""
        for attempt in range(1, 4):
            tmp_path: str | None = None
            try:
                with tempfile.NamedTemporaryFile(
                    mode="w+",
                    encoding="utf-8",
                    prefix="sandworm-nix-shell-warmup.",
                    suffix=".txt",
                    delete=False,
                ) as tmp:
                    tmp_path = tmp.name
                    proc = subprocess.run(
                        cmd,
                        cwd=root,
                        stdout=tmp,
                        stderr=subprocess.STDOUT,
                        env=npm_env,
                        timeout=180,
                        text=False,
                    )
            except Exception as e:
                last = repr(e)
                proc = None
            if proc is not None and proc.returncode == 0:
                try:
                    if tmp_path:
                        Path(tmp_path).unlink(missing_ok=True)
                except Exception:
                    pass
                return
            if proc is not None:
                try:
                    last = Path(tmp_path).read_text(encoding="utf-8", errors="replace").strip() if tmp_path else ""
                except Exception:
                    last = ""
                last = last or f"exit={proc.returncode}"
            if _is_transient_text_file_busy(last) and attempt < 4:
                # Cold nix-portable boots can take a few seconds to settle; use a gentle backoff.
                time.sleep(min(4.0, 0.75 * float(attempt)))
                try:
                    if tmp_path:
                        Path(tmp_path).unlink(missing_ok=True)
                except Exception:
                    pass
                continue
            try:
                if tmp_path:
                    Path(tmp_path).unlink(missing_ok=True)
            except Exception:
                pass
            raise ClientsError(f"nix shell warmup failed: {last}")

    _warmup_nix_shell()

    # Best-effort: provide a real node binary under --root/.sandworm/clients/bin so client wrappers can
    # avoid calling `nix shell` at runtime (which can be flaky on some nix-portable cold boots).
    try:
        node_shim = clients_bin_dir(root) / "node"
        if not (node_shim.exists() and os.access(node_shim, os.X_OK)):
            node_exec = _node_exec_path()
            if isinstance(node_exec, str) and node_exec.startswith("/nix/store/") and "/bin/node" in node_exec:
                # Avoid /usr/bin/env: some sandbox substrates (and nix-portable runtimes) hide /usr entirely.
                _write_executable(node_shim, f"#!/bin/sh\nexec {shlex.quote(node_exec)} \"$@\"\n")
    except Exception:
        pass

    # Some nix-portable runtimes hide /usr entirely. npm-installed bin scripts default to `#!/usr/bin/env node`,
    # which then fails inside our nix shell execution. We avoid host mutation by:
    # - patching specific helper shebangs to the nix-provided node store path, and
    # - providing tiny gcc/g++ shims (symlinks to cc/c++) when building native deps.
    def _nix_shell_has_usr_bin_env() -> bool:
        try:
            # Avoid `sh -lc` here: on some cold nix-portable boots, invoking sh can be flakey.
            # Use node to probe /usr/bin/env directly.
            probe = (
                "const fs=require('fs');"
                "try{fs.accessSync('/usr/bin/env',fs.constants.X_OK);process.exit(0)}"
                "catch(e){process.exit(1)}"
            )
            proc = subprocess.run(
                [nix, *nix_flags(), "shell", node_attr, "--command", "node", "-e", probe],
                cwd=root,
                text=True,
                capture_output=True,
                env=npm_env,
                timeout=30,
            )
            return proc.returncode == 0
        except Exception:
            return False

    nix_shell_has_usr_bin_env = _nix_shell_has_usr_bin_env()
    node_flake_ref = node_attr.split("#", 1)[0] if isinstance(node_attr, str) and "#" in node_attr else ""
    gemini_shell_installables: list[str] = [node_attr]
    if node_flake_ref:
        # node-gyp wants python + make + a compiler in PATH when native deps must be built.
        # Avoid nixpkgs#gcc because nix-portable can fail on store outputs that are symlinks (e.g. gcc-wrapper-man).
        gemini_shell_installables.extend([f"{node_flake_ref}#python3", f"{node_flake_ref}#gnumake", f"{node_flake_ref}#clang"])

    def _nix_shell_cmd(*, installables: list[str], argv: list[str]) -> list[str]:
        return [nix, *nix_flags(), "shell", *installables, "--command", *argv]

    def _node_exec_path() -> str | None:
        try:
            proc = subprocess.run(
                [nix, *nix_flags(), "shell", node_attr, "--command", "node", "-p", "process.execPath"],
                cwd=root,
                text=True,
                capture_output=True,
                env=npm_env,
                timeout=60,
            )
            if proc.returncode != 0:
                return None
            v = (proc.stdout or "").strip()
            return v if v.startswith("/nix/store/") and "/bin/node" in v else (v or None)
        except Exception:
            return None

    def _patch_shebang_to_node(path: Path) -> bool:
        """
        Rewrite a `#!/usr/bin/env node` shebang to `#!<nix-store>/bin/node` (best-effort).
        """
        try:
            if not (path.exists() and path.is_file()):
                return False
            b = path.read_bytes()
            if not b.startswith(b"#!/usr/bin/env node"):
                return False
            node_path = _node_exec_path()
            if not node_path:
                return False
            nl = b.find(b"\n")
            rest = b[nl + 1 :] if nl >= 0 else b""
            path.write_bytes((f"#!{node_path}\n".encode("utf-8")) + rest)
            try:
                path.chmod(0o755)
            except Exception:
                pass
            return True
        except Exception:
            return False

    node_fixed_exec = _node_exec_path() or ""

    def _lock_pinned_client_version(name: str) -> str | None:
        lf = lockfile_path(root)
        if not lf.exists():
            return None
        try:
            d = load_lockfile_dict(lf)
        except Exception:
            return None
        ctab = d.get("clients") if isinstance(d, dict) else None
        ent = (ctab.get(name) if isinstance(ctab, dict) else None) if ctab else None
        ver = ent.get("version") if isinstance(ent, dict) else None
        if isinstance(ver, str) and ver.strip() and ver.strip() != "...":
            return ver.strip()
        return None

    def _client_selfcheck(spec: ClientSpec) -> tuple[bool, str]:
        """
        Best-effort: ensure the installed client can at least execute `--version`.
        This protects against upstream packaging issues (e.g. broken npm "latest").
        """
        try:
            p = clients_bin_dir(root) / spec.bin_name
            if not (p.exists() and os.access(p, os.X_OK)):
                return False, f"missing wrapper: {p}"
            timeout_s = _clients_selfcheck_timeout_s(name=spec.name)
            env_check = dict(npm_env)
            try:
                cb = str(clients_bin_dir(root))
                oldp = env_check.get("PATH", "")
                env_check["PATH"] = (cb + (os.pathsep + oldp if oldp else ""))
            except Exception:
                pass
            last = ""
            for attempt in range(1, 4):
                tmp_path: str | None = None
                proc = None
                try:
                    with tempfile.NamedTemporaryFile(
                        mode="w+",
                        encoding="utf-8",
                        prefix=f"sandworm-client-selfcheck.{spec.name}.",
                        suffix=".txt",
                        delete=False,
                    ) as tmp:
                        tmp_path = tmp.name
                        child = subprocess.Popen(
                            [str(p), "--version"],
                            cwd=str(root),
                            stdout=tmp,
                            stderr=subprocess.STDOUT,
                            env=env_check,
                            text=False,
                            start_new_session=True,
                        )
                        deadline = (time.time() + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
                        try:
                            while True:
                                rc0 = child.poll()
                                if rc0 is not None:
                                    proc = subprocess.CompletedProcess(args=[str(p), "--version"], returncode=int(rc0))
                                    break
                                if deadline is not None and time.time() >= deadline:
                                    _terminate_proc_group(child, grace_s=_provider_timeout_grace_s())
                                    proc = subprocess.CompletedProcess(args=[str(p), "--version"], returncode=124)
                                    last = f"selfcheck timed out after {int(timeout_s)}s"
                                    break
                                time.sleep(0.1)
                        except KeyboardInterrupt:
                            _terminate_proc_group(child, grace_s=_provider_timeout_grace_s())
                            raise
                except Exception as e:
                    last = repr(e)
                try:
                    out = Path(tmp_path).read_text(encoding="utf-8", errors="replace") if tmp_path else ""
                except Exception:
                    out = ""
                try:
                    if tmp_path:
                        Path(tmp_path).unlink(missing_ok=True)
                except Exception:
                    pass

                if proc is not None and proc.returncode == 0 and out.strip():
                    return True, out.strip().splitlines()[0]

                if proc is not None:
                    if int(proc.returncode) == 124:
                        last = last or f"selfcheck timed out after {int(timeout_s)}s"
                    else:
                        last = out.strip() or f"exit={proc.returncode}"

                if _is_transient_text_file_busy(last) and attempt < 4:
                    time.sleep(min(4.0, 0.75 * float(attempt)))
                    continue
                break
            return False, (last or "empty output")
        except Exception as e:
            return False, repr(e)

    # Install packages (best-effort incremental). `npm` will create/update package-lock.json under the prefix.
    prev = clients_installed_manifest(root)
    prev_updated_at = prev.get("updated_at") if isinstance(prev, dict) else None
    prev_updated_at_by_client = prev.get("updated_at_by_client") if isinstance(prev, dict) else None
    installed_versions = _read_installed_versions(root)
    did_npm_install = False
    checked_at = _now_rfc3339_utc()
    updated_at_by_client: dict[str, str] = {}
    install_timeout_s = _clients_install_timeout_s()
    if isinstance(prev_updated_at_by_client, dict):
        for k, v in prev_updated_at_by_client.items():
            if isinstance(k, str) and isinstance(v, str) and k.strip() and v.strip():
                updated_at_by_client[k.strip()] = v.strip()
    for spec in selected:
        have = installed_versions.get(spec.name) if not force else None
        want_ver: str | None = None
        installed_candidate: str | None = None
        gemini_fallback_spec: str | None = None
        if locked:
            lf = lockfile_path(root)
            d = load_lockfile_dict(lf)
            ctab = d.get("clients") if isinstance(d, dict) else None
            ent = (ctab.get(spec.name) if isinstance(ctab, dict) else None) if ctab else None
            ver = ent.get("version") if isinstance(ent, dict) else None
            if not (isinstance(ver, str) and ver.strip() and ver.strip() != "..."):
                raise ClientsError(
                    f"clients install --locked: missing clients.{spec.name}.version in sandworm.lock "
                    "(run `sandworm clients install --update-lock --all`)"
                )
            want_ver = ver.strip()
            pkg_spec = f"{spec.npm_package}@{want_ver}"
        else:
            pkg_spec = f"{spec.npm_package}@{npm_tag}" if npm_tag else spec.npm_package

        need_install = bool(force or not have)
        if locked and want_ver and have != want_ver:
            need_install = True

        if need_install:
            if offline:
                raise ClientsError(
                    f"offline mode enabled; refusing to install missing client {spec.name!r} "
                    "(unset SW_OFFLINE/SANDWORM_OFFLINE or preinstall while online)"
                )
            # Gemini's deps currently include tree-sitter packages whose lifecycle scripts expect
            # `node-gyp-build` to be present. npm can run those scripts before the helper is
            # available when installing multiple packages at once, so preinstall it explicitly.
            if spec.name == "gemini":
                pre_argv = [
                    "npm",
                    "install",
                    "--no-audit",
                    "--no-fund",
                    "node-gyp-build",
                ]
                pre = _nix_shell_cmd(installables=gemini_shell_installables, argv=pre_argv)
                if _progress_enabled():
                    rc = _run_with_heartbeat(
                        cmd=pre,
                        cwd=prefix,
                        env=npm_env,
                        label="installing node-gyp-build (gemini prereq)",
                        timeout_s=install_timeout_s,
                    )
                    if rc != 0:
                        if rc == 124:
                            raise ClientsError(
                                "npm install timed out for gemini prereq: node-gyp-build "
                                "(tune: SW_CLIENTS_INSTALL_TIMEOUT_S)"
                            )
                        raise ClientsError(f"npm install failed (exit code {rc}) for gemini prereq: node-gyp-build")
                else:
                    try:
                        proc = _run_with_capture_timeout(
                            cmd=pre,
                            cwd=prefix,
                            env=npm_env,
                            timeout_s=install_timeout_s,
                        )
                    except subprocess.TimeoutExpired:
                        raise ClientsError(
                            "npm install timed out for gemini prereq: node-gyp-build "
                            "(tune: SW_CLIENTS_INSTALL_TIMEOUT_S)"
                        )
                    if proc.returncode != 0:
                        err = (proc.stderr.strip() or proc.stdout.strip() or f"exit={proc.returncode}")
                        raise ClientsError(f"npm install failed for gemini prereq (node-gyp-build): {err}")
                if not nix_shell_has_usr_bin_env:
                    # tree-sitter-* packages often run `node-gyp-build` during install; on NixOS the upstream
                    # shebang `#!/usr/bin/env node` fails. Patch it to the nix-provided node path.
                    _patch_shebang_to_node(prefix / "node_modules" / "node-gyp-build" / "bin.js")
            # Gemini CLI "latest" has had upstream packaging regressions; make it resilient by
            # falling back to the lockfile-pinned version when `--version` fails post-install.
            pkg_candidates: list[str] = [pkg_spec]
            if (
                spec.name == "gemini"
                and not locked
                and (npm_tag or "").strip() in ("", "latest")
                and not gemini_require_latest
            ):
                fb = _lock_pinned_client_version("gemini") or "0.22.5"
                fb_spec = f"{spec.npm_package}@{fb}"
                if fb_spec != pkg_spec:
                    pkg_candidates.append(fb_spec)
                    gemini_fallback_spec = fb_spec

            last_err = ""
            for attempt_i, cand in enumerate(pkg_candidates, start=1):
                transient_tries = 0
                transient_max = 4
                if _progress_enabled():
                    suffix = "" if attempt_i == 1 else " (fallback)"
                    _note(f"installing provider client {spec.name} via nix+npm{suffix} (first run can take a minute)")
                # Some CLIs bundle native deps via postinstall scripts (e.g. tree-sitter).
                # Upstream occasionally misclassifies build helpers (like node-gyp-build) as devDeps;
                # installing with --omit=dev can then break the runtime install. Prefer correctness
                # over size for those packages.
                omit_args = [] if spec.name == "gemini" else ["--omit=dev"]
                npm_argv = [
                    "npm",
                    "install",
                    "--no-audit",
                    "--no-fund",
                    *omit_args,
                    cand,
                ]
                installables = gemini_shell_installables if spec.name == "gemini" else [node_attr]
                env2 = npm_env
                if spec.name == "gemini":
                    # Provide gcc/g++ shims for build scripts that insist on those names.
                    shim_dir = prefix / ".sandworm-npm-shims" / "bin"
                    try:
                        shim_dir.mkdir(parents=True, exist_ok=True)
                        _write_executable(shim_dir / "gcc", "#!/bin/sh\nset -eu\nexec cc \"$@\"\n")
                        _write_executable(shim_dir / "g++", "#!/bin/sh\nset -eu\nexec c++ \"$@\"\n")
                    except Exception:
                        pass
                    env2 = dict(npm_env)
                    env2["PATH"] = str(shim_dir) + os.pathsep + env2.get("PATH", "")
                cmd = _nix_shell_cmd(installables=installables, argv=npm_argv)
                while True:
                    if _progress_enabled():
                        rc = _run_with_heartbeat(
                            cmd=cmd,
                            cwd=prefix,
                            env=env2,
                            label=f"installing {spec.name} (nix+npm)",
                            timeout_s=install_timeout_s,
                        )
                        if rc != 0:
                            if rc == 124:
                                last_err = f"npm install timed out after {install_timeout_s}s"
                            else:
                                last_err = f"npm install failed (exit code {rc})"
                            # On some kernels/filesystems, a cold nix-portable bootstrap can transiently fail
                            # with ETXTBSY. Retry the same install once or twice before giving up.
                            if transient_tries < transient_max:
                                transient_tries += 1
                                _note(f"WARNING: {spec.name} install failed; retrying (transient; attempt {transient_tries}/{transient_max})")
                                time.sleep(min(8.0, 1.0 * float(2 ** (transient_tries - 1))))
                                continue
                            if attempt_i < len(pkg_candidates):
                                _note(f"WARNING: {spec.name} install failed; retrying with fallback ({last_err})")
                                break
                            raise ClientsError(f"{last_err} for {spec.name}")
                        break
                    else:
                        try:
                            proc = _run_with_capture_timeout(
                                cmd=cmd,
                                cwd=prefix,
                                env=env2,
                                timeout_s=install_timeout_s,
                            )
                        except subprocess.TimeoutExpired:
                            last_err = f"npm install timed out after {install_timeout_s}s"
                            if attempt_i < len(pkg_candidates):
                                _note(f"WARNING: {spec.name} install failed; retrying with fallback ({last_err})")
                                break
                            raise ClientsError(f"{last_err} for {spec.name} (tune: SW_CLIENTS_INSTALL_TIMEOUT_S)")
                        if proc.returncode != 0:
                            last_err = (proc.stderr.strip() or proc.stdout.strip() or f"exit={proc.returncode}")
                            if _is_transient_text_file_busy(last_err) and transient_tries < transient_max:
                                transient_tries += 1
                                time.sleep(min(8.0, 1.0 * float(2 ** (transient_tries - 1))))
                                continue
                            if attempt_i < len(pkg_candidates):
                                _note(f"WARNING: {spec.name} install failed; retrying with fallback ({last_err})")
                                break
                            raise ClientsError(f"npm install failed for {spec.name}: {last_err}")
                        break

                did_npm_install = True
                installed_versions = _read_installed_versions(root)
                updated_at_by_client[spec.name] = checked_at
                installed_candidate = cand
                break

        # Wrapper that runs the npm-provided bin under nix-provided node.
        wrapper_path = bin_dir / spec.bin_name
        if spec.name == "claude":
            wrapper = _claude_wrapper_script(nix=str(nix), node_attr=node_attr, bin_name=spec.bin_name)
        else:
            wrapper = _npm_client_wrapper_script(
                bin_name=spec.bin_name,
                node_fixed_exec=node_fixed_exec,
                nix=str(nix),
                node_attr=node_attr,
            )
        _write_executable(wrapper_path, wrapper)

        # Post-install sanity check for known-brittle packages (Gemini). If "latest" is broken,
        # retry with a pinned fallback so `sandworm gemini` still works.
        if installed_candidate is not None and spec.name == "gemini":
            ok, msg = _client_selfcheck(spec)
            if not ok:
                if gemini_require_latest:
                    if not installed_candidate.endswith("@latest"):
                        raise ClientsError(f"installed gemini appears broken ({msg})")
                    raise ClientsError(
                        f"installed gemini latest appears broken ({msg}); "
                        "SANDWORM_GEMINI_REQUIRE_LATEST=1 forbids fallback"
                    )
                if not installed_candidate.endswith("@latest"):
                    raise ClientsError(f"installed gemini appears broken ({msg})")
                if gemini_fallback_spec is None:
                    raise ClientsError(f"installed gemini latest appears broken ({msg}); no fallback version configured")
                _note(f"WARNING: installed gemini appears broken ({msg}); reinstalling fallback")
                shim = ""
                shim_dir = shlex.quote(str(prefix / ".sandworm-npm-shims" / "bin"))
                shim = (
                    f"shim_dir={shim_dir}; mkdir -p \"$shim_dir\" >/dev/null 2>&1 || true; "
                    "if ! command -v gcc >/dev/null 2>&1 && command -v cc >/dev/null 2>&1; then ln -sf \"$(command -v cc)\" \"$shim_dir/gcc\" >/dev/null 2>&1 || true; fi; "
                    "if ! command -v g++ >/dev/null 2>&1 && command -v c++ >/dev/null 2>&1; then ln -sf \"$(command -v c++)\" \"$shim_dir/g++\" >/dev/null 2>&1 || true; fi; "
                    "export PATH=\"$shim_dir${PATH:+:$PATH}\"; "
                )
                cmd = [
                    nix,
                    *nix_flags(),
                    "shell",
                    *gemini_shell_installables,
                    "--command",
                    "sh",
                    "-lc",
                    (
                        f"cd {shlex.quote(str(prefix))} && {shim}"
                        + " ".join(
                            shlex.quote(a)
                            for a in [
                                "npm",
                                "install",
                                "--no-audit",
                                "--no-fund",
                                gemini_fallback_spec,
                            ]
                        )
                    ),
                ]
                if _progress_enabled():
                    rc = _run_with_heartbeat(
                        cmd=cmd,
                        cwd=root,
                        env=npm_env,
                        label="installing gemini (fallback)",
                        timeout_s=install_timeout_s,
                    )
                    if rc != 0:
                        if rc == 124:
                            raise ClientsError(
                                "gemini fallback install timed out "
                                "(tune: SW_CLIENTS_INSTALL_TIMEOUT_S)"
                            )
                        raise ClientsError(f"gemini fallback install failed (exit code {rc})")
                else:
                    try:
                        proc = _run_with_capture_timeout(
                            cmd=cmd,
                            cwd=root,
                            env=npm_env,
                            timeout_s=install_timeout_s,
                        )
                    except subprocess.TimeoutExpired:
                        raise ClientsError(
                            "gemini fallback install timed out "
                            "(tune: SW_CLIENTS_INSTALL_TIMEOUT_S)"
                        )
                    if proc.returncode != 0:
                        err = proc.stderr.strip() or proc.stdout.strip() or f"exit={proc.returncode}"
                        raise ClientsError(f"gemini fallback install failed: {err}")
                installed_versions = _read_installed_versions(root)
                updated_at_by_client[spec.name] = checked_at
                ok2, msg2 = _client_selfcheck(spec)
                if not ok2:
                    raise ClientsError(f"gemini fallback still appears broken: {msg2}")

    versions = _read_installed_versions(root)
    updated_at: str
    if did_npm_install:
        updated_at = checked_at
    else:
        updated_at = str(prev_updated_at) if isinstance(prev_updated_at, str) and prev_updated_at.strip() else checked_at
    out = {
        "checked_at": checked_at,
        "updated_at": updated_at,
        "updated_at_by_client": updated_at_by_client,
        "node_attr": node_attr,
        "mode": ("locked" if locked else "floating"),
        "npm_tag": (None if locked else npm_tag),
        "versions": versions,
    }
    clients_installed_manifest_path(root).write_text(json.dumps(out, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    if update_lock:
        try:
            import tomlkit  # type: ignore
        except Exception as e:
            raise ClientsError(
                "cannot update lockfile: missing python dependency `tomlkit` "
                "(remediation: run inside `sandworm dev shell` or install tomlkit)"
            ) from e
        lf = lockfile_path(root)
        doc = load_lockfile_doc(lf) if lf.exists() else None
        if doc is None:
            raise ClientsError("cannot update lockfile: sandworm.lock missing (run `sandworm lock init`)")
        try:
            ctab = doc.get("clients")
            if ctab is None:
                ctab = tomlkit.table()
                ctab.add(tomlkit.comment("Provider CLI pins (optional). Sandworm may install/update these into ./.sandworm/clients/"))
                ctab.add("node_attr", node_attr)
                for nm in sorted(CLIENT_SPECS.keys()):
                    ent = tomlkit.table()
                    ent.add("version", "...")
                    ctab.add(nm, ent)
                doc.add("clients", ctab)
            doc["clients"]["node_attr"] = node_attr
            for name, ver in versions.items():
                if name not in CLIENT_SPECS:
                    continue
                if isinstance(ver, str) and ver.strip():
                    doc["clients"][name]["version"] = ver.strip()
        except Exception as e:
            raise ClientsError("failed to update sandworm.lock (missing [clients]?)") from e
        lf.write_text(dump_lockfile_doc(doc), encoding="utf-8")

    return clients_status(root)


def clients_exec(
    root: Path,
    *,
    name: str,
    argv: list[str],
    mode: str = "sandbox",
    image: str = "docker.io/library/node:22-bookworm",
    network: str = "host",
    env: dict[str, str] | None = None,
    kvm_instance: str | None = None,
    posture: str = "safe",
    fallback: bool = False,
    emit: Callable[[str, dict[str, object]], None] | None = None,
) -> int:
    """
    Run an installed provider client under Sandworm-managed HOME/XDG dirs.

    `mode=auto` runs it inside the first available backend in the chain: sandbox (podman) → bwrap → kvm.
    `mode=sandbox` runs it inside a Podman container (default isolation path).
    `mode=bwrap` runs it inside a bwrap sandbox (best-effort).
    `mode=kvm` runs it inside the KVM guest over SSH (best-effort; requires a guest image).
    `mode=inherited` reuses the already-active nested Sandworm backend/posture.
    `posture=bare-metal` forces host execution (no sandbox), regardless of mode.
    """
    root = root.resolve()
    mode = (mode or "sandbox").strip()
    if not mode:
        mode = "sandbox"
    mode_requested = mode
    posture_requested = (posture or "safe").strip()
    if posture_requested not in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev"):
        posture_requested = "safe"
    posture_effective = posture_requested
    nested_backend = (os.environ.get("SANDWORM_BACKEND") or "").strip()
    nested_posture = (os.environ.get("SANDWORM_POSTURE") or "").strip().lower()
    nested_posture_known = nested_posture in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev")
    nested_runtime_markers = _nested_runtime_markers_present()
    env_only_nested_backend = bool(nested_backend and not nested_runtime_markers)
    inherited_posture_match = bool(nested_backend and nested_posture_known and nested_posture == posture_effective)
    # Legacy fallback for old DEV cockpit sessions that did not always propagate SANDWORM_POSTURE.
    inherited_legacy_dev = bool(nested_backend and posture_effective == "dev" and _truthy_env("SANDWORM_DEV_COCKPIT"))
    inherited_possible = bool(nested_runtime_markers and (inherited_posture_match or inherited_legacy_dev))
    if env_only_nested_backend and posture_effective != "bare-metal" and mode_requested in ("auto", "inherited"):
        raise ClientsError(
            "SANDWORM_BACKEND is set, but active nested Sandworm runtime markers are missing "
            "(need /run/sandworm/bin/sandworm and HOME=/run/sandworm/home). "
            "Refusing env-only nested backend context."
        )

    def _socket_create_probe() -> tuple[bool, int | None, str | None]:
        """
        Best-effort: detect environments where seccomp/policy denies `socket()` (EPERM/EACCES).

        In those environments, networking is impossible regardless of DNS config or sandbox backend.
        """
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.close()
            return True, None, None
        except OSError as e:
            return False, getattr(e, "errno", None), (str(e) or None)
        except Exception as e:
            return False, None, repr(e)

    # If the host environment forbids socket creation, online flows may fail.
    # Keep best-effort by default and allow explicit fail-closed enforcement.
    dev_socket_guard_enforced = (
        _truthy_env("SW_DEV_REQUIRE_SOCKET")
        or _truthy_env("SANDWORM_DEV_REQUIRE_SOCKET")
        or _truthy_env("SW_DEV_FAIL_CLOSED_NO_SOCKET")
        or _truthy_env("SANDWORM_DEV_FAIL_CLOSED_NO_SOCKET")
    )
    require_net = (
        (posture_effective == "dev" and bool(dev_socket_guard_enforced))
        or _truthy_env("SW_REQUIRE_NETWORK")
        or _truthy_env("SANDWORM_REQUIRE_NETWORK")
    )
    if require_net and not (_truthy_env("SW_OFFLINE") or _truthy_env("SANDWORM_OFFLINE")) and (network != "none"):
        sock_ok, sock_errno, _sock_err = _socket_create_probe()
        if not sock_ok and sock_errno in (1, 13):
            raise ClientsError(
                "networking is blocked by sandbox policy (socket() denied; errno=%s). "
                "This environment cannot run online provider sessions. "
                "Run Sandworm in a less-restricted environment (recommended), or re-run with SW_OFFLINE=1/--network none."
                % (str(sock_errno))
            )

    def _backend_fail_rc(rc: int) -> bool:
        # Podman uses 125/126/127 for runtime/exec failures; treat these as backend failures
        # so we can fall back to bwrap/KVM automatically.
        return int(rc) in (125, 126, 127)

    def _is_non_backend_clients_error(msg: str) -> bool:
        """
        Errors that should *not* trigger backend fallback.

        These indicate an invocation/configuration problem (for example missing client binary),
        not a backend runtime failure.
        """
        text = (msg or "").strip().lower()
        if not text:
            return False
        markers = (
            "unknown client:",
            "client not installed:",
            "provider host execution requires posture=bare-metal",
            "invalid mode:",
        )
        return any(m in text for m in markers)

    def _dev_auto_fallback_on_provider_failure() -> bool:
        """
        DEV auto-mode compatibility switch.

        Historical behavior could fallback from sandbox->bwrap on *any* provider rc!=0
        even when backend health probes were OK. That hid true provider/runtime errors.
        Keep this disabled by default and allow explicit opt-in only.
        """
        raw = (
            os.environ.get("SW_DEV_AUTO_FALLBACK_ON_PROVIDER_FAILURE")
            or os.environ.get("SANDWORM_DEV_AUTO_FALLBACK_ON_PROVIDER_FAILURE")
            or "0"
        ).strip().lower()
        return raw not in ("0", "false", "no", "off", "n")

    def _warn(msg: str) -> None:
        print(f"[sandworm] WARNING: {msg}", file=sys.stderr)
        try:
            if emit is not None:
                emit("provider_warning", {"provider": name, "message": msg})
        except Exception:
            pass

    force_host_for_bare_metal = False
    if posture_effective == "bare-metal":
        force_host_for_bare_metal = True
        if mode_requested != "host":
            _warn(f"bare-metal posture forces host execution; ignoring mode={mode_requested!r}")
        mode = "host"
        fallback = False
    if posture_effective == "dev":
        # DEV is the default development lane: SAFE-like sandbox boundaries with extra Sandworm
        # development ergonomics (for example toolchain bootstrap), not a host-escape posture.
        if mode_requested not in ("auto", "sandbox", "bwrap", "kvm", "inherited"):
            _warn(f"dev posture requires auto|sandbox|bwrap|kvm|inherited; ignoring mode={mode_requested!r}")
            mode = "auto"

        # DEV networking preflight: warn by default; fail-closed only when explicitly requested.
        try:
            from .doctor import _socket_create_probe

            socket_ok, socket_errno, socket_err = _socket_create_probe()
        except Exception:
            socket_ok, socket_errno, socket_err = True, None, None
        if not bool(socket_ok) and not (os.environ.get("SW_OFFLINE") == "1" or os.environ.get("SANDWORM_OFFLINE") == "1"):
            if dev_socket_guard_enforced:
                raise ClientsError(
                    "DEV requires networking, but this environment forbids socket() "
                    f"(errno={socket_errno}): {socket_err}. "
                    "Run Sandworm in a less-restricted environment (recommended: KVM DEV on a host with /dev/kvm), "
                    "or explicitly set SW_OFFLINE=1 for offline-only runs."
                )
            _warn(
                "DEV socket preflight failed (socket() denied; "
                f"errno={socket_errno}): {socket_err}. Continuing best-effort. "
                "Set SW_DEV_REQUIRE_SOCKET=1 for fail-closed behavior."
            )
    else:
        # Best-effort: only used to refine KVM "fetch via nix" probes below.
        try:
            from .doctor import _socket_create_probe

            socket_ok, _socket_errno, _socket_err = _socket_create_probe()
        except Exception:
            socket_ok = True

    # KVM backend does not provide host escape hatches (/host + hostd). Refuse host-capable postures
    # so posture contracts stay truthful instead of silently degrading.
    if mode_requested == "kvm" and posture_effective in ("unsafe", "take-the-wheel") and not force_host_for_bare_metal:
        raise ClientsError(
            f"kvm mode does not support posture={posture_effective!r} "
            "(host escape is unavailable in kvm; use --mode sandbox|bwrap, or --posture safe|dev with kvm)"
        )

    def _probe_podman_bin() -> str | None:
        override = os.environ.get("SW_PODMAN_BIN") or os.environ.get("SANDWORM_PODMAN_BIN")
        if isinstance(override, str) and override.strip():
            cand = override.strip()
            try:
                if os.path.exists(cand) and os.access(cand, os.X_OK):
                    return cand
            except Exception:
                return None
            return None
        return shutil.which("podman")

    def _probe_bwrap_bin() -> str | None:
        override = os.environ.get("SW_BWRAP_BIN") or os.environ.get("SANDWORM_BWRAP_BIN")
        if isinstance(override, str) and override.strip():
            cand = override.strip()
            try:
                if os.path.exists(cand) and os.access(cand, os.X_OK):
                    return cand
            except Exception:
                return None
            return None
        return shutil.which("bwrap")

    _sandbox_probe_cache: tuple[bool | None, str, dict[str, object] | None] | None = None

    def _sandbox_probe_require_ok_for_dev() -> bool:
        raw = (
            os.environ.get("SW_DEV_SANDBOX_PRECHECK_REQUIRE_OK")
            or os.environ.get("SANDWORM_DEV_SANDBOX_PRECHECK_REQUIRE_OK")
            or "1"
        ).strip().lower()
        return raw not in ("0", "false", "no", "off", "n")

    def _probe_sandbox_backend_health() -> tuple[bool | None, str, dict[str, object] | None]:
        """
        Best-effort backend-health probe for podman sandbox mode.

        Why this exists:
        - Some hosts can launch Podman containers but still cannot provide usable outbound networking
          from inside the container (DNS/TCP fails).
        - In that state, provider CLIs often exit with generic rc=1 (not Podman's rc=125), which used
          to look like an application failure and prevented backend fallback.
        """
        nonlocal _sandbox_probe_cache
        if _sandbox_probe_cache is not None:
            return _sandbox_probe_cache

        probe_toggle = (
            os.environ.get("SW_PROVIDER_SANDBOX_NET_PROBE")
            or os.environ.get("SANDWORM_PROVIDER_SANDBOX_NET_PROBE")
            or "1"
        ).strip().lower()
        if probe_toggle in ("0", "false", "no", "off", "n"):
            _sandbox_probe_cache = (None, "probe disabled by env", None)
            return _sandbox_probe_cache

        if (network or "").strip() == "none":
            _sandbox_probe_cache = (None, "network=none", None)
            return _sandbox_probe_cache

        probe_script = r"""
set -eu
if command -v node >/dev/null 2>&1; then
  node -e 'const dns=require("dns"),net=require("net"); dns.lookup("github.com",(e)=>{ if(e){ console.error("__SW_NET_FAIL__:dns:"+e.message); process.exit(42);} const s=net.createConnection({host:"github.com",port:443,timeout:8000},()=>{s.end(); console.log("__SW_NET_OK__:node"); process.exit(0);}); s.on("error",(err)=>{ console.error("__SW_NET_FAIL__:tcp:"+err.message); process.exit(42);}); s.on("timeout",()=>{ console.error("__SW_NET_FAIL__:timeout"); process.exit(42);}); });'
  exit $?
fi
if command -v python3 >/dev/null 2>&1; then
  python3 - <<'PY'
import socket
import sys
try:
    socket.getaddrinfo("github.com", 443)
    s = socket.create_connection(("github.com", 443), 8)
    s.close()
except Exception as e:
    print("__SW_NET_FAIL__:python:" + str(e), file=sys.stderr)
    raise SystemExit(42)
print("__SW_NET_OK__:python")
PY
  exit $?
fi
if command -v wget >/dev/null 2>&1; then
  wget -T 8 -qO- http://example.com >/dev/null 2>&1 && { echo "__SW_NET_OK__:wget"; exit 0; }
  echo "__SW_NET_FAIL__:wget" >&2
  exit 42
fi
if command -v curl >/dev/null 2>&1; then
  curl -fsS --max-time 8 http://example.com >/dev/null 2>&1 && { echo "__SW_NET_OK__:curl"; exit 0; }
  echo "__SW_NET_FAIL__:curl" >&2
  exit 42
fi
echo "__SW_NET_UNSURE__:no_probe_tool"
exit 0
"""

        try:
            from .podman import dangerous_posture_security_opts, run_with_network_fallback

            podman_env = ensure_storage(root)
            proc, netmeta = run_with_network_fallback(
                root,
                ["sh", "-lc", probe_script],
                image=image,
                podman_env=podman_env,
                network=network,
                workdir="/workspace",
                timeout_s=20,
                mounts=None,
                shares=None,
                env=None,
                stdin=None,
                user=f"{os.getuid()}:{os.getgid()}",
                userns="keep-id",
                expose_control_plane=False,
                security_opts=dangerous_posture_security_opts(posture="dev"),
            )
            combined = ((proc.stdout or "") + "\n" + (proc.stderr or "")).strip()
            rc = int(proc.returncode)
            selected = None
            if isinstance(netmeta, dict):
                selected = netmeta.get("selected")
            if "__SW_NET_OK__" in combined:
                _sandbox_probe_cache = (True, f"probe ok (rc={rc}, network={selected})", netmeta)
            elif "__SW_NET_UNSURE__" in combined:
                _sandbox_probe_cache = (None, f"probe inconclusive (rc={rc}, network={selected})", netmeta)
            elif "__SW_NET_FAIL__" in combined or rc != 0:
                _sandbox_probe_cache = (False, f"probe failed (rc={rc}, network={selected})", netmeta)
            else:
                _sandbox_probe_cache = (None, f"probe inconclusive (rc={rc}, network={selected})", netmeta)
            return _sandbox_probe_cache
        except Exception as e:
            _sandbox_probe_cache = (False, f"probe exception: {e!r}", None)
            return _sandbox_probe_cache

    def _probe_kvm_possible(*, require_dev_kvm: bool = False) -> tuple[bool, str]:
        """
        KVM backend is considered "possible" if qemu is available OR nix is available to fetch it.
        """
        kvm_devnode_ok = False
        try:
            from .doctor import _kvm_writable

            kvm_devnode_ok = bool(_kvm_writable())
        except Exception:
            kvm_devnode_ok = False
        if require_dev_kvm and not kvm_devnode_ok:
            return False, "/dev/kvm not accessible (DEV requires KVM)"

        try:
            from .kvm import _qemu_system_binary  # intentional: cheap, pure function
        except Exception:
            _qemu_system_binary = lambda: "qemu-system-x86_64"  # type: ignore[assignment]
        qemu_prog = _qemu_system_binary()
        if shutil.which(qemu_prog):
            if kvm_devnode_ok:
                return True, f"{qemu_prog} in PATH"
            return True, f"{qemu_prog} in PATH (note: /dev/kvm not accessible; accel may fall back to tcg)"
        try:
            from .nixutils import find_nix

            if find_nix(root):
                if not bool(socket_ok):
                    return False, "nix available but socket() is denied (cannot fetch qemu)"
                if require_dev_kvm and not kvm_devnode_ok:
                    return False, "/dev/kvm not accessible (DEV requires KVM)"
                return True, "nix available (qemu can be fetched)"
        except Exception:
            pass
        return False, f"{qemu_prog} not found and nix not available"

    def _auto_chain() -> tuple[list[str], dict[str, object]]:
        try:
            from .nixutils import find_nix
        except Exception:
            find_nix = lambda _root: None  # type: ignore[assignment]
        try:
            from .bwrap_backend import find_bwrap
        except Exception:
            find_bwrap = None  # type: ignore[assignment]
        podman_bin = _probe_podman_bin()
        podman_ok = False
        podman_reason = "podman not found"
        if podman_bin:
            try:
                # Probe using Sandworm's project-local Podman storage config. This avoids false negatives
                # when $HOME/$XDG_* point at a directory with stale/incompatible Podman state.
                from .podman import ensure_storage

                ensure_storage(root)
                podman_ok = True
                podman_reason = "ok"
            except Exception as e:
                podman_reason = str(e) or repr(e)
        bwrap_hint = _probe_bwrap_bin()
        bwrap_caps = None
        if find_bwrap is not None:
            try:
                bwrap_caps = find_bwrap(root)
            except Exception:
                bwrap_caps = None
        bwrap = str(getattr(bwrap_caps, "path", "") or "") if bwrap_caps is not None else None
        bwrap_ok = bool(bwrap)
        if bwrap_ok:
            bwrap_reason = f"ok ({getattr(bwrap_caps, 'sourced_from', 'unknown')})"
        elif bwrap_hint:
            bwrap_reason = "found in PATH but runtime probe failed"
        else:
            bwrap_reason = "bwrap not found"
        nix = find_nix(root)
        kvm_ok, kvm_reason = _probe_kvm_possible(require_dev_kvm=False)
        chain: list[str] = []
        if inherited_possible:
            chain.append("inherited")
        if podman_ok:
            chain.append("sandbox")
        if bwrap_ok:
            chain.append("bwrap")
        elif not bwrap_hint and nix and socket_ok:
            chain.append("bwrap")
        if kvm_ok and posture_effective in ("safe", "dev"):
            chain.append("kvm")
        meta: dict[str, object] = {
            "podman": bool(podman_ok),
            "podman_reason": str(podman_reason),
            "podman_bin": (str(podman_bin) if podman_bin else None),
            "bwrap": bool(bwrap_ok),
            "bwrap_reason": str(bwrap_reason),
            "bwrap_bin": (str(bwrap_hint) if bwrap_hint else None),
            "nix": bool(nix),
            "kvm_possible": bool(kvm_ok),
            "kvm_reason": str(kvm_reason),
            "socket_create_ok": bool(socket_ok),
            "inherited_backend": (nested_backend if inherited_possible else None),
            "inherited_posture": (nested_posture if nested_posture_known else None),
            "inherited_posture_match": bool(inherited_posture_match),
            "inherited_runtime_markers": bool(nested_runtime_markers),
        }
        return chain, meta

    auto_chain_planned: list[str] | None = None

    if mode_requested == "auto" and not force_host_for_bare_metal:
        fallback = True
        chain, meta = _auto_chain()
        if posture_effective == "dev" and chain and chain[0] == "sandbox" and not _offline_enabled() and (network != "none"):
            if not bool(socket_ok):
                # When host socket() is denied, trust that signal over podman net probes.
                # Keep best-effort by preferring alternate backends first.
                demoted_chain = [m for m in chain if m != "sandbox"]
                if demoted_chain:
                    chain = demoted_chain
                    meta["podman_precheck"] = {
                        "result": "failed",
                        "detail": "host socket() denied during DEV preflight; sandbox deprioritized",
                        "network": None,
                    }
                    _warn(
                        "auto mode rejected sandbox backend for DEV: "
                        "host socket() preflight denied networking; chain now="
                        f"{chain}"
                    )
                else:
                    meta["podman_precheck"] = {
                        "result": "inconclusive",
                        "detail": "host socket() denied during DEV preflight; sandbox retained as only backend",
                        "network": None,
                    }
                    _warn(
                        "auto mode kept sandbox backend for DEV despite socket() preflight denial "
                        "(no alternate backend available)"
                    )
            else:
                probe_ok, probe_detail, probe_meta = _probe_sandbox_backend_health()
                meta["podman_precheck"] = {
                    "result": ("ok" if probe_ok is True else ("failed" if probe_ok is False else "inconclusive")),
                    "detail": probe_detail,
                    "network": probe_meta,
                }
                require_ok = _sandbox_probe_require_ok_for_dev()
                if probe_ok is False or (probe_ok is None and require_ok):
                    chain = [m for m in chain if m != "sandbox"]
                    _warn(
                        "auto mode rejected sandbox backend for DEV: "
                        f"{probe_detail} (require_ok={str(require_ok).lower()}); chain now={chain}"
                    )
        auto_chain_planned = list(chain)
        if not chain:
            raise ClientsError(
                "auto mode: no usable provider backend found "
                "(need podman or bwrap; tip: run `sandworm hostdeps plan`)"
            )
        mode = chain[0]
        log_meta: dict[str, object] = dict(meta)
        for _k in ("podman_bin", "bwrap_bin"):
            _v = log_meta.get(_k)
            if isinstance(_v, str) and _v.strip():
                log_meta[_k] = os.path.basename(_v.strip())
        _warn(f"auto mode selected backend={mode} (chain={chain}; posture={posture_effective}; probes={log_meta})")
        try:
            if emit is not None:
                emit(
                    "provider_backend_plan",
                    {
                        "provider": name,
                        "mode_requested": "auto",
                        "fallback_chain": chain,
                        "selected_backend": mode,
                        "posture": posture_effective,
                        "probes": meta,
                    },
                )
        except Exception:
            pass

    if fallback and mode in ("sandbox", "bwrap"):
        # Optional best-effort fallback chain:
        # podman → bwrap → kvm.
        #
        # Hard choice (alpha): explicit `mode=bwrap|sandbox` is treated as deterministic by default.
        # Callers can opt into fallback by passing `fallback=True` (or via a future `--mode auto`).
        if mode_requested == "auto":
            if auto_chain_planned is not None:
                chain = list(auto_chain_planned)
            else:
                chain, _meta = _auto_chain()
            if not chain:
                raise ClientsError(
                    "auto mode: no usable provider backend found "
                    "(need podman or bwrap; tip: run `sandworm hostdeps plan`)"
                )
        else:
            chain = [mode]
            if mode == "sandbox":
                chain += ["bwrap", "kvm"]
            elif mode == "bwrap":
                chain += ["kvm"]

        tried_refresh = False
        tried_kvm_init = False
        attempt_no = 0
        i = 0
        last_exc: Exception | None = None
        last_rc: int | None = None

        while i < len(chain):
            m = chain[i]
            attempt_no += 1
            try:
                if emit is not None:
                    emit("provider_backend_attempt", {"provider": name, "backend": m, "attempt": attempt_no})
            except Exception:
                pass

            try:
                rc = clients_exec(
                    root,
                    name=name,
                    argv=argv,
                    mode=m,
                    image=image,
                    network=network,
                    env=env,
                    kvm_instance=kvm_instance,
                    posture=posture_effective,
                    fallback=False,
                    emit=emit,
                )
                last_rc = int(rc)
                try:
                    if emit is not None:
                        emit(
                            "provider_backend_result",
                            {"provider": name, "backend": m, "attempt": attempt_no, "exit_code": int(last_rc)},
                        )
                except Exception:
                    pass
            except Exception as e:
                last_exc = e
                msg = str(e)
                try:
                    if emit is not None:
                        emit("provider_backend_error", {"provider": name, "backend": m, "attempt": attempt_no, "error": msg})
                except Exception:
                    pass

                if m == "bwrap" and (not tried_refresh) and "run `sandworm refresh`" in msg:
                    tried_refresh = True
                    _warn(f"bwrap backend missing prerequisites; running `sandworm refresh` and retrying bwrap ({msg})")
                    try:
                        from .toolroot import refresh_toolroot

                        refresh_toolroot(root, update=False, force=False)
                        continue
                    except Exception as e2:
                        _warn(f"`sandworm refresh` failed (continuing fallbacks): {e2}")

                if m == "kvm" and (not tried_kvm_init) and ("guest image missing" in msg or "kvm guest image missing" in msg):
                    tried_kvm_init = True
                    _warn("kvm guest image missing; attempting `sandworm kvm init --fetch` (this may take a while)")
                    try:
                        from .kvm import kvm_init

                        kvm_init(root, instance=kvm_instance, build=False, force=False, fetch=True, update_lock=False)
                        continue
                    except Exception as e2:
                        _warn(f"`sandworm kvm init --fetch` failed (continuing fallbacks): {e2}")

                if isinstance(e, ClientsError) and _is_non_backend_clients_error(msg):
                    raise

                if i < (len(chain) - 1):
                    _warn(f"{m} backend failed; falling back to {chain[i + 1]} ({msg})")
                    i += 1
                    continue
                if isinstance(e, ClientsError):
                    raise
                raise ClientsError(msg) from e

            if i < (len(chain) - 1):
                if m == "sandbox" and _backend_fail_rc(int(last_rc)):
                    _warn(f"{m} backend failed (exit={last_rc}); falling back to {chain[i + 1]}")
                    i += 1
                    continue
                if m == "sandbox" and int(last_rc) != 0 and (network or "").strip() != "none":
                    probe_ok, probe_detail, probe_meta = _probe_sandbox_backend_health()
                    try:
                        if emit is not None:
                            emit(
                                "provider_backend_probe",
                                {
                                    "provider": name,
                                    "backend": m,
                                    "attempt": attempt_no,
                                    "result": (
                                        "ok"
                                        if probe_ok is True
                                        else ("failed" if probe_ok is False else "inconclusive")
                                    ),
                                    "detail": probe_detail,
                                    "network": probe_meta,
                                },
                            )
                    except Exception:
                        pass
                    if probe_ok is False:
                        _warn(
                            f"{m} backend appears unhealthy after provider failure (exit={last_rc}); "
                            f"falling back to {chain[i + 1]} ({probe_detail})"
                        )
                        i += 1
                        continue
                    if probe_ok is None:
                        _warn(
                            f"{m} backend health probe was inconclusive after provider failure (exit={last_rc}); "
                            f"falling back to {chain[i + 1]} ({probe_detail})"
                        )
                        i += 1
                        continue
                if (
                    m == "sandbox"
                    and int(last_rc) != 0
                    and posture_effective == "dev"
                    and mode_requested == "auto"
                    and (network or "").strip() != "none"
                ):
                    if _dev_auto_fallback_on_provider_failure():
                        _warn(
                            f"{m} backend returned exit={last_rc} in DEV auto mode; "
                            f"falling back to {chain[i + 1]} because "
                            "SW_DEV_AUTO_FALLBACK_ON_PROVIDER_FAILURE=1"
                        )
                        i += 1
                        continue
                if m == "bwrap" and int(last_rc) != 0:
                    _warn(f"{m} backend failed (exit={last_rc}); falling back to {chain[i + 1]}")
                    i += 1
                    continue

            try:
                if emit is not None:
                    emit("provider_backend_selected", {"provider": name, "backend": m, "attempt": attempt_no})
            except Exception:
                pass
            return int(last_rc)

        if last_exc is not None:
            if isinstance(last_exc, ClientsError):
                raise last_exc
            raise ClientsError(str(last_exc)) from last_exc
        return int(last_rc or 2)

    if name not in CLIENT_SPECS:
        raise ClientsError(f"unknown client: {name!r} (expected one of: {', '.join(sorted(CLIENT_SPECS.keys()))})")
    spec = CLIENT_SPECS[name]

    host_bin = clients_bin_dir(root) / spec.bin_name
    if not (host_bin.exists() and os.access(host_bin, os.X_OK)):
        raise ClientsError(f"client not installed: {name!r} (expected executable: {host_bin})")

    home_dir = ensure_sandworm_home(root)
    _ensure_home_login_path_profile(home_dir)
    dev_toolchain_bin_in_sandbox: str | None = None
    dev_toolchain_ok = False
    dev_toolchain_requested = bool(posture_effective == "dev" and mode in ("sandbox", "bwrap", "kvm", "inherited"))
    if dev_toolchain_requested:
        # DEV posture should "just have the kitchensink" without requiring humans/LLMs to remember to
        # enter a separate dev shell. Provision once under Sandworm HOME and then just prepend its bin.
        try:
            from .devtools import dev_toolchain_bin_dir_in_sandbox, ensure_dev_toolchain

            res = ensure_dev_toolchain(root, home_dir=home_dir, quiet=True)
            if bool(res.get("ok")):
                dev_toolchain_ok = True
                dev_toolchain_bin_in_sandbox = dev_toolchain_bin_dir_in_sandbox()
            elif not bool(res.get("skipped")):
                err = str(res.get("error") or "unknown error")
                logp = str(res.get("log") or "")
                if logp:
                    _warn(f"DEV toolchain provision failed: {err} (log: {logp})")
                else:
                    _warn(f"DEV toolchain provision failed: {err}")
        except Exception as e:
            _warn(f"DEV toolchain provision failed: {e!r}")
    shares: list[tuple[str, str, str]] = []
    try:
        from .shares import load_shares_checked

        loaded, share_errors = load_shares_checked(root)
        shares = [(s.name, s.src, s.mode) for s in loaded]
        for msg in share_errors:
            _warn(f"share ignored: {msg} (see: sandworm share list)")
    except Exception as e:
        _warn(f"invalid shares configuration (ignoring shares): {e}")
    if _progress_enabled():
        _note("self-docs: $HOME/README.md, $HOME/SANDWORM_ENV.md, $HOME/SANDWORM_RUNBOOK.md (HOME=/run/sandworm/home inside sandboxes)")
    if name == "codex":
        try:
            from .codexhome import ensure_codex_auth_imported, sandworm_codex_home

            ensure_codex_auth_imported(root)
        except Exception:
            pass
    if name == "claude":
        try:
            from .claudehome import ensure_claude_credentials_imported, ensure_claude_settings_local

            ensure_claude_credentials_imported(root)
            res = ensure_claude_settings_local(root)
            if _progress_enabled() and bool(getattr(res, "changed", False)):
                _note(f"claude: wrote settings.local.json to {getattr(res, 'path', '')} ({getattr(res, 'reason', '')})")
        except Exception:
            pass
    gemini_trusted_folders_host_path: str | None = None
