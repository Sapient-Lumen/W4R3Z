def _url_ok_for_session_open(url: str) -> tuple[bool, str | None]:
    """
    Session probe `--open-url` is an explicit opt-in, but we still enforce a safe default:
    - HTTPS only
    - non-localhost
    """
    try:
        p = urlparse(url)
    except Exception:
        return False, "invalid URL"
    if (p.scheme or "").lower() != "https":
        return False, "open_url must be https://"
    host = (p.hostname or "").lower().strip(".")
    if not host:
        return False, "open_url missing hostname"
    if host in ("localhost",) or host.startswith("127.") or host == "::1":
        return False, "open_url must not target localhost"
    return True, None


