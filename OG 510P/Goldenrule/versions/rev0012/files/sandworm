        _safe_mkdir(p["base"])
        with p["audit"].open("a", encoding="utf-8") as f:
            f.write(json.dumps(rec, sort_keys=True) + "\n")
    except Exception:
        pass


def _lock_path(root: Path, name: str) -> Path:
    p = runner_state_paths(root)
    _safe_mkdir(p["locks"])
    safe = "".join([c if c.isalnum() or c in ("-", "_", ".") else "_" for c in (name or "lock")])[:64]
    return p["locks"] / f"{safe}.lock"


class _FileLock:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.f = None

    def __enter__(self) -> "_FileLock":
        import fcntl

        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.f = self.path.open("a+", encoding="utf-8")
        fcntl.flock(self.f.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, exc_type, exc, tb) -> None:
        import fcntl

        try:
            if self.f:
                fcntl.flock(self.f.fileno(), fcntl.LOCK_UN)
        finally:
            try:
                if self.f:
                    self.f.close()
            except Exception:
                pass


def _run_host_cmd_to_file(argv: list[str], *, cwd: Path, env: dict[str, str], log_path: Path, timeout_s: int | None) -> int:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("w", encoding="utf-8") as f:
        try:
            proc = subprocess.run(argv, cwd=str(cwd), env=env, text=True, stdout=f, stderr=subprocess.STDOUT, timeout=timeout_s)
            return int(proc.returncode)
        except subprocess.TimeoutExpired:
            f.write("\n[dev-runner] ERROR: timed out\n")
            return 124
        except Exception as e:
            f.write("\n[dev-runner] ERROR: exception\n")
            f.write(repr(e) + "\n")
            return 125


def _suite_facility_in_kvm(
    *,
    root: Path,
    run_dir: Path,
    full: bool,
    vm_matrix: bool,
    podman_pulls: bool,
    timeout_s: int,
) -> dict[str, Any]:
    """
    Run the repo facility inside a dedicated KVM instance so we don't rely on nested virtualization
    and we keep host execution surface narrow.
    """
    inst = f"dev-runner-facility-{secrets.token_hex(4)}"
    kvm_home = run_dir / "kvm-home"
    _safe_mkdir(kvm_home)

    # Single-flight KVM because Sandworm KVM exports a shared writable HOME by default.
    # We override home_export to a per-run directory, but still avoid multi-VM flake.
    with _FileLock(_lock_path(root, "kvm")):
        init_meta = {}
        try:
            init_meta = kvm_init(root, instance=inst, build=True, force=False, fetch=False)
        except Exception as e:
            return {"ok": False, "error": f"kvm_init failed: {e!r}", "instance": inst}

        try:
            kvm_up(
                root,
                instance=inst,
                build_image=False,
                timeout_s=240,
                expose_private=False,
                shares=None,
                reconfigure=True,
                home_export=kvm_home,
            )
        except Exception as e:
            return {"ok": False, "error": f"kvm_up failed: {e!r}", "instance": inst, "init": init_meta}

        try:
            env = {
                # KVM guest root disks can be small; keep facility temp roots off the guest root disk.
                # Prefer the guest-local ext4 data disk (more reliable exec semantics than 9p mounts).
                "SW_SMOKE_TMP_PARENT": "/home/sand/tmp",
                "SANDWORM_SMOKE_TMP_PARENT": "/home/sand/tmp",
                # Preserve SSH user's HOME (/home/sand) inside the guest so facility smokes that create
                # temp roots exercise SAFE defaults correctly (kvm_exec_in_dir's default sw_home mode
                # sets SANDWORM_HOME/HOME to /run/sandworm/home, which can leak into those smokes).
                "SW_KVM_EXEC_HOME_MODE": "ssh",
                "SW_SMOKE_KEEP_TMP": os.environ.get("SW_SMOKE_KEEP_TMP", "0"),
            }
            if full:
                env["SW_SMOKE_FACILITY_FULL"] = "1"
                env["SANDWORM_SMOKE_FACILITY_FULL"] = "1"
            if vm_matrix:
                env["SW_SMOKE_VM_MATRIX"] = "1"
                env["SANDWORM_SMOKE_VM_MATRIX"] = "1"
            if podman_pulls:
                env["SW_SMOKE_PODMAN_PULLS"] = "1"
                env["SANDWORM_SMOKE_PODMAN_PULLS"] = "1"

            cmd = [
                "bash",
                "-lc",
                "set -euo pipefail; cd /workspace; mkdir -p /home/sand/tmp; "
                "SW_SMOKE_TMP_PARENT=/home/sand/tmp SANDWORM_SMOKE_TMP_PARENT=/home/sand/tmp "
                "./tests/smoke-facility.sh",
            ]
            # kvm_exec_in_dir returns CompletedProcess[str]
            proc = kvm_exec_in_dir(
                root,
                cmd,
                instance=inst,
                workdir="/workspace",
                timeout_s=int(timeout_s) if timeout_s and timeout_s > 0 else None,
                env=env,
                stdin=None,
            )
            out_path = run_dir / "facility-in-kvm.stdout.txt"
            err_path = run_dir / "facility-in-kvm.stderr.txt"
            _atomic_write(out_path, (proc.stdout or ""))
            _atomic_write(err_path, (proc.stderr or ""))
            ok = int(proc.returncode) == 0
            return {
                "ok": bool(ok),
                "instance": inst,
                "exit_code": int(proc.returncode),
                "stdout": str(out_path),
                "stderr": str(err_path),
                "init": init_meta,
            }
        finally:
            try:
                kvm_down(root, instance=inst, purge=True)
            except Exception:
                pass


def _suite_kvm_smokes_host(
    *,
    root: Path,
    run_dir: Path,
    timeout_s: int,
) -> dict[str, Any]:
    """
    Run host-KVM-dependent smokes. This intentionally runs on the host (not in a guest) so /dev/kvm
    is real and the KVM backend is exercised.

    These smokes are shell scripts in the repo. We run them under a DEV bwrap cockpit so:
    - filesystem access is constrained (no host / by default)
    - the repo control plane is available at /workspace/.sandworm (needed for the guest image)
    """
    scripts = [
        ("smoke-dev-kvm", ["./tests/smoke-dev-kvm.sh"], {"SW_SMOKE_KVM_DEV": "1"}),
        ("smoke-dev-kvm-hotbar", ["./tests/smoke-dev-kvm-hotbar.sh"], {"SW_SMOKE_KVM_DEV": "1"}),
        ("smoke-kvm-exec-output", ["./tests/smoke-kvm-exec-output.sh"], {"SW_SMOKE_KVM_EXEC_OUTPUT": "1"}),
        ("smoke-kvm-nixos-rebuild-baseline", ["./tests/smoke-kvm-nixos-rebuild-baseline.sh"], {"SW_SMOKE_KVM_NIXOS_REBUILD_BASELINE": "1"}),
        ("smoke-kvm-nested-sandworm", ["./tests/smoke-kvm-nested-sandworm.sh"], {"SW_SMOKE_KVM_NESTED_SANDWORM": "1"}),
        ("smoke-kvm-ttw-bwrap", ["./tests/smoke-kvm-ttw-bwrap.sh"], {"SW_SMOKE_KVM_TTW_BWRAP": "1"}),
    ]

    # Ensure the guest image exists before running smokes that require it.
    try:
        _ = kvm_init(root, instance=None, build=True, force=False, fetch=False)
    except Exception as e:
        return {"ok": False, "error": f"kvm_init(build) failed: {e!r}"}

    results: list[dict[str, Any]] = []
    ok_all = True
    for name, argv, extra_env in scripts:
        log_path = run_dir / f"{name}.log"
        env = dict(os.environ)
        # Do not leak workspace-core override into temp-root artifacts created by smokes. Many smokes
        # copy `dist/sandworm` into a temp root and execute it; if SW_USE_WORKSPACE_CORE=1 is inherited,
        # that artifact will try (and fail) to locate a source-tree sandworm_core/ directory.
        env.pop("SW_USE_WORKSPACE_CORE", None)
        env.pop("SANDWORM_USE_WORKSPACE_CORE", None)
        env.update(extra_env)
        env["SW_SMOKE_REBUILD_SINGLEFILE"] = "1"
        # Run inside a bwrap dev cockpit so /workspace/.sandworm is visible (needed for .sandworm/kvm image).
        cmd = [
            *_self_argv(),
            "--root",
            str(root),
            "dev",
            "cockpit",
            "--backend",
            "bwrap",
            "--posture",
            "safe",
            "--cwd",
            "/workspace",
            "--",
            "bash",
            "-lc",
            "set -euo pipefail; cd /workspace; " + " ".join(argv),
        ]
        rc = _run_host_cmd_to_file(cmd, cwd=root, env=env, log_path=log_path, timeout_s=timeout_s)
        rec = {"name": name, "exit_code": int(rc), "log": str(log_path)}
        results.append(rec)
        if rc != 0:
            ok_all = False
            # Keep going; collect full failure set.

    return {"ok": bool(ok_all), "results": results}


