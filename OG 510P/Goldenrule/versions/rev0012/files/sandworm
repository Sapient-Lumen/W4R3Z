from __future__ import annotations

import json
import os
import shutil
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path

from .prove import run_prove
from .status import write_status_json


class CertifyError(RuntimeError):
    pass


@dataclass(frozen=True)
class CertifyResult:
    ok: bool
    out_dir: str
    candidate: str
    files: dict[str, str]


def _write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def _now_rfc3339_utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run_certify(
    *,
    root: Path,
    out_dir: Path,
    candidate: Path,
    timeout_s: int,
    skip_build: bool,
    skip_selftest: bool,
    write_status: bool = True,
) -> CertifyResult:
    root = root.resolve()
    out_dir = out_dir.resolve()
    candidate = candidate.resolve()
    out_dir.mkdir(parents=True, exist_ok=True)

    files: dict[str, str] = {}
    ok = True
    summary: dict[str, object] = {"ok": True, "generated_at": _now_rfc3339_utc(), "steps": {}}
    steps: dict[str, object] = summary["steps"]  # type: ignore[assignment]

    # Step 1: build candidate + write proof artifacts.
    prove = run_prove(
        root=root,
        out_dir=out_dir,
        singlefile_out=candidate,
        build=(not skip_build),
        run_doctor=True,
        timeout_s=int(timeout_s),
        require_embedded_core=True,
    )
    steps["prove"] = {"ok": bool(prove.ok), "files": prove.files, "singlefile_out": prove.singlefile_out}
    files.update({k: v for k, v in (prove.files or {}).items() if isinstance(k, str) and isinstance(v, str)})
    if not prove.ok:
        ok = False

    if write_status:
        try:
            p = write_status_json(root, path=out_dir / "status.json")
            files["status_json"] = str(p)
            steps["status"] = {"ok": True, "path": str(p)}
        except Exception as e:
            steps["status"] = {"ok": False, "error": str(e)}

    # Step 2: run the candidate's built-in singlefile selftest (strongest “it works as a product” check).
    if not skip_selftest and candidate.exists():
        certify_root = out_dir / "certify-root"
        if certify_root.exists():
            shutil.rmtree(certify_root, ignore_errors=True)
        certify_root.mkdir(parents=True, exist_ok=True)
        env = os.environ.copy()
        for k in ["SANDWORM_ROOT", "SANDWORM_CORE_DIR", "SANDWORM_EMBEDDED_CORE_DIR", "SANDWORM_SINGLEFILE", "SANDWORM_WRAPPER_PATH", "PYTHONPATH"]:
            env.pop(k, None)
        t0 = time.time()
        try:
            proc = subprocess.run(
                [str(candidate), "--root", str(certify_root), "selftest", "--singlefile"],
                cwd=str(certify_root),
                capture_output=True,
                text=True,
                timeout=max(30, int(timeout_s)),
                env=env,
            )
            dt_ms = int((time.time() - t0) * 1000)
        except subprocess.TimeoutExpired:
            proc = None
            dt_ms = int((time.time() - t0) * 1000)

        stdout_p = out_dir / "candidate_selftest.stdout.txt"
        stderr_p = out_dir / "candidate_selftest.stderr.txt"
        if proc is None:
            stdout_p.write_text("", encoding="utf-8")
            stderr_p.write_text(f"timed out after {timeout_s}s\n", encoding="utf-8")
            steps["candidate_selftest"] = {"ok": False, "error": "timeout", "duration_ms": dt_ms}
            ok = False
        else:
            stdout_p.write_text(proc.stdout or "", encoding="utf-8")
            stderr_p.write_text(proc.stderr or "", encoding="utf-8")
            steps["candidate_selftest"] = {"ok": proc.returncode == 0, "exit_code": int(proc.returncode), "duration_ms": dt_ms}
            if proc.returncode != 0:
                ok = False
        files["candidate_selftest_stdout"] = str(stdout_p)
        files["candidate_selftest_stderr"] = str(stderr_p)

    summary["ok"] = ok
    certify_json = out_dir / "certify.json"
    _write_json(certify_json, summary)
    files["certify_json"] = str(certify_json)

    return CertifyResult(ok=ok, out_dir=str(out_dir), candidate=str(candidate), files=files)
