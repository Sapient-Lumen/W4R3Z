    _one("sandbox", hooks_dir(root), ["pre_run", "post_run", "pre_shell", "post_shell"])
    _one("host", host_hooks_dir(root), ["pre_run", "post_run", "pre_shell", "post_shell", "pre_archive", "post_archive"])
    return res

def hook_is_enabled(root: Path, name: str) -> bool:
