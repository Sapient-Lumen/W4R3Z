    except Exception:
        return None, None


def _terminate_proc_group(proc: subprocess.Popen[str], *, grace_s: int) -> None:
    try:
        pgid = os.getpgid(proc.pid)
    except Exception:
        pgid = None
    if pgid is not None:
        try:
            os.killpg(pgid, signal.SIGTERM)
        except Exception:
            pass
        deadline = time.time() + float(max(1, grace_s))
        while time.time() < deadline:
            if proc.poll() is not None:
                return
            time.sleep(0.05)
        try:
            os.killpg(pgid, signal.SIGKILL)
        except Exception:
            pass
        return
    try:
        proc.terminate()
    except Exception:
        pass
    deadline = time.time() + float(max(1, grace_s))
    while time.time() < deadline:
        if proc.poll() is not None:
            return
        time.sleep(0.05)
    try:
        proc.kill()
    except Exception:
        pass


def _bwrap_usable(path: str) -> bool:
    try:
        p = Path(path)
        if not (p.exists() and os.access(str(p), os.X_OK)):
            return False
        r = subprocess.run(
            [str(p), "--version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
        if r.returncode != 0:
            return False
        # Runtime probe: some environments expose a bwrap binary but deny uid/userns
        # operations at execution time ("setting up uid map: Permission denied").
        # Mark that binary unusable so backend selection/failures are explicit.
        if os.environ.get("SW_BWRAP_SKIP_RUNTIME_PROBE") != "1" and os.environ.get("SANDWORM_BWRAP_SKIP_RUNTIME_PROBE") != "1":
            probe_tail: list[str] | None = None
            if Path("/bin/sh").exists():
                probe_tail = ["/bin/sh", "-lc", "true"]
            elif Path("/usr/bin/sh").exists():
                probe_tail = ["/usr/bin/sh", "-lc", "true"]
            elif Path("/bin/true").exists():
                probe_tail = ["/bin/true"]
            elif Path("/usr/bin/true").exists():
                probe_tail = ["/usr/bin/true"]
            if probe_tail is not None:
                probe = [
                    str(p),
                    "--die-with-parent",
                    "--new-session",
                    "--proc",
                    "/proc",
                    "--dev-bind",
                    "/dev",
                    "/dev",
                    "--ro-bind",
                    "/",
                    "/",
                    *probe_tail,
                ]
                rr = subprocess.run(
                    probe,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=3,
                )
                if rr.returncode != 0:
                    return False
        return True
    except Exception:
        return False


def _shell_usable(path: str) -> bool:
    try:
        p = Path(path)
        if not (p.exists() and os.access(str(p), os.X_OK)):
            return False
        r = subprocess.run(
            [str(p), "-lc", "true"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
        return r.returncode == 0
    except Exception:
        return False


def _select_fallback_shell(*, avoid_bin_prefix: bool = False) -> str | None:
    cands: list[str] = []
    env_bash = os.environ.get("SANDWORM_BASH")
    if isinstance(env_bash, str) and env_bash.strip():
        cands.append(env_bash.strip())
    for w in ("bash", "sh"):
        p = shutil.which(w)
        if isinstance(p, str) and p.strip():
            cands.append(p.strip())
    cands += [
        "/run/current-system/sw/bin/sh",
        "/run/current-system/sw/bin/bash",
        "/bin/sh",
        "/usr/bin/sh",
        "/bin/bash",
        "/usr/bin/bash",
        "/usr/local/bin/bash",
    ]
    try:
        for p in sorted(Path("/nix/store").glob("*bash*/bin/bash")):
            cands.append(str(p))
    except Exception:
        pass
    seen: set[str] = set()
    for cand in cands:
        if not cand or cand in seen:
            continue
        seen.add(cand)
        if avoid_bin_prefix and cand.startswith("/bin/"):
            continue
        if _shell_usable(cand):
            return cand
    return None


