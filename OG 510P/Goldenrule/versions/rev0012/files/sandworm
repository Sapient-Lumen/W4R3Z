    candidate = candidate.resolve()
    target = target.resolve()
    if proof_json is not None:
        proof_json = proof_json.resolve()

    if not candidate.exists():
        raise PromoteError(f"candidate not found: {candidate}")
    if not os.access(candidate, os.X_OK):
        raise PromoteError(f"candidate is not executable: {candidate}")
    if not _looks_like_sandworm_singlefile(candidate):
        raise PromoteError(f"candidate does not look like a sandworm singlefile: {candidate}")

    if not force:
        if proof_json is None:
            raise PromoteError("missing required proof JSON (pass --proof, or use --force)")
        meta = _read_prove_meta(proof_json)
        if not meta:
            raise PromoteError(f"invalid proof JSON: {proof_json}")
        if not bool(meta.get("ok")):
            raise PromoteError(f"proof indicates failure (ok=false): {proof_json}")
        sf = meta.get("singlefile")
        want_sha = sf.get("sha256") if isinstance(sf, dict) else None
        if isinstance(want_sha, str) and want_sha.strip():
