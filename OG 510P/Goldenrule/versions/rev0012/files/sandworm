def claude_cli_login_status(root: Path) -> dict[str, object]:
    """
    Best-effort check for whether Claude Code has stored credentials under Sandworm-managed HOME.
    This does not make network calls.
    """
    p = claude_cli_credentials_path(root)
    out: dict[str, object] = {
        "path": str(p),
        "present": p.exists(),
        "has_oauth": False,
        "has_api_key": False,
        "parse_error": None,
    }
    if not p.exists():
        return out
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception as e:
        out["parse_error"] = str(e)
        return out
    if not isinstance(data, dict):
        out["parse_error"] = "credentials file is not a JSON object"
        return out
    oauth = data.get("claudeAiOauth")
    if isinstance(oauth, dict) and isinstance(oauth.get("accessToken"), str) and oauth.get("accessToken").strip():
        out["has_oauth"] = True
    for k in ("primaryApiKey", "apiKey"):
        v = data.get(k)
        if isinstance(v, str) and v.strip():
            out["has_api_key"] = True
            break
    return out


def claude_cli_clear_credentials(root: Path) -> bool:
    p = claude_cli_credentials_path(root)
    if not p.exists():
        return False
    try:
        p.unlink(missing_ok=True)
        return True
    except Exception:
        return False


