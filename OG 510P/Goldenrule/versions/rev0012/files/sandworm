def _inject_bwrap_ssl_env(env: dict[str, str]) -> None:
    if "NIX_SSL_CERT_FILE" not in env or "SSL_CERT_FILE" not in env or "CURL_CA_BUNDLE" not in env:
        cand = Path("/etc/ssl/certs/ca-certificates.crt")
        if not cand.exists():
            cand = Path("/etc/pki/tls/certs/ca-bundle.crt")
        if not cand.exists():
            try:
                store = Path("/nix/store")
                if store.exists():
                    # NixOS often keeps the CA bundle in the nix store (nss-cacert).
                    matches = list(store.glob("*-nss-cacert-*/etc/ssl/certs/ca-bundle.crt"))
                    if not matches:
                        matches = list(store.glob("*-cacert-*/etc/ssl/certs/ca-bundle.crt"))
                    if matches:
                        cand = matches[0]
            except Exception:
                pass
        if cand.exists():
            try:
                resolved = cand.resolve()
            except Exception:
                resolved = cand
            env.setdefault("NIX_SSL_CERT_FILE", str(resolved))
            env.setdefault("SSL_CERT_FILE", str(resolved))
            env.setdefault("CURL_CA_BUNDLE", str(resolved))
    if "NP_GIT" not in env:
        git = shutil.which("git")
        if git:
            env["NP_GIT"] = git


def _inject_nix_experimental_features_env(env: dict[str, str], *, home_dir: Path) -> None:
    """
    Make `nix shell` / flakes work by default inside Sandworm environments.

    Nix defaults vary across distros; many require explicitly enabling nix-command/flakes.
    Sandworm aims to provide a predictable CLI environment, so set NIX_CONFIG when the
    user does not already have a nix.conf under the Sandworm-managed HOME.
    """
    try:
        if "experimental-features" in str(env.get("NIX_CONFIG", "")):
            return
        nix_conf = home_dir / ".config" / "nix" / "nix.conf"
        if nix_conf.exists():
            return
        cur = str(env.get("NIX_CONFIG", "") or "")
        add = "experimental-features = nix-command flakes"
        env["NIX_CONFIG"] = (cur + ("\n" if cur else "") + add)
    except Exception:
        return


def _maybe_bind_host_node(cmd: list[str]) -> None:
    try:
        # Only bind the canonical host node location. On some hosts `node` may live under
        # /usr/local/bin, and attempting to bind it into /usr/bin can fail when /usr is ro-bound.
        node = Path("/usr/bin/node")
        if node.exists():
