def _slug(s: str | None) -> str:
    if not isinstance(s, str):
        return ""
    v = re.sub(r"[^A-Za-z0-9._-]+", "-", s.strip())
    v = v.strip("-.")
    if not v:
        return ""
    return v[:48]


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


