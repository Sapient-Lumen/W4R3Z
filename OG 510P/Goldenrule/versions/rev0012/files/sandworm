        if quote:
            cur.append(ch)
            if esc:
                esc = False
            elif ch == "\\\\":
                esc = True
            elif ch == quote:
                quote = ""
            continue
        if ch in ("'", '"'):
            quote = ch
            cur.append(ch)
            continue
        if ch in "([":
            depth += 1
            cur.append(ch)
            continue
        if ch in ")]":
            depth = max(0, depth - 1)
            cur.append(ch)
            continue
