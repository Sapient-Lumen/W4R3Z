from __future__ import annotations

import io
import json
import os
import tarfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable

from .creds import ensure_sandworm_home


class BundleError(RuntimeError):
    pass


def _now_compact() -> str:
    return time.strftime("%Y%m%d-%H%M%S", time.localtime())


def _safe_name(name: str) -> str:
    n = (name or "").strip()
    if not n:
        raise BundleError("bundle name must be non-empty")
    allowed = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")
    if any(ch not in allowed for ch in n):
        raise BundleError("bundle name must match [A-Za-z0-9_-]+")
    return n


def _iter_input_paths(root: Path, inputs: Iterable[str]) -> list[Path]:
    out: list[Path] = []
    for raw in inputs:
        if not isinstance(raw, str):
            continue
        s = raw.strip()
        if not s:
            continue
        if s.startswith("/"):
            raise BundleError(f"bundle input must be workspace-relative, not absolute: {s!r}")
        p = (root / s).resolve()
        try:
            p.relative_to(root.resolve())
        except Exception:
            raise BundleError(f"bundle input escapes workspace root: {s!r}")
        if not p.exists():
            raise BundleError(f"bundle input does not exist: {s!r}")
        out.append(p)
    if not out:
        raise BundleError("bundle create: no input paths provided")
    return out


def _tar_filter(root: Path):
    root = root.resolve()

    def _filter(ti: tarfile.TarInfo) -> tarfile.TarInfo | None:
        # Exclude control plane and VCS by default, even if a directory is added recursively.
        name = (ti.name or "").lstrip("./")
        parts = [p for p in name.split("/") if p]
        if any(p in (".sandworm", ".git") for p in parts):
            return None
        # Normalize ownership/timestamps for stable-ish archives.
        ti.uid = 0
        ti.gid = 0
        ti.uname = "root"
        ti.gname = "root"
        ti.mtime = 0
        return ti

    return _filter


@dataclass(frozen=True)
class BundleCreateResult:
    name: str
    archive_path: str
    meta_path: str
    inputs: list[str]


def bundle_create(
    root: Path,
    *,
    name: str,
    inputs: list[str],
    redact_known_secrets: bool = False,
) -> BundleCreateResult:
    root = root.resolve()
    safe = _safe_name(name)
    home = ensure_sandworm_home(root)  # .sandworm/home
    bundles_dir = home / "bundles"
    bundles_dir.mkdir(parents=True, exist_ok=True)

    inp_paths = _iter_input_paths(root, inputs)
    stamp = _now_compact()
    archive = bundles_dir / f"{safe}-{stamp}.tar.gz"
    meta = bundles_dir / f"{safe}-{stamp}.json"

    # Create a tarball that can be consumed inside sandboxes at /run/sandworm/home/bundles/.
    # Store entries relative to the workspace root.
    with tarfile.open(archive, mode="w:gz", dereference=True) as tf:
        if not redact_known_secrets:
            filt = _tar_filter(root)
            for p in inp_paths:
                rel = p.relative_to(root)
                tf.add(str(p), arcname=str(rel.as_posix()), recursive=True, filter=filt)
        else:
            from .creds import redact_known_secrets_text

            max_bytes = int(os.environ.get("SW_BUNDLE_REDACT_MAX_BYTES", str(2 * 1024 * 1024)) or (2 * 1024 * 1024))
            exclude = {".sandworm", ".git"}

            def excluded(rel_parts: tuple[str, ...]) -> bool:
                return any(p in exclude for p in rel_parts)

            def norm_tarinfo(ti: tarfile.TarInfo) -> tarfile.TarInfo:
                ti.uid = 0
                ti.gid = 0
                ti.uname = "root"
                ti.gname = "root"
                ti.mtime = 0
                return ti

            def add_dir(rel: Path) -> None:
                if not rel.as_posix() or rel.as_posix() == ".":
                    return
                ti = tarfile.TarInfo(name=str(rel.as_posix()))
                ti.type = tarfile.DIRTYPE
                ti.mode = 0o755
                ti.size = 0
                tf.addfile(norm_tarinfo(ti))

            def add_file(src_path: Path, rel: Path) -> None:
                rp = rel.as_posix()
                if not rp or rp == ".":
                    return
                # Resolve symlinks; refuse to include data outside the workspace root.
                try:
                    real = src_path.resolve()
                    real.relative_to(root)
                except Exception as e:
                    raise BundleError(f"bundle create: refusing to include path outside workspace root: {src_path} ({e})")

                try:
                    data = real.read_bytes()
                except Exception as e:
                    raise BundleError(f"bundle create: failed to read file: {src_path} ({e})")

                if max_bytes > 0 and len(data) <= max_bytes:
                    try:
                        txt = data.decode("utf-8")
                    except Exception:
                        txt = None
                    if isinstance(txt, str):
                        red = redact_known_secrets_text(root, txt, enabled=True)
                        if red != txt:
                            data = red.encode("utf-8")

                ti = tarfile.TarInfo(name=rp)
                ti.size = len(data)
                try:
                    ti.mode = int(real.stat().st_mode) & 0o777
                except Exception:
                    ti.mode = 0o644
                tf.addfile(norm_tarinfo(ti), fileobj=io.BytesIO(data))

            # Walk each input path and add entries individually so we can redact file contents.
            for p in inp_paths:
                if p.is_symlink():
                    try:
                        if p.resolve().is_dir():
                            raise BundleError(f"bundle create: refusing symlinked directory in redacted mode: {p}")
                    except BundleError:
                        raise
                    except Exception:
                        pass
                if p.is_file() or p.is_symlink():
                    rel = p.relative_to(root)
                    if not excluded(rel.parts):
                        add_file(p, rel)
                    continue
                if not p.is_dir():
                    raise BundleError(f"bundle create: unsupported path type: {p}")
                rel_root = p.relative_to(root)
                if excluded(rel_root.parts):
                    continue
                add_dir(rel_root)
                for cur, dirs, files in os.walk(p, followlinks=False):
                    curp = Path(cur)
                    rel_dir = curp.relative_to(root)
                    if excluded(rel_dir.parts):
                        dirs[:] = []
                        continue
                    dirs[:] = [d for d in dirs if d not in exclude and not (curp / d).is_symlink()]
                    add_dir(rel_dir)
                    for fn in files:
                        fp = curp / fn
                        rel_file = fp.relative_to(root)
                        if excluded(rel_file.parts):
                            continue
                        if fp.is_symlink():
                            # Only allow symlink targets within the workspace root.
                            add_file(fp, rel_file)
                        elif fp.is_file():
                            add_file(fp, rel_file)

    payload: dict[str, Any] = {
        "name": safe,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "archive": str(archive),
        "inputs": [str(Path(x).as_posix()) for x in inputs],
        "redaction": {"known_secrets": bool(redact_known_secrets), "max_bytes": int(max_bytes) if redact_known_secrets else None},
        "notes": [
            "This bundle is stored under .sandworm/home so it is visible inside sandboxes at /run/sandworm/home/bundles/.",
            "Control plane paths (.sandworm) and VCS paths (.git) are excluded by default.",
            ("Known secrets (stored API keys) were redacted from small UTF-8 files." if redact_known_secrets else "No redaction was applied."),
        ],
    }
    meta.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        os.chmod(archive, 0o600)
        os.chmod(meta, 0o600)
    except Exception:
        pass

    return BundleCreateResult(name=safe, archive_path=str(archive), meta_path=str(meta), inputs=list(inputs))


def bundle_list(root: Path) -> list[dict[str, Any]]:
    root = root.resolve()
    home = ensure_sandworm_home(root)
    bundles_dir = home / "bundles"
    if not bundles_dir.exists():
        return []
    out: list[dict[str, Any]] = []
    for p in sorted(bundles_dir.glob("*.tar.gz")):
        try:
            st = p.stat()
            out.append({"path": str(p), "size": int(st.st_size), "mtime": int(st.st_mtime)})
        except Exception:
            out.append({"path": str(p), "size": None, "mtime": None})
    return out


def bundle_rm(root: Path, *, prefix: str) -> int:
    root = root.resolve()
    home = ensure_sandworm_home(root)
    bundles_dir = home / "bundles"
    if not bundles_dir.exists():
        return 0
    pref = (prefix or "").strip()
    if not pref:
        raise BundleError("bundle rm: missing prefix/name")
    removed = 0
    for p in sorted(bundles_dir.iterdir()):
        if p.name.startswith(pref) and (p.suffix in (".json", ".gz") or p.name.endswith(".tar.gz")):
            try:
                p.unlink()
                removed += 1
            except Exception:
                pass
    return removed


def _find_bundle_archive(home_bundles_dir: Path, *, prefix: str) -> Path:
    pref = (prefix or "").strip()
    if not pref:
        raise BundleError("bundle extract: missing prefix/name")
    # Allow passing a full filename.
    if pref.endswith(".tar.gz"):
        p = (home_bundles_dir / pref).resolve()
        if p.exists() and p.is_file():
            return p
    matches = [p for p in sorted(home_bundles_dir.glob("*.tar.gz")) if p.name.startswith(pref)]
    if not matches:
        raise BundleError(f"bundle extract: no bundle found for prefix {pref!r}")
    # Prefer newest by mtime.
    matches.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    return matches[0]


def _tar_members_safe(tf: tarfile.TarFile) -> list[tarfile.TarInfo]:
    safe: list[tarfile.TarInfo] = []
    for m in tf.getmembers():
        name = (m.name or "").lstrip("/")
        if not name or name == ".":
            continue
        if name.startswith("../") or "/../" in name:
            raise BundleError(f"bundle extract: unsafe path traversal in archive entry: {m.name!r}")
        if m.issym() or m.islnk():
            raise BundleError(f"bundle extract: refusing symlink/hardlink entry: {m.name!r}")
        safe.append(m)
    return safe


def bundle_extract(root: Path, *, prefix: str, dest_name: str | None = None, force: bool = False) -> dict[str, Any]:
    """
    Extract a bundle tar.gz into a directory under .sandworm/home/bundles/extracted/.
    This makes bundles consumable in sandboxes without requiring tar tooling.
    """
    root = root.resolve()
    home = ensure_sandworm_home(root)
    bundles_dir = home / "bundles"
    bundles_dir.mkdir(parents=True, exist_ok=True)
    extracted_root = bundles_dir / "extracted"
    extracted_root.mkdir(parents=True, exist_ok=True)

    archive = _find_bundle_archive(bundles_dir, prefix=prefix)
    base = archive.name[:-7] if archive.name.endswith(".tar.gz") else archive.stem
    if dest_name is not None:
        dn = (dest_name or "").strip()
        if not dn:
            raise BundleError("bundle extract: --dest must be non-empty")
        if "/" in dn or dn.startswith(".") or dn.startswith("~"):
            raise BundleError("bundle extract: --dest must be a simple directory name")
        base = dn

    dest = (extracted_root / base).resolve()
    try:
        dest.relative_to(extracted_root.resolve())
    except Exception:
        raise BundleError("bundle extract: destination escapes extracted root")
    if dest.exists():
        if not force:
            raise BundleError(f"bundle extract: destination already exists: {dest} (use --force)")
        # Best-effort clean.
        try:
            for p in sorted(dest.rglob("*"), reverse=True):
                if p.is_file() or p.is_symlink():
                    p.unlink(missing_ok=True)
                elif p.is_dir():
                    p.rmdir()
            dest.rmdir()
        except Exception:
            pass
    dest.mkdir(parents=True, exist_ok=True)

    with tarfile.open(archive, mode="r:gz") as tf:
        members = _tar_members_safe(tf)
        for m in members:
            out_path = (dest / (m.name or "").lstrip("./")).resolve()
            try:
