  local want_sha="${SW_NIX_PORTABLE_SHA256:-${SANDWORM_NIX_PORTABLE_SHA256:-}}"
  local known_good_url="${SW_NIX_PORTABLE_KNOWN_GOOD_URL:-${SANDWORM_NIX_PORTABLE_KNOWN_GOOD_URL:-}}"
  local known_good_sha="${SW_NIX_PORTABLE_KNOWN_GOOD_SHA256:-${SANDWORM_NIX_PORTABLE_KNOWN_GOOD_SHA256:-}}"
