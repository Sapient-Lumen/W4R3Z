if [ ! -x "$NP_BIN" ]; then
  echo "nix-shell: nix-portable missing at $NP_BIN (run: sandworm refresh)" >&2
  exit 2
fi

_sw_writable_dir() {
  d="${1:-}"
  [ -n "$d" ] || return 1
  mkdir -p "$d" >/dev/null 2>&1 || return 1
  [ -w "$d" ]
}

# Keep nix-portable state local to Sandworm roots for reproducibility.
# If backend/home hints are missing inside a sandbox, avoid defaulting to
# /run/sandworm (often mounted read-only for the runtime user).
if [ -z "${NP_LOCATION:-}" ]; then
  host_default="$(cd "$SCRIPT_DIR/../.." && pwd -P)/nix-portable"
  if [ -n "${SANDWORM_BACKEND:-}" ]; then
    if [ -n "${SANDWORM_HOME:-}" ] && _sw_writable_dir "${SANDWORM_HOME}/.nix-portable"; then
      NP_LOCATION="${SANDWORM_HOME}/.nix-portable"
    elif [ -w "/run/sandworm/home" ] && _sw_writable_dir "/run/sandworm/home/.nix-portable"; then
      NP_LOCATION="/run/sandworm/home/.nix-portable"
    elif [ -n "${HOME:-}" ] && _sw_writable_dir "${HOME}/.nix-portable"; then
      NP_LOCATION="${HOME}/.nix-portable"
    else
      NP_LOCATION="/tmp/.nix-portable"
    fi
  else
    if _sw_writable_dir "$host_default"; then
      NP_LOCATION="$host_default"
    elif [ -w "/run/sandworm/home" ] && _sw_writable_dir "/run/sandworm/home/.nix-portable"; then
      NP_LOCATION="/run/sandworm/home/.nix-portable"
    elif [ -n "${HOME:-}" ] && _sw_writable_dir "${HOME}/.nix-portable"; then
      NP_LOCATION="${HOME}/.nix-portable"
    else
      NP_LOCATION="/tmp/.nix-portable"
    fi
  fi
