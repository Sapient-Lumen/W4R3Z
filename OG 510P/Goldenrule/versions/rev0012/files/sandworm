    jl_last = jlsub.add_parser("last", help="Print the last matched value by dotted key path")
    jl_last.add_argument("--file", dest="path", required=True, help="JSONL file path")
    jl_last.add_argument("--where", action="append", default=[], help="Filter: dotted.key=value (repeatable)")
    jl_last.add_argument("--where-contains", action="append", default=[], help="Filter: dotted.key~substring (repeatable)")
    jl_last.add_argument("--key", required=True, help="Dotted key path to print from the matched record")
    jl_last.add_argument("--raw", action="store_true", help="Print scalars without JSON quoting")
    jl_last.add_argument("--json", action="store_true", help="Emit machine-readable JSON (ok/value/error)")

    p_proof = sub.add_parser("proof", help="Proof bundle replay/sign/verify/falsification helpers")
    prsub = p_proof.add_subparsers(dest="proof_cmd", required=True)
    pr_replay = prsub.add_parser("replay", help="Replay and re-validate a proof bundle")
    pr_replay.add_argument("bundle", help="Proof bundle path (suite dir, summary.json, or manifest.json)")
    pr_replay.add_argument("--execute", action="store_true", help="Execute summary.command after verification (dangerous)")
    pr_replay.add_argument("--timeout-s", dest="timeout_s", type=int, default=120, help="Replay command timeout seconds when --execute is used")
    pr_replay.add_argument("--verify-chain", dest="verify_chain", action="store_true", default=True, help="Verify evidence chain membership/integrity (default: on)")
    pr_replay.add_argument("--no-verify-chain", dest="verify_chain", action="store_false", help="Skip evidence chain verification")
    pr_replay.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    pr_sign = prsub.add_parser("sign", help="Write signed manifest + append evidence chain entry for a proof bundle")
    pr_sign.add_argument("bundle", help="Proof bundle path (suite dir, summary.json, or manifest.json)")
    pr_sign.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    pr_verify = prsub.add_parser("verify", help="Verify proof bundle integrity/signature/chain")
    pr_verify.add_argument("bundle", nargs="?", default=None, help="Proof bundle path (required unless --all)")
    pr_verify.add_argument("--all", action="store_true", help="Verify every bundle under --proof-dir (default: dist/proof)")
    pr_verify.add_argument("--proof-dir", default=None, help="Proof root directory containing bundle suites (default: dist/proof)")
    pr_verify.add_argument("--allow-unsigned", action="store_true", help="Allow missing/legacy manifest signatures (warning instead of hard failure)")
    pr_verify.add_argument("--verify-chain", dest="verify_chain", action="store_true", default=True, help="Verify evidence chain membership/integrity (default: on)")
    pr_verify.add_argument("--no-verify-chain", dest="verify_chain", action="store_false", help="Skip evidence chain verification")
    pr_verify.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    pr_falsify = prsub.add_parser("falsify", help="Generate falsification hooks for tamper testing")
    prfsub = pr_falsify.add_subparsers(dest="proof_falsify_cmd", required=True)
    pr_fpack = prfsub.add_parser("pack", help="Generate a falsification hook pack for a proof bundle")
    pr_fpack.add_argument("bundle", help="Proof bundle path (suite dir, summary.json, or manifest.json)")
    pr_fpack.add_argument("--out-dir", default=None, help="Output directory (default: <bundle>/falsify-pack)")
    pr_fpack.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    p_proofb = sub.add_parser("proofbundle", help="Write a standard dist/proof/<suite>/... bundle (test-friendly)")
    pbsub = p_proofb.add_subparsers(dest="proofbundle_cmd", required=True)
    pb_write = pbsub.add_parser("write", help="Create a proof bundle from an existing run directory and artifacts")
    pb_write.add_argument("--out-dir", dest="out_dir", required=True, help="Proof output directory (e.g. dist/proof)")
    pb_write.add_argument("--suite", dest="suite", required=True, help="Suite name (subdir under out-dir)")
    pb_write.add_argument("--run-dir", dest="run_dir", required=True, help="Run directory path (e.g. .sandworm/runs/<runid>)")
    pb_write.add_argument("--command", dest="command", default="", help="Human-readable command description")
    pb_write.add_argument("--ok", dest="ok", type=int, choices=[0, 1], required=True, help="Whether the suite succeeded (0/1)")
    pb_write.add_argument("--file", action="append", default=[], help="Artifact mapping key=path (repeatable)")
    pb_write.add_argument("--note", action="append", default=[], help="Note string to record in summary.json (repeatable)")
    pb_write.add_argument("--sign", action="store_true", help="Also write signed manifest.json and append to evidence chain")
    pb_write.add_argument("--json", action="store_true", help="Emit machine-readable JSON (suite_dir/summary)")

    p_dev = sub.add_parser("dev", help="Self-hosting dev environment helpers")
    dsub = p_dev.add_subparsers(dest="dev_cmd", required=True)
    d_shell = dsub.add_parser("shell", help="Open a Nix dev shell for working on Sandworm")
    d_shell.add_argument(
        "--flake",
        default=None,
        help="Nix flake ref to use as the nixpkgs base (default: env/lock ref when available, else nixpkgs-unstable tarball ref)",
    )
    d_shell.add_argument("--no-default-packages", action="store_true", help="Do not include the default dev package set")
    d_shell.add_argument(
        "--pkg",
        dest="packages",
        action="append",
        default=[],
        help="Extra nixpkgs package or attr path (repeatable; e.g. git, ripgrep, python311Packages.tomlkit)",
    )
    d_shell.add_argument("command", nargs=argparse.REMAINDER, help="Optional command to run (use `--` before argv)")
    d_diag = dsub.add_parser("diag", help="Run dev shell preflight diagnostics and write an artifact")
    d_diag.add_argument(
        "--flake",
        default=None,
        help="Nix flake ref to probe (default: env/lock ref when available, else nixpkgs-unstable tarball ref)",
    )
    d_diag.add_argument("--no-default-packages", action="store_true", help="Probe with only explicitly provided --pkg entries")
    d_diag.add_argument(
        "--pkg",
        dest="packages",
        action="append",
        default=[],
        help="Extra nixpkgs package or attr path for probe (repeatable)",
    )
    d_diag.add_argument("--timeout-s", default=30, type=int, help="Preflight timeout seconds (default: 30)")
    d_diag.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    d_cockpit = dsub.add_parser("cockpit", help="Open a dev cockpit for working on Sandworm (self-hosting lane)")
    d_cockpit.add_argument("--backend", default="bwrap", choices=["bwrap", "kvm"], help="Cockpit backend (default: bwrap)")
    d_cockpit.add_argument("--kvm-instance", default=None, help="KVM instance name (when --backend kvm)")
    d_cockpit.add_argument("--kvm-timeout-s", default=240, type=int, help="KVM boot timeout seconds (when --backend kvm)")
    d_cockpit.add_argument("--posture", default="safe", choices=["safe", "unsafe", "take-the-wheel"], help="Host escape posture (default: safe)")
    d_cockpit.add_argument("--cwd", default="/workspace", help="Working directory inside cockpit (default: /workspace)")
    d_cockpit.add_argument("--no-shares", action="store_true", help="Do not mount shares.json entries into /workspace/shared/*")
    d_cockpit.add_argument("command", nargs=argparse.REMAINDER, help="Optional command to run (use `--` before argv); default: sh")

    d_runner = dsub.add_parser("runner", help="DEV runner (host-side test executor for LLM-only development)")
    rsub = d_runner.add_subparsers(dest="runner_cmd", required=True)
    r_serve = rsub.add_parser("serve", help="Run the DEV runner service (foreground)")
    r_serve.add_argument("--host", default="127.0.0.1", help="Bind address (default: 127.0.0.1)")
    r_serve.add_argument("--port", default=0, type=int, help="Bind port (default: use persisted port or pick a free one)")

    r_start = rsub.add_parser("start", help="Start the DEV runner service (background)")
    r_start.add_argument("--host", default="127.0.0.1", help="Bind address (default: 127.0.0.1)")
    r_start.add_argument("--port", default=0, type=int, help="Bind port (default: use persisted port or pick a free one)")
    r_start.add_argument("--kvm-instance", default=None, help="If set, also write the runner token into this KVM instance keys dir")
    r_start.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    r_stop = rsub.add_parser("stop", help="Stop the DEV runner service")
    r_stop.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    r_status = rsub.add_parser("status", help="Show DEV runner status")
    r_status.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    r_run = rsub.add_parser("run", help="Request a suite run from the DEV runner (client)")
    r_run.add_argument("suite", choices=["facility-core", "facility-full", "kvm-smokes-host", "vm-matrix-host", "dev-proof-host", "oracle-host"])
    r_run.add_argument("--addr", default=None, help="Runner address (host:port). Default: $SANDWORM_DEV_RUNNER_ADDR or localhost persisted port.")
    r_run.add_argument("--token-file", default=None, help="Token file path. Default: $SANDWORM_DEV_RUNNER_TOKEN_FILE or /run/sandworm/keys/dev-runner.token if present.")
    r_run.add_argument("--timeout-s", default=7200, type=int, help="Suite timeout seconds (default: 7200)")
    r_run.add_argument("--vm-matrix", action="store_true", help="For facility suites, also run the VM matrix tranche")
    r_run.add_argument("--podman-pulls", action="store_true", help="For facility suites, enable Podman pull coverage")
    r_run.add_argument("--fast", action="store_true", help="For dev-proof-host, run scripts/facility-devproof-fast.sh")
    r_run.add_argument("--dry-run", action="store_true", help="Plan-only runner execution; do not execute host suite")
    r_run.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    p_build = sub.add_parser("build", help="Build Sandworm artifacts")
    bsub = p_build.add_subparsers(dest="build_cmd", required=True)
    b_single = bsub.add_parser("singlefile", help="Build the standalone single-file sandworm artifact")
    b_single.add_argument(
        "--out",
        default=None,
        help="Output path (default: <root>/dist/sandworm if dist/ exists, else <root>/.sandworm/artifacts/sandworm)",
    )
    b_single.add_argument(
        "--use-workspace-core",
        action="store_true",
        help="When running from the singlefile product, embed the workspace sandworm_core instead of the embedded one (dev-only).",
    )
    b_single.add_argument(
        "--format",
        default="files",
        choices=["files", "b64tar"],
        help="Singlefile payload format (default: files). 'files' embeds readable source via heredocs; 'b64tar' is legacy base64+tar.",
    )
    b_single.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    register_share_domain_parsers(sub)

    _assert_top_level_command_registry(sub)
    return parser


def main(argv: list[str] | None = None) -> int:
    raw_argv = list(os.sys.argv[1:] if argv is None else argv)
    args = _parse_args(raw_argv)
    if getattr(args, "cmd", None) in ("codex", "gemini", "claude"):
        setattr(
            args,
            "_top_level_posture_explicit",
            _provider_top_level_posture_explicit(args),
        )
    creds_profile = getattr(args, "creds_profile", None)
    if isinstance(creds_profile, str) and creds_profile.strip():
        os.environ["SW_CREDS_PROFILE"] = creds_profile.strip()
    root = Path(args.root).resolve()

    _apply_host_integrations_flag(getattr(args, "host_integrations", None))
    _apply_safe_home_defaults(root)

    if args.cmd == "docs":
        from .creds import ensure_sandworm_home
        from .runbook import runbook_json, runbook_json_filtered, runbook_md, runbook_md_filtered

        topic = getattr(args, "topic", None)
        if isinstance(topic, str) and topic.strip():
            md_text = runbook_md_filtered(topic.strip())
        else:
            md_text = runbook_md()
        if bool(getattr(args, "json", False)):
            if isinstance(topic, str) and topic.strip():
                out_text = json.dumps(runbook_json_filtered(topic.strip()), indent=2, sort_keys=True) + "\n"
            else:
                out_text = json.dumps(runbook_json(), indent=2, sort_keys=True) + "\n"
        else:
            out_text = md_text

        raw = getattr(args, "write", None)
        if isinstance(raw, str) and raw.strip():
            out_path = Path(raw.strip())
            if not out_path.is_absolute():
                out_path = root / out_path
            out_path.parent.mkdir(parents=True, exist_ok=True)
            out_path.write_text(out_text, encoding="utf-8")
            print(str(out_path))
            return 0

        print(out_text, end="")
        try:
            home = ensure_sandworm_home(root)
            (home / "SANDWORM_RUNBOOK.md").write_text(md_text, encoding="utf-8")
        except Exception:
            pass
        return 0

    if args.cmd == "state":
        from .statebackups import (
            StateBackupError,
            create_state_backup,
            list_state_backups,
            maybe_create_policy_checkpoint,
            restore_state_backup,
            state_backups_dir,
        )

        if args.state_cmd == "show":
            file_override = read_state_root_file(root)
            selected = control_dir(root)
            payload = {
                "root": str(root),
                "state_root_selected": str(selected),
                "state_root_env": os.environ.get("SANDWORM_STATE_ROOT") or os.environ.get("SW_STATE_ROOT"),
                "state_root_file": str(state_root_config_path(root)),
                "state_root_file_value": (str(file_override.path) if file_override.path else None),
                "state_root_readonly": bool(file_override.readonly or _truthy_env("SW_STATE_ROOT_READONLY") or _truthy_env("SANDWORM_STATE_ROOT_READONLY")),
            }
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"- root: {payload['root']}")
                print(f"- state_root_selected: {payload['state_root_selected']}")
                print(f"- state_root_env: {payload['state_root_env'] or ''}")
                print(f"- state_root_file: {payload['state_root_file']}")
                print(f"- state_root_file_value: {payload['state_root_file_value'] or ''}")
                print(f"- state_root_readonly: {str(payload['state_root_readonly']).lower()}")
            return 0

        if args.state_cmd == "use":
            allow_outside = bool(getattr(args, "allow_outside", False)) or _truthy_env("SW_ALLOW_STATE_ROOT_OUTSIDE_ROOT") or _truthy_env(
                "SANDWORM_ALLOW_STATE_ROOT_OUTSIDE_ROOT"
            )
            auto_checkpoint: dict[str, object] = {
                "created": False,
                "reason": "policy_not_applicable",
            }
            marker = (control_dir(root) / "CONTROL_PLANE_DO_NOT_TOUCH")
            if marker.exists():
                try:
                    ac = maybe_create_policy_checkpoint(root=root, command_family="state-use", run_id=None)
                    auto_checkpoint = {
                        "created": bool(ac.created),
                        "reason": str(ac.reason),
                        "snapshot_id": ac.snapshot_id,
                        "snapshot_path": ac.snapshot_path,
                        "snapshot_mode": ac.snapshot_mode,
                        "prune_removed": int(ac.prune_removed),
                        "prune_retained": int(ac.prune_retained),
                    }
                except (StateError, StateBackupError) as e:
                    print(f"ERROR: rollback auto-checkpoint (state-use) failed: {e}", file=sys.stderr)
                    return 2
            else:
                auto_checkpoint = {"created": False, "reason": "control_plane_missing"}
            try:
                target = resolve_state_root(root, str(getattr(args, "path")))
                require_control_plane_marker(target)
                try:
                    target.relative_to(root)
                    inside_root = True
                except Exception:
                    inside_root = False
                if not inside_root and not allow_outside:
                    raise StateError(
                        f"refusing state root outside workspace (use --allow-outside or SW_ALLOW_STATE_ROOT_OUTSIDE_ROOT=1): {target}"
                    )
                cfg = write_state_root_file(root, target, readonly=bool(getattr(args, "readonly", False)))
            except StateError as e:
                err_msg = str(e)
                print(f"ERROR: {err_msg}", file=sys.stderr)
                rb: dict[str, object] | None = None
                rb_action: dict[str, object] | None = None
                if bool(auto_checkpoint.get("created")):
                    rb = _compute_rollback_failure_assistant(
                        root=root,
                        command_family="state-use",
                        source="state.use.failure",
                        failure_message=err_msg,
                    )
                    _print_rollback_failure_assistant(rb)
                    rb_action = _maybe_offer_rollback_on_failure(
                        root=root,
                        payload=rb,
                        allow_prompt=(not bool(getattr(args, "json", False))),
                    )
                if bool(getattr(args, "json", False)):
                    print(
                        json.dumps(
                            {
                                "ok": False,
                                "error": err_msg,
                                "state_root": str(getattr(args, "path", "")),
                                "auto_checkpoint": auto_checkpoint,
                                "rollback_recommendation": rb,
                                "rollback_action": rb_action,
                            },
                            indent=2,
                            sort_keys=True,
                        )
                    )
                return 2
            payload = {
                "ok": True,
                "state_root": str(target),
                "state_root_file": str(cfg),
                "readonly": bool(getattr(args, "readonly", False)),
                "auto_checkpoint": auto_checkpoint,
            }
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"state root set: {target}")
                print(f"state root file: {cfg}")
                if bool(getattr(args, "readonly", False)):
                    print("state root mode: readonly")
                if bool(auto_checkpoint.get("created")):
                    print(
                        "auto-checkpoint: "
                        f"{auto_checkpoint.get('snapshot_id')} "
                        f"({auto_checkpoint.get('snapshot_mode')})"
                    )
            return 0

        if args.state_cmd == "clear":
            try:
                removed = clear_state_root_file(root)
            except StateError as e:
                _emit_json_error(args, f"ERROR: {e}")
                return 2
            payload = {"ok": True, "removed": bool(removed), "state_root_file": str(state_root_config_path(root))}
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                if removed:
                    print(f"state root cleared: {payload['state_root_file']}")
                else:
                    print("state root already clear")
            return 0

        if args.state_cmd == "import":
            try:
                src = resolve_state_root(root, str(getattr(args, "src")))
                copied = import_state_root(
                    root=root,
                    src=src,
                    overwrite=bool(getattr(args, "overwrite", False)),
                    skip_volatile=(not bool(getattr(args, "include_volatile", False))),
                )
            except StateError as e:
                _emit_json_error(args, f"ERROR: {e}")
                return 2
            payload = {"ok": True, "src": str(src), "dest": str(root / ".sandworm"), "copied": copied}
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"imported state root from: {src}")
                print(f"dest: {root / '.sandworm'}")
                if copied:
                    print(f"copied: {', '.join(copied)}")
            return 0

        if args.state_cmd == "snapshot":
            try:
                res = create_state_backup(
                    root=root,
                    label=(str(getattr(args, "name", "")) if getattr(args, "name", None) else None),
                    include_volatile=bool(getattr(args, "include_volatile", False)),
                    include_entrypoint=(not bool(getattr(args, "no_entrypoint", False))),
                    pointer_only=bool(getattr(args, "pointer", False)),
                )
            except (StateError, StateBackupError) as e:
                _emit_json_error(args, f"ERROR: {e}")
                return 2
            payload = {
                "ok": bool(res.ok),
                "snapshot_id": res.snapshot_id,
                "path": res.path,
                "state_root_selected": res.state_root_selected,
                "metadata_path": res.metadata_path,
                "skipped": list(res.skipped or []),
                "snapshot_mode": res.snapshot_mode,
            }
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"snapshot created: {res.snapshot_id}")
                print(f"path: {res.path}")
                print(f"state_root_selected: {res.state_root_selected}")
                print(f"snapshot_mode: {res.snapshot_mode}")
                if res.skipped:
                    print("snapshot warnings (skipped entries):")
                    for s in res.skipped[:20]:
                        print(f"- {s}")
                    if len(res.skipped) > 20:
                        print(f"- ... and {len(res.skipped) - 20} more")
            return 0

        if args.state_cmd == "snapshots":
            items = list_state_backups(root=root)
            payload = {"ok": True, "backups_dir": str(state_backups_dir(root)), "count": len(items), "snapshots": items}
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"backups_dir: {payload['backups_dir']}")
                if not items:
                    print("snapshots: none")
                else:
                    for it in items:
                        sid = str(it.get("snapshot_id") or "")
                        created = str(it.get("created_at") or "")
                        label = str(it.get("label") or "")
                        selected = str(it.get("state_root_selected") or "")
                        mode = str(it.get("snapshot_mode") or "")
                        extra = []
                        if created:
                            extra.append(created)
                        if mode:
                            extra.append(f"mode={mode}")
                        if label:
                            extra.append(f"label={label}")
                        if selected:
                            extra.append(f"state_root={selected}")
                        print(f"- {sid}" + (f" ({'; '.join(extra)})" if extra else ""))
            return 0

        if args.state_cmd == "rollback":
            snap = str(getattr(args, "snapshot", "") or "").strip() or None
            use_last = bool(getattr(args, "last", False))
            if snap and use_last:
                raise SystemExit("state rollback: use either --snapshot or --last (not both)")
            if (not snap) and (not use_last):
                use_last = True
            restore_state = not bool(getattr(args, "entrypoint_only", False))
            restore_entrypoint = not bool(getattr(args, "state_only", False))
            if not restore_state and not restore_entrypoint:
                raise SystemExit("state rollback: nothing to restore (check --state-only/--entrypoint-only flags)")
            if not bool(getattr(args, "yes", False)) and sys.stdin.isatty():
                mode_bits: list[str] = []
                if restore_state:
                    mode_bits.append("state")
                if restore_entrypoint:
                    mode_bits.append("entrypoints")
                target = (snap if snap else "latest snapshot")
                print(f"About to rollback {', '.join(mode_bits)} from {target}.", file=sys.stderr)
                ans = input("Continue? [y/N] ").strip().lower()
                if ans not in ("y", "yes"):
                    print("aborted", file=sys.stderr)
                    return 2
            try:
                res = restore_state_backup(
                    root=root,
                    snapshot_id=snap,
                    last=use_last,
                    restore_state=restore_state,
                    restore_entrypoint=restore_entrypoint,
                    activate=True,
                    activate_readonly=bool(getattr(args, "activate_readonly", False)),
                )
            except (StateError, StateBackupError) as e:
                print(f"ERROR: {e}", file=sys.stderr)
                return 2
            payload = {
                "ok": bool(res.ok),
                "snapshot_id": res.snapshot_id,
                "path": res.path,
                "snapshot_mode": res.snapshot_mode,
                "restored_state": bool(res.restored_state),
                "restored_entrypoint": bool(res.restored_entrypoint),
                "state_backup_path": res.state_backup_path,
                "entrypoint_backup_paths": res.entrypoint_backup_paths,
                "activate_readonly": bool(getattr(args, "activate_readonly", False)),
            }
            if bool(getattr(args, "json", False)):
