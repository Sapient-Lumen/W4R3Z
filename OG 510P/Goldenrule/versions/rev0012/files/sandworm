import hashlib
import json
import os
import shutil
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path

from .doctor import collect_doctor_report
from .singlefile import SinglefileError, build_singlefile


class ProveError(RuntimeError):
    pass


@dataclass(frozen=True)
class ProveResult:
    ok: bool
    out_dir: str
    singlefile_out: str | None
    files: dict[str, str]


def _now_rfc3339_utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def _run_singlefile_doctor(
    singlefile: Path,
    *,
    proof_dir: Path,
    timeout_s: int,
    require_embedded_core: bool,
) -> dict[str, object]:
    tmp_root = proof_dir / "tmp-root"
    if tmp_root.exists():
        shutil.rmtree(tmp_root, ignore_errors=True)
    tmp_root.mkdir(parents=True, exist_ok=True)

    if require_embedded_core:
        # Poison any accidental workspace core import; the singlefile must prefer embedded core by default.
        (tmp_root / "sandworm_core").mkdir(parents=True, exist_ok=True)
        (tmp_root / "sandworm_core" / "__init__.py").write_text(
            'raise RuntimeError("workspace sandworm_core was imported (expected embedded core)")\n', encoding="utf-8"
        )

    env = os.environ.copy()
    for k in ["SANDWORM_ROOT", "SANDWORM_CORE_DIR", "SANDWORM_EMBEDDED_CORE_DIR", "SANDWORM_SINGLEFILE", "SANDWORM_WRAPPER_PATH", "PYTHONPATH"]:
        env.pop(k, None)

    out_json = proof_dir / "singlefile_doctor.json"
    t0 = time.time()
    try:
        proc = subprocess.run(
            [str(singlefile), "--root", str(tmp_root), "doctor", "--json"],
            cwd=str(tmp_root),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"timed out after {timeout_s}s"}
    dt_ms = int((time.time() - t0) * 1000)

    (proof_dir / "singlefile_doctor.stdout.txt").write_text(proc.stdout or "", encoding="utf-8")
    (proof_dir / "singlefile_doctor.stderr.txt").write_text(proc.stderr or "", encoding="utf-8")

    if proc.returncode != 0:
        return {"ok": False, "exit_code": int(proc.returncode), "duration_ms": dt_ms}

    try:
        data = json.loads(proc.stdout or "{}")
        if isinstance(data, dict):
            _write_json(out_json, data)
    except Exception:
        pass

    return {"ok": True, "exit_code": 0, "duration_ms": dt_ms, "out_json": str(out_json)}


