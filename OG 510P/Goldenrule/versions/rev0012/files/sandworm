def iter_jsonl_objects(path: Path) -> Iterator[object]:
    text = path.read_text(encoding="utf-8")
    for i, line in enumerate(text.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            yield json.loads(line)
        except Exception as e:
            raise ValueError(f"invalid JSON at {path}:{i}: {e}") from e


def _scalar_equals(v: object, expect: str) -> bool:
    exp = (expect or "").strip()
    if isinstance(v, bool) and exp.lower() in ("true", "false"):
        return v is (exp.lower() == "true")
    if v is None and exp.lower() in ("null", "none", ""):
        return True
    if isinstance(v, int) and exp.lstrip("-").isdigit():
        try:
            return v == int(exp)
        except Exception:
            return False
    if isinstance(v, (str, int, float, bool)):
        return str(v) == exp
    return False


@dataclass(frozen=True)
class JsonlHasResult:
    ok: bool
    matched: bool
    count: int
    error: str | None


def jsonl_has(
    path: Path,
    *,
    where_eq: list[tuple[str, str]] | None = None,
    where_contains: list[tuple[str, str]] | None = None,
) -> JsonlHasResult:
    where_eq = where_eq or []
    where_contains = where_contains or []
    count = 0
    try:
        for rec in iter_jsonl_objects(path):
            count += 1
            if not isinstance(rec, dict):
                continue

            ok = True
            for key, expect in where_eq:
                got = json_get(rec, key)
                if not got.ok or not _scalar_equals(got.value, expect):
                    ok = False
                    break
            if not ok:
                continue

            for key, sub in where_contains:
                got = json_get(rec, key)
                if not got.ok or not isinstance(got.value, str) or sub not in got.value:
                    ok = False
                    break
            if not ok:
                continue

            return JsonlHasResult(ok=True, matched=True, count=count, error=None)
    except Exception as e:
        return JsonlHasResult(ok=False, matched=False, count=count, error=str(e))

    return JsonlHasResult(ok=True, matched=False, count=count, error=None)


