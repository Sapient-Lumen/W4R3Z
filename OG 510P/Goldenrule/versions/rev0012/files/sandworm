            if got_sha != want_sha.strip():
                raise PromoteError(
                    "candidate sha256 mismatch vs proof\n"
                    f"- candidate: {candidate}\n"
                    f"- got: {got_sha}\n"
                    f"- want: {want_sha.strip()}\n"
                    f"- proof: {proof_json}"
