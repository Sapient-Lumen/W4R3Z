    root_visible = _root_control_plane_visible(root)
    root_token_present = False
    try:
        p = control_dir(root) / "host" / "hostd.token"
        if p.exists():
            root_token_present = True
            v = p.read_text(encoding="utf-8").strip()
            return v or None
    except Exception:
        pass
    tok = os.environ.get("SANDWORM_HOSTD_TOKEN")
    if tok:
        # Prefer root-local token when present. If control-plane marker is visible
        # but token file is not present in this namespace, fall back to env token.
        if root_visible and root_token_present and not _hostd_override_forced():
            return None
        if os.environ.get("SANDWORM_HOSTD_SOCK"):
            return tok
        if _nested_runtime_markers_present() and str(sock) == "/run/sandworm/hostd.sock":
            return tok
    return None


def _connect(sockpath: Path) -> socket.socket:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(str(sockpath))
    return s


def _classify_hostd_exception(exc: Exception) -> tuple[str | None, str | None]:
    errno_v = getattr(exc, "errno", None)
    if errno_v in (1, 13):
        return (
            "socket_policy_runtime_constraint",
            "socket() denied by environment policy (EPERM/EACCES)",
        )
    return None, None


