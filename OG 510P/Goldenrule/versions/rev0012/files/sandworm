from __future__ import annotations

import os
import shlex
import shutil
import subprocess
import sys
from typing import Iterable


class PtyWrapError(RuntimeError):
    pass


def _have_tty() -> bool:
    try:
        return bool(sys.stdin.isatty() and sys.stdout.isatty())
    except Exception:
        return False


def _script_path() -> str | None:
    for cand in (
        os.environ.get("SANDWORM_SCRIPT_BIN"),
        os.environ.get("SW_SCRIPT_BIN"),
        shutil.which("script"),
        "/run/current-system/sw/bin/script",
        "/usr/bin/script",
        "/bin/script",
    ):
        if isinstance(cand, str) and cand and os.path.exists(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def _join_cmd(cmd: Iterable[str]) -> str:
    return shlex.join([str(c) for c in cmd])


_SCRIPT_USABLE_CACHE: dict[str, tuple[bool, str]] = {}


def _script_usable(script: str) -> tuple[bool, str]:
    """
    Best-effort probe for whether `script` can actually allocate a pseudo-terminal.
    Some constrained environments ship `script` but deny PTY creation at runtime.
    """
    cached = _SCRIPT_USABLE_CACHE.get(script)
    if cached is not None:
        return cached
    try:
        proc = subprocess.run(
            [script, "-q", "-c", "true", "/dev/null"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=3,
            check=False,
        )
        ok = int(proc.returncode) == 0
        msg = (proc.stderr or "").strip()
        _SCRIPT_USABLE_CACHE[script] = (ok, msg)
        return ok, msg
    except Exception as e:
        msg = str(e).strip()
        _SCRIPT_USABLE_CACHE[script] = (False, msg)
        return False, msg


def wrap_with_pty_if_needed(*, cmd: list[str], force: bool, label: str) -> list[str]:
    """
    Best-effort: wrap a command with `script` to provide a pseudo-TTY when stdin/stdout
    are not attached to a terminal. This helps interactive providers that refuse
    to run without a TTY (e.g., Codex resume/fork).

    If `force` is False or a TTY is already present, return the original command.
    """
    if not force:
        return cmd
    if _have_tty():
        return cmd
    script = _script_path()
    if not script:
        raise PtyWrapError(
            f"{label} requires a TTY, but stdin is not a terminal and `script` was not found. "
            "Install `script` (util-linux), or run from an interactive terminal. "
            "Tip: keep SW_PROVIDER_TTY=auto (default) unless you intentionally want raw TTY behavior."
        )
    ok, detail = _script_usable(script)
    if not ok:
        detail_hint = f" ({detail})" if detail else ""
        raise PtyWrapError(
            f"{label} requires a TTY, but `script` cannot allocate a pseudo-terminal in this environment{detail_hint}. "
            "Run from a real interactive terminal, or set SW_PROVIDER_TTY=off only for non-interactive provider commands."
        )
    return [script, "-q", "/dev/null", "-c", _join_cmd(cmd)]
