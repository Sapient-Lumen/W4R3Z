def _resume_root_identity_warning(root: Path, runid: str) -> str | None:
    man = _load_run_manifest(root, runid)
    if not isinstance(man, dict):
        return None
    repo = man.get("repo")
    if not isinstance(repo, dict):
        return None
    prev = repo.get("root_identity")
    if not isinstance(prev, dict):
        return None
    prev_id = prev.get("identity")
    prev_path = prev.get("canonical_path") or repo.get("root_canonical") or repo.get("root")
    cur = describe_root(root)
    cur_id = cur.get("identity")
    cur_path = cur.get("canonical_path")
    if isinstance(prev_id, str) and prev_id and isinstance(cur_id, str) and cur_id and prev_id != cur_id:
        return (
            "resume root identity mismatch: "
            f"run={runid} recorded_root={prev_path!r} recorded_identity={prev_id} "
            f"current_root={cur_path!r} current_identity={cur_id}. "
            "Use the original --root for this run, or pass --allow-root-mismatch to override."
        )
    if isinstance(prev_path, str) and prev_path and isinstance(cur_path, str) and cur_path and prev_path != cur_path:
        return (
            "WARNING: resume root path differs from recorded canonical path but identity matches: "
            f"run={runid} recorded_root={prev_path!r} current_root={cur_path!r}"
        )
    return None


def _control_plane_observed_populated() -> bool:
    cp = Path("/workspace/.sandworm")
    try:
        if not (cp.exists() and cp.is_dir()):
            return False
        entries = [p.name for p in cp.iterdir() if p.name not in (".", "..")]
        non_private = [n for n in entries if n != "private"]
        if not non_private:
            return False
        # Nested podman/bwrap mask mounts can look populated due to in-sandbox writes,
        # while still preserving host control-plane masking.
        try:
            mi = Path("/proc/self/mountinfo")
            if mi.exists():
                for line in mi.read_text(encoding="utf-8", errors="replace").splitlines():
                    if " - " not in line:
                        continue
                    pre, _post = line.split(" - ", 1)
                    fields = pre.split()
                    if len(fields) < 5:
                        continue
                    if fields[4] != "/workspace/.sandworm":
                        continue
                    mount_root = fields[3]
                    if "/.sandworm/tmp/podman-mask/" in mount_root or "/.sandworm/mask-empty" in mount_root:
                        return False
                    break
        except Exception:
            pass
        return True
    except Exception:
        return False


