@dataclass(frozen=True)
class ProofFalsifyPackResult:
    ok: bool
    bundle_dir: Path
    out_dir: Path
    hooks_file: Path
    scripts: list[Path]
    errors: list[str]


def _now_rfc3339_utc() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def _canonical_json_bytes(payload: dict[str, object]) -> bytes:
    return json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def _safe_rel(root: Path, path: Path) -> str:
    try:
        return str(path.resolve().relative_to(root.resolve())).replace("\\", "/")
    except Exception:
        return str(path.resolve())


def resolve_bundle_dir(root: Path, bundle: str | Path) -> Path:
    p = Path(str(bundle)).expanduser()
    if not p.is_absolute():
        p = root / p
    p = p.resolve()
    if p.is_file() and p.name in ("summary.json", "manifest.json"):
        p = p.parent
    if not p.exists() or not p.is_dir():
        raise ProofOpsError(f"proof bundle not found: {p}")
    summary = p / "summary.json"
    if not summary.exists():
        raise ProofOpsError(f"proof bundle missing summary.json: {p}")
    return p


def _proof_chain_dir(root: Path) -> Path:
    return control_dir(root) / "proof"


def _proof_chain_path(root: Path) -> Path:
    return _proof_chain_dir(root) / "manifest-chain.jsonl"


def _proof_chain_head_path(root: Path) -> Path:
    return _proof_chain_dir(root) / "manifest-chain-head.json"


def _default_signing_key_path(root: Path) -> Path:
    return control_dir(root) / "private" / "evidence-signing.key"


def _read_signing_key(root: Path, *, allow_generate: bool) -> tuple[bytes, str, bool]:
    env_key = (
        os.environ.get("SW_EVIDENCE_SIGNING_KEY")
        or os.environ.get("SANDWORM_EVIDENCE_SIGNING_KEY")
        or ""
    ).strip()
    if env_key:
        b = env_key.encode("utf-8")
        kid = hashlib.sha256(b).hexdigest()[:16]
        return (b, kid, False)

    env_key_file = (
        os.environ.get("SW_EVIDENCE_SIGNING_KEY_FILE")
        or os.environ.get("SANDWORM_EVIDENCE_SIGNING_KEY_FILE")
        or ""
    ).strip()
    if env_key_file:
        kf = Path(env_key_file).expanduser()
        if not kf.is_absolute():
            kf = root / kf
        if not kf.exists():
            raise ProofOpsError(f"signing key file does not exist: {kf}")
        raw = kf.read_text(encoding="utf-8", errors="replace").strip().encode("utf-8")
        if not raw:
            raise ProofOpsError(f"signing key file is empty: {kf}")
        kid = hashlib.sha256(raw).hexdigest()[:16]
        return (raw, kid, False)

    key_path = _default_signing_key_path(root)
    if key_path.exists():
        raw = key_path.read_text(encoding="utf-8", errors="replace").strip().encode("utf-8")
        if not raw:
            raise ProofOpsError(f"signing key file is empty: {key_path}")
        kid = hashlib.sha256(raw).hexdigest()[:16]
        return (raw, kid, False)

    if not allow_generate:
        raise ProofOpsError(
            "evidence signing key is missing; run `sandworm proof sign <bundle>` once to initialize it, "
            "or set SW_EVIDENCE_SIGNING_KEY(_FILE)"
        )

    key_path.parent.mkdir(parents=True, exist_ok=True)
    raw = secrets.token_hex(32).encode("utf-8")
    key_path.write_text(raw.decode("utf-8"), encoding="utf-8")
    try:
        os.chmod(key_path, 0o600)
    except Exception:
        pass
    kid = hashlib.sha256(raw).hexdigest()[:16]
    return (raw, kid, True)


def _collect_bundle_file_records(bundle_dir: Path) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    include: list[Path] = [bundle_dir / "summary.json"]
    events = bundle_dir / "events.jsonl"
    if events.exists() and events.is_file():
        include.append(events)
    artifacts = bundle_dir / "artifacts"
    if artifacts.exists() and artifacts.is_dir():
        for p in sorted([x for x in artifacts.rglob("*") if x.is_file()]):
            include.append(p)
    seen: set[str] = set()
    for path in include:
        rel = str(path.relative_to(bundle_dir)).replace("\\", "/")
        if rel in seen:
            continue
        seen.add(rel)
        st = path.stat()
        records.append(
            {
                "path": rel,
                "size": int(st.st_size),
                "sha256": _sha256_file(path),
            }
        )
    records.sort(key=lambda x: str(x.get("path") or ""))
    return records


def _bundle_digest(records: list[dict[str, object]]) -> str:
    h = hashlib.sha256()
    for rec in records:
        p = str(rec.get("path") or "")
        s = str(rec.get("sha256") or "")
        h.update(f"{p} {s}\n".encode("utf-8"))
    return h.hexdigest()


def _load_chain_entries(chain_path: Path) -> tuple[list[dict[str, Any]], list[str]]:
    entries: list[dict[str, Any]] = []
    errors: list[str] = []
    if not chain_path.exists():
        return (entries, errors)
    text = chain_path.read_text(encoding="utf-8", errors="replace")
    for idx, line in enumerate(text.splitlines(), start=1):
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except Exception as e:
            errors.append(f"chain line {idx}: invalid JSON: {e}")
            continue
        if not isinstance(obj, dict):
            errors.append(f"chain line {idx}: expected JSON object")
            continue
        entries.append(obj)
    return (entries, errors)


def sign_proof_bundle(root: Path, bundle: str | Path) -> ProofManifestWriteResult:
    errors: list[str] = []
    try:
        bundle_dir = resolve_bundle_dir(root, bundle)
    except Exception as e:
        return ProofManifestWriteResult(
            ok=False,
            bundle_dir=Path(str(bundle)),
            manifest_path=None,
            manifest_sha256=None,
            chain_path=None,
            chain_entry_index=None,
            key_id=None,
            generated_key=False,
            errors=[str(e)],
        )

    try:
        summary_obj = json.loads((bundle_dir / "summary.json").read_text(encoding="utf-8"))
        if not isinstance(summary_obj, dict):
            raise ProofOpsError("summary.json must be a JSON object")
    except Exception as e:
        errors.append(f"invalid summary.json: {e}")
        return ProofManifestWriteResult(
            ok=False,
            bundle_dir=bundle_dir,
            manifest_path=None,
            manifest_sha256=None,
            chain_path=None,
            chain_entry_index=None,
            key_id=None,
            generated_key=False,
            errors=errors,
        )

    try:
        key, key_id, generated_key = _read_signing_key(root, allow_generate=True)
    except Exception as e:
        return ProofManifestWriteResult(
            ok=False,
            bundle_dir=bundle_dir,
            manifest_path=None,
            manifest_sha256=None,
            chain_path=None,
            chain_entry_index=None,
            key_id=None,
            generated_key=False,
            errors=[str(e)],
        )

    records = _collect_bundle_file_records(bundle_dir)
    chain_path = _proof_chain_path(root)
    chain_path.parent.mkdir(parents=True, exist_ok=True)
    entries, chain_errors = _load_chain_entries(chain_path)
    errors.extend(chain_errors)

    prev_sha: str | None = None
    if entries:
        last_sha = entries[-1].get("manifest_sha256")
        if isinstance(last_sha, str) and last_sha.strip():
            prev_sha = last_sha.strip()

    manifest_payload: dict[str, object] = {
        "schema": "sandworm.evidence_manifest.v1",
        "generated_at": _now_rfc3339_utc(),
        "bundle": {
            "suite": str(bundle_dir.name),
            "path": _safe_rel(root, bundle_dir),
            "summary_schema": summary_obj.get("schema"),
            "summary_ok": bool(summary_obj.get("ok")),
            "run_id": summary_obj.get("run_id"),
            "command": summary_obj.get("command"),
            "file_count": len(records),
            "bundle_sha256": _bundle_digest(records),
            "files": records,
        },
        "chain": {
            "path": _safe_rel(root, chain_path),
            "prev_manifest_sha256": prev_sha,
            "entry_index": len(entries) + 1,
        },
        "signer": {
            "method": "hmac-sha256",
            "key_id": key_id,
        },
    }
    sig = hmac.new(key, _canonical_json_bytes(manifest_payload), hashlib.sha256).hexdigest()
    manifest_obj = dict(manifest_payload)
    manifest_obj["signature"] = sig

    manifest_path = bundle_dir / "manifest.json"
    manifest_path.write_text(json.dumps(manifest_obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    manifest_sha = _sha256_file(manifest_path)

    entry = {
        "schema": "sandworm.evidence_chain_entry.v1",
        "generated_at": _now_rfc3339_utc(),
        "entry_index": len(entries) + 1,
        "bundle_path": _safe_rel(root, bundle_dir),
        "manifest_path": _safe_rel(root, manifest_path),
        "manifest_sha256": manifest_sha,
        "prev_manifest_sha256": prev_sha,
        "signature": sig,
        "key_id": key_id,
    }
    with chain_path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, sort_keys=True) + "\n")

    head_path = _proof_chain_head_path(root)
    head_path.write_text(json.dumps(entry, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    return ProofManifestWriteResult(
        ok=(len(errors) == 0),
        bundle_dir=bundle_dir,
        manifest_path=manifest_path,
        manifest_sha256=manifest_sha,
        chain_path=chain_path,
        chain_entry_index=int(entry["entry_index"]),
        key_id=key_id,
        generated_key=generated_key,
        errors=errors,
    )


def _verify_chain(
    root: Path,
    *,
    expected_bundle_dir: Path | None = None,
    expected_manifest_sha: str | None = None,
) -> tuple[bool, list[str], list[str], int]:
    errors: list[str] = []
    warnings: list[str] = []
    chain_path = _proof_chain_path(root)
    if not chain_path.exists():
        errors.append(f"chain file missing: {chain_path}")
        return (False, errors, warnings, 0)

    entries, parse_errors = _load_chain_entries(chain_path)
    errors.extend(parse_errors)
    prev: str | None = None
    found_bundle = expected_bundle_dir is None
    found_manifest = expected_manifest_sha is None

    for idx, ent in enumerate(entries, start=1):
        if not isinstance(ent, dict):
            errors.append(f"chain entry {idx}: invalid object")
            continue
        schema = ent.get("schema")
        if schema != "sandworm.evidence_chain_entry.v1":
            errors.append(f"chain entry {idx}: schema mismatch: {schema!r}")
        have_prev = ent.get("prev_manifest_sha256")
        hp = str(have_prev).strip() if isinstance(have_prev, str) else None
        if prev != hp:
            errors.append(
                f"chain entry {idx}: prev_manifest_sha256 mismatch (expected {prev!r}, got {hp!r})"
            )
        sha = ent.get("manifest_sha256")
        if not isinstance(sha, str) or len(sha.strip()) != 64:
            errors.append(f"chain entry {idx}: invalid manifest_sha256")
            continue
        prev = sha.strip()

        mpath_raw = ent.get("manifest_path")
        if isinstance(mpath_raw, str) and mpath_raw.strip():
            mpath = Path(mpath_raw)
            if not mpath.is_absolute():
                mpath = root / mpath
            if mpath.exists() and mpath.is_file():
                got = _sha256_file(mpath)
                if got != sha.strip():
                    errors.append(
                        f"chain entry {idx}: manifest sha mismatch ({mpath} expected {sha.strip()} got {got})"
                    )
            else:
                warnings.append(f"chain entry {idx}: manifest path missing on disk: {mpath}")

        bpath_raw = ent.get("bundle_path")
        if expected_bundle_dir is not None and isinstance(bpath_raw, str) and bpath_raw.strip():
            bpath = Path(bpath_raw)
            if not bpath.is_absolute():
                bpath = root / bpath
            try:
                if bpath.resolve() == expected_bundle_dir.resolve():
                    found_bundle = True
            except Exception:
                pass

        if expected_manifest_sha is not None and sha.strip() == expected_manifest_sha.strip():
            found_manifest = True

    if expected_bundle_dir is not None and not found_bundle:
        errors.append(f"bundle not present in chain: {expected_bundle_dir}")
    if expected_manifest_sha is not None and not found_manifest:
        errors.append(f"manifest sha not present in chain: {expected_manifest_sha}")

    return (len(errors) == 0, errors, warnings, len(entries))


def verify_proof_bundle(
    root: Path,
    bundle: str | Path,
    *,
    require_manifest: bool,
    verify_chain: bool,
    allow_unsigned: bool,
) -> ProofVerifyResult:
    errors: list[str] = []
    warnings: list[str] = []
    summary_obj: dict[str, Any] | None = None
    files_checked = 0
    chain_entries_checked = 0

    try:
        bundle_dir = resolve_bundle_dir(root, bundle)
    except Exception as e:
        return ProofVerifyResult(
            ok=False,
            bundle_dir=Path(str(bundle)),
            summary_path=None,
            manifest_path=None,
            chain_path=_proof_chain_path(root),
            errors=[str(e)],
            warnings=[],
            files_checked=0,
            chain_entries_checked=0,
            summary=None,
        )

    summary_path = bundle_dir / "summary.json"
    try:
        obj = json.loads(summary_path.read_text(encoding="utf-8"))
        if isinstance(obj, dict):
            summary_obj = obj
        else:
            errors.append("summary.json: expected JSON object")
    except Exception as e:
        errors.append(f"summary.json: invalid JSON: {e}")

    events_path = bundle_dir / "events.jsonl"
    if events_path.exists():
        ev = validate_events_jsonl(events_path)
        if not ev.ok:
            errors.extend([f"events.jsonl: {x}" for x in ev.errors])
        for w in ev.warnings:
            warnings.append(f"events.jsonl: {w}")

    manifest_path = bundle_dir / "manifest.json"
    manifest_obj: dict[str, Any] | None = None
    manifest_sha: str | None = None

    if manifest_path.exists():
        try:
            m = json.loads(manifest_path.read_text(encoding="utf-8"))
            if not isinstance(m, dict):
                raise ProofOpsError("expected JSON object")
            manifest_obj = m
        except Exception as e:
            errors.append(f"manifest.json: invalid JSON: {e}")
    else:
        if require_manifest:
            errors.append(f"manifest.json missing: {manifest_path}")
        else:
            warnings.append("manifest.json missing (legacy unsigned proof bundle)")

    if manifest_obj is not None:
        if manifest_obj.get("schema") != "sandworm.evidence_manifest.v1":
            errors.append(f"manifest.json: schema mismatch: {manifest_obj.get('schema')!r}")

        bundle_info = manifest_obj.get("bundle") if isinstance(manifest_obj.get("bundle"), dict) else {}
        files = bundle_info.get("files") if isinstance(bundle_info, dict) else None
        if not isinstance(files, list):
            errors.append("manifest.json: bundle.files missing/invalid")
            files = []

        recomputed_records = _collect_bundle_file_records(bundle_dir)
        recomputed_map = {
            str(rec.get("path") or ""): str(rec.get("sha256") or "") for rec in recomputed_records
        }
        files_checked = len(recomputed_records)

        for i, rec in enumerate(files, start=1):
            if not isinstance(rec, dict):
                errors.append(f"manifest.json: bundle.files[{i}] must be object")
                continue
            rel = rec.get("path")
            want = rec.get("sha256")
            if not isinstance(rel, str) or not rel.strip():
                errors.append(f"manifest.json: bundle.files[{i}].path missing/invalid")
                continue
            if not isinstance(want, str) or len(want.strip()) != 64:
                errors.append(f"manifest.json: bundle.files[{i}].sha256 missing/invalid")
                continue
            rp = bundle_dir / rel
            if not rp.exists() or not rp.is_file():
                errors.append(f"manifest.json: referenced file missing: {rel}")
                continue
            got = _sha256_file(rp)
            if got != want.strip():
                errors.append(f"manifest.json: sha mismatch for {rel}: expected {want.strip()} got {got}")

        for rel, got in recomputed_map.items():
            have = None
            for rec in files:
                if isinstance(rec, dict) and rec.get("path") == rel:
                    have = rec
                    break
            if have is None:
                warnings.append(f"manifest.json: file missing from manifest listing: {rel}")
            else:
                want = have.get("sha256") if isinstance(have, dict) else None
                if isinstance(want, str) and want.strip() and want.strip() != got:
                    errors.append(f"manifest.json: sha mismatch for {rel}: expected {want.strip()} got {got}")

        bundle_sha = bundle_info.get("bundle_sha256") if isinstance(bundle_info, dict) else None
        calc_bundle_sha = _bundle_digest(recomputed_records)
        if isinstance(bundle_sha, str) and bundle_sha.strip():
            if bundle_sha.strip() != calc_bundle_sha:
                errors.append(
                    f"manifest.json: bundle.bundle_sha256 mismatch: expected {bundle_sha.strip()} got {calc_bundle_sha}"
                )

        signature = manifest_obj.get("signature")
        signer = manifest_obj.get("signer") if isinstance(manifest_obj.get("signer"), dict) else {}
        method = signer.get("method") if isinstance(signer, dict) else None
        if method != "hmac-sha256":
            errors.append(f"manifest.json: signer.method mismatch: {method!r}")

        if not isinstance(signature, str) or len(signature.strip()) != 64:
            if allow_unsigned:
                warnings.append("manifest.json: signature missing/invalid and allow_unsigned=1")
            else:
                errors.append("manifest.json: signature missing/invalid")
        else:
            try:
                key, key_id, _ = _read_signing_key(root, allow_generate=False)
                payload = dict(manifest_obj)
                payload.pop("signature", None)
                calc_sig = hmac.new(key, _canonical_json_bytes(payload), hashlib.sha256).hexdigest()
                if calc_sig != signature.strip():
                    errors.append("manifest.json: signature mismatch (tampered manifest or wrong signing key)")
                want_key_id = signer.get("key_id") if isinstance(signer, dict) else None
                if isinstance(want_key_id, str) and want_key_id.strip() and want_key_id.strip() != key_id:
                    errors.append(
                        f"manifest.json: signer.key_id mismatch: expected {want_key_id.strip()} got {key_id}"
                    )
            except Exception as e:
                if allow_unsigned:
                    warnings.append(f"manifest.json: signature verification skipped: {e}")
                else:
                    errors.append(f"manifest.json: signature verification failed: {e}")

        manifest_sha = _sha256_file(manifest_path)

    chain_path = _proof_chain_path(root)
    if verify_chain:
        if manifest_obj is None and allow_unsigned and not require_manifest:
            warnings.append("chain: skipped for unsigned bundle")
        else:
            ok_chain, chain_errors, chain_warnings, checked = _verify_chain(
                root,
                expected_bundle_dir=bundle_dir,
                expected_manifest_sha=manifest_sha,
            )
            chain_entries_checked = checked
            if not ok_chain:
                errors.extend([f"chain: {e}" for e in chain_errors])
            warnings.extend([f"chain: {w}" for w in chain_warnings])

    return ProofVerifyResult(
        ok=(len(errors) == 0),
        bundle_dir=bundle_dir,
        summary_path=summary_path if summary_path.exists() else None,
        manifest_path=manifest_path if manifest_path.exists() else None,
        chain_path=chain_path,
        errors=errors,
        warnings=warnings,
        files_checked=files_checked,
        chain_entries_checked=chain_entries_checked,
        summary=summary_obj,
    )


def replay_proof_bundle(
    root: Path,
    bundle: str | Path,
    *,
    verify_chain: bool,
    execute: bool,
    timeout_s: int,
) -> ProofReplayResult:
    errors: list[str] = []
    # Replay can be used as a lightweight integrity check, but executing the recorded
    # command should require stricter trust guarantees.
    allow_unsigned = (not execute)
    verify = verify_proof_bundle(
        root,
        bundle,
        require_manifest=False,
        verify_chain=verify_chain,
        allow_unsigned=allow_unsigned,
    )

    command: str | None = None
    rc: int | None = None
    out: str | None = None
    err: str | None = None

    if isinstance(verify.summary, dict):
        raw = verify.summary.get("command")
        if isinstance(raw, str) and raw.strip():
            command = raw.strip()

    if execute:
        if not verify.ok:
            errors.append("refusing to execute replay command: proof verification failed")
        elif not verify_chain:
            errors.append("refusing to execute replay command: --verify-chain is required")
        if not command:
            errors.append("summary.command is empty; cannot execute replay")
        elif len(errors) == 0:
            try:
                proc = subprocess.run(
                    command,
                    cwd=root,
                    shell=True,
                    text=True,
                    capture_output=True,
                    timeout=(timeout_s if int(timeout_s) > 0 else None),
                )
                rc = int(proc.returncode)
                out = proc.stdout
                err = proc.stderr
                if rc != 0:
                    errors.append(f"replay command failed with rc={rc}")
            except subprocess.TimeoutExpired:
                errors.append("replay command timed out")
            except Exception as e:
                errors.append(f"replay command failed: {e}")

    ok = verify.ok and (len(errors) == 0)
    return ProofReplayResult(
        ok=ok,
        bundle_dir=verify.bundle_dir,
        verify=verify,
        executed=bool(execute),
        command=command,
        returncode=rc,
        stdout=out,
        stderr=err,
        errors=errors,
    )


def write_falsification_pack(
    root: Path,
    bundle: str | Path,
    *,
    out_dir: str | Path | None = None,
) -> ProofFalsifyPackResult:
    errors: list[str] = []
    try:
        bundle_dir = resolve_bundle_dir(root, bundle)
    except Exception as e:
        return ProofFalsifyPackResult(
            ok=False,
            bundle_dir=Path(str(bundle)),
            out_dir=Path(str(out_dir or "")),
            hooks_file=Path(str(out_dir or "")) / "hooks.json",
            scripts=[],
            errors=[str(e)],
        )

    if out_dir is None:
        dst = bundle_dir / "falsify-pack"
    else:
        dst = Path(str(out_dir)).expanduser()
        if not dst.is_absolute():
            dst = root / dst
    dst.mkdir(parents=True, exist_ok=True)

    scripts: list[Path] = []

    def _write_exec(path: Path, content: str) -> None:
        path.write_text(content, encoding="utf-8")
        try:
            os.chmod(path, 0o755)
        except Exception:
            pass
        scripts.append(path)

    summary_script = dst / "tamper-summary.sh"
    _write_exec(
        summary_script,
        "#!/usr/bin/env bash\n"
        "set -euo pipefail\n"
        f"bundle_dir={json.dumps(str(bundle_dir))}\n"
        "python3 - \"$bundle_dir\" <<'PY'\n"
        "import json\n"
        "import sys\n"
        "from pathlib import Path\n"
        "p = Path(sys.argv[1]) / 'summary.json'\n"
        "doc = json.loads(p.read_text(encoding='utf-8'))\n"
