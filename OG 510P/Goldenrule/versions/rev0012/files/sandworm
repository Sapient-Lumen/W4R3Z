def _resolve_qemu_bin(root: Path) -> str:
    """
    Resolve a usable qemu-system binary path.

    Prefers system qemu if present; otherwise tries to locate it via nix (no host-global install).
    """
    qemu_prog = _qemu_system_binary()
    qemu_bin = shutil.which(qemu_prog)
    nix = find_nix(root)
    if not qemu_bin:
        if not nix:
            raise RuntimeError("qemu not found (install qemu or nix)")
        try:
            store = subprocess.check_output(
                [
                    nix,
                    *nix_flags(),
                    "build",
                    "--no-link",
                    "--print-out-paths",
                    "nixpkgs#qemu",
                ],
                cwd=root,
                text=True,
            ).strip()
            out_paths = [ln.strip() for ln in store.splitlines() if ln.strip()]
            out_path = out_paths[-1] if out_paths else store.strip()
            cand = str(Path(out_path) / "bin" / qemu_prog)
            if os.path.exists(cand) and os.access(cand, os.X_OK):
                qemu_bin = cand
        except Exception:
            qemu_bin = None
    if not qemu_bin:
        raise RuntimeError(f"qemu not available: {qemu_prog}")
    return str(qemu_bin)


