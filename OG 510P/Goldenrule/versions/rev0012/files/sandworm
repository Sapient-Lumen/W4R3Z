        argv = ["./scripts/facility-devproof-fast.sh"]
    else:
        argv = ["./tests/smoke-facility.sh"]
    cmd = ["bash", "-lc", f"set -euo pipefail; cd {shlex.quote(str(root))}; " + " ".join(argv)]
    if dry_run:
