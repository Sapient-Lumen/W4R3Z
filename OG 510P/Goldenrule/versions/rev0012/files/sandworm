        try:
            d = load_lockfile_dict(lf)
            nix = d.get("nix") if isinstance(d, dict) else None
            if isinstance(nix, dict):
                primary = _clean_ref(nix.get("nixpkgs_flake"))
                fb = _clean_ref(nix.get("nixpkgs_flake_fallback"))
