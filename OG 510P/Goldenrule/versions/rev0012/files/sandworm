            except Exception:
                raise BundleError(f"bundle extract: refusing to write outside destination: {m.name!r}")
        tf.extractall(path=dest, members=members)  # nosec - guarded by path checks above

    meta = {
        "archive": str(archive),
        "dest": str(dest),
        "extracted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
