def runner_pid_status(root: Path) -> dict[str, Any]:
    p = runner_state_paths(root)
    root_resolved = None
    try:
        root_resolved = str(root.resolve())
    except Exception:
        root_resolved = str(root)

    def _read_port() -> int | None:
        port_txt = _read_text(p["port"])
        if port_txt and port_txt.isdigit():
            try:
                return int(port_txt)
            except Exception:
                return None
        return None

    def _argv_has_subseq(argv: list[str], subseq: list[str]) -> bool:
        if not subseq:
            return True
        n = len(subseq)
        for i in range(0, max(0, len(argv) - n + 1)):
            if argv[i : i + n] == subseq:
                return True
        return False

    def _find_runner_pid_by_cmdline(*, port: int) -> int | None:
        proc = Path("/proc")
        if not proc.exists():
            return None
        want_port = str(int(port))
        for ent in proc.iterdir():
            if not ent.name.isdigit():
                continue
            pid = int(ent.name)
            try:
                raw = (ent / "cmdline").read_bytes()
            except Exception:
                continue
            if not raw:
                continue
            parts = [p.decode("utf-8", errors="ignore") for p in raw.split(b"\x00") if p]
            # Expect: ... -m sandworm_core --root <root> dev runner serve ... --port <port>
            if not _argv_has_subseq(parts, ["dev", "runner", "serve"]):
                continue
            try:
                i_root = parts.index("--root")
            except ValueError:
                continue
            if i_root + 1 >= len(parts):
                continue
            if parts[i_root + 1] != root_resolved and parts[i_root + 1] != str(root):
                continue
            try:
                i_port = parts.index("--port")
            except ValueError:
                continue
            if i_port + 1 >= len(parts):
                continue
            if parts[i_port + 1] != want_port:
                continue
            return pid
        return None

    pid_txt = _read_text(p["pid"])
    pid = int(pid_txt) if pid_txt and pid_txt.isdigit() else None
    running = False
    if pid:
        try:
            os.kill(pid, 0)
            running = True
        except Exception:
            running = False

    # If the pidfile is stale but a runner is still listening, recover by scanning /proc and
    # updating the pidfile. This keeps `dev runner stop/status` usable even if the runner was
    # started manually (e.g., `dev runner serve`) or the pidfile was lost.
    if not running:
        port = _read_port()
        if port:
            found = _find_runner_pid_by_cmdline(port=port)
            if found:
                pid = int(found)
                running = True
                try:
                    _atomic_write(p["pid"], str(int(pid)) + "\n")
                except Exception:
                    pass
    return {"pid": pid, "running": bool(running), "pid_file": str(p["pid"])}


def runner_stop(root: Path, *, timeout_s: int = 5) -> bool:
    p = runner_state_paths(root)
    st = runner_pid_status(root)
    pid = st.get("pid")
    if not pid:
        try:
            p["pid"].unlink(missing_ok=True)
        except Exception:
            pass
        return True
    try:
        os.kill(int(pid), signal.SIGTERM)
    except Exception:
        try:
            p["pid"].unlink(missing_ok=True)
        except Exception:
            pass
        return True
    deadline = time.time() + float(timeout_s)
    while time.time() < deadline:
        try:
            os.kill(int(pid), 0)
        except Exception:
            try:
                p["pid"].unlink(missing_ok=True)
            except Exception:
                pass
            return True
        time.sleep(0.1)
    try:
        os.kill(int(pid), signal.SIGKILL)
    except Exception:
        pass
    try:
        p["pid"].unlink(missing_ok=True)
    except Exception:
        pass
    return True


def runner_start_daemon(
    root: Path,
    *,
    host: str = "127.0.0.1",
    port: int | None = None,
    kvm_instance_for_token: str | None = None,
) -> RunnerConfig:
    cfg = runner_config_load_or_create(root, host=host, port=port)
    p = runner_state_paths(root)
    st = runner_pid_status(root)
    if st.get("running"):
        _write_kvm_keys_token(root, instance=kvm_instance_for_token, token=cfg.token)
        return cfg

    exe_argv = _self_argv()
    _safe_mkdir(p["base"])
    _safe_mkdir(p["runs"])
    _safe_mkdir(p["locks"])

    with p["log"].open("a", encoding="utf-8") as logf:
        env = dict(os.environ)
        # Ensure the child can import sandworm_core when running from a workspace checkout.
        try:
            cur_py = env.get("PYTHONPATH", "")
            add: list[str] = []
            emb = env.get("SANDWORM_EMBEDDED_CORE_DIR")
            if isinstance(emb, str) and emb.strip():
                add.append(emb.strip())
            add.append(str(root))
            add2 = ":".join([p for p in add if p])
            if add2:
                env["PYTHONPATH"] = (add2 + (":" + cur_py if cur_py else ""))
        except Exception:
            pass
        proc = subprocess.Popen(
            [
                *exe_argv,
                "--root",
                str(root),
                "dev",
                "runner",
                "serve",
                "--host",
                str(cfg.host),
                "--port",
                str(cfg.port),
            ],
            cwd=str(root),
            stdout=logf,
            stderr=logf,
            start_new_session=True,
            env=env,
        )
    _atomic_write(p["pid"], str(int(proc.pid)) + "\n")
    _write_kvm_keys_token(root, instance=kvm_instance_for_token, token=cfg.token)

    # Preflight: ensure the child actually bound the port. This avoids leaving a stale pidfile
    # when the bind fails (port already in use, permissions, etc).
    deadline = time.time() + 4.0
    last_err: str | None = None
    import socket

    while time.time() < deadline:
        if proc.poll() is not None:
            last_err = f"runner exited early (code={proc.returncode})"
            break
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.25)
            s.connect((str(cfg.host), int(cfg.port)))
            s.close()
            last_err = None
            break
        except Exception as e:
            last_err = repr(e)
            try:
                time.sleep(0.1)
            except Exception:
                pass
        finally:
            try:
                s.close()
            except Exception:
                pass

    if last_err is not None:
        try:
            os.kill(int(proc.pid), signal.SIGTERM)
        except Exception:
            pass
        try:
            p["pid"].unlink(missing_ok=True)
        except Exception:
            pass
        raise RuntimeError(f"dev runner failed to start on {cfg.host}:{cfg.port}: {last_err}")

    return cfg


