        try:
            st = p.lstat()
            mode = stat.S_IMODE(st.st_mode)
        except Exception:
            mode = 0o644
        text = _read_payload_text(p)
        files.append(_PayloadFile(rel=rel, mode=mode, text=text))
        total_bytes += len(text.encode("utf-8"))

    # Stable payload ID for caching: sha256 over (rel, mode, sha256(file_bytes)) in deterministic order.
    h = hashlib.sha256()
