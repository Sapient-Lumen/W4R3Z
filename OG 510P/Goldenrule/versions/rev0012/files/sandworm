        "esac; "
        "export SANDWORM_BACKEND=kvm; "
        "cpfs=$(findmnt -n -o FSTYPE --target /workspace/.sandworm 2>/dev/null || true); "
        "test \"$cpfs\" = tmpfs || { echo 'ERROR: control plane is visible at /workspace/.sandworm' >&2; exit 42; };"
    )
    return _ssh_call(root, port=int(st.port), privkey=priv, argv=["bash", "-lc", f"{pre} cd {wd} && exec {cmd}"])

def kvm_logs(root: Path, *, instance: str | None = None, which: str, tail_lines: int) -> str:
    base = _kvm_state_dir(root, instance=instance)
    mapping = {
        "serial": base / "serial.log",
        "stdout": base / "qemu.stdout.log",
        "stderr": base / "qemu.stderr.log",
        "virtiofsd": base / "virtiofsd.log",
    }
    p = mapping.get(which)
    if not p:
        raise ValueError(f"unknown log: {which}")
    if not p.exists():
        return ""
    return _tail_file(p, int(tail_lines))


def kvm_status_human(root: Path, *, instance: str | None = None) -> str:
    st = kvm_status(root, instance=instance)
    if not st.running:
        return "STOPPED"
    base = _kvm_state_dir(root, instance=instance)
    ws = None
    try:
        ws = (base / "workspace.fstype").read_text(encoding="utf-8").strip() if (base / "workspace.fstype").exists() else None
    except Exception:
        ws = None
    extra = f" spice={st.spice_port}" if st.spice_port else ""
    if ws:
        extra += f" workspace={ws}"
    return f"RUNNING pid={st.pid} accel={st.accel} ssh={st.port}{extra}"


def kvm_spice_url(root: Path, *, instance: str | None = None) -> str:
    st = kvm_status(root, instance=instance)
    if not st.running:
        raise RuntimeError("kvm is not running (use `sandworm kvm up`)")
    if not st.spice_port:
        raise RuntimeError("kvm GUI is not enabled (start with `sandworm kvm up --gui on`)")
    return f"spice://127.0.0.1:{int(st.spice_port)}"


def kvm_try_launch_viewer(root: Path, *, url: str) -> bool:
    viewer = shutil.which("remote-viewer") or shutil.which("virt-viewer")
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return False
    try:
        if viewer:
            subprocess.Popen([viewer, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return True
        nix = find_nix(root)
        if not nix:
            return False
        # Best-effort: run remote-viewer from virt-viewer package without installing system-wide.
        cmd = nix_shell_argv(nix, packages=["virt-viewer"], command=["remote-viewer", url])
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def kvm_virtiofs_status(root: Path) -> dict[str, object]:
    marker = _virtiofs_broken_marker(root)
    tail = ""
    if marker.exists():
        try:
            tail = _tail_text(marker.read_text(encoding="utf-8", errors="ignore"), 120)
        except Exception:
            tail = ""
    return {
        "broken_marker": bool(marker.exists()),
        "marker_path": str(marker),
