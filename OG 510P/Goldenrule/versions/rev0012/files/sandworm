    out.append("_sw_write_payload_files() {\n")
    out.append("  local dst=\"$1\"\n")
    out.append("  _sw_mkdir -p \"$dst\" >/dev/null 2>&1 || true\n")
    out.append(f"  local total={len(files)}\n")
    for i, f in enumerate(files):
        rel = f.rel
        d = os.path.dirname(rel)
        if d and d != ".":
            out.append(f"  _sw_mkdir -p \"$dst/{d}\" >/dev/null 2>&1 || true\n")
        seed = f"{i:03d}_{hashlib.sha256(rel.encode('utf-8')).hexdigest()[:10]}"
        delim = _pick_heredoc_delim(seed=seed, content=f.text)
        size_kib = max(1, int(len(f.text.encode("utf-8")) / 1024))
        out.append(f'  if _sw_progress_enabled; then _sw_note "extract: {i + 1}/$total {rel} ({size_kib} KiB)"; fi\n')
        out.append(f"  # {rel}\n")
        out.append(f"  cat > \"$dst/{rel}\" <<'{delim}'\n")
        out.append(f.text)
        if not f.text.endswith("\n"):
            out.append("\n")
        out.append(f"{delim}\n")
        mode = oct(int(f.mode) & 0o777)[2:].zfill(3)
        out.append(f"  chmod {mode} \"$dst/{rel}\" 2>/dev/null || true\n")
    out.append("}\n")
    out.append("_sw_verify_payload_files() {\n")
    out.append("  local dst=\"$1\"\n")
    out.append("  local rel=\"\" want=\"\" got=\"\" p=\"\"\n")
    out.append("  while IFS=$'\\t' read -r rel want; do\n")
    out.append("    [[ -n \"$rel\" ]] || continue\n")
    out.append("    p=\"$dst/$rel\"\n")
    out.append("    if [[ ! -f \"$p\" ]]; then\n")
    out.append("      _sw_err \"singlefile payload verify failed: missing file: $rel\"\n")
    out.append("      return 2\n")
    out.append("    fi\n")
    out.append("    got=\"$(_sw_sha256 \"$p\" 2>/dev/null || true)\"\n")
    out.append("    if [[ -z \"$got\" ]]; then\n")
    out.append("      # Keep behavior aligned with b64tar verification: if no sha tool exists, skip verification.\n")
    out.append("      return 0\n")
    out.append("    fi\n")
    out.append("    if [[ \"$got\" != \"$want\" ]]; then\n")
    out.append("      _sw_err \"singlefile payload verify failed: sha mismatch for $rel (got=$got expected=$want)\"\n")
    out.append("      return 2\n")
    out.append("    fi\n")
    out.append("  done <<'__SW_PAYLOAD_SHA_MANIFEST__'\n")
    for f in files:
        b = f.text.encode("utf-8")
        sha = hashlib.sha256(b).hexdigest()
        out.append(f"{f.rel}\t{sha}\n")
    out.append("__SW_PAYLOAD_SHA_MANIFEST__\n")
    out.append("  return 0\n")
    out.append("}\n")
    return "".join(out)


