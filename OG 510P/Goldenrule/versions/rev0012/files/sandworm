def _next_snapshot_dir(base: Path, *, label: str | None) -> tuple[str, Path]:
    stamp = _now_compact_utc()
    slug = _slug(label)
    base_id = f"{stamp}-{slug}" if slug else stamp
    cand = base / base_id
    if not cand.exists():
