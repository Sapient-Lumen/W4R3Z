export NP_LOCATION

if [ "${NP_LOCATION#/}" = "$NP_LOCATION" ]; then
  echo "nix-shell: NP_LOCATION must be an absolute path (got: $NP_LOCATION)" >&2
  exit 2
fi
if ! _sw_writable_dir "$NP_LOCATION"; then
  echo "nix-shell: NP_LOCATION is not writable ($NP_LOCATION); set NP_LOCATION or SANDWORM_HOME to a writable path" >&2
  exit 2
