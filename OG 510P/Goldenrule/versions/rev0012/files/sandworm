    if sig is not None:
        return sig
    return _provider_resume_signature(str(holder.get("cmd") or ""), None)


def _holder_pid(holder: dict[str, object] | None) -> int | None:
    if not isinstance(holder, dict):
        return None
    raw = holder.get("pid")
    try:
        return int(raw) if raw is not None else None
    except Exception:
        return None


def _holder_pid_matches_starttime(holder: dict[str, object] | None, pid: int | None) -> bool:
    if not isinstance(pid, int):
        return False
    if not isinstance(holder, dict):
        return True
    hstart = holder.get("proc_starttime")
    if not isinstance(hstart, str) or not hstart:
        return True
    return _proc_starttime(pid) == hstart


def _truthy_env(name: str, *, default: bool = False) -> bool:
    raw = os.environ.get(name)
    if raw is None:
        return bool(default)
    return str(raw).strip().lower() in ("1", "true", "yes", "y", "on")


def _runlock_auto_takeover_enabled() -> bool:
    # Default ON for human ergonomics; can be disabled for debugging.
    if "SW_RUNLOCK_AUTO_TAKEOVER" in os.environ:
        return _truthy_env("SW_RUNLOCK_AUTO_TAKEOVER")
    if "SANDWORM_RUNLOCK_AUTO_TAKEOVER" in os.environ:
        return _truthy_env("SANDWORM_RUNLOCK_AUTO_TAKEOVER")
    return True


def _runlock_takeover_timeout_s() -> float:
    raw = os.environ.get("SW_RUNLOCK_TAKEOVER_TIMEOUT_S") or os.environ.get("SANDWORM_RUNLOCK_TAKEOVER_TIMEOUT_S") or "3"
    try:
        out = float(raw)
    except Exception:
        out = 3.0
    if out < 0.2:
        out = 0.2
    return out


def _stop_holder_pid(pid: int, *, timeout_s: float) -> bool:
    if pid <= 1:
        return False
    try:
        os.kill(pid, signal.SIGTERM)
    except Exception:
        pass
    deadline = time.time() + float(max(0.2, timeout_s))
    while time.time() < deadline:
        alive_now, _ = _pid_probe(pid)
        if alive_now is not True:
            return True
        time.sleep(0.05)
    try:
        os.kill(pid, signal.SIGKILL)
    except Exception:
        pass
    time.sleep(0.1)
    alive_now, _ = _pid_probe(pid)
    return alive_now is not True


def _proc_ppid(pid: int) -> int | None:
    """
    Return parent PID from /proc/<pid>/stat, or None if unavailable.
    """
    try:
        stat = Path(f"/proc/{int(pid)}/stat").read_text(encoding="utf-8", errors="replace").strip()
    except Exception:
        return None
    try:
        tail = stat.split(") ", 1)[1]
        parts = tail.split()
        # /proc/<pid>/stat tail: state ppid ...
        return int(parts[1]) if len(parts) > 1 else None
    except Exception:
        return None


def _proc_is_descendant(*, pid: int, ancestor_pid: int, max_hops: int = 64) -> bool:
    """
    Best-effort check: is `pid` a descendant of `ancestor_pid`?
    """
    try:
        cur = int(pid)
        anc = int(ancestor_pid)
    except Exception:
        return False
    if cur <= 1 or anc <= 1:
        return False
    for _ in range(int(max_hops)):
        if cur == anc:
            return True
        ppid = _proc_ppid(cur)
        if ppid is None or ppid <= 1 or ppid == cur:
            return False
        cur = ppid
    return False


def _git_repo_meta(root: Path) -> dict[str, object]:
    timeout_raw = (os.environ.get("SANDWORM_GIT_META_TIMEOUT_SEC", "5") or "5").strip()
    try:
        timeout_s = float(timeout_raw)
    except Exception:
        timeout_s = 5.0
    if timeout_s <= 0:
        timeout_s = 0.1

    git = shutil.which("git")
    if not git:
        return {"head": None, "branch": None, "dirty": False, "dirty_unstaged": False, "dirty_staged": False, "untracked": 0}
    try:
        head = (
            subprocess.check_output(
                [git, "rev-parse", "HEAD"],
                cwd=root,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=timeout_s,
            )
            .strip()
            .lower()
        )
    except Exception:
        return {"head": None, "branch": None, "dirty": False, "dirty_unstaged": False, "dirty_staged": False, "untracked": 0}
    try:
        branch = (
            subprocess.check_output(
                [git, "rev-parse", "--abbrev-ref", "HEAD"],
                cwd=root,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=timeout_s,
            )
            .strip()
        )
    except Exception:
        branch = ""
    if branch.strip().upper() == "HEAD":
        branch = ""

    try:
        dirty_unstaged = (
            subprocess.run(
                [git, "diff", "--quiet"],
                cwd=root,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=timeout_s,
            ).returncode
            != 0
        )
    except Exception:
        dirty_unstaged = False
    try:
        dirty_staged = (
            subprocess.run(
                [git, "diff", "--cached", "--quiet"],
                cwd=root,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=timeout_s,
            ).returncode
            != 0
        )
    except Exception:
        dirty_staged = False
    untracked_timed_out = False
    try:
        untracked = subprocess.check_output(
            [git, "ls-files", "--others", "--exclude-standard"],
            cwd=root,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout_s,
        )
        untracked_n = len([ln for ln in untracked.splitlines() if ln.strip()])
    except subprocess.TimeoutExpired:
        # Be conservative: if untracked enumeration times out, keep startup fast and
        # report dirty to avoid claiming a clean tree when we could not confirm it.
        untracked_n = 0
        untracked_timed_out = True
    except Exception:
        untracked_n = 0

    dirty = bool(dirty_unstaged or dirty_staged or untracked_n > 0 or untracked_timed_out)
    return {
        "head": (head or None),
        "branch": (branch.strip() or None),
        "dirty": dirty,
        "dirty_unstaged": bool(dirty_unstaged),
        "dirty_staged": bool(dirty_staged),
        "untracked": int(untracked_n),
    }


def _shortsha(root: Path) -> str:
    meta = _git_repo_meta(root)
    head = meta.get("head")
    if isinstance(head, str) and head:
        return head[:8]
    return secrets.token_hex(4)


def _default_runid(root: Path) -> str:
    ts = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return f"{ts}-{_shortsha(root)}-{secrets.token_hex(2)}"


@dataclass
class RunContext:
    root: Path
    runid: str
    trace_id: str
    command: str
    run_dir: Path
    seq: int = 0
    run_end_emitted: bool = False

    def _ensure_run_dir(self) -> None:
        self.run_dir.mkdir(parents=True, exist_ok=True)

    def _events_path(self) -> Path:
        return self.run_dir / "events.jsonl"

    def event(self, typ: str, data: dict[str, Any], step: str | None = None) -> None:
        self.seq += 1
        level = "info"
        if typ == "warning":
            level = "warning"
        elif typ == "error":
            level = "error"
        rec = {
            "ts": _rfc3339_now(),
            "level": level,
            "type": typ,
            "runid": self.runid,
            "run_id": self.runid,
            "step": step,
            "step_id": step,
            "seq": self.seq,
            "data": data,
            "trace_id": self.trace_id,
        }
        line = json.dumps(rec, sort_keys=True)
        # Best-effort redaction: events may include command argv fragments that contain secrets (e.g. env vars).
        if os.environ.get("SW_REDACT_EVENTS", "1") != "0":
            try:
                from .creds import redact_known_secrets

                line = redact_known_secrets(self.root, line)
            except Exception:
                pass
            # Also redact provider env var values even if they aren't stored yet (defense in depth).
            try:
                for k in (
                    "CLAUDE_CODE_OAUTH_TOKEN",
                    "ANTHROPIC_API_KEY",
                    "OPENAI_API_KEY",
                    "GEMINI_API_KEY",
                    "GOOGLE_API_KEY",
                    "GITHUB_TOKEN",
                ):
                    line = re.sub(rf"({re.escape(k)}=)[^\"\\s]+", r"\\1[REDACTED]", line)
                line = re.sub(r"sk-ant-oat[0-9A-Za-z_-]{10,}", "[REDACTED]", line)
            except Exception:
                pass
        # Cleanup tools may race and delete run_dir while a process is still active.
        # Recreate it on-demand so run shutdown path stays best-effort.
        for _ in (0, 1):
            try:
                self._ensure_run_dir()
                with self._events_path().open("a", encoding="utf-8") as f:
                    f.write(line + "\n")
                break
            except FileNotFoundError:
                continue
            except Exception:
                try:
                    print(
                        f"[sandworm] warning: failed to write run event ({typ}) to {self._events_path()}",
                        file=sys.stderr,
                    )
                except Exception:
                    pass
                break
        if typ == "run_end":
            self.run_end_emitted = True

    def warn(self, msg: str) -> None:
        self.event("warning", {"message": msg})

    def write_manifest(self, doctor_report: dict[str, Any]) -> None:
        self._ensure_run_dir()
        git_meta = _git_repo_meta(self.root)
        head = git_meta.get("head") if isinstance(git_meta.get("head"), str) else None
        dirty = bool(git_meta.get("dirty") is True)
        branch = git_meta.get("branch") if isinstance(git_meta.get("branch"), str) else None
        dirty_unstaged = bool(git_meta.get("dirty_unstaged") is True)
        dirty_staged = bool(git_meta.get("dirty_staged") is True)
        untracked_raw = git_meta.get("untracked")
        untracked_n = int(untracked_raw) if isinstance(untracked_raw, int) else 0
        root_info = describe_root(self.root)
        cfg = read_state_root_file(self.root)
        man = {
            "runid": self.runid,
            "created_at": _rfc3339_now(),
            "repo": {
                "root": str(self.root),
                "root_canonical": root_info.get("canonical_path"),
                "root_identity": root_info,
                "git_head": head,
                "git_branch": branch,
                "git_dirty": dirty,
                "git_dirty_unstaged": dirty_unstaged,
                "git_dirty_staged": dirty_staged,
                "git_untracked": untracked_n,
            },
            "state_root": {
                "selected": str(control_dir(self.root).resolve()),
                "file": (str(cfg.path) if cfg.path else None),
                "file_readonly": bool(cfg.readonly),
                "env": (os.environ.get("SANDWORM_STATE_ROOT") or os.environ.get("SW_STATE_ROOT") or None),
                "readonly": state_root_readonly(self.root),
            },
            "host": {
                "uname": " ".join(os.uname()),
                "uid": os.getuid(),
                "caps": doctor_report.get("caps", {}),
            },
            "defaults": {},
            "provider_sessions": {},
            "warnings": [],
        }
        (self.run_dir / "manifest.json").write_text(json.dumps(man, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        (self.run_dir / "doctor.json").write_text(json.dumps(doctor_report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    def update_manifest(self, patch: dict[str, Any]) -> None:
        self._ensure_run_dir()
        p = self.run_dir / "manifest.json"
        if not p.exists():
            return
        try:
            cur = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            return
        if not isinstance(cur, dict):
            return
        for k, v in patch.items():
            cur[k] = v
        p.write_text(json.dumps(cur, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    def write_file(self, relpath: str, content: str) -> Path:
        # Best-effort redaction: avoid leaking stored API keys into run artifacts.
        # Only touches files under a `logs/` directory, which are typically command stdout/stderr captures.
        if os.environ.get("SW_REDACT_LOGS", "1") != "0":
            try:
                rp = str(relpath or "")
                if "/logs/" in rp or rp.startswith("logs/") or rp.endswith("/logs"):
                    from .creds import redact_known_secrets

                    content = redact_known_secrets(self.root, content)
            except Exception:
                pass
        self._ensure_run_dir()
        p = self.run_dir / relpath
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")
        return p

    def finish_ok(self) -> None:
        if not self.run_end_emitted:
            self.event("run_end", {"status": "ok"})

    def finish_error(self, exit_code: int) -> None:
        if not self.run_end_emitted:
            self.event("run_end", {"status": "error", "exit_code": exit_code})


@contextlib.contextmanager
def create_run_context(root: Path, command: str, command_meta: dict[str, object] | None = None) -> Iterator[RunContext]:
    fallback_root: Path | None = None

    def _truthy_env_any(*names: str) -> bool:
        for n in names:
            v = os.environ.get(n)
            if v is not None and str(v).strip().lower() in ("1", "true", "yes", "y", "on"):
                return True
        return False

    keep_ro_fallback = _truthy_env_any(
        "SW_RUNCTX_KEEP_RO_FALLBACK",
        "SANDWORM_RUNCTX_KEEP_RO_FALLBACK",
        "SW_KEEP_RO_FALLBACK",
        "SANDWORM_KEEP_RO_FALLBACK",
    )

    def _cleanup_fallback(path: Path | None) -> None:
        if not path:
            return
        if keep_ro_fallback:
            return
        shutil.rmtree(path, ignore_errors=True)

    try:
        ensure_control_plane(root)
        if state_root_readonly(root):
            fallback_root = Path(tempfile.mkdtemp(prefix="sandworm-ro-fallback-"))
            ensure_control_plane(fallback_root, ignore_readonly=True)
    except OSError as e:
        if e.errno == 30: # Read-only file system
            # If we are inside a sandbox, .sandworm is masked (RO).
            # Fallback to a temporary control plane in /tmp.
            fallback_root = Path(tempfile.mkdtemp(prefix="sandworm-ro-fallback-"))
            ensure_control_plane(fallback_root, ignore_readonly=True)
        else:
            raise

    def _open_run_lock(base_root: Path) -> tuple[Path, Any]:
        lp = base_root / ".sandworm" / "locks" / "run.lock"
        lp.parent.mkdir(parents=True, exist_ok=True)
        fd = lp.open("a+", encoding="utf-8")
        return lp, fd

    effective_root = fallback_root or root
    try:
        lock_path, lock_fd = _open_run_lock(effective_root)
    except OSError as e:
        if e.errno == 30 and fallback_root is None:  # Read-only file system
            # `ensure_control_plane(root)` can succeed in masked RO lanes (dir exists),
            # but lock initialization can still fail later. Fall back to a writable
            # temporary control plane so nested SAFE calls don't crash with traceback.
            fallback_root = Path(tempfile.mkdtemp(prefix="sandworm-ro-fallback-"))
            ensure_control_plane(fallback_root, ignore_readonly=True)
            effective_root = fallback_root
            lock_path, lock_fd = _open_run_lock(effective_root)
        else:
            raise
    reentrant = False
    allow_reentrant_env = str(
        os.environ.get("SW_RUNLOCK_REENTRANT")
        or os.environ.get("SANDWORM_RUNLOCK_REENTRANT")
        or os.environ.get("SW_RUN_LOCK_REENTRANT")
        or os.environ.get("SANDWORM_RUN_LOCK_REENTRANT")
        or ""
    ).strip().lower() in ("1", "true", "yes", "y", "on")
    resume_sig_current = _provider_resume_signature(command, command_meta)
    auto_takeover_allowed = _runlock_auto_takeover_enabled()
    auto_takeover_enabled = bool(auto_takeover_allowed and (resume_sig_current is not None))
    auto_takeover_attempted = False
    auto_takeover_note = ("disabled_by_env" if (resume_sig_current is not None and not auto_takeover_allowed) else "")
    try:
        # Noob ergonomics: avoid blocking forever if another Sandworm process is stuck.
        # Acquire the lock with a short timeout and print a useful diagnostic on failure.
        deadline = time.time() + float(os.environ.get("SW_RUN_LOCK_TIMEOUT_S") or os.environ.get("SANDWORM_RUN_LOCK_TIMEOUT_S") or "2")
        while True:
            try:
                fcntl.flock(lock_fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                # Allow opt-in reentrancy even across PID namespaces (e.g. Sandworm spawning a provider
                # in podman/kvm where nested sandworm calls cannot see the host PID tree).
                if allow_reentrant_env:
                    reentrant = True
                    break
                # Allow "Sandworm from Sandworm": if a parent process holds the lock,
                # nested sandworm invocations (e.g. provider tool calls) should not deadlock.
                holder: dict[str, object] | None = None
                try:
                    txt = lock_path.read_text(encoding="utf-8", errors="replace").strip()
                    if txt:
                        holder = json.loads(txt)
                except Exception:
                    holder = None
                hpid: int | None = None
                try:
                    if isinstance(holder, dict) and holder.get("pid") is not None:
                        hpid = int(holder.get("pid"))
                except Exception:
                    hpid = None
                hstart = holder.get("proc_starttime") if isinstance(holder, dict) else None
                if hpid and _proc_is_descendant(pid=os.getpid(), ancestor_pid=hpid):
                    if not hstart or (isinstance(hstart, str) and _proc_starttime(hpid) == hstart):
                        reentrant = True
                        break
                if auto_takeover_enabled and (not auto_takeover_attempted):
                    holder = _read_lock_holder(lock_path)
                    hsig = _holder_resume_signature(holder)
                    hpid = _holder_pid(holder)
                    if (
                        hsig is not None
                        and resume_sig_current is not None
                        and hsig == resume_sig_current
                        and isinstance(hpid, int)
                        and hpid != os.getpid()
                    ):
                        alive, _probe = _pid_probe(hpid)
                        if alive is True and _holder_pid_matches_starttime(holder, hpid):
                            auto_takeover_attempted = True
                            provider, sid = hsig
                            print(
                                f"[sandworm] runlock: auto-takeover for active `{provider} resume {sid}` "
                                f"(holder pid={hpid})",
                                file=sys.stderr,
                            )
                            stopped = _stop_holder_pid(hpid, timeout_s=_runlock_takeover_timeout_s())
                            if stopped:
                                auto_takeover_note = "auto_takeover_applied"
                                # Retry lock acquisition immediately.
                                continue
                            auto_takeover_note = "auto_takeover_failed_to_stop_holder"
                if time.time() >= deadline:
                    holder: dict[str, object] | None = None
                    try:
                        txt = lock_path.read_text(encoding="utf-8", errors="replace").strip()
                        if txt:
                            holder = json.loads(txt)
                    except Exception:
                        holder = None
                    pid = holder.get("pid") if isinstance(holder, dict) else None
                    cmd = holder.get("cmd") if isinstance(holder, dict) else None
                    started = holder.get("started_at") if isinstance(holder, dict) else None
                    hint = "Another Sandworm run appears active and is holding the run lock."
                    if pid or cmd or started:
                        hint += f" holder={{pid={pid!r}, cmd={cmd!r}, started_at={started!r}}}."
                    hint += " If it is stuck, terminate it (e.g. `kill <pid>`), or wait for it to finish."
                    hint += " See also: `sandworm runlock status` (and `sandworm runlock stop` / `sandworm runlock clear`)."
                    if resume_sig_current is not None and auto_takeover_note:
                        hint += f" auto_takeover={auto_takeover_note}."
                    hint += f" lock={lock_path}"
                    raise SystemExit(hint)
                time.sleep(0.05)
    except Exception:
        lock_fd.close()
        _cleanup_fallback(fallback_root)
        raise

    runid = _default_runid(effective_root)
    run_dir = effective_root / ".sandworm" / "runs" / runid
    run_dir.mkdir(parents=True, exist_ok=False)
    # Even if we use a fallback root for the control plane, the workspace 'root' remains the same.
    ctx = RunContext(root=root, runid=runid, trace_id=secrets.token_hex(16), command=command, run_dir=run_dir)
    try:
        if not reentrant:
            lock_fd.seek(0)
            lock_fd.truncate()
            lock_fd.write(
                json.dumps(
                    {
                        "pid": os.getpid(),
                        "proc_starttime": _proc_starttime(os.getpid()),
                        "cmd": command,
                        "cmd_meta": (command_meta if isinstance(command_meta, dict) else None),
                        "runid": runid,
                        "started_at": _rfc3339_now(),
                    }
                )
                + "\n"
            )
            lock_fd.flush()
    except Exception:
        pass
    ctx.event("run_start", {"command": command})
    if fallback_root:
        ctx.warn(f"Control plane is read-only; using temporary control plane at {fallback_root}")
        if keep_ro_fallback:
            ctx.warn(f"Retaining read-only fallback control plane at {fallback_root} (SW_RUNCTX_KEEP_RO_FALLBACK=1)")

