        "text file busy",
        "operation not permitted",
        "permission denied",
        "no permissions to create new namespace",
        "temporary failure in name resolution",
        "could not resolve host",
        "failed to download",
        "api rate limit exceeded",
        "http error 403",
        "api.github.com/repos/nixos/nixpkgs/commits",
        "too many requests",
        "socket() denied by sandbox policy",
        "timed out after",
        "timeout expired",
