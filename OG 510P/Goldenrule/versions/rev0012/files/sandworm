from __future__ import annotations

import json
import os
import pwd
import shutil
from dataclasses import dataclass
from pathlib import Path

from .creds import ensure_sandworm_home


@dataclass(frozen=True)
class CodexAuthImportResult:
    imported: bool
    reason: str
    src_auth_json: str | None
    dest_auth_json: str


def sandworm_codex_home(root: Path) -> Path:
    """
    Project-local Codex state directory. Codex calls this CODEX_HOME and defaults it to ~/.codex.

    Sandworm sets it to live under the Sandworm-managed HOME so auth is reusable across podman/bwrap/KVM.
    """
    home = ensure_sandworm_home(root)
    return (home / ".codex").resolve()


def _read_json(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def _looks_like_placeholder_api_key(auth: dict) -> bool:
    v = auth.get("OPENAI_API_KEY")
    return isinstance(v, str) and v.startswith("sw-test-")


def _has_chatgpt_tokens(auth: dict) -> bool:
    t = auth.get("tokens")
    if not isinstance(t, dict):
        return False
    at = t.get("access_token")
    rt = t.get("refresh_token")
    return bool(isinstance(at, str) and at.strip() and isinstance(rt, str) and rt.strip())


def _has_real_api_key(auth: dict) -> bool:
    v = auth.get("OPENAI_API_KEY")
    return bool(isinstance(v, str) and v.strip() and not v.startswith("sw-test-"))


def _user_home_dir() -> Path:
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir).expanduser().resolve()
    except Exception:
        return Path("~").expanduser().resolve()


def _candidate_codex_homes_from_host_env(root: Path) -> list[Path]:
    out: list[Path] = []
    allow_host_home = (os.environ.get("SW_IMPORT_HOST_HOME_CREDS") or os.environ.get("SANDWORM_IMPORT_HOST_HOME_CREDS") or "").strip().lower() in (
        "1",
        "true",
        "yes",
        "y",
        "on",
    )

    # SAFE default: do not read host $HOME for creds. Host-home import is an explicit opt-in.
    # Still allow CODEX_HOME when it points inside the workspace root (project-local) because it does not
    # require host-home usage.
    ch = os.environ.get("CODEX_HOME")
    if isinstance(ch, str) and ch.strip():
        try:
            chp = Path(ch).expanduser().resolve()
            rootp = root.resolve()
            if allow_host_home or str(chp).startswith(str(rootp) + os.sep) or str(chp) == str(rootp):
                out.append(chp)
        except Exception:
            pass

    if allow_host_home:
        out.append((_user_home_dir() / ".codex").resolve())
    # De-dupe.
    seen: set[str] = set()
    uniq: list[Path] = []
    for p in out:
        sp = str(p)
        if sp in seen:
            continue
        seen.add(sp)
        uniq.append(p)
    # Never consider Sandworm's own codex home as a source.
    dst = sandworm_codex_home(root)
    return [p for p in uniq if p != dst]


def ensure_codex_auth_imported(root: Path) -> CodexAuthImportResult:
    """
    Ensure Sandworm's CODEX_HOME has an auth.json, importing from safe sources when missing.

    SAFE default: do not read host $HOME (~/.codex) unless explicitly enabled via:
    - SW_IMPORT_HOST_HOME_CREDS=1 (or SANDWORM_IMPORT_HOST_HOME_CREDS=1)

    Never prints secrets; only copies files on disk best-effort.
    """
    root = root.resolve()
    if os.environ.get("SW_IMPORT_HOST_CREDS", "1") == "0":
        dst_auth = str((sandworm_codex_home(root) / "auth.json").resolve())
        return CodexAuthImportResult(imported=False, reason="disabled", src_auth_json=None, dest_auth_json=dst_auth)
    dst_home = sandworm_codex_home(root)
    dst_home.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(dst_home, 0o700)
    except Exception:
        pass

    dst_auth = (dst_home / "auth.json").resolve()
    dst_data = _read_json(dst_auth) if dst_auth.exists() else None

    if isinstance(dst_data, dict) and (_has_chatgpt_tokens(dst_data) or _has_real_api_key(dst_data)):
        return CodexAuthImportResult(imported=False, reason="dest_has_real_auth", src_auth_json=None, dest_auth_json=str(dst_auth))
    if isinstance(dst_data, dict) and _looks_like_placeholder_api_key(dst_data):
        need = True
        reason = "dest_has_placeholder_api_key"
    else:
        need = not dst_auth.exists()
        reason = "dest_missing" if need else "dest_unreadable_or_empty"

    if not need:
        return CodexAuthImportResult(imported=False, reason=reason, src_auth_json=None, dest_auth_json=str(dst_auth))

    for src_home in _candidate_codex_homes_from_host_env(root):
        src_auth = (src_home / "auth.json").resolve()
        if not src_auth.exists():
            continue
        src_data = _read_json(src_auth)
        if not isinstance(src_data, dict):
            continue
        if not (_has_chatgpt_tokens(src_data) or _has_real_api_key(src_data)):
            continue
        try:
            shutil.copyfile(src_auth, dst_auth)
            try:
                os.chmod(dst_auth, 0o600)
            except Exception:
                pass
            return CodexAuthImportResult(imported=True, reason=f"imported_from:{src_home}", src_auth_json=str(src_auth), dest_auth_json=str(dst_auth))
        except Exception:
            continue

    return CodexAuthImportResult(imported=False, reason="no_source_auth_found", src_auth_json=None, dest_auth_json=str(dst_auth))


def codex_has_any_creds(root: Path) -> bool:
    try:
        auth = (sandworm_codex_home(root) / "auth.json").resolve()
        if auth.exists():
            data = _read_json(auth)
            if isinstance(data, dict) and (_has_chatgpt_tokens(data) or _has_real_api_key(data)):
                return True
    except Exception:
        return False
    return False


