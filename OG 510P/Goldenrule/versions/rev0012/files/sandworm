def write_proof_bundle(
    *,
    root: Path,
    suite: str,
    out_dir: Path,
    run_dir: Path,
    command: str,
    ok: bool,
    files: dict[str, str] | None,
    notes: list[str] | None = None,
    meta: dict[str, Any] | None = None,
) -> Path:
    suite = (suite or "").strip() or "suite"
    out_dir = out_dir.resolve()
    suite_dir = (out_dir / suite).resolve()
    suite_dir.mkdir(parents=True, exist_ok=True)

    artifacts_dir = suite_dir / "artifacts"
    artifacts_dir.mkdir(parents=True, exist_ok=True)

    artifacts_out: dict[str, str] = {}

    # Copy events.jsonl from the run dir into the proof bundle (best-effort redaction).
    src_events = run_dir / "events.jsonl"
    dst_events = suite_dir / "events.jsonl"
