def _int_env(*names: str, default: int, minimum: int = 0) -> int:
    for name in names:
        raw = os.environ.get(name)
        if not isinstance(raw, str) or not raw.strip():
            continue
        try:
            return max(minimum, int(float(raw.strip())))
        except Exception:
            continue
