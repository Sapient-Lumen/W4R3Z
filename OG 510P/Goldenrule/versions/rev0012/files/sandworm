    if _sw_is_real_bash_bin "$_sw_bash"; then
      _sw_bash_dir="${_sw_bash%/*}"
      PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
      exec "$_sw_bash" "$0" "$@"
