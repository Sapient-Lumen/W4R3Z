def ensure_control_plane(root: Path, *, ignore_readonly: bool = False) -> None:
    try:
        control = control_dir(root)
        if state_root_readonly(root) and not ignore_readonly:
            if not control.exists():
                raise RuntimeError(f"state root is read-only and control plane is missing: {control}")
            try:
                require_control_plane_marker(control)
            except Exception as e:
                raise RuntimeError(f"state root is read-only and invalid: {e}") from e
            return
        control.mkdir(parents=True, exist_ok=True)
        for rel in [
            "locks",
            "runs",
            "archives",
            "podman",
            "host",
            "logs",
            "private",
            "kvm",
            "hooks",
            "hooks-host",
            "clients/bin",
        ]:
            (control / rel).mkdir(parents=True, exist_ok=True)
        sentinel = control / "CONTROL_PLANE_DO_NOT_TOUCH"
        if not sentinel.exists():
            try:
                sentinel.write_text(
                    "This file lives in Sandworm's control plane and must never be visible inside the sandbox.\n",
                    encoding="utf-8",
                )
            except OSError as e:
                if e.errno != 30: # RO
                    raise
    except OSError as e:
        if e.errno == 30: # Read-only file system
            # If we are inside a sandbox, .sandworm is masked (RO).
            # If it already exists (even if empty), we can continue.
            if control_dir(root).is_dir():
                return
        raise


def _rfc3339_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def _proc_starttime(pid: int) -> str | None:
    # Best-effort Linux-only: use /proc starttime to detect PID reuse for diagnostics.
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    try:
        tail = stat.split(") ", 1)[1]
        parts = tail.split()
        return parts[19] if len(parts) > 19 else None
    except Exception:
        return None


def _pid_probe(pid: int | None) -> tuple[bool | None, str]:
    if not isinstance(pid, int) or pid <= 1:
        return None, "absent"
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False, "missing"
    except PermissionError:
        return None, "permission_denied"
    except Exception:
        return None, "unknown"
    return True, "alive"


def _read_lock_holder(lock_path: Path) -> dict[str, object] | None:
    try:
        txt = lock_path.read_text(encoding="utf-8", errors="replace").strip()
        if not txt:
            return None
        obj = json.loads(txt)
        return obj if isinstance(obj, dict) else None
    except Exception:
        return None


def _provider_resume_signature(command: str, command_meta: dict[str, object] | None) -> tuple[str, str] | None:
    provider = ""
    sid = ""
    if isinstance(command_meta, dict):
        kind = str(command_meta.get("kind") or "").strip().lower()
        if kind == "provider_resume":
            provider = str(command_meta.get("provider") or "").strip().lower()
            sid = str(command_meta.get("session_id") or "").strip()
    if provider and sid:
        return (provider, sid)
    toks = str(command or "").strip().split()
