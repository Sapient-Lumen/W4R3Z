        "attempted": False,
        "ok": False,
        "rc": None,
        "reason_code": ("nix_missing" if not nix else "not_attempted"),
        "stderr": "",
        "timeout_s": int(preflight_timeout_s),
    }
    if nix:
        argv = [
            nix,
            *nix_flags(),
            "shell",
            "--impure",
            "--expr",
            expr_base_for_flake(flake_ref),
            *installables,
            "--command",
            "sh",
            "-c",
            "true",
        ]
        preflight["attempted"] = True
        try:
            rc, out, err, _timed_out = run_with_timeout_killpg(
                argv,
