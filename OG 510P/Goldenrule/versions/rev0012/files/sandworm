def parse_policy_before_csv(raw: str) -> tuple[str, ...]:
    toks = [x.strip().lower() for x in str(raw or "").split(",") if x.strip()]
    if not toks:
        raise StateBackupError("rollback policy: --before requires a non-empty csv list")
    if len(toks) == 1 and toks[0] in ("none", "off", "disable", "disabled"):
        return ()
    if len(toks) == 1 and toks[0] == "all":
        return _ROLLBACK_POLICY_COMMANDS
    out: list[str] = []
    seen: set[str] = set()
    for name in toks:
        if name not in _ROLLBACK_POLICY_COMMANDS:
            raise StateBackupError(
                f"rollback policy: unsupported command family in --before: {name!r} "
                f"(supported: {', '.join(_ROLLBACK_POLICY_COMMANDS)}; special: all, none)"
            )
        if name in seen:
            continue
        seen.add(name)
        out.append(name)
    return tuple(out)


