    workdir: str = "/workspace",
    offline: bool = False,
    mounts: list[tuple[str, str, str]] | None = None,  # (src, dest, mode) mode in {ro,rw}
    shares: list[tuple[str, str, str]] | None = None,  # (name, src, mode)
    env: dict[str, str] | None = None,
    take_the_wheel: bool = False,
    unsafe: bool = False,
    posture: str | None = None,
    expose_control_plane: bool = False,
    expose_private: bool = False,
    timeout_s: int | None = None,
    stdin: str | None = None,
    capture_output: bool = True,
    force_tty: bool = False,
) -> subprocess.CompletedProcess[str]:
    caps = find_bwrap()
    if not caps:
        raise RuntimeError("bwrap not available (install bubblewrap or enable nix)")

    bwrap = caps.path
    bwrap_real = bwrap
    try:
        bwrap_real = os.path.realpath(bwrap)
    except Exception:
        bwrap_real = bwrap
    root = root.resolve()
    control = control_dir(root)
    from .creds import ensure_sandworm_home

    home_dir = ensure_sandworm_home(root)
    try:
        (home_dir / "tmp").mkdir(parents=True, exist_ok=True)
    except Exception:
        pass
    try:
        from .selfdocs import write_self_docs

        posture_effective = str((posture or "").strip().lower())
        if posture_effective not in ("safe", "dev", "unsafe", "take-the-wheel", "bare-metal"):
            posture_effective = ("take-the-wheel" if take_the_wheel else ("unsafe" if unsafe else "safe"))
        write_self_docs(
            root,
            backend="bwrap",
            posture=posture_effective,
            network_requested=("none" if offline else "host"),
            network_selected=("none" if offline else "host"),
            network_attempts=[{"network": ("none" if offline else "host")}],
            offline=bool(offline),
            strict=None,
            provider=None,
            provider_mode=None,
            image=None,
            shares=(
                [{"name": str(n), "path": f"/workspace/shared/{n}", "mode": str(m)} for (n, _src, m) in (shares or [])]
                if shares
                else []
            ),
            expose_private=bool(expose_private),
            expose_control_plane=bool(expose_control_plane),
            control_plane_observed=("populated" if bool(expose_control_plane) else "private-only"),
            control_plane_entries=([] if bool(expose_control_plane) else ["private"]),
        )
    except Exception:
        pass

    mask_dir = control / "mask-empty"
    mask_dir.mkdir(parents=True, exist_ok=True)
    (mask_dir / "private").mkdir(parents=True, exist_ok=True)

    # Provide NixOS toolchain visibility.
    run_sw = Path("/run/current-system/sw")
    have_run_sw = run_sw.exists()

    argv2 = argv if expose_control_plane else inject_mask_check(argv)
    cmd: list[str] = [bwrap, "--die-with-parent", "--new-session", "--unshare-all"]
    if not offline:
        cmd += ["--share-net"]

    # Kernel interfaces. Prefer a new /proc, but this can fail in some environments; caller can retry.
    cmd += ["--proc", "/proc"]
    cmd += ["--dev-bind", "/dev", "/dev"]

    # Minimal host filesystem views (read-only).
    has_bin_sh_mount_override = False
    if mounts:
        try:
            for _src, dest, _mode in mounts:
                if dest == "/bin/sh":
                    has_bin_sh_mount_override = True
                    break
        except Exception:
            has_bin_sh_mount_override = False
    host_bin_sh_ok = _shell_usable("/bin/sh")
    need_bin_sh_fallback = (not host_bin_sh_ok) and (not has_bin_sh_mount_override)
    fallback_shell = _select_fallback_shell(avoid_bin_prefix=need_bin_sh_fallback) if need_bin_sh_fallback else None
    if need_bin_sh_fallback and not fallback_shell:
        try:
            bb = control / "toolroot" / "bin" / "busybox-static"
            if bb.exists() and os.access(str(bb), os.X_OK):
                fallback_shell = "/run/sandworm/toolroot/bin/busybox-static"
        except Exception:
            fallback_shell = fallback_shell
    want_bin_sh_override = has_bin_sh_mount_override or need_bin_sh_fallback

    if Path("/nix").exists():
        cmd += ["--ro-bind", "/nix", "/nix"]
    if have_run_sw:
        # Expose /run/current-system/sw itself (ro) so nested sandboxes can detect a NixOS toolchain.
        cmd += ["--ro-bind", str(run_sw), str(run_sw)]
        # Prefer a real /bin when available so provider CLIs that force PATH=/usr/bin:/bin still work.
        # On NixOS, /run/current-system/sw/bin is read-only and stable; binding it avoids needing a long
        # list of symlinked coreutils shims.
        bound_run_sw_bin = False
        if (not want_bin_sh_override) and Path("/run/current-system/sw/bin").exists():
            cmd += ["--ro-bind", "/run/current-system/sw/bin", "/bin"]
            bound_run_sw_bin = True
        else:
            cmd += ["--dir", "/bin"]
        # Some provider CLIs run shell tools under a reduced PATH like /usr/bin:/bin.
        # On NixOS sandboxes, /usr/bin is intentionally minimal; provide common process tools via toolroot when present.
        # Only do this when /bin is a writable dir; if /bin is a read-only bind to /run/current-system/sw/bin,
        # attempting to symlink will fail.
        if not bound_run_sw_bin:
            try:
                tr = control / "toolroot"
                if (tr / "bin" / "pgrep").exists():
                    cmd += ["--symlink", "/run/sandworm/toolroot/bin/pgrep", "/bin/pgrep"]
                if (tr / "bin" / "pkill").exists():
                    cmd += ["--symlink", "/run/sandworm/toolroot/bin/pkill", "/bin/pkill"]
            except Exception:
                pass
            if need_bin_sh_fallback and fallback_shell:
                cmd += ["--symlink", fallback_shell, "/bin/sh"]
                if fallback_shell.endswith("/bash"):
                    cmd += ["--symlink", fallback_shell, "/bin/bash"]
                if _toolroot_busybox_static_valid(control):
                    _add_busybox_applets(cmd, applets=_FALLBACK_BIN_APPLETS)
    elif Path("/bin").exists() and (not want_bin_sh_override):
        cmd += ["--ro-bind", "/bin", "/bin"]
    else:
        cmd += ["--dir", "/bin"]
        if need_bin_sh_fallback and fallback_shell:
            cmd += ["--symlink", fallback_shell, "/bin/sh"]
            if fallback_shell.endswith("/bash"):
                cmd += ["--symlink", fallback_shell, "/bin/bash"]
            if _toolroot_busybox_static_valid(control):
                _add_busybox_applets(cmd, applets=_FALLBACK_BIN_APPLETS)

    # Minimal /etc view: enough for DNS/TLS and OS metadata, without exposing the full host /etc.
    #
    # Why this exists:
    # - networking in bwrap frequently depends on /etc/resolv.conf and /etc/nsswitch.conf
    # - TLS stacks often consult system CA bundles (commonly under /etc/ssl/certs or /etc/pki/...)
    # - in TAKE-THE-WHEEL, `/host` is a bind-mount of `/`; absolute symlinks under `/host/etc/*`
    #   (common on NixOS, e.g. /host/etc/os-release -> /etc/static/os-release) resolve against the
    #   sandbox root, so a compatible /etc must exist
    cmd += ["--dir", "/etc"]
    # Provide identity files without exposing host /etc/passwd wholesale.
    try:
        pass_p, group_p = _write_minimal_identity_files(
            control,
            uid=os.getuid(),
            gid=os.getgid(),
            username=str(os.environ.get("USER") or "sandworm"),
            home_in_sandbox="/run/sandworm/home",
            shell_in_sandbox="/bin/sh",
        )
        if pass_p is not None and pass_p.exists():
            cmd += ["--ro-bind", str(pass_p), "/etc/passwd"]
        if group_p is not None and group_p.exists():
            cmd += ["--ro-bind", str(group_p), "/etc/group"]
    except Exception:
        pass
    if Path("/etc/resolv.conf").exists():
        cmd += ["--ro-bind", "/etc/resolv.conf", "/etc/resolv.conf"]
    if Path("/etc/hosts").exists():
        cmd += ["--ro-bind", "/etc/hosts", "/etc/hosts"]
    if Path("/etc/nsswitch.conf").exists():
        cmd += ["--ro-bind", "/etc/nsswitch.conf", "/etc/nsswitch.conf"]
    for fn in ("os-release", "machine-id", "localtime"):  # best-effort compat
        if Path("/etc").joinpath(fn).exists():
            cmd += ["--ro-bind", f"/etc/{fn}", f"/etc/{fn}"]

    # NixOS: /etc/os-release often symlinks to /etc/static/os-release.
    if Path("/etc/static/os-release").exists():
        cmd += ["--dir", "/etc/static"]
        cmd += ["--ro-bind", "/etc/static/os-release", "/etc/static/os-release"]

    # CA bundles (common distros).
    if Path("/etc/ssl/certs").is_dir():
        cmd += ["--dir", "/etc/ssl"]
        cmd += ["--ro-bind", "/etc/ssl/certs", "/etc/ssl/certs"]
    if Path("/etc/ssl/openssl.cnf").exists():
        cmd += ["--ro-bind", "/etc/ssl/openssl.cnf", "/etc/ssl/openssl.cnf"]
    if Path("/etc/pki/tls/certs").is_dir():
        cmd += ["--dir", "/etc/pki"]
        cmd += ["--dir", "/etc/pki/tls"]
        cmd += ["--ro-bind", "/etc/pki/tls/certs", "/etc/pki/tls/certs"]

    bin_points_to_usr = False
    try:
        if Path("/bin").is_symlink():
            bin_target = str(Path("/bin").resolve())
            bin_points_to_usr = bin_target.startswith("/usr/")
    except Exception:
        bin_points_to_usr = False

    # Many tool scripts use `#!/usr/bin/env ...`; provide /usr/bin/env without exposing all of /usr.
    cmd += ["--dir", "/usr"]
    cmd += ["--dir", "/usr/bin"]
    _maybe_bind_host_node(cmd)
    if have_run_sw and Path("/run/current-system/sw/bin").exists():
        # NixOS: populate /usr/bin so nested sandboxes with PATH=/usr/bin:/bin can find basic tools.
        cmd += ["--ro-bind", "/run/current-system/sw/bin", "/usr/bin"]
    elif (not have_run_sw) and bin_points_to_usr and Path("/usr").exists():
        # Distros like Arch can expose /bin as a symlink into /usr/bin.
        # Binding only /bin can leave /bin/sh dangling unless /usr is also visible.
        cmd += ["--ro-bind", "/usr", "/usr"]
    elif Path("/usr/bin/env").exists():
        cmd += ["--ro-bind", "/usr/bin/env", "/usr/bin/env"]
    elif Path("/bin/env").exists():
        cmd += ["--ro-bind", "/bin/env", "/usr/bin/env"]
    elif Path("/nix/var/nix/profiles/default/bin/env").exists():
        cmd += ["--ro-bind", "/nix/var/nix/profiles/default/bin/env", "/usr/bin/env"]
    if not have_run_sw:
        # On some distros /bin is a symlink into /usr/bin. When we keep /usr/bin minimal
        # (only binding /usr/bin/env), resolving `sh` can fail inside the sandbox. Expose
        # common shell entrypoints explicitly to keep stage0/non-NixOS sandboxes runnable.
        if Path("/usr/bin/sh").exists():
            cmd += ["--ro-bind", "/usr/bin/sh", "/usr/bin/sh"]
        if Path("/usr/bin/bash").exists():
            cmd += ["--ro-bind", "/usr/bin/bash", "/usr/bin/bash"]
        # Dynamic host shells (/usr/bin/sh, /usr/bin/bash) require loader/libs that are
        # outside /usr/bin. Bind common runtime library trees read-only so shell probes run.
        seen_lib_targets: set[str] = set()
        for libdir in ("/lib", "/lib64", "/usr/lib", "/usr/lib64", "/usr/lib32"):
            try:
                p = Path(libdir)
                if not p.exists():
                    continue
                resolved = str(p.resolve())
                if resolved in seen_lib_targets:
                    continue
                seen_lib_targets.add(resolved)
                cmd += ["--dir", libdir]
                cmd += ["--ro-bind", libdir, libdir]
            except Exception:
                continue
    cmd += ["--dir", "/workspace"]
    cmd += ["--bind", str(root), "/workspace"]
    cmd += ["--dir", "/workspace/.sandworm"]
    if expose_control_plane:
        # Dev-only: expose the control plane so Sandworm can self-host inside the sandbox.
        cmd += ["--bind", str(control), "/workspace/.sandworm"]
    else:
        cmd += ["--ro-bind", str(mask_dir), "/workspace/.sandworm"]
        if expose_private:
            host_private = control / "private"
            host_private.mkdir(parents=True, exist_ok=True)
            cmd += ["--ro-bind", str(host_private), "/workspace/.sandworm/private"]

    # Shares.
    cmd += ["--dir", "/workspace/shared"]
    if shares:
        for name, src, mode in shares:
            dest = f"/workspace/shared/{name}"
            cmd += ["--dir", dest]
            if mode == "ro":
                cmd += ["--ro-bind", src, dest]
            else:
                cmd += ["--bind", src, dest]

    # Home.
    cmd += ["--dir", "/home"]
    cmd += ["--dir", "/home/sandworm"]
    cmd += ["--bind", str(home_dir), "/home/sandworm"]
    # Canonical Sandworm HOME path (used by provider wrappers across backends).
    cmd += ["--dir", "/run/sandworm/home"]
    cmd += ["--bind", str(home_dir), "/run/sandworm/home"]

    need_host_bin_shadow = need_bin_sh_fallback and Path("/bin").exists()

    # Writable temp areas.
    cmd += ["--tmpfs", "/tmp"]
    # Some tooling (notably nix) may attempt to stat `/var` even when we chdir to /workspace;
    # provide a minimal empty /var tree to avoid spurious failures without exposing host /var.
    cmd += ["--dir", "/var"]
    cmd += ["--dir", "/var/tmp"]
    cmd += ["--dir", "/run"]
    cmd += ["--dir", "/run/sandworm"]
    if need_host_bin_shadow:
        cmd += ["--dir", "/run/sandworm/host-bin"]
        cmd += ["--ro-bind", "/bin", "/run/sandworm/host-bin"]
    # Stable in-sandbox Sandworm re-entry binary contract.
    sandbox_bin_dir = ensure_sandbox_bin_dir(root, bwrap_path=bwrap_real)
    cmd += ["--dir", "/run/sandworm/bin"]
    cmd += ["--ro-bind", str(sandbox_bin_dir), "/run/sandworm/bin"]
    # Shared handoff folder (host ./shared -> /srv/shared).
    shared_dir = root / "shared"
    shared_dir.mkdir(parents=True, exist_ok=True)
    cmd += ["--dir", "/srv"]
    cmd += ["--dir", "/srv/shared"]
    cmd += ["--bind", str(shared_dir), "/srv/shared"]
    # Sandworm-managed provider CLIs (mounted outside /workspace so control plane remains masked).
    clients_dir = control / "clients"
    clients_dir.mkdir(parents=True, exist_ok=True)
    cmd += ["--dir", "/run/sandworm/clients"]
    cmd += ["--ro-bind", str(clients_dir), "/run/sandworm/clients"]
    # Sandworm toolroot (nix-portable + nix wrapper) for provider/client execution on non-NixOS hosts.
    toolroot_dir = control / "toolroot"
    toolroot_dir.mkdir(parents=True, exist_ok=True)
    cmd += ["--dir", "/run/sandworm/toolroot"]
    cmd += ["--ro-bind", str(toolroot_dir), "/run/sandworm/toolroot"]
    # Hooks (explicit control-plane export).
    hooks_dir = control / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    cmd += ["--dir", "/run/sandworm/hooks"]
    cmd += ["--ro-bind", str(hooks_dir), "/run/sandworm/hooks"]

    bwrap_env = dict(os.environ)
    _sanitize_env_for_sandbox(bwrap_env)
    _inject_bwrap_ssl_env(bwrap_env)
    _inject_nix_experimental_features_env(bwrap_env, home_dir=home_dir)

    # Optional extra mounts.
    created_dirs: set[str] = {
        "/",
        "/usr",
        "/usr/bin",
        "/bin",
        "/workspace",
        "/workspace/shared",
        "/home",
        "/home/sandworm",
        "/tmp",
        "/var",
        "/var/tmp",
        "/run",
        "/run/sandworm",
        "/run/sandworm/bin",
        "/run/sandworm/host-bin",
        "/run/sandworm/home",
        "/run/sandworm/clients",
        "/run/sandworm/toolroot",
        "/run/sandworm/hooks",
    }
    if mounts:
        for src, dest, mode in mounts:
            _bwrap_ensure_dest_dirs_for_bind(cmd, dest=dest, src=src, created=created_dirs)
            if mode == "ro":
                cmd += ["--ro-bind", src, dest]
            else:
                cmd += ["--bind", src, dest]

    if take_the_wheel:
        cmd += ["--dir", "/host"]
        cmd += ["--bind", "/", "/host"]

    # Environment.
    bwrap_env["SANDWORM_HOME"] = "/run/sandworm/home"
    bwrap_env["HOME"] = "/run/sandworm/home"
    bwrap_env["USER"] = bwrap_env.get("USER", "sandworm")
    # Host TMPDIR often points at `--root/.sandworm/tmp`, which is intentionally masked inside bwrap.
    # Provide a sandbox-valid temp directory so tools like nix can run reliably.
    bwrap_env["TMPDIR"] = "/run/sandworm/home/tmp"
    bwrap_env.setdefault("TMP", "/tmp")
    bwrap_env.setdefault("TEMP", "/tmp")
    # nix-portable defaults to running its own sandbox; inside a bwrap sandbox this is redundant and can
    # break in subtle ways (e.g., CA cert visibility, nested namespace quirks). Allow override by the user.
    bwrap_env.setdefault("NP_CONF_SANDBOX", "false")
    path_parts: list[str] = []
    # Prefer an explicitly resolved host Node (common on NixOS where node is not in /run/current-system/sw/bin).
    # Only add /nix/store paths (read-only, stable) to avoid leaking arbitrary host PATH entries into SAFE sandboxes.
    try:
        host_node = shutil.which("node")
        if host_node:
            p = Path(host_node)
            if str(p).startswith("/nix/store/") and p.name == "node":
                path_parts.append(str(p.parent))
    except Exception:
        pass
    if have_run_sw:
        path_parts.append("/run/current-system/sw/bin")
    if need_host_bin_shadow:
        path_parts.append("/run/sandworm/host-bin")
    path_parts.append("/run/sandworm/bin")
    path_parts += ["/usr/bin", "/bin", "/nix/var/nix/profiles/default/bin", "/run/sandworm/toolroot/bin"]
    bwrap_env["PATH"] = ":".join(path_parts)
    bwrap_env["SANDWORM_BACKEND"] = "bwrap"
    bwrap_env["SANDWORM_CLIENTS_BIN"] = "/run/sandworm/clients/bin"
    bwrap_env["SANDWORM_BIN"] = "/run/sandworm/bin/sandworm"
    # Prefer a system nix that will be visible inside bwrap; fall back to toolroot nix wrapper.
    # Clients wrappers consult $SANDWORM_NIX before PATH, so this choice matters.
    if have_run_sw and Path("/run/current-system/sw/bin/nix").exists():
        # In NixOS bwrap sandboxes we do not expose the host's full /bin; use the real mounted path.
        bwrap_env["SANDWORM_NIX"] = "/run/current-system/sw/bin/nix"
    elif Path("/nix/var/nix/profiles/default/bin/nix").exists():
        bwrap_env["SANDWORM_NIX"] = "/nix/var/nix/profiles/default/bin/nix"
    elif Path("/run/sandworm/toolroot/bin/nix").exists():
        bwrap_env["SANDWORM_NIX"] = "/run/sandworm/toolroot/bin/nix"
    pybin = _ensure_python311_bin()
    if pybin:
        bwrap_env["SANDWORM_PYTHON"] = pybin
    # Legacy compatibility: older in-sandbox lanes may still call Python directly.
    # Keep embedded core rewrites for those paths, but the supported re-entry contract is SANDWORM_BIN.
    embedded = os.environ.get("SANDWORM_EMBEDDED_CORE_DIR")
    if isinstance(embedded, str) and embedded.strip():
        emb = embedded.strip()
        try:
            if str(home_dir) and emb.startswith(str(home_dir)):
                emb = "/run/sandworm/home" + emb[len(str(home_dir)) :]
            elif str(root) and emb.startswith(str(root)):
                emb = "/workspace" + emb[len(str(root)) :]
        except Exception:
            pass
        if emb:
            bwrap_env["SANDWORM_EMBEDDED_CORE_DIR"] = emb
            prev = bwrap_env.get("PYTHONPATH") or ""
            bwrap_env["PYTHONPATH"] = emb + (os.pathsep + prev if prev else "")

    # UNSAFE/TAKE-THE-WHEEL: mount the host gateway socket (do not expose /workspace/.sandworm).
    if unsafe or take_the_wheel:
        try:
            from .hostd_ctl import hostd_socket, hostd_start

            hostd_start(root)
        except Exception:
            pass
        host_sock = hostd_socket(root)
        if host_sock.exists():
            cmd += ["--ro-bind", str(host_sock), "/run/sandworm/hostd.sock"]
            bwrap_env["SANDWORM_HOSTD_SOCK"] = "/run/sandworm/hostd.sock"
            try:
                from .hostd_ctl import hostd_token

                tok = hostd_token(root)
                if tok:
                    bwrap_env["SANDWORM_HOSTD_TOKEN"] = tok
            except Exception:
                pass
        else:
            bwrap_env["SANDWORM_HOSTD_MISSING"] = "1"
            print(
                f"WARNING: posture requested host gateway, but hostd socket is missing at {host_sock} "
                "(host actions will fail closed).",
                file=sys.stderr,
            )
    if unsafe:
        bwrap_env["SANDWORM_POSTURE"] = "unsafe"
    elif take_the_wheel:
        bwrap_env["SANDWORM_POSTURE"] = "take-the-wheel"
    else:
        bwrap_env["SANDWORM_POSTURE"] = "safe"
    if expose_control_plane:
        bwrap_env["SANDWORM_EXPOSE_CONTROL_PLANE"] = "1"
    if env:
        bwrap_env.update(env)
        # Re-apply scrub after explicit env overlays so sensitive host vars do not
        # re-enter SAFE/DEV sandboxes through caller-provided env maps.
        _sanitize_env_for_sandbox(bwrap_env)

    # Prefer an explicit sandbox cwd (bubblewrap will fail if it can't chdir; that's better than silently using /).
    if workdir:
        cmd += ["--chdir", workdir]

    cmd += argv2
    if capture_output:
        return subprocess.run(cmd, text=True, capture_output=True, env=bwrap_env, timeout=timeout_s, input=stdin, errors="replace")
    if stdin is not None:
        raise ValueError("run_bwrap(..., capture_output=False) does not support stdin text input")
    if force_tty:
        try:
            cmd = wrap_with_pty_if_needed(cmd=cmd, force=True, label="bwrap attached run")
        except PtyWrapError as e:
            raise RuntimeError(str(e)) from e
    hb_s = _attached_heartbeat_s()
    grace_s = _attached_timeout_grace_s()
    interactive_tty = False
    try:
        interactive_tty = bool(sys.stdin.isatty() and sys.stdout.isatty() and sys.stderr.isatty())
    except Exception:
        interactive_tty = False
    heartbeat_enabled = hb_s > 0 and _progress_enabled() and (
        not interactive_tty or _attached_heartbeat_in_interactive_tty()
    )
    deadline = (time.time() + float(timeout_s)) if (timeout_s is not None and int(timeout_s) > 0) else None
    start = time.time()
    proc: subprocess.Popen[str] | None = None
    try:
        proc = subprocess.Popen(cmd, text=True, env=bwrap_env, start_new_session=True)
        if _progress_enabled():
            _note("provider launch: started bwrap run")
        next_tick = (start + float(hb_s)) if heartbeat_enabled else float("inf")
        while True:
            rc = proc.poll()
            now = time.time()
            if rc is not None:
                if _progress_enabled():
                    elapsed = int(now - start)
                    _note(f"provider launch: bwrap run exited rc={int(rc)} (elapsed {elapsed}s)")
                return subprocess.CompletedProcess(args=cmd, returncode=int(rc), stdout="", stderr="")
            if deadline is not None and now >= deadline:
                elapsed = int(now - start)
                _note(f"provider launch: bwrap run timed out after {elapsed}s; terminating process group")
                _terminate_proc_group(proc, grace_s=grace_s)
                return subprocess.CompletedProcess(
                    args=cmd,
                    returncode=124,
                    stdout="",
                    stderr=f"bwrap attached run timed out after {int(timeout_s)}s",
                )
            if heartbeat_enabled and now >= next_tick:
                elapsed = int(now - start)
                _note(f"provider launch: bwrap run still active (elapsed {elapsed}s)")
                next_tick = now + float(hb_s)
            time.sleep(0.2)
    except KeyboardInterrupt:
        if proc is not None:
            _note("provider launch: interrupt received; terminating bwrap run")
            _terminate_proc_group(proc, grace_s=grace_s)
        return subprocess.CompletedProcess(args=cmd, returncode=130, stdout="", stderr="interrupted")


def run_bwrap_attached(
    root: Path,
    argv: list[str],
    *,
    workdir: str = "/workspace",
    offline: bool = False,
    mounts: list[tuple[str, str, str]] | None = None,  # (src, dest, mode) mode in {ro,rw}
    shares: list[tuple[str, str, str]] | None = None,  # (name, src, mode)
