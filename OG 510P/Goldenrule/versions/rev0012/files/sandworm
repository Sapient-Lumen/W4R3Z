def state_root_config_path(root: Path) -> Path:
    return (root.resolve() / ".sandworm-state-root").resolve()


def _parse_state_root_lines(lines: list[str]) -> StateRootConfig:
    path: Path | None = None
    readonly = False
    if lines:
        raw = lines[0].strip()
        if raw:
            path = Path(raw).expanduser()
    for line in lines[1:]:
        s = line.strip().lower()
        if not s:
            continue
        if s in ("readonly", "readonly=1", "readonly=true", "readonly=yes", "readonly:on"):
            readonly = True
    return StateRootConfig(path=path, readonly=readonly)


def read_state_root_file(root: Path) -> StateRootConfig:
    p = state_root_config_path(root)
    if not p.exists():
        return StateRootConfig(path=None, readonly=False)
    try:
        raw = p.read_text(encoding="utf-8").splitlines()
    except Exception as e:
        raise StateError(f"failed to read state root file: {p}") from e
    cfg = _parse_state_root_lines(raw)
    if cfg.path is None:
        return StateRootConfig(path=None, readonly=cfg.readonly)
    try:
        path = cfg.path
        if not path.is_absolute():
            path = (root.resolve() / path).resolve()
        else:
            path = path.resolve()
    except Exception as e:
        raise StateError(f"invalid state root path in {p}: {str(cfg.path)!r}") from e
    return StateRootConfig(path=path, readonly=cfg.readonly)


def resolve_state_root(root: Path, path: str) -> Path:
    try:
        p = Path(path).expanduser()
        if not p.is_absolute():
            p = (root.resolve() / p).resolve()
        else:
            p = p.resolve()
    except Exception as e:
        raise StateError(f"invalid state root path: {path!r}") from e
    return p


def state_root_readonly_env() -> bool:
    v = os.environ.get("SW_STATE_ROOT_READONLY") or os.environ.get("SANDWORM_STATE_ROOT_READONLY")
    if not isinstance(v, str):
        return False
    return v.strip().lower() in ("1", "true", "yes", "y", "on")


def state_root_readonly(root: Path) -> bool:
    if state_root_readonly_env():
        return True
    try:
        cfg = read_state_root_file(root)
        return bool(cfg.readonly)
    except Exception:
        return False


def require_control_plane_marker(path: Path) -> None:
    marker = path / "CONTROL_PLANE_DO_NOT_TOUCH"
    if not marker.exists():
        raise StateError(f"missing control-plane marker: {marker}")


def write_state_root_file(root: Path, path: Path, *, readonly: bool) -> Path:
    p = state_root_config_path(root)
    try:
        lines = [str(path)]
        if readonly:
            lines.append("readonly")
        p.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except Exception as e:
        raise StateError(f"failed to write state root file: {p}") from e
    return p


def clear_state_root_file(root: Path) -> bool:
    p = state_root_config_path(root)
    try:
        if p.exists():
            p.unlink()
            return True
    except Exception as e:
        raise StateError(f"failed to remove state root file: {p}") from e
    return False


def import_state_root(*, root: Path, src: Path, overwrite: bool, skip_volatile: bool) -> list[str]:
    """
    Copy a control-plane directory into the current root's `.sandworm` directory.
    Returns a list of copied top-level entries.
    """
    dest = (root.resolve() / ".sandworm").resolve()
    if not src.is_dir():
        raise StateError(f"source state root not found: {src}")
    require_control_plane_marker(src)
    dest.mkdir(parents=True, exist_ok=True)
    copied: list[str] = []
    for entry in sorted(src.iterdir()):
        name = entry.name
        if skip_volatile and name in ("locks", "tmp"):
            continue
        target = dest / name
        if target.exists():
            if overwrite:
                if target.is_dir():
                    shutil.rmtree(target)
                else:
                    target.unlink()
            else:
                continue
        if entry.is_dir():
            shutil.copytree(entry, target, symlinks=True)
        else:
            shutil.copy2(entry, target, follow_symlinks=False)
        copied.append(name)
    return copied
