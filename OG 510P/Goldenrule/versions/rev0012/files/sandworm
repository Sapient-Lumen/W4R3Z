    override = os.environ.get("SW_HOSTDEPS_OS_RELEASE_FILE") or os.environ.get("SANDWORM_HOSTDEPS_OS_RELEASE_FILE")
    p = Path(override).expanduser() if isinstance(override, str) and override.strip() else Path("/etc/os-release")
    out: dict[str, str] = {}
    if not p.exists():
        return out
    try:
        for raw in p.read_text(encoding="utf-8", errors="replace").splitlines():
            line = raw.strip()
