    ctx.event("facility_smoke", {"exit_code": int(rc), "duration_ms": int(dt_ms)}, step="selftest-facility")
    if rc != 0:
        ctx.event("selftest_end", {"status": "fail", "mode": "facility"}, step="selftest-facility")
        return int(rc) if int(rc) != 0 else 112

    ctx.event("selftest_end", {"status": "ok", "mode": "facility"}, step="selftest-facility")
