def _should_skip_payload_path(rel: str) -> bool:
    parts = rel.split("/")
    if "__pycache__" in parts or ".pytest_cache" in parts:
        return True
    if rel.endswith(".pyc") or rel.endswith(".pyo"):
        return True
    if parts[:1] == ["sandworm_core"] and parts[1:2] == ["__pycache__"]:
        return True
    return False


def _build_payload_tar_bytes(*, sandworm_path: Path, core_dir: Path) -> bytes:
    sw_text = _read_text(sandworm_path)
    sw_text = _normalize_payload_wrapper(sw_text)
    sw_text = _normalize_stage0_bwrap_nix_bind(sw_text)
    core_pkg = core_dir / "sandworm_core"
    if not core_pkg.is_dir():
        raise SinglefileError(f"missing sandworm_core/ directory at: {core_pkg}")

    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tf:
        sw_info = tarfile.TarInfo(name="sandworm")
        sw_bytes = sw_text.encode("utf-8")
        sw_info.size = len(sw_bytes)
        sw_info.mode = 0o755
        tf.addfile(sw_info, io.BytesIO(sw_bytes))

        for p in sorted(core_pkg.rglob("*")):
            rel = p.relative_to(core_dir).as_posix()
            if _should_skip_payload_path(rel):
                continue
            ti = tarfile.TarInfo(name=rel)
            try:
                st = p.lstat()
                ti.mode = stat.S_IMODE(st.st_mode)
            except Exception:
                ti.mode = 0o644
            if p.is_symlink():
                # Do not dereference symlinks when building the payload: it can accidentally embed
                # host files outside the repo. Keep the singlefile payload strict and explicit.
                raise SinglefileError(f"refusing to embed symlink in singlefile payload: {rel}")
            if p.is_dir():
                ti.type = tarfile.DIRTYPE
                ti.size = 0
                tf.addfile(ti)
                continue
            if p.is_file():
                try:
                    data = p.read_bytes()
                except Exception as e:
                    raise SinglefileError(f"failed to read payload file: {p}") from e
                ti.type = tarfile.REGTYPE
