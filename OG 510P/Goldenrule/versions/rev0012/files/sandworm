    """
    root = root.resolve()
    res: dict[str, dict[str, object]] = {}

    def _one(kind: str, d: Path, names: list[str]) -> None:
        out: dict[str, object] = {}
        for n in names:
            p = d / f"{n}.sh"
            out[n] = {"path": str(p), "present": p.is_file(), "enabled": bool(p.is_file() and (p.stat().st_mode & 0o111))}
