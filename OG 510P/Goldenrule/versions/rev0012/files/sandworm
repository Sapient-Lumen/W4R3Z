            text = src_events.read_text(encoding="utf-8")
            if os.environ.get("SW_REDACT_LOGS", "1") != "0":
                try:
                    from .creds import redact_known_secrets

                    text = redact_known_secrets(root, text)
                except Exception:
                    pass
            dst_events.write_text(text, encoding="utf-8")
        except Exception:
            pass

    # Copy declared proof files into artifacts/, using stable key-derived names.
    used_names: set[str] = set()
    for k, v in sorted((files or {}).items()):
        if not isinstance(k, str) or not isinstance(v, str):
            continue
        src = Path(v)
        if not src.is_absolute():
            src = root / src
        try:
            src = src.resolve()
        except Exception:
            pass
        if not src.exists() or not src.is_file():
            continue
