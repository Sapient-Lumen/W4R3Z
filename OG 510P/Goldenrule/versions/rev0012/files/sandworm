def build_hostdeps_install_plan(
    report: dict[str, object],
    *,
    only: list[str] | None = None,
    include_config: bool = True,
) -> HostDepsInstallPlan:
    manager = report.get("manager") if isinstance(report.get("manager"), str) else None
    missing = report.get("missing") if isinstance(report.get("missing"), list) else []
    missing_norm = [str(x).strip().lower() for x in missing if str(x).strip().lower() in ("podman", "bwrap", "kvm")]
    selected = list(missing_norm)
    if only:
        keep = {str(x).strip().lower() for x in only if str(x).strip().lower() in ("podman", "bwrap", "kvm")}
        selected = [x for x in selected if x in keep]
    notes: list[str] = []
    commands: list[str] = []
    if manager == "nixos":
        notes.extend(
            [
                "NixOS detected: install host deps in system configuration, then rebuild.",
                "Recommended modules: virtualisation.podman.enable = true; programs.bwrap.enable = true;",
                "For KVM: virtualisation.libvirtd.enable = true; users.users.<name>.extraGroups = [ \"kvm\" \"libvirtd\" ];",
            ]
        )
        return HostDepsInstallPlan(
            supported=False,
            manager=manager,
            commands=[],
            notes=notes,
            selected=selected,
        )
    if manager is None:
        notes.append("No supported package manager was detected (apt/dnf/yum/pacman/zypper/apk).")
        return HostDepsInstallPlan(
            supported=False,
            manager=None,
            commands=[],
            notes=notes,
            selected=selected,
        )
    if not selected:
        if include_config:
            present = report.get("present") if isinstance(report.get("present"), dict) else {}
            if isinstance(present, dict) and bool(present.get("qemu")) and not bool(present.get("kvm_dev_writable")):
                commands.append('if getent group kvm >/dev/null 2>&1; then sudo usermod -aG kvm "$USER"; fi')
                notes.append("If group membership changed, log out/in (or reboot) before retrying Sandworm KVM.")
        return HostDepsInstallPlan(
            supported=True,
            manager=manager,
            commands=commands,
            notes=notes,
            selected=[],
        )

    if manager == "apt":
        commands.append("sudo apt-get update")
    if manager == "zypper":
        commands.append("sudo zypper --non-interactive refresh")

    for dep in selected:
        candidates = _pkg_plan(manager, dep)
        if not candidates:
            notes.append(f"no install mapping for dependency {dep!r} under manager={manager!r}")
            continue
        if len(candidates) == 1:
            commands.append(_install_cmd(manager, candidates[0]))
            continue
        cmds = [_install_cmd(manager, c) for c in candidates]
        commands.append(" || ".join(cmds))

    if include_config and ("kvm" in selected or "kvm" in missing_norm):
        commands.append('if getent group kvm >/dev/null 2>&1; then sudo usermod -aG kvm "$USER"; fi')
        notes.append("If group membership changed, log out/in (or reboot) before retrying Sandworm KVM.")

    if "podman" in selected:
        notes.append("Rootless podman may require subuid/subgid entries (check /etc/subuid and /etc/subgid).")

    return HostDepsInstallPlan(
        supported=True,
        manager=manager,
        commands=commands,
        notes=notes,
        selected=selected,
    )


def run_hostdeps_install_plan(
    plan: HostDepsInstallPlan,
    *,
    dry_run: bool = False,
) -> dict[str, object]:
    executed: list[dict[str, object]] = []
    if not plan.supported:
        return {"ok": False, "error": "unsupported_platform", "executed": executed, "plan": plan.as_dict()}
    if not plan.commands:
        return {"ok": True, "changed": False, "executed": executed, "plan": plan.as_dict()}
    if dry_run:
        return {"ok": True, "changed": False, "dry_run": True, "executed": executed, "plan": plan.as_dict()}
    for cmd in plan.commands:
        try:
            proc = subprocess.run(
                ["bash", "-lc", cmd],
                text=True,
                capture_output=True,
                timeout=60 * 20,
            )
        except Exception as e:
            return {
                "ok": False,
                "error": str(e),
                "executed": executed,
                "failed_command": cmd,
                "plan": plan.as_dict(),
            }
        row = {
            "command": cmd,
            "exit_code": int(proc.returncode),
            "stdout": (proc.stdout or "")[-4000:],
            "stderr": (proc.stderr or "")[-4000:],
        }
        executed.append(row)
        if proc.returncode != 0:
            return {
                "ok": False,
                "error": f"install command failed (exit={proc.returncode})",
                "failed_command": cmd,
                "executed": executed,
                "plan": plan.as_dict(),
            }
    return {"ok": True, "changed": True, "executed": executed, "plan": plan.as_dict()}


