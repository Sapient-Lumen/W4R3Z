def _safe_home_env(root: Path) -> dict[str, str]:
    """
    SAFE defaults: make external tool probes (nix/podman/etc) avoid writing into host $HOME.

    Some tools create caches or state even for benign probes like `--version`. Point HOME/XDG_*
    at Sandworm-managed dirs under `--root/.sandworm/home`.
    """
    env = dict(os.environ)
    # If we are already inside a sandbox, respect the existing Sandworm HOME.
    active_sw_home = os.environ.get("SANDWORM_HOME")
    if active_sw_home == "/run/sandworm/home" or os.environ.get("HOME") == "/run/sandworm/home":
        home = Path(active_sw_home or "/run/sandworm/home")
    else:
        home = sandworm_home_dir(root)

    try:
        (home / ".cache").mkdir(parents=True, exist_ok=True)
        (home / ".config").mkdir(parents=True, exist_ok=True)
        (home / ".local" / "share").mkdir(parents=True, exist_ok=True)
        (home / ".local" / "state").mkdir(parents=True, exist_ok=True)
    except OSError as e:
        # Noob ergonomics: if we are inside a sandbox where .sandworm is masked (RO),
        # don't fail the doctor probe just because we can't create cache dirs.
        if e.errno != 30: # 30 = Read-only file system
            pass
    except Exception:
        pass
    env["HOME"] = str(home)
    env["XDG_CACHE_HOME"] = str(home / ".cache")
    env["XDG_CONFIG_HOME"] = str(home / ".config")
    env["XDG_DATA_HOME"] = str(home / ".local" / "share")
    env["XDG_STATE_HOME"] = str(home / ".local" / "state")
    return env


