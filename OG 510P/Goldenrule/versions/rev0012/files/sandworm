import os
import shutil
from pathlib import Path


def nix_flags() -> list[str]:
    return ["--extra-experimental-features", "nix-command flakes"]


def find_nix(root: Path | None = None) -> str | None:
    """
    Locate a nix executable.

    Prefers an explicit nix override (SW_NIX / SANDWORM_NIX), then a native/system nix when available
    (more stable on NixOS and avoids nix-portable quirks), and finally falls back to the repo-local
    toolroot nix wrapper when present (keeps state disposable under --root).

    Toolroot wrapper path:
      .sandworm/toolroot/bin/nix
    """
    env_nix = os.environ.get("SW_NIX") or os.environ.get("SANDWORM_NIX")
    if env_nix:
        try:
            p = Path(env_nix)
            # `Path.exists()` follows symlinks; reject broken symlinks early so callers can fall back.
            if p.exists() and os.access(str(p), os.X_OK):
                return str(p)
        except Exception:
            pass

    # Prefer well-known system nix locations even if PATH is weird. This avoids nix-portable
    # first-run issues (ETXTBSY) and store-output symlink edge cases that can break pinning.
    for cand in (
        "/run/current-system/sw/bin/nix",  # NixOS
        "/nix/var/nix/profiles/default/bin/nix",
        "/nix/profile/bin/nix",
    ):
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand

    if root is None:
        env_root = os.environ.get("SANDWORM_ROOT")
        if env_root:
            try:
                root = Path(env_root)
            except Exception:
                root = None
    if root is not None:
        cand = Path(root) / ".sandworm" / "toolroot" / "bin" / "nix"
        if cand.exists() and os.access(str(cand), os.X_OK):
            return str(cand)
    p = shutil.which("nix")
    if p and "/.sandworm/toolroot/bin/" not in p and "/run/sandworm/toolroot/bin/" not in p:
        return p
    if p:
        return p
    return None


