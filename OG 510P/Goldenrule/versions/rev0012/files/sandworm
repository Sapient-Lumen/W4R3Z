def _select_host_shell(shell_path: str | None) -> str | None:
    """
    Pick a concrete, executable shell path on the host.

    NixOS typically lacks /bin/sh, so we also try /run/current-system/sw/bin/{sh,bash}.
    """
    if shell_path and os.path.exists(shell_path) and os.access(shell_path, os.X_OK):
        return shell_path
    candidates: list[str] = [
        "/run/current-system/sw/bin/bash",
        "/run/current-system/sw/bin/sh",
        "/bin/bash",
        "/usr/bin/bash",
        "/bin/sh",
        "/usr/bin/sh",
    ]
    picked = _pick_existing_shell(candidates)
    if picked:
        return picked
    for nm in ("bash", "sh"):
        p = shutil.which(nm)
        if p and os.path.exists(p) and os.access(p, os.X_OK):
            return p
    return None

def _write_passwd_with_shell_override(root: Path, *, shell: str) -> Path | None:
    """
    Create a project-local /etc/passwd override with the current user's login shell
    forced to a known-good path (typically /bin/sh).

    Motivation (Codex CLI):
    - Codex's command execution sandbox on Linux may attempt to exec the user's login shell
      from /etc/passwd (often /run/current-system/sw/bin/zsh on NixOS).
    - That path is not necessarily present inside Codex's internal sandbox, yielding opaque ENOENT.
    - Overriding /etc/passwd inside the *outer* sandbox keeps SAFE defaults (no host mutation)
      while making tool execution reliable.
    """
    try:
        src = Path("/etc/passwd")
        if not src.exists():
            return None
        uid = os.getuid()
        lines = src.read_text(encoding="utf-8", errors="replace").splitlines()
        out: list[str] = []
        changed = False
        for line in lines:
            if not line or line.startswith("#"):
                out.append(line)
                continue
            parts = line.split(":")
            if len(parts) >= 7:
                try:
                    if int(parts[2]) == int(uid):
                        parts[6] = shell
                        line = ":".join(parts)
                        changed = True
                except Exception:
                    pass
            out.append(line)
        if not changed:
            return None
        d = (control_dir(root) / "tmp").resolve()
        d.mkdir(parents=True, exist_ok=True)
        p = (d / "passwd.shell-override").resolve()
        p.write_text("\n".join(out) + "\n", encoding="utf-8")
        return p
    except Exception:
        return None

def _ensure_busybox_static(root: Path) -> Path | None:
    """
    Ensure a statically-linked busybox binary exists under the project-local toolroot.

    Why:
    - Some nested sandboxes (notably Codex's internal command sandbox) may not mount /nix or /run,
      so shells like /run/current-system/sw/bin/zsh (and even NixOS's /bin/sh -> /nix/store/...) can
      fail with ENOENT inside that nested environment.
    - A static busybox placed at /bin/sh inside the *outer* sandbox gives the nested runner a
      portable shell binary that does not depend on /nix being mounted.
    """
    try:
        out = (control_dir(root) / "toolroot" / "bin" / "busybox-static").resolve()
        if _is_valid_busybox_binary(out):
            return out
        # Drop corrupt/empty placeholders so we can rebuild a valid binary.
        try:
            if out.exists() or out.is_symlink():
                out.unlink()
        except Exception:
            pass
        # Prefer the project-local toolroot nix wrapper when present (works even on hosts without system nix).
        nix = None
        try:
            toolroot_nix = (control_dir(root) / "toolroot" / "bin" / "nix").resolve()
            if toolroot_nix.exists() and os.access(toolroot_nix, os.X_OK):
                nix = str(toolroot_nix)
        except Exception:
            nix = None
        if not nix:
            nix = find_nix(root)
        if not nix:
            return None
        # Build a static busybox via nixpkgs' pkgsStatic. This is a small binary and is usually cache-backed.
        link = (control_dir(root) / "toolroot" / "tmp-busybox-static").resolve()
        try:
            if link.exists() or link.is_symlink():
                try:
                    link.unlink()
                except Exception:
                    pass
        except Exception:
            pass
        argv = [nix, *nix_flags(), "build", "nixpkgs#pkgsStatic.busybox", "--out-link", str(link)]
        subprocess.run(argv, cwd=str(root), check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        src = link / "bin" / "busybox"
        if not _is_valid_busybox_binary(src):
            return None
        out.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, out)
        try:
            out.chmod(0o755)
        except Exception:
            pass
        return out if _is_valid_busybox_binary(out) else None
    except Exception:
        return None

def _write_executable(path: Path, text: str) -> None:
    fd: int | None = None
    tmp_path: Path | None = None
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            if path.is_symlink():
                path.unlink()
        except Exception:
            pass
        fd, tmp_name = tempfile.mkstemp(prefix=path.name + ".tmp.", dir=str(path.parent))
        tmp_path = Path(tmp_name)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            f.write(text)
        try:
            tmp_path.chmod(0o755)
        except Exception:
            pass
        os.replace(str(tmp_path), str(path))
    except Exception:
        return
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except Exception:
                pass
        if tmp_path is not None and tmp_path.exists() and tmp_path != path:
            try:
                tmp_path.unlink(missing_ok=True)
            except Exception:
                pass

def _toolroot_busybox_applet_wrapper_script(name: str) -> str:
