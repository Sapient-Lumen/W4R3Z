def _wrapper_home_selection_snippet() -> str:
    return """_sw_writable_dir() {
  d="${1:-}"
  [ -n "$d" ] || return 1
  mkdir -p "$d" >/dev/null 2>&1 || return 1
  [ -w "$d" ]
}

_sw_pick_home() {
  if [ -n "${SANDWORM_HOME:-}" ] && _sw_writable_dir "${SANDWORM_HOME}"; then
    printf '%s' "${SANDWORM_HOME}"
    return 0
  fi

  # Host layout: <repo>/.sandworm/clients/bin/<tool>
  case "$CLIENTS_DIR" in
    */.sandworm/clients)
