    sock = _socket_path(root)
    tok = _token(root, sock=sock)
    if tok and "token" not in req:
        req = dict(req)
        req["token"] = tok
    with _connect(sock) as s:
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        resp_raw = b""
        while not resp_raw.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            resp_raw += chunk
    return json.loads(resp_raw.decode("utf-8", errors="replace").strip() or "{}")


