def host_hook_is_enabled(root: Path, name: str) -> bool:
    p = host_hooks_dir(root) / f"{name}.sh"
    return p.exists() and p.is_file() and bool(p.stat().st_mode & 0o111)


def allow_host_hooks_default() -> bool:
