def ensure_sandbox_bin_dir(root: Path, *, bwrap_path: str | None = None) -> Path:
    """
    Ensure control-plane `bin/` contains portable in-sandbox entrypoints.

    Returns host path to the exported bin dir (typically `<root>/.sandworm/bin`):
    - `sandworm` -> host Sandworm entrypoint
    - optional `bwrap` -> host bwrap binary
    """
    root = root.resolve()
    bin_dir = control_dir(root) / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)

