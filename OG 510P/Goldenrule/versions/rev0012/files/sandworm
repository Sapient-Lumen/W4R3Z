            cmds = expect.get("command_succeeds")
            if cmds is not None and not isinstance(cmds, list):
                errors.append(f"step {sid}: expect.command_succeeds must be a list")
            if isinstance(cmds, list):
                for j, cmd in enumerate(cmds, start=1):
                    if not (isinstance(cmd, list) and cmd and all(isinstance(x, str) for x in cmd)):
                        errors.append(f"step {sid}: expect.command_succeeds[{j}] must be a non-empty string argv list")
                    elif _uses_legacy_in_sandbox_reentry(cmd):
                        msg = _legacy_reentry_message(
                            f"step {sid}: expect.command_succeeds[{j}]",
                            allow_legacy_in_sandbox_reentry=allow_legacy_in_sandbox_reentry,
                        )
                        if allow_legacy_in_sandbox_reentry:
                            warnings.append(msg)
                        else:
                            errors.append(msg)
            files = expect.get("files_exist")
            if files is not None and not isinstance(files, list):
                errors.append(f"step {sid}: expect.files_exist must be a list")
            if isinstance(files, list) and not all(isinstance(x, str) and x.strip() for x in files):
                errors.append(f"step {sid}: expect.files_exist entries must be non-empty strings")
            ec = expect.get("exit_code")
            if ec is not None and not isinstance(ec, int):
                errors.append(f"step {sid}: expect.exit_code must be an int")

    return errors, warnings
