def _run_tee(
    *,
    argv: list[str],
    cwd: Path,
    env: dict[str, str],
    stdout_path: Path,
    stderr_path: Path,
    timeout_s: int | None,
) -> tuple[int, int]:
    """
    Run a subprocess, streaming stdout/stderr to both the terminal and files.
    Returns (exit_code, duration_ms).
    """
    t0 = time.time()
    stdout_path.parent.mkdir(parents=True, exist_ok=True)
    stderr_path.parent.mkdir(parents=True, exist_ok=True)
    with stdout_path.open("w", encoding="utf-8") as out_f, stderr_path.open("w", encoding="utf-8") as err_f:
        proc = subprocess.Popen(argv, cwd=str(cwd), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        sel = selectors.DefaultSelector()
        assert proc.stdout is not None
        assert proc.stderr is not None
        sel.register(proc.stdout, selectors.EVENT_READ, ("stdout", out_f))
        sel.register(proc.stderr, selectors.EVENT_READ, ("stderr", err_f))
        try:
            while True:
                if timeout_s is not None and timeout_s > 0 and (time.time() - t0) > float(timeout_s):
                    proc.kill()
                    break
                events = sel.select(timeout=0.1)
                for key, _mask in events:
                    stream_name, f = key.data
                    line = key.fileobj.readline()
                    if line == "":
                        try:
                            sel.unregister(key.fileobj)
                        except Exception:
                            pass
                        continue
                    f.write(line)
                    f.flush()
                    if stream_name == "stdout":
                        sys.stdout.write(line)
                        sys.stdout.flush()
                    else:
                        sys.stderr.write(line)
                        sys.stderr.flush()
                if proc.poll() is not None and not sel.get_map():
                    break
        finally:
            try:
                sel.close()
            except Exception:
                pass
        rc = proc.wait(timeout=5) if proc.poll() is not None else proc.returncode
    dt_ms = int((time.time() - t0) * 1000)
    return int(rc or 0), dt_ms


def run_selftest_facility(
    ctx: RunContext,
    *,
    full: bool,
    vm_matrix: bool,
    podman_pulls: bool,
    timeout_s: int,
) -> int:
    """
    Repo-only test runner: execute tests/smoke-facility.sh under a RunContext and emit a proof bundle via the CLI.

    This is intentionally source-tree scoped (requires the repo's tests/ directory).
    """
    ctx.event("selftest_start", {"mode": "facility", "full": bool(full), "vm_matrix": bool(vm_matrix), "podman_pulls": bool(podman_pulls)})

    script = (ctx.root / "tests" / "smoke-facility.sh").resolve()
    if not script.exists():
        ctx.event("error", {"where": "selftest_facility", "error": f"missing required script: {script}"})
        ctx.event("selftest_end", {"status": "fail", "mode": "facility"}, step="selftest-facility")
        return 110

    env = dict(os.environ)
    if full:
        env["SW_SMOKE_FACILITY_FULL"] = "1"
        env["SANDWORM_SMOKE_FACILITY_FULL"] = "1"
    if vm_matrix:
        env["SW_SMOKE_VM_MATRIX"] = "1"
        env["SANDWORM_SMOKE_VM_MATRIX"] = "1"
    if podman_pulls:
        env["SW_SMOKE_PODMAN_PULLS"] = "1"
        env["SANDWORM_SMOKE_PODMAN_PULLS"] = "1"

    stdout_path = ctx.run_dir / "steps" / "selftest-facility" / "logs" / "stdout.txt"
    stderr_path = ctx.run_dir / "steps" / "selftest-facility" / "logs" / "stderr.txt"

    try:
        rc, dt_ms = _run_tee(
            argv=[str(script)],
            cwd=ctx.root,
            env=env,
            stdout_path=stdout_path,
            stderr_path=stderr_path,
            timeout_s=(int(timeout_s) if int(timeout_s) > 0 else None),
        )
    except Exception as e:
        ctx.event("error", {"where": "selftest_facility.run", "error": repr(e)}, step="selftest-facility")
