from __future__ import annotations

import json
import os
from dataclasses import dataclass
from pathlib import Path

from .creds import ensure_sandworm_home, get_gemini_api_key, set_gemini_api_key


@dataclass(frozen=True)
class GeminiKeyImportResult:
    imported: bool
    reason: str
    source_env_var: str | None


@dataclass(frozen=True)
class GeminiTrustSeedResult:
    changed: bool
    path: str
    trusted_entries_added: int
    error: str | None


def ensure_gemini_api_key_imported(root: Path) -> GeminiKeyImportResult:
    """
    If Sandworm's project-local creds store has no Gemini API key, import it from the host environment
    (GEMINI_API_KEY or GOOGLE_API_KEY) so it can be used inside podman/bwrap/KVM.
    """
    root = root.resolve()

    if os.environ.get("SW_IMPORT_HOST_CREDS", "1") == "0":
        return GeminiKeyImportResult(imported=False, reason="disabled", source_env_var=None)

    if get_gemini_api_key(root):
        return GeminiKeyImportResult(imported=False, reason="already_present", source_env_var=None)

    for key_name in ("GEMINI_API_KEY", "GOOGLE_API_KEY"):
        v = os.environ.get(key_name)
        if isinstance(v, str) and v.strip():
            try:
                set_gemini_api_key(root, v.strip())
                return GeminiKeyImportResult(imported=True, reason="imported_from_env", source_env_var=key_name)
            except Exception:
                return GeminiKeyImportResult(imported=False, reason="failed_to_store", source_env_var=key_name)

    return GeminiKeyImportResult(imported=False, reason="no_env_key", source_env_var=None)


def gemini_cli_login_status(root: Path) -> dict[str, object]:
    root = root.resolve()
    home = ensure_sandworm_home(root)
    oauth_path = (home / ".gemini" / "oauth_creds.json").resolve()
    settings_path = (home / ".gemini" / "settings.json").resolve()
    google_accounts_path = (home / ".gemini" / "google_accounts.json").resolve()
    out: dict[str, object] = {
        "path": str(oauth_path),
        "present": False,
        "has_oauth": False,
        "parse_error": None,
        "settings_path": str(settings_path),
        "settings_selected_auth_type": None,
        "google_accounts_path": str(google_accounts_path),
        "google_accounts_present": False,
    }
    if oauth_path.exists():
        out["present"] = True
    if google_accounts_path.exists():
        out["google_accounts_present"] = True
    try:
        if oauth_path.exists():
            data = oauth_path.read_text(encoding="utf-8")
            if data.strip():
                obj = json.loads(data)
                if isinstance(obj, dict):
                    out["has_oauth"] = bool(obj)
                elif isinstance(obj, list):
                    out["has_oauth"] = len(obj) > 0
                else:
                    out["has_oauth"] = True
        if settings_path.exists():
            sraw = settings_path.read_text(encoding="utf-8")
            if sraw.strip():
                sobj = json.loads(sraw)
                if isinstance(sobj, dict):
                    sec = sobj.get("security")
                    if isinstance(sec, dict):
                        auth = sec.get("auth")
                        if isinstance(auth, dict):
                            selected = auth.get("selectedType")
                            if isinstance(selected, str) and selected.strip():
                                out["settings_selected_auth_type"] = selected.strip()
    except Exception as e:
        out["parse_error"] = str(e)
    return out


def gemini_has_any_creds(root: Path) -> bool:
    if get_gemini_api_key(root):
        return True
    st = gemini_cli_login_status(root)
    selected = str(st.get("settings_selected_auth_type") or "").strip().lower()
    if selected in ("oauth-personal", "gemini-api-key"):
        return True
    if bool(st.get("google_accounts_present")):
        return True
    return bool(st.get("has_oauth"))


def gemini_trusted_folders_path(root: Path) -> Path:
    root = root.resolve()
    home = ensure_sandworm_home(root)
    return (home / ".gemini" / "trustedFolders.json").resolve()


def ensure_gemini_workspace_trusted(root: Path, *, workspace_host: Path | None = None) -> GeminiTrustSeedResult:
    """
    Best-effort preseed of Gemini trusted folders for Sandworm-managed workspaces.

    Why:
    - Gemini restarts itself after trust decisions.
    - In Sandworm runs we can safely preseed trust for the active workspace paths to
      reduce first-run restart churn.
    """
    root = root.resolve()
    tf_path = gemini_trusted_folders_path(root)
    tf_dir = tf_path.parent
    try:
        tf_dir.mkdir(parents=True, exist_ok=True)
    except Exception as e:
        return GeminiTrustSeedResult(changed=False, path=str(tf_path), trusted_entries_added=0, error=str(e))

    cfg: dict[str, object] = {}
    if tf_path.exists():
        try:
            raw = tf_path.read_text(encoding="utf-8")
            if raw.strip():
                obj = json.loads(raw)
                if isinstance(obj, dict):
                    cfg = dict(obj)
        except Exception:
            cfg = {}

    add = 0
    host_ws = (workspace_host or root).resolve()
    for key in (str(host_ws), "/workspace"):
        if not key:
            continue
        if cfg.get(key) != "TRUST_FOLDER":
            cfg[key] = "TRUST_FOLDER"
            add += 1

    if add == 0 and tf_path.exists():
        return GeminiTrustSeedResult(changed=False, path=str(tf_path), trusted_entries_added=0, error=None)

    try:
        tmp = tf_path.with_suffix(tf_path.suffix + ".tmp")
        tmp.write_text(json.dumps(cfg, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        try:
            tmp.chmod(0o600)
        except Exception:
            pass
        tmp.replace(tf_path)
        try:
            tf_path.chmod(0o600)
        except Exception:
            pass
        return GeminiTrustSeedResult(changed=(add > 0), path=str(tf_path), trusted_entries_added=add, error=None)
    except Exception as e:
        return GeminiTrustSeedResult(changed=False, path=str(tf_path), trusted_entries_added=0, error=str(e))
