  # If /proc is unavailable (non-Linux), we fall back to kill -0 only.
  if [[ -r "/proc/$pid/stat" ]]; then
    # /proc/<pid>/stat: "pid (comm) state ... starttime ..."
    # Strip the leading "pid (comm) " (including any spaces inside comm) so starttime becomes field 20.
    awk '{{ sub(/^.*\\) /, \"\"); print $20; exit }}' "/proc/$pid/stat" 2>/dev/null || true
  fi
