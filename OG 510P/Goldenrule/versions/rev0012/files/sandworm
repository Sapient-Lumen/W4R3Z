            [str(wrapper), "--root", str(root0), "doctor", "--json"],
            cwd=str(root0),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
    except subprocess.TimeoutExpired:
        ctx.event("error", {"where": "selftest_stage0.doctor", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "stage0"}, step="selftest-stage0")
        return 84
    ctx.write_file("steps/selftest-stage0/logs/doctor-stdout.txt", proc.stdout)
    ctx.write_file("steps/selftest-stage0/logs/doctor-stderr.txt", proc.stderr)
    ctx.event("stage0_doctor", {"exit_code": proc.returncode}, step="selftest-stage0")
    if proc.returncode != 0:
        ctx.event("selftest_end", {"status": "fail", "mode": "stage0"}, step="selftest-stage0")
        return 85
    np = root0 / ".sandworm" / "toolroot" / "bin" / "nix-portable"
    if not (np.exists() and os.access(np, os.X_OK)):
        ctx.event("error", {"where": "selftest_stage0", "error": "stage0 did not install nix-portable under root/.sandworm/toolroot/bin"})
        ctx.event("selftest_end", {"status": "fail", "mode": "stage0"}, step="selftest-stage0")
        return 86

    # Offline should fail closed when stage0 is required.
    root_offline = tmp_base / "root-offline"
    root_offline.mkdir(parents=True, exist_ok=True)
    env_off = dict(env)
    env_off["SW_OFFLINE"] = "1"
    try:
        proc2 = subprocess.run(
            [str(wrapper), "--root", str(root_offline), "doctor", "--json"],
            cwd=str(root_offline),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env_off,
        )
    except subprocess.TimeoutExpired:
        ctx.event("error", {"where": "selftest_stage0.offline", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "stage0"}, step="selftest-stage0")
        return 87
    ctx.write_file("steps/selftest-stage0/logs/offline-stdout.txt", proc2.stdout)
    ctx.write_file("steps/selftest-stage0/logs/offline-stderr.txt", proc2.stderr)
    ctx.event("stage0_offline_doctor", {"exit_code": proc2.returncode}, step="selftest-stage0")
    if proc2.returncode == 0:
        ctx.event("error", {"where": "selftest_stage0.offline", "error": "expected offline stage0 doctor to fail"})
        ctx.event("selftest_end", {"status": "fail", "mode": "stage0"}, step="selftest-stage0")
        return 88

    ctx.event("selftest_end", {"status": "ok", "mode": "stage0"}, step="selftest-stage0")
    return 0


def run_selftest_singlefile(ctx: RunContext) -> int:
    """
    High-signal product test:
    - Builds a single-file artifact.
    - Proves embedded-core precedence (workspace `sandworm_core/` must not be imported).
    - Proves the product can rebuild itself in a fresh workspace root.
    """
    ctx.event("selftest_start", {"mode": "singlefile"})

    fmt_raw = (os.environ.get("SW_SINGLEFILE_FORMAT") or os.environ.get("SANDWORM_SINGLEFILE_FORMAT") or "files").strip().lower()
    fmt = "b64tar" if fmt_raw in ("blob", "b64", "tar", "b64+tar", "b64-tar", "b64tar") else fmt_raw
    need = ["bash", "sleep"]
    if fmt == "b64tar":
        need += ["tar", "base64", "awk"]
    missing = [c for c in need if not shutil.which(c)]
    if missing:
        ctx.event("error", {"where": "selftest_singlefile", "error": f"missing required host tools: {missing}"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 60

    timeout_s = 1800
    try:
        raw = os.environ.get("SW_SELFTEST_SINGLEFILE_TIMEOUT_S") or os.environ.get("SANDWORM_SELFTEST_SINGLEFILE_TIMEOUT_S")
        if raw is not None and str(raw).strip():
            timeout_s = max(30, int(str(raw).strip()))
    except Exception:
        timeout_s = 1800

    tmp_base = control_dir(ctx.root) / "tmp" / f"selftest-singlefile-{ctx.runid}"
    try:
        if tmp_base.exists():
            shutil.rmtree(tmp_base, ignore_errors=True)
        tmp_base.mkdir(parents=True, exist_ok=False)
    except Exception as e:
        ctx.event("error", {"where": "selftest_singlefile.mkdir", "error": repr(e)})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 61

    out = tmp_base / "sandworm"
    embedded = os.environ.get("SANDWORM_EMBEDDED_CORE_DIR")
    embedded_core_dir = Path(embedded) if isinstance(embedded, str) and embedded.strip() else None
    wrapper_env = os.environ.get("SANDWORM_WRAPPER_PATH")
    wrapper_path = Path(wrapper_env).resolve() if isinstance(wrapper_env, str) and wrapper_env.strip() else None
    running_singlefile = os.environ.get("SANDWORM_SINGLEFILE", "0") == "1"

    try:
        res = build_singlefile(
            root=ctx.root,
            out=out,
            use_workspace_core=False,
            format=fmt,
            running_singlefile=running_singlefile,
            embedded_core_dir=embedded_core_dir,
            argv0_path=wrapper_path,
        )
    except SinglefileError as e:
        ctx.event("error", {"where": "selftest_singlefile.build", "error": str(e)})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 62
    ctx.event(
        "singlefile_built",
        {"out": res.out, "payload_sha256": res.payload_sha256, "sources": res.used_sources, "format": getattr(res, "format", None)},
        step="selftest-singlefile",
    )

    ws = tmp_base / "workspace"
    ws.mkdir(parents=True, exist_ok=True)
    (ws / "sandworm_core").mkdir(parents=True, exist_ok=True)
    (ws / "sandworm_core" / "__init__.py").write_text(
        'raise RuntimeError("workspace sandworm_core was imported (expected embedded core)")\n', encoding="utf-8"
    )

    env = os.environ.copy()
    for k in ["SANDWORM_ROOT", "SANDWORM_CORE_DIR", "SANDWORM_EMBEDDED_CORE_DIR", "SANDWORM_SINGLEFILE", "SANDWORM_WRAPPER_PATH", "PYTHONPATH"]:
        env.pop(k, None)

    try:
        proc = subprocess.run(
            [str(out), "--root", str(ws), "doctor", "--json"],
            cwd=str(ws),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
        ctx.write_file("steps/selftest-singlefile/logs/doctor-stdout.txt", proc.stdout)
        ctx.write_file("steps/selftest-singlefile/logs/doctor-stderr.txt", proc.stderr)
        ctx.event("singlefile_doctor", {"exit_code": proc.returncode}, step="selftest-singlefile")
        if proc.returncode != 0:
            ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
            return 63
    except subprocess.TimeoutExpired as e:
        ctx.write_file("steps/selftest-singlefile/logs/doctor-stdout.txt", getattr(e, "stdout", "") or "")
        ctx.write_file("steps/selftest-singlefile/logs/doctor-stderr.txt", getattr(e, "stderr", "") or "")
        ctx.event("error", {"where": "selftest_singlefile.doctor", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 66

    # Weird-place: workspace roots with spaces must work (quoting/cwd/root parsing).
    ws_space = tmp_base / "workspace with spaces"
    ws_space.mkdir(parents=True, exist_ok=True)
    (ws_space / "sandworm_core").mkdir(parents=True, exist_ok=True)
    (ws_space / "sandworm_core" / "__init__.py").write_text(
        'raise RuntimeError("workspace sandworm_core was imported (expected embedded core)")\n', encoding="utf-8"
    )
    try:
        proc_space = subprocess.run(
            [str(out), "--root", str(ws_space), "doctor", "--json"],
            cwd=str(ws_space),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
        ctx.write_file("steps/selftest-singlefile/logs/doctor-spaces-stdout.txt", proc_space.stdout)
        ctx.write_file("steps/selftest-singlefile/logs/doctor-spaces-stderr.txt", proc_space.stderr)
        ctx.event("singlefile_doctor_spaces", {"exit_code": proc_space.returncode}, step="selftest-singlefile")
        if proc_space.returncode != 0:
            ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
            return 69
    except subprocess.TimeoutExpired as e:
        ctx.write_file("steps/selftest-singlefile/logs/doctor-spaces-stdout.txt", getattr(e, "stdout", "") or "")
        ctx.write_file("steps/selftest-singlefile/logs/doctor-spaces-stderr.txt", getattr(e, "stderr", "") or "")
        ctx.event("error", {"where": "selftest_singlefile.doctor_spaces", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 70

    # Weird-place: concurrent first-run extraction into the same cache dir should not race or corrupt.
    ws_conc = tmp_base / "workspace-concurrent"
    ws_conc.mkdir(parents=True, exist_ok=True)
    (ws_conc / "sandworm_core").mkdir(parents=True, exist_ok=True)
    (ws_conc / "sandworm_core" / "__init__.py").write_text(
        'raise RuntimeError("workspace sandworm_core was imported (expected embedded core)")\n', encoding="utf-8"
    )
    p1 = subprocess.Popen(
        [str(out), "--root", str(ws_conc), "doctor", "--json"],
        cwd=str(ws_conc),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    p2 = subprocess.Popen(
        [str(out), "--root", str(ws_conc), "doctor", "--json"],
        cwd=str(ws_conc),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )
    try:
        out1, err1 = p1.communicate(timeout=timeout_s)
        out2, err2 = p2.communicate(timeout=timeout_s)
    except subprocess.TimeoutExpired:
        p1.kill()
        p2.kill()
        ctx.event("error", {"where": "selftest_singlefile.doctor_concurrent", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 71
    ctx.write_file("steps/selftest-singlefile/logs/doctor-concurrent-1-stdout.txt", out1 or "")
    ctx.write_file("steps/selftest-singlefile/logs/doctor-concurrent-1-stderr.txt", err1 or "")
    ctx.write_file("steps/selftest-singlefile/logs/doctor-concurrent-2-stdout.txt", out2 or "")
    ctx.write_file("steps/selftest-singlefile/logs/doctor-concurrent-2-stderr.txt", err2 or "")
    ctx.event(
        "singlefile_doctor_concurrent",
        {"exit_code_1": p1.returncode, "exit_code_2": p2.returncode},
        step="selftest-singlefile",
    )
    if p1.returncode != 0 or p2.returncode != 0:
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 72

    # Self-rebuild inside a fresh root (no prior control plane).
    ws2 = tmp_base / "workspace2"
    ws2.mkdir(parents=True, exist_ok=True)
    (ws2 / "dist").mkdir(parents=True, exist_ok=True)
    out2 = ws2 / "dist" / "sandworm"

    try:
        proc2 = subprocess.run(
            [str(out), "--root", str(ws2), "build", "singlefile", "--out", str(out2)],
            cwd=str(ws2),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
        ctx.write_file("steps/selftest-singlefile/logs/rebuild-stdout.txt", proc2.stdout)
        ctx.write_file("steps/selftest-singlefile/logs/rebuild-stderr.txt", proc2.stderr)
        ctx.event("singlefile_rebuild", {"exit_code": proc2.returncode, "out": str(out2)}, step="selftest-singlefile")
        if proc2.returncode != 0 or not out2.exists():
            ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
            return 64
    except subprocess.TimeoutExpired as e:
        ctx.write_file("steps/selftest-singlefile/logs/rebuild-stdout.txt", getattr(e, "stdout", "") or "")
        ctx.write_file("steps/selftest-singlefile/logs/rebuild-stderr.txt", getattr(e, "stderr", "") or "")
        ctx.event("error", {"where": "selftest_singlefile.rebuild", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 67

    try:
        proc3 = subprocess.run(
            [str(out2), "--root", str(ws2), "doctor", "--json"],
            cwd=str(ws2),
            capture_output=True,
            text=True,
            timeout=timeout_s,
            env=env,
        )
        ctx.write_file("steps/selftest-singlefile/logs/rebuilt-doctor-stdout.txt", proc3.stdout)
        ctx.write_file("steps/selftest-singlefile/logs/rebuilt-doctor-stderr.txt", proc3.stderr)
        ctx.event("singlefile_rebuilt_doctor", {"exit_code": proc3.returncode}, step="selftest-singlefile")
        if proc3.returncode != 0:
            ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
            return 65
    except subprocess.TimeoutExpired as e:
        ctx.write_file("steps/selftest-singlefile/logs/rebuilt-doctor-stdout.txt", getattr(e, "stdout", "") or "")
        ctx.write_file("steps/selftest-singlefile/logs/rebuilt-doctor-stderr.txt", getattr(e, "stderr", "") or "")
        ctx.event("error", {"where": "selftest_singlefile.rebuilt_doctor", "error": f"timed out after {timeout_s}s"})
        ctx.event("selftest_end", {"status": "fail", "mode": "singlefile"}, step="selftest-singlefile")
        return 68

    ctx.event("selftest_end", {"status": "ok", "mode": "singlefile"}, step="selftest-singlefile")
    return 0


