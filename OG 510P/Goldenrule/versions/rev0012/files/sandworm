from __future__ import annotations

from dataclasses import dataclass
from typing import Any


@dataclass(frozen=True)
class JsonGetResult:
    ok: bool
    value: object | None
    error: str | None


def json_get(doc: object, key: str) -> JsonGetResult:
    """
    Retrieve a nested value from a JSON-ish Python object using a simple dotted path.

    - Dict keys: "a.b.c"
    - List indexes: "items.0.name" (numeric segments index lists)

    This is intentionally minimal and stable for tests; it is not JSONPath.
    """
    key = (key or "").strip()
    if not key:
        return JsonGetResult(ok=False, value=None, error="missing --key")

    cur: Any = doc
    for seg in key.split("."):
        seg = seg.strip()
        if not seg:
            return JsonGetResult(ok=False, value=None, error=f"invalid key segment in {key!r}")

        if isinstance(cur, list) and seg.isdigit():
            i = int(seg)
            if i < 0 or i >= len(cur):
                return JsonGetResult(ok=False, value=None, error=f"index out of range at segment {seg!r}")
            cur = cur[i]
            continue

        if isinstance(cur, dict):
            if seg not in cur:
                return JsonGetResult(ok=False, value=None, error=f"missing key at segment {seg!r}")
            cur = cur[seg]
            continue

        return JsonGetResult(ok=False, value=None, error=f"cannot descend into {type(cur).__name__} at segment {seg!r}")

    return JsonGetResult(ok=True, value=cur, error=None)

