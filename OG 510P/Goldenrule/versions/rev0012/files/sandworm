                "proc_starttime": pst,
                "proc_starttime_match": pst_match,
                "holder_state": holder_state,
            }
            if bool(getattr(args, "json", False)):
                print(json.dumps(payload, indent=2, sort_keys=True))
                return 0
            print(f"runlock: {lock_path}")
            print(f"- held: {held}")
            print(f"- holder_state: {holder_state}")
            if holder:
                print(f"- holder: {json.dumps(holder, sort_keys=True)}")
            if isinstance(pid, int):
                print(f"- pid_alive: {alive}")
                print(f"- pid_probe: {pid_probe}")
            if pst:
                print(f"- proc_starttime: {pst}")
            if pst_match is not None:
                print(f"- proc_starttime_match: {pst_match}")
            return 0

        if args.runlock_cmd == "clear":
            if not lock_path.exists():
                payload = {"ok": True, "cleared": False, "reason": "missing", "lock_path": str(lock_path)}
                if bool(getattr(args, "json", False)):
                    print(json.dumps(payload, indent=2, sort_keys=True))
                    return 0
                print("runlock clear: OK (no lock file present)")
                return 0
            fd = lock_path.open("a+", encoding="utf-8")
            try:
                fcntl.flock(fd.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                payload = {"ok": False, "cleared": False, "reason": "held", "lock_path": str(lock_path), "holder": (holder or None)}
                if bool(getattr(args, "json", False)):
                    print(json.dumps(payload, indent=2, sort_keys=True))
                    return 2
                raise SystemExit(f"runlock clear: lock is held (use: sandworm runlock status). lock={lock_path}")
            try:
                fd.seek(0)
                fd.truncate()
                fd.flush()
            except Exception:
                pass
            finally:
                try:
                    fcntl.flock(fd.fileno(), fcntl.LOCK_UN)
                except Exception:
                    pass
