# Leave margin under Linux's AF_UNIX path cap (typically 108 bytes including NUL).
_UNIX_SOCK_PATH_SAFE_MAX = 100


def _short_socket_root() -> Path:
    override = (os.environ.get("SANDWORM_HOSTD_SOCKET_DIR") or os.environ.get("SW_HOSTD_SOCKET_DIR") or "").strip()
    if override.startswith("/"):
        return Path(override)
    return Path("/tmp/.sandworm-hostd")


def _socket_path_too_long(path: Path) -> bool:
    try:
        return len(os.fsencode(str(path))) >= _UNIX_SOCK_PATH_SAFE_MAX
    except Exception:
        return len(str(path).encode("utf-8", errors="ignore")) >= _UNIX_SOCK_PATH_SAFE_MAX


def _derived_short_socket(root: Path) -> Path:
    try:
        key = str(root.resolve())
    except Exception:
        key = str(root)
    digest = hashlib.sha256(key.encode("utf-8", errors="ignore")).hexdigest()[:24]
    return _short_socket_root() / f"{digest}.sock"


def _read_socket_ref(path: Path) -> Path | None:
    try:
        raw = path.read_text(encoding="utf-8").strip()
    except Exception:
        return None
    if not raw:
        return None
    p = Path(raw)
    if not p.is_absolute():
        return None
    return p


def _host_paths(root: Path) -> dict[str, Path]:
    base = control_dir(root) / "host"
    legacy_socket = base / "hostd.sock"
    socket_ref = base / "hostd.socket-path"
    socket_path = _read_socket_ref(socket_ref)
    if socket_path is None:
        socket_path = _derived_short_socket(root) if _socket_path_too_long(legacy_socket) else legacy_socket
    return {
        "base": base,
        "socket": socket_path,
        "legacy_socket": legacy_socket,
        "socket_ref": socket_ref,
        "pidfile": base / "hostd.pid",
        "audit": base / "audit.jsonl",
        "captures": base / "captures",
        "log": base / "hostd.log",
        "token": base / "hostd.token",
        "token_prev": base / "hostd.token.prev",
        "token_history": base / "hostd.token.history",
    }


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _is_socket_file(path: Path) -> bool:
    try:
        st = path.stat()
        return stat.S_ISSOCK(st.st_mode)
    except Exception:
        return False


