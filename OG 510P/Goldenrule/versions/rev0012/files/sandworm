def _host_probe(
    ctx: RunContext,
    *,
    name: str,
    script: str,
    timeout_s: int | None,
    require_hostd: bool,
) -> dict[str, Any]:
    rc, meta = host_exec(
        ctx.root,
        ["bash", "-lc", script],
        cwd=ctx.root,
        timeout_s=timeout_s,
        capture="always",
        run_dir=ctx.run_dir,
        env=_session_env(name=name),
        tag=f"session_probe:{name}",
        trace_id=ctx.trace_id,
    )
    used_hostd = (meta.get("transport") == "hostd")
    ok = (int(rc) == 0) and (not require_hostd or used_hostd)
    if require_hostd and not used_hostd:
        ctx.warn(f"session probe {name}: required hostd transport but got {meta.get('transport')!r}")
    ctx.event("session_probe", {"name": name, "ok": ok, "exit_code": int(rc), "meta": meta})
    return {"name": name, "ok": ok, "exit_code": int(rc), "meta": meta}


