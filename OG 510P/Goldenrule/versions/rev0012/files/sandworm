from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class LockReadResult:
    ok: bool
    values: dict[str, str]
    error: str | None = None


def _strip_comment(line: str) -> str:
    # TOML comments start with '#'. This is best-effort and does not handle '#' inside quotes.
    if "#" in line:
        return line.split("#", 1)[0]
    return line


def _parse_string_value(raw: str) -> str | None:
    s = raw.strip()
    if not s:
        return None
    if s.startswith('"'):
        # Very small subset: "value"
        try:
            end = s[1:].index('"') + 1
        except ValueError:
            return None
        return s[1:end]
    if s.startswith("'"):
        try:
            end = s[1:].index("'") + 1
        except ValueError:
            return None
        return s[1:end]
    # Accept barewords as a last resort.
    return s.split()[0]


def read_lock_section_strings(root: Path, *, section: str, keys: list[str]) -> LockReadResult:
    """
    Minimal TOML reader for specific string keys under a single section (e.g. [images]).
    Intended for runtime use on hosts where python may not be 3.11+ (no tomllib).
    """
    root = root.resolve()
    lf = root / "sandworm.lock"
    if not lf.exists():
        return LockReadResult(ok=True, values={})
    want = {k: None for k in keys}
    sec = (section or "").strip()
    if not sec:
        return LockReadResult(ok=False, values={}, error="section must be non-empty")

    cur = None
    try:
        for raw in lf.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = _strip_comment(raw).strip()
            if not line:
                continue
            if line.startswith("[") and line.endswith("]") and len(line) > 2:
                cur = line[1:-1].strip()
                continue
            if cur != sec:
                continue
            if "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.strip()
            if k not in want:
                continue
            val = _parse_string_value(v)
            if val is None:
                continue
            val = val.strip()
            if val in ("", "..."):
                continue
            want[k] = val
    except Exception as e:
        return LockReadResult(ok=False, values={}, error=repr(e))

    out: dict[str, str] = {k: v for (k, v) in want.items() if isinstance(v, str) and v}
    return LockReadResult(ok=True, values=out)

