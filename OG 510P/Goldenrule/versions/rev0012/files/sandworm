_sw_wants_help() {
  # Global help is instant (no python/nix bootstrap). Only treat -h/--help as "global"
  # when no subcommand is present. If a subcommand is present (e.g. `sandworm codex --help`),
  # let the real CLI handle it so subcommand help is discoverable.
  local -a argv=("$@")
  local i=0
  local saw_help=0
  while [[ "$i" -lt "${#argv[@]}" ]]; do
    local a="${argv[$i]}"
    if [[ "$a" == "--" ]]; then
      break
    fi
    if [[ "$a" == "--root" ]]; then
      i=$((i + 2))
      continue
    fi
    if [[ "$a" == "--root="* ]]; then
      i=$((i + 1))
      continue
    fi
    if [[ "$a" == "--help" || "$a" == "-h" ]]; then
      saw_help=1
      i=$((i + 1))
      continue
    fi
    # First non-global-option token (subcommand) means this is not global help.
    if [[ "$a" != -* ]]; then
      return 1
    fi
    i=$((i + 1))
  done
  [[ "$saw_help" == "1" ]]
}

