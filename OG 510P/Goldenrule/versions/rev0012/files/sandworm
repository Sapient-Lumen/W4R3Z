    timeout_s: int,
    fast: bool,
    dry_run: bool,
) -> dict[str, Any]:
    """
    Run the strict DEV readiness gate on the host.

    This gives nested DEV sessions a narrow, audited way to trigger the host-grade
    `SW_SMOKE_PROFILE=dev-proof` gate without manual shelling into bare-metal.
    """
    log_path = run_dir / "dev-proof-host.log"
