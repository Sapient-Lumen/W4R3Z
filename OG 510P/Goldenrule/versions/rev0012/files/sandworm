_URL_RE = re.compile(r"(https://[^\s<>\"]+)", re.IGNORECASE)


def _gui_available() -> bool:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return False
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def _find_https_urls(text: str) -> list[str]:
    out: list[str] = []
    for m in _URL_RE.finditer(text):
        u = m.group(1)
        if isinstance(u, str) and u:
            out.append(u)
    # De-dupe while keeping order.
    seen: set[str] = set()
    uniq: list[str] = []
    for u in out:
        if u in seen:
            continue
        seen.add(u)
        uniq.append(u)
    return uniq


def _url_ok(url: str, *, allowed_domains: set[str], open_policy: str = "allowlist") -> bool:
    try:
        p = urlparse(url)
    except Exception:
        return False
    if (p.scheme or "").lower() != "https":
        return False
    host = (p.hostname or "").lower().strip(".")
    if not host:
        return False
    if host in ("localhost",) or host.startswith("127.") or host == "::1":
        return False
    if open_policy == "any":
        return True
    # Exact match or subdomain match.
    for dom in allowed_domains:
        d = dom.lower().strip(".")
        if host == d or host.endswith("." + d):
            return True
    return False


def _xdg_open(url: str) -> bool:
    xdg = shutil.which("xdg-open")
    if not xdg:
        return False
    try:
        # Non-blocking UX: don't make login depend on this.
        subprocess.Popen([xdg, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except Exception:
        return False


def _run_pty_with_url_watch(
    argv: list[str],
    *,
    cwd: Path,
    env: dict[str, str],
    open_mode: str,
    allowed_domains: set[str],
    open_policy: str = "allowlist",
) -> int:
    import pty

    master_fd, slave_fd = pty.openpty()
    opened = False
    tried = False
    buf = ""

    def scan_for_url(data: bytes) -> None:
        nonlocal buf, opened, tried, open_mode
        if open_mode != "on" or opened:
            return
        if not _gui_available():
            open_mode = "off"
            return
        try:
            s = data.decode("utf-8", errors="ignore")
        except Exception:
            s = ""
        if not s:
            return
        buf += s
        if len(buf) > 64 * 1024:
            buf = buf[-32 * 1024 :]
        urls = _find_https_urls(buf)
        if not urls:
            return
        tried = True
        cand = urls[-1]
        if _url_ok(cand, allowed_domains=allowed_domains, open_policy=open_policy):
            if _xdg_open(cand):
                opened = True
        if tried and not opened:
            open_mode = "off"

    proc = subprocess.Popen(argv, cwd=str(cwd), env=env, stdin=slave_fd, stdout=slave_fd, stderr=slave_fd, text=False)
    os.close(slave_fd)

    sel = selectors.DefaultSelector()
    sel.register(master_fd, selectors.EVENT_READ)
    if sys.stdin.isatty():
        sel.register(sys.stdin.fileno(), selectors.EVENT_READ)

    old_term = None
    if sys.stdin.isatty():
        try:
            old_term = termios.tcgetattr(sys.stdin.fileno())
            # Keep signals enabled so Ctrl+C remains usable during interactive login.
            tty.setcbreak(sys.stdin.fileno())
        except Exception:
            old_term = None

    interrupted = False
    try:
        while True:
            if proc.poll() is not None:
                # Drain remaining output.
                try:
                    while True:
                        data = os.read(master_fd, 4096)
                        if not data:
                            break
                        os.write(sys.stdout.fileno(), data)
                        scan_for_url(data)
                except Exception:
                    pass
                break

            events = sel.select(timeout=0.1)
            for key, _mask in events:
                if key.fileobj == master_fd:
                    try:
                        data = os.read(master_fd, 4096)
                    except OSError:
                        data = b""
                    if not data:
                        continue
                    os.write(sys.stdout.fileno(), data)
                    scan_for_url(data)
                else:
                    # stdin -> pty
                    try:
                        data_in = os.read(sys.stdin.fileno(), 4096)
                    except OSError:
                        data_in = b""
                    if not data_in:
                        continue
                    try:
                        os.write(master_fd, data_in)
                    except OSError:
                        pass

        return int(proc.wait())
    except KeyboardInterrupt:
        interrupted = True
        try:
            if proc.poll() is None:
                os.kill(int(proc.pid), signal.SIGINT)
        except Exception:
            pass
        deadline = time.time() + 2.0
        while proc.poll() is None and time.time() < deadline:
            time.sleep(0.05)
        if proc.poll() is None:
            try:
                os.kill(int(proc.pid), signal.SIGTERM)
            except Exception:
                pass
            deadline = time.time() + 2.0
            while proc.poll() is None and time.time() < deadline:
                time.sleep(0.05)
        if proc.poll() is None:
            try:
                os.kill(int(proc.pid), signal.SIGKILL)
            except Exception:
                pass
        try:
            proc.wait(timeout=1.0)
        except Exception:
            pass
        return 130
    finally:
        try:
            sel.close()
        except Exception:
            pass
        try:
            os.close(master_fd)
        except Exception:
            pass
        if old_term is not None:
            try:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_term)
            except Exception:
                pass
        # If the process already exited due Ctrl+C, preserve shell semantics.
        if interrupted and proc.poll() is None:
            try:
                os.kill(int(proc.pid), signal.SIGTERM)
            except Exception:
                pass


def auth_login(
    root: Path,
    *,
    provider: str,
    mode: str,
    posture: str = "safe",
    open_mode: str,
    open_policy: str,
    image: str,
    network: str,
    kvm_instance: str | None = None,
    dry_run: bool,
    fallback: bool = True,
) -> tuple[int, dict[str, object]]:
    root = root.resolve()
    posture_effective = (posture or "safe").strip().lower()
    if posture_effective not in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev"):
        posture_effective = "safe"
    if provider not in AUTH_SPECS:
        raise AuthError(f"unknown provider: {provider!r} (expected one of: {', '.join(sorted(AUTH_SPECS.keys()))})")
    spec = AUTH_SPECS[provider]

    # Provider binaries come from Sandworm-installed clients.
    bin_path = (control_dir(root) / "clients" / "bin" / provider).resolve()
    if not (bin_path.exists() and os.access(bin_path, os.X_OK)):
        raise AuthError(f"provider client not installed: {provider!r} (run: sandworm clients install --all)")

    if spec.login_argv is None:
        if not spec.help_url:
            raise AuthError(f"no built-in OAuth/login flow detected for {provider!r}")

        meta: dict[str, object] = {
            "provider": provider,
            "mode": mode,
            "posture": posture_effective,
            "open": open_mode,
            "open_policy": open_policy,
            "status": ("dry_run" if dry_run else "manual"),
            "help_url": spec.help_url,
        }
        if dry_run:
            return 0, meta
        print(f"{provider}: open this URL to set up credentials:\n  {spec.help_url}", file=sys.stderr)
        if open_mode == "on" and _gui_available() and _url_ok(spec.help_url, allowed_domains=spec.allowed_domains, open_policy=open_policy):
            _xdg_open(spec.help_url)
        return 0, meta

    # Gemini CLI login is interactive; fall back to guidance when no TTY is available.
    force_gemini_cli = os.environ.get("SW_GEMINI_FORCE_CLI", "0") == "1"
    if provider == "gemini" and spec.login_argv == [] and (not sys.stdin.isatty() and not sys.stdout.isatty()) and not force_gemini_cli:
        if not spec.help_url:
            raise AuthError("gemini login requires a TTY or a configured API key")
        meta = {
            "provider": provider,
            "mode": mode,
            "posture": posture_effective,
            "open": open_mode,
            "open_policy": open_policy,
            "status": ("dry_run" if dry_run else "manual"),
            "help_url": spec.help_url,
            "warning": "gemini login requires an interactive TTY; showing API key guidance instead",
        }
        if dry_run:
            return 0, meta
        print(f"{provider}: open this URL to set up credentials:\n  {spec.help_url}", file=sys.stderr)
        return 0, meta

    # Sandworm should never open a browser by default. We keep "auto" only for backwards
    # compatibility but treat it as "off".
    if open_mode not in ("auto", "on", "off"):
        open_mode = "off"
    if open_mode == "auto":
        open_mode = "off"
    if open_policy not in ("allowlist", "any"):
        open_policy = "allowlist"
    if mode not in ("host", "auto", "sandbox", "bwrap", "kvm", "inherited"):
        mode = "sandbox"
    # Host execution is only permitted in explicit bare-metal posture. Otherwise this would
    # violate SAFE-by-default expectations for `sandworm auth ...`.
    if mode == "host" and posture_effective != "bare-metal":
