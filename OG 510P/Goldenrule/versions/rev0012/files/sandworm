    cands: list[Path] = []
    env_seed = os.environ.get("SW_NIX_PORTABLE_SEED_BIN") or os.environ.get("SANDWORM_NIX_PORTABLE_SEED_BIN")
    if isinstance(env_seed, str) and env_seed.strip():
        cands.append(Path(env_seed.strip()))

    try:
        cands.append(Path.cwd() / ".sandworm" / "toolroot" / "bin" / "nix-portable")
    except Exception:
        pass

    cands.append(control_dir(root) / "toolroot" / "bin" / "nix-portable")

    out: list[Path] = []
    seen: set[str] = set()
    try:
        target_resolved = str(target.resolve())
    except Exception:
        target_resolved = str(target)
    for cand in cands:
        try:
            resolved = str(cand.resolve())
        except Exception:
            resolved = str(cand)
        if resolved in seen:
            continue
        seen.add(resolved)
        if resolved == target_resolved:
            continue
        if not cand.exists() or not os.access(str(cand), os.X_OK):
            continue
        out.append(cand)
    return out


def _local_junest_seed_candidates(root: Path, *, target: Path) -> list[Path]:
    """
    Best-effort local seeds for junest when archive download is unavailable.
    """
    cands: list[Path] = []
    env_seed = os.environ.get("SW_JUNEST_SEED_DIR") or os.environ.get("SANDWORM_JUNEST_SEED_DIR")
    if isinstance(env_seed, str) and env_seed.strip():
        cands.append(Path(env_seed.strip()))

    try:
        cands.append(Path.cwd() / ".sandworm" / "toolroot" / "junest")
    except Exception:
        pass

    cands.append(control_dir(root) / "toolroot" / "junest")
    cands.append(Path("/run/sandworm/toolroot/junest"))

    out: list[Path] = []
    seen: set[str] = set()
    try:
        target_resolved = str(target.resolve())
    except Exception:
        target_resolved = str(target)
    for cand in cands:
        try:
            resolved = str(cand.resolve())
        except Exception:
            resolved = str(cand)
        if resolved in seen:
            continue
        seen.add(resolved)
        if resolved == target_resolved:
            continue
        if not cand.exists() or not cand.is_dir():
            continue
        if not (cand / "bin" / "junest").exists():
            continue
        out.append(cand)
    return out


def _junest_seed_claimed_sha256(seed: Path) -> str | None:
    """
    Best-effort provenance claim for local junest seed directories.
    """
    env_sha = os.environ.get("SW_JUNEST_SEED_SHA256") or os.environ.get("SANDWORM_JUNEST_SEED_SHA256")
    if isinstance(env_sha, str):
        s = env_sha.strip().lower()
        if len(s) == 64 and all(c in "0123456789abcdef" for c in s):
            return s
    for p in (
        seed / ".sandworm-junest-sha256",
        seed / "JUNEST_SHA256",
        seed / ".sha256",
    ):
        try:
            txt = p.read_text(encoding="utf-8", errors="replace").strip()
        except Exception:
            continue
        if not txt:
            continue
        tok = txt.split()[0].strip().lower()
        if len(tok) == 64 and all(c in "0123456789abcdef" for c in tok):
            return tok
    return None


def _write_executable(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = None
    tmp_path: Path | None = None
    try:
        fd, tmp_name = tempfile.mkstemp(prefix=path.name + '.tmp.', dir=str(path.parent))
        tmp_path = Path(tmp_name)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            fd = None
            f.write(text)
        try:
            tmp_path.chmod(0o755)
        except Exception:
            pass
        os.replace(str(tmp_path), str(path))
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except Exception:
                pass
        if tmp_path is not None and tmp_path.exists() and tmp_path != path:
            try:
                tmp_path.unlink(missing_ok=True)
            except Exception:
                pass


def _bash_shebang_line() -> str:
    # Toolroot wrappers are executed in multiple substrates (host, bwrap, podman, kvm guests).
    # Hardcoding a host-only bash path (e.g. /run/current-system/sw/bin/bash on NixOS, or an
    # ephemeral /nix/store bash in nix-shell) makes the wrappers fail in other postures.
    #
    # Use /bin/sh as a portable entrypoint. Wrappers that need bash must re-exec into bash
    # themselves (see _nix_wrapper_script/_rg_wrapper_script prelude).
    return "#!/bin/sh"


def _nix_wrapper_script(*, root: Path) -> str:
    return textwrap.dedent(
        """\
        #!/bin/sh
        # Sandworm scripts are bash, but some sandboxes break /usr/bin/env.
        # This prelude re-execs under a real bash and ensures `bash` is in PATH.
        if [ -z "${BASH_VERSION-}" ]; then
          if [ -n "${SANDWORM_BASH-}" ] && [ -x "${SANDWORM_BASH}" ]; then
            _sw_bash="${SANDWORM_BASH}"
            _sw_bash_dir="${_sw_bash%/*}"
            PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
            exec "$_sw_bash" "$0" "$@"
          fi
          for _sw_bash in /usr/bin/bash /bin/bash /usr/local/bin/bash /run/current-system/sw/bin/bash; do
            if [ -x "$_sw_bash" ]; then
              _sw_bash_dir="${_sw_bash%/*}"
              PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
              exec "$_sw_bash" "$0" "$@"
            fi
          done
          for _sw_bash in /nix/store/*bash*/bin/bash; do
            if [ -x "$_sw_bash" ]; then
              _sw_bash_dir="${_sw_bash%/*}"
              PATH="$_sw_bash_dir${PATH:+:$PATH}"; export PATH
              exec "$_sw_bash" "$0" "$@"
            fi
          done
          echo "nix: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
          exit 2
        fi
        set -euo pipefail

        SW_NIX_WRAPPER_BASH="${BASH:-}"
        if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
          for _sw_bash in /run/current-system/sw/bin/bash /usr/bin/bash /bin/bash /usr/local/bin/bash; do
            if [[ -x "$_sw_bash" ]]; then
              SW_NIX_WRAPPER_BASH="$_sw_bash"
              break
            fi
          done
        fi
        if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
          SW_NIX_WRAPPER_BASH="$(command -v bash 2>/dev/null || true)"
        fi
        if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
          for _sw_bash in /nix/store/*bash*/bin/bash; do
            if [[ -x "$_sw_bash" ]]; then
              SW_NIX_WRAPPER_BASH="$_sw_bash"
              break
            fi
          done
        fi
        if [[ -z "${SW_NIX_WRAPPER_BASH}" || ! -x "${SW_NIX_WRAPPER_BASH}" ]]; then
          echo "nix: bash not found (set SANDWORM_BASH=/path/to/bash)" >&2
          exit 2
        fi

        SCRIPT="${BASH_SOURCE[0]:-$0}"
        case "$SCRIPT" in
          */*) SCRIPT_DIR="${SCRIPT%/*}" ;;
          *) SCRIPT_DIR="." ;;
        esac
        SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd -P)"
        export PATH="$SCRIPT_DIR${PATH:+:$PATH}"
        NP_BIN="$SCRIPT_DIR/nix-portable"
        if [[ ! -x "$NP_BIN" ]]; then
          echo "nix: nix-portable missing at $NP_BIN (run: sandworm refresh)" >&2
          exit 2
        fi

        # SSL: nix-portable manages its own internal CA bundle, but some hosts export NIX_SSL_CERT_FILE/CURL_CA_BUNDLE
        # pointing into /nix/store. That can break HTTPS inside nix-portable's wrapped environment. Prefer a CA bundle
        # living next to nix-portable (under --root) and avoid leaking host NIX_SSL_CERT_FILE/CURL_CA_BUNDLE.
        unset NIX_SSL_CERT_FILE CURL_CA_BUNDLE
        ca_local="$SCRIPT_DIR/../nix-portable/ca-certificates.crt"
        if [[ ! -r "$ca_local" ]]; then
          ca_src=""
          if [[ -n "${SW_NIX_SSL_CERT_FILE:-}" ]] && [[ -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
            ca_src="$SW_NIX_SSL_CERT_FILE"
          elif [[ -r "/etc/ssl/certs/ca-certificates.crt" ]]; then
            ca_src="/etc/ssl/certs/ca-certificates.crt"
          elif [[ -r "/etc/pki/tls/certs/ca-bundle.crt" ]]; then
            ca_src="/etc/pki/tls/certs/ca-bundle.crt"
          elif [[ -r "/etc/ssl/certs/ca-bundle.crt" ]]; then
            ca_src="/etc/ssl/certs/ca-bundle.crt"
          fi
          if [[ -n "$ca_src" ]] && command -v cp >/dev/null 2>&1; then
            ca_dir="${ca_local%/*}"
            mkdir -p "$ca_dir" 2>/dev/null || true
            cp "$ca_src" "$ca_local" 2>/dev/null || true
          fi
        fi
        if [[ -r "$ca_local" ]]; then
          export SSL_CERT_FILE="$ca_local"
        elif [[ -n "${SW_NIX_SSL_CERT_FILE:-}" ]] && [[ -r "${SW_NIX_SSL_CERT_FILE:-}" ]]; then
          export SSL_CERT_FILE="$SW_NIX_SSL_CERT_FILE"
        fi

        # nix-portable may try to self-install git and print progress (sometimes to stdout), which can
        # corrupt `nix ... --json` output and can be flaky on first bootstrap. If host git is available,
        # point nix-portable at it to avoid the self-install path.
        if [[ -z "${NP_GIT:-}" ]] && [[ -z "${SANDWORM_BACKEND:-}" ]] && command -v git >/dev/null 2>&1; then
          export NP_GIT="$(command -v git)"
        fi

        _sw_writable_dir() {
          d="${1:-}"
          [[ -n "$d" ]] || return 1
          mkdir -p "$d" >/dev/null 2>&1 || return 1
          [[ -w "$d" ]]
        }

        # nix-portable caches and virtualizes /nix/store under NP_LOCATION.
        # If backend/home hints are missing inside a sandbox, avoid defaulting to
        # /run/sandworm (often mounted read-only for the runtime user).
        if [[ -z "${NP_LOCATION:-}" ]]; then
          host_default="$(cd "$SCRIPT_DIR/../.." && pwd -P)/nix-portable"
          if [[ -n "${SANDWORM_BACKEND:-}" ]]; then
            if [[ -n "${SANDWORM_HOME:-}" ]] && _sw_writable_dir "${SANDWORM_HOME}/.nix-portable"; then
              NP_LOCATION="${SANDWORM_HOME}/.nix-portable"
            elif [[ -w "/run/sandworm/home" ]] && _sw_writable_dir "/run/sandworm/home/.nix-portable"; then
              NP_LOCATION="/run/sandworm/home/.nix-portable"
            elif [[ -n "${HOME:-}" ]] && _sw_writable_dir "${HOME}/.nix-portable"; then
              NP_LOCATION="${HOME}/.nix-portable"
            else
              NP_LOCATION="/tmp/.nix-portable"
            fi
          else
            if _sw_writable_dir "$host_default"; then
              NP_LOCATION="$host_default"
            elif [[ -w "/run/sandworm/home" ]] && _sw_writable_dir "/run/sandworm/home/.nix-portable"; then
              NP_LOCATION="/run/sandworm/home/.nix-portable"
            elif [[ -n "${HOME:-}" ]] && _sw_writable_dir "${HOME}/.nix-portable"; then
              NP_LOCATION="${HOME}/.nix-portable"
            else
              NP_LOCATION="/tmp/.nix-portable"
            fi
          fi
        fi
        export NP_LOCATION

        if [[ "$NP_LOCATION" != /* ]]; then
          echo "nix: NP_LOCATION must be an absolute path (got: $NP_LOCATION)" >&2
          exit 2
        fi
        if ! _sw_writable_dir "$NP_LOCATION"; then
          echo "nix: NP_LOCATION is not writable ($NP_LOCATION); set NP_LOCATION or SANDWORM_HOME to a writable path" >&2
          exit 2
        fi

        # In podman sandboxes, nix-portable's default runtime frequently fails first and may emit errors on stdout.
        # Prefer proot by default (unless explicitly disabled) to keep behavior stable for noob flows and JSON callers.
        SW_NP_RUNTIME_USER_SET=0
        if [[ -n "${NP_RUNTIME:-}" ]]; then
          SW_NP_RUNTIME_USER_SET=1
        fi
        if [[ -z "${NP_RUNTIME:-}" ]] && [[ "${SANDWORM_BACKEND:-}" == "podman" ]]; then
          if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
            export NP_RUNTIME=proot
            if [[ -z "${PROOT_NO_SECCOMP:-}" ]]; then
              export PROOT_NO_SECCOMP=1
            fi
          fi
        fi

        # nix-portable self-initializes under "$NP_LOCATION/.nix-portable" (extracts BusyBox + config).
        # If multiple nix-portable processes start at once against the same NP_LOCATION, the init can race
        # and fail with ETXTBSY ("Text file busy") while rewriting binaries.
        #
        # Important: do NOT hold the init lock for the entire nix command. Some Sandworm helpers run
        # long-lived nix shells (e.g. tiny socket proxies for DBus/ssh-agent), and serializing all nix
        # invocations would wedge unrelated workflows (including provider client selfchecks).
        np_root="$NP_LOCATION/.nix-portable"
        lock="$np_root/.sandworm-init.lock"
        init_done="$np_root/.sandworm-init.done"
        mkdir -p "$np_root" >/dev/null 2>&1 || true

        _sw_sleep() {
          # Best-effort delay without relying on external `sleep` in minimal PATH environments.
          #
          # Uses `read -t` against /dev/zero (works in bash; often works in busybox ash too).
          d="${1:-0}"
          if (read -r -t "$d" _ </dev/zero) 2>/dev/null; then
            :
          else
            :
          fi
        }

        _sw_np_init_once() {
          mkdir -p "$np_root" >/dev/null 2>&1 || true

          # nix-portable extracts embedded files using `unzip`. On some builds, BusyBox's unzip cannot extract
          # the embedded nix binary when invoked with nix-portable's flags. If a host unzip is available,
          # ensure it is preferred inside the nix-portable init PATH (which is later set to busybox/bin).
          unzip_host=""
          if command -v unzip >/dev/null 2>&1; then
            unzip_host="$(command -v unzip)"
          else
            for cand in /run/current-system/sw/bin/unzip /usr/bin/unzip /bin/unzip; do
              if [[ -x "$cand" ]]; then
                unzip_host="$cand"
                break
              fi
            done
          fi
          if [[ -n "$unzip_host" ]]; then
            mkdir -p "$np_root/busybox/bin" >/dev/null 2>&1 || true
            if [[ ! -e "$np_root/busybox/bin/unzip" ]]; then
              ln -s "$unzip_host" "$np_root/busybox/bin/unzip" >/dev/null 2>&1 || true
            fi
          fi

          # nix-portable's bwrap/proot runtime can hide the host /usr tree. Many Node/npm-installed binaries
          # use a shebang like `#!/usr/bin/env node`, which then fails with ENOENT inside the runtime unless
          # /usr/bin/env exists. Provide a tiny /usr/bin/env shim inside nix-portable's emptyroot.
          env_shim="$np_root/emptyroot/usr/bin/env"
          if [[ ! -x "$env_shim" ]]; then
            if command -v mkdir >/dev/null 2>&1 && command -v cat >/dev/null 2>&1 && command -v mv >/dev/null 2>&1; then
              env_dir="${env_shim%/*}"
              mkdir -p "$env_dir" >/dev/null 2>&1 || true
              tmp_env="${env_shim}.tmp.$$"
              cat >"$tmp_env" <<'EOF_ENV'
        #!/bin/sh
        set -eu

        # Minimal env(1) for shebang usage inside nix-portable runtimes.
        # Supports: /usr/bin/env <cmd> [args...]
        if [ "$#" -lt 1 ]; then
          exit 0
        fi

        cmd="$1"
        shift || true

        if command -v "$cmd" >/dev/null 2>&1; then
          exec "$cmd" "$@"
        fi
        echo "env: $cmd: No such file or directory" >&2
        exit 127
        EOF_ENV
              chmod +x "$tmp_env" >/dev/null 2>&1 || true
              mv -f "$tmp_env" "$env_shim" >/dev/null 2>&1 || true
            fi
          fi

          # Trigger nix-portable's own one-time extraction/config under the init lock so concurrent cold boots
          # don't race. Do not emit output here (protects callers that expect clean --json output).
          "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix --version >/dev/null 2>&1 || true
          touch "$init_done" >/dev/null 2>&1 || true
        }

        if [[ ! -e "$init_done" ]]; then
          if command -v flock >/dev/null 2>&1; then
            (
              exec 9>"$lock"
              flock -x -w 60 9 >/dev/null 2>&1 || true
              if [[ ! -e "$init_done" ]]; then
                _sw_np_init_once
              fi
            )
          else
            # Best-effort fallback on minimal hosts without flock(1).
            lockd="${lock}.d"
            tries=0
            while ! mkdir "$lockd" >/dev/null 2>&1; do
              tries=$((tries + 1))
              if [[ "$tries" -gt 200 ]]; then
                break
              fi
              _sw_sleep 0.05
            done
            if [[ ! -e "$init_done" ]]; then
              _sw_np_init_once
            fi
            rmdir "$lockd" >/dev/null 2>&1 || true
          fi
        fi

        rand="${RANDOM:-0}"
        tmp_err="${TMPDIR:-/tmp}/sandworm-nix-portable.$$.$rand"
        : >"$tmp_err" 2>/dev/null || tmp_err="/tmp/sandworm-nix-portable.$$.$rand"
        rc="0"
        txt_busy_retry=0
        while true; do
          : >"$tmp_err" 2>/dev/null || true
          set +e
          "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@" 2>"$tmp_err"
          rc="$?"
          set -e
          if [[ "$rc" == "0" ]]; then
            break
          fi
          err_txt_try=""
          if [[ -r "$tmp_err" ]]; then
            err_txt_try="$(<"$tmp_err")"
          fi
          if [[ "$err_txt_try" == *"Text file busy"* ]] || [[ "$err_txt_try" == *"bad interpreter: Text file busy"* ]]; then
            txt_busy_retry=$((txt_busy_retry + 1))
            if [[ "$txt_busy_retry" -le 6 ]]; then
              case "$txt_busy_retry" in
                1) _sw_sleep 0.25 ;;
                2) _sw_sleep 0.5 ;;
                3) _sw_sleep 1 ;;
                4) _sw_sleep 2 ;;
                5) _sw_sleep 4 ;;
                *) _sw_sleep 6 ;;
              esac
              continue
            fi
          fi
          break
        done
        if [[ "$rc" != "0" ]]; then
          err_txt=""
          if [[ -r "$tmp_err" ]]; then
            err_txt="$(<"$tmp_err")"
          fi
          # Propagate nix/nix-portable errors. (stdout stays clean for callers that parse it.)
          if [[ -n "$err_txt" ]]; then
            printf '%s' "$err_txt" >&2
            echo >&2
          fi
          if [[ "${SW_NP_RUNTIME_USER_SET:-0}" != "1" ]]; then
          allow_proot=1
          if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" = "1" ] || [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" = "1" ]; then
            allow_proot=0
          fi
          runtime_now="${NP_RUNTIME:-}"
          if [[ -z "$err_txt" ]]; then
            if [[ "$runtime_now" == "proot" ]]; then
              echo "nix: nix-portable failed without stderr detail in runtime=proot; retrying with NP_RUNTIME=nix" >&2
              set +e
              NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
              rc2="$?"
              set -e
              if [[ "$rc2" == "0" ]]; then
                if command -v rm >/dev/null 2>&1; then
                  rm -f "$tmp_err" >/dev/null 2>&1 || true
                fi
                exit 0
              fi
              exit "$rc2"
            fi
            if [[ "$allow_proot" == "1" ]]; then
              echo "nix: nix-portable failed without stderr detail; retrying with NP_RUNTIME=proot" >&2
              # Some nix-portable failures are emitted on stdout only; prefer a resilient runtime fallback.
              NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            fi
            echo "nix: nix-portable failed without stderr detail; retrying with NP_RUNTIME=nix" >&2
            set +e
            NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            rc2="$?"
            set -e
            if [[ "$rc2" == "0" ]]; then
              if command -v rm >/dev/null 2>&1; then
                rm -f "$tmp_err" >/dev/null 2>&1 || true
              fi
              exit 0
            fi
            exit "$rc2"
          fi
          if [[ "$err_txt" == *"private mount namespace"* && "$err_txt" == *"Operation not permitted"* ]] || [[ "$err_txt" == *"/proc/self/setgroups"* && "$err_txt" == *"Operation not permitted"* ]] || [[ "$err_txt" == *"bwrap: setting up uid map: Permission denied"* ]] || [[ "$err_txt" == *"No permissions to create new namespace"* ]] || [[ "$err_txt" == *"bwrap: Creating new namespace failed"* && "$err_txt" == *"Operation not permitted"* ]]; then
            echo "nix: nix-portable failed with namespace restrictions; retrying with NP_RUNTIME=nix" >&2
            set +e
            NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            rc2="$?"
            set -e
            if [[ "$rc2" == "0" ]]; then
              if command -v rm >/dev/null 2>&1; then
                rm -f "$tmp_err" >/dev/null 2>&1 || true
              fi
              exit 0
            fi
            if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
              echo "nix: nix-portable runtime=nix failed; retrying with NP_RUNTIME=proot" >&2
              # PRoot seccomp support can be missing on some kernels; disable PRoot seccomp to reduce false negatives.
              NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            fi
            exit "$rc2"
          elif [[ "$err_txt" == *"suspicious ownership or permission on '/nix/store/"* ]] || [[ "$err_txt" == *"rejecting this build output"* && "$err_txt" == *"/nix/store/"* ]]; then
            echo "nix: detected Nix store ownership/permission rejection under NP_LOCATION=$NP_LOCATION" >&2
            echo "nix: try clearing the local nix-portable store and retrying (or set NP_LOCATION to a fresh writable path)." >&2
            echo "nix: suggested cleanup: rm -rf \"$NP_LOCATION\"/.nix-portable" >&2
            if [ "${SW_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ] && [ "${SANDWORM_NIX_PORTABLE_DISABLE_PROOT:-0}" != "1" ]; then
              echo "nix: retrying with NP_RUNTIME=proot after ownership/permission rejection" >&2
              NP_RUNTIME=proot PROOT_NO_SECCOMP=1 exec "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            fi
            echo "nix: proot retry disabled; retrying with NP_RUNTIME=nix" >&2
            set +e
            NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
            rc2="$?"
            set -e
            if [[ "$rc2" == "0" ]]; then
              if command -v rm >/dev/null 2>&1; then
                rm -f "$tmp_err" >/dev/null 2>&1 || true
              fi
              exit 0
            fi
            exit "$rc2"
          elif [[ "$err_txt" == *"Fatal error: nix is unable to build packages"* ]] || [[ "$err_txt" == *"fatal error: nix is unable to build packages"* ]]; then
            if [[ "$runtime_now" == "proot" ]]; then
              echo "nix: nix-portable failed to build packages in runtime=proot; retrying with NP_RUNTIME=nix" >&2
              set +e
              NP_RUNTIME=nix "$SW_NIX_WRAPPER_BASH" "$NP_BIN" nix "$@"
              rc2="$?"
              set -e
              if [[ "$rc2" == "0" ]]; then
                if command -v rm >/dev/null 2>&1; then
                  rm -f "$tmp_err" >/dev/null 2>&1 || true
                fi
                exit 0
              fi
              exit "$rc2"
            fi
            if [[ "$allow_proot" == "1" ]]; then
              echo "nix: nix-portable failed to build packages in default runtime; retrying with NP_RUNTIME=proot" >&2
              # PRoot seccomp support can be missing on some kernels; disable PRoot seccomp to reduce false negatives.
