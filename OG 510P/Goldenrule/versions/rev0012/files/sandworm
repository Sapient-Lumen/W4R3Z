def _backup_if_exists(*, root: Path, path: Path) -> None:
    if not path.exists():
        return
    backup_root = (control_dir(root) / "backups").resolve()
    backup_root.mkdir(parents=True, exist_ok=True)
    try:
        rel = path.resolve().relative_to(root.resolve())
        bak = backup_root / rel.parent / f"{rel.name}.bak.{_ts()}"
    except Exception:
        bak = backup_root / f"{path.name}.bak.{_ts()}"
    bak.parent.mkdir(parents=True, exist_ok=True)
    try:
        shutil.copy2(path, bak)
    except Exception:
        try:
            bak.write_bytes(path.read_bytes())
        except Exception:
            pass


def _write_file(*, root: Path, path: Path, content: str, mode: int, force: bool, quiet: bool) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and not force:
        if not quiet:
            print(f"• Keeping existing: {path}")
        return
    if force and path.exists():
        _backup_if_exists(root=root, path=path)
    path.write_text(content, encoding="utf-8")
    try:
        os.chmod(path, mode)
    except Exception:
        pass
    if not quiet:
        print(f"• Wrote: {path}")


