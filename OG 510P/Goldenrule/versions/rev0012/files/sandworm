def plan_state_reinstall(*, root: Path, preserve: str, rebuild: str, dry_run: bool) -> StateReinstallPlan:
    if preserve not in ("none", "auth", "auth-sessions"):
        raise StateReinstallError(f"unsupported preserve mode: {preserve!r}")
    if rebuild not in ("off", "auto", "strict"):
        raise StateReinstallError(f"unsupported rebuild mode: {rebuild!r}")
    selected = control_dir(root)
    exists = selected.exists()
    if exists and selected.is_dir():
        try:
            top = sorted({p.name for p in selected.iterdir() if p.name not in (".", "..")})
        except Exception:
            top = []
    else:
        top = []
    keep_relpaths = [] if preserve == "none" else _collect_preserve_relpaths(selected, preserve)
    target = sorted(
        {
            "CONTROL_PLANE_DO_NOT_TOUCH",
            "artifacts",
            "bin",
            "clients",
            "home",
            "locks",
            "runs",
            "tmp",
            "toolroot",
            "state-backups",
        }
    )
    return StateReinstallPlan(
        root=str(root.resolve()),
        selected_control_dir=str(selected),
        preserve=preserve,
        rebuild=rebuild,
        keep_relpaths=keep_relpaths,
        destroy_top_level=top,
        target_top_level_after_rebuild=target,
        dry_run=bool(dry_run),
    )


def execute_state_reinstall(
    *,
    root: Path,
    preserve: str,
    rebuild: str,
    dry_run: bool,
    artifact_path: Path | None = None,
) -> dict[str, object]:
    plan = plan_state_reinstall(root=root, preserve=preserve, rebuild=rebuild, dry_run=dry_run)
    selected = Path(plan.selected_control_dir)
    if selected.exists():
        if not selected.is_dir():
            raise StateReinstallError(f"selected control plane is not a directory: {selected}")
        if plan.destroy_top_level:
            require_control_plane_marker(selected)
    payload: dict[str, object] = {
        "ok": True,
        "plan": {
            "root": plan.root,
            "selected_control_dir": plan.selected_control_dir,
            "preserve": plan.preserve,
            "rebuild": plan.rebuild,
            "keep_relpaths": list(plan.keep_relpaths),
            "destroy_top_level": list(plan.destroy_top_level),
            "target_top_level_after_rebuild": list(plan.target_top_level_after_rebuild),
            "dry_run": bool(plan.dry_run),
        },
    }

    if dry_run:
        out = (artifact_path or _artifact_path(root)).resolve()
        payload["artifact"] = str(out)
        out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return payload

    stage_dir_path: Path | None = None
    stage_tmp = tempfile.mkdtemp(prefix="sandworm-reinstall-preserve.")
    stage_dir_path = Path(stage_tmp).resolve()
    try:
        preserved: list[str] = []
        for rel in plan.keep_relpaths:
            _copy_relpath(selected, stage_dir_path, rel)
            preserved.append(rel)
        payload["preserved"] = preserved

        _remove_selected_control_plane(selected)
        selected.mkdir(parents=True, exist_ok=True)
        ensure_control_plane(root)

        restored: list[str] = []
        for rel in preserved:
            _copy_relpath(stage_dir_path, selected, rel)
            restored.append(rel)
        payload["restored"] = restored

        rebuild_payload, rebuild_failed = _attempt_rebuild(root, rebuild_mode=rebuild)
        payload["rebuild"] = rebuild_payload
        if rebuild == "strict" and rebuild_failed:
            payload["ok"] = False
            payload["error"] = "strict rebuild failed"
    finally:
        if stage_dir_path is not None:
            shutil.rmtree(stage_dir_path, ignore_errors=True)

    out = (artifact_path or _artifact_path(root)).resolve()
    payload["artifact"] = str(out)
    out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return payload
