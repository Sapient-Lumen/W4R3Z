def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _looks_like_sandworm_singlefile(path: Path) -> bool:
    try:
        # Scan a larger header slice: the loader-embedded help text can exceed 4KB.
        head = path.read_text(encoding="utf-8", errors="ignore")[:131072]
    except Exception:
        return False
    if not head.lstrip().startswith("#!"):
        return False
    # Heuristic shape check: require payload markers and a distinctive loader behavior marker.
    # Keep this tolerant of banner/header changes (including large ASCII art).
    if 'PAYLOAD_SHA256="' not in head:
        return False
    if 'PAYLOAD_EXT="tar"' not in head:
        return False
    if "_sw_extract_payload()" not in head:
        return False
    # Prefer explicit format markers; fall back to legacy marker.
    if 'PAYLOAD_FORMAT="files"' in head or 'PAYLOAD_FORMAT="b64tar"' in head:
        return True
    if "__SW_PAYLOAD_B64_BELOW__" in head:
        return True
    return False


def _read_prove_meta(path: Path) -> dict[str, object] | None:
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def promote(
    *,
    root: Path,
    candidate: Path,
    target: Path,
    proof_json: Path | None,
    force: bool,
