def _install_cmd(manager: str, pkgs: list[str]) -> str:
    q = " ".join(shlex.quote(p) for p in pkgs if p)
    mgr = str(manager).strip().lower()
    if mgr == "apt":
        return f"sudo apt-get install -y --no-install-recommends {q}"
    if mgr == "dnf":
        return f"sudo dnf install -y {q}"
    if mgr == "yum":
        return f"sudo yum install -y {q}"
    if mgr == "pacman":
        return f"sudo pacman -S --needed --noconfirm {q}"
    if mgr == "zypper":
        return f"sudo zypper --non-interactive install --no-recommends {q}"
    if mgr == "apk":
        return f"sudo apk add {q}"
    raise ValueError(f"unsupported package manager: {manager!r}")


