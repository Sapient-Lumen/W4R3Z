def _prepend_path_entries(path_value: str | None, entries: list[str]) -> str:
    """
    Prepend PATH entries while preserving order and de-duplicating segments.
    """
    current = [p for p in str(path_value or "").split(":") if p]
    out: list[str] = []
    seen: set[str] = set()
    for p in [*entries, *current]:
        if not p:
            continue
        if p in seen:
            continue
        out.append(p)
        seen.add(p)
    return ":".join(out)


def _control_plane_observed_populated() -> bool:
    cp = Path("/workspace/.sandworm")
    try:
        if not (cp.exists() and cp.is_dir()):
            return False
        entries = [p.name for p in cp.iterdir() if p.name not in (".", "..")]
        non_private = [n for n in entries if n != "private"]
        if not non_private:
            return False
        try:
            mi = Path("/proc/self/mountinfo")
            if mi.exists():
                for line in mi.read_text(encoding="utf-8", errors="replace").splitlines():
                    if " - " not in line:
                        continue
                    pre, _post = line.split(" - ", 1)
                    fields = pre.split()
                    if len(fields) < 5:
                        continue
                    if fields[4] != "/workspace/.sandworm":
                        continue
                    mount_root = fields[3]
                    if "/.sandworm/tmp/podman-mask/" in mount_root or "/.sandworm/mask-empty" in mount_root:
                        return False
                    break
        except Exception:
            pass
        return True
    except Exception:
        return False

