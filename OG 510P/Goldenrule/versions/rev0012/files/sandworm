def run_with_timeout_killpg(
    argv: list[str],
    *,
    env: dict[str, str],
    timeout_s: int,
) -> tuple[int, str, str, bool]:
    """
    Run a subprocess with a hard timeout and kill the full process group on timeout.

    Returns: (rc, stdout, stderr, timed_out)
    """
    p = subprocess.Popen(
        argv,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,
    )
    try:
        out, err = p.communicate(timeout=max(1, int(timeout_s)))
        return int(p.returncode), str(out or ""), str(err or ""), False
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except Exception:
            try:
                p.terminate()
            except Exception:
                pass
        try:
            out, err = p.communicate(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass
            out, err = p.communicate(timeout=2)
        return 124, str(out or ""), str(err or ""), True


def probe_exec_health(
    argv: list[str],
    *,
    env: dict[str, str],
    timeout_s: int = 6,
) -> dict[str, object]:
    """
    Best-effort executable health probe with bounded runtime.

    Distinguishes absent/not-executable/timeout/runtime-failure so callers can
    avoid collapsing "binary exists" and "binary usable" into one signal.
    """
    target = str(argv[0]) if argv else ""
    out: dict[str, object] = {
        "attempted": False,
        "path": target,
        "exists": False,
        "executable": False,
        "ok": False,
        "rc": None,
        "reason_code": "not_attempted",
        "stderr": "",
    }
    if not target:
        out["reason_code"] = "invalid_argv"
        return out
    p = Path(target)
    out["exists"] = p.exists()
    out["executable"] = os.access(target, os.X_OK)
    if not out["exists"]:
        out["reason_code"] = "missing"
        return out
    if not out["executable"]:
        out["reason_code"] = "not_executable"
        return out
    out["attempted"] = True
    try:
        rc, stdout, stderr, timed_out = run_with_timeout_killpg(argv, env=env, timeout_s=max(1, int(timeout_s)))
        msg = _merge_output(stderr, stdout)
        out["rc"] = int(rc)
        out["stderr"] = msg[:2000]
        if timed_out:
            out["reason_code"] = "timeout"
            return out
        out["ok"] = (int(rc) == 0)
        out["reason_code"] = ("ok" if int(rc) == 0 else "runtime_failed")
        return out
    except Exception as e:
        out["reason_code"] = "exception"
        out["stderr"] = str(e)[:2000]
        return out


def collect_dev_shell_diagnostics(
    root: Path,
    *,
    flake_ref: str,
