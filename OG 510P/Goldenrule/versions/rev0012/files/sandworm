# │  /host                         Host root (TAKE-THE-WHEEL only)                       │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ STATE & ARTIFACTS                                                                   │
# ├─────────────────────────────────────────────────────────────────────────────────────┤
# │  .sandworm/                    Project-local control plane root                      │
# │  .sandworm/home/               Default managed HOME                                  │
# │  .sandworm/home.NAME/          Named creds profile (--creds NAME)                    │
# │  .sandworm/runs/<runid>/       Run artifacts (events.jsonl, report.md, logs)        │
# │  .sandworm/toolroot/           nix-portable + toolchain artifacts                    │
# │  .sandworm/clients/            Installed provider CLIs                               │
# │  sandworm.lock                 Pins for strict/offline and reproducibility           │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ HIGH-LEVERAGE ENV KNOBS                                                             │
# ├─────────────────────────────────────────────────────────────────────────────────────┤
# │  SW_BOOTSTRAP_PROGRESS=1      Show bootstrap progress                               │
# │  SW_OFFLINE=1                 Fail if network would be required                      │
# │  SW_STRICT_SUPPLYCHAIN=1      Require pinned/provable dependencies                  │
# │  SW_REDACT_LOGS=0             Disable log redaction (debug only)                    │
# │  SANDWORM_ROOT=/path          Override root detection                               │
# └─────────────────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────────────────┐
# │ REQUIREMENTS                                                                        │
# ├─────────────────────────────────────────────────────────────────────────────────────┤
# │  Required:  bash (4.0+), Linux (x86_64), basic coreutils                            │
# │  Bootstrap: curl/wget (nix-portable fetch), tar, sha256sum/shasum                   │
# │  Sandbox:   podman (preferred), or bwrap, or KVM/QEMU                               │
# │  Optional:  python3 (faster core), ca-certificates (TLS sanity)                     │
# └─────────────────────────────────────────────────────────────────────────────────────┘
