class RefreshResult:
    lockfile: str | None
    nix_portable_path: str | None
    junest_path: str | None
    junest_home: str | None
    changed: bool
    updated_lockfile: bool
    installed_manifest: str | None


def refresh_toolroot(root: Path, *, update: bool, force: bool) -> RefreshResult:
    if state_root_readonly(root):
        raise ToolrootError("toolroot refresh refused: state root is read-only")
    control_plane = control_dir(root) / "CONTROL_PLANE_DO_NOT_TOUCH"
    if not control_plane.exists():
        raise ToolrootError("refresh must be run on the host workspace (control plane not found)")

    # Ensure lightweight utility shims exist under toolroot/bin for sandboxes that run with a tiny PATH.
    # Many wrapper scripts use `dirname` to locate adjacent files; constrained DEV fallbacks also expect `rg`/`jq`.
    try:
        bin_dir = control_dir(root) / 'toolroot' / 'bin'
        bin_dir.mkdir(parents=True, exist_ok=True)
        nix_shell_shim = bin_dir / 'nix-shell'
        _write_executable(nix_shell_shim, _nix_shell_wrapper_script())
        dirname_shim = bin_dir / 'dirname'
        _write_executable(dirname_shim, _dirname_wrapper_script())
        rg_shim = bin_dir / 'rg'
        _write_executable(rg_shim, _rg_wrapper_script())
        jq_shim = bin_dir / 'jq'
        _write_executable(jq_shim, _jq_wrapper_script())
        git_shim = bin_dir / 'git'
        _write_executable(git_shim, _git_wrapper_script(git_attr=_git_attr_from_lockfile(root)))
        apt_shim = bin_dir / 'apt'
        _write_executable(apt_shim, _apt_wrapper_script())
        pgrep_shim = bin_dir / 'pgrep'
        _write_executable(pgrep_shim, _procps_wrapper_script("pgrep"))
        pkill_shim = bin_dir / 'pkill'
        _write_executable(pkill_shim, _procps_wrapper_script("pkill"))
        date_shim = bin_dir / 'date'
        _write_executable(date_shim, _procps_wrapper_script("date"))
    except Exception:
        pass

    strict_supply_chain = _truthy(os.environ.get("SW_STRICT_SUPPLYCHAIN", "0"))

    lock_dir = control_dir(root) / "locks"
    lock_dir.mkdir(parents=True, exist_ok=True)
    lock_path = lock_dir / "toolroot.lock"
    try:
        import fcntl  # unix-only
    except Exception:  # pragma: no cover
        fcntl = None

    with lock_path.open("a+", encoding="utf-8") as lockf:
        if fcntl:
            try:
                fcntl.flock(lockf.fileno(), fcntl.LOCK_EX)
            except Exception:
                pass

        lf = lockfile_path(root)
        lockfile_present = lf.exists()
        doc = None
        url: str | None = None
        sha: str | None = None
        known_good_url: str | None = None
        known_good_sha: str | None = None
        junest_url: str | None = None
        junest_sha: str | None = None
        node_attr = "nixpkgs#nodejs_22"
        updated_lockfile = False

        if lockfile_present:
            try:
                d = load_lockfile_dict(lf)
                toolroot = d.get("toolroot") if isinstance(d, dict) else None
                if isinstance(toolroot, dict):
                    url0 = toolroot.get("nix_portable_url")
                    sha0 = toolroot.get("nix_portable_sha256")
                    if isinstance(url0, str) and url0.strip() not in ("", "..."):
                        url = url0.strip()
                    if isinstance(sha0, str) and sha0.strip() not in ("", "..."):
                        sha = sha0.strip()
                    ju0 = toolroot.get("junest_url")
                    jsha0 = toolroot.get("junest_sha256")
                    if isinstance(ju0, str) and ju0.strip() not in ("", "..."):
                        junest_url = ju0.strip()
                    if isinstance(jsha0, str) and jsha0.strip() not in ("", "..."):
                        junest_sha = jsha0.strip()
                    kg0 = toolroot.get("nix_portable_known_good_url")
                    kgsha0 = toolroot.get("nix_portable_known_good_sha256")
                    if isinstance(kg0, str) and kg0.strip() not in ("", "..."):
                        known_good_url = kg0.strip()
                    if isinstance(kgsha0, str) and kgsha0.strip() not in ("", "..."):
                        known_good_sha = kgsha0.strip()
                clients = d.get("clients") if isinstance(d, dict) else None
                if isinstance(clients, dict):
                    na = clients.get("node_attr")
                    if isinstance(na, str) and na.strip() not in ("", "..."):
                        node_attr = na.strip()
            except LockfileError as e:
                if update:
                    raise ToolrootError(str(e)) from e
        elif strict_supply_chain:
            raise ToolrootError("strict supply chain mode requires sandworm.lock (run `sandworm lock init` then `sandworm refresh --update`)")

        # Junest defaults (small scripts; safe to ship a known-good pin).
        env_ju = os.environ.get("SW_JUNEST_URL") or os.environ.get("SANDWORM_JUNEST_URL")
        env_ju_sha = os.environ.get("SW_JUNEST_SHA256") or os.environ.get("SANDWORM_JUNEST_SHA256")
        if isinstance(env_ju, str) and env_ju.strip():
            junest_url = env_ju.strip()
        if isinstance(env_ju_sha, str) and env_ju_sha.strip():
            junest_sha = env_ju_sha.strip()
        if not junest_url:
            junest_url = "https://github.com/fsquillace/junest/archive/refs/tags/7.4.10.tar.gz"
        if not junest_sha:
            junest_sha = "c73215b701b63361843269dd0bb98ec94983d78fceec7fa8e55467f3a1934369"

        arch = _nix_portable_arch()
        if not url:
            tag = _github_latest_release_tag(owner="DavHau", repo="nix-portable")
            if tag:
                url = f"https://github.com/DavHau/nix-portable/releases/download/{tag}/nix-portable-{arch}"
            else:
                url = f"https://github.com/DavHau/nix-portable/releases/latest/download/nix-portable-{arch}"

        # Floating/latest URLs should resolve to a stable tag URL for download, so "refresh" can notice updates.
        if isinstance(url, str) and url.startswith("https://github.com/DavHau/nix-portable/releases/latest/download/"):
            tag = _github_latest_release_tag(owner="DavHau", repo="nix-portable")
            if tag:
                url = f"https://github.com/DavHau/nix-portable/releases/download/{tag}/nix-portable-{arch}"

        if update:
            if doc is None and lockfile_present:
                try:
                    doc = load_lockfile_doc(lf)
                except LockfileError as e:
                    raise ToolrootError(str(e)) from e
            if doc is None:
                doc = new_lockfile_doc()
                updated_lockfile = True

        if update and isinstance(url, str) and ("release-assets.githubusercontent.com" in url or "/releases/latest/" in url):
            tag = _github_latest_release_tag(owner="DavHau", repo="nix-portable")
            if tag:
                url = f"https://github.com/DavHau/nix-portable/releases/download/{tag}/nix-portable-{arch}"
                if doc is not None:
                    doc["toolroot"]["nix_portable_url"] = url
                    updated_lockfile = True

        # Optional known-good fallback for hotbar resilience.
        env_kg = os.environ.get("SW_NIX_PORTABLE_KNOWN_GOOD_URL") or os.environ.get("SANDWORM_NIX_PORTABLE_KNOWN_GOOD_URL")
        env_kg_sha = os.environ.get("SW_NIX_PORTABLE_KNOWN_GOOD_SHA256") or os.environ.get("SANDWORM_NIX_PORTABLE_KNOWN_GOOD_SHA256")
        if isinstance(env_kg, str) and env_kg.strip():
            known_good_url = env_kg.strip()
        if isinstance(env_kg_sha, str) and env_kg_sha.strip():
            known_good_sha = env_kg_sha.strip()

        url2 = _as_url(url)
        toolroot_dir = control_dir(root) / "toolroot"
        downloads_dir = toolroot_dir / "downloads"
        bin_dir = toolroot_dir / "bin"
        np_bin = bin_dir / "nix-portable"
        nix_wrapper = bin_dir / "nix"
        installed_manifest = toolroot_dir / "installed.json"
        changed = False
        np_sha: str | None = None
        np_url_used: str | None = None
        need_np_download = force or (not np_bin.exists())

        expected_sha: str | None = None
        if sha:
            expected_sha = sha
        if strict_supply_chain and not expected_sha:
            raise ToolrootError(
                "strict supply chain mode requires toolroot.nix_portable_sha256 to be pinned in sandworm.lock "
                "(run `sandworm refresh --update`)"
            )

        if np_bin.exists() and not force:
            have = _sha256_file(np_bin)
            np_sha = have
            np_url_used = str(url)
            want_update = False
            if expected_sha is None and installed_manifest.exists():
                try:
                    cur = json.loads(installed_manifest.read_text(encoding="utf-8"))
                    cur_np = cur.get("nix_portable") if isinstance(cur, dict) else None
                    cur_url = cur_np.get("url") if isinstance(cur_np, dict) else None
                    if isinstance(cur_url, str) and isinstance(url, str) and cur_url.strip() and cur_url.strip() != url.strip():
                        want_update = True
                except Exception:
                    want_update = False
            if expected_sha and have != expected_sha:
                if not update:
                    raise ToolrootError(
                        "toolroot nix-portable sha mismatch vs sandworm.lock "
                        f"(have {have}, want {expected_sha}); rerun with --update to repin"
                    )
                expected_sha = None
            if want_update:
                need_np_download = True
            else:
                if update and doc is not None:
                    doc["toolroot"]["nix_portable_url"] = url
                    doc["toolroot"]["nix_portable_sha256"] = have
                    updated_lockfile = True
                _write_executable(nix_wrapper, _nix_wrapper_script(root=root))
                _write_executable(bin_dir / "node", _node_wrapper_script(node_attr=node_attr))
                pinned = bool(expected_sha and have == expected_sha) or bool(update)
                if not pinned and os.environ.get("SW_SUPPLYCHAIN_QUIET", "0") != "1":
                    print(
                        "WARNING: toolroot nix-portable is unpinned (floating URL/sha). "
                        "Run `sandworm refresh --update` to write a stable URL+sha into sandworm.lock.",
                        file=sys.stderr,
                    )
                # Do not return early: continue to ensure other toolroot artifacts (e.g. junest) are present.

        tmp: Path | None = None
        got_sha: str | None = None
        used_url = str(url)
        seeded_from_local = False
        if need_np_download:
            try:
                tmp, got_sha = _download_to_tmp(url2, parent=downloads_dir)
            except ToolrootError as e:
                for seed in _local_nix_portable_seed_candidates(root, target=np_bin):
                    try:
                        seed_sha = _sha256_file(seed)
                        if expected_sha and seed_sha != expected_sha:
                            continue
                        bin_dir.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(seed, np_bin)
                        try:
                            np_bin.chmod(0o755)
                        except Exception:
                            pass
                        changed = True
                        np_sha = seed_sha
                        np_url_used = f"file://{seed.resolve()}"
                        seeded_from_local = True
                        if update and doc is not None:
                            doc["toolroot"]["nix_portable_url"] = str(url)
                            doc["toolroot"]["nix_portable_sha256"] = seed_sha
                            updated_lockfile = True
                        break
                    except Exception:
                        continue
                if not seeded_from_local:
                    if known_good_url:
                        kg_url2 = _as_url(known_good_url)
                        try:
                            tmp, got_sha = _download_to_tmp(kg_url2, parent=downloads_dir)
                            used_url = str(known_good_url)
                            expected_sha = expected_sha or (known_good_sha.strip() if isinstance(known_good_sha, str) and known_good_sha.strip() else None)
                        except Exception:
                            raise e
                    else:
                        raise e
            if not seeded_from_local:
                if tmp is None or got_sha is None:
                    raise ToolrootError("nix-portable download failed (no artifact)")
                _verify_download_looks_executable(tmp)
                if expected_sha and got_sha != expected_sha:
                    tmp.unlink(missing_ok=True)
                    raise ToolrootError(f"downloaded nix-portable sha mismatch (got {got_sha}, want {expected_sha})")

                if update and doc is not None:
                    doc["toolroot"]["nix_portable_url"] = used_url
                    doc["toolroot"]["nix_portable_sha256"] = got_sha
                    updated_lockfile = True

                bin_dir.mkdir(parents=True, exist_ok=True)
                tmp.replace(np_bin)
                try:
                    np_bin.chmod(0o755)
                except Exception:
                    pass
                changed = True
                np_sha = got_sha
                np_url_used = used_url

        _write_executable(nix_wrapper, _nix_wrapper_script(root=root))
        _write_executable(bin_dir / "node", _node_wrapper_script(node_attr=node_attr))
        _write_executable(bin_dir / "apt", _apt_wrapper_script())

        # Junest: install scripts into toolroot, but keep the heavy JUNEST_HOME runtime under toolroot as well.
        j_url2 = _as_url(str(junest_url))
        junest_base = toolroot_dir / "junest"
        junest_bin = junest_base / "bin" / "junest"
        junest_wrapper = bin_dir / "junest"
        junest_home = toolroot_dir / "junest-home"
        junest_changed = False
        junest_source = "download"
        junest_seed_path: str | None = None
        junest_seed_claimed_sha: str | None = None
        junest_seed_verified = False
        junest_provenance_warning: str | None = None

        if strict_supply_chain and not (isinstance(junest_sha, str) and len(junest_sha) == 64):
            raise ToolrootError(
                "strict supply chain mode requires toolroot.junest_sha256 to be pinned in sandworm.lock "
                "(run `sandworm refresh --update`)"
            )

        need_junest = force or (not junest_bin.exists())
        if not need_junest and installed_manifest.exists():
            try:
                cur = json.loads(installed_manifest.read_text(encoding="utf-8"))
                cur_j = cur.get("junest") if isinstance(cur, dict) else None
