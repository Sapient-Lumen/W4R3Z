    # If the lockdir vanished between mkdir() and write (cross-namespace stale reclaim race),
    # recreate once and continue best-effort without crashing extraction.
    _sw_mkdir -p "$lockdir" >/dev/null 2>&1 || true
    printf '%s %s %s\\n' "$$" "$st" "$pns" > "$lockdir/pid" 2>/dev/null || true
  fi
