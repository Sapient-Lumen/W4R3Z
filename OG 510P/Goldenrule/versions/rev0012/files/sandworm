from __future__ import annotations

from typing import Iterable


def choose_menu(
    *,
    title: str,
    options: list[dict[str, str]],
    subtitle: str | None = None,
    footer: str | None = None,
    initial_id: str | None = None,
) -> tuple[str | None, str | None]:
    """
    Render an interactive curses selector and return (selected_id, error).

    - selected_id is None when user cancels.
    - error is non-None when curses cannot be used.
    """
    if not options:
        return None, "no options"

    try:
        import curses
    except Exception as e:  # pragma: no cover - import error path is environment-specific
        return None, f"curses unavailable: {e}"

    idx = 0
    if isinstance(initial_id, str) and initial_id:
        for i, row in enumerate(options):
            if str(row.get("id") or "") == initial_id:
                idx = i
                break

    state: dict[str, object] = {"selected": None, "error": None}

    def _run(stdscr: "curses._CursesWindow") -> None:
        nonlocal idx
        top = 0
        try:
            curses.curs_set(0)
        except Exception:
            pass
        stdscr.keypad(True)

        while True:
            h, w = stdscr.getmaxyx()
            if h < 8 or w < 40:
                stdscr.erase()
                msg = "terminal too small for rollback TUI (need >= 40x8)"
                stdscr.addnstr(0, 0, msg, max(0, w - 1))
                stdscr.addnstr(1, 0, "resize terminal, or press q to cancel", max(0, w - 1))
                stdscr.refresh()
                ch = stdscr.getch()
                if ch in (ord("q"), ord("Q"), 27):
                    state["selected"] = None
                    return
                continue

            stdscr.erase()
            title_line = str(title or "Rollback Picker")
            stdscr.addnstr(0, 0, title_line, max(0, w - 1), curses.A_BOLD)
            if subtitle:
                stdscr.addnstr(1, 0, str(subtitle), max(0, w - 1))
            help_line = "j/k or arrows: move  Enter: select  q: cancel  g/G: top/bottom"
            stdscr.addnstr(2, 0, help_line, max(0, w - 1), curses.A_DIM)

            start_row = 4
            footer_rows = 1 if footer else 0
            visible = max(1, h - start_row - footer_rows - 1)

            if idx < top:
                top = idx
            if idx >= top + visible:
                top = idx - visible + 1

            for row_idx in range(visible):
                opt_idx = top + row_idx
                if opt_idx >= len(options):
                    break
                row = options[opt_idx]
                label = str(row.get("label") or "")
                detail = str(row.get("detail") or "")
                line = f"{opt_idx + 1:>3}. {label}"
                if detail:
                    line = f"{line} - {detail}"
                attr = curses.A_REVERSE if opt_idx == idx else 0
                stdscr.addnstr(start_row + row_idx, 0, line, max(0, w - 1), attr)

            if footer:
                stdscr.addnstr(h - 1, 0, str(footer), max(0, w - 1), curses.A_DIM)
            stdscr.refresh()

            ch = stdscr.getch()
            if ch in (ord("q"), ord("Q"), 27):
                state["selected"] = None
                return
            if ch in (curses.KEY_UP, ord("k"), ord("K")):
                idx = max(0, idx - 1)
                continue
            if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
                idx = min(len(options) - 1, idx + 1)
                continue
            if ch in (ord("g"),):
                idx = 0
                continue
            if ch in (ord("G"),):
                idx = len(options) - 1
                continue
            if ch in (10, 13, curses.KEY_ENTER):
                state["selected"] = str(options[idx].get("id") or "") or None
                return

    try:
        curses.wrapper(_run)
    except Exception as e:  # pragma: no cover - curses runtime behavior is host-terminal-specific
        return None, f"curses failed: {e}"

    return (state.get("selected") if isinstance(state.get("selected"), str) else None), None
