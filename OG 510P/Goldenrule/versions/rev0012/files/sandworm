def split_top_level(expr: str) -> list[str]:
    out: list[str] = []
    cur: list[str] = []
    depth = 0
    quote = ""
    esc = False
    for ch in expr:
        if quote:
            cur.append(ch)
            if esc:
                esc = False
            elif ch == "\\\\":
                esc = True
            elif ch == quote:
                quote = ""
            continue
        if ch in ("'", '"'):
            quote = ch
            cur.append(ch)
            continue
        if ch in "([":
            depth += 1
            cur.append(ch)
            continue
        if ch in ")]":
            depth = max(0, depth - 1)
            cur.append(ch)
            continue
        if ch == "," and depth == 0:
            part = "".join(cur).strip()
            if part:
                out.append(part)
            cur = []
            continue
        cur.append(ch)
    part = "".join(cur).strip()
    if part:
        out.append(part)
    return out

def strip_outer_parens(expr: str) -> str:
    s = expr.strip()
    while s.startswith("(") and s.endswith(")"):
        depth = 0
        ok = True
        for i, ch in enumerate(s):
            if ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth == 0 and i != len(s) - 1:
                    ok = False
                    break
            if depth < 0:
                ok = False
                break
        if ok and depth == 0:
            s = s[1:-1].strip()
        else:
            break
    return s

def eval_path(expr: str, obj):
    if expr == ".":
        return obj
    if not expr.startswith("."):
        print(f"jq-compat: unsupported filter: {expr}", file=sys.stderr)
        raise SystemExit(2)
    rest = expr[1:]
    part_re = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)|\\[([0-9]+)\\]")
    tokens: list[tuple[str, int | str]] = []
    pos = 0
    while pos < len(rest):
        if rest[pos] == ".":
            pos += 1
            continue
        m = part_re.match(rest, pos)
        if not m:
            print(f"jq-compat: unsupported filter: {expr}", file=sys.stderr)
            raise SystemExit(2)
        if m.group(1) is not None:
            tokens.append(("key", m.group(1)))
        else:
            tokens.append(("idx", int(m.group(2))))
        pos = m.end()
    cur = obj
    for kind, value in tokens:
        if kind == "key":
            if not isinstance(cur, dict) or value not in cur:
                raise SystemExit(1)
            cur = cur[value]
        else:
            if not isinstance(cur, list):
                raise SystemExit(1)
            i = int(value)
            if i < 0 or i >= len(cur):
                raise SystemExit(1)
            cur = cur[i]
    return cur

def eval_expr(expr: str, obj):
    e = strip_outer_parens(expr)
    join_m = re.match(r"^(.*)\\|\\s*join\\((.*)\\)\\s*$", e)
    if join_m:
        left = strip_outer_parens(join_m.group(1))
        sep_token = join_m.group(2).strip()
        try:
            sep = ast.literal_eval(sep_token)
        except Exception:
            print(f"jq-compat: unsupported join separator: {sep_token}", file=sys.stderr)
            raise SystemExit(2)
        if not isinstance(sep, str):
            print(f"jq-compat: unsupported join separator: {sep_token}", file=sys.stderr)
            raise SystemExit(2)
        val = eval_expr(left, obj)
        if not isinstance(val, list):
            raise SystemExit(1)
        return str(sep).join(str(x) for x in val)
    return eval_path(e, obj)

parts = split_top_level(flt)
if not parts:
    print("jq-compat: missing filter expression", file=sys.stderr)
    raise SystemExit(2)

vals = [eval_expr(p, data) for p in parts]
for cur in vals:
    if raw and isinstance(cur, (str, int, float, bool)):
        sys.stdout.write(str(cur))
        if not str(cur).endswith("\\n"):
