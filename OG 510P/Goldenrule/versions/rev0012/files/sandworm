        Best-effort: only require Node when the provider executable appears to be a Node-based CLI.
        This keeps small facility smokes (which stub providers with /bin/sh scripts) lightweight,
        while still producing a high-signal error for real installs that use `#!/usr/bin/env node`.
        """
        try:
            p = control_dir(root) / "clients" / "bin" / name
            if not (p.exists() and os.access(p, os.X_OK)):
                return False
            head = p.read_bytes()[:256]
            if head.startswith(b"\x7fELF"):
                return False
            if head.startswith(b"#!"):
                line = head.splitlines()[0].decode("utf-8", errors="ignore").strip().lower()
                return "node" in line
        except Exception:
            # If we can't inspect, be conservative: require Node (better error message than ENOENT).
            return True
        return False

    if _provider_bin_needs_node(ctx.root, provider) and not _bwrap_node_available(ctx.root):
        raise RuntimeError(
            "bwrap provider execution requires a Node runtime; run `sandworm refresh` to bootstrap the toolroot node shim "
            "or install node on the host (node in PATH or /run/current-system/sw/bin)"
        )

    if not _provider_has_any_creds(ctx.root, provider):
        ctx.warn(
            f"provider {provider}: no stored credentials detected; you may need to run "
            f"`sandworm auth login {provider}` or `sandworm auth set {provider}`"
        )

    argv = [wrapper_in_sandbox]
    if resume_policy in ("always", "resume", "resume-last"):
        argv.append("--resume-last")
        if resume_start:
            argv.append("--resume-start")
    if model_fallbacks is False:
        argv.append("--no-model-fallbacks")

    if tty:
        argv.append("--interactive")

    env: dict[str, str] = {
        "SANDWORM_HOME": "/run/sandworm/home",
        "HOME": "/run/sandworm/home",
        "SANDWORM_CLIENTS_BIN": "/run/sandworm/clients/bin",
        "SANDWORM_CLIENTS_USE_NODE": "1",
        "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
        "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
        "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
    }
    inject_provider_creds_env(ctx.root, provider, env)
    try:
        from .selfdocs import write_self_docs

        write_self_docs(
            ctx.root,
            backend="bwrap",
            posture="safe",
            network_requested=("none" if offline else "host"),
            network_selected=("none" if offline else "host"),
            network_attempts=[{"network": ("none" if offline else "host")}],
            offline=bool(offline),
            strict=None,
            provider=provider,
            provider_mode="sandbox",
            image=None,
            shares=None,
            expose_private=None,
        )
    except Exception:
        pass
    for k in env_allowlist:
        if not isinstance(k, str) or not k:
            continue
        if k in os.environ:
            env[k] = os.environ[k]

    mounts: list[tuple[str, str, str]] = []
    if queuer_dir.exists():
        mounts.append((str(queuer_dir), "/run/sandworm/queuer", "ro"))
    if _provider_dbus_enabled():
        try:
            xdg = os.environ.get("SW_PROVIDER_XDG_RUNTIME_DIR") or os.environ.get("XDG_RUNTIME_DIR")
            addr = os.environ.get("SW_PROVIDER_DBUS_SESSION_BUS_ADDRESS") or os.environ.get("DBUS_SESSION_BUS_ADDRESS")
            mount_set: set[str] = set()

            def _mount_dir(d: Path) -> None:
                if not d.is_absolute() or not d.exists():
                    return
                key = f"{d}"
                if key in mount_set:
                    return
                mounts.append((str(d), str(d), "rw"))
                mount_set.add(key)

            if isinstance(xdg, str) and xdg:
                bus = Path(xdg) / "bus"
                if bus.exists():
                    _mount_dir(Path(xdg))
                    env.setdefault("XDG_RUNTIME_DIR", xdg)
                    if isinstance(addr, str) and addr:
                        env.setdefault("DBUS_SESSION_BUS_ADDRESS", addr)
                    else:
                        env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={bus}")

            if isinstance(addr, str) and addr and "unix:path=" in addr:
                try:
                    p = addr.split("unix:path=", 1)[1].split(",", 1)[0].strip()
                    if p.startswith("/"):
                        sock = Path(p)
                        if sock.exists():
                            _mount_dir(sock.parent)
                            env.setdefault("DBUS_SESSION_BUS_ADDRESS", addr)
                except Exception:
                    pass
        except Exception:
            pass

    if _provider_ssh_agent_enabled():
        try:
            sock = os.environ.get("SW_PROVIDER_SSH_AUTH_SOCK") or os.environ.get("SSH_AUTH_SOCK")
            if isinstance(sock, str) and sock and sock.startswith("/"):
                sp = Path(sock)
                if sp.exists():
                    mounts.append((str(sp.parent), str(sp.parent), "rw"))
                    env.setdefault("SSH_AUTH_SOCK", sock)
        except Exception:
            pass

    t0 = time.time()
    if tty:
        if not os.isatty(0):
            raise RuntimeError("tty-attached provider execution requires a TTY stdin (run from an interactive terminal)")
        # Wrapper reads the prompt from argv when present; avoid piping stdin (Gemini rejects -i when stdin is piped).
        rc = run_bwrap_attached(
            ctx.root,
            [*argv, prompt],
            workdir="/workspace",
            offline=bool(offline),
            mounts=(mounts if mounts else None),
            timeout_s=timeout_s,
            env=env,
        )
        dt_ms = int((time.time() - t0) * 1000)
        ctx.event(
            "provider_exec",
            {
                "provider": provider,
                "status": ("ok" if int(rc) == 0 else "fail"),
                "argv": argv,
                "resume_policy": resume_policy,
                "resume_start": bool(resume_start),
                "model_fallbacks": bool(model_fallbacks),
                "attempt": int(attempt),
                "env_allowlist": env_allowlist,
                "exit_code": int(rc),
                "transport": "bwrap",
                "duration_ms": dt_ms,
                "tty": True,
                "stdout_path": None,
                "stderr_path": None,
            },
            step=step_id,
        )
        return int(rc)

    proc = run_bwrap(
        ctx.root,
        argv,
        workdir="/workspace",
        offline=bool(offline),
        mounts=(mounts if mounts else None),
        timeout_s=timeout_s,
        env=env,
        stdin=prompt,
    )
    dt_ms = int((time.time() - t0) * 1000)
    stdout_path, stderr_path = _write_exec_logs(ctx, step_id, "provider.exec", proc.stdout, proc.stderr)
    ctx.event(
        "provider_exec",
        {
            "provider": provider,
            "status": ("ok" if int(proc.returncode) == 0 else "fail"),
            "argv": argv,
            "resume_policy": resume_policy,
            "resume_start": bool(resume_start),
            "model_fallbacks": bool(model_fallbacks),
            "attempt": int(attempt),
            "env_allowlist": env_allowlist,
            "exit_code": int(proc.returncode),
            "transport": "bwrap",
            "duration_ms": dt_ms,
            "stdout_path": stdout_path,
            "stderr_path": stderr_path,
            "tty": False,
        },
        step=step_id,
    )
    return int(proc.returncode)


def _run_provider_exec_kvm(
    ctx: RunContext,
    step_id: str,
    *,
    provider: str,
    prompt: str,
    resume_policy: str,
    resume_start: bool,
    model_fallbacks: bool,
    env_allowlist: list[str],
    timeout_s: int | None,
    instance: str,
    attempt: int,
) -> int:
    from .kvm import kvm_exec_in_dir, kvm_up

    queuer_dir = control_dir(ctx.root) / "queuer"
    queuer_bin = queuer_dir / "bin" / f"{provider}-queuer"
    wrapper_in_guest = ""
    if queuer_bin.exists() and os.access(queuer_bin, os.X_OK):
        wrapper_in_guest = f"/run/sandworm/queuer/bin/{provider}-queuer"
    else:
        raise RuntimeError(
            f"provider wrapper not found (expected .sandworm/queuer/bin/{provider}-queuer). "
            f"Run `sandworm queuer init`."
        )

    argv = [wrapper_in_guest]
    if resume_policy in ("always", "resume", "resume-last"):
        argv.append("--resume-last")
        if resume_start:
            argv.append("--resume-start")
    if model_fallbacks is False:
        argv.append("--no-model-fallbacks")

    env: dict[str, str] = {
        "SANDWORM_HOME": "/run/sandworm/home",
        "HOME": "/run/sandworm/home",
        "SANDWORM_CLIENTS_BIN": "/run/sandworm/clients/bin",
        "SANDWORM_CLIENTS_USE_NODE": "1",
        "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
        "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
        "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
    }
    inject_provider_creds_env(ctx.root, provider, env)
    try:
        from .selfdocs import write_self_docs

        write_self_docs(
            ctx.root,
            backend="kvm",
            posture="safe",
            network_requested="user",
            network_selected="user",
            network_attempts=[{"network": "user"}],
            offline=False,
            strict=None,
            provider=provider,
            provider_mode="sandbox",
            image=None,
            shares=None,
            expose_private=None,
        )
    except Exception:
        pass
    for k in env_allowlist:
        if not isinstance(k, str) or not k:
            continue
        if k in os.environ:
            env[k] = os.environ[k]

    st = kvm_up(ctx.root, instance=instance, build_image=True, timeout_s=int(timeout_s or 240), reconfigure=True)
    t0 = time.time()
    proc = kvm_exec_in_dir(
        ctx.root,
        argv,
        instance=instance,
        workdir="/workspace",
        timeout_s=timeout_s,
        env=env,
        stdin=prompt,
    )
    dt_ms = int((time.time() - t0) * 1000)
    stdout_path, stderr_path = _write_exec_logs(ctx, step_id, "provider.exec", proc.stdout, proc.stderr)
    ctx.event(
        "provider_exec",
        {
            "provider": provider,
            "status": ("ok" if int(proc.returncode) == 0 else "fail"),
            "argv": argv,
            "resume_policy": resume_policy,
            "resume_start": bool(resume_start),
            "model_fallbacks": bool(model_fallbacks),
            "attempt": int(attempt),
            "env_allowlist": env_allowlist,
            "exit_code": int(proc.returncode),
            "transport": "kvm",
            "duration_ms": dt_ms,
            "stdout_path": stdout_path,
            "stderr_path": stderr_path,
            "kvm": {"instance": instance, "ssh_port": st.port, "accel": st.accel},
        },
        step=step_id,
    )
    return int(proc.returncode)


def _bwrap_node_available(root: Path) -> bool:
    try:
        from .toolroot import ensure_toolroot_node_wrapper

        if ensure_toolroot_node_wrapper(root):
            return True
    except Exception:
        pass
    try:
        if Path("/run/current-system/sw/bin/node").exists():
            return True
    except Exception:
        return False
    try:
        if shutil.which("node"):
            return True
    except Exception:
        return False
    return False


def _provider_has_any_creds(root: Path, provider: str) -> bool:
    name = (provider or "").strip().lower()
    try:
        if name == "gemini":
            from .geminihome import gemini_has_any_creds

            return bool(gemini_has_any_creds(root))
        if name == "claude":
            from .claudehome import claude_has_any_creds

            return bool(claude_has_any_creds(root))
        if name == "codex":
            from .codexhome import codex_has_any_creds

            return bool(codex_has_any_creds(root))
    except Exception:
        return False
    return False


def _run_sandbox_exec(
    ctx: RunContext,
    step_id: str,
    argv: list[str],
    *,
    podman_env: PodmanEnv | None,
    workdir: str,
    image: str,
    network: str,
    podman_network_order: str = "host_first",
    timeout_s: int | None,
    capture: str,
    tag: str,
    backend: str,
    posture: str,
    expose_private: bool,
    shares: list[tuple[str, str, str]] | None,
    kvm_instance: str | None,
    env: dict[str, str] | None = None,
    stdin: str | None = None,
) -> tuple[int, dict[str, object]]:
    t0 = time.time()
    hooks_meta: dict[str, bool] = {"pre_run": False, "post_run": False}
    stdout_path: str | None = None
    stderr_path: str | None = None
    error: str | None = None
    try:
        mounts: list[str] = []
        extra_env: dict[str, str] = {}
        hostd_sock_present = False
        shares_meta = [{"name": str(n), "path": f"/workspace/shared/{n}", "mode": str(m)} for (n, _s, m) in (shares or [])]

        # UNSAFE / TAKE-THE-WHEEL: make host gateway available to the sandbox.
        if posture in ("unsafe", "take-the-wheel"):
            hostd_err: str | None = None
            try:
                from .hostd_ctl import hostd_socket, hostd_start, hostd_token

                hostd_start(ctx.root)
            except Exception as e:
                hostd_err = repr(e)
            sock = hostd_socket(ctx.root)
            hostd_sock_present = sock.exists()
            if backend == "podman" or hostd_sock_present:
                extra_env["SANDWORM_HOSTD_SOCK"] = "/run/sandworm/hostd.sock"
            if hostd_sock_present:
                # podman needs explicit bind mounts; bwrap handles hostd mounting internally.
                if backend == "podman":
                    mounts.append(f"{sock}:/run/sandworm/hostd.sock")
                try:
                    tok = hostd_token(ctx.root)
                    if tok:
                        extra_env["SANDWORM_HOSTD_TOKEN"] = tok
                except Exception:
                    pass
            elif backend == "podman":
                extra = f" (hostd_start error: {hostd_err})" if hostd_err else ""
                ctx.warn(f"step {step_id}: posture={posture} requested host gateway, but hostd socket is missing at {sock}{extra}")

        # TAKE-THE-WHEEL: expose host root at /host (explicitly dangerous).
        if posture == "take-the-wheel":
            if backend == "podman":
                mounts.append("/:/host:rw,rslave")
            extra_env["SANDWORM_TAKE_THE_WHEEL"] = "1"
        # NOTE: We intentionally do NOT mount host root in posture=unsafe.
        # Rootless Podman does not reliably enforce `-v /:/host:ro`, which makes the mount effectively writable
        # (e.g. /host/tmp). In unsafe posture, host access should go through the host gateway socket for auditability.

        if expose_private:
            if backend == "podman":
                mounts.append(f"{control_dir(ctx.root) / 'private'}:/workspace/.sandworm/private:ro")
            extra_env["SANDWORM_EXPOSE_PRIVATE"] = "1"

        # Provide a consistent Sandworm-managed HOME inside sandboxes.
        extra_env.setdefault("SANDWORM_BACKEND", backend)
        extra_env.setdefault("SANDWORM_POSTURE", posture)
        extra_env.setdefault("SANDWORM_HOME", "/run/sandworm/home")
        extra_env.setdefault("HOME", "/run/sandworm/home")
        extra_env.setdefault("XDG_CONFIG_HOME", "/run/sandworm/home/.config")
        extra_env.setdefault("XDG_DATA_HOME", "/run/sandworm/home/.local/share")
        extra_env.setdefault("XDG_CACHE_HOME", "/run/sandworm/home/.cache")

        # Sandbox hooks run inside the sandbox invocation when present.
        try:
            from .hooks import wrap_sandbox_argv_with_hooks

            argv, hooks_meta = wrap_sandbox_argv_with_hooks(
                argv,
                root=ctx.root,
                runid=ctx.runid,
                step_id=step_id,
                backend=backend,
                posture=posture,
                workdir=workdir,
            )
        except Exception:
            hooks_meta = {"pre_run": False, "post_run": False}

        if backend == "kvm":
            if posture != "safe":
                raise RuntimeError("kvm backend only supports posture=safe for now")
            from .kvm import kvm_exec_in_dir, kvm_up

            st = kvm_up(
                ctx.root,
                instance=kvm_instance,
                build_image=True,
                timeout_s=int(timeout_s or 120),
                expose_private=expose_private,
                shares=shares,
                reconfigure=True,
            )
            merged_env = dict(extra_env)
            if env:
                merged_env.update(env)
            proc = kvm_exec_in_dir(
                ctx.root,
                argv,
                instance=kvm_instance,
                workdir=workdir,
                timeout_s=timeout_s,
                env=merged_env,
                stdin=stdin,
            )
            netmeta = {"requested": "user", "selected": "user", "ssh_port": st.port, "accel": st.accel}
        elif backend == "bwrap":
            from .bwrap_backend import run_bwrap

            transport: str | None = None
            if posture in ("unsafe", "take-the-wheel") and hostd_sock_present:
                transport = "hostd"

            merged_env = dict(extra_env)
            if env:
                merged_env.update(env)
            proc = run_bwrap(
                ctx.root,
                argv,
                workdir=workdir,
                offline=(network == "none"),
                unsafe=(posture == "unsafe"),
                take_the_wheel=(posture == "take-the-wheel"),
                timeout_s=timeout_s,
                env=merged_env,
                expose_control_plane=False,
                expose_private=expose_private,
                shares=shares,
                stdin=stdin,
            )
            netmeta = {
                "requested": network,
                "selected": ("none" if network == "none" else "host"),
                "attempts": [{"network": ("none" if network == "none" else "host"), "exit_code": proc.returncode}],
                "transport": transport,
            }
        else:
            if podman_env is None:
                podman_env = ensure_storage(ctx.root)
            try:
                sw_home_host = ensure_sandworm_home(ctx.root)
                mounts.append(f"{sw_home_host}:/run/sandworm/home:rw")
            except Exception:
                pass
            merged_env = dict(extra_env)
            if env:
                merged_env.update(env)
            proc, netmeta = run_with_network_fallback(
                ctx.root,
                argv,
                image=image,
                podman_env=podman_env,
                network=network,
                network_order=podman_network_order,
                workdir=workdir,
                timeout_s=timeout_s,
                mounts=mounts if mounts else None,
                shares=shares,
                env=merged_env if merged_env else None,
                stdin=stdin,
                expose_control_plane=False,
                security_opts=dangerous_posture_security_opts(posture=posture),
            )
        try:
            from .selfdocs import write_self_docs

            attempts = netmeta.get("attempts") if isinstance(netmeta, dict) else None
            selected = netmeta.get("selected") if isinstance(netmeta, dict) else None
            write_self_docs(
                ctx.root,
                backend=backend,
                posture=posture,
                network_requested=network,
                network_selected=(str(selected) if selected else None),
                network_attempts=(attempts if isinstance(attempts, list) else None),
                offline=bool(network == "none"),
                strict=None,
                provider=None,
                provider_mode=None,
                image=(image if backend == "podman" else None),
                shares=shares_meta,
                expose_private=bool(expose_private),
            )
        except Exception:
            pass
    except subprocess.TimeoutExpired as e:
        stdout = (e.stdout or "") if isinstance(e.stdout, str) else ""
        stderr = (e.stderr or "") if isinstance(e.stderr, str) else ""
        stdout_path, stderr_path = _write_exec_logs(ctx, step_id, f"{tag}.timeout", stdout, stderr)
        ctx.event(
            "sandbox_exec",
            {
                "backend": backend,
                "hooks": hooks_meta,
                "argv": argv,
                "cwd": workdir,
                "exit_code": 124,
                "timeout_s": timeout_s,
                "stdout_path": stdout_path,
                "stderr_path": stderr_path,
            },
            step=step_id,
        )
        return 124, {"duration_ms": int((time.time() - t0) * 1000), "stdout_path": stdout_path, "stderr_path": stderr_path, "error": "timeout"}

    dt_ms = int((time.time() - t0) * 1000)

    if capture == "always" or (capture == "onfail" and proc.returncode != 0):
        stdout_path, stderr_path = _write_exec_logs(ctx, step_id, f"{tag}.exec", proc.stdout, proc.stderr)

    ctx.event(
        "sandbox_exec",
        {
            "backend": backend,
            "network": netmeta,
            "hooks": hooks_meta,
            "argv": proc.args,
            "cwd": workdir,
            "exit_code": proc.returncode,
            "duration_ms": dt_ms,
            "stdout_path": stdout_path,
            "stderr_path": stderr_path,
        },
        step=step_id,
    )
    return int(proc.returncode), {
        "duration_ms": dt_ms,
        "stdout_path": stdout_path,
        "stderr_path": stderr_path,
        "error": error,
        "warning": None,
    }


def _collect_artifacts(ctx: RunContext, step_id: str, patterns: list[str]) -> None:
    if not patterns:
        return
    dest_root = ctx.run_dir / "steps" / step_id / "artifacts"
    dest_root.mkdir(parents=True, exist_ok=True)

    for pat in patterns:
        matched = False
        # Deterministic walk over repo files, explicitly pruning control plane/VCS directories.
        # Do not use `Path.rglob("*")`: it can throw PermissionError on rootless Podman storage trees.
        def _on_walk_error(_e: OSError) -> None:
            return

        for dirpath, dirnames, filenames in os.walk(ctx.root, topdown=True, onerror=_on_walk_error, followlinks=False):
            # Prune control-plane/VCS dirs and keep traversal deterministic.
            dirnames[:] = sorted([d for d in dirnames if d not in (".sandworm", ".git")])
            for fn in sorted(filenames):
                p = Path(dirpath) / fn
                try:
                    if not p.is_file():
                        continue
                except Exception:
                    continue
                try:
                    rel = str(p.relative_to(ctx.root))
                except Exception:
                    continue
                rel_posix = rel.replace(os.sep, "/")
                if fnmatch.fnmatch(rel_posix, pat) or fnmatch.fnmatch(fn, pat):
                    matched = True
                    dest = dest_root / rel
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(p, dest)
                    h = hashlib.sha256(dest.read_bytes()).hexdigest()
                    ctx.event(
                        "artifact",
                        {"path": str(dest.relative_to(ctx.run_dir)), "sha256": h, "size": dest.stat().st_size},
                        step=step_id,
                    )
        if not matched:
            ctx.warn(f"artifact pattern matched nothing: {pat}")


def queue_run(
    ctx: RunContext,
    path: Path,
    *,
    only_step: str | None,
    from_step: str | None,
    run_providers: bool = False,
    providers_mode: str = "auto",
    providers_image: str = "docker.io/library/node:22-bookworm",
    kvm_instance: str | None = None,
) -> int:
    rep = queue_validate(ctx.root, path)
    ctx.event("queue_validate", rep)
    if not bool(rep.get("ok")):
        return 2
    q = _load_queue(ctx.root, path)
    _copy_queue_used(ctx, ctx.root, path)

    defaults = q.get("defaults") or {}
    if not isinstance(defaults, dict):
        defaults = {}

    # Record resolved queue defaults + declared inputs in the run manifest.
    input_meta: dict[str, dict[str, Any]] = {}
    inputs_by_step: dict[str, list[str]] = {}
    for st in q.get("steps") or []:
        if not isinstance(st, dict):
            continue
        sid = st.get("id")
        if not isinstance(sid, str) or not sid:
            continue
        inps = st.get("inputs") or []
        if not isinstance(inps, list):
            continue
        step_paths: list[str] = []
        for raw in inps:
            if not isinstance(raw, str) or not raw:
                continue
            step_paths.append(raw)
            if raw in input_meta:
                continue
            p = (ctx.root / raw).resolve()
            entry: dict[str, Any] = {"path": raw, "exists": False}
            if p.exists() and p.is_file():
                try:
                    st2 = p.stat()
                    entry["exists"] = True
                    entry["size"] = int(st2.st_size)
                    entry["sha256"] = _sha256_file(p)
                    if entry["sha256"] is None:
                        entry["note"] = "sha256 skipped (file too large or unreadable)"
                except Exception:
