            "bwrap backend unavailable: bubblewrap is not installed "
            "(install bubblewrap, or use --backend podman/kvm when available; "
            "tip: `sandworm hostdeps plan` / `sandworm hostdeps install --yes`)"
        )
    if b == "podman" and "podman not found in PATH" in msg:
        return (
            "podman backend unavailable: podman is not installed "
            "(install podman, or use --backend bwrap/kvm when available; "
            "tip: `sandworm hostdeps plan` / `sandworm hostdeps install --yes`)"
        )
    return f"{b or 'backend'} backend failed: {msg or repr(err)}"


def _provider_exec_hints(provider: str, msg: str) -> list[str]:
    low = str(msg or "").lower()
    hints: list[str] = []
    tty_problem = ("stdin is not a terminal" in low) or ("requires a tty" in low) or ("requires a terminal" in low)
    if tty_problem:
        hints.append(
            "interactive provider commands (resume/fork/chat) require terminal I/O. "
            "Run from an interactive terminal, or keep SW_PROVIDER_TTY=auto (default) / SW_PROVIDER_TTY=force."
        )
        hints.append("inspect tty/runtime probes: `./sandworm doctor --json`")
        if _truthy_env("SANDWORM_SINGLEFILE"):
            hints.append(
                "if this started after source changes, rebuild the wrapper to refresh embedded core: "
                "`./sandworm build singlefile --out ./sandworm`"
            )
    return hints


def _print_provider_exec_error(*, provider: str, msg: str) -> None:
    print(f"ERROR: {provider} failed: {msg}", file=sys.stderr)
    for h in _provider_exec_hints(provider, msg):
        print(f"HINT: {h}", file=sys.stderr)


def _rollback_scope_for_command_family(command_family: str) -> tuple[bool, bool]:
    fam = str(command_family or "").strip().lower()
    if fam == "build-singlefile":
        return (False, True)
    if fam in ("setup", "refresh", "state-use"):
        return (True, False)
    return (True, True)


def _compute_rollback_failure_assistant(
    *,
    root: Path,
    command_family: str,
    source: str,
    failure_message: str,
    run_id: str | None = None,
) -> dict[str, object]:
    restore_state, restore_entrypoint = _rollback_scope_for_command_family(command_family)
    payload: dict[str, object] = {
        "ok": False,
        "command_family": str(command_family or "").strip().lower(),
        "source": str(source or "").strip().lower(),
        "restore_state": bool(restore_state),
        "restore_entrypoint": bool(restore_entrypoint),
        "recommended_snapshot_id": None,
        "recommended_usable": False,
        "recommendation_reason": "rollback recommendation unavailable",
        "recommended_command": None,
        "artifact_path": None,
        "artifact_run_id": None,
        "recommendation_error": None,
    }
    rec = None
    rec_err: str | None = None
    try:
        from .statebackups import StateBackupError, recommend_state_backups, write_rollback_decision_artifact

        rec = recommend_state_backups(
            root=root,
            restore_state=restore_state,
            restore_entrypoint=restore_entrypoint,
            limit=5,
        )
        payload["recommended_snapshot_id"] = rec.recommended_snapshot_id
        payload["recommended_usable"] = bool(rec.recommended_usable)
        payload["recommendation_reason"] = rec.recommendation_reason
        payload["recommended_command"] = rec.recommended_command
        payload["recommendation_error"] = None
        try:
            art = write_rollback_decision_artifact(
                root=root,
                command_family=command_family,
                source=source,
                restore_state=restore_state,
                restore_entrypoint=restore_entrypoint,
                recommendation=rec,
                recommendation_error=None,
                failure_context={"error": str(failure_message or ""), "source": str(source or "")},
                chosen_snapshot_id=None,
                chosen_command=None,
                run_id=run_id,
            )
            payload["artifact_path"] = art.path
            payload["artifact_run_id"] = art.run_id
        except Exception as e:
            payload["artifact_error"] = str(e)
    except Exception as e:
        rec_err = str(e)
        payload["recommendation_error"] = rec_err
        try:
            from .statebackups import write_rollback_decision_artifact

            art = write_rollback_decision_artifact(
                root=root,
                command_family=command_family,
                source=source,
                restore_state=restore_state,
                restore_entrypoint=restore_entrypoint,
                recommendation=rec,
                recommendation_error=rec_err,
                failure_context={"error": str(failure_message or ""), "source": str(source or "")},
                chosen_snapshot_id=None,
                chosen_command=None,
                run_id=run_id,
            )
            payload["artifact_path"] = art.path
            payload["artifact_run_id"] = art.run_id
        except Exception as e2:
            payload["artifact_error"] = str(e2)
    return payload


def _print_rollback_failure_assistant(payload: dict[str, object]) -> None:
    fam = str(payload.get("command_family") or "")
    recommended_usable = bool(payload.get("recommended_usable"))
    recommended_id = str(payload.get("recommended_snapshot_id") or "")
    recommended_cmd = str(payload.get("recommended_command") or "")
    reason = str(payload.get("recommendation_reason") or "")
    rec_err = str(payload.get("recommendation_error") or "")
    print(f"HINT: rollback assistant ({fam}):", file=sys.stderr)
    if rec_err:
        print(f"HINT: rollback recommendation failed: {rec_err}", file=sys.stderr)
    elif recommended_usable and recommended_id and recommended_cmd:
        print(f"HINT: recommended snapshot: {recommended_id}", file=sys.stderr)
        print(f"HINT: reason: {reason}", file=sys.stderr)
        print(f"HINT: command: {recommended_cmd}", file=sys.stderr)
    elif recommended_id:
        print(
            f"HINT: no usable rollback snapshot matched the requested scope "
            f"(best candidate={recommended_id}; reason={reason})",
            file=sys.stderr,
        )
    else:
        print("HINT: no rollback snapshots available; create one with `sandworm rollback save --name <label>`", file=sys.stderr)
    ap = str(payload.get("artifact_path") or "")
    if ap:
        print(f"HINT: decision artifact: {ap}", file=sys.stderr)


def _failure_rollback_mode() -> str:
    raw = os.environ.get("SW_FAILURE_ROLLBACK")
    if raw is None:
        raw = os.environ.get("SANDWORM_FAILURE_ROLLBACK")
    v = str(raw or "").strip().lower()
    if not v:
        return "ask"
    if v in ("off", "none", "0", "false", "no", "n"):
        return "off"
    if v in ("ask", "prompt", "interactive"):
        return "ask"
    if v in ("latest", "last"):
        return "latest"
    if v in ("recommended", "recommend", "rec"):
        return "recommended"
    return "ask"


def _rollback_scope_flags(*, restore_state: bool, restore_entrypoint: bool) -> list[str]:
    flags: list[str] = []
    if restore_state and (not restore_entrypoint):
        flags.append("--state-only")
    elif restore_entrypoint and (not restore_state):
        flags.append("--entrypoint-only")
    return flags


def _format_rollback_command_for_choice(
    *,
    choice: str,
    snapshot_id: str | None,
    restore_state: bool,
    restore_entrypoint: bool,
) -> str:
    parts = ["sandworm", "--yes", "rollback"]
    if choice == "latest":
        parts.append("latest")
    else:
        sid = str(snapshot_id or "").strip()
        if sid:
            parts.extend(["to", sid])
        else:
            parts.append("latest")
    parts.extend(_rollback_scope_flags(restore_state=restore_state, restore_entrypoint=restore_entrypoint))
    return " ".join(parts)


def _apply_rollback_choice(
    *,
    root: Path,
    choice: str,
    snapshot_id: str | None,
    restore_state: bool,
    restore_entrypoint: bool,
) -> tuple[object | None, str | None, str]:
    from .statebackups import StateBackupError, restore_state_backup

    cmd = _format_rollback_command_for_choice(
        choice=choice,
        snapshot_id=snapshot_id,
        restore_state=restore_state,
        restore_entrypoint=restore_entrypoint,
    )
    try:
        res = restore_state_backup(
            root=root,
            snapshot_id=(snapshot_id if choice != "latest" else None),
            last=(choice == "latest"),
            restore_state=bool(restore_state),
            restore_entrypoint=bool(restore_entrypoint),
            activate=True,
            activate_readonly=False,
        )
        return res, None, cmd
    except (StateError, StateBackupError) as e:
        return None, str(e), cmd


def _ask_failure_rollback_choice(
    *,
    recommended_id: str | None,
    recommended_usable: bool,
) -> str:
    if _rollback_tui_enabled() and sys.stdin.isatty() and sys.stderr.isatty():
        try:
            from .rollback_tui import choose_menu

            rec = str(recommended_id or "").strip()
            rec_note = ("usable" if recommended_usable else "best-effort")
            options = [
                {"id": "recommended", "label": "rollback recommended snapshot", "detail": (f"{rec} ({rec_note})" if rec else "fallback to latest")},
                {"id": "latest", "label": "rollback latest snapshot", "detail": "most recent backup"},
                {"id": "skip", "label": "skip rollback", "detail": "continue without restore"},
            ]
            sel, err = choose_menu(
                title="Rollback Failure Assistant",
                subtitle="A command failed after auto-checkpoint. Choose rollback action.",
                options=options,
                footer="Enter=select  q=cancel",
                initial_id=("recommended" if rec else "latest"),
            )
            if err is None:
                if sel in ("recommended", "latest", "skip"):
                    return str(sel)
                return "skip"
        except Exception:
            pass

    rec = str(recommended_id or "").strip()
    print("HINT: rollback now?", file=sys.stderr)
    if rec:
        rec_note = ("usable" if recommended_usable else "best-effort")
        print(f"HINT: [r] rollback recommended snapshot ({rec}; {rec_note})", file=sys.stderr)
    else:
        print("HINT: [r] rollback recommended snapshot (unavailable; falls back to latest)", file=sys.stderr)
    print("HINT: [l] rollback latest snapshot", file=sys.stderr)
    print("HINT: [n] skip rollback", file=sys.stderr)
    try:
        ans = input("Rollback choice [r/l/N]: ").strip().lower()
    except EOFError:
        return "skip"
    except KeyboardInterrupt:
        print("", file=sys.stderr)
        return "skip"
    if ans in ("r", "rec", "recommend", "recommended"):
        return "recommended"
    if ans in ("l", "latest", "last"):
        return "latest"
    return "skip"


def _rollback_tui_enabled() -> bool:
    raw = os.environ.get("SW_ROLLBACK_TUI")
    if raw is None:
        raw = os.environ.get("SANDWORM_ROLLBACK_TUI")
    v = str(raw or "").strip().lower()
    if v in ("0", "false", "no", "off", "n"):
        return False
    term = str(os.environ.get("TERM") or "").strip().lower()
    if term in ("", "dumb"):
        return False
    return True


def _maybe_offer_rollback_on_failure(
    *,
    root: Path,
    payload: dict[str, object] | None,
    allow_prompt: bool,
) -> dict[str, object] | None:
    if not isinstance(payload, dict):
        return None
    if not allow_prompt:
        return {"attempted": False, "applied": False, "reason": "disabled_for_this_output_mode"}
    restore_state = bool(payload.get("restore_state"))
    restore_entrypoint = bool(payload.get("restore_entrypoint"))
    if not restore_state and not restore_entrypoint:
        return {"attempted": False, "applied": False, "reason": "empty_restore_scope"}

    mode = _failure_rollback_mode()
    if mode == "off":
        return {"attempted": False, "applied": False, "reason": "mode_off", "mode": mode}

    is_tty = bool(sys.stdin.isatty() and sys.stderr.isatty())
    recommended_id = str(payload.get("recommended_snapshot_id") or "").strip() or None
    recommended_usable = bool(payload.get("recommended_usable"))

    choice = "skip"
    if mode == "ask":
        if not allow_prompt:
            return {"attempted": False, "applied": False, "reason": "json_output", "mode": mode}
        if not is_tty:
            return {"attempted": False, "applied": False, "reason": "non_tty", "mode": mode}
        choice = _ask_failure_rollback_choice(recommended_id=recommended_id, recommended_usable=recommended_usable)
    elif mode == "latest":
        choice = "latest"
    elif mode == "recommended":
        if recommended_id:
            choice = "recommended"
        elif is_tty and allow_prompt:
            print("HINT: SW_FAILURE_ROLLBACK=recommended but no recommended snapshot id is available; falling back to latest.", file=sys.stderr)
            choice = "latest"
        else:
            return {"attempted": False, "applied": False, "reason": "recommended_unavailable", "mode": mode}
    else:
        return {"attempted": False, "applied": False, "reason": "unsupported_mode", "mode": mode}

    if choice == "skip":
        print("HINT: rollback not applied.", file=sys.stderr)
        return {"attempted": False, "applied": False, "reason": "user_skipped", "mode": mode}

    resolved_choice = ("latest" if choice == "latest" else ("recommended" if recommended_id else "latest"))
    sid = (recommended_id if resolved_choice == "recommended" else None)
    res, err, cmd = _apply_rollback_choice(
        root=root,
        choice=("latest" if resolved_choice == "latest" else "recommended"),
        snapshot_id=sid,
        restore_state=restore_state,
        restore_entrypoint=restore_entrypoint,
    )
    if err:
        print(f"HINT: rollback apply failed: {err}", file=sys.stderr)
        print(f"HINT: you can retry manually: {cmd}", file=sys.stderr)
        return {
            "attempted": True,
            "applied": False,
            "mode": mode,
            "choice": resolved_choice,
            "command": cmd,
            "error": err,
        }
    applied_snapshot = str(getattr(res, "snapshot_id", "") or "")
    print(f"HINT: rollback applied: snapshot={applied_snapshot}", file=sys.stderr)
    print(f"HINT: command used: {cmd}", file=sys.stderr)
    return {
        "attempted": True,
        "applied": True,
        "mode": mode,
        "choice": resolved_choice,
        "snapshot_id": applied_snapshot,
        "command": cmd,
    }


def _apply_safe_home_defaults(root: Path) -> None:
    """
    SAFE defaults: avoid writing to the host user's HOME/XDG_*.

    Many external tools (nix, git, podman, npm, etc) create caches/state even for
    benign operations. By default, Sandworm uses a project-local HOME under
    `--root/.sandworm/home` for the whole process, unless explicitly opted out.

    Inside sandboxes, HOME/SANDWORM_HOME are already set to `/run/sandworm/home` and
    the host control plane under `/workspace/.sandworm` is masked; do not override.
    """
    if _truthy_env("SW_USE_HOST_HOME") or _truthy_env("SANDWORM_USE_HOST_HOME"):
        return
    if os.environ.get("SANDWORM_HOME") == "/run/sandworm/home" or os.environ.get("HOME") == "/run/sandworm/home":
        return
    try:
        from .creds import ensure_sandworm_home, sandworm_home_dir
        from .stateutil import state_root_readonly

        if state_root_readonly(root):
            home_dir = sandworm_home_dir(root)
        else:
            home_dir = ensure_sandworm_home(root)
    except Exception:
        return

    try:
        (home_dir / ".cache").mkdir(parents=True, exist_ok=True)
        (home_dir / ".config").mkdir(parents=True, exist_ok=True)
        (home_dir / ".local" / "share").mkdir(parents=True, exist_ok=True)
        (home_dir / ".local" / "state").mkdir(parents=True, exist_ok=True)
    except Exception:
        pass

    os.environ["SANDWORM_HOME"] = str(home_dir)
    os.environ["HOME"] = str(home_dir)
    os.environ["XDG_CACHE_HOME"] = str(home_dir / ".cache")
    os.environ["XDG_CONFIG_HOME"] = str(home_dir / ".config")
    os.environ["XDG_DATA_HOME"] = str(home_dir / ".local" / "share")
    os.environ["XDG_STATE_HOME"] = str(home_dir / ".local" / "state")

def _git_subcommand(args: list[str]) -> str | None:
    skip_next = False
    for a in args:
        if skip_next:
            skip_next = False
            continue
        if a in ("-c", "-C"):
            skip_next = True
            continue
        if a.startswith("-"):
            continue
        return a
    return None


def _git_config_key_is_risky(raw_key: str) -> bool:
    key = str(raw_key or "").strip().lower()
    if not key:
        return False
    exact = {
        "core.hookspath",
        "core.fsmonitor",
        "core.fsmonitorhookversion",
        "core.pager",
        "core.editor",
        "sequence.editor",
        "diff.external",
        "credential.helper",
        "gpg.program",
    }
    if key in exact:
        return True
    if key.startswith("alias."):
        return True
    if key.startswith("filter.") and key.endswith((".clean", ".smudge", ".process")):
        return True
    if key.startswith("mergetool.") and key.endswith(".cmd"):
        return True
    if key.startswith("difftool.") and key.endswith(".cmd"):
        return True
    return False


def _git_validate_args(args: list[str], *, allow_network: bool, allow_mutate: bool, allow_risky_config: bool) -> None:
    forbidden_flags = {"-C", "--git-dir", "--work-tree"}
    for a in args:
        if a in forbidden_flags or any(a.startswith(f"{f}=") for f in ("--git-dir", "--work-tree")):
            raise SystemExit(f"sandworm git: refusing path override flag: {a!r} (use --cwd instead)")
    subcmd = _git_subcommand(args)
    if not subcmd:
        return
    # Mutating subcommands are denied by default because they can rewrite history or destroy worktrees.
    mutating = {
        "add",
        "apply",
        "am",
        "branch",
        "checkout",
        "cherry-pick",
        "clean",
        "commit",
        "config",
        "merge",
        "mv",
        "rebase",
        "reset",
        "revert",
        "rm",
        "stash",
        "switch",
        "tag",
    }
    if subcmd in mutating and not allow_mutate:
        raise SystemExit(f"sandworm git: refusing mutating git subcommand {subcmd!r} without --allow-mutate")
    if subcmd == "config" and not allow_risky_config:
        # Guard against async host payload vectors where agent-authored git config
        # executes later in a developer's native shell (outside Sandworm mediation).
        for a in args:
            if isinstance(a, str) and _git_config_key_is_risky(a):
                raise SystemExit(
                    "sandworm git: refusing risky git config key "
                    f"{a!r} without --allow-risky-config"
                )
    if subcmd in ("push", "pull", "fetch", "clone", "submodule", "ls-remote"):
        if _offline_enabled():
            raise SystemExit("sandworm git: offline mode enabled (SW_OFFLINE=1); refusing git network operation")
        if not allow_network:
            raise SystemExit(f"sandworm git: refusing git {subcmd!r} without --allow-network")


def _git_json_output_mode(args: object) -> str:
    raw = getattr(args, "json_output", "paths")
    mode = str(raw).strip().lower() if isinstance(raw, str) else "paths"
    if mode not in {"paths", "inline", "both"}:
        return "paths"
    return mode


def _git_read_output_text(meta: dict[str, Any], *, run_dir: Path | None) -> tuple[str | None, str | None]:
    stdout_text = meta.get("stdout") if isinstance(meta.get("stdout"), str) else None
    stderr_text = meta.get("stderr") if isinstance(meta.get("stderr"), str) else None

    if run_dir is not None:
        sp = meta.get("stdout_path")
        if stdout_text is None and isinstance(sp, str) and sp:
            try:
                stdout_text = (run_dir / sp).read_text(encoding="utf-8", errors="replace")
            except Exception:
                stdout_text = None
        ep = meta.get("stderr_path")
        if stderr_text is None and isinstance(ep, str) and ep:
            try:
                stderr_text = (run_dir / ep).read_text(encoding="utf-8", errors="replace")
            except Exception:
                stderr_text = None
    return stdout_text, stderr_text


def _git_json_payload(*, rc: int, meta: dict[str, Any], run_dir: Path | None, output_mode: str) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "exit_code": int(rc),
        "meta": meta,
        "output_mode": output_mode,
        "stdout_path": (meta.get("stdout_path") if isinstance(meta.get("stdout_path"), str) else None),
        "stderr_path": (meta.get("stderr_path") if isinstance(meta.get("stderr_path"), str) else None),
    }
    if output_mode in {"inline", "both"}:
        stdout_text, stderr_text = _git_read_output_text(meta, run_dir=run_dir)
        payload["stdout"] = stdout_text
        payload["stderr"] = stderr_text
        if "stdout_truncated" in meta:
            payload["stdout_truncated"] = bool(meta.get("stdout_truncated"))
        if "stderr_truncated" in meta:
            payload["stderr_truncated"] = bool(meta.get("stderr_truncated"))
    return payload



def _clients_autoupdate_policy_path(root: Path) -> Path:
    return (control_dir(root) / "clients" / "autoupdate-policy.json").resolve()


def _default_clients_autoupdate_policy() -> dict[str, object]:
    return {
        "schema": "sandworm.clients_autoupdate.v1",
        "enabled": True,
        "ttl_s": 24 * 60 * 60,
    }


def _load_clients_autoupdate_policy(root: Path) -> dict[str, object]:
    p = _clients_autoupdate_policy_path(root)
    if not p.exists():
        return _default_clients_autoupdate_policy()
    try:
        obj = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return _default_clients_autoupdate_policy()
    if not isinstance(obj, dict):
        return _default_clients_autoupdate_policy()
    d = _default_clients_autoupdate_policy()
    if isinstance(obj.get("enabled"), bool):
        d["enabled"] = bool(obj.get("enabled"))
    ttl = obj.get("ttl_s")
    try:
        if ttl is not None:
            d["ttl_s"] = max(0, int(float(str(ttl))))
    except Exception:
        pass
    return d


def _write_clients_autoupdate_policy(root: Path, policy: dict[str, object]) -> str:
    p = _clients_autoupdate_policy_path(root)
    p.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "schema": "sandworm.clients_autoupdate.v1",
        "enabled": bool(policy.get("enabled", True)),
        "ttl_s": max(0, int(float(str(policy.get("ttl_s", 24 * 60 * 60))))),
    }
    p.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return str(p)


def _clients_autoupdate_enabled(root: Path) -> bool:
    """
    Best-effort: keep provider CLIs reasonably fresh when using floating installs.
    Enabled by default; disable with SW_CLIENTS_AUTOUPDATE=0.
    """
    if "SW_CLIENTS_AUTOUPDATE" in os.environ:
        return _truthy_env("SW_CLIENTS_AUTOUPDATE")
    if "SANDWORM_CLIENTS_AUTOUPDATE" in os.environ:
        return _truthy_env("SANDWORM_CLIENTS_AUTOUPDATE")
    # Alias: provider-level naming maps to the same policy.
    if "SW_PROVIDER_AUTOUPDATE" in os.environ:
        return _truthy_env("SW_PROVIDER_AUTOUPDATE")
    if "SANDWORM_PROVIDER_AUTOUPDATE" in os.environ:
        return _truthy_env("SANDWORM_PROVIDER_AUTOUPDATE")
    pol = _load_clients_autoupdate_policy(root)
    return bool(pol.get("enabled", True))


def _clients_update_ttl_s(root: Path) -> int:
    v = os.environ.get("SW_CLIENTS_UPDATE_TTL_S") or os.environ.get("SANDWORM_CLIENTS_UPDATE_TTL_S")
    if v is None or not str(v).strip():
        v = os.environ.get("SW_PROVIDER_UPDATE_TTL_S") or os.environ.get("SANDWORM_PROVIDER_UPDATE_TTL_S")
    if v is None or not str(v).strip():
        pol = _load_clients_autoupdate_policy(root)
        try:
            return max(0, int(float(str(pol.get("ttl_s", 24 * 60 * 60)))))
        except Exception:
            return 24 * 60 * 60
    try:
        return max(0, int(float(str(v).strip())))
    except Exception:
        return 24 * 60 * 60


def _clients_autoupdate_decision(
    root: Path, *, provider: str, installed: bool, npm_tag: str, strict_supply_chain: bool
) -> tuple[bool, dict[str, object]]:
    """
    Decide whether to best-effort update an already-installed provider CLI before launching it.
    """
    meta: dict[str, object] = {
        "provider": provider,
        "installed": bool(installed),
        "autoupdate_enabled": bool(_clients_autoupdate_enabled(root)),
        "offline": bool(_offline_enabled()),
        "strict_supply_chain": bool(strict_supply_chain),
        "npm_tag": str(npm_tag),
        "ttl_s": int(_clients_update_ttl_s(root)),
    }
    if not installed:
        meta["reason"] = "not_installed"
        return False, meta
    if strict_supply_chain:
        meta["reason"] = "strict_supply_chain"
        return False, meta
    if _offline_enabled():
        meta["reason"] = "offline"
        return False, meta
    if not _clients_autoupdate_enabled(root):
        meta["reason"] = "disabled"
        return False, meta
    if str(npm_tag) != "latest":
        meta["reason"] = "tag_not_latest"
        return False, meta

    from .clients import clients_installed_age_s

    age_s = clients_installed_age_s(root, name=provider)
    meta["installed_age_s"] = age_s
    ttl_s = int(meta["ttl_s"])
    if ttl_s == 0:
        meta["reason"] = "ttl_zero"
        return True, meta
    if age_s is None:
        meta["reason"] = "unknown_age"
        return True, meta
    if age_s >= ttl_s:
        meta["reason"] = "stale"
        return True, meta
    meta["reason"] = "fresh"
    return False, meta


def _truthy_str(v: str) -> bool:
    return v.strip().lower() in ("1", "true", "yes", "y", "on")


def _falsy_str(v: str) -> bool:
    return v.strip().lower() in ("0", "false", "no", "n", "off")


def _apply_host_integrations_flag(value: str | None) -> None:
    """
    CLI sugar: --host-integrations[=1|0] writes SW_HOST_INTEGRATIONS into this process env so downstream
    provider execution code can consistently interpret the request.
    """
    if value is None:
        return
    s = str(value).strip()
    if not s:
        return
    if _truthy_str(s):
        os.environ["SW_HOST_INTEGRATIONS"] = "1"
        return
    if _falsy_str(s):
        os.environ["SW_HOST_INTEGRATIONS"] = "0"
        return
    raise SystemExit(f"invalid --host-integrations value: {value!r} (expected 1|0|true|false|on|off|yes|no)")


def _parse_hostdeps_only_csv(raw: str | None) -> list[str]:
    if raw is None:
        return []
    out: list[str] = []
    for tok in str(raw).split(","):
        x = tok.strip().lower()
        if not x:
            continue
        if x not in ("podman", "bwrap", "kvm"):
            raise SystemExit(f"invalid host dependency name in --only: {x!r} (expected podman,bwrap,kvm)")
        if x not in out:
            out.append(x)
    return out


def _prompt_yes_no(prompt: str, *, default_no: bool = True) -> bool:
    if not sys.stdin.isatty():
        return False
    suffix = "[y/N]" if default_no else "[Y/n]"
    try:
        ans = input(f"{prompt} {suffix} ").strip().lower()
    except EOFError:
        return False
    if not ans:
        return not default_no
    return ans in ("y", "yes")


def _lock_images_best_effort(root: Path) -> dict[str, str]:
    try:
        from .lockfile_min import read_lock_section_strings

        res = read_lock_section_strings(root, section="images", keys=["podman_default", "providers_sandbox_default"])
        return res.values if res.ok else {}
    except Exception:
        return {}

def _maybe_default_image_from_lock(*, image: str, lock_images: dict[str, str], lock_key: str, builtin_default: str) -> str:
    """
    Best-effort override: if caller is still using the built-in default image string and sandworm.lock provides
    a value under [images].<lock_key>, return the lock value.
    """
    if str(image) != str(builtin_default):
        return str(image)
    li = lock_images.get(lock_key)
    if isinstance(li, str) and li.strip():
        return li.strip()
    return str(image)


def _enforce_strict_images(*, strict_supply_chain: bool, image: str, kind: str) -> None:
    if not strict_supply_chain:
        return
    s = (image or "").strip()
    if not s:
        raise SystemExit(f"strict supply chain mode: missing required {kind} image")
    if s.endswith(":latest") or s == "latest":
        raise SystemExit(f"strict supply chain mode: {kind} image must not use :latest ({s})")
    if (":" not in s) and ("@" not in s):
        raise SystemExit(f"strict supply chain mode: {kind} image must include a tag or digest ({s})")
    # Optional stricter pinning: require digest pins, not just tags.
    if _truthy_env("SW_STRICT_OCI_DIGEST") or _truthy_env("SW_REQUIRE_OCI_DIGEST"):
        if "@sha256:" not in s:
            raise SystemExit(f"strict supply chain mode: {kind} image must be pinned by digest (@sha256:...) ({s})")

def _auto_provider_backend_plan(root: Path, *, allow_kvm: bool = True, posture: str | None = None) -> dict[str, object]:
    """
    Best-effort, non-mutating backend selection plan for provider entrypoints.

    This is intentionally lightweight (no builds/downloads). The runtime may still
    fall back further, run `sandworm refresh`, and/or fetch a KVM qcow2 image.
    """
    root = root.resolve()
    strict_supply_chain = _truthy_env("SW_STRICT_SUPPLYCHAIN") or _truthy_env("SANDWORM_STRICT_SUPPLYCHAIN")

    def _probe_exe(env_key: str, fallback_env_key: str, name: str) -> str | None:
        override = os.environ.get(env_key) or os.environ.get(fallback_env_key)
        if isinstance(override, str) and override.strip():
            cand = override.strip()
            try:
                if os.path.exists(cand) and os.access(cand, os.X_OK):
                    return cand
            except Exception:
                return None
            return None
        return shutil.which(name)

    # Networking preflight: distinguish "DNS is down" from "this environment forbids sockets".
    # DEV posture must be online; if `socket()` is denied by policy, we must fail loudly.
    socket_ok = True
    socket_errno: int | None = None
    socket_err: str | None = None
    try:
        from .doctor import _socket_create_probe

        socket_ok, socket_errno, socket_err = _socket_create_probe()
    except Exception:
        # Best-effort: if the probe itself fails for an unexpected reason, treat as unknown/ok for planning.
        socket_ok, socket_errno, socket_err = True, None, None

    podman = _probe_exe("SW_PODMAN_BIN", "SANDWORM_PODMAN_BIN", "podman")

    podman_ok = False
    podman_reason = "podman not found"
    if podman:
        try:
            # Probe using Sandworm's project-local Podman storage config (more representative than
            # `podman unshare true` under an arbitrary HOME/XDG env).
            from .podman import ensure_storage

            ensure_storage(root)
            podman_ok = True
            podman_reason = "ok"
        except Exception as e:
            podman_ok = False
            podman_reason = str(e) or repr(e)
    bwrap = _probe_exe("SW_BWRAP_BIN", "SANDWORM_BWRAP_BIN", "bwrap")

    nix = None
    try:
        from .nixutils import find_nix

        nix = find_nix(root)
    except Exception:
        nix = None

    qemu_prog = "qemu-system-x86_64"
    try:
        from .kvm import _qemu_system_binary

        qemu_prog = _qemu_system_binary()
    except Exception:
        qemu_prog = "qemu-system-x86_64"
    qemu = _probe_exe("SW_QEMU_BIN", "SANDWORM_QEMU_BIN", qemu_prog)
    kvm_devnode_ok = False
    try:
        from .doctor import _kvm_writable

        kvm_devnode_ok = bool(_kvm_writable())
    except Exception:
        kvm_devnode_ok = False

    # If qemu is not present, we may be able to fetch it via nix, but that implies networking.
    # The plan should not claim "kvm available" when sockets are denied by policy.
    kvm_possible = bool(kvm_devnode_ok and (qemu or (nix and socket_ok)))

    chain: list[str] = []
    reasons: list[dict[str, object]] = []
    inherited_backend = (os.environ.get("SANDWORM_BACKEND") or "").strip()
    inherited_posture = (os.environ.get("SANDWORM_POSTURE") or "").strip().lower()
    inherited_posture_known = inherited_posture in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev")
    inherited_runtime_markers = _nested_runtime_markers_present()

    p = (posture or "").strip().lower()
    inherited_match = bool(inherited_backend and inherited_posture_known and inherited_posture == p)
    inherited_legacy_dev = bool(inherited_backend and p == "dev" and _truthy_env("SANDWORM_DEV_COCKPIT"))
    inherited_possible = bool(inherited_runtime_markers and (inherited_match or inherited_legacy_dev))
    inherited_control_plane_populated = bool(
        inherited_runtime_markers
        and p in ("safe", "dev", "unsafe", "take-the-wheel")
        and _control_plane_observed_populated()
    )
    allow_inherited_control_plane = bool(
        _truthy_env("SW_ALLOW_INHERITED_CONTROL_PLANE")
        or _truthy_env("SANDWORM_ALLOW_INHERITED_CONTROL_PLANE")
        or _truthy_env("SANDWORM_EXPOSE_CONTROL_PLANE")
    )
    env_only_inherited_backend = bool(inherited_backend and not inherited_runtime_markers)
    if env_only_inherited_backend:
        reasons.append(
            {
                "mode": "inherited",
                "ok": False,
                "reason": (
                    "SANDWORM_BACKEND is set, but active nested Sandworm runtime markers are missing "
                    "(/run/sandworm/bin/sandworm + HOME=/run/sandworm/home)"
                ),
            }
        )
    if inherited_possible and inherited_control_plane_populated and not allow_inherited_control_plane:
        reasons.append(
            {
                "mode": "inherited",
                "ok": False,
                "reason": (
                    "nested runtime has populated /workspace/.sandworm; "
                    "refusing inherited backend until control-plane masking is restored "
                    "(override only for diagnostics with SW_ALLOW_INHERITED_CONTROL_PLANE=1)"
                ),
            }
        )
    elif inherited_possible:
        chain.append("inherited")
        reasons.append(
            {
                "mode": "inherited",
                "ok": True,
                "reason": (
                    f"reuse inherited backend ({inherited_backend}) for posture={p}"
                    if inherited_match
                    else f"reuse inherited backend ({inherited_backend}) in legacy DEV cockpit"
                ),
            }
        )
    if p == "dev" and not socket_ok:
        reasons.append(
            {
                "mode": "dev",
                "ok": False,
                "reason": (
                    f"socket() denied by sandbox policy (errno={socket_errno}): {socket_err}; "
                    "continuing best-effort for nested DEV fallback"
                ),
            }
        )

    if env_only_inherited_backend:
        reasons.append(
            {
                "mode": "sandbox",
                "ok": False,
                "reason": (
                    "refusing backend auto-selection while SANDWORM_BACKEND is env-only; "
                    "active nested runtime markers are required"
                ),
            }
        )
        reasons.append(
            {
                "mode": "bwrap",
                "ok": False,
                "reason": (
                    "refusing backend auto-selection while SANDWORM_BACKEND is env-only; "
                    "active nested runtime markers are required"
                ),
            }
        )
    elif podman_ok:
        chain.append("sandbox")
        reasons.append({"mode": "sandbox", "ok": True, "reason": "podman ok"})
    else:
        reasons.append({"mode": "sandbox", "ok": False, "reason": f"podman unavailable ({podman_reason})"})
        if bwrap:
            chain.append("bwrap")
            reasons.append({"mode": "bwrap", "ok": True, "reason": "bwrap found"})
        elif nix and socket_ok:
            chain.append("bwrap")
            reasons.append({"mode": "bwrap", "ok": True, "reason": "nix available (bwrap can be fetched; net ok)"})
        else:
            if nix and not socket_ok:
                reasons.append({"mode": "bwrap", "ok": False, "reason": "bwrap not found; nix present but socket() is denied (cannot fetch bwrap)"})
            else:
                reasons.append({"mode": "bwrap", "ok": False, "reason": "bwrap not found and nix not available"})

    p = (posture or "").strip().lower()
    if env_only_inherited_backend:
        reasons.append(
            {
                "mode": "kvm",
                "ok": False,
                "reason": (
                    "refusing backend auto-selection while SANDWORM_BACKEND is env-only; "
                    "active nested runtime markers are required"
                ),
            }
        )
    elif p in ("unsafe", "take-the-wheel", "bare-metal"):
        reasons.append(
            {
                "mode": "kvm",
                "ok": False,
                "reason": "requested posture needs host escape semantics unavailable in kvm",
            }
        )
    elif allow_kvm and kvm_possible:
        chain.append("kvm")
        reasons.append(
            {"mode": "kvm", "ok": True, "reason": (f"{qemu_prog} found" if qemu else "nix available (qemu can be fetched)")}
        )
    else:
        reasons.append(
            {
                "mode": "kvm",
                "ok": False,
                "reason": (f"{qemu_prog} not found and nix not available" if allow_kvm else "disabled"),
            }
        )

    if p == "dev" and not socket_ok and not (_truthy_env("SW_OFFLINE") or _truthy_env("SANDWORM_OFFLINE")) and "sandbox" in chain:
        chain_without_sandbox = [m for m in chain if m != "sandbox"]
        if chain_without_sandbox:
            chain = chain_without_sandbox
            reasons.append(
                {
                    "mode": "sandbox",
                    "ok": False,
                    "reason": "socket() denied by sandbox policy; deprioritizing sandbox in DEV auto mode",
                }
            )
        else:
            reasons.append(
                {
                    "mode": "sandbox",
                    "ok": True,
                    "reason": "socket() denied by sandbox policy; sandbox retained as only backend (best-effort)",
                }
            )

    selected_mode = chain[0] if chain else None

    kvm_image = (control_dir(root) / "kvm" / "guest.qcow2").resolve()
    kvm_image_present = bool(kvm_image.exists())
    would_fetch_kvm_image = bool(selected_mode == "kvm" and not kvm_image_present)

    qcow2_url = os.environ.get("SW_KVM_QCOW2_URL") or os.environ.get("SANDWORM_KVM_QCOW2_URL")
    qcow2_sha = os.environ.get("SW_KVM_QCOW2_SHA256") or os.environ.get("SANDWORM_KVM_QCOW2_SHA256")
    if not (isinstance(qcow2_url, str) and qcow2_url.strip()):
        qcow2_url = None
    if not (isinstance(qcow2_sha, str) and qcow2_sha.strip()):
        qcow2_sha = None

    try:
        from .lockfile_min import read_lock_section_strings

        kvm_lock = read_lock_section_strings(root, section="kvm.nixos", keys=["qcow2_url", "qcow2_sha256"])
        if kvm_lock.ok:
            if not qcow2_url:
                qcow2_url = kvm_lock.values.get("qcow2_url")
            if not qcow2_sha:
                qcow2_sha = kvm_lock.values.get("qcow2_sha256")
    except Exception:
        pass

    qcow2_sha_pinned = bool(isinstance(qcow2_sha, str) and re.fullmatch(r"[0-9a-fA-F]{64}", qcow2_sha.strip() or ""))
    allow_floating_in_strict = bool(
        _truthy_env("SW_ALLOW_KVM_QCOW2_FLOATING") or _truthy_env("SW_KVM_ALLOW_FLOATING_QCOW2")
    )
    kvm_fetch_would_fail_closed = bool(strict_supply_chain and would_fetch_kvm_image and not qcow2_sha_pinned and not allow_floating_in_strict)

    return {
        "selected_mode": selected_mode,
        "fallback_chain": chain,
        "reasons": reasons,
        "inherited_backend": (inherited_backend if inherited_possible else None),
        "inherited_posture": (inherited_posture if inherited_posture_known else None),
        "inherited_posture_match": bool(inherited_match),
        "inherited_runtime_markers": bool(inherited_runtime_markers),
        "inherited_control_plane_populated": bool(inherited_control_plane_populated),
        "probes": {
            "podman": bool(podman_ok),
            "podman_reason": str(podman_reason),
            "podman_bin": (str(podman) if podman else None),
            "bwrap": bool(bwrap),
            "nix": bool(nix),
            "qemu_prog": qemu_prog,
            "qemu": bool(qemu),
        },
        "kvm": {
            "guest_image_path": str(kvm_image),
            "guest_image_present": kvm_image_present,
            "would_fetch_image": would_fetch_kvm_image,
            "qcow2_url": qcow2_url,
            "qcow2_sha256": qcow2_sha,
            "qcow2_sha256_pinned": qcow2_sha_pinned,
            "fetch_would_fail_closed_in_strict": kvm_fetch_would_fail_closed,
        },
    }


def _collect_provider_session_manifest() -> dict[str, object]:
    """Lightweight provider preflight manifest.

    Keep provider launch paths responsive by avoiding full doctor collection.
    """
    offline_env = _truthy_env("SW_OFFLINE") or _truthy_env("SANDWORM_OFFLINE")
    socket_ok = True
    socket_errno: int | None = None
    socket_err: str | None = None
    dns_ok: bool | None = None
    try:
        from .doctor import _socket_create_probe

        socket_ok, socket_errno, socket_err = _socket_create_probe()
    except Exception:
        socket_ok, socket_errno, socket_err = True, None, None
    try:
        proc = subprocess.run(
            ["getent", "hosts", "github.com"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2.0,
        )
        dns_ok = bool(proc.returncode == 0)
    except Exception:
        dns_ok = None

    return {
        "session": {
            "net": {
                "offline_env": bool(offline_env),
                "socket_create_ok": bool(socket_ok),
                "socket_create_errno": (int(socket_errno) if isinstance(socket_errno, int) else None),
                "socket_create_error": (str(socket_err) if socket_err else None),
                "dns_github_ok": dns_ok,
            }
        }
    }


def _summarize_provider_invocation(provider: str, argv: list[str]) -> dict[str, object]:
    """
    Return a minimal, non-secret summary of provider CLI argv.

    Do not include the prompt/body (which can contain user data/secrets).
    """
    p = (provider or "").strip()
    args = list(argv or [])
    out: dict[str, object] = {"argv_len": int(len(args))}

    def first_subcommand() -> str | None:
        for a in args:
            if isinstance(a, str) and a and not a.startswith("-"):
                return a
        return None

    out["subcommand"] = first_subcommand()

    if p == "codex":
        model: str | None = None
        approvals: str | None = None
        sandbox: str | None = None
        bypass = False
        wants_json = False
        i = 0
        while i < len(args):
            a = args[i]
            if a.startswith("--ask-for-approval="):
                approvals = str(a.split("=", 1)[1])
                i += 1
                continue
            if a.startswith("--sandbox="):
                sandbox = str(a.split("=", 1)[1])
                i += 1
                continue
            if a == "--dangerously-bypass-approvals-and-sandbox":
                bypass = True
                i += 1
                continue
            if a == "--json":
                wants_json = True
                i += 1
                continue
            if a in ("--model", "-m") and i + 1 < len(args):
                model = str(args[i + 1])
                i += 2
                continue
            if a in ("-a", "--approvals", "--approval-policy", "--ask-for-approval") and i + 1 < len(args):
                approvals = str(args[i + 1])
                i += 2
                continue
            if a in ("-s", "--sandbox", "--sandbox-policy") and i + 1 < len(args):
                sandbox = str(args[i + 1])
                i += 2
                continue
            i += 1
        out["codex"] = {
            "model": model,
            "approvals": approvals,
            "sandbox": sandbox,
            "bypass_approvals_and_sandbox": bool(bypass),
            "json": bool(wants_json),
        }

    if p in ("claude", "gemini"):
        wants_json = False
        output_format: str | None = None
        i = 0
        while i < len(args):
            a = args[i]
            if a == "--output-format" and i + 1 < len(args):
                output_format = str(args[i + 1])
                i += 2
                continue
            if a == "--json":
                wants_json = True
                i += 1
                continue
            i += 1
        out[p] = {"output_format": output_format, "json": bool(wants_json)}

    return out


def _provider_posture_from_args(args: argparse.Namespace) -> str:
    raw = getattr(args, "posture", None)
    posture = str(raw or "safe").strip()
    if posture not in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev"):
        posture = "safe"
    return posture


def _extract_posture_from_provider_argv(argv: list[str]) -> tuple[str | None, bool, list[str]]:
    posture: str | None = None
    saw_yes = False
    out: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-y", "--yes"):
            saw_yes = True
            i += 1
            continue
        if a == "--DEV":
            posture = "dev"
            i += 1
            continue
        if a == "--UNSAFE":
            posture = "unsafe"
            i += 1
            continue
        if a == "--TAKE-THE-WHEEL":
            posture = "take-the-wheel"
            i += 1
            continue
        if a == "--BARE-METAL":
            posture = "bare-metal"
            i += 1
            continue
        if a == "--posture":
            v = argv[i + 1] if (i + 1) < len(argv) else ""
            if v in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev"):
                posture = v
                i += 2
                continue
        if a.startswith("--posture="):
            v = a.split("=", 1)[1].strip()
            if v in ("safe", "unsafe", "take-the-wheel", "bare-metal", "dev"):
                posture = v
                i += 1
                continue
        out.append(a)
        i += 1
    return posture, saw_yes, out


def _normalize_provider_argv_and_posture(
    ctx: "RunContext",
    args: argparse.Namespace,
    *,
    provider: str,
    posture: str,
) -> tuple[str, bool, list[str]]:
    provider_argv = list(getattr(args, "argv", []) or [])
    resume_target = getattr(args, "resume_target", None)
    if isinstance(resume_target, str):
        resume_target = resume_target.strip()
    else:
        resume_target = None
    provider_key = str(provider or "").strip().lower()
    if resume_target:
        scan = [a for a in provider_argv if a != "--"]
        first_nonflag = ""
        for a in scan:
            if not a.startswith("-"):
                first_nonflag = a
                break
        if first_nonflag:
            raise SystemExit(
                "cannot combine --RESUME with explicit provider argv. "
                "Use only one shape: `--RESUME [latest|<sid>]` or `-- resume ...`."
            )
        if provider_key == "codex":
            provider_argv = ["resume", resume_target, *provider_argv]
        elif provider_key in ("claude", "gemini"):
            provider_argv = ["--resume", resume_target, *provider_argv]
        else:
            provider_argv = ["resume", resume_target, *provider_argv]
    while provider_argv and provider_argv[0] == "--":
        provider_argv = provider_argv[1:]
    posture_from_argv, yes_from_argv, provider_argv = _extract_posture_from_provider_argv(provider_argv)
    # Ergonomic guardrail: treat trailing `--dry-run` in provider resume forms as a Sandworm
    # dry-run request so `sandworm <provider> resume ... --DEV -y --dry-run` does not
    # accidentally execute a real provider command.
    first_nonflag = ""
    for a in provider_argv:
        if a in ("--", ""):
            continue
        if not a.startswith("-"):
            first_nonflag = a
            break
    is_resume_form = bool(
        (provider_key == "codex" and first_nonflag == "resume")
        or (provider_key in ("claude", "gemini") and "--resume" in provider_argv)
    )
    if not bool(getattr(args, "dry_run", False)) and is_resume_form:
        if "--dry-run" in provider_argv:
            provider_argv = [a for a in provider_argv if a != "--dry-run"]
            setattr(args, "dry_run", True)
    if posture_from_argv and posture_from_argv != posture:
        # Common ergonomic form: `sandworm codex resume <id> --DEV -y`.
        # When top-level posture is implicit parser-default safe, suppress warning.
        posture_explicit = bool(getattr(args, "_top_level_posture_explicit", False))
        if posture_explicit or posture != "safe":
            ctx.warn(f"posture from argv overrides --posture ({posture!r} -> {posture_from_argv!r})")
        posture = posture_from_argv
    if yes_from_argv:
        setattr(args, "yes", True)
    setattr(args, "argv", provider_argv)
    yes_effective = bool(getattr(args, "yes", False)) or yes_from_argv
    return posture, yes_effective, provider_argv


def _provider_top_level_posture_explicit(args: argparse.Namespace) -> bool:
    raw = getattr(args, "posture", None)
    return bool(isinstance(raw, str) and raw.strip())


def _runlock_command_descriptor(args: argparse.Namespace) -> tuple[str, dict[str, object] | None]:
    cmd = str(getattr(args, "cmd", "") or "").strip()
    if not cmd:
        return ("unknown", None)
    if cmd not in ("codex", "claude", "gemini"):
        return (cmd, None)
    provider_argv = list(getattr(args, "argv", []) or [])
    while provider_argv and provider_argv[0] == "--":
        provider_argv = provider_argv[1:]
    _posture_ignored, _yes_ignored, normalized = _extract_posture_from_provider_argv(list(provider_argv))
    first_idx = -1
    for i, tok in enumerate(normalized):
        if tok and tok != "--" and not tok.startswith("-"):
            first_idx = i
            break
    if first_idx < 0:
        return (cmd, None)
    subcmd = str(normalized[first_idx]).strip().lower()
    if subcmd == "resume":
        sid = str(normalized[first_idx + 1]).strip() if (first_idx + 1) < len(normalized) else ""
        if sid:
            return (
                f"{cmd} resume {sid}",
                {"kind": "provider_resume", "provider": cmd, "session_id": sid},
            )
        return (f"{cmd} resume", {"kind": "provider_resume", "provider": cmd, "session_id": ""})
    return (f"{cmd} {subcmd}".strip(), {"kind": "provider", "provider": cmd, "subcommand": subcmd})


def _confirm_dangerous_posture(*, provider: str, posture: str, yes: bool, dry_run: bool) -> None:
    if posture not in ("unsafe", "take-the-wheel", "bare-metal"):
        return
    if dry_run:
        return
    # If the singlefile loader already prompted (pre-bootstrap), don't prompt twice.
    if _truthy_env("SANDWORM_DANGEROUS_POSTURE_CONFIRMED") or _truthy_env("SW_DANGEROUS_POSTURE_CONFIRMED"):
        return

    if posture == "unsafe":
        banner = (
            "DANGEROUS: UNSAFE posture requested.\n"
            "- Enables host actions via hostd (audited gateway).\n"
            "- Does NOT mount host root at /host.\n"
            "- Provider still runs in a sandbox (host execution remains disabled).\n"
        )
    elif posture == "take-the-wheel":
        banner = (
            "DANGEROUS: TAKE-THE-WHEEL posture requested.\n"
            "- Mounts host root read-write at /host (explicitly dangerous).\n"
            "- Also enables host actions via hostd when available.\n"
            "- Provider still runs in a sandbox (host execution remains disabled).\n"
        )
    else:
        banner = (
            "DANGEROUS: BARE-METAL posture requested.\n"
            "- Provider runs directly on the host (no sandbox).\n"
            "- Full host filesystem + process access applies.\n"
            "- Host actions are no longer mediated by hostd.\n"
        )
    print(banner, file=sys.stderr)
    if yes:
        return
    if not sys.stdin.isatty():
        raise SystemExit(f"sandworm {provider}: posture={posture} requires confirmation. Re-run with -y/--yes.")
    print("Tip: re-run with -y/--yes to skip this prompt.", file=sys.stderr)
    ans = input("Continue? [y/N] ").strip().lower()
    if ans not in ("y", "yes"):
        raise SystemExit("aborted")


def _print_provider_plan(
    *,
    root: Path,
    provider: str,
    runid: str | None,
    mode_requested: str,
    mode_selected: str,
    auto_plan: dict[str, object] | None,
    posture: str,
    creds_profile: str | None,
    installed: bool,
    would_update: bool,
    would_login: bool,
    login_policy: str,
    open_policy: str,
    image: str | None,
    network: str | None,
) -> None:
    """
    Noob ergonomics: print a short plan before doing slow work (install/update/login/launch).

    Keep this secret-free and stable (stdout remains provider's domain; use stderr).
    """
    chain = None
    if isinstance(auto_plan, dict):
        raw = auto_plan.get("fallback_chain")
        if isinstance(raw, list):
            parts = [str(x) for x in raw if str(x).strip()]
            if parts:
                chain = "→".join(parts)
    control = control_dir(root)
    home_host = control / ("home" if not creds_profile or creds_profile == "default" else f"home.{creds_profile}")
    default_control = (root / ".sandworm").resolve()
    state_root_env = os.environ.get("SANDWORM_STATE_ROOT") or os.environ.get("SW_STATE_ROOT")
    try:
        state_root_file = read_state_root_file(root)
    except Exception:
        state_root_file = None

    lines: list[str] = []
    lines.append(f"provider={provider} posture={posture} mode={mode_requested} selected={mode_selected}{(' (chain=' + chain + ')') if chain else ''}")
    if control.resolve() != default_control:
        if isinstance(state_root_env, str) and state_root_env.strip():
            lines.append(f"state_root={control} (override via SW_STATE_ROOT/SANDWORM_STATE_ROOT)")
        elif state_root_file is not None and state_root_file.path is not None:
            lines.append(f"state_root={control} (override via {state_root_config_path(root)})")
        else:
            lines.append(f"state_root={control} (override)")
    lines.append(f"clients: installed={'yes' if installed else 'no'}; will_install={'no' if installed else 'yes'}; will_update={'yes' if would_update else 'no'}")
    lines.append(
        f"auth: login={login_policy}; will_login={'yes' if would_login else 'no'}; open={open_policy}; home_host={home_host}"
    )
    if provider == "codex":
        lines.append("codex defaults: --ask-for-approval never; --sandbox danger-full-access (unless explicitly overridden)")
    if mode_selected == "sandbox":
        lines.append(f"sandbox: image={image or ''} network={network or ''}".strip())
    if posture == "dev":
        lines.append(
            "dev: development lane (SAFE-like sandbox boundaries, no host escape); may enable extra toolchain conveniences"
        )
    elif posture == "unsafe":
        lines.append("unsafe: host actions via hostd (audited); no /host mount")
    elif posture == "take-the-wheel":
        lines.append("take-the-wheel: host root mounted at /host (rw; normal file permissions still apply)")
    elif posture == "bare-metal":
        lines.append("bare-metal: provider runs on host (no sandbox; full host access)")
    if runid:
        readonly_state_root = False
        try:
            from .stateutil import state_root_readonly

            readonly_state_root = bool(state_root_readonly(root))
        except Exception:
            readonly_state_root = False
        if readonly_state_root:
            lines.append(f"run: <temporary control plane> (state root is readonly; report: sandworm report --run {runid})")
        else:
            lines.append(f"run: {control_dir(root) / 'runs' / runid} (report: sandworm report --run {runid})")
    if posture == "bare-metal":
        lines.append(f"host: Sandworm HOME={home_host} (provider runs on host; no sandbox)")
    else:
        lines.append("inside sandboxes: /run/sandworm/home (see also: sandworm docs; use --dry-run for JSON plan)")
    for s in lines:
        print(f"[sandworm] plan: {s}", file=sys.stderr)


def _fail_no_backend_selected(
    *,
    ctx: RunContext,
    provider: str,
    mode_requested: str,
    mode_selected: str,
    auto_plan: dict[str, object] | None,
) -> int | None:
    """
    Fail fast when auto mode cannot pick any backend.

    This avoids pointless client install/update work in constrained environments where
    execution cannot proceed anyway.
    """
    if mode_requested != "auto" or mode_selected != "none":
        return None
    msg = (
        "auto mode: no usable provider backend found (need podman or bwrap; "
        "tip: run `sandworm hostdeps plan`)"
    )
    detail: list[str] = []
    if isinstance(auto_plan, dict):
        raw = auto_plan.get("reasons")
        if isinstance(raw, list):
            for item in raw:
                if not isinstance(item, dict):
                    continue
                if bool(item.get("ok")):
                    continue
                mode = str(item.get("mode") or "").strip()
                reason = str(item.get("reason") or "").strip()
                if mode and reason:
                    detail.append(f"{mode}: {reason}")
    ctx.event(
        "error",
        {
            "where": f"{provider}.backend",
            "error": msg,
            "mode_requested": mode_requested,
            "mode_selected": mode_selected,
            "backend_reasons": detail,
        },
    )
    print(f"ERROR: {provider} failed: {msg}", file=sys.stderr)
    for line in detail[:5]:
        print(f"HINT: {line}", file=sys.stderr)
    print("HINT: inspect host capabilities with `sandworm doctor --json`", file=sys.stderr)
    print("HINT: install missing host deps with `sandworm hostdeps install --yes`", file=sys.stderr)
    return 2


def _resolve_run_shell_backend(
    *,
    root: Path,
    command_name: str,
    posture: str,
    backend_requested: str,
    ctx: RunContext,
) -> tuple[str, dict[str, object] | None]:
    backend_req = str(backend_requested or "").strip().lower() or "podman"
    auto_plan: dict[str, object] | None = None
    backend_selected = backend_req
    if backend_req == "auto":
        auto_plan = _auto_provider_backend_plan(root, allow_kvm=True, posture=posture)
        backend_selected = str(auto_plan.get("selected_mode") or "").strip() or "none"
        rc_none = _fail_no_backend_selected(
            ctx=ctx,
            provider=command_name,
            mode_requested="auto",
            mode_selected=backend_selected,
            auto_plan=auto_plan,
        )
        if rc_none is not None:
            raise SystemExit(int(rc_none))
        if backend_selected == "inherited":
            inherited_backend = str(auto_plan.get("inherited_backend") or "").strip().lower()
            if inherited_backend in ("podman", "bwrap", "kvm"):
                ctx.event(
                    "backend_auto_select",
                    {
                        "where": command_name,
                        "backend_requested": backend_req,
                        "backend_selected": "inherited",
                        "inherited_backend": inherited_backend,
                        "posture": posture,
                        "fallback_chain": auto_plan.get("fallback_chain"),
                    },
                )
            else:
                # Defensive fallback: inherited selection without a concrete parent backend
                # is unusable for run/shell execution.
                raise SystemExit(
                    f"sandworm {command_name}: auto backend selected inherited mode "
                    "without a concrete parent backend"
                )
        elif backend_selected in ("podman", "bwrap", "kvm"):
            ctx.event(
                "backend_auto_select",
                {
                    "where": command_name,
                    "backend_requested": backend_req,
                    "backend_selected": backend_selected,
                    "posture": posture,
                    "fallback_chain": auto_plan.get("fallback_chain"),
                },
            )
        else:
            raise SystemExit(
                f"sandworm {command_name}: auto backend selected unsupported mode {backend_selected!r}"
            )
    if backend_selected == "kvm" and posture in ("unsafe", "take-the-wheel"):
        raise SystemExit(
            f"sandworm {command_name}: backend=kvm does not support posture={posture!r}; "
            "use --backend podman|bwrap for UNSAFE/TAKE-THE-WHEEL"
        )
    return (backend_selected, auto_plan)


def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = build_parser()
    return parser.parse_args(argv)


def _assert_top_level_command_registry(subparsers: object) -> None:
    choices = getattr(subparsers, "choices", None)
    if not isinstance(choices, dict):
        return
    actual = sorted(str(name) for name in choices.keys())
    missing, extra = compare_top_level_commands(actual)
    if not missing and not extra:
        return
    details: list[str] = []
    if missing:
        details.append(f"missing={missing}")
    if extra:
        details.append(f"extra={extra}")
    raise RuntimeError("top-level command registry drift: " + " ".join(details))


def build_parser() -> argparse.ArgumentParser:
    """
    Build the CLI parser without parsing argv.

    This is used by:
    - the main entrypoint (`_parse_args`)
    - the singlefile builder, which embeds `--help` output into the loader for instant help on minimal hosts
    """
    parser = argparse.ArgumentParser(prog="sandworm")
    parser.add_argument(
        "--root",
        required=True,
        help="Workspace root (project dir). Control plane defaults to <root>/.sandworm unless SANDWORM_STATE_ROOT is set.",
    )
    parser.add_argument("--version", action="version", version=f"sandworm {__version__}")
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Do not prompt for dangerous posture confirmation (global; useful for non-provider commands)",
    )

    sub = parser.add_subparsers(dest="cmd", required=True)

    def _add_creds_arg(p: argparse.ArgumentParser) -> None:
        p.add_argument(
            "--creds",
            dest="creds_profile",
            default="default",
            help="Credential profile name (default=default; uses ./.sandworm/home or ./.sandworm/home.<name>)",
        )

    p_doctor = sub.add_parser("doctor", help="Diagnose host capabilities")
    p_doctor.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    p_hostdeps = sub.add_parser("hostdeps", help="Host dependency helper (podman, bubblewrap, qemu/kvm)")
    hdsub = p_hostdeps.add_subparsers(dest="hostdeps_cmd", required=True)
    hd_plan = hdsub.add_parser("plan", help="Show distro-aware install plan for missing host dependencies")
    hd_plan.add_argument(
        "--only",
        default="",
        help="Optional CSV subset (podman,bwrap,kvm); default: all missing dependencies",
    )
    hd_plan.add_argument("--no-config", action="store_true", help="Do not include post-install config steps (e.g. kvm group)")
    hd_plan.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    hd_install = hdsub.add_parser("install", help="Install missing host dependencies using distro package manager")
    hd_install.add_argument(
        "--only",
        default="",
        help="Optional CSV subset (podman,bwrap,kvm); default: all missing dependencies",
    )
    hd_install.add_argument("--no-config", action="store_true", help="Do not apply post-install config steps (e.g. kvm group)")
    hd_install.add_argument("--dry-run", action="store_true", help="Print commands only; do not execute")
    hd_install.add_argument("--json", action="store_true", help="Emit machine-readable JSON")

    p_docs = sub.add_parser("docs", help="Print the built-in runbook (singlefile-friendly)")
    p_docs.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    p_docs.add_argument("--write", default=None, help="Write output to a file (prints the path on success)")
    p_docs.add_argument("topic", nargs="?", default=None, help="Optional topic filter (e.g. queue, hooks, recipes, real-providers)")

    p_state = sub.add_parser("state", help="Manage control-plane state roots")
    stsub = p_state.add_subparsers(dest="state_cmd", required=True)
    s_show = stsub.add_parser("show", help="Show current state-root selection")
    s_show.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    s_use = stsub.add_parser("use", help="Persist an alternate control-plane directory for this root")
    s_use.add_argument("--path", required=True, help="Control-plane directory to use (relative to root or absolute)")
    s_use.add_argument("--allow-outside", action="store_true", help="Allow a path outside the workspace root")
    s_use.add_argument("--readonly", action="store_true", help="Mark the state root as read-only (fail closed on writes)")
    s_use.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    s_clear = stsub.add_parser("clear", help="Clear any persisted alternate state root for this root")
    s_clear.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    s_import = stsub.add_parser("import", help="Copy a control-plane directory into ./.sandworm")
    s_import.add_argument("--from", dest="src", required=True, help="Source control-plane directory")
    s_import.add_argument("--overwrite", action="store_true", help="Overwrite existing entries in ./.sandworm")
    s_import.add_argument("--include-volatile", action="store_true", help="Include volatile dirs like locks/tmp")
    s_import.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    s_snapshot = stsub.add_parser("snapshot", help="Create an immutable rollback snapshot of current state root")
    s_snapshot.add_argument("--name", default=None, help="Optional human label for the snapshot id")
    s_snapshot.add_argument("--include-volatile", action="store_true", help="Include volatile dirs like locks/tmp/cache")
    s_snapshot.add_argument("--no-entrypoint", action="store_true", help="Do not include sandworm entrypoint files in the snapshot")
    s_snapshot.add_argument("--pointer", action="store_true", help="Pointer-only snapshot (fast; stores state root reference instead of copying control-plane files)")
    s_snapshot.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
    s_snapshots = stsub.add_parser("snapshots", help="List available state rollback snapshots")
