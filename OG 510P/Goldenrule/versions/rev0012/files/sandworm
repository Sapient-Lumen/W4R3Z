def _normalize_payload_wrapper(text: str) -> str:
    """
    Best-effort normalization of the inner wrapper embedded in the singlefile payload.

    Invariant: the singlefile product must prefer its embedded `sandworm_core` by default even when
    executed with `cwd=<root>`, so imports must not implicitly come from the working directory.
    """
    if "PYTHONSAFEPATH" in text:
        return text
    lines = text.splitlines(keepends=True)
    out: list[str] = []
    inserted = False
    for line in lines:
        out.append(line)
        if not inserted and line.startswith("export PYTHONPATH="):
            out.append("export PYTHONSAFEPATH=1\n")
            inserted = True
    if not inserted:
        return text
    return "".join(out)


def _normalize_stage0_bwrap_nix_bind(text: str) -> str:
    """
    Best-effort patch for the stage0 `run --backend bwrap` fallback in the payload wrapper.

    On some distros (notably NixOS), /bin and /usr/bin entries can be symlinks into /nix/store.
    Without a /nix bind, even `sh` may fail to exec inside the sandbox.
    """
    if 'bwrap_cmd+=("--ro-bind" "/nix" "/nix")' in text:
        return text
    if "_sw_stage0_run_bwrap" not in text:
        return text
    marker = '  if [[ -d "/bin" ]]; then bwrap_cmd+=("--ro-bind" "/bin" "/bin"); fi\n'
    if marker not in text:
        return text
    insert = (
        marker
        + '  # On some distros (e.g., NixOS), /bin and /usr/bin entries are symlinks into /nix/store.\n'
        + '  # Without a /nix bind, even `sh` may not exist inside the sandbox.\n'
        + '  if [[ -d "/nix" ]]; then bwrap_cmd+=("--ro-bind" "/nix" "/nix"); fi\n'
    )
    return text.replace(marker, insert, 1)


def _compress_bytes_gzip(data: bytes) -> bytes:
    import gzip

    out = io.BytesIO()
    with gzip.GzipFile(fileobj=out, mode="wb", compresslevel=9) as gz:
        gz.write(data)
    return out.getvalue()


def _build_payload(*, sandworm_path: Path, core_dir: Path) -> tuple[bytes, str]:
