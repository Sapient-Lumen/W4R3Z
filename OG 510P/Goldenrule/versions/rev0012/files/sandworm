                os.environ.get("SANDWORM_HOSTD_OVERRIDE_FORCE")
            )
            if root_visible and root_sock.exists() and not force_override:
                return root_sock
            override = (os.environ.get("SANDWORM_HOSTD_SOCK") or "").strip()
            if override:
                return Path(override)
            if root_visible:
                return root_sock
