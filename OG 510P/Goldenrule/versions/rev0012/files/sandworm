def codex_login_status(root: Path) -> tuple[bool, str]:
    """
    Best-effort check for whether Codex is logged in under Sandworm-managed HOME.
    Returns (logged_in, raw_output).
    """
    root = root.resolve()
    try:
        from .codexhome import codex_auth_state, ensure_codex_auth_imported

        # Best-effort: import an existing token into Sandworm-managed HOME (copy-only).
        ensure_codex_auth_imported(root)
        state = codex_auth_state(root)
    except Exception as e:
        return False, f"error: {e!r}"

    logged_in = bool(state.get("any_creds"))
    # Keep this terse and non-secret; the caller can also inspect auth.json directly if needed.
    raw = (
        f"auth_json_present={state.get('present')} "
        f"oauth_tokens={state.get('has_oauth_tokens')} "
        f"api_key={state.get('has_real_api_key')} "
        f"placeholder={state.get('looks_like_placeholder_api_key')}"
    )
    return logged_in, raw

def codex_login_status_sandbox(root: Path, *, image: str, network: str) -> tuple[bool, str]:
    """
    Best-effort check for whether Codex is logged in when executed inside a podman sandbox.

    This is intentionally separate from `codex_login_status()` because some auth mechanisms
    (notably desktop keyring / OAuth tokens) may not be available inside containers.
    Returns (logged_in, raw_output).
    """
    root = root.resolve()
    bin_path = (control_dir(root) / "clients" / "bin" / "codex").resolve()
    if not (bin_path.exists() and os.access(bin_path, os.X_OK)):
        raise AuthError("codex client not installed")

    try:
        from .podman import ensure_storage, run
    except Exception as e:
        raise AuthError(f"podman not available: {e}")

    home_dir = ensure_sandworm_home(root)
    try:
        from .codexhome import ensure_codex_auth_imported

        ensure_codex_auth_imported(root)
    except Exception:
        pass
    podman_env = ensure_storage(root)
    mounts = [f"{home_dir}:/run/sandworm/home:rw"]
    env2: dict[str, str] = {
        "SANDWORM_HOME": "/run/sandworm/home",
        "HOME": "/run/sandworm/home",
        "XDG_CONFIG_HOME": "/run/sandworm/home/.config",
        "XDG_DATA_HOME": "/run/sandworm/home/.local/share",
        "XDG_CACHE_HOME": "/run/sandworm/home/.cache",
        "CODEX_HOME": "/run/sandworm/home/.codex",
        # Force wrapper to use the container's node instead of nix.
        "SANDWORM_CLIENTS_USE_NODE": "1",
    }
    proc = run(
        root,
        ["/run/sandworm/clients/bin/codex", "login", "status"],
        image=image,
        podman_env=podman_env,
        network=network,
        workdir="/workspace",
        timeout_s=20,
        mounts=mounts,
        env=env2,
    )
    out = (proc.stdout or "") + (proc.stderr or "")
    s = out.lower()
    if "not logged in" in s or "logged out" in s:
        return False, out.strip()
    # Tests (and some bootstrap flows) may leave a placeholder API key behind in ~/.codex/auth.json,
    # which makes Codex report "logged in" even though real API calls will fail.
    if "logged in using an api key" in s and "sw-test-" in s:
        return False, out.strip()
    if proc.returncode == 0 and "logged in" in s:
        return True, out.strip()
    return False, out.strip()


