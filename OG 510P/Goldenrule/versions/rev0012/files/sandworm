        try:
            from .report import render_minimal_transcript, generate_report_for_run

            render_minimal_transcript(effective_root, runid)
            generate_report_for_run(effective_root, runid)
        except Exception as e:
            ctx.warn(f"failed to render transcript/report: {e!r}")
