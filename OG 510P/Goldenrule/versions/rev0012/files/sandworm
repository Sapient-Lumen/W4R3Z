def client_run(
    *,
    addr: str,
    token: str,
    suite: str,
    knobs: dict[str, Any] | None,
    poll_s: float = 2.0,
) -> dict[str, Any]:
    import urllib.request

    hostport = addr.strip()
    if hostport.startswith("http://") or hostport.startswith("https://"):
        base = hostport.rstrip("/")
    else:
        base = "http://" + hostport.rstrip("/")

    def req(method: str, path: str, body: dict[str, Any] | None) -> dict[str, Any]:
        data = None
        if body is not None:
            data = (json.dumps(body) + "\n").encode("utf-8")
        r = urllib.request.Request(base + path, data=data, method=method)
        r.add_header("Authorization", f"Bearer {token}")
        r.add_header("Content-Type", "application/json")
        with urllib.request.urlopen(r, timeout=30) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            obj = json.loads(raw)
            return obj if isinstance(obj, dict) else {"ok": False, "error": "bad response"}

    start = req("POST", "/v1/suite/run", {"suite": suite, "knobs": knobs or {}})
    if not bool(start.get("ok")):
        return start
    run_id = str(start.get("run_id") or "")
    if not run_id:
        return {"ok": False, "error": "missing run_id"}

    while True:
        st = req("GET", f"/v1/run/status?run_id={run_id}", None)
        if not bool(st.get("ok")):
            return st
        status = str(st.get("status") or "")
        if status in ("ok", "fail", "error"):
            return st
        time.sleep(float(poll_s))
