    backup: Path | None = None
    if target.exists():
        backup = target.with_suffix(target.suffix + f".bak.{_now_compact_utc()}")
        try:
            shutil.copy2(target, backup)
        except Exception as e:
            raise PromoteError(f"failed to create backup: {backup}") from e

