def _git_wrapper_script(*, git_attr: str) -> str:
    attr_default = str(git_attr).replace("\\", "\\\\").replace('"', '\\"')
    return f"""#!/bin/sh
set -eu

self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
for cand in /run/current-system/sw/bin/git /nix/var/nix/profiles/default/bin/git /usr/bin/git /bin/git; do
  if [ -x "$cand" ]; then
    cand_real="$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")"
    if [ "$cand_real" != "$self" ]; then
      exec "$cand" "$@"
    fi
  fi
done

SCRIPT="$0"
case "$SCRIPT" in
  */*) SCRIPT_DIR="${{SCRIPT%/*}}" ;;
  *) SCRIPT_DIR="." ;;
esac
SCRIPT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR" && pwd -P)"

NIX="${{SANDWORM_NIX:-${{SW_NIX:-}}}}"
if [ -z "$NIX" ] || [ ! -x "$NIX" ]; then
  if [ -x "$SCRIPT_DIR/nix" ]; then
    NIX="$SCRIPT_DIR/nix"
  elif command -v nix >/dev/null 2>&1; then
    NIX="$(command -v nix)"
  else
    NIX=""
  fi
fi

if [ -z "$NIX" ]; then
  echo "git-compat: git unavailable (no system git and no nix wrapper; run: sandworm refresh)" >&2
  exit 127
fi

GIT_ATTR="${{SANDWORM_GIT_ATTR:-${{SW_GIT_ATTR:-{attr_default}}}}}"
exec "$NIX" --extra-experimental-features 'nix-command flakes' shell "$GIT_ATTR" --command git "$@"
"""


def _now_rfc3339() -> str:
    import time

    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _write_json(path: Path, payload: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def _node_attr_from_lockfile(root: Path) -> str:
    node_attr = "nixpkgs#nodejs_22"
    lf = lockfile_path(root)
    if not lf.exists():
        return node_attr
    try:
        d = load_lockfile_dict(lf)
        clients = d.get("clients") if isinstance(d, dict) else None
        if isinstance(clients, dict):
            na = clients.get("node_attr")
            if isinstance(na, str) and na.strip() and na.strip() not in ("", "..."):
                node_attr = na.strip()
    except Exception:
        return node_attr
    return _with_pinned_nixpkgs_ref(root, node_attr)


def _with_pinned_nixpkgs_ref(root: Path, attr: str) -> str:
    if not isinstance(attr, str) or not attr.startswith("nixpkgs#"):
        return attr
    lf = lockfile_path(root)
    if not lf.exists():
        return attr
    try:
        d = load_lockfile_dict(lf)
        nix = d.get("nix") if isinstance(d, dict) else None
        if not isinstance(nix, dict):
            return attr

        def _pinned_enough(v: object) -> bool:
            if not isinstance(v, str) or not v.strip():
                return False
            s = v.strip()
            if s == "nixpkgs":
                return False
            if "refs/heads/" in s or s.endswith("/nixpkgs"):
                return False
            return True

        pinned_ref = None
        primary = nix.get("nixpkgs_flake")
        fb = nix.get("nixpkgs_flake_fallback")
        if _pinned_enough(primary):
            pinned_ref = str(primary).strip()
        elif _pinned_enough(fb):
            pinned_ref = str(fb).strip()
        if not pinned_ref:
            return attr
        return f"{pinned_ref}#{attr.split('#', 1)[1]}"
    except Exception:
        return attr


def _git_attr_from_lockfile(root: Path) -> str:
    return _with_pinned_nixpkgs_ref(root, "nixpkgs#git")


def ensure_toolroot_node_wrapper(root: Path) -> bool:
    bin_dir = control_dir(root) / "toolroot" / "bin"
    if not bin_dir.exists():
        return False
    node_path = bin_dir / "node"
    # Cross-posture invariant: toolroot wrappers must be executable in sandboxes where
    # host-only interpreter paths (e.g. /run/current-system/sw/bin/bash on NixOS) are absent.
    # Enforce a portable /bin/sh shebang and rely on wrapper preludes to re-exec bash when needed.
    try:
        if node_path.exists():
            try:
                first = node_path.read_text(encoding="utf-8", errors="replace").splitlines()[0].strip()
            except Exception:
                first = ""
            if first == "#!/bin/sh":
                return True
        return refresh_toolroot_wrappers(root) and node_path.exists()
    except Exception:
        return False


def refresh_toolroot_wrappers(root: Path) -> bool:
    """
    Rewrite lightweight wrappers without downloading toolroot artifacts.
    """
    if state_root_readonly(root):
        raise ToolrootError("toolroot refresh refused: state root is read-only")
    bin_dir = control_dir(root) / "toolroot" / "bin"
    try:
        bin_dir.mkdir(parents=True, exist_ok=True)
        _write_executable(bin_dir / "nix", _nix_wrapper_script(root=root))
        _write_executable(bin_dir / "nix-shell", _nix_shell_wrapper_script())
        node_attr = _node_attr_from_lockfile(root)
        _write_executable(bin_dir / "node", _node_wrapper_script(node_attr=node_attr))
        _write_executable(bin_dir / "dirname", _dirname_wrapper_script())
        _write_executable(bin_dir / "rg", _rg_wrapper_script())
        _write_executable(bin_dir / "jq", _jq_wrapper_script())
        _write_executable(bin_dir / "git", _git_wrapper_script(git_attr=_git_attr_from_lockfile(root)))
        _write_executable(bin_dir / "apt", _apt_wrapper_script())
        _write_executable(bin_dir / "pgrep", _procps_wrapper_script("pgrep"))
        _write_executable(bin_dir / "pkill", _procps_wrapper_script("pkill"))
        return True
    except Exception:
        return False


