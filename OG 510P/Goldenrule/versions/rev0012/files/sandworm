    manifest_sha256: str | None
    chain_path: Path | None
    chain_entry_index: int | None
    key_id: str | None
    generated_key: bool
    errors: list[str]


@dataclass(frozen=True)
class ProofVerifyResult:
    ok: bool
    bundle_dir: Path
    summary_path: Path | None
    manifest_path: Path | None
    chain_path: Path | None
    errors: list[str]
    warnings: list[str]
    files_checked: int
    chain_entries_checked: int
    summary: dict[str, Any] | None


@dataclass(frozen=True)
class ProofReplayResult:
    ok: bool
    bundle_dir: Path
    verify: ProofVerifyResult
    executed: bool
    command: str | None
    returncode: int | None
    stdout: str | None
    stderr: str | None
