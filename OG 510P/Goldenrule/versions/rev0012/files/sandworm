def _bwrap_ensure_dest_dirs_for_bind(cmd: list[str], *, dest: str, src: str | None, created: set[str]) -> None:
    """
    Best-effort: ensure destination directories exist before adding `--bind/--ro-bind` mounts.

    Bubblewrap binds behave differently for file vs directory mounts; this helper focuses on
    directory mounts (dominant for DBus/SSH agent passthrough).
    """
    if not isinstance(dest, str) or not dest.startswith("/"):
        return
    src_is_dir = False
    if isinstance(src, str) and src:
        try:
            src_is_dir = Path(src).exists() and Path(src).is_dir()
        except Exception:
            src_is_dir = False
    try:
        p = Path(dest)
        # Ensure parents exist from / → ... → parent(dest).
        parents = list(p.parents)
        parents.reverse()
        for d in parents:
            s = str(d)
            if s in ("", "/"):
                continue
            if s in created:
                continue
            cmd += ["--dir", s]
            created.add(s)
        # For directory mounts, also ensure the destination directory itself exists.
        if src_is_dir:
            sdest = str(p)
            if sdest not in ("", "/") and sdest not in created:
                cmd += ["--dir", sdest]
                created.add(sdest)
    except Exception:
        return


def _ensure_bwrap_via_nix(root: Path | None) -> str | None:
    nix = find_nix(root)
    if not nix:
        return None
    timeout_s = _nix_probe_timeout_s()
    try:
        cmd = [nix, *nix_flags(), "build", "--no-link", "--print-out-paths", "nixpkgs#bubblewrap"]
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        try:
            out, err = proc.communicate(timeout=timeout_s)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except Exception:
                pass
            time.sleep(0.1)
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except Exception:
                    pass
            raise
        if proc.returncode != 0:
            raise subprocess.CalledProcessError(proc.returncode, cmd, output=out, stderr=err)
        store_path = out.strip().splitlines()[-1].strip()
        bwrap = str(Path(store_path) / "bin" / "bwrap")
        if os.path.exists(bwrap) and os.access(bwrap, os.X_OK):
            return bwrap
    except subprocess.TimeoutExpired:
        if _progress_enabled():
            _note(f"bwrap probe via nix timed out after {timeout_s}s; continuing without nix-provided bwrap")
        return None
    except Exception:
        return None
    return None


