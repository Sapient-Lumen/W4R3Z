        "pid_alive": pid_alive,
        "pid": pid,
        "socket": str(p["socket"]),
        "socket_legacy": str(p["legacy_socket"]),
        "socket_exists": bool(sock_exists),
        "socket_ok": sock_ok,
        "effective_socket": str(effective_socket),
        "effective_source": effective_source,
        "effective_socket_exists": bool(effective_exists),
