        h.update(f.rel.encode("utf-8"))
        h.update(b"\0")
        h.update(oct(int(f.mode) & 0o777).encode("ascii"))
        h.update(b"\0")
        h.update(hashlib.sha256(b).hexdigest().encode("ascii"))
        h.update(b"\n")
    return files, h.hexdigest(), total_bytes


