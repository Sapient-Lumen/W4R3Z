{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concord Spec Ledger",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "type",
      "status",
      "summary",
      "owner",
      "exit_criteria",
      "evidence_links",
      "created",
      "last_updated",
      "target_resolution"
    ],
    "properties": {
      "id": { "type": "string" },
      "type": { "enum": ["gap", "question", "assumption"] },
      "status": { "enum": ["open", "mitigated", "resolved", "retired"] },
      "summary": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "mitigated_by": { "type": "string" },
      "linked_gap": { "type": "string" },
      "related_gap": { "type": "string" },
      "exit_criteria": { "type": "string", "minLength": 1 },
      "evidence_links": {
        "type": "array",
        "items": { "type": "string" }
      },
      "created": { "type": "string", "format": "date" },
      "last_updated": { "type": "string", "format": "date" },
      "target_resolution": { "type": "string", "format": "date" }
    },
    "additionalProperties": true
  }
}
