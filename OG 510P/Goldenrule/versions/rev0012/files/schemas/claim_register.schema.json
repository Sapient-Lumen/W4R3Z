{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concord Claim Register",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "claim_class_id",
      "status",
      "summary",
      "scope",
      "owner",
      "assumptions",
      "evidence_links",
      "last_updated"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^CL-[0-9]{3}$"
      },
      "claim_class_id": {
        "type": "string",
        "pattern": "^CC-[0-9]{3}$"
      },
      "status": {
        "type": "string",
        "enum": ["draft", "active", "superseded", "retired"]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "string",
        "minLength": 1
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^SA-[0-9]{3}$"
        }
      },
      "evidence_links": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "last_updated": {
        "type": "string",
        "format": "date"
      }
    },
    "additionalProperties": false
  }
}
