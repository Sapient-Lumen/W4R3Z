{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch Proxy Zero-Noise Rule Classifier Snapshot",
  "type": "object",
  "required": [
    "world",
    "rule_rows",
    "summary"
  ],
  "properties": {
    "world": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "source_artifact",
        "mode_id",
        "state_positions",
        "alphabet",
        "wildcard_symbol",
        "support_signature_count",
        "regime_count"
      ],
      "properties": {
        "kind": {
          "const": "rematch_proxy_zero_noise_rule_classifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact": {
          "type": "string",
          "minLength": 1
        },
        "mode_id": {
          "const": "none"
        },
        "state_positions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alphabet": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wildcard_symbol": {
          "type": "string",
          "minLength": 1
        },
        "support_signature_count": {
          "type": "integer",
          "minimum": 1
        },
        "regime_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "rule_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "pattern",
          "regex",
          "regime_id",
          "signature_count",
          "representative_signatures",
          "quotient_family_count",
          "quotient_family_examples",
          "note"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "regex": {
            "type": "string",
            "minLength": 1
          },
          "regime_id": {
            "type": "string",
            "minLength": 1
          },
          "signature_count": {
            "type": "integer",
            "minimum": 1
          },
          "representative_signatures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quotient_family_count": {
            "type": "integer",
            "minimum": 1
          },
          "quotient_family_examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "lookup_signature_count",
        "ordered_rule_count",
        "lookup_to_rule_reduction_factor",
        "largest_rule_id",
        "largest_pattern",
        "largest_rule_signature_count",
        "smallest_rule_id",
        "smallest_pattern",
        "smallest_rule_signature_count",
        "exact_match"
      ],
      "properties": {
        "lookup_signature_count": {
          "type": "integer",
          "minimum": 1
        },
        "ordered_rule_count": {
          "type": "integer",
          "minimum": 1
        },
        "lookup_to_rule_reduction_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "largest_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "largest_pattern": {
          "type": "string",
          "minLength": 1
        },
        "largest_rule_signature_count": {
          "type": "integer",
          "minimum": 1
        },
        "smallest_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "smallest_pattern": {
          "type": "string",
          "minLength": 1
        },
        "smallest_rule_signature_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_match": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
