{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concord Risk Register",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "status",
      "domain",
      "summary",
      "severity",
      "likelihood",
      "owner",
      "mitigation",
      "review_date",
      "evidence_links"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^RK-[0-9]{3}$"
      },
      "status": {
        "type": "string",
        "enum": ["open", "mitigated", "accepted", "closed"]
      },
      "domain": {
        "type": "string",
        "enum": ["formal", "benchmark", "ops", "governance", "performance", "security"]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "severity": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "likelihood": {
        "type": "string",
        "enum": ["low", "medium", "high"]
      },
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "mitigation": {
        "type": "string",
        "minLength": 1
      },
      "review_date": {
        "type": "string",
        "format": "date"
      },
      "evidence_links": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "additionalProperties": false
  }
}
