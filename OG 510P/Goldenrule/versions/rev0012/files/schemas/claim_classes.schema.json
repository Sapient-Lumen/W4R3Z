{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concord Claim Classes",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "evidence_class",
      "summary",
      "required_artifacts",
      "required_checks",
      "strict_gate_required"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^CC-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "evidence_class": {
        "type": "string",
        "enum": ["empirical", "formal", "hybrid", "operational", "assumption"]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "required_artifacts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "required_checks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^make [A-Za-z0-9_:= -]+$"
        }
      },
      "strict_gate_required": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
