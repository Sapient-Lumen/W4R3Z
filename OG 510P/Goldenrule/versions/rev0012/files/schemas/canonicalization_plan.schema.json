{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonicalization Plan Manifest",
  "type": "object",
  "required": ["world", "mode_rows", "summary"],
  "properties": {
    "world": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "base_pool",
        "deterministic_focal_codes",
        "support_signature_count",
        "state_count",
        "state_index",
        "naive_cache_plan"
      ],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "base_pool": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministic_focal_codes": { "type": "integer", "minimum": 1 },
        "support_signature_count": { "type": "integer", "minimum": 1 },
        "state_count": { "type": "integer", "minimum": 1 },
        "state_index": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "naive_cache_plan": {
          "type": "object",
          "required": ["key_fields", "horizon", "signature_slots", "key_depth_slots"],
          "properties": {
            "key_fields": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "horizon": { "type": "integer", "minimum": 1 },
            "signature_slots": { "type": "integer", "minimum": 1 },
            "key_depth_slots": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "mode_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "focal_tremble",
          "opponent_tremble",
          "regime_count",
          "minimal_exact_horizon",
          "planner_kind",
          "recommended_key_fields",
          "planner_note",
          "naive_signature_slots",
          "optimized_signature_slots",
          "signature_slot_reduction_factor",
          "naive_key_depth_slots",
          "optimized_key_depth_slots",
          "key_depth_reduction_factor",
          "regime_rows",
          "signature_to_regime"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "focal_tremble": { "type": "boolean" },
          "opponent_tremble": { "type": "boolean" },
          "regime_count": { "type": "integer", "minimum": 1 },
          "minimal_exact_horizon": { "type": "integer", "minimum": 1 },
          "planner_kind": { "type": "string", "minLength": 1 },
          "recommended_key_fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "planner_note": { "type": "string", "minLength": 1 },
          "naive_signature_slots": { "type": "integer", "minimum": 1 },
          "optimized_signature_slots": { "type": "integer", "minimum": 1 },
          "signature_slot_reduction_factor": { "type": "number", "exclusiveMinimum": 0 },
          "naive_key_depth_slots": { "type": "integer", "minimum": 1 },
          "optimized_key_depth_slots": { "type": "integer", "minimum": 1 },
          "key_depth_reduction_factor": { "type": "number", "exclusiveMinimum": 0 },
          "regime_rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "regime_id",
                "signature_count",
                "representative_signatures",
                "contains_initial_d_support",
                "all_initial_c_only",
                "quotient_family_count",
                "quotient_family_examples"
              ],
              "properties": {
                "regime_id": { "type": "string", "minLength": 1 },
                "signature_count": { "type": "integer", "minimum": 1 },
                "representative_signatures": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "contains_initial_d_support": { "type": "boolean" },
                "all_initial_c_only": { "type": "boolean" },
                "quotient_family_count": { "type": "integer", "minimum": 1 },
                "quotient_family_examples": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": true
            }
          },
          "signature_to_regime": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "optimized_key_depth_slots_by_mode",
        "key_depth_reduction_factor_by_mode",
        "regime_count_by_mode",
        "minimal_exact_horizon_by_mode",
        "largest_reduction_factor",
        "smallest_reduction_factor"
      ],
      "properties": {
        "optimized_key_depth_slots_by_mode": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "key_depth_reduction_factor_by_mode": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        },
        "regime_count_by_mode": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "minimal_exact_horizon_by_mode": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "largest_reduction_factor": { "type": "number", "exclusiveMinimum": 0 },
        "smallest_reduction_factor": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
