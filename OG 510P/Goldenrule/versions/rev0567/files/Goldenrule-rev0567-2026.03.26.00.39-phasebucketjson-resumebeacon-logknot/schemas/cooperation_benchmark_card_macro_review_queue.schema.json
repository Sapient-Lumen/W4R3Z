{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_macro_review_queue.schema.json",
  "title": "Cooperation Benchmark Card Macro Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_kind",
    "inventory_kind",
    "heads_register_kind",
    "review_queue_kind",
    "citation_surface_kind",
    "counts",
    "groups"
  ],
  "properties": {
    "queue_kind": {
      "const": "cooperation_benchmark_card_macro_review_queue"
    },
    "inventory_kind": {
      "const": "cooperation_benchmark_card_inventory"
    },
    "heads_register_kind": {
      "const": "cooperation_benchmark_card_heads_register"
    },
    "review_queue_kind": {
      "const": "cooperation_benchmark_card_review_queue"
    },
    "citation_surface_kind": {
      "const": "cooperation_benchmark_card_citation_surface"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_count",
        "queued_lineage_count",
        "total_item_count",
        "total_apply_command_count"
      ],
      "properties": {
        "lineage_count": {
          "type": "integer",
          "minimum": 0
        },
        "queued_lineage_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_apply_command_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineage_id",
          "benchmark_names",
          "operational_head_card_id",
          "citation_head_card_id",
          "citation_ready",
          "item_count",
          "item_ids",
          "item_kinds",
          "reason_codes",
          "primary_review_command",
          "review_commands",
          "apply_commands",
          "context_paths"
        ],
        "properties": {
          "lineage_id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operational_head_card_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "citation_head_card_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "citation_ready": {
            "type": "boolean"
          },
          "item_count": {
            "type": "integer",
            "minimum": 1
          },
          "item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "item_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary_review_command": {
            "type": "string",
            "minLength": 1
          },
          "review_commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "apply_commands": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
