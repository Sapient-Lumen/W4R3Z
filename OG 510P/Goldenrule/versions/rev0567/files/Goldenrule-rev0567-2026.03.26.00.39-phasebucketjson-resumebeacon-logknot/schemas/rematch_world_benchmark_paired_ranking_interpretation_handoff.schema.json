{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "occupancy_accounting_report_path",
    "occupancy_accounting_report_sha256",
    "turnover_tempo_report_path",
    "turnover_tempo_report_sha256",
    "rank_decomposition_report_path",
    "rank_decomposition_report_sha256",
    "linked_question_ids",
    "tested_extortion_values",
    "tested_delay_values",
    "canonical_occupancy_normalized_rank_order",
    "extortions_sharing_canonical_order",
    "occupancy_loss_summary",
    "rank_disagreement_summary",
    "tempo_scaling_summary",
    "ranking_interpretation_rule",
    "upgrade_requirement",
    "size_discipline_note"
  ],
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_paired_ranking_interpretation_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_paired_ranking_interpretation_handoff.v1"
    },
    "planner_origin": {
      "type": "string",
      "minLength": 1
    },
    "occupancy_accounting_report_path": {
      "const": "artifacts/reports/rematch_proxy_occupancy_accounting_snapshot_20260306.json"
    },
    "occupancy_accounting_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "turnover_tempo_report_path": {
      "const": "artifacts/reports/rematch_proxy_turnover_tempo_snapshot_20260306.json"
    },
    "turnover_tempo_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rank_decomposition_report_path": {
      "const": "artifacts/reports/rematch_proxy_rank_decomposition_snapshot_20260306.json"
    },
    "rank_decomposition_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linked_question_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^SQ-0(14|15|16)$"
      }
    },
    "tested_extortion_values": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "tested_delay_values": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 1
    },
    "canonical_occupancy_normalized_rank_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extortions_sharing_canonical_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "occupancy_loss_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_cells",
        "matched_share_monotone_nonincreasing_in_all_tested_cells",
        "mean_share_component_fraction_of_delay_loss",
        "min_share_component_fraction_of_delay_loss",
        "max_abs_in_match_payoff_drift_delay0_to_delay2"
      ],
      "properties": {
        "tested_cells": {
          "type": "integer",
          "minimum": 1
        },
        "matched_share_monotone_nonincreasing_in_all_tested_cells": {
          "type": "boolean"
        },
        "mean_share_component_fraction_of_delay_loss": {
          "type": "number",
          "minimum": 0
        },
        "min_share_component_fraction_of_delay_loss": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_in_match_payoff_drift_delay0_to_delay2": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rank_disagreement_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panels_checked",
        "nonzero_delay_panels_checked",
        "nonzero_delay_panels_with_raw_vs_occupancy_normalized_rank_disagreement",
        "total_pairwise_inversions_overall_vs_occupancy_normalized_in_nonzero_delay_panels",
        "max_pairwise_inversions_in_any_panel",
        "lowest_kendall_tau_overall_vs_occupancy_normalized",
        "largest_disagreement_panel"
      ],
      "properties": {
        "panels_checked": {
          "type": "integer",
          "minimum": 1
        },
        "nonzero_delay_panels_checked": {
          "type": "integer",
          "minimum": 0
        },
        "nonzero_delay_panels_with_raw_vs_occupancy_normalized_rank_disagreement": {
          "type": "integer",
          "minimum": 0
        },
        "total_pairwise_inversions_overall_vs_occupancy_normalized_in_nonzero_delay_panels": {
          "type": "integer",
          "minimum": 0
        },
        "max_pairwise_inversions_in_any_panel": {
          "type": "integer",
          "minimum": 0
        },
        "lowest_kendall_tau_overall_vs_occupancy_normalized": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "largest_disagreement_panel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extortion",
            "delay",
            "kendall_tau_overall_vs_occupancy_normalized",
            "pairwise_inversion_count",
            "overall_rank_order",
            "occupancy_normalized_rank_order",
            "example_inversions"
          ],
          "properties": {
            "extortion": {
              "type": "integer",
              "minimum": 0
            },
            "delay": {
              "type": "integer",
              "minimum": 0
            },
            "kendall_tau_overall_vs_occupancy_normalized": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pairwise_inversion_count": {
              "type": "integer",
              "minimum": 0
            },
            "overall_rank_order": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "occupancy_normalized_rank_order": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "example_inversions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "higher_by_in_match",
                  "lower_by_in_match",
                  "in_match_gap",
                  "overall_gap"
                ],
                "properties": {
                  "higher_by_in_match": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lower_by_in_match": {
                    "type": "string",
                    "minLength": 1
                  },
                  "in_match_gap": {
                    "type": "number"
                  },
                  "overall_gap": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tempo_scaling_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highest_churn_delay2_cell",
        "lowest_churn_delay2_cell",
        "highest_vs_lowest_churn_delay2_matched_share_loss_ratio",
        "mean_abs_prediction_error",
        "max_abs_prediction_error"
      ],
      "properties": {
        "highest_churn_delay2_cell": {
          "$ref": "#/$defs/churnCell"
        },
        "lowest_churn_delay2_cell": {
          "$ref": "#/$defs/churnCell"
        },
        "highest_vs_lowest_churn_delay2_matched_share_loss_ratio": {
          "type": "number",
          "minimum": 0
        },
        "mean_abs_prediction_error": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_prediction_error": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ranking_interpretation_rule": {
      "type": "string",
      "minLength": 1
    },
    "upgrade_requirement": {
      "type": "string",
      "minLength": 1
    },
    "size_discipline_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "churnCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "extortion",
        "avg_match_length",
        "matched_share_loss"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "extortion": {
          "type": "integer",
          "minimum": 0
        },
        "avg_match_length": {
          "type": "number",
          "minimum": 0
        },
        "matched_share_loss": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
