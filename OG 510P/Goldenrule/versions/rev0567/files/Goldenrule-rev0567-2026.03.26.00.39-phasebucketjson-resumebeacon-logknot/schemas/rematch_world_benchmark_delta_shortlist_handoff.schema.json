{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Delta Shortlist Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "publishability_report_path",
    "publishability_report_sha256",
    "decision_contract_path",
    "decision_contract_sha256",
    "linked_question_ids",
    "declared_budget_family_caps",
    "strict_profile",
    "primary_shortlist_rows",
    "broader_profile_candidate_count",
    "upgrade_requirement",
    "size_discipline_note"
  ],
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_delta_shortlist_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_delta_shortlist_handoff.v1"
    },
    "planner_origin": {
      "const": "copy the strict proxy-era publishable delta shortlist into the benchmark seed until native rematch worlds can emit their own SESOI-band shortlist"
    },
    "publishability_report_path": {
      "const": "artifacts/reports/rematch_proxy_delta_publishability_snapshot_20260306.json"
    },
    "publishability_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_contract_path": {
      "const": "artifacts/reports/rematch_decision_contract_snapshot_20260316.json"
    },
    "decision_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linked_question_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^SQ-0(22|23|24|25|26)$"
      }
    },
    "declared_budget_family_caps": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "strict_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_name",
        "minimum_covered_budget_cap_count",
        "minimum_shared_core_width",
        "requires_no_overlap_with_hazard_band_for_additional_budget_cap",
        "sub_0p01_only",
        "candidate_count"
      ],
      "properties": {
        "profile_name": {
          "const": "family4_width0p0010_hazard1000_sub0p01"
        },
        "minimum_covered_budget_cap_count": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_shared_core_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requires_no_overlap_with_hazard_band_for_additional_budget_cap": {
          "type": "integer",
          "minimum": 1
        },
        "sub_0p01_only": {
          "const": true
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "primary_shortlist_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topology_code",
          "counts",
          "covered_budget_caps",
          "shared_core_start_delta",
          "shared_core_end_delta",
          "shared_core_width",
          "shared_core_anchor_delta",
          "shared_core_anchor_buffer_to_boundary",
          "min_separation_to_hazard_band_for_additional_budget_cap_1000",
          "min_separation_to_knife_edge_delta"
        ],
        "properties": {
          "topology_code": {"type": "string", "minLength": 1},
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_leader", "practical_tie", "undecided"],
            "properties": {
              "material_leader": {"type": "integer", "minimum": 0},
              "practical_tie": {"type": "integer", "minimum": 0},
              "undecided": {"type": "integer", "minimum": 0}
            }
          },
          "covered_budget_caps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          },
          "shared_core_start_delta": {"type": "number", "minimum": 0},
          "shared_core_end_delta": {"type": "number", "minimum": 0},
          "shared_core_width": {"type": "number", "exclusiveMinimum": 0},
          "shared_core_anchor_delta": {"type": "number", "minimum": 0},
          "shared_core_anchor_buffer_to_boundary": {"type": "number", "minimum": 0},
          "min_separation_to_hazard_band_for_additional_budget_cap_1000": {"type": "number", "minimum": 0},
          "min_separation_to_knife_edge_delta": {"type": "number", "minimum": 0}
        }
      }
    },
    "broader_profile_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "upgrade_requirement": {"type": "string", "minLength": 1},
    "size_discipline_note": {"type": "string", "minLength": 1}
  }
}
