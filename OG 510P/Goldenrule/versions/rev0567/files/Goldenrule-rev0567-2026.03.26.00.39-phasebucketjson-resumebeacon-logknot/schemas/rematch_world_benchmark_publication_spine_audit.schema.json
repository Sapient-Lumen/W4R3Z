{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Publication Spine Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_script",
    "bundle_receipt_path",
    "checks",
    "compiled_artifact_path",
    "decision_contract_path",
    "evidence_receipt_path",
    "focus",
    "packet_path",
    "preflight_receipt_path",
    "publication_spine_ready",
    "receipt_version",
    "rebuild_hashes",
    "recommended_next_move",
    "retained_bytes",
    "retained_hashes",
    "retained_preflight_status",
    "seed_path",
    "snapshot_date"
  ],
  "properties": {
    "analysis_script": {"type": "string"},
    "bundle_receipt_path": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_hash_matches_rebuild",
        "artifact_rebuild_matches_retained",
        "bundle_hash_matches_rebuild",
        "bundle_rebuild_matches_retained",
        "evidence_receipt_strict_coverage_passed",
        "packet_digest_matches_evidence_receipt",
        "preflight_hash_matches_rebuild",
        "preflight_rebuild_matches_retained",
        "retained_artifact_matches_bundle",
        "retained_bundle_patch_elision_ready",
        "retained_decision_digest_matches_contract",
        "retained_preflight_matches_artifact",
        "retained_preflight_ready"
      ],
      "properties": {
        "artifact_hash_matches_rebuild": {"type": "boolean"},
        "artifact_rebuild_matches_retained": {"type": "boolean"},
        "bundle_hash_matches_rebuild": {"type": "boolean"},
        "bundle_rebuild_matches_retained": {"type": "boolean"},
        "evidence_receipt_strict_coverage_passed": {"type": "boolean"},
        "packet_digest_matches_evidence_receipt": {"type": "boolean"},
        "preflight_hash_matches_rebuild": {"type": "boolean"},
        "preflight_rebuild_matches_retained": {"type": "boolean"},
        "retained_artifact_matches_bundle": {"type": "boolean"},
        "retained_bundle_patch_elision_ready": {"type": "boolean"},
        "retained_decision_digest_matches_contract": {"type": "boolean"},
        "retained_preflight_matches_artifact": {"type": "boolean"},
        "retained_preflight_ready": {"type": "boolean"}
      }
    },
    "compiled_artifact_path": {"type": "string"},
    "decision_contract_path": {"type": "string"},
    "evidence_receipt_path": {"type": "string"},
    "focus": {"type": "string"},
    "packet_path": {"type": "string"},
    "preflight_receipt_path": {"type": "string"},
    "publication_spine_ready": {"type": "boolean"},
    "receipt_version": {"type": "string"},
    "rebuild_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_receipt_sha256",
        "compiled_artifact_sha256",
        "preflight_receipt_sha256"
      ],
      "properties": {
        "bundle_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiled_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "recommended_next_move": {"type": "string"},
    "retained_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_receipt_bytes",
        "compiled_artifact_bytes",
        "durable_spine_bytes",
        "evidence_receipt_bytes",
        "packet_bytes",
        "preflight_receipt_bytes"
      ],
      "properties": {
        "bundle_receipt_bytes": {"type": "integer", "minimum": 0},
        "compiled_artifact_bytes": {"type": "integer", "minimum": 0},
        "durable_spine_bytes": {"type": "integer", "minimum": 0},
        "evidence_receipt_bytes": {"type": "integer", "minimum": 0},
        "packet_bytes": {"type": "integer", "minimum": 0},
        "preflight_receipt_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "retained_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_receipt_sha256",
        "compiled_artifact_sha256",
        "evidence_receipt_sha256",
        "packet_sha256",
        "preflight_receipt_sha256"
      ],
      "properties": {
        "bundle_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiled_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preflight_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "retained_preflight_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_decision_null_count",
        "blocking_fill_slot_count",
        "filled_world_section_count",
        "forbidden_changed_path_count"
      ],
      "properties": {
        "allowed_decision_null_count": {"type": "integer", "minimum": 0},
        "blocking_fill_slot_count": {"type": "integer", "minimum": 0},
        "filled_world_section_count": {"type": "integer", "minimum": 0},
        "forbidden_changed_path_count": {"type": "integer", "minimum": 0}
      }
    },
    "seed_path": {"type": "string"},
    "snapshot_date": {"type": "string"}
  }
}
