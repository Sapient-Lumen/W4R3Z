{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_review_queue.schema.json",
  "title": "Cooperation Benchmark Card Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_kind",
    "inventory_kind",
    "heads_register_kind",
    "counts",
    "items"
  ],
  "properties": {
    "queue_kind": {
      "const": "cooperation_benchmark_card_review_queue"
    },
    "inventory_kind": {
      "const": "cooperation_benchmark_card_inventory"
    },
    "heads_register_kind": {
      "const": "cooperation_benchmark_card_heads_register"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_items",
        "freeze_needed_item_count",
        "topology_review_item_count",
        "readiness_lint_item_count",
        "freeze_drift_item_count",
        "delta_drift_item_count"
      ],
      "properties": {
        "total_items": {"type": "integer", "minimum": 0},
        "freeze_needed_item_count": {"type": "integer", "minimum": 0},
        "topology_review_item_count": {"type": "integer", "minimum": 0},
        "readiness_lint_item_count": {"type": "integer", "minimum": 0},
        "freeze_drift_item_count": {"type": "integer", "minimum": 0},
        "delta_drift_item_count": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "item_kind",
          "reason_codes",
          "summary",
          "review_command",
          "apply_command",
          "lineage_id",
          "card_id",
          "card_path",
          "context_paths"
        ],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "item_kind": {
            "type": "string",
            "enum": [
              "freeze_needed",
              "topology_review",
              "readiness_lint",
              "freeze_drift",
              "delta_drift"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "summary": {"type": "string", "minLength": 1},
          "review_command": {"type": "string", "minLength": 1},
          "apply_command": {"type": ["string", "null"], "minLength": 1},
          "lineage_id": {"type": ["string", "null"], "minLength": 1},
          "card_id": {"type": ["string", "null"], "minLength": 1},
          "card_path": {"type": ["string", "null"], "minLength": 1},
          "context_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
