{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Report Hotspot Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "analysis_script",
    "measurement_scope",
    "package_receipt_path",
    "package_receipt_sha256",
    "report_bucket_totals",
    "hotspot_concentration",
    "largest_report_families",
    "largest_report_files",
    "priority_compaction_targets",
    "policy_checks",
    "status_counts",
    "archive_posture",
    "headline_findings",
    "recommended_next_move"
  ],
  "properties": {
    "receipt_kind": {
      "const": "archive_report_hotspot_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "minLength": 1
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "tree_root",
        "report_root",
        "output_receipt_self_excluded",
        "excluded_output_path",
        "fixed_point_excluded_paths",
        "skip_parts",
        "skip_suffixes"
      ],
      "properties": {
        "tree_root": {
          "type": "string",
          "minLength": 1
        },
        "report_root": {
          "type": "string",
          "minLength": 1
        },
        "output_receipt_self_excluded": {
          "type": "boolean"
        },
        "excluded_output_path": {
          "type": "string",
          "minLength": 1
        },
        "skip_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skip_suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixed_point_excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "package_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "package_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "report_bucket_totals": {
      "type": "object",
      "required": [
        "path",
        "file_count",
        "raw_bytes",
        "raw_mebibytes",
        "share_of_raw_tree",
        "json_md_pair_count",
        "paired_raw_bytes",
        "pair_share_of_report_bucket_raw_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "share_of_raw_tree": {
          "type": "number",
          "minimum": 0
        },
        "json_md_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "paired_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pair_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "hotspot_concentration": {
      "type": "object",
      "required": [
        "top_1_family_share_of_report_bucket_raw_bytes",
        "top_3_family_share_of_report_bucket_raw_bytes",
        "top_5_family_share_of_report_bucket_raw_bytes",
        "top_10_family_share_of_report_bucket_raw_bytes",
        "top_10_pair_family_share_of_report_bucket_raw_bytes"
      ],
      "properties": {
        "top_1_family_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "top_3_family_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "top_5_family_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "top_10_family_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "top_10_pair_family_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "largest_report_families": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "family",
          "file_count",
          "raw_bytes",
          "raw_mebibytes",
          "share_of_report_bucket_raw_bytes",
          "has_json_md_pair",
          "json_bytes",
          "md_bytes"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "file_count": {
            "type": "integer",
            "minimum": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "has_json_md_pair": {
            "type": "boolean"
          },
          "json_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "md_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "largest_report_files": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "path",
          "raw_bytes",
          "raw_mebibytes",
          "share_of_report_bucket_raw_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "priority_compaction_targets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "family",
          "raw_bytes",
          "share_of_report_bucket_raw_bytes",
          "reason"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "package_receipt_ready",
        "report_bucket_totals_match_package_receipt",
        "reports_remain_top_three_artifact_buckets",
        "hotspot_table_nonempty"
      ],
      "properties": {
        "package_receipt_ready": {
          "type": "boolean"
        },
        "report_bucket_totals_match_package_receipt": {
          "type": "boolean"
        },
        "reports_remain_top_three_artifact_buckets": {
          "type": "boolean"
        },
        "hotspot_table_nonempty": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "total_check_count",
        "ready_to_cite"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_to_cite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "prefer_citation_over_recopy",
        "intended_retention_class",
        "size_discipline_note"
      ],
      "properties": {
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "headline_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
