{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_claim_scope.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Claim Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_claim_scope_kind",
    "receipt_id",
    "journey_kind",
    "authoritative_manifest",
    "active_receipt_locator_digest_hex",
    "scope_inputs",
    "claim_scope_decision",
    "allowed_claim_classes",
    "restricted_claim_classes",
    "required_qualifiers",
    "broader_claims_requirements",
    "scope_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_claim_scope_kind": {
      "const": "successor_safe_ceremony_receipt_package_claim_scope"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "authoritative_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "active_receipt_locator_digest_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_status_card",
        "package_verification_report"
      ],
      "properties": {
        "package_status_card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_hex",
            "currently_citable"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "currently_citable": {
              "type": "boolean"
            }
          }
        },
        "package_verification_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_hex",
            "verification_decision"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verification_decision": {
              "type": "string",
              "enum": [
                "verified_python_lane_only",
                "verified_full_stack",
                "verification_failed"
              ]
            }
          }
        }
      }
    },
    "claim_scope_decision": {
      "type": "string",
      "enum": [
        "citation_allowed_non_runtime_claims_only",
        "citation_allowed_full_stack_claims",
        "citation_suspended_pending_regeneration",
        "citation_requires_reverification"
      ]
    },
    "allowed_claim_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "current_package_identity",
          "current_locator_identity",
          "current_citation_posture",
          "current_review_window",
          "python_integrity_results",
          "full_local_validation_profile",
          "rust_execution_results"
        ]
      }
    },
    "restricted_claim_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "current_package_identity",
          "current_locator_identity",
          "current_citation_posture",
          "current_review_window",
          "python_integrity_results",
          "full_local_validation_profile",
          "rust_execution_results",
          "engine_behavior_runtime_claims"
        ]
      }
    },
    "required_qualifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "broader_claims_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
