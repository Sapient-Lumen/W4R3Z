{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_promotion.schema.json",
  "title": "Successor-Safe Ceremony Receipt Promotion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_kind",
    "receipt_id",
    "journey_kind",
    "prior_receipt_locator",
    "current_receipt_locator",
    "prior_assessment_overall_status",
    "current_assessment_overall_status",
    "prior_authorization_decision",
    "current_authorization_decision",
    "closed_finding_codes",
    "carried_finding_codes",
    "newly_opened_finding_codes",
    "promotion_decision",
    "basis_checks",
    "failed_basis_codes",
    "status_change_summary",
    "review_trigger",
    "recommended_next_step"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "promotion_kind": {"const": "successor_safe_ceremony_receipt_promotion"},
    "receipt_id": {"type": "string", "minLength": 1},
    "journey_kind": {"type": "string", "enum": ["presentation", "authorization", "authentication", "issuance", "other"]},
    "prior_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ni_uri", "digest_hex", "source_path"],
      "properties": {
        "ni_uri": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"},
        "digest_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"type": "string", "minLength": 1}
      }
    },
    "current_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ni_uri", "digest_hex", "source_path"],
      "properties": {
        "ni_uri": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"},
        "digest_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"type": "string", "minLength": 1}
      }
    },
    "prior_assessment_overall_status": {"type": "string", "enum": ["pass", "warn", "fail"]},
    "current_assessment_overall_status": {"type": "string", "enum": ["pass", "warn", "fail"]},
    "prior_authorization_decision": {"type": "string", "enum": ["authorized_for_claim_ready_citation", "not_authorized_for_claim_ready_citation"]},
    "current_authorization_decision": {"type": "string", "enum": ["authorized_for_claim_ready_citation", "not_authorized_for_claim_ready_citation"]},
    "closed_finding_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "carried_finding_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "newly_opened_finding_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "promotion_decision": {"type": "string", "enum": ["promoted_to_claim_ready_citation", "already_claim_ready", "not_yet_promoted", "regressed_from_claim_ready"]},
    "basis_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "passed", "summary"],
        "properties": {
          "code": {"type": "string", "enum": ["current_authorized", "prior_not_authorized", "all_prior_nonpass_findings_closed", "no_newly_opened_findings"]},
          "passed": {"type": "boolean"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "failed_basis_codes": {"type": "array", "items": {"type": "string", "enum": ["current_authorized", "prior_not_authorized", "all_prior_nonpass_findings_closed", "no_newly_opened_findings"]}, "uniqueItems": true},
    "status_change_summary": {"type": "string", "minLength": 1},
    "review_trigger": {"type": "string", "minLength": 1},
    "recommended_next_step": {"type": "string", "minLength": 1}
  }
}
