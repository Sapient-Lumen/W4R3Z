{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_catalog.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_catalog_kind",
    "catalog_id",
    "catalog_summary",
    "package_families",
    "superseded_package_redirects",
    "catalog_links",
    "catalog_purpose"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_catalog_kind": {
      "const": "successor_safe_ceremony_receipt_package_catalog"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_family_count",
        "authoritative_head_count",
        "superseded_redirect_count"
      ],
      "properties": {
        "package_family_count": {
          "type": "integer",
          "minimum": 1
        },
        "authoritative_head_count": {
          "type": "integer",
          "minimum": 1
        },
        "superseded_redirect_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "package_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_key",
          "receipt_id",
          "journey_kind",
          "current_package_head",
          "current_package_status_card",
          "current_package_reliance_card",
          "authoritative_manifest",
          "package_lineage",
          "active_receipt_locator_digest_hex",
          "current_citation_state",
          "superseded_redirect_count",
          "member_links"
        ],
        "properties": {
          "family_key": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "journey_kind": {
            "type": "string",
            "enum": [
              "presentation",
              "authorization",
              "authentication",
              "issuance",
              "other"
            ]
          },
          "current_package_head": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "current_package_status_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "currently_citable"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "currently_citable": {
                "type": "boolean"
              }
            }
          },
          "authoritative_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "current_claim_status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "current_claim_status": {
                "type": "string",
                "enum": [
                  "claim_ready_citable",
                  "suspended_pending_regeneration"
                ]
              }
            }
          },
          "package_lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "chain_length"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "chain_length": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "active_receipt_locator_digest_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "current_citation_state": {
            "type": "string",
            "enum": [
              "citable_now",
              "suspended_pending_regeneration"
            ]
          },
          "superseded_redirect_count": {
            "type": "integer",
            "minimum": 0
          },
          "member_links": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rel",
                "target_kind",
                "path",
                "sha256_hex"
              ],
              "properties": {
                "rel": {
                  "type": "string",
                  "enum": [
                    "item",
                    "latest-version",
                    "version-history",
                    "status",
                    "describedby"
                  ]
                },
                "target_kind": {
                  "type": "string",
                  "enum": [
                    "package_head",
                    "package_manifest",
                    "package_lineage",
                    "package_status_card",
                    "package_reliance_card"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "current_package_reliance_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "reliance_decision"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reliance_decision": {
                "type": "string",
                "enum": [
                  "rely_with_non_runtime_scope_only",
                  "rely_for_full_stack_claims",
                  "rely_only_after_reverification",
                  "do_not_rely_until_regenerated"
                ]
              }
            }
          }
        }
      }
    },
    "superseded_package_redirects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_id",
          "journey_kind",
          "source_package_manifest",
          "redirect_artifact",
          "successor_package_manifest",
          "current_status",
          "reference_action"
        ],
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "journey_kind": {
            "type": "string",
            "enum": [
              "presentation",
              "authorization",
              "authentication",
              "issuance",
              "other"
            ]
          },
          "source_package_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "current_claim_status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "current_claim_status": {
                "type": "string",
                "enum": [
                  "claim_ready_citable",
                  "suspended_pending_regeneration"
                ]
              }
            }
          },
          "redirect_artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "successor_package_manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256_hex",
              "current_claim_status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "current_claim_status": {
                "type": "string",
                "enum": [
                  "claim_ready_citable",
                  "suspended_pending_regeneration"
                ]
              }
            }
          },
          "current_status": {
            "type": "string",
            "enum": [
              "claim_ready_citable",
              "suspended_pending_regeneration"
            ]
          },
          "reference_action": {
            "type": "string",
            "enum": [
              "use_current_package_head_for_package_reference",
              "consult_current_package_head_before_reuse"
            ]
          }
        }
      }
    },
    "catalog_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel",
          "target_kind",
          "path",
          "sha256_hex"
        ],
        "properties": {
          "rel": {
            "const": "item"
          },
          "target_kind": {
            "const": "package_head"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "catalog_purpose": {
      "type": "string",
      "minLength": 1
    }
  }
}
