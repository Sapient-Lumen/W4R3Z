{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_remediation_plan.schema.json",
  "title": "Successor-Safe Ceremony Receipt Remediation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "receipt_id",
    "journey_kind",
    "receipt_locator",
    "assessment_overall_status",
    "archive_admission",
    "residual_risk_response",
    "copy_forward_rule",
    "plan_status",
    "work_items",
    "promotion_gate",
    "completion_rule",
    "review_trigger"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_kind": {
      "const": "successor_safe_ceremony_receipt_remediation_plan"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ni_uri",
        "digest_hex",
        "source_path"
      ],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment_overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "archive_admission": {
      "type": "string",
      "enum": [
        "claim_ready_citable",
        "provisional_locator_only",
        "hold_for_remediation"
      ]
    },
    "residual_risk_response": {
      "type": "string",
      "enum": [
        "accept",
        "mitigate"
      ]
    },
    "copy_forward_rule": {
      "type": "string",
      "enum": [
        "cite_locator_only",
        "cite_locator_until_remediated",
        "hold_until_remediated"
      ]
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "monitor_only",
        "open"
      ]
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_code",
          "priority",
          "blocking",
          "closure_goal",
          "acceptance_test",
          "recommended_actions",
          "evidence_paths"
        ],
        "properties": {
          "finding_code": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "closure_goal": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_test": {
            "type": "string",
            "minLength": 1
          },
          "recommended_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "promotion_gate": {
      "type": "string",
      "minLength": 1
    },
    "completion_rule": {
      "type": "string",
      "minLength": 1
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    }
  }
}
