{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successor-Safe Ceremony Receipt Locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "locator_kind",
    "receipt_id",
    "canonicalization_profile",
    "digest_algorithm",
    "digest_hex",
    "ni_uri",
    "canonical_utf8_bytes",
    "source_path",
    "size_discipline_note"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "locator_kind": {"type": "string", "const": "successor_safe_ceremony_receipt_locator"},
    "receipt_id": {"type": "string", "minLength": 1},
    "canonicalization_profile": {"type": "string", "const": "restricted_jcs_utf8_v1"},
    "digest_algorithm": {"type": "string", "const": "sha-256"},
    "digest_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ni_uri": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{43}$"},
    "canonical_utf8_bytes": {"type": "integer", "minimum": 1},
    "source_path": {"type": "string", "minLength": 1},
    "size_discipline_note": {"type": "string", "minLength": 1}
  }
}
