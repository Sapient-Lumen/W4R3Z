{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_review_verdict.schema.json",
  "title": "Successor-Safe Ceremony Receipt Review Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_verdict_kind",
    "receipt_id",
    "journey_kind",
    "current_receipt_locator",
    "watch_reviewed_on",
    "watch_review_due_on",
    "as_of",
    "observed_trigger_codes",
    "matched_reopen_trigger_codes",
    "timeliness_status",
    "prior_watch_status",
    "review_decision",
    "citation_status",
    "basis_checks",
    "failed_basis_codes",
    "required_regeneration_sequence",
    "review_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_verdict_kind": {
      "const": "successor_safe_ceremony_receipt_review_verdict"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "current_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ni_uri",
        "digest_hex",
        "source_path"
      ],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "watch_reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "watch_review_due_on": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "observed_trigger_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ceremony_contract_changed",
          "protocol_surface_changed",
          "retained_evidence_changed",
          "retention_policy_changed",
          "new_nonpass_findings",
          "authorization_terms_changed",
          "review_interval_elapsed"
        ]
      }
    },
    "matched_reopen_trigger_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ceremony_contract_changed",
          "protocol_surface_changed",
          "retained_evidence_changed",
          "retention_policy_changed",
          "new_nonpass_findings",
          "authorization_terms_changed",
          "review_interval_elapsed"
        ]
      }
    },
    "timeliness_status": {
      "type": "string",
      "enum": [
        "within_interval",
        "due_today",
        "overdue"
      ]
    },
    "prior_watch_status": {
      "type": "string",
      "enum": [
        "active_watch",
        "reopen_now"
      ]
    },
    "review_decision": {
      "type": "string",
      "enum": [
        "continue_claim_ready_citation",
        "reopen_and_suspend_claim_ready_citation"
      ]
    },
    "citation_status": {
      "type": "string",
      "enum": [
        "claim_ready_citable",
        "suspended_pending_regeneration"
      ]
    },
    "basis_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "passed",
          "summary"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "watch_active_before_review",
              "within_review_interval",
              "no_reopen_trigger_observed",
              "prior_package_authorized"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failed_basis_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "watch_active_before_review",
          "within_review_interval",
          "no_reopen_trigger_observed",
          "prior_package_authorized"
        ]
      }
    },
    "required_regeneration_sequence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch"
        ]
      }
    },
    "review_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
