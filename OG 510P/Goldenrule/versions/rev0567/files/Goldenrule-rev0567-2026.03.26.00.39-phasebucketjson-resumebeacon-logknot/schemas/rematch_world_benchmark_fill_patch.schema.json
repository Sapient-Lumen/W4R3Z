{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Fill Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_state",
    "benchmark_id",
    "decision_contract_path",
    "matching_state_contract",
    "occupancy_accounting_contract",
    "paired_ranking_views_contract",
    "patch_intent",
    "patch_version",
    "seed_artifact_path",
    "turnover_tempo_contract",
    "world_semantics_contract"
  ],
  "properties": {
    "patch_version": {"const": "2026-03-16.rematch_world_benchmark_fill_patch.v1"},
    "patch_intent": {"const": "fill only the mutable seed surface, then compile back to one retained benchmark artifact"},
    "seed_artifact_path": {"const": "examples/snapshots/rematch_world_benchmark_seed.json"},
    "decision_contract_path": {"const": "artifacts/reports/rematch_decision_contract_snapshot_20260316.json"},
    "artifact_state": {"enum": ["filled_benchmark"]},
    "benchmark_id": {"type": "string", "minLength": 1},
    "world_semantics_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asymmetry_trigger_policy", "rematch_state_carry_policy", "rematch_state_reset_policy", "role_assignment_policy", "role_swapped_companion_policy", "world_name"],
      "properties": {
        "asymmetry_trigger_policy": {"type": "string", "minLength": 1},
        "rematch_state_carry_policy": {"type": "string", "minLength": 1},
        "rematch_state_reset_policy": {"type": "string", "minLength": 1},
        "role_assignment_policy": {"type": "string", "minLength": 1},
        "role_swapped_companion_policy": {"type": "string", "minLength": 1},
        "world_name": {"type": "string", "minLength": 1}
      }
    },
    "matching_state_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparability_note", "matched_state_fields", "matching_efficiency_model", "rematch_delay_rounds", "search_state_fields"],
      "properties": {
        "comparability_note": {"type": "string", "minLength": 1},
        "matched_state_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "matching_efficiency_model": {"type": "string", "minLength": 1},
        "rematch_delay_rounds": {"type": ["number", "null"]},
        "search_state_fields": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "occupancy_accounting_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_rows"],
      "properties": {
        "policy_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aggregate_avg_payoff", "dead_round_share", "in_match_avg_payoff", "matched_round_share", "policy"],
            "properties": {
              "aggregate_avg_payoff": {"type": ["number", "null"]},
              "dead_round_share": {"type": ["number", "null"]},
              "in_match_avg_payoff": {"type": ["number", "null"]},
              "matched_round_share": {"type": ["number", "null"]},
              "policy": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "turnover_tempo_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_rows"],
      "properties": {
        "policy_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["avg_match_length", "delay_or_search_dead_time", "policy", "turnover_metric_label"],
            "properties": {
              "avg_match_length": {"type": ["number", "null"]},
              "delay_or_search_dead_time": {"type": ["number", "null"]},
              "policy": {"type": "string", "minLength": 1},
              "turnover_metric_label": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "paired_ranking_views_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaderboard_rows"],
      "properties": {
        "leaderboard_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aggregate_avg_payoff", "aggregate_rank", "in_match_avg_payoff", "in_match_rank", "policy"],
            "properties": {
              "aggregate_avg_payoff": {"type": ["number", "null"]},
              "aggregate_rank": {"type": ["integer", "null"]},
              "in_match_avg_payoff": {"type": ["number", "null"]},
              "in_match_rank": {"type": ["integer", "null"]},
              "policy": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
