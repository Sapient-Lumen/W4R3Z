{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_redirect.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Redirect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_redirect_kind",
    "receipt_id",
    "journey_kind",
    "source_package_manifest",
    "preferred_reference_target",
    "successor_package_manifest",
    "supporting_status_card",
    "redirect_basis",
    "ceremony_locator_guidance",
    "redirect_links",
    "redirect_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_redirect_kind": {
      "const": "successor_safe_ceremony_receipt_package_redirect"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "source_package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "preferred_reference_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "path",
        "sha256_hex",
        "reference_action"
      ],
      "properties": {
        "target_kind": {
          "const": "package_head"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_action": {
          "type": "string",
          "enum": [
            "use_current_package_head_for_package_reference",
            "consult_current_package_head_before_reuse"
          ]
        }
      }
    },
    "successor_package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "supporting_status_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "currently_citable"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "currently_citable": {
          "type": "boolean"
        }
      }
    },
    "redirect_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersession_path",
        "supersession_sha256_hex",
        "continuity",
        "supersession_reason_codes",
        "current_review_decision",
        "current_advisory_decision"
      ],
      "properties": {
        "supersession_path": {
          "type": "string",
          "minLength": 1
        },
        "supersession_sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "continuity": {
          "type": "string",
          "enum": [
            "same_receipt_locator",
            "rekeyed_receipt_locator"
          ]
        },
        "supersession_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "review_window_renewed",
              "freshness_artifacts_replaced",
              "claim_status_changed",
              "package_state_changed",
              "receipt_locator_rekeyed"
            ]
          }
        },
        "current_review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "current_advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        }
      }
    },
    "ceremony_locator_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_locator_digest_hex",
        "existing_citations_action",
        "new_citations_action"
      ],
      "properties": {
        "preferred_locator_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "existing_citations_action": {
          "type": "string",
          "enum": [
            "keep",
            "flag_for_withdrawal"
          ]
        },
        "new_citations_action": {
          "type": "string",
          "enum": [
            "cite_reviewed_locator",
            "suspend_until_regenerated"
          ]
        }
      }
    },
    "redirect_links": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel",
          "target_kind",
          "path",
          "sha256_hex"
        ],
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "cite-as",
              "successor-version",
              "latest-version",
              "status",
              "describedby"
            ]
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "package_head",
              "package_manifest",
              "package_status_card",
              "package_supersession"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "redirect_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
