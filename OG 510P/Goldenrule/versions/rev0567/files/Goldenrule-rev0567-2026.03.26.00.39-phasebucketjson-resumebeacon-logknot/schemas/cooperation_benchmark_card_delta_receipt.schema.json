{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooperation Benchmark Card Delta Receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_kind": {
      "const": "cooperation_benchmark_card_delta_receipt"
    },
    "old_card_id": {
      "type": "string",
      "minLength": 1
    },
    "new_card_id": {
      "type": "string",
      "minLength": 1
    },
    "old_card_path": {
      "type": "string",
      "minLength": 1
    },
    "old_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_card_path": {
      "type": "string",
      "minLength": 1
    },
    "new_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_field_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_surface_changed_field_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata_only_changed_field_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_surface_changed": {
      "type": "boolean"
    },
    "delta_tool_path": {
      "type": "string",
      "minLength": 1
    },
    "delta_tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "receipt_kind",
    "old_card_id",
    "new_card_id",
    "old_card_path",
    "old_card_sha256",
    "new_card_path",
    "new_card_sha256",
    "changed_field_paths",
    "claim_surface_changed_field_paths",
    "metadata_only_changed_field_paths",
    "claim_surface_changed",
    "delta_tool_path",
    "delta_tool_sha256"
  ]
}
