{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_execution_lanes.schema.json",
  "title": "Cooperation Benchmark Card Execution Lanes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_surface_kind",
    "preferred_for_environment_handoff",
    "observation",
    "counts",
    "preferred_lane_id",
    "recommended_entrypoints",
    "lanes"
  ],
  "properties": {
    "execution_surface_kind": {"const": "cooperation_benchmark_card_execution_lanes"},
    "preferred_for_environment_handoff": {"const": true},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python3_path",
        "python3_version",
        "jsonschema_available",
        "git_path",
        "git_version",
        "native_cargo_path",
        "native_cargo_version",
        "native_rustc_path",
        "native_rustc_version",
        "junest_bin_path",
        "junest_home_path",
        "junest_home_present",
        "junest_cargo_version",
        "junest_rustc_version",
        "junest_rust_available",
        "rust_exec_path",
        "rust_exec_present"
      ],
      "properties": {
        "python3_path": {"type": ["string", "null"], "minLength": 1},
        "python3_version": {"type": ["string", "null"], "minLength": 1},
        "jsonschema_available": {"type": "boolean"},
        "git_path": {"type": ["string", "null"], "minLength": 1},
        "git_version": {"type": ["string", "null"], "minLength": 1},
        "native_cargo_path": {"type": ["string", "null"], "minLength": 1},
        "native_cargo_version": {"type": ["string", "null"], "minLength": 1},
        "native_rustc_path": {"type": ["string", "null"], "minLength": 1},
        "native_rustc_version": {"type": ["string", "null"], "minLength": 1},
        "junest_bin_path": {"type": ["string", "null"], "minLength": 1},
        "junest_home_path": {"type": "string", "minLength": 1},
        "junest_home_present": {"type": "boolean"},
        "junest_cargo_version": {"type": ["string", "null"], "minLength": 1},
        "junest_rustc_version": {"type": ["string", "null"], "minLength": 1},
        "junest_rust_available": {"type": "boolean"},
        "rust_exec_path": {"type": "string", "minLength": 1},
        "rust_exec_present": {"type": "boolean"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_lane_count", "blocked_lane_count"],
      "properties": {
        "available_lane_count": {"type": "integer", "minimum": 0},
        "blocked_lane_count": {"type": "integer", "minimum": 0}
      }
    },
    "preferred_lane_id": {"type": "string", "minLength": 1},
    "recommended_entrypoints": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lanes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "lane_kind",
          "summary",
          "available",
          "availability_basis",
          "required_capabilities",
          "blocking_reason_codes",
          "entrypoint_commands",
          "verification_commands",
          "recovery_commands",
          "handoff_paths"
        ],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1},
          "lane_kind": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "available": {"type": "boolean"},
          "availability_basis": {"type": "string", "minLength": 1},
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "blocking_reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "entrypoint_commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "verification_commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "recovery_commands": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "handoff_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
