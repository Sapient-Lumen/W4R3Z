{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Retention Exit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_script",
    "audit_receipt_path",
    "bundle_receipt_path",
    "compiled_artifact_path",
    "decision_contract_path",
    "durable_retained_objects",
    "evidence_receipt_path",
    "exit_conditions",
    "exit_ready_transient_objects",
    "focus",
    "packet_path",
    "preflight_receipt_path",
    "receipt_version",
    "recommended_next_move",
    "retained_byte_totals",
    "seed_path",
    "snapshot_date"
  ],
  "properties": {
    "analysis_script": {"type": "string"},
    "audit_receipt_path": {"type": "string"},
    "bundle_receipt_path": {"type": "string"},
    "compiled_artifact_path": {"type": "string"},
    "decision_contract_path": {"type": "string"},
    "durable_retained_objects": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_count", "label", "path", "retention_class", "sha256"],
        "properties": {
          "byte_count": {"type": "integer", "minimum": 0},
          "label": {"type": "string"},
          "path": {"type": "string"},
          "retention_class": {"type": "string", "enum": ["durable_retained"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_receipt_path": {"type": "string"},
    "exit_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_patch_elision_ready",
        "evidence_receipt_strict_coverage_passed",
        "publication_spine_ready",
        "retained_preflight_ready",
        "retention_exit_ready",
        "scratch_hashes_match_receipt_now"
      ],
      "properties": {
        "bundle_patch_elision_ready": {"type": "boolean"},
        "evidence_receipt_strict_coverage_passed": {"type": "boolean"},
        "publication_spine_ready": {"type": "boolean"},
        "retained_preflight_ready": {"type": "boolean"},
        "retention_exit_ready": {"type": "boolean"},
        "scratch_hashes_match_receipt_now": {"type": "boolean"}
      }
    },
    "exit_ready_transient_objects": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_count", "exit_ready", "label", "path", "retention_class", "sha256"],
        "properties": {
          "byte_count": {"type": "integer", "minimum": 0},
          "exit_ready": {"type": "boolean"},
          "label": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "retention_class": {"type": "string", "enum": ["reconstructible_intermediate", "scratch_exit_candidate"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "focus": {"type": "string"},
    "packet_path": {"type": "string"},
    "preflight_receipt_path": {"type": "string"},
    "receipt_version": {"type": "string"},
    "recommended_next_move": {"type": "string"},
    "retained_byte_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durable_publication_spine_bytes",
        "retained_publication_set_bytes",
        "transient_exit_bytes",
        "transient_exit_share_of_publication_lifecycle"
      ],
      "properties": {
        "durable_publication_spine_bytes": {"type": "integer", "minimum": 0},
        "retained_publication_set_bytes": {"type": "integer", "minimum": 0},
        "transient_exit_bytes": {"type": "integer", "minimum": 0},
        "transient_exit_share_of_publication_lifecycle": {"type": "number", "minimum": 0}
      }
    },
    "seed_path": {"type": "string"},
    "snapshot_date": {"type": "string"}
  }
}
