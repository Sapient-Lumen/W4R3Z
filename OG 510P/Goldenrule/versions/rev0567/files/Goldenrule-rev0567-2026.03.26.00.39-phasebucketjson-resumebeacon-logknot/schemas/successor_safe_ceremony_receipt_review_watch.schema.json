{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_review_watch.schema.json",
  "title": "Successor-Safe Ceremony Receipt Review Watch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_watch_kind",
    "receipt_id",
    "journey_kind",
    "current_receipt_locator",
    "authorization_decision",
    "promotion_decision",
    "reviewed_on",
    "max_review_interval_days",
    "review_due_on",
    "watch_status",
    "review_trigger",
    "event_trigger_codes",
    "required_regeneration_sequence",
    "basis_checks",
    "failed_basis_codes",
    "watch_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_watch_kind": {
      "const": "successor_safe_ceremony_receipt_review_watch"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "current_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ni_uri",
        "digest_hex",
        "source_path"
      ],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization_decision": {
      "type": "string",
      "enum": [
        "authorized_for_claim_ready_citation",
        "not_authorized_for_claim_ready_citation"
      ]
    },
    "promotion_decision": {
      "type": "string",
      "enum": [
        "promoted_to_claim_ready_citation",
        "already_claim_ready",
        "regressed_from_claim_ready",
        "not_yet_promoted"
      ]
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "max_review_interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3660
    },
    "review_due_on": {
      "type": "string",
      "format": "date"
    },
    "watch_status": {
      "type": "string",
      "enum": [
        "active_watch",
        "reopen_now"
      ]
    },
    "review_trigger": {
      "type": "string",
      "minLength": 1
    },
    "event_trigger_codes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": [
          "ceremony_contract_changed",
          "protocol_surface_changed",
          "retained_evidence_changed",
          "retention_policy_changed",
          "new_nonpass_findings",
          "authorization_terms_changed",
          "review_interval_elapsed"
        ]
      }
    },
    "required_regeneration_sequence": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "enum": [
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch"
        ]
      }
    },
    "basis_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "passed",
          "summary"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "current_authorized",
              "promotion_clean_or_continuity",
              "review_due_after_reviewed_on",
              "explicit_review_trigger_present"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failed_basis_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "current_authorized",
          "promotion_clean_or_continuity",
          "review_due_after_reviewed_on",
          "explicit_review_trigger_present"
        ]
      }
    },
    "watch_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
