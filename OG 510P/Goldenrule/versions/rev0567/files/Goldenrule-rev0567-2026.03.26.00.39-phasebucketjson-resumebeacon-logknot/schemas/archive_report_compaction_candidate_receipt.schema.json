{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Report Compaction Candidate Receipt",
  "type": "object",
  "required": [
    "analysis_script",
    "archive_posture",
    "headline_findings",
    "hotspot_receipt_path",
    "hotspot_receipt_sha256",
    "measurement_scope",
    "policy_checks",
    "priority_candidates",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "semantic_handle_receipt_path",
    "semantic_handle_receipt_sha256",
    "status_counts",
    "summary_metrics"
  ],
  "properties": {
    "receipt_kind": {
      "const": "archive_report_compaction_candidate_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "const": "scripts/tools/build_archive_report_compaction_candidate_receipt.py"
    },
    "hotspot_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "hotspot_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_handle_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "semantic_handle_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "candidate_search_roots",
        "excluded_handle_paths",
        "max_backing_handles_per_family",
        "primary_doc_paths"
      ],
      "properties": {
        "candidate_search_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_doc_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_handle_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_backing_handles_per_family": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "summary_metrics": {
      "type": "object",
      "required": [
        "priority_candidate_count",
        "priority_candidate_pair_count",
        "priority_candidate_raw_bytes",
        "priority_candidate_raw_mebibytes",
        "priority_candidate_share_of_report_bucket_raw_bytes",
        "priority_candidates_using_semantic_alias_count",
        "priority_candidates_with_library_topic_count",
        "priority_candidates_with_snapshot_count"
      ],
      "properties": {
        "priority_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "priority_candidate_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "priority_candidate_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "priority_candidate_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "priority_candidate_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "priority_candidates_with_library_topic_count": {
          "type": "integer",
          "minimum": 0
        },
        "priority_candidates_with_snapshot_count": {
          "type": "integer",
          "minimum": 0
        },
        "priority_candidates_using_semantic_alias_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "priority_candidates": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backing_handle_count",
          "backing_handle_kinds",
          "backing_handles",
          "compaction_readiness",
          "family",
          "file_count",
          "has_json_md_pair",
          "rationale",
          "raw_bytes",
          "raw_mebibytes",
          "semantic_alias_handle_count",
          "semantic_alias_used",
          "share_of_report_bucket_raw_bytes"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "file_count": {
            "type": "integer",
            "minimum": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "has_json_md_pair": {
            "type": "boolean"
          },
          "backing_handle_count": {
            "type": "integer",
            "minimum": 1
          },
          "backing_handle_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "doc",
                "library_topic",
                "snapshot"
              ]
            },
            "uniqueItems": true
          },
          "backing_handles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "doc",
                    "library_topic",
                    "snapshot"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "semantic_alias_used": {
            "type": "boolean"
          },
          "semantic_alias_handle_count": {
            "type": "integer",
            "minimum": 0
          },
          "compaction_readiness": {
            "type": "string",
            "enum": [
              "artifact_backed",
              "artifact_backed_pair",
              "citation_ready",
              "citation_ready_pair",
              "doc_backed"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "priority_candidates_need_no_new_library_topics",
        "hotspot_receipt_ready",
        "priority_candidates_all_have_backing_handles",
        "priority_candidates_are_hotspot_families",
        "priority_candidates_nonempty",
        "priority_candidates_sorted_by_readiness_then_size",
        "semantic_handle_receipt_ready"
      ],
      "properties": {
        "hotspot_receipt_ready": {
          "type": "boolean"
        },
        "semantic_handle_receipt_ready": {
          "type": "boolean"
        },
        "priority_candidates_nonempty": {
          "type": "boolean"
        },
        "priority_candidates_all_have_backing_handles": {
          "type": "boolean"
        },
        "priority_candidates_are_hotspot_families": {
          "type": "boolean"
        },
        "priority_candidates_sorted_by_readiness_then_size": {
          "type": "boolean"
        },
        "priority_candidates_need_no_new_library_topics": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_to_cite": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "properties": {
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "headline_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
