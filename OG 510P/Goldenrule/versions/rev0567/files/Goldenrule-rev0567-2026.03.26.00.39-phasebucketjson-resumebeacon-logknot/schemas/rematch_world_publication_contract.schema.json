{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Publication Contract Snapshot",
  "type": "object",
  "required": [
    "focus",
    "snapshot_date",
    "gap_id",
    "gap_summary",
    "publication_contract_shape",
    "question_rows",
    "section_rows",
    "layer_rows",
    "status_counts",
    "main_findings",
    "recommended_next_move",
    "analysis_script",
    "schema_path",
    "validator_path"
  ],
  "properties": {
    "focus": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "minLength": 1},
    "gap_id": {"const": "SG-003"},
    "gap_summary": {"type": "string", "minLength": 1},
    "publication_contract_shape": {
      "type": "object",
      "required": [
        "benchmark_kind",
        "required_sections",
        "section_count",
        "resolves_question_count",
        "post_canonicalization_question_count",
        "decision_contract_path",
        "decision_contract_schema_path",
        "decision_contract_validator_path"
      ],
      "properties": {
        "benchmark_kind": {"const": "endogenous_rematch_world_publication_contract"},
        "required_sections": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "world_semantics_contract",
              "matching_state_contract",
              "occupancy_accounting_contract",
              "turnover_tempo_contract",
              "paired_ranking_views_contract",
              "compact_decision_bundle"
            ]
          }
        },
        "section_count": {"type": "integer", "minimum": 1},
        "resolves_question_count": {"type": "integer", "minimum": 1},
        "post_canonicalization_question_count": {"type": "integer", "minimum": 1},
        "decision_contract_path": {"type": "string", "minLength": 1},
        "decision_contract_schema_path": {"type": "string", "minLength": 1},
        "decision_contract_validator_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "question_rows": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "question_summary",
          "linked_assumption_id",
          "linked_assumption_summary",
          "contract_section",
          "minimal_fields",
          "section_publication_fields",
          "source_artifacts",
          "schema_specified",
          "validator_enforced",
          "world_benchmark_emitted",
          "status",
          "question_exit_gap",
          "assumption_exit_gap"
        ],
        "properties": {
          "question_id": {"type": "string", "pattern": "^SQ-0(1[2-9]|2[0-6])$"},
          "question_summary": {"type": "string", "minLength": 1},
          "linked_assumption_id": {"type": "string", "pattern": "^SA-0(1[1-9]|2[0-5])$"},
          "linked_assumption_summary": {"type": "string", "minLength": 1},
          "contract_section": {
            "type": "string",
            "enum": [
              "world_semantics_contract",
              "matching_state_contract",
              "occupancy_accounting_contract",
              "turnover_tempo_contract",
              "paired_ranking_views_contract",
              "compact_decision_bundle"
            ]
          },
          "minimal_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "section_publication_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "schema_specified": {"type": "boolean"},
          "validator_enforced": {"type": "boolean"},
          "world_benchmark_emitted": {"type": "boolean"},
          "status": {"type": "string", "minLength": 1},
          "question_exit_gap": {"type": "string", "minLength": 1},
          "assumption_exit_gap": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "section_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "contract_section",
          "question_ids",
          "question_count",
          "minimum_shape",
          "section_publication_fields",
          "world_benchmark_emitted"
        ],
        "properties": {
          "contract_section": {
            "type": "string",
            "enum": [
              "world_semantics_contract",
              "matching_state_contract",
              "occupancy_accounting_contract",
              "turnover_tempo_contract",
              "paired_ranking_views_contract",
              "compact_decision_bundle"
            ]
          },
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SQ-0(1[2-9]|2[0-6])$"}
          },
          "question_count": {"type": "integer", "minimum": 1},
          "minimum_shape": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer", "minimum": 1}
          },
          "section_publication_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "world_benchmark_emitted": {"type": "boolean"},
          "decision_contract_path": {"type": "string", "minLength": 1},
          "decision_contract_schema_path": {"type": "string", "minLength": 1},
          "decision_contract_validator_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "layer_rows": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["layer", "question_ids", "section_count", "why_it_exists"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SQ-0(1[2-9]|2[0-6])$"}
          },
          "section_count": {"type": "integer", "minimum": 1},
          "why_it_exists": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "schema_specified_and_validator_enforced",
        "world_benchmark_pending",
        "newly_schema_specified_world_questions",
        "decision_bundle_questions"
      ],
      "properties": {
        "schema_specified_and_validator_enforced": {"type": "integer", "minimum": 1},
        "world_benchmark_pending": {"type": "integer", "minimum": 1},
        "newly_schema_specified_world_questions": {"type": "integer", "minimum": 1},
        "decision_bundle_questions": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "main_findings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_next_move": {"type": "string", "minLength": 1},
    "analysis_script": {"type": "string", "minLength": 1},
    "schema_path": {"type": "string", "minLength": 1},
    "validator_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
