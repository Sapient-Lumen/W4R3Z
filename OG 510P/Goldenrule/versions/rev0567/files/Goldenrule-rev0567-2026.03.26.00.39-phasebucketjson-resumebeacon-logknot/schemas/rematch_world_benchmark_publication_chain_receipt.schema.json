{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Publication Chain Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "analysis_script",
    "chain_links",
    "compiled_artifact_path",
    "compiled_artifact_sha256",
    "coverage",
    "status_counts",
    "archive_posture",
    "recommended_next_move"
  ],
  "properties": {
    "receipt_kind": { "const": "rematch_world_benchmark_publication_chain_receipt" },
    "receipt_version": { "type": "string", "minLength": 1 },
    "analysis_script": { "type": "string", "minLength": 1 },
    "chain_links": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["stage", "path", "sha256", "ready"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "ready": { "type": "boolean" },
          "summary": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "compiled_artifact_path": { "type": "string", "minLength": 1 },
    "compiled_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coverage": {
      "type": "object",
      "required": ["copied_frozen_section_count", "durable_publication_object_count", "question_id_count", "question_id_range_summary", "question_ids"],
      "properties": {
        "copied_frozen_section_count": { "type": "integer", "minimum": 1 },
        "durable_publication_object_count": { "type": "integer", "minimum": 1 },
        "question_id_count": { "type": "integer", "minimum": 1 },
        "question_id_range_summary": { "type": "string", "minLength": 1 },
        "question_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": true
    },
    "status_counts": {
      "type": "object",
      "required": ["ready_link_count", "total_link_count", "transient_cleared_count", "overall_chain_ready"],
      "properties": {
        "ready_link_count": { "type": "integer", "minimum": 0 },
        "total_link_count": { "type": "integer", "minimum": 1 },
        "transient_cleared_count": { "type": "integer", "minimum": 0 },
        "overall_chain_ready": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "archive_posture": {
      "type": "object",
      "required": ["prefer_citation_over_recopy", "intended_retention_class", "size_discipline_note"],
      "properties": {
        "prefer_citation_over_recopy": { "type": "boolean" },
        "intended_retention_class": { "type": "string", "minLength": 1 },
        "size_discipline_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "recommended_next_move": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
