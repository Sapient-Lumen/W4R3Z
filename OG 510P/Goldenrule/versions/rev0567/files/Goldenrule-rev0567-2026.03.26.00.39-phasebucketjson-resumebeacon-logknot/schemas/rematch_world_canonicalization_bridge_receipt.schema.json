{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Canonicalization Bridge Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "scope",
    "linked_open_items",
    "planner_contract",
    "zero_noise_classifier_contract",
    "retained_artifacts",
    "carry_forward_rules",
    "must_regenerate_when",
    "do_not_carry_forward",
    "recommended_next_moves",
    "archive_posture"
  ],
  "properties": {
    "receipt_kind": {
      "const": "rematch_world_canonicalization_bridge_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "gap_id",
        "focus_layer",
        "generated_on",
        "provisional_scope_note",
        "linked_open_item_count"
      ],
      "properties": {
        "gap_id": { "type": "string", "minLength": 1 },
        "focus_layer": { "type": "string", "minLength": 1 },
        "generated_on": { "type": "string", "minLength": 1 },
        "provisional_scope_note": { "type": "string", "minLength": 1 },
        "linked_open_item_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "linked_open_items": {
      "type": "object",
      "required": ["assumptions", "questions", "risks"],
      "properties": {
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "summary", "primary_evidence_link"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "primary_evidence_link": { "type": "string", "minLength": 1 },
              "target_resolution": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "summary", "primary_evidence_link"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "primary_evidence_link": { "type": "string", "minLength": 1 },
              "target_resolution": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "severity", "likelihood", "summary", "primary_evidence_link"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "minLength": 1 },
              "likelihood": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "primary_evidence_link": { "type": "string", "minLength": 1 },
              "review_date": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "planner_contract": {
      "type": "object",
      "required": ["source_artifact", "naive_cache_plan", "mode_rows"],
      "properties": {
        "source_artifact": { "type": "string", "minLength": 1 },
        "naive_cache_plan": {
          "type": "object",
          "required": ["key_fields", "horizon", "signature_slots", "key_depth_slots"],
          "properties": {
            "key_fields": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "horizon": { "type": "integer", "minimum": 1 },
            "signature_slots": { "type": "integer", "minimum": 1 },
            "key_depth_slots": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        "mode_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "planner_kind",
              "recommended_key_fields",
              "minimal_exact_horizon",
              "regime_count",
              "optimized_key_depth_slots",
              "key_depth_reduction_factor"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "planner_kind": { "type": "string", "minLength": 1 },
              "recommended_key_fields": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "minimal_exact_horizon": { "type": "integer", "minimum": 1 },
              "regime_count": { "type": "integer", "minimum": 1 },
              "optimized_key_depth_slots": { "type": "integer", "minimum": 1 },
              "key_depth_reduction_factor": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "zero_noise_classifier_contract": {
      "type": "object",
      "required": [
        "source_artifact",
        "schema_path",
        "validator_path",
        "ordered_rule_count",
        "support_signature_count",
        "dispatch_surface_reduction_factor"
      ],
      "properties": {
        "source_artifact": { "type": "string", "minLength": 1 },
        "schema_path": { "type": "string", "minLength": 1 },
        "validator_path": { "type": "string", "minLength": 1 },
        "ordered_rule_count": { "type": "integer", "minimum": 1 },
        "support_signature_count": { "type": "integer", "minimum": 1 },
        "dispatch_surface_reduction_factor": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "retained_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "carry_forward_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "must_regenerate_when": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "do_not_carry_forward": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_next_moves": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "prefer_citation_over_recopy",
        "intended_retention_class",
        "size_discipline_note"
      ],
      "properties": {
        "prefer_citation_over_recopy": { "type": "boolean" },
        "intended_retention_class": { "type": "string", "minLength": 1 },
        "size_discipline_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
