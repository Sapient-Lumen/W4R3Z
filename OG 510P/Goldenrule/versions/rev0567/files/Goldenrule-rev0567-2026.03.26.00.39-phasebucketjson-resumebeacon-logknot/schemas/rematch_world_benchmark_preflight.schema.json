{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_script",
    "artifact_fingerprints",
    "artifact_state",
    "blocking_slot_rows",
    "completion_ready",
    "decision_bundle_digest_matches_contract",
    "decision_contract_path",
    "filled_world_sections",
    "focus",
    "forbidden_changed_path_rows",
    "inspection_mode",
    "inspection_target_path",
    "mutation_surface_ok",
    "pending_world_sections",
    "preflight_ready",
    "recommended_next_move",
    "seed_path",
    "snapshot_date",
    "status_counts",
    "strict_mode_would_pass"
  ],
  "properties": {
    "analysis_script": {
      "type": "string"
    },
    "artifact_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "compact_decision_bundle_sha256",
        "frozen_surface_sha256",
        "standing_decision_contract_sha256"
      ],
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compact_decision_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozen_surface_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "standing_decision_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocking_slot_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "blocker_kind",
          "current_value_summary",
          "linked_question_ids",
          "path",
          "section"
        ],
        "properties": {
          "blocker_kind": {
            "type": "string"
          },
          "current_value_summary": {
            "type": "string"
          },
          "linked_question_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "completion_ready": {
      "type": "boolean"
    },
    "decision_bundle_digest_matches_contract": {
      "type": "boolean"
    },
    "decision_contract_path": {
      "type": "string"
    },
    "filled_world_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus": {
      "type": "string"
    },
    "forbidden_changed_path_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "frozen_kind",
          "matched_frozen_prefix",
          "path",
          "reason"
        ],
        "properties": {
          "frozen_kind": {
            "type": "string"
          },
          "matched_frozen_prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "inspection_mode": {
      "type": "string",
      "enum": [
        "artifact",
        "patch_compile"
      ]
    },
    "inspection_target_path": {
      "type": "string"
    },
    "mutation_surface_ok": {
      "type": "boolean"
    },
    "pending_world_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preflight_ready": {
      "type": "boolean"
    },
    "recommended_next_move": {
      "type": "string"
    },
    "seed_path": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string"
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_changed_path_count",
        "allowed_decision_null_count",
        "blocking_fill_slot_count",
        "filled_world_section_count",
        "forbidden_changed_path_count",
        "null_blocker_count",
        "pending_world_section_status_count",
        "template_blocker_count",
        "unchanged_required_mutation_prefix_count"
      ],
      "properties": {
        "allowed_changed_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "allowed_decision_null_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_fill_slot_count": {
          "type": "integer",
          "minimum": 0
        },
        "filled_world_section_count": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_changed_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "null_blocker_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_world_section_status_count": {
          "type": "integer",
          "minimum": 0
        },
        "template_blocker_count": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged_required_mutation_prefix_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "strict_mode_would_pass": {
      "type": "boolean"
    },
    "compiled_candidate_artifact_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "patch_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "strict_mode_exit_code_if_run_now": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    }
  }
}
