{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_citation_surface.schema.json",
  "title": "Cooperation Benchmark Card Citation Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "inventory_kind",
    "heads_register_kind",
    "counts",
    "entries",
    "unresolved_lineages"
  ],
  "properties": {
    "surface_kind": {
      "const": "cooperation_benchmark_card_citation_surface"
    },
    "inventory_kind": {
      "const": "cooperation_benchmark_card_inventory"
    },
    "heads_register_kind": {
      "const": "cooperation_benchmark_card_heads_register"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_count",
        "citation_lineage_count",
        "unresolved_lineage_count",
        "citation_entry_count"
      ],
      "properties": {
        "lineage_count": {"type": "integer", "minimum": 0},
        "citation_lineage_count": {"type": "integer", "minimum": 0},
        "unresolved_lineage_count": {"type": "integer", "minimum": 0},
        "citation_entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineage_id",
          "benchmark_name",
          "card_id",
          "card_path",
          "rendered_markdown_path",
          "freeze_receipt_path",
          "card_sha256",
          "rendered_markdown_sha256",
          "card_schema_path",
          "card_schema_sha256",
          "freeze_tool_path",
          "freeze_tool_sha256"
        ],
        "properties": {
          "lineage_id": {"type": "string", "minLength": 1},
          "benchmark_name": {"type": "string", "minLength": 1},
          "card_id": {"type": "string", "minLength": 1},
          "card_path": {"type": "string", "minLength": 1},
          "rendered_markdown_path": {"type": "string", "minLength": 1},
          "freeze_receipt_path": {"type": "string", "minLength": 1},
          "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rendered_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "card_schema_path": {"type": "string", "minLength": 1},
          "card_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "freeze_tool_path": {"type": "string", "minLength": 1},
          "freeze_tool_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "unresolved_lineages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineage_id",
          "reason_codes",
          "operational_head_card_ids",
          "citation_head_card_ids",
          "card_paths"
        ],
        "properties": {
          "lineage_id": {"type": "string", "minLength": 1},
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "operational_head_card_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "citation_head_card_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "card_paths": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
