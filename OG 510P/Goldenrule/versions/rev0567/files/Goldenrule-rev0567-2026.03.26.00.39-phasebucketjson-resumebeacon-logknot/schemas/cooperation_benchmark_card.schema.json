{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooperation Benchmark Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "benchmark_name", "result_kind", "comparison_license", "lane_contract", "score_construction", "metric_governance", "uncertainty_and_dependence", "variant_selection", "evaluated_subject", "environment_and_knowledge", "execution_budget", "scenario_sampling", "failure_handling", "adjudication"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "benchmark_name": {"type": "string", "minLength": 1},
    "result_kind": {"type": "string", "enum": ["comparative", "descriptive", "method_note"]},
    "comparison_license": {"$ref": "#/$defs/comparison_license"},
    "lane_contract": {"$ref": "#/$defs/lane_contract"},
    "score_construction": {"$ref": "#/$defs/score_construction"},
    "metric_governance": {"$ref": "#/$defs/metric_governance"},
    "uncertainty_and_dependence": {"$ref": "#/$defs/uncertainty_and_dependence"},
    "variant_selection": {"$ref": "#/$defs/variant_selection"},
    "evaluated_subject": {"$ref": "#/$defs/evaluated_subject"},
    "environment_and_knowledge": {"$ref": "#/$defs/environment_and_knowledge"},
    "execution_budget": {"$ref": "#/$defs/execution_budget"},
    "scenario_sampling": {"$ref": "#/$defs/scenario_sampling"},
    "failure_handling": {"$ref": "#/$defs/failure_handling"},
    "adjudication": {"$ref": "#/$defs/adjudication"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1},
    "comparison_license": {
      "type": "object", "additionalProperties": false,
      "required": ["headline_comparison_licensed", "headline_comparison_not_licensed_without_further_justification"],
      "properties": {
        "headline_comparison_licensed": {"$ref": "#/$defs/nonempty_string"},
        "headline_comparison_not_licensed_without_further_justification": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "lane_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["counterpart_class_and_mix_rule", "counterpart_class_x_novelty_axis_coverage", "cold_start_familiarized_coadaptive_status", "same_partner_continuation_vs_fresh_partner_transfer", "role_seat_assignment_and_side_switch_policy", "information_visibility_and_asymmetry_regime", "communication_schedule_and_channel_rights", "interaction_language_translation_localization_and_pooling_rule", "interaction_horizon_stopping_rule_and_termination_knowledge", "intervention_rights_delegation_policy_and_final_action_authority", "process_aware_vs_outcome_only_interpretation", "human_lane_type_proxy_provenance_and_real_human_escalation_status", "counterpart_disclosure_blinding_and_participant_belief_protocol", "participant_pool_provenance_country_mix_eligibility_and_repeat_exposure_policy", "material_payoff_matrix_stake_mapping_and_comprehension_protocol"],
      "properties": {
        "counterpart_class_and_mix_rule": {"$ref": "#/$defs/nonempty_string"},
        "counterpart_class_x_novelty_axis_coverage": {"$ref": "#/$defs/nonempty_string"},
        "cold_start_familiarized_coadaptive_status": {"$ref": "#/$defs/nonempty_string"},
        "same_partner_continuation_vs_fresh_partner_transfer": {"$ref": "#/$defs/nonempty_string"},
        "role_seat_assignment_and_side_switch_policy": {"$ref": "#/$defs/nonempty_string"},
        "information_visibility_and_asymmetry_regime": {"$ref": "#/$defs/nonempty_string"},
        "communication_schedule_and_channel_rights": {"$ref": "#/$defs/nonempty_string"},
        "interaction_language_translation_localization_and_pooling_rule": {"$ref": "#/$defs/nonempty_string"},
        "interaction_horizon_stopping_rule_and_termination_knowledge": {"$ref": "#/$defs/nonempty_string"},
        "intervention_rights_delegation_policy_and_final_action_authority": {"$ref": "#/$defs/nonempty_string"},
        "process_aware_vs_outcome_only_interpretation": {"$ref": "#/$defs/nonempty_string"},
        "human_lane_type_proxy_provenance_and_real_human_escalation_status": {"$ref": "#/$defs/nonempty_string"},
        "counterpart_disclosure_blinding_and_participant_belief_protocol": {"$ref": "#/$defs/nonempty_string"},
        "participant_pool_provenance_country_mix_eligibility_and_repeat_exposure_policy": {"$ref": "#/$defs/nonempty_string"},
        "material_payoff_matrix_stake_mapping_and_comprehension_protocol": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "score_construction": {"type": "object", "additionalProperties": false, "required": ["scored_unit_unit_of_analysis", "pooling_weighting_censoring_rule", "primary_estimand"], "properties": {"scored_unit_unit_of_analysis": {"$ref": "#/$defs/nonempty_string"}, "pooling_weighting_censoring_rule": {"$ref": "#/$defs/nonempty_string"}, "primary_estimand": {"$ref": "#/$defs/nonempty_string"}}},
    "metric_governance": {"type": "object", "additionalProperties": false, "required": ["primary_endpoint_governing_metric", "auxiliary_guardrail_metrics", "composite_normalization_rule", "multiplicity_metric_selection_policy"], "properties": {"primary_endpoint_governing_metric": {"$ref": "#/$defs/nonempty_string"}, "auxiliary_guardrail_metrics": {"$ref": "#/$defs/nonempty_string"}, "composite_normalization_rule": {"$ref": "#/$defs/nonempty_string"}, "multiplicity_metric_selection_policy": {"$ref": "#/$defs/nonempty_string"}}},
    "uncertainty_and_dependence": {"type": "object", "additionalProperties": false, "required": ["dependence_clustering_structure", "inference_or_resampling_unit", "primary_uncertainty_summary"], "properties": {"dependence_clustering_structure": {"$ref": "#/$defs/nonempty_string"}, "inference_or_resampling_unit": {"$ref": "#/$defs/nonempty_string"}, "primary_uncertainty_summary": {"$ref": "#/$defs/nonempty_string"}}},
    "variant_selection": {"type": "object", "additionalProperties": false, "required": ["variant_family", "selection_tuning_rule", "search_budget", "test_touch_policy"], "properties": {"variant_family": {"$ref": "#/$defs/nonempty_string"}, "selection_tuning_rule": {"$ref": "#/$defs/nonempty_string"}, "search_budget": {"$ref": "#/$defs/nonempty_string"}, "test_touch_policy": {"$ref": "#/$defs/nonempty_string"}}},
    "evaluated_subject": {"type": "object", "additionalProperties": false, "required": ["evaluated_subject_provenance", "serving_stack_execution_substrate", "evaluation_window_snapshot_date", "update_drift_posture"], "properties": {"evaluated_subject_provenance": {"$ref": "#/$defs/nonempty_string"}, "serving_stack_execution_substrate": {"$ref": "#/$defs/nonempty_string"}, "evaluation_window_snapshot_date": {"$ref": "#/$defs/nonempty_string"}, "update_drift_posture": {"$ref": "#/$defs/nonempty_string"}}},
    "environment_and_knowledge": {"type": "object", "additionalProperties": false, "required": ["tool_capability_catalog_and_access_policy", "external_environment_state_snapshot_posture", "knowledge_base_retrieval_corpus_provenance_and_snapshot", "reset_refresh_mutability_policy"], "properties": {"tool_capability_catalog_and_access_policy": {"$ref": "#/$defs/nonempty_string"}, "external_environment_state_snapshot_posture": {"$ref": "#/$defs/nonempty_string"}, "knowledge_base_retrieval_corpus_provenance_and_snapshot": {"$ref": "#/$defs/nonempty_string"}, "reset_refresh_mutability_policy": {"$ref": "#/$defs/nonempty_string"}}},
    "execution_budget": {"type": "object", "additionalProperties": false, "required": ["turn_action_tool_call_budget", "context_history_retention_policy", "token_compute_latency_budget", "limit_hit_handling_truncation_stop_rule"], "properties": {"turn_action_tool_call_budget": {"$ref": "#/$defs/nonempty_string"}, "context_history_retention_policy": {"$ref": "#/$defs/nonempty_string"}, "token_compute_latency_budget": {"$ref": "#/$defs/nonempty_string"}, "limit_hit_handling_truncation_stop_rule": {"$ref": "#/$defs/nonempty_string"}}},
    "scenario_sampling": {"type": "object", "additionalProperties": false, "required": ["scenario_world_template_family", "sampling_randomization_rule", "seed_set_reroll_stopping_policy", "release_posture_holdout_exposure"], "properties": {"scenario_world_template_family": {"$ref": "#/$defs/nonempty_string"}, "sampling_randomization_rule": {"$ref": "#/$defs/nonempty_string"}, "seed_set_reroll_stopping_policy": {"$ref": "#/$defs/nonempty_string"}, "release_posture_holdout_exposure": {"$ref": "#/$defs/nonempty_string"}}},
    "failure_handling": {"type": "object", "additionalProperties": false, "required": ["raw_attempt_denominator", "scored_denominator", "failure_invalid_output_taxonomy", "retry_repair_rule_and_budget", "exclusion_scoring_rule"], "properties": {"raw_attempt_denominator": {"$ref": "#/$defs/nonempty_string"}, "scored_denominator": {"$ref": "#/$defs/nonempty_string"}, "failure_invalid_output_taxonomy": {"$ref": "#/$defs/nonempty_string"}, "retry_repair_rule_and_budget": {"$ref": "#/$defs/nonempty_string"}, "exclusion_scoring_rule": {"$ref": "#/$defs/nonempty_string"}}},
    "adjudication": {"type": "object", "additionalProperties": false, "required": ["judge_rater_provenance", "rubric_scoring_protocol", "adjudication_debias_rule", "calibration_escalation_policy"], "properties": {"judge_rater_provenance": {"$ref": "#/$defs/nonempty_string"}, "rubric_scoring_protocol": {"$ref": "#/$defs/nonempty_string"}, "adjudication_debias_rule": {"$ref": "#/$defs/nonempty_string"}, "calibration_escalation_policy": {"$ref": "#/$defs/nonempty_string"}}}
  }
}
