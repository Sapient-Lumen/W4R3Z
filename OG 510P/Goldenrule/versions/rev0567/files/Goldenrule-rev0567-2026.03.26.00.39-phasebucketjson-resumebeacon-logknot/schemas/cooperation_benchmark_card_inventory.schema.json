{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_inventory.schema.json",
  "title": "Cooperation Benchmark Card Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_inventory_kind",
    "cards",
    "freeze_receipts",
    "delta_receipts",
    "counts",
    "latest_claim_ready_card_ids",
    "orphan_freeze_receipt_paths",
    "orphan_delta_receipt_paths"
  ],
  "properties": {
    "card_inventory_kind": {
      "const": "cooperation_benchmark_card_inventory"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "benchmark_name",
          "result_kind",
          "path",
          "claim_ready",
          "readiness_issue_count",
          "freeze_receipt_paths",
          "verified_freeze_receipt_paths",
          "drifted_freeze_receipt_paths",
          "incoming_delta_receipt_paths",
          "outgoing_delta_receipt_paths",
          "verified_incoming_delta_receipt_paths",
          "verified_outgoing_delta_receipt_paths",
          "drifted_incoming_delta_receipt_paths",
          "drifted_outgoing_delta_receipt_paths",
          "predecessor_card_ids",
          "successor_card_ids",
          "frozen",
          "freeze_drift",
          "delta_drift",
          "latest_known"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "benchmark_name": {"type": "string", "minLength": 1},
          "result_kind": {"type": "string", "enum": ["comparative", "descriptive", "method_note"]},
          "path": {"type": "string", "minLength": 1},
          "claim_ready": {"type": "boolean"},
          "readiness_issue_count": {"type": "integer", "minimum": 0},
          "freeze_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "verified_freeze_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "drifted_freeze_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "incoming_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "outgoing_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "verified_incoming_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "verified_outgoing_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "drifted_incoming_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "drifted_outgoing_delta_receipt_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "predecessor_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "successor_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "frozen": {"type": "boolean"},
          "freeze_drift": {"type": "boolean"},
          "delta_drift": {"type": "boolean"},
          "latest_known": {"type": "boolean"}
        }
      }
    },
    "freeze_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "card_id",
          "card_path",
          "claim_ready",
          "rendered_markdown_path",
          "card_sha256",
          "rendered_markdown_sha256",
          "drift_reason_codes",
          "matches_current_surface"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "card_id": {"type": "string", "minLength": 1},
          "card_path": {"type": "string", "minLength": 1},
          "claim_ready": {"type": "boolean"},
          "rendered_markdown_path": {"type": "string", "minLength": 1},
          "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rendered_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "drift_reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "matches_current_surface": {"type": "boolean"}
        }
      }
    },
    "delta_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old_card_id",
          "new_card_id",
          "old_card_path",
          "old_card_sha256",
          "new_card_path",
          "new_card_sha256",
          "claim_surface_changed",
          "drift_reason_codes",
          "matches_current_surface"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "old_card_id": {"type": "string", "minLength": 1},
          "new_card_id": {"type": "string", "minLength": 1},
          "old_card_path": {"type": "string", "minLength": 1},
          "old_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "new_card_path": {"type": "string", "minLength": 1},
          "new_card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "claim_surface_changed": {"type": "boolean"},
          "drift_reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "matches_current_surface": {"type": "boolean"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_count",
        "claim_ready_card_count",
        "frozen_card_count",
        "freeze_drift_card_count",
        "delta_drift_card_count",
        "latest_known_card_count",
        "freeze_receipt_count",
        "verified_freeze_receipt_count",
        "drifted_freeze_receipt_count",
        "delta_receipt_count",
        "verified_delta_receipt_count",
        "drifted_delta_receipt_count",
        "orphan_freeze_receipt_count",
        "orphan_delta_receipt_count"
      ],
      "properties": {
        "card_count": {"type": "integer", "minimum": 0},
        "claim_ready_card_count": {"type": "integer", "minimum": 0},
        "frozen_card_count": {"type": "integer", "minimum": 0},
        "freeze_drift_card_count": {"type": "integer", "minimum": 0},
        "delta_drift_card_count": {"type": "integer", "minimum": 0},
        "latest_known_card_count": {"type": "integer", "minimum": 0},
        "freeze_receipt_count": {"type": "integer", "minimum": 0},
        "verified_freeze_receipt_count": {"type": "integer", "minimum": 0},
        "drifted_freeze_receipt_count": {"type": "integer", "minimum": 0},
        "delta_receipt_count": {"type": "integer", "minimum": 0},
        "verified_delta_receipt_count": {"type": "integer", "minimum": 0},
        "drifted_delta_receipt_count": {"type": "integer", "minimum": 0},
        "orphan_freeze_receipt_count": {"type": "integer", "minimum": 0},
        "orphan_delta_receipt_count": {"type": "integer", "minimum": 0}
      }
    },
    "latest_claim_ready_card_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "orphan_freeze_receipt_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "orphan_delta_receipt_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
