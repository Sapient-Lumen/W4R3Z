{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Turnover-Tempo Interpretation Handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_turnover_tempo_interpretation_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_turnover_tempo_interpretation_handoff.v1"
    },
    "planner_origin": {
      "const": "copy the current proxy-era turnover-tempo interpretation into the benchmark seed until native rematch worlds can emit world-owned persistence and delay-normalization sections directly"
    },
    "turnover_tempo_report_path": {
      "const": "artifacts/reports/rematch_proxy_turnover_tempo_snapshot_20260306.json"
    },
    "turnover_tempo_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linked_question_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tested_policy_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tested_extortion_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "tested_delay_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "tempo_scaling_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario_means_checked": {
          "type": "integer",
          "minimum": 1
        },
        "mean_abs_prediction_error": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_prediction_error": {
          "type": "number",
          "minimum": 0
        },
        "rms_prediction_error": {
          "type": "number",
          "minimum": 0
        },
        "highest_churn_delay2_cell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {"type": "string", "minLength": 1},
            "extortion": {"type": "integer", "minimum": 0},
            "avg_match_length": {"type": "number", "minimum": 0},
            "matched_share_loss": {"type": "number", "minimum": 0}
          },
          "required": ["policy", "extortion", "avg_match_length", "matched_share_loss"]
        },
        "lowest_churn_delay2_cell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {"type": "string", "minLength": 1},
            "extortion": {"type": "integer", "minimum": 0},
            "avg_match_length": {"type": "number", "minimum": 0},
            "matched_share_loss": {"type": "number", "minimum": 0}
          },
          "required": ["policy", "extortion", "avg_match_length", "matched_share_loss"]
        },
        "highest_vs_lowest_churn_delay2_matched_share_loss_ratio": {
          "type": "number",
          "minimum": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scenario_means_checked",
        "mean_abs_prediction_error",
        "max_abs_prediction_error",
        "rms_prediction_error",
        "highest_churn_delay2_cell",
        "lowest_churn_delay2_cell",
        "highest_vs_lowest_churn_delay2_matched_share_loss_ratio",
        "interpretation"
      ]
    },
    "turnover_tempo_contract_guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparability_rule": {"type": "string", "minLength": 1},
        "turnover_metric_requirement_rule": {"type": "string", "minLength": 1},
        "persistence_boundary_rule": {"type": "string", "minLength": 1},
        "required_policy_row_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "comparability_rule",
        "turnover_metric_requirement_rule",
        "persistence_boundary_rule",
        "required_policy_row_fields"
      ]
    },
    "upgrade_requirement": {
      "type": "string",
      "minLength": 1
    },
    "size_discipline_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "turnover_tempo_report_path",
    "turnover_tempo_report_sha256",
    "linked_question_ids",
    "tested_policy_ids",
    "tested_extortion_values",
    "tested_delay_values",
    "tempo_scaling_summary",
    "turnover_tempo_contract_guidance",
    "upgrade_requirement",
    "size_discipline_note"
  ]
}
