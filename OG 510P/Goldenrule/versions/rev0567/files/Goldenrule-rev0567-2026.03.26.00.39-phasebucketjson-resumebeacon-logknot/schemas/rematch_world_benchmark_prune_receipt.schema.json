{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Prune Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_script",
    "counts",
    "execution_mode",
    "focus",
    "prune_ready",
    "receipt_version",
    "recommended_next_move",
    "retention_exit_receipt_path",
    "snapshot_date",
    "transient_rows"
  ],
  "properties": {
    "snapshot_date": {"type": "string"},
    "receipt_version": {"type": "string"},
    "analysis_script": {"type": "string"},
    "focus": {"type": "string"},
    "retention_exit_receipt_path": {"type": "string"},
    "execution_mode": {"type": "string", "enum": ["dry_run", "execute"]},
    "prune_ready": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "already_absent_count",
        "already_elided_unlinked_count",
        "blocked_count",
        "concrete_exit_bytes",
        "concrete_path_count",
        "deleted_count",
        "eligible_count",
        "empty_dirs_removed_count",
        "removed_bytes",
        "total_transient_count",
        "would_delete_count"
      ],
      "properties": {
        "total_transient_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "concrete_path_count": {"type": "integer", "minimum": 0},
        "already_elided_unlinked_count": {"type": "integer", "minimum": 0},
        "would_delete_count": {"type": "integer", "minimum": 0},
        "deleted_count": {"type": "integer", "minimum": 0},
        "already_absent_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0},
        "empty_dirs_removed_count": {"type": "integer", "minimum": 0},
        "concrete_exit_bytes": {"type": "integer", "minimum": 0},
        "removed_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "transient_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "byte_count",
          "eligible",
          "exit_ready",
          "exists_after",
          "exists_before",
          "hash_matches_before",
          "label",
          "path",
          "retention_class",
          "sha256",
          "status"
        ],
        "properties": {
          "label": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "retention_class": {"type": "string"},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string"},
          "exit_ready": {"type": "boolean"},
          "eligible": {"type": "boolean"},
          "exists_before": {"type": "boolean"},
          "exists_after": {"type": "boolean"},
          "hash_matches_before": {"type": ["boolean", "null"]},
          "status": {
            "type": "string",
            "enum": [
              "already_absent",
              "blocked_hash_mismatch",
              "blocked_not_exit_ready",
              "deleted",
              "unlinked_transient",
              "would_delete"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "block",
              "none",
              "planned_unlink",
              "unlink"
            ]
          }
        }
      }
    },
    "recommended_next_move": {"type": "string"}
  }
}
