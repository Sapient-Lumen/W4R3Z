{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_status_card.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Status Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_status_card_kind",
    "receipt_id",
    "journey_kind",
    "authoritative_manifest",
    "active_receipt_locator_digest_hex",
    "current_review_window",
    "current_review_state",
    "citation_guidance",
    "currently_citable",
    "required_regeneration_sequence",
    "status_inputs",
    "status_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_status_card_kind": {
      "const": "successor_safe_ceremony_receipt_package_status_card"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "authoritative_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "active_receipt_locator_digest_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_review_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watch_status",
        "reviewed_on",
        "review_due_on",
        "max_review_interval_days"
      ],
      "properties": {
        "watch_status": {
          "type": "string",
          "enum": [
            "active_watch",
            "reopen_now"
          ]
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "review_due_on": {
          "type": "string",
          "format": "date"
        },
        "max_review_interval_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "current_review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "review_decision",
        "failed_basis_codes",
        "observed_trigger_codes",
        "matched_reopen_trigger_codes"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "failed_basis_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observed_trigger_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "matched_reopen_trigger_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "citation_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_decision",
        "existing_citations_action",
        "new_citations_action"
      ],
      "properties": {
        "advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        },
        "existing_citations_action": {
          "type": "string",
          "enum": [
            "keep",
            "flag_for_withdrawal"
          ]
        },
        "new_citations_action": {
          "type": "string",
          "enum": [
            "cite_reviewed_locator",
            "suspend_until_regenerated"
          ]
        }
      }
    },
    "currently_citable": {
      "type": "boolean"
    },
    "required_regeneration_sequence": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch"
        ]
      },
      "uniqueItems": true
    },
    "status_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_watch",
        "review_verdict",
        "citation_advisory"
      ],
      "properties": {
        "review_watch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_hex"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "review_verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_hex"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "citation_advisory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256_hex"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256_hex": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "status_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
