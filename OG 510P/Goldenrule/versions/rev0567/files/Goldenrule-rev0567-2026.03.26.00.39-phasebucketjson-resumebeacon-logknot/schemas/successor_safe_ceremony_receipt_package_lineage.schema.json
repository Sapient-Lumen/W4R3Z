{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_lineage.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Lineage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_lineage_kind",
    "receipt_id",
    "journey_kind",
    "authoritative_manifest",
    "manifest_chain",
    "supersession_chain",
    "lineage_continuity",
    "current_authority_basis",
    "changed_component_roles_across_chain",
    "lineage_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_lineage_kind": { "const": "successor_safe_ceremony_receipt_package_lineage" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "journey_kind": {
      "type": "string",
      "enum": ["presentation", "authorization", "authentication", "issuance", "other"]
    },
    "authoritative_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256_hex", "current_claim_status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "current_claim_status": {
          "type": "string",
          "enum": ["claim_ready_citable", "suspended_pending_regeneration"]
        }
      }
    },
    "manifest_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "path",
          "sha256_hex",
          "current_claim_status",
          "review_decision",
          "advisory_decision",
          "active_receipt_locator_digest_hex"
        ],
        "properties": {
          "position": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "current_claim_status": {
            "type": "string",
            "enum": ["claim_ready_citable", "suspended_pending_regeneration"]
          },
          "review_decision": {
            "type": "string",
            "enum": ["continue_claim_ready_citation", "reopen_and_suspend_claim_ready_citation"]
          },
          "advisory_decision": {
            "type": "string",
            "enum": ["keep_current_locator_citable", "withdraw_current_locator_from_claim_ready_citation"]
          },
          "active_receipt_locator_digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "supersession_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "path",
          "sha256_hex",
          "prior_manifest_path",
          "current_manifest_path",
          "continuity",
          "supersession_reason_codes"
        ],
        "properties": {
          "position": { "type": "integer", "minimum": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "prior_manifest_path": { "type": "string", "minLength": 1 },
          "current_manifest_path": { "type": "string", "minLength": 1 },
          "continuity": {
            "type": "string",
            "enum": ["same_receipt_locator", "rekeyed_receipt_locator"]
          },
          "supersession_reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "review_window_renewed",
                "freshness_artifacts_replaced",
                "claim_status_changed",
                "package_state_changed",
                "receipt_locator_rekeyed"
              ]
            }
          }
        }
      }
    },
    "lineage_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuity", "distinct_locator_digest_count", "distinct_locator_digest_hexes"],
      "properties": {
        "continuity": {
          "type": "string",
          "enum": ["same_receipt_locator_across_chain", "rekeyed_within_chain"]
        },
        "distinct_locator_digest_count": { "type": "integer", "minimum": 1 },
        "distinct_locator_digest_hexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "current_authority_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_status", "head_position", "current_review_decision", "current_advisory_decision"],
      "properties": {
        "chain_status": { "const": "authoritative_head_identified" },
        "head_position": { "type": "integer", "minimum": 1 },
        "current_review_decision": {
          "type": "string",
          "enum": ["continue_claim_ready_citation", "reopen_and_suspend_claim_ready_citation"]
        },
        "current_advisory_decision": {
          "type": "string",
          "enum": ["keep_current_locator_citable", "withdraw_current_locator_from_claim_ready_citation"]
        }
      }
    },
    "changed_component_roles_across_chain": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "receipt",
          "rendered_markdown",
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch",
          "review_verdict",
          "citation_advisory"
        ]
      }
    },
    "lineage_summary": { "type": "string", "minLength": 1 }
  }
}
