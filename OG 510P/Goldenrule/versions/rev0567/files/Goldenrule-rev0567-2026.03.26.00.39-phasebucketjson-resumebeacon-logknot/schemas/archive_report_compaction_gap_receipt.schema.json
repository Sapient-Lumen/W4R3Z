{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_script": {
      "const": "scripts/tools/build_archive_report_compaction_gap_receipt.py",
      "type": "string"
    },
    "archive_posture": {
      "additionalProperties": false,
      "properties": {
        "intended_retention_class": {
          "minLength": 1,
          "type": "string"
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "type": "object"
    },
    "blocked_hotspots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "backing_handle_count": {
            "const": 0,
            "type": "integer"
          },
          "backing_handles": {
            "maxItems": 0,
            "type": "array"
          },
          "family": {
            "minLength": 1,
            "type": "string"
          },
          "file_count": {
            "minimum": 1,
            "type": "integer"
          },
          "gap_class": {
            "const": "missing_durable_handle",
            "type": "string"
          },
          "has_json_md_pair": {
            "type": "boolean"
          },
          "raw_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "raw_mebibytes": {
            "minimum": 0,
            "type": "number"
          },
          "recommended_handle_kind": {
            "enum": [
              "doc",
              "library_topic",
              "snapshot"
            ],
            "type": "string"
          },
          "share_of_report_bucket_raw_bytes": {
            "minimum": 0,
            "type": "number"
          },
          "unlock_move": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "backing_handle_count",
          "backing_handles",
          "family",
          "file_count",
          "gap_class",
          "has_json_md_pair",
          "raw_bytes",
          "raw_mebibytes",
          "recommended_handle_kind",
          "share_of_report_bucket_raw_bytes",
          "unlock_move"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "compaction_candidate_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "compaction_candidate_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "headline_findings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "hotspot_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "hotspot_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "measurement_scope": {
      "additionalProperties": false,
      "properties": {
        "candidate_search_roots": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "excluded_handle_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "max_backing_handles_per_family": {
          "minimum": 1,
          "type": "integer"
        },
        "primary_doc_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "top_hotspot_limit": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "candidate_search_roots",
        "excluded_handle_paths",
        "max_backing_handles_per_family",
        "primary_doc_paths",
        "top_hotspot_limit"
      ],
      "type": "object"
    },
    "policy_checks": {
      "additionalProperties": false,
      "properties": {
        "blocked_hotspots_are_current_hotspot_families": {
          "type": "boolean"
        },
        "blocked_hotspots_exhaust_true_handle_gaps": {
          "type": "boolean"
        },
        "blocked_hotspots_have_zero_backing_handles": {
          "type": "boolean"
        },
        "blocked_hotspots_sorted_by_size": {
          "type": "boolean"
        },
        "blocked_hotspots_unique": {
          "type": "boolean"
        },
        "compaction_candidate_receipt_ready": {
          "type": "boolean"
        },
        "hotspot_receipt_ready": {
          "type": "boolean"
        },
        "semantic_handle_receipt_ready": {
          "type": "boolean"
        }
      },
      "required": [
        "hotspot_receipt_ready",
        "semantic_handle_receipt_ready",
        "compaction_candidate_receipt_ready",
        "blocked_hotspots_unique",
        "blocked_hotspots_are_current_hotspot_families",
        "blocked_hotspots_have_zero_backing_handles",
        "blocked_hotspots_sorted_by_size",
        "blocked_hotspots_exhaust_true_handle_gaps"
      ],
      "type": "object"
    },
    "receipt_kind": {
      "const": "archive_report_compaction_gap_receipt"
    },
    "receipt_version": {
      "minLength": 1,
      "type": "string"
    },
    "recommended_next_move": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_handle_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_handle_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status_counts": {
      "additionalProperties": false,
      "properties": {
        "passed_check_count": {
          "minimum": 0,
          "type": "integer"
        },
        "ready_to_cite": {
          "type": "boolean"
        },
        "total_check_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "type": "object"
    },
    "summary_metrics": {
      "additionalProperties": false,
      "properties": {
        "blocked_hotspot_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_hotspot_pair_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_hotspot_raw_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_hotspot_raw_mebibytes": {
          "minimum": 0,
          "type": "number"
        },
        "blocked_hotspot_share_of_report_bucket_raw_bytes": {
          "minimum": 0,
          "type": "number"
        },
        "blocked_hotspot_share_of_top_hotspot_raw_bytes": {
          "minimum": 0,
          "type": "number"
        },
        "combined_first_pass_and_gap_raw_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "combined_first_pass_and_gap_share_of_report_bucket_raw_bytes": {
          "minimum": 0,
          "type": "number"
        },
        "first_pass_candidate_raw_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "blocked_hotspot_count",
        "blocked_hotspot_pair_count",
        "blocked_hotspot_raw_bytes",
        "blocked_hotspot_raw_mebibytes",
        "blocked_hotspot_share_of_report_bucket_raw_bytes",
        "blocked_hotspot_share_of_top_hotspot_raw_bytes",
        "combined_first_pass_and_gap_raw_bytes",
        "combined_first_pass_and_gap_share_of_report_bucket_raw_bytes",
        "first_pass_candidate_raw_bytes"
      ],
      "type": "object"
    }
  },
  "required": [
    "analysis_script",
    "archive_posture",
    "blocked_hotspots",
    "compaction_candidate_receipt_path",
    "compaction_candidate_receipt_sha256",
    "headline_findings",
    "hotspot_receipt_path",
    "hotspot_receipt_sha256",
    "measurement_scope",
    "policy_checks",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "semantic_handle_receipt_path",
    "semantic_handle_receipt_sha256",
    "status_counts",
    "summary_metrics"
  ],
  "title": "Archive Report Compaction Gap Receipt",
  "type": "object"
}
