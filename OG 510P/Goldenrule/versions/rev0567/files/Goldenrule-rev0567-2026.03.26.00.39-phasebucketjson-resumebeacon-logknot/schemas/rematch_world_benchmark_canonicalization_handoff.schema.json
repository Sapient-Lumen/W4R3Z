{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Canonicalization Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "bridge_receipt_path",
    "bridge_receipt_sha256",
    "mode_rows",
    "zero_noise_dispatch_contract",
    "invalidation_triggers",
    "upgrade_requirement",
    "size_discipline_note"
  ],
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_canonicalization_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_canonicalization_handoff.v1"
    },
    "planner_origin": {
      "const": "copy the current SG-003 bridge receipt into the benchmark seed until a native rematch-world planner manifest exists"
    },
    "bridge_receipt_path": {
      "const": "examples/snapshots/rematch_world_canonicalization_bridge_receipt.json"
    },
    "bridge_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode_id",
          "label",
          "planner_kind",
          "recommended_key_fields",
          "minimal_exact_horizon",
          "regime_count"
        ],
        "properties": {
          "mode_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "planner_kind": {"type": "string", "minLength": 1},
          "recommended_key_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "minimal_exact_horizon": {"type": "integer", "minimum": 1},
          "regime_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "zero_noise_dispatch_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_signature_count",
        "ordered_rule_count",
        "dispatch_surface_reduction_factor"
      ],
      "properties": {
        "support_signature_count": {"type": "integer", "minimum": 1},
        "ordered_rule_count": {"type": "integer", "minimum": 1},
        "dispatch_surface_reduction_factor": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "invalidation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "upgrade_requirement": {"type": "string", "minLength": 1},
    "size_discipline_note": {"type": "string", "minLength": 1}
  }
}
