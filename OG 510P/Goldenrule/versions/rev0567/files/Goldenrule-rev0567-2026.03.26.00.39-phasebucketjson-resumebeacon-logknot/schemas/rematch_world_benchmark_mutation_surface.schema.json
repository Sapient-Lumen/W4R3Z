{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Mutation Surface Snapshot",
  "type": "object",
  "required": [
    "focus",
    "snapshot_date",
    "seed_artifact_path",
    "decision_contract_path",
    "mutation_guard_path",
    "mutable_prefix_rows",
    "frozen_prefix_rows",
    "allowed_decision_null_rows",
    "status_counts",
    "main_findings",
    "recommended_next_move",
    "analysis_script",
    "schema_path",
    "validator_path",
    "source_artifacts"
  ],
  "properties": {
    "focus": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "minLength": 1},
    "seed_artifact_path": {"type": "string", "minLength": 1},
    "decision_contract_path": {"type": "string", "minLength": 1},
    "mutation_guard_path": {"type": "string", "minLength": 1},
    "mutable_prefix_rows": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "prefix",
          "mutation_kind",
          "required_change_for_publishable",
          "linked_question_ids",
          "reason"
        ],
        "properties": {
          "prefix": {"type": "string", "minLength": 1},
          "mutation_kind": {"type": "string", "enum": ["metadata_transition", "metadata_binding", "section_status_flip", "world_section_fill"]},
          "required_change_for_publishable": {"type": "boolean"},
          "linked_question_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^SQ-0(1[2-6])$"}
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "frozen_prefix_rows": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["prefix", "frozen_kind", "reason"],
        "properties": {
          "prefix": {"type": "string", "minLength": 1},
          "frozen_kind": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "allowed_decision_null_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "section", "linked_question_ids", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "section": {"const": "compact_decision_bundle"},
          "linked_question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SQ-0(1[7-9]|2[0-6])$"}
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "mutable_prefix_count",
        "metadata_mutable_prefix_count",
        "status_flip_prefix_count",
        "world_section_mutable_prefix_count",
        "frozen_prefix_count",
        "allowed_decision_null_count"
      ],
      "properties": {
        "mutable_prefix_count": {"type": "integer", "minimum": 12},
        "metadata_mutable_prefix_count": {"type": "integer", "const": 2},
        "status_flip_prefix_count": {"type": "integer", "const": 5},
        "world_section_mutable_prefix_count": {"type": "integer", "const": 5},
        "frozen_prefix_count": {"type": "integer", "minimum": 12},
        "allowed_decision_null_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "main_findings": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_next_move": {"type": "string", "minLength": 1},
    "analysis_script": {"type": "string", "minLength": 1},
    "schema_path": {"type": "string", "minLength": 1},
    "validator_path": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
