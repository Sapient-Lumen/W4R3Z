{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Post-Prune Audit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_script",
    "cleaned_tree_ready_for_zip",
    "counts",
    "durable_rows",
    "focus",
    "prune_receipt_path",
    "prune_receipt_summary",
    "receipt_version",
    "recommended_next_move",
    "retention_exit_receipt_path",
    "snapshot_date",
    "transient_rows"
  ],
  "properties": {
    "snapshot_date": {"type": "string"},
    "receipt_version": {"type": "string"},
    "analysis_script": {"type": "string"},
    "focus": {"type": "string"},
    "retention_exit_receipt_path": {"type": "string"},
    "prune_receipt_path": {"type": "string"},
    "cleaned_tree_ready_for_zip": {"type": "boolean"},
    "prune_receipt_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_count",
        "deleted_count",
        "execution_mode",
        "prune_ready",
        "would_delete_count"
      ],
      "properties": {
        "execution_mode": {"type": "string", "enum": ["dry_run", "execute"]},
        "prune_ready": {"type": "boolean"},
        "blocked_count": {"type": "integer", "minimum": 0},
        "would_delete_count": {"type": "integer", "minimum": 0},
        "deleted_count": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_count",
        "durable_count",
        "durable_hash_match_count",
        "durable_missing_count",
        "transient_absent_or_unlinked_count",
        "transient_count",
        "transient_still_present_count"
      ],
      "properties": {
        "durable_count": {"type": "integer", "minimum": 0},
        "durable_hash_match_count": {"type": "integer", "minimum": 0},
        "durable_missing_count": {"type": "integer", "minimum": 0},
        "transient_count": {"type": "integer", "minimum": 0},
        "transient_absent_or_unlinked_count": {"type": "integer", "minimum": 0},
        "transient_still_present_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0}
      }
    },
    "durable_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actual_sha256",
          "byte_count",
          "exists",
          "hash_matches",
          "label",
          "path",
          "retention_class",
          "sha256",
          "status"
        ],
        "properties": {
          "label": {"type": "string"},
          "path": {"type": "string"},
          "retention_class": {"type": "string"},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string"},
          "actual_sha256": {"type": ["string", "null"]},
          "exists": {"type": "boolean"},
          "hash_matches": {"type": "boolean"},
          "status": {"type": "string", "enum": ["durable_hash_match", "durable_hash_mismatch", "missing_durable"]}
        }
      }
    },
    "transient_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confirmed_absent",
          "label",
          "path",
          "prune_action",
          "prune_status",
          "retention_class",
          "status"
        ],
        "properties": {
          "label": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "retention_class": {"type": "string"},
          "prune_status": {"type": "string"},
          "prune_action": {"type": "string"},
          "confirmed_absent": {"type": "boolean"},
          "status": {
            "type": "string",
            "enum": [
              "blocked_prune_receipt",
              "confirmed_absent_after_prune",
              "confirmed_unlinked_transient",
              "still_present_after_prune"
            ]
          }
        }
      }
    },
    "recommended_next_move": {"type": "string"}
  }
}
