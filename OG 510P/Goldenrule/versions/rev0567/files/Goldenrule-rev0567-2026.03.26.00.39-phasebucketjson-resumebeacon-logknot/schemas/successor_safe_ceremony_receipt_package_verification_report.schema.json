{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_verification_report.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_verification_report_kind",
    "receipt_id",
    "journey_kind",
    "as_of",
    "authoritative_manifest",
    "active_receipt_locator_digest_hex",
    "current_citation_state",
    "verification_scope",
    "checks",
    "summary_counts",
    "verification_decision",
    "environment_boundary",
    "verification_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_verification_report_kind": { "const": "successor_safe_ceremony_receipt_package_verification_report" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "journey_kind": {
      "type": "string",
      "enum": ["presentation", "authorization", "authentication", "issuance", "other"]
    },
    "as_of": { "type": "string", "format": "date" },
    "authoritative_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256_hex", "current_claim_status"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "current_claim_status": {
          "type": "string",
          "enum": ["claim_ready_citable", "suspended_pending_regeneration"]
        }
      }
    },
    "active_receipt_locator_digest_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "current_citation_state": {
      "type": "string",
      "enum": ["citable_now", "suspended_pending_regeneration"]
    },
    "verification_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_status_card", "validation_profile_id"],
      "properties": {
        "package_status_card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256_hex", "currently_citable"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "currently_citable": { "type": "boolean" }
          }
        },
        "validation_profile_id": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "lane", "command", "status", "outcome_code", "summary"],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "lane": { "type": "string", "enum": ["python_integrity", "rust_boundary"] },
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "blocked", "fail"] },
          "outcome_code": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "blocker_codes": {
            "type": "array",
            "items": { "type": "string", "enum": ["missing_cargo", "missing_junest"] },
            "uniqueItems": true
          }
        }
      }
    },
    "summary_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_count", "blocked_count", "fail_count"],
      "properties": {
        "pass_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "fail_count": { "type": "integer", "minimum": 0 }
      }
    },
    "verification_decision": {
      "type": "string",
      "enum": ["verified_python_lane_only", "verified_full_stack", "verification_failed"]
    },
    "environment_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_lane_status", "missing_tools", "blocked_follow_up"],
      "properties": {
        "rust_lane_status": {
          "type": "string",
          "enum": ["available", "blocked_missing_toolchain", "failed_other"]
        },
        "missing_tools": {
          "type": "array",
          "items": { "type": "string", "enum": ["cargo", "junest"] },
          "uniqueItems": true
        },
        "blocked_follow_up": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rerun_doctor_after_cargo_available",
              "rerun_quick_harness_after_junest_available"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "verification_summary": { "type": "string", "minLength": 1 }
  }
}
