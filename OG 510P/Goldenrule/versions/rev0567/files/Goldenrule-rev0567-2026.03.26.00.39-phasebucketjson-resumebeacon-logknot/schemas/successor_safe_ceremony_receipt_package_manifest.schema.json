{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_manifest.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_manifest_kind",
    "receipt_id",
    "journey_kind",
    "current_claim_status",
    "active_receipt_locator",
    "package_state",
    "component_roles_present",
    "components",
    "manifest_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "package_manifest_kind": {
      "const": "successor_safe_ceremony_receipt_package_manifest"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": ["presentation", "authorization", "authentication", "issuance", "other"]
    },
    "current_claim_status": {
      "type": "string",
      "enum": ["claim_ready_citable", "suspended_pending_regeneration"]
    },
    "active_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ni_uri", "digest_hex", "source_path"],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_decision",
        "promotion_decision",
        "review_decision",
        "advisory_decision"
      ],
      "properties": {
        "authorization_decision": {
          "type": "string",
          "enum": [
            "authorized_for_claim_ready_citation",
            "not_authorized_for_claim_ready_citation"
          ]
        },
        "promotion_decision": {
          "type": "string",
          "enum": [
            "promoted_to_claim_ready_citation",
            "not_yet_promoted"
          ]
        },
        "review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        }
      }
    },
    "component_roles_present": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "receipt",
          "rendered_markdown",
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch",
          "review_verdict",
          "citation_advisory"
        ]
      }
    },
    "components": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type", "sha256_hex", "bytes"],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "receipt",
              "rendered_markdown",
              "locator",
              "assessment",
              "disposition",
              "remediation",
              "authorization",
              "promotion",
              "review_watch",
              "review_verdict",
              "citation_advisory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "enum": ["application/json", "text/markdown"]
          },
          "sha256_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "manifest_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
