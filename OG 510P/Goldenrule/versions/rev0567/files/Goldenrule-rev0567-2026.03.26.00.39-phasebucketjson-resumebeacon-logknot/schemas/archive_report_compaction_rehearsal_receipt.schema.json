{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Report Compaction Rehearsal Receipt",
  "type": "object",
  "required": [
    "analysis_script",
    "archive_posture",
    "compaction_manifest_receipt_path",
    "compaction_manifest_receipt_sha256",
    "headline_findings",
    "measurement_scope",
    "package_receipt_path",
    "package_receipt_sha256",
    "policy_checks",
    "projected_next_frontier",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "semantic_handle_receipt_path",
    "semantic_handle_receipt_sha256",
    "status_counts",
    "summary_metrics",
    "trimmed_families"
  ],
  "properties": {
    "receipt_kind": {
      "const": "archive_report_compaction_rehearsal_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "const": "scripts/tools/build_archive_report_compaction_rehearsal_receipt.py"
    },
    "package_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "package_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compaction_manifest_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "compaction_manifest_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_handle_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "semantic_handle_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "candidate_search_roots",
        "excluded_handle_paths",
        "primary_doc_paths",
        "projected_frontier_limit",
        "report_root"
      ],
      "properties": {
        "report_root": {
          "type": "string",
          "const": "artifacts/reports"
        },
        "projected_frontier_limit": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_search_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_handle_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "primary_doc_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "summary_metrics": {
      "type": "object",
      "required": [
        "projected_frontier_family_count",
        "projected_frontier_gap_count",
        "projected_frontier_handle_covered_count",
        "projected_raw_tree_bytes",
        "projected_raw_tree_mebibytes",
        "projected_report_bucket_file_count",
        "projected_report_bucket_pair_count",
        "projected_report_bucket_raw_bytes",
        "projected_report_bucket_raw_mebibytes",
        "projected_report_bucket_share_of_raw_tree",
        "projected_retained_file_count",
        "trimmed_family_count",
        "trimmed_file_count",
        "trimmed_raw_bytes",
        "trimmed_raw_mebibytes",
        "trimmed_share_of_report_bucket_raw_bytes"
      ],
      "properties": {
        "trimmed_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "trimmed_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "trimmed_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "trimmed_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "trimmed_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_report_bucket_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_report_bucket_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_report_bucket_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_report_bucket_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_report_bucket_share_of_raw_tree": {
          "type": "number",
          "minimum": 0
        },
        "projected_raw_tree_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_raw_tree_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_retained_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_frontier_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_frontier_handle_covered_count": {
          "type": "integer",
          "minimum": 0
        },
        "projected_frontier_gap_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "trimmed_families": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "exact_report_file_count",
          "family",
          "priority_rank",
          "raw_bytes",
          "raw_mebibytes"
        ],
        "properties": {
          "priority_rank": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "exact_report_file_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "projected_next_frontier": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backing_handle_count",
          "backing_handle_kinds",
          "backing_handles",
          "current_rank",
          "family",
          "file_count",
          "has_json_md_pair",
          "projected_compaction_readiness",
          "projected_rank",
          "raw_bytes",
          "raw_mebibytes",
          "semantic_alias_used",
          "share_of_projected_report_bucket_raw_bytes"
        ],
        "properties": {
          "projected_rank": {
            "type": "integer",
            "minimum": 1
          },
          "current_rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_projected_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "file_count": {
            "type": "integer",
            "minimum": 1
          },
          "has_json_md_pair": {
            "type": "boolean"
          },
          "backing_handle_count": {
            "type": "integer",
            "minimum": 0
          },
          "backing_handle_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "doc",
                "library_topic",
                "snapshot"
              ]
            },
            "uniqueItems": true
          },
          "backing_handles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "doc",
                    "library_topic",
                    "snapshot"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "semantic_alias_used": {
            "type": "boolean"
          },
          "projected_compaction_readiness": {
            "type": "string",
            "enum": [
              "artifact_backed",
              "artifact_backed_pair",
              "citation_ready",
              "citation_ready_pair",
              "doc_backed",
              "handle_gap"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "manifest_receipt_ready",
        "package_receipt_ready",
        "projected_frontier_accounted_for",
        "projected_frontier_sorted_by_size",
        "projected_raw_tree_strictly_smaller",
        "projected_report_bucket_strictly_smaller",
        "semantic_handle_receipt_ready",
        "trimmed_families_fully_removed",
        "trimmed_paths_exist_under_reports",
        "trimmed_paths_nonempty",
        "trimmed_paths_unique"
      ],
      "properties": {
        "package_receipt_ready": {
          "type": "boolean"
        },
        "manifest_receipt_ready": {
          "type": "boolean"
        },
        "semantic_handle_receipt_ready": {
          "type": "boolean"
        },
        "trimmed_paths_nonempty": {
          "type": "boolean"
        },
        "trimmed_paths_unique": {
          "type": "boolean"
        },
        "trimmed_paths_exist_under_reports": {
          "type": "boolean"
        },
        "trimmed_families_fully_removed": {
          "type": "boolean"
        },
        "projected_report_bucket_strictly_smaller": {
          "type": "boolean"
        },
        "projected_raw_tree_strictly_smaller": {
          "type": "boolean"
        },
        "projected_frontier_accounted_for": {
          "type": "boolean"
        },
        "projected_frontier_sorted_by_size": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_to_cite": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "properties": {
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "headline_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
