{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Package Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "analysis_script",
    "measurement_scope",
    "chain_receipt_path",
    "chain_receipt_sha256",
    "post_prune_audit_path",
    "post_prune_audit_sha256",
    "compiled_artifact_sha256",
    "archive_totals",
    "report_growth_surface",
    "retention_hygiene",
    "policy_checks",
    "status_counts",
    "archive_posture",
    "recommended_next_move"
  ],
  "properties": {
    "receipt_kind": {
      "const": "rematch_world_benchmark_package_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "minLength": 1
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "tree_root",
        "output_receipt_self_excluded",
        "excluded_output_path",
        "fixed_point_excluded_paths",
        "skip_parts",
        "skip_suffixes"
      ],
      "properties": {
        "tree_root": {
          "type": "string",
          "minLength": 1
        },
        "output_receipt_self_excluded": {
          "type": "boolean"
        },
        "excluded_output_path": {
          "type": "string",
          "minLength": 1
        },
        "skip_parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skip_suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixed_point_excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "chain_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "chain_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "post_prune_audit_path": {
      "type": "string",
      "minLength": 1
    },
    "post_prune_audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compiled_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_totals": {
      "type": "object",
      "required": [
        "retained_file_count_excluding_receipt",
        "raw_bytes_excluding_receipt",
        "raw_mebibytes_excluding_receipt",
        "approx_revision_zip_bytes_excluding_receipt",
        "approx_revision_zip_mebibytes_excluding_receipt",
        "zip_share_of_raw_excluding_receipt"
      ],
      "properties": {
        "retained_file_count_excluding_receipt": {
          "type": "integer",
          "minimum": 1
        },
        "raw_bytes_excluding_receipt": {
          "type": "integer",
          "minimum": 1
        },
        "raw_mebibytes_excluding_receipt": {
          "type": "number",
          "minimum": 0
        },
        "approx_revision_zip_bytes_excluding_receipt": {
          "type": "integer",
          "minimum": 1
        },
        "approx_revision_zip_mebibytes_excluding_receipt": {
          "type": "number",
          "minimum": 0
        },
        "zip_share_of_raw_excluding_receipt": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "report_growth_surface": {
      "type": "object",
      "required": [
        "path",
        "file_count",
        "raw_bytes",
        "raw_mebibytes",
        "share_of_raw_tree",
        "json_md_pair_count",
        "paired_raw_bytes",
        "pair_share_of_report_bucket_raw_bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "share_of_raw_tree": {
          "type": "number",
          "minimum": 0
        },
        "json_md_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "paired_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pair_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "retention_hygiene": {
      "type": "object",
      "required": [
        "scratch_manifest_path",
        "scratch_manifest_active_count",
        "examples_scratch_file_count",
        "pdf_file_count",
        "pycache_dir_count"
      ],
      "properties": {
        "scratch_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "scratch_manifest_active_count": {
          "type": "integer",
          "minimum": 0
        },
        "examples_scratch_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "pdf_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "pycache_dir_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "publication_chain_ready",
        "post_prune_zip_ready",
        "compiled_artifact_digest_consistent",
        "pdf_free_tree",
        "scratch_tree_empty",
        "scratch_manifest_clear",
        "pycache_free_tree"
      ],
      "properties": {
        "publication_chain_ready": {
          "type": "boolean"
        },
        "post_prune_zip_ready": {
          "type": "boolean"
        },
        "compiled_artifact_digest_consistent": {
          "type": "boolean"
        },
        "pdf_free_tree": {
          "type": "boolean"
        },
        "scratch_tree_empty": {
          "type": "boolean"
        },
        "scratch_manifest_clear": {
          "type": "boolean"
        },
        "pycache_free_tree": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "total_check_count",
        "package_ready"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "package_ready": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "prefer_citation_over_recopy",
        "intended_retention_class",
        "size_discipline_note"
      ],
      "properties": {
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
