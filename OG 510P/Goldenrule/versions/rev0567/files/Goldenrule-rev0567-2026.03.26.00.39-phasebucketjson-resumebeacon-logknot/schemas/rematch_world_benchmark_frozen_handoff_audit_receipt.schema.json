{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Frozen Handoff Audit Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "analysis_script",
    "seed_path",
    "seed_builder_script",
    "seed_sha256",
    "rebuilt_seed_sha256",
    "rebuilt_seed_matches_standing_seed",
    "audited_sections",
    "status_counts",
    "archive_posture",
    "recommended_next_move"
  ],
  "properties": {
    "receipt_kind": {
      "const": "rematch_world_benchmark_frozen_handoff_audit_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "minLength": 1
    },
    "seed_path": {
      "type": "string",
      "minLength": 1
    },
    "seed_builder_script": {
      "type": "string",
      "minLength": 1
    },
    "seed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rebuilt_seed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rebuilt_seed_matches_standing_seed": {
      "type": "boolean"
    },
    "audited_sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "section_path",
          "source_path",
          "source_kind",
          "linked_question_ids",
          "seed_subtree_sha256",
          "source_sha256",
          "source_bytes",
          "exact_match"
        ],
        "properties": {
          "section_path": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "minLength": 1
          },
          "linked_question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seed_subtree_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "exact_match": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "audited_section_count",
        "exact_match_count",
        "mismatch_count",
        "cited_source_path_count"
      ],
      "properties": {
        "audited_section_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_match_count": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "cited_source_path_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "prefer_citation_over_recopy",
        "intended_retention_class",
        "size_discipline_note"
      ],
      "properties": {
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
