{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_supersession.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Supersession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_supersession_kind",
    "receipt_id",
    "journey_kind",
    "prior_package_manifest",
    "current_package_manifest",
    "active_receipt_locator_continuity",
    "supersession_reason_codes",
    "component_roles_replaced",
    "package_transition",
    "replacement_guidance",
    "supersession_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_supersession_kind": {
      "const": "successor_safe_ceremony_receipt_package_supersession"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "prior_package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "current_package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "active_receipt_locator_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuity",
        "prior_digest_hex",
        "current_digest_hex"
      ],
      "properties": {
        "continuity": {
          "type": "string",
          "enum": [
            "same_receipt_locator",
            "rekeyed_receipt_locator"
          ]
        },
        "prior_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "supersession_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "review_window_renewed",
          "freshness_artifacts_replaced",
          "claim_status_changed",
          "package_state_changed",
          "receipt_locator_rekeyed"
        ]
      }
    },
    "component_roles_replaced": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "receipt",
          "rendered_markdown",
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch",
          "review_verdict",
          "citation_advisory"
        ]
      }
    },
    "package_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersession_decision",
        "prior_review_decision",
        "current_review_decision",
        "prior_advisory_decision",
        "current_advisory_decision"
      ],
      "properties": {
        "supersession_decision": {
          "const": "current_manifest_supersedes_prior_manifest"
        },
        "prior_review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "current_review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "prior_advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        },
        "current_advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        }
      }
    },
    "replacement_guidance": {
      "type": "string",
      "minLength": 1
    },
    "supersession_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
