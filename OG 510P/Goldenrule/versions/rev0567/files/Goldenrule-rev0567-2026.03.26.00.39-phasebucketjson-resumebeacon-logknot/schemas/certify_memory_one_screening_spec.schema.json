{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/certify_memory_one_screening_spec.schema.json",
  "title": "CertifyMemoryOneScreeningSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "spec_id",
    "status",
    "steady_state",
    "pairwise_fairness",
    "recovery_proxy",
    "repair_proxy",
    "noisy_ecology"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"type": "string", "const": "certify_memory_one_screening_spec"},
    "spec_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "screening_proxy_contract"},
    "steady_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cesaro_fallback_steps"],
      "properties": {
        "cesaro_fallback_steps": {"type": "integer", "minimum": 1}
      }
    },
    "pairwise_fairness": {"$ref": "#/$defs/bindingThresholdSpec"},
    "recovery_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "shock_protocol",
        "epsilon",
        "horizon",
        "cc_mass_min",
        "threshold_kind",
        "threshold_value"
      ],
      "properties": {
        "metric": {"type": "string", "const": "recovery_rounds"},
        "shock_protocol": {"type": "string", "minLength": 1},
        "epsilon": {"type": "number", "minimum": 0},
        "horizon": {"type": "integer", "minimum": 1},
        "cc_mass_min": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_kind": {"type": "string", "const": "max"},
        "threshold_value": {"type": ["integer", "number"], "minimum": 0}
      }
    },
    "repair_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "k",
        "rounds",
        "repetitions",
        "noise",
        "threshold_kind",
        "threshold_value",
        "threshold_status"
      ],
      "properties": {
        "metric": {"type": "string", "const": "repair_abuse_rate"},
        "k": {"type": "integer", "minimum": 1},
        "rounds": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "noise": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_kind": {"type": ["string", "null"]},
        "threshold_value": {"type": ["number", "integer", "null"]},
        "threshold_status": {"type": "string", "enum": ["pending", "declared"]}
      }
    },
    "noisy_ecology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "threshold_kind",
        "threshold_value",
        "noise",
        "rounds",
        "repetitions",
        "pool"
      ],
      "properties": {
        "metric": {"type": "string", "const": "ecology_gap_noisy"},
        "threshold_kind": {"type": "string", "const": "max"},
        "threshold_value": {"type": ["number", "integer"]},
        "noise": {"type": "number", "minimum": 0, "maximum": 1},
        "rounds": {"type": "integer", "minimum": 1},
        "repetitions": {"type": "integer", "minimum": 1},
        "pool": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/memoryOneStrategy"}
        }
      }
    }
  },
  "$defs": {
    "bindingThresholdSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "threshold_kind", "threshold_value"],
      "properties": {
        "metric": {"type": "string", "const": "payoff_gap"},
        "threshold_kind": {"type": "string", "const": "max"},
        "threshold_value": {"type": ["integer", "number"]}
      }
    },
    "memoryOneStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "id", "p0", "p_cc", "p_cd", "p_dc", "p_dd"],
      "properties": {
        "family": {"type": "string", "const": "memory_one"},
        "id": {"type": "string", "minLength": 1},
        "p0": {"type": "number", "minimum": 0, "maximum": 1},
        "p_cc": {"type": "number", "minimum": 0, "maximum": 1},
        "p_cd": {"type": "number", "minimum": 0, "maximum": 1},
        "p_dc": {"type": "number", "minimum": 0, "maximum": 1},
        "p_dd": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
