{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "decision_contract_path",
    "leaderboard_rows",
    "matching_observations",
    "occupancy_policy_rows",
    "packet_intent",
    "packet_version",
    "scratch_retention_note",
    "source_run_label",
    "turnover_policy_rows",
    "world_semantics_observations"
  ],
  "properties": {
    "packet_version": {
      "const": "2026-03-16.rematch_world_benchmark_evidence_packet.v1"
    },
    "packet_intent": {
      "const": "distill one tiny retained evidence packet from a rematch-world run, then compile it into the standard fill patch"
    },
    "scratch_retention_note": {
      "const": "raw run traces and bulky intermediate tables may remain scratch-only once these distilled facts are retained"
    },
    "source_run_label": {
      "type": "string",
      "minLength": 1
    },
    "decision_contract_path": {
      "const": "artifacts/reports/rematch_decision_contract_snapshot_20260316.json"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "world_semantics_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asymmetry_trigger_policy",
        "rematch_state_carry_policy",
        "rematch_state_reset_policy",
        "role_assignment_policy",
        "role_swapped_companion_policy",
        "world_name"
      ],
      "properties": {
        "asymmetry_trigger_policy": {"type": "string", "minLength": 1},
        "rematch_state_carry_policy": {"type": "string", "minLength": 1},
        "rematch_state_reset_policy": {"type": "string", "minLength": 1},
        "role_assignment_policy": {"type": "string", "minLength": 1},
        "role_swapped_companion_policy": {"type": "string", "minLength": 1},
        "world_name": {"type": "string", "minLength": 1}
      }
    },
    "matching_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparability_note",
        "matched_state_fields",
        "matching_efficiency_model",
        "rematch_delay_rounds",
        "search_state_fields"
      ],
      "properties": {
        "comparability_note": {"type": "string", "minLength": 1},
        "matched_state_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "matching_efficiency_model": {"type": "string", "minLength": 1},
        "rematch_delay_rounds": {"type": "number"},
        "search_state_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "occupancy_policy_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregate_avg_payoff",
          "dead_round_share",
          "in_match_avg_payoff",
          "matched_round_share",
          "policy"
        ],
        "properties": {
          "aggregate_avg_payoff": {"type": "number"},
          "dead_round_share": {"type": "number"},
          "in_match_avg_payoff": {"type": "number"},
          "matched_round_share": {"type": "number"},
          "policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "turnover_policy_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "avg_match_length",
          "delay_or_search_dead_time",
          "policy",
          "turnover_metric_label"
        ],
        "properties": {
          "avg_match_length": {"type": "number"},
          "delay_or_search_dead_time": {"type": "number"},
          "policy": {"type": "string", "minLength": 1},
          "turnover_metric_label": {"type": "string", "minLength": 1}
        }
      }
    },
    "leaderboard_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aggregate_avg_payoff",
          "aggregate_rank",
          "in_match_avg_payoff",
          "in_match_rank",
          "policy"
        ],
        "properties": {
          "aggregate_avg_payoff": {"type": "number"},
          "aggregate_rank": {"type": "integer"},
          "in_match_avg_payoff": {"type": "number"},
          "in_match_rank": {"type": "integer"},
          "policy": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
