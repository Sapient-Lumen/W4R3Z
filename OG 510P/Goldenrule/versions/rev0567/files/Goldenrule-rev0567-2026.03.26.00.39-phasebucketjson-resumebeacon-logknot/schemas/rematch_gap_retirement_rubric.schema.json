{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch Gap Retirement Rubric Snapshot",
  "type": "object",
  "required": [
    "focus",
    "snapshot_date",
    "gap_id",
    "gap_summary",
    "decision_contract_path",
    "decision_contract_schema_path",
    "decision_contract_validator_path",
    "rubric_schema_path",
    "rubric_validator_path",
    "question_rows",
    "status_counts",
    "section_status",
    "closure_order",
    "archive_size_reason",
    "recommended_next_move"
  ],
  "properties": {
    "focus": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "minLength": 1},
    "gap_id": {"const": "SG-003"},
    "gap_summary": {"type": "string", "minLength": 1},
    "decision_contract_path": {"type": "string", "minLength": 1},
    "decision_contract_schema_path": {"type": "string", "minLength": 1},
    "decision_contract_validator_path": {"type": "string", "minLength": 1},
    "rubric_schema_path": {"type": "string", "minLength": 1},
    "rubric_validator_path": {"type": "string", "minLength": 1},
    "question_rows": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "question_summary",
          "linked_assumption_id",
          "linked_assumption_summary",
          "contract_section",
          "section_minimum_shape",
          "minimal_fields",
          "section_publication_fields",
          "schema_specified",
          "validator_enforced",
          "proxy_emitted",
          "world_benchmark_emitted",
          "status",
          "question_exit_gap",
          "assumption_exit_gap",
          "source_reports"
        ],
        "properties": {
          "question_id": {"type": "string", "pattern": "^SQ-0(1[7-9]|2[0-6])$"},
          "question_summary": {"type": "string", "minLength": 1},
          "linked_assumption_id": {"type": "string", "pattern": "^SA-0(1[6-9]|2[0-5])$"},
          "linked_assumption_summary": {"type": "string", "minLength": 1},
          "contract_section": {"type": "string", "enum": ["delay_contract", "winner_contract", "delta_contract"]},
          "section_minimum_shape": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer", "minimum": 1}
          },
          "minimal_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "section_publication_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "schema_specified": {"type": "boolean"},
          "validator_enforced": {"type": "boolean"},
          "proxy_emitted": {"type": "boolean"},
          "world_benchmark_emitted": {"type": "boolean"},
          "status": {"const": "world_benchmark_pending"},
          "question_exit_gap": {"type": "string", "minLength": 1},
          "assumption_exit_gap": {"type": "string", "minLength": 1},
          "source_reports": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "schema_specified_and_validator_enforced",
        "proxy_emitted",
        "world_benchmark_pending"
      ],
      "properties": {
        "schema_specified_and_validator_enforced": {"type": "integer", "minimum": 1},
        "proxy_emitted": {"type": "integer", "minimum": 1},
        "world_benchmark_pending": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "section_status": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "contract_section",
          "question_ids",
          "question_count",
          "section_publication_fields",
          "world_benchmark_emitted"
        ],
        "properties": {
          "contract_section": {"type": "string", "enum": ["delay_contract", "winner_contract", "delta_contract"]},
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SQ-0(1[7-9]|2[0-6])$"}
          },
          "question_count": {"type": "integer", "minimum": 1},
          "section_publication_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "world_benchmark_emitted": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "closure_order": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "archive_size_reason": {
      "type": "object",
      "required": [
        "component_report_paths",
        "component_report_total_bytes",
        "bundle_json_bytes",
        "bundle_vs_components_raw_byte_ratio",
        "why_it_matters"
      ],
      "properties": {
        "component_report_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "component_report_total_bytes": {"type": "integer", "minimum": 1},
        "bundle_json_bytes": {"type": "integer", "minimum": 1},
        "bundle_vs_components_raw_byte_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "why_it_matters": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "recommended_next_move": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
