{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_authorization.schema.json",
  "title": "Successor-Safe Ceremony Receipt Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_kind",
    "receipt_id",
    "journey_kind",
    "receipt_locator",
    "assessment_overall_status",
    "archive_admission",
    "residual_risk_response",
    "copy_forward_rule",
    "plan_status",
    "authorization_decision",
    "basis_checks",
    "failed_basis_codes",
    "terms_and_conditions",
    "review_trigger",
    "recommended_next_step"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authorization_kind": {"const": "successor_safe_ceremony_receipt_authorization"},
    "receipt_id": {"type": "string", "minLength": 1},
    "journey_kind": {"type": "string", "enum": ["presentation", "authorization", "authentication", "issuance", "other"]},
    "receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ni_uri", "digest_hex", "source_path"],
      "properties": {
        "ni_uri": {"type": "string", "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"},
        "digest_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_path": {"type": "string", "minLength": 1}
      }
    },
    "assessment_overall_status": {"type": "string", "enum": ["pass", "warn", "fail"]},
    "archive_admission": {"type": "string", "enum": ["claim_ready_citable", "provisional_locator_only", "hold_for_remediation"]},
    "residual_risk_response": {"type": "string", "enum": ["accept", "mitigate"]},
    "copy_forward_rule": {"type": "string", "enum": ["cite_locator_only", "cite_locator_until_remediated", "hold_until_remediated"]},
    "plan_status": {"type": "string", "enum": ["monitor_only", "open"]},
    "authorization_decision": {"type": "string", "enum": ["authorized_for_claim_ready_citation", "not_authorized_for_claim_ready_citation"]},
    "basis_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "passed", "summary"],
        "properties": {
          "code": {"type": "string", "enum": ["assessment_green", "no_open_blocking_work_items", "claim_ready_archive_admission", "locator_only_copy_forward"]},
          "passed": {"type": "boolean"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "failed_basis_codes": {
      "type": "array",
      "items": {"type": "string", "enum": ["assessment_green", "no_open_blocking_work_items", "claim_ready_archive_admission", "locator_only_copy_forward"]},
      "uniqueItems": true
    },
    "terms_and_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "review_trigger": {"type": "string", "minLength": 1},
    "recommended_next_step": {"type": "string", "minLength": 1}
  }
}
