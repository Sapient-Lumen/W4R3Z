{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_script": {
      "type": "string"
    },
    "artifact_written": {
      "type": "boolean"
    },
    "compiled_candidate": {
      "additionalProperties": false,
      "properties": {
        "artifact_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "artifact_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact_output_path",
        "artifact_sha256",
        "artifact_state",
        "byte_count"
      ],
      "type": "object"
    },
    "decision_contract_path": {
      "type": "string"
    },
    "decision_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision_emission": {
      "additionalProperties": false,
      "properties": {
        "allowed_open_interval_count": {
          "minimum": 0,
          "type": "integer"
        },
        "bundle_matches_standing_contract": {
          "type": "boolean"
        },
        "copied_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "emitted_question_id_count": {
          "minimum": 10,
          "type": "integer"
        },
        "emitted_question_ids": {
          "items": {
            "pattern": "^SQ-[0-9]{3}$",
            "type": "string"
          },
          "minItems": 10,
          "type": "array"
        },
        "emitted_sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "question_id_count": {
                "minimum": 1,
                "type": "integer"
              },
              "question_ids": {
                "items": {
                  "pattern": "^SQ-[0-9]{3}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "section": {
                "enum": [
                  "delay_contract",
                  "winner_contract",
                  "delta_contract"
                ],
                "type": "string"
              }
            },
            "required": [
              "section",
              "question_ids",
              "question_id_count"
            ],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "phase": {
          "const": "SG-003.phase3_world_emission"
        },
        "standing_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "world_emission_ready": {
          "type": "boolean"
        }
      },
      "required": [
        "phase",
        "world_emission_ready",
        "copied_bundle_sha256",
        "standing_contract_sha256",
        "bundle_matches_standing_contract",
        "emitted_sections",
        "emitted_question_ids",
        "emitted_question_id_count",
        "allowed_open_interval_count"
      ],
      "type": "object"
    },
    "evidence_receipt_matches_packet": {
      "type": "boolean"
    },
    "evidence_receipt_path": {
      "type": "string"
    },
    "evidence_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_receipt_strict_coverage_passed": {
      "type": "boolean"
    },
    "focus": {
      "type": "string"
    },
    "packet_path": {
      "type": "string"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "packet_source_run_label": {
      "type": "string"
    },
    "patch_elision_ready": {
      "type": "boolean"
    },
    "patch_retention_required": {
      "type": "boolean"
    },
    "patch_written": {
      "type": "boolean"
    },
    "preflight": {
      "additionalProperties": false,
      "properties": {
        "allowed_decision_null_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocking_fill_slot_count": {
          "minimum": 0,
          "type": "integer"
        },
        "decision_bundle_digest_matches_contract": {
          "type": "boolean"
        },
        "filled_world_section_count": {
          "minimum": 0,
          "type": "integer"
        },
        "forbidden_changed_path_count": {
          "minimum": 0,
          "type": "integer"
        },
        "mutation_surface_ok": {
          "type": "boolean"
        },
        "preflight_ready": {
          "type": "boolean"
        },
        "template_blocker_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "allowed_decision_null_count",
        "blocking_fill_slot_count",
        "decision_bundle_digest_matches_contract",
        "filled_world_section_count",
        "forbidden_changed_path_count",
        "mutation_surface_ok",
        "preflight_ready",
        "template_blocker_count"
      ],
      "type": "object"
    },
    "receipt_version": {
      "type": "string"
    },
    "recommended_next_move": {
      "type": "string"
    },
    "recommended_retained_objects": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "type": "array"
    },
    "seed_path": {
      "type": "string"
    },
    "seed_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_date": {
      "type": "string"
    },
    "transient_patch": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "type": "integer"
        },
        "patch_output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "byte_count",
        "patch_output_path",
        "patch_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "analysis_script",
    "artifact_written",
    "compiled_candidate",
    "decision_contract_path",
    "decision_contract_sha256",
    "decision_emission",
    "evidence_receipt_matches_packet",
    "evidence_receipt_path",
    "evidence_receipt_sha256",
    "evidence_receipt_strict_coverage_passed",
    "focus",
    "packet_path",
    "packet_sha256",
    "packet_source_run_label",
    "patch_elision_ready",
    "patch_retention_required",
    "patch_written",
    "preflight",
    "receipt_version",
    "recommended_next_move",
    "recommended_retained_objects",
    "seed_path",
    "seed_sha256",
    "snapshot_date",
    "transient_patch"
  ],
  "title": "Rematch World Benchmark Publication Bundle Receipt",
  "type": "object"
}
