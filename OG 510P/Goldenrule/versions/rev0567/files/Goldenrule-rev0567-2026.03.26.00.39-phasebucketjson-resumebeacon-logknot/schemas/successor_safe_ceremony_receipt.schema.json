{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successor-Safe Ceremony Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "journey_kind",
    "authoritative_request",
    "verifier_targeting",
    "delivery_path",
    "approval_surface",
    "ceremony_topology",
    "linkability_and_retention",
    "retained_evidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/nonempty_string"},
    "journey_kind": {
      "type": "string",
      "enum": ["presentation", "authorization", "authentication", "issuance", "other"]
    },
    "authoritative_request": {"$ref": "#/$defs/three_field_block"},
    "verifier_targeting": {"$ref": "#/$defs/three_field_block"},
    "delivery_path": {"$ref": "#/$defs/three_field_block"},
    "approval_surface": {"$ref": "#/$defs/three_field_block"},
    "ceremony_topology": {"$ref": "#/$defs/four_field_block"},
    "linkability_and_retention": {"$ref": "#/$defs/three_field_block"},
    "retained_evidence": {"$ref": "#/$defs/three_field_block"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1},
    "three_field_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_one", "field_two", "field_three"],
      "properties": {
        "field_one": {"$ref": "#/$defs/nonempty_string"},
        "field_two": {"$ref": "#/$defs/nonempty_string"},
        "field_three": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "four_field_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_one", "field_two", "field_three", "field_four"],
      "properties": {
        "field_one": {"$ref": "#/$defs/nonempty_string"},
        "field_two": {"$ref": "#/$defs/nonempty_string"},
        "field_three": {"$ref": "#/$defs/nonempty_string"},
        "field_four": {"$ref": "#/$defs/nonempty_string"}
      }
    }
  }
}
