{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_matching_state_interpretation_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_matching_state_interpretation_handoff.v1"
    },
    "delay_tax_summary": {
      "additionalProperties": false,
      "properties": {
        "all_tested_policy_extortion_cells_are_monotone_in_delay": {
          "type": "boolean"
        },
        "largest_mean_delay_tax_policy": {
          "additionalProperties": false,
          "properties": {
            "mean_delay0_to_delay2_loss": {
              "type": "number"
            },
            "policy": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "policy",
            "mean_delay0_to_delay2_loss"
          ],
          "type": "object"
        },
        "ranked_mean_delay_tax": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "mean_delay0_to_delay2_loss": {
                "type": "number"
              },
              "policy": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "policy",
              "mean_delay0_to_delay2_loss"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "smallest_mean_delay_tax_policy": {
          "additionalProperties": false,
          "properties": {
            "mean_delay0_to_delay2_loss": {
              "type": "number"
            },
            "policy": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "policy",
            "mean_delay0_to_delay2_loss"
          ],
          "type": "object"
        },
        "tested_cells": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "tested_cells",
        "all_tested_policy_extortion_cells_are_monotone_in_delay",
        "largest_mean_delay_tax_policy",
        "smallest_mean_delay_tax_policy",
        "ranked_mean_delay_tax"
      ],
      "type": "object"
    },
    "linked_question_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "matching_friction_report_path": {
      "const": "artifacts/reports/rematch_proxy_matching_friction_snapshot_20260306.json"
    },
    "matching_friction_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "matching_state_contract_guidance": {
      "additionalProperties": false,
      "properties": {
        "comparability_rule": {
          "minLength": 1,
          "type": "string"
        },
        "matching_efficiency_interpretation_rule": {
          "minLength": 1,
          "type": "string"
        },
        "required_matched_state_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "required_search_state_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "matching_efficiency_interpretation_rule",
        "comparability_rule",
        "required_search_state_fields",
        "required_matched_state_fields"
      ],
      "type": "object"
    },
    "occupancy_accounting_report_path": {
      "const": "artifacts/reports/rematch_proxy_occupancy_accounting_snapshot_20260306.json"
    },
    "occupancy_accounting_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "occupancy_accounting_summary": {
      "additionalProperties": false,
      "properties": {
        "matched_share_monotone_nonincreasing_in_all_tested_cells": {
          "type": "boolean"
        },
        "max_abs_identity_gap_across_all_delay_means": {
          "minimum": 0,
          "type": "number"
        },
        "max_abs_in_match_payoff_drift_delay0_to_delay2": {
          "minimum": 0,
          "type": "number"
        },
        "mean_share_component_fraction_of_delay_loss": {
          "minimum": 0,
          "type": "number"
        },
        "min_share_component_fraction_of_delay_loss": {
          "minimum": 0,
          "type": "number"
        },
        "tested_cells": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "tested_cells",
        "matched_share_monotone_nonincreasing_in_all_tested_cells",
        "mean_share_component_fraction_of_delay_loss",
        "min_share_component_fraction_of_delay_loss",
        "max_abs_in_match_payoff_drift_delay0_to_delay2",
        "max_abs_identity_gap_across_all_delay_means"
      ],
      "type": "object"
    },
    "planner_origin": {
      "const": "copy the current proxy-era matching-friction and occupancy interpretation into the benchmark seed until native rematch worlds can emit matching-state sections directly"
    },
    "size_discipline_note": {
      "minLength": 1,
      "type": "string"
    },
    "tested_delay_values": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array"
    },
    "tested_extortion_values": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array"
    },
    "tested_policy_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "upgrade_requirement": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "matching_friction_report_path",
    "matching_friction_report_sha256",
    "occupancy_accounting_report_path",
    "occupancy_accounting_report_sha256",
    "linked_question_ids",
    "tested_policy_ids",
    "tested_extortion_values",
    "tested_delay_values",
    "delay_tax_summary",
    "occupancy_accounting_summary",
    "matching_state_contract_guidance",
    "upgrade_requirement",
    "size_discipline_note"
  ],
  "title": "Rematch World Benchmark Matching-State Interpretation Handoff",
  "type": "object"
}
