{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage_sections",
    "missing_sections",
    "packet_bytes",
    "packet_path",
    "packet_sha256",
    "receipt_intent",
    "receipt_version",
    "scratch_source_count",
    "scratch_sources",
    "scratch_total_bytes",
    "source_run_label",
    "strict_coverage_passed"
  ],
  "properties": {
    "coverage_sections": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "minItems": 1
    },
    "missing_sections": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "packet_bytes": {"type": "integer", "minimum": 1},
    "packet_path": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_intent": {"type": "string", "minLength": 1},
    "receipt_version": {"type": "string", "minLength": 1},
    "scratch_source_count": {"type": "integer", "minimum": 1},
    "scratch_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["byte_count", "covered_sections", "label", "scratch_path", "sha256"],
        "properties": {
          "byte_count": {"type": "integer", "minimum": 1},
          "covered_sections": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true,
            "minItems": 1
          },
          "label": {"type": "string", "minLength": 1},
          "scratch_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "scratch_total_bytes": {"type": "integer", "minimum": 1},
    "source_run_label": {"type": "string", "minLength": 1},
    "strict_coverage_passed": {"type": "boolean"}
  }
}
