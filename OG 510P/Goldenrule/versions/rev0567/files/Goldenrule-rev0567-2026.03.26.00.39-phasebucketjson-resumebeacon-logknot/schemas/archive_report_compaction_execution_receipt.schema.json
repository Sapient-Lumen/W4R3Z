{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_script": {
      "const": "scripts/tools/build_archive_report_compaction_execution_receipt.py",
      "type": "string"
    },
    "archive_posture": {
      "additionalProperties": false,
      "properties": {
        "intended_retention_class": {
          "minLength": 1,
          "type": "string"
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "type": "object"
    },
    "executed_manifest": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "backing_handle_count": {
            "minimum": 1,
            "type": "integer"
          },
          "backing_handles": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "doc",
                    "library_topic",
                    "snapshot"
                  ],
                  "type": "string"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "exact_report_file_count": {
            "minimum": 1,
            "type": "integer"
          },
          "exact_report_paths": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "family": {
            "minLength": 1,
            "type": "string"
          },
          "file_rows": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "file_kind": {
                  "minLength": 1,
                  "type": "string"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "raw_bytes": {
                  "minimum": 1,
                  "type": "integer"
                },
                "raw_mebibytes": {
                  "minimum": 0,
                  "type": "number"
                },
                "source_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "file_kind",
                "path",
                "raw_bytes",
                "raw_mebibytes",
                "source_sha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "priority_rank": {
            "minimum": 1,
            "type": "integer"
          },
          "raw_bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "raw_mebibytes": {
            "minimum": 0,
            "type": "number"
          },
          "semantic_alias_used": {
            "type": "boolean"
          },
          "share_of_report_bucket_raw_bytes": {
            "minimum": 0,
            "type": "number"
          },
          "trim_mode": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "backing_handle_count",
          "backing_handles",
          "exact_report_file_count",
          "exact_report_paths",
          "family",
          "file_rows",
          "priority_rank",
          "raw_bytes",
          "raw_mebibytes",
          "semantic_alias_used",
          "share_of_report_bucket_raw_bytes",
          "trim_mode"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "headline_findings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "measurement_scope": {
      "additionalProperties": false,
      "properties": {
        "output_receipt_self_excluded": {
          "type": "boolean"
        },
        "post_execution_frontier_refresh_required": {
          "type": "boolean"
        },
        "report_root": {
          "const": "artifacts/reports",
          "type": "string"
        },
        "seed_receipt_self_reused": {
          "type": "boolean"
        }
      },
      "required": [
        "output_receipt_self_excluded",
        "post_execution_frontier_refresh_required",
        "report_root",
        "seed_receipt_self_reused"
      ],
      "type": "object"
    },
    "policy_checks": {
      "additionalProperties": false,
      "properties": {
        "all_executed_rows_citation_backed": {
          "type": "boolean"
        },
        "executed_manifest_nonempty": {
          "type": "boolean"
        },
        "executed_paths_absent_now": {
          "type": "boolean"
        },
        "executed_paths_removed_from_live_manifest": {
          "type": "boolean"
        },
        "executed_paths_under_reports": {
          "type": "boolean"
        },
        "executed_paths_unique": {
          "type": "boolean"
        },
        "executed_raw_bytes_match_pre_manifest": {
          "type": "boolean"
        },
        "frontier_shifted_after_execution": {
          "type": "boolean"
        },
        "net_raw_tree_shrink_not_greater_than_executed_bytes": {
          "type": "boolean"
        },
        "net_raw_tree_shrink_positive": {
          "type": "boolean"
        },
        "net_retained_file_shrink_positive": {
          "type": "boolean"
        },
        "next_frontier_rehearsed": {
          "type": "boolean"
        },
        "next_manifest_present": {
          "type": "boolean"
        },
        "post_hotspot_receipt_ready": {
          "type": "boolean"
        },
        "post_manifest_receipt_ready": {
          "type": "boolean"
        },
        "post_package_receipt_ready": {
          "type": "boolean"
        },
        "post_rehearsal_receipt_ready": {
          "type": "boolean"
        },
        "report_bucket_file_delta_reconciles_with_executed_files": {
          "type": "boolean"
        },
        "report_bucket_net_shrink_not_greater_than_executed_bytes": {
          "type": "boolean"
        },
        "report_bucket_net_shrink_positive": {
          "type": "boolean"
        },
        "report_bucket_pair_delta_reconciles_with_executed_pairs": {
          "type": "boolean"
        },
        "report_bucket_retained_addition_file_count_accounted": {
          "type": "boolean"
        },
        "report_bucket_retained_addition_pair_count_accounted": {
          "type": "boolean"
        },
        "report_bucket_retained_addition_raw_bytes_accounted": {
          "type": "boolean"
        },
        "retained_addition_file_count_accounted": {
          "type": "boolean"
        },
        "retained_addition_raw_bytes_accounted": {
          "type": "boolean"
        }
      },
      "required": [
        "all_executed_rows_citation_backed",
        "executed_manifest_nonempty",
        "executed_paths_absent_now",
        "executed_paths_removed_from_live_manifest",
        "executed_paths_under_reports",
        "executed_paths_unique",
        "executed_raw_bytes_match_pre_manifest",
        "frontier_shifted_after_execution",
        "next_frontier_rehearsed",
        "next_manifest_present",
        "net_raw_tree_shrink_not_greater_than_executed_bytes",
        "net_raw_tree_shrink_positive",
        "net_retained_file_shrink_positive",
        "post_hotspot_receipt_ready",
        "post_manifest_receipt_ready",
        "post_package_receipt_ready",
        "post_rehearsal_receipt_ready",
        "report_bucket_net_shrink_not_greater_than_executed_bytes",
        "report_bucket_net_shrink_positive",
        "report_bucket_retained_addition_raw_bytes_accounted",
        "retained_addition_file_count_accounted",
        "retained_addition_raw_bytes_accounted",
        "report_bucket_retained_addition_file_count_accounted",
        "report_bucket_file_delta_reconciles_with_executed_files",
        "report_bucket_retained_addition_pair_count_accounted",
        "report_bucket_pair_delta_reconciles_with_executed_pairs"
      ],
      "type": "object"
    },
    "post_hotspot_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "post_hotspot_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "post_manifest_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "post_manifest_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "post_package_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "post_package_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "post_rehearsal_receipt_path": {
      "minLength": 1,
      "type": "string"
    },
    "post_rehearsal_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pre_trim_manifest_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pre_trim_package_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "pre_trim_summary": {
      "additionalProperties": false,
      "properties": {
        "approx_zip_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "manifest_family_count": {
          "minimum": 1,
          "type": "integer"
        },
        "manifest_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "manifest_raw_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "raw_tree_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "report_bucket_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "report_bucket_pair_count": {
          "minimum": 0,
          "type": "integer"
        },
        "report_bucket_raw_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "retained_file_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "approx_zip_bytes",
        "manifest_family_count",
        "manifest_file_count",
        "manifest_raw_bytes",
        "raw_tree_bytes",
        "report_bucket_file_count",
        "report_bucket_pair_count",
        "report_bucket_raw_bytes",
        "retained_file_count"
      ],
      "type": "object"
    },
    "receipt_kind": {
      "const": "archive_report_compaction_execution_receipt"
    },
    "receipt_version": {
      "minLength": 1,
      "type": "string"
    },
    "recommended_next_move": {
      "minLength": 1,
      "type": "string"
    },
    "status_counts": {
      "additionalProperties": false,
      "properties": {
        "passed_check_count": {
          "minimum": 0,
          "type": "integer"
        },
        "ready_to_cite": {
          "type": "boolean"
        },
        "total_check_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "type": "object"
    },
    "summary_metrics": {
      "additionalProperties": false,
      "properties": {
        "approx_zip_bytes_delta": {
          "type": "integer"
        },
        "executed_family_count": {
          "minimum": 1,
          "type": "integer"
        },
        "executed_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "executed_raw_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "executed_raw_mebibytes": {
          "minimum": 0,
          "type": "number"
        },
        "executed_share_of_pre_trim_report_bucket_raw_bytes": {
          "minimum": 0,
          "type": "number"
        },
        "next_frontier_gap_count": {
          "minimum": 0,
          "type": "integer"
        },
        "next_frontier_leading_hotspot_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_manifest_family_count": {
          "minimum": 0,
          "type": "integer"
        },
        "next_manifest_file_count": {
          "minimum": 0,
          "type": "integer"
        },
        "next_manifest_raw_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "post_trim_approx_zip_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "post_trim_raw_tree_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "post_trim_report_bucket_file_count": {
          "minimum": 0,
          "type": "integer"
        },
        "post_trim_report_bucket_pair_count": {
          "minimum": 0,
          "type": "integer"
        },
        "post_trim_report_bucket_raw_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "post_trim_retained_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "pre_trim_approx_zip_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "pre_trim_raw_tree_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "pre_trim_report_bucket_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "pre_trim_report_bucket_pair_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pre_trim_report_bucket_raw_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "pre_trim_retained_file_count": {
          "minimum": 1,
          "type": "integer"
        },
        "raw_tree_bytes_delta": {
          "type": "integer"
        },
        "report_bucket_file_count_delta": {
          "type": "integer"
        },
        "report_bucket_pair_count_delta": {
          "minimum": 0,
          "type": "integer"
        },
        "report_bucket_raw_bytes_delta": {
          "type": "integer"
        },
        "report_bucket_retained_addition_file_count_during_pass": {
          "type": "integer"
        },
        "report_bucket_retained_addition_pair_count_during_pass": {
          "type": "integer"
        },
        "report_bucket_retained_addition_raw_bytes_during_pass": {
          "type": "integer"
        },
        "retained_addition_file_count_during_pass": {
          "type": "integer"
        },
        "retained_addition_raw_bytes_during_pass": {
          "type": "integer"
        },
        "retained_file_count_delta": {
          "type": "integer"
        }
      },
      "required": [
        "approx_zip_bytes_delta",
        "executed_family_count",
        "executed_file_count",
        "executed_raw_bytes",
        "executed_raw_mebibytes",
        "executed_share_of_pre_trim_report_bucket_raw_bytes",
        "next_frontier_gap_count",
        "next_frontier_leading_hotspot_family",
        "next_manifest_family_count",
        "next_manifest_file_count",
        "next_manifest_raw_bytes",
        "post_trim_approx_zip_bytes",
        "post_trim_raw_tree_bytes",
        "post_trim_report_bucket_file_count",
        "post_trim_report_bucket_pair_count",
        "post_trim_report_bucket_raw_bytes",
        "post_trim_retained_file_count",
        "pre_trim_approx_zip_bytes",
        "pre_trim_raw_tree_bytes",
        "pre_trim_report_bucket_file_count",
        "pre_trim_report_bucket_pair_count",
        "pre_trim_report_bucket_raw_bytes",
        "pre_trim_retained_file_count",
        "raw_tree_bytes_delta",
        "report_bucket_file_count_delta",
        "report_bucket_pair_count_delta",
        "report_bucket_raw_bytes_delta",
        "report_bucket_retained_addition_raw_bytes_during_pass",
        "retained_addition_file_count_during_pass",
        "retained_addition_raw_bytes_during_pass",
        "retained_file_count_delta",
        "report_bucket_retained_addition_file_count_during_pass",
        "report_bucket_retained_addition_pair_count_during_pass"
      ],
      "type": "object"
    }
  },
  "required": [
    "analysis_script",
    "archive_posture",
    "executed_manifest",
    "headline_findings",
    "measurement_scope",
    "policy_checks",
    "post_hotspot_receipt_path",
    "post_hotspot_receipt_sha256",
    "post_manifest_receipt_path",
    "post_manifest_receipt_sha256",
    "post_package_receipt_path",
    "post_package_receipt_sha256",
    "post_rehearsal_receipt_path",
    "post_rehearsal_receipt_sha256",
    "pre_trim_manifest_receipt_sha256",
    "pre_trim_package_receipt_sha256",
    "pre_trim_summary",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "status_counts",
    "summary_metrics"
