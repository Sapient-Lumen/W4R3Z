{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooperation Benchmark Card Freeze Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "card_id",
    "benchmark_name",
    "result_kind",
    "card_path",
    "card_sha256",
    "rendered_markdown_path",
    "rendered_markdown_sha256",
    "card_schema_path",
    "card_schema_sha256",
    "freeze_tool_path",
    "freeze_tool_sha256",
    "claim_ready"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "receipt_kind": {
      "type": "string",
      "const": "cooperation_benchmark_card_freeze_receipt"
    },
    "card_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_name": {
      "type": "string",
      "minLength": 1
    },
    "result_kind": {
      "type": "string",
      "enum": [
        "comparative",
        "descriptive",
        "method_note"
      ]
    },
    "card_path": {
      "type": "string",
      "minLength": 1
    },
    "card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rendered_markdown_path": {
      "type": "string",
      "minLength": 1
    },
    "rendered_markdown_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "card_schema_path": {
      "type": "string",
      "minLength": 1
    },
    "card_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "freeze_tool_path": {
      "type": "string",
      "minLength": 1
    },
    "freeze_tool_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_ready": {
      "type": "boolean",
      "const": true
    },
    "lineage_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_kind",
        "lineage_id",
        "observed_operational_head_card_ids",
        "matched_card_id"
      ],
      "properties": {
        "guard_kind": {
          "type": "string",
          "const": "require_unique_operational_head"
        },
        "lineage_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_operational_head_card_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "matched_card_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
