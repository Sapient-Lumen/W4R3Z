{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_package_head.schema.json",
  "title": "Successor-Safe Ceremony Receipt Package Head",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_head_kind",
    "receipt_id",
    "journey_kind",
    "authoritative_manifest",
    "package_lineage",
    "active_receipt_locator_digest_hex",
    "current_package_state",
    "current_status_card",
    "current_verification_report",
    "current_claim_scope",
    "current_reliance_card",
    "discovery_links",
    "package_head_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_head_kind": {
      "const": "successor_safe_ceremony_receipt_package_head"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "authoritative_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "current_claim_status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "package_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex",
        "head_position",
        "chain_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "head_position": {
          "type": "integer",
          "minimum": 1
        },
        "chain_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "active_receipt_locator_digest_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_package_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_claim_status",
        "review_decision",
        "advisory_decision",
        "verification_decision",
        "claim_scope_decision"
      ],
      "properties": {
        "current_claim_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        },
        "review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "advisory_decision": {
          "type": "string",
          "enum": [
            "keep_current_locator_citable",
            "withdraw_current_locator_from_claim_ready_citation"
          ]
        },
        "verification_decision": {
          "type": "string",
          "enum": [
            "verified_python_lane_only",
            "verified_full_stack",
            "verification_failed"
          ]
        },
        "claim_scope_decision": {
          "type": "string",
          "enum": [
            "citation_allowed_non_runtime_claims_only",
            "citation_allowed_full_stack_claims",
            "citation_suspended_pending_regeneration",
            "citation_requires_reverification"
          ]
        }
      }
    },
    "discovery_links": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel",
          "target_kind",
          "path",
          "sha256_hex"
        ],
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "latest-version",
              "version-history",
              "describedby",
              "status",
              "predecessor-version"
            ]
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "package_manifest",
              "package_lineage",
              "review_verdict",
              "citation_advisory",
              "package_verification_report",
              "package_claim_scope",
              "package_status_card",
              "previous_package_manifest",
              "package_reliance_card"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "package_head_summary": {
      "type": "string",
      "minLength": 1
    },
    "current_status_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "current_verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "current_claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "current_reliance_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256_hex"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
