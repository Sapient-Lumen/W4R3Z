{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_citation_advisory.schema.json",
  "title": "Successor-Safe Ceremony Receipt Citation Advisory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "citation_advisory_kind",
    "receipt_id",
    "journey_kind",
    "reviewed_receipt_locator",
    "source_review_verdict",
    "advisory_decision",
    "reviewed_locator_status",
    "advisory_reason_codes",
    "matched_reopen_trigger_codes",
    "failed_review_basis_codes",
    "existing_citations_action",
    "new_citations_action",
    "required_follow_up",
    "advisory_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "citation_advisory_kind": {
      "const": "successor_safe_ceremony_receipt_citation_advisory"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "reviewed_receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ni_uri",
        "digest_hex",
        "source_path"
      ],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_review_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "review_decision",
        "citation_status"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "review_decision": {
          "type": "string",
          "enum": [
            "continue_claim_ready_citation",
            "reopen_and_suspend_claim_ready_citation"
          ]
        },
        "citation_status": {
          "type": "string",
          "enum": [
            "claim_ready_citable",
            "suspended_pending_regeneration"
          ]
        }
      }
    },
    "advisory_decision": {
      "type": "string",
      "enum": [
        "keep_current_locator_citable",
        "withdraw_current_locator_from_claim_ready_citation"
      ]
    },
    "reviewed_locator_status": {
      "type": "string",
      "enum": [
        "citable",
        "withdrawn"
      ]
    },
    "advisory_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "review_clean",
          "ceremony_contract_changed",
          "protocol_surface_changed",
          "retained_evidence_changed",
          "retention_policy_changed",
          "new_nonpass_findings",
          "authorization_terms_changed",
          "review_interval_elapsed",
          "watch_active_before_review",
          "within_review_interval",
          "no_reopen_trigger_observed",
          "prior_package_authorized",
          "review_reopened"
        ]
      }
    },
    "matched_reopen_trigger_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ceremony_contract_changed",
          "protocol_surface_changed",
          "retained_evidence_changed",
          "retention_policy_changed",
          "new_nonpass_findings",
          "authorization_terms_changed",
          "review_interval_elapsed"
        ]
      }
    },
    "failed_review_basis_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "watch_active_before_review",
          "within_review_interval",
          "no_reopen_trigger_observed",
          "prior_package_authorized"
        ]
      }
    },
    "existing_citations_action": {
      "type": "string",
      "enum": [
        "keep",
        "flag_for_withdrawal"
      ]
    },
    "new_citations_action": {
      "type": "string",
      "enum": [
        "cite_reviewed_locator",
        "suspend_until_regenerated"
      ]
    },
    "required_follow_up": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "locator",
          "assessment",
          "disposition",
          "remediation",
          "authorization",
          "promotion",
          "review_watch"
        ]
      }
    },
    "advisory_summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
