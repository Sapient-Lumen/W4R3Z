{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Fill Status Snapshot",
  "type": "object",
  "required": [
    "focus",
    "snapshot_date",
    "seed_artifact_path",
    "decision_contract_path",
    "publication_contract_path",
    "completion_ready",
    "completion_gate_rules",
    "section_rows",
    "blocking_slot_rows",
    "allowed_decision_null_rows",
    "status_counts",
    "main_findings",
    "recommended_next_move",
    "analysis_script",
    "schema_path",
    "validator_path",
    "source_artifacts"
  ],
  "properties": {
    "focus": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "minLength": 1},
    "seed_artifact_path": {"type": "string", "minLength": 1},
    "decision_contract_path": {"type": "string", "minLength": 1},
    "publication_contract_path": {"type": "string", "minLength": 1},
    "completion_ready": {"type": "boolean"},
    "completion_gate_rules": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "section_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "section",
          "title",
          "linked_question_ids",
          "blocking_slot_count",
          "template_blocker_count",
          "null_blocker_count",
          "status_transition_required"
        ],
        "properties": {
          "section": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "linked_question_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^SQ-0(1[2-9]|2[0-6])$"}
          },
          "blocking_slot_count": {"type": "integer", "minimum": 0},
          "template_blocker_count": {"type": "integer", "minimum": 0},
          "null_blocker_count": {"type": "integer", "minimum": 0},
          "status_transition_required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "blocking_slot_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["blocker_kind", "path", "section", "linked_question_ids", "current_value_summary"],
        "properties": {
          "blocker_kind": {"type": "string", "enum": ["template_string", "null_fill_required"]},
          "path": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "linked_question_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^SQ-0(1[2-9]|2[0-6])$"}
          },
          "current_value_summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "allowed_decision_null_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "section", "linked_question_ids", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "section": {"const": "compact_decision_bundle"},
          "linked_question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^SQ-0(1[7-9]|2[0-6])$"}
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "blocking_slot_count",
        "template_blocker_count",
        "null_blocker_count",
        "world_section_status_pending_count",
        "allowed_decision_null_count",
        "sections_with_fill_blockers"
      ],
      "properties": {
        "blocking_slot_count": {"type": "integer", "minimum": 1},
        "template_blocker_count": {"type": "integer", "minimum": 1},
        "null_blocker_count": {"type": "integer", "minimum": 1},
        "world_section_status_pending_count": {"type": "integer", "minimum": 1},
        "allowed_decision_null_count": {"type": "integer", "minimum": 1},
        "sections_with_fill_blockers": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "main_findings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_next_move": {"type": "string", "minLength": 1},
    "analysis_script": {"type": "string", "minLength": 1},
    "schema_path": {"type": "string", "minLength": 1},
    "validator_path": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
