{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch Delta Anchor Contract Snapshot",
  "type": "object",
  "required": [
    "focus",
    "headline_findings",
    "method_note",
    "band_rows",
    "source_report",
    "source_script"
  ],
  "properties": {
    "focus": {
      "type": "string",
      "minLength": 1
    },
    "headline_findings": {
      "type": "object",
      "required": [
        "parent_band_count",
        "fragmented_parent_band_count",
        "parent_anchor_zero_topology_buffer_count",
        "topology_preserving_anchor_improves_buffer_count",
        "topology_preserving_anchor_same_topology_count",
        "topology_preserving_anchor_same_counts_count",
        "topology_preserving_anchor_within_budget_cap_count",
        "topology_preserving_anchor_same_exact_additional_seed_count",
        "only_non_improving_band"
      ],
      "properties": {
        "parent_band_count": {"type": "integer", "minimum": 1},
        "fragmented_parent_band_count": {"type": "integer", "minimum": 0},
        "parent_anchor_zero_topology_buffer_count": {"type": "integer", "minimum": 0},
        "topology_preserving_anchor_improves_buffer_count": {"type": "integer", "minimum": 0},
        "topology_preserving_anchor_same_topology_count": {"type": "integer", "minimum": 0},
        "topology_preserving_anchor_same_counts_count": {"type": "integer", "minimum": 0},
        "topology_preserving_anchor_within_budget_cap_count": {"type": "integer", "minimum": 0},
        "topology_preserving_anchor_same_exact_additional_seed_count": {"type": "integer", "minimum": 0},
        "only_non_improving_band": {
          "type": "object",
          "required": [
            "budget_cap_additional_paired_seeds",
            "parent_band_start_delta",
            "parent_band_end_delta",
            "parent_anchor_delta"
          ],
          "properties": {
            "budget_cap_additional_paired_seeds": {"type": "integer", "minimum": 1},
            "parent_band_start_delta": {"type": "number", "minimum": 0},
            "parent_band_end_delta": {"type": "number", "minimum": 0},
            "parent_anchor_delta": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "method_note": {
      "type": "string",
      "minLength": 1
    },
    "band_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "budget_cap_additional_paired_seeds",
          "parent_band_start_delta",
          "parent_band_end_delta",
          "parent_band_width",
          "fragmented_parent_band",
          "contains_single_point_knife_edge",
          "parent_anchor",
          "topology_preserving_anchor"
        ],
        "properties": {
          "budget_cap_additional_paired_seeds": {"type": "integer", "minimum": 1},
          "parent_band_start_delta": {"type": "number", "minimum": 0},
          "parent_band_end_delta": {"type": "number", "minimum": 0},
          "parent_band_width": {"type": "number", "minimum": 0},
          "fragmented_parent_band": {"type": "boolean"},
          "contains_single_point_knife_edge": {"type": "boolean"},
          "parent_anchor": {
            "type": "object",
            "required": [
              "delta",
              "topology_code",
              "counts",
              "buffer_to_nearest_topology_boundary",
              "total_additional_paired_seeds"
            ],
            "properties": {
              "delta": {"type": "number", "minimum": 0},
              "topology_code": {"type": "string", "minLength": 1},
              "counts": {
                "type": "object",
                "required": ["material_leader", "practical_tie", "undecided"],
                "properties": {
                  "material_leader": {"type": "integer", "minimum": 0},
                  "practical_tie": {"type": "integer", "minimum": 0},
                  "undecided": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "buffer_to_nearest_topology_boundary": {"type": "number", "minimum": 0},
              "total_additional_paired_seeds": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": true
          },
          "topology_preserving_anchor": {
            "type": "object",
            "required": [
              "delta",
              "topology_subband_start_delta",
              "topology_subband_end_delta",
              "topology_subband_width",
              "topology_code",
              "counts",
              "buffer_to_nearest_topology_boundary",
              "buffer_gain_vs_parent",
              "total_additional_paired_seeds",
              "same_topology_as_parent",
              "same_counts_as_parent",
              "same_exact_additional_paired_seeds_as_parent",
              "stays_within_budget_cap"
            ],
            "properties": {
              "delta": {"type": "number", "minimum": 0},
              "topology_subband_start_delta": {"type": "number", "minimum": 0},
              "topology_subband_end_delta": {"type": "number", "minimum": 0},
              "topology_subband_width": {"type": "number", "minimum": 0},
              "topology_code": {"type": "string", "minLength": 1},
              "counts": {
                "type": "object",
                "required": ["material_leader", "practical_tie", "undecided"],
                "properties": {
                  "material_leader": {"type": "integer", "minimum": 0},
                  "practical_tie": {"type": "integer", "minimum": 0},
                  "undecided": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "buffer_to_nearest_topology_boundary": {"type": "number", "minimum": 0},
              "buffer_gain_vs_parent": {"type": "number"},
              "total_additional_paired_seeds": {"type": "integer", "minimum": 0},
              "same_topology_as_parent": {"type": "boolean"},
              "same_counts_as_parent": {"type": "boolean"},
              "same_exact_additional_paired_seeds_as_parent": {"type": "boolean"},
              "stays_within_budget_cap": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "source_report": {
      "type": "string",
      "minLength": 1
    },
    "source_script": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
