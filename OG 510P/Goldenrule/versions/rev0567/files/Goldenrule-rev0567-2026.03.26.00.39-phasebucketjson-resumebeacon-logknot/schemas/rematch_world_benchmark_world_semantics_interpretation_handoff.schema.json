{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/rematch_world_benchmark_world_semantics_interpretation_handoff.schema.json",
  "title": "Rematch World Benchmark World-Semantics Interpretation Handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_kind": {
      "const": "rematch_world_benchmark_world_semantics_interpretation_handoff"
    },
    "contract_version": {
      "const": "2026-03-17.rematch_world_benchmark_world_semantics_interpretation_handoff.v1"
    },
    "planner_origin": {
      "type": "string",
      "minLength": 1
    },
    "publication_contract_report_path": {
      "const": "artifacts/reports/rematch_world_publication_contract_snapshot_20260316.json"
    },
    "publication_contract_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role_assignment_note_path": {
      "const": "docs/LIBRARY/topics/rematch_role_assignment_is_a_first_class_contract.md"
    },
    "role_assignment_note_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inheritor_brief_path": {
      "const": "docs/LIBRARY/topics/golden_rule_inheritor_brief.md"
    },
    "inheritor_brief_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "linked_question_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SQ-[0-9]{3}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "disclosure_boundary_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_summary": {
          "type": "string",
          "minLength": 1
        },
        "linked_assumption_summary": {
          "type": "string",
          "minLength": 1
        },
        "minimal_world_semantics_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "section_publication_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "question_exit_gap": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "question_summary",
        "linked_assumption_summary",
        "minimal_world_semantics_fields",
        "section_publication_fields",
        "question_exit_gap"
      ]
    },
    "role_semantics_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixed_role_benchmark_required": {
          "type": "boolean"
        },
        "role_swapped_companion_required_when_asymmetry_is_in_play": {
          "type": "boolean"
        },
        "state_carry_disclosure_required": {
          "type": "boolean"
        },
        "seat_assignment_confound_warning": {
          "type": "string",
          "minLength": 1
        },
        "conservative_handoff_posture": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "fixed_role_benchmark_required",
        "role_swapped_companion_required_when_asymmetry_is_in_play",
        "state_carry_disclosure_required",
        "seat_assignment_confound_warning",
        "conservative_handoff_posture"
      ]
    },
    "world_semantics_contract_guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_world_section_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 6,
          "uniqueItems": true
        },
        "comparability_rule": {
          "type": "string",
          "minLength": 1
        },
        "asymmetry_trigger_rule": {
          "type": "string",
          "minLength": 1
        },
        "state_carry_rule": {
          "type": "string",
          "minLength": 1
        },
        "provisional_claim_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required_world_section_fields",
        "comparability_rule",
        "asymmetry_trigger_rule",
        "state_carry_rule",
        "provisional_claim_rule"
      ]
    },
    "upgrade_requirement": {
      "type": "string",
      "minLength": 1
    },
    "size_discipline_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract_kind",
    "contract_version",
    "planner_origin",
    "publication_contract_report_path",
    "publication_contract_report_sha256",
    "role_assignment_note_path",
    "role_assignment_note_sha256",
    "inheritor_brief_path",
    "inheritor_brief_sha256",
    "linked_question_ids",
    "disclosure_boundary_summary",
    "role_semantics_interpretation",
    "world_semantics_contract_guidance",
    "upgrade_requirement",
    "size_discipline_note"
  ]
}
