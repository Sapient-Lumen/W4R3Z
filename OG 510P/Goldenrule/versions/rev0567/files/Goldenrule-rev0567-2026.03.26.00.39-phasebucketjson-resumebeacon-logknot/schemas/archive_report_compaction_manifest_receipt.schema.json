{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Report Compaction Manifest Receipt",
  "type": "object",
  "required": [
    "analysis_script",
    "archive_posture",
    "compaction_candidate_receipt_path",
    "compaction_candidate_receipt_sha256",
    "headline_findings",
    "measurement_scope",
    "package_receipt_path",
    "package_receipt_sha256",
    "policy_checks",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "status_counts",
    "summary_metrics",
    "trim_manifest"
  ],
  "properties": {
    "receipt_kind": {
      "const": "archive_report_compaction_manifest_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "const": "scripts/tools/build_archive_report_compaction_manifest_receipt.py"
    },
    "package_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "package_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compaction_candidate_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "compaction_candidate_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "candidate_count_limit",
        "family_suffix_patterns",
        "output_receipt_self_excluded",
        "report_root"
      ],
      "properties": {
        "report_root": {
          "type": "string",
          "const": "artifacts/reports"
        },
        "family_suffix_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_count_limit": {
          "type": "integer",
          "minimum": 0
        },
        "output_receipt_self_excluded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "summary_metrics": {
      "type": "object",
      "required": [
        "manifest_family_count",
        "manifest_file_count",
        "manifest_pair_count",
        "manifest_raw_bytes",
        "manifest_raw_mebibytes",
        "manifest_share_of_report_bucket_raw_bytes",
        "manifest_rows_using_semantic_alias_count"
      ],
      "properties": {
        "manifest_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "manifest_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "manifest_rows_using_semantic_alias_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "trim_manifest": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backing_handle_count",
          "backing_handles",
          "candidate_compaction_readiness",
          "exact_report_file_count",
          "exact_report_files",
          "exact_report_paths",
          "family",
          "has_json_md_pair",
          "priority_rank",
          "raw_bytes",
          "raw_mebibytes",
          "semantic_alias_used",
          "share_of_report_bucket_raw_bytes",
          "trim_mode",
          "trim_rationale"
        ],
        "properties": {
          "priority_rank": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "exact_report_file_count": {
            "type": "integer",
            "minimum": 1
          },
          "exact_report_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exact_report_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "raw_bytes",
                "raw_mebibytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "raw_mebibytes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "has_json_md_pair": {
            "type": "boolean"
          },
          "candidate_compaction_readiness": {
            "type": "string",
            "enum": [
              "artifact_backed",
              "artifact_backed_pair",
              "citation_ready",
              "citation_ready_pair",
              "doc_backed"
            ]
          },
          "semantic_alias_used": {
            "type": "boolean"
          },
          "backing_handle_count": {
            "type": "integer",
            "minimum": 1
          },
          "backing_handles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "doc",
                    "library_topic",
                    "snapshot"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "trim_mode": {
            "type": "string",
            "enum": [
              "drop_report_pair_after_citing_handles",
              "drop_retained_family_after_citing_handles"
            ]
          },
          "trim_rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "all_manifest_rows_citation_backed",
        "candidate_receipt_ready",
        "manifest_families_match_priority_candidates",
        "manifest_file_counts_match_candidate_receipt",
        "manifest_paths_exist_under_reports",
        "manifest_paths_unique",
        "manifest_raw_bytes_match_candidate_receipt",
        "manifest_rows_nonempty",
        "package_receipt_ready"
      ],
      "properties": {
        "package_receipt_ready": {
          "type": "boolean"
        },
        "candidate_receipt_ready": {
          "type": "boolean"
        },
        "manifest_rows_nonempty": {
          "type": "boolean"
        },
        "manifest_families_match_priority_candidates": {
          "type": "boolean"
        },
        "manifest_paths_unique": {
          "type": "boolean"
        },
        "manifest_paths_exist_under_reports": {
          "type": "boolean"
        },
        "manifest_file_counts_match_candidate_receipt": {
          "type": "boolean"
        },
        "manifest_raw_bytes_match_candidate_receipt": {
          "type": "boolean"
        },
        "all_manifest_rows_citation_backed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_to_cite": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "properties": {
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "headline_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
