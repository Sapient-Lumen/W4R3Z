{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.example/schemas/successor_safe_ceremony_receipt_disposition.schema.json",
  "title": "Successor-Safe Ceremony Receipt Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition_kind",
    "receipt_id",
    "journey_kind",
    "receipt_locator",
    "assessment_overall_status",
    "archive_admission",
    "residual_risk_response",
    "copy_forward_rule",
    "blocking_finding_codes",
    "warning_finding_codes",
    "required_actions",
    "rationale",
    "next_review_trigger"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "disposition_kind": {
      "const": "successor_safe_ceremony_receipt_disposition"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "journey_kind": {
      "type": "string",
      "enum": [
        "presentation",
        "authorization",
        "authentication",
        "issuance",
        "other"
      ]
    },
    "receipt_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ni_uri",
        "digest_hex",
        "source_path"
      ],
      "properties": {
        "ni_uri": {
          "type": "string",
          "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
        },
        "digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment_overall_status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "archive_admission": {
      "type": "string",
      "enum": [
        "claim_ready_citable",
        "provisional_locator_only",
        "hold_for_remediation"
      ]
    },
    "residual_risk_response": {
      "type": "string",
      "enum": [
        "accept",
        "mitigate"
      ]
    },
    "copy_forward_rule": {
      "type": "string",
      "enum": [
        "cite_locator_only",
        "cite_locator_until_remediated",
        "hold_until_remediated"
      ]
    },
    "blocking_finding_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "warning_finding_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "next_review_trigger": {
      "type": "string",
      "minLength": 1
    }
  }
}
