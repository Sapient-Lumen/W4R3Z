{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successor-Safe Ceremony Receipt Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_kind",
    "receipt_id",
    "journey_kind",
    "source_path",
    "overall_status",
    "counts",
    "findings",
    "advice"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "assessment_kind": {"type": "string", "const": "successor_safe_ceremony_receipt_assessment"},
    "receipt_id": {"type": "string", "minLength": 1},
    "journey_kind": {"type": "string", "enum": ["presentation", "authorization", "authentication", "issuance", "other"]},
    "source_path": {"type": "string", "minLength": 1},
    "overall_status": {"type": "string", "enum": ["pass", "warn", "fail"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_count", "hard_fail_count", "warning_count"],
      "properties": {
        "finding_count": {"type": "integer", "minimum": 1},
        "hard_fail_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "status", "summary", "evidence_paths"],
        "properties": {
          "code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "severity": {"type": "string", "enum": ["info", "warning", "error"]},
          "status": {"type": "string", "enum": ["pass", "warn", "fail"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence_paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^/"}
          }
        }
      }
    },
    "advice": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
