{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch World Benchmark Copy-Forward Audit Receipt",
  "type": "object",
  "required": [
    "receipt_kind",
    "receipt_version",
    "analysis_script",
    "artifact_path",
    "artifact_sha256",
    "seed_path",
    "seed_sha256",
    "seed_frozen_handoff_audit_path",
    "seed_frozen_handoff_audit_sha256",
    "audited_sections",
    "status_counts",
    "archive_posture",
    "recommended_next_move"
  ],
  "properties": {
    "receipt_kind": { "const": "rematch_world_benchmark_copy_forward_audit_receipt" },
    "receipt_version": { "type": "string", "minLength": 1 },
    "analysis_script": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "seed_path": { "type": "string", "minLength": 1 },
    "seed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "seed_frozen_handoff_audit_path": { "type": "string", "minLength": 1 },
    "seed_frozen_handoff_audit_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "audited_sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "section_path",
          "source_path",
          "source_kind",
          "linked_question_ids",
          "artifact_subtree_sha256",
          "source_sha256",
          "exact_match"
        ],
        "properties": {
          "section_path": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "source_kind": { "type": "string", "minLength": 1 },
          "linked_question_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "artifact_subtree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "exact_match": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "status_counts": {
      "type": "object",
      "required": [
        "audited_section_count",
        "exact_match_count",
        "mismatch_count"
      ],
      "properties": {
        "audited_section_count": { "type": "integer", "minimum": 1 },
        "exact_match_count": { "type": "integer", "minimum": 0 },
        "mismatch_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "prefer_citation_over_recopy",
        "intended_retention_class",
        "size_discipline_note"
      ],
      "properties": {
        "prefer_citation_over_recopy": { "type": "boolean" },
        "intended_retention_class": { "type": "string", "minLength": 1 },
        "size_discipline_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "recommended_next_move": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
