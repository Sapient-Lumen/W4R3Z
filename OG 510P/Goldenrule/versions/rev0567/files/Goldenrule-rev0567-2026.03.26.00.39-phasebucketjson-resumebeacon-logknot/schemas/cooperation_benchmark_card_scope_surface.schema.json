{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_scope_surface.schema.json",
  "title": "Cooperation Benchmark Card Scope Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_surface_kind",
    "preferred_for_subsystem_boundary",
    "subsystem_id",
    "summary",
    "scope_manifest_sha256",
    "counts",
    "boundary_rules",
    "verification_commands",
    "refresh_commands",
    "categories"
  ],
  "properties": {
    "scope_surface_kind": {
      "const": "cooperation_benchmark_card_scope_surface"
    },
    "preferred_for_subsystem_boundary": {
      "const": true
    },
    "subsystem_id": {
      "const": "compact-cooperation-benchmark-card-stack"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_count",
        "path_count",
        "source_path_count",
        "generated_path_count",
        "hashed_path_count",
        "path_only_path_count",
        "self_elided_path_count"
      ],
      "properties": {
        "category_count": {
          "type": "integer",
          "minimum": 1
        },
        "path_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "generated_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "hashed_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "self_elided_path_count": {
          "type": "integer",
          "minimum": 1
        },
        "path_only_path_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "boundary_rules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "summary"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "refresh_commands": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "categories": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "summary",
          "path_count",
          "paths"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "path_count": {
            "type": "integer",
            "minimum": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "role",
                "stage",
                "integrity_mode",
                "bytes",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "source",
                    "generated"
                  ]
                },
                "integrity_mode": {
                  "type": "string",
                  "enum": [
                    "hashed",
                    "path-only",
                    "self-elided"
                  ]
                },
                "bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "integrity_mode": {
                        "const": "hashed"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "bytes",
                      "sha256"
                    ],
                    "properties": {
                      "bytes": {
                        "type": "integer"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "integrity_mode": {
                        "enum": [
                          "path-only",
                          "self-elided"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "bytes": {
                        "const": null
                      },
                      "sha256": {
                        "const": null
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
