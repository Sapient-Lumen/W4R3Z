{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Report Compaction Stage Receipt",
  "type": "object",
  "required": [
    "analysis_script",
    "archive_posture",
    "compaction_manifest_receipt_path",
    "compaction_manifest_receipt_sha256",
    "compaction_rehearsal_receipt_path",
    "compaction_rehearsal_receipt_sha256",
    "headline_findings",
    "measurement_scope",
    "package_receipt_path",
    "package_receipt_sha256",
    "policy_checks",
    "receipt_kind",
    "receipt_version",
    "recommended_next_move",
    "stage_manifest",
    "status_counts",
    "summary_metrics"
  ],
  "properties": {
    "receipt_kind": {
      "const": "archive_report_compaction_stage_receipt"
    },
    "receipt_version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_script": {
      "type": "string",
      "const": "scripts/tools/build_archive_report_compaction_stage_receipt.py"
    },
    "package_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "package_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compaction_manifest_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "compaction_manifest_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compaction_rehearsal_receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "compaction_rehearsal_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_scope": {
      "type": "object",
      "required": [
        "output_receipt_self_excluded",
        "report_root",
        "stage_path_strategy",
        "stage_root",
        "stage_root_retained_in_package"
      ],
      "properties": {
        "report_root": {
          "type": "string",
          "const": "artifacts/reports"
        },
        "stage_root": {
          "type": "string",
          "const": "examples/scratch/archive_report_compaction_stage"
        },
        "stage_path_strategy": {
          "type": "string",
          "minLength": 1
        },
        "stage_root_retained_in_package": {
          "type": "boolean"
        },
        "output_receipt_self_excluded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "summary_metrics": {
      "type": "object",
      "required": [
        "projected_raw_tree_after_canonical_trim_bytes",
        "projected_raw_tree_after_canonical_trim_mebibytes",
        "projected_raw_tree_during_stage_bytes",
        "projected_raw_tree_during_stage_mebibytes",
        "projected_report_bucket_after_stage_raw_bytes",
        "projected_report_bucket_after_stage_raw_mebibytes",
        "projected_scratch_stage_raw_bytes",
        "projected_scratch_stage_raw_mebibytes",
        "stage_family_count",
        "stage_file_count",
        "stage_raw_bytes",
        "stage_raw_mebibytes",
        "stage_root_preexisting_file_count",
        "stage_share_of_report_bucket_raw_bytes"
      ],
      "properties": {
        "stage_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "stage_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "stage_share_of_report_bucket_raw_bytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_report_bucket_after_stage_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_report_bucket_after_stage_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_scratch_stage_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_scratch_stage_raw_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_raw_tree_during_stage_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_raw_tree_during_stage_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "projected_raw_tree_after_canonical_trim_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_raw_tree_after_canonical_trim_mebibytes": {
          "type": "number",
          "minimum": 0
        },
        "stage_root_preexisting_file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "stage_manifest": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "backing_handle_count",
          "backing_handles",
          "exact_report_file_count",
          "family",
          "file_rows",
          "priority_rank",
          "raw_bytes",
          "raw_mebibytes",
          "share_of_report_bucket_raw_bytes",
          "source_report_paths",
          "stage_mode",
          "stage_paths",
          "trim_mode"
        ],
        "properties": {
          "priority_rank": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "raw_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "raw_mebibytes": {
            "type": "number",
            "minimum": 0
          },
          "share_of_report_bucket_raw_bytes": {
            "type": "number",
            "minimum": 0
          },
          "exact_report_file_count": {
            "type": "integer",
            "minimum": 1
          },
          "backing_handle_count": {
            "type": "integer",
            "minimum": 1
          },
          "backing_handles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "doc",
                    "library_topic",
                    "snapshot"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "trim_mode": {
            "type": "string",
            "minLength": 1
          },
          "stage_mode": {
            "type": "string",
            "const": "move_to_scratch_then_validate_then_delete_staged_copy"
          },
          "source_report_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "stage_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "file_rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file_kind",
                "raw_bytes",
                "raw_mebibytes",
                "source_path",
                "source_sha256",
                "stage_path"
              ],
              "properties": {
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "stage_path": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "raw_mebibytes": {
                  "type": "number",
                  "minimum": 0
                },
                "file_kind": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "policy_checks": {
      "type": "object",
      "required": [
        "all_stage_rows_citation_backed",
        "manifest_receipt_ready",
        "package_receipt_ready",
        "projected_canonical_trim_matches_rehearsal",
        "projected_report_bucket_after_stage_matches_rehearsal",
        "rehearsal_receipt_ready",
        "source_paths_exist_under_reports",
        "stage_and_source_paths_disjoint",
        "stage_manifest_nonempty",
        "stage_paths_absent_now",
        "stage_paths_live_under_examples_scratch",
        "stage_paths_unique",
        "stage_raw_bytes_match_manifest",
        "stage_raw_bytes_match_rehearsal_trim",
        "stage_root_clear_now"
      ],
      "properties": {
        "package_receipt_ready": {
          "type": "boolean"
        },
        "manifest_receipt_ready": {
          "type": "boolean"
        },
        "rehearsal_receipt_ready": {
          "type": "boolean"
        },
        "stage_manifest_nonempty": {
          "type": "boolean"
        },
        "stage_root_clear_now": {
          "type": "boolean"
        },
        "source_paths_exist_under_reports": {
          "type": "boolean"
        },
        "stage_paths_unique": {
          "type": "boolean"
        },
        "stage_paths_absent_now": {
          "type": "boolean"
        },
        "stage_paths_live_under_examples_scratch": {
          "type": "boolean"
        },
        "stage_and_source_paths_disjoint": {
          "type": "boolean"
        },
        "stage_raw_bytes_match_manifest": {
          "type": "boolean"
        },
        "stage_raw_bytes_match_rehearsal_trim": {
          "type": "boolean"
        },
        "projected_report_bucket_after_stage_matches_rehearsal": {
          "type": "boolean"
        },
        "projected_canonical_trim_matches_rehearsal": {
          "type": "boolean"
        },
        "all_stage_rows_citation_backed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status_counts": {
      "type": "object",
      "required": [
        "passed_check_count",
        "ready_to_cite",
        "total_check_count"
      ],
      "properties": {
        "passed_check_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_check_count": {
          "type": "integer",
          "minimum": 1
        },
        "ready_to_cite": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "archive_posture": {
      "type": "object",
      "required": [
        "intended_retention_class",
        "prefer_citation_over_recopy",
        "size_discipline_note"
      ],
      "properties": {
        "intended_retention_class": {
          "type": "string",
          "minLength": 1
        },
        "prefer_citation_over_recopy": {
          "type": "boolean"
        },
        "size_discipline_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "headline_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_move": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
