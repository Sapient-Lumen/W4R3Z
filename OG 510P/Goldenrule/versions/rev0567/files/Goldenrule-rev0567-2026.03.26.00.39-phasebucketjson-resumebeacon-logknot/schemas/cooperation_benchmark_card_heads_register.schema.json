{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenrule.local/schemas/cooperation_benchmark_card_heads_register.schema.json",
  "title": "Cooperation Benchmark Card Heads Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "register_kind",
    "inventory_kind",
    "counts",
    "lineages"
  ],
  "properties": {
    "register_kind": {
      "const": "cooperation_benchmark_card_heads_register"
    },
    "inventory_kind": {
      "const": "cooperation_benchmark_card_inventory"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_count",
        "unique_operational_head_count",
        "unique_citation_head_count",
        "branch_ambiguous_lineage_count",
        "ambiguous_operational_head_lineage_count",
        "lineages_needing_freeze_count",
        "lineages_with_freeze_drift_count"
      ],
      "properties": {
        "lineage_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_operational_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_citation_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "branch_ambiguous_lineage_count": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous_operational_head_lineage_count": {
          "type": "integer",
          "minimum": 0
        },
        "lineages_needing_freeze_count": {
          "type": "integer",
          "minimum": 0
        },
        "lineages_with_freeze_drift_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lineages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineage_id",
          "benchmark_names",
          "card_ids",
          "card_paths",
          "root_card_ids",
          "tip_card_ids",
          "operational_head_card_ids",
          "citation_head_card_ids",
          "drifted_operational_head_card_ids",
          "unique_operational_head_id",
          "unique_citation_head_id",
          "branch_ambiguous",
          "warning_reason_codes",
          "warnings"
        ],
        "properties": {
          "lineage_id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "card_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "root_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "tip_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "operational_head_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "citation_head_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "unique_operational_head_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "unique_citation_head_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "branch_ambiguous": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "warning_reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "drifted_operational_head_card_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
