{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rematch Compact Decision Contract Snapshot",
  "type": "object",
  "required": [
    "focus",
    "snapshot_date",
    "world",
    "question_coverage",
    "delay_contract",
    "winner_contract",
    "delta_contract",
    "component_report_bytes",
    "component_report_total_bytes",
    "bundle_json_bytes",
    "bundle_vs_components_raw_byte_ratio",
    "analysis_script"
  ],
  "properties": {
    "focus": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "minLength": 1},
    "world": {
      "type": "object",
      "required": [
        "kind",
        "description",
        "tested_delay_levels",
        "tested_extortion_levels",
        "panel_count",
        "budget_band_count"
      ],
      "properties": {
        "kind": {"const": "rematch_proxy_compact_decision_contract"},
        "description": {"type": "string", "minLength": 1},
        "tested_delay_levels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "tested_extortion_levels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "panel_count": {"type": "integer", "minimum": 1},
        "budget_band_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "question_coverage": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "question_summary",
          "contract_section",
          "minimal_fields",
          "source_reports"
        ],
        "properties": {
          "question_id": {"type": "string", "pattern": "^SQ-0(1[7-9]|2[0-6])$"},
          "question_summary": {"type": "string", "minLength": 1},
          "contract_section": {"type": "string", "enum": ["delay_contract", "winner_contract", "delta_contract"]},
          "minimal_fields": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_reports": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "delay_contract": {
      "type": "object",
      "required": ["headline_findings", "robustness_probe_contract", "extortion_rows", "source_reports"],
      "properties": {
        "headline_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "robustness_probe_contract": {
          "type": "object",
          "required": [
            "robustness_triage_class_count_when_w_hazard_gt_0",
            "minimum_nonadaptive_probe_count_for_universal_robustness_triage",
            "unique_minimal_nonadaptive_probe_caps",
            "minimum_adaptive_worst_case_probe_count_for_universal_robustness_triage",
            "adaptive_best_case_probe_count_for_universal_robustness_triage",
            "most_practical_probe_contract"
          ],
          "properties": {
            "robustness_triage_class_count_when_w_hazard_gt_0": {"type": "integer", "minimum": 1},
            "minimum_nonadaptive_probe_count_for_universal_robustness_triage": {"type": "integer", "minimum": 1},
            "unique_minimal_nonadaptive_probe_caps": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "integer", "minimum": 1}
            },
            "minimum_adaptive_worst_case_probe_count_for_universal_robustness_triage": {"type": "integer", "minimum": 1},
            "adaptive_best_case_probe_count_for_universal_robustness_triage": {"type": "integer", "minimum": 1},
            "most_practical_probe_contract": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "extortion_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "extortion",
              "predicted_nonnegative_delay_live_contender_set",
              "predicted_nonnegative_delay_winner_intervals",
              "strictly_dominated_policies",
              "tested_band_leader_flips",
              "tested_band_pairwise_flips_between_delay0_and_delay2",
              "tested_band_panel_rows"
            ],
            "properties": {
              "extortion": {"type": "integer", "minimum": 0},
              "predicted_nonnegative_delay_live_contender_set": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "predicted_nonnegative_delay_winner_intervals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["winner", "start_delay", "interval"],
                  "properties": {
                    "winner": {"type": "string", "minLength": 1},
                    "start_delay": {"type": "number", "minimum": 0},
                    "end_delay": {"type": ["number", "null"], "minimum": 0},
                    "interval": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": true
                }
              },
              "strictly_dominated_policies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["policy", "dominated_by"],
                  "properties": {
                    "policy": {"type": "string", "minLength": 1},
                    "dominated_by": {
                      "type": "array",
                      "minItems": 1,
                      "items": {"type": "string", "minLength": 1}
                    }
                  },
                  "additionalProperties": true
                }
              },
              "tested_band_leader_flips": {"type": "integer", "minimum": 0},
              "tested_band_pairwise_flips_between_delay0_and_delay2": {"type": "integer", "minimum": 0},
              "tested_band_panel_rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["delay", "leader", "runner_up", "leader_gap"],
                  "properties": {
                    "delay": {"type": "integer", "minimum": 0},
                    "leader": {"type": "string", "minLength": 1},
                    "runner_up": {"type": "string", "minLength": 1},
                    "leader_gap": {"type": "number"}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "source_reports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "winner_contract": {
      "type": "object",
      "required": ["headline_findings", "panel_rows", "source_reports"],
      "properties": {
        "headline_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "panel_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "delay",
              "extortion",
              "leader",
              "runner_up",
              "leader_certified_95_ci",
              "leader_margin",
              "leader_margin_ci_low",
              "leader_margin_ci_high",
              "paired_seed_count",
              "smallest_equivalence_delta_supported_90",
              "largest_material_delta_supported_90",
              "triage_status"
            ],
            "properties": {
              "delay": {"type": "integer", "minimum": 0},
              "extortion": {"type": "integer", "minimum": 0},
              "leader": {"type": "string", "minLength": 1},
              "runner_up": {"type": "string", "minLength": 1},
              "leader_certified_95_ci": {"type": "boolean"},
              "leader_margin": {"type": "number"},
              "leader_margin_ci_low": {"type": "number"},
              "leader_margin_ci_high": {"type": "number"},
              "paired_seed_count": {"type": "integer", "minimum": 1},
              "smallest_equivalence_delta_supported_90": {"type": "number", "minimum": 0},
              "largest_material_delta_supported_90": {"type": "number", "minimum": 0},
              "triage_status": {
                "type": "string",
                "enum": ["uncertified", "certified_practical_tie", "certified_material_leader"]
              },
              "delta_classifications": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": true
          }
        },
        "source_reports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "delta_contract": {
      "type": "object",
      "required": ["headline_findings", "band_rows", "source_reports"],
      "properties": {
        "headline_findings": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "band_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "budget_cap_additional_paired_seeds",
              "parent_band_start_delta",
              "parent_band_end_delta",
              "parent_band_width",
              "fragmented_parent_band",
              "contains_single_point_knife_edge",
              "parent_anchor_delta",
              "parent_anchor_topology_code",
              "parent_anchor_buffer_to_nearest_topology_boundary",
              "topology_preserving_anchor_delta",
              "topology_subband_start_delta",
              "topology_subband_end_delta",
              "topology_subband_width",
              "topology_preserving_anchor_topology_code",
              "topology_preserving_anchor_buffer_to_nearest_topology_boundary",
              "buffer_gain_vs_parent",
              "same_counts_as_parent",
              "stays_within_budget_cap"
            ],
            "properties": {
              "budget_cap_additional_paired_seeds": {"type": "integer", "minimum": 1},
              "parent_band_start_delta": {"type": "number", "minimum": 0},
              "parent_band_end_delta": {"type": "number", "minimum": 0},
              "parent_band_width": {"type": "number", "minimum": 0},
              "fragmented_parent_band": {"type": "boolean"},
              "contains_single_point_knife_edge": {"type": "boolean"},
              "parent_anchor_delta": {"type": "number", "minimum": 0},
              "parent_anchor_topology_code": {"type": "string", "minLength": 1},
              "parent_anchor_buffer_to_nearest_topology_boundary": {"type": "number", "minimum": 0},
              "parent_anchor_counts": {
                "type": "object",
                "required": ["material_leader", "practical_tie", "undecided"],
                "properties": {
                  "material_leader": {"type": "integer", "minimum": 0},
                  "practical_tie": {"type": "integer", "minimum": 0},
                  "undecided": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "topology_preserving_anchor_delta": {"type": "number", "minimum": 0},
              "topology_subband_start_delta": {"type": "number", "minimum": 0},
              "topology_subband_end_delta": {"type": "number", "minimum": 0},
              "topology_subband_width": {"type": "number", "minimum": 0},
              "topology_preserving_anchor_topology_code": {"type": "string", "minLength": 1},
              "topology_preserving_anchor_counts": {
                "type": "object",
                "required": ["material_leader", "practical_tie", "undecided"],
                "properties": {
                  "material_leader": {"type": "integer", "minimum": 0},
                  "practical_tie": {"type": "integer", "minimum": 0},
                  "undecided": {"type": "integer", "minimum": 0}
                },
                "additionalProperties": false
              },
              "topology_preserving_anchor_buffer_to_nearest_topology_boundary": {"type": "number", "minimum": 0},
              "buffer_gain_vs_parent": {"type": "number"},
              "same_counts_as_parent": {"type": "boolean"},
              "stays_within_budget_cap": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "source_reports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    },
    "component_report_bytes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "component_report_total_bytes": {"type": "integer", "minimum": 1},
    "bundle_json_bytes": {"type": "integer", "minimum": 1},
    "bundle_vs_components_raw_byte_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "analysis_script": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
