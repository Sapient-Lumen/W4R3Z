@@ -0,0 +1,57 @@
+use gr_engine::probe::{run_probe, ProbeMatchupResult, ProbeSpec};
+use gr_engine::spec::ReputationModelSpec;
+
+fn load_simple_standing_image_scoring_probe_v1() -> ProbeSpec {
+    serde_json::from_str(include_str!("../../examples/probes/simple_standing_image_scoring_probe.json")).unwrap()
+}
+
+fn load_simple_standing_standing_norm_probe_v1() -> ProbeSpec {
+    serde_json::from_str(include_str!("../../examples/probes/simple_standing_standing_norm_probe.json")).unwrap()
+}
+
+fn declared_initial_standing(probe: &ProbeSpec) -> f64 {
+    match &probe.world.reputation {
+        ReputationModelSpec::SimpleStanding { initial_standing, .. } => *initial_standing,
+        ReputationModelSpec::None => panic!("expected simple_standing reputation"),
+    }
+}
+
+fn first_trace_standing(matchup: &ProbeMatchupResult) -> (f64, f64) {
+    let replication = matchup.replications_detail.first().expect("replication detail");
+    let trace = replication.trace.as_ref().expect("trace");
+    let round0 = trace.first().expect("round 0 trace");
+    (round0.standing_a, round0.standing_b)
+}
+
+fn assert_close(actual: f64, expected: f64) {
+    let diff = (actual - expected).abs();
+    assert!(diff <= 1e-12, "expected first trace standing {expected}, got {actual} (diff={diff})");
+}
+
+#[test]
+fn probe_trace_bootstraps_declared_initial_standing_simple_standing_image_scoring_probe() {
+    let probe = load_simple_standing_image_scoring_probe_v1();
+    assert_eq!(probe.id, "simple_standing_image_scoring_probe_v1");
+    assert!(probe.matchups.iter().all(|m| m.trace_rounds > 0), "seed must request trace_rounds");
+    let expected = declared_initial_standing(&probe);
+    let out = run_probe(&probe).unwrap();
+    let matchup = out.matchups.iter().find(|m| m.id == "always_c_vs_tft_under_image_scoring").expect("matchup result");
+    let (standing_a, standing_b) = first_trace_standing(matchup);
+    assert_close(standing_a, expected);
+    assert_close(standing_b, expected);
+    assert_close(expected, 0.5);
+}
+
+#[test]
+fn probe_trace_bootstraps_declared_initial_standing_simple_standing_standing_norm_probe() {
+    let probe = load_simple_standing_standing_norm_probe_v1();
+    assert_eq!(probe.id, "simple_standing_standing_norm_probe_v1");
+    assert!(probe.matchups.iter().all(|m| m.trace_rounds > 0), "seed must request trace_rounds");
+    let expected = declared_initial_standing(&probe);
+    let out = run_probe(&probe).unwrap();
+    let matchup = out.matchups.iter().find(|m| m.id == "tft_vs_always_d_under_standing_norm").expect("matchup result");
+    let (standing_a, standing_b) = first_trace_standing(matchup);
+    assert_close(standing_a, expected);
+    assert_close(standing_b, expected);
+    assert_close(expected, 0.7);
+}
