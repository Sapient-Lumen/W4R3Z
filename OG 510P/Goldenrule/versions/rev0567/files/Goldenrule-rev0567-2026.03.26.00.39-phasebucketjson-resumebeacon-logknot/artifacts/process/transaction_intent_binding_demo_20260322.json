{
  "scenario": "same-authenticator-different-approved-object",
  "question": "What changes when the same authenticated session and holder key are used for different transaction-intent and approval-object contracts?",
  "cases": [
    {
      "case_id": "A-generic-authentication-only",
      "session": "verifier-targeted-and-holder-bound",
      "approval_object": null,
      "request_protection": "not-applicable",
      "outcome": "identity-proven-no-specific-authorization-bound"
    },
    {
      "case_id": "B-structured-ask-reduced-subset",
      "session": "verifier-targeted-and-holder-bound",
      "approval_object": {
        "authorization_details": [
          "account_info",
          "payment_initiation"
        ],
        "granted_subset": [
          "account_info"
        ]
      },
      "request_protection": "signed_request_object",
      "outcome": "reduced-authorization-approved"
    },
    {
      "case_id": "C-transaction-data-hash-bound",
      "session": "verifier-targeted-and-holder-bound",
      "approval_object": {
        "transaction_data": [
          "pay:merchant=example;amount=10.00;currency=USD"
        ],
        "transaction_data_hashes": [
          "sha-256:examplehash"
        ]
      },
      "request_protection": "pushed_request_plus_hash_bound_proof",
      "outcome": "specific-transaction-authorized"
    },
    {
      "case_id": "D-front-channel-context-swap-risk",
      "session": "verifier-targeted-and-holder-bound",
      "approval_object": {
        "authorization_details": [
          "payment_initiation"
        ]
      },
      "request_protection": "browser_carried_unsigned_parameters",
      "outcome": "authorization-looks-valid-but-approved-object-not-tamper-stable"
    }
  ],
  "lesson": "The same valid session and authenticator can mean generic login, reduced authorization, exact transaction approval, or approval-context ambiguity. Future inheritors need the approved object and its integrity path, or they can misread safer authorization plumbing as moral or institutional progress."
}
