{
  "scenario": "same-proof-different-delivery-path",
  "question": "What changes when the same verifier-targeted and transaction-bound proof is delivered through different request and response paths?",
  "cases": [
    {
      "case_id": "A-url-heavy-redirect-world",
      "request_transport": "front_channel_by_value",
      "response_transport": "redirect_or_url_visible",
      "plaintext_observers": [
        "browser_history",
        "frontend",
        "logs_or_referrer_surface"
      ],
      "correlation_closure": "state_only",
      "outcome": "valid_but_url_exposed"
    },
    {
      "case_id": "B-protected-request-plain-direct-post",
      "request_transport": "PAR_plus_JAR_request_uri",
      "response_transport": "direct_post_plain_body",
      "plaintext_observers": [
        "wallet",
        "verifier_response_endpoint",
        "reverse_proxy"
      ],
      "correlation_closure": "none_declared",
      "outcome": "valid_but_out_of_band_session_gap"
    },
    {
      "case_id": "C-protected-request-direct-post-with-response-code",
      "request_transport": "PAR_plus_JAR_request_uri",
      "response_transport": "direct_post_plain_body_then_redirect_with_response_code",
      "plaintext_observers": [
        "wallet",
        "verifier_response_endpoint",
        "reverse_proxy",
        "frontend_receives_only_response_code"
      ],
      "correlation_closure": "fresh_single_use_response_code",
      "outcome": "valid_and_session_correlated"
    },
    {
      "case_id": "D-protected-request-encrypted-response",
      "request_transport": "PAR_plus_JAR_request_uri",
      "response_transport": "direct_post_jwt_encrypted",
      "plaintext_observers": [
        "wallet",
        "verifier_decryption_endpoint"
      ],
      "correlation_closure": "response_code_or_equivalent_backend_mapping",
      "outcome": "valid_with_narrow_plaintext_surface"
    }
  ],
  "lesson": "The same disclosed claims and verifier target are not replay-complete. Future inheritors need the delivery-path contract, or they can misread transport hardening and reduced observer exposure as moral or institutional progress."
}
