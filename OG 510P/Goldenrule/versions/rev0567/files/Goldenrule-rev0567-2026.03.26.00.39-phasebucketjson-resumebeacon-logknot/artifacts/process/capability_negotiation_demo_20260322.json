{
  "scenario": "same-counterparts-different-chosen-profile",
  "question": "What changes when the same verifier and wallet support multiple compatible profiles but choose, reject, or silently downgrade among them?",
  "cases": [
    {
      "case_id": "A-strict-high-profile",
      "advertised_support": {
        "formats": [
          "dc+sd-jwt"
        ],
        "proof_types": [
          "jwt"
        ],
        "response_modes": [
          "direct_post.jwt",
          "direct_post"
        ],
        "request_object_signing_alg_values_supported": [
          "ES256"
        ],
        "credential_request_encryption_required": true
      },
      "chosen_profile": {
        "format": "dc+sd-jwt",
        "proof_type": "jwt",
        "alg": "ES256",
        "response_mode": "direct_post.jwt",
        "request_encryption": "required-and-used"
      },
      "downgrade_policy": "fail_closed",
      "outcome": "admissible"
    },
    {
      "case_id": "B-silent-downgrade",
      "advertised_support": {
        "formats": [
          "dc+sd-jwt"
        ],
        "proof_types": [
          "jwt"
        ],
        "response_modes": [
          "direct_post.jwt",
          "direct_post"
        ],
        "request_object_signing_alg_values_supported": [
          "ES256"
        ],
        "credential_request_encryption_required": true
      },
      "chosen_profile": {
        "format": "dc+sd-jwt",
        "proof_type": "jwt",
        "alg": "ES256",
        "response_mode": "direct_post",
        "request_encryption": "omitted"
      },
      "downgrade_policy": "best_effort_fallback",
      "outcome": "cryptographically-recoverable-but-contract-violating"
    },
    {
      "case_id": "C-no-common-safe-profile",
      "advertised_support": {
        "wallet_response_modes": [
          "direct_post.jwt"
        ],
        "verifier_response_modes": [
          "direct_post"
        ],
        "wallet_algs": [
          "ES256"
        ],
        "verifier_algs": [
          "ES384"
        ]
      },
      "chosen_profile": null,
      "downgrade_policy": "fail_closed",
      "outcome": "reject-unsupported-profile"
    }
  ],
  "lesson": "Supported-feature overlap is not replay-complete. Future inheritors need the chosen profile and downgrade posture, or the same participants can appear to have changed moral or institutional behavior when only negotiation policy changed."
}
