{
  "date": "2026-03-22",
  "point": "the same evidence, policy text, and decision logic can yield different outcomes when the baseline corpus of reference values, endorsements, or trust roots changes",
  "policy": {
    "name": "firmware-release-gate",
    "logic": "allow only if firmware_digest is in approved_reference_values and attestation_key chains to accepted_trust_root"
  },
  "evidence": {
    "device": "edge-node-17",
    "firmware_digest": "sha256:aa11",
    "attestation_key_chain": "vendor-a/firmware-signer-7"
  },
  "cases": [
    {
      "baseline_snapshot": "baseline-2026-03-15",
      "approved_reference_values": [
        "sha256:aa11",
        "sha256:bb22"
      ],
      "accepted_trust_roots": [
        "vendor-a-root-v3"
      ],
      "endorsement_binding": "vendor-a may endorse firmware layer",
      "verdict": "ALLOW"
    },
    {
      "baseline_snapshot": "baseline-2026-03-22",
      "approved_reference_values": [
        "sha256:cc33"
      ],
      "accepted_trust_roots": [
        "vendor-a-root-v4"
      ],
      "endorsement_binding": "vendor-a may endorse firmware layer",
      "verdict": "DENY",
      "reason": "firmware digest no longer in approved reference corpus"
    },
    {
      "baseline_snapshot": "baseline-2026-03-22-airgap-copy",
      "approved_reference_values": [
        "sha256:aa11",
        "sha256:bb22"
      ],
      "accepted_trust_roots": [
        "vendor-a-root-v3"
      ],
      "endorsement_binding": "vendor-a may endorse firmware layer",
      "verdict": "ALLOW_WITH_DRIFT_WARNING",
      "reason": "air-gapped baseline still accepts old root and old digest set; outcome differs from refreshed baseline"
    }
  ]
}
