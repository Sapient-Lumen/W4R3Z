{
  "scenario": "same-request-different-metadata-resolution",
  "request": {
    "client_id": "openid_federation:https://verifier.example",
    "nonce": "session-104",
    "response_mode": "direct_post",
    "requested_format": "dc+sd-jwt"
  },
  "cases": [
    {
      "case_id": "A-live-federation-chain",
      "resolution_mode": "openid_federation",
      "metadata_source": "trust chain snapshot T1",
      "resolved_key": "kid=fed-key-7",
      "resolved_response_uri": "https://verifier.example/post",
      "resolved_algorithms": [
        "ES256"
      ],
      "policy_effect": "direct_post permitted",
      "verdict": "ALLOW",
      "meaning": "request is admissible under the evaluated trust chain and policy set"
    },
    {
      "case_id": "B-stale-or-different-policy-chain",
      "resolution_mode": "openid_federation",
      "metadata_source": "trust chain snapshot T0",
      "resolved_key": "kid=fed-key-5",
      "resolved_response_uri": "https://verifier.example/legacy",
      "resolved_algorithms": [
        "PS256"
      ],
      "policy_effect": "direct_post removed by metadata policy",
      "verdict": "REJECT_POLICY_OR_METADATA_DRIFT",
      "meaning": "same request text is no longer admissible once the resolved metadata surface changes"
    },
    {
      "case_id": "C-did-resolution-version-shift",
      "resolution_mode": "decentralized_identifier",
      "metadata_source": "DID resolution with versionTime=2026-03-22T10:00:00Z",
      "resolved_key": "did:example:verifier#key-9",
      "resolved_response_uri": "https://verifier.example/callback",
      "resolved_algorithms": [
        "ES384"
      ],
      "policy_effect": "client_metadata trusted except public-key discovery",
      "verdict": "ALLOW_ONLY_FOR_VERSIONED_DID_STATE",
      "meaning": "the DID string alone is insufficient without the resolved historical document state"
    },
    {
      "case_id": "D-discovery-validation-failure",
      "resolution_mode": "oidc-discovery",
      "metadata_source": "https://issuer.example/.well-known/openid-configuration",
      "resolved_key": "jwks_uri mismatch after validation",
      "resolved_response_uri": "https://issuer.example/auth",
      "resolved_algorithms": [
        "RS256"
      ],
      "policy_effect": "validation failure triggers abort",
      "verdict": "ABORT_INVALID_METADATA",
      "meaning": "fetched metadata must not be used when validation fails"
    },
    {
      "case_id": "E-unsigned-request-local-client-metadata",
      "resolution_mode": "redirect_uri prefix",
      "metadata_source": "request client_metadata only",
      "resolved_key": "none external",
      "resolved_response_uri": "https://client.example.org/cb",
      "resolved_algorithms": [
        "ES256"
      ],
      "policy_effect": "unsigned mode cannot use a trusted request-signing key acquisition path",
      "verdict": "LIMITED_TRUST_UNSIGNED_MODE",
      "meaning": "the same endpoint string implies a weaker trust path when metadata came only from the request"
    }
  ],
  "lesson": "The same participant identifier or request text can yield different admissibility, capability, and security conclusions once metadata-resolution path, validation outcome, and trust-chain snapshot are made explicit."
}
