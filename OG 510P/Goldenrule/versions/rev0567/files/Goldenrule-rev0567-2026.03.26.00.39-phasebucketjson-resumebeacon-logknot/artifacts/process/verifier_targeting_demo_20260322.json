{
  "scenario": "same-proof-different-target-binding",
  "payload": {
    "credential": "employee_badge_vc",
    "holder_key": "did:key:zDemoHolderKey",
    "revealed_claims": [
      "employment_status=active",
      "department=research"
    ]
  },
  "cases": [
    {
      "case_id": "A-intended-verifier-and-session",
      "audience": "https://rp-a.example/verifier",
      "client_id": "web-origin:https://rp-a.example",
      "origin": "https://rp-a.example",
      "nonce": "session-001",
      "route_binding": "POST https://rp-a.example/post",
      "transcript_binding": "matches responseUri and handover thumbprint",
      "verdict": "ALLOW",
      "meaning": "proof is valid for the intended relying party and live session"
    },
    {
      "case_id": "B-wrong-verifier",
      "audience": "https://rp-b.example/verifier",
      "client_id": "web-origin:https://rp-b.example",
      "origin": "https://rp-b.example",
      "nonce": "session-001",
      "route_binding": "POST https://rp-b.example/post",
      "transcript_binding": "same disclosed payload reused",
      "verdict": "REJECT_WRONG_TARGET",
      "meaning": "cryptographically similar proof is not admissible for a different verifier"
    },
    {
      "case_id": "C-stale-replay-same-verifier",
      "audience": "https://rp-a.example/verifier",
      "client_id": "web-origin:https://rp-a.example",
      "origin": "https://rp-a.example",
      "nonce": "session-000-old",
      "route_binding": "POST https://rp-a.example/post",
      "transcript_binding": "old wallet nonce / old session transcript",
      "verdict": "REJECT_STALE_SESSION",
      "meaning": "same verifier is still the wrong verifier when the session changed"
    },
    {
      "case_id": "D-origin-misbinding",
      "audience": "https://rp-a.example/verifier",
      "client_id": "web-origin:https://rp-a.example",
      "origin": "https://evil.example",
      "nonce": "session-001",
      "route_binding": "POST https://rp-a.example/post",
      "transcript_binding": "expected_origins mismatch",
      "verdict": "REJECT_ORIGIN_MISMATCH",
      "meaning": "browser / DC-API origin belongs in the proof-admissibility contract"
    },
    {
      "case_id": "E-route-or-handover-change",
      "audience": "https://rp-a.example/verifier",
      "client_id": "web-origin:https://rp-a.example",
      "origin": "https://rp-a.example",
      "nonce": "session-001",
      "route_binding": "GET https://rp-a.example/post or POST https://rp-a.example/other",
      "transcript_binding": "responseUri or jwkThumbprint changed",
      "verdict": "REJECT_ROUTE_OR_TRANSCRIPT_MISMATCH",
      "meaning": "endpoint and handover drift can invalidate a replay even when claims and key stay the same"
    }
  ],
  "lesson": "A proof that verifies cryptographically may still be invalid for a different verifier, origin, endpoint, or session."
}
