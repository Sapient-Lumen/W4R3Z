{
  "scenario": "same-proof-format-different-authenticator-assurance",
  "question": "What changes when the same verifier-targeted proof is produced under different authenticator classes, user-control events, and device-binding postures?",
  "cases": [
    {
      "case_id": "A-soft-key-no-uv",
      "proof": "format-and-session-valid",
      "authenticator_facts": {
        "up": true,
        "uv": false,
        "backup_eligible": null,
        "attestation": "absent",
        "key_container": "software_or_uncharacterized"
      },
      "holder_binding": "required",
      "outcome": "admissible-low-assurance"
    },
    {
      "case_id": "B-syncable-uv",
      "proof": "format-and-session-valid",
      "authenticator_facts": {
        "up": true,
        "uv": true,
        "backup_eligible": true,
        "backup_state": true,
        "attestation": "absent",
        "key_container": "syncable"
      },
      "holder_binding": "required",
      "outcome": "admissible-but-not-device-unique"
    },
    {
      "case_id": "C-device-bound-attested",
      "proof": "format-and-session-valid",
      "authenticator_facts": {
        "up": true,
        "uv": true,
        "backup_eligible": false,
        "backup_state": false,
        "attestation": "present",
        "key_storage": [
          "non_exportable",
          "hardware_backed"
        ],
        "user_authentication": [
          "local_multi_factor"
        ]
      },
      "holder_binding": "required",
      "outcome": "admissible-high-assurance"
    },
    {
      "case_id": "D-holder-binding-waived",
      "proof": "claims-valid-no-holder-binding",
      "authenticator_facts": {
        "up": null,
        "uv": null,
        "attestation": "not-applicable"
      },
      "holder_binding": "waived",
      "outcome": "presentation-valid-but-replay-accepted"
    }
  ],
  "lesson": "The same disclosed claims and verifier target are not replay-complete. Future inheritors need authenticator-assurance facts, or they can misread device binding, user verification, and holder-binding policy changes as moral or institutional progress."
}
