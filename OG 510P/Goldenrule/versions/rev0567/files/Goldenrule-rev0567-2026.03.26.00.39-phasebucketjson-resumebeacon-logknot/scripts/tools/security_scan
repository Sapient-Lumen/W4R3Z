#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OUT_DIR="$ROOT/artifacts/security"
OUT_FILE="$OUT_DIR/report.json"
STRICT="${STRICT:-0}"
mkdir -p "$OUT_DIR"

timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
os="$(uname -s)"
arch="$(uname -m)"

if command -v cargo-audit >/dev/null 2>&1; then
  tmp="$(mktemp)"
  status="ok"
  if cargo-audit --json >"$tmp" 2>/dev/null; then
    findings="$(python3 - <<'PY' "$tmp"
import json,sys
obj=json.load(open(sys.argv[1]))
print(len(obj.get('vulnerabilities',{}).get('list',[])))
PY
)"
  else
    status="error"
    findings=-1
  fi
  python3 - <<'PY' "$OUT_FILE" "$timestamp" "$status" "$findings" "$os" "$arch" "$STRICT"
import json,sys
path,timestamp,status,findings,os_name,arch,strict=sys.argv[1:]
obj={
  "timestamp": timestamp,
  "strict": strict == "1",
  "environment": {"os": os_name, "arch": arch},
  "tool": "cargo-audit",
  "status": status,
  "findings": int(findings),
}
with open(path,"w",encoding="utf-8") as f:
  json.dump(obj,f,indent=2,sort_keys=True)
  f.write("\n")
PY
  if [[ "$status" != "ok" ]]; then
    echo "security_scan: cargo-audit failed"
    [[ "$STRICT" == "1" ]] && exit 1
  fi
else
  python3 - <<'PY' "$OUT_FILE" "$timestamp" "$os" "$arch" "$STRICT"
import json,sys
path,timestamp,os_name,arch,strict=sys.argv[1:]
obj={
  "timestamp": timestamp,
  "strict": strict == "1",
  "environment": {"os": os_name, "arch": arch},
  "tool": None,
  "status": "skipped",
  "reason": "cargo-audit not installed",
  "findings": None,
}
with open(path,"w",encoding="utf-8") as f:
  json.dump(obj,f,indent=2,sort_keys=True)
  f.write("\n")
PY
  echo "security_scan: skipped (cargo-audit missing)"
  if [[ "$STRICT" == "1" ]]; then
    echo "security_scan: strict mode requires cargo-audit"
    exit 1
  fi
fi

echo "security_scan: wrote $OUT_FILE"
