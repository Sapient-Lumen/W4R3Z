{
  "schema_version": 1,
  "id": "snapshot_smoke_v1",
  "description": "Example definition snapshot that binds current smoke registries/suites.",
  "probe_registry": {
    "schema_version": 1,
    "id": "probe_registry_smoke_v1",
    "description": "Tiny probe registry for wiring and format smoke checks.",
    "probes": [
      {
        "schema_version": 1,
        "id": "ipd_c_vs_d_smoke_v1",
        "description": "AlwaysC vs AlwaysD in standard IPD; asserts expected directional payoffs.",
        "world": {
          "id": "ipd_core_v1",
          "game": { "kind": "ipd", "payoffs": { "r": 3.0, "s": 0.0, "t": 5.0, "p": 1.0 } },
          "noise": { "kind": "none" },
          "termination": { "kind": "fixed", "rounds": 20 },
          "seed": 12345
        },
        "matchups": [
          {
            "id": "always_c_vs_always_d",
            "strategy_a": { "family": "builtin", "id": "always_c_v1", "kind": "always_c", "params": { "p_cooperate": 1.0 } },
            "strategy_b": { "family": "builtin", "id": "always_d_v1", "kind": "always_d", "params": { "p_cooperate": 0.0 } },
            "replications": 3,
            "seed_offset": 0,
            "trace_rounds": 0,
            "assertions": [
              { "kind": "avg_payoff_a_at_least", "min": 0.0 },
              { "kind": "avg_payoff_b_at_least", "min": 4.9 },
              { "kind": "coop_rate_a_at_least", "min": 1.0 }
            ]
          }
        ]
      }
    ]
  },
  "probe_suite": {
    "schema_version": 1,
    "id": "probe_suite_smoke_v1",
    "description": "Runs a tiny set of probes from the smoke registry.",
    "probe_ids": ["ipd_c_vs_d_smoke_v1"]
  },
  "metamorphic_registry": {
    "schema_version": 1,
    "id": "metamorphic_registry_smoke_v1",
    "description": "Tiny metamorphic registry for wiring and format smoke checks.",
    "checks": [
      {
        "schema_version": 1,
        "id": "player_swap_smoke_v1",
        "description": "Player swap symmetry on a deterministic matchup.",
        "kind": "player_swap_symmetry",
        "probe": {
          "schema_version": 1,
          "id": "probe_for_player_swap_smoke_v1",
          "description": "Deterministic matchup suitable for strict player-swap symmetry.",
          "world": {
            "id": "ipd_core_v1",
            "game": { "kind": "ipd", "payoffs": { "r": 3.0, "s": 0.0, "t": 5.0, "p": 1.0 } },
            "noise": { "kind": "none" },
            "termination": { "kind": "fixed", "rounds": 30 },
            "seed": 12345
          },
          "matchups": [
            {
              "id": "tft_vs_wsls",
              "strategy_a": { "family": "builtin", "id": "tft_v1", "kind": "tit_for_tat" },
              "strategy_b": { "family": "builtin", "id": "wsls_v1", "kind": "win_stay_lose_shift" },
              "replications": 3,
              "trace_rounds": 0,
              "assertions": []
            }
          ]
        }
      },
      {
        "schema_version": 1,
        "id": "scaling_prefix_smoke_v1",
        "description": "Scaling prefix stability on a stochastic/noisy matchup (same seed).",
        "kind": "scaling_prefix_stability",
        "scaling_prefix": { "base_rounds": 20, "extended_rounds": 60 },
        "probe": {
          "schema_version": 1,
          "id": "probe_for_scaling_prefix_smoke_v1",
          "description": "Includes noise + stochastic strategies to ensure prefix stability holds under RNG stream extension.",
          "world": {
            "id": "ipd_noise_v1",
            "game": { "kind": "ipd", "payoffs": { "r": 3.0, "s": 0.0, "t": 5.0, "p": 1.0 } },
            "noise": { "kind": "iid", "p_implementation": 0.2, "p_observation": 0.1 },
            "termination": { "kind": "fixed", "rounds": 20 },
            "seed": 12345
          },
          "matchups": [
            {
              "id": "random_vs_mem1",
              "strategy_a": { "family": "builtin", "id": "random_v1", "kind": "random", "params": { "p_cooperate": 0.42 } },
              "strategy_b": { "family": "memory_one", "id": "mem1_v1", "p0": 0.9, "p_cc": 0.9, "p_cd": 0.1, "p_dc": 0.8, "p_dd": 0.2 },
              "replications": 3,
              "trace_rounds": 0,
              "assertions": []
            }
          ]
        }
      }
    ]
  },
  "metamorphic_suite": {
    "schema_version": 1,
    "id": "metamorphic_suite_smoke_v1",
    "description": "Runs a tiny set of metamorphic checks from the smoke registry.",
    "check_ids": ["player_swap_smoke_v1", "scaling_prefix_smoke_v1"]
  }
}

