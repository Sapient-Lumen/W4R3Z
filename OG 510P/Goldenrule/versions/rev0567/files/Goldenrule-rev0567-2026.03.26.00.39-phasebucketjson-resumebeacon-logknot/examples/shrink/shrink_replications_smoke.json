{
  "schema_version": 1,
  "id": "shrink_replications_smoke_v1",
  "description": "Shrinks a failing matchup down to the smallest replication count that still fails.",
  "max_scan_replications": 10,
  "probe": {
    "schema_version": 1,
    "id": "ipd_c_vs_d_fail_reps_v1",
    "description": "AlwaysC vs AlwaysD; force a failing A payoff floor.",
    "world": {
      "id": "ipd_core_v1",
      "game": { "kind": "ipd", "payoffs": { "r": 3.0, "s": 0.0, "t": 5.0, "p": 1.0 } },
      "noise": { "kind": "none" },
      "termination": { "kind": "fixed", "rounds": 20 },
      "seed": 12345
    },
    "matchups": [
      {
        "id": "always_c_vs_always_d",
        "strategy_a": { "family": "builtin", "id": "always_c_v1", "kind": "always_c" },
        "strategy_b": { "family": "builtin", "id": "always_d_v1", "kind": "always_d" },
        "replications": 5,
        "assertions": [{ "kind": "avg_payoff_a_at_least", "min": 0.1 }]
      }
    ]
  }
}

