{
  "schema_version": 1,
  "id": "shrink_matchups_smoke_v1",
  "description": "Shrinks a probe down to just the failing matchup.",
  "probe": {
    "schema_version": 1,
    "id": "probe_multi_matchup_v1",
    "world": {
      "id": "ipd_core_v1",
      "game": { "kind": "ipd", "payoffs": { "r": 3.0, "s": 0.0, "t": 5.0, "p": 1.0 } },
      "noise": { "kind": "none" },
      "termination": { "kind": "fixed", "rounds": 10 },
      "seed": 12345
    },
    "matchups": [
      {
        "id": "pass",
        "strategy_a": { "family": "builtin", "id": "tft_v1", "kind": "tit_for_tat" },
        "strategy_b": { "family": "builtin", "id": "tft_v1b", "kind": "tit_for_tat" },
        "replications": 1,
        "assertions": [{ "kind": "mutual_coop_rate_at_least", "min": 1.0 }]
      },
      {
        "id": "fail",
        "strategy_a": { "family": "builtin", "id": "always_c_v1", "kind": "always_c" },
        "strategy_b": { "family": "builtin", "id": "always_d_v1", "kind": "always_d" },
        "replications": 1,
        "assertions": [{ "kind": "avg_payoff_a_at_least", "min": 0.1 }]
      }
    ]
  }
}

