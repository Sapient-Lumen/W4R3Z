{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release-gcc",
      "displayName": "Release with GCC and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "sanitize-gcc",
      "displayName": "ASan + UBSan with GCC and Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/sanitize-gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "BZIP4_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release-gcc", "configurePreset": "release-gcc" },
    { "name": "sanitize-gcc", "configurePreset": "sanitize-gcc" }
  ],
  "testPresets": [
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitize-gcc",
      "configurePreset": "sanitize-gcc",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
