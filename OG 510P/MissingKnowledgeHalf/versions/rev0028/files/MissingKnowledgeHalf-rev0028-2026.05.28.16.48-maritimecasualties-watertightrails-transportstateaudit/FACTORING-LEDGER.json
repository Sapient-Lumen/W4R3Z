{
  "project": "MissingKnowledgeHalf",
  "revision": "rev0026",
  "created_at": "2026-05-25T14:55:00-04:00",
  "purpose": "Separate durable discipline from provisional record-type scaffolding. Future sessions should use record types as containers and factor axes as the true analytic surface.",
  "core_distinction": "Record type answers what kind of object this file is; factor axes answer how the object participates in epistemic motion.",
  "factor_axes": [
    {
      "id": "FA-001",
      "name": "object_role",
      "values": [
        "source",
        "claim",
        "attempt",
        "incident",
        "replication_program",
        "audit",
        "infrastructure",
        "genealogy_scene",
        "pattern_candidate",
        "practice_surface",
        "status_transition"
      ],
      "why": "Prevents record-type sprawl by distinguishing atomic role from folder."
    },
    {
      "id": "FA-002",
      "name": "evidence_surface",
      "values": [
        "official_report",
        "peer_reviewed_trial",
        "registry",
        "protocol_publication_pair",
        "FDA_or_regulator_review",
        "post_publication_review",
        "confidential_reporting_system",
        "court_or_inquiry",
        "lineage_archive",
        "vendor_postmortem",
        "journalistic_context"
      ],
      "why": "Lets users compare source strength across domains."
    },
    {
      "id": "FA-003",
      "name": "status_motion",
      "values": [
        "proposed",
        "published",
        "adopted",
        "canonized",
        "challenged",
        "nonreplicated",
        "narrowed",
        "reversed",
        "revived",
        "practice_persistent",
        "demoted",
        "unknown"
      ],
      "why": "The cube is about motion, not verdicts."
    },
    {
      "id": "FA-004",
      "name": "denominator_visibility",
      "values": [
        "visible_denominator",
        "paired_hidden_denominator",
        "registry_denominator",
        "abandoned_or_unpublished",
        "confidential_or_private",
        "posthoc_reconstructed",
        "unknown_denominator"
      ],
      "why": "Names how much of the missing half is actually visible."
    },
    {
      "id": "FA-005",
      "name": "correction_surface",
      "values": [
        "replication",
        "hard_endpoint_trial",
        "accident_investigation",
        "inquiry",
        "registry_results",
        "guideline_or_coverage",
        "retraction_or_expression_of_concern",
        "post_publication_peer_review",
        "safety_recommendation",
        "near_miss_channel"
      ],
      "why": "Separates the error from the institution that makes correction possible."
    },
    {
      "id": "FA-006",
      "name": "transmission_edge",
      "values": [
        "advisor",
        "citation",
        "coauthorship",
        "acknowledgment",
        "conference_copresence",
        "textbook_or_syllabus",
        "regulator_guidance",
        "media_amplification",
        "product_deployment",
        "reaction_against",
        "translation_or_editorial_labor"
      ],
      "why": "Genealogy of correction requires typed evidence-sensitive edges."
    },
    {
      "id": "FA-007",
      "name": "practice_status",
      "values": [
        "not_applicable",
        "never_adopted",
        "adopted_before_hard_evidence",
        "practice_lag_after_reversal",
        "de_adoption_underway",
        "still_contested_in_practice",
        "practice_unknown"
      ],
      "why": "Literature status and world status are separate."
    },
    {
      "id": "FA-008",
      "name": "harm_and_ethics",
      "values": [
        "low",
        "medium_reputational",
        "high_death_or_injury",
        "high_medical_or_legal",
        "security_sensitive",
        "restricted_private_or_confidential"
      ],
      "why": "Controls naming, quoting, survivor/family handling, and blame posture."
    },
    {
      "id": "FA-009",
      "name": "pattern_maturity",
      "values": [
        "single_case_observation",
        "support_cluster",
        "candidate",
        "candidate_with_controls",
        "mature_synthesis",
        "demoted_or_split"
      ],
      "why": "Prevents memorable analogy from becoming theory too early."
    },
    {
      "id": "FA-010",
      "name": "review_depth",
      "values": [
        "seed_only",
        "source_located",
        "one_pass_extracted",
        "schema_validated",
        "second_reviewed",
        "expert_reviewed",
        "query_ready"
      ],
      "why": "Counts should not substitute for review depth."
    }
  ],
