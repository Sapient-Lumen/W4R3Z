  "do_not_do": [
    "Do not solve every new phenomenon by inventing a new record type.",
    "Do not flatten all axes into tags without definitions.",
    "Do not let factor axes imply certainty: each axis value may need confidence and source support."
  ],
  "migration_target": "Eventually create first-class CLAIM, EDGE, STATUS_TRANSITION, LOCATOR, and PRACTICE_SURFACE tables/records while preserving readable case records as narrative bundles.",
