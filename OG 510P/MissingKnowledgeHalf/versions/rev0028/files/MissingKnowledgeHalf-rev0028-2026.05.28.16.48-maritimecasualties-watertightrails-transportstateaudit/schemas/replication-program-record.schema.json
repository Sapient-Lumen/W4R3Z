{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/replication-program-record.schema.json",
  "title": "MissingKnowledgeHalf Replication Program Record v0.1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-REP-[0-9]{4,}$"
    },
    "record_type": {
      "const": "REP"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "record_class",
        "replication_program",
        "original_sampling_frame",
        "replication_metrics",
        "status_cautions"
      ]
    }
  },
  "additionalProperties": true
}
