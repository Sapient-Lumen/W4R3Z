{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/pattern-record.schema.json",
  "title": "MissingKnowledgeHalf Pattern Candidate Record v0.3",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "evidence_profile",
    "type_payload",
    "ethics",
    "revision_history",
    "unknowns",
    "next_actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-PAT-[0-9]{4,}$"
    },
    "record_type": {
      "const": "PAT"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "pattern": "candidate|Candidate|not_mature|not_theory"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^MKH-(CTL|ENG|GEN|INF|MET|NEG|PAT|REP|SRC)-[0-9]{4,}$"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1
    },
    "evidence_profile": {
      "type": "object"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "red_team_controls"
      ],
      "properties": {
        "red_team_controls": {
          "type": "object",
          "required": [
            "control_status",
            "supporting_records_currently_in_cube",
            "positive_controls_needed",
            "negative_controls_needed",
            "counterexamples_to_seek",
            "rollback_triggers",
            "maturity_gate"
          ],
          "properties": {
            "supporting_records_currently_in_cube": {
              "type": "array"
            },
            "positive_controls_needed": {
              "type": "array"
            },
            "negative_controls_needed": {
              "type": "array"
            },
            "counterexamples_to_seek": {
              "type": "array"
            },
            "rollback_triggers": {
              "type": "array"
            },
            "maturity_gate": {
              "type": "object"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "links": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "object"
        }
      ]
    },
    "ethics": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "next_actions": {
      "type": "array"
    },
    "revision_history": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "description": "rev0020 permits pattern candidates to cite PAT records as qualifier/adjacent-pattern supports as well as CTL control records."
}
