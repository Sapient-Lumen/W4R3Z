{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/engineering-incident-record.schema.json",
  "title": "MissingKnowledgeHalf Engineering Incident Record v0.1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-ENG-[0-9]{4,}$"
    },
    "record_type": {
      "const": "ENG"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^MKH-SRC-[0-9]{4,}$"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1
    },
    "type_payload": {
      "type": "object",
      "required": [
        "incident_class",
        "system",
        "sequence_of_events",
        "proximate_cause",
        "contributing_factors",
        "latent_conditions"
      ]
    },
    "ethics": {
      "type": "object",
      "required": [
        "sensitivity",
        "handling_notes"
      ]
    }
  },
  "additionalProperties": true
}
