{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/genealogy-record.schema.json",
  "title": "MissingKnowledgeHalf genealogy / scene / anti-genealogy record schema",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "domain",
    "summary",
    "status_history",
    "subjects",
    "sources",
    "claims",
    "evidence_profile",
    "type_payload",
    "links",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-GEN-[0-9]{4,}$"
    },
    "record_type": {
      "const": "GEN"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "status_history": {
      "type": "array"
    },
    "time": {
      "type": "object"
    },
    "place": {
      "type": "object"
    },
    "subjects": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MKH-SRC-[0-9]{4,}$"
      }
    },
    "claims": {
      "type": "array"
    },
    "evidence_profile": {
      "type": "object"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "record_class",
        "relation_types",
        "nodes",
        "edges",
        "confidence_ladder",
        "scope_cautions",
        "why_it_matters_for_missing_half"
      ],
      "properties": {
        "record_class": {
          "enum": [
            "genealogy_infrastructure_model",
            "scene_record",
            "anti_genealogy_audit_scene"
          ]
        },
        "relation_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        },
        "confidence_ladder": {
          "type": "array"
        },
        "scope_cautions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why_it_matters_for_missing_half": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "array"
    },
    "ethics": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "next_actions": {
      "type": "array"
    },
    "revision_history": {
      "type": "array"
    }
  }
}
