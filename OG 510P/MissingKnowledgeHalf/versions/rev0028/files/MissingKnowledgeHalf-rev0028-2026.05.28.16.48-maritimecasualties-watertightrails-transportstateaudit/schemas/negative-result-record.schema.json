{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/negative-result-record.schema.json",
  "title": "MissingKnowledgeHalf Negative Result / Medical Reversal Record v0.2",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-NEG-[0-9]{4,}$"
    },
    "record_type": {
      "const": "NEG"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "hypothesis_or_claim_tested",
        "prior_evidentiary_route",
        "scope_cautions"
      ],
      "anyOf": [
        {
          "required": [
            "hard_endpoint_result"
          ]
        },
        {
          "required": [
            "hard_endpoint_or_reversal_surface"
          ]
        },
        {
          "required": [
            "program_audit_result"
          ]
        },
        {
          "required": [
            "negative_result_class"
          ]
        }
      ]
    }
  },
  "additionalProperties": true,
  "description": "rev0015 permits both early hard_endpoint_result and later hard_endpoint_or_reversal_surface payload variants."
}
