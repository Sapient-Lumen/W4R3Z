{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/evidence-ref.schema.json",
  "title": "MissingKnowledgeHalf Evidence Reference v0.1",
  "type": "object",
  "required": [
    "ref_id",
    "ref_kind",
    "support_role",
    "confidence"
  ],
  "properties": {
    "ref_id": {
      "type": "string",
      "pattern": "^MKH-(SRC|ENG|GEN|INF|MET|NEG|PAT|REP|CLA)-[0-9]{4,}$"
    },
    "ref_kind": {
      "enum": [
        "source",
        "engineering_record",
        "genealogy_record",
        "infrastructure_record",
        "metaresearch_record",
        "negative_result_record",
        "pattern_record",
        "replication_record",
        "claim",
        "unknown",
        "control_record"
      ]
    },
    "support_role": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "locator": {
      "type": "string"
    },
    "support_type": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
