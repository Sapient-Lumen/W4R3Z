{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissingKnowledgeHalf multilab replication record sketch",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "evidence_profile",
    "type_payload"
  ],
  "properties": {
    "record_type": {
      "const": "REP"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "record_class",
        "replication_program",
        "original_sampling_frame",
        "replication_metrics",
        "status_cautions"
      ]
    }
  }
}
