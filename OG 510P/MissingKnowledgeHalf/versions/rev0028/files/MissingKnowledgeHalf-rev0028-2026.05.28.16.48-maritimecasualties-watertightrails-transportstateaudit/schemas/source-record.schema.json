{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/source-record.schema.json",
  "title": "MissingKnowledgeHalf Source Record v0.3",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "domain",
    "summary",
    "sources",
    "source_payload",
    "ethics",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-SRC-[0-9]{4,}$"
    },
    "record_type": {
      "const": "SRC"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MKH-SRC-[0-9]{4,}$"
      }
    },
    "source_payload": {
      "type": "object",
      "required": [
        "author_or_body",
        "publication_date",
        "source_type",
        "url",
        "host",
        "retrieved_at",
        "evidence_class",
        "permanence_token",
        "copyability",
        "web_review_refs",
        "line_locators_used",
        "extraction_notes",
        "supports_record_ids"
      ],
      "properties": {
        "author_or_body": {
          "type": "string"
        },
        "publication_date": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string"
        },
        "evidence_class": {
          "type": "string"
        },
        "permanence_token": {
          "type": "string"
        },
        "copyability": {
          "type": "string"
        },
        "web_review_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "line_locators_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraction_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^MKH-(ENG|GEN|INF|MET|NEG|PAT|REP|CTL)-[0-9]{4,}$"
          }
        },
        "doi": {
          "type": "string"
        },
        "pmid": {
          "type": "string"
        },
        "pubmed": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "primary_article_pointer": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ethics": {
      "type": "object"
    },
    "revision_history": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "description": "rev0019 allows source records to support CTL calibration/control records."
}
