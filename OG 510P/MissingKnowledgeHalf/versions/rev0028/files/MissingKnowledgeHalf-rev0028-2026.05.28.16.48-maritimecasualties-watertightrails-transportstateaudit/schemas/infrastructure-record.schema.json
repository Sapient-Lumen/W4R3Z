{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/infrastructure-record.schema.json",
  "title": "MissingKnowledgeHalf Source Infrastructure Record v0.1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "revision_history",
    "unknowns",
    "next_actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-INF-[0-9]{4,}$"
    },
    "record_type": {
      "const": "INF"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MKH-SRC-[0-9]{4,}$"
      }
    },
    "claims": {
      "type": "array"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "infrastructure_class",
        "signal_capture_model",
        "outputs",
        "limitations"
      ]
    },
    "ethics": {
      "type": "object"
    },
    "revision_history": {
      "type": "array"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "description": "rev0015 hardened schema: non-source promoted records must carry unknowns and next_actions so uncertainty and follow-through survive resumption."
}
