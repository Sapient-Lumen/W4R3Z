{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/unified-record.schema.json",
  "title": "MissingKnowledgeHalf Unified Record v0.3",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "ethics",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-(NEG|REP|ENG|GEN|INF|MET|SRC|PAT|CLA|CTL)-[0-9]{4,}$"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "NEG",
        "REP",
        "ENG",
        "GEN",
        "INF",
        "MET",
        "SRC",
        "PAT",
        "CTL",
        "CLA"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "time": {
      "type": "object"
    },
    "place": {
      "type": "object"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "claim_status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MKH-CLA-[0-9]{4,}$"
          },
          "claim": {
            "type": "string"
          },
          "plain_claim": {
            "type": "string"
          },
          "claim_status": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "ref_id",
                "ref_kind",
                "support_role",
                "confidence"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_profile": {
      "type": "object"
    },
    "type_payload": {
      "type": "object"
    },
    "links": {
      "description": "Earlier records use both array-style link rows and compact dictionary-style link groups; rev0015 explicitly permits both until a graph-edge migration is performed.",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "object"
        }
      ]
    },
    "ethics": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true,
  "revision_note": "rev0020: introduces optional scope_qualifiers overlay for genomics scope/portability audit."
}
