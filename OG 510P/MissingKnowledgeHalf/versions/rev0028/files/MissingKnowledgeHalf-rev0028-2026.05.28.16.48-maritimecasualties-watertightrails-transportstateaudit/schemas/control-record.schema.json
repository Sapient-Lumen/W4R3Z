{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/control-record.schema.json",
  "title": "MissingKnowledgeHalf Control / Calibration Record v0.1",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-CTL-[0-9]{4,}$"
    },
    "record_type": {
      "const": "CTL"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MKH-(SRC|INF|MET|NEG|REP|ENG|GEN|PAT)-[0-9]{4,}$"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1
    },
    "type_payload": {
      "type": "object",
      "required": [
        "control_class",
        "calibrates_patterns",
        "fit_rationale",
        "limits"
      ]
    },
    "ethics": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "next_actions": {
      "type": "array"
    },
    "revision_history": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "description": "Control records are not failures; they are calibration surfaces used to red-team pattern candidates against overfitting."
}
