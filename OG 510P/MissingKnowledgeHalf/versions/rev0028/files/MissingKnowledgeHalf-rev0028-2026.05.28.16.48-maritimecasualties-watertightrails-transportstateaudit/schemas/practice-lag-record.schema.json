{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissingKnowledgeHalf practice-lag record sketch",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "record_type": {
      "enum": [
        "NEG",
        "MET",
        "INF",
        "PAT"
      ]
    },
    "type_payload": {
      "type": "object",
      "properties": {
        "practice_lag_dimensions": {
          "type": "array"
        },
        "hard_endpoint_or_reversal_surface": {
          "type": "array"
        },
        "scope_cautions": {
          "type": "array"
        }
      }
    }
  }
}
