{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/graph-edge-ledger.schema.json",
  "title": "MissingKnowledgeHalf Graph Edge Ledger v0.1",
  "type": "object",
  "required": ["project", "revision", "edges"],
  "properties": {
    "project": {"const": "MissingKnowledgeHalf"},
    "revision": {"type": "string"},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "edge_type", "from_id", "from_kind", "to_id", "to_kind", "source_surface"],
        "properties": {
          "edge_id": {"type": "string", "pattern": "^MKH-EDGE-[0-9]{6}$"},
          "edge_type": {"type": "string"},
          "from_id": {"type": "string"},
          "from_kind": {"type": "string"},
          "to_id": {"type": "string"},
          "to_kind": {"type": "string"},
          "source_surface": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
