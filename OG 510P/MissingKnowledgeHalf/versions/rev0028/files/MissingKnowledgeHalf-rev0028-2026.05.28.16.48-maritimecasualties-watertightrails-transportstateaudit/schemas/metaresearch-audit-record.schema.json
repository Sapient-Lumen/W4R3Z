{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missingknowledgehalf.local/schemas/metaresearch-audit-record.schema.json",
  "title": "MissingKnowledgeHalf Meta-Research Audit Record v0.2",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "sources",
    "claims",
    "type_payload",
    "ethics",
    "unknowns",
    "next_actions",
    "revision_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MKH-MET-[0-9]{4,}$"
    },
    "record_type": {
      "const": "MET"
    },
    "type_payload": {
      "type": "object",
      "required": [
        "audit_class",
        "denominator_surface",
        "numerator_surface",
        "limits"
      ],
      "anyOf": [
        {
          "required": [
            "bias_mechanisms_encoded"
          ]
        },
        {
          "required": [
            "bias_or_lag_mechanisms_encoded"
          ]
        },
        {
          "required": [
            "de_adoption_mechanisms_encoded"
          ]
        }
      ]
    }
  },
  "additionalProperties": true,
  "description": "rev0015 permits both reporting-bias and practice-lag/de-adoption meta-research payload variants."
}
