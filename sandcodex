+static bool sandcodex_touchpad_swipe_shape_valid(int64_t x, int64_t y,
+        int32_t delta_x, int32_t delta_y, uint32_t fingers, uint32_t steps,
+        uint32_t duration_msec) {
+    int64_t magnitude_x = delta_x < 0 ? -(int64_t)delta_x : (int64_t)delta_x;
+    int64_t magnitude_y = delta_y < 0 ? -(int64_t)delta_y : (int64_t)delta_y;
+    int64_t maximum_magnitude = magnitude_x > magnitude_y
+        ? magnitude_x : magnitude_y;
+    return x >= 0 && x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+        y >= 0 && y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+        delta_x >= -SANDCODEX_TOUCHPAD_SWIPE_MAX_DELTA &&
+        delta_x <= SANDCODEX_TOUCHPAD_SWIPE_MAX_DELTA &&
+        delta_y >= -SANDCODEX_TOUCHPAD_SWIPE_MAX_DELTA &&
+        delta_y <= SANDCODEX_TOUCHPAD_SWIPE_MAX_DELTA &&
+        (delta_x != 0 || delta_y != 0) &&
+        fingers >= SANDCODEX_TOUCHPAD_SWIPE_MIN_FINGERS &&
+        fingers <= SANDCODEX_TOUCHPAD_SWIPE_MAX_FINGERS &&
+        steps >= 1 && steps <= SANDCODEX_TOUCHPAD_SWIPE_MAX_STEPS &&
+        (int64_t)steps <= maximum_magnitude &&
+        duration_msec >= steps + 1 &&
+        duration_msec <= SANDCODEX_TOUCHPAD_SWIPE_MAX_DURATION_MSEC;
+}
+
+static int32_t sandcodex_touchpad_swipe_cumulative(int32_t total,
+        uint32_t index, uint32_t steps) {
+    if (index == 0 || total == 0) {
+        return 0;
+    }
+    if (index >= steps) {
+        return total;
+    }
+    int64_t magnitude = total < 0 ? -(int64_t)total : (int64_t)total;
+    int64_t part = (magnitude * (int64_t)index) / (int64_t)steps;
+    return (int32_t)(total < 0 ? -part : part);
+}
+
+static bool sandcodex_emit_touchpad_swipe(
+        struct wlr_pointer_gestures_v1 *gestures, struct wlr_seat *seat,
+        int32_t delta_x, int32_t delta_y, uint32_t fingers, uint32_t steps,
+        uint32_t duration_msec, uint32_t base_time) {
+    if (!gestures || !seat || steps == 0 ||
+            duration_msec < steps + 1 ||
+            base_time > UINT32_MAX - duration_msec ||
+            (delta_x == 0 && delta_y == 0)) {
+        return false;
+    }
+
+    /* Validate the complete integer interpolation before swipe_begin.  After
+     * begin is client-visible this helper has no branch that can omit end. */
+    int32_t previous_x = 0;
+    int32_t previous_y = 0;
+    for (uint32_t index = 1; index <= steps; ++index) {
+        int32_t cumulative_x = sandcodex_touchpad_swipe_cumulative(
+            delta_x, index, steps);
+        int32_t cumulative_y = sandcodex_touchpad_swipe_cumulative(
+            delta_y, index, steps);
+        int32_t relative_x = cumulative_x - previous_x;
+        int32_t relative_y = cumulative_y - previous_y;
+        if (relative_x == 0 && relative_y == 0) {
+            return false;
+        }
+        previous_x = cumulative_x;
+        previous_y = cumulative_y;
+    }
+
+    previous_x = 0;
+    previous_y = 0;
+    wlr_pointer_gestures_v1_send_swipe_begin(
+        gestures, seat, base_time, fingers);
+    for (uint32_t index = 1; index <= steps; ++index) {
+        int32_t cumulative_x = sandcodex_touchpad_swipe_cumulative(
+            delta_x, index, steps);
+        int32_t cumulative_y = sandcodex_touchpad_swipe_cumulative(
+            delta_y, index, steps);
+        int32_t relative_x = cumulative_x - previous_x;
+        int32_t relative_y = cumulative_y - previous_y;
+        uint32_t offset = (uint32_t)(((uint64_t)duration_msec * index) /
+            (uint64_t)(steps + 1));
+        wlr_pointer_gestures_v1_send_swipe_update(
+            gestures, seat, base_time + offset,
+            (double)relative_x, (double)relative_y);
+        previous_x = cumulative_x;
+        previous_y = cumulative_y;
+    }
+    wlr_pointer_gestures_v1_send_swipe_end(
+        gestures, seat, base_time + duration_msec, false);
+    return previous_x == delta_x && previous_y == delta_y;
+}
+
+static bool sandcodex_pointer_default_route(struct sway_seat *seat,
+        uintptr_t expected_grab_address,
+        uintptr_t expected_default_grab_address,
+        uintptr_t expected_focused_surface_address,
+        uintptr_t expected_focused_client_address) {
+    if (!seat || !seat->cursor || !seat->wlr_seat ||
+            seat->focused_layer || seat->has_exclusive_layer ||
+            server.session_lock.lock || seat->cursor->active_constraint ||
+            !sandcodex_exact_released_pointer(seat)) {
+        return false;
+    }
+    struct wlr_seat_pointer_state *state = &seat->wlr_seat->pointer_state;
+    if (!state->grab || !state->default_grab ||
+            state->grab != state->default_grab || !state->focused_surface ||
+            !state->focused_surface->resource || !state->focused_client ||
+            state->focused_client->seat != seat->wlr_seat ||
+            !state->focused_client->client ||
+            wl_resource_get_client(state->focused_surface->resource) !=
+                state->focused_client->client) {
+        return false;
+    }
+    return (expected_grab_address == 0 ||
+            (uintptr_t)state->grab == expected_grab_address) &&
+        (expected_default_grab_address == 0 ||
+            (uintptr_t)state->default_grab == expected_default_grab_address) &&
+        (expected_focused_surface_address == 0 ||
+            (uintptr_t)state->focused_surface == expected_focused_surface_address) &&
+        (expected_focused_client_address == 0 ||
+            (uintptr_t)state->focused_client == expected_focused_client_address);
+}
