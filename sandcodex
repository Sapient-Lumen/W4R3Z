+            distance_start_65535 <= SANDCODEX_STYLUS_DISTANCE_MAX_65535 &&
+            distance_end_65535 <= SANDCODEX_STYLUS_DISTANCE_MAX_65535)) &&
+        ((!wheel_present && wheel_delta_degrees_256 == 0 &&
