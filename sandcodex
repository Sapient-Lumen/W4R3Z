sc_gemini_http() {
  local method="$1" url="$2" body="$3" response_path="$4" key="$5" tmp="$6" cfg
  cfg="$tmp/curl.conf"
  {
    printf 'header = "x-goog-api-key: %s"\n' "$key"
    printf 'connect-timeout = 20\n'
    printf 'max-time = 120\n'
  } >"$cfg"
  chmod 600 -- "$cfg"
  case "$method" in
    GET)
      curl --proto '=https' --tlsv1.2 -sS -o "$response_path" -w '%{http_code}' -K "$cfg" "$url"
      ;;
    POST)
      curl --proto '=https' --tlsv1.2 -sS -o "$response_path" -w '%{http_code}' -K "$cfg" \
        -H 'Content-Type: application/json' --data-binary "@$body" "$url"
      ;;
    *) sc_die "internal Gemini HTTP method error" 70 ;;
  esac
}

sc_gemini_render_status() {
  local status="$1"
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$status"
    return
  fi
  printf 'Sandcodex Gemini\n'
  if [[ "$(jq -r '.launch_ready' <<<"$status")" == true ]]; then
    printf '  result       READY\n'
  elif [[ "$(jq -r '.key_available' <<<"$status")" == true ]]; then
    printf '  result       DEGRADED · credentials exist, but no route is currently ready\n'
  else
    printf '  result       NOT READY · %s\n' "$(jq -r '.key_reason' <<<"$status")"
  fi
  printf '  policy       free-tier models only · no paid fallback\n'
  printf '  capacity     %s/%s models · %s/%s account/model routes\n' \
    "$(jq -r '.route_availability.usable_models' <<<"$status")" \
    "$(jq -r '.route_availability.total_models' <<<"$status")" \
    "$(jq -r '.route_availability.usable_routes' <<<"$status")" \
    "$(jq -r '.route_availability.total_routes' <<<"$status")"
  printf '  accounts     %s usable · %s configured · target %s\n' \
    "$(jq -r '.route_availability.usable_credentials' <<<"$status")" \
    "$(jq -r '.route_availability.credential_inventory' <<<"$status")" \
    "$(jq -r '.route_availability.rotation_target_accounts' <<<"$status")"
  printf '  rotation     automatic on quota/rate/auth pressure · fresh starts round-robin\n'
  printf '  qualification %s · adapter %s\n' \
    "$(jq -r 'if .routing.qualification.current then "current" else "required" end' <<<"$status")" \
    "$(jq -r '.routing.adapter_sha256[0:12]' <<<"$status")"
  printf '  wait budget  %ss per request across route attempts\n' \
    "$(jq -r '.routing.request_ceiling_seconds' <<<"$status")"
  jq -r 'if .route_availability.next_retry_at then
    "  next retry   " + .route_availability.next_retry_at else empty end' <<<"$status"
  if [[ "$(jq -r '.key_available' <<<"$status")" == true ]]; then
    printf '\naccounts\n'
    jq -r '.active.keys[]? | "  \(.index). \(.label) · id \(.key_id)"' <<<"$status"
    printf '  source       %s\n' "$(jq -r '.active.path' <<<"$status")"
  else
    printf '\nsetup\n'
    printf '  key bank     %s\n' "$(jq -r '.key_bank' <<<"$status")"
    printf '  fallback     %s\n' "$(jq -r '.key_file' <<<"$status")"
    printf '  next         %s\n' "$(jq -r '.install_hint' <<<"$status")"
  fi
  printf '\nnext\n'
  printf '  start        %s\n' "$(jq -r '.commands.launch' <<<"$status")"
  printf '  inspect      sandcodex gemini quota\n'
  printf '  test keys    sandcodex gemini keys test\n'
  printf '\nprivacy\n  Credential values and provider content are not printed.\n'
}

