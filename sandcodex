static size_t pending_count(const struct drop_state *state) {
    size_t count = 0U;
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0) {
            count++;
        }
    }
    return count;
}

static struct pending_request *find_pending(struct drop_state *state,
        uint32_t request_id) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0 &&
                state->pending[index].id == request_id) {
            return &state->pending[index];
        }
    }
    return NULL;
}

static struct pending_request *find_unannounced(struct drop_state *state) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0 &&
                !state->pending[index].announced) {
            return &state->pending[index];
        }
    }
    return NULL;
}

static bool target_valid(const struct drop_state *state);

static void source_target(void *data, struct wl_data_source *source,
        const char *mime_type) {
    (void)source;
    struct drop_state *state = data;
    state->target_mime[0] = '\0';
    if (mime_type != NULL) {
        if (!allowed_mime(state, mime_type) || strlen(mime_type) > MAX_MIME_BYTES) {
            state->terminal_error = true;
            return;
        }
        (void)snprintf(state->target_mime, sizeof(state->target_mime), "%s", mime_type);
    }
    state->target_generation++;
    if (state->target_generation == 0U) {
        state->terminal_error = true;
    }
}

static void source_send(void *data, struct wl_data_source *source,
        const char *mime_type, int descriptor) {
    (void)source;
    struct drop_state *state = data;
    if (state->request_attempts >= MAX_REQUESTS) {
        if (descriptor >= 0) {
            (void)close(descriptor);
        }
        state->terminal_error = true;
        return;
    }
    state->request_attempts++;
    if (!state->started || !state->request_gate_open || state->finished ||
            state->cancelled ||
            !allowed_mime(state, mime_type) || descriptor < 0) {
        if (descriptor >= 0) {
            (void)close(descriptor);
        }
        state->terminal_error = true;
        return;
    }
    /*
     * wl_data_offer.receive may be issued before the destination has accepted
     * a MIME/action.  Such speculative requests are protocol-valid, but a
     * source cannot prove that their descriptor belongs to the target that is
     * accepted later.  Close them empty.  A destination may retry after its
     * acceptance has reached the source.
     */
    if (!target_valid(state)) {
        (void)close(descriptor);
        return;
    }
    size_t slot = MAX_REQUESTS;
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor < 0) {
            slot = index;
            break;
        }
    }
    if (slot == MAX_REQUESTS) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    const int flags = fcntl(descriptor, F_GETFL);
    const int descriptor_flags = fcntl(descriptor, F_GETFD);
    struct stat metadata = {0};
    if (flags < 0 || descriptor_flags < 0 ||
            (flags & O_ACCMODE) != O_WRONLY || fstat(descriptor, &metadata) < 0 ||
            !S_ISFIFO(metadata.st_mode) || metadata.st_uid != geteuid() ||
            metadata.st_nlink != 1U ||
            fcntl(descriptor, F_SETFL, flags | O_NONBLOCK) < 0 ||
            fcntl(descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    state->next_request_id++;
    if (state->next_request_id == 0U) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    state->pending[slot].id = state->next_request_id;
    state->pending[slot].descriptor = descriptor;
    state->pending[slot].announced = false;
    (void)snprintf(state->pending[slot].mime, sizeof(state->pending[slot].mime),
        "%s", mime_type);
    (void)snprintf(state->pending[slot].accepted_mime,
        sizeof(state->pending[slot].accepted_mime), "%s", state->target_mime);
    state->pending[slot].target_generation = state->target_generation;
    state->pending[slot].selected_action = state->selected_action;
    state->requests_seen++;
}

