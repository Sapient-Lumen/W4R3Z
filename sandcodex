        if not self.is_wayland:
            self._click(button)
            return None
        points = route.get("points")
        if not isinstance(points, list) or not 0 <= point_index < len(points):
            raise ToolError("compositor click route lost its exact point")
        point_record = points[point_index]
        point = point_record.get("point") if isinstance(point_record, dict) else None
        if (
            not isinstance(point, list)
            or len(point) != 2
            or any(type(value) is not int for value in point)
        ):
            raise ToolError("compositor click route point is malformed")
        x, y = point
        if self.pointer != {"x": x, "y": y}:
            raise ToolError("compositor click cursor left its reviewed route point")
        transaction = getattr(self, "_active_pointer_transaction", None)
        if transaction is None or transaction.closed:
            raise ToolError("compositor click lost its birth-pinned virtual pointer")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor click has no SeatSeal virtual-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor click virtual-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
