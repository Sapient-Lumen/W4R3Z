    def _terminate(self) -> None:
        process = self.process
        if process is None:
            return
        try:
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=1)
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=1)
        finally:
            for stream in (process.stdin, process.stdout, process.stderr):
                if stream is not None:
                    with contextlib.suppress(Exception):
                        stream.close()

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            unresolved_modifier_arc = (
                self._modifier_arc_pending_mask is not None
                or self._modifier_arc_active_mask is not None
                or self._modifier_arc_release_inflight is not None
            )
            if unresolved_modifier_arc and not self.modifier_arc_revocation_forced:
                self.controller._quarantine_keyboard(
                    "virtual-keyboard transaction ended with unresolved compositor modifier authority"
                )
                raise ToolError(
                    "compositor modifier arc ended without release or connection revocation"
                )
            if not self.release_confirmed:
                self._quarantine_release(
                    "virtual-keyboard transaction ended before key-up and modifier-clear were confirmed"
                )
            elif not self.terminal_error and self._exact_alive():
                self._exchange("QUIT", expected="BYE")
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
            # A prior HELD=0 MODS=0 reply is sufficient proof that no input
            # remains in flight. Losing the subsequent process-shutdown reply
            # must fail the operation, but it must not permanently quarantine
            # a controller whose released state was already acknowledged.
            if not self.release_confirmed:
                self._quarantine_release(
                    "virtual-keyboard transaction shutdown did not confirm a released state"
                )
        finally:
            self._terminate()
            try:
                self.seat_stop_receipt = self.controller._seat_transaction_stopped(
                    "keyboard", self.purpose, self.seat_start_receipt
                )
            except Exception as seat_error:
                self.controller._quarantine_keyboard(
                    f"SeatSeal could not prove virtual-keyboard removal: {seat_error}"
                )
                if close_error is None:
                    close_error = seat_error
                else:
                    close_error = ToolError(
                        f"{close_error}; SeatSeal virtual-keyboard cleanup also failed: {seat_error}"
                    )
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_keyboard_transaction", None) is self:
                self.controller._active_keyboard_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandKeyboardTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception:
            if exc is None:
                raise
        return False

class WaylandInputMethodTransaction:
    """One focus-fenced native text-input commit transaction.

    CommitSeal keeps UTF-8 bytes in one immutable anonymous memfd and gives one
    birth-pinned helper only byte ranges.  The helper must first receive an
    application-originated input-method activate followed by ``done``.  Every
    chunk is committed with the exact done serial and acknowledged only after a
    Wayland roundtrip.  Surrounding text and content metadata are counted by the
    helper but are never relayed to the controller, logs, or model.
    """

    _ready_pattern = re.compile(
        rf"READY {re.escape(INPUT_METHOD_AGENT_PROTOCOL)} MANAGER (1) SEATS 1 "
        r"PAYLOAD ([0-9]{1,7}) ACTIVE ([01]) SERIAL ([0-9]+) EXECSEALED ([01])"
    )
    _active_pattern = re.compile(
        r"ACTIVE ([1-9][0-9]*) SERIAL ([0-9]+) ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )
    _inactive_pattern = re.compile(
        r"INACTIVE ([1-9][0-9]*) SERIAL ([0-9]+) ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )
    _commit_pattern = re.compile(
        r"COMMITTED ([1-9][0-9]*) OFFSET ([0-9]+) BYTES ([1-9][0-9]*) "
        r"SERIAL ([0-9]+) AFTER ([0-9]+) COMMITS ([1-9][0-9]*) "
        r"TOTAL ([1-9][0-9]*) ACTIVE 1 ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )
    _pong_pattern = re.compile(
        r"PONG ([1-9][0-9]*) ACTIVE ([01]) SERIAL ([0-9]+) "
        r"COMMITS ([0-9]+) BYTES ([0-9]+) ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )
    _bye_pattern = re.compile(
        r"BYE ([1-9][0-9]*) COMMITS ([0-9]+) BYTES ([0-9]+) "
        r"ACTIVE ([01]) SERIAL ([0-9]+) ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )
    _error_pattern = re.compile(
        r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) COMMITS ([0-9]+) "
        r"BYTES ([0-9]+) ACTIVE ([01]) SERIAL ([0-9]+) "
        r"ACTIVATIONS ([0-9]+) DEACTIVATIONS ([0-9]+)"
    )

    def __init__(self, controller: Any, text: str, purpose: str) -> None:
        self.controller = controller
        self.purpose = purpose
        if "\x00" in text:
            raise ToolError("native input-method text cannot contain NUL")
        self.payload = text.encode("utf-8")
        if len(self.payload) > MAX_TEXT_BYTES:
            raise ToolError("native input-method payload exceeds the private workstation limit")
        self.chunk_ranges = self._build_chunk_ranges(self.payload)
        if len(self.chunk_ranges) > INPUT_METHOD_AGENT_MAX_COMMITS:
            raise ToolError("native input-method payload exceeds the bounded commit count")
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.manager_version: int | None = None
        self.initial_active = False
        self.active = False
        self.done_serial = 0
        self.activations = 0
        self.deactivations = 0
        self.epoch_activations: int | None = None
        self.epoch_deactivations: int | None = None
        self.exec_sealed = False
        self.preparation_completed = False
        self.activation_timed_out = False
        self.commits_attempted = 0
        self.commits_confirmed = 0
        self.bytes_committed = 0
        self.serial_receipts: list[dict[str, int]] = []
        self.ready = False
        self.closed = False
        self.terminal_error = False
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self._stdout_buffer = bytearray()
        self._payload_descriptor: int | None = None
        self._start()

    @staticmethod
    def _build_chunk_ranges(payload: bytes) -> list[tuple[int, int]]:
        ranges: list[tuple[int, int]] = []
        start = 0
        while start < len(payload):
            end = min(start + INPUT_METHOD_AGENT_MAX_COMMIT_BYTES, len(payload))
            while end < len(payload) and (payload[end] & 0xC0) == 0x80:
                end -= 1
            if end <= start:
                raise ToolError("native input-method UTF-8 chunk boundary is invalid")
            try:
                payload[start:end].decode("utf-8", "strict")
            except UnicodeDecodeError as error:
                raise ToolError("native input-method UTF-8 chunk validation failed") from error
            ranges.append((start, end - start))
            start = end
        return ranges

    @staticmethod
    def _sealed_payload(payload: bytes) -> int:
        required_os = ("MFD_CLOEXEC", "MFD_ALLOW_SEALING")
        required_fcntl = ("F_ADD_SEALS", "F_GET_SEALS")
        if not hasattr(os, "memfd_create") or any(not hasattr(os, name) for name in required_os):
            raise ToolError("sealed anonymous input-method memory is unavailable on this Linux runtime")
        if any(not hasattr(fcntl, name) for name in required_fcntl):
            raise ToolError("Linux memfd sealing support is unavailable to the input-method controller")
        try:
            writable_descriptor = os.memfd_create(
                "sandcodex-input-method",
                int(getattr(os, "MFD_CLOEXEC"))
                | int(getattr(os, "MFD_ALLOW_SEALING"))
                | LINUX_MFD_NOEXEC_SEAL,
            )
        except OSError as error:
            if error.errno in {errno.EINVAL, errno.ENOSYS}:
                raise ToolError(
                    "native input-method transport requires Linux MFD_NOEXEC_SEAL support"
                ) from error
            raise
        readonly_descriptor: int | None = None
        try:
            os.fchmod(writable_descriptor, 0o600)
            initial = os.fstat(writable_descriptor)
            initial_seals = int(
                fcntl.fcntl(writable_descriptor, int(getattr(fcntl, "F_GET_SEALS")))
            )
            if (
                stat.S_IMODE(initial.st_mode) != 0o600
                or initial_seals != LINUX_F_SEAL_EXEC
            ):
                raise ToolError("input-method payload memfd did not start non-executable")
            write_all(writable_descriptor, payload)
            os.lseek(writable_descriptor, 0, os.SEEK_SET)
            fcntl.fcntl(
                writable_descriptor,
                int(getattr(fcntl, "F_ADD_SEALS")),
                INPUT_METHOD_PAYLOAD_SEALS,
            )
            observed = int(
                fcntl.fcntl(writable_descriptor, int(getattr(fcntl, "F_GET_SEALS")))
            )
            metadata = os.fstat(writable_descriptor)
            if (
                observed != INPUT_METHOD_PAYLOAD_SEALS
                or metadata.st_size != len(payload)
                or metadata.st_nlink != 0
                or stat.S_IMODE(metadata.st_mode) != 0o600
            ):
                raise ToolError(
                    "input-method payload memfd did not retain its immutable no-exec seal contract"
                )

            # Never inherit the writable open-file description. Reopening the
            # sealed inode through procfs creates an independent O_RDONLY file
            # description; verify exact identity and authority before closing
            # the only writable descriptor.
            readonly_descriptor = os.open(
                f"/proc/self/fd/{writable_descriptor}",
                os.O_RDONLY | os.O_CLOEXEC,
            )
            readonly_metadata = os.fstat(readonly_descriptor)
            readonly_flags = int(fcntl.fcntl(readonly_descriptor, fcntl.F_GETFL))
            readonly_descriptor_flags = int(
                fcntl.fcntl(readonly_descriptor, fcntl.F_GETFD)
            )
            readonly_seals = int(
                fcntl.fcntl(readonly_descriptor, int(getattr(fcntl, "F_GET_SEALS")))
            )
            if (
                (readonly_flags & os.O_ACCMODE) != os.O_RDONLY
                or readonly_flags & (os.O_APPEND | os.O_NONBLOCK)
                or readonly_descriptor_flags & fcntl.FD_CLOEXEC != fcntl.FD_CLOEXEC
                or readonly_metadata.st_dev != metadata.st_dev
                or readonly_metadata.st_ino != metadata.st_ino
                or readonly_metadata.st_size != len(payload)
                or readonly_metadata.st_nlink != 0
                or stat.S_IMODE(readonly_metadata.st_mode) != 0o600
                or readonly_seals != INPUT_METHOD_PAYLOAD_SEALS
            ):
                raise ToolError(
                    "input-method payload could not be reduced to one exact read-only sealed descriptor"
                )
            result = readonly_descriptor
            readonly_descriptor = None
            return result
        except Exception:
            with contextlib.suppress(OSError):
                if readonly_descriptor is not None:
                    os.close(readonly_descriptor)
            raise
        finally:
            with contextlib.suppress(OSError):
                os.close(writable_descriptor)

    def _diagnostic(self) -> str:
        process = self.process
        if process is None or process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
                break
            try:
                chunk = os.read(descriptor, min(2048 - len(chunks), 512))
            except OSError:
                break
            if not chunk:
                break
            chunks.extend(chunk)
        return bytes(chunks).decode("utf-8", "replace").strip()

    def _exact_alive(self) -> bool:
        return (
            self.pid is not None
            and self.start_ticks is not None
            and exact_process_alive(self.pid, self.start_ticks)
        )

    def _read_line(self, timeout: float) -> str:
        process = self.process
        if process is None or process.stdout is None:
            raise ToolError("private Wayland input-method transaction has no response channel")
        deadline = time.monotonic() + timeout
        descriptor = process.stdout.fileno()
        while b"\n" not in self._stdout_buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ToolError("private Wayland input-method transaction response timed out")
            try:
                readable, _, _ = select.select([descriptor], [], [], remaining)
            except (OSError, ValueError) as error:
                raise ToolError(f"private Wayland input-method transaction response failed: {error}") from error
            if not readable:
                raise ToolError("private Wayland input-method transaction response timed out")
            try:
                chunk = os.read(descriptor, INPUT_METHOD_AGENT_MAX_REPLY_BYTES + 1)
            except OSError as error:
                raise ToolError(f"private Wayland input-method transaction response failed: {error}") from error
            if not chunk:
                diagnostic = self._diagnostic()
                suffix = f": {diagnostic}" if diagnostic else ""
                raise ToolError(f"private Wayland input-method transaction exited before replying{suffix}")
            self._stdout_buffer.extend(chunk)
            if len(self._stdout_buffer) > INPUT_METHOD_AGENT_MAX_REPLY_BYTES:
                raise ToolError("private Wayland input-method transaction returned an oversized reply")
        raw, _, remainder = self._stdout_buffer.partition(b"\n")
        self._stdout_buffer = bytearray(remainder)
        try:
            return raw.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("private Wayland input-method transaction returned a non-ASCII reply") from error

    def _write_line(self, value: str) -> None:
        process = self.process
        if process is None or process.stdin is None:
            raise ToolError("private Wayland input-method transaction has no command channel")
        payload = value.encode("ascii", "strict")
        descriptor = process.stdin.fileno()
        offset = 0
        try:
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written <= 0:
                    raise BrokenPipeError("zero-length write")
                offset += written
        except (BrokenPipeError, OSError) as error:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland input-method transaction command failed{suffix}") from error

    def _start(self) -> None:
        if getattr(self.controller, "_active_input_method_transaction", None) is not None:
            raise ToolError("another private Wayland input-method transaction is already active")
        helper = getattr(self.controller, "input_method_agent", None)
        if not isinstance(helper, Path):
            raise ToolError("private Wayland input-method helper is unavailable")
        descriptor = self._sealed_payload(self.payload)
        self._payload_descriptor = descriptor
        environment = self.controller._controller_environment()
        try:
            process = subprocess.Popen(
                [os.fspath(helper), str(descriptor), str(len(self.payload))],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=environment,
                pass_fds=(descriptor,),
                start_new_session=True,
                close_fds=True,
                bufsize=0,
            )
        except OSError as error:
            raise ToolError(f"private Wayland input-method transaction could not start: {error}") from error
        finally:
            if self._payload_descriptor is not None:
                with contextlib.suppress(OSError):
                    os.close(self._payload_descriptor)
                self._payload_descriptor = None
        self.process = process
        self.pid = process.pid
        identity = None
        for _ in range(100):
            identity = proc_identity(process.pid)
            if identity is not None:
                break
            if process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            self._terminate()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland input-method transaction exited before custody was established{suffix}")
        self.start_ticks = int(identity["start_ticks"])
        try:
            ready = self._read_line(INPUT_METHOD_AGENT_READY_TIMEOUT_SECONDS)
            match = self._ready_pattern.fullmatch(ready)
            if (
                match is None
                or int(match.group(2)) != len(self.payload)
                or match.group(5) != "1"
                or not self._exact_alive()
            ):
                raise ToolError("private Wayland input-method transaction readiness receipt is invalid")
            self.manager_version = int(match.group(1))
            self.initial_active = match.group(3) == "1"
            self.active = self.initial_active
            self.done_serial = int(match.group(4))
            self.exec_sealed = match.group(5) == "1"
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.controller._active_input_method_transaction = self

    def _exchange(self, command: str, timeout: float = INPUT_METHOD_AGENT_COMMAND_TIMEOUT_SECONDS) -> str:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland input-method transaction lost its birth-pinned helper")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        try:
            reply = self._read_line(timeout)
        except Exception:
            self.terminal_error = True
            raise
        error_match = self._error_pattern.fullmatch(reply)
        if error_match is not None:
            if int(error_match.group(1)) != sequence:
                self.terminal_error = True
                raise ToolError("private Wayland input-method transaction returned a mismatched error sequence")
            self.commits_confirmed = int(error_match.group(3))
            self.bytes_committed = int(error_match.group(4))
            self.active = error_match.group(5) == "1"
            self.done_serial = int(error_match.group(6))
            self.activations = int(error_match.group(7))
            self.deactivations = int(error_match.group(8))
            self.terminal_error = True
            raise ToolError(
                f"private Wayland input-method transaction rejected {command.split()[0]}: "
                f"{error_match.group(2)}"
            )
        self.sequence += 1
        return reply

    def ping(self) -> None:
        sequence = self.sequence
        reply = self._exchange("PING")
        match = self._pong_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland input-method transaction returned an invalid ping receipt")
        self.active = match.group(2) == "1"
        self.done_serial = int(match.group(3))
        self.activations = int(match.group(6))
        self.deactivations = int(match.group(7))
        if int(match.group(4)) != self.commits_confirmed or int(match.group(5)) != self.bytes_committed:
            self.terminal_error = True
            raise ToolError("private Wayland input-method transaction ping accounting is inconsistent")

    def wait_active(self, timeout_milliseconds: int = INPUT_METHOD_AGENT_ACTIVE_TIMEOUT_MILLISECONDS) -> None:
        timeout_milliseconds = as_int(
            timeout_milliseconds, 1, 10000, "input-method activation timeout_milliseconds"
        )
        sequence = self.sequence
        reply = self._exchange(
            f"WAIT_ACTIVE {timeout_milliseconds}",
            timeout=max(INPUT_METHOD_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000.0 + 1.0),
        )
        match = self._active_pattern.fullmatch(reply)
        if match is not None:
            if int(match.group(1)) != sequence:
                self.terminal_error = True
                raise ToolError("private Wayland input-method transaction returned a mismatched activation sequence")
            self.active = True
            self.done_serial = int(match.group(2))
            self.activations = int(match.group(3))
            self.deactivations = int(match.group(4))
            if self.done_serial < 1 or self.activations < 1:
                self.terminal_error = True
                raise ToolError("private Wayland input-method activation receipt is inconsistent")
            self.epoch_activations = self.activations
            self.epoch_deactivations = self.deactivations
            self.preparation_completed = True
            return
        inactive = self._inactive_pattern.fullmatch(reply)
        if inactive is not None and int(inactive.group(1)) == sequence:
            self.active = False
            self.done_serial = int(inactive.group(2))
            self.activations = int(inactive.group(3))
            self.deactivations = int(inactive.group(4))
            self.activation_timed_out = True
            raise InputMethodUnavailable(
                "focused application did not activate a native Wayland text-input context"
            )
        self.terminal_error = True
        raise ToolError("private Wayland input-method transaction returned an invalid activation receipt")

    def commit_chunk(self, index: int) -> None:
        if not self.preparation_completed or not self.active:
            raise ToolError("native input-method commit was attempted before activation")
        if not isinstance(index, int) or isinstance(index, bool) or not 0 <= index < len(self.chunk_ranges):
            raise ToolError("native input-method commit index is invalid")
        if index != self.commits_attempted:
            raise ToolError("native input-method commits must be strictly sequential")
        offset, length = self.chunk_ranges[index]
        sequence = self.sequence
        self.commits_attempted += 1
        reply = self._exchange(f"COMMIT {offset} {length}")
        match = self._commit_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland input-method transaction returned an invalid commit receipt")
        received_offset = int(match.group(2))
        received_length = int(match.group(3))
        serial_before = int(match.group(4))
        serial_after = int(match.group(5))
        commits = int(match.group(6))
        total = int(match.group(7))
        activations = int(match.group(8))
        deactivations = int(match.group(9))
        expected_total = self.bytes_committed + length
        previous_serial = self.done_serial
        if (
            received_offset != offset
            or received_length != length
            or commits != self.commits_confirmed + 1
            or commits != self.commits_attempted
            or total != expected_total
            # The helper performs a Wayland roundtrip immediately before the
            # commit and therefore may legitimately observe newer same-epoch
            # state than WAIT_ACTIVE or the preceding commit receipt.  Accept
            # monotonic advancement, but never regression or uint32 wrap.
            or serial_before < previous_serial
            or serial_after < serial_before
            or self.epoch_activations is None
            or self.epoch_deactivations is None
            or activations != self.epoch_activations
            or deactivations != self.epoch_deactivations
        ):
            self.terminal_error = True
            raise ToolError("private Wayland input-method transaction commit accounting is inconsistent")
        self.commits_confirmed = commits
        self.bytes_committed = total
        self.done_serial = serial_after
        self.activations = activations
        self.deactivations = deactivations
        self.serial_receipts.append({
            "index": index,
            "serial_before": serial_before,
            "serial_after": serial_after,
            "serial_advanced_before_commit": int(serial_before > previous_serial),
            "offset": offset,
            "bytes": length,
        })

    def evidence(self) -> dict[str, Any]:
        return {
            "transport": "birth-pinned-zwp-input-method-v2",
            "protocol": INPUT_METHOD_AGENT_PROTOCOL,
            "connection_scope": "one-guarded-native-text-operation",
            "activation_authority": "focused-application-text-input-enable+compositor-done",
            "commit_authority": (
                "single-activation-epoch+precommit-roundtrip+exact-done-count+"
                "utf8-byte-range+postcommit-roundtrip"
            ),
            "payload_storage": (
                "mode-0600-non-executable-sealed-anonymous-memfd+readonly-inherited-descriptor"
            ),
            "payload_bytes": len(self.payload),
            "payload_in_process_argv": False,
            "payload_in_environment": False,
            "payload_written_to_disk": False,
            "payload_exec_sealed": self.exec_sealed,
            "payload_execution_policy": "MFD_NOEXEC_SEAL+F_SEAL_EXEC-required",
            "payload_descriptor_access": "read-only",
            "clipboard_touched": False,
            "synthetic_keymap_used": False,
            "surrounding_text_relayed": False,
            "content_type_relayed": False,
            "maximum_commit_bytes": INPUT_METHOD_AGENT_MAX_COMMIT_BYTES,
            "planned_commits": len(self.chunk_ranges),
            "commits_attempted": self.commits_attempted,
            "commits_confirmed": self.commits_confirmed,
            "bytes_committed": self.bytes_committed,
            "serial_receipts": list(self.serial_receipts),
            "initial_active": self.initial_active,
            "active": self.active,
            "done_serial": self.done_serial,
            "activations": self.activations,
            "deactivations": self.deactivations,
            "epoch_activations": self.epoch_activations,
            "epoch_deactivations": self.epoch_deactivations,
            "activation_epoch_intact": (
                self.epoch_activations is not None
                and self.epoch_deactivations is not None
                and self.activations == self.epoch_activations
                and self.deactivations == self.epoch_deactivations
            ),
            "preparation_completed": self.preparation_completed,
            "activation_timed_out": self.activation_timed_out,
            "registry_cardinality": "exactly-one-seat+one-input-method-manager",
            "helper_process_custody": (
                "parent-death-signal+non-dumpable+no-new-privileges+"
                "exact-inherited-descriptor-inventory+three-distinct-directional-pipes+"
                "zero-regular-file-output"
            ),
            "helper_pid": self.pid,
            "helper_start_ticks": self.start_ticks,
            "manager_version": self.manager_version,
            "shutdown_confirmed": self.shutdown_confirmed,
            "shutdown_error": self.shutdown_error,
            "terminal_error": self.terminal_error,
            "closed": self.closed,
        }

    def _terminate(self) -> None:
        process = self.process
        if process is None:
            return
        try:
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=1)
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=1)
        finally:
            for stream in (process.stdin, process.stdout, process.stderr):
                if stream is not None:
                    with contextlib.suppress(Exception):
                        stream.close()

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            if not self.terminal_error and self._exact_alive():
                sequence = self.sequence
                reply = self._exchange("QUIT")
                match = self._bye_pattern.fullmatch(reply)
                if (
                    match is None
                    or int(match.group(1)) != sequence
                    or int(match.group(2)) != self.commits_confirmed
                    or int(match.group(3)) != self.bytes_committed
                ):
                    self.terminal_error = True
                    raise ToolError("private Wayland input-method transaction returned an invalid shutdown receipt")
                self.active = match.group(4) == "1"
                self.done_serial = int(match.group(5))
                self.activations = int(match.group(6))
                self.deactivations = int(match.group(7))
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
        finally:
            self._terminate()
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_input_method_transaction", None) is self:
                self.controller._active_input_method_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandInputMethodTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception:
            if exc is None:
                raise
        return False


class WaylandClipboardTransaction:
    """One request-gated, one-shot Wayland selection escrow transaction.

    One bounded UTF-8, canonical PNG, or strict launch-private file URI list
    lives only in a read-only, explicitly non-executable sealed anonymous memfd inherited by one
    birth-pinned helper. Data-control ``send`` requests are held open by
    that helper and expose metadata only.  The controller must revalidate the
    launch trust domain, focused top-level or pointer route, and TickSeal
    interval before it authorizes each request. Success requires at least one
    complete transfer, a bounded quiet period, and a compositor-roundtrip-
    confirmed clear of the exact ordinary or PRIMARY selection target.
    Ambiguous clear state quarantines further selection publication.
    """

    _ready_pattern = re.compile(
        rf"READY {re.escape(CLIPBOARD_AGENT_PROTOCOL)} MANAGER (1) SEATS 1 "
        rf"SELECTION (clipboard|primary) PROFILE (text|png|files) "
        rf"PAYLOAD ([0-9]{{1,8}}) EXECSEALED (1)"
    )
    _request_pattern = re.compile(
        r"REQUEST ([1-9][0-9]*) ID ([1-9][0-9]*) MIME "
        r"(text/plain;charset=utf-8|text/plain|UTF8_STRING|STRING|image/png|text/uri-list) "
        r"PENDING ([1-9][0-9]*)"
    )
    _quiet_pattern = re.compile(
        r"QUIET ([1-9][0-9]*) REQUESTS ([1-9][0-9]*) TRANSFERS ([1-9][0-9]*) BYTES ([0-9]+)"
    )
    _authorize_pattern = re.compile(
        r"AUTHORIZED ([1-9][0-9]*) ID ([1-9][0-9]*) BYTES ([0-9]+) "
        r"TRANSFERS ([1-9][0-9]*) PENDING ([0-9]+)"
    )
    _clear_pattern = re.compile(
        r"CLEARED ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
        r"BYTES ([0-9]+) CANCELLED ([01])"
    )
    _bye_pattern = re.compile(
        r"BYE ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
        r"BYTES ([0-9]+) CLEARED 1"
    )
    _error_pattern = re.compile(
        r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) REQUESTS ([0-9]+) "
        r"TRANSFERS ([0-9]+) PENDING ([0-9]+) CLEARED ([01])"
    )

    def __init__(
        self,
        controller: Any,
        payload: bytes,
        purpose: str,
        launch_id: str | None,
        *,
        profile: str = "text",
        selection: str = "clipboard",
        scene_id: str | None = None,
        scene_launch_ids: tuple[str, ...] = (),
    ) -> None:
        self.controller = controller
        self.purpose = purpose
        self.launch_id = launch_id
        self.scene_id = scene_id
        self.scene_launch_ids = tuple(sorted(scene_launch_ids))
        if self.launch_id is not None and self.scene_launch_ids:
            raise ToolError("clipboard escrow cannot mix launch and scene-set scope")
        if self.scene_launch_ids:
            if self.scene_id is None:
                raise ToolError("scene-set clipboard escrow requires scene_id")
            if not 2 <= len(self.scene_launch_ids) <= SCENE_SET_MAX_LAUNCHES:
                raise ToolError("scene-set clipboard escrow member count is invalid")
            if len(set(self.scene_launch_ids)) != len(self.scene_launch_ids):
                raise ToolError("scene-set clipboard escrow membership contains duplicates")
            if any(
                re.fullmatch(r"launch-[0-9a-f]{24}", value) is None
                for value in self.scene_launch_ids
            ):
                raise ToolError("scene-set clipboard escrow membership is malformed")
        elif self.scene_id is not None:
            raise ToolError("scene-set clipboard escrow requires exact launch membership")
        if profile not in {"text", "png", "files"}:
            raise ToolError("clipboard escrow payload profile is invalid")
        if selection not in {"clipboard", "primary"}:
            raise ToolError("Wayland selection escrow target is invalid")
        if selection == "primary" and profile != "text":
            raise ToolError("Wayland PRIMARY selection escrow accepts UTF-8 text only")
        if not isinstance(payload, bytes):
            raise ToolError("clipboard escrow payload must be immutable bytes")
        self.profile = profile
        self.selection = selection
        self.payload = payload
        if profile == "text":
            if len(payload) > MAX_TEXT_BYTES:
                raise ToolError("clipboard escrow text exceeds the private workstation limit")
            try:
                payload.decode("utf-8", "strict")
            except UnicodeDecodeError as error:
                raise ToolError("clipboard escrow text is not valid UTF-8") from error
        elif profile == "png":
            if not 8 <= len(payload) <= MAX_RICH_PASTE_PNG_BYTES:
                raise ToolError("clipboard escrow PNG exceeds the private workstation limit")
        else:
            if not 1 <= len(payload) <= MAX_FILE_DROP_URI_LIST_BYTES:
                raise ToolError("clipboard escrow file URI list exceeds the private workstation limit")
            try:
                uri_text = payload.decode("ascii", "strict")
            except UnicodeDecodeError as error:
                raise ToolError("clipboard escrow file URI list is not strict ASCII") from error
            if not uri_text.endswith("\r\n") or "\n" in uri_text.replace("\r\n", ""):
                raise ToolError("clipboard escrow file URI list is not canonical CRLF text/uri-list")
            uri_lines = uri_text[:-2].split("\r\n")
            if not 1 <= len(uri_lines) <= MAX_FILE_DROP_FILES:
                raise ToolError("clipboard escrow file URI list has an invalid entry count")
            uri_pattern = re.compile(
                rf"file://{re.escape(FILE_DROP_MOUNT)}/(clip-[0-9a-f]{{32}})/"
                rf"files/item-(0[1-8])/(?:[A-Za-z0-9._~-]|%[0-9A-F]{{2}})+"
            )
            transaction_ids: set[str] = set()
            for index, uri in enumerate(uri_lines, start=1):
                match = uri_pattern.fullmatch(uri)
                if match is None:
                    raise ToolError("clipboard escrow file URI list escaped its canonical launch-private namespace")
                if match.group(2) != f"{index:02d}":
                    raise ToolError("clipboard escrow file URI list has non-sequential opaque slots")
                transaction_ids.add(match.group(1))
            if len(transaction_ids) != 1:
                raise ToolError("clipboard escrow file URI list mixes staging transactions")
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.manager_version: int | None = None
        self.ready = False
        self.closed = False
        self.terminal_error = False
        self.clear_confirmed = False
        self.clear_recovery_confirmed = False
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self.requests_seen = 0
        self.requests_announced = 0
        self.requests_authorized = 0
        self.transfers_completed = 0
        self.bytes_transferred = 0
        self.pending_requests = 0
        self.authorization_checkpoints = 0
        self.post_transfer_checkpoints = 0
        self.quiet_confirmed = False
        self._stdout_buffer = bytearray()
        self._payload_descriptor: int | None = None
        self._start()

    @staticmethod
    def _sealed_payload(payload: bytes) -> int:
        required_os = ("MFD_CLOEXEC", "MFD_ALLOW_SEALING")
        required_fcntl = (
            "F_ADD_SEALS", "F_GET_SEALS", "F_SEAL_SHRINK", "F_SEAL_GROW",
            "F_SEAL_WRITE", "F_SEAL_SEAL",
        )
        if not hasattr(os, "memfd_create") or any(not hasattr(os, name) for name in required_os):
            raise ToolError("sealed anonymous clipboard memory is unavailable on this Linux runtime")
        if any(not hasattr(fcntl, name) for name in required_fcntl):
            raise ToolError("Linux memfd sealing support is unavailable to the clipboard controller")
        writable: int | None = None
        readonly: int | None = None
        try:
            writable = os.memfd_create(
                "sandcodex-clipboard",
                int(getattr(os, "MFD_CLOEXEC"))
                | int(getattr(os, "MFD_ALLOW_SEALING"))
                | LINUX_MFD_NOEXEC_SEAL,
            )
            os.fchmod(writable, 0o600)
            write_all(writable, payload)
            os.lseek(writable, 0, os.SEEK_SET)
            fcntl.fcntl(
                writable,
                int(getattr(fcntl, "F_ADD_SEALS")),
                INPUT_METHOD_PAYLOAD_SEALS,
            )
            readonly = os.open(
                f"/proc/self/fd/{writable}",
                os.O_RDONLY | os.O_CLOEXEC,
            )
            writable_metadata = os.fstat(writable)
            readonly_metadata = os.fstat(readonly)
            if (
                writable_metadata.st_dev != readonly_metadata.st_dev
                or writable_metadata.st_ino != readonly_metadata.st_ino
            ):
                raise ToolError("clipboard payload read-only descriptor changed object identity")
            os.close(writable)
            writable = None
            observed = int(
                fcntl.fcntl(readonly, int(getattr(fcntl, "F_GET_SEALS")))
            )
            metadata = os.fstat(readonly)
            flags = int(fcntl.fcntl(readonly, fcntl.F_GETFL))
            if (
                observed != INPUT_METHOD_PAYLOAD_SEALS
                or metadata.st_size != len(payload)
                or metadata.st_nlink != 0
                or stat.S_IMODE(metadata.st_mode) != 0o600
                or flags & os.O_ACCMODE != os.O_RDONLY
                or flags & (os.O_APPEND | os.O_NONBLOCK)
            ):
                raise ToolError(
                    "clipboard payload memfd did not retain its read-only non-executable seal contract"
                )
            os.lseek(readonly, 0, os.SEEK_SET)
            result = readonly
            readonly = None
            return result
        except OSError as error:
            raise ToolError(
                "read-only non-executable sealed clipboard memory is unavailable on this Linux runtime"
            ) from error
        finally:
            for descriptor in (readonly, writable):
                if descriptor is not None:
                    with contextlib.suppress(OSError):
                        os.close(descriptor)

    def _diagnostic(self) -> str:
        process = self.process
        if process is None or process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
                break
            try:
                chunk = os.read(descriptor, min(2048 - len(chunks), 512))
            except OSError:
                break
            if not chunk:
                break
            chunks.extend(chunk)
        return bytes(chunks).decode("utf-8", "replace").strip()

    def _exact_alive(self) -> bool:
        return (
            self.pid is not None
            and self.start_ticks is not None
            and exact_process_alive(self.pid, self.start_ticks)
        )

    def _read_line(self, timeout: float) -> str:
        process = self.process
        if process is None or process.stdout is None:
            raise ToolError("private Wayland clipboard transaction has no response channel")
        deadline = time.monotonic() + timeout
        descriptor = process.stdout.fileno()
        while b"\n" not in self._stdout_buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ToolError("private Wayland clipboard transaction response timed out")
            try:
                readable, _, _ = select.select([descriptor], [], [], remaining)
            except (OSError, ValueError) as error:
                raise ToolError(f"private Wayland clipboard transaction response failed: {error}") from error
            if not readable:
                raise ToolError("private Wayland clipboard transaction response timed out")
            try:
                chunk = os.read(descriptor, CLIPBOARD_AGENT_MAX_REPLY_BYTES + 1)
            except OSError as error:
                raise ToolError(f"private Wayland clipboard transaction response failed: {error}") from error
            if not chunk:
                diagnostic = self._diagnostic()
                suffix = f": {diagnostic}" if diagnostic else ""
                raise ToolError(f"private Wayland clipboard transaction exited before replying{suffix}")
            self._stdout_buffer.extend(chunk)
            if len(self._stdout_buffer) > CLIPBOARD_AGENT_MAX_REPLY_BYTES:
                raise ToolError("private Wayland clipboard transaction returned an oversized reply")
        raw, _, remainder = self._stdout_buffer.partition(b"\n")
        self._stdout_buffer = bytearray(remainder)
        try:
            return raw.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("private Wayland clipboard transaction returned a non-ASCII reply") from error

    def _write_line(self, value: str) -> None:
        process = self.process
        if process is None or process.stdin is None:
            raise ToolError("private Wayland clipboard transaction has no command channel")
        payload = value.encode("ascii", "strict")
        descriptor = process.stdin.fileno()
        offset = 0
        try:
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written <= 0:
                    raise BrokenPipeError("zero-length write")
                offset += written
        except (BrokenPipeError, OSError) as error:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland clipboard transaction command failed{suffix}") from error

    def _start(self) -> None:
        self.controller._require_clipboard_healthy()
        if getattr(self.controller, "_active_clipboard_transaction", None) is not None:
            raise ToolError("another private Wayland clipboard transaction is already active")
        self._assert_scope()
        helper = getattr(self.controller, "clipboard_agent", None)
        if not isinstance(helper, Path):
            raise ToolError("private Wayland clipboard escrow helper is unavailable")
        descriptor = self._sealed_payload(self.payload)
        self._payload_descriptor = descriptor
        environment = self.controller._controller_environment()
        try:
            process = subprocess.Popen(
                [
                    os.fspath(helper),
                    self.selection,
                    self.profile,
                    str(descriptor),
                    str(len(self.payload)),
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=environment,
                pass_fds=(descriptor,),
                start_new_session=True,
                close_fds=True,
                bufsize=0,
            )
        except OSError as error:
            with contextlib.suppress(OSError):
                os.close(descriptor)
            self._payload_descriptor = None
            raise ToolError(f"private Wayland clipboard transaction could not start: {error}") from error
        finally:
            if self._payload_descriptor is not None:
                with contextlib.suppress(OSError):
                    os.close(self._payload_descriptor)
                self._payload_descriptor = None
        self.process = process
        self.pid = process.pid
        identity = None
        for _ in range(100):
            identity = proc_identity(process.pid)
            if identity is not None:
                break
            if process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            self._terminate()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland clipboard transaction exited before custody was established{suffix}")
        self.start_ticks = int(identity["start_ticks"])
        try:
            ready = self._read_line(CLIPBOARD_AGENT_READY_TIMEOUT_SECONDS)
            match = self._ready_pattern.fullmatch(ready)
            if (
                match is None
                or match.group(2) != self.selection
                or match.group(3) != self.profile
                or int(match.group(4)) != len(self.payload)
                or match.group(5) != "1"
                or not self._exact_alive()
            ):
                raise ToolError("private Wayland clipboard transaction readiness receipt is invalid")
            self.manager_version = int(match.group(1))
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.controller._active_clipboard_transaction = self

    def _exchange(self, command: str, timeout: float = CLIPBOARD_AGENT_COMMAND_TIMEOUT_SECONDS) -> str:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland clipboard transaction lost its birth-pinned helper")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        try:
            reply = self._read_line(timeout)
        except Exception:
            self.terminal_error = True
            raise
        error_match = self._error_pattern.fullmatch(reply)
        if error_match is not None:
            if int(error_match.group(1)) != sequence:
                self.terminal_error = True
                raise ToolError("private Wayland clipboard transaction returned a mismatched error sequence")
            self.requests_seen = int(error_match.group(3))
            self.transfers_completed = int(error_match.group(4))
            self.pending_requests = int(error_match.group(5))
            self.clear_confirmed = error_match.group(6) == "1"
            self.terminal_error = True
            raise ToolError(f"private Wayland clipboard transaction rejected {command.split()[0]}: {error_match.group(2)}")
        self.sequence += 1
        return reply

    def ping(self) -> None:
        sequence = self.sequence
        reply = self._exchange("PING")
        if reply != f"PONG {sequence}":
            self.terminal_error = True
            raise ToolError("private Wayland clipboard transaction returned an invalid ping receipt")

    def next_request(
        self,
        *,
        timeout_milliseconds: int = CLIPBOARD_AGENT_REQUEST_TIMEOUT_MILLISECONDS,
        quiet_milliseconds: int = CLIPBOARD_AGENT_QUIET_MILLISECONDS,
    ) -> dict[str, Any]:
        sequence = self.sequence
        timeout_milliseconds = as_int(
            timeout_milliseconds, 1, 10000, "clipboard request timeout_milliseconds"
        )
        quiet_milliseconds = as_int(
            quiet_milliseconds, 1, 1000, "clipboard quiet_milliseconds"
        )
        reply = self._exchange(
            f"NEXT {timeout_milliseconds} {quiet_milliseconds}",
            timeout=max(CLIPBOARD_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000.0 + 1.0),
        )
        request_match = self._request_pattern.fullmatch(reply)
        if request_match is not None:
            if int(request_match.group(1)) != sequence:
                self.terminal_error = True
                raise ToolError("private Wayland clipboard transaction returned a mismatched request sequence")
            request_id = int(request_match.group(2))
            pending = int(request_match.group(4))
            if request_id > CLIPBOARD_AGENT_MAX_REQUESTS or pending > CLIPBOARD_AGENT_MAX_REQUESTS:
                self.terminal_error = True
                raise ToolError("private Wayland clipboard transaction exceeded its request bounds")
            self.requests_announced += 1
            self.requests_seen = max(self.requests_seen, request_id)
            self.pending_requests = pending
            return {"kind": "request", "request_id": request_id, "mime": request_match.group(3)}
        quiet_match = self._quiet_pattern.fullmatch(reply)
        if quiet_match is not None:
            if int(quiet_match.group(1)) != sequence:
                self.terminal_error = True
                raise ToolError("private Wayland clipboard transaction returned a mismatched quiet sequence")
            requests = int(quiet_match.group(2))
            transfers = int(quiet_match.group(3))
            transferred_bytes = int(quiet_match.group(4))
            if (
                requests < 1
                or requests > CLIPBOARD_AGENT_MAX_REQUESTS
                or transfers < 1
                or requests != self.requests_announced
                or requests != self.requests_authorized
                or transfers != self.requests_authorized
                or transferred_bytes != transfers * len(self.payload)
            ):
                self.terminal_error = True
                raise ToolError("private Wayland clipboard transaction returned an inconsistent quiet receipt")
            self.requests_seen = requests
            self.transfers_completed = transfers
            self.bytes_transferred = transferred_bytes
            self.pending_requests = 0
            self.quiet_confirmed = True
            return {"kind": "quiet"}
        self.terminal_error = True
        raise ToolError("private Wayland clipboard transaction returned an invalid request receipt")

    def authorize(self, request_id: int) -> None:
        request_id = as_int(request_id, 1, CLIPBOARD_AGENT_MAX_REQUESTS, "clipboard request_id")
        sequence = self.sequence
        reply = self._exchange(f"AUTHORIZE {request_id}")
        match = self._authorize_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence or int(match.group(2)) != request_id:
            self.terminal_error = True
            raise ToolError("private Wayland clipboard transaction returned an invalid authorization receipt")
        payload_bytes = int(match.group(3))
        transfers = int(match.group(4))
        pending = int(match.group(5))
        if (
            payload_bytes != len(self.payload)
            or transfers != self.requests_authorized + 1
            or transfers > CLIPBOARD_AGENT_MAX_REQUESTS
            or pending > CLIPBOARD_AGENT_MAX_REQUESTS
        ):
            self.terminal_error = True
            raise ToolError("private Wayland clipboard transaction reported inconsistent transfer accounting")
        self.requests_authorized += 1
        self.transfers_completed = transfers
        self.bytes_transferred = transfers * len(self.payload)
        self.pending_requests = pending

    def clear(self) -> None:
        if self.clear_confirmed:
            return
        sequence = self.sequence
        reply = self._exchange("CLEAR")
        match = self._clear_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland clipboard transaction returned an invalid clear receipt")
        requests = int(match.group(2))
        transfers = int(match.group(3))
        transferred_bytes = int(match.group(4))
        unexpected_cancel = match.group(5) == "1"
        if (
            unexpected_cancel
            or requests > CLIPBOARD_AGENT_MAX_REQUESTS
            or transfers != self.transfers_completed
            or transferred_bytes != self.bytes_transferred
        ):
            self.terminal_error = True
            raise ToolError("private Wayland clipboard transaction could not prove exclusive selection release")
        self.requests_seen = requests
        self.pending_requests = 0
        self.clear_confirmed = True

    def evidence(self) -> dict[str, Any]:
        if self.scene_launch_ids:
            confidentiality_scope = "exclusive-explicit-scene-set-trust-domain"
            requester_mitigation = (
                "exact-scene-set-must-equal-complete-live-managed-launch-domain-before-"
                "publication-and-each-release"
            )
            scope_kind = "scene-set"
        elif self.launch_id is not None:
            confidentiality_scope = "exclusive-live-launch-trust-domain"
            requester_mitigation = (
                "sole-live-managed-launch-required-before-publication-and-each-release"
            )
            scope_kind = "launch"
        else:
            confidentiality_scope = "workstation"
            requester_mitigation = "none-unscoped"
            scope_kind = "workstation"
        return {
            "transport": "birth-pinned-request-gated-ext-data-control-v1",
            "protocol": CLIPBOARD_AGENT_PROTOCOL,
            "connection_scope": "one-guarded-paste-operation",
            "selection": self.selection,
            "selection_scope": (
                "private-workstation-global-primary"
                if self.selection == "primary"
                else "private-workstation-global-clipboard"
            ),
            "launch_confidentiality_scope": confidentiality_scope,
            "authority_scope": scope_kind,
            "scene_member_count": len(self.scene_launch_ids) if self.scene_launch_ids else None,
            "scene_member_set_sha256": (
                hashlib.sha256(canonical_json(list(self.scene_launch_ids))).hexdigest()
                if self.scene_launch_ids else None
            ),
            "requester_identity_available": False,
            "requester_identity_mitigation": requester_mitigation,
            "payload_profile": self.profile,
            "payload_mime": (
                "image/png" if self.profile == "png" else
                FILE_DROP_MIME if self.profile == "files" else
                "text/plain;charset=utf-8"
            ),
            "payload_storage": "read-only-noexec-sealed-anonymous-memfd",
            "payload_descriptor_authority": "one-independent-O_RDONLY-open-file-description",
            "payload_execute_authority": "permanently-denied-by-MFD_NOEXEC_SEAL+F_SEAL_EXEC",
            "payload_bytes": len(self.payload),
            "payload_in_process_argv": False,
            "payload_in_environment": False,
            "payload_written_to_disk": False,
            "release_policy": (
                "controller-authorize-each-data-request-after-pre-transfer-focus+scope+TickSeal-"
                "checkpoint+post-transfer-focus+scope+TickSeal-proof"
            ),
            "clear_policy": "selected-target-null+Wayland-roundtrip-before-success",
            "registry_cardinality": "exactly-one-seat+one-data-control-manager",
            "helper_process_custody": (
                "parent-death-signal+non-dumpable+no-new-privileges+"
                "exact-inherited-descriptor-inventory+three-distinct-directional-pipes+"
                "zero-regular-file-output"
            ),
            "helper_pid": self.pid,
            "helper_start_ticks": self.start_ticks,
            "manager_version": self.manager_version,
            "requests_seen": self.requests_seen,
            "requests_announced": self.requests_announced,
            "requests_authorized": self.requests_authorized,
            "transfers_completed": self.transfers_completed,
            "bytes_transferred": self.bytes_transferred,
            "pending_requests": self.pending_requests,
            "authorization_checkpoints": self.authorization_checkpoints,
            "post_transfer_checkpoints": self.post_transfer_checkpoints,
            "request_accounting": "seen=announced=authorized=transfers-at-quiet",
            "quiet_confirmed": self.quiet_confirmed,
            "clear_confirmed": self.clear_confirmed,
            "clear_recovery_confirmed": self.clear_recovery_confirmed,
            "shutdown_confirmed": self.shutdown_confirmed,
            "shutdown_error": self.shutdown_error,
            "terminal_error": self.terminal_error,
            "closed": self.closed,
        }

    def _assert_scope(self) -> None:
        if self.scene_launch_ids:
            self.controller._assert_clipboard_scene_exclusive(
                self.scene_id,
                self.scene_launch_ids,
            )
        elif self.launch_id is not None:
            self.controller._assert_clipboard_launch_exclusive(self.launch_id)

    def _terminate(self) -> None:
        process = self.process
        if process is None:
            return
        try:
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=1)
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=1)
        finally:
            for stream in (process.stdin, process.stdout, process.stderr):
                if stream is not None:
                    with contextlib.suppress(Exception):
                        stream.close()

    def _recover_clear(self, reason: str) -> bool:
        self._terminate()
        try:
            clear_arguments = [self.controller.commands["wl-copy"]]
            if self.selection == "primary":
                clear_arguments.append("--primary")
            clear_arguments.append("--clear")
            self.controller._run_controller(
                clear_arguments, timeout=5
            )
        except Exception as error:
            self.shutdown_error = f"{reason}; fallback-clear={type(error).__name__}: {error}"[:512]
            self.controller._quarantine_clipboard(
                "request-gated selection release was ambiguous and fallback clear failed",
                clear_failure=True,
            )
            return False
        self.clear_recovery_confirmed = True
        self.pending_requests = 0
        return True

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            if not self.clear_confirmed:
                if self.terminal_error or not self._exact_alive():
                    raise ToolError("request-gated clipboard transaction ended before selection clear was confirmed")
                self.clear()
            if not self.terminal_error and self._exact_alive():
                sequence = self.sequence
                reply = self._exchange("QUIT")
                match = self._bye_pattern.fullmatch(reply)
                if match is None or int(match.group(1)) != sequence:
                    self.terminal_error = True
                    raise ToolError("private Wayland clipboard transaction returned an invalid shutdown receipt")
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
            if not self.clear_confirmed and not self._recover_clear(str(error)):
                close_error = ToolError(
                    "clipboard escrow failed and selection release could not be confirmed; "
                    "clipboard publication is quarantined until desktop restart"
                )
        finally:
            self._terminate()
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_clipboard_transaction", None) is self:
                self.controller._active_clipboard_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandClipboardTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception as close_error:
            # A failed selection clear is more security-significant than the
            # original action error: callers must learn that clipboard
            # publication is now quarantined rather than seeing only a focus or
            # timeout failure that happened first. Ordinary shutdown errors do
            # not mask an existing action error once clear was confirmed.
            if exc is None or getattr(self.controller, "clipboard_quarantined", False):
                if exc is not None:
                    raise close_error from exc
                raise
        return False


class WaylandDropTransaction:
    """One request-gated compositor-native Wayland drag source."""

    _ready = re.compile(
        rf"READY {re.escape(DROP_AGENT_PROTOCOL)} MANAGER ([3-9]|[1-9][0-9]+) "
        rf"SEATS 1 COMPOSITOR 1 SHM 1 LAYER 1 PROFILE (text|png|files) "
        rf"PAYLOAD ([0-9]{{1,8}}) EXECSEALED 1 CORNER (tl|tr|bl|br) "
        rf"ORIGIN ([0-9]{{1,4}}) ([0-9]{{1,4}}) SIZE {DROP_AGENT_ORIGIN_SIZE}"
    )
    _error = re.compile(
        r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) STARTED ([01]) "
        r"TARGET ([01]) ACTION ([0-9]+) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
        r"PENDING ([0-9]+) DROPPED ([01]) FINISHED ([01]) CANCELLED ([01])"
    )

    def __init__(
        self,
        controller: Any,
        payload: bytes,
        purpose: str,
        launch_id: str | None,
        *,
        profile: str,
        corner: str,
        scene_id: str | None = None,
        scene_launch_ids: tuple[str, ...] = (),
    ) -> None:
        if profile not in {"text", "png", "files"} or corner not in {"tl", "tr", "bl", "br"}:
            raise ToolError("DropSeal profile or origin corner is invalid")
        if not isinstance(payload, bytes):
            raise ToolError("DropSeal payload must be immutable bytes")
        self.controller = controller
        self.payload = payload
        self.purpose = purpose
        self.launch_id = launch_id
        self.scene_id = scene_id
        self.scene_launch_ids = tuple(sorted(scene_launch_ids))
        if launch_id is not None and self.scene_launch_ids:
            raise ToolError("DropSeal cannot mix launch and scene-set scope")
        if self.scene_launch_ids:
            if scene_id is None or not 2 <= len(self.scene_launch_ids) <= SCENE_SET_MAX_LAUNCHES:
                raise ToolError("DropSeal scene-set scope is invalid")
            if len(set(self.scene_launch_ids)) != len(self.scene_launch_ids):
                raise ToolError("DropSeal scene-set membership contains duplicates")
        elif scene_id is not None:
            raise ToolError("DropSeal scene_id requires exact member identities")
        self.profile = profile
        self.corner = corner
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.manager_version: int | None = None
        self.origin: tuple[int, int] | None = None
        self.ready = False
        self.closed = False
        self.terminal_error = False
        self.started = False
        self.target_valid = False
        self.target_mime: str | None = None
        self.selected_action = 0
        self.target_generation = 0
        self.drop_performed = False
        self.finished = False
        self.cancelled = False
        self.requests_seen = 0
        self.requests_announced = 0
        self.requests_authorized = 0
        self.transfers_completed = 0
        self.bytes_transferred = 0
        self.pending_requests = 0
        self.authorization_checkpoints = 0
        self.post_transfer_checkpoints = 0
        self.target_revalidation_checkpoints = 0
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self._announced_request_ids: set[int] = set()
        self._authorized_request_ids: set[int] = set()
        self._request_generations: dict[int, int] = {}
        self._stdout_buffer = bytearray()
        self._start()

    def _assert_scope(self) -> None:
        if self.scene_launch_ids:
            self.controller._assert_clipboard_scene_exclusive(self.scene_id, self.scene_launch_ids)
        elif self.launch_id is not None:
            self.controller._assert_clipboard_launch_exclusive(self.launch_id)

    def _exact_alive(self) -> bool:
        return (
            self.pid is not None
            and self.start_ticks is not None
            and exact_process_alive(self.pid, self.start_ticks)
        )

    def _diagnostic(self) -> str:
        if self.process is None or self.process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = self.process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
                break
            try:
                chunk = os.read(descriptor, min(512, 2048 - len(chunks)))
            except OSError:
                break
            if not chunk:
                break
            chunks.extend(chunk)
        return bytes(chunks).decode("utf-8", "replace").strip()

    def _read_line(self, timeout: float) -> str:
        if self.process is None or self.process.stdout is None:
            raise ToolError("DropSeal has no response channel")
        deadline = time.monotonic() + timeout
        descriptor = self.process.stdout.fileno()
        while b"\n" not in self._stdout_buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ToolError("DropSeal response timed out")
            readable, _, _ = select.select([descriptor], [], [], remaining)
            if not readable:
                raise ToolError("DropSeal response timed out")
            chunk = os.read(descriptor, DROP_AGENT_MAX_REPLY_BYTES + 1)
            if not chunk:
                diagnostic = self._diagnostic()
                raise ToolError(
                    "DropSeal helper exited before replying" + (f": {diagnostic}" if diagnostic else "")
                )
            self._stdout_buffer.extend(chunk)
            if len(self._stdout_buffer) > DROP_AGENT_MAX_REPLY_BYTES:
                raise ToolError("DropSeal returned an oversized reply")
        raw, _, remainder = self._stdout_buffer.partition(b"\n")
        self._stdout_buffer = bytearray(remainder)
        try:
            return raw.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("DropSeal returned a non-ASCII reply") from error

    def _write_line(self, value: str) -> None:
        if self.process is None or self.process.stdin is None:
            raise ToolError("DropSeal has no command channel")
        payload = value.encode("ascii", "strict")
        offset = 0
        while offset < len(payload):
            written = os.write(self.process.stdin.fileno(), payload[offset:])
            if written <= 0:
                raise ToolError("DropSeal command channel closed")
            offset += written

    def _start(self) -> None:
        self.controller._require_pointer_healthy()
        self.controller._require_clipboard_healthy()
        if getattr(self.controller, "_active_drop_transaction", None) is not None:
            raise ToolError("another DropSeal transaction is already active")
        self._assert_scope()
        helper = getattr(self.controller, "drop_agent", None)
        if not isinstance(helper, Path):
            raise ToolError("private Wayland DropSeal helper is unavailable")
        descriptor = WaylandClipboardTransaction._sealed_payload(self.payload)
        try:
            process = subprocess.Popen(
                [
                    os.fspath(helper), self.profile, str(descriptor), str(len(self.payload)),
                    self.corner, str(self.controller.width), str(self.controller.height),
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=self.controller._controller_environment(),
                pass_fds=(descriptor,),
                start_new_session=True,
                close_fds=True,
                bufsize=0,
            )
        except OSError as error:
            raise ToolError(f"DropSeal helper could not start: {error}") from error
        finally:
            with contextlib.suppress(OSError):
                os.close(descriptor)
        self.process = process
        self.pid = process.pid
        identity = None
        for _ in range(100):
            identity = proc_identity(process.pid)
            if identity is not None or process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            self._terminate()
            raise ToolError(
                "DropSeal helper exited before custody was established" +
                (f": {diagnostic}" if diagnostic else "")
            )
        self.start_ticks = int(identity["start_ticks"])
        try:
            match = self._ready.fullmatch(self._read_line(DROP_AGENT_READY_TIMEOUT_SECONDS))
            if (
                match is None
                or match.group(2) != self.profile
                or int(match.group(3)) != len(self.payload)
                or match.group(4) != self.corner
                or not self._exact_alive()
            ):
                raise ToolError("DropSeal readiness receipt is invalid")
            self.manager_version = int(match.group(1))
            origin = (int(match.group(5)), int(match.group(6)))
            if not (0 <= origin[0] < self.controller.width and 0 <= origin[1] < self.controller.height):
                raise ToolError("DropSeal origin lies outside the private output")
            self.origin = origin
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.controller._active_drop_transaction = self

    def _exchange(self, command: str, timeout: float = DROP_AGENT_COMMAND_TIMEOUT_SECONDS) -> str:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("DropSeal lost its birth-pinned helper")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        try:
            reply = self._read_line(timeout)
        except Exception:
            self.terminal_error = True
            raise
        error = self._error.fullmatch(reply)
        if error is not None:
            if int(error.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched error sequence")
            self.started = error.group(3) == "1"
            self.target_valid = error.group(4) == "1"
            self.selected_action = int(error.group(5))
            self.requests_seen = int(error.group(6))
            self.transfers_completed = int(error.group(7))
            self.pending_requests = int(error.group(8))
            self.drop_performed = error.group(9) == "1"
            self.finished = error.group(10) == "1"
            self.cancelled = error.group(11) == "1"
            self.terminal_error = True
            raise ToolError(f"DropSeal rejected {command.split()[0]}: {error.group(2)}")
        self.sequence += 1
        return reply

    def wait_origin(self, timeout_milliseconds: int = DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS) -> None:
        timeout_milliseconds = as_int(timeout_milliseconds, 1, 10000, "DropSeal origin timeout")
        sequence = self.sequence
        reply = self._exchange(
            f"ORIGIN {timeout_milliseconds}",
            max(DROP_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000 + 1),
        )
        match = re.fullmatch(
            r"ORIGIN ([1-9][0-9]*) POINTER 1 ENTERED 1 ORIGIN ([0-9]+) ([0-9]+)", reply
        )
        if match is None or int(match.group(1)) != sequence or self.origin != (
            int(match.group(2)), int(match.group(3))
        ):
            raise ToolError("virtual pointer did not enter the exact DropSeal origin")

    def arm(self) -> None:
        if self.origin is None:
            raise ToolError("DropSeal has no attested origin")
        sequence = self.sequence
        if self._exchange("ARM") != f"ARMED {sequence} ORIGIN {self.origin[0]} {self.origin[1]}":
            raise ToolError("DropSeal returned an invalid arm receipt")

    def wait_started(self, timeout_milliseconds: int = DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS) -> None:
        timeout_milliseconds = as_int(timeout_milliseconds, 1, 10000, "DropSeal start timeout")
        sequence = self.sequence
        reply = self._exchange(
            f"STARTED {timeout_milliseconds}",
            max(DROP_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000 + 1),
        )
        match = re.fullmatch(r"STARTED ([1-9][0-9]*) STARTED 1 SERIAL ([1-9][0-9]*)", reply)
        if match is None or int(match.group(1)) != sequence:
            raise ToolError("compositor did not acknowledge native DropSeal start_drag")
        self.started = True

    def wait_target(self, timeout_milliseconds: int = DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS) -> None:
        timeout_milliseconds = as_int(timeout_milliseconds, 1, 10000, "DropSeal target timeout")
        sequence = self.sequence
        reply = self._exchange(
            f"TARGET {timeout_milliseconds}",
            max(DROP_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000 + 1),
        )
        match = re.fullmatch(
            r"TARGET ([1-9][0-9]*) MIME "
            r"(text/plain;charset=utf-8|text/plain|UTF8_STRING|STRING|image/png|text/uri-list) "
            r"ACTION 1 GENERATION ([1-9][0-9]*)",
            reply,
        )
        if match is None or int(match.group(1)) != sequence:
            raise ToolError("native target did not accept DropSeal's MIME with copy action")
        self.target_mime = match.group(2)
        self.selected_action = DROP_AGENT_COPY_ACTION
        self.target_generation = int(match.group(3))
        self.target_valid = True

    def ping(self) -> None:
        sequence = self.sequence
        reply = self._exchange("PING")
        match = re.fullmatch(
            r"PONG ([1-9][0-9]*) POINTER ([01]) ENTERED ([01]) STARTED ([01]) "
            r"TARGET ([01]) ACTION ([0-9]+) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
            r"PENDING ([0-9]+) DROPPED ([01]) FINISHED ([01]) CANCELLED ([01])",
            reply,
        )
        if match is None or int(match.group(1)) != sequence:
            raise ToolError("DropSeal returned an invalid ping receipt")
        self.started = match.group(4) == "1"
        self.target_valid = match.group(5) == "1"
        self.selected_action = int(match.group(6))
        self.requests_seen = int(match.group(7))
        self.transfers_completed = int(match.group(8))
        self.pending_requests = int(match.group(9))
        self.drop_performed = match.group(10) == "1"
        self.finished = match.group(11) == "1"
        self.cancelled = match.group(12) == "1"

    def next_event(self, timeout_milliseconds: int = DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS) -> dict[str, Any]:
        timeout_milliseconds = as_int(timeout_milliseconds, 1, 10000, "DropSeal event timeout")
        sequence = self.sequence
        reply = self._exchange(
            f"NEXT {timeout_milliseconds}",
            max(DROP_AGENT_COMMAND_TIMEOUT_SECONDS, timeout_milliseconds / 1000 + 1),
        )
        request = re.fullmatch(
            r"REQUEST ([1-9][0-9]*) ID ([1-9][0-9]*) MIME "
            r"(text/plain;charset=utf-8|text/plain|UTF8_STRING|STRING|image/png|text/uri-list) "
            r"GENERATION ([1-9][0-9]*) PENDING ([1-9][0-9]*) TARGET 1 ACTION 1",
            reply,
        )
        if request is not None:
            if int(request.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched request")
            request_id = int(request.group(2))
            request_mime = request.group(3)
            request_generation = int(request.group(4))
            allowed_mimes = (
                {"image/png"}
                if self.profile == "png"
                else {FILE_DROP_MIME}
                if self.profile == "files"
                else {"text/plain;charset=utf-8", "text/plain", "UTF8_STRING", "STRING"}
            )
            if request_mime not in allowed_mimes:
                raise ToolError("DropSeal target requested a MIME outside the sealed payload profile")
            if request_id != self.requests_announced + 1 or request_id in self._announced_request_ids:
                raise ToolError("DropSeal request identifiers are not unique and monotonic")
            if request_generation != self.target_generation:
                raise ToolError("DropSeal request is not bound to the controller-observed target generation")
            self._announced_request_ids.add(request_id)
            self._request_generations[request_id] = request_generation
            self.requests_seen = max(self.requests_seen, request_id)
            self.requests_announced += 1
            self.pending_requests = int(request.group(5))
            if request_id > DROP_AGENT_MAX_REQUESTS or self.pending_requests > DROP_AGENT_MAX_REQUESTS:
                raise ToolError("DropSeal exceeded its request bound")
            if self.pending_requests < self.requests_announced - self.requests_authorized:
                raise ToolError("DropSeal pending-request accounting regressed")
            return {
                "kind": "request",
                "request_id": request_id,
                "mime": request_mime,
                "target_generation": request_generation,
            }
        target = re.fullmatch(
            r"TARGET ([1-9][0-9]*) MIME "
            r"(none|text/plain;charset=utf-8|text/plain|UTF8_STRING|STRING|image/png|text/uri-list) "
            r"ACTION ([0-9]+) GENERATION ([1-9][0-9]*)", reply,
        )
        if target is not None:
            if int(target.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched target event")
            self.target_mime = None if target.group(2) == "none" else target.group(2)
            self.selected_action = int(target.group(3))
            generation = int(target.group(4))
            if generation <= self.target_generation:
                raise ToolError("DropSeal target generations are not strictly monotonic")
            self.target_generation = generation
            self.target_valid = self.target_mime is not None and self.selected_action == 1
            return {
                "kind": "target",
                "valid": self.target_valid,
                "target_generation": self.target_generation,
            }
        dropped = re.fullmatch(
            r"DROPPED ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) PENDING ([0-9]+)", reply
        )
        if dropped is not None:
            if int(dropped.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched drop event")
            requests = int(dropped.group(2))
            transfers = int(dropped.group(3))
            pending = int(dropped.group(4))
            if (
                self.drop_performed
                or requests != self.requests_seen
                or transfers != self.transfers_completed
                or pending != self.pending_requests
            ):
                raise ToolError("DropSeal returned inconsistent drop accounting")
            self.drop_performed = True
            return {"kind": "dropped"}
        finished = re.fullmatch(
            r"FINISHED ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
            r"BYTES ([0-9]+) PENDING ([0-9]+)", reply,
        )
        if finished is not None:
            if int(finished.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched finish event")
            self.requests_seen = int(finished.group(2))
            self.transfers_completed = int(finished.group(3))
            self.bytes_transferred = int(finished.group(4))
            self.pending_requests = int(finished.group(5))
            self.finished = True
            if (
                not self.started
                or not self.target_valid
                or not self.drop_performed
                or self.cancelled
                or self.requests_seen < 1
                or self.requests_seen != self.requests_announced
                or self.requests_announced != self.requests_authorized
                or self._announced_request_ids != self._authorized_request_ids
                or self.transfers_completed != self.requests_authorized
                or self.bytes_transferred != self.transfers_completed * len(self.payload)
                or self.pending_requests != 0
            ):
                raise ToolError("DropSeal returned inconsistent finish accounting")
            return {"kind": "finished"}
        cancelled = re.fullmatch(
            r"CANCELLED ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) PENDING ([0-9]+)", reply
        )
        if cancelled is not None:
            if int(cancelled.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched cancellation event")
            self.requests_seen = int(cancelled.group(2))
            self.transfers_completed = int(cancelled.group(3))
            self.pending_requests = int(cancelled.group(4))
            self.cancelled = True
            return {"kind": "cancelled"}
        timeout = re.fullmatch(
            r"TIMEOUT ([1-9][0-9]*) REQUESTS ([0-9]+) TRANSFERS ([0-9]+) "
            r"PENDING ([0-9]+) DROPPED ([01]) FINISHED ([01]) CANCELLED ([01])",
            reply,
        )
        if timeout is not None:
            if int(timeout.group(1)) != sequence:
                raise ToolError("DropSeal returned a mismatched event timeout")
            self.requests_seen = int(timeout.group(2))
            self.transfers_completed = int(timeout.group(3))
            self.pending_requests = int(timeout.group(4))
            self.drop_performed = timeout.group(5) == "1"
            self.finished = timeout.group(6) == "1"
            self.cancelled = timeout.group(7) == "1"
            return {"kind": "timeout"}
        raise ToolError("DropSeal returned an invalid event receipt")

    def authorize(self, request_id: int) -> None:
        request_id = as_int(request_id, 1, DROP_AGENT_MAX_REQUESTS, "DropSeal request_id")
        if request_id not in self._announced_request_ids:
            raise ToolError("DropSeal cannot authorize an unannounced request")
        if request_id in self._authorized_request_ids:
            raise ToolError("DropSeal request was already authorized")
        request_generation = self._request_generations.get(request_id)
        if request_generation is None or request_generation != self.target_generation:
            raise ToolError("DropSeal request lost its exact target-generation binding")
        sequence = self.sequence
        reply = self._exchange(f"AUTHORIZE {request_id} {request_generation}")
        match = re.fullmatch(
            r"AUTHORIZED ([1-9][0-9]*) ID ([1-9][0-9]*) GENERATION ([1-9][0-9]*) "
            r"BYTES ([0-9]+) TRANSFERS ([1-9][0-9]*) PENDING ([0-9]+)", reply,
        )
        if (
            match is None
            or int(match.group(1)) != sequence
            or int(match.group(2)) != request_id
            or int(match.group(3)) != request_generation
        ):
            raise ToolError("DropSeal returned an invalid authorization receipt")
        transfers = int(match.group(5))
        if int(match.group(4)) != len(self.payload) or transfers != self.requests_authorized + 1:
            raise ToolError("DropSeal transfer accounting changed")
        self._authorized_request_ids.add(request_id)
        self.requests_authorized += 1
        self.transfers_completed = transfers
        self.bytes_transferred = transfers * len(self.payload)
        self.pending_requests = int(match.group(6))

    def evidence(self) -> dict[str, Any]:
        return {
            "transport": "birth-pinned-request-gated-wl-data-device-dnd",
            "protocol": DROP_AGENT_PROTOCOL,
            "connection_scope": "one-guarded-native-drop",
            "authority_scope": "scene-set" if self.scene_launch_ids else "launch" if self.launch_id else "workstation",
            "scene_member_count": len(self.scene_launch_ids) if self.scene_launch_ids else None,
            "payload_profile": self.profile,
            "payload_mime": (
                "image/png" if self.profile == "png"
                else FILE_DROP_MIME if self.profile == "files"
                else "text/plain;charset=utf-8"
            ),
            "payload_storage": "read-only-noexec-sealed-anonymous-memfd",
            "payload_bytes": len(self.payload),
            "payload_in_process_argv": False,
            "payload_in_environment": False,
            "payload_written_to_disk": False,
            "referenced_snapshots_written_to_disk": self.profile == "files",
            "referenced_snapshot_scope": (
                "exact-launch-read-only-capsule" if self.profile == "files" else None
            ),
            "origin_surface": "transparent-8x8-layer-shell-overlay",
            "origin_corner": self.corner,
            "origin": list(self.origin) if self.origin else None,
            "drag_serial": "wl-pointer-button-implicit-grab-on-exact-origin-surface",
            "drag_started": self.started,
            "target_mime": self.target_mime,
            "selected_action": self.selected_action,
            "target_generation": self.target_generation,
            "copy_action_only": self.selected_action in {0, 1},
            "drop_performed": self.drop_performed,
            "finished": self.finished,
            "cancelled": self.cancelled,
            "requests_seen": self.requests_seen,
            "requests_announced": self.requests_announced,
            "requests_authorized": self.requests_authorized,
            "transfers_completed": self.transfers_completed,
            "bytes_transferred": self.bytes_transferred,
            "pending_requests": self.pending_requests,
            "authorization_checkpoints": self.authorization_checkpoints,
            "post_transfer_checkpoints": self.post_transfer_checkpoints,
            "target_revalidation_checkpoints": self.target_revalidation_checkpoints,
            "preemptive_receive_policy": "preaccept-request-closed-empty;accepted-request-retained-empty-until-authorization",
            "authorization_freshness": "request-generation+controller-observed-generation+helper-compositor-roundtrip",
            "descriptor_ceiling": 64,
            "helper_pid": self.pid,
            "helper_start_ticks": self.start_ticks,
            "manager_version": self.manager_version,
            "shutdown_confirmed": self.shutdown_confirmed,
            "shutdown_error": self.shutdown_error,
            "terminal_error": self.terminal_error,
            "closed": self.closed,
        }

    def _terminate(self) -> None:
        if self.process is None:
            return
        try:
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                self.process.wait(timeout=1)
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    self.process.wait(timeout=1)
        finally:
            for stream in (self.process.stdin, self.process.stdout, self.process.stderr):
                if stream is not None:
                    with contextlib.suppress(Exception):
                        stream.close()

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            if not self.terminal_error and self._exact_alive():
                sequence = self.sequence
                reply = self._exchange("QUIT")
                if re.fullmatch(
                    rf"BYE {sequence} STARTED [01] REQUESTS [0-9]+ TRANSFERS [0-9]+ "
                    r"BYTES [0-9]+ PENDING [0-9]+ FINISHED [01] CANCELLED [01]",
                    reply,
                ) is None:
                    raise ToolError("DropSeal returned an invalid shutdown receipt")
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
        finally:
            self._terminate()
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_drop_transaction", None) is self:
                self.controller._active_drop_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandDropTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception:
            if exc is None:
                raise
        return False


class WaylandSelectionCaptureTransaction:
    """One request-gated RichCopySeal capture of a new Wayland selection.

    A launch-fixed profile accepts bounded UTF-8 text, exactly ``image/png``, or
    one bounded ``text/uri-list``. The helper clears stale clipboard state, arms one monotonic
    selection generation, and reports only bounded offer metadata. It does not
    request bytes until the controller has revalidated focus, launch/scene
    custody, and TickSeal event order after the guarded native copy chord.
    Payload crosses one dedicated anonymous pipe, is never written to disk or
    diagnostic streams, and is followed by a compositor-roundtrip-confirmed
    selection clear. PNG is structurally prevalidated by the helper and fully
    decoded/canonicalized by the controller only after that clear. File URI
    lists are syntax-prevalidated by the helper and admitted only after clear
    against one exact launch-private output root. Ambiguous
    clear state quarantines further clipboard transactions until restart.
    """

    _ready_pattern = re.compile(
        rf"READY {re.escape(SELECTION_AGENT_PROTOCOL)} PROFILE (text|png|files) "
        r"MANAGER ([1-9][0-9]*) SEATS 1 MAX ([1-9][0-9]{0,8}) CLEARED 1"
    )
    _armed_pattern = re.compile(
        r"ARMED ([1-9][0-9]*) GENERATION ([1-9][0-9]*) CLEARED 1"
    )
    _offer_pattern = re.compile(
        r"OFFER ([1-9][0-9]*) ID ([1-9][0-9]*) MIME "
        r"(text/plain;charset=utf-8|text/plain|UTF8_STRING|image/png|text/uri-list) GENERATION ([1-9][0-9]*)"
    )
    _capture_pattern = re.compile(
        r"CAPTURED ([1-9][0-9]*) ID ([1-9][0-9]*) MIME "
        r"(text/plain;charset=utf-8|text/plain|UTF8_STRING|image/png|text/uri-list) BYTES ([0-9]+)"
    )
    _clear_pattern = re.compile(
        r"CLEARED ([1-9][0-9]*) OFFERS ([0-9]+) GENERATION ([1-9][0-9]*) BYTES ([0-9]+)"
    )
    _bye_pattern = re.compile(
        r"BYE ([1-9][0-9]*) CAPTURED ([01]) BYTES ([0-9]+) CLEARED 1"
    )
    _error_pattern = re.compile(
        r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) OFFERS ([0-9]+) "
        r"GENERATION ([0-9]+) CAPTURED ([01]) CLEARED ([01])"
    )

    def __init__(
        self,
        controller: Any,
        purpose: str,
        launch_id: str | None,
        *,
        scene_id: str | None = None,
        scene_launch_ids: tuple[str, ...] = (),
        profile: str = "text",
        maximum_bytes: int | None = None,
    ) -> None:
        self.controller = controller
        self.purpose = purpose
        self.launch_id = launch_id
        self.scene_id = scene_id
        self.scene_launch_ids = tuple(sorted(scene_launch_ids))
        if self.launch_id is not None and self.scene_launch_ids:
            raise ToolError("selection capture cannot mix launch and scene-set scope")
        if self.scene_launch_ids:
            if self.scene_id is None:
                raise ToolError("scene-set selection capture requires scene_id")
            if not 2 <= len(self.scene_launch_ids) <= SCENE_SET_MAX_LAUNCHES:
                raise ToolError("scene-set selection capture member count is invalid")
            if len(set(self.scene_launch_ids)) != len(self.scene_launch_ids):
                raise ToolError("scene-set selection capture membership contains duplicates")
            if any(
                re.fullmatch(r"launch-[0-9a-f]{24}", value) is None
                for value in self.scene_launch_ids
            ):
                raise ToolError("scene-set selection capture membership is malformed")
        elif self.scene_id is not None:
            raise ToolError("scene-set selection capture requires exact launch membership")
        if profile not in {"text", "png", "files"}:
            raise ToolError("selection capture profile must be text, png, or files")
        if profile == "files" and (
            self.launch_id is None or self.scene_id is not None or self.scene_launch_ids
        ):
            raise ToolError(
                "file selection capture requires one exact launch and denies scene/workstation scope"
            )
        self.profile = profile
        profile_maximum = (
            MAX_TEXT_BYTES if profile == "text"
            else MAX_PNG_PAYLOAD_BYTES if profile == "png"
            else MAX_FILE_COPY_URI_LIST_BYTES
        )
        profile_minimum = MIN_PNG_PAYLOAD_BYTES if profile == "png" else 1
        requested_maximum = profile_maximum if maximum_bytes is None else maximum_bytes
        self.maximum_bytes = as_int(
            requested_maximum,
            profile_minimum,
            profile_maximum,
            "selection maximum_bytes",
        )
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.manager_version: int | None = None
        self.ready = False
        self.closed = False
        self.terminal_error = False
        self.armed = False
        self.armed_generation: int | None = None
        self.offer_id: int | None = None
        self.offer_generation: int | None = None
        self.mime: str | None = None
        self.capture_complete = False
        self.captured_bytes = 0
        self.clear_confirmed = False
        self.clear_recovery_confirmed = False
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self.offers_seen = 0
        self.selection_generation = 0
        self.authorization_checkpoints = 0
        self.post_transfer_checkpoints = 0
        self._stdout_buffer = bytearray()
        self._payload_descriptor: int | None = None
        self._start()

    def _diagnostic(self) -> str:
        process = self.process
        if process is None or process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
                break
            try:
                chunk = os.read(descriptor, min(2048 - len(chunks), 512))
            except OSError:
                break
            if not chunk:
                break
            chunks.extend(chunk)
        return bytes(chunks).decode("utf-8", "replace").strip()

    def _exact_alive(self) -> bool:
        return (
            self.pid is not None
            and self.start_ticks is not None
            and exact_process_alive(self.pid, self.start_ticks)
        )

    def _read_line(self, timeout: float) -> str:
        process = self.process
        if process is None or process.stdout is None:
            raise ToolError("private Wayland selection capture has no response channel")
        deadline = time.monotonic() + timeout
        descriptor = process.stdout.fileno()
        while b"\n" not in self._stdout_buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ToolError("private Wayland selection capture response timed out")
            try:
                readable, _, _ = select.select([descriptor], [], [], remaining)
            except (OSError, ValueError) as error:
                raise ToolError(f"private Wayland selection capture response failed: {error}") from error
            if not readable:
                raise ToolError("private Wayland selection capture response timed out")
            try:
                chunk = os.read(descriptor, SELECTION_AGENT_MAX_REPLY_BYTES + 1)
            except OSError as error:
                raise ToolError(f"private Wayland selection capture response failed: {error}") from error
            if not chunk:
                diagnostic = self._diagnostic()
                suffix = f": {diagnostic}" if diagnostic else ""
                raise ToolError(f"private Wayland selection capture exited before replying{suffix}")
            self._stdout_buffer.extend(chunk)
            if len(self._stdout_buffer) > SELECTION_AGENT_MAX_REPLY_BYTES:
                raise ToolError("private Wayland selection capture returned an oversized reply")
        raw, _, remainder = self._stdout_buffer.partition(b"\n")
        self._stdout_buffer = bytearray(remainder)
        try:
            return raw.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("private Wayland selection capture returned a non-ASCII reply") from error

    def _write_line(self, value: str) -> None:
        process = self.process
        if process is None or process.stdin is None:
            raise ToolError("private Wayland selection capture has no command channel")
        payload = value.encode("ascii", "strict")
        descriptor = process.stdin.fileno()
        offset = 0
        try:
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written <= 0:
                    raise BrokenPipeError("zero-length write")
                offset += written
        except (BrokenPipeError, OSError) as error:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland selection capture command failed{suffix}") from error

    def _start(self) -> None:
        self.controller._require_clipboard_healthy()
        if getattr(self.controller, "_active_clipboard_transaction", None) is not None:
            raise ToolError("another private Wayland clipboard transaction is already active")
        self._assert_scope()
        helper = getattr(self.controller, "selection_agent", None)
        if not isinstance(helper, Path):
            raise ToolError("private Wayland selection capture helper is unavailable")
        try:
            output_read, output_write = os.pipe2(os.O_CLOEXEC)
        except AttributeError:
            output_read, output_write = os.pipe()
            for descriptor in (output_read, output_write):
                flags = fcntl.fcntl(descriptor, fcntl.F_GETFD)
                fcntl.fcntl(descriptor, fcntl.F_SETFD, flags | fcntl.FD_CLOEXEC)
        try:
            flags = fcntl.fcntl(output_read, fcntl.F_GETFL)
            fcntl.fcntl(output_read, fcntl.F_SETFL, flags | os.O_NONBLOCK)
            process = subprocess.Popen(
                [
                    os.fspath(helper),
                    self.profile,
                    str(output_write),
                    str(self.maximum_bytes),
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=self.controller._controller_environment(),
                pass_fds=(output_write,),
                start_new_session=True,
                close_fds=True,
                bufsize=0,
            )
        except OSError as error:
            with contextlib.suppress(OSError):
                os.close(output_read)
            with contextlib.suppress(OSError):
                os.close(output_write)
            raise ToolError(f"private Wayland selection capture could not start: {error}") from error
        finally:
            with contextlib.suppress(OSError):
                os.close(output_write)
        self._payload_descriptor = output_read
        self.process = process
        self.pid = process.pid
        identity = None
        for _ in range(100):
            identity = proc_identity(process.pid)
            if identity is not None:
                break
            if process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            self._terminate()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland selection capture exited before custody was established{suffix}")
        self.start_ticks = int(identity["start_ticks"])
        try:
            ready = self._read_line(SELECTION_AGENT_READY_TIMEOUT_SECONDS)
            match = self._ready_pattern.fullmatch(ready)
            if (
                match is None
                or match.group(1) != self.profile
                or int(match.group(3)) != self.maximum_bytes
                or not self._exact_alive()
            ):
                raise ToolError("private Wayland selection capture readiness receipt is invalid")
            self.manager_version = int(match.group(2))
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.clear_confirmed = False
        self.controller._active_clipboard_transaction = self

    def _record_error(self, reply: str, sequence: int, command: str) -> None:
        match = self._error_pattern.fullmatch(reply)
        if match is None:
            return
        if int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned a mismatched error sequence")
        self.offers_seen = int(match.group(3))
        self.selection_generation = int(match.group(4))
        self.capture_complete = match.group(5) == "1"
        self.clear_confirmed = match.group(6) == "1"
        self.terminal_error = True
        raise ToolError(
            f"private Wayland selection capture rejected {command.split()[0]}: {match.group(2)}"
        )

    def _exchange(self, command: str, timeout: float = SELECTION_AGENT_COMMAND_TIMEOUT_SECONDS) -> str:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland selection capture lost its birth-pinned helper")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        try:
            reply = self._read_line(timeout)
        except Exception:
            self.terminal_error = True
            raise
        self._record_error(reply, sequence, command)
        self.sequence += 1
        return reply

    def ping(self) -> None:
        sequence = self.sequence
        reply = self._exchange("PING")
        if reply != f"PONG {sequence}":
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned an invalid ping receipt")

    def arm(self) -> None:
        if self.armed:
            raise ToolError("private Wayland selection capture is already armed")
        sequence = self.sequence
        reply = self._exchange("ARM")
        match = self._armed_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned an invalid arm receipt")
        generation = int(match.group(2))
        if generation < 1:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned an invalid arm generation")
        self.armed_generation = generation
        self.selection_generation = generation
        self.armed = True

    def next_offer(
        self,
        *,
        timeout_milliseconds: int = SELECTION_AGENT_CAPTURE_TIMEOUT_MILLISECONDS,
        quiet_milliseconds: int = SELECTION_AGENT_QUIET_MILLISECONDS,
    ) -> dict[str, Any]:
        if not self.armed or self.offer_id is not None:
            raise ToolError("private Wayland selection capture is not waiting for a new offer")
        timeout_milliseconds = as_int(
            timeout_milliseconds, 100, 10000, "selection timeout_milliseconds"
        )
        quiet_milliseconds = as_int(
            quiet_milliseconds, 1, 1000, "selection quiet_milliseconds"
        )
        sequence = self.sequence
        reply = self._exchange(
            f"NEXT {timeout_milliseconds} {quiet_milliseconds}",
            timeout=max(
                SELECTION_AGENT_COMMAND_TIMEOUT_SECONDS,
                timeout_milliseconds / 1000.0 + 1.0,
            ),
        )
        match = self._offer_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned an invalid offer receipt")
        offer_id = int(match.group(2))
        generation = int(match.group(4))
        if self.armed_generation is None or generation <= self.armed_generation:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture did not prove a post-arm offer generation")
        offered_mime = match.group(3)
        if self.profile == "png":
            if offered_mime != "image/png":
                self.terminal_error = True
                raise ToolError("private Wayland selection capture retained a MIME outside its PNG profile")
        elif self.profile == "files":
            if offered_mime != FILE_DROP_MIME:
                self.terminal_error = True
                raise ToolError("private Wayland selection capture retained a MIME outside its files profile")
        elif offered_mime not in {
            "text/plain;charset=utf-8", "text/plain", "UTF8_STRING"
        }:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture retained a MIME outside its text profile")
        self.offer_id = offer_id
        self.mime = offered_mime
        self.offer_generation = generation
        self.selection_generation = generation
        return {
            "offer_id": offer_id,
            "mime": self.mime,
            "generation": generation,
        }

    def _capture_reply_and_payload(self, command: str, timeout: float) -> tuple[str, bytes]:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland selection capture lost its birth-pinned helper")
        process = self.process
        payload_descriptor = self._payload_descriptor
        if process is None or process.stdout is None or payload_descriptor is None:
            raise ToolError("private Wayland selection capture has no payload channel")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        stdout_descriptor = process.stdout.fileno()
        deadline = time.monotonic() + timeout
        payload = bytearray()
        payload_eof = False
        reply: str | None = None
        try:
            while reply is None or not payload_eof:
                if reply is None and b"\n" in self._stdout_buffer:
                    raw, _, remainder = self._stdout_buffer.partition(b"\n")
                    self._stdout_buffer = bytearray(remainder)
                    try:
                        reply = raw.decode("ascii", "strict")
                    except UnicodeDecodeError as error:
                        raise ToolError(
                            "private Wayland selection capture returned a non-ASCII reply"
                        ) from error
                    continue
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise ToolError("private Wayland selection payload transfer timed out")
                readers: list[int] = []
                if reply is None:
                    readers.append(stdout_descriptor)
                if not payload_eof:
                    readers.append(payload_descriptor)
                try:
                    readable, _, _ = select.select(readers, [], [], remaining)
                except (OSError, ValueError) as error:
                    raise ToolError(
                        f"private Wayland selection payload transfer failed: {error}"
                    ) from error
                if not readable:
                    raise ToolError("private Wayland selection payload transfer timed out")
                if payload_descriptor in readable:
                    try:
                        chunk = os.read(payload_descriptor, min(65536, self.maximum_bytes + 1 - len(payload)))
                    except BlockingIOError:
                        chunk = None
                    except OSError as error:
                        raise ToolError(
                            f"private Wayland selection payload read failed: {error}"
                        ) from error
                    if chunk == b"":
                        payload_eof = True
                    elif chunk:
                        payload.extend(chunk)
                        if len(payload) > self.maximum_bytes:
                            raise ToolError("private Wayland selection payload exceeded its declared bound")
                if stdout_descriptor in readable and reply is None:
                    try:
                        chunk = os.read(stdout_descriptor, SELECTION_AGENT_MAX_REPLY_BYTES + 1)
                    except OSError as error:
                        raise ToolError(
                            f"private Wayland selection capture response failed: {error}"
                        ) from error
                    if not chunk:
                        diagnostic = self._diagnostic()
                        suffix = f": {diagnostic}" if diagnostic else ""
                        raise ToolError(
                            f"private Wayland selection capture exited before replying{suffix}"
                        )
                    self._stdout_buffer.extend(chunk)
                    if len(self._stdout_buffer) > SELECTION_AGENT_MAX_REPLY_BYTES:
                        raise ToolError(
                            "private Wayland selection capture returned an oversized reply"
                        )
            assert reply is not None
        except Exception:
            self.terminal_error = True
            raise
        finally:
            if payload_eof and self._payload_descriptor is not None:
                with contextlib.suppress(OSError):
                    os.close(self._payload_descriptor)
                self._payload_descriptor = None
        self._record_error(reply, sequence, command)
        self.sequence += 1
        return reply, bytes(payload)

    def capture(self, offer_id: int) -> str | bytes:
        if self.offer_id is None or self.offer_generation is None or self.mime is None:
            raise ToolError("private Wayland selection capture has no authorized offer")
        offer_id = as_int(offer_id, 1, 2**32 - 1, "selection offer_id")
        if offer_id != self.offer_id:
            raise ToolError("selection offer_id does not match the retained RichCopySeal offer")
        sequence = self.sequence
        reply, payload = self._capture_reply_and_payload(
            f"CAPTURE {offer_id}",
            SELECTION_AGENT_COMMAND_TIMEOUT_SECONDS + 6.0,
        )
        match = self._capture_pattern.fullmatch(reply)
        if (
            match is None
            or int(match.group(1)) != sequence
            or int(match.group(2)) != offer_id
            or match.group(3) != self.mime
            or int(match.group(4)) != len(payload)
            or len(payload) > self.maximum_bytes
        ):
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned inconsistent transfer accounting")
        if self.profile == "png":
            if self.mime != "image/png" or not payload.startswith(b"\x89PNG\r\n\x1a\n"):
                self.terminal_error = True
                raise ToolError("private Wayland selection capture returned malformed PNG")
            captured: str | bytes = payload
        elif self.profile == "files":
            if self.mime != FILE_DROP_MIME or not payload:
                self.terminal_error = True
                raise ToolError("private Wayland selection capture returned malformed file URI data")
            captured = payload
        else:
            try:
                text = payload.decode("utf-8", "strict")
            except UnicodeDecodeError as error:
                self.terminal_error = True
                raise ToolError("private Wayland selection capture returned malformed UTF-8") from error
            if "\x00" in text:
                self.terminal_error = True
                raise ToolError("private Wayland selection capture returned forbidden NUL text")
            captured = text
        self.capture_complete = True
        self.captured_bytes = len(payload)
        return captured

    def clear(self) -> None:
        if self.clear_confirmed:
            return
        sequence = self.sequence
        reply = self._exchange("CLEAR")
        match = self._clear_pattern.fullmatch(reply)
        if match is None or int(match.group(1)) != sequence:
            self.terminal_error = True
            raise ToolError("private Wayland selection capture returned an invalid clear receipt")
        offers = int(match.group(2))
        generation = int(match.group(3))
        transferred_bytes = int(match.group(4))
        if (
            offers > 2**32 - 1
            or generation < self.selection_generation
            or (self.capture_complete and generation <= self.selection_generation)
            or (self.capture_complete and offers < 1)
            or transferred_bytes != self.captured_bytes
        ):
            self.terminal_error = True
            raise ToolError("private Wayland selection capture could not prove selection release")
        self.offers_seen = offers
        self.selection_generation = generation
        self.clear_confirmed = True

    def evidence(self) -> dict[str, Any]:
        if self.scene_launch_ids:
            confidentiality_scope = "exclusive-explicit-scene-set-trust-domain"
            scope_kind = "scene-set"
            source_mitigation = (
                "exact-scene-set-must-equal-complete-live-managed-launch-domain-before-"
                "arm+capture+post-transfer-clear"
            )
        elif self.launch_id is not None:
            confidentiality_scope = "exclusive-live-launch-trust-domain"
            scope_kind = "launch"
            source_mitigation = (
                "sole-live-managed-launch-required-before-arm+capture+post-transfer-clear"
            )
        else:
            confidentiality_scope = "workstation"
            scope_kind = "workstation"
            source_mitigation = "none-unscoped"
        return {
            "transport": "birth-pinned-request-gated-ext-data-control-v1-offer",
            "protocol": SELECTION_AGENT_PROTOCOL,
            "connection_scope": "one-guarded-copy-operation",
            "selection_scope": "private-workstation-global",
            "launch_confidentiality_scope": confidentiality_scope,
            "authority_scope": scope_kind,
            "scene_member_count": len(self.scene_launch_ids) if self.scene_launch_ids else None,
            "scene_member_set_sha256": (
                hashlib.sha256(canonical_json(list(self.scene_launch_ids))).hexdigest()
                if self.scene_launch_ids else None
            ),
            "selection_source_identity_available": False,
            "selection_source_mitigation": source_mitigation,
            "capture_profile": self.profile,
            "capture_policy": (
                "clear-stale+arm-generation+profile-matched-metadata-only-offer+"
                "controller-authorized-receive+post-transfer-focus+scope+TickSeal-proof"
            ),
            "payload_validation": (
                "bounded-utf8-without-nul"
                if self.profile == "text"
                else "helper-structural-PNG+controller-full-decode-after-clear"
                if self.profile == "png"
                else "helper-printable-ASCII-uri-list+controller-post-clear-strict-file-admission"
            ),
            "payload_transport": "dedicated-one-shot-owner-pipe",
            "payload_in_process_argv": False,
            "payload_in_environment": False,
            "payload_written_to_disk": False,
            "source_payload_retained": False,
            "stable_payload_fingerprint_retained": False,
            "maximum_payload_bytes": self.maximum_bytes,
            "maximum_profile_bytes": (
                MAX_TEXT_BYTES if self.profile == "text"
                else MAX_PNG_PAYLOAD_BYTES if self.profile == "png"
                else MAX_FILE_COPY_URI_LIST_BYTES
            ),
            "maximum_png_dimension": MAX_PNG_DIMENSION if self.profile == "png" else None,
            "maximum_png_pixels": MAX_PNG_PIXELS if self.profile == "png" else None,
            "payload_bytes": self.captured_bytes if self.capture_complete else None,
            "payload_fingerprint_retained": False,
            "mime": self.mime,
            "registry_cardinality": "exactly-one-seat+one-data-control-manager",
            "helper_process_custody": (
                "parent-death-signal+non-dumpable+no-new-privileges+"
                "exact-inherited-descriptor-inventory+four-distinct-directional-pipes+"
                "zero-regular-file-output"
            ),
            "helper_pid": self.pid,
            "helper_start_ticks": self.start_ticks,
            "manager_version": self.manager_version,
            "armed_generation": self.armed_generation,
            "offer_generation": self.offer_generation,
            "selection_generation": self.selection_generation,
            "offers_seen": self.offers_seen,
            "offer_announced": self.offer_id is not None,
            "capture_complete": self.capture_complete,
            "authorization_checkpoints": self.authorization_checkpoints,
            "post_transfer_checkpoints": self.post_transfer_checkpoints,
            "clear_policy": (
                "selection-null+Wayland-roundtrip-before-decode-or-file-admission-and-success"
            ),
            "clear_confirmed": self.clear_confirmed,
            "clear_recovery_confirmed": self.clear_recovery_confirmed,
            "shutdown_confirmed": self.shutdown_confirmed,
            "shutdown_error": self.shutdown_error,
            "terminal_error": self.terminal_error,
            "closed": self.closed,
        }

    def _assert_scope(self) -> None:
        if self.scene_launch_ids:
            self.controller._assert_clipboard_scene_exclusive(
                self.scene_id,
                self.scene_launch_ids,
            )
        elif self.launch_id is not None:
            self.controller._assert_clipboard_launch_exclusive(self.launch_id)

    def _terminate(self) -> None:
        process = self.process
        if process is not None:
            try:
                if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                    signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
                with contextlib.suppress(subprocess.TimeoutExpired):
                    process.wait(timeout=1)
                if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                    signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                    with contextlib.suppress(Exception):
                        process.wait(timeout=1)
            finally:
                for stream in (process.stdin, process.stdout, process.stderr):
                    if stream is not None:
                        with contextlib.suppress(Exception):
                            stream.close()
        if self._payload_descriptor is not None:
            with contextlib.suppress(OSError):
                os.close(self._payload_descriptor)
            self._payload_descriptor = None

    def _recover_clear(self, reason: str) -> bool:
        self._terminate()
        try:
            self.controller._run_controller(
                [self.controller.commands["wl-copy"], "--clear"], timeout=5
            )
        except Exception as error:
            self.shutdown_error = f"{reason}; fallback-clear={type(error).__name__}: {error}"[:512]
            self.controller._quarantine_clipboard(
                "RichCopySeal selection release was ambiguous and fallback clear failed",
                clear_failure=True,
            )
            return False
        self.clear_recovery_confirmed = True
        return True

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            if not self.clear_confirmed:
                if self.terminal_error or not self._exact_alive():
                    raise ToolError("RichCopySeal ended before selection clear was confirmed")
                self.clear()
            if not self.terminal_error and self._exact_alive():
                sequence = self.sequence
                reply = self._exchange("QUIT")
                match = self._bye_pattern.fullmatch(reply)
                expected_captured = "1" if self.capture_complete else "0"
                if (
                    match is None
                    or int(match.group(1)) != sequence
                    or match.group(2) != expected_captured
                    or int(match.group(3)) != self.captured_bytes
                ):
                    self.terminal_error = True
                    raise ToolError("private Wayland selection capture returned an invalid shutdown receipt")
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
            if not self.clear_confirmed and not self._recover_clear(str(error)):
                close_error = ToolError(
                    "RichCopySeal failed and selection release could not be confirmed; "
                    "clipboard transactions are quarantined until desktop restart"
                )
        finally:
            self._terminate()
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_clipboard_transaction", None) is self:
                self.controller._active_clipboard_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandSelectionCaptureTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception as close_error:
            if exc is None or getattr(self.controller, "clipboard_quarantined", False):
                if exc is not None:
                    raise close_error from exc
                raise
        return False

class ClipboardOwner:
    """Small ICCCM clipboard owner on a dedicated X connection."""

    def __init__(self, display_name: str) -> None:
        self.display = xdisplay.Display(display_name)
        self.root = self.display.screen().root
        self.window = self.root.create_window(-10, -10, 1, 1, 0, X.CopyFromParent)
        self.clipboard = self.display.intern_atom("CLIPBOARD")
        self.targets = self.display.intern_atom("TARGETS")
        self.utf8 = self.display.intern_atom("UTF8_STRING")
        self.text_atom = self.display.intern_atom("TEXT")
        self.incr = self.display.intern_atom("INCR")
        self._text = ""
        self._lock = threading.RLock()
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, name="sandcodex-clipboard", daemon=True)
        self._thread.start()

    def set_text(self, text: str) -> None:
        with self._lock:
            self._text = text
            self.window.set_selection_owner(self.clipboard, X.CurrentTime)
            self.display.flush()
            if self.display.get_selection_owner(self.clipboard).id != self.window.id:
                raise ToolError("could not acquire the X11 clipboard")

    def owned_text(self) -> str | None:
        with self._lock:
            owner = self.display.get_selection_owner(self.clipboard)
            if owner is None or owner.id != self.window.id:
                return None
            return self._text

    def _reply(self, request: Any) -> None:
        prop = request.property if request.property != X.NONE else request.target
        target = request.target
        with self._lock:
            text = self._text
        if target == self.targets:
            self.window.change_property(
                prop,
                Xatom.ATOM,
                32,
                [self.targets, self.utf8, self.text_atom, Xatom.STRING],
            )
        elif target in {self.utf8, self.text_atom}:
            self.window.change_property(prop, target, 8, text.encode("utf-8"))
        elif target == Xatom.STRING:
            self.window.change_property(prop, Xatom.STRING, 8, text.encode("latin-1", "replace"))
        else:
            prop = X.NONE
        event = protocol.event.SelectionNotify(
            time=request.time,
            requestor=request.requestor,
            selection=request.selection,
            target=request.target,
            property=prop,
        )
        request.requestor.send_event(event, propagate=False)
        self.display.flush()

    def _run(self) -> None:
        while not self._stop.wait(0.01):
            try:
                with self._lock:
                    while self.display.pending_events():
                        event = self.display.next_event()
                        if event.type == X.SelectionRequest:
                            self._reply(event)
                        elif event.type == X.SelectionClear:
                            pass
            except Exception:
                time.sleep(0.05)

    def close(self) -> None:
        self._stop.set()
        self._thread.join(timeout=1)
        try:
            self.window.destroy()
            self.display.flush()
            self.display.close()
        except Exception:
            pass


class AccessibilityBridge:
    """Bounded AT-SPI semantic inspection and action surface for the private desktop."""

    def __init__(self, module: Any = Atspi, import_error: str | None = ATSPI_IMPORT_ERROR) -> None:
        self.module = module
        self.error = import_error
        self.available = False
        self.desktop: Any = None
        self.generation = 0
        self.nodes: dict[str, Any] = {}
        self.deadline: float | None = None
        self.initialized = False
        # EventPulseSeal is deliberately independent of snapshot generations.
        # The ring contains only exact launch-attributed events, while every
        # reader receives an opaque HMAC cursor bound to one launch or one
        # caller-proved scene membership vector.
        self.event_condition = threading.Condition(threading.RLock())
        self.event_ring: deque[dict[str, Any]] = deque()
        self.event_sequence = 0
        self.event_received = 0
        self.event_unattributed = 0
        self.event_invalid = 0
        self.event_evicted = 0
        self.event_capacity_dropped = 0
        self.event_launch_counts: dict[str, int] = {}
        self.event_launch_received: dict[str, int] = {}
        self.event_launch_evicted: dict[str, int] = {}
        self.event_launch_capacity_dropped: dict[str, int] = {}
        self.event_listener: Any = None
        self.event_thread: threading.Thread | None = None
        self.event_stream_available = False
        self.event_stream_error: str | None = None
        self.event_registered_types: tuple[str, ...] = ()
        self.event_closing = False
        self.event_cursor_key = secrets.token_bytes(32)
        self.event_cursors: dict[str, dict[str, Any]] = {}
        self.event_origin_resolver: Callable[[int], Mapping[str, Any] | None] | None = None
        if module is None:
            return
        try:
            timeout_setter = getattr(module, "set_timeout", None)
            if callable(timeout_setter):
                timeout_setter(A11Y_CALL_TIMEOUT_MILLISECONDS, A11Y_STARTUP_TIMEOUT_MILLISECONDS)
            result = module.init()
            self.initialized = True
            if isinstance(result, int) and result != 0:
                raise RuntimeError(f"Atspi.init returned {result}")
            self.desktop = module.get_desktop(0)
            if self.desktop is None:
                raise RuntimeError("AT-SPI did not publish a desktop root")
            self.available = True
            self.error = None
            self._start_event_stream()
        except Exception as error:
            self.error = f"{type(error).__name__}: {error}"
            self.available = False

    def close(self) -> None:
        self.event_closing = True
        listener = self.event_listener
        if listener is not None:
            deregister = getattr(listener, "deregister", None)
            if callable(deregister):
                for event_type in self.event_registered_types:
                    with contextlib.suppress(Exception):
                        deregister(event_type)
            deregister_all = getattr(listener, "deregister_from_all", None)
            if callable(deregister_all):
                with contextlib.suppress(Exception):
                    deregister_all()
        if self.module is not None:
            event_quit = getattr(self.module, "event_quit", None)
            if callable(event_quit):
                with contextlib.suppress(Exception):
                    event_quit()
        with self.event_condition:
            self.event_stream_available = False
            # Subscription names describe live listener authority.  Clear them
            # with the journal so post-close status cannot imply that a dead
            # bridge still retains AT-SPI registrations.
            self.event_registered_types = ()
            self.event_ring.clear()
            self.event_cursors.clear()
            self.event_launch_counts.clear()
            self.event_launch_received.clear()
            self.event_launch_evicted.clear()
            self.event_launch_capacity_dropped.clear()
            self.event_condition.notify_all()
        if self.event_thread is not None:
            self.event_thread.join(timeout=2)
        self.event_listener = None
        self.event_thread = None
        self.event_origin_resolver = None
        self.nodes.clear()
        if self.initialized and self.module is not None:
            try:
                self.module.exit()
            except Exception:
                pass
        self.initialized = False
        self.available = False

    def _check_deadline(self) -> None:
        if self.deadline is not None and time.monotonic() >= self.deadline:
            raise AccessibilityDeadline

    def _call(self, obj: Any, name: str, *args: Any, default: Any = None) -> Any:
        self._check_deadline()
        if obj is None:
            return default
        try:
            function = getattr(obj, name, None)
            if not callable(function):
                return default
            result = function(*args)
        except AccessibilityDeadline:
            raise
        except Exception:
            return default
        self._check_deadline()
        return result

    @staticmethod
    def _enum_name(value: Any) -> str:
        if value is None:
            return ""
        for attribute in ("value_nick", "value_name", "name"):
            candidate = getattr(value, attribute, None)
            if isinstance(candidate, str) and candidate:
                text = candidate
                break
        else:
            text = str(value)
        text = text.rsplit(".", 1)[-1]
        text = re.sub(r"^(?:ATSPI_)?(?:STATE|ROLE|LAYER)_", "", text, flags=re.IGNORECASE)
        return text.replace("-", "_").lower()

    @staticmethod
    def _string(value: Any, limit: int = TITLE_LIMIT) -> str:
        if value is None:
            return ""
        text = str(value).replace("\x00", "")
        return text[:limit]

    @staticmethod
    def _event_call(obj: Any, name: str, *args: Any, default: Any = None) -> Any:
        """Call one event-source method without sharing snapshot deadlines."""
        if obj is None:
            return default
        try:
            function = getattr(obj, name, None)
            if not callable(function):
                return default
            return function(*args)
        except Exception:
            return default

    def set_event_origin_resolver(
        self,
        resolver: Callable[[int], Mapping[str, Any] | None] | None,
    ) -> None:
        if resolver is not None and not callable(resolver):
            raise TypeError("accessibility event origin resolver must be callable")
        self.event_origin_resolver = resolver

    @classmethod
    def _normalize_event_type(cls, value: Any) -> str:
        text = cls._string(value, A11Y_EVENT_TYPE_LIMIT).strip().casefold()
        if not text or re.fullmatch(r"[a-z0-9:_-]+", text) is None:
            return ""
        return text

    @staticmethod
    def _event_type_matches(event_type: str, subscription: str) -> bool:
        return (
            event_type == subscription
            or (subscription.endswith(":") and event_type.startswith(subscription))
            or event_type.startswith(subscription + ":")
        )

    def _start_event_stream(self) -> None:
        """Start the private AT-SPI event loop without weakening snapshots.

        A missing or incompatible listener API degrades only EventPulseSeal;
        bounded snapshot/action support remains available and reports the
        listener error independently.
        """
        if self.module is None or not self.available:
            return
        registered: list[str] = []
        listener: Any = None
        try:
            listener_class = getattr(self.module, "EventListener", None)
            factory = getattr(listener_class, "new", None)
            event_main = getattr(self.module, "event_main", None)
            if not callable(factory) or not callable(event_main):
                raise RuntimeError("AT-SPI event listener API is unavailable")
            try:
                listener = factory(self._on_event, None)
            except TypeError:
                listener = factory(self._on_event)
            if listener is None:
                raise RuntimeError("AT-SPI did not create an event listener")
            register = getattr(listener, "register", None)
            if not callable(register):
                raise RuntimeError("AT-SPI event listener has no register method")
            for event_type in A11Y_EVENT_TYPES:
                result = register(event_type)
                if result is False:
                    raise RuntimeError(f"AT-SPI rejected event subscription {event_type}")
                registered.append(event_type)
            self.event_listener = listener
            self.event_registered_types = tuple(registered)
            self.event_stream_available = True
            self.event_stream_error = None
            self.event_thread = threading.Thread(
                target=self._event_loop,
                name="sandcodex-atspi-event-pulse",
                daemon=True,
            )
            self.event_thread.start()
        except Exception as error:
            if listener is not None:
                deregister = getattr(listener, "deregister", None)
                if callable(deregister):
                    for event_type in registered:
                        with contextlib.suppress(Exception):
                            deregister(event_type)
            self.event_listener = None
            self.event_registered_types = ()
            self.event_stream_available = False
            self.event_stream_error = f"{type(error).__name__}: {error}"

    def _event_loop(self) -> None:
        error: str | None = None
        try:
            event_main = getattr(self.module, "event_main", None)
            if not callable(event_main):
                raise RuntimeError("AT-SPI event loop entry point disappeared")
            event_main()
            if not self.event_closing:
                error = "AT-SPI event loop returned unexpectedly"
        except Exception as caught:
            if not self.event_closing:
                error = f"{type(caught).__name__}: {caught}"
        finally:
            with self.event_condition:
                if error is not None:
                    self.event_stream_error = error
                self.event_stream_available = False
                self.event_condition.notify_all()

    @staticmethod
    def _event_primitive(value: Any) -> str | None:
        if isinstance(value, bytes):
            text = value.decode("utf-8", "replace")
        elif isinstance(value, str):
            text = value
        elif value is None:
            return None
        elif isinstance(value, (bool, int, float)):
            text = str(value)
        else:
            return None
        text = redact_private_notification_surface_ids(text.replace("\x00", ""))
        return text[:A11Y_EVENT_STRING_LIMIT] or None

    def _resolve_event_origin(self, process_id: int) -> dict[str, Any] | None:
        resolver = self.event_origin_resolver
        if resolver is None:
            return None
        try:
            value = resolver(process_id)
        except Exception:
            return None
        if not isinstance(value, Mapping):
            return None
        launch_id = value.get("launch_id")
        application_id = value.get("application_id")
        scene_id = value.get("scene_id")
        start_ticks = value.get("start_ticks")
        if (
            not isinstance(launch_id, str)
            or not launch_id
            or len(launch_id.encode("utf-8")) > 128
            or not isinstance(application_id, str)
            or not application_id
            or len(application_id.encode("utf-8")) > MAX_APP_ID_BYTES
            or isinstance(start_ticks, bool)
            or not isinstance(start_ticks, int)
            or start_ticks <= 0
        ):
            return None
        if scene_id is not None and (
            not isinstance(scene_id, str)
            or not scene_id
            or len(scene_id.encode("utf-8")) > MAX_SCENE_ID_BYTES
        ):
            return None
        return {
            "launch_id": launch_id,
            "application_id": redact_private_notification_surface_ids(application_id),
            "scene_id": scene_id,
            "start_ticks": start_ticks,
        }

    def _event_source_summary(
        self,
        source: Any,
        origin: Mapping[str, Any],
        process_id: int,
    ) -> dict[str, Any]:
        name = redact_private_notification_surface_ids(
            self._string(self._event_call(source, "get_name"), A11Y_EVENT_STRING_LIMIT)
        )
        description = redact_private_notification_surface_ids(
            self._string(self._event_call(source, "get_description"), A11Y_EVENT_STRING_LIMIT)
        )
        role = redact_private_notification_surface_ids(
            self._string(self._event_call(source, "get_role_name"), 256)
        )
        accessible_id = redact_private_notification_surface_ids(
            self._string(self._event_call(source, "get_accessible_id"), 1024)
        )
        toolkit = redact_private_notification_surface_ids(
            self._string(self._event_call(source, "get_toolkit_name"), 256)
        )
        # Prefer an application-supplied accessible ID when one exists.  Names
        # and descriptions are mutable user-visible data, so including them in
        # an otherwise stable source capability would make a rename look like a
        # different object.  The role/name fallback is necessarily weaker but
        # remains launch- and process-birth-scoped.
        locator = accessible_id or f"{role}\x00{name}"
        identity = {
            "launch_id": origin["launch_id"],
            "process_id": process_id,
            "start_ticks": origin["start_ticks"],
            "locator": locator,
        }
        source_ref = "a11y-src-" + hmac.new(
            self.event_cursor_key,
            b"sandcodex-a11y-source\x00" + canonical_json(identity),
            hashlib.sha256,
        ).hexdigest()[:32]
        return {
            "source_ref": source_ref,
            "name": name or None,
            "description": description or None,
            "role": role or None,
            "accessible_id": accessible_id or None,
            "toolkit": toolkit or None,
        }

    def _remove_event_record_locked(self, record: Mapping[str, Any]) -> None:
        launch_id = record.get("_launch_id")
        if isinstance(launch_id, str):
            remaining = self.event_launch_counts.get(launch_id, 0) - 1
            if remaining > 0:
                self.event_launch_counts[launch_id] = remaining
            else:
                self.event_launch_counts.pop(launch_id, None)
            self.event_launch_evicted[launch_id] = self.event_launch_evicted.get(launch_id, 0) + 1
        self.event_evicted += 1

    def retire_launch(self, launch_id: str) -> None:
        """Revoke all event/cursor state for one launch at exact teardown."""
        if not isinstance(launch_id, str) or not launch_id:
            return
        with self.event_condition:
            self.event_ring = deque(
                record
                for record in self.event_ring
                if record.get("_launch_id") != launch_id
            )
            self.event_launch_counts.pop(launch_id, None)
            self.event_launch_received.pop(launch_id, None)
            self.event_launch_evicted.pop(launch_id, None)
            self.event_launch_capacity_dropped.pop(launch_id, None)
            for digest, cursor in list(self.event_cursors.items()):
                launch_ids = cursor.get("launch_ids")
                if isinstance(launch_ids, tuple) and launch_id in launch_ids:
                    self.event_cursors.pop(digest, None)
            self.event_condition.notify_all()

    def _evict_oldest_launch_event_locked(self, launch_id: str) -> bool:
        for index, record in enumerate(self.event_ring):
            if record.get("_launch_id") != launch_id:
                continue
            self.event_ring.rotate(-index)
            removed = self.event_ring.popleft()
            self.event_ring.rotate(index)
            self._remove_event_record_locked(removed)
            return True
        return False

    def _on_event(self, event: Any, _user_data: Any = None) -> None:
        """Admit one exact-origin event into the bounded private journal."""
        try:
            with self.event_condition:
                if self.event_closing or not self.event_stream_available:
                    return
            event_type = self._normalize_event_type(
                getattr(event, "type", None) or self._event_call(event, "get_type")
            )
            if not event_type or not any(
                self._event_type_matches(event_type, subscribed)
                for subscribed in self.event_registered_types
            ):
                with self.event_condition:
                    self.event_invalid += 1
                return
            source = getattr(event, "source", None)
            process_id = self._event_call(source, "get_process_id")
            if isinstance(process_id, bool) or not isinstance(process_id, int) or process_id <= 0:
                with self.event_condition:
                    self.event_unattributed += 1
                return
            origin = self._resolve_event_origin(process_id)
            if origin is None:
                with self.event_condition:
                    self.event_unattributed += 1
                return
            source_summary = self._event_source_summary(source, origin, process_id)
            def bounded_detail(value: Any) -> int | None:
                if isinstance(value, bool) or not isinstance(value, int):
                    return None
                return value if -(2**31) <= value <= 2**31 - 1 else None

            detail1 = bounded_detail(getattr(event, "detail1", None))
            detail2 = bounded_detail(getattr(event, "detail2", None))
            payload: dict[str, Any] = {}
            any_data = self._event_primitive(getattr(event, "any_data", None))
            if any_data is not None:
                if event_type.startswith("object:announcement"):
                    payload["announcement"] = any_data
                elif event_type.startswith("object:property-change:"):
                    payload["changed_value"] = any_data
            timestamp = utc_now()
            with self.event_condition:
                # Shutdown may have started while bounded source metadata was
                # queried over AT-SPI.  Never repopulate a wiped journal after
                # close has revoked the listener and cursor authority.
                if self.event_closing or not self.event_stream_available:
                    return
                launch_id = origin["launch_id"]
                launch_count = self.event_launch_counts.get(launch_id, 0)
                if launch_count >= A11Y_EVENT_PER_LAUNCH_MAX:
                    if not self._evict_oldest_launch_event_locked(launch_id):
                        raise RuntimeError("accessibility event launch accounting is inconsistent")
                elif len(self.event_ring) >= A11Y_EVENT_RING_MAX:
                    # Never let a newly noisy principal displace another
                    # launch's retained semantic history.  A launch that
                    # already owns records rolls only its own oldest record;
                    # a launch with no partition fails closed and reports a
                    # scoped capacity gap until teardown frees space.
                    if launch_count > 0:
                        if not self._evict_oldest_launch_event_locked(launch_id):
                            raise RuntimeError("accessibility event global accounting is inconsistent")
                    else:
                        self.event_capacity_dropped += 1
                        self.event_launch_capacity_dropped[launch_id] = (
                            self.event_launch_capacity_dropped.get(launch_id, 0) + 1
                        )
                        self.event_condition.notify_all()
                        return
                if len(self.event_ring) >= A11Y_EVENT_RING_MAX:
                    raise RuntimeError("accessibility event capacity invariant failed")
                self.event_sequence += 1
                sequence = self.event_sequence
                event_identity = {
                    "sequence": sequence,
                    "launch_id": origin["launch_id"],
                    "event_type": event_type,
                    "source_ref": source_summary["source_ref"],
                }
                event_ref = "a11y-event-" + hmac.new(
                    self.event_cursor_key,
                    b"sandcodex-a11y-event\x00" + canonical_json(event_identity),
                    hashlib.sha256,
                ).hexdigest()[:32]
                record: dict[str, Any] = {
                    "_sequence": sequence,
                    "_launch_id": origin["launch_id"],
                    "_scene_id": origin["scene_id"],
                    "schema": A11Y_EVENT_SCHEMA,
                    "event_ref": event_ref,
                    "timestamp": timestamp,
                    "event_type": event_type,
                    "launch_id": origin["launch_id"],
                    "application_id": origin["application_id"],
                    "scene_id": origin["scene_id"],
                    "source": source_summary,
                    "detail": {"detail1": detail1, "detail2": detail2},
                    "warning": A11Y_WARNING,
                }
                if payload:
                    record["payload"] = payload
                self.event_ring.append(record)
                self.event_received += 1
                self.event_launch_counts[launch_id] = self.event_launch_counts.get(launch_id, 0) + 1
                self.event_launch_received[launch_id] = self.event_launch_received.get(launch_id, 0) + 1
                self.event_condition.notify_all()
        except Exception:
            with self.event_condition:
                self.event_invalid += 1

    @staticmethod
    def _normalize_event_scope(value: Mapping[str, Any]) -> dict[str, Any]:
        if not isinstance(value, Mapping):
            raise ToolError("accessibility event scope is invalid")
        kind = value.get("kind")
        launch_ids_value = value.get("launch_ids")
        scene_id = value.get("scene_id")
        if kind not in {"launch", "scene"} or not isinstance(launch_ids_value, (tuple, list)):
            raise ToolError("accessibility event scope is invalid")
        launch_ids = tuple(sorted({
            as_string(item, "scope launch_id", maximum=128, allow_empty=False)
            for item in launch_ids_value
        }))
        if kind == "launch":
            if len(launch_ids) != 1 or scene_id is not None:
                raise ToolError("launch event scope must contain exactly one launch")
        else:
            if not 2 <= len(launch_ids) <= SCENE_SET_MAX_LAUNCHES:
                raise ToolError("scene event scope has an invalid member count")
            scene_id = as_string(
                scene_id,
                "scope scene_id",
                maximum=MAX_SCENE_ID_BYTES,
                allow_empty=False,
            )
        return {
            "schema": A11Y_EVENT_SCOPE_SCHEMA,
            "kind": kind,
            "launch_ids": list(launch_ids),
            "scene_id": scene_id,
        }

    @staticmethod
    def _event_matches_scope(record: Mapping[str, Any], scope: Mapping[str, Any]) -> bool:
        if record.get("_launch_id") not in scope["launch_ids"]:
            return False
        if scope["kind"] == "scene" and record.get("_scene_id") != scope["scene_id"]:
            return False
        return True

    @classmethod
    def _normalize_event_filters(cls, value: Any) -> tuple[str, ...]:
        if value is None:
            return ()
        if not isinstance(value, list) or len(value) > len(A11Y_EVENT_TYPES):
            raise ToolError("event_types must be a bounded array")
        result: list[str] = []
        for index, item in enumerate(value):
            event_type = cls._normalize_event_type(
                as_string(
                    item,
                    f"event_types[{index}]",
                    maximum=A11Y_EVENT_TYPE_LIMIT,
                    allow_empty=False,
                )
            )
            if event_type not in A11Y_EVENT_TYPES:
                raise ToolError(f"event_types[{index}] is not a supported subscription")
            if event_type not in result:
                result.append(event_type)
        return tuple(result)

    def _cursor_digest(self, raw: bytes) -> str:
        return hmac.new(
            self.event_cursor_key,
            b"sandcodex-a11y-event-cursor\x00" + raw,
            hashlib.sha256,
        ).hexdigest()

    def _prune_event_cursors_locked(self, now: float) -> None:
        for digest, cursor in list(self.event_cursors.items()):
            expires = cursor.get("expires")
            if not isinstance(expires, (int, float)) or expires <= now:
                self.event_cursors.pop(digest, None)
        while len(self.event_cursors) >= A11Y_EVENT_CURSOR_MAX:
            self.event_cursors.pop(next(iter(self.event_cursors)))

    def _issue_event_cursor_locked(
        self,
        scope: Mapping[str, Any],
        scope_digest: str,
        after: int,
        fence_event_types: tuple[str, ...],
    ) -> str:
        if (
            not isinstance(fence_event_types, tuple)
            or not fence_event_types
            or any(value not in A11Y_EVENT_TYPES for value in fence_event_types)
        ):
            raise ToolError("accessibility event cursor filter coverage is invalid")
        now = time.monotonic()
        self._prune_event_cursors_locked(now)
        for _ in range(16):
            raw = secrets.token_bytes(A11Y_EVENT_CURSOR_BYTES)
            digest = self._cursor_digest(raw)
            if digest not in self.event_cursors:
                break
        else:
            raise ToolError("could not allocate an accessibility event cursor")
        self.event_cursors[digest] = {
            "schema": A11Y_EVENT_CURSOR_SCHEMA,
            "scope_digest": scope_digest,
            "launch_ids": tuple(scope["launch_ids"]),
            "after": after,
            "fence_consumed": False,
            "fence_event_types": fence_event_types,
            "losses": {
                launch_id: (
                    self.event_launch_evicted.get(launch_id, 0),
                    self.event_launch_capacity_dropped.get(launch_id, 0),
                )
                for launch_id in scope["launch_ids"]
            },
            "expires": now + A11Y_EVENT_CURSOR_TTL_SECONDS,
        }
        return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")

    def _read_event_cursor_locked(
        self,
        value: Any,
        scope: Mapping[str, Any],
        scope_digest: str,
    ) -> tuple[int, dict[str, tuple[int, int]], dict[str, Any]]:
        token = as_string(value, "cursor", maximum=128, allow_empty=False)
        if re.fullmatch(r"[A-Za-z0-9_-]{43}", token) is None:
            raise ToolError("accessibility event cursor encoding is invalid")
        try:
            raw = base64.urlsafe_b64decode(token + "=")
        except (binascii.Error, ValueError) as error:
            raise ToolError("accessibility event cursor encoding is invalid") from error
        if (
            len(raw) != A11Y_EVENT_CURSOR_BYTES
            or base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=") != token
        ):
            raise ToolError("accessibility event cursor encoding is invalid")
        now = time.monotonic()
        self._prune_event_cursors_locked(now)
        cursor = self.event_cursors.get(self._cursor_digest(raw))
        if cursor is None:
            raise ToolError("accessibility event cursor is unknown or expired")
        stored_scope = cursor.get("scope_digest")
        if not isinstance(stored_scope, str) or not hmac.compare_digest(stored_scope, scope_digest):
            raise ToolError("accessibility event cursor belongs to another launch or scene")
        stored_launch_ids = cursor.get("launch_ids")
        if stored_launch_ids != tuple(scope["launch_ids"]):
            raise ToolError("accessibility event cursor state is invalid")
        after = cursor.get("after")
        if isinstance(after, bool) or not isinstance(after, int) or after < 0:
            raise ToolError("accessibility event cursor state is invalid")
        if not isinstance(cursor.get("fence_consumed"), bool):
            raise ToolError("accessibility event cursor state is invalid")
        fence_event_types = cursor.get("fence_event_types")
        if (
            not isinstance(fence_event_types, tuple)
            or not fence_event_types
            or any(value not in A11Y_EVENT_TYPES for value in fence_event_types)
        ):
            raise ToolError("accessibility event cursor state is invalid")
        losses = cursor.get("losses")
        if not isinstance(losses, dict) or set(losses) != set(scope["launch_ids"]):
            raise ToolError("accessibility event cursor state is invalid")
        normalized_losses: dict[str, tuple[int, int]] = {}
        for launch_id, values in losses.items():
            if not isinstance(values, tuple) or len(values) != 2:
                raise ToolError("accessibility event cursor state is invalid")
            evicted, capacity_dropped = values
            if any(
                isinstance(value, bool) or not isinstance(value, int) or value < 0
                for value in (evicted, capacity_dropped)
            ):
                raise ToolError("accessibility event cursor state is invalid")
            normalized_losses[str(launch_id)] = (evicted, capacity_dropped)
        return after, normalized_losses, cursor

    def _event_loss_snapshot_locked(
        self,
        scope: Mapping[str, Any],
    ) -> dict[str, tuple[int, int]]:
        return {
            str(launch_id): (
                self.event_launch_evicted.get(str(launch_id), 0),
                self.event_launch_capacity_dropped.get(str(launch_id), 0),
            )
            for launch_id in scope["launch_ids"]
        }

    def _event_fence_record_matches(
        self,
        record: Mapping[str, Any],
        scope: Mapping[str, Any],
        event_types: tuple[str, ...],
        source_ref: str | None,
    ) -> bool:
        if not self._event_matches_scope(record, scope):
            return False
        event_type = str(record.get("event_type") or "")
        if not any(
            self._event_type_matches(event_type, requested)
            for requested in event_types
        ):
            return False
        if source_ref is None:
            return True
        source = record.get("source")
        return isinstance(source, Mapping) and source.get("source_ref") == source_ref

    def _event_fence_anchor_locked(
        self,
        scope: Mapping[str, Any],
        event_ref: str | None,
        *,
        maximum_sequence: int | None = None,
    ) -> Mapping[str, Any] | None:
        if event_ref is None:
            return None
        for record in self.event_ring:
            if record.get("event_ref") != event_ref or not self._event_matches_scope(record, scope):
                continue
            sequence = record.get("_sequence")
            if (
                isinstance(sequence, bool)
                or not isinstance(sequence, int)
                or sequence <= 0
                or (maximum_sequence is not None and sequence > maximum_sequence)
            ):
                return None
            return record
        return None

    def _validate_event_fence_internal(
        self,
        fence: Mapping[str, Any],
        scope_value: Mapping[str, Any],
    ) -> tuple[dict[str, Any], tuple[str, ...], str | None, int, dict[str, tuple[int, int]]]:
        if not isinstance(fence, Mapping) or fence.get("schema") != A11Y_EVENT_FENCE_SCHEMA:
            raise ToolError("accessibility event fence state is invalid")
        scope = self._normalize_event_scope(scope_value)
        stored_scope = fence.get("scope")
        if not isinstance(stored_scope, Mapping):
            raise ToolError("accessibility event fence scope is invalid")
        normalized_stored_scope = self._normalize_event_scope(stored_scope)
        if canonical_json(normalized_stored_scope) != canonical_json(scope):
            raise ToolError("accessibility event fence belongs to another launch or scene")
        stored_digest = fence.get("scope_digest")
        scope_digest = hashlib.sha256(canonical_json(scope)).hexdigest()
        if not isinstance(stored_digest, str) or not hmac.compare_digest(stored_digest, scope_digest):
            raise ToolError("accessibility event fence scope digest is invalid")
        event_types_value = fence.get("event_types")
        if not isinstance(event_types_value, tuple) or not event_types_value:
            raise ToolError("accessibility event fence event types are invalid")
        event_types = tuple(str(value) for value in event_types_value)
        if any(value not in A11Y_EVENT_TYPES for value in event_types):
            raise ToolError("accessibility event fence event types are invalid")
        cursor_event_types_value = fence.get("cursor_event_types")
        if not isinstance(cursor_event_types_value, tuple) or not cursor_event_types_value:
            raise ToolError("accessibility event fence cursor coverage is invalid")
        cursor_event_types = tuple(str(value) for value in cursor_event_types_value)
        if (
            any(value not in A11Y_EVENT_TYPES for value in cursor_event_types)
            or not set(event_types).issubset(set(cursor_event_types))
        ):
            raise ToolError("accessibility event fence cursor coverage is invalid")
        source_ref = fence.get("source_ref")
        if source_ref is not None and (
            not isinstance(source_ref, str)
            or re.fullmatch(r"a11y-src-[0-9a-f]{32}", source_ref) is None
        ):
            raise ToolError("accessibility event fence source identity is invalid")
        frontier = fence.get("frontier")
        if isinstance(frontier, bool) or not isinstance(frontier, int) or frontier < 0:
            raise ToolError("accessibility event fence frontier is invalid")
        anchor_event_ref = fence.get("anchor_event_ref")
        if anchor_event_ref is not None and (
            not isinstance(anchor_event_ref, str)
            or re.fullmatch(r"a11y-event-[0-9a-f]{32}", anchor_event_ref) is None
        ):
            raise ToolError("accessibility event fence anchor identity is invalid")
        anchor_event_type = fence.get("anchor_event_type")
        if anchor_event_ref is None:
            if anchor_event_type is not None:
                raise ToolError("accessibility event fence anchor state is inconsistent")
        elif (
            not isinstance(anchor_event_type, str)
            or not anchor_event_type
            or len(anchor_event_type.encode("utf-8")) > A11Y_EVENT_TYPE_LIMIT
            or not any(
                self._event_type_matches(anchor_event_type, requested)
                for requested in event_types
            )
        ):
            raise ToolError("accessibility event fence anchor type is invalid")
        if not isinstance(fence.get("capture_complete"), bool):
            raise ToolError("accessibility event fence capture state is invalid")
        losses = fence.get("losses")
        if not isinstance(losses, dict) or set(losses) != set(scope["launch_ids"]):
            raise ToolError("accessibility event fence loss state is invalid")
        normalized_losses: dict[str, tuple[int, int]] = {}
        for launch_id, values in losses.items():
            if not isinstance(values, tuple) or len(values) != 2:
                raise ToolError("accessibility event fence loss state is invalid")
            evicted, capacity_dropped = values
            if any(
                isinstance(value, bool) or not isinstance(value, int) or value < 0
                for value in (evicted, capacity_dropped)
            ):
                raise ToolError("accessibility event fence loss state is invalid")
            normalized_losses[str(launch_id)] = (evicted, capacity_dropped)
        return scope, event_types, source_ref, frontier, normalized_losses

    def arm_event_fence(
        self,
        arguments: Mapping[str, Any],
        scope_value: Mapping[str, Any],
    ) -> dict[str, Any]:
        """Bind a future guarded observation to one exact EventPulse frontier.

        The caller-held cursor proves which scoped event frontier was reviewed.
        The returned state contains no raw cursor and remains controller-private.
        Any matching semantic event or retained-history loss after that frontier
        invalidates capture rather than letting a stale notification authorize a
        later GUI mutation.
        """
        if not isinstance(arguments, Mapping):
            raise ToolError("event_fence must be an object")
        unexpected = sorted(
            set(arguments) - {"cursor", "event_ref", "source_ref", "event_types"}
        )
        if unexpected:
            raise ToolError(f"event_fence contains unsupported keys: {', '.join(unexpected)}")
        if "cursor" not in arguments:
            raise ToolError("event_fence requires an EventPulse cursor")
        scope = self._normalize_event_scope(scope_value)
        scope_digest = hashlib.sha256(canonical_json(scope)).hexdigest()
        filters = self._normalize_event_filters(arguments.get("event_types"))
        if "event_types" in arguments and not filters:
            raise ToolError("event_fence.event_types must not be empty")
        event_types = filters or tuple(A11Y_EVENT_TYPES)
        event_ref_value = arguments.get("event_ref")
        event_ref = None
        if event_ref_value is not None:
            event_ref = as_string(
                event_ref_value,
                "event_fence.event_ref",
                maximum=64,
                allow_empty=False,
            )
            if re.fullmatch(r"a11y-event-[0-9a-f]{32}", event_ref) is None:
                raise ToolError("event_fence.event_ref is invalid")
        source_ref_value = arguments.get("source_ref")
        source_ref = None
        if source_ref_value is not None:
            source_ref = as_string(
                source_ref_value,
                "event_fence.source_ref",
                maximum=64,
                allow_empty=False,
            )
            if re.fullmatch(r"a11y-src-[0-9a-f]{32}", source_ref) is None:
                raise ToolError("event_fence.source_ref is invalid")
        with self.event_condition:
            if not self.event_stream_available:
                detail = f": {self.event_stream_error}" if self.event_stream_error else ""
                raise ToolError(f"private accessibility event stream is unavailable{detail}")
            after, cursor_losses, cursor_state = self._read_event_cursor_locked(
                arguments.get("cursor"),
                scope,
                scope_digest,
            )
            if cursor_state["fence_consumed"]:
                raise ToolError(
                    "accessibility event cursor already authorized one EventFenceSeal attempt"
                )
            # A valid scope-bound cursor grants exactly one fence attempt. Consume
            # before mutable journal/anchor checks so a failed attempt cannot be
            # replayed against a subtly different semantic frontier.
            cursor_state["fence_consumed"] = True
            cursor_event_types = cursor_state["fence_event_types"]
            if not set(event_types).issubset(set(cursor_event_types)):
                raise ToolError(
                    "event_fence event types were not reviewed by this cursor"
                )
            current_losses = self._event_loss_snapshot_locked(scope)
            if current_losses != cursor_losses:
                raise ToolError(
                    "accessibility event history changed after the reviewed cursor; "
                    "observation was withheld"
                )
            anchor = self._event_fence_anchor_locked(
                scope,
                event_ref,
                maximum_sequence=after,
            )
            if event_ref is not None and anchor is None:
                raise ToolError(
                    "event_fence.event_ref is absent, outside the reviewed scope, or newer than the cursor"
                )
            if anchor is not None and not self._event_fence_record_matches(
                anchor,
                scope,
                event_types,
                source_ref,
            ):
                raise ToolError(
                    "event_fence anchor does not match the requested event/source filter"
                )
            if anchor is not None and source_ref is not None:
                source = anchor.get("source")
                if not isinstance(source, Mapping) or source.get("source_ref") != source_ref:
                    raise ToolError("event_fence source_ref does not match the anchor event")
            if source_ref is not None and anchor is None:
                source_retained = any(
                    not isinstance(record.get("_sequence"), bool)
                    and isinstance(record.get("_sequence"), int)
                    and int(record["_sequence"]) <= after
                    and self._event_matches_scope(record, scope)
                    and isinstance(record.get("source"), Mapping)
                    and record["source"].get("source_ref") == source_ref
                    for record in self.event_ring
                )
                if not source_retained:
                    raise ToolError(
                        "event_fence.source_ref is not retained in the reviewed scope"
                    )
            for record in self.event_ring:
                sequence = record.get("_sequence")
                if (
                    isinstance(sequence, bool)
                    or not isinstance(sequence, int)
                    or sequence <= after
                ):
                    continue
                if self._event_fence_record_matches(record, scope, event_types, source_ref):
                    raise ToolError(
                        "a matching accessibility event occurred after the reviewed cursor; "
                        "observation was withheld"
                    )
            frontier = self.event_sequence
            return {
                "schema": A11Y_EVENT_FENCE_SCHEMA,
                "scope": scope,
                "scope_digest": scope_digest,
                "event_types": tuple(event_types),
                "cursor_event_types": tuple(cursor_event_types),
                "source_ref": source_ref,
                "anchor_event_ref": event_ref,
                "anchor_event_type": (
                    str(anchor.get("event_type")) if anchor is not None else None
                ),
                "frontier": frontier,
                "losses": current_losses,
                "capture_complete": False,
            }

    def complete_event_fence(
        self,
        fence: Mapping[str, Any],
        scope_value: Mapping[str, Any],
    ) -> dict[str, Any]:
        """Close the event interval around one captured observation."""
        scope, event_types, source_ref, frontier, losses = (
            self._validate_event_fence_internal(fence, scope_value)
        )
        with self.event_condition:
            if not self.event_stream_available:
                detail = f": {self.event_stream_error}" if self.event_stream_error else ""
                raise ToolError(f"private accessibility event stream is unavailable{detail}")
            if frontier > self.event_sequence:
                raise ToolError("accessibility event fence frontier is ahead of the journal")
            if self._event_loss_snapshot_locked(scope) != losses:
                raise ToolError(
                    "accessibility event history changed while capturing the observation"
                )
            anchor_ref = fence.get("anchor_event_ref")
            anchor = self._event_fence_anchor_locked(scope, anchor_ref)
            if anchor_ref is not None:
                if anchor is None:
                    raise ToolError("the accessibility event anchor expired during observation capture")
                if (
                    not self._event_fence_record_matches(
                        anchor,
                        scope,
                        event_types,
                        source_ref,
                    )
                    or anchor.get("event_type") != fence.get("anchor_event_type")
                ):
                    raise ToolError("the accessibility event anchor changed during observation capture")
            for record in self.event_ring:
                sequence = record.get("_sequence")
                if (
                    isinstance(sequence, bool)
                    or not isinstance(sequence, int)
                    or sequence <= frontier
                ):
                    continue
                if self._event_fence_record_matches(record, scope, event_types, source_ref):
                    raise ToolError(
                        "a matching accessibility event occurred while capturing the observation"
                    )
            completed = dict(fence)
            completed["frontier"] = self.event_sequence
            completed["losses"] = self._event_loss_snapshot_locked(scope)
            completed["capture_complete"] = True
            return completed

    def validate_event_fence(
        self,
        fence: Mapping[str, Any],
        scope_value: Mapping[str, Any],
    ) -> dict[str, Any]:
        """Prove no reviewed semantic event invalidated a guarded action."""
        scope, event_types, source_ref, frontier, losses = (
            self._validate_event_fence_internal(fence, scope_value)
        )
        if fence.get("capture_complete") is not True:
            raise ToolError("accessibility event fence was not closed around its observation")
        with self.event_condition:
            if not self.event_stream_available:
                detail = f": {self.event_stream_error}" if self.event_stream_error else ""
                raise ToolError(f"private accessibility event stream is unavailable{detail}")
            if frontier > self.event_sequence:
                raise ToolError("accessibility event fence frontier is ahead of the journal")
            if self._event_loss_snapshot_locked(scope) != losses:
                raise ToolError(
                    "accessibility event history changed after observation; guarded action was withheld"
                )
            anchor_ref = fence.get("anchor_event_ref")
            anchor = self._event_fence_anchor_locked(scope, anchor_ref)
            if anchor_ref is not None:
                if anchor is None:
                    raise ToolError(
                        "the accessibility event anchor expired before guarded-action dispatch"
                    )
                if (
                    not self._event_fence_record_matches(
                        anchor,
                        scope,
                        event_types,
                        source_ref,
                    )
                    or anchor.get("event_type") != fence.get("anchor_event_type")
                ):
                    raise ToolError(
                        "the accessibility event anchor changed before guarded-action dispatch"
                    )
            for record in self.event_ring:
                sequence = record.get("_sequence")
                if (
                    isinstance(sequence, bool)
                    or not isinstance(sequence, int)
                    or sequence <= frontier
                ):
                    continue
                if self._event_fence_record_matches(record, scope, event_types, source_ref):
                    raise ToolError(
                        "a matching accessibility event occurred after observation; "
                        "guarded action was withheld"
                    )
        return self.public_event_fence(fence, validated_for_dispatch=True)

    @staticmethod
    def public_event_fence(
        fence: Mapping[str, Any] | None,
        *,
        validated_for_dispatch: bool = False,
    ) -> dict[str, Any] | None:
        if fence is None:
            return None
        if not isinstance(fence, Mapping) or fence.get("schema") != A11Y_EVENT_FENCE_SCHEMA:
            raise ToolError("accessibility event fence state is invalid")
        event_types = fence.get("event_types")
        if not isinstance(event_types, tuple):
            raise ToolError("accessibility event fence event types are invalid")
        cursor_event_types = fence.get("cursor_event_types")
        if not isinstance(cursor_event_types, tuple):
            raise ToolError("accessibility event fence cursor coverage is invalid")
        return {
            "schema": A11Y_EVENT_FENCE_SCHEMA,
            "enforced": True,
            "capture_complete": fence.get("capture_complete") is True,
            "validated_for_dispatch": validated_for_dispatch,
            "anchor_event_ref": fence.get("anchor_event_ref"),
            "anchor_event_type": fence.get("anchor_event_type"),
            "source_ref": fence.get("source_ref"),
            "event_types": list(event_types),
            "cursor_reviewed_event_types": list(cursor_event_types),
            "cursor_single_fence_use": True,
            "cursor_filter_coverage_enforced": True,
            "policy": (
                "single-fence-use-scope-bound-event-cursor+no-matching-event-or-loss-through-final-predispatch-check"
            ),
            "raw_text_change_subscribed": False,
        }

    @staticmethod
    def _public_event(record: Mapping[str, Any]) -> dict[str, Any]:
        return {
            key: value
            for key, value in record.items()
            if not str(key).startswith("_")
        }

    def events(self, arguments: dict[str, Any], scope_value: Mapping[str, Any]) -> dict[str, Any]:
        """Read or long-poll one exact-origin semantic event stream."""
        scope = self._normalize_event_scope(scope_value)
        scope_digest = hashlib.sha256(canonical_json(scope)).hexdigest()
        cursor_value = arguments.get("cursor")
        history = as_bool(arguments.get("history", False), "history")
        if cursor_value is not None and history:
            raise ToolError("history may be used only when starting without a cursor")
        limit = as_int(
            arguments.get("limit", 32),
            1,
            A11Y_EVENT_RESULT_MAX,
            "limit",
        )
        wait_milliseconds = as_int(
            arguments.get("wait_milliseconds", 0),
            0,
            A11Y_EVENT_MAX_WAIT_MILLISECONDS,
            "wait_milliseconds",
        )
        filters = self._normalize_event_filters(arguments.get("event_types"))
        deadline = time.monotonic() + wait_milliseconds / 1000.0
        timed_out = False
        gap = False
        truncated = False
        selected: list[dict[str, Any]] = []
        with self.event_condition:
            if not self.event_stream_available:
                detail = f": {self.event_stream_error}" if self.event_stream_error else ""
                raise ToolError(f"private accessibility event stream is unavailable{detail}")
            if cursor_value is not None:
                after, cursor_losses, _cursor_state = self._read_event_cursor_locked(
                    cursor_value,
                    scope,
                    scope_digest,
                )
            elif history and self.event_ring:
                after = int(self.event_ring[0]["_sequence"]) - 1
                cursor_losses = {
                    launch_id: (
                        self.event_launch_evicted.get(launch_id, 0),
                        self.event_launch_capacity_dropped.get(launch_id, 0),
                    )
                    for launch_id in scope["launch_ids"]
                }
            else:
                after = self.event_sequence
                cursor_losses = {
                    launch_id: (
                        self.event_launch_evicted.get(launch_id, 0),
                        self.event_launch_capacity_dropped.get(launch_id, 0),
                    )
                    for launch_id in scope["launch_ids"]
                }

            while True:
                if self.event_closing or not self.event_stream_available:
                    detail = f": {self.event_stream_error}" if self.event_stream_error else ""
                    raise ToolError(f"private accessibility event stream stopped{detail}")
                if any(
                    self.event_launch_evicted.get(launch_id, 0) > cursor_losses[launch_id][0]
                    or self.event_launch_capacity_dropped.get(launch_id, 0) > cursor_losses[launch_id][1]
                    for launch_id in scope["launch_ids"]
                ):
                    gap = True
                records = list(self.event_ring)
                matching: list[dict[str, Any]] = []
                for record in records:
                    sequence = int(record["_sequence"])
                    if sequence <= after or not self._event_matches_scope(record, scope):
                        continue
                    event_type = str(record.get("event_type") or "")
                    if filters and not any(
                        self._event_type_matches(event_type, requested)
                        for requested in filters
                    ):
                        continue
                    matching.append(record)
                if matching:
                    selected = matching[:limit]
                    truncated = len(matching) > limit
                    next_after = (
                        int(selected[-1]["_sequence"])
                        if truncated
                        else self.event_sequence
                    )
                    break
                if gap:
                    next_after = self.event_sequence
                    break
                remaining = deadline - time.monotonic()
                if wait_milliseconds == 0 or remaining <= 0:
                    timed_out = wait_milliseconds > 0
                    next_after = self.event_sequence
                    break
                self.event_condition.wait(timeout=remaining)

            next_cursor = self._issue_event_cursor_locked(
                scope,
                scope_digest,
                next_after,
                filters or tuple(A11Y_EVENT_TYPES),
            )
            scope_launch_ids = set(scope["launch_ids"])
            statistics = {
                "retained": sum(
                    self.event_launch_counts.get(launch_id, 0)
                    for launch_id in scope_launch_ids
                ),
                "maximum_retained": min(
                    A11Y_EVENT_RING_MAX,
                    A11Y_EVENT_PER_LAUNCH_MAX * len(scope_launch_ids),
                ),
                "received": sum(
                    self.event_launch_received.get(launch_id, 0)
                    for launch_id in scope_launch_ids
                ),
                "evicted": sum(
                    self.event_launch_evicted.get(launch_id, 0)
                    for launch_id in scope_launch_ids
                ),
                "capacity_dropped": sum(
                    self.event_launch_capacity_dropped.get(launch_id, 0)
                    for launch_id in scope_launch_ids
                ),
            }
        return {
            "schema": A11Y_EVENT_SCHEMA,
            "scope": scope,
            "events": [self._public_event(record) for record in selected],
            "count": len(selected),
            "next_cursor": next_cursor,
            "timed_out": timed_out,
            "truncated": truncated,
            "gap": gap,
            "history_requested": history,
            "event_types": list(filters),
            "cursor_ttl_seconds": A11Y_EVENT_CURSOR_TTL_SECONDS,
            "statistics": statistics,
            "warning": A11Y_WARNING,
        }

    def status(self) -> dict[str, Any]:
        version = None
        if self.available and self.module is not None:
            version = self._call(self.module, "get_version")
        with self.event_condition:
            events = {
                "available": self.event_stream_available,
                "error": self.event_stream_error,
                "schema": A11Y_EVENT_SCHEMA,
                "scope": "exact-launch-or-exact-scene-membership",
                "subscriptions": list(self.event_registered_types),
                "retained": len(self.event_ring),
                "maximum_retained": A11Y_EVENT_RING_MAX,
                "maximum_retained_per_launch": A11Y_EVENT_PER_LAUNCH_MAX,
                "maximum_result_events": A11Y_EVENT_RESULT_MAX,
                "maximum_wait_milliseconds": A11Y_EVENT_MAX_WAIT_MILLISECONDS,
                "cursor_ttl_seconds": A11Y_EVENT_CURSOR_TTL_SECONDS,
                "action_fence_schema": A11Y_EVENT_FENCE_SCHEMA,
                "action_fence_policy": (
                    "single-fence-use-scope-bound-cursor+no-matching-event-or-loss-through-final-predispatch-check"
                ),
                "received": self.event_received,
                "unattributed_dropped": self.event_unattributed,
                "invalid_dropped": self.event_invalid,
                "evicted": self.event_evicted,
                "capacity_dropped": self.event_capacity_dropped,
            }
        return {
            "available": self.available,
            "version": self._string(version, 128) or None,
            "error": self.error,
            "node_ids": "snapshot-scoped",
            "events": events,
            "method_timeout_milliseconds": A11Y_CALL_TIMEOUT_MILLISECONDS,
            "startup_timeout_milliseconds": A11Y_STARTUP_TIMEOUT_MILLISECONDS,
            "warning": A11Y_WARNING,
        }

    def _require(self) -> None:
        if not self.available or self.module is None:
            detail = f": {self.error}" if self.error else ""
            raise ToolError(f"private desktop accessibility is unavailable{detail}")

    def _states(self, accessible: Any) -> list[str]:
        state_set = self._call(accessible, "get_state_set")
        states = self._call(state_set, "get_states", default=[]) or []
        return sorted({name for state in states if (name := self._enum_name(state))})

    def _interfaces(self, accessible: Any) -> list[str]:
        interfaces = self._call(accessible, "get_interfaces", default=[]) or []
        values: set[str] = set()
        for interface in interfaces:
            name = self._string(interface, 256).rsplit(".", 1)[-1]
            if name:
                values.add(name)
        return sorted(values)

    def _bounds(self, accessible: Any) -> dict[str, int] | None:
        component = self._call(accessible, "get_component_iface")
        if component is None:
            return None
        coord_type = getattr(getattr(self.module, "CoordType", object()), "SCREEN", 0)
        rectangle = self._call(component, "get_extents", coord_type)
        if rectangle is None:
            return None
        try:
            return {
                "x": int(rectangle.x),
                "y": int(rectangle.y),
                "width": max(0, int(rectangle.width)),
                "height": max(0, int(rectangle.height)),
            }
        except (AttributeError, TypeError, ValueError):
            return None

    def _actions(self, accessible: Any) -> list[dict[str, Any]]:
        action = self._call(accessible, "get_action_iface")
        count = self._call(action, "get_n_actions", default=0)
        if not isinstance(count, int) or count < 0:
            return []
        values: list[dict[str, Any]] = []
        for index in range(min(count, 64)):
            name_value = self._call(action, "get_action_name", index)
            if not name_value:
                name_value = self._call(action, "get_name", index)
            name = self._string(name_value, 256)
            localized = self._string(self._call(action, "get_localized_name", index), 256)
            description_value = self._call(action, "get_action_description", index)
            if not description_value:
                description_value = self._call(action, "get_description", index)
            description = self._string(description_value, 1024)
            key_binding = self._string(self._call(action, "get_key_binding", index), 512)
            values.append({
                "index": index,
                "name": name,
                "localized_name": localized or None,
                "description": description or None,
                "key_binding": key_binding or None,
            })
        return values

    def _text(self, accessible: Any, limit: int) -> dict[str, Any] | None:
        text = self._call(accessible, "get_text_iface")
        if text is None:
            return None
        count = self._call(text, "get_character_count", default=0)
        if not isinstance(count, int) or count < 0:
            count = 0
        excerpt = self._string(self._call(text, "get_text", 0, min(count, limit)), limit * 4)
        caret = self._call(text, "get_caret_offset")
        return {
            "character_count": count,
            "excerpt": excerpt,
            "truncated": count > limit,
            "caret_offset": caret if isinstance(caret, int) and caret >= 0 else None,
            "editable": self._call(accessible, "get_editable_text_iface") is not None,
        }

    def _value(self, accessible: Any) -> dict[str, Any] | None:
        value = self._call(accessible, "get_value_iface")
        if value is None:
            return None
        current = self._call(value, "get_current_value")
        minimum = self._call(value, "get_minimum_value")
        maximum = self._call(value, "get_maximum_value")
        increment = self._call(value, "get_minimum_increment")
        text = self._string(self._call(value, "get_text"), 1024)
        return {
            "current": current if isinstance(current, (int, float)) and not isinstance(current, bool) else None,
            "minimum": minimum if isinstance(minimum, (int, float)) and not isinstance(minimum, bool) else None,
            "maximum": maximum if isinstance(maximum, (int, float)) and not isinstance(maximum, bool) else None,
            "minimum_increment": increment if isinstance(increment, (int, float)) and not isinstance(increment, bool) else None,
            "text": text or None,
        }

    def _node(self, accessible: Any, node_id: str, parent_id: str | None, depth: int, text_limit: int) -> dict[str, Any]:
        child_count = self._call(accessible, "get_child_count", default=0)
        if not isinstance(child_count, int) or child_count < 0:
            child_count = 0
        process_id = self._call(accessible, "get_process_id")
        accessible_id = self._string(self._call(accessible, "get_accessible_id"), 1024)
        attributes = self._call(accessible, "get_attributes", default={})
        if not isinstance(attributes, dict):
            attributes = {}
        safe_attributes: dict[str, str] = {}
        for index, (key, value) in enumerate(attributes.items()):
            if index >= 64:
                break
            safe_key = self._string(key, 256)
            if safe_key:
                safe_attributes[safe_key] = self._string(value, 1024)
        return {
            "id": node_id,
            "node_id": node_id,
            "parent_id": parent_id,
            "depth": depth,
            "name": self._string(self._call(accessible, "get_name")),
            "description": self._string(self._call(accessible, "get_description")),
            "help_text": self._string(self._call(accessible, "get_help_text")) or None,
            "role": self._string(self._call(accessible, "get_role_name"), 256),
            "localized_role": self._string(self._call(accessible, "get_localized_role_name"), 256) or None,
            "accessible_id": accessible_id or None,
            "process_id": process_id if isinstance(process_id, int) and process_id > 0 else None,
            "toolkit": self._string(self._call(accessible, "get_toolkit_name"), 256) or None,
            "toolkit_version": self._string(self._call(accessible, "get_toolkit_version"), 256) or None,
            "states": self._states(accessible),
            "interfaces": self._interfaces(accessible),
            "bounds": self._bounds(accessible),
            "actions": self._actions(accessible),
            "text": self._text(accessible, text_limit),
            "value": self._value(accessible),
            "attributes": safe_attributes,
            "child_count": child_count,
        }

    def snapshot(self, arguments: dict[str, Any]) -> dict[str, Any]:
        self._require()
        max_nodes = as_int(arguments.get("max_nodes", 256), 1, MAX_A11Y_NODES, "max_nodes")
        max_depth = as_int(arguments.get("max_depth", 8), 0, MAX_A11Y_DEPTH, "max_depth")
        text_limit = as_int(arguments.get("text_limit", 512), 0, MAX_A11Y_TEXT, "text_limit")
        timeout_ms = as_int(
            arguments.get("timeout_milliseconds", 10000),
            100,
            MAX_A11Y_SNAPSHOT_MILLISECONDS,
            "timeout_milliseconds",
        )
        query = as_string(arguments.get("query", ""), "query", maximum=1024).casefold()
        roles_value = arguments.get("roles", [])
        if not isinstance(roles_value, list) or len(roles_value) > 64:
            raise ToolError("roles must be a bounded string array")
        roles = {
            as_string(role, f"roles[{index}]", maximum=256, allow_empty=False).casefold()
            for index, role in enumerate(roles_value)
        }
        process_ids_value = arguments.get("process_ids", [])
        if not isinstance(process_ids_value, list) or len(process_ids_value) > MAX_MANAGED_PROCESSES * 64:
            raise ToolError("process_ids must be a bounded integer array")
        process_ids = {
            as_int(value, 1, 2**31 - 1, f"process_ids[{index}]")
            for index, value in enumerate(process_ids_value)
        }
        self.generation += 1
        self.nodes = {}
        visible: list[dict[str, Any]] = []
        response_bytes = 0
        scanned = 0
        truncated = False
        timed_out = False
        started = time.monotonic()
        self.deadline = started + timeout_ms / 1000
        queue: deque[tuple[Any, str | None, int]] = deque()
        try:
            desktop = self._call(self.module, "get_desktop", 0)
            if desktop is None:
                raise ToolError("AT-SPI desktop root disappeared")
            self.desktop = desktop
            queue.append((desktop, None, 0))
            while queue and scanned < max_nodes:
                self._check_deadline()
                accessible, parent_id, depth = queue.popleft()
                node_id = f"a11y-{self.generation}-{scanned}"
                node = self._node(accessible, node_id, parent_id, depth, text_limit)
                scanned += 1
                haystack = " ".join([
                    node["name"], node["description"], node["role"],
                    node.get("accessible_id") or "",
                    (node.get("text") or {}).get("excerpt", ""),
                ]).casefold()
                matches = (
                    (not query or query in haystack)
                    and (not roles or node["role"].casefold() in roles)
                    and (not process_ids or node.get("process_id") in process_ids)
                )
                if matches:
                    encoded_bytes = len(json.dumps(node, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
                    if response_bytes + encoded_bytes > MAX_A11Y_RESPONSE_BYTES:
                        truncated = True
                        break
                    visible.append(node)
                    self.nodes[node_id] = accessible
                    response_bytes += encoded_bytes
                if depth >= max_depth:
                    if node["child_count"]:
                        truncated = True
                    continue
                remaining = max(0, max_nodes - scanned - len(queue))
                child_limit = min(node["child_count"], MAX_A11Y_NODES)
                admitted = min(child_limit, remaining)
                if node["child_count"] > admitted:
                    truncated = True
                for index in range(admitted):
                    child = self._call(accessible, "get_child_at_index", index)
                    if child is not None:
                        queue.append((child, node_id, depth + 1))
        except AccessibilityDeadline:
            timed_out = True
            truncated = True
        finally:
            self.deadline = None
        if queue:
            truncated = True
        elapsed_ms = round((time.monotonic() - started) * 1000)
        return {
            "available": True,
            "generation": self.generation,
            "nodes": visible,
            "count": len(visible),
            "scanned": scanned,
            "truncated": truncated,
            "timed_out": timed_out,
            "elapsed_milliseconds": elapsed_ms,
            "timeout_milliseconds": timeout_ms,
            "max_nodes": max_nodes,
            "max_depth": max_depth,
            "text_limit": text_limit,
            "process_ids": sorted(process_ids),
            "response_bytes": response_bytes,
            "max_response_bytes": MAX_A11Y_RESPONSE_BYTES,
            "warning": A11Y_WARNING,
        }

    def _resolve(self, value: Any) -> tuple[str, Any]:
        self._require()
        node_id = as_string(value, "node_id", maximum=128, allow_empty=False)
        accessible = self.nodes.get(node_id)
        if accessible is None:
            raise ToolError("node_id is absent or stale; take a fresh desktop_accessibility snapshot")
        return node_id, accessible

    def node_process_id(self, value: Any) -> int | None:
        _node_id, accessible = self._resolve(value)
        process_id = self._call(accessible, "get_process_id")
        return process_id if isinstance(process_id, int) and process_id > 0 else None

    def action(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        interface = self._call(accessible, "get_action_iface")
        if interface is None:
            raise ToolError("accessible node does not implement Action")
        count = self._call(interface, "get_n_actions", default=0)
        if not isinstance(count, int) or count <= 0:
            raise ToolError("accessible node exposes no actions")
        requested = arguments.get("action")
        index: int | None = None
        if isinstance(requested, int) and not isinstance(requested, bool):
            if not 0 <= requested < count:
                raise ToolError("action index is outside the node action range")
            index = requested
        elif isinstance(requested, str):
            target = as_string(requested, "action", maximum=256, allow_empty=False).casefold()
            for candidate in range(min(count, 64)):
                names = {
                    self._string(self._call(interface, "get_action_name", candidate)).casefold(),
                    self._string(self._call(interface, "get_name", candidate)).casefold(),
                    self._string(self._call(interface, "get_localized_name", candidate)).casefold(),
                }
                if target in names:
                    index = candidate
                    break
            if index is None:
                raise ToolError("named action is not exposed by this node")
        else:
            raise ToolError("action must be an integer index or exact action name")
        name = self._string(self._call(interface, "get_action_name", index, default=self._call(interface, "get_name", index)), 256)
        result = self._call(interface, "do_action", index, default=False)
        if not bool(result):
            raise ToolError("AT-SPI action was rejected by the controlled application")
        return {"acted": True, "node_id": node_id, "action": name, "index": index, "warning": A11Y_WARNING}

    def focus(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        component = self._call(accessible, "get_component_iface")
        if component is None:
            raise ToolError("accessible node does not implement Component")
        focused = bool(self._call(component, "grab_focus", default=False))
        if not focused:
            raise ToolError("controlled application rejected semantic focus")
        return {"focused": True, "node_id": node_id, "bounds": self._bounds(accessible), "warning": A11Y_WARNING}

    def text(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        replacement_present = "text" in arguments
        if replacement_present:
            replacement = as_string(arguments.get("text"), "text", maximum=MAX_A11Y_TEXT)
            editable = self._call(accessible, "get_editable_text_iface")
            if editable is None:
                raise ToolError("accessible node does not implement EditableText")
            if not bool(self._call(editable, "set_text_contents", replacement, default=False)):
                raise ToolError("controlled application rejected semantic text replacement")
        limit = as_int(arguments.get("limit", 4096), 0, MAX_A11Y_TEXT, "limit")
        value = self._text(accessible, limit)
        if value is None:
            raise ToolError("accessible node does not implement Text")
        return {"node_id": node_id, "replaced": replacement_present, "text": value, "warning": A11Y_WARNING}

    def value(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        interface = self._call(accessible, "get_value_iface")
        if interface is None:
            raise ToolError("accessible node does not implement Value")
        changed = False
        if "value" in arguments:
            requested = as_number(arguments.get("value"), -1e308, 1e308, "value")
            if not bool(self._call(interface, "set_current_value", requested, default=False)):
                raise ToolError("controlled application rejected semantic value assignment")
            changed = True
        return {"node_id": node_id, "changed": changed, "value": self._value(accessible), "warning": A11Y_WARNING}

    @staticmethod
    def _normalize_selector(value: Any) -> dict[str, Any]:
        if value is None:
            return {}
        if not isinstance(value, dict) or len(value) > 32:
            raise ToolError("selector must be a bounded object")
        allowed = {
            "name", "name_contains", "description_contains", "text_contains", "role", "roles",
            "states", "actions", "attributes", "visible", "case_sensitive", "occurrence", "unique",
            "ancestor_name_contains", "ancestor_role",
        }
        unknown = sorted(set(value) - allowed)
        if unknown:
            raise ToolError(f"selector contains unsupported fields: {unknown}")
        result = dict(value)
        for name in ("name", "name_contains", "description_contains", "text_contains", "role", "ancestor_name_contains", "ancestor_role"):
            if name in result:
                result[name] = as_string(result[name], f"selector.{name}", maximum=1024, allow_empty=False)
        for name in ("roles", "states", "actions"):
            if name in result:
                items = result[name]
                if not isinstance(items, list) or len(items) > 32:
                    raise ToolError(f"selector.{name} must be a bounded string array")
                result[name] = [as_string(item, f"selector.{name}", maximum=256, allow_empty=False) for item in items]
        if "attributes" in result:
            attributes = result["attributes"]
            if not isinstance(attributes, dict) or len(attributes) > 32:
                raise ToolError("selector.attributes must be a bounded string map")
            result["attributes"] = {
                as_string(str(key), "selector attribute name", maximum=256, allow_empty=False):
                as_string(val, f"selector.attributes.{key}", maximum=1024)
                for key, val in attributes.items()
            }
        for name in ("visible", "case_sensitive", "unique"):
            if name in result:
                result[name] = as_bool(result[name], f"selector.{name}")
        if "occurrence" in result:
            result["occurrence"] = as_int(result["occurrence"], 0, MAX_SELECTOR_RESULTS - 1, "selector.occurrence")
        return result

    @classmethod
    def _selector_matches(cls, node: dict[str, Any], selector: dict[str, Any], by_id: dict[str, dict[str, Any]]) -> bool:
        case_sensitive = bool(selector.get("case_sensitive", False))
        fold = (lambda value: value) if case_sensitive else (lambda value: value.casefold())
        def match_equal(actual: Any, expected: str) -> bool:
            return fold(str(actual or "")) == fold(expected)
        def match_contains(actual: Any, expected: str) -> bool:
            return fold(expected) in fold(str(actual or ""))
        if "name" in selector and not match_equal(node.get("name"), selector["name"]):
            return False
        if "name_contains" in selector and not match_contains(node.get("name"), selector["name_contains"]):
            return False
        if "description_contains" in selector and not match_contains(node.get("description"), selector["description_contains"]):
            return False
        text = node.get("text") if isinstance(node.get("text"), dict) else {}
        if "text_contains" in selector and not match_contains(text.get("excerpt", ""), selector["text_contains"]):
            return False
        if "role" in selector and not match_equal(node.get("role"), selector["role"]):
            return False
        roles = selector.get("roles") or []
        if roles and not any(match_equal(node.get("role"), role) for role in roles):
            return False
        states = {fold(str(item)) for item in node.get("states", [])}
        if any(fold(item) not in states for item in selector.get("states", [])):
            return False
        actions = {
            fold(str(item.get("name") or item.get("localized_name") or ""))
            for item in node.get("actions", []) if isinstance(item, dict)
        }
        if any(fold(item) not in actions for item in selector.get("actions", [])):
            return False
        attributes = node.get("attributes") if isinstance(node.get("attributes"), dict) else {}
        for key, expected in (selector.get("attributes") or {}).items():
            if key not in attributes or not match_equal(attributes[key], expected):
                return False
        if selector.get("visible") is True:
            bounds = node.get("bounds")
            if not isinstance(bounds, dict) or bounds.get("width", 0) <= 0 or bounds.get("height", 0) <= 0:
                return False
            if "visible" not in states and "showing" not in states:
                return False
        ancestor_name = selector.get("ancestor_name_contains")
        ancestor_role = selector.get("ancestor_role")
        if ancestor_name or ancestor_role:
            parent = node.get("parent_id")
            found = False
            visited: set[str] = set()
            while isinstance(parent, str) and parent not in visited:
                visited.add(parent)
                ancestor = by_id.get(parent)
                if ancestor is None:
                    break
                name_ok = ancestor_name is None or match_contains(ancestor.get("name"), ancestor_name)
                role_ok = ancestor_role is None or match_equal(ancestor.get("role"), ancestor_role)
                if name_ok and role_ok:
                    found = True
                    break
                parent = ancestor.get("parent_id")
            if not found:
                return False
        return True

    def find(self, arguments: dict[str, Any]) -> dict[str, Any]:
        selector = self._normalize_selector(arguments.get("selector"))
        snapshot_arguments = {
            "max_nodes": arguments.get("max_nodes", MAX_A11Y_NODES),
            "max_depth": arguments.get("max_depth", MAX_A11Y_DEPTH),
            "text_limit": arguments.get("text_limit", 1024),
            "timeout_milliseconds": arguments.get("snapshot_timeout_milliseconds", 10000),
            "process_ids": arguments.get("process_ids", []),
        }
        snapshot = self.snapshot(snapshot_arguments)
        nodes = snapshot["nodes"]
        by_id = {str(node.get("node_id")): node for node in nodes if isinstance(node, dict)}
        matches = [node for node in nodes if isinstance(node, dict) and self._selector_matches(node, selector, by_id)]
        if len(matches) > MAX_SELECTOR_RESULTS:
            matches = matches[:MAX_SELECTOR_RESULTS]
            snapshot["truncated"] = True
        occurrence = selector.get("occurrence")
        if occurrence is not None:
            matches = matches[occurrence:occurrence + 1]
        if selector.get("unique") and len(matches) != 1:
            raise ToolError(f"semantic selector expected exactly one match, found {len(matches)}")
        return {
            "available": True,
            "selector": selector,
            "matches": matches,
            "count": len(matches),
            "generation": snapshot["generation"],
            "scanned": snapshot["scanned"],
            "truncated": snapshot["truncated"],
            "timed_out": snapshot["timed_out"],
            "warning": A11Y_WARNING,
        }

    def wait_for_selector(self, arguments: dict[str, Any]) -> dict[str, Any]:
        timeout_ms = as_int(arguments.get("timeout_milliseconds", 10000), 0, MAX_SELECTOR_TIMEOUT_MILLISECONDS, "timeout_milliseconds")
        poll_ms = as_int(arguments.get("poll_milliseconds", 100), 25, 1000, "poll_milliseconds")
        condition = arguments.get("condition", "present")
        if condition not in {"present", "absent", "unique"}:
            raise ToolError("condition must be present, absent, or unique")
        find_arguments = {key: value for key, value in arguments.items() if key not in {"timeout_milliseconds", "poll_milliseconds", "condition"}}
        started = time.monotonic()
        deadline = started + timeout_ms / 1000
        polls = 0
        last: dict[str, Any] | None = None
        while True:
            polls += 1
            last = self.find(find_arguments)
            count = last["count"]
            matched = (condition == "present" and count > 0) or (condition == "absent" and count == 0) or (condition == "unique" and count == 1)
            if matched:
                return {**last, "matched": True, "condition": condition, "polls": polls, "elapsed_milliseconds": round((time.monotonic() - started) * 1000)}
            if time.monotonic() >= deadline:
                raise ToolError(f"semantic selector did not become {condition} within {timeout_ms} milliseconds; last count={count}")
            time.sleep(min(poll_ms / 1000, max(0.0, deadline - time.monotonic())))

    def at_point(self, arguments: dict[str, Any]) -> dict[str, Any]:
        x = as_int(arguments.get("x"), 0, 100000, "x")
        y = as_int(arguments.get("y"), 0, 100000, "y")
        find_arguments = {key: value for key, value in arguments.items() if key not in {"x", "y"}}
        result = self.find(find_arguments)
        hits = []
        for node in result["matches"]:
            bounds = node.get("bounds")
            if not isinstance(bounds, dict):
                continue
            left, top = bounds.get("x", 0), bounds.get("y", 0)
            width, height = bounds.get("width", 0), bounds.get("height", 0)
            if left <= x < left + width and top <= y < top + height:
                hits.append(node)
        hits.sort(key=lambda node: ((node.get("bounds") or {}).get("width", 0) * (node.get("bounds") or {}).get("height", 0), -int(node.get("depth", 0))))
        return {**result, "point": {"x": x, "y": y}, "matches": hits[:MAX_SELECTOR_RESULTS], "count": len(hits[:MAX_SELECTOR_RESULTS])}

    def scroll(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        component = self._call(accessible, "get_component_iface")
        if component is None:
            raise ToolError("accessible node does not implement Component")
        if "x" in arguments or "y" in arguments:
            if "x" not in arguments or "y" not in arguments:
                raise ToolError("x and y must be supplied together")
            x = as_int(arguments.get("x"), -100000, 100000, "x")
            y = as_int(arguments.get("y"), -100000, 100000, "y")
            coordinate_type = getattr(getattr(self.module, "CoordType", object), "SCREEN", 0)
            accepted = bool(self._call(component, "scroll_to_point", coordinate_type, x, y, default=False))
            mode = {"point": {"x": x, "y": y}}
        else:
            requested = as_string(arguments.get("where", "anywhere"), "where", maximum=64, allow_empty=False).upper().replace("-", "_")
            enum = getattr(self.module, "ScrollType", None)
            aliases = {"ANYWHERE": "ANYWHERE", "TOP_LEFT": "TOP_LEFT", "BOTTOM_RIGHT": "BOTTOM_RIGHT", "TOP_EDGE": "TOP_EDGE", "BOTTOM_EDGE": "BOTTOM_EDGE", "LEFT_EDGE": "LEFT_EDGE", "RIGHT_EDGE": "RIGHT_EDGE"}
            name = aliases.get(requested)
            if enum is None or name is None or not hasattr(enum, name):
                raise ToolError("where must name a supported AT-SPI scroll target")
            accepted = bool(self._call(component, "scroll_to", getattr(enum, name), default=False))
            mode = {"where": requested.casefold()}
        if not accepted:
            raise ToolError("controlled application rejected semantic scrolling")
        return {"scrolled": True, "node_id": node_id, **mode, "warning": A11Y_WARNING}

    def selection(self, arguments: dict[str, Any]) -> dict[str, Any]:
        node_id, accessible = self._resolve(arguments.get("node_id"))
        interface = self._call(accessible, "get_selection_iface")
        if interface is None:
            raise ToolError("accessible node does not implement Selection")
        operation = arguments.get("operation", "list")
        if operation not in {"list", "select", "deselect", "clear", "select_all"}:
            raise ToolError("operation must be list, select, deselect, clear, or select_all")
        changed = False
        if operation in {"select", "deselect"}:
            index = as_int(arguments.get("index"), 0, MAX_A11Y_NODES - 1, "index")
            method = "select_child" if operation == "select" else "deselect_child"
            changed = bool(self._call(interface, method, index, default=False))
            if not changed:
                raise ToolError(f"controlled application rejected semantic {operation}")
        elif operation == "clear":
            changed = bool(self._call(interface, "clear_selection", default=False))
        elif operation == "select_all":
            changed = bool(self._call(interface, "select_all", default=False))
        count = self._call(interface, "get_n_selected_children", default=0)
        selected: list[dict[str, Any]] = []
        if isinstance(count, int):
            for index in range(min(count, MAX_SELECTOR_RESULTS)):
                child = self._call(interface, "get_selected_child", index)
                if child is not None:
                    selected.append({"index": index, "name": self._string(self._call(child, "get_name")), "role": self._string(self._call(child, "get_role_name"), 256)})
        return {"node_id": node_id, "operation": operation, "changed": changed, "selected": selected, "selected_count": count if isinstance(count, int) else len(selected), "warning": A11Y_WARNING}

    def perform(self, arguments: dict[str, Any]) -> dict[str, Any]:
        found = self.find({
            "selector": {**self._normalize_selector(arguments.get("selector")), "unique": True},
            "max_nodes": arguments.get("max_nodes", MAX_A11Y_NODES),
            "max_depth": arguments.get("max_depth", MAX_A11Y_DEPTH),
            "text_limit": arguments.get("text_limit", 1024),
            "snapshot_timeout_milliseconds": arguments.get("snapshot_timeout_milliseconds", 10000),
            "process_ids": arguments.get("process_ids", []),
        })
        return self._perform_node(arguments, found["matches"][0])

    def resolve_from_snapshot(self, arguments: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
        """Resolve exactly one semantic target in an already-sealed generation."""
        selector = {**self._normalize_selector(arguments.get("selector")), "unique": True}
        nodes = snapshot.get("nodes", [])
        if not isinstance(nodes, list):
            raise ToolError("guarded accessibility snapshot is invalid")
        by_id = {
            str(node.get("node_id")): node
            for node in nodes
            if isinstance(node, dict) and isinstance(node.get("node_id"), str)
        }
        matches = [
            node for node in nodes
            if isinstance(node, dict) and self._selector_matches(node, selector, by_id)
        ]
        occurrence = selector.get("occurrence")
        if occurrence is not None:
            matches = matches[occurrence:occurrence + 1]
        if len(matches) != 1:
            raise ToolError(f"semantic selector expected exactly one match, found {len(matches)}")
        return matches[0]

    def perform_resolved(self, arguments: dict[str, Any], node: dict[str, Any]) -> dict[str, Any]:
        """Perform one operation against an exact node from the sealed snapshot."""
        return self._perform_node(arguments, node)

    def _perform_node(self, arguments: dict[str, Any], node: dict[str, Any]) -> dict[str, Any]:
        operation = arguments.get("operation")
        if operation not in {"action", "focus", "replace_text", "set_value", "scroll", "selection"}:
            raise ToolError("operation must be action, focus, replace_text, set_value, scroll, or selection")
        node_id = node["node_id"]
        params = arguments.get("arguments", {})
        if not isinstance(params, dict):
            raise ToolError("arguments must be an object")
        if operation == "action":
            result = self.action({"node_id": node_id, "action": params.get("action", 0)})
        elif operation == "focus":
            result = self.focus({"node_id": node_id})
        elif operation == "replace_text":
            result = self.text({"node_id": node_id, "text": params.get("text", ""), "limit": params.get("limit", 4096)})
        elif operation == "set_value":
            result = self.value({"node_id": node_id, "value": params.get("value")})
        elif operation == "scroll":
            result = self.scroll({"node_id": node_id, **params})
        else:
            result = self.selection({"node_id": node_id, **params})
        return {"matched": node, "operation": operation, "result": result, "warning": A11Y_WARNING}


