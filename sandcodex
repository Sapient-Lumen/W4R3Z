def _bounded_text(value: Any, label: str, maximum: int, *, allow_empty: bool = True) -> str:
    if not isinstance(value, str):
        raise PortalError(f"{label} must be a string")
    if not allow_empty and not value:
        raise PortalError(f"{label} must not be empty")
    if "\x00" in value or len(value.encode("utf-8", "surrogateescape")) > maximum:
        raise PortalError(f"{label} exceeds its bounded text policy")
    return value


def _bounded_variant_tree(value: Any) -> None:
    nodes = 0
    byte_count = 0
    stack = [value]
    while stack:
        current = stack.pop()
        nodes += 1
        if nodes > MAX_OPTION_NODES:
            raise PortalError("portal options exceed the bounded node policy")
        if isinstance(current, str):
            byte_count += len(current.encode("utf-8", "surrogateescape"))
        elif isinstance(current, (bytes, bytearray, memoryview)):
            byte_count += len(current)
        elif isinstance(current, dict):
            stack.extend(current.keys())
            stack.extend(current.values())
        elif isinstance(current, (list, tuple)):
            stack.extend(current)
        elif isinstance(current, (bool, int, float, type(None))):
            pass
        elif hasattr(current, "deep_unpack"):
            stack.append(current.deep_unpack())
        elif hasattr(current, "unpack"):
            stack.append(current.unpack())
        else:
            raise PortalError("portal options contain an unsupported value")
        if byte_count > MAX_OPTION_BYTES:
            raise PortalError("portal options exceed the aggregate byte policy")


def _deep_unbox(value: Any) -> Any:
    if hasattr(value, "deep_unpack"):
        return _deep_unbox(value.deep_unpack())
    if hasattr(value, "unpack"):
        return _deep_unbox(value.unpack())
    if isinstance(value, dict):
        return {_deep_unbox(key): _deep_unbox(item) for key, item in value.items()}
    if isinstance(value, tuple):
        return tuple(_deep_unbox(item) for item in value)
    if isinstance(value, list):
        return [_deep_unbox(item) for item in value]
    return value


def _decode_path_bytes(value: Any, label: str) -> str:
    value = _deep_unbox(value)
    if isinstance(value, bytes):
        raw = value
    elif isinstance(value, bytearray):
        raw = bytes(value)
    elif isinstance(value, (list, tuple)) and all(isinstance(item, int) and 0 <= item <= 255 for item in value):
        raw = bytes(value)
    else:
        raise PortalError(f"{label} must be a filesystem byte array")
    if not raw or raw[-1] != 0 or b"\x00" in raw[:-1] or len(raw) > MAX_PATH_BYTES + 1:
        raise PortalError(f"{label} is not one bounded NUL-terminated path")
    return os.fsdecode(raw[:-1])


def _contains(root: Path, candidate: Path) -> bool:
    try:
        return os.path.commonpath((os.fspath(root), os.fspath(candidate))) == os.fspath(root)
    except ValueError:
        return False


def _parent_window(value: Any) -> str:
    """Validate one standard portal parent-window identifier.

    The handle remains opaque. Sandcodex does not import a foreign host surface;
    it only accepts the standard X11/Wayland syntax on the launch-private display
    and keeps the bounded identifier for future same-realm transient placement.
    """
    parent = _bounded_text(value, "parent_window", MAX_PARENT_BYTES)
    if not parent:
        return ""
    if X11_PARENT_RE.fullmatch(parent):
        return parent
    if parent.startswith("wayland:"):
        handle = parent[len("wayland:") :]
        if handle and all(0x21 <= ord(character) <= 0x7E for character in handle):
            return parent
    raise PortalError("parent_window is not an empty, X11, or Wayland portal identifier")


def _canonical_existing(path: str, label: str) -> Path:
    _bounded_text(path, label, MAX_PATH_BYTES, allow_empty=False)
    if not os.path.isabs(path):
        raise PortalError(f"{label} must be absolute")
    try:
        resolved = Path(os.path.realpath(path, strict=True))
    except (OSError, RuntimeError) as error:
        raise PortalError(f"{label} is unavailable") from error
    return resolved


def _canonical_save(path: str, label: str) -> Path:
    _bounded_text(path, label, MAX_PATH_BYTES, allow_empty=False)
    if not os.path.isabs(path):
        raise PortalError(f"{label} must be absolute")
    lexical = Path(os.path.normpath(path))
    if lexical.name in {"", ".", ".."}:
        raise PortalError(f"{label} has no filename")
    try:
        parent = Path(os.path.realpath(lexical.parent, strict=True))
    except (OSError, RuntimeError) as error:
        raise PortalError(f"{label} parent is unavailable") from error
    candidate = parent / lexical.name
    if candidate.exists() or candidate.is_symlink():
        try:
            candidate = Path(os.path.realpath(candidate, strict=True))
        except (OSError, RuntimeError) as error:
            raise PortalError(f"{label} is unavailable") from error
    return candidate


@dataclass(frozen=True)
class PortalPolicy:
    project: Path
    home: Path
    output: Path
    project_access: str

    @classmethod
    def create(cls, project: str, home: str, output: str, project_access: str) -> "PortalPolicy":
        if project_access not in {"readonly", "readwrite"}:
            raise PortalError("project access must be readonly or readwrite")
        roots: list[Path] = []
        for raw, label in ((project, "project"), (home, "home"), (output, "output")):
            root = _canonical_existing(raw, label)
            try:
                info = root.lstat()
            except OSError as error:
                raise PortalError(f"{label} root is unavailable") from error
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise PortalError(f"{label} root is not a real directory")
            roots.append(root)
        if len(set(roots)) != len(roots):
            raise PortalError("portal roots must be distinct")
        return cls(roots[0], roots[1], roots[2], project_access)

    @property
    def open_roots(self) -> tuple[Path, ...]:
        return self.project, self.home, self.output

    @property
    def save_roots(self) -> tuple[Path, ...]:
        roots = [self.home, self.output]
        if self.project_access == "readwrite":
            roots.insert(0, self.project)
        return tuple(roots)

    def open_path(self, path: str, *, directory: bool = False) -> Path:
        candidate = _canonical_existing(path, "selected path")
        if not any(_contains(root, candidate) for root in self.open_roots):
            raise PortalError("selected path is outside the launch-local portal roots")
        if directory and not candidate.is_dir():
            raise PortalError("selected path is not a directory")
        if not directory and not candidate.is_file():
            raise PortalError("selected path is not a regular file")
        return candidate

    def save_path(self, path: str) -> Path:
        candidate = _canonical_save(path, "selected save path")
        if not any(_contains(root, candidate) for root in self.save_roots):
            raise PortalError("selected save path is outside the writable portal roots")
        if candidate.exists():
            try:
                information = candidate.stat()
            except OSError as error:
                raise PortalError("selected save path is unavailable") from error
            if not stat.S_ISREG(information.st_mode):
                raise PortalError("selected save path is not a regular file")
        return candidate

    def save_folder(self, path: str) -> Path:
        candidate = _canonical_existing(path, "selected save folder")
        if not candidate.is_dir() or not any(_contains(root, candidate) for root in self.save_roots):
            raise PortalError("selected save folder is outside the writable portal roots")
        return candidate

    def initial_folder(self, value: Any, *, writable: bool) -> Path | None:
        try:
            candidate = _canonical_existing(_decode_path_bytes(value, "current_folder"), "current_folder")
        except PortalError:
            return None
        roots = self.save_roots if writable else self.open_roots
        return candidate if candidate.is_dir() and any(_contains(root, candidate) for root in roots) else None


@dataclass(frozen=True)
class FilterSpec:
    name: str
    rules: tuple[tuple[int, str], ...]


@dataclass(frozen=True)
class ChoiceSpec:
    identifier: str
    label: str
    options: tuple[tuple[str, str], ...]
    initial: str


@dataclass(frozen=True)
class RequestSpec:
    method: str
    sender: str
    handle: str
    title: str
    parent_window: str
    modal: bool
    multiple: bool
    directory: bool
    accept_label: str
    initial_folder: Path | None
    current_name: str | None
    current_file: Path | None
    filters: tuple[FilterSpec, ...]
    current_filter: FilterSpec | None
    choices: tuple[ChoiceSpec, ...]
    files: tuple[str, ...]


def _parse_filters(value: Any) -> tuple[FilterSpec, ...]:
    if value is None:
        return ()
    value = _deep_unbox(value)
    if not isinstance(value, (list, tuple)) or len(value) > MAX_FILTERS:
        raise PortalError("filters must be a bounded array")
    result: list[FilterSpec] = []
    for index, item in enumerate(value):
        if not isinstance(item, (list, tuple)) or len(item) != 2:
            raise PortalError(f"filters[{index}] has an invalid structure")
        name = _bounded_text(item[0], f"filters[{index}].name", MAX_FILTER_TEXT_BYTES, allow_empty=False)
        raw_rules = item[1]
        if not isinstance(raw_rules, (list, tuple)) or not raw_rules or len(raw_rules) > MAX_FILTER_RULES:
            raise PortalError(f"filters[{index}].rules must be bounded and non-empty")
        rules: list[tuple[int, str]] = []
        for rule_index, rule in enumerate(raw_rules):
            if not isinstance(rule, (list, tuple)) or len(rule) != 2 or rule[0] not in {0, 1}:
                raise PortalError(f"filters[{index}].rules[{rule_index}] is invalid")
            text = _bounded_text(
                rule[1], f"filters[{index}].rules[{rule_index}]", MAX_FILTER_TEXT_BYTES, allow_empty=False
            )
            rules.append((int(rule[0]), text))
        result.append(FilterSpec(name, tuple(rules)))
    return tuple(result)


def _parse_filter(value: Any) -> FilterSpec | None:
    if value is None:
        return None
    parsed = _parse_filters([_deep_unbox(value)])
    return parsed[0]


def _parse_choices(value: Any) -> tuple[ChoiceSpec, ...]:
    if value is None:
        return ()
    value = _deep_unbox(value)
    if not isinstance(value, (list, tuple)) or len(value) > MAX_CHOICES:
        raise PortalError("choices must be a bounded array")
    result: list[ChoiceSpec] = []
    seen: set[str] = set()
    for index, item in enumerate(value):
        if not isinstance(item, (list, tuple)) or len(item) != 4:
            raise PortalError(f"choices[{index}] has an invalid structure")
        identifier = _bounded_text(item[0], f"choices[{index}].id", MAX_CHOICE_TEXT_BYTES, allow_empty=False)
        if not TOKEN_RE.fullmatch(identifier) or identifier in seen:
            raise PortalError(f"choices[{index}].id is invalid or duplicated")
        seen.add(identifier)
        label = _bounded_text(item[1], f"choices[{index}].label", MAX_CHOICE_TEXT_BYTES, allow_empty=False)
        raw_options = item[2]
        if not isinstance(raw_options, (list, tuple)) or len(raw_options) > MAX_CHOICE_OPTIONS:
            raise PortalError(f"choices[{index}].options must be bounded")
        options: list[tuple[str, str]] = []
        option_ids: set[str] = set()
        for option_index, option in enumerate(raw_options):
            if not isinstance(option, (list, tuple)) or len(option) != 2:
                raise PortalError(f"choices[{index}].options[{option_index}] is invalid")
            option_id = _bounded_text(
                option[0], f"choices[{index}].options[{option_index}].id", MAX_CHOICE_TEXT_BYTES, allow_empty=False
            )
            option_label = _bounded_text(
                option[1], f"choices[{index}].options[{option_index}].label", MAX_CHOICE_TEXT_BYTES, allow_empty=False
            )
            if option_id in option_ids:
                raise PortalError(f"choices[{index}] contains a duplicate option id")
            option_ids.add(option_id)
            options.append((option_id, option_label))
        initial = _bounded_text(item[3], f"choices[{index}].initial", MAX_CHOICE_TEXT_BYTES)
        if options and initial and initial not in option_ids:
            raise PortalError(f"choices[{index}].initial is not an option")
        if not options and initial not in {"", "true", "false"}:
            raise PortalError(f"choices[{index}].initial must be true or false")
        result.append(ChoiceSpec(identifier, label, tuple(options), initial))
    return tuple(result)


def _parse_files(value: Any) -> tuple[str, ...]:
    if value is None:
        raise PortalError("SaveFiles requires files")
    value = _deep_unbox(value)
    if not isinstance(value, (list, tuple)) or not value or len(value) > MAX_SAVE_FILES:
        raise PortalError("files must be a bounded non-empty array")
    result: list[str] = []
    for index, item in enumerate(value):
        name = _decode_path_bytes(item, f"files[{index}]")
        if name in {"", ".", ".."} or os.path.basename(name) != name or "/" in name:
            raise PortalError(f"files[{index}] must be one filename")
        if len(os.fsencode(name)) > MAX_FILENAME_BYTES:
            raise PortalError(f"files[{index}] exceeds the filename byte policy")
        result.append(name)
    return tuple(result)


def _request_handle(sender: str, token: str | None) -> str:
    if not isinstance(sender, str) or not sender.startswith(":"):
        raise PortalError("portal request has no private-bus sender identity")
    sender_part = sender[1:].replace(".", "_")
    if not TOKEN_RE.fullmatch(sender_part):
        raise PortalError("portal request sender identity is invalid")
    if token is None:
        token = "sandcodex_" + secrets.token_hex(16)
    token = _bounded_text(token, "handle_token", MAX_TOKEN_BYTES, allow_empty=False)
    if not TOKEN_RE.fullmatch(token):
        raise PortalError("handle_token is not a valid object-path element")
    return f"{DESKTOP_PATH}/request/{sender_part}/{token}"


def _disconnected_unique_name(parameters: Any) -> str | None:
    """Return the vanished private-bus unique name represented by a signal."""
    try:
        name, old_owner, new_owner = _deep_unbox(parameters)
    except Exception:
        return None
    if (
        not isinstance(name, str)
        or not name.startswith(":")
        or old_owner != name
        or new_owner != ""
    ):
        return None
    return name


def _parse_request(
    method: str,
    sender: str,
    parent_window: Any,
    title: Any,
    options: Any,
    policy: PortalPolicy,
) -> RequestSpec:
    if method not in {"OpenFile", "SaveFile", "SaveFiles"}:
        raise PortalError("unsupported FileChooser method")
    parent = _parent_window(parent_window)
    title_text = _bounded_text(title, "title", MAX_TITLE_BYTES)
    options = _deep_unbox(options)
    _bounded_variant_tree(options)
    if not isinstance(options, dict) or any(not isinstance(key, str) for key in options):
        raise PortalError("options must be a string-keyed vardict")

    token = options.get("handle_token")
    if token is not None:
        token = _bounded_text(token, "handle_token", MAX_TOKEN_BYTES, allow_empty=False)
    handle = _request_handle(sender, token)
    modal = options.get("modal", True)
    if not isinstance(modal, bool):
        raise PortalError("modal must be boolean")
    multiple = options.get("multiple", False) if method == "OpenFile" else False
    directory = options.get("directory", False) if method == "OpenFile" else False
    if not isinstance(multiple, bool) or not isinstance(directory, bool):
        raise PortalError("multiple and directory must be boolean")
    accept_label = options.get("accept_label", "_Open" if method == "OpenFile" else "_Save")
    accept_label = _bounded_text(accept_label, "accept_label", MAX_CHOICE_TEXT_BYTES, allow_empty=False)
    filters = _parse_filters(options.get("filters"))
    current_filter = _parse_filter(options.get("current_filter"))
    choices = _parse_choices(options.get("choices"))
    writable = method in {"SaveFile", "SaveFiles"}
    initial_folder = policy.initial_folder(options["current_folder"], writable=writable) if "current_folder" in options else None

    current_name: str | None = None
    current_file: Path | None = None
    files: tuple[str, ...] = ()
    if method == "SaveFile":
        if "current_name" in options:
            current_name = _bounded_text(options["current_name"], "current_name", MAX_FILENAME_BYTES)
            if current_name in {".", ".."} or "/" in current_name:
                raise PortalError("current_name must be one filename")
        if "current_file" in options:
            try:
                candidate = policy.save_path(_decode_path_bytes(options["current_file"], "current_file"))
            except PortalError:
                candidate = None
            current_file = candidate
    elif method == "SaveFiles":
        files = _parse_files(options.get("files"))

    return RequestSpec(
        method=method,
        sender=sender,
        handle=handle,
        title=title_text or ("Open File" if method == "OpenFile" else "Save File"),
        parent_window=parent,
        modal=modal,
        multiple=multiple,
        directory=directory,
        accept_label=accept_label,
        initial_folder=initial_folder,
        current_name=current_name,
        current_file=current_file,
        filters=filters,
        current_filter=current_filter,
        choices=choices,
        files=files,
    )


def _parse_external_options(
    options: Any,
    label: str,
    *,
    writable: bool,
    ask: bool,
    activation_token: bool,
) -> tuple[str | None, bool]:
    """Validate the bounded standard options advertised by OpenURI v5.

    Sandcodex has one pre-authorized exact handler, so ``ask=true`` cannot be
    honored without adding ambient app-choice authority and is rejected rather
    than silently ignored. Activation tokens remain opaque, bounded metadata;
    the private compositor does not import host activation authority.
    """
    value = _deep_unbox(options)
    _bounded_variant_tree(value)
    if not isinstance(value, dict) or any(not isinstance(key, str) for key in value):
        raise PortalError(f"{label} options must be a string-keyed vardict")
    allowed = {"handle_token"}
    if writable:
        allowed.add("writable")
    if ask:
        allowed.add("ask")
    if activation_token:
        allowed.add("activation_token")
    unknown = set(value) - allowed
    if unknown:
        raise PortalError(f"{label} options contain unsupported keys")
    token = value.get("handle_token")
    if token is not None:
        token = _bounded_text(token, "handle_token", MAX_TOKEN_BYTES, allow_empty=False)
    requested_writable = value.get("writable", False)
    if not isinstance(requested_writable, bool):
        raise PortalError(f"{label} writable must be boolean")
    ask_value = value.get("ask", False)
    if not isinstance(ask_value, bool):
        raise PortalError(f"{label} ask must be boolean")
    if ask_value:
        raise PortalError(f"{label} cannot ask for an ambient application chooser")
    activation = value.get("activation_token")
    if activation is not None:
        activation = _bounded_text(
            activation,
            f"{label} activation_token",
            MAX_ACTIVATION_TOKEN_BYTES,
        )
        if any(ord(character) < 0x20 or ord(character) == 0x7F for character in activation):
            raise PortalError(f"{label} activation_token contains control characters")
    return token, requested_writable


def _parse_open_uri_request(
    sender: str,
    parent_window: Any,
    uri: Any,
    options: Any,
    policy: OpenUriPolicy,
) -> OpenUriRequestSpec:
    parent = _parent_window(parent_window)
    token, requested_writable = _parse_external_options(
        options,
        "OpenURI",
        writable=True,
        ask=True,
        activation_token=True,
    )
    if requested_writable:
        raise PortalError("writable OpenURI requests are intentionally unsupported")
    return OpenUriRequestSpec(
        sender=sender,
        handle=_request_handle(sender, token),
        parent_window=parent,
        uri=policy.normalize_uri(uri),
    )


def _parse_open_file_request(
    sender: str,
    parent_window: Any,
    descriptor_index: Any,
    options: Any,
    policy: OpenFilePolicy,
    invocation: Any,
) -> OpenFileRequestSpec:
    parent = _parent_window(parent_window)
    if not isinstance(descriptor_index, int) or isinstance(descriptor_index, bool) or descriptor_index < 0:
        raise PortalError("OpenFile descriptor index must be a non-negative integer")
    token, requested_writable = _parse_external_options(
        options,
        "OpenFile",
        writable=True,
        ask=True,
        activation_token=True,
    )
    access = policy.requested_access(requested_writable)
    # Validate the request identity before taking custody of a Unix descriptor.
    # An invalid token must not leave a sealed snapshot or retained writable FD
    # behind in the long-lived private portal process.
    handle = _request_handle(sender, token)
    descriptor, transfer = _receive_open_file_descriptor(
        invocation,
        descriptor_index,
        access,
        policy.readonly_maximum_bytes,
    )
    return OpenFileRequestSpec(
        sender=sender,
        handle=handle,
        parent_window=parent,
        descriptor=descriptor,
        access=access,
        transfer=transfer,
    )


def _parse_open_directory_request(
    sender: str,
    parent_window: Any,
    descriptor_index: Any,
    options: Any,
    invocation: Any,
    portal_policy: PortalPolicy,
) -> OpenDirectoryRequestSpec:
    parent = _parent_window(parent_window)
    if not isinstance(descriptor_index, int) or isinstance(descriptor_index, bool) or descriptor_index < 0:
        raise PortalError("OpenDirectory descriptor index must be a non-negative integer")
    token, _requested_writable = _parse_external_options(
        options,
        "OpenDirectory",
        writable=False,
        ask=False,
        activation_token=True,
    )
    handle = _request_handle(sender, token)
    (
        object_descriptor,
        directory_descriptor,
        object_kind,
        selected_name,
        object_device,
        object_inode,
        directory_device,
        directory_inode,
    ) = _receive_open_directory_descriptors(invocation, descriptor_index, portal_policy)
    return OpenDirectoryRequestSpec(
        sender=sender,
        handle=handle,
        parent_window=parent,
        object_descriptor=object_descriptor,
        directory_descriptor=directory_descriptor,
        object_kind=object_kind,
        selected_name=selected_name,
        object_device=object_device,
        object_inode=object_inode,
        directory_device=directory_device,
        directory_inode=directory_inode,
    )


def _scheme_supported_request(scheme: Any, options: Any, policy: OpenUriPolicy | None) -> bool:
    value = _deep_unbox(options)
    _bounded_variant_tree(value)
    if not isinstance(value, dict) or value:
        raise PortalError("SchemeSupported options must be an empty vardict")
    normalized = _bounded_text(
        scheme,
        "scheme",
        MAX_URI_SCHEME_BYTES,
        allow_empty=False,
    ).casefold()
    if URI_SCHEME_RE.fullmatch(normalized) is None:
        raise PortalError("scheme is invalid")
    return policy is not None and normalized not in DENIED_URI_SCHEMES and normalized in policy.schemes


def _sealed_readonly_snapshot(source: int, maximum_bytes: int) -> int:
    """Return an O_RDONLY descriptor for one immutable memfd snapshot."""
    before = os.fstat(source)
    if not stat.S_ISREG(before.st_mode):
        raise PortalError("OpenFile accepts regular files only")
    if before.st_size < 0 or before.st_size > maximum_bytes:
        raise PortalError("OpenFile read-only snapshot exceeds its launch byte ceiling")
    writable = -1
    readonly = -1
    try:
        try:
            writable = os.memfd_create(
                "sandcodex-open-file",
                os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING | MFD_NOEXEC_SEAL,
            )
        except OSError as error:
            if error.errno == errno.EINVAL:
                raise PortalError(
                    "OpenFile read-only snapshots require Linux MFD_NOEXEC_SEAL support"
                ) from error
            raise
        os.fchmod(writable, 0o600)
        initial = os.fstat(writable)
        initial_seals = fcntl.fcntl(writable, fcntl.F_GET_SEALS)
        if (initial.st_mode & 0o777) != 0o600 or (initial_seals & F_SEAL_EXEC) != F_SEAL_EXEC:
            raise PortalError("OpenFile read-only snapshot did not start non-executable")
        offset = 0
        while offset < before.st_size:
            amount = min(OPEN_FILE_COPY_CHUNK_BYTES, before.st_size - offset)
            chunk = os.pread(source, amount, offset)
            if not chunk:
                raise PortalError("OpenFile source changed while its read-only snapshot was copied")
            written = 0
            while written < len(chunk):
                count = os.pwrite(writable, chunk[written:], offset + written)
                if count <= 0:
                    raise PortalError("OpenFile read-only snapshot could not be written")
                written += count
            offset += len(chunk)
        after = os.fstat(source)
        if (
            before.st_dev != after.st_dev
            or before.st_ino != after.st_ino
            or stat.S_IFMT(before.st_mode) != stat.S_IFMT(after.st_mode)
            or before.st_size != after.st_size
            or before.st_mtime_ns != after.st_mtime_ns
            or before.st_ctime_ns != after.st_ctime_ns
        ):
            raise PortalError("OpenFile source changed while its read-only snapshot was copied")
        snapshot = os.fstat(writable)
        if (
            not stat.S_ISREG(snapshot.st_mode)
            or snapshot.st_size != before.st_size
            or (snapshot.st_mode & 0o777) != 0o600
        ):
            raise PortalError("OpenFile read-only snapshot identity is invalid")
        fcntl.fcntl(writable, fcntl.F_ADD_SEALS, OPEN_FILE_READONLY_SEALS)
        seals = fcntl.fcntl(writable, fcntl.F_GET_SEALS)
        if (seals & OPEN_FILE_READONLY_SEALS) != OPEN_FILE_READONLY_SEALS:
            raise PortalError("OpenFile read-only snapshot seals were not retained")
        readonly = os.open(f"/proc/self/fd/{writable}", os.O_RDONLY | os.O_CLOEXEC)
        reopened = os.fstat(readonly)
        if (
            snapshot.st_dev != reopened.st_dev
            or snapshot.st_ino != reopened.st_ino
            or stat.S_IFMT(snapshot.st_mode) != stat.S_IFMT(reopened.st_mode)
            or (reopened.st_mode & 0o777) != 0o600
        ):
            raise PortalError("OpenFile read-only snapshot identity changed during sealing")
        if (fcntl.fcntl(readonly, fcntl.F_GETFL) & os.O_ACCMODE) != os.O_RDONLY:
            raise PortalError("OpenFile read-only snapshot descriptor is not O_RDONLY")
        if (
            fcntl.fcntl(readonly, fcntl.F_GET_SEALS) & OPEN_FILE_READONLY_SEALS
        ) != OPEN_FILE_READONLY_SEALS:
            raise PortalError("OpenFile read-only snapshot lost its seals")
        os.set_inheritable(readonly, False)
        result = readonly
        readonly = -1
        return result
    except PortalError:
        raise
    except Exception as error:
        raise PortalError("OpenFile read-only snapshot could not be sealed") from error
    finally:
        if readonly >= 0:
            with contextlib_suppress(OSError):
                os.close(readonly)
        if writable >= 0:
            with contextlib_suppress(OSError):
                os.close(writable)


def _receive_open_file_descriptor(
    invocation: Any,
    descriptor_index: int,
    access: str,
    readonly_maximum_bytes: int,
) -> tuple[int, str]:
    """Retain one D-Bus file descriptor without granting broader authority.

    ``GUnixFDList.get`` returns a caller-owned duplicate. We validate the
    supplied kernel object. O_RDWR requests retain the same open file
    description with close-on-exec. O_RDONLY requests become immutable,
    size-bounded memfd snapshots before a child receives a reopenable
    ``/proc/self/fd`` path.
    """
    received = -1
    retained = -1
    try:
        message = invocation.get_message()
        if message is None:
            raise PortalError("OpenFile invocation has no D-Bus message")
        descriptor_list = message.get_unix_fd_list()
        if descriptor_list is None:
            raise PortalError("OpenFile request did not carry a Unix descriptor list")
        descriptor_count = descriptor_list.get_length()
        if descriptor_count != 1:
            raise PortalError("OpenFile request must carry exactly one Unix descriptor")
        if descriptor_index != 0 or descriptor_index >= descriptor_count:
            raise PortalError("OpenFile descriptor index is outside the received list")
        received = descriptor_list.get(descriptor_index)
        if not isinstance(received, int) or received < 0:
            raise PortalError("OpenFile descriptor could not be received")
        flags = fcntl.fcntl(received, fcntl.F_GETFL)
        if hasattr(os, "O_PATH") and (flags & os.O_PATH):
            raise PortalError("OpenFile O_PATH descriptors are intentionally unsupported")
        expected_mode = os.O_RDONLY if access == "readonly" else os.O_RDWR
        if (flags & os.O_ACCMODE) != expected_mode:
            raise PortalError(f"OpenFile descriptor does not carry exact {access} access")
        before = os.fstat(received)
        if not stat.S_ISREG(before.st_mode):
            raise PortalError("OpenFile accepts regular files only")
        if access == "readonly":
            result = _sealed_readonly_snapshot(received, readonly_maximum_bytes)
            return result, "sealed-memfd-snapshot"
        retained = fcntl.fcntl(received, fcntl.F_DUPFD_CLOEXEC, 3)
        after = os.fstat(retained)
        if (
            before.st_dev != after.st_dev
            or before.st_ino != after.st_ino
            or stat.S_IFMT(before.st_mode) != stat.S_IFMT(after.st_mode)
        ):
            raise PortalError("OpenFile descriptor identity changed while it was retained")
        os.set_inheritable(retained, False)
        result = retained
        retained = -1
        return result, "retained-original-fd"
    except PortalError:
        raise
    except Exception as error:
        raise PortalError("OpenFile descriptor could not be retained") from error
    finally:
        if retained >= 0:
            with contextlib_suppress(OSError):
                os.close(retained)
        if received >= 0:
            with contextlib_suppress(OSError):
                os.close(received)


def _same_object(left: os.stat_result, right: os.stat_result) -> bool:
    return (
        left.st_dev == right.st_dev
        and left.st_ino == right.st_ino
        and stat.S_IFMT(left.st_mode) == stat.S_IFMT(right.st_mode)
    )


def _retain_open_directory_target(
    source: int,
    portal_policy: PortalPolicy,
) -> tuple[int, int, str, str, int, int, int, int]:
    """Pin one selected object and its containing capsule directory.

    The procfs link is used only to locate the capsule-visible directory entry.
    Authority remains bound to the caller's exact kernel object and to a second
    independently opened directory descriptor. Both identities are rechecked
    after acquisition. No pathname is passed to the child.
    """
    retained_object = -1
    retained_directory = -1
    try:
        if not isinstance(source, int) or source < 0:
            raise PortalError("OpenDirectory source descriptor is invalid")
        flags = fcntl.fcntl(source, fcntl.F_GETFL)
        is_path = bool(hasattr(os, "O_PATH") and (flags & os.O_PATH))
        if not is_path and (flags & os.O_ACCMODE) != os.O_RDONLY:
            raise PortalError("OpenDirectory accepts only O_RDONLY or O_PATH descriptors")
        before = os.fstat(source)
        if stat.S_ISREG(before.st_mode):
            object_kind = "regular"
        elif stat.S_ISDIR(before.st_mode):
            object_kind = "directory"
        else:
            raise PortalError("OpenDirectory accepts regular files or directories only")

        try:
            link = os.readlink(f"/proc/self/fd/{source}")
        except OSError as error:
            raise PortalError("OpenDirectory descriptor has no capsule-visible path") from error
        if not link.startswith("/") or link.endswith(" (deleted)"):
            raise PortalError("OpenDirectory descriptor is not a live capsule path")
        candidate = _canonical_existing(link, "OpenDirectory descriptor path")
        if not any(_contains(root, candidate) for root in portal_policy.open_roots):
            raise PortalError("OpenDirectory descriptor is outside the launch-local portal roots")
        path_metadata = candidate.lstat()
        if stat.S_ISLNK(path_metadata.st_mode) or not _same_object(before, path_metadata):
            raise PortalError("OpenDirectory descriptor path does not identify the retained object")

        roots = set(portal_policy.open_roots)
        if object_kind == "directory" and candidate in roots:
            directory_path = candidate
            selected_name = ""
        else:
            directory_path = candidate.parent
            selected_name = candidate.name
        if not any(_contains(root, directory_path) for root in portal_policy.open_roots):
            raise PortalError("OpenDirectory containing directory is outside the portal roots")
        encoded_name = os.fsencode(selected_name)
        if len(encoded_name) > MAX_FILENAME_BYTES or b"\0" in encoded_name:
            raise PortalError("OpenDirectory selected basename exceeds its bounded policy")

        directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            directory_flags |= os.O_NOFOLLOW
        retained_directory = os.open(directory_path, directory_flags)
        directory_metadata = os.fstat(retained_directory)
        if not stat.S_ISDIR(directory_metadata.st_mode):
            raise PortalError("OpenDirectory containing object is no longer a directory")
        current_directory_metadata = directory_path.lstat()
        if stat.S_ISLNK(current_directory_metadata.st_mode) or not _same_object(
            directory_metadata, current_directory_metadata
        ):
            raise PortalError("OpenDirectory containing directory changed during acquisition")

        retained_object = fcntl.fcntl(source, fcntl.F_DUPFD_CLOEXEC, 3)
        object_metadata = os.fstat(retained_object)
        if not _same_object(before, object_metadata):
            raise PortalError("OpenDirectory object identity changed while it was retained")
        if retained_object == retained_directory:
            raise PortalError("OpenDirectory descriptor custody did not remain distinct")

        if selected_name:
            try:
                selected_metadata = os.stat(
                    selected_name,
                    dir_fd=retained_directory,
                    follow_symlinks=False,
                )
            except OSError as error:
                raise PortalError("OpenDirectory selected entry changed during acquisition") from error
            if stat.S_ISLNK(selected_metadata.st_mode) or not _same_object(
                object_metadata, selected_metadata
            ):
                raise PortalError("OpenDirectory selected entry no longer identifies the object")
        elif not _same_object(object_metadata, directory_metadata):
            raise PortalError("OpenDirectory root-directory fallback lost object identity")

        os.set_inheritable(retained_object, False)
        os.set_inheritable(retained_directory, False)
        result = (
            retained_object,
            retained_directory,
            object_kind,
            selected_name,
            int(object_metadata.st_dev),
            int(object_metadata.st_ino),
            int(directory_metadata.st_dev),
            int(directory_metadata.st_ino),
        )
        retained_object = -1
        retained_directory = -1
        return result
    except PortalError:
        raise
    except Exception as error:
        raise PortalError("OpenDirectory descriptors could not be retained") from error
    finally:
        if retained_object >= 0:
            with contextlib_suppress(OSError):
                os.close(retained_object)
        if retained_directory >= 0:
            with contextlib_suppress(OSError):
                os.close(retained_directory)


def _receive_open_directory_descriptors(
    invocation: Any,
    descriptor_index: int,
    portal_policy: PortalPolicy,
) -> tuple[int, int, str, str, int, int, int, int]:
    received = -1
    try:
        message = invocation.get_message()
        if message is None:
            raise PortalError("OpenDirectory invocation has no D-Bus message")
        descriptor_list = message.get_unix_fd_list()
        if descriptor_list is None:
            raise PortalError("OpenDirectory request did not carry a Unix descriptor list")
        descriptor_count = descriptor_list.get_length()
        if descriptor_count != 1:
            raise PortalError("OpenDirectory request must carry exactly one Unix descriptor")
        if descriptor_index != 0 or descriptor_index >= descriptor_count:
            raise PortalError("OpenDirectory descriptor index is outside the received list")
        received = descriptor_list.get(descriptor_index)
        if not isinstance(received, int) or received < 0:
            raise PortalError("OpenDirectory descriptor could not be received")
