+	double sy[SANDCODEX_TOUCH_STROKE_MAX_POINTS] = {0};
+	bool same_path = true;
+	for (uint32_t index = 0; index <= steps; ++index) {
+		int64_t x = sandcodex_touch_stroke_coordinate(start_x, end_x,
