import os
from pathlib import Path
import signal
import stat
import subprocess
import sys

if len(sys.argv) < 4:
    raise SystemExit("sandcodex-jail: invalid deadline-runner invocation")
try:
    seconds = int(sys.argv[1])
except ValueError:
    raise SystemExit("sandcodex-jail: invalid deadline")
if not 1 <= seconds <= 604800:
    raise SystemExit("sandcodex-jail: invalid deadline")
marker = Path(sys.argv[2])
parent = marker.parent
info = parent.lstat()
if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
        stat.S_IMODE(info.st_mode) != 0o700 or marker.name != "deadline-exceeded"):
    raise SystemExit("sandcodex-jail: unsafe deadline marker")
if marker.exists() or marker.is_symlink():
    raise SystemExit("sandcodex-jail: deadline marker already exists")

process = subprocess.Popen(sys.argv[3:], close_fds=True)

def forward(signum, _frame):
    try:
        process.send_signal(signum)
    except ProcessLookupError:
        pass

for watched in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(watched, forward)

timed_out = False
try:
    status = process.wait(timeout=seconds)
except subprocess.TimeoutExpired:
    timed_out = True
    descriptor = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
    os.close(descriptor)
    process.terminate()
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
    status = 124
if timed_out:
    raise SystemExit(124)
if status < 0:
    status = 128 + (-status)
# Status 124 is reserved for the broker-proven deadline outcome.
raise SystemExit(125 if status == 124 else min(status, 255))
