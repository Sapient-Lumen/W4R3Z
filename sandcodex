            "baseline_paths_exposed": False,
            "baseline_paths_persisted": False,
            "stable_content_fingerprint_retained": False,
        }
        watch_fence["output_watch_seal"] = publication
        result["publication_seal"] = {
            key: publication[key]
            for key in (
                "publication_status",
                "publication_order",
                "compositor_event_chain_sha256",
                "dispatch_complete_sequence",
