}

sc_stop_operator_stack() {
  local supervisor_wait_tenths=150
  if [[ "$SC_OPERATOR_STOP_GRACE_SECONDS" =~ ^[1-9][0-9]{0,2}$ ]] &&
      (( SC_OPERATOR_STOP_GRACE_SECONDS <= SC_OPERATOR_STOP_GRACE_MAX_SECONDS )); then
    # The supervisor waits once for TERM and once to prove KILL/reap. Give its
    # own close path another five seconds before the launcher intervenes.
    supervisor_wait_tenths=$(( (SC_OPERATOR_STOP_GRACE_SECONDS * 2 + 5) * 10 ))
  fi
  if [[ -n "$SC_OPERATOR_INGRESS_PID" ]]; then
    sc_stop_tracked_pid "$SC_OPERATOR_INGRESS_PID" "$SC_OPERATOR_INGRESS_START" TERM
    wait "$SC_OPERATOR_INGRESS_PID" 2>/dev/null || true
    SC_OPERATOR_INGRESS_PID=""; SC_OPERATOR_INGRESS_START=""
  fi
  if [[ -n "$SC_OPERATOR_SERVICE_PID" ]]; then
    sc_stop_tracked_pid "$SC_OPERATOR_SERVICE_PID" "$SC_OPERATOR_SERVICE_START" \
      TERM "$supervisor_wait_tenths"
    wait "$SC_OPERATOR_SERVICE_PID" 2>/dev/null || true
    SC_OPERATOR_SERVICE_PID=""; SC_OPERATOR_SERVICE_START=""
  fi
  if [[ -n "$SC_OPERATOR_LOCATOR" && -n "$SC_OPERATOR_LOCATOR_IDENTITY" && \
    -f "$SC_OPERATOR_LOCATOR" && ! -L "$SC_OPERATOR_LOCATOR" && \
    "$(stat -c '%d:%i' -- "$SC_OPERATOR_LOCATOR" 2>/dev/null || true)" == "$SC_OPERATOR_LOCATOR_IDENTITY" && \
    "$(jq -r '.run_id // empty' "$SC_OPERATOR_LOCATOR" 2>/dev/null || true)" == "$SC_RUN_ID" ]]; then
    unlink -- "$SC_OPERATOR_LOCATOR" 2>/dev/null || true
  fi
}

sc_bpf_insn() {
  local code="$1" jt="$2" jf="$3" value="$4" encoded
  printf -v encoded '\\%03o\\%03o\\%03o\\%03o\\%03o\\%03o\\%03o\\%03o' \
    "$(( code & 255 ))" "$(( (code >> 8) & 255 ))" "$jt" "$jf" \
    "$(( value & 255 ))" "$(( (value >> 8) & 255 ))" \
    "$(( (value >> 16) & 255 ))" "$(( (value >> 24) & 255 ))"
  printf '%b' "$encoded"
}

sc_seccomp_filter() {
  local output="$SC_RUN_ROOT/seccomp.bpf" arch syscall_mask add_key request_key keyctl
  [[ ! -e "$output" && ! -L "$output" ]] || return 0
  case "$(uname -m)" in
    x86_64) arch=$(( 0xc000003e )); syscall_mask=$(( 0xbfffffff )); add_key=248; request_key=249; keyctl=250 ;;
    aarch64) arch=$(( 0xc00000b7 )); syscall_mask=$(( 0xffffffff )); add_key=217; request_key=218; keyctl=219 ;;
    *) sc_die "safe mode has no seccomp policy for architecture: $(uname -m)" ;;
  esac
  {
    sc_bpf_insn 0x20 0 0 4
    sc_bpf_insn 0x15 1 0 "$arch"
    sc_bpf_insn 0x06 0 0 0x80000000
    sc_bpf_insn 0x20 0 0 0
    sc_bpf_insn 0x54 0 0 "$syscall_mask"
    sc_bpf_insn 0x15 0 1 "$keyctl"
    sc_bpf_insn 0x06 0 0 0x00050001
    sc_bpf_insn 0x15 0 1 "$add_key"
    sc_bpf_insn 0x06 0 0 0x00050001
    sc_bpf_insn 0x15 0 1 "$request_key"
    sc_bpf_insn 0x06 0 0 0x00050001
    sc_bpf_insn 0x06 0 0 0x7fff0000
  } >"$output"
  chmod 600 -- "$output"
  [[ "$(stat -c %s -- "$output")" == 96 ]] || sc_die "internal seccomp filter encoding failed"
}

sc_write_agent_loopback_relay() {
  (( SC_BROWSER )) || return 0
