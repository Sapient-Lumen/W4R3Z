            "dispatch_atomicity", "time_scope", "delta_scope", "target_kind",
            "container_id", "view_pid", "surface_resource_id",
            "surface_client_pid", "surface_client_uid", "surface_client_gid",
            "surface_class", "shell", "sandbox_engine", "sandbox_app_id",
            "sandbox_instance_id",
        }
        if not isinstance(value, dict) or set(value) != expected_fields:
            raise RuntimeError("Sway compositor touchpad-swipe arm reply is malformed")
        required = {
            "schema": SWAY_HIT_TEST_SCHEMA,
            "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
            "success": True,
            "authorized": True,
            "operation": "arm-touchpad-swipe",
            "x": x,
            "y": y,
            "delta_x": delta_x,
            "delta_y": delta_y,
            "fingers": fingers,
            "steps": steps,
            "duration_milliseconds": duration_milliseconds,
            "recipient_armed": True,
            "lifetime_revocation_armed": True,
            "modifier_quiet": True,
            "target_scope": "exact-destroy-watched-focused-client-surface",
            "route_scope": COMPOSITOR_TOUCHPAD_SWIPE_ROUTE_SCOPE,
            "dispatch_atomicity": GUARDED_TOUCHPAD_SWIPE_DISPATCH_ATOMICITY,
            "time_scope": COMPOSITOR_TOUCHPAD_SWIPE_TIME_SCOPE,
            "delta_scope": COMPOSITOR_TOUCHPAD_SWIPE_DELTA_SCOPE,
        }
        for field, expected in required.items():
            if value.get(field) != expected or type(value.get(field)) is not type(expected):
                raise RuntimeError(
                    f"Sway compositor touchpad-swipe {field} attestation is invalid"
                )
        adapted = dict(value)
        for field in (
            "authorized", "delta_x", "delta_y", "fingers", "steps",
            "duration_milliseconds", "recipient_armed",
            "lifetime_revocation_armed", "modifier_quiet", "target_scope", "route_scope",
            "dispatch_atomicity", "time_scope", "delta_scope",
        ):
            adapted.pop(field)
        adapted.update({"operation": "arm-click", "hit": True})
        target, ticket = self._normalize_hit_test_reply(
            adapted, x, y, expected_operation="arm-click"
        )
        if ticket is None:
            raise RuntimeError("Sway compositor touchpad-swipe arm omitted private authority")
        return target, ticket

