sc_proxy_start() {
  local ready=0
  SC_PROXY_SOCKET="$SC_PROXY_TMP/proxy.sock"
  if (( SC_DEV_NET )); then
    : >"$SC_RUN_ROOT/network-proxy.stderr"
    (
      sc_close_inherited_fds
      exec env -i PATH="$PATH" HOME="$SC_WORK/home" \
        "$SC_SETPRIV" --pdeathsig TERM python3 -P "$SC_JAIL_DATA/host-proxy.py" "$SC_PROXY_SOCKET"
    ) >>"$SC_RUN_ROOT/network-proxy.stderr" 2>&1 & SC_PROXY_PID=$!
    for _ in {1..200}; do
      if [[ -S "$SC_PROXY_SOCKET" && ! -L "$SC_PROXY_SOCKET" && \
        "$(stat -c %u:%a -- "$SC_PROXY_SOCKET" 2>/dev/null || true)" == "$(id -u):600" ]]; then
        ready=1
        break
      fi
      kill -0 "$SC_PROXY_PID" 2>/dev/null || break
      sleep 0.01
    done
    if (( ! ready )); then
      sed -n '1,80p' "$SC_RUN_ROOT/network-proxy.stderr" >&2
      return 1
    fi
    sc_log_event info proxy_ready "unrestricted network proxy is ready" "mode=unrestricted"
    return 0
  fi

  sc_proxy_filter
  for _ in {1..12}; do
    SC_PROXY_PORT=$(( 20000 + (RANDOM * 32768 + RANDOM) % 30000 ))
    sc_proxy_config
    : >"$SC_RUN_ROOT/squid.stderr"
    (
      sc_close_inherited_fds
      exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SQUID" -N -f "$SC_PROXY_TMP/squid.conf"
    ) >>"$SC_RUN_ROOT/squid.stderr" 2>&1 & SC_PROXY_PID=$!
    for _ in {1..100}; do
      kill -0 "$SC_PROXY_PID" 2>/dev/null || break
      if sc_tcp_ready "$SC_PROXY_PORT"; then ready=1; break; fi
      sleep 0.02
    done
    (( ready )) && break
    wait "$SC_PROXY_PID" 2>/dev/null || true; SC_PROXY_PID=""
  done
  if (( ! ready )); then
    sed -n '1,80p' "$SC_RUN_ROOT/squid.stderr" >&2
    return 1
  fi

  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SOCAT" "UNIX-LISTEN:$SC_PROXY_SOCKET,fork,mode=0600" \
      "TCP4:127.0.0.1:$SC_PROXY_PORT"
  ) >>"$SC_RUN_ROOT/socat-host.log" 2>&1 & SC_BRIDGE_PID=$!
  for _ in {1..100}; do
    kill -0 "$SC_BRIDGE_PID" 2>/dev/null || break
    [[ -S "$SC_PROXY_SOCKET" ]] && break
    sleep 0.02
  done
  [[ -S "$SC_PROXY_SOCKET" ]] || return 1
  sc_log_event info proxy_ready "provider-only proxy is ready" "domains=${#SC_DOMAINS[@]}" "port=$SC_PROXY_PORT"
}

