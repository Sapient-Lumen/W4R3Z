def recv_request(channel):
    data, ancillary, flags, _ = channel.recvmsg(MAX_REQUEST + 4, socket.CMSG_SPACE(3 * 4))
    rights = array.array("i")
    try:
        if flags & (socket.MSG_CTRUNC | socket.MSG_TRUNC):
            raise ValueError("truncated broker transport message")
        for level, kind, value in ancillary:
            if level != socket.SOL_SOCKET or kind != socket.SCM_RIGHTS:
                raise ValueError("unsupported broker ancillary message")
            usable = len(value) - (len(value) % rights.itemsize)
            rights.frombytes(value[:usable])
        if len(rights) != 3:
            raise ValueError("exactly three standard-I/O descriptors are required")
        while len(data) < 4:
            chunk = channel.recv(4 - len(data))
            if not chunk:
                raise ValueError("truncated broker request header")
            data += chunk
        length = struct.unpack("!I", data[:4])[0]
        if not 1 <= length <= MAX_REQUEST:
            raise ValueError("broker request size is invalid")
        payload = bytearray(data[4:])
        while len(payload) < length:
            chunk = channel.recv(length - len(payload))
            if not chunk:
                raise ValueError("truncated broker request")
            payload.extend(chunk)
        if len(payload) != length:
            raise ValueError("broker request has trailing bytes")
        return json.loads(bytes(payload)), list(rights)
    except BaseException:
        for fd in rights:
            os.close(fd)
        raise

