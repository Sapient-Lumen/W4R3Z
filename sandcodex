+static bool sandcodex_emit_tablet_pad_strip(struct wlr_surface *surface,
+        struct wl_client *target_client, uint32_t position_65535,
+        uint32_t mode_index) {
+    struct wlr_tablet_v2_tablet_pad *pad = sandcodex_stylus.pad_v2;
+    if (!surface || !surface->resource || !target_client ||
+            position_65535 >
+                SANDCODEX_TABLET_PAD_STRIP_MAX_POSITION_65535 ||
+            wl_resource_get_client(surface->resource) != target_client ||
+            !wlr_surface_accepts_tablet_v2(surface,
+                sandcodex_stylus.tablet_v2) ||
+            !sandcodex_tablet_pad_idle_at_mode(mode_index)) {
+        return false;
+    }
+    uint32_t time = get_current_time_in_msec();
+    uint32_t enter_serial = wlr_tablet_v2_tablet_pad_notify_enter(pad,
+        sandcodex_stylus.tablet_v2, surface);
+    bool entered = enter_serial != 0 && pad->current_client != NULL &&
+        pad->grab == &pad->default_grab && pad->group_count == 1 &&
+        pad->groups != NULL &&
+        pad->groups[SANDCODEX_TABLET_PAD_STRIP_GROUP_INDEX] ==
+            mode_index;
+    if (!entered) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    /* wlroots' enter helper emits the persistent current mode for every pad
+     * group before returning. The ticket-bound mode equality above therefore
+     * attests the exact mode visible to this recipient before strip input. */
+    double position = (double)position_65535 / 65535.0;
+    wlr_tablet_v2_tablet_pad_notify_strip(pad,
+        SANDCODEX_TABLET_PAD_STRIP_INDEX, position, true, time);
+    if (pad->current_client == NULL ||
+            pad->grab != &pad->default_grab) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    /* wlroots maps a negative position to zwp_tablet_pad_strip_v2.stop. */
+    wlr_tablet_v2_tablet_pad_notify_strip(pad,
+        SANDCODEX_TABLET_PAD_STRIP_INDEX, -1.0, true, time);
+    if (pad->current_client == NULL ||
+            pad->grab != &pad->default_grab) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    uint32_t leave_serial = wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+    /* wlroots 0.20 sends leave but intentionally leaves current_client set;
+     * Sway tracks focus separately. This synthetic one-shot pad owns no such
+     * persistent focus, so clear it synchronously before proving final idle. */
+    pad->current_client = NULL;
+    return leave_serial != 0 &&
+        sandcodex_tablet_pad_idle_at_mode(mode_index);
+}
