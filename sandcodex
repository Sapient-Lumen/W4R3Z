+static void sandcodex_arm_touch_stroke(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	json_object *duration_object = NULL, *end_x_object = NULL;
+	json_object *end_y_object = NULL, *start_x_object = NULL;
+	json_object *start_y_object = NULL, *steps_object = NULL;
+	sandcodex_clear_dispatch_ticket(client);
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		!client->sandcodex_modifier_arc.active &&
+		json_object_object_length(request) == 7 &&
+		sandcodex_request_operation(request, "arm-touch-stroke") &&
+		json_object_object_get_ex(request, "duration_milliseconds",
+			&duration_object) &&
+		json_object_object_get_ex(request, "end_x", &end_x_object) &&
+		json_object_object_get_ex(request, "end_y", &end_y_object) &&
+		json_object_object_get_ex(request, "start_x", &start_x_object) &&
+		json_object_object_get_ex(request, "start_y", &start_y_object) &&
+		json_object_object_get_ex(request, "steps", &steps_object) &&
+		json_object_is_type(duration_object, json_type_int) &&
+		json_object_is_type(end_x_object, json_type_int) &&
+		json_object_is_type(end_y_object, json_type_int) &&
+		json_object_is_type(start_x_object, json_type_int) &&
+		json_object_is_type(start_y_object, json_type_int) &&
+		json_object_is_type(steps_object, json_type_int);
+	int64_t duration_raw = valid_shape ? json_object_get_int64(duration_object) : 0;
+	int64_t end_x = valid_shape ? json_object_get_int64(end_x_object) : 0;
+	int64_t end_y = valid_shape ? json_object_get_int64(end_y_object) : 0;
+	int64_t start_x = valid_shape ? json_object_get_int64(start_x_object) : 0;
+	int64_t start_y = valid_shape ? json_object_get_int64(start_y_object) : 0;
+	int64_t steps_raw = valid_shape ? json_object_get_int64(steps_object) : 0;
+	uint32_t steps = steps_raw > 0 && steps_raw <= SANDCODEX_TOUCH_STROKE_MAX_STEPS
+		? (uint32_t)steps_raw : 0;
+	uint32_t duration_msec = duration_raw > 0 &&
+		duration_raw <= SANDCODEX_TOUCH_STROKE_MAX_DURATION_MSEC
+		? (uint32_t)duration_raw : 0;
+	bool canonical = valid_shape && steps != 0 && duration_msec >= steps + 1 &&
+		start_x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sandcodex_touch_stroke_arm_payload_canonical(payload, payload_length,
+			duration_msec, end_x, end_y, start_x, start_y, steps);
+	if (!canonical) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sandcodex_hit_target first_target = {0};
+	struct sway_view *first_view = NULL;
+	struct wlr_surface *first_view_surface = NULL;
+	struct wlr_surface *first_surface = NULL;
+	struct wlr_seat_client *first_client = NULL;
+	uintptr_t touch_resource_address = 0;
+	uint32_t touch_resource_id = 0;
+	uint64_t sx_bits[SANDCODEX_TOUCH_STROKE_MAX_POINTS] = {0};
+	uint64_t sy_bits[SANDCODEX_TOUCH_STROKE_MAX_POINTS] = {0};
+	bool path_valid = true;
+	for (uint32_t index = 0; index <= steps; ++index) {
+		int64_t x = sandcodex_touch_stroke_coordinate(start_x, end_x,
+			index, steps);
+		int64_t y = sandcodex_touch_stroke_coordinate(start_y, end_y,
+			index, steps);
+		struct sandcodex_hit_target target = {0};
+		struct sway_view *view = NULL;
+		struct wlr_surface *view_surface = NULL;
+		struct wlr_surface *surface = NULL;
+		struct wlr_seat_client *seat_client = NULL;
+		double sx = 0, sy = 0;
+		if (!sandcodex_capture_touch_target(seat, (double)x, (double)y,
+				&target, &view, &view_surface, &surface, &seat_client, &sx, &sy)) {
+			path_valid = false;
+			sandcodex_secure_clear(&target, sizeof(target));
+			break;
+		}
+		if (index == 0) {
+			first_target = target;
+			first_view = view;
+			first_view_surface = view_surface;
+			first_surface = surface;
+			first_client = seat_client;
+			path_valid = sandcodex_touch_recipient_exact(first_client, 0, 0,
+				&touch_resource_address, &touch_resource_id);
+		} else {
+			path_valid = sandcodex_hit_target_equal(&target, &first_target) &&
+				view == first_view && view_surface == first_view_surface &&
+				surface == first_surface && seat_client == first_client &&
+				sandcodex_touch_recipient_exact(first_client,
+					touch_resource_address, touch_resource_id, NULL, NULL);
+		}
+		sx_bits[index] = sandcodex_double_bits(sx);
+		sy_bits[index] = sandcodex_double_bits(sy);
+		sandcodex_secure_clear(&target, sizeof(target));
+		if (!path_valid) {
+			break;
+		}
+	}
+	if (!path_valid || !first_surface || !first_client ||
+			touch_resource_address == 0 || touch_resource_id == 0) {
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(sx_bits, sizeof(sx_bits));
+		sandcodex_secure_clear(sy_bits, sizeof(sy_bits));
+		sandcodex_send_hit_test_failure(client,
+			"touch-stroke-path-or-recipient-invalid");
+		return;
+	}
+
+	struct sandcodex_dispatch_ticket *grant = &client->sandcodex_dispatch_ticket;
+	char ticket[SANDCODEX_DISPATCH_TICKET_LENGTH + 1] = {0};
+	if (!sandcodex_random_ticket(ticket)) {
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(sx_bits, sizeof(sx_bits));
+		sandcodex_secure_clear(sy_bits, sizeof(sy_bits));
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-ticket-generation-failed");
+		return;
+	}
+	grant->armed = true;
+	grant->kind = SANDCODEX_DISPATCH_TOUCH_STROKE;
+	memcpy(grant->value, ticket, sizeof(grant->value));
+	grant->from_x = start_x;
+	grant->from_y = start_y;
+	grant->x = end_x;
+	grant->y = end_y;
+	grant->target = first_target;
+	grant->touch_stroke_steps = steps;
+	grant->touch_stroke_duration_msec = duration_msec;
+	memcpy(grant->touch_stroke_sx_bits, sx_bits,
+		(steps + 1) * sizeof(sx_bits[0]));
+	memcpy(grant->touch_stroke_sy_bits, sy_bits,
+		(steps + 1) * sizeof(sy_bits[0]));
+	grant->touch_grab_address = (uintptr_t)seat->wlr_seat->touch_state.grab;
+	grant->touch_default_grab_address =
+		(uintptr_t)seat->wlr_seat->touch_state.default_grab;
+	grant->touch_seat_client_address = (uintptr_t)first_client;
+	grant->touch_resource_address = touch_resource_address;
+	grant->touch_resource_id = touch_resource_id;
+	if (!sandcodex_bind_surface_ticket(client, first_view_surface, first_surface) ||
+			!sandcodex_bind_touch_resource_ticket(client,
+				(struct wl_resource *)touch_resource_address)) {
+		sandcodex_secure_clear(ticket, sizeof(ticket));
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(sx_bits, sizeof(sx_bits));
+		sandcodex_secure_clear(sy_bits, sizeof(sy_bits));
+		sandcodex_clear_dispatch_ticket(client);
+		sandcodex_send_hit_test_failure(client, "dispatch-lifetime-bind-failed");
+		return;
+	}
+	sandcodex_send_touch_stroke_target(client, &first_target, first_view,
+		ticket, start_x, start_y, end_x, end_y, steps, duration_msec);
+	sandcodex_secure_clear(ticket, sizeof(ticket));
+	sandcodex_secure_clear(&first_target, sizeof(first_target));
+	sandcodex_secure_clear(sx_bits, sizeof(sx_bits));
+	sandcodex_secure_clear(sy_bits, sizeof(sy_bits));
+}
