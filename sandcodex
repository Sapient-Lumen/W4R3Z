def private_directory(value: str, label: str) -> Path:
    path = Path(value)
    info = path.lstat()
    if not path.is_absolute() or path.resolve() != path or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise RuntimeError(f"{label} must be one canonical owned mode-0700 directory")
    return path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--socket", required=True)
    parser.add_argument("--project", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--home", required=True)
    parser.add_argument("--status", required=True)
    parser.add_argument("--max-output-bytes", required=True, type=int)
    parser.add_argument("--width", required=True, type=int)
    parser.add_argument("--height", required=True, type=int)
    parser.add_argument("--backend", required=True)
    parser.add_argument("--app-launcher")
    parser.add_argument("--app-wayland-display")
    parser.add_argument("--context-helper")
    parser.add_argument("--context-root")
    parser.add_argument("--atspi-proxy")
    parser.add_argument("--atspi-address")
    parser.add_argument("--pointer-agent")
    parser.add_argument("--keyboard-agent")
    parser.add_argument("--input-method-agent")
    parser.add_argument("--clipboard-agent")
    parser.add_argument("--selection-agent")
    parser.add_argument("--drop-agent")
    parser.add_argument("--drop-root")
    parser.add_argument("--keyboard-libxkbcommon-version")
    parser.add_argument("--audit")
    args = parser.parse_args()

    socket_path = Path(args.socket)
    if not socket_path.is_absolute() or socket_path.parent.resolve(strict=True) != socket_path.parent or len(os.fsencode(socket_path)) >= 104:
        raise RuntimeError("desktop MCP socket path is invalid")
    if stat.S_IMODE(socket_path.parent.stat().st_mode) != 0o700 or socket_path.parent.stat().st_uid != os.geteuid():
        raise RuntimeError("desktop MCP socket parent is not private")
    project = Path(args.project).resolve(strict=True)
    if not project.is_dir():
        raise RuntimeError("desktop project is not a directory")
    output = private_directory(args.output, "desktop output")
    home = private_directory(args.home, "desktop home")
    status = Path(args.status)
    if status.parent.resolve(strict=True) != socket_path.parent:
        raise RuntimeError("desktop status must share the private control directory")
    if not 1024 <= args.max_output_bytes <= 1024 * 1024 * 1024:
        raise RuntimeError("desktop output limit is invalid")
    if not 320 <= args.width <= 8192 or not 240 <= args.height <= 8192:
        raise RuntimeError("desktop dimensions are invalid")
    if args.backend not in {"wayland", "xephyr", "xvfb", "x11", "test"}:
        raise RuntimeError("desktop display backend is invalid")
    app_launcher = Path(args.app_launcher).resolve(strict=True) if args.app_launcher else None
    context_helper = Path(args.context_helper).resolve(strict=True) if args.context_helper else None
    context_root = private_directory(args.context_root, "Wayland context root") if args.context_root else None
    atspi_proxy = Path(args.atspi_proxy).resolve(strict=True) if args.atspi_proxy else None
    pointer_agent = Path(args.pointer_agent).resolve(strict=True) if args.pointer_agent else None
    keyboard_agent = Path(args.keyboard_agent).resolve(strict=True) if args.keyboard_agent else None
    input_method_agent = Path(args.input_method_agent).resolve(strict=True) if args.input_method_agent else None
    clipboard_agent = Path(args.clipboard_agent).resolve(strict=True) if args.clipboard_agent else None
    selection_agent = Path(args.selection_agent).resolve(strict=True) if args.selection_agent else None
    drop_agent = Path(args.drop_agent).resolve(strict=True) if args.drop_agent else None
    drop_root = private_directory(args.drop_root, "FileDropSeal root") if args.drop_root else None
    keyboard_libxkbcommon_version = args.keyboard_libxkbcommon_version
    if args.backend == "wayland" and (
        context_helper is None
        or context_root is None
        or atspi_proxy is None
        or args.atspi_address is None
        or pointer_agent is None
        or keyboard_agent is None
        or input_method_agent is None
        or clipboard_agent is None
        or selection_agent is None
        or drop_agent is None
        or drop_root is None
        or keyboard_libxkbcommon_version is None
    ):
        raise RuntimeError(
            "Wayland backend requires per-launch Wayland, filtered AT-SPI, and persistent virtual input brokers"
        )
    audit_path = Path(args.audit) if args.audit else None
    if audit_path is not None and (not audit_path.is_absolute() or audit_path.parent.resolve(strict=True) != audit_path.parent):
        raise RuntimeError("desktop audit path is invalid")

    controller = DesktopController(
        project,
        output,
        home,
        status,
        args.max_output_bytes,
        args.width,
        args.height,
        args.backend,
        app_launcher=app_launcher,
        app_wayland_display=args.app_wayland_display,
        context_helper=context_helper,
        context_root=context_root,
        atspi_proxy=atspi_proxy,
        atspi_address=args.atspi_address,
        pointer_agent=pointer_agent,
        keyboard_agent=keyboard_agent,
        input_method_agent=input_method_agent,
        clipboard_agent=clipboard_agent,
        selection_agent=selection_agent,
        drop_agent=drop_agent,
        drop_root=drop_root,
        keyboard_libxkbcommon_version=keyboard_libxkbcommon_version,
        audit_path=audit_path,
    )
    server = MCPServer(socket_path, controller)

    def stop(_signum: int, _frame: Any) -> None:
        server.shutdown()

    for name in ("SIGTERM", "SIGINT", "SIGHUP"):
        signal.signal(getattr(signal, name), stop)
    try:
        server.start()
        return 0
    finally:
        server.close()


if __name__ == "__main__":
    raise SystemExit(main())
DESKTOP_SERVER
}

