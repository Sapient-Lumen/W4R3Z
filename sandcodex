sc_campaign_write_direct_request() {
  local target="$1" run_target="$2" depends_json providers_json test_json
  depends_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_DEPENDS[@]}")"
  providers_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_ALLOWED_PROVIDERS[@]}")"
  test_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_TEST_ARGS[@]}")"
  jq -cn \
    --arg schema "$SC_CAMPAIGN_REQUEST_SCHEMA" --arg id "operator:$SC_RUN_ID" \
    --arg target_run_id "$run_target" --arg action "$SC_CAMPAIGN_ACTION" \
    --arg name "$SC_CAMPAIGN_NAME" --arg prompt "$SC_CAMPAIGN_PROMPT" \
    --arg base "$SC_CAMPAIGN_BASE" --arg browser "$SC_CAMPAIGN_BROWSER" --arg desktop "$SC_CAMPAIGN_DESKTOP" \
    --arg interface "$([[ $SC_TEAM_MODE == 1 ]] && printf team || printf campaign)" \
    --arg output "$SC_CAMPAIGN_OUTPUT" --arg grant_action "$SC_CAMPAIGN_GRANT_ACTION" \
    --arg to "$SC_TEAM_TO" --arg message_id "$SC_TEAM_MESSAGE_ID" \
    --arg attachment "$SC_TEAM_ATTACHMENT" --arg provider "$SC_TEAM_PROVIDER" \
    --arg effort "$SC_TEAM_EFFORT" --arg strategy "$SC_TEAM_ADOPT_STRATEGY" \
    --arg verifier "$SC_TEAM_VERIFIER" \
    --arg created_at "$(sc_now)" \
    --argjson turns "$SC_CAMPAIGN_TURNS" --argjson cursor "$SC_CAMPAIGN_CURSOR" \
    --argjson dry_run "$SC_CAMPAIGN_DRY_RUN" \
    --argjson grant_max "$([[ -z "$SC_CAMPAIGN_GRANT_MAX" ]] && printf null || printf '%s' "$SC_CAMPAIGN_GRANT_MAX")" \
    --argjson depends "$depends_json" --argjson allowed_providers "$providers_json" \
    --argjson token_budget "$SC_TEAM_TOKEN_BUDGET" --argjson time_budget "$SC_TEAM_TIME_BUDGET" \
    --argjson timeout "$SC_TEAM_TIMEOUT" --argjson poll "$SC_TEAM_POLL" \
    --argjson test_timeout "$SC_TEAM_TEST_TIMEOUT" --argjson test_argv "$test_json" \
    --argjson graph "$SC_TEAM_GRAPH_JSON" \
    '{schema:$schema,id:$id,target_run_id:$target_run_id,action:$action,
      name:(if $name == "" then null else $name end),turns:$turns,base:$base,browser:$browser,
      prompt:(if ($action == "start" or $action == "send") then $prompt else null end),
      output:(if $output == "" then null else $output end),cursor:$cursor,
      dry_run:($dry_run == 1),
      grant:(if $action == "grant" then {action:$grant_action,max_campaigns:$grant_max} else null end),
      team:{interface:$interface,desktop:$desktop,to:$to,message_id:(if $message_id=="" then null else $message_id end),
        attachment:(if $attachment=="" then null else $attachment end),depends:$depends,
        provider:$provider,allowed_providers:$allowed_providers,
        effort:(if $effort=="" then null else $effort end),token_budget:$token_budget,
        time_budget_seconds:$time_budget,timeout_seconds:$timeout,poll_seconds:$poll,
        test_timeout_seconds:$test_timeout,test_argv:$test_argv,strategy:$strategy,
        verifier:(if $verifier=="" then null else $verifier end),graph:$graph},
      created_at:$created_at}' |
    sc_atomic "$target" 600
}

sc_campaign_host_once() {
  local render="${1:-1}" context request target rc=0
  context="$(mktemp "$SC_GLOBAL/runtime/.campaign-context.XXXXXX")"
  request="$(mktemp "$SC_GLOBAL/runtime/.campaign-request.XXXXXX")"
  chmod 600 -- "$context" "$request"
  sc_campaign_write_direct_context "$context"
  if [[ "$SC_CAMPAIGN_ACTION" == start ]]; then
    target="$(sc_campaign_target_run)"
  else
    target="operator:$SC_RUN_ID"
  fi
  sc_campaign_write_direct_request "$request" "$target"
  sc_campaign_build_environment
  SC_CAMPAIGN_RESPONSE="$("${SC_CAMPAIGN_ENV[@]}" "$(command -v python3)" \
    "$SC_CAMPAIGN_ENGINE" direct "$context" "$request")" || rc=$?
  rm -f -- "$context" "$request"
  if [[ -z "$SC_CAMPAIGN_RESPONSE" ]]; then
    sc_die "campaign operator command failed without a response"
  fi
  (( ! render )) || sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE" || return $?
  return "$rc"
}

sc_campaign_host_wait() {
  local deadline=$((SECONDS + SC_TEAM_TIMEOUT)) lifecycle rc
  while :; do
    sc_campaign_host_once 0
    if [[ "$SC_CAMPAIGN_ACTION" == wait-any ]]; then
      if [[ "$(jq -r '.result.ready | length' <<<"$SC_CAMPAIGN_RESPONSE")" -gt 0 ]]; then
        sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE"
        lifecycle="$(jq -r '.result.ready[0].lifecycle_state' <<<"$SC_CAMPAIGN_RESPONSE")"
        if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
        (( rc != 126 )) && return "$rc"
      fi
    else
      lifecycle="$(jq -r '.result.lifecycle_state // "failed"' <<<"$SC_CAMPAIGN_RESPONSE")"
      if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
      if (( rc != 126 )); then
        sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE"
        return "$rc"
      fi
    fi
    if (( SC_TEAM_TIMEOUT > 0 && SECONDS >= deadline )); then
      sc_die "team $SC_CAMPAIGN_ACTION timed out after ${SC_TEAM_TIMEOUT}s" 124
    fi
    sleep "$SC_TEAM_POLL"
  done
}

sc_campaign_host_dispatch() {
  local lifecycle rc
  sc_prepare_campaign_storage_budget
  sc_campaign_validate_request
  sc_campaign_load_prompt
  if [[ "$SC_CAMPAIGN_ACTION" == remove && $SC_CAMPAIGN_DRY_RUN -eq 0 ]]; then
    sc_confirm_delete "campaign '$SC_CAMPAIGN_NAME', including its staged clone, worker session, and broker evidence"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" == wait || "$SC_CAMPAIGN_ACTION" == wait-any ]]; then
    sc_campaign_host_wait
    return
  fi
  if (( SC_CAMPAIGN_FOLLOW )); then
    while :; do
      sc_campaign_host_once
      SC_CAMPAIGN_CURSOR="$(jq -r '.result.next_cursor // 0' <<<"$SC_CAMPAIGN_RESPONSE")"
      if [[ "$SC_CAMPAIGN_ACTION" == attach || "$SC_CAMPAIGN_ACTION" == inspect ]]; then
        lifecycle="$(jq -r '.result.status.lifecycle_state // "failed"' <<<"$SC_CAMPAIGN_RESPONSE")"
        if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
        (( rc == 126 )) || return "$rc"
      fi
      sleep "$SC_TEAM_POLL"
    done
  fi
  sc_campaign_host_once
}

sc_campaign_remove_all() {
  local dry_run="$1" name
  local saved_action="$SC_CAMPAIGN_ACTION" saved_name="$SC_CAMPAIGN_NAME"
  local saved_json="$SC_CAMPAIGN_JSON" saved_dry_run="$SC_CAMPAIGN_DRY_RUN"
  sc_prepare_campaign_storage_budget
  SC_CAMPAIGN_ACTION=list
  SC_CAMPAIGN_NAME=""
  SC_CAMPAIGN_JSON=1
  SC_CAMPAIGN_DRY_RUN=0
  sc_campaign_host_once >/dev/null
  local list_response="$SC_CAMPAIGN_RESPONSE"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    SC_CAMPAIGN_ACTION=remove
    SC_CAMPAIGN_NAME="$name"
    SC_CAMPAIGN_DRY_RUN="$dry_run"
    sc_campaign_host_once >/dev/null
  done < <(jq -r '.result.campaigns[]?.name' <<<"$list_response")
  SC_CAMPAIGN_ACTION="$saved_action"
  SC_CAMPAIGN_NAME="$saved_name"
  SC_CAMPAIGN_JSON="$saved_json"
  SC_CAMPAIGN_DRY_RUN="$saved_dry_run"
}

sc_marker() { sed -n "s/^$2=//p" "$1" | head -n 1; }
sc_toml() { jq -Rn --arg value "$1" '$value'; }

sc_process_start() {
  local stat_line state
  [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/stat" ]] || return 1
  IFS= read -r stat_line <"/proc/$1/stat" || return 1
  stat_line="${stat_line##*) }"
  state="${stat_line%% *}"
  [[ "$state" != Z && "$state" != X && "$state" != x ]] || return 1
  awk '{print $20}' <<<"$stat_line"
}

sc_reap_owned_processes_referencing() {
  local needle="$1" pid uid args started victim self_uid
  local -a victims=()
  [[ -n "$needle" ]] || return 0
  self_uid="$(id -u)"
  while read -r pid uid args; do
    [[ "$pid" =~ ^[0-9]+$ && "$uid" == "$self_uid" ]] || continue
    [[ "$pid" != "$$" && "$pid" != "$BASHPID" ]] || continue
    [[ "$args" == *"$needle"* ]] || continue
    started="$(sc_process_start "$pid" 2>/dev/null || true)"
    [[ "$started" =~ ^[0-9]+$ ]] || continue
    victims+=("$pid:$started")
  done < <(ps -ww -eo pid=,uid=,args=)
  for victim in "${victims[@]}"; do
    sc_stop_tracked_pid "${victim%%:*}" "${victim#*:}" TERM
  done
}

sc_process_exited_after_grace() {
  local pid="$1" started="$2" attempt current
  current="$(sc_process_start "$pid" 2>/dev/null || true)"
  [[ -n "$current" && "$current" == "$started" ]] || return 0
  for (( attempt=0; attempt<20; attempt++ )); do
    sleep 0.05
    current="$(sc_process_start "$pid" 2>/dev/null || true)"
    [[ -n "$current" && "$current" == "$started" ]] || return 0
  done
  return 1
}

sc_reap_crashed_runs() {
  local run marker run_id pid started current proxy proxy_marker
  for run in "$SC_GLOBAL"/runtime/*; do
    [[ -d "$run" && ! -L "$run" ]] || continue
    [[ "$(stat -c %u -- "$run")" == "$(id -u)" ]] || continue
    marker="$run/OWNER"
    [[ -f "$marker" && ! -L "$marker" ]] || continue
    [[ "$(sc_marker "$marker" schema)" == "$SC_SCHEMA" ]] || continue
    [[ "$(sc_marker "$marker" kind)" == runtime ]] || continue
    [[ "$(sc_marker "$marker" uid)" == "$(id -u)" ]] || continue
    run_id="$(sc_marker "$marker" run_id)"
    [[ "${run##*/}" == "$run_id" ]] || continue
    pid="$(sc_marker "$marker" pid)"; started="$(sc_marker "$marker" process_start)"
    [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || continue
    sc_process_exited_after_grace "$pid" "$started" || continue
    sc_reap_owned_processes_referencing "$run"
    if [[ -f "$run/proxy-path" && ! -L "$run/proxy-path" ]]; then
      IFS= read -r proxy <"$run/proxy-path"
      case "$proxy" in
        /tmp/scx.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] | \
        /run/user/"$(id -u)"/scx.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]) ;;
        *) continue ;;
      esac
      sc_reap_owned_processes_referencing "$proxy"
      if [[ -e "$proxy" || -L "$proxy" ]]; then
        [[ -d "$proxy" && ! -L "$proxy" && "$(stat -c %u -- "$proxy")" == "$(id -u)" ]] || continue
        proxy_marker="$proxy/OWNER"
        [[ -f "$proxy_marker" && ! -L "$proxy_marker" ]] || continue
        [[ "$(sc_marker "$proxy_marker" schema)" == "$SC_SCHEMA" ]] || continue
        [[ "$(sc_marker "$proxy_marker" kind)" == proxy-transit ]] || continue
        [[ "$(sc_marker "$proxy_marker" run_id)" == "$run_id" ]] || continue
        if ! rm -rf -- "$proxy" 2>/dev/null; then
          sc_warn "stale proxy transit could not be removed; retained without blocking launch: $proxy"
          continue
        fi
      fi
    fi
    sc_remove_verified_runtime_tree "$run" "stale runtime $run_id"
  done
}

