    SC_CAMPAIGN_RUNTIME_PATH="$(dirname -- "$SC_CODEX"):$SC_CAMPAIGN_RUNTIME_PATH"
  fi
  SC_CAMPAIGN_WORKSPACE_ROOT="${SC_GLOBAL}-workspaces"
  [[ "$SC_CAMPAIGN_WORKSPACE_ROOT" == /* && "$SC_CAMPAIGN_WORKSPACE_ROOT" != "$SC_GLOBAL" && \
    "$SC_CAMPAIGN_WORKSPACE_ROOT" != "$SC_GLOBAL"/* ]] || sc_die "campaign workspace root is invalid"
  sc_no_symlink_components "$SC_CAMPAIGN_WORKSPACE_ROOT" "campaign workspace root"
  sc_ensure_dir "$SC_CAMPAIGN_WORKSPACE_ROOT" "campaign workspace root"
  if [[ -n "$SC_PROJECT_KEY" && "$SC_PROJECT_KEY" != '<none>' ]]; then
    SC_CAMPAIGN_STATE_ROOT="$SC_GLOBAL/campaigns/$SC_PROJECT_KEY"
    sc_ensure_dir "$SC_CAMPAIGN_STATE_ROOT" "project campaign state root"
  fi
  local marker="$SC_GLOBAL/OWNER"
  if [[ -e "$marker" || -L "$marker" ]]; then
    sc_validate_global_state
  else
    sc_atomic "$marker" 600 <<EOF
schema=$SC_SCHEMA
kind=global
uid=$(id -u)
home=$SC_REAL_HOME
EOF
    sc_validate_global_state
  fi
  sc_atomic "$SC_GLOBAL/auth-home/config.toml" 600 <<'EOF'
cli_auth_credentials_store = "file"
mcp_oauth_credentials_store = "file"
check_for_update_on_startup = false
EOF
  local artifact_sha
  artifact_sha="$(sc_artifact_sha256)"
  SC_CAMPAIGN_ENGINE="$SC_GLOBAL/campaign-engines/$artifact_sha.py"
  sc_write_campaign_engine "$SC_CAMPAIGN_ENGINE"
  SC_CAMPAIGN_LAUNCHER="$SC_GLOBAL/campaign-launchers/$artifact_sha"
  if [[ -e "$SC_CAMPAIGN_LAUNCHER" || -L "$SC_CAMPAIGN_LAUNCHER" ]]; then
    sc_owned_single_file "$SC_CAMPAIGN_LAUNCHER" 500 "versioned campaign launcher"
    [[ "$(sha256sum -- "$SC_CAMPAIGN_LAUNCHER" | awk '{print $1}')" == "$artifact_sha" ]] || \
      sc_die "versioned campaign launcher digest does not match its path"
  else
    sc_atomic "$SC_CAMPAIGN_LAUNCHER" 500 <"$SC_SCRIPT"
  fi
  sc_reap_crashed_runs
}

sc_validate_global_state() {
  local marker="$SC_GLOBAL/OWNER"
  sc_owned_dir "$SC_GLOBAL" "global control root"
  sc_owned_single_file "$marker" 600 "global ownership marker"
  [[ "$(sc_marker "$marker" schema)" == "$SC_SCHEMA" ]] || sc_die "global state schema mismatch"
  [[ "$(sc_marker "$marker" kind)" == global ]] || sc_die "global state kind mismatch"
  [[ "$(sc_marker "$marker" uid)" == "$(id -u)" ]] || sc_die "global state belongs to another uid"
  [[ "$(sc_marker "$marker" home)" == "$SC_REAL_HOME" ]] || sc_die "global state belongs to another home directory"
}

sc_launcher_start_project_key() {
  local line="$1"
  local header='^\{"timestamp":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z","level":"info","event":"start","message":"Sandcodex invocation","version":"[^"\\]+","artifact_sha256":"[0-9a-f]{64}","operation":"[^"\\]+","project":"'
  local trailer=',"project_key":"([0-9a-f]{64})","pid":"[1-9][0-9]*"\}$'
  [[ "$line" =~ $header && "$line" =~ $trailer ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

sc_collect_project_logs() {
  local allow_missing="${1:-0}" event log first_line event_project_key parent base day
  SC_MATCHED_LOGS=()
  if [[ ! -e "$SC_GLOBAL" && ! -L "$SC_GLOBAL" ]]; then
    (( allow_missing )) && return 0
    sc_die "no Sandcodex launcher log exists for this project"
  fi
  sc_validate_global_state
  if [[ ! -e "$SC_GLOBAL/logs" && ! -L "$SC_GLOBAL/logs" ]]; then
    (( allow_missing )) && return 0
    sc_die "no Sandcodex launcher log exists for this project"
  fi
  sc_no_symlink_components "$SC_GLOBAL/logs" "launcher log root"
  sc_owned_dir "$SC_GLOBAL/logs" "launcher log root"
  while IFS= read -r -d '' event; do
    parent="$(dirname -- "$event")"; day="${parent##*/}"; base="${event##*/}"
    [[ "$day" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && \
      "$base" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9a-f]{6}\.jsonl$ ]] || continue
    sc_owned_dir "$parent" "daily launcher log directory"
    sc_owned_single_file "$event" 600 "launcher event log"
    first_line="$(head -c 65536 -- "$event" | sed -n '1p')"
    if ! event_project_key="$(sc_launcher_start_project_key "$first_line")"; then
      continue
    fi
    [[ "$event_project_key" == "$SC_PROJECT_KEY" ]] || continue
    log="${event%.jsonl}.log"
    sc_owned_single_file "$log" 600 "launcher text log"
    SC_MATCHED_LOGS+=("$log")
  done < <(find -P "$SC_GLOBAL/logs" -mindepth 2 -maxdepth 2 -type f -name '*.jsonl' -print0)
  if (( ${#SC_MATCHED_LOGS[@]} )); then
    mapfile -t SC_MATCHED_LOGS < <(printf '%s\n' "${SC_MATCHED_LOGS[@]}" | LC_ALL=C sort)
  fi
}

sc_logs_dispatch() {
  SC_OPERATION=logs
  sc_collect_project_logs 0
  (( ${#SC_MATCHED_LOGS[@]} )) || sc_die "no Sandcodex launcher log exists for this project"
  local latest="${SC_MATCHED_LOGS[${#SC_MATCHED_LOGS[@]}-1]}" log
  case "$SC_LOG_ACTION" in
    list)
      for log in "${SC_MATCHED_LOGS[@]}"; do printf '%s\n' "$log"; done
      ;;
    path) printf '%s\n' "$latest" ;;
    tail) tail -n "$SC_LOG_LINES" -- "$latest" ;;
    follow) exec tail -n "$SC_LOG_LINES" -f -- "$latest" ;;
    *) sc_die "internal log action error: $SC_LOG_ACTION" ;;
  esac
}

sc_acquire_project_lock() {
  local lock="$SC_GLOBAL/locks/$SC_PROJECT_KEY.lock" holder_shell ready_seen=0 holder_rc=0
  if [[ ! -e "$lock" && ! -L "$lock" ]]; then
    ( set -o noclobber; : >"$lock" ) 2>/dev/null || true
  fi
  [[ -f "$lock" && ! -L "$lock" ]] || sc_die "project operation lock is not a regular file: $lock"
  [[ "$(stat -c %u -- "$lock")" == "$(id -u)" && "$(stat -c %h -- "$lock")" == 1 ]] || \
    sc_die "project operation lock metadata is invalid: $lock"
  chmod 600 -- "$lock"
  [[ "$(stat -c %a -- "$lock")" == 600 ]] || sc_die "project operation lock permissions are invalid: $lock"

  SC_LOCK_READY="$SC_GLOBAL/locks/.ready.$$.$RANDOM"
  [[ ! -e "$SC_LOCK_READY" && ! -L "$SC_LOCK_READY" ]] || sc_die "project lock readiness path collision"
  holder_shell="$(command -v bash)"
  # Expanded by the isolated lock-holder shell after its argument is assigned.
  # shellcheck disable=SC2016
  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM "$SC_FLOCK" --exclusive --nonblock --no-fork "$lock" \
      "$holder_shell" -c '
      set -eu
      ready=$1
      umask 077
      printf "%s\n" "$$" >"$ready"
      chmod 600 "$ready"
      exec sleep infinity
    ' sandcodex-project-lock "$SC_LOCK_READY"
  ) & SC_LOCK_PID=$!

  for _ in {1..100}; do
    if [[ -f "$SC_LOCK_READY" ]]; then
      kill -0 "$SC_LOCK_PID" 2>/dev/null && ready_seen=1
      break
    fi
    if ! kill -0 "$SC_LOCK_PID" 2>/dev/null; then break; fi
    sleep 0.02
  done
  if (( ! ready_seen )); then
    wait "$SC_LOCK_PID" 2>/dev/null || holder_rc=$?
    SC_LOCK_PID=""
    rm -f -- "$SC_LOCK_READY" 2>/dev/null || true
    SC_LOCK_READY=""
    if (( holder_rc == 1 )); then
      sc_die "another Sandcodex operation is already active for this project" 75
    fi
    sc_die "could not acquire the project operation lock" 75
  fi
  [[ ! -L "$SC_LOCK_READY" && "$(stat -c %u -- "$SC_LOCK_READY")" == "$(id -u)" && \
    "$(stat -c %a -- "$SC_LOCK_READY")" == 600 && "$(stat -c %h -- "$SC_LOCK_READY")" == 1 ]] || \
    sc_die "project lock readiness marker is invalid"
  rm -f -- "$SC_LOCK_READY"
  SC_LOCK_READY=""
  sc_debug "exclusive project operation lock acquired"
}

sc_jail_store_root() {
  local path=$1 canonical rest
  canonical=$(readlink -f -- "$path" 2>/dev/null || true)
  case "$canonical" in
    /nix/store/*)
      rest=${canonical#/nix/store/}
      printf '/nix/store/%s\n' "${rest%%/*}"
      ;;
  esac
}

sc_build_jail_seccomp_executor() {
