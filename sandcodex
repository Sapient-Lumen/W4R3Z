static size_t pending_count(const struct clipboard_state *state) {
    size_t count = 0U;
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0) {
            count++;
        }
    }
    return count;
}

static struct pending_request *find_pending(struct clipboard_state *state,
        uint32_t request_id) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0 &&
                state->pending[index].id == request_id) {
            return &state->pending[index];
        }
    }
    return NULL;
}

static struct pending_request *find_unannounced(struct clipboard_state *state) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0 && !state->pending[index].announced) {
            return &state->pending[index];
        }
    }
    return NULL;
}

static void source_send(void *data, struct ext_data_control_source_v1 *source,
        const char *mime_type, int descriptor) {
    (void)source;
    struct clipboard_state *state = data;
    if (!state->selection_active || !state->request_gate_open ||
            state->clear_in_progress ||
            state->requests_seen >= MAX_REQUESTS || !allowed_mime(state, mime_type) ||
            descriptor < 0) {
        if (descriptor >= 0) {
            (void)close(descriptor);
        }
        state->terminal_error = true;
        return;
    }
    size_t slot = MAX_REQUESTS;
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor < 0) {
            slot = index;
            break;
        }
    }
    if (slot == MAX_REQUESTS) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    const int flags = fcntl(descriptor, F_GETFL);
    const int descriptor_flags = fcntl(descriptor, F_GETFD);
    if (flags < 0 || descriptor_flags < 0 ||
            fcntl(descriptor, F_SETFL, flags | O_NONBLOCK) < 0 ||
            fcntl(descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    state->next_request_id++;
    if (state->next_request_id == 0U) {
        (void)close(descriptor);
        state->terminal_error = true;
        return;
    }
    state->pending[slot].id = state->next_request_id;
    state->pending[slot].descriptor = descriptor;
    state->pending[slot].announced = false;
    (void)snprintf(state->pending[slot].mime, sizeof(state->pending[slot].mime), "%s",
        mime_type);
    state->requests_seen++;
    state->last_activity_milliseconds = monotonic_milliseconds();
}

static void source_cancelled(void *data, struct ext_data_control_source_v1 *source) {
    (void)source;
    struct clipboard_state *state = data;
    state->request_gate_open = false;
    if (!state->clear_in_progress && state->selection_active) {
        state->unexpected_cancel = true;
        state->terminal_error = true;
    }
    state->selection_active = false;
}

static const struct ext_data_control_source_v1_listener source_listener = {
    .send = source_send,
    .cancelled = source_cancelled,
};

static int display_roundtrip(struct clipboard_state *state) {
    if (!state->topology_valid || state->display == NULL ||
            wl_display_roundtrip(state->display) < 0 || !state->topology_valid ||
            state->device_finished || state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int dispatch_ready_events(struct clipboard_state *state, int timeout_milliseconds) {
    if (!state->topology_valid || state->display == NULL ||
            wl_display_dispatch_pending(state->display) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (state->terminal_error || state->device_finished) {
        errno = EPROTO;
        return -1;
    }
    if (wl_display_flush(state->display) < 0 && errno != EAGAIN) {
        return -1;
    }
    const int descriptor = wl_display_get_fd(state->display);
    if (descriptor < 0) {
        errno = EPROTO;
        return -1;
    }
    struct pollfd item = {
        .fd = descriptor,
        .events = POLLIN,
        .revents = 0,
    };
    int result = 0;
    do {
        result = poll(&item, 1U, timeout_milliseconds);
    } while (result < 0 && errno == EINTR && !stop_requested);
    if (result < 0) {
        return -1;
    }
    if (result == 0) {
        return 0;
    }
    if ((item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
            (item.revents & POLLIN) == 0 || wl_display_dispatch(state->display) < 0 ||
            state->terminal_error || state->device_finished || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    return 1;
}

static void set_selection(struct clipboard_state *state,
        struct ext_data_control_source_v1 *source) {
    if (state->selection == SELECTION_PRIMARY) {
        ext_data_control_device_v1_set_primary_selection(state->device, source);
    } else {
        ext_data_control_device_v1_set_selection(state->device, source);
    }
}

static int initialize_wayland(struct clipboard_state *state) {
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->topology_valid = true;
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 || state->manager == NULL ||
            state->seat == NULL || state->manager_count != 1U || state->seat_count != 1U ||
            state->manager_version < 1U || state->manager_name == 0U ||
            state->seat_name == 0U || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    state->source = ext_data_control_manager_v1_create_data_source(state->manager);
    state->device = ext_data_control_manager_v1_get_data_device(state->manager, state->seat);
    if (state->source == NULL || state->device == NULL ||
            ext_data_control_source_v1_add_listener(state->source, &source_listener, state) < 0 ||
            ext_data_control_device_v1_add_listener(state->device, &device_listener, state) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (state->profile == PROFILE_PNG) {
        ext_data_control_source_v1_offer(state->source, MIME_PNG);
    } else if (state->profile == PROFILE_FILES) {
        ext_data_control_source_v1_offer(state->source, MIME_URI_LIST);
    } else {
        ext_data_control_source_v1_offer(state->source, MIME_UTF8);
        ext_data_control_source_v1_offer(state->source, MIME_TEXT);
        ext_data_control_source_v1_offer(state->source, MIME_UTF8_STRING);
        if (state->payload_ascii) {
            ext_data_control_source_v1_offer(state->source, MIME_STRING);
        }
    }
    state->request_gate_open = true;
    set_selection(state, state->source);
    state->selection_active = true;
    state->last_activity_milliseconds = monotonic_milliseconds();
    return display_roundtrip(state);
}

static void close_pending(struct clipboard_state *state) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0) {
            (void)close(state->pending[index].descriptor);
            state->pending[index].descriptor = -1;
            state->pending[index].announced = false;
        }
    }
}

static int clear_selection(struct clipboard_state *state) {
    if (state->clear_confirmed) {
        return 0;
    }
    if (state->device == NULL || state->display == NULL || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    /* Irreversibly close the release gate before asking the compositor to
     * replace our source.  Any send event racing this roundtrip is closed
     * empty and turns the clear into a fail-closed result. */
    state->request_gate_open = false;
    state->clear_in_progress = true;
    close_pending(state);
    set_selection(state, NULL);
    const int roundtrip_result = wl_display_roundtrip(state->display);
    const bool clear_valid = roundtrip_result >= 0 && state->topology_valid &&
        !state->device_finished && !state->terminal_error &&
        pending_count(state) == 0U;
    close_pending(state);
    state->clear_in_progress = false;
    if (!clear_valid) {
        errno = EPROTO;
        return -1;
    }
    state->selection_active = false;
    state->clear_confirmed = true;
    return 0;
}

static int write_payload(struct clipboard_state *state, int descriptor) {
    unsigned char buffer[TRANSFER_CHUNK_BYTES];
    size_t offset = 0U;
    const uint64_t deadline = monotonic_milliseconds() + TRANSFER_TIMEOUT_MILLISECONDS;
    while (offset < state->payload_size && !stop_requested) {
        size_t wanted = state->payload_size - offset;
        if (wanted > sizeof(buffer)) {
            wanted = sizeof(buffer);
        }
        const ssize_t read_count = pread(state->payload_descriptor, buffer, wanted, (off_t)offset);
        if (read_count <= 0) {
            errno = EIO;
            return -1;
        }
        size_t written_total = 0U;
        while (written_total < (size_t)read_count && !stop_requested) {
            const ssize_t write_count = write(descriptor, buffer + written_total,
                (size_t)read_count - written_total);
            if (write_count > 0) {
                written_total += (size_t)write_count;
                continue;
            }
            if (write_count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
                return -1;
            }
            const uint64_t now = monotonic_milliseconds();
            if (now >= deadline) {
                errno = ETIMEDOUT;
                return -1;
            }
            uint64_t remaining = deadline - now;
            if (remaining > (uint64_t)INT_MAX) {
                remaining = (uint64_t)INT_MAX;
            }
            struct pollfd item = {.fd = descriptor, .events = POLLOUT, .revents = 0};
            int result = 0;
            do {
                result = poll(&item, 1U, (int)remaining);
            } while (result < 0 && errno == EINTR && !stop_requested);
            if (result <= 0 || (item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
                    (item.revents & POLLOUT) == 0) {
                errno = result == 0 ? ETIMEDOUT : EPIPE;
                return -1;
            }
        }
        offset += (size_t)read_count;
    }
    if (stop_requested) {
        errno = EINTR;
        return -1;
    }
    return 0;
}

static int authorize_request(struct clipboard_state *state, uint32_t request_id) {
    struct pending_request *request = find_pending(state, request_id);
    if (request == NULL || !request->announced || state->clear_in_progress ||
            state->clear_confirmed || state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    const int descriptor = request->descriptor;
    request->descriptor = -1;
    request->announced = false;
    const int result = write_payload(state, descriptor);
    const int saved_errno = errno;
    (void)close(descriptor);
    if (result < 0) {
        state->terminal_error = true;
        errno = saved_errno;
        return -1;
    }
    state->transfers_completed++;
    state->bytes_transferred += (uint64_t)state->payload_size;
    state->last_activity_milliseconds = monotonic_milliseconds();
    return 0;
}

static int next_request(struct clipboard_state *state, uint32_t timeout_milliseconds,
        uint32_t quiet_milliseconds, struct pending_request **request,
        bool *quiet_complete) {
    *request = NULL;
    *quiet_complete = false;
    const uint64_t started = monotonic_milliseconds();
    const uint64_t deadline = started + (uint64_t)timeout_milliseconds;
    for (;;) {
        if (stop_requested || state->terminal_error || state->unexpected_cancel ||
                state->device_finished || !state->topology_valid) {
            errno = EPROTO;
            return -1;
        }
        struct pending_request *candidate = find_unannounced(state);
        if (candidate != NULL) {
            candidate->announced = true;
            *request = candidate;
            return 0;
        }
        const uint64_t now = monotonic_milliseconds();
        if (state->transfers_completed > 0U && pending_count(state) == 0U &&
                now >= state->last_activity_milliseconds &&
                now - state->last_activity_milliseconds >= (uint64_t)quiet_milliseconds) {
            *quiet_complete = true;
            return 0;
        }
        if (now >= deadline) {
            errno = ETIMEDOUT;
            return -1;
        }
        uint64_t remaining = deadline - now;
        if (state->transfers_completed > 0U && pending_count(state) == 0U &&
                now >= state->last_activity_milliseconds) {
            const uint64_t elapsed = now - state->last_activity_milliseconds;
            if (elapsed < (uint64_t)quiet_milliseconds) {
                const uint64_t quiet_remaining = (uint64_t)quiet_milliseconds - elapsed;
                if (quiet_remaining < remaining) {
                    remaining = quiet_remaining;
                }
            }
        }
        if (remaining > (uint64_t)INT_MAX) {
            remaining = (uint64_t)INT_MAX;
        }
        if (dispatch_ready_events(state, (int)remaining) < 0) {
            return -1;
        }
    }
}

static void cleanup(struct clipboard_state *state) {
    if (state->device != NULL && state->display != NULL && state->topology_valid &&
            !state->device_finished && !state->clear_confirmed) {
        (void)clear_selection(state);
    }
    close_pending(state);
    if (state->source != NULL) {
        ext_data_control_source_v1_destroy(state->source);
        state->source = NULL;
    }
    if (state->device != NULL) {
        ext_data_control_device_v1_destroy(state->device);
        state->device = NULL;
    }
    if (state->manager != NULL) {
        ext_data_control_manager_v1_destroy(state->manager);
        state->manager = NULL;
    }
    if (state->seat != NULL) {
        wl_seat_destroy(state->seat);
        state->seat = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
    if (state->payload_descriptor >= 0) {
        (void)close(state->payload_descriptor);
        state->payload_descriptor = -1;
    }
}

static void reply_error(uint64_t sequence, const char *reason,
        const struct clipboard_state *state) {
    fprintf(stdout,
        "ERR %" PRIu64 " %s REQUESTS %u TRANSFERS %u PENDING %zu CLEARED %u\n",
        sequence, reason, state->requests_seen, state->transfers_completed,
        pending_count(state), state->clear_confirmed ? 1U : 0U);
    (void)fflush(stdout);
}

