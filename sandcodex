+static void sandcodex_dispatch_touch_stroke_request(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	json_object *duration_object = NULL, *end_x_object = NULL;
+	json_object *end_y_object = NULL, *start_x_object = NULL;
+	json_object *start_y_object = NULL, *steps_object = NULL;
+	json_object *ticket_object = NULL;
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == 8 &&
+		sandcodex_request_operation(request, "dispatch-touch-stroke") &&
+		json_object_object_get_ex(request, "duration_milliseconds",
+			&duration_object) &&
+		json_object_object_get_ex(request, "end_x", &end_x_object) &&
+		json_object_object_get_ex(request, "end_y", &end_y_object) &&
+		json_object_object_get_ex(request, "start_x", &start_x_object) &&
+		json_object_object_get_ex(request, "start_y", &start_y_object) &&
+		json_object_object_get_ex(request, "steps", &steps_object) &&
+		json_object_object_get_ex(request, "ticket", &ticket_object) &&
