+
+static bool sandcodex_send_modifier_arc_hold(struct sway_seat *seat,
+		struct sway_seat_device *device, struct wlr_surface *expected_surface,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_focused_client_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		uint32_t modifiers) {
+	if (!seat || !seat->wlr_seat || !device || !expected_surface ||
+			seat->focused_layer || seat->has_exclusive_layer ||
+			server.session_lock.lock || !sandcodex_input_method_grab_absent(seat) ||
+			!sandcodex_keyboard_default_route(seat, expected_grab_address,
+				expected_default_grab_address, expected_focused_client_address) ||
+			!sandcodex_keyboard_recipient_exact(
+				seat->wlr_seat->keyboard_state.focused_client,
+				expected_resource_address, expected_resource_id, NULL, NULL) ||
+			seat->wlr_seat->keyboard_state.focused_surface != expected_surface ||
+			!sandcodex_keyboard_released(seat, device) ||
+			!sandcodex_keyboard_modifiers_valid(device, modifiers, true)) {
+		return false;
+	}
+	struct wlr_keyboard_modifiers pressed = {
+		.depressed = modifiers,
+		.latched = 0,
+		.locked = 0,
+		.group = 0,
+	};
+	/* This is client-visible logical modifier state, not Sway shortcut state.
+	 * Direct seat delivery bypasses compositor bindings and leaves the exact
+	 * virtual keyboard's physical state released for fail-safe clear. */
+	wlr_seat_keyboard_notify_modifiers(seat->wlr_seat, &pressed);
+	return sandcodex_keyboard_released(seat, device) &&
+		seat->wlr_seat->keyboard_state.focused_surface == expected_surface &&
+		sandcodex_keyboard_default_route(seat, expected_grab_address,
+			expected_default_grab_address, expected_focused_client_address) &&
+		sandcodex_keyboard_recipient_exact(
+			seat->wlr_seat->keyboard_state.focused_client,
+			expected_resource_address, expected_resource_id, NULL, NULL);
+}
+
+static bool sandcodex_release_modifier_arc_state(struct ipc_client *client,
+		bool require_exact_device, bool *recipient_alive_out) {
+	if (recipient_alive_out) {
+		*recipient_alive_out = false;
+	}
+	if (!client || !client->sandcodex_modifier_arc.active) {
+		return false;
+	}
+	struct sandcodex_modifier_arc snapshot = client->sandcodex_modifier_arc;
+	if (recipient_alive_out) {
+		*recipient_alive_out = snapshot.recipient_alive;
+	}
+	/* Consume the raw arc token and detach all lifetime listeners before any
+	 * mutable reobservation. From here the only possible event is de-escalation. */
+	sandcodex_reset_modifier_arc(client);
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sway_seat_device *device = sandcodex_single_virtual_keyboard(seat);
+	bool same_device = device && device->input_device &&
+		(uintptr_t)device == snapshot.sway_device_address &&
+		(uintptr_t)device->input_device->wlr_device == snapshot.wlr_device_address &&
+		strcmp(device->input_device->identifier, snapshot.device_identifier) == 0;
+	bool underlying_released = same_device &&
+		sandcodex_keyboard_released(seat, device);
+	/* Clearing is monotonic de-escalation. Attempt it even when the exact virtual
+	 * keyboard proof has become ambiguous; otherwise a transient second device
+	 * could consume the one-use arc token while leaving seat-global logical
+	 * modifiers latched. Exact proof still controls the success acknowledgement. */
+	bool clear_attempted = seat && seat->wlr_seat;
+	if (clear_attempted) {
+		struct wlr_keyboard_modifiers cleared = {0};
+		wlr_seat_keyboard_notify_modifiers(seat->wlr_seat, &cleared);
+	}
+	bool released = clear_attempted &&
+		(!require_exact_device || underlying_released);
+	sandcodex_secure_clear(&snapshot, sizeof(snapshot));
+	return released;
+}
