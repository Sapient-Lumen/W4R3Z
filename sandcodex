+        (uintptr_t)seat->wlr_seat->pointer_state.default_grab : 0;
+    for (uint32_t index = 0; path_valid && index <= hover.steps; ++index) {
+        int64_t x = sandcodex_touch_stroke_coordinate(hover.start_x,
+            hover.end_x, index, hover.steps);
+        int64_t y = sandcodex_touch_stroke_coordinate(hover.start_y,
+            hover.end_y, index, hover.steps);
