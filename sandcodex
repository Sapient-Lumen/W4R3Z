sc_remote_keybank_default_path() {
  printf '%s\n' "$SC_GLOBAL/remote/openrouter-keys.txt"
}

sc_remote_keybank_path() {
  local path="${SC_REMOTE_KEYBANK_PATH:-}"
  [[ -n "$path" ]] || path="$(sc_remote_keybank_default_path)"
  if [[ "$path" != /* ]]; then
    path="$(realpath -m -- "$path")"
  fi
