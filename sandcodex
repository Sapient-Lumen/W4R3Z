#!/usr/bin/env python3
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time


def group_alive(group: int) -> bool:
    try:
        os.killpg(group, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def wait_group(group: int, seconds: int) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if not group_alive(group):
            return True
        time.sleep(0.05)
    return not group_alive(group)


signal_fd = int(sys.argv[1])
grace_seconds = int(sys.argv[2])
adapter_mode = sys.argv[3]
adapter_target_port = int(sys.argv[4])
if adapter_mode not in {"socket-activation", "tcp-loopback"}:
    raise SystemExit("sandcodex operator: unknown application adapter")
if adapter_mode == "socket-activation" and adapter_target_port != 0:
    raise SystemExit("sandcodex operator: socket activation cannot declare a target port")
if adapter_mode == "tcp-loopback" and not 1 <= adapter_target_port <= 65535:
    raise SystemExit("sandcodex operator: TCP adapter target port is invalid")
if sys.argv[5:6] != ["--"] or len(sys.argv) < 7:
    raise SystemExit("sandcodex operator: malformed application relay argv")
argv = sys.argv[6:]
listen_fd = int(os.environ["SANDCODEX_LISTEN_FD"])
ready_fd = int(os.environ["SANDCODEX_READY_FD"])
application_environment = os.environ.copy()
application_pass_fds = (listen_fd, ready_fd)
if adapter_mode == "tcp-loopback":
    application_environment.pop("SANDCODEX_LISTEN_FD", None)
    application_environment.pop("SANDCODEX_READY_FD", None)
    application_environment["SANDCODEX_OPERATOR_TARGET_ADDRESS"] = "127.0.0.1"
    application_environment["SANDCODEX_OPERATOR_TARGET_PORT"] = str(adapter_target_port)
    application_pass_fds = ()
application = subprocess.Popen(
    argv,
    env=application_environment,
    close_fds=True,
    pass_fds=application_pass_fds,
    start_new_session=True,
)
application_group = application.pid
stop_requested = threading.Event()


def forward_signals() -> None:
    while True:
        try:
            value = os.read(signal_fd, 1)
        except InterruptedError:
            continue
        if not value:
            return
        signum = value[0]
        if signum not in {signal.SIGHUP, signal.SIGINT, signal.SIGTERM}:
            continue
        stop_requested.set()
        try:
            os.killpg(application_group, signum)
        except ProcessLookupError:
            pass


threading.Thread(target=forward_signals, name="operator-signal-relay", daemon=True).start()


def bridge_connection(client: socket.socket, active: set[socket.socket], lock: threading.Lock) -> None:
    upstream: socket.socket | None = None
    try:
        upstream = socket.create_connection(("127.0.0.1", adapter_target_port), timeout=5)
        upstream.settimeout(None)
        with lock:
            active.add(upstream)

        def pump(source: socket.socket, destination: socket.socket) -> None:
            try:
                while True:
                    chunk = source.recv(65536)
                    if not chunk:
                        break
                    destination.sendall(chunk)
            except (ConnectionError, OSError):
                pass
            try:
                destination.shutdown(socket.SHUT_WR)
            except OSError:
                pass

        request = threading.Thread(target=pump, args=(client, upstream), daemon=True)
        request.start()
        pump(upstream, client)
        request.join(timeout=1)
    except OSError:
        pass
    finally:
        with lock:
            active.discard(client)
            if upstream is not None:
                active.discard(upstream)
        try:
            client.close()
        except OSError:
            pass
        if upstream is not None:
            try:
                upstream.close()
            except OSError:
                pass


if adapter_mode == "tcp-loopback":
    listener = socket.socket(fileno=os.dup(listen_fd))
    listener.settimeout(0.2)
    while application.poll() is None and not stop_requested.is_set():
        probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            probe.settimeout(0.2)
            if probe.connect_ex(("127.0.0.1", adapter_target_port)) == 0:
                break
        finally:
            probe.close()
        time.sleep(0.05)
    if application.poll() is None and not stop_requested.is_set():
        generation = int(os.environ["SANDCODEX_OPERATOR_SERVICE_GENERATION"])
        ready = {
            "schema": "sandcodex.operator-service-ready.v1",
            "service_generation": generation,
            "application_build_id": f"tcp-loopback:{adapter_target_port}",
        }
        os.write(ready_fd, (json.dumps(ready, separators=(",", ":")) + "\n").encode())
    active_sockets: set[socket.socket] = set()
    active_lock = threading.Lock()
    connection_slots = threading.BoundedSemaphore(64)

    def serve(client: socket.socket) -> None:
        try:
            bridge_connection(client, active_sockets, active_lock)
        finally:
            connection_slots.release()

    while application.poll() is None and not stop_requested.is_set():
        try:
            client, _ = listener.accept()
        except socket.timeout:
            continue
        except OSError:
            break
        if not connection_slots.acquire(blocking=False):
            client.close()
            continue
        with active_lock:
            active_sockets.add(client)
        threading.Thread(target=serve, args=(client,), name="operator-tcp-bridge", daemon=True).start()
    listener.close()
    with active_lock:
        for endpoint in tuple(active_sockets):
            try:
                endpoint.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            try:
                endpoint.close()
            except OSError:
                pass
returncode = application.wait()
if group_alive(application_group):
    if not stop_requested.is_set():
        try:
            os.killpg(application_group, signal.SIGTERM)
        except ProcessLookupError:
            pass
    if not wait_group(application_group, grace_seconds):
        try:
            os.killpg(application_group, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if not wait_group(application_group, grace_seconds):
            raise SystemExit("sandcodex operator: application descendants could not be reaped")
os.close(signal_fd)
if returncode < 0:
    signum = -returncode
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)
    os._exit(128 + signum)
raise SystemExit(returncode)
