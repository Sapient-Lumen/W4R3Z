    "  includes: \(.project_authority.includes | join(", "))",
    "  frontend config: \(.project_authority.frontend_configuration_sources)",
    "  sudo ticket: \(if .mode == "bare-metal" then (if .project_authority.bare_metal_sudo_ticket then "launcher-managed" else "not primed by Sandcodex" end) else "none" end)",
    "  retained boundary: \(.project_authority.boundary_state)",
    "  resource cgroup: \(if .mode == "bare-metal" then "none (bare metal)" elif .resource_scope.enabled then "systemd user unit; memory \(.resource_scope.memory_max), tasks \(.resource_scope.tasks_max), swap disabled" else "disabled by explicit --no-resource-scope; sandbox/proxy/mount namespaces remain active" end)",
    "",
    "Nix",
    "  flakes/build/develop/profile: \(if .toolchain.nix.flakes and .toolchain.nix.daemon_available then "yes" else "no" end)",
    "  profile bin on PATH: \(if .toolchain.nix.profile_bin_on_path then "yes" else "no" end)",
    "  isolated profile: \(.toolchain.nix.isolated_profile // "none")",
    "  pinned registry: \(.toolchain.nix.registry.shorthand) -> \(.toolchain.nix.registry.target)",
    "  recipes: \(if .toolchain.nix.daemon_available then "nix develop | nix build | nix shell nixpkgs#ripgrep -c rg --version" else "daemon unavailable for builds/fetches; pure eval and the pinned registry remain available" end)",
    "  persistence: \(if .toolchain.nix.profile_bin_on_path then "nix profile add nixpkgs#ripgrep; profile bin is already on PATH" else "none" end)",
