  printf 'unset CODEX_HOME OPENAI_API_KEY SANDCODEX_LOOPER SANDCODEX_CAMPAIGN SANDCODEX_WORKER SANDCODEX_TEAM SANDCODEX_RUN_ID SANDCODEX_ACTIVE SANDCODEX_OUTER_PROJECT HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy\n' >>"$tmp"
