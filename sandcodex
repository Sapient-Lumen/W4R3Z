  (( SC_BROWSER )) || return 0
  local manifest directory canonical kind issue seen=$'\n' project_selected=0 project_manifest="" project_key="" bundle_key=""
  local -a candidates=(
    "$SC_PROJECT/extension/dist/manifest.json"
    "$SC_PROJECT/extension/build/manifest.json"
    "$SC_PROJECT/extension/manifest.json"
    "$SC_PROJECT/dist/manifest.json"
  )
  [[ -z "$SC_BROWSER_BUNDLE_EXTENSION" ]] || candidates+=("$SC_BROWSER_BUNDLE_EXTENSION/manifest.json")
  [[ "$SC_COMMAND" != doctor ]] || candidates+=("$SC_BROWSER_HOME/doctor-fixture/extension/manifest.json")
  for manifest in "${candidates[@]}"; do
    [[ -f "$manifest" && ! -L "$manifest" ]] || continue
    [[ "$(stat -c %s -- "$manifest" 2>/dev/null || printf 1048577)" -le 1048576 ]] || continue
    jq -e '.manifest_version == 2 or .manifest_version == 3' "$manifest" >/dev/null 2>&1 || continue
    directory="$(dirname -- "$manifest")"
    canonical="$(realpath -- "$directory" 2>/dev/null || true)"
    if [[ "$SC_COMMAND" == doctor && "$canonical" == "$SC_BROWSER_HOME/doctor-fixture/extension" ]]; then
