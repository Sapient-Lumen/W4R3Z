+static bool sandcodex_capture_stylus_target(struct ipc_client *client,
+        struct sway_seat *seat, double x, double y,
+        struct sandcodex_hit_target *target, struct sway_view **view_out,
+        struct wlr_surface **view_surface_out,
+        struct wlr_surface **target_surface_out,
+        struct wlr_seat_client **pointer_client_out,
