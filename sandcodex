+static bool sandcodex_gesture_coordinate_valid(int64_t value) {
+	return value >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		value <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT;
+}
+
+static bool sandcodex_touch_gesture_shape_valid(
+		int64_t first_start_x, int64_t first_start_y,
+		int64_t first_end_x, int64_t first_end_y,
+		int64_t second_start_x, int64_t second_start_y,
+		int64_t second_end_x, int64_t second_end_y,
+		uint32_t steps, uint32_t duration_msec) {
+	if (steps == 0 || steps > SANDCODEX_TOUCH_GESTURE_MAX_STEPS ||
+			duration_msec < steps + 1 ||
+			duration_msec > SANDCODEX_TOUCH_GESTURE_MAX_DURATION_MSEC ||
+			!sandcodex_gesture_coordinate_valid(first_start_x) ||
+			!sandcodex_gesture_coordinate_valid(first_start_y) ||
+			!sandcodex_gesture_coordinate_valid(first_end_x) ||
+			!sandcodex_gesture_coordinate_valid(first_end_y) ||
+			!sandcodex_gesture_coordinate_valid(second_start_x) ||
+			!sandcodex_gesture_coordinate_valid(second_start_y) ||
+			!sandcodex_gesture_coordinate_valid(second_end_x) ||
+			!sandcodex_gesture_coordinate_valid(second_end_y) ||
+			(first_start_x == first_end_x && first_start_y == first_end_y &&
+			 second_start_x == second_end_x && second_start_y == second_end_y)) {
+		return false;
+	}
+
+	int64_t previous_first_x = 0, previous_first_y = 0;
+	int64_t previous_second_x = 0, previous_second_y = 0;
+	for (uint32_t index = 0; index <= steps; ++index) {
+		int64_t first_x = sandcodex_touch_stroke_coordinate(first_start_x,
+			first_end_x, index, steps);
+		int64_t first_y = sandcodex_touch_stroke_coordinate(first_start_y,
+			first_end_y, index, steps);
+		int64_t second_x = sandcodex_touch_stroke_coordinate(second_start_x,
+			second_end_x, index, steps);
+		int64_t second_y = sandcodex_touch_stroke_coordinate(second_start_y,
+			second_end_y, index, steps);
+		if ((first_x == second_x && first_y == second_y) ||
+				(index > 0 && first_x == previous_first_x &&
+				 first_y == previous_first_y && second_x == previous_second_x &&
+				 second_y == previous_second_y)) {
+			return false;
+		}
+		previous_first_x = first_x;
+		previous_first_y = first_y;
+		previous_second_x = second_x;
+		previous_second_y = second_y;
+	}
+	return true;
+}
