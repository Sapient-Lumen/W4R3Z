+static int64_t sandcodex_touch_stroke_coordinate(int64_t start, int64_t end,
+		uint32_t index, uint32_t steps) {
+	if (index == 0 || start == end) {
+		return start;
+	}
+	if (index >= steps) {
+		return end;
+	}
+	int64_t delta = end - start;
+	int64_t numerator = delta * (int64_t)index;
+	return start + numerator / (int64_t)steps;
+}
