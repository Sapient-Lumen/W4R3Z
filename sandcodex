                self.compositor_stylus_stroke_dispatches += 1
                self.last_compositor_stylus_stroke_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_stylus_stroke_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor stylus stroke failed closed: {error}"
                ) from error

