sc_prepare_inner_jail() {
  SC_JAIL_DATA="$SC_WORK/agent/inner-jail"
  SC_JAIL_ENV="$SC_WORK/agent/inner-jail.json"
  SC_JAIL_WORKSPACES="$SC_WORK/inner-jail/workspaces"
  SC_JAIL_CACHES="$SC_WORK/inner-jail/caches"
  SC_JAIL_STORAGE_REGISTRY="$SC_WORK/agent/jail-workspace-registry"
  sc_prepare_jail_storage_budget
  SC_JAIL_SEALED_INPUTS="$SC_WORK/agent/sealed-inputs"
  SC_JAIL_RECEIPTS="$SC_WORK/agent/jail-receipts"
  SC_JAIL_BROKER_ROOT=""
  SC_JAIL_BROKER_SOCKET="$SC_JAIL_DATA/broker.sock"
  SC_JAIL_RELAY_ROOT="$SC_WORK/inner-jail/relays"
  SC_JAIL_AUDIT_LOG="$SC_WORK/logs/inner-jail-audit.jsonl"
  if (( ! SC_BARE && ! SC_RESOURCE_SCOPE )); then
    sc_prepare_unavailable_inner_jail \
      "disabled by explicit --no-resource-scope; cgroup-backed inner-jail action scopes require systemd-run"
    return 0
  fi
  SC_JAIL_AVAILABLE=1
  local stage="$SC_WORK/agent/.inner-jail.$$" old="$SC_JAIL_DATA"
  local delegated=false network_modes='["none"]' default_network=none outer_mode proxy_kind="$SC_JAIL_NETWORK_CEILING"
  local outer_network_mode=none proxy_transports='[]'
  local file_ceiling=null tmp_ceiling=null home_ceiling=null default_resources=custom
  local storage_budget=null storage_metering=observed-tree-usage
  local -a minimal=(bash sh basename cat chmod cp cut date dd dirname echo env false head id
    install ln ls mkdir mktemp mv numfmt od paste printenv printf pwd readlink realpath rm
    rmdir seq sha256sum sleep sort stat tail tee test timeout touch tr true truncate uname
    uniq wc find xargs awk grep egrep fgrep sed jq curl)
  local -a python=("${minimal[@]}" python python3 pip pip3 pytest)
  local -a node=("${minimal[@]}" node npm npx)
  local -a build=("${python[@]}" node npm npx gcc cc g++ c++ cpp make cmake ctest ninja
    pkg-config git patch tar gzip gunzip zip unzip xz file diff cmp rg fd yq rsync tree
    ssh scp shellcheck)
  if [[ "${SANDCODEX_TESTING:-0}" != 1 || "${SANDCODEX_NO_NIX:-0}" != 1 ]]; then
    build+=(go cargo rustc)
  fi

  if [[ -e $old || -L $old ]]; then
    [[ -d $old && ! -L $old && $(sc_owner_uid "$old") == "$EUID" ]] || \
      sc_jail_fatal "inner-jail protected data has an invalid type or owner: $old"
    sc_assert_no_mounts_at_or_below "$old" 1 'inner-jail protected data'
    rm -rf -- "$old"
  fi
  [[ ! -e $stage && ! -L $stage ]] || sc_jail_fatal 'inner-jail staging path already exists'
  mkdir -p -- "$stage/profiles" "$stage/etc"
  chmod 700 -- "$stage" "$stage/profiles" "$stage/etc"
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
    install -m 500 -- "$(type -P true)" "$stage/seccomp-exec"
  else
    sc_build_jail_seccomp_executor "$stage"
  fi
  sc_write_jail_support_scripts "$stage"
  sc_prepare_jail_profile "$stage" minimal "${minimal[@]}"
  sc_prepare_jail_profile "$stage" python "${python[@]}"
  sc_prepare_jail_profile "$stage" node "${node[@]}"
  sc_prepare_jail_profile "$stage" build "${build[@]}"
  printf 'worker:x:65534:65534:Inner jail worker:/home/worker:/bin/sh\n' >"$stage/etc/passwd"
  printf 'worker:x:65534:\n' >"$stage/etc/group"
  printf '127.0.0.1 localhost\n::1 localhost\n' >"$stage/etc/hosts"
  printf '# DNS is intentionally absent; delegated HTTP(S) uses the fixed proxy.\n' >"$stage/etc/resolv.conf"
  printf 'landlock-must-deny-this-file\n' >"$stage/landlock-canary"
  chmod 600 "$stage"/certificate-path "$stage"/profiles/*/commands.json \
    "$stage"/profiles/*/closure "$stage"/profiles/*/identity.json
  chmod 444 "$stage/etc/"* "$stage/landlock-canary"
  mv -T -- "$stage" "$old"

  sc_ensure_dir "$SC_WORK/inner-jail" "inner-jail state"
  sc_ensure_dir "$SC_WORK/logs" "inner-jail log state"
  sc_ensure_dir "$SC_JAIL_WORKSPACES" "inner-jail workspaces"
  sc_ensure_dir "$SC_JAIL_CACHES" "inner-jail caches"
  sc_remove_legacy_jail_storage_guards
  sc_ensure_dir "$SC_JAIL_STORAGE_REGISTRY" "inner-jail workspace registry"
  sc_ensure_dir "$SC_JAIL_SEALED_INPUTS" "inner-jail sealed inputs"
  sc_ensure_dir "$SC_JAIL_RECEIPTS" "inner-jail action receipts"
  sc_ensure_dir "$SC_JAIL_WORKSPACES/default" "default inner-jail workspace"
  sc_ensure_dir "$SC_JAIL_CACHES/default" "default inner-jail cache"
  sc_ensure_dir "$SC_JAIL_RELAY_ROOT" "inner-jail relay root"
  local audit_tmp=''
  if [[ -e $SC_JAIL_AUDIT_LOG || -L $SC_JAIL_AUDIT_LOG ]]; then
    sc_owned_single_file "$SC_JAIL_AUDIT_LOG" 600 'inner-jail audit log'
    chmod 600 -- "$SC_JAIL_AUDIT_LOG"
  else
    audit_tmp=$(mktemp "$SC_WORK/logs/.inner-jail-audit.XXXXXX")
    chmod 600 -- "$audit_tmp"
    mv -fT -- "$audit_tmp" "$SC_JAIL_AUDIT_LOG"
  fi
  sc_owned_single_file "$SC_JAIL_AUDIT_LOG" 600 'inner-jail audit log'
  local audit_index audit_archive
  for ((audit_index=1; audit_index<=SC_JAIL_AUDIT_KEEP_COUNT; audit_index++)); do
    audit_archive="$SC_JAIL_AUDIT_LOG.$audit_index"
    if [[ -e $audit_archive || -L $audit_archive ]]; then
      sc_owned_single_file "$audit_archive" 600 "inner-jail audit archive $audit_index"
      chmod 600 -- "$audit_archive"
    fi
  done
  if [[ $SC_JAIL_NETWORK_CEILING != none ]]; then
    delegated=true; network_modes='["none","delegated"]'; default_network=delegated
  fi
  outer_mode=$([[ $SC_BARE == 1 ]] && printf bare || printf sandbox)
  if (( SC_BARE || SC_DEV_NET )); then outer_network_mode=unrestricted; else outer_network_mode='provider-only'; fi
  if [[ $SC_JAIL_NETWORK_CEILING != none ]]; then
    proxy_transports='["HTTP","HTTPS CONNECT"]'
    if [[ $outer_network_mode == unrestricted ]]; then
      proxy_transports='["HTTP","HTTPS CONNECT","SOCKS5"]'
    fi
  fi
  [[ $SC_JAIL_FILE_CEILING_MIB == null ]] || file_ceiling=$((SC_JAIL_FILE_CEILING_MIB * 1024 * 1024))
  [[ $SC_JAIL_TMP_CEILING_MIB == null ]] || tmp_ceiling=$((SC_JAIL_TMP_CEILING_MIB * 1024 * 1024))
  [[ $SC_JAIL_HOME_CEILING_MIB == null ]] || home_ceiling=$((SC_JAIL_HOME_CEILING_MIB * 1024 * 1024))
  if [[ $SC_JAIL_STORAGE_BUDGET_MIB != null ]]; then
    storage_budget=$((SC_JAIL_STORAGE_BUDGET_MIB * 1024 * 1024))
    storage_metering=fixed-ext4-filesystem-capacity
  fi
  if [[ $SC_JAIL_TIMEOUT_CEILING == null && $SC_JAIL_CPU_CEILING == null &&
    $SC_JAIL_MEMORY_CEILING == null && $SC_JAIL_SWAP_CEILING == null &&
    $SC_JAIL_PIDS_CEILING == null && $file_ceiling == null && $tmp_ceiling == null &&
    $home_ceiling == null ]]; then
    default_resources=heavy
  elif [[ $SC_JAIL_TIMEOUT_CEILING == "$SC_JAIL_BOUNDED_TIMEOUT" &&
    $SC_JAIL_CPU_CEILING == "$SC_JAIL_BOUNDED_CPU_PERCENT" &&
    $SC_JAIL_MEMORY_CEILING == "$SC_JAIL_BOUNDED_MEMORY_MIB" &&
    $SC_JAIL_SWAP_CEILING == "$SC_JAIL_BOUNDED_SWAP_MIB" &&
    $SC_JAIL_PIDS_CEILING == "$SC_JAIL_BOUNDED_PIDS" &&
    $file_ceiling == "$SC_JAIL_BOUNDED_FILE_SIZE_BYTES" &&
    $tmp_ceiling == "$SC_JAIL_BOUNDED_TMP_BYTES" &&
    $home_ceiling == "$SC_JAIL_BOUNDED_HOME_BYTES" ]]; then
    default_resources=bounded
