    def guarded_relative_motion(
        self,
        x: int,
        y: int,
        dx: int,
        dy: int,
        steps: int,
        duration_milliseconds: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor relative-motion authority is unavailable")
        if type(x) is not int or type(y) is not int:
            raise ToolError("compositor relative-motion coordinates must be integers")
        if not 0 <= x <= SWAY_HIT_TEST_MAX_COORDINATE or not 0 <= y <= SWAY_HIT_TEST_MAX_COORDINATE:
            raise ToolError("compositor relative-motion coordinates exceed the sealed range")
        if type(dx) is not int or type(dy) is not int:
            raise ToolError("relative-motion vector components must be integers")
        if not -RELATIVE_MOTION_MAX_DELTA <= dx <= RELATIVE_MOTION_MAX_DELTA or not -RELATIVE_MOTION_MAX_DELTA <= dy <= RELATIVE_MOTION_MAX_DELTA or (dx == 0 and dy == 0):
            raise ToolError("relative-motion vector is empty or outside the sealed range")
