+static bool sandcodex_emit_locked_relative_motion(
+        struct wlr_relative_pointer_manager_v1 *manager,
+        struct wlr_seat *seat, int32_t dx, int32_t dy, uint32_t steps,
+        uint32_t duration_msec, uint32_t base_time) {
+    if (!manager || !seat ||
+            !sandcodex_relative_motion_shape_valid(0, 0, dx, dy, steps,
+                duration_msec) || base_time > UINT32_MAX - duration_msec) {
+        return false;
+    }
+    int32_t step_dx[SANDCODEX_RELATIVE_MOTION_MAX_STEPS] = {0};
+    int32_t step_dy[SANDCODEX_RELATIVE_MOTION_MAX_STEPS] = {0};
+    uint32_t offsets[SANDCODEX_RELATIVE_MOTION_MAX_STEPS] = {0};
+    int64_t previous_x = 0;
+    int64_t previous_y = 0;
+    uint32_t previous_offset = 0;
+    for (uint32_t index = 1; index <= steps; ++index) {
+        int64_t cumulative_x = ((int64_t)dx * index) / steps;
+        int64_t cumulative_y = ((int64_t)dy * index) / steps;
+        uint32_t offset = (uint32_t)(((uint64_t)duration_msec * index) / steps);
+        int64_t part_x = cumulative_x - previous_x;
+        int64_t part_y = cumulative_y - previous_y;
+        if (part_x < INT32_MIN || part_x > INT32_MAX ||
+                part_y < INT32_MIN || part_y > INT32_MAX ||
+                (part_x == 0 && part_y == 0) || offset <= previous_offset) {
+            return false;
+        }
+        step_dx[index - 1] = (int32_t)part_x;
+        step_dy[index - 1] = (int32_t)part_y;
+        offsets[index - 1] = offset;
+        previous_x = cumulative_x;
+        previous_y = cumulative_y;
+        previous_offset = offset;
+    }
+    if (previous_x != dx || previous_y != dy ||
+            previous_offset != duration_msec) {
+        return false;
+    }
+    /* Every fallible shape and timestamp branch completes before the first
+     * client-visible relative_motion event. */
+    for (uint32_t index = 0; index < steps; ++index) {
+        uint64_t time_usec =
+            ((uint64_t)base_time + offsets[index]) * UINT64_C(1000);
+        wlr_relative_pointer_manager_v1_send_relative_motion(manager, seat,
+            time_usec, (double)step_dx[index], (double)step_dy[index],
+            (double)step_dx[index], (double)step_dy[index]);
+    }
