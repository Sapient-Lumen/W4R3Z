  esac
  return 1
}

sc_unix_socket_path_active() {
  local wanted="$1"
  python3 -P - "$wanted" <<'PY'
import os
import pathlib
import sys

def sc_stable_proc_namespace_snapshot(process, known_namespaces):
    """Return one stable namespace identity and optional socket rows.

    ``process`` is a ``pathlib.Path`` for a numeric `/proc` entry.  A namespace
    already present in ``known_namespaces`` returns ``rows=None`` only after the
    process birth and namespace identities are rechecked.  Any malformed or
    changing evidence raises ``OSError`` or ``ValueError`` so the caller does
    not mark an unstable namespace as scanned.
    """

    def birth():
        line = (process / "stat").read_text(errors="strict")
        parts = line.rsplit(") ", 1)
        if len(parts) != 2:
            raise ValueError("malformed process stat")
        fields = parts[1].split()
        if len(fields) <= 19 or fields[0] in {"Z", "X", "x"}:
            raise ValueError("unusable process stat")
        return fields[19]

    born_before = birth()
    namespace_before = os.stat(process / "ns/net")
    namespace_identity = (namespace_before.st_dev, namespace_before.st_ino)
    rows = None
    if namespace_identity not in known_namespaces:
        rows = (process / "net/unix").read_text(errors="strict").splitlines()[1:]
    namespace_after = os.stat(process / "ns/net")
    born_after = birth()
    if born_before != born_after or (
        namespace_after.st_dev,
        namespace_after.st_ino,
    ) != namespace_identity:
        raise OSError("process or network namespace changed during socket snapshot")
    return namespace_identity, rows

target_path = sys.argv[1]
try:
    target = os.stat(target_path, follow_symlinks=False)
except OSError:
    raise SystemExit(1)

identity = (target.st_dev, target.st_ino)
uid = os.getuid()
namespaces = set()
for process in pathlib.Path("/proc").iterdir():
    if not process.name.isdigit():
        continue
    try:
        if process.stat().st_uid != uid:
            continue
        namespace_identity, rows = sc_stable_proc_namespace_snapshot(
            process, namespaces
        )
        if rows is None:
            continue
    except (OSError, UnicodeError, ValueError):
        continue
    namespaces.add(namespace_identity)
    for row in rows:
        fields = row.split(maxsplit=7)
        if len(fields) != 8:
            continue
        bound = fields[7]
        if bound == target_path:
            raise SystemExit(0)
        if bound.startswith("/"):
            candidate = process / "root" / bound.lstrip("/")
        elif not bound.startswith("@"):
            candidate = process / "cwd" / bound
        else:
            continue
        try:
            observed = os.stat(candidate, follow_symlinks=False)
        except OSError:
            continue
        if (observed.st_dev, observed.st_ino) == identity:
            raise SystemExit(0)
raise SystemExit(1)
PY
}

sc_fifo_path_active() {
  local wanted="$1"
  python3 -P - "$wanted" <<'PY'
import os
import pathlib
import stat
import sys

try:
    target = os.stat(sys.argv[1], follow_symlinks=False)
except OSError:
    raise SystemExit(2)
if not stat.S_ISFIFO(target.st_mode):
    raise SystemExit(2)

uid = os.getuid()
for process in pathlib.Path("/proc").iterdir():
    if not process.name.isdigit():
        continue
    try:
        if process.stat().st_uid != uid:
            continue
        descriptors = os.scandir(process / "fd")
    except OSError:
        continue
    with descriptors:
        for descriptor in descriptors:
            try:
                if os.readlink(descriptor.path) == sys.argv[1]:
                    raise SystemExit(0)
            except OSError:
                continue
raise SystemExit(1)
PY
}

