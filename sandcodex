sc_browser_extension_readiness_issue() {
  python3 -P - "$1" <<'PY'
from __future__ import annotations

import json
from pathlib import Path, PurePosixPath
import sys

manifest_path = Path(sys.argv[1])
root = manifest_path.parent.resolve(strict=True)
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except Exception as error:
    print(f"manifest could not be read: {error}")
    raise SystemExit(1)

references: list[tuple[str, str]] = []

def add(label: str, value: object) -> None:
    if value is None or value == "":
        return
    if not isinstance(value, str):
        print(f"{label} must be a string")
        raise SystemExit(1)
    references.append((label, value))

def add_many(label: str, value: object) -> None:
    if value is None:
        return
    if not isinstance(value, list):
        print(f"{label} must be an array")
        raise SystemExit(1)
    for index, entry in enumerate(value):
        add(f"{label}[{index}]", entry)

background = manifest.get("background")
if background is not None:
    if not isinstance(background, dict):
        print("background must be an object")
        raise SystemExit(1)
    add("background.service_worker", background.get("service_worker"))
    add("background.page", background.get("page"))
    add_many("background.scripts", background.get("scripts"))

content_scripts = manifest.get("content_scripts", [])
if not isinstance(content_scripts, list):
    print("content_scripts must be an array")
    raise SystemExit(1)
for index, entry in enumerate(content_scripts):
    if not isinstance(entry, dict):
        print(f"content_scripts[{index}] must be an object")
        raise SystemExit(1)
    add_many(f"content_scripts[{index}].js", entry.get("js"))
    add_many(f"content_scripts[{index}].css", entry.get("css"))

for key in ("action", "browser_action", "page_action"):
    value = manifest.get(key)
    if value is not None:
        if not isinstance(value, dict):
            print(f"{key} must be an object")
            raise SystemExit(1)
        add(f"{key}.default_popup", value.get("default_popup"))

add("options_page", manifest.get("options_page"))
options_ui = manifest.get("options_ui")
if options_ui is not None:
    if not isinstance(options_ui, dict):
        print("options_ui must be an object")
        raise SystemExit(1)
    add("options_ui.page", options_ui.get("page"))
add("devtools_page", manifest.get("devtools_page"))
side_panel = manifest.get("side_panel")
if side_panel is not None:
    if not isinstance(side_panel, dict):
        print("side_panel must be an object")
        raise SystemExit(1)
    add("side_panel.default_path", side_panel.get("default_path"))
overrides = manifest.get("chrome_url_overrides")
if overrides is not None:
    if not isinstance(overrides, dict):
        print("chrome_url_overrides must be an object")
        raise SystemExit(1)
    for key, value in overrides.items():
        add(f"chrome_url_overrides.{key}", value)
sandbox = manifest.get("sandbox")
if sandbox is not None:
    if not isinstance(sandbox, dict):
        print("sandbox must be an object")
        raise SystemExit(1)
    add_many("sandbox.pages", sandbox.get("pages"))

for label, value in references:
    relative = value[1:] if value.startswith("/") else value
    pure = PurePosixPath(relative)
    if not relative or "\\" in relative or pure.is_absolute() or ".." in pure.parts:
        print(f"{label} has an unsafe extension path: {json.dumps(value)}")
        raise SystemExit(1)
    target = (root / Path(*pure.parts)).resolve(strict=False)
    try:
        target.relative_to(root)
    except ValueError:
        print(f"{label} escapes the extension root: {json.dumps(value)}")
        raise SystemExit(1)
    if not target.is_file():
        print(f"{label} is missing: {json.dumps(value)}")
        raise SystemExit(1)
