        transient_points = [
            point
            for point in route.get("points", [])
            if isinstance(point, dict) and point.get("transient_owner_sha256") is not None
        ]
        occlusion_points = [
            point
            for point in route.get("points", [])
            if isinstance(point, dict) and point.get("occlusion_owner_sha256") is not None
        ]
        popup_axis_seal: dict[str, Any] | None = None
        if action_name == "desktop_scroll" and transient_points:
            point = transient_points[0]
            popup_axis_seal = {
                "schema": SCENE_TRANSIENT_AXIS_SCHEMA,
                "enforced": True,
                "scene_transient_map_sha256": route.get("scene_transient_map_sha256"),
                "owner_sha256": point.get("transient_owner_sha256"),
