                "axis_unit": point.get("occlusion_axis_unit"),
                "logical_step_ceiling": SCENE_OCCLUSION_AXIS_MAX_LOGICAL_STEPS,
                "modifier_authority": "none",
                "axis_transport": SCENE_OCCLUSION_AXIS_TRANSPORT,
                "continuation_authority": "fresh-observation-and-map-required",
            }
        dispatch_schema_by_unit = {
            "complete-stylus-hover": STYLUS_HOVER_DISPATCH_SEAL_SCHEMA,
            "complete-stylus-stroke": STYLUS_STROKE_DISPATCH_SEAL_SCHEMA,
