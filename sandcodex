int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc != 4) {
        fputs("usage: wayland-selection-agent PROFILE OUTPUT_FD MAXIMUM_BYTES\n", stderr);
        return 64;
    }
    enum capture_profile profile = PROFILE_TEXT;
    uint64_t descriptor_value = 0U;
    uint64_t maximum_value = 0U;
    if (!parse_profile(argv[1], &profile)) {
        fputs("sandcodex-wayland-selection-agent: invalid profile, output descriptor, or maximum\n", stderr);
        return 64;
    }
    const uint64_t minimum_value = profile == PROFILE_PNG ? MIN_PNG_BYTES : 1U;
    const uint64_t maximum_profile_value = profile == PROFILE_PNG
        ? MAX_PNG_CAPTURE_BYTES
        : profile == PROFILE_FILES ? MAX_FILE_URI_LIST_BYTES : MAX_TEXT_CAPTURE_BYTES;
    if (!parse_u64(argv[2], 3U, INT_MAX, &descriptor_value) ||
            !parse_u64(argv[3], minimum_value, maximum_profile_value,
                &maximum_value)) {
        fputs("sandcodex-wayland-selection-agent: invalid profile, output descriptor, or maximum\n", stderr);
        return 64;
    }
    const int output_descriptor = (int)descriptor_value;
    const size_t maximum_bytes = (size_t)maximum_value;
    struct sigaction action = {0};
    action.sa_handler = on_signal;
    if (sigemptyset(&action.sa_mask) < 0 ||
            sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0) {
        perror("sandcodex-wayland-selection-agent: sigaction");
        return 70;
    }
    struct sigaction ignore = {0};
    ignore.sa_handler = SIG_IGN;
    if (sigemptyset(&ignore.sa_mask) < 0 || sigaction(SIGPIPE, &ignore, NULL) < 0) {
        perror("sandcodex-wayland-selection-agent: sigaction SIGPIPE");
        return 70;
    }
    if (harden_process(output_descriptor) < 0) {
        perror("sandcodex-wayland-selection-agent: process hardening");
        return 70;
    }
    if (setvbuf(stdout, NULL, _IOLBF, 0U) != 0) {
        fputs("sandcodex-wayland-selection-agent: stdout buffering failed\n", stderr);
        return 70;
    }

    struct selection_state state = {
        .profile = profile,
        .output_descriptor = output_descriptor,
        .maximum_bytes = maximum_bytes,
    };
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-selection-agent: Wayland initialization");
        cleanup(&state);
        return 71;
    }
    printf("READY %s PROFILE %s MANAGER %u SEATS %u MAX %zu CLEARED 1\n",
        AGENT_PROTOCOL, profile_name(state.profile), state.manager_version,
        state.seat_count, state.maximum_bytes);

    char line[MAX_LINE_BYTES + 2U];
    uint64_t expected_sequence = 1U;
    int exit_code = 0;
    while (!stop_requested && fgets(line, sizeof(line), stdin) != NULL) {
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n' ||
                (length == MAX_LINE_BYTES + 1U && line[length - 1U] != '\n')) {
            reply_error(expected_sequence, "malformed-command", &state);
            exit_code = 72;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            reply_error(expected_sequence, "invalid-command", &state);
            exit_code = 72;
            break;
        }
        if (command.kind == COMMAND_ARM) {
            if (arm_capture(&state) < 0) {
                reply_error(command.sequence, "arm-failed", &state);
                exit_code = 73;
                break;
            }
            fprintf(stdout, "ARMED %" PRIu64 " GENERATION %u CLEARED 1\n",
                command.sequence, state.armed_generation);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_NEXT) {
            struct offer_slot *offer = NULL;
            if (next_offer(&state, command.timeout_milliseconds,
                    command.quiet_milliseconds, &offer) < 0 || offer == NULL) {
                reply_error(command.sequence, error_reason(errno), &state);
                exit_code = 74;
                break;
            }
            const char *mime = preferred_mime(&state, offer);
            if (mime == NULL) {
                reply_error(command.sequence, "offer-mime-invalid", &state);
                exit_code = 74;
                break;
            }
            fprintf(stdout,
                "OFFER %" PRIu64 " ID %u MIME %s GENERATION %u\n",
                command.sequence, offer->id, mime, state.selection_generation);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_CAPTURE) {
            if (capture_offer(&state, command.offer_id) < 0) {
                reply_error(command.sequence, error_reason(errno), &state);
                exit_code = 75;
                break;
            }
            fprintf(stdout,
                "CAPTURED %" PRIu64 " ID %u MIME %s BYTES %zu\n",
                command.sequence, state.captured_offer_id,
                state.captured_mime, state.captured_bytes);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_CLEAR) {
            if (clear_selection(&state, false) < 0) {
                reply_error(command.sequence, "clear-unconfirmed", &state);
                exit_code = 76;
                break;
            }
            fprintf(stdout,
                "CLEARED %" PRIu64 " OFFERS %u GENERATION %u BYTES %zu\n",
                command.sequence, state.offers_seen, state.selection_generation,
                state.captured_bytes);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_PING) {
            if (display_roundtrip(&state) < 0) {
                reply_error(command.sequence, "wayland-ping-failed", &state);
                exit_code = 77;
                break;
            }
            fprintf(stdout, "PONG %" PRIu64 "\n", command.sequence);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_QUIT) {
            if (!state.final_clear_confirmed && clear_selection(&state, false) < 0) {
                reply_error(command.sequence, "quit-clear-unconfirmed", &state);
                exit_code = 76;
                break;
            }
            fprintf(stdout,
                "BYE %" PRIu64 " CAPTURED %u BYTES %zu CLEARED 1\n",
                command.sequence, state.capture_complete ? 1U : 0U,
                state.captured_bytes);
            (void)fflush(stdout);
            expected_sequence++;
            break;
        }
        expected_sequence++;
        if (expected_sequence == 0U) {
            exit_code = 72;
            break;
        }
    }
    if (!stop_requested && ferror(stdin)) {
        exit_code = 78;
    }
    cleanup(&state);
    return exit_code;
}
WAYLAND_SELECTION_AGENT_C
}

