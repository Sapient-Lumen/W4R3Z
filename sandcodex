    normalized = os.path.normpath(value)
    if normalized == ".." or normalized.startswith("../"):
        raise ValueError(f"{label} escaped its fixed root")
    return normalized

def mount_path(value):
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)

def reject_nested_mounts(path, label):
    target = str(path)
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8") as stream:
            for line in stream:
                fields = line.split()
                if len(fields) < 5:
                    raise ValueError("kernel mount inventory is malformed")
                mounted = mount_path(fields[4])
                if mounted == target or mounted.startswith(target.rstrip("/") + "/"):
                    raise ValueError(f"{label} contains a mounted filesystem: {mounted}")
    except OSError as error:
        raise ValueError("kernel mount inventory is unavailable") from error

def open_source_child(parent_fd, name, label):
    try:
        info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except OSError as error:
        raise ValueError(f"{label} is unavailable: {error}") from error
    if info.st_uid != os.geteuid():
        raise ValueError(f"{label} has a foreign-owned entry")
    if stat.S_ISDIR(info.st_mode):
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
        flags = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW
    else:
        raise ValueError(f"{label} contains a special or hardlinked entry")
    try:
        descriptor = os.open(name, flags, dir_fd=parent_fd)
    except OSError as error:
        raise ValueError(f"{label} changed during capture: {error}") from error
    opened = os.fstat(descriptor)
    if ((opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino) or
            opened.st_uid != os.geteuid() or
            stat.S_IFMT(opened.st_mode) != stat.S_IFMT(info.st_mode) or
            (stat.S_ISREG(opened.st_mode) and opened.st_nlink != 1)):
        os.close(descriptor)
        raise ValueError(f"{label} changed identity during capture")
    return descriptor, opened

def source_path(relative):
    relative = canonical_relative(relative, "sealed input source", allow_dot=True)
    if any(part == ".sandcodex" for part in relative.split("/")):
        raise ValueError("sealed inputs cannot include provider control state")
    candidate = project if relative == "." else project.joinpath(*relative.split("/"))
    if os.path.realpath(candidate) != str(candidate):
        raise ValueError("sealed input source has a symlink component")
    reject_nested_mounts(candidate, "sealed input source")
    descriptor = os.open(
        project, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    )
    try:
        project_opened = os.fstat(descriptor)
        if ((project_opened.st_dev, project_opened.st_ino) !=
                (project_info.st_dev, project_info.st_ino)):
            raise ValueError("selected project changed identity during sealed-input capture")
        if relative != ".":
            for index, component in enumerate(relative.split("/")):
                child, info = open_source_child(
                    descriptor, component,
                    "sealed input source" if index == len(relative.split("/")) - 1
                    else "sealed input source path",
                )
                if index != len(relative.split("/")) - 1 and not stat.S_ISDIR(info.st_mode):
                    os.close(child)
                    raise ValueError("sealed input source has a nondirectory path component")
                os.close(descriptor)
                descriptor = child
        info = os.fstat(descriptor)
        if not (stat.S_ISDIR(info.st_mode) or
                (stat.S_ISREG(info.st_mode) and info.st_nlink == 1)):
            raise ValueError("sealed input source must be a user-owned regular file or directory")
        return relative, candidate, descriptor, info
    except BaseException:
        os.close(descriptor)
        raise

def copy_sealed_entry(source_fd, destination, relative, records, totals):
    info = os.fstat(source_fd)
    if info.st_uid != os.geteuid():
        raise ValueError(f"sealed input has a foreign-owned entry: {relative}")
    if stat.S_ISDIR(info.st_mode):
        os.mkdir(destination, 0o700)
        records.append({"path": relative, "type": "directory", "mode": 0o755})
        for name in sorted(os.listdir(source_fd), key=os.fsencode):
            try:
                name.encode("utf-8")
            except UnicodeEncodeError as error:
                raise ValueError("sealed input contains a non-UTF-8 directory entry") from error
            if (name in {".", ".."} or "/" in name or
                    any(unicodedata.category(character) in {"Cc", "Cf", "Cs"} for character in name)):
                raise ValueError("sealed input contains an invalid directory entry")
            if name == ".sandcodex":
                continue
            child_relative = name if relative == "." else relative + "/" + name
            child_fd, _ = open_source_child(source_fd, name, f"sealed input {child_relative}")
            try:
                copy_sealed_entry(
                    child_fd, destination / name, child_relative, records, totals
                )
            finally:
                os.close(child_fd)
        os.chmod(destination, 0o755)
        return
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise ValueError(f"sealed input contains a special or hardlinked entry: {relative}")
    totals["files"] += 1
    if totals["files"] > seal_max_files:
        raise ValueError(f"sealed input exceeds the {seal_max_files}-file limit")
    destination_fd = -1
    try:
        mode = 0o555 if info.st_mode & 0o111 else 0o444
        destination_fd = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            mode,
        )
        digest = hashlib.sha256()
        copied = 0
        while True:
            chunk = os.read(source_fd, 1024 * 1024)
            if not chunk:
                break
            copied += len(chunk)
            totals["bytes"] += len(chunk)
            if totals["bytes"] > seal_max_bytes:
                raise ValueError(f"sealed input exceeds the {seal_max_bytes}-byte limit")
            digest.update(chunk)
            view = memoryview(chunk)
            while view:
                written = os.write(destination_fd, view)
                if written <= 0:
                    raise OSError("sealed input copy made no progress")
                view = view[written:]
        os.fsync(destination_fd)
        os.chmod(destination, mode, follow_symlinks=False)
        records.append({
            "path": relative, "type": "file", "mode": mode,
            "bytes": copied, "sha256": digest.hexdigest(),
        })
    finally:
        if destination_fd >= 0:
            os.close(destination_fd)

def seal_core(manifest):
    return {
        "schema": "sand-jail.sealed-input-core.v1",
        "source": manifest["source"],
        "root_type": manifest["root_type"],
        "entries": manifest["entries"],
        "total_bytes": manifest["total_bytes"],
        "file_count": manifest["file_count"],
    }

def seal_digest(manifest):
    encoded = json.dumps(seal_core(manifest), sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()

def validate_seal_id(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        raise ValueError("sealed input id must be 64 lowercase hexadecimal characters")
    return value

def load_seal(value, verify_content=True):
    value = validate_seal_id(value)
    object_root = sealed_root / value
    data = object_root / "data"
    manifest_path = object_root / "manifest.json"
    for path, kind, mode in (
            (object_root, stat.S_ISDIR, 0o700), (data, stat.S_ISDIR, 0o755),
            (manifest_path, stat.S_ISREG, 0o400)):
        info = path.lstat()
        if (not kind(info.st_mode) or info.st_uid != os.geteuid() or
                stat.S_IMODE(info.st_mode) != mode or
                (stat.S_ISREG(info.st_mode) and
                 (info.st_nlink != 1 or info.st_size > MAX_SEAL_MANIFEST_BYTES))):
            raise ValueError("sealed input object has an unsafe identity")
    try:
        manifest = json.loads(read_small_regular(manifest_path, MAX_SEAL_MANIFEST_BYTES))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError("sealed input manifest is unreadable") from error
    required = {
        "schema", "id", "created_at", "source", "root_type", "entries",
        "total_bytes", "file_count",
    }
    if (not isinstance(manifest, dict) or set(manifest) != required or
            manifest.get("schema") != "sand-jail.sealed-input.v1" or
            manifest.get("id") != value or seal_digest(manifest) != value or
            not isinstance(manifest.get("entries"), list) or
            manifest.get("file_count") != sum(
                item.get("type") == "file" for item in manifest["entries"]
                if isinstance(item, dict)
            )):
        raise ValueError("sealed input manifest identity is invalid")
    if not verify_content:
        return manifest
    reject_nested_mounts(data, "sealed input object")
    observed_bytes = 0
    observed_files = 0
    expected_paths = set()
    for record in manifest["entries"]:
        if not isinstance(record, dict) or record.get("type") not in {"file", "directory"}:
            raise ValueError("sealed input manifest contains an invalid entry")
        relative = canonical_relative(record.get("path"), "sealed manifest path", allow_dot=True)
        if relative in expected_paths:
            raise ValueError("sealed input manifest repeats a path")
        expected_paths.add(relative)
        path = data if relative == "." else data.joinpath(*relative.split("/"))
        info = path.lstat()
        if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != record.get("mode"):
            raise ValueError("sealed input entry metadata changed")
        if record["type"] == "directory":
            if not stat.S_ISDIR(info.st_mode):
                raise ValueError("sealed input directory changed type")
            continue
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size != record.get("bytes"):
            raise ValueError("sealed input file metadata changed")
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        digest = hashlib.sha256()
        size = 0
        try:
            while True:
                chunk = os.read(descriptor, 1024 * 1024)
                if not chunk:
                    break
                size += len(chunk)
                digest.update(chunk)
        finally:
            os.close(descriptor)
        if size != record["bytes"] or digest.hexdigest() != record.get("sha256"):
            raise ValueError("sealed input file content changed")
        observed_bytes += size
        observed_files += 1
    for current, directories, files in os.walk(data, topdown=True, followlinks=False):
        for name in directories + files:
            path = Path(current) / name
            relative = os.path.relpath(path, data)
            if relative not in expected_paths:
                raise ValueError("sealed input contains an unmanifested entry")
    if observed_bytes != manifest["total_bytes"] or observed_files != manifest["file_count"]:
        raise ValueError("sealed input totals are inconsistent")
    return manifest

def remove_staging(path):
    info = path.lstat()
    if stat.S_ISDIR(info.st_mode):
        os.chmod(path, 0o700, follow_symlinks=False)
        for entry in os.scandir(path):
            remove_staging(path / entry.name)
        os.rmdir(path)
        return
    os.chmod(path, 0o600, follow_symlinks=False)
    os.unlink(path)

def create_seal(relative):
    relative, source, source_fd, source_info = source_path(relative)
    with seal_lock:
        staging = sealed_root / (".stage-" + secrets.token_hex(12))
        data = staging / "data"
        os.mkdir(staging, 0o700)
        records = []
        totals = {"bytes": 0, "files": 0}
        try:
            if stat.S_ISDIR(source_info.st_mode):
                copy_sealed_entry(source_fd, data, ".", records, totals)
                root_type = "directory"
            else:
                os.mkdir(data, 0o700)
                copy_sealed_entry(source_fd, data / "input", "input", records, totals)
                os.chmod(data, 0o755)
                root_type = "file"
            reject_nested_mounts(source, "sealed input source")
            records.sort(key=lambda item: os.fsencode(item["path"]))
            manifest = {
                "schema": "sand-jail.sealed-input.v1",
                "id": "", "created_at": now(), "source": relative,
                "root_type": root_type, "entries": records,
                "total_bytes": totals["bytes"], "file_count": totals["files"],
            }
            manifest["id"] = seal_digest(manifest)
            manifest_path = staging / "manifest.json"
            encoded_manifest = (
                json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n"
            ).encode()
            if len(encoded_manifest) > MAX_SEAL_MANIFEST_BYTES:
                raise ValueError("sealed-input manifest exceeds its 16 MiB metadata bound")
            safe_write(manifest_path, encoded_manifest)
            os.chmod(manifest_path, 0o400)
            destination = sealed_root / manifest["id"]
            if destination.exists():
                existing = load_seal(manifest["id"])
                remove_staging(staging)
                return existing
            os.rename(staging, destination)
            descriptor = os.open(sealed_root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            return load_seal(manifest["id"])
        except BaseException:
            if staging.exists():
                remove_staging(staging)
            raise
        finally:
            os.close(source_fd)

def seal_summary(manifest):
    return {
        "schema": manifest["schema"], "id": manifest["id"],
        "root_type": manifest["root_type"], "total_bytes": manifest["total_bytes"],
        "file_count": manifest["file_count"], "created_at": manifest["created_at"],
        "source": manifest["source"],
    }

def handle_seal_request(request, peer_pid):
    if matching_grant(read_cgroup(peer_pid)) is not None:
        raise ValueError("recursive actions cannot create or enumerate sealed inputs")
    if not isinstance(request, dict) or request.get("schema") != "sand-jail.seal-request.v1":
        raise ValueError("sealed-input request schema is invalid")
    action = request.get("action")
    if action == "create" and set(request) == {"schema", "action", "source"}:
        manifest = create_seal(request["source"])
        audit("seal-created", sealed_input=manifest["id"], bytes=manifest["total_bytes"],
              files=manifest["file_count"])
        return seal_summary(manifest)
    if action == "inspect" and set(request) == {"schema", "action", "id"}:
        return seal_summary(load_seal(request["id"]))
    if action == "list" and set(request) == {"schema", "action"}:
        with seal_lock:
            newest = []
            total = 0
            for entry in os.scandir(sealed_root):
                if entry.name.startswith(".stage-"):
                    raise ValueError("sealed-input staging residue requires operator review")
                if not re.fullmatch(r"[0-9a-f]{64}", entry.name):
                    raise ValueError("sealed-input registry contains an unexpected entry")
                info = entry.stat(follow_symlinks=False)
                if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                        stat.S_IMODE(info.st_mode) != 0o700):
                    raise ValueError("sealed-input registry contains an unsafe object")
                total += 1
                item = (info.st_mtime_ns, entry.name)
                if len(newest) < 1024:
                    heapq.heappush(newest, item)
                else:
                    heapq.heappushpop(newest, item)
            rows = [
                seal_summary(load_seal(name))
                for _, name in sorted(newest)
            ]
        return {
            "schema": "sand-jail.sealed-input-list.v1",
            "total": total, "returned": len(rows), "truncated": total > len(rows),
            "sealed_inputs": rows,
        }
    raise ValueError("sealed-input request action or fields are invalid")

def validate_request(request, peer_pid):
    if not isinstance(request, dict) or request.get("schema") != "sand-jail.request.v3":
        raise ValueError("request schema is invalid")
    allowed = {"schema", "parent_token", "workspace", "profile", "network", "resource_profile", "timeout_seconds",
               "cwd", "cpu_percent", "memory_mib", "memory_swap_mib", "pids", "file_size_bytes",
               "tmp_bytes", "home_bytes", "argv", "proxy_url", "proxy_socket",
               "sealed_inputs", "result_paths", "report_receipt"}
    if set(request) != allowed:
        raise ValueError("request contains unsupported fields")
    peer_cgroup = read_cgroup(peer_pid)
    parent = matching_grant(peer_cgroup)
    parent_token = request["parent_token"]
    if parent is None:
        if parent_token is not None:
            raise ValueError("recursive grant is not active for this caller")
        depth = 1
        workspace_name = request["workspace"]
        workspace = canonical_workspace(workspace_name)
        cache = canonical_cache(workspace_name)
        profile_ceiling = "build"
        network_modes = {"none"} if network_ceiling == "none" else {"none", "delegated"}
        timeout_ceiling = timeout_max
        cpu_ceiling = cpu_max
        memory_ceiling = memory_max
        swap_ceiling = swap_max
        pids_ceiling = pids_max
        file_size_ceiling = file_size_max
        tmp_ceiling = tmp_max
        home_ceiling = home_max
        proxy_kind = network_ceiling
        proxy_url = None
        proxy_socket = None
        parent_seals = None
    else:
        if not isinstance(parent_token, str) or not secrets.compare_digest(parent_token, parent["token"]):
            raise ValueError("recursive request did not present its current immutable grant")
        if request["workspace"] is not None:
            raise ValueError("recursive requests inherit their workspace")
        depth = parent["depth"] + 1
        if depth > parent["max_depth"]:
            raise ValueError(f"recursive jail depth exhausted at {parent['max_depth']}")
        workspace_name = parent["workspace_name"]
        workspace = parent["workspace"]
        cache = parent["cache"]
        profile_ceiling = parent["profile"]
        network_modes = {"none", parent["network"]}
        timeout_ceiling = parent["timeout_seconds"]
        cpu_ceiling = parent["cpu_percent"]
        memory_ceiling = parent["memory_mib"]
        swap_ceiling = parent["memory_swap_mib"]
        pids_ceiling = parent["pids"]
        file_size_ceiling = parent["file_size_bytes"]
        tmp_ceiling = parent["tmp_bytes"]
        home_ceiling = parent["home_bytes"]
        proxy_kind = parent["proxy_kind"]
        proxy_url = parent["proxy_url"]
        proxy_socket = parent["proxy_socket"]
        parent_seals = set(parent["sealed_input_ids"])
        if request["proxy_url"] is not None or request["proxy_socket"] is not None:
            raise ValueError("recursive requests cannot replace their network transport")
    profile = request["profile"]
    if profile not in PROFILE_CHILDREN.get(profile_ceiling, set()):
        raise ValueError(f"tools profile exceeds parent ceiling {profile_ceiling}")
    tool_identity = profile_identities[profile]
    network = request["network"]
    if network not in network_modes:
        raise ValueError("delegated network was not authorized by the parent grant")
    if parent is None:
        if network == "delegated" and proxy_kind == "outer":
            proxy_url = validate_proxy(request["proxy_url"])
            proxy_socket = validate_relay(request["proxy_socket"])
        elif request["proxy_url"] is not None or request["proxy_socket"] is not None:
            raise ValueError("a proxy transport was supplied without an outer delegated grant")
    resources = {
        "timeout_seconds": bounded_optional(request["timeout_seconds"], "timeout", 1, MAX_TIMEOUT, timeout_ceiling),
        "cpu_percent": bounded_optional(request["cpu_percent"], "CPU percent", 1, MAX_CPU_PERCENT, cpu_ceiling),
        "memory_mib": bounded_optional(request["memory_mib"], "memory MiB", 32, MAX_MEMORY_MIB, memory_ceiling),
        "memory_swap_mib": bounded_optional(request["memory_swap_mib"], "swap MiB", 0,
                                               MAX_SWAP_MIB, swap_ceiling),
        "pids": bounded_optional(request["pids"], "pids", 8, MAX_PIDS, pids_ceiling),
        "file_size_bytes": bounded_optional(request["file_size_bytes"], "file size bytes", 1048576, MAX_STORAGE_BYTES, file_size_ceiling),
        "tmp_bytes": bounded_optional(request["tmp_bytes"], "tmp bytes", 1048576, MAX_STORAGE_BYTES, tmp_ceiling),
        "home_bytes": bounded_optional(request["home_bytes"], "home bytes", 1048576, MAX_STORAGE_BYTES, home_ceiling),
    }
    resource_profile = classify_resources(resources)
    if request["resource_profile"] != resource_profile:
        raise ValueError("resource profile does not match the effective resource vector")
    seconds = resources["timeout_seconds"]
    cpu = resources["cpu_percent"]
    memory = resources["memory_mib"]
    swap = resources["memory_swap_mib"]
    pids = resources["pids"]
    file_size = resources["file_size_bytes"]
    tmp_bytes = resources["tmp_bytes"]
    home_bytes = resources["home_bytes"]
    cwd = request["cwd"]
    if not isinstance(cwd, str) or not cwd or cwd.startswith("/") or "\x00" in cwd or "\n" in cwd or "\r" in cwd:
        raise ValueError("cwd must be a nonempty relative path")
    if any(component == ".." for component in cwd.split("/")):
        raise ValueError("--cwd escaped the selected workspace")
    normalized = os.path.normpath("/" + cwd).lstrip("/") or "."
    argv = request["argv"]
    if not isinstance(argv, list) or not 1 <= len(argv) <= 256 or not all(isinstance(item, str) and "\x00" not in item for item in argv):
        raise ValueError("argv must contain 1 through 256 strings")
    if sum(len(item.encode()) + 1 for item in argv) > 98304:
        raise ValueError("argv is too large")
    sealed_input_ids = request["sealed_inputs"]
    if (not isinstance(sealed_input_ids, list) or len(sealed_input_ids) > seal_max_count or
            not all(isinstance(item, str) for item in sealed_input_ids) or
            len(set(sealed_input_ids)) != len(sealed_input_ids)):
        raise ValueError(f"sealed_inputs must contain at most {seal_max_count} unique ids")
    sealed_input_ids = sorted(validate_seal_id(item) for item in sealed_input_ids)
    if parent_seals is not None and not set(sealed_input_ids).issubset(parent_seals):
        raise ValueError("recursive requests may inherit or drop sealed inputs, never add or replace them")
    sealed_inputs = [seal_summary(load_seal(item)) for item in sealed_input_ids]
    result_paths = request["result_paths"]
    if (not isinstance(result_paths, list) or len(result_paths) > result_max_count or
            not all(isinstance(item, str) for item in result_paths)):
        raise ValueError(f"result_paths must contain at most {result_max_count} relative paths")
    result_paths = [
        canonical_relative(item, "result path")
        for item in result_paths
    ]
    if len(set(result_paths)) != len(result_paths):
        raise ValueError("result_paths must not contain duplicates")
    if not isinstance(request["report_receipt"], bool):
        raise ValueError("report_receipt must be boolean")
    return {
        "schema": "sand-jail.grant.v3", "token": secrets.token_hex(24),
        "parent_token": parent["token"] if parent else None,
        "depth": depth, "max_depth": depth_max if parent is None else parent["max_depth"],
        "workspace_name": workspace_name, "workspace": workspace, "profile": profile,
        "cache": cache, "tool_identity": tool_identity,
        "network": network, "resource_profile": resource_profile, "timeout_seconds": seconds, "cwd": normalized,
        "cpu_percent": cpu, "memory_mib": memory, "memory_swap_mib": swap, "pids": pids,
        "file_size_bytes": file_size, "tmp_bytes": tmp_bytes, "home_bytes": home_bytes, "argv": argv,
        "proxy_kind": proxy_kind, "proxy_url": proxy_url, "proxy_socket": proxy_socket,
        "sealed_inputs": sealed_inputs, "sealed_input_ids": sealed_input_ids,
        "result_paths": result_paths, "report_receipt": request["report_receipt"],
        "budget_group": budget_group, "budget_max_bytes": budget_max_bytes,
        "budget_metering": budget_metering,
    }, parent

def safe_write(path, content):
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    try:
        remaining = memoryview(content)
        while remaining:
            written = os.write(fd, remaining)
            if written <= 0:
                raise OSError("protected write made no progress")
            remaining = remaining[written:]
        os.fsync(fd)
    finally:
        os.close(fd)

def request_file(grant):
    ident = secrets.token_hex(16)
    path = root / f"request-{ident}.json"
    safe_write(path, json.dumps(grant, sort_keys=True, separators=(",", ":")).encode() + b"\n")
    return path

def control_group(unit):
    result = subprocess.run(
        [systemctl, "--user", "show", unit, "--property=ControlGroup", "--value", "--no-pager"],
        env=manager_env, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        timeout=3, check=True,
    ).stdout.strip()
    if not result.startswith("/") or ".." in result.split("/"):
        raise ValueError("systemd did not return a safe jail cgroup")
    return result

def current_control_group():
    try:
        with open("/proc/self/cgroup", "r", encoding="utf-8") as stream:
            for line in stream:
                if line.startswith("0::/"):
                    result = line[3:].strip()
                    if result.startswith("/") and ".." not in result.split("/"):
                        return result
    except OSError:
        pass
    return None

def manager_control_group():
    try:
        result = subprocess.run(
            [systemctl, "--user", "show", "--property=ControlGroup", "--value", "--no-pager"],
            env=manager_env, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=3, check=True,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    if not result.startswith("/") or ".." in result.split("/"):
        return None
    return result

def action_transport():
    current = current_control_group()
    manager = manager_control_group()
    # systemd can adopt the caller into a scope only while it is already in the
    # user manager's cgroup subtree. Login shells and VM/container bridges are
    # commonly in a sibling session-*.scope, where the kernel rejects that
    # migration. A transient service starts below the user manager and retains
    # the same externally owned resource and delegation properties.
    if current is not None and manager is not None and (
            current == manager or current.startswith(manager.rstrip("/") + "/")):
        return "scope"
    return "service"

def write_control(path, value):
    fd = os.open(path, os.O_WRONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        os.write(fd, str(value).encode())
    finally:
        os.close(fd)

def resource_report(grant, expected_status):
    path = Path(grant["result_path"])
    if not path.exists() and not path.is_symlink():
        raise BrokerFailure("jail resource report is missing")
    info = path.lstat()
    if (path.parent != root or path.name != f"result-{grant['token']}.json" or
            not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or info.st_size > 4096):
        raise BrokerFailure("jail resource report has an unsafe identity")
    try:
        report = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise BrokerFailure("jail resource report is unreadable or malformed") from error
    required = {"schema", "status", "memory_oom", "memory_oom_kills", "memory_peak_bytes",
                "pids_max_events", "pids_peak", "cpu_nr_throttled", "cpu_throttled_usec"}
    if (not isinstance(report, dict) or set(report) != required or
            report.get("schema") != "sand-jail.resource-report.v1" or
            report.get("status") != expected_status):
        raise BrokerFailure("jail resource report does not match the completed action")
    for key in required - {"schema"}:
        value = report[key]
        if isinstance(value, bool) or (value is not None and (not isinstance(value, int) or value < 0)):
            raise BrokerFailure("jail resource report contains an invalid counter")
    return report

def tree_usage(path):
    root_path = Path(path)
    root_info = root_path.lstat()
    if not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != os.geteuid():
        raise BrokerFailure("persistent tree has an unsafe root")
    totals = {
        "logical_bytes": 0, "allocated_bytes": root_info.st_blocks * 512,
        "entries": 0, "regular_files": 0, "directories": 1,
        "symlinks": 0, "special_entries": 0, "multiply_linked_regular_files": 0,
    }
    pending = [root_path]
    while pending:
        current = pending.pop()
        try:
            entries = list(os.scandir(current))
        except OSError as error:
            raise BrokerFailure(f"persistent tree could not be measured: {error}") from error
        for entry in entries:
            totals["entries"] += 1
            if totals["entries"] > 1000000:
                raise BrokerFailure("persistent tree exceeds the one-million-entry receipt bound")
            child = Path(entry.path)
            info = child.lstat()
            totals["allocated_bytes"] += info.st_blocks * 512
            if stat.S_ISDIR(info.st_mode):
                totals["directories"] += 1
                pending.append(child)
            elif stat.S_ISREG(info.st_mode):
                totals["regular_files"] += 1
                totals["logical_bytes"] += info.st_size
                if info.st_nlink != 1:
                    totals["multiply_linked_regular_files"] += 1
            elif stat.S_ISLNK(info.st_mode):
                totals["symlinks"] += 1
                totals["logical_bytes"] += len(os.fsencode(os.readlink(child)))
            else:
                totals["special_entries"] += 1
    return totals

def storage_inventory():
    observed = {}
    for kind, parent in (("workspace", workspace_root), ("cache", cache_root)):
        try:
            reject_nested_mounts(parent, "persistent storage root")
        except ValueError as error:
            raise BrokerFailure(str(error)) from error
        for entry in os.scandir(parent):
            if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", entry.name):
                raise BrokerFailure(
                    f"persistent storage contains an unexpected entry ({kind}): {entry.name!r}"
                )
            info = entry.stat(follow_symlinks=False)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
                raise BrokerFailure(
                    f"persistent storage contains an unsafe entry ({kind}): {entry.name!r}"
                )
            observed.setdefault(entry.name, set()).add(kind)
    return observed

def workspace_record_path(name):
    return registry_root / (name + ".json")

def write_workspace_record(record):
    destination = workspace_record_path(record["name"])
    temporary = registry_root / (".stage-" + secrets.token_hex(12))
    encoded = (json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n").encode()
    safe_write(temporary, encoded)
    try:
        os.rename(temporary, destination)
        descriptor = os.open(registry_root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass

def load_workspace_record(name, adopt=False):
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
        raise ValueError("workspace name is invalid")
    path = workspace_record_path(name)
    try:
        info = path.lstat()
    except FileNotFoundError:
        if not adopt:
            raise ValueError("workspace metadata is unavailable")
        workspace = workspace_root / name
        cache = cache_root / name
        for candidate in (workspace, cache):
            item = candidate.lstat()
            if (not stat.S_ISDIR(item.st_mode) or item.st_uid != os.geteuid() or
                    os.path.realpath(candidate) != str(candidate)):
                raise ValueError("workspace or cache is unsafe")
        record = {
            "schema": "sand-jail.workspace.v1",
            "id": hashlib.sha256(
                f"{project_key}\0{budget_group}\0{name}".encode()
            ).hexdigest(),
            "name": name, "project_key": project_key, "budget_group": budget_group,
            "role": "durable-candidate", "state": "active",
            "created_at": now(), "last_action_id": None, "last_action_at": None,
            "adopted_existing": True,
        }
        write_workspace_record(record)
        return record
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or
            info.st_size > 65536):
        raise ValueError("workspace metadata has an unsafe identity")
    try:
        record = json.loads(read_small_regular(path, 65536))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        raise ValueError("workspace metadata is unreadable") from error
    required = {
        "schema", "id", "name", "project_key", "budget_group", "role", "state",
        "created_at", "last_action_id", "last_action_at", "adopted_existing",
    }
    if (not isinstance(record, dict) or set(record) != required or
            record.get("schema") != "sand-jail.workspace.v1" or
            record.get("name") != name or record.get("project_key") != project_key or
            record.get("budget_group") != budget_group or
            record.get("role") not in {"durable-candidate", "ephemeral-verification", "diagnostic"} or
            record.get("state") not in {"active", "retired"} or
            not re.fullmatch(r"[0-9a-f]{64}", record.get("id", ""))):
        raise ValueError("workspace metadata does not match this budget group")
    return record

def persistent_usage():
    totals = {
        "logical_bytes": 0, "allocated_bytes": 0, "entries": 0,
        "regular_files": 0, "directories": 0, "symlinks": 0,
        "special_entries": 0, "multiply_linked_regular_files": 0,
    }
    rows = []
    observed = storage_inventory()
    for name in sorted(observed):
        workspace = workspace_root / name
        cache = cache_root / name
        presence = observed[name]
        workspace_usage = tree_usage(workspace) if "workspace" in presence else None
        cache_usage = tree_usage(cache) if "cache" in presence else None
        for measured in (workspace_usage, cache_usage):
            if measured is None:
                continue
            for key in totals:
                totals[key] += measured[key]
        rows.append({
            "name": name,
            "presence": (
                "pair" if presence == {"workspace", "cache"}
                else "workspace_only" if presence == {"workspace"}
                else "cache_only"
            ),
            "workspace": workspace_usage,
            "cache": cache_usage,
        })
    filesystem = os.statvfs(workspace_root)
    block = filesystem.f_frsize or filesystem.f_bsize
    usable_bytes = filesystem.f_blocks * block
    available_bytes = filesystem.f_bavail * block
    return {
        "schema": "sand-jail.workspace-usage.v1",
        "project_key": project_key, "budget_group": budget_group,
        "maximum_bytes": budget_max_bytes, "metering": budget_metering,
        "filesystem_usable_bytes": usable_bytes,
        "filesystem_available_bytes": available_bytes,
        "headroom_bytes": available_bytes if budget_max_bytes is not None else None,
        "totals": totals, "workspaces": rows,
    }

def budget_status():
    filesystem = os.statvfs(workspace_root)
    block = filesystem.f_frsize or filesystem.f_bsize
    return {
        "group": budget_group, "maximum_bytes": budget_max_bytes,
        "metering": budget_metering,
        "filesystem_usable_bytes": filesystem.f_blocks * block,
        "filesystem_available_bytes": filesystem.f_bavail * block,
    }

def read_small_regular(path, maximum):
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            info.st_nlink != 1 or info.st_size > maximum):
        raise ValueError("file identity is unsafe")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError("file identity changed")
        chunks = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        content = b"".join(chunks)
        if len(content) > maximum:
            raise ValueError("file exceeds its read bound")
        return content
    finally:
        os.close(descriptor)

def workspace_git_identity(workspace):
    git_dir = Path(workspace) / ".git"
    try:
        info = git_dir.lstat()
    except FileNotFoundError:
        return {"status": "not-a-repository", "commit": None, "ref": None}
    try:
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or
                os.path.realpath(git_dir) != str(git_dir)):
            raise ValueError("the .git entry is not a safe directory")
        head = read_small_regular(git_dir / "HEAD", 4096).decode("ascii").strip()
        if re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", head):
            return {"status": "detached", "commit": head, "ref": None}
        if not head.startswith("ref: "):
            raise ValueError("HEAD has an unsupported form")
        reference = canonical_relative(head[5:], "Git HEAD reference")
        if not reference.startswith("refs/"):
            raise ValueError("HEAD reference is outside refs")
        loose = git_dir.joinpath(*reference.split("/"))
        commit = None
        if loose.exists() or loose.is_symlink():
            if os.path.realpath(loose) != str(loose):
                raise ValueError("HEAD reference has a symlink component")
            commit = read_small_regular(loose, 4096).decode("ascii").strip()
        else:
            packed = git_dir / "packed-refs"
            if packed.exists() or packed.is_symlink():
                for raw in read_small_regular(packed, 16 * 1024 * 1024).decode("ascii").splitlines():
                    if not raw or raw.startswith(("#", "^")):
                        continue
                    value, name = raw.split(" ", 1)
                    if name == reference:
                        commit = value
                        break
        if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", commit or ""):
            raise ValueError("HEAD does not resolve to an object id")
        return {"status": "symbolic", "commit": commit, "ref": reference}
    except (OSError, UnicodeError, ValueError) as error:
        return {"status": "unsafe-or-unresolved", "commit": None, "ref": None,
                "detail": str(error)[:200]}

def hash_result_files(workspace, requested):
    results = []
    errors = []
    total = 0
    workspace_path = Path(workspace)
    for relative in requested:
        path = workspace_path.joinpath(*relative.split("/"))
        try:
            if os.path.realpath(path) != str(path):
                raise ValueError("has a symlink component")
            info = path.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
                    info.st_nlink != 1):
                raise ValueError("is not a user-owned single-link regular file")
            total += info.st_size
            if total > result_max_bytes:
                raise ValueError(f"exceeds the aggregate {result_max_bytes}-byte result bound")
            descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            digest = hashlib.sha256()
            size = 0
            try:
                opened = os.fstat(descriptor)
                if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                    raise ValueError("changed identity before hashing")
                while True:
                    chunk = os.read(descriptor, 1024 * 1024)
                    if not chunk:
                        break
                    size += len(chunk)
                    digest.update(chunk)
            finally:
                os.close(descriptor)
            if size != info.st_size:
                raise ValueError("changed size while hashing")
            results.append({
                "path": relative, "bytes": size, "sha256": digest.hexdigest(),
                "mode": stat.S_IMODE(info.st_mode),
            })
        except (OSError, ValueError) as error:
            errors.append({"path": relative, "error": str(error)[:300]})
    return results, errors

def receipt_digest(receipt):
    core = {key: value for key, value in receipt.items() if key != "id"}
    encoded = json.dumps(core, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()

def write_receipt(receipt):
    receipt["id"] = receipt_digest(receipt)
    with receipt_lock:
        destination = receipt_root / (receipt["id"] + ".json")
        if destination.exists() or destination.is_symlink():
            existing = load_receipt(receipt["id"])
            if existing != receipt:
                raise BrokerFailure("action receipt identity collided")
            return receipt["id"]
        temporary = receipt_root / (".stage-" + secrets.token_hex(12))
        encoded = (json.dumps(receipt, sort_keys=True, separators=(",", ":")) + "\n").encode()
        if len(encoded) > 262144:
            raise BrokerFailure("action receipt exceeds its protected size bound")
        safe_write(temporary, encoded)
        try:
            os.chmod(temporary, 0o400)
            os.rename(temporary, destination)
            descriptor = os.open(receipt_root, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        finally:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass
    return receipt["id"]

def load_receipt(value):
    if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
        raise ValueError("receipt id must be 64 lowercase hexadecimal characters")
    path = receipt_root / (value + ".json")
    info = path.lstat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
            stat.S_IMODE(info.st_mode) != 0o400 or info.st_nlink != 1 or
            info.st_size > 262144):
        raise ValueError("action receipt has an unsafe identity")
    try:
        receipt = json.loads(read_small_regular(path, 262144))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        raise ValueError("action receipt is unreadable") from error
    if (not isinstance(receipt, dict) or receipt.get("schema") not in {
            "sand-jail.action-receipt.v1", "sand-jail.workspace-lifecycle-receipt.v1"
        } or
            receipt.get("id") != value or receipt_digest(receipt) != value):
        raise ValueError("action receipt identity is invalid")
    return receipt

def receipt_summary(receipt):
    if receipt["schema"] == "sand-jail.workspace-lifecycle-receipt.v1":
        return {
            "id": receipt["id"], "action_id": receipt["action_id"],
            "finished_at": receipt["finished_at"], "workspace": receipt["workspace"]["name"],
            "status": receipt["status"], "outcome": receipt["outcome"],
            "result_count": 0, "result_error_count": 0,
        }
    return {
        "id": receipt["id"], "action_id": receipt["action_id"],
        "finished_at": receipt["finished_at"], "workspace": receipt["grant"]["workspace"],
        "status": receipt["status"], "outcome": receipt["outcome"],
        "result_count": len(receipt["results"]), "result_error_count": len(receipt["result_errors"]),
    }

def handle_receipt_request(request, peer_pid):
    if matching_grant(read_cgroup(peer_pid)) is not None:
        raise ValueError("recursive actions cannot enumerate protected receipts")
    if not isinstance(request, dict) or request.get("schema") != "sand-jail.receipt-request.v1":
        raise ValueError("receipt request schema is invalid")
    action = request.get("action")
    if action == "show" and set(request) == {"schema", "action", "id"}:
        return load_receipt(request["id"])
    if action == "list" and set(request) == {"schema", "action"}:
        with receipt_lock:
            newest = []
            total = 0
            for entry in os.scandir(receipt_root):
                if entry.name.startswith(".stage-"):
                    raise ValueError("action-receipt staging residue requires operator review")
                if not re.fullmatch(r"[0-9a-f]{64}\.json", entry.name):
                    raise ValueError("action-receipt registry contains an unexpected entry")
                info = entry.stat(follow_symlinks=False)
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or
                        stat.S_IMODE(info.st_mode) != 0o400 or info.st_nlink != 1 or
                        info.st_size > 262144):
                    raise ValueError("action-receipt registry contains an unsafe object")
                total += 1
                item = (info.st_mtime_ns, entry.name[:-5])
                if len(newest) < 256:
                    heapq.heappush(newest, item)
                else:
                    heapq.heappushpop(newest, item)
            rows = [
                receipt_summary(load_receipt(receipt_id))
                for _, receipt_id in sorted(newest)
            ]
        rows.sort(key=lambda item: (item["finished_at"], item["id"]))
        return {
            "schema": "sand-jail.action-receipt-list.v1",
            "total": total, "returned": len(rows), "truncated": total > len(rows),
            "receipts": rows,
        }
    raise ValueError("receipt request action or fields are invalid")

def workspace_active_count(name):
    with lock:
        return sum(item["workspace_name"] == name for item in grants.values())

def workspace_snapshot(name):
    with registry_lock:
        record = load_workspace_record(name, adopt=True)
    workspace = workspace_root / name
    cache = cache_root / name
    return {
        **record,
        "active_grants": workspace_active_count(name),
        "usage": {
            "workspace": tree_usage(workspace),
            "cache": tree_usage(cache),
        },
        "budget": {
            "group": budget_group, "maximum_bytes": budget_max_bytes,
            "metering": budget_metering,
        },
    }

def normalize_internal_hardlinks(workspace, cache):
    roots = (Path(workspace), Path(cache))
    inventory = {}
    for root_path in roots:
        reject_nested_mounts(root_path, "hardlink normalization target")
        for current, directories, files in os.walk(root_path, topdown=True, followlinks=False):
            for name in directories:
                path = Path(current) / name
                info = path.lstat()
                if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
                    raise ValueError("hardlink normalization target contains an unsafe directory")
            for name in files:
                path = Path(current) / name
                info = path.lstat()
                if stat.S_ISLNK(info.st_mode):
                    continue
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
                    raise ValueError("hardlink normalization target contains a special or foreign-owned entry")
                if info.st_nlink > 1:
                    inventory.setdefault((info.st_dev, info.st_ino), []).append((path, info))
    normalized = []
    for (device, inode), aliases in sorted(inventory.items()):
        link_count = aliases[0][1].st_nlink
        if len(aliases) != link_count:
            raise ValueError("hardlinked file has an alias outside the paired workspace/cache authority")
        for path, original in aliases[:-1]:
            descriptor, temporary_name = tempfile.mkstemp(prefix=".sandcodex-copy-", dir=path.parent)
            temporary = Path(temporary_name)
            try:
                os.fchmod(descriptor, stat.S_IMODE(original.st_mode))
                source = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
                try:
                    opened = os.fstat(source)
                    if (opened.st_dev, opened.st_ino) != (device, inode):
                        raise ValueError("hardlinked file changed during normalization")
                    while True:
                        chunk = os.read(source, 1024 * 1024)
                        if not chunk:
                            break
                        view = memoryview(chunk)
                        while view:
                            view = view[os.write(descriptor, view):]
                finally:
                    os.close(source)
                os.fsync(descriptor)
                os.close(descriptor)
                descriptor = -1
                os.replace(temporary, path)
                normalized.append(os.fspath(path.relative_to(
                    workspace_root if path.is_relative_to(workspace_root) else cache_root
                )))
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
                try:
                    temporary.unlink()
                except FileNotFoundError:
                    pass
    return normalized

def purge_identity(info):
    return (
        info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,
        info.st_size, info.st_mtime_ns, info.st_ctime_ns,
    )

def stable_purge_identity(info):
    return info.st_dev, info.st_ino, stat.S_IFMT(info.st_mode), info.st_uid

def normalize_symlink_target(parent, target):
    if not target or os.path.isabs(target):
        raise ValueError("workspace purge refuses an absolute or empty symlink target")
    parts = list(parent)
    for component in target.split("/"):
        if component in {"", "."}:
            continue
        if component == "..":
            if not parts:
                raise ValueError("workspace purge refuses an escaping symlink")
            parts.pop()
            continue
        parts.append(component)
    return tuple(parts)

def validate_purge_symlinks(inventory):
    for path, record in inventory.items():
        if record["kind"] != "symlink":
            continue
        pending = list(normalize_symlink_target(path[:-1], record["target"]))
        resolved = []
        hops = 0
        while pending:
            component = pending.pop(0)
            candidate = tuple(resolved + [component])
            target_record = inventory.get(candidate)
            if target_record is None:
                raise ValueError("workspace purge refuses a dangling symlink")
            if target_record["kind"] == "symlink":
                hops += 1
                if hops > 40:
                    raise ValueError("workspace purge refuses a symlink cycle")
                pending = list(normalize_symlink_target(
                    candidate[:-1], target_record["target"]
                )) + pending
                resolved = []
                continue
            if pending and target_record["kind"] != "directory":
                raise ValueError("workspace purge refuses a symlink through a nondirectory")
            resolved.append(component)

def prepare_purge_tree(path):
    root_path = Path(path)
    parent_path = root_path.parent
    parent_fd = os.open(
        parent_path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    )
    root_fd = -1
    try:
        parent_info = os.fstat(parent_fd)
        if not stat.S_ISDIR(parent_info.st_mode) or parent_info.st_uid != os.geteuid():
            raise ValueError("workspace purge parent changed identity")
        root_info = os.stat(root_path.name, dir_fd=parent_fd, follow_symlinks=False)
        if not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != os.geteuid():
            raise ValueError("workspace purge target changed identity")
        root_fd = os.open(
            root_path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )
        opened = os.fstat(root_fd)
        if purge_identity(opened) != purge_identity(root_info):
            raise ValueError("workspace purge target changed while opening")
        inventory = {
            (): {
                "kind": "directory",
                "identity": purge_identity(opened),
                "stable_identity": stable_purge_identity(opened),
            }
        }
        children = {}

        def scan(directory_fd, relative):
            names = sorted(os.listdir(directory_fd), key=os.fsencode)
            children[relative] = names
            for name in names:
                info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
                if info.st_uid != os.geteuid():
                    raise ValueError("workspace purge refuses a foreign-owned entry")
                child = relative + (name,)
                record = {
                    "identity": purge_identity(info),
                    "stable_identity": stable_purge_identity(info),
                }
                if stat.S_ISDIR(info.st_mode):
                    record["kind"] = "directory"
                    inventory[child] = record
                    child_fd = os.open(
                        name,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
                        dir_fd=directory_fd,
                    )
                    try:
                        if purge_identity(os.fstat(child_fd)) != record["identity"]:
                            raise ValueError("workspace purge directory changed while opening")
                        scan(child_fd, child)
                    finally:
                        os.close(child_fd)
                elif stat.S_ISREG(info.st_mode):
                    if info.st_nlink != 1:
                        raise ValueError("workspace purge refuses a multiply-linked file")
                    record["kind"] = "regular"
                    inventory[child] = record
                elif stat.S_ISLNK(info.st_mode):
                    record["kind"] = "symlink"
                    record["target"] = os.readlink(name, dir_fd=directory_fd)
                    inventory[child] = record
                else:
                    raise ValueError("workspace purge refuses a special entry")

        scan(root_fd, ())
        validate_purge_symlinks(inventory)
        return {
            "path": root_path,
            "parent_identity": purge_identity(parent_info),
            "root_identity": purge_identity(opened),
            "root_stable_identity": stable_purge_identity(opened),
            "inventory": inventory,
            "children": children,
        }
    finally:
        if root_fd >= 0:
            os.close(root_fd)
        os.close(parent_fd)

def purge_tree(plan):
    root_path = plan["path"]
    parent_fd = os.open(
        root_path.parent,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
    )
    root_fd = -1
    try:
        if purge_identity(os.fstat(parent_fd)) != plan["parent_identity"]:
            raise ValueError("workspace purge parent changed after validation")
        root_info = os.stat(root_path.name, dir_fd=parent_fd, follow_symlinks=False)
        if purge_identity(root_info) != plan["root_identity"]:
            raise ValueError("workspace purge target changed after validation")
        root_fd = os.open(
            root_path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )
        if purge_identity(os.fstat(root_fd)) != plan["root_identity"]:
            raise ValueError("workspace purge target changed while reopening")

        def remove(directory_fd, relative):
            expected_names = plan["children"][relative]
            if sorted(os.listdir(directory_fd), key=os.fsencode) != expected_names:
                raise ValueError("workspace purge directory inventory changed")
            directory_record = plan["inventory"][relative]
            os.fchmod(
                directory_fd,
                stat.S_IMODE(directory_record["identity"][2]) |
                stat.S_IWUSR | stat.S_IXUSR,
            )
            for name in expected_names:
                child = relative + (name,)
                record = plan["inventory"][child]
                info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
                if purge_identity(info) != record["identity"]:
                    raise ValueError("workspace purge entry changed after validation")
                if record["kind"] == "directory":
                    child_fd = os.open(
                        name,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
                        dir_fd=directory_fd,
                    )
                    try:
                        if purge_identity(os.fstat(child_fd)) != record["identity"]:
                            raise ValueError("workspace purge directory changed while reopening")
                        remove(child_fd, child)
                    finally:
                        os.close(child_fd)
                    current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
                    if stable_purge_identity(current) != record["stable_identity"]:
                        raise ValueError("workspace purge directory changed before removal")
                    os.rmdir(name, dir_fd=directory_fd)
                else:
                    if record["kind"] == "symlink":
                        if os.readlink(name, dir_fd=directory_fd) != record["target"]:
                            raise ValueError("workspace purge symlink changed after validation")
                    os.unlink(name, dir_fd=directory_fd)
            if os.listdir(directory_fd):
                raise ValueError("workspace purge directory retained an unexpected entry")

        remove(root_fd, ())
        current = os.stat(root_path.name, dir_fd=parent_fd, follow_symlinks=False)
        if stable_purge_identity(current) != plan["root_stable_identity"]:
            raise ValueError("workspace purge root changed before removal")
        os.close(root_fd)
        root_fd = -1
        os.rmdir(root_path.name, dir_fd=parent_fd)
        os.fsync(parent_fd)
    finally:
        if root_fd >= 0:
            os.close(root_fd)
        os.close(parent_fd)

def lifecycle_receipt(operation, before, after, status=0, outcome="completed", error=None):
    receipt = {
        "schema": "sand-jail.workspace-lifecycle-receipt.v1",
        "action_id": secrets.token_hex(24), "operation": operation,
        "project_key": project_key, "budget_group": budget_group,
        "workspace": {
            "id": before["id"], "name": before["name"], "role": before["role"],
        },
        "before": before, "after": after, "status": status, "outcome": outcome,
        "finished_at": now(),
    }
    if error is not None:
        receipt["error"] = str(error)[:300]
    write_receipt(receipt)
    return receipt

def handle_workspace_request(request, peer_pid):
    if matching_grant(read_cgroup(peer_pid)) is not None:
        raise ValueError("recursive actions cannot control persistent workspace lifecycle")
    if not isinstance(request, dict) or request.get("schema") != "sand-jail.workspace-request.v1":
        raise ValueError("workspace request schema is invalid")
    action = request.get("action")
    name = request.get("name")
    if action == "create" and set(request) == {"schema", "action", "name", "role"}:
        role = request["role"]
        if role not in {"durable-candidate", "ephemeral-verification", "diagnostic"}:
            raise ValueError("workspace role is invalid")
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
            raise ValueError("workspace name is invalid")
        workspace = workspace_root / name
        cache = cache_root / name
        with registry_lock:
            if workspace_record_path(name).exists():
                record = load_workspace_record(name)
                if record["state"] != "active" or record["role"] != role:
                    raise ValueError("workspace already exists with different lifecycle metadata")
            else:
                present = [candidate.exists() or candidate.is_symlink() for candidate in (workspace, cache)]
                if any(present):
                    if not all(present) or role != "durable-candidate":
                        raise ValueError("unregistered workspace/cache pair requires durable adoption")
                    record = load_workspace_record(name, adopt=True)
                else:
                    workspace.mkdir(mode=0o700)
                    try:
                        cache.mkdir(mode=0o700)
                    except BaseException:
                        workspace.rmdir()
                        raise
                    record = {
                        "schema": "sand-jail.workspace.v1",
                        "id": secrets.token_hex(32), "name": name,
                        "project_key": project_key, "budget_group": budget_group,
                        "role": role, "state": "active", "created_at": now(),
                        "last_action_id": None, "last_action_at": None,
                        "adopted_existing": False,
                    }
                    write_workspace_record(record)
        return workspace_snapshot(name)
    if action == "inspect" and set(request) == {"schema", "action", "name"}:
        return workspace_snapshot(name)
    if action == "list" and set(request) == {"schema", "action"}:
        rows = []
        with registry_lock:
            observed = storage_inventory()
            recorded = set()
            for entry in os.scandir(registry_root):
                if entry.name.startswith(".stage-"):
                    raise ValueError("workspace registry staging residue requires operator review")
                if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}\.json", entry.name):
                    raise ValueError("workspace registry contains an unexpected entry")
                name = entry.name[:-5]
                recorded.add(name)
                record = load_workspace_record(name)
                presence = observed.get(name, set())
                if presence != {"workspace", "cache"}:
                    raise ValueError("registered workspace/cache pair is incomplete")
                rows.append({**record, "presence": "pair"})
            for name, presence in observed.items():
                if name in recorded:
                    continue
                rows.append({
                    "name": name,
                    "role": None,
                    "state": "unregistered",
                    "presence": (
                        "pair" if presence == {"workspace", "cache"}
                        else "workspace_only" if presence == {"workspace"}
                        else "cache_only"
                    ),
                })
        return {
            "schema": "sand-jail.workspace-list.v1", "budget_group": budget_group,
            "workspaces": sorted(rows, key=lambda item: item["name"]),
        }
    if action == "usage" and set(request) == {"schema", "action"}:
        return persistent_usage()
    if action == "normalize-hardlinks" and set(request) == {"schema", "action", "name", "receipt"}:
        if request["receipt"] is not True:
            raise ValueError("hardlink normalization requires a protected receipt")
        with lock:
            if any(item["workspace_name"] == name for item in grants.values()):
                raise ValueError("an active workspace cannot be normalized")
            with registry_lock:
                before = workspace_snapshot(name)
                if before["state"] != "active":
                    raise ValueError("a retired workspace cannot be normalized")
                normalized = normalize_internal_hardlinks(
                    workspace_root / name, cache_root / name
                )
                after = workspace_snapshot(name)
                after["normalized_paths"] = normalized
        receipt = lifecycle_receipt(action, before, after)
        return {"workspace": after, "receipt": receipt}
    if action in {"retire", "purge"} and set(request) == {"schema", "action", "name", "receipt"}:
        if request["receipt"] is not True:
            raise ValueError("workspace lifecycle mutation requires a protected receipt")
        with lock:
            if any(item["workspace_name"] == name for item in grants.values()):
                raise ValueError("an active workspace cannot be retired or purged")
            with registry_lock:
                before = workspace_snapshot(name)
                record = load_workspace_record(name)
                if action == "retire":
                    if record["state"] != "active":
                        raise ValueError("workspace is already retired")
                    record["state"] = "retired"
                    write_workspace_record(record)
                    after = workspace_snapshot(name)
                else:
                    if record["state"] != "retired":
                        raise ValueError("workspace must be retired before purge")
                    workspace = workspace_root / name
                    cache = cache_root / name
                    purge_plans = []
                    for candidate in (workspace, cache):
                        if os.path.realpath(candidate) != str(candidate):
                            raise ValueError("workspace purge target escaped its fixed root")
                        reject_nested_mounts(candidate, "workspace purge target")
                        measured = tree_usage(candidate)
                        if (measured["special_entries"] or
                                measured["multiply_linked_regular_files"]):
                            raise ValueError("workspace purge refuses special or multiply-linked entries")
                        purge_plans.append(prepare_purge_tree(candidate))
                    try:
                        for plan in purge_plans:
                            purge_tree(plan)
                    except (OSError, ValueError) as error:
                        after = {
                            "name": name, "state": "purge-incomplete",
                            "usage": {
                                "workspace": tree_usage(workspace) if workspace.exists() else None,
                                "cache": tree_usage(cache) if cache.exists() else None,
                            },
                            "budget": {
                                "group": budget_group, "maximum_bytes": budget_max_bytes,
                                "metering": budget_metering,
                            },
                        }
                        failed = lifecycle_receipt(
                            "purge", before, after,
                            status=getattr(error, "errno", 1) or 1,
                            outcome="partial_failure", error=error,
                        )
                        raise ValueError(
                            f"workspace purge incomplete; protected receipt {failed['id']}: {error}"
                        ) from error
                    workspace_record_path(name).unlink()
                    after = {
                        "name": name, "state": "purged",
                        "usage": {"workspace": None, "cache": None},
                        "budget": {
                            "group": budget_group, "maximum_bytes": budget_max_bytes,
                            "metering": budget_metering,
                        },
                    }
        receipt = lifecycle_receipt(action, before, after)
        return {"workspace": after, "receipt": receipt}
    raise ValueError("workspace request action or fields are invalid")

def revoke(grant):
    pending = [grant]
    revoked = []
    with lock:
        while pending:
            current = pending.pop()
            token = current["token"]
            active = grants.pop(token, None)
            if active is None:
                continue
            revoked.append(active)
            pending.extend(item for item in grants.values() if item["parent_token"] == token)
    for current in sorted(revoked, key=lambda item: item["depth"], reverse=True):
        unit = current.get("unit")
        if unit:
            subprocess.run([systemctl, "--user", "kill", "--kill-whom=all", unit],
                           env=manager_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        path = current.get("cgroup_root")
        if path:
            try:
                write_control(Path(path) / "cgroup.kill", 1)
            except OSError:
                pass
    return revoked

def wait_for_revocation(revoked):
    deadline = time.monotonic() + 5
    pending = [Path(item["cgroup_root"]) for item in revoked if item.get("cgroup_root")]
    while pending and time.monotonic() < deadline:
        active = []
        for path in pending:
            try:
                fields = {}
                for line in (path / "cgroup.events").read_text().splitlines():
                    key, value = line.split(None, 1)
                    fields[key] = value
                if fields.get("populated") != "0":
                    active.append(path)
            except FileNotFoundError:
                continue
            except (OSError, ValueError) as error:
                raise BrokerFailure(f"descendant revocation could not be verified: {error}") from error
        pending = active
        if pending:
            threading.Event().wait(0.02)
    if pending:
        raise BrokerFailure("descendant scope remained populated after revocation")

def launch_top(grant, fds):
    global counter
    with lock:
        counter += 1
        serial = counter
    segment = "g-" + grant["token"][:24]
    transport = action_transport()
    unit = f"sandcodex-jail-{runtime_id}-{serial}.{transport}"
    result_path = root / f"result-{grant['token']}.json"
    if result_path.exists() or result_path.is_symlink():
        raise ValueError("jail resource report path already exists")
    grant.update({"segment": segment, "unit": unit, "cgroup_mode": "top", "cgroup_ref": unit,
                  "result_path": str(result_path)})
    request_path = request_file(grant)
    if transport == "scope":
        command = [
            systemd_run, "--user", "--scope", "--quiet", "--collect", "--unit", unit,
            "--property=Delegate=yes",
        ]
    else:
        stream_option = "--pty" if any(os.isatty(descriptor) for descriptor in fds) else "--pipe"
        command = [
            systemd_run, "--user", "--quiet", "--wait", "--collect", stream_option,
            "--send-sighup", "--unit", unit, "--property=Type=exec",
            "--property=Delegate=yes", "--property=KillMode=control-group",
        ]
    memory = "infinity" if grant["memory_mib"] is None else f"{grant['memory_mib']}M"
    swap = "infinity" if grant["memory_swap_mib"] is None else f"{grant['memory_swap_mib']}M"
    pids = "infinity" if grant["pids"] is None else str(grant["pids"])
    runtime = ("infinity" if grant["timeout_seconds"] is None else
               f"{grant['timeout_seconds'] + trusted_watchdog_grace}s")
    command.extend([
        f"--property=MemoryMax={memory}", f"--property=MemorySwapMax={swap}",
        f"--property=TasksMax={pids}", "--property=OOMPolicy=continue",
        f"--property=RuntimeMaxSec={runtime}",
    ])
    if grant["cpu_percent"] is not None:
        command.append(f"--property=CPUQuota={grant['cpu_percent']}%")
    command.extend([env_bin, "-i", "PATH=/usr/bin:/bin", "SANDCODEX_JAIL_BROKER_EXEC=1",
                    str(helper), "__broker-exec", str(request_path)])
    process = subprocess.Popen(command, stdin=fds[0], stdout=fds[1], stderr=fds[2],
                               close_fds=True, env=manager_env)
    scope = None
    for _ in range(500):
        try:
            scope = control_group(unit)
            break
        except (ValueError, subprocess.SubprocessError):
            if process.poll() is not None:
                break
            threading.Event().wait(0.01)
    if scope is None:
        process.terminate()
        process.wait(timeout=3)
        raise ValueError(f"top-level jail {transport} cgroup did not become observable")
    with lock:
        grant["cgroup_root"] = "/sys/fs/cgroup" + scope + "/" + segment
        grant["cgroup_payload"] = scope + "/" + segment + "/payload"
    return process, request_path

def handle(channel):
    fds = []
    grant = None
    request_path = None
    peer_pid = None
    process = None
    grant_released = False
    storage_before = None
    started_at = None
    try:
        peer_pid, peer_uid, _ = struct.unpack("3i", channel.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer_uid != os.geteuid() or peer_pid <= 1:
            raise ValueError("broker caller identity is invalid")
        request, fds = recv_request(channel)
        control_schema = request.get("schema") if isinstance(request, dict) else None
        if control_schema in {
                "sand-jail.seal-request.v1", "sand-jail.receipt-request.v1",
                "sand-jail.workspace-request.v1"}:
            if control_schema == "sand-jail.seal-request.v1":
                result = handle_seal_request(request, peer_pid)
            elif control_schema == "sand-jail.workspace-request.v1":
                result = handle_workspace_request(request, peer_pid)
            else:
                result = handle_receipt_request(request, peer_pid)
            channel.sendall((
                json.dumps({"status": 0, "result": result}, separators=(",", ":")) + "\n"
            ).encode())
            return
        peer_cgroup = read_cgroup(peer_pid)
        grant, parent = validate_request(request, peer_pid)
        with lock:
            top_count = sum(item["parent_token"] is None for item in grants.values())
            child_count = sum(item["parent_token"] == grant["parent_token"] for item in grants.values())
            if parent is None and top_count >= 8:
                raise ValueError("top-level jail concurrency limit reached")
            if parent is None and any(item["workspace"] == grant["workspace"] for item in grants.values()):
                raise ValueError("the selected workspace already has an active jail grant")
            if parent is not None and grants.get(parent["token"]) is not parent:
                raise ValueError("recursive parent grant ended before child reservation")
            if parent is not None and child_count >= 1:
                raise ValueError("a recursive grant already has an active child")
            grants[grant["token"]] = grant
        started_at = now()
        with registry_lock:
            record = load_workspace_record(grant["workspace_name"], adopt=True)
            record["last_action_id"] = grant["token"]
            record["last_action_at"] = started_at
            write_workspace_record(record)
        storage_before = {
            "workspace": tree_usage(grant["workspace"]),
            "cache": tree_usage(grant["cache"]),
            "git": workspace_git_identity(grant["workspace"]),
            "budget": budget_status(),
        }
        digest = hashlib.sha256(json.dumps(grant["argv"], separators=(",", ":")).encode()).hexdigest()
        argv0_digest = hashlib.sha256(grant["argv"][0].encode()).hexdigest()
        audit("start", request=grant["token"][:16], parent=(grant["parent_token"] or "")[:16],
              depth=grant["depth"], workspace=grant["workspace_name"], profile=grant["profile"],
              network=grant["network"], resource_profile=grant["resource_profile"],
              timeout_seconds=grant["timeout_seconds"],
              cpu_percent=grant["cpu_percent"], memory_mib=grant["memory_mib"],
              memory_swap_mib=grant["memory_swap_mib"], pids=grant["pids"],
              file_size_bytes=grant["file_size_bytes"], tmp_bytes=grant["tmp_bytes"],
              home_bytes=grant["home_bytes"],
              sealed_inputs=grant["sealed_input_ids"], result_count=len(grant["result_paths"]),
              argv0_sha256=argv0_digest, argv_count=len(grant["argv"]), argv_sha256=digest)
        process, request_path = launch_top(grant, fds)
        channel.setblocking(False)
        while process.poll() is None:
            try:
                readable, _, _ = select.select([channel], [], [], 0.25)
            except OSError as error:
                raise ClientDisconnected from error
            if not readable:
                continue
            try:
                pending = channel.recv(1, socket.MSG_PEEK)
            except OSError as error:
                raise ClientDisconnected from error
            if pending == b"":
                raise ClientDisconnected
            raise ValueError("broker client sent data after its request")
        channel.settimeout(5)
        status = process.returncode
        if status < 0:
            status = 128 + (-status)
        process_status = min(status, 255)
        report_error = None
        try:
            report = resource_report(grant, process_status)
        except BrokerFailure as error:
            report = None
            report_error = str(error)[:500]
        revoked = revoke(grant)
        grant_released = True
        revocation_error = None
        try:
            wait_for_revocation(revoked)
        except BrokerFailure as error:
            revocation_error = str(error)[:500]
        results = []
        result_errors = []
        storage_after = None
        if revocation_error is None:
            results, result_errors = hash_result_files(grant["workspace"], grant["result_paths"])
            try:
                storage_after = {
                    "workspace": tree_usage(grant["workspace"]),
                    "cache": tree_usage(grant["cache"]),
                    "git": workspace_git_identity(grant["workspace"]),
                    "budget": budget_status(),
                }
            except BrokerFailure as error:
                result_errors.append({"path": None, "error": str(error)[:300]})
        else:
            result_errors.append({"path": None, "error": revocation_error})
        status = process_status
        if report_error is not None:
            status = 70
            outcome = "resource-report-invalid"
        elif revocation_error is not None:
            status = 70
            outcome = "descendant-revocation-unconfirmed"
        elif result_errors:
            status = 70
            outcome = "result-evidence-invalid"
        elif (process_status != 0 and budget_max_bytes is not None and storage_after is not None and
              storage_after["budget"]["filesystem_available_bytes"] <= 1048576):
            outcome = "persistent-budget-exhausted"
        elif process_status == 124 and grant["timeout_seconds"] is not None:
            outcome = "deadline-exceeded"
        elif report.get("memory_oom_kills"):
            outcome = "memory-exhausted"
        elif process_status == 0:
            outcome = "success"
        else:
            outcome = "failed"
        oom_events = report.get("memory_oom") if report else None
        oom_kills = report.get("memory_oom_kills") if report else None
        memory_peak = report.get("memory_peak_bytes") if report else None
        pids_max_events = report.get("pids_max_events") if report else None
        pids_peak = report.get("pids_peak") if report else None
        cpu_throttled = report.get("cpu_nr_throttled") if report else None
        cpu_throttled_usec = report.get("cpu_throttled_usec") if report else None
        grant_evidence = {
            "schema": grant["schema"],
            "workspace": grant["workspace_name"],
            "profile": grant["profile"], "tool_identity": grant["tool_identity"],
            "network": grant["network"],
            "resource_profile": grant["resource_profile"],
            "timeout_seconds": grant["timeout_seconds"],
            "cwd": grant["cwd"],
            "resources": {
                "cpu_percent": grant["cpu_percent"], "memory_mib": grant["memory_mib"],
                "memory_swap_mib": grant["memory_swap_mib"], "pids": grant["pids"],
                "file_size_bytes": grant["file_size_bytes"], "tmp_bytes": grant["tmp_bytes"],
                "home_bytes": grant["home_bytes"],
            },
            "depth": grant["depth"], "max_depth": grant["max_depth"],
            "parent_action_id": (
                hashlib.sha256(("action:" + grant["parent_token"]).encode()).hexdigest()
                if grant["parent_token"] else None
            ),
            "sealed_inputs": grant["sealed_input_ids"],
            "result_paths": grant["result_paths"],
            "persistent_storage": {
                "budget_group": grant["budget_group"],
                "maximum_bytes": grant["budget_max_bytes"],
                "metering": grant["budget_metering"],
            },
            "argv_count": len(grant["argv"]), "argv0_sha256": argv0_digest,
            "argv_sha256": digest,
        }
        grant_digest = hashlib.sha256(
            json.dumps(grant_evidence, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()
        receipt = {
            "schema": "sand-jail.action-receipt.v1",
            "action_id": hashlib.sha256(("action:" + grant["token"]).encode()).hexdigest(),
            "started_at": started_at, "finished_at": now(),
            "grant": grant_evidence, "grant_sha256": grant_digest,
            "process_status": process_status, "status": status, "outcome": outcome,
            "resource_report": report, "resource_report_error": report_error,
            "descendants_revoked": revocation_error is None,
            "storage_before": storage_before, "storage_after": storage_after,
            "results": results, "result_errors": result_errors,
        }
        receipt_id = write_receipt(receipt)
        audit("finish", request=grant["token"][:16], depth=grant["depth"], status=status,
              outcome=outcome, resource_profile=grant["resource_profile"],
              timeout_seconds=grant["timeout_seconds"], cpu_percent=grant["cpu_percent"],
              memory_mib=grant["memory_mib"], memory_swap_mib=grant["memory_swap_mib"],
              pids=grant["pids"], file_size_bytes=grant["file_size_bytes"],
              tmp_bytes=grant["tmp_bytes"], home_bytes=grant["home_bytes"],
              memory_oom_events=oom_events, memory_oom_kills=oom_kills,
              memory_peak_bytes=memory_peak, pids_max_events=pids_max_events, pids_peak=pids_peak,
              cpu_nr_throttled=cpu_throttled, cpu_throttled_usec=cpu_throttled_usec,
              receipt=receipt_id, result_count=len(results), result_error_count=len(result_errors))
        try:
            response = {"status": status}
            if grant["report_receipt"]:
                response["receipt"] = receipt_id
            channel.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode())
        except OSError:
            pass
    except ClientDisconnected:
        audit("cancel", request=(grant["token"][:16] if grant else None),
              depth=(grant["depth"] if grant else None), reason="client disconnected")
    except BrokerFailure as error:
        audit("failure", request=(grant["token"][:16] if grant else None),
              depth=(grant["depth"] if grant else None), reason=str(error)[:300])
        try:
            channel.sendall((json.dumps({"status": 70, "error": str(error)[:500]}, separators=(",", ":")) + "\n").encode())
        except OSError:
            pass
    except (ValueError, OSError, subprocess.SubprocessError, json.JSONDecodeError) as error:
        audit("reject", peer_pid=peer_pid, reason=str(error)[:300])
        try:
            channel.sendall((json.dumps({"status": 64, "error": str(error)[:500]}, separators=(",", ":")) + "\n").encode())
        except OSError:
            pass
    except BaseException as error:
        traceback.print_exc()
        try:
            audit(
                "failure",
                request=(grant["token"][:16] if grant else None),
                depth=(grant["depth"] if grant else None),
                reason=f"internal {type(error).__name__}: {str(error)[:240]}",
            )
        except BaseException:
            pass
        try:
            channel.sendall(b'{"status":70,"error":"resource broker internal failure"}\n')
        except OSError:
            pass
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass
        if grant is not None and not grant_released:
            revoke(grant)
        if process is not None and process.poll() is None:
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=3)
        if request_path is not None:
            try:
                request_path.unlink()
            except FileNotFoundError:
                pass
        if grant is not None and grant.get("result_path"):
            try:
                Path(grant["result_path"]).unlink()
            except FileNotFoundError:
                pass
        channel.close()

def stop(*_):
    stopping.set()
    if listener is not None:
        try:
            listener.close()
        except OSError:
            pass
    with lock:
        snapshot = list(grants.values())
    for grant in snapshot:
        if grant.get("unit"):
            subprocess.run([systemctl, "--user", "kill", "--kill-whom=all", grant["unit"]],
                           env=manager_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        revoke(grant)

signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
if socket_path.exists() or socket_path.is_symlink():
    raise SystemExit("broker socket path already exists")
listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
listener.bind(os.fspath(socket_path))
os.chmod(socket_path, 0o600)
listener.listen(32)
listener.settimeout(0.25)
audit("broker-start", mode=mode, network_ceiling=network_ceiling, depth_max=depth_max)
try:
    while not stopping.is_set():
        try:
            channel, _ = listener.accept()
        except socket.timeout:
            continue
        except OSError:
            if stopping.is_set():
                break
            raise
        channel.settimeout(5)
        threading.Thread(target=handle, args=(channel,), daemon=True).start()
finally:
    stop()
    try:
        socket_path.unlink()
    except FileNotFoundError:
        pass
    audit("broker-stop")
SANDCODEX_INNER_JAIL_BROKER_PY
}

sc_write_inner_jail_broker() {
  local target="$SC_JAIL_BROKER_ROOT/inner-jail-broker.py"
  sc_emit_inner_jail_broker | sc_atomic "$target" 500
}

sc_start_inner_jail_broker() {
  if [[ -n $SC_JAIL_BROKER_PID ]]; then
    local existing_start
    existing_start=$(sc_process_start "$SC_JAIL_BROKER_PID" 2>/dev/null || true)
    if [[ -n $existing_start && $existing_start == "$SC_JAIL_BROKER_START" && \
      -S $SC_JAIL_BROKER_SOCKET && ! -L $SC_JAIL_BROKER_SOCKET && \
      $(sc_owner_uid "$SC_JAIL_BROKER_SOCKET") == "$EUID" && $(sc_mode_octal "$SC_JAIL_BROKER_SOCKET") == 600 ]]; then
      sc_log_event info inner_jail "reusing inner_jail_broker_pid=$SC_JAIL_BROKER_PID"
      return 0
    fi
    sc_jail_fatal 'the existing inner-jail resource broker lost its verified identity'
    return 1
  fi
  local config="$SC_JAIL_BROKER_ROOT/config.json" tmp systemd_run systemctl_bin env_bin python_bin
  local file_ceiling=null tmp_ceiling=null home_ceiling=null storage_budget=null storage_metering=observed-tree-usage
  systemd_run=$(type -P systemd-run)
  systemctl_bin=$(type -P systemctl)
  env_bin=$(type -P env)
  python_bin=$(type -P python3)
  if [[ ! -x $systemd_run || ! -x $systemctl_bin || ! -x $env_bin || ! -x $python_bin ]]; then
    sc_jail_fatal 'inner-jail cgroups require systemd-run, systemctl, env, and Python'
    return 1
  fi
  if [[ ! -d /run/user/$EUID || -L /run/user/$EUID ]]; then
    sc_jail_fatal 'inner-jail cgroups require an active systemd user manager runtime'
    return 1
  fi
  sc_ensure_dir "$SC_JAIL_BROKER_ROOT" "inner-jail broker root"
  sc_write_inner_jail_broker
  [[ $SC_JAIL_FILE_CEILING_MIB == null ]] || file_ceiling=$((SC_JAIL_FILE_CEILING_MIB * 1024 * 1024))
  [[ $SC_JAIL_TMP_CEILING_MIB == null ]] || tmp_ceiling=$((SC_JAIL_TMP_CEILING_MIB * 1024 * 1024))
  [[ $SC_JAIL_HOME_CEILING_MIB == null ]] || home_ceiling=$((SC_JAIL_HOME_CEILING_MIB * 1024 * 1024))
  if [[ $SC_JAIL_STORAGE_BUDGET_MIB != null ]]; then
    storage_budget=$((SC_JAIL_STORAGE_BUDGET_MIB * 1024 * 1024))
    storage_metering=fixed-ext4-filesystem-capacity
  fi
  tmp=$(mktemp "$SC_JAIL_BROKER_ROOT/.config.XXXXXX")
  jq -n \
    --arg socket "$SC_JAIL_BROKER_SOCKET" --arg root "$SC_JAIL_BROKER_ROOT" \
    --arg helper "$SC_AGENT_BIN/sandcodex-jail" --arg project "$SC_PROJECT" \
    --arg workspaceRoot "$SC_JAIL_WORKSPACES" --arg cacheRoot "$SC_JAIL_CACHES" \
    --arg sealedRoot "$SC_JAIL_SEALED_INPUTS" --arg receiptRoot "$SC_JAIL_RECEIPTS" \
    --arg registryRoot "$SC_JAIL_STORAGE_REGISTRY" --arg projectKey "$SC_PROJECT_KEY" \
    --arg budgetGroup "$SC_JAIL_BUDGET_GROUP" --arg budgetMetering "$storage_metering" \
    --arg relayRoot "$SC_JAIL_RELAY_ROOT" \
    --arg audit "$SC_JAIL_AUDIT_LOG" --arg systemdRun "$systemd_run" --arg systemctl "$systemctl_bin" \
    --arg env "$env_bin" \
    --arg mode "$([[ $SC_BARE == 1 ]] && printf bare || printf sandbox)" --arg ceiling "$SC_JAIL_NETWORK_CEILING" \
    --arg runtimeId "$(basename -- "$SC_RUN_ROOT")" --arg xdgRuntime "/run/user/$EUID" \
    --argjson cpu "$SC_JAIL_CPU_CEILING" --argjson memory "$SC_JAIL_MEMORY_CEILING" \
    --argjson swap "$SC_JAIL_SWAP_CEILING" --argjson pids "$SC_JAIL_PIDS_CEILING" \
    --argjson timeout "$SC_JAIL_TIMEOUT_CEILING" --argjson fileSize "$file_ceiling" \
    --argjson tmpBytes "$tmp_ceiling" --argjson homeBytes "$home_ceiling" \
    --argjson budgetMax "$storage_budget" \
    --argjson depth "$SC_JAIL_RECURSION_MAX" --argjson auditMax "$SC_JAIL_AUDIT_MAX_BYTES" \
    --argjson trustedGrace "$SC_JAIL_TRUSTED_WATCHDOG_GRACE" \
    --argjson sealMaxBytes "$SC_JAIL_SEAL_MAX_BYTES" --argjson sealMaxFiles "$SC_JAIL_SEAL_MAX_FILES" \
    --argjson sealMaxCount "$SC_JAIL_SEAL_MAX_COUNT" --argjson resultMaxCount "$SC_JAIL_RESULT_MAX_COUNT" \
    --argjson resultMaxBytes "$SC_JAIL_RESULT_MAX_BYTES" \
    --argjson auditKeep "$SC_JAIL_AUDIT_KEEP_COUNT" \
    --slurpfile minimalIdentity "$SC_JAIL_DATA/profiles/minimal/identity.json" \
    --slurpfile pythonIdentity "$SC_JAIL_DATA/profiles/python/identity.json" \
    --slurpfile nodeIdentity "$SC_JAIL_DATA/profiles/node/identity.json" \
    --slurpfile buildIdentity "$SC_JAIL_DATA/profiles/build/identity.json" '{
      socket:$socket,root:$root,helper:$helper,project:$project,
      workspace_root:$workspaceRoot,cache_root:$cacheRoot,sealed_root:$sealedRoot,
      receipt_root:$receiptRoot,registry_root:$registryRoot,relay_root:$relayRoot,audit:$audit,
      systemd_run:$systemdRun,systemctl:$systemctl,env:$env,
      mode:$mode,network_ceiling:$ceiling,cpu_max:$cpu,memory_mib_max:$memory,
      memory_swap_mib_max:$swap,pids_max:$pids,timeout_max:$timeout,
      file_size_bytes_max:$fileSize,tmp_bytes_max:$tmpBytes,home_bytes_max:$homeBytes,
      depth_max:$depth,runtime_id:$runtimeId,trusted_watchdog_grace_seconds:$trustedGrace,
      seal_max_bytes:$sealMaxBytes,seal_max_files:$sealMaxFiles,seal_max_count:$sealMaxCount,
      result_max_count:$resultMaxCount,result_max_bytes:$resultMaxBytes,
      project_key:$projectKey,budget_group:$budgetGroup,budget_max_bytes:$budgetMax,
      budget_metering:$budgetMetering,
      profile_identities:{minimal:$minimalIdentity[0],python:$pythonIdentity[0],
        node:$nodeIdentity[0],build:$buildIdentity[0]},
      audit_max_bytes:$auditMax,audit_keep_count:$auditKeep,xdg_runtime_dir:$xdgRuntime
    }' >"$tmp"
  chmod 600 -- "$tmp"
  mv -fT -- "$tmp" "$config"
  SC_JAIL_BROKER_LOG="$SC_RUN_ROOT/inner-jail-broker.log"
  : >"$SC_JAIL_BROKER_LOG"; chmod 600 -- "$SC_JAIL_BROKER_LOG"
  env -i PATH="$PATH" HOME="$SC_WORK/home" XDG_RUNTIME_DIR="/run/user/$EUID" \
    "$python_bin" -P "$SC_JAIL_BROKER_ROOT/inner-jail-broker.py" "$config" \
    >"$SC_JAIL_BROKER_LOG" 2>&1 &
  SC_JAIL_BROKER_PID=$!
  SC_JAIL_BROKER_START=$(sc_process_start "$SC_JAIL_BROKER_PID")
  local ready=0
  for _ in {1..200}; do
    if [[ -S $SC_JAIL_BROKER_SOCKET && $(sc_owner_uid "$SC_JAIL_BROKER_SOCKET") == "$EUID" && \
      $(sc_mode_octal "$SC_JAIL_BROKER_SOCKET") == 600 ]]; then ready=1; break; fi
    kill -0 "$SC_JAIL_BROKER_PID" 2>/dev/null || break
    sleep 0.01
  done
  if ((ready == 0)); then
    local detail
    detail=$(tail -n 20 "$SC_JAIL_BROKER_LOG" 2>/dev/null || true)
    sc_jail_fatal 'inner-jail resource broker failed to start' "$detail"
    return 1
  fi
  sc_log_event info inner_jail "inner_jail_broker_pid=$SC_JAIL_BROKER_PID network_ceiling=$SC_JAIL_NETWORK_CEILING"
}

sc_stop_inner_jail_broker() {
  [[ -n $SC_JAIL_BROKER_PID ]] || return 0
  local current
  current=$(sc_process_start "$SC_JAIL_BROKER_PID" 2>/dev/null || true)
  if [[ -n $current && $current == "$SC_JAIL_BROKER_START" ]]; then
    kill -TERM "$SC_JAIL_BROKER_PID" 2>/dev/null || true
    local _
    for _ in {1..100}; do
      kill -0 "$SC_JAIL_BROKER_PID" 2>/dev/null || break
      sleep 0.02
    done
    kill -KILL "$SC_JAIL_BROKER_PID" 2>/dev/null || true
    wait "$SC_JAIL_BROKER_PID" 2>/dev/null || true
  fi
  SC_JAIL_BROKER_PID=''; SC_JAIL_BROKER_START=''
}

sc_verify_inner_jail_at_launch() {
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_TEST_BROWSER_BUNDLE_ONLY:-0}" == 1 ]]; then return 0; fi
  local output tested_at tmp detail
  local -a runtime_marker=(SANDCODEX_ACTIVE=1)
  (( SC_BARE )) && runtime_marker=(SANDCODEX_BARE_METAL=1)
  sc_note 'verifying the inner jail before provider launch'
  if ! output=$(sc_run_clean_fds env "${runtime_marker[@]}" \
      "$SC_AGENT_BIN/sandcodex-jail" self-test --json 2>>"$SC_LOG") ||
      ! jq -e '.schema == "sand-jail.self-test.v3" and .result == "ok" and
        .fresh_root == true and .host_paths_absent == true and
        .direct_egress_blocked == true and .cgroup.enforced == true and
        (.default_resources == "heavy" or .default_resources == "bounded" or .default_resources == "custom") and
        .heavy.verified == (.default_resources == "heavy") and
        .heavy.sandcodex_limits == false and
        .seccomp.enforced == true and .recursion.enforced == true and
        .recursion.maximum_passed == true and .landlock.enforced == true and
        .landlock.read_denied == true and .landlock.write_denied == true and
        .landlock.abi >= 3' <<<"$output" >/dev/null; then
    detail=$(tail -n 20 "$SC_JAIL_BROKER_LOG" 2>/dev/null || true)
    sc_jail_fatal 'inner-jail launch self-test failed before provider execution' "$detail"
    return 1
  fi
  tested_at=$(sc_now)
  tmp=$(mktemp "$SC_WORK/agent/.inner-jail-verified.XXXXXX")
  jq --arg testedAt "$tested_at" --argjson result "$output" '
    .self_tested_at_launch = true |
    .self_tested_at = $testedAt |
    .launch_self_test = $result
  ' "$SC_JAIL_ENV" >"$tmp"
  chmod 600 -- "$tmp"
  mv -fT -- "$tmp" "$SC_JAIL_ENV"
  sc_log_event info inner_jail "inner_jail_launch_self_test=ok tested_at=$tested_at"
  sc_ok 'inner jail launch self-test passed'
}

sc_audit_inner_jail_storage() {
  local output error_file detail checked_at contract_tmp
  local usage_file="$SC_WORK/agent/inner-jail-storage-usage.json"
  local -a runtime_marker=(SANDCODEX_ACTIVE=1)
  (( SC_BARE )) && runtime_marker=(SANDCODEX_BARE_METAL=1)
  mkdir -p -- "$SC_WORK/preflight"
  error_file="$(mktemp "$SC_WORK/preflight/.inner-jail-storage-error.XXXXXX")"
  chmod 600 -- "$error_file"
  SC_JAIL_STORAGE_HEALTH=degraded
  SC_JAIL_STORAGE_DIAGNOSTIC="persistent storage inventory did not return a valid result"
  if output=$(sc_run_clean_fds env "${runtime_marker[@]}" \
      "$SC_AGENT_BIN/sandcodex-jail" workspace usage --json 2>"$error_file") &&
      jq -e '.schema == "sand-jail.workspace-usage.v1" and
        (.totals.logical_bytes | type == "number") and
        (.totals.allocated_bytes | type == "number")' <<<"$output" >/dev/null; then
    SC_JAIL_STORAGE_HEALTH=ready
    SC_JAIL_STORAGE_DIAGNOSTIC=""
    printf '%s\n' "$output" | sc_atomic "$usage_file" 600
  else
    rm -f -- "$usage_file"
    detail="$(sed -n '1{s/[^[:print:]\t]/?/g;p;}' "$error_file" | cut -c1-1000)"
    [[ -z "$detail" ]] || SC_JAIL_STORAGE_DIAGNOSTIC="$detail"
    sc_warn "inner-jail persistent storage inventory is degraded; command room will remain available"
    sc_warn "$SC_JAIL_STORAGE_DIAGNOSTIC"
    sc_log_event warn inner_jail_storage \
      "persistent storage inventory degraded without blocking the command room" \
      "diagnostic=$SC_JAIL_STORAGE_DIAGNOSTIC"
  fi
  rm -f -- "$error_file"
  checked_at="$(sc_now)"
  contract_tmp="$(mktemp "$SC_WORK/agent/.inner-jail-storage-health.XXXXXX")"
  jq --arg status "$SC_JAIL_STORAGE_HEALTH" \
    --arg diagnostic "$SC_JAIL_STORAGE_DIAGNOSTIC" \
    --arg checkedAt "$checked_at" '
      .persistent_storage_health = {
        status:$status,
        inventory_available:($status == "ready"),
        diagnostic:(if $diagnostic == "" then null else $diagnostic end),
        checked_at:$checkedAt,
        command_room_blocking:false,
        lifecycle_mutations_fail_closed:true
      }
    ' "$SC_JAIL_ENV" >"$contract_tmp"
  chmod 600 -- "$contract_tmp"
  mv -fT -- "$contract_tmp" "$SC_JAIL_ENV"
}

sc_start_and_verify_inner_jail() {
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
    sc_log_event info inner_jail "inner-jail broker and launch self-test skipped by no-Nix fixture"
    return 0
  fi
  if (( ! SC_JAIL_AVAILABLE )); then
    sc_log_event warn inner_jail "inner-jail unavailable in this launch" \
      "reason=--no-resource-scope disables cgroup-backed action scopes"
    sc_warn "inner jail unavailable in this launch because --no-resource-scope disables cgroup-backed action scopes"
    return 0
  fi
  sc_start_inner_jail_broker || return $?
  sc_verify_inner_jail_at_launch || return $?
  sc_audit_inner_jail_storage || return $?
}


sc_emit_inner_jail_helper_body() {
  cat <<'SANDCODEX_INNER_JAIL_HELPER_BODY_SH'

die() { printf 'sandcodex-jail: %s\n' "$*" >&2; exit 64; }
infra_die() { printf 'sandcodex-jail: infrastructure failure: %s\n' "$*" >&2; exit 70; }

usage() {
  cat <<'EOF'
sandcodex-jail - run a less-trusted action inside Sandcodex

USAGE
  sandcodex-jail inspect [--json]
  sandcodex-jail capability-card [--json]
  sandcodex-jail workspace create NAME [--role ROLE] [--json]
  sandcodex-jail workspace inspect NAME [--json]
  sandcodex-jail workspace usage [--json]
  sandcodex-jail workspace normalize-hardlinks NAME --receipt [--json]
  sandcodex-jail workspace retire|purge NAME --receipt [--json]
  sandcodex-jail workspace path|cache NAME
  sandcodex-jail workspace list [--json]
  sandcodex-jail seal create SOURCE [--json]
  sandcodex-jail seal inspect ID [--json]
  sandcodex-jail seal list [--json]
  sandcodex-jail receipt show ID [--json]
  sandcodex-jail receipt list [--json]
  sandcodex-jail run [--workspace NAME] [--tools PROFILE]
                        [--network none|delegated] [--resources heavy|bounded]
                        [--timeout SECONDS] [--cpu-percent PERCENT]
                        [--memory-mib MIB] [--swap-mib MIB] [--pids COUNT]
                        [--file-size-mib MIB] [--tmp-mib MIB] [--home-mib MIB]
                        [--seal ID] [--drop-seals] [--result RELATIVE]
                        [--receipt | --receipt-fd FD]
                        [--cwd RELATIVE] -- ARGV...
  sandcodex-jail self-test [--json]

AUTHORITY
  The first-layer agent or human chooses a named staging workspace and may
  reduce tools, network, deadline, CPU, memory, swap, process, file, tmp, and home ceilings. Every
  top-level action enters a transient cgroup. An action may recursively invoke
  sandcodex-jail through depth five, but each child must be equal or narrower.
  The broker, not the action, constructs every grant and cgroup.

WORKFLOW
  sandcodex-jail workspace create review --role ephemeral-verification
  dir=$(sandcodex-jail workspace path review)
  git archive HEAD | tar -x -C "$dir"
  harness=$(sandcodex-jail seal create verifier)
  sandcodex-jail run --workspace review --tools python --seal "$harness" \
    --result verification.json --receipt-fd 3 -- \
    /sealed/"$harness"/verify.sh 3>receipt.id

NETWORK
  delegated is the default whenever the outer launch authorizes it. Normal safe
  and BARE-METAL launches authorize unrestricted proxied egress; launch with
  --restricted-network or --jail-network none to reduce it. The action remains
  in a fresh network namespace: HTTP(S) and SOCKS egress use the fixed proxy,
  while direct sockets and UDP stay unavailable.

RESOURCES
  Every dimension is independent. The launch grant is the default; finite launch
  ceilings are inherited. heavy clears every dimension only beneath a fully
  unbounded launch/parent grant. bounded applies the tested 30 second / 100% CPU /
  512 MiB / zero-swap / 256 PID / 128 MiB-per-file / 32 MiB-tmp /
  16 MiB-home preset. A numeric option changes only its named dimension.

Run `sandcodex-jail inspect` for the exact contract and current grant.
EOF
}

is_nested() {
  [[ ${SAND_JAIL:-0} == 1 && ${SAND_JAIL_GRANT:-} == /run/sand-jail/grant.json && \
    -f /run/sand-jail/grant.json && ! -L /run/sand-jail/grant.json && \
    -S /run/sand-jail/control.sock && -x /run/sand-jail/bin/sandcodex-jail ]]
}

require_runtime() {
  local available disabled first
  if is_nested; then return 0; fi
  if [[ ${SANDCODEX_JAIL_BROKER_EXEC:-0} == 1 ]]; then return 0; fi
  [[ ${SANDCODEX_ACTIVE:-0} == 1 || ${SANDCODEX_BARE_METAL:-0} == 1 ]] || \
    die 'must run inside an active Sandcodex session'
  [[ -f $contract && ! -L $contract && -d $data_root && ! -L $data_root ]] || \
    die 'protected inner-jail contract is unavailable'
  available=$("$jq_bin" -er '.available // false' "$contract" 2>/dev/null || printf false)
  if [[ "$available" != true ]]; then
    first=${1:---help}
    case "$first" in
      inspect|capability-card|card|-h|--help|help) return 0 ;;
    esac
    disabled=$("$jq_bin" -er '.disabled_reason // "not available in this launch"' "$contract" 2>/dev/null || \
      printf 'not available in this launch')
    die "inner-jail unavailable in this launch: $disabled"
  fi
  [[ -d $workspace_root && ! -L $workspace_root ]] || die 'inner-jail workspace root is unavailable'
  [[ -d $cache_root && ! -L $cache_root ]] || die 'inner-jail cache root is unavailable'
  [[ -d $sealed_root && ! -L $sealed_root ]] || die 'protected sealed-input root is unavailable'
  [[ -d $receipt_root && ! -L $receipt_root ]] || die 'protected action-receipt root is unavailable'
  if [[ ! -S $broker_socket || -L $broker_socket ]]; then
    local broker_observed=absent
    [[ ! -e $broker_socket && ! -L $broker_socket ]] ||
      broker_observed=$("$stat_bin" -Lc 'type=%F mode=%a uid=%u links=%h' -- "$broker_socket" 2>/dev/null || printf unreadable)
    die "inner-jail resource broker is unavailable at $broker_socket ($broker_observed)"
  fi
}

validate_name() {
  local name=$1
  [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && $name != '.' && $name != '..' ]] || \
    die 'workspace name must be 1-64 letters, digits, dots, underscores, or hyphens'
}

workspace_path() {
  local name=$1 expected path
  is_nested && die 'recursive jail calls inherit one fixed workspace'
  validate_name "$name"
  expected="$workspace_root/$name"
  path=$($realpath_bin -m -- "$expected")
  [[ $path == "$expected" ]] || die 'workspace path escaped its fixed root'
  printf '%s\n' "$path"
}

cache_path() {
  local name=$1 expected path
  is_nested && die 'recursive jail calls inherit one fixed cache'
  validate_name "$name"
  expected="$cache_root/$name"
  path=$($realpath_bin -m -- "$expected")
  [[ $path == "$expected" ]] || die 'cache path escaped its fixed root'
  printf '%s\n' "$path"
}

validate_workspace() {
  local path=$1 target bad mounts
  [[ -d $path && ! -L $path ]] || die "workspace does not exist: $path"
  [[ $($realpath_bin -- "$path") == "$path" ]] || die 'workspace has a symlink component'
  mounts=$($findmnt_bin -R -n -o TARGET --target "$path") || die 'could not inspect workspace mounts'
  while IFS= read -r target; do
    [[ -n $target ]] || continue
    case "$target" in "$path"|"$path"/*) die "workspace contains a nested mount: $target" ;; esac
  done <<<"$mounts"
  bad=$($find_bin -P "$path" -xdev \( -type b -o -type c -o -type p -o -type s \) -print -quit)
  [[ -z $bad ]] || die "workspace contains a special file: $bad"
  bad=$($find_bin -P "$path" -xdev -type f -links +1 -print -quit)
  [[ -z $bad ]] || die "workspace contains a hardlinked file; copy it instead: $bad"
}

validate_cache() {
  local path=$1 target bad mounts
  [[ -d $path && ! -L $path ]] || die "cache does not exist: $path"
  [[ $($realpath_bin -- "$path") == "$path" ]] || die 'cache has a symlink component'
  mounts=$($findmnt_bin -R -n -o TARGET --target "$path") || die 'could not inspect cache mounts'
  while IFS= read -r target; do
    [[ -n $target ]] || continue
    case "$target" in "$path"|"$path"/*) die "cache contains a nested mount: $target" ;; esac
  done <<<"$mounts"
  bad=$($find_bin -P "$path" -xdev \( -type b -o -type c -o -type p -o -type s \) -print -quit)
  [[ -z $bad ]] || die "cache contains a special file: $bad"
}

landlock_abi() {
  "$python_bin" -P - <<'PY'
import ctypes
import platform
if platform.machine() not in {"x86_64", "aarch64"}:
    raise SystemExit("unsupported Landlock probe architecture")
libc = ctypes.CDLL(None, use_errno=True)
result = libc.syscall(ctypes.c_long(444), ctypes.c_void_p(), ctypes.c_size_t(0), ctypes.c_uint(1))
if result < 0:
    raise SystemExit(f"landlock_create_ruleset(VERSION) failed with errno {ctypes.get_errno()}")
print(result)
PY
}

close_nonstandard_fds() {
  local entry fd
  for entry in /proc/"$BASHPID"/fd/*; do
    fd=${entry##*/}
    case "$fd" in 0|1|2|*[!0-9]*|'') continue ;; esac
    { exec {fd}>&-; } 2>/dev/null || true
  done
}

current_outer_proxy() {
  local url=${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}
  [[ -n $url ]] || die 'delegated network is unavailable: the outer proxy is absent'
  printf '%s\n' "$url"
}

parse_outer_proxy() {
  local url=$1
  "$python_bin" -P - "$url" <<'PY'
import sys
from urllib.parse import quote, urlsplit
parsed = urlsplit(sys.argv[1])
if parsed.scheme != "http" or parsed.hostname not in {"127.0.0.1", "localhost"}:
    raise SystemExit("outer proxy is not a loopback HTTP endpoint")
try: port = parsed.port
except ValueError as error: raise SystemExit(str(error))
if not port or parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
    raise SystemExit("outer proxy URL has an unsupported shape")
userinfo = ""
if parsed.username is not None:
    userinfo = quote(parsed.username, safe="")
    if parsed.password is not None: userinfo += ":" + quote(parsed.password, safe="")
    userinfo += "@"
print(port)
print(f"http://{userinfo}127.0.0.1:3128")
PY
}

write_request() {
  local target=$1 parent=$2 workspace=$3 profile=$4 network=$5 resources=$6 seconds=$7 cwd=$8
  local cpu=$9 memory=${10} swap=${11} pids=${12} file_size=${13} tmp_bytes=${14} home_bytes=${15}
  local proxy=${16} proxy_socket=${17} seals=${18} results=${19} report_receipt=${20}
  shift 20
  "$jq_bin" -n --arg parent "$parent" --arg workspace "$workspace" --arg profile "$profile" \
    --arg network "$network" --arg resources "$resources" --arg cwd "$cwd" --arg proxy "$proxy" --arg proxySocket "$proxy_socket" \
    --argjson seconds "$seconds" --argjson cpu "$cpu" --argjson memory "$memory" \
    --argjson swap "$swap" --argjson pids "$pids" --argjson fileSize "$file_size" \
    --argjson tmpBytes "$tmp_bytes" --argjson homeBytes "$home_bytes" \
    --argjson seals "$seals" --argjson results "$results" --argjson reportReceipt "$report_receipt" --args '
      {schema:"sand-jail.request.v3",
       parent_token:(if $parent == "" then null else $parent end),
       workspace:(if $workspace == "" then null else $workspace end),
       profile:$profile,network:$network,resource_profile:$resources,timeout_seconds:$seconds,cwd:$cwd,
       cpu_percent:$cpu,memory_mib:$memory,memory_swap_mib:$swap,pids:$pids,
       file_size_bytes:$fileSize,tmp_bytes:$tmpBytes,home_bytes:$homeBytes,
       proxy_url:(if $proxy == "" then null else $proxy end),
       proxy_socket:(if $proxySocket == "" then null else $proxySocket end),
       sealed_inputs:$seals,result_paths:$results,report_receipt:$reportReceipt,argv:$ARGS.positional}
    ' -- "$@" >"$target"
  "$chmod_bin" 600 -- "$target"
}

request_action() (
  local workspace=$1 profile=$2 network=$3 resources=$4 seconds=$5 cwd=$6 cpu=$7 memory=$8 swap=$9
  local pids=${10} file_size=${11} tmp_bytes=${12} home_bytes=${13}
  shift 13
  (( $# )) || die 'run requires argv after --'
  local parent='' proxy='' proxy_socket='' socket=$broker_socket client="$data_root/broker-client.py"
  local request_dir='' request relay_dir='' relay_pid='' proxy_port=''
  local -a proxy_parts=()
  cleanup_request() {
    local rc=$?
    trap - EXIT INT TERM HUP
    if [[ -n $relay_pid ]]; then kill "$relay_pid" 2>/dev/null || true; wait "$relay_pid" 2>/dev/null || true; fi
    [[ -z $request_dir ]] || "$rm_bin" -rf -- "$request_dir"
    [[ -z $relay_dir ]] || "$rm_bin" -rf -- "$relay_dir"
    exit "$rc"
  }
  trap cleanup_request EXIT INT TERM HUP
  if is_nested; then
    parent=$($jq_bin -er '.token' /run/sand-jail/grant.json)
    socket=/run/sand-jail/control.sock
    client=/run/sand-jail/broker-client.py
    workspace=''
  else
    local work
    work=$(workspace_path "$workspace")
    validate_workspace "$work"
    if [[ $network == delegated && $($jq_bin -r '.network.proxy_kind' "$contract") == outer ]]; then
      mapfile -t proxy_parts < <(parse_outer_proxy "$(current_outer_proxy)")
      (( ${#proxy_parts[@]} == 2 )) || die 'could not resolve the outer delegated proxy'
      proxy_port=${proxy_parts[0]}; proxy=${proxy_parts[1]}
      [[ -d $relay_root && ! -L $relay_root ]] || die 'outer delegated relay root is unavailable'
      if ! relay_dir=$($mktemp_bin -d "$relay_root/relay.XXXXXX"); then
        infra_die 'could not allocate the delegated-network relay'
      fi
      "$chmod_bin" 700 -- "$relay_dir"
      proxy_socket="$relay_dir/proxy.sock"
      (
        close_nonstandard_fds
        exec "$socat_bin" "UNIX-LISTEN:$proxy_socket,fork,mode=0600" "TCP4:127.0.0.1:$proxy_port"
      ) >/dev/null 2>"$relay_dir/relay.err" &
      relay_pid=$!
      local ready=0
      for _ in {1..200}; do
        if [[ -S $proxy_socket && $($stat_bin -c %a -- "$proxy_socket") == 600 ]]; then ready=1; break; fi
        kill -0 "$relay_pid" 2>/dev/null || break
        "$sleep_bin" 0.01
      done
      (( ready == 1 )) || infra_die 'outer delegated relay failed to start'
    fi
  fi
  [[ -x $client && -S $socket ]] || die 'inner-jail resource broker transport is unavailable'
  if ! request_dir=$($mktemp_bin -d "${TMPDIR:-/tmp}/.sjr.XXXXXX"); then
    infra_die 'could not allocate the broker request'
  fi
  request="$request_dir/request.json"
  write_request "$request" "$parent" "$workspace" "$profile" "$network" "$resources" "$seconds" "$cwd" \
    "$cpu" "$memory" "$swap" "$pids" "$file_size" "$tmp_bytes" "$home_bytes" \
    "$proxy" "$proxy_socket" "${request_seals_json:-[]}" "${request_results_json:-[]}" \
    "${request_report_receipt:-false}" "$@"
  local -a client_options=()
  if [[ -n ${request_receipt_fd:-} ]]; then
    client_options=(--receipt-fd "$request_receipt_fd")
  fi
  "$python_bin" -P "$client" "$socket" "$request" "${client_options[@]}"
)

current_cgroup() {
  local line
  while IFS= read -r line; do
    case "$line" in 0::/*) printf '%s\n' "${line#0::}"; return 0 ;; esac
  done </proc/self/cgroup
  return 1
}

PREPARED_CGROUP_ROOT=
prepare_cgroup() {
  local mode=$1 reference=$2 segment=$3 unit=$4 resources=$5 cpu=$6 memory=$7 swap=$8 pids=$9
  local current scope grant expected memory_bytes swap_bytes observed_cpu observed_memory observed_swap observed_pids
  current=$(current_cgroup) || die 'jail cgroup identity is unavailable'
  [[ $current == /* ]] || die 'jail cgroup identity is unavailable'
  if [[ $mode == top ]]; then
    [[ $segment =~ ^g-[0-9a-f]{24}$ && ${current##*/} == "$unit" ]] || \
      die 'top-level jail cgroup grant is invalid'
    scope="/sys/fs/cgroup$current"
    grant="$scope/$segment"
    [[ ! -e $grant && ! -L $grant ]] || die 'top-level jail cgroup already exists'
    $mkdir_bin -- "$grant" "$grant/payload"
    printf '%s' "$$" >"$grant/payload/cgroup.procs"
    printf '%s' '+cpu +memory +pids' >"$scope/cgroup.subtree_control"
    [[ $memory == null ]] && printf 'max' >"$grant/memory.max" ||
      printf '%s' "$((memory * 1024 * 1024))" >"$grant/memory.max"
    [[ $swap == null ]] && printf 'max' >"$grant/memory.swap.max" ||
      printf '%s' "$((swap * 1024 * 1024))" >"$grant/memory.swap.max"
    [[ $pids == null ]] && printf 'max' >"$grant/pids.max" || printf '%s' "$pids" >"$grant/pids.max"
    [[ $cpu == null ]] && printf 'max 100000' >"$grant/cpu.max" ||
      printf '%s 100000' "$((cpu * 1000))" >"$grant/cpu.max"
    printf '%s' '+cpu +memory +pids' >"$grant/cgroup.subtree_control"
    current=$(current_cgroup) || die 'top-level jail cgroup identity disappeared'
    expected="${scope#/sys/fs/cgroup}/$segment/payload"
    [[ $current == "$expected" ]] || die 'top-level jail process did not enter its delegated cgroup'
  else
    [[ $mode == nested && $reference == /sys/fs/cgroup/* && -d $reference && ! -L $reference ]] || \
      die 'recursive jail cgroup grant is invalid'
    grant=$reference
    expected="${grant#/sys/fs/cgroup}/payload"
    [[ $current == "$expected" ]] || die 'recursive jail process is outside its delegated cgroup'
  fi
  observed_memory=$(<"$grant/memory.max")
  observed_swap=$(<"$grant/memory.swap.max")
  observed_pids=$(<"$grant/pids.max")
  observed_cpu=$(<"$grant/cpu.max")
  [[ $memory == null ]] && memory_bytes=max || memory_bytes=$((memory * 1024 * 1024))
  [[ $swap == null ]] && swap_bytes=max || swap_bytes=$((swap * 1024 * 1024))
  local expected_pids=$pids expected_cpu
  [[ $pids == null ]] && expected_pids=max
  [[ $cpu == null ]] && expected_cpu='max 100000' || expected_cpu="$((cpu * 1000)) 100000"
  [[ $observed_memory == "$memory_bytes" && $observed_swap == "$swap_bytes" && \
    $observed_pids == "$expected_pids" && $observed_cpu == "$expected_cpu" ]] ||
    die 'jail cgroup limits do not match the immutable grant'
  PREPARED_CGROUP_ROOT=$grant
}

execute_action() {
  local workspace=$1 profile=$2 network=$3 resources=$4 seconds=$5 cwd=$6 cpu=$7 memory=$8 swap=$9
  local pids=${10} file_size=${11} tmp_bytes=${12} home_bytes=${13}
  local depth=${14} max_depth=${15} token=${16} proxy_kind=${17} proxy_url=${18}
  local proxy_socket=${19} cgroup_mode=${20} cgroup_ref=${21} segment=${22} unit=${23}
  local result_path=${24} sealed_json=${25} result_json=${26}
  shift 26
  (( $# )) || die 'broker grant contains no argv'
  local work cache profile_root manifest cert abi child_cwd cgroup_root
  local action_dir='' denied_dir='' bridge_socket='' bridge_pid='' proxy_inner='' deadline_marker=''
  local grant_json='' limits_json='' socks_available=false file_size_blocks=null
  local -a mounts=() seal_ids=()

  work=$(workspace_path "$workspace")
  validate_workspace "$work"
  cache=$(cache_path "$workspace")
  validate_cache "$cache"
  profile_root="$data_root/profiles/$profile"
  manifest="$profile_root/closure"
  [[ -d $profile_root && ! -L $profile_root && -s $manifest && ! -L $manifest ]] || \
    die "unknown or unavailable tool profile: $profile"
  cert=$(<"$data_root/certificate-path")
  [[ $cert == /nix/store/* && -f $cert ]] || die 'pinned certificate path is invalid'
  abi=$(landlock_abi) || die 'Landlock ABI probe failed'
  [[ $abi =~ ^[0-9]+$ && $abi -ge 3 ]] || die "Landlock ABI 3 or newer is required; observed ${abi:-unknown}"
  [[ $depth =~ ^[1-5]$ && $max_depth == "$depth_max" && $depth -le $max_depth ]] || \
    die 'broker recursion grant is invalid'
  [[ $token =~ ^[0-9a-f]{48}$ ]] || die 'broker grant token is invalid'
  [[ $result_path == "$broker_root/result-$token.json" && ! -e $result_path && ! -L $result_path ]] || \
    die 'broker resource-report path is invalid'
  "$jq_bin" -e --argjson maximum "$seal_max_count" '
    type == "array" and length <= $maximum and
    all(.[]; type == "string" and test("^[0-9a-f]{64}$")) and
    (length == (unique | length))' <<<"$sealed_json" >/dev/null ||
    die 'broker sealed-input grant is invalid'
  "$jq_bin" -e --argjson maximum "$result_max_count" '
    type == "array" and length <= $maximum and all(.[]; type == "string") and
    (length == (unique | length))' <<<"$result_json" >/dev/null ||
    die 'broker result-evidence grant is invalid'
  mapfile -t seal_ids < <("$jq_bin" -er '.[]?' <<<"$sealed_json")

  [[ $cwd != /* && $cwd != *$'\n'* && $cwd != *$'\r'* ]] || die '--cwd must be a relative path'
  child_cwd=$($realpath_bin -m -- "$work/$cwd")
  case "$child_cwd" in "$work"|"$work"/*) ;; *) die '--cwd escaped the selected workspace' ;; esac
  [[ -d $child_cwd ]] || die "--cwd does not exist in the selected workspace: $cwd"
  child_cwd="/work${child_cwd#"$work"}"
  prepare_cgroup "$cgroup_mode" "$cgroup_ref" "$segment" "$unit" "$resources" "$cpu" "$memory" "$swap" "$pids"
  cgroup_root=$PREPARED_CGROUP_ROOT

  cleanup() {
    local rc=$?
    trap - EXIT INT TERM HUP
    if [[ -n $bridge_pid ]]; then
      kill "$bridge_pid" 2>/dev/null || true
      wait "$bridge_pid" 2>/dev/null || true
    fi
    if [[ $proxy_kind == host && -n $bridge_socket ]]; then "$rm_bin" -f -- "$bridge_socket"; fi
    if [[ -n $denied_dir ]]; then
      if [[ ! -f $denied_dir/canary || $(<"$denied_dir/canary") != landlock-write-canary ]]; then
        printf 'sandcodex-jail: Landlock write canary failed; refusing success\n' >&2
        rc=79
      fi
    fi
    [[ -z $action_dir ]] || $rm_bin -rf -- "$action_dir"
    exit "$rc"
  }
  trap cleanup EXIT INT TERM HUP

  [[ -d $broker_root && ! -L $broker_root ]] || die 'protected broker storage is unavailable'
  action_dir=$($mktemp_bin -d "$broker_root/.action.XXXXXX")
  "$chmod_bin" 700 -- "$action_dir"
  deadline_marker="$action_dir/deadline-exceeded"
  denied_dir="$action_dir/landlock-denied"
  $mkdir_bin -m 777 -- "$denied_dir"
  printf 'landlock-write-canary\n' >"$denied_dir/canary"
  "$chmod_bin" 666 -- "$denied_dir/canary"
  grant_json="$action_dir/grant.json"
  limits_json="$action_dir/limits.json"
  "$jq_bin" -n --arg schema sand-jail.recursive-grant.v3 --arg token "$token" \
    --arg profile "$profile" --arg network "$network" --arg resources "$resources" --arg workspace "$workspace" \
    --argjson seals "$sealed_json" --argjson results "$result_json" \
    --argjson depth "$depth" --argjson maxDepth "$max_depth" --argjson timeout "$seconds" \
    --argjson cpu "$cpu" --argjson memory "$memory" --argjson swap "$swap" --argjson pids "$pids" \
    --argjson fileSize "$file_size" --argjson tmpBytes "$tmp_bytes" --argjson homeBytes "$home_bytes" '{
      schema:$schema,token:$token,depth:$depth,max_depth:$maxDepth,workspace:$workspace,
      profile:$profile,network:$network,resource_profile:$resources,timeout_seconds_max:$timeout,
      resources:{cpu_percent_max:$cpu,memory_mib_max:$memory,memory_swap_mib_max:$swap,
        pids_max:$pids,file_size_bytes_max:$fileSize,tmp_bytes_max:$tmpBytes,home_bytes_max:$homeBytes},
      sealed_inputs:$seals,result_paths:$results,
      reductions:["tool profile","network to none","timeout","CPU","memory","swap","pids","file size","tmp","home","sealed inputs may be dropped","relative cwd"],
      invariant:"a recursive child must be equal to or narrower than this grant"
    }' >"$grant_json"
  "$jq_bin" -n --arg schema sand-jail.resource-limits.v2 --arg path "$cgroup_root" --arg resources "$resources" \
    --argjson depth "$depth" --argjson timeout "$seconds" --argjson cpu "$cpu" \
    --argjson memory "$memory" --argjson swap "$swap" --argjson pids "$pids" \
    --argjson fileSize "$file_size" --argjson tmpBytes "$tmp_bytes" --argjson homeBytes "$home_bytes" \
    '{schema:$schema,enforced:any([$timeout,$cpu,$memory,$swap,$pids,$fileSize,$tmpBytes,$homeBytes][]; . != null),
      resource_profile:$resources,depth:$depth,cgroup_path:$path,deadline_seconds:$timeout,
      cpu_percent:$cpu,memory_mib:$memory,memory_swap_mib:$swap,
      memory_swap_bytes:(if $swap == null then null else $swap * 1048576 end),pids:$pids,
      file_size_bytes:$fileSize,tmp_bytes:$tmpBytes,home_bytes:$homeBytes}' >"$limits_json"
  "$chmod_bin" 444 -- "$grant_json" "$limits_json"

  if [[ $network == delegated ]]; then
    if "$jq_bin" -e '.network.proxy_transports | index("SOCKS5") != null' "$contract" >/dev/null; then
      socks_available=true
    fi
    if [[ $proxy_kind == outer ]]; then
      bridge_socket=$proxy_socket
      proxy_inner=$proxy_url
      [[ -S $bridge_socket && ! -L $bridge_socket && $($stat_bin -c %u:%a -- "$bridge_socket") == "$EUID:600" ]] || \
        die 'outer delegated relay grant is unavailable'
    elif [[ $proxy_kind == host ]]; then
      bridge_socket="$relay_root/host.${token:0:16}.sock"
      [[ ! -e $bridge_socket && ! -L $bridge_socket ]] || die 'delegated host proxy path already exists'
      proxy_inner=http://127.0.0.1:3128
      (
        close_nonstandard_fds
        exec "$python_bin" -P "$data_root/host-proxy.py" "$bridge_socket"
      ) >/dev/null 2>"$action_dir/bridge.err" &
      bridge_pid=$!
      local ready=0
      for _ in {1..200}; do
        if [[ -S $bridge_socket && $($stat_bin -c %a -- "$bridge_socket") == 600 ]]; then ready=1; break; fi
        kill -0 "$bridge_pid" 2>/dev/null || break
        "$sleep_bin" 0.01
      done
      (( ready == 1 )) || die 'delegated host proxy failed to start'
    else
      die 'delegated network has no preauthorized proxy ceiling'
    fi
  fi

  mounts=(--tmpfs / --dir /nix --dir /nix/store --dir /sealed)
  local store_path
  while IFS= read -r store_path; do
    [[ $store_path == /nix/store/* && -e $store_path && ! -L $store_path ]] || \
      die "invalid store closure entry: $store_path"
    mounts+=(--ro-bind "$store_path" "$store_path")
  done <"$manifest"
  local seal_id seal_object seal_data seal_manifest
  for seal_id in "${seal_ids[@]}"; do
    seal_object="$sealed_root/$seal_id"
    seal_data="$seal_object/data"
    seal_manifest="$seal_object/manifest.json"
    [[ $($realpath_bin -- "$seal_object") == "$seal_object" &&
      -d $seal_data && ! -L $seal_data && -f $seal_manifest && ! -L $seal_manifest &&
      $($stat_bin -c %u:%a -- "$seal_object") == "$EUID:700" &&
      $($stat_bin -c %u:%a -- "$seal_data") == "$EUID:755" &&
      $($stat_bin -c %u:%a:%h -- "$seal_manifest") == "$EUID:400:1" ]] ||
      die "sealed input object is unavailable or unsafe: $seal_id"
    mounts+=(--dir "/sealed/$seal_id" --ro-bind "$seal_data" "/sealed/$seal_id")
  done
  mounts+=(
    --ro-bind "$profile_root" /tools
    --dir /bin --symlink /tools/bin/bash /bin/bash --symlink /tools/bin/sh /bin/sh
    --dir /usr --dir /usr/bin --symlink /tools/bin/env /usr/bin/env
    --dir /etc
    --ro-bind "$data_root/etc/passwd" /etc/passwd
    --ro-bind "$data_root/etc/group" /etc/group
    --ro-bind "$data_root/etc/hosts" /etc/hosts
    --ro-bind "$data_root/etc/resolv.conf" /etc/resolv.conf
    --proc /proc --dev /dev
    --dir /work --bind "$work" /work
    --dir /cache --bind "$cache" /cache
    --dir /run --ro-bind "$data_root/landlock-canary" /run/landlock-canary
    --bind "$denied_dir" /run/landlock-denied
    --dir /run/sand-jail --dir /run/sand-jail/bin
    --ro-bind "$helper_host" /run/sand-jail/bin/sandcodex-jail
    --ro-bind "$data_root/broker-client.py" /run/sand-jail/broker-client.py
    --ro-bind "$data_root/seccomp-exec" /run/sand-jail/seccomp-exec
    --ro-bind "$grant_json" /run/sand-jail/grant.json
    --ro-bind "$limits_json" /run/sand-jail/limits.json
    --ro-bind "$broker_socket" /run/sand-jail/control.sock
  )
  if [[ $tmp_bytes == null ]]; then
    $mkdir_bin -m 1777 -- "$action_dir/tmp"
    mounts+=(--dir /tmp --bind "$action_dir/tmp" /tmp)
  else
    mounts+=(--size "$tmp_bytes" --tmpfs /tmp --chmod 1777 /tmp)
  fi
  if [[ $home_bytes == null ]]; then
    $mkdir_bin -m 700 -- "$action_dir/home"
    mounts+=(--dir /home --dir /home/worker --bind "$action_dir/home" /home/worker)
  else
    mounts+=(--dir /home --size "$home_bytes" --tmpfs /home/worker --chmod 700 /home/worker)
  fi
  if [[ $network == delegated ]]; then
    mounts+=(--dir /run/network --ro-bind "$bridge_socket" /run/network/proxy.sock)
  fi
  mounts+=(--remount-ro /)

  local bootstrap
  read -r -d '' bootstrap <<'BOOTSTRAP' || true
set -Eeuo pipefail
landrun=$1; seccomp_exec=$2; socat=$3; network=$4; proxy_url=$5; socks_available=$6
profile=$7; workspace=$8; resources=$9; depth=${10}; max_depth=${11}; file_size_blocks=${12}; shift 12
ulimit -c 0
if [[ $file_size_blocks != null ]]; then ulimit -f "$file_size_blocks"; fi
relay=
cleanup_leaf() {
  rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n $relay ]]; then kill "$relay" 2>/dev/null || true; wait "$relay" 2>/dev/null || true; fi
  exit "$rc"
}
trap cleanup_leaf EXIT INT TERM HUP
if [[ $network == delegated ]]; then
  "$socat" TCP4-LISTEN:3128,bind=127.0.0.1,reuseaddr,fork \
    UNIX-CONNECT:/run/network/proxy.sock >/tmp/proxy-relay.log 2>&1 &
  relay=$!
  ready=0
  for _ in {1..100}; do
    kill -0 "$relay" 2>/dev/null || break
    if timeout 1 bash -c 'exec 9<>/dev/tcp/127.0.0.1/3128' 2>/dev/null; then ready=1; break; fi
    sleep 0.01
  done
  [[ $ready == 1 ]] || { printf 'sand-jail: child proxy relay failed\n' >&2; exit 70; }
fi
args=(--best-effort --unrestricted-network
  --rox /nix/store --rox /tools --rox /sealed --ro /etc --ro /proc --rw /dev
  --rox /run/sand-jail --rwx /work --rwx /cache --rwx /tmp --rwx /home/worker
  --env HOME=/home/worker --env PATH=/run/sand-jail/bin:/tools/bin --env TMPDIR=/tmp
  --env XDG_CACHE_HOME=/cache/xdg --env npm_config_cache=/cache/npm
  --env PIP_CACHE_DIR=/cache/pip --env CARGO_HOME=/cache/cargo --env GOCACHE=/cache/go-build
  --env LANG=C.UTF-8 --env "SSL_CERT_FILE=$SSL_CERT_FILE" --env "NIX_SSL_CERT_FILE=$NIX_SSL_CERT_FILE"
  --env SAND_JAIL=1 --env SAND_JAIL_GRANT=/run/sand-jail/grant.json
  --env SAND_JAIL_SEALED_ROOT=/sealed
  --env "SAND_JAIL_PRODUCT=$SAND_JAIL_PRODUCT" --env "SAND_JAIL_NETWORK=$network"
  --env "SAND_JAIL_PROFILE=$profile" --env "SAND_JAIL_WORKSPACE=$workspace"
  --env "SAND_JAIL_RESOURCES=$resources"
  --env "SAND_JAIL_DEPTH=$depth" --env "SAND_JAIL_MAX_DEPTH=$max_depth")
if [[ $network == delegated ]]; then
  args+=(--env NODE_USE_ENV_PROXY=1
    --env "HTTP_PROXY=$proxy_url" --env "HTTPS_PROXY=$proxy_url"
    --env "http_proxy=$proxy_url" --env "https_proxy=$proxy_url"
    --env NO_PROXY=127.0.0.1,localhost --env no_proxy=127.0.0.1,localhost)
  if [[ $socks_available == true ]]; then
    args+=(--env "ALL_PROXY=${proxy_url/http:/socks5h:}" --env "all_proxy=${proxy_url/http:/socks5h:}")
  fi
fi
exec "$landrun" "${args[@]}" -- "$seccomp_exec" bash -c '
  if cat /run/landlock-canary >/dev/null 2>&1; then
    printf "sand-jail: Landlock read canary was readable; refusing action\n" >&2; exit 78
  fi
  if (printf changed > /run/landlock-denied/canary) 2>/dev/null; then
    printf "sand-jail: Landlock write canary was writable; refusing action\n" >&2; exit 79
  fi
  exec "$@"
' sand-jail-leaf "$@"
BOOTSTRAP

  [[ $file_size == null ]] || file_size_blocks=$((file_size / 1024))
  local action_status
  local -a action=(
      "$bwrap_bin" --die-with-parent --new-session --unshare-all --unshare-user --disable-userns \
      --uid 65534 --gid 65534 --cap-drop ALL --clearenv --hostname sandcodex-jail \
      "${mounts[@]}" --setenv HOME /home/worker --setenv PATH /run/sand-jail/bin:/tools/bin \
      --setenv TMPDIR /tmp --setenv LANG C.UTF-8 --setenv SSL_CERT_FILE "$cert" \
      --setenv NIX_SSL_CERT_FILE "$cert" --setenv SAND_JAIL_PRODUCT "$product" \
      --chdir "$child_cwd" -- "$bash_bin" -c "$bootstrap" sand-jail-bootstrap \
      "$landrun_bin" /run/sand-jail/seccomp-exec "$socat_bin" "$network" "$proxy_inner" \
      "$socks_available" "$profile" "$workspace" "$resources" "$depth" "$max_depth" \
      "$file_size_blocks" "$@")
  if (
    close_nonstandard_fds
    if [[ $seconds != null ]]; then
      exec "$python_bin" -P "$data_root/deadline-runner.py" "$seconds" "$deadline_marker" "${action[@]}"
    fi
    exec "${action[@]}"
  ); then action_status=0; else action_status=$?; fi
  if [[ -f $deadline_marker && ! -L $deadline_marker && $($stat_bin -c %u:%a:%h -- "$deadline_marker") == "$EUID:600:1" ]]; then
    action_status=124
  elif (( action_status == 124 )); then
    action_status=125
  fi
  "$python_bin" -P "$data_root/resource-report.py" "$cgroup_root" "$broker_root" \
    "$result_path" "$action_status" || die 'could not seal the broker resource report'
  exit "$action_status"
}

broker_execute() {
  [[ ${SANDCODEX_JAIL_BROKER_EXEC:-0} == 1 ]] || die 'broker executor is not public'
  local request=$1 request_name size owner mode links
  request_name=${request##*/}
  [[ ${request%/*} == "$broker_root" && $request_name =~ ^request-[0-9a-f]{32}\.json$ && \
    -f $request && ! -L $request ]] || \
    die 'broker request path is invalid'
  owner=$($stat_bin -c %u -- "$request"); mode=$($stat_bin -c %a -- "$request")
  links=$($stat_bin -c %h -- "$request"); size=$($stat_bin -c %s -- "$request")
  [[ $owner == "$EUID" && $mode == 600 && $links == 1 && $size -le 131072 ]] || \
    die 'broker request file is unsafe'
  local -a fields=()
  mapfile -d '' -t fields < <("$python_bin" -P - "$request" <<'PY'
import json, sys
doc=json.load(open(sys.argv[1], encoding="utf-8"))
if doc.get("schema") != "sand-jail.grant.v3": raise SystemExit(64)
fixed=[doc["workspace_name"],doc["profile"],doc["network"],doc["resource_profile"],
       doc["timeout_seconds"] if doc["timeout_seconds"] is not None else "null",doc["cwd"],
       doc["cpu_percent"],doc["memory_mib"],doc["memory_swap_mib"],doc["pids"],
       doc["file_size_bytes"],doc["tmp_bytes"],doc["home_bytes"],
       doc["depth"],doc["max_depth"],doc["token"],
       doc["proxy_kind"],doc.get("proxy_url") or "",doc.get("proxy_socket") or "",
       doc["cgroup_mode"],doc["cgroup_ref"],
       doc.get("segment") or "",doc.get("unit") or "",doc["result_path"],
       json.dumps(doc["sealed_input_ids"],sort_keys=True,separators=(",",":")),
       json.dumps(doc["result_paths"],sort_keys=True,separators=(",",":"))]
values=["null" if value is None else str(value) for value in fixed] + doc["argv"]
for value in values:
    if "\0" in value: raise SystemExit(64)
    sys.stdout.buffer.write(value.encode()+b"\0")
PY
  ) || die 'broker request could not be decoded'
  (( ${#fields[@]} >= 27 )) || die 'broker request is incomplete'
  execute_action "${fields[0]}" "${fields[1]}" "${fields[2]}" "${fields[3]}" "${fields[4]}" \
    "${fields[5]}" "${fields[6]}" "${fields[7]}" "${fields[8]}" "${fields[9]}" \
    "${fields[10]}" "${fields[11]}" "${fields[12]}" "${fields[13]}" "${fields[14]}" \
    "${fields[15]}" "${fields[16]}" "${fields[17]}" "${fields[18]}" "${fields[19]}" \
    "${fields[20]}" "${fields[21]}" "${fields[22]}" "${fields[23]}" "${fields[24]}" \
    "${fields[25]}" "${fields[@]:26}"
}

