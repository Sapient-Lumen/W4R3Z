+static void sandcodex_arm_touch_tap(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	json_object *x_object = NULL, *y_object = NULL;
+	sandcodex_clear_dispatch_ticket(client);
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		!client->sandcodex_modifier_arc.active &&
+		json_object_object_length(request) == 3 &&
+		sandcodex_request_operation(request, "arm-touch-tap") &&
+		json_object_object_get_ex(request, "x", &x_object) &&
+		json_object_object_get_ex(request, "y", &y_object) &&
+		json_object_is_type(x_object, json_type_int) &&
+		json_object_is_type(y_object, json_type_int);
+	int64_t x = valid_shape ? json_object_get_int64(x_object) : 0;
+	int64_t y = valid_shape ? json_object_get_int64(y_object) : 0;
+	bool canonical = valid_shape &&
+		x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sandcodex_touch_arm_payload_canonical(payload, payload_length, x, y);
+	if (!canonical) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sandcodex_hit_target target = {0};
+	struct sway_view *view = NULL;
+	struct wlr_surface *view_surface = NULL;
+	struct wlr_surface *target_surface = NULL;
+	struct wlr_seat_client *seat_client = NULL;
+	double sx = 0, sy = 0;
+	uintptr_t touch_resource_address = 0;
+	uint32_t touch_resource_id = 0;
+	if (!sandcodex_capture_touch_target(seat, (double)x, (double)y, &target,
+			&view, &view_surface, &target_surface, &seat_client, &sx, &sy) ||
+			!sandcodex_touch_recipient_exact(seat_client, 0, 0,
+				&touch_resource_address, &touch_resource_id)) {
+		sandcodex_secure_clear(&target, sizeof(target));
+		sandcodex_send_hit_test_failure(client,
+			"touch-state-or-recipient-invalid");
+		return;
+	}
+
+	struct sandcodex_dispatch_ticket *grant =
+		&client->sandcodex_dispatch_ticket;
+	char ticket[SANDCODEX_DISPATCH_TICKET_LENGTH + 1] = {0};
+	if (!sandcodex_random_ticket(ticket)) {
+		sandcodex_secure_clear(&target, sizeof(target));
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-ticket-generation-failed");
+		return;
+	}
+	grant->armed = true;
+	grant->kind = SANDCODEX_DISPATCH_TOUCH_TAP;
+	memcpy(grant->value, ticket, sizeof(grant->value));
+	grant->x = x;
+	grant->y = y;
+	grant->target = target;
+	grant->touch_sx_bits = sandcodex_double_bits(sx);
+	grant->touch_sy_bits = sandcodex_double_bits(sy);
+	grant->touch_grab_address =
+		(uintptr_t)seat->wlr_seat->touch_state.grab;
+	grant->touch_default_grab_address =
+		(uintptr_t)seat->wlr_seat->touch_state.default_grab;
+	grant->touch_seat_client_address = (uintptr_t)seat_client;
+	grant->touch_resource_address = touch_resource_address;
+	grant->touch_resource_id = touch_resource_id;
+	if (!sandcodex_bind_surface_ticket(client, view_surface, target_surface) ||
+			!sandcodex_bind_touch_resource_ticket(client,
+				(struct wl_resource *)touch_resource_address)) {
+		sandcodex_secure_clear(ticket, sizeof(ticket));
+		sandcodex_secure_clear(&target, sizeof(target));
+		sandcodex_clear_dispatch_ticket(client);
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-lifetime-bind-failed");
+		return;
+	}
+	sandcodex_send_touch_target(client, &target, view, ticket, x, y);
+	sandcodex_secure_clear(ticket, sizeof(ticket));
+	sandcodex_secure_clear(&target, sizeof(target));
+}
