+static void sandcodex_arm_drag_button(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length,
+		bool pressed) {
+	const char *operation = pressed ? "arm-drag-press" : "arm-drag-release";
+	enum sandcodex_dispatch_kind dispatch_kind = pressed
+		? SANDCODEX_DISPATCH_DRAG_PRESS : SANDCODEX_DISPATCH_DRAG_RELEASE;
+	json_object *button_object = NULL, *x_object = NULL, *y_object = NULL;
+	sandcodex_clear_dispatch_ticket(client);
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == 4 &&
+		sandcodex_request_operation(request, operation) &&
+		json_object_object_get_ex(request, "button", &button_object) &&
+		json_object_object_get_ex(request, "x", &x_object) &&
+		json_object_object_get_ex(request, "y", &y_object) &&
+		json_object_is_type(button_object, json_type_int) &&
+		json_object_is_type(x_object, json_type_int) &&
+		json_object_is_type(y_object, json_type_int);
+	int64_t button_value = valid_shape ? json_object_get_int64(button_object) : 0;
+	bool button_valid = button_value >= 1 && button_value <= 3;
+	uint32_t button = button_valid ? (uint32_t)button_value : 0;
+	int64_t x = valid_shape ? json_object_get_int64(x_object) : 0;
+	int64_t y = valid_shape ? json_object_get_int64(y_object) : 0;
+	bool canonical = valid_shape && button_valid &&
+		x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sandcodex_drag_button_arm_payload_canonical(payload, payload_length,
+			operation, button, x, y);
+	if (!canonical) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sway_input_device *device = sandcodex_single_virtual_pointer(seat);
+	double actual_x = 0;
+	double actual_y = 0;
+	bool state_valid = pressed ? sandcodex_exact_released_pointer(seat)
+		: sandcodex_exact_held_button(seat, button);
+	if (!device || !state_valid || !seat->cursor ||
+			seat->cursor->active_constraint ||
+			!sandcodex_cursor_near_requested(seat, x, y,
+				&actual_x, &actual_y)) {
+		sandcodex_send_hit_test_failure(client,
+			pressed ? "drag-press-precondition-failed"
+				: "drag-release-precondition-failed");
+		return;
+	}
+
+	struct sandcodex_hit_target target = {0};
+	struct sway_view *view = NULL;
+	struct wlr_surface *view_surface = NULL;
+	struct wlr_surface *target_surface = NULL;
+	if (!sandcodex_capture_hit_target(seat, actual_x, actual_y, &target,
+			&view, &view_surface, &target_surface) || !target.hit ||
+			(pressed && (!target.surface_hit || !target_surface ||
+				seat->wlr_seat->pointer_state.focused_surface != target_surface))) {
+		sandcodex_send_hit_test_failure(client,
+			pressed ? "drag-press-hit-test-failed"
+				: "drag-release-hit-test-failed");
+		return;
+	}
+
+	struct sandcodex_dispatch_ticket *grant =
+		&client->sandcodex_dispatch_ticket;
+	if (!sandcodex_random_ticket(grant->value)) {
+		sandcodex_send_hit_test_failure(client,
+			pressed ? "drag-press-ticket-failed"
+				: "drag-release-ticket-failed");
+		return;
+	}
+	grant->armed = true;
+	grant->kind = dispatch_kind;
+	grant->x = x;
+	grant->y = y;
+	grant->button = button;
+	grant->cursor_x_bits = sandcodex_double_bits(actual_x);
+	grant->cursor_y_bits = sandcodex_double_bits(actual_y);
+	grant->target = target;
+	grant->sway_device_address = (uintptr_t)device;
+	grant->wlr_device_address = (uintptr_t)device->wlr_device;
+	strcpy(grant->device_identifier, device->identifier);
+	if (pressed) {
+		grant->pointer_focused_surface_address = (uintptr_t)target_surface;
+	} else {
+		struct wlr_seat_pointer_state *state = &seat->wlr_seat->pointer_state;
+		if (!state->grab || !state->default_grab || !state->focused_surface ||
+				state->grab_button != sandcodex_linux_button(button) ||
+				state->grab_serial == 0 || state->grab_time == 0) {
+			sandcodex_clear_dispatch_ticket(client);
+			sandcodex_send_hit_test_failure(client,
+				"drag-release-grab-unavailable");
+			return;
+		}
+		grant->pointer_grab_address = (uintptr_t)state->grab;
+		grant->pointer_default_grab_address = (uintptr_t)state->default_grab;
+		grant->pointer_focused_surface_address =
+			(uintptr_t)state->focused_surface;
+		grant->pointer_grab_button = state->grab_button;
+		grant->pointer_grab_serial = state->grab_serial;
+		grant->pointer_grab_time = state->grab_time;
+	}
+	if (!sandcodex_bind_dispatch_ticket(client, device->wlr_device,
+			view_surface, target_surface) || (!pressed &&
+			!sandcodex_bind_pointer_focused_surface_ticket(client,
+				seat->wlr_seat->pointer_state.focused_surface,
+				view_surface, target_surface))) {
+		sandcodex_clear_dispatch_ticket(client);
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-lifetime-bind-failed");
+		return;
+	}
+	sandcodex_send_hit_target(client, operation, x, y, &target, view,
+		grant->value, dispatch_kind, 0, 0, 0, 0, button, NULL, NULL);
+}
