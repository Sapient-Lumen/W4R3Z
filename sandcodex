def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def write_all(descriptor: int, payload: bytes) -> None:
    view = memoryview(payload)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError("short write")
        view = view[written:]


def as_int(value: Any, minimum: int, maximum: int, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        raise ToolError(f"{label} must be an integer from {minimum} through {maximum}")
    return value


def as_number(value: Any, minimum: float, maximum: float, label: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not minimum <= float(value) <= maximum:
        raise ToolError(f"{label} must be a number from {minimum} through {maximum}")
    return float(value)


def as_string(value: Any, label: str, *, maximum: int = MAX_TEXT_BYTES, allow_empty: bool = True) -> str:
    if not isinstance(value, str) or "\x00" in value:
        raise ToolError(f"{label} must be a string without NUL bytes")
    size = len(value.encode("utf-8"))
    if size > maximum or (not allow_empty and not value):
        raise ToolError(f"{label} exceeds its allowed size or is empty")
    return value


def as_bool(value: Any, label: str) -> bool:
    if not isinstance(value, bool):
        raise ToolError(f"{label} must be a boolean")
    return value


def parse_window_id(value: Any) -> int:
    if isinstance(value, bool):
        raise ToolError("window_id must be an integer or hexadecimal string")
    if isinstance(value, int):
        result = value
    elif isinstance(value, str) and re.fullmatch(r"(?:0x)?[0-9a-fA-F]+", value):
        base = 16 if value.lower().startswith("0x") or re.search(r"[a-fA-F]", value) else 10
        result = int(value, base)
    else:
        raise ToolError("window_id must be an integer or hexadecimal string")
    if not 1 <= result <= 2**63 - 1:
        raise ToolError("window_id is outside the supported compositor range")
    return result


def text_result(text: str, *, structured: dict[str, Any] | None = None) -> dict[str, Any]:
    result: dict[str, Any] = {"content": [{"type": "text", "text": text}]}
    if structured is not None:
        result["structuredContent"] = structured
    return result


def json_result(value: Any) -> dict[str, Any]:
    return text_result(json.dumps(value, sort_keys=True, indent=2), structured=value if isinstance(value, dict) else {"value": value})


def image_result(metadata: dict[str, Any], payload: bytes) -> dict[str, Any]:
    if not payload.startswith(b"\x89PNG\r\n\x1a\n"):
        raise ToolError("image result payload is not PNG")
    return {
        "content": [
            {"type": "text", "text": json.dumps(metadata, sort_keys=True, indent=2)},
            {
                "type": "image",
                "data": base64.b64encode(payload).decode("ascii"),
                "mimeType": "image/png",
            },
        ],
        "structuredContent": metadata,
    }


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    temporary = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
    try:
        payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
        write_all(descriptor, payload)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)


def canonical_json(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def denied_external_handler_executable(value: str) -> bool:
    """Reject ambient launchers and version-suffixed language runtimes.

    Nix commonly exposes interpreter executables as ``python3.13``,
    ``perl5.40.0``, or ``ruby3.3`` rather than the unversioned basename.  An
    exact-name denylist alone would therefore let a narrow URI/file handler
    grant become a general program interpreter merely by selecting a versioned
    binary.  Keep ordinary application names available while rejecting the
    reviewed multi-call, namespace, package, dispatcher, and runtime families.
    """
    basename = os.path.basename(value).casefold()
    return (
        basename in DENIED_OPEN_URI_HANDLER_BASENAMES
        or VERSIONED_HANDLER_INTERPRETER_RE.fullmatch(basename) is not None
    )


def normalize_open_uri_policy(
    handler_value: Any,
    schemes_value: Any = None,
) -> tuple[tuple[str, ...], str, str, str]:
    """Seal one immutable Nix-store URI handler and a sorted scheme allowlist."""
    if (
        not isinstance(handler_value, list)
        or not handler_value
        or len(handler_value) > MAX_OPEN_URI_HANDLER_ARGS
    ):
        raise ToolError("open_uri_handler must be a bounded non-empty argv array")
    handler: list[str] = []
    aggregate = 0
    for index, value in enumerate(handler_value):
        item = as_string(
            value,
            f"open_uri_handler[{index}]",
            maximum=MAX_OPEN_URI_HANDLER_ARG_BYTES,
            allow_empty=False,
        )
        if any(ord(character) < 0x20 or ord(character) == 0x7F for character in item):
            raise ToolError(f"open_uri_handler[{index}] contains control characters")
        aggregate += len(item.encode("utf-8")) + 1
        if aggregate > MAX_OPEN_URI_HANDLER_BYTES:
            raise ToolError("open_uri_handler exceeds the aggregate byte limit")
        handler.append(item)

    executable = handler[0]
    if not os.path.isabs(executable) or os.path.normpath(executable) != executable:
        raise ToolError("open_uri_handler executable must be one canonical absolute path")
    try:
        resolved = os.path.realpath(executable, strict=True)
        metadata = os.stat(resolved, follow_symlinks=False)
    except (OSError, RuntimeError) as error:
        raise ToolError("open_uri_handler executable is unavailable") from error
    if not resolved.startswith("/nix/store/"):
        raise ToolError("open_uri_handler executable must resolve inside the immutable Nix store")
    if not stat.S_ISREG(metadata.st_mode) or not os.access(resolved, os.X_OK):
        raise ToolError("open_uri_handler executable is not an executable regular file")
    if denied_external_handler_executable(resolved):
        raise ToolError("open_uri_handler may not be an ambient dispatcher or programmable interpreter")
    handler[0] = resolved

    raw_schemes = ["http", "https"] if schemes_value is None else schemes_value
    if (
        not isinstance(raw_schemes, list)
        or not raw_schemes
        or len(raw_schemes) > MAX_OPEN_URI_SCHEMES
    ):
        raise ToolError("open_uri_schemes must be a bounded non-empty array")
    schemes: list[str] = []
    for index, value in enumerate(raw_schemes):
        scheme = as_string(
            value,
            f"open_uri_schemes[{index}]",
            maximum=MAX_OPEN_URI_SCHEME_BYTES,
            allow_empty=False,
        ).casefold()
        if URI_SCHEME_RE.fullmatch(scheme) is None:
            raise ToolError(f"open_uri_schemes[{index}] is invalid")
        if scheme in DENIED_OPEN_URI_SCHEMES:
            raise ToolError(f"open_uri_schemes permanently denies {scheme}")
        if scheme in schemes:
            raise ToolError(f"open_uri_schemes[{index}] duplicates {scheme}")
        schemes.append(scheme)
    schemes.sort()

    value = {
        "schema": OPEN_URI_POLICY_SCHEMA,
        "handler": handler,
        "schemes": schemes,
    }
    canonical = canonical_json(value)
    if len(canonical) > MAX_OPEN_URI_POLICY_BYTES:
        raise ToolError("OpenURI policy exceeds its byte limit")
    transport = base64.urlsafe_b64encode(canonical).decode("ascii").rstrip("=")
    handler_digest = hashlib.sha256(canonical_json(handler)).hexdigest()
    policy_digest = hashlib.sha256(canonical).hexdigest()
    return tuple(schemes), transport, handler_digest, policy_digest


def normalize_open_file_policy(
    handler_value: Any,
    access_value: Any = None,
    readonly_maximum_bytes_value: Any = None,
) -> tuple[str, int, str, str, str]:
    """Seal one immutable Nix-store descriptor handler and exact access ceiling."""
    if (
        not isinstance(handler_value, list)
        or not handler_value
        or len(handler_value) > MAX_OPEN_URI_HANDLER_ARGS
    ):
        raise ToolError("open_file_handler must be a bounded non-empty argv array")
    handler: list[str] = []
    aggregate = 0
    for index, value in enumerate(handler_value):
        item = as_string(
            value,
            f"open_file_handler[{index}]",
            maximum=MAX_OPEN_URI_HANDLER_ARG_BYTES,
            allow_empty=False,
        )
        if any(ord(character) < 0x20 or ord(character) == 0x7F for character in item):
            raise ToolError(f"open_file_handler[{index}] contains control characters")
        aggregate += len(item.encode("utf-8")) + 1
        if aggregate > MAX_OPEN_URI_HANDLER_BYTES:
            raise ToolError("open_file_handler exceeds the aggregate byte limit")
        handler.append(item)

    executable = handler[0]
    if not os.path.isabs(executable) or os.path.normpath(executable) != executable:
        raise ToolError("open_file_handler executable must be one canonical absolute path")
    try:
        resolved = os.path.realpath(executable, strict=True)
        metadata = os.stat(resolved, follow_symlinks=False)
    except (OSError, RuntimeError) as error:
        raise ToolError("open_file_handler executable is unavailable") from error
    if not resolved.startswith("/nix/store/"):
        raise ToolError("open_file_handler executable must resolve inside the immutable Nix store")
    if not stat.S_ISREG(metadata.st_mode) or not os.access(resolved, os.X_OK):
        raise ToolError("open_file_handler executable is not an executable regular file")
    if denied_external_handler_executable(resolved):
        raise ToolError("open_file_handler may not be an ambient dispatcher or programmable interpreter")
    handler[0] = resolved

    access = "readonly" if access_value is None else access_value
    if access not in {"readonly", "readwrite"}:
        raise ToolError("open_file_access must be readonly or readwrite")
    readonly_maximum_bytes = (
        DEFAULT_OPEN_FILE_SNAPSHOT_BYTES
        if readonly_maximum_bytes_value is None
        else readonly_maximum_bytes_value
    )
    if (
        not isinstance(readonly_maximum_bytes, int)
        or isinstance(readonly_maximum_bytes, bool)
        or not 1 <= readonly_maximum_bytes <= MAX_OPEN_FILE_SNAPSHOT_BYTES
    ):
        raise ToolError(
            f"open_file_readonly_maximum_bytes must be from 1 through {MAX_OPEN_FILE_SNAPSHOT_BYTES}"
        )
    value = {
        "schema": OPEN_FILE_POLICY_SCHEMA,
        "handler": handler,
        "access": access,
        "kinds": ["regular"],
        "readonly_transfer": "sealed-memfd-snapshot",
        "readonly_maximum_bytes": readonly_maximum_bytes,
    }
    canonical = canonical_json(value)
    if len(canonical) > MAX_OPEN_FILE_POLICY_BYTES:
        raise ToolError("OpenFile policy exceeds its byte limit")
    transport = base64.urlsafe_b64encode(canonical).decode("ascii").rstrip("=")
    handler_digest = hashlib.sha256(canonical_json(handler)).hexdigest()
    policy_digest = hashlib.sha256(canonical).hexdigest()
    return access, readonly_maximum_bytes, transport, handler_digest, policy_digest


