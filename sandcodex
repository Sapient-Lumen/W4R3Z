sc_start_log() {
  local day
  day="$(date -u +%Y-%m-%d)"
  SC_RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$-$(printf '%06x' "$(( RANDOM * RANDOM % 16777216 ))")"
  SC_PROVIDER_REQUEST_SCOPE="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$SC_PROVIDER_REQUEST_SCOPE" =~ ^[0-9a-f]{32}$ ]] || sc_die "could not generate provider request scope" 70
  SC_PROCESS_START="$(sc_process_start "$$")" || sc_die "could not identify launcher process"
  sc_ensure_dir "$SC_GLOBAL/logs/$day" "daily launcher logs"
  SC_LOG="$SC_GLOBAL/logs/$day/$SC_RUN_ID.log"; SC_EVENTS="$SC_GLOBAL/logs/$day/$SC_RUN_ID.jsonl"
  : >"$SC_LOG"; : >"$SC_EVENTS"; chmod 600 "$SC_LOG" "$SC_EVENTS"
  printf '%s\n' "$SC_LOG" | sc_atomic "$SC_GLOBAL/latest-log" 600
  sc_log_event info start "Sandcodex invocation" "version=$SC_VERSION" "artifact_sha256=$(sc_artifact_sha256)" "operation=$SC_COMMAND" "project=$SC_PROJECT" "project_key=$SC_PROJECT_KEY" "pid=$$"
}

sc_auth_path() { printf '%s/auth.json\n' "$SC_GLOBAL/auth-home"; }

sc_auth_logout_marker() { printf '%s/auto-import-disabled\n' "$SC_GLOBAL/auth-home"; }

sc_auth_auto_import_disabled() {
  local marker
  marker="$(sc_auth_logout_marker)"
  [[ -e "$marker" || -L "$marker" ]] || return 1
  sc_owned_single_file "$marker" 600 "authentication logout marker"
  [[ "$(sc_marker "$marker" schema)" == sandcodex.auth-logout.v1 &&
    "$(sc_marker "$marker" uid)" == "$(id -u)" ]] || \
    sc_die "authentication logout marker is invalid"
}

sc_mark_auth_logged_out() {
  local marker
  marker="$(sc_auth_logout_marker)"
  sc_atomic "$marker" 600 <<EOF
schema=sandcodex.auth-logout.v1
uid=$(id -u)
EOF
}

sc_mark_auth_active() {
  local marker
  marker="$(sc_auth_logout_marker)"
  if [[ -e "$marker" || -L "$marker" ]]; then
    sc_owned_single_file "$marker" 600 "authentication logout marker"
    rm -f -- "$marker"
  fi
}

sc_global_auth_codex() {
  (
    cd -- "$SC_GLOBAL/login-home"
    # The provider may itself be a script interpreter. Never let it inherit
    # Bash's lazily-read launcher descriptor (normally fd 255), or any other
    # frontend descriptor whose shared open-file description could be sought,
    # reused, or retained beyond authentication.
    sc_close_inherited_fds
    exec env CODEX_HOME="$SC_GLOBAL/auth-home" HOME="$SC_GLOBAL/login-home" \
      XDG_CACHE_HOME="$SC_GLOBAL/cache" "$SC_CODEX" "$@"
  )
}

sc_valid_auth() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  [[ "$(stat -c %u -- "$path")" == "$(id -u)" && "$(stat -c %a -- "$path")" == 600 && \
    "$(stat -c %h -- "$path")" == 1 && "$(stat -c %s -- "$path")" -le "$SC_AUTH_MAX_BYTES" ]] || return 1
  jq -e 'type == "object" and length > 0' "$path" >/dev/null 2>&1
}

sc_import_auth() {
  local source="$1" target tmp backup=""
  sc_no_line_breaks "$source" "auth source path"
  [[ ! -L "$source" ]] || sc_die "auth source must be a non-symlink regular file"
  source="$(realpath -- "$source" 2>/dev/null || true)"
  [[ -z "$source" ]] || sc_no_line_breaks "$source" "canonical auth source path"
  [[ -n "$source" ]] || sc_die "auth source must be a non-symlink regular file"
  sc_owned_single_file "$source" "" "auth source"
  [[ "$(stat -c %s -- "$source")" -le "$SC_AUTH_MAX_BYTES" ]] || \
    sc_die "auth source exceeds the $SC_AUTH_MAX_BYTES-byte limit: $source"
  jq -e 'type == "object" and length > 0' "$source" >/dev/null 2>&1 || sc_die "auth source is not a non-empty JSON object"
  sc_clear_account_caches
  target="$(sc_auth_path)"
  if sc_valid_auth "$target"; then
    backup="$(mktemp "$SC_GLOBAL/auth-home/.auth.previous.XXXXXX")"
    cp -- "$target" "$backup"; chmod 600 "$backup"
  fi
  tmp="$(mktemp "$SC_GLOBAL/auth-home/.auth.import.XXXXXX")"
  if ! cp -- "$source" "$tmp"; then
    rm -f -- "$tmp"
    [[ -z "$backup" ]] || rm -f -- "$backup"
    sc_die "could not stage the imported credential cache"
  fi
  chmod 600 "$tmp"
  if ! sc_valid_auth "$tmp"; then
    rm -f -- "$tmp"
    [[ -z "$backup" ]] || rm -f -- "$backup"
    sc_die "staged credential cache failed its ownership, link, mode, size, or JSON check"
  fi
  mv -fT -- "$tmp" "$target"
  if ! sc_global_auth_codex login status >/dev/null 2>&1; then
    rm -f -- "$target"
    if [[ -n "$backup" ]]; then mv -fT -- "$backup" "$target"; fi
    sc_die "Codex rejected the imported credential cache"
  fi
  [[ -z "$backup" ]] || rm -f -- "$backup"
  sc_clear_account_caches
  sc_mark_auth_active
  sc_log_event info auth_import "authentication imported" "source=$source" "target=$target"
  sc_ok "authentication imported into trusted Sandcodex state"
}

sc_frontend_requires_openai_auth() {
  [[ "$SC_PROVIDER_MODE" != remote && "$SC_PROVIDER_MODE" != gemini ]] &&
