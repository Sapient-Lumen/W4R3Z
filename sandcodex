    def __init__(self, socket_path: Path, controller: DesktopController) -> None:
        self.socket_path = socket_path
        self.controller = controller
        self.listener: socket.socket | None = None
        self.stop = threading.Event()
        self.clients: set[threading.Thread] = set()
        self.connections: set[socket.socket] = set()
        self.client_lock = threading.Lock()

    def start(self) -> None:
        if self.socket_path.exists() or self.socket_path.is_symlink():
            info = self.socket_path.lstat()
            if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
                raise RuntimeError("desktop MCP socket path is unsafe")
            self.socket_path.unlink()
        temporary = self.socket_path.with_name(f".{self.socket_path.name}.{os.getpid()}.{secrets.token_hex(8)}.sock")
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            listener.bind(os.fspath(temporary))
            os.chmod(temporary, 0o600)
            listener.listen(16)
            listener.settimeout(0.25)
            os.replace(temporary, self.socket_path)
        except Exception:
            listener.close()
            with contextlib.suppress(FileNotFoundError):
                temporary.unlink()
            raise
        self.listener = listener
        self.controller.started_at = utc_now()
        self.controller.socket_path = str(self.socket_path)
        self.controller.write_status("ready")
        while not self.stop.is_set():
            try:
                connection, _ = listener.accept()
            except socket.timeout:
                continue
            except OSError:
                if self.stop.is_set():
                    break
                raise
            with self.client_lock:
                if len(self.clients) >= MAX_CLIENTS:
                    connection.close()
                    continue
                thread = threading.Thread(target=self._client, args=(connection,), daemon=True)
                self.clients.add(thread)
                self.connections.add(connection)
            thread.start()

    def shutdown(self) -> None:
        if self.stop.is_set():
            return
        self.stop.set()
        if self.listener is not None:
            with contextlib.suppress(OSError):
                self.listener.close()
        with self.client_lock:
            connections = list(self.connections)
        for connection in connections:
            with contextlib.suppress(OSError):
                connection.shutdown(socket.SHUT_RDWR)
            with contextlib.suppress(OSError):
                connection.close()
        self.controller.write_status("stopping")

    def close(self) -> None:
        self.shutdown()
        with self.client_lock:
            clients = list(self.clients)
        for thread in clients:
            thread.join(timeout=1)
        self.controller.close()
        with contextlib.suppress(FileNotFoundError):
            self.socket_path.unlink()
        self.controller.socket_path = None
        self.controller.write_status("stopped")

    def _send(self, stream: Any, value: dict[str, Any]) -> None:
        payload = json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode("utf-8") + b"\n"
        offset = 0
        while offset < len(payload):
            written = stream.write(payload[offset:])
            if written is None or written <= 0:
                raise BrokenPipeError("desktop MCP returned a short socket write")
            offset += written
        stream.flush()

