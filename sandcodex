+			sandcodex_double_bits(actual_x) != expected_x_bits ||
+			sandcodex_double_bits(actual_y) != expected_y_bits) {
+		return false;
+	}
+	if (actual_x_out) {
+		*actual_x_out = actual_x;
+	}
+	if (actual_y_out) {
+		*actual_y_out = actual_y;
+	}
+	return true;
+}
