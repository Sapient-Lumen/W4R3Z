+            distance_start_65535, distance_end_65535, wheel_present,
+            wheel_delta_degrees_256, wheel_clicks, wheel_step) ||
+            !client || !seat || !expected_surface || !expected_surface->resource ||
+            !expected_target_client || !tool ||
+            !sandcodex_stylus.tool.distance || !sandcodex_stylus.tool.wheel ||
