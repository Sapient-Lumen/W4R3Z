def proc_identity(pid: int) -> dict[str, Any] | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except (FileNotFoundError, ProcessLookupError, PermissionError, OSError):
        return None
    marker = raw.rfind(") ")
    if marker < 0:
        return None
    head = raw[: marker + 1]
    tail = raw[marker + 2 :].split()
    if len(tail) < 20:
        return None
    try:
        return {
            "pid": int(head.split("(", 1)[0].strip()),
            "state": tail[0],
            "ppid": int(tail[1]),
            "pgrp": int(tail[2]),
            "session": int(tail[3]),
            "start_ticks": int(tail[19]),
        }
    except (ValueError, IndexError):
        return None


def exact_process_alive(pid: int, start_ticks: int) -> bool:
    identity = proc_identity(pid)
    return identity is not None and identity["start_ticks"] == start_ticks and identity["state"] != "Z"


def signal_exact_process(pid: int, start_ticks: int, sig: signal.Signals) -> bool:
    if not exact_process_alive(pid, start_ticks):
        return False
    opener = getattr(os, "pidfd_open", None)
    sender = getattr(signal, "pidfd_send_signal", None)
    if callable(opener) and callable(sender):
        try:
            descriptor = opener(pid, 0)
        except (ProcessLookupError, PermissionError, OSError):
            return False
        try:
            if not exact_process_alive(pid, start_ticks):
                return False
            sender(descriptor, sig)
            return True
        except (ProcessLookupError, PermissionError, OSError):
            return False
        finally:
            os.close(descriptor)
    if not exact_process_alive(pid, start_ticks):
        return False
    try:
        os.kill(pid, sig)
        return True
    except (ProcessLookupError, PermissionError):
        return False

