+static bool sandcodex_keyboard_modifiers_valid(
+		struct sway_seat_device *device, uint32_t modifiers, bool nonzero) {
+	struct sway_keyboard *keyboard = device ? device->keyboard : NULL;
+	struct wlr_keyboard *wlr = keyboard ? keyboard->wlr : NULL;
+	if (!wlr || !wlr->keymap || (nonzero && modifiers == 0)) {
+		return false;
+	}
+	const char *names[] = {"Shift", "Control", "Mod1", "Mod4", "Mod5"};
+	xkb_mod_mask_t allowed = 0;
+	for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); ++i) {
+		xkb_mod_mask_t mask = xkb_keymap_mod_get_mask(wlr->keymap, names[i]);
+		if (mask == 0 || (allowed & mask) != 0) {
+			return false;
+		}
+		allowed |= mask;
+	}
+	return (modifiers & ~allowed) == 0;
+}
+
+static bool sandcodex_keyboard_plan_valid(struct sway_seat_device *device,
+		uint32_t keycode, uint32_t modifiers) {
+	struct sway_keyboard *keyboard = device ? device->keyboard : NULL;
+	struct wlr_keyboard *wlr = keyboard ? keyboard->wlr : NULL;
+	return wlr && wlr->keymap && keycode != 0 &&
+		keycode <= SANDCODEX_KEYBOARD_MAX_KEYCODE &&
+		xkb_keymap_key_get_name(wlr->keymap, (xkb_keycode_t)keycode + 8) &&
+		sandcodex_keyboard_modifiers_valid(device, modifiers, false);
+}
+
+static bool sandcodex_dispatch_keyboard_unit(struct sway_seat *seat,
+		struct sway_seat_device *device, struct wlr_surface *expected_surface,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_focused_client_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		uint32_t keycode, uint32_t modifiers) {
+	if (!seat || !seat->wlr_seat || !device || !expected_surface ||
+			seat->focused_layer || seat->has_exclusive_layer ||
+			server.session_lock.lock || !sandcodex_input_method_grab_absent(seat) ||
+			!sandcodex_keyboard_default_route(seat, expected_grab_address,
+				expected_default_grab_address, expected_focused_client_address) ||
+			!sandcodex_keyboard_recipient_exact(
+				seat->wlr_seat->keyboard_state.focused_client,
+				expected_resource_address, expected_resource_id, NULL, NULL) ||
+			seat->wlr_seat->keyboard_state.focused_surface != expected_surface ||
+			!sandcodex_keyboard_released(seat, device) ||
+			!sandcodex_keyboard_plan_valid(device, keycode, modifiers)) {
+		return false;
+	}
+	struct wlr_keyboard *wlr = device->keyboard->wlr;
+	if (wlr_seat_get_keyboard(seat->wlr_seat) != wlr) {
+		return false;
+	}
+	struct wlr_keyboard_modifiers pressed = {
+		.depressed = modifiers,
+		.latched = 0,
+		.locked = 0,
+		.group = 0,
+	};
+	struct wlr_keyboard_modifiers cleared = {0};
+	if (wlr_seat_get_keyboard(seat->wlr_seat) != wlr ||
+			seat->wlr_seat->keyboard_state.focused_surface != expected_surface ||
+			!sandcodex_input_method_grab_absent(seat) ||
+			!sandcodex_keyboard_default_route(seat, expected_grab_address,
+				expected_default_grab_address, expected_focused_client_address) ||
+			!sandcodex_keyboard_recipient_exact(
+				seat->wlr_seat->keyboard_state.focused_client,
+				expected_resource_address, expected_resource_id, NULL, NULL)) {
+		return false;
+	}
+
+	uint32_t time_msec = get_current_time_in_msec();
+	/* Route directly to the exact focused wl_keyboard client. This deliberately
+	 * bypasses Sway bindings and refuses any input-method grab. The complete
+	 * modifier/key unit is queued before returning to the Wayland event loop. */
+	wlr_seat_keyboard_notify_modifiers(seat->wlr_seat, &pressed);
+	wlr_seat_keyboard_notify_key(seat->wlr_seat, time_msec, keycode,
+		WL_KEYBOARD_KEY_STATE_PRESSED);
+	wlr_seat_keyboard_notify_key(seat->wlr_seat, time_msec, keycode,
+		WL_KEYBOARD_KEY_STATE_RELEASED);
+	wlr_seat_keyboard_notify_modifiers(seat->wlr_seat, &cleared);
+	return seat->wlr_seat->keyboard_state.focused_surface == expected_surface &&
+		wlr_seat_get_keyboard(seat->wlr_seat) == wlr &&
+		sandcodex_input_method_grab_absent(seat) &&
+		sandcodex_keyboard_default_route(seat, expected_grab_address,
+			expected_default_grab_address, expected_focused_client_address) &&
+		sandcodex_keyboard_recipient_exact(
+			seat->wlr_seat->keyboard_state.focused_client,
+			expected_resource_address, expected_resource_id, NULL, NULL) &&
+		sandcodex_keyboard_released(seat, device);
+}
