      (.parent.process_start|type)=="string" and (.parent.process_start|test("^[1-9][0-9]*$")) and
      .provider.name=="ollama" and (.provider.endpoint|type)=="string" and
      (.provider.pid|type)=="number" and (.provider.process_start|type)=="string" and
      (.provider.process_start|test("^[1-9][0-9]*$")) and
      (.model.requested|type)=="string" and (.model.runtime|type)=="string" and
      (.model.digest_sha256|test("^[0-9a-f]{64}$")) and
      (.model.context_tokens|type)=="number" and
      (.runtime.backend=="cpu" or .runtime.backend=="cuda") and
      (.runtime.startup_receipt|type)=="string" and
      (.runtime.startup_receipt_sha256|test("^[0-9a-f]{64}$")) and
      (.runtime.qualification_receipt|type)=="string" and
      (.runtime.qualification_receipt_sha256|test("^[0-9a-f]{64}$")) and
      .sharing.provider_generation_parallelism==1
    ' "$contract" >/dev/null || sc_die "parent local-provider contract is malformed" 78
  [[ "$(jq -er '.artifact_sha256' "$contract")" == "$(sc_artifact_sha256)" ]] ||
    sc_die "parent local-provider contract names different launcher bytes" 78
  local parent_pid parent_start provider_pid provider_start requested runtime digest context backend threads endpoint
  local startup startup_sha qualification qualification_sha binary binary_sha provider_version available_mib memory_max
  local run_dir model_pin_file inventory_file load_file final_file runtime_file
  parent_pid=$(jq -er '.parent.pid' "$contract"); parent_start=$(jq -er '.parent.process_start' "$contract")
  provider_pid=$(jq -er '.provider.pid' "$contract"); provider_start=$(jq -er '.provider.process_start' "$contract")
  sc_pid_still_matches "$parent_pid" "$parent_start" || sc_die "parent command room no longer owns the local-provider capability" 77
  sc_pid_still_matches "$provider_pid" "$provider_start" || sc_die "delegated local-provider process is no longer live" 78
  requested=$(jq -er '.model.requested' "$contract"); runtime=$(jq -er '.model.runtime' "$contract")
  [[ "$(sc_family_canonical_model_name "$SC_LOCAL_REQUESTED_MODEL")" == "$(sc_family_canonical_model_name "$requested")" ]] ||
    sc_die "companion requested a model different from its parent provider capability" 64
  digest=$(jq -er '.model.digest_sha256' "$contract"); context=$(jq -er '.model.context_tokens' "$contract")
  backend=$(jq -er '.runtime.backend' "$contract"); threads=$(jq -r '.model.num_thread // empty' "$contract")
  endpoint=$(jq -er '.provider.endpoint' "$contract")
  startup=$(jq -er '.runtime.startup_receipt' "$contract"); startup_sha=$(jq -er '.runtime.startup_receipt_sha256' "$contract")
  qualification=$(jq -er '.runtime.qualification_receipt' "$contract"); qualification_sha=$(jq -er '.runtime.qualification_receipt_sha256' "$contract")
  for source in "$startup" "$qualification"; do
    [[ "$source" == /* ]] || sc_die "parent local-provider evidence path is not absolute" 78
    sc_no_symlink_components "$source" "parent local-provider evidence"
    sc_owned_single_file "$source" 600 "parent local-provider evidence"
  done
  [[ "$(sha256sum -- "$startup" | awk '{print $1}')" == "$startup_sha" &&
      "$(sha256sum -- "$qualification" | awk '{print $1}')" == "$qualification_sha" ]] ||
    sc_die "parent local-provider evidence bytes changed" 78
  jq -e --arg requested "$requested" --arg runtime "$runtime" --arg digest "$digest" \
    --arg backend "$backend" --argjson context "$context" --arg threads "$threads" '
      .schema=="sandcodex.managed-local-startup.v1" and .result=="startup_checks_passed" and
      .requested_model==$requested and .runtime_model==$runtime and
      .verification.model.digest_sha256==$digest and
      .runtime_provenance.backend==$backend and
      .runtime_provenance.context_tokens==$context and
      (.runtime_provenance.server_policy.num_parallel==1) and
      (if $threads=="" then .model_pin.runtime_parameters.num_thread==null
       else .model_pin.runtime_parameters.num_thread==($threads|tonumber) end)
    ' "$startup" >/dev/null || sc_die "parent local-provider startup evidence conflicts with its capability" 78

  SC_LOCAL_REQUESTED_MODEL=$requested
  SC_MODEL=$runtime; SC_MODEL_SET=1
  SC_LOCAL_MODEL_PIN_ALIAS=$runtime
  SC_LOCAL_MODEL_DIGEST=$digest; SC_LOCAL_MODEL_DIGEST_EXPLICIT=1
  SC_LOCAL_CONTEXT_TOKENS=$context; SC_LOCAL_CONTEXT_EXPLICIT=1
  SC_LOCAL_THREADS=$threads; [[ -z "$threads" ]] || SC_LOCAL_THREADS_EXPLICIT=1
  SC_LOCAL_BACKEND=$backend; SC_LOCAL_BACKEND_EXPLICIT=1
  SC_LOCAL_PROVIDER_ENDPOINT=$endpoint; SC_LOCAL_PROVIDER_SOURCE=campaign-parent
  SC_LOCAL_PULL=0
  SC_LOCAL_QUALIFICATION=""
  # Validate the inherited endpoint and all normalized model/runtime fields
  # before making the first request through the delegated capability.
  sc_local_provider_validate
  available_mib=$(sc_local_startup_available_mib)
  [[ "$available_mib" =~ ^[0-9]+$ && "$available_mib" -ge 2048 ]] ||
    sc_die "less than 2 GiB host memory available for a local companion" 69
  memory_max=$(sc_local_memory_budget_mib "$available_mib")
  SC_LOCAL_MEMORY_MAX_BYTES=$(( memory_max * 1024 * 1024 ))
  sc_ensure_dir "$SC_CONTROL/local-startup" "local startup evidence"
  run_dir=$(mktemp -d "$SC_CONTROL/local-startup/inherited.XXXXXXXXXXXX"); chmod 700 "$run_dir"
  SC_LOCAL_STARTUP_DIRECTORY=$run_dir
  sc_emit_local_preflight | sc_atomic "$SC_CONTROL/local-preflight.py" 700
  model_pin_file="$run_dir/model-pin.json"
  jq -e '.model_pin' "$startup" | sc_atomic "$model_pin_file" 600 ||
    sc_die "parent local-provider model pin is invalid" 78
  cp -- "$qualification" "$run_dir/qualification.json"; chmod 600 "$run_dir/qualification.json"
  SC_LOCAL_QUALIFICATION="$run_dir/qualification.json"
  SC_LOCAL_QUALIFICATION_SHA256="$(sha256sum -- "$SC_LOCAL_QUALIFICATION" | awk '{print $1}')"
  sc_local_provider_validate
  SCL_BACKEND=$backend
  SCL_PROVIDER_NIXPKGS_REV=$(jq -er '.runtime_provenance.provider_nixpkgs_rev' "$startup")
  binary=$(jq -er '.runtime_provenance.executable' "$startup")
  binary_sha=$(jq -er '.runtime_provenance.executable_sha256' "$startup")
  provider_version=$(jq -er '.runtime_provenance.provider_version' "$startup")
  [[ -x "$binary" && "$(sha256sum -- "$binary" | awk '{print $1}')" == "$binary_sha" ]] ||
    sc_die "delegated local-provider runtime executable is missing or changed" 78
  export SANDCODEX_LOCAL_CONTEXT_LENGTH="$SC_LOCAL_CONTEXT_TOKENS"
  runtime_file="$run_dir/runtime.json"
  sc_local_runtime_record "$binary" "$binary_sha" "$backend" "$context" "$provider_version" "$runtime_file"
  inventory_file="$run_dir/inventory.json"
  sc_local_startup_check inventory "$inventory_file" ||
    sc_die "delegated local-provider inventory verification failed" 78
  [[ "$(jq -er '.model.digest_sha256' "$inventory_file")" == "$digest" ]] ||
    sc_die "delegated local-provider model identity changed" 78
  load_file="$run_dir/load.json"
  sc_local_startup_check load "$load_file" || sc_die "delegated local-provider load check failed" 78
  final_file="$run_dir/verified.json"
  sc_local_startup_check verify "$final_file" || sc_die "delegated local-provider final verification failed" 78
  jq -n --arg schema sandcodex.managed-local-startup.v1 --arg requested_model "$requested" \
    --arg runtime_model "$runtime" --arg requested_backend "$backend" \
    --arg qualification_sha256 "$SC_LOCAL_QUALIFICATION_SHA256" \
    --arg parent_contract_sha256 "$expected_contract" --arg parent_run_id "$(jq -er '.parent.run_id' "$contract")" \
    --argjson memory_explicit "$SC_LOCAL_MEMORY_EXPLICIT" --argjson available_mib "$available_mib" \
    --argjson memory_max_mib "$memory_max" --argjson memory_max_bytes "$SC_LOCAL_MEMORY_MAX_BYTES" \
    --slurpfile verified "$final_file" --slurpfile runtime "$runtime_file" --slurpfile model_pin "$model_pin_file" '
      {schema:$schema,result:"startup_checks_passed",requested_model:$requested_model,
       runtime_model:$runtime_model,requested_backend:$requested_backend,cpu_retry_used:false,attempts:1,
       qualification_sha256:$qualification_sha256,verification:$verified[0],runtime_provenance:$runtime[0],
       memory_budget:{policy:(if $memory_explicit == 1 then "operator-explicit-mib" else "half-memavailable" end),
         host_memavailable_mib:$available_mib,memory_max_mib:$memory_max_mib,
         memory_max_bytes:$memory_max_bytes},
       model_pin:$model_pin[0],native_session_binding:false,binding_commit_pending:true,
       resume_binding_sha256:null,full_codex_turn_tested:false,
       inherited_provider:{parent_run_id:$parent_run_id,contract_sha256:$parent_contract_sha256,
                           process_identity_verified:true}}' |
    sc_atomic "$run_dir/launch.json" 600
  SC_LOCAL_STARTUP_RECEIPT="$run_dir/launch.json"
  sc_note "local companion · shared parent provider · serialized generation · digest $digest"
  return 0
}

sc_family_prepare_local() {
  if [[ -n "${SANDCODEX_LOCAL_PARENT_CONTRACT:-}" ]]; then
    sc_family_prepare_inherited_local
    return
  fi
  [[ -z "$SC_LOCAL_QUALIFICATION" ]] || sc_die "managed local startup creates its own qualification receipt" 64
  command -v timeout >/dev/null || sc_die "managed local startup requires timeout for bounded checks" 69
  local library="$SC_CONTROL/local-runtime-library.sh" ollama available_mib memory_max memory_high port provider_version
  local requested_model=${SC_LOCAL_REQUESTED_MODEL:-$SC_MODEL} requested_backend=$SC_LOCAL_BACKEND attempt=1 rc=0 run_dir inventory_file load_file
  local fallback_used=false user_require_gpu=${SANDCODEX_LOCAL_REQUIRE_GPU:-0} qualifier_file final_file binary_digest binary_path
  local resume_bound=false binding_pending=true model_pin_file pinned_inventory source_model source_digest pin_policy
  (( SC_LOCAL_RESUME_BOUND )) && resume_bound=true
  (( SC_LOCAL_RESUME_BOUND )) && binding_pending=false
  SC_LOCAL_REQUESTED_MODEL=$requested_model
  sc_emit_local_library | sc_atomic "$library" 600
  sc_emit_nvidia_helper | sc_atomic "$SC_CONTROL/sandcodex-local-nvidia.py" 700
  sc_emit_local_preflight | sc_atomic "$SC_CONTROL/local-preflight.py" 700
  sc_emit_local_qualifier | sc_atomic "$SC_CONTROL/local-qualify.py" 700
  sc_emit_local_model_pin | sc_atomic "$SC_CONTROL/local-model-pin.py" 700
  # Generated immediately above from the embedded, quoted helper body.
  # shellcheck source=/dev/null
  source "$library"
  # These values are consumed by functions defined in that generated helper.
  # shellcheck disable=SC2034
  SCL_PYTHON=$(command -v python3)
  SCL_BACKEND=$(scl_select_backend "$SC_LOCAL_BACKEND")
  sc_local_runtime_channel_apply "$SCL_BACKEND"
  scl_state_init
  # shellcheck disable=SC2034
  SCL_REUSE_SERVER=0
  # shellcheck disable=SC2034
  SCL_KEEP_SERVER=0
  [[ "$SC_MODEL" != *-cloud* ]] || sc_die "cloud model tags cannot be local inference" 64
  [[ "$user_require_gpu" == 0 || "$user_require_gpu" == 1 ]] || sc_die "SANDCODEX_LOCAL_REQUIRE_GPU must be 0 or 1" 64
  [[ "$SCL_BACKEND" != cpu || "$user_require_gpu" != 1 ]] || sc_die "GPU was required but the selected backend is CPU" 69
  if [[ -z "$SC_LOCAL_CONTEXT_TOKENS" ]]; then
    if [[ "$SCL_BACKEND" == cpu ]]; then SC_LOCAL_CONTEXT_TOKENS=8192; else SC_LOCAL_CONTEXT_TOKENS=32768; fi
  fi
  export SANDCODEX_LOCAL_CONTEXT_LENGTH="$SC_LOCAL_CONTEXT_TOKENS"
  # These are launcher policy, not ambient tuning knobs. They are exported only
  # for the quoted embedded runtime library and overwrite inherited values.
  export SANDCODEX_LOCAL_KEEP_ALIVE="$SC_LOCAL_KEEP_ALIVE"
  export SANDCODEX_LOCAL_MAX_LOADED_MODELS="$SC_LOCAL_MAX_LOADED_MODELS"
  export SANDCODEX_LOCAL_NUM_PARALLEL="$SC_LOCAL_NUM_PARALLEL"
  export SANDCODEX_LOCAL_MAX_QUEUE="$SC_LOCAL_MAX_QUEUE"
  export SANDCODEX_LOCAL_FLASH_ATTENTION="$SC_LOCAL_FLASH_ATTENTION"
  export SANDCODEX_LOCAL_KV_CACHE_TYPE="$SC_LOCAL_KV_CACHE_TYPE"
  available_mib=$(sc_local_startup_available_mib)
  memory_max=$(sc_local_memory_budget_mib "$available_mib")
  memory_high=$(( memory_max * 4 / 5 ))
  SC_LOCAL_MEMORY_MAX_BYTES=$(( memory_max * 1024 * 1024 ))
  sc_ensure_dir "$SC_CONTROL/local-startup" "local startup evidence"
  run_dir=$(mktemp -d "$SC_CONTROL/local-startup/launch.XXXXXXXXXXXX")
  chmod 700 "$run_dir"
  SC_LOCAL_STARTUP_DIRECTORY=$run_dir
  model_pin_file="$run_dir/model-pin.json"
  if (( SC_LOCAL_RESUME_BOUND )); then
    jq -e '.local.model_pin | select(
      .policy=="ollama-manifest-alias-v1" or .policy=="ollama-derived-profile-v1")' \
      "$SC_RESUME_BINDING_VERIFIED" |
      sc_atomic "$model_pin_file" 600 || sc_die "bound local model-pin record is missing or invalid" 78
  fi
  sc_note "local · checking model load, context, and Codex protocol · evidence $run_dir"

  while (( attempt <= 2 )); do
    ollama=$(scl_nix_ollama)
    binary_path=$(readlink -f -- "$ollama")
    [[ -f "$binary_path" && -x "$binary_path" ]] || sc_die "realized runtime binary is missing or not executable" 69
    binary_digest=$(sha256sum -- "$binary_path" | awk '{print $1}')
    sc_local_verify_bound_runtime_binary "$binary_path" "$binary_digest"
    # Per-attempt host port; namespace port stays 11434. Still not a privacy or
    # atomic listener-ownership guarantee; the household transport gate remains.
    port=$(python3 -P -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')
    scl_start_ollama "$ollama" "$port" 0 "${memory_high}M" "${memory_max}M" 4096
    if [[ -n "${SCL_STARTED_PID:-}" ]]; then SC_LOCAL_PROCESS_START=$(sc_process_start "$SCL_STARTED_PID"); fi
    SC_LOCAL_PROVIDER_ENDPOINT="http://127.0.0.1:$port"
    SC_LOCAL_PROVIDER_SOURCE=managed
    if (( attempt == 1 )) && ! scl_model_present "$ollama" "$SC_MODEL" "$port"; then
      (( SC_LOCAL_PULL )) || sc_die "local model is absent and --no-pull was selected" 66
      # A resume is not an update: do not fetch whatever a mutable tag now names.
      [[ "$SC_RESUME" == fresh ]] || sc_die "saved local model is absent; resume will not pull a mutable replacement" 66
      sc_note "local · acquiring requested model $SC_MODEL (no automatic model substitution)"
      scl_model_pull "$ollama" "$SC_MODEL" "$port"
    fi
    inventory_file="$run_dir/$attempt-inventory.json"
    sc_local_startup_check inventory "$inventory_file" || sc_die "local inventory/context/memory check failed; no inference fallback" 78
    SC_MODEL=$(jq -er '.model.resolved_name' "$inventory_file"); SC_MODEL_SET=1
    SC_LOCAL_MODEL_DIGEST=$(jq -er '.model.digest_sha256' "$inventory_file")
    provider_version=$(jq -er '.model.provider_version' "$inventory_file")
    sc_local_verify_bound_provider_version "$inventory_file"

    # A fresh launch retains the qualified source manifest under a stable alias,
    # then derives a second digest-checked profile when runtime parameters exist.
    # Bound resumes use that exact result and never pull, recreate, retune,
    # substitute, or reduce context.
    if (( ! SC_LOCAL_RESUME_BOUND )) && [[ -z "$SC_LOCAL_MODEL_PIN_ALIAS" ]]; then
      source_model=$SC_MODEL
      source_digest=$SC_LOCAL_MODEL_DIGEST
      local -a model_pin_args=(
        --endpoint "$SC_LOCAL_PROVIDER_ENDPOINT" --requested-model "$requested_model" \
        --source-model "$source_model" --expected-digest "$source_digest" \
        --provider-version "$provider_version" --model-store "$SCL_OLLAMA_MODELS" \
        --timeout 120 --output "$model_pin_file")
      if [[ -n "$SC_LOCAL_THREADS" ]]; then
        model_pin_args+=(--runtime-threads "$SC_LOCAL_THREADS")
        if [[ "$(sc_family_canonical_model_name "$requested_model")" == \
              "$(sc_family_canonical_model_name "$SC_LOCAL_CPU_REFERENCE_MODEL")" &&
              "$SC_LOCAL_THREADS" == "$SC_LOCAL_CPU_REFERENCE_THREADS" ]]; then
          model_pin_args+=(--expected-runtime-digest "$SC_LOCAL_CPU_REFERENCE_RUNTIME_DIGEST")
        fi
      fi
      timeout --signal=TERM --kill-after=5s 420s python3 -P "$SC_CONTROL/local-model-pin.py" \
        "${model_pin_args[@]}" ||
        sc_die "local model manifest could not be retained under its content-addressed alias" 78
      pin_policy=$(jq -er '.policy' "$model_pin_file")
      if [[ -n "$SC_LOCAL_THREADS" ]]; then
        [[ "$pin_policy" == ollama-derived-profile-v1 ]] ||
          sc_die "local model runtime profile has an invalid retention policy" 78
        [[ "$(jq -er '.source_digest_sha256' "$model_pin_file")" == "$source_digest" ]] ||
          sc_die "local model runtime profile names different source bytes" 78
        SC_LOCAL_MODEL_DIGEST=$(jq -er '.runtime_digest_sha256' "$model_pin_file")
      else
        [[ "$pin_policy" == ollama-manifest-alias-v1 ]] ||
          sc_die "local model manifest alias has an invalid retention policy" 78
        [[ "$(jq -er '.digest_sha256' "$model_pin_file")" == "$source_digest" ]] ||
          sc_die "local model manifest alias names different source bytes" 78
      fi
      SC_LOCAL_MODEL_PIN_ALIAS=$(jq -er '.runtime_model' "$model_pin_file")
      SC_MODEL=$SC_LOCAL_MODEL_PIN_ALIAS; SC_MODEL_SET=1
      pinned_inventory="$run_dir/$attempt-pinned-inventory.json"
      sc_local_startup_check inventory "$pinned_inventory" ||
        sc_die "content-addressed local model alias failed identity/context verification" 78
      [[ "$(jq -er '.model.digest_sha256' "$pinned_inventory")" == "$SC_LOCAL_MODEL_DIGEST" ]] ||
        sc_die "content-addressed local model alias has different bytes" 78
      provider_version=$(jq -er '.model.provider_version' "$pinned_inventory")
      inventory_file=$pinned_inventory
      if [[ -n "$SC_LOCAL_THREADS" ]]; then
        sc_note "local · retained $requested_model as $SC_MODEL · threads $SC_LOCAL_THREADS"
      else
        sc_note "local · retained $requested_model as $SC_MODEL"
      fi
    elif [[ -n "$SC_LOCAL_MODEL_PIN_ALIAS" ]]; then
      [[ "$SC_MODEL" == "$SC_LOCAL_MODEL_PIN_ALIAS" ]] ||
        sc_die "bound content-addressed local model alias changed" 78
      [[ "$(jq -er '.model.digest_sha256' "$inventory_file")" == "$SC_LOCAL_MODEL_DIGEST" ]] ||
        sc_die "bound content-addressed local model alias has different bytes" 78
    fi

    sc_local_runtime_record "$binary_path" "$binary_digest" "$SCL_BACKEND" "$SC_LOCAL_CONTEXT_TOKENS" \
      "$provider_version" "$run_dir/$attempt-runtime.json"
    # The selected channel GC root is needed only until this project-specific
    # runtime root has been created. Release the shared lease before model load
    # and protocol work so safe pruning is not blocked by the whole conversation.
    sc_local_runtime_release_lease
    load_file="$run_dir/$attempt-load.json"; rc=0
    sc_local_startup_check load "$load_file" || rc=$?
    if (( rc == 0 )); then break; fi
    if (( rc == 75 && attempt == 1 )) && [[ "$requested_backend" == auto && "$SCL_BACKEND" == cuda && "$user_require_gpu" == 0 ]]; then
      sc_note "local · CUDA load unavailable; retrying CPU once with the SAME model digest and context (no cloud fallback)"
      sc_local_startup_stop_for_retry
      sc_local_runtime_channel_clear_applied
      SCL_BACKEND=cpu
      sc_local_runtime_channel_apply "$SCL_BACKEND"
      scl_set_provider_nixpkgs_rev
      fallback_used=true; attempt=2
      continue
    fi
    sc_die "local load check failed; requested backend policy forbids further retries (see $load_file)" "$rc"
  done

  # Protocol failures are never classified as CUDA failures and cannot trigger retry.
  qualifier_file="$run_dir/qualification.json"
  local -a qualify_args=(--provider ollama --endpoint "$SC_LOCAL_PROVIDER_ENDPOINT" --model "$SC_MODEL"
    --expected-digest "$SC_LOCAL_MODEL_DIGEST" --context-tokens "$SC_LOCAL_CONTEXT_TOKENS"
    --profile codex --timeout 120 --output "$qualifier_file")
  [[ "$SCL_BACKEND" != cuda ]] || qualify_args+=(--require-gpu)
  timeout --signal=TERM --kill-after=5s 720s python3 -P "$SC_CONTROL/local-qualify.py" "${qualify_args[@]}" \
    >"$run_dir/qualification.log" 2>&1 || sc_die "local Codex protocol qualification failed; no backend/model substitution (see $run_dir/qualification.log)" 78
  # Responses may reload the model using its Modelfile context; verify again after
  # all probes, not merely after the explicit-num_ctx warm-load request.
  final_file="$run_dir/verified.json"
  sc_local_startup_check verify "$final_file" || sc_die "post-protocol model/context/residency verification failed; no retry" 78
  SC_LOCAL_QUALIFICATION=$qualifier_file
  sc_local_provider_validate
  [[ -e "$model_pin_file" ]] || sc_die "managed local startup produced no content-addressed model-pin record" 78
  # A successful launch receipt is not a native conversation and never makes a
  # failed Codex launch become the project's latest conversation.
  jq -n --arg schema sandcodex.managed-local-startup.v1 --arg requested_model "$requested_model" \
    --arg runtime_model "$SC_MODEL" --arg requested_backend "$requested_backend" \
    --argjson fallback "$fallback_used" --argjson attempt "$attempt" \
    --arg qualification_sha256 "$SC_LOCAL_QUALIFICATION_SHA256" \
    --arg resume_binding_sha256 "$SC_RESUME_BINDING_SHA256" --argjson resume_bound "$resume_bound" \
    --argjson binding_pending "$binding_pending" --slurpfile verified "$final_file" \
    --argjson memory_explicit "$SC_LOCAL_MEMORY_EXPLICIT" --argjson available_mib "$available_mib" \
    --argjson memory_high_mib "$memory_high" --argjson memory_max_mib "$memory_max" \
    --argjson memory_max_bytes "$SC_LOCAL_MEMORY_MAX_BYTES" \
    --slurpfile runtime "$run_dir/$attempt-runtime.json" --slurpfile model_pin "$model_pin_file" '
      {schema:$schema,result:"startup_checks_passed",requested_model:$requested_model,
       runtime_model:$runtime_model,requested_backend:$requested_backend,cpu_retry_used:$fallback,attempts:$attempt,
       qualification_sha256:$qualification_sha256,verification:$verified[0],runtime_provenance:$runtime[0],
       memory_budget:{policy:(if $memory_explicit == 1 then "operator-explicit-mib" else "half-memavailable" end),
         host_memavailable_mib:$available_mib,memory_high_mib:$memory_high_mib,
         memory_max_mib:$memory_max_mib,memory_max_bytes:$memory_max_bytes},
       model_pin:$model_pin[0],
       native_session_binding:$resume_bound,binding_commit_pending:$binding_pending,
       resume_binding_sha256:(if $resume_binding_sha256=="" then null else $resume_binding_sha256 end),
       full_codex_turn_tested:false}' | sc_atomic "$run_dir/launch.json" 600
  SC_LOCAL_STARTUP_RECEIPT="$run_dir/launch.json"
  if [[ "$SCL_BACKEND" == cpu ]]; then
    sc_note "local · CPU admission $(sc_human_bytes "$(jq -er '.verification.memory_admission.minimum_bytes' "$SC_LOCAL_STARTUP_RECEIPT")") minimum / $(sc_human_bytes "$(jq -er '.verification.memory_admission.budget_bytes' "$SC_LOCAL_STARTUP_RECEIPT")") budget · real bounded load passed"
  fi
  sc_note "local · $(jq -r '.runtime.placement' "$final_file") (provider-reported) · context $SC_LOCAL_CONTEXT_TOKENS · threads ${SC_LOCAL_THREADS:-provider-default} · digest $SC_LOCAL_MODEL_DIGEST"
  if (( SC_LOCAL_RESUME_BOUND )); then
    sc_note "resume · content-addressed model $SC_LOCAL_MODEL_PIN_ALIAS · exact bound backend $SCL_BACKEND"
    sc_note "resume · runtime $(jq -r '.local.runtime.executable_sha256' "$SC_RESUME_BINDING_VERIFIED")"
  fi
}

# Alternate-provider native-session binding. Embedded, not a public CLI.
# The current canonical project directory is the only scope; no machine-global latest pointer exists.

sc_family_install_session_tools() {
  SC_SESSION_SELECTOR_TOOL="$SC_CONTROL/session-selector.py"
  SC_SESSION_PICKER_TOOL="$SC_CONTROL/session-picker.py"
  SC_SESSION_BINDING_TOOL="$SC_CONTROL/session-binding.py"
  sc_emit_session_selector | sc_atomic "$SC_SESSION_SELECTOR_TOOL" 700
  sc_emit_session_picker | sc_atomic "$SC_SESSION_PICKER_TOOL" 700
  sc_emit_session_binding | sc_atomic "$SC_SESSION_BINDING_TOOL" 700
}

sc_family_binding_state_dirs() {
  sc_ensure_dir "$SC_CONTROL/session-bindings" "provider session bindings"
  sc_ensure_dir "$SC_CONTROL/session-binding-retirements" "provider session retirement authorizations"
  sc_ensure_dir "$SC_CONTROL/session-binding-retirement-receipts" "provider session retirement receipts"
  sc_ensure_dir "$SC_CONTROL/session-binding-runs" "provider session binding evidence"
  SC_SESSION_BINDING_DIRECTORY="$SC_CONTROL/session-bindings"
  SC_SESSION_BINDING_RETIREMENT_DIRECTORY="$SC_CONTROL/session-binding-retirements"
  SC_SESSION_BINDING_RETIREMENT_RECEIPT_DIRECTORY="$SC_CONTROL/session-binding-retirement-receipts"
}


sc_family_canonical_model_name() {
  local value=$1 tail=${1##*/}
  if [[ "$tail" == *:* ]]; then printf '%s\n' "$value"; else printf '%s:latest\n' "$value"; fi
}

sc_family_apply_resume_binding() {
  local selected=$1 rc=0 verified mode backend context digest executable pin configured root expected_snapshot
  local pin_policy pin_alias requested bound_requested explicit_requested qualification_path qualification_sha
  local source_digest bound_threads gemini_qualification_revision
  sc_family_install_session_tools
  sc_family_binding_state_dirs
  SC_SESSION_BINDING_RUN_DIRECTORY=$(mktemp -d "$SC_CONTROL/session-binding-runs/resume.XXXXXXXXXXXX")
  chmod 700 "$SC_SESSION_BINDING_RUN_DIRECTORY"
  local selection="$SC_SESSION_BINDING_RUN_DIRECTORY/selection.json"
  SC_RESUME_BINDING_VERIFIED="$SC_SESSION_BINDING_RUN_DIRECTORY/verified.json"
  printf '%s\n' "$selected" | sc_atomic "$selection" 600
  verified=$(python3 -P "$SC_SESSION_BINDING_TOOL" verify \
    --selection "$selection" --bindings "$SC_SESSION_BINDING_DIRECTORY" \
    --retirements "$SC_SESSION_BINDING_RETIREMENT_DIRECTORY") || rc=$?
  (( rc == 0 )) || sc_die "alternate-provider conversation lacks a valid immutable provider binding; migration/review is required" "$rc"
  printf '%s\n' "$verified" | sc_atomic "$SC_RESUME_BINDING_VERIFIED" 600
  SC_RESUME_BINDING_SHA256=$(jq -er '.binding_sha256' <<<"$verified")
  mode=$(jq -er '.mode' <<<"$verified")
  [[ "$mode" == "$SC_PROVIDER_MODE" ]] || sc_die "session binding provider mode conflicts with native history" 78
  if [[ "$mode" == local ]]; then
    backend=$(jq -er '.local.runtime.backend' <<<"$verified")
    context=$(jq -er '.context_tokens' <<<"$verified")
    digest=$(jq -er '.local.model_digest_sha256' <<<"$verified")
    executable=$(jq -er '.local.runtime.executable' <<<"$verified")
    pin=$(jq -er '.local.runtime.provider_nixpkgs_rev' <<<"$verified")
    if (( SC_LOCAL_BACKEND_EXPLICIT )) && [[ "$SC_LOCAL_BACKEND" != "$backend" ]]; then
      sc_die "requested local backend differs from the conversation's bound backend" 64
    fi
    if (( SC_LOCAL_CONTEXT_EXPLICIT )) && [[ "$SC_LOCAL_CONTEXT_TOKENS" != "$context" ]]; then
      sc_die "requested local context differs from the conversation's bound context" 64
    fi
    configured=${SANDCODEX_LOCAL_OLLAMA_BIN:-}
    if [[ -n "$configured" && "$(readlink -f -- "$configured" 2>/dev/null || true)" != "$executable" ]]; then
      sc_die "SANDCODEX_LOCAL_OLLAMA_BIN conflicts with the conversation's bound runtime" 64
    fi
    [[ -z "${SANDCODEX_LOCAL_NIXPKGS_REV:-}" || "$SANDCODEX_LOCAL_NIXPKGS_REV" == "$pin" ]] ||
      sc_die "SANDCODEX_LOCAL_NIXPKGS_REV conflicts with the conversation binding" 64
    [[ "$backend" != cpu || "${SANDCODEX_LOCAL_REQUIRE_GPU:-0}" != 1 ]] ||
      sc_die "GPU was explicitly required but this conversation is bound to the CPU runtime" 64
    root=$(jq -r '.local.runtime.gc_root // empty' <<<"$verified")
    if [[ -n "$root" ]]; then
      [[ "$root" == "$SC_CONTROL/local-runtime-roots/"* ]] || sc_die "bound runtime GC root lies outside this project control state" 78
    fi
    pin_policy=$(jq -er '.local.model_pin.policy' <<<"$verified")
    pin_alias=$(jq -er '.local.model_pin.runtime_model' <<<"$verified")
    requested=$(jq -er '.local.model_pin.requested_model' <<<"$verified")
    source_digest=$(jq -er '.local.model_pin.source_digest_sha256 // .local.model_pin.digest_sha256' <<<"$verified")
    bound_threads=$(jq -r '.local.model_pin.runtime_parameters.num_thread // empty' <<<"$verified")
    if (( SC_LOCAL_MODEL_DIGEST_EXPLICIT )) && [[ "$SC_LOCAL_MODEL_DIGEST" != "$source_digest" ]]; then
      sc_die "requested local source-model digest differs from the conversation binding" 64
    fi
    if (( SC_LOCAL_THREADS_EXPLICIT )) && [[ "$SC_LOCAL_THREADS" != "$bound_threads" ]]; then
      sc_die "requested local runner-thread profile differs from the conversation binding" 64
    fi
    bound_requested=$requested
    explicit_requested=$SC_LOCAL_REQUESTED_MODEL
    if [[ -n "$explicit_requested" &&
          "$(sc_family_canonical_model_name "$explicit_requested")" != "$(sc_family_canonical_model_name "$bound_requested")" &&
          "$(sc_family_canonical_model_name "$explicit_requested")" != "$(sc_family_canonical_model_name "$(jq -er '.model' <<<"$verified")")" ]]; then
      sc_die "requested local model differs from the conversation's bound requested model" 64
    fi
    [[ ( "$pin_policy" == ollama-manifest-alias-v1 || "$pin_policy" == ollama-derived-profile-v1 ) &&
       -n "$pin_alias" && "$pin_alias" == "$(jq -er '.model' <<<"$verified")" ]] ||
      sc_die "bound local content-addressed model alias is inconsistent" 78
    SC_LOCAL_MODEL_PIN_ALIAS=$pin_alias
    SC_LOCAL_REQUESTED_MODEL=$bound_requested
    SC_LOCAL_BACKEND=$backend
    SC_LOCAL_CONTEXT_TOKENS=$context; SC_LOCAL_CONTEXT_EXPLICIT=1
    SC_LOCAL_THREADS=$bound_threads; SC_LOCAL_THREADS_EXPLICIT=1
    SC_LOCAL_MODEL_DIGEST=$digest; SC_LOCAL_MODEL_DIGEST_EXPLICIT=1
    SC_LOCAL_PULL=0
    SC_LOCAL_RESUME_BOUND=1
    SC_LOCAL_PROVIDER_SOURCE="resume-bound"
    export SANDCODEX_LOCAL_OLLAMA_BIN="$executable"
    export SANDCODEX_LOCAL_NIXPKGS_REV="$pin"
  elif [[ "$mode" == remote ]]; then
    expected_snapshot="$SC_CONTROL/remote-providers/${SC_REMOTE_NATIVE_PROVIDER#scr_}.json"
    [[ "$(jq -er '.remote.snapshot_path' <<<"$verified")" == "$expected_snapshot" ]] ||
      sc_die "bound remote snapshot lies outside the project provider store" 78
    SC_REMOTE_SNAPSHOT=$expected_snapshot
    qualification_path=$(jq -er '.remote.qualification.receipt_path' <<<"$verified")
    qualification_sha=$(jq -er '.remote.qualification.receipt_sha256' <<<"$verified")
    [[ "$qualification_path" == "$SC_CONTROL/remote-qualifications/$qualification_sha.json" ]] ||
      sc_die "bound remote qualification lies outside the project receipt store" 78
    SC_REMOTE_QUALIFICATION=$qualification_path
    SC_REMOTE_QUALIFICATION_SHA256=$qualification_sha
    SC_REMOTE_QUALIFICATION_PROBE_VERSION=$(jq -er '.remote.qualification.probe_version' <<<"$verified")
    SC_REMOTE_QUALIFICATION_MODEL_POLICY=$(jq -er '.remote.qualification.model_identity_policy' <<<"$verified")
    SC_REMOTE_BOUND_QUALIFICATION=1
    if jq -e '.remote.router != null' <<<"$verified" >/dev/null; then
      sc_remote_router_snapshot_is_router ||
        sc_die "bound remote relay identity conflicts with its provider snapshot" 78
      [[ "$(jq -cS '.remote.router' <<<"$verified")" == "$(jq -cS '.router' "$SC_REMOTE_SNAPSHOT")" ]] ||
        sc_die "bound remote relay identity differs from its immutable provider snapshot" 78
    elif sc_remote_router_snapshot_is_router; then
      sc_die "bound remote provider snapshot gained an unbound relay identity" 78
    fi
  else
    [[ "$mode" == gemini ]] || sc_die "unsupported alternate-provider binding mode" 78
    expected_snapshot="$SC_CONTROL/gemini-providers/${SC_GEMINI_NATIVE_PROVIDER#scg_}.json"
    [[ "$(jq -er '.gemini.snapshot_path' <<<"$verified")" == "$expected_snapshot" ]] ||
      sc_die "bound Gemini snapshot lies outside the project provider store" 78
    [[ "$(jq -er '.gemini.snapshot_sha256' <<<"$verified")" == "${SC_GEMINI_NATIVE_PROVIDER#scg_}" ]] ||
      sc_die "bound Gemini snapshot digest conflicts with its native provider ID" 78
    SC_GEMINI_SNAPSHOT=$expected_snapshot
    SC_GEMINI_SNAPSHOT_SHA256=${SC_GEMINI_NATIVE_PROVIDER#scg_}
    SC_GEMINI_ADAPTER_SHA256=$(jq -er '.gemini.adapter_sha256' <<<"$verified")
    SC_GEMINI_ADAPTER_SCRIPT=$(jq -er '.gemini.adapter_path' <<<"$verified")
    [[ "$SC_GEMINI_ADAPTER_SCRIPT" == "$SC_CONTROL/gemini-adapters/$SC_GEMINI_ADAPTER_SHA256.py" ]] ||
      sc_die "bound Gemini adapter lies outside the project adapter store" 78
    qualification_path=$(jq -er '.gemini.qualification.receipt_path' <<<"$verified")
    qualification_sha=$(jq -er '.gemini.qualification.receipt_sha256' <<<"$verified")
    [[ "$qualification_path" == "$SC_CONTROL/gemini-qualifications/$qualification_sha.json" ]] ||
      sc_die "bound Gemini qualification lies outside the project receipt store" 78
    SC_GEMINI_QUALIFICATION=$qualification_path
    SC_GEMINI_QUALIFICATION_SHA256=$qualification_sha
    SC_GEMINI_BOUND_QUALIFICATION=1
    SC_GEMINI_AUTO=$(jq -r 'if .gemini.route.auto then 1 else 0 end' <<<"$verified")
    gemini_qualification_revision=$(jq -r '.qualification_probe_revision // "legacy-v1"' "$qualification_path")
    case "$gemini_qualification_revision" in
      "$SC_GEMINI_QUALIFICATION_REVISION") ;;
      gemini-responses-qualification-v4|gemini-responses-qualification-v5|gemini-responses-qualification-v6|gemini-responses-qualification-v7|gemini-responses-qualification-v8|gemini-responses-qualification-v9|gemini-responses-qualification-v10|gemini-responses-qualification-v11)
        sc_note "resume · exact historical Gemini adapter $gemini_qualification_revision · original routing semantics preserved"
        ;;
      legacy-v1|gemini-responses-qualification-v2|gemini-responses-qualification-v3)
        if (( SC_GEMINI_ROUTE_WAIT_EXPLICIT )) && (( SC_GEMINI_ROUTE_WAIT_SECONDS != 0 )); then
          sc_die "this bound Gemini adapter predates in-request route waiting; resume it with --no-route-wait or start a fresh Gemini conversation" 64
        fi
        SC_GEMINI_ROUTE_WAIT_SECONDS=0
        sc_note "resume · exact historical Gemini adapter $gemini_qualification_revision · in-request route waiting unavailable"
        ;;
      *) sc_die "bound Gemini qualification revision is not supported by this Sandcodex artifact" 78 ;;
    esac
  fi
  sc_note "resume · immutable provider binding $SC_RESUME_BINDING_SHA256 verified"
}

sc_family_prepare_session_binding() {
  [[ "$SC_RESUME" == fresh && "$SC_PROVIDER_MODE" != gpt ]] || return 0
  # Bind managed Ollama and remote Responses conversations after the first
  # durable user/assistant event.
  local startup_sha descriptor snapshot_sha snapshot_identity launch_id created qualification_sha router_identity=null
  sc_family_install_session_tools
  sc_family_binding_state_dirs
  SC_SESSION_BINDING_RUN_DIRECTORY=$(mktemp -d "$SC_CONTROL/session-binding-runs/launch.XXXXXXXXXXXX")
  chmod 700 "$SC_SESSION_BINDING_RUN_DIRECTORY"
  SC_SESSION_BINDING_BASELINE="$SC_SESSION_BINDING_RUN_DIRECTORY/baseline.json"
  SC_SESSION_BINDING_CLAIM="$SC_SESSION_BINDING_RUN_DIRECTORY/claim.json"
  SC_SESSION_BINDING_RESULT="$SC_SESSION_BINDING_RUN_DIRECTORY/result.json"
  python3 -P "$SC_SESSION_BINDING_TOOL" snapshot \
    --selector "$SC_SESSION_SELECTOR_TOOL" --sessions "$SC_CONTROL/codex-home/sessions" \
    --project "$SC_PROJECT" --output "$SC_SESSION_BINDING_BASELINE" ||
    sc_die "could not take a bounded metadata-only baseline of this project's conversations" 78
  launch_id=${SC_SESSION_BINDING_RUN_DIRECTORY##*/}
  created=$(sc_now)
  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    [[ -n "$SC_LOCAL_STARTUP_RECEIPT" ]] || sc_die "managed local startup produced no launch receipt for session binding" 78
    sc_owned_single_file "$SC_LOCAL_STARTUP_RECEIPT" 600 "managed local startup receipt"
    startup_sha=$(sha256sum -- "$SC_LOCAL_STARTUP_RECEIPT" | awk '{print $1}')
    jq -e --arg project "$SC_PROJECT" --arg provider "$SC_LOCAL_PROVIDER" --arg model "$SC_MODEL" \
      --arg created "$created" --arg launch_id "$launch_id" --arg startup_sha "$startup_sha" \
      --argjson context "$SC_LOCAL_CONTEXT_TOKENS" '
        select(.schema=="sandcodex.managed-local-startup.v1" and .result=="startup_checks_passed")
        | {schema:"sandcodex.provider-session-claim.v1",project:$project,mode:"local",
           provider:$provider,model:$model,context_tokens:$context,created_at:$created,launch_id:$launch_id,
           local:{model_digest_sha256:.verification.model.digest_sha256,
                  qualification_sha256:.qualification_sha256,
                  startup_receipt_sha256:$startup_sha,cpu_retry_used:.cpu_retry_used,
                  resume_fallback_policy:"exact-bound-backend-no-fallback",runtime:.runtime_provenance,
                  model_pin:.model_pin}}' \
      "$SC_LOCAL_STARTUP_RECEIPT" | sc_atomic "$SC_SESSION_BINDING_CLAIM" 600 ||
      sc_die "managed local startup receipt could not become a session-binding claim" 78
  elif [[ "$SC_PROVIDER_MODE" == remote ]]; then
    [[ -n "$SC_REMOTE_SNAPSHOT" && -n "$SC_REMOTE_NATIVE_PROVIDER" ]] ||
      sc_die "remote provider snapshot is missing before session binding" 78
    [[ -n "$SC_REMOTE_QUALIFICATION" && -n "$SC_REMOTE_QUALIFICATION_SHA256" ]] ||
      sc_die "remote provider qualification is missing before session binding" 78
    sc_owned_single_file "$SC_REMOTE_SNAPSHOT" 600 "remote provider snapshot"
    sc_owned_single_file "$SC_REMOTE_QUALIFICATION" 600 "remote qualification receipt"
    descriptor=${SC_REMOTE_NATIVE_PROVIDER#scr_}
    snapshot_sha=$(sha256sum -- "$SC_REMOTE_SNAPSHOT" | awk '{print $1}')
    qualification_sha=$(sha256sum -- "$SC_REMOTE_QUALIFICATION" | awk '{print $1}')
    [[ "$qualification_sha" == "$SC_REMOTE_QUALIFICATION_SHA256" ]] ||
      sc_die "remote qualification digest changed before session binding" 78
    [[ "$SC_REMOTE_QUALIFICATION" == "$SC_CONTROL/remote-qualifications/$qualification_sha.json" ]] ||
      sc_die "remote qualification receipt lies outside the project receipt store" 78
    if sc_remote_router_snapshot_is_router; then
      # Router snapshots bind several separately sealed broker artifacts. Their
      # native provider ID is therefore the digest of the complete snapshot,
      # whereas ordinary provider IDs remain the semantic descriptor emitted by
      # remote-config. Keep the two identity domains explicit.
      [[ "$snapshot_sha" == "$descriptor" ]] ||
        sc_die "OpenRouter router snapshot digest conflicts with its native provider ID" 78
      sc_remote_router_verify_bound_files
      router_identity=$(jq -c '.router' "$SC_REMOTE_SNAPSHOT")
    else
      snapshot_identity=$(
        sc_emit_remote_config | python3 -P - --snapshot "$SC_REMOTE_SNAPSHOT" |
          jq -er '.sha256'
      ) || sc_die "remote provider snapshot identity could not be revalidated before session binding" 78
      [[ "$snapshot_identity" == "$descriptor" ]] ||
        sc_die "remote provider snapshot descriptor conflicts with its native provider ID" 78
    fi
    jq -n --arg project "$SC_PROJECT" --arg provider "$SC_REMOTE_NATIVE_PROVIDER" --arg model "$SC_MODEL" \
      --arg created "$created" --arg launch_id "$launch_id" --arg descriptor "$descriptor" \
      --arg snapshot_sha "$snapshot_sha" --arg snapshot_path "$SC_REMOTE_SNAPSHOT" \
      --arg qualification_sha "$qualification_sha" --arg qualification_path "$SC_REMOTE_QUALIFICATION" \
      --arg probe_version "$SC_REMOTE_QUALIFICATION_PROBE_VERSION" \
      --arg model_policy "$SC_REMOTE_QUALIFICATION_MODEL_POLICY" --argjson router "$router_identity" '
        {schema:"sandcodex.provider-session-claim.v1",project:$project,mode:"remote",
         provider:$provider,model:$model,created_at:$created,launch_id:$launch_id,
         remote:{descriptor_sha256:$descriptor,snapshot_sha256:$snapshot_sha,snapshot_path:$snapshot_path,
                 qualification:{schema:"sandcodex.remote-qualification.v1",receipt_sha256:$qualification_sha,
                                receipt_path:$qualification_path,probe_version:$probe_version,model:$model,
                                model_identity_policy:$model_policy},router:$router}}' |
      sc_atomic "$SC_SESSION_BINDING_CLAIM" 600
  else
    [[ "$SC_PROVIDER_MODE" == gemini ]] || sc_die "unsupported alternate-provider session-binding mode" 78
    [[ -n "$SC_GEMINI_SNAPSHOT" && -n "$SC_GEMINI_NATIVE_PROVIDER" ]] ||
      sc_die "Gemini provider snapshot is missing before session binding" 78
    [[ -n "$SC_GEMINI_ADAPTER_SCRIPT" && -n "$SC_GEMINI_ADAPTER_SHA256" ]] ||
      sc_die "Gemini adapter identity is missing before session binding" 78
    [[ -n "$SC_GEMINI_QUALIFICATION" && -n "$SC_GEMINI_QUALIFICATION_SHA256" ]] ||
      sc_die "Gemini qualification is missing before session binding" 78
    sc_owned_single_file "$SC_GEMINI_SNAPSHOT" 600 "Gemini provider snapshot"
    sc_owned_single_file "$SC_GEMINI_ADAPTER_SCRIPT" 500 "Gemini Responses adapter"
    sc_owned_single_file "$SC_GEMINI_QUALIFICATION" 600 "Gemini qualification receipt"
    descriptor=${SC_GEMINI_NATIVE_PROVIDER#scg_}
    snapshot_sha=$(sha256sum -- "$SC_GEMINI_SNAPSHOT" | awk '{print $1}')
    [[ "$snapshot_sha" == "$descriptor" && "$snapshot_sha" == "$SC_GEMINI_SNAPSHOT_SHA256" ]] ||
      sc_die "Gemini provider snapshot digest changed before session binding" 78
    [[ "$(sha256sum -- "$SC_GEMINI_ADAPTER_SCRIPT" | awk '{print $1}')" == "$SC_GEMINI_ADAPTER_SHA256" ]] ||
      sc_die "Gemini adapter digest changed before session binding" 78
    qualification_sha=$(sha256sum -- "$SC_GEMINI_QUALIFICATION" | awk '{print $1}')
    [[ "$qualification_sha" == "$SC_GEMINI_QUALIFICATION_SHA256" ]] ||
      sc_die "Gemini qualification digest changed before session binding" 78
    [[ "$SC_GEMINI_SNAPSHOT" == "$SC_CONTROL/gemini-providers/$descriptor.json" ]] ||
      sc_die "Gemini provider snapshot lies outside the project provider store" 78
    [[ "$SC_GEMINI_ADAPTER_SCRIPT" == "$SC_CONTROL/gemini-adapters/$SC_GEMINI_ADAPTER_SHA256.py" ]] ||
      sc_die "Gemini adapter lies outside the project adapter store" 78
    [[ "$SC_GEMINI_QUALIFICATION" == "$SC_CONTROL/gemini-qualifications/$qualification_sha.json" ]] ||
      sc_die "Gemini qualification receipt lies outside the project receipt store" 78
    jq -n --arg project "$SC_PROJECT" --arg provider "$SC_GEMINI_NATIVE_PROVIDER" --arg model "$SC_MODEL" \
      --arg created "$created" --arg launch_id "$launch_id" --arg descriptor "$descriptor" \
      --arg snapshot_sha "$snapshot_sha" --arg snapshot_path "$SC_GEMINI_SNAPSHOT" \
      --arg adapter_sha "$SC_GEMINI_ADAPTER_SHA256" --arg adapter_path "$SC_GEMINI_ADAPTER_SCRIPT" \
      --arg qualification_sha "$qualification_sha" --arg qualification_path "$SC_GEMINI_QUALIFICATION" \
      --arg state_schema "$SC_GEMINI_ADAPTER_STATE_SCHEMA" \
      --argjson auto "$SC_GEMINI_AUTO" --argjson candidates "$(jq -c '.candidate_models' "$SC_GEMINI_SNAPSHOT")" '
        {schema:"sandcodex.provider-session-claim.v1",project:$project,mode:"gemini",
         provider:$provider,model:$model,created_at:$created,launch_id:$launch_id,
         gemini:{descriptor_sha256:$descriptor,snapshot_sha256:$snapshot_sha,snapshot_path:$snapshot_path,
                 adapter_sha256:$adapter_sha,adapter_path:$adapter_path,
                 qualification:{schema:"sandcodex.gemini-adapter-qualification.v1",
                                receipt_sha256:$qualification_sha,receipt_path:$qualification_path},
                 route:{routing_model:$model,auto:($auto==1),free_only:true,candidate_models:$candidates,
                        state_schema:$state_schema,
                        model_switch_policy:"pre-visible-output-key-then-model-failover"}}}' |
      sc_atomic "$SC_SESSION_BINDING_CLAIM" 600
  fi
  # Validate the claim before Codex starts. Commit is delayed until a real user/assistant
  # event establishes exactly one new primary native conversation.
  python3 -P "$SC_SESSION_BINDING_TOOL" commit \
    --selector "$SC_SESSION_SELECTOR_TOOL" --sessions "$SC_CONTROL/codex-home/sessions" \
    --project "$SC_PROJECT" --baseline "$SC_SESSION_BINDING_BASELINE" \
    --claim "$SC_SESSION_BINDING_CLAIM" --bindings "$SC_SESSION_BINDING_DIRECTORY" \
    --retirements "$SC_SESSION_BINDING_RETIREMENT_DIRECTORY" \
    | jq -e '.result=="no_established_session"' >/dev/null ||
      sc_die "session-binding claim or baseline failed validation before launch" 78
  SC_SESSION_BINDING_PENDING=1
  sc_note "session binding · waiting for the first established conversation in this project"
}

sc_family_start_session_binding_watcher() {
  (( SC_SESSION_BINDING_PENDING )) || return 0
  [[ -z "$SC_SESSION_BINDING_WATCH_PID" ]] || sc_die "session binding watcher is already active" 70
  local parent_start
  parent_start=$(sc_process_start "$$") || sc_die "could not identify the Sandcodex process for session binding" 70
  python3 -P "$SC_SESSION_BINDING_TOOL" watch \
    --selector "$SC_SESSION_SELECTOR_TOOL" --sessions "$SC_CONTROL/codex-home/sessions" \
    --project "$SC_PROJECT" --baseline "$SC_SESSION_BINDING_BASELINE" \
    --claim "$SC_SESSION_BINDING_CLAIM" --bindings "$SC_SESSION_BINDING_DIRECTORY" \
    --retirements "$SC_SESSION_BINDING_RETIREMENT_DIRECTORY" \
    --result "$SC_SESSION_BINDING_RESULT" --parent-pid "$$" --parent-start "$parent_start" \
    >"$SC_SESSION_BINDING_RUN_DIRECTORY/watcher.log" 2>&1 < /dev/null &
  SC_SESSION_BINDING_WATCH_PID=$!
  SC_SESSION_BINDING_WATCH_START=$(sc_process_start "$SC_SESSION_BINDING_WATCH_PID" 2>/dev/null || true)
  [[ "$SC_SESSION_BINDING_WATCH_START" =~ ^[0-9]+$ ]] || sc_die "session binding watcher did not start safely" 70
}

sc_family_stop_session_binding_watcher() {
  [[ -n "$SC_SESSION_BINDING_WATCH_PID" ]] || return 0
  if sc_pid_still_matches "$SC_SESSION_BINDING_WATCH_PID" "$SC_SESSION_BINDING_WATCH_START"; then
    kill -TERM "$SC_SESSION_BINDING_WATCH_PID" 2>/dev/null || true
  fi
  wait "$SC_SESSION_BINDING_WATCH_PID" 2>/dev/null || true
  SC_SESSION_BINDING_WATCH_PID=""
  SC_SESSION_BINDING_WATCH_START=""
}

sc_family_finalize_session_binding() {
  local strict=${1:-0} keep_pending_on_empty=${2:-0} result rc=0 status
  (( SC_SESSION_BINDING_PENDING )) || return 0
  sc_family_stop_session_binding_watcher
  result=$(python3 -P "$SC_SESSION_BINDING_TOOL" commit \
    --selector "$SC_SESSION_SELECTOR_TOOL" --sessions "$SC_CONTROL/codex-home/sessions" \
    --project "$SC_PROJECT" --baseline "$SC_SESSION_BINDING_BASELINE" \
    --claim "$SC_SESSION_BINDING_CLAIM" --bindings "$SC_SESSION_BINDING_DIRECTORY" \
    --retirements "$SC_SESSION_BINDING_RETIREMENT_DIRECTORY") || rc=$?
  if (( rc != 0 )); then
    SC_SESSION_BINDING_PENDING=0
    if (( strict )); then
      sc_die "could not bind the established alternate-provider conversation; review $SC_SESSION_BINDING_RUN_DIRECTORY" "$rc"
    fi
    sc_warn "session binding could not be finalized; review $SC_SESSION_BINDING_RUN_DIRECTORY"
    return 0
  fi
  printf '%s\n' "$result" | sc_atomic "$SC_SESSION_BINDING_RESULT" 600
  status=$(jq -er '.result' <<<"$result")
  case "$status" in
    bound|already_bound)
      SC_SESSION_BINDING_PENDING=0
      SC_RESUME_BINDING_SHA256=$(jq -er '.binding_sha256' <<<"$result")
      SC_SESSION_BINDING_THREAD_ID=$(jq -er '.thread_id' <<<"$result")
      [[ "$SC_SESSION_BINDING_THREAD_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] ||
        sc_die "session binding helper returned an invalid thread ID" 78
      SC_SESSION_BINDING_THREAD_ID=${SC_SESSION_BINDING_THREAD_ID,,}
      sc_note "session binding · $status · thread $SC_SESSION_BINDING_THREAD_ID"
      ;;
    no_established_session)
      if (( keep_pending_on_empty )); then
        SC_SESSION_BINDING_PENDING=1
        sc_note "session binding · no durable user turn yet; binding remains armed for a safe retry"
      else
        SC_SESSION_BINDING_PENDING=0
        sc_note "session binding · no user/assistant conversation was established; no binding written"
      fi
      ;;
    *)
      SC_SESSION_BINDING_PENDING=0
      if (( strict )); then sc_die "session binding helper returned an unknown result" 78; fi
      sc_warn "session binding helper returned an unknown result"
      ;;
  esac
}

# Per-user local-runtime lifecycle. Embedded, not a separate public CLI.
# The active channel affects only fresh managed-local launches. Bound resume
# restores its exact runtime first and never consults this channel.

sc_local_runtime_help() {
  cat <<'EOF'
Sandcodex local runtime maintenance

  sandcodex local update MODEL [OPTIONS]
      Realize one pinned Ollama runtime, qualify MODEL with the same startup and
      Responses probes used by a normal local launch, then atomically activate
      it for future fresh launches. Existing conversations are not retargeted.

  sandcodex local probe MODEL [OPTIONS]
      Run the same managed-local model/runtime qualification and print the
      evidence, but do not activate a per-user runtime channel. This accepts
      --local-ollama-bin PATH and is the preferred first CUDA proof when using
      a host/prebuilt Ollama binary.

  sandcodex local rollback [--backend auto|cuda|cpu] [--json]
      Atomically swap the selected backend to its previous qualified runtime.

  sandcodex local status [--json]
      Show active and previous qualified CPU/CUDA runtime stages.
      Without --json, also print copyable fresh-launch/resume commands for each
      active backend and the in-room companion-worker surface.

  sandcodex local report
      Print one paste-ready terminal diagnostic for the host, local channels,
      CUDA inventory, host Ollama, and recommended next local probe commands.

  sandcodex local prune [--dry-run] [--json]
      Remove only unreachable runtime-stage metadata and Sandcodex-owned channel
      GC-root symlinks. Project conversation roots and the Nix store are untouched.

Update options:
  --nixpkgs REV              Full 40-character nixpkgs commit
  --backend auto|cuda|cpu    Default: auto
  --cpu                      Alias for --backend cpu
  --local-context TOKENS     Qualification context budget
  --local-threads N          Immutable Ollama runner-thread profile (1..1024)
  --local-memory-mib MIB     Managed Ollama MemoryMax/admission budget
  --local-ollama-bin PATH    Use this executable for local/probe instead of
                             realizing nixpkgs#ollama-{cpu,cuda}
  --no-pull                  Refuse to acquire an absent qualification model
  --json                     Emit the result as JSON

Runtime updates are per Unix user, not per project. Update/rollback/prune are
serialized. Fresh launches lease a selected channel only until their project root
is established. Resume never updates, activates, rolls back, or substitutes a runtime.
`--local-ollama-bin` is intentionally not accepted by `local update`: an active
channel is a Nix-rooted artifact. Use `local probe` or direct `sandcodex local`.
EOF
}

sc_local_backend_cli_option() {
  case "$1" in
    cpu) printf -- '--cpu' ;;
    cuda) printf -- '--backend cuda' ;;
    *) printf -- '--backend %s' "$1" ;;
  esac
}

sc_parse_local_runtime_model_action() {
  local action=$1; shift
  case "${1:-}" in ''|-h|--help|help) sc_local_runtime_help; exit 0 ;; esac
  [[ "$1" != -* ]] || sc_usage_error "sandcodex local $action requires MODEL before options"
  SC_MODEL=$1; SC_MODEL_SET=1; SC_LOCAL_REQUESTED_MODEL=$1; shift
  while (( $# )); do
    case "$1" in
      --nixpkgs) (( $# > 1 )) || sc_usage_error "--nixpkgs requires a full commit"; SC_LOCAL_RUNTIME_NIXPKGS_REV=$2; shift 2 ;;
      --nixpkgs=*) SC_LOCAL_RUNTIME_NIXPKGS_REV=${1#*=}; shift ;;
      --backend) (( $# > 1 )) || sc_usage_error "--backend requires auto, cuda, or cpu"; SC_LOCAL_BACKEND=$2; SC_LOCAL_BACKEND_EXPLICIT=1; shift 2 ;;
      --backend=*) SC_LOCAL_BACKEND=${1#*=}; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
      --cpu) SC_LOCAL_BACKEND=cpu; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
      --local-context) (( $# > 1 )) || sc_usage_error "--local-context requires TOKENS"; SC_LOCAL_CONTEXT_TOKENS=$2; SC_LOCAL_CONTEXT_EXPLICIT=1; shift 2 ;;
      --local-context=*) SC_LOCAL_CONTEXT_TOKENS=${1#*=}; SC_LOCAL_CONTEXT_EXPLICIT=1; shift ;;
      --local-threads) (( $# > 1 )) || sc_usage_error "--local-threads requires N"; SC_LOCAL_THREADS=$2; SC_LOCAL_THREADS_EXPLICIT=1; shift 2 ;;
      --local-threads=*) SC_LOCAL_THREADS=${1#*=}; SC_LOCAL_THREADS_EXPLICIT=1; shift ;;
      --local-memory|--local-memory-mib) (( $# > 1 )) || sc_usage_error "--local-memory-mib requires MIB"; SC_LOCAL_MEMORY_MIB=$2; SC_LOCAL_MEMORY_EXPLICIT=1; shift 2 ;;
      --local-memory=*|--local-memory-mib=*) SC_LOCAL_MEMORY_MIB=${1#*=}; SC_LOCAL_MEMORY_EXPLICIT=1; shift ;;
      --local-ollama-bin)
        (( $# > 1 )) || sc_usage_error "--local-ollama-bin requires PATH"
        [[ "$action" != update ]] || sc_usage_error "--local-ollama-bin is for local probe/run; local update activates only Nix-rooted channels"
        sc_set_local_ollama_bin_cli "$2"; shift 2 ;;
      --local-ollama-bin=*)
        [[ "$action" != update ]] || sc_usage_error "--local-ollama-bin is for local probe/run; local update activates only Nix-rooted channels"
        sc_set_local_ollama_bin_cli "${1#*=}"; shift ;;
      --no-pull) SC_LOCAL_PULL=0; shift ;;
      --json) SC_LOCAL_RUNTIME_JSON=1; SC_QUIET=1; shift ;;
      -h|--help) sc_local_runtime_help; exit 0 ;;
      --model|--model=*|-m|-m=*|--local-model|--local-model=*|--local-provider|--local-provider=*)
        sc_usage_error "local $action MODEL is already selected; do not supply another provider/model selector" ;;
      --RESUME|--RESUME=*|--project|--project=*)
        sc_usage_error "local runtime maintenance is per-user and cannot resume or select a project" ;;
      *) sc_usage_error "unknown local $action option: $1" ;;
    esac
  done
  [[ "$SC_LOCAL_RUNTIME_NIXPKGS_REV" =~ ^[0-9a-f]{40}$ ]] ||
    sc_usage_error "--nixpkgs requires a full lowercase 40-character commit"
  [[ "$action" != update || -z "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" ]] ||
    sc_usage_error "local update activates only Nix-rooted channels; unset SANDCODEX_LOCAL_OLLAMA_BIN or use local probe"
  case "$SC_LOCAL_BACKEND" in auto|cuda|cpu) ;; *) sc_usage_error "--backend requires auto, cuda, or cpu" ;; esac
  if [[ -n "$SC_LOCAL_CONTEXT_TOKENS" ]]; then
    [[ "$SC_LOCAL_CONTEXT_TOKENS" =~ ^[0-9]+$ ]] || sc_usage_error "--local-context requires an integer"
    (( 10#$SC_LOCAL_CONTEXT_TOKENS >= SC_LOCAL_CONTEXT_MIN &&
       10#$SC_LOCAL_CONTEXT_TOKENS <= SC_LOCAL_CONTEXT_MAX &&
       10#$SC_LOCAL_CONTEXT_TOKENS % 1024 == 0 )) ||
      sc_usage_error "--local-context must be $SC_LOCAL_CONTEXT_MIN..$SC_LOCAL_CONTEXT_MAX and a multiple of 1024"
  fi
  if [[ -n "$SC_LOCAL_THREADS" ]]; then
    [[ "$SC_LOCAL_THREADS" =~ ^[1-9][0-9]*$ && ${#SC_LOCAL_THREADS} -le 4 ]] ||
      sc_usage_error "--local-threads requires a canonical positive integer"
    (( 10#$SC_LOCAL_THREADS <= SC_LOCAL_THREADS_MAX )) ||
      sc_usage_error "--local-threads must be 1 through $SC_LOCAL_THREADS_MAX"
  fi
  sc_validate_local_memory_mib
}

sc_parse_local_runtime_maintenance() {
  SC_HELP_TOPIC=local
  local action=$1; shift
  SC_COMMAND=local-runtime
  SC_LOCAL_RUNTIME_ACTION=$action
  SC_LOCAL_RUNTIME_MAINTENANCE=1
  SC_PROVIDER_MODE=local; SC_PROVIDER_MODE_EXPLICIT=1
  SC_LOCAL_PROVIDER=ollama; SC_LOCAL_PROVIDER_SOURCE=maintenance
  SC_SUBAGENTS=0; SC_CAMPAIGN_MAX_COUNT=0
  case "$action" in
    probe|update)
      sc_parse_local_runtime_model_action "$action" "$@"
      ;;
    rollback)
      while (( $# )); do
        case "$1" in
          --backend) (( $# > 1 )) || sc_usage_error "--backend requires auto, cuda, or cpu"; SC_LOCAL_BACKEND=$2; SC_LOCAL_BACKEND_EXPLICIT=1; shift 2 ;;
          --backend=*) SC_LOCAL_BACKEND=${1#*=}; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
          --cpu) SC_LOCAL_BACKEND=cpu; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
          --json) SC_LOCAL_RUNTIME_JSON=1; SC_QUIET=1; shift ;;
          -h|--help|help) sc_local_runtime_help; exit 0 ;;
          *) sc_usage_error "unknown local rollback option: $1" ;;
        esac
      done
      case "$SC_LOCAL_BACKEND" in auto|cuda|cpu) ;; *) sc_usage_error "--backend requires auto, cuda, or cpu" ;; esac
      ;;
    status)
      while (( $# )); do
        case "$1" in
          --json) SC_LOCAL_RUNTIME_JSON=1; SC_QUIET=1; shift ;;
          -h|--help|help) sc_local_runtime_help; exit 0 ;;
          *) sc_usage_error "unknown local status option: $1" ;;
        esac
      done
      ;;
    report)
      while (( $# )); do
        case "$1" in
          -h|--help|help) sc_local_runtime_help; exit 0 ;;
          *) sc_usage_error "unknown local report option: $1" ;;
        esac
      done
      ;;
    prune)
      while (( $# )); do
        case "$1" in
          --dry-run) SC_LOCAL_RUNTIME_PRUNE_DRY_RUN=1; shift ;;
          --json) SC_LOCAL_RUNTIME_JSON=1; SC_QUIET=1; shift ;;
          -h|--help|help) sc_local_runtime_help; exit 0 ;;
          *) sc_usage_error "unknown local prune option: $1" ;;
        esac
      done
      ;;
    *) sc_usage_error "unknown local runtime action: $action" ;;
  esac
}

sc_local_runtime_root() {
  printf '%s/local-runtimes\n' "$SC_GLOBAL"
}

sc_local_runtime_python() {
  sc_emit_local_runtime_channel | python3 -P - "$@"
}

sc_local_runtime_json_tools_available() {
  command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1
}

sc_local_runtime_file_json() {
  local path=$1 label=$2 raw
  sc_owned_single_file "$path" 600 "$label"
  raw=$(<"$path")
  [[ "$raw" != *$'\n'* && "$raw" == "{"*"}" ]] ||
    sc_die "$label is not a single canonical JSON object" 78
  printf '%s\n' "$raw"
}

sc_local_runtime_json_string_field() {
  local raw=$1 key=$2 value
  value=$(sed -n 's/.*"'"$key"'":"\([^"]*\)".*/\1/p' <<<"$raw")
  printf '%s\n' "$value"
}

sc_local_runtime_json_int_field() {
  local raw=$1 key=$2 value
  value=$(sed -n 's/.*"'"$key"'":\([0-9][0-9]*\).*/\1/p' <<<"$raw")
  printf '%s\n' "$value"
}

sc_local_runtime_shell_channel_json() {
  local root=$1 backend=$2 channel_path current previous stage_path previous_path
  local channel_raw stage_raw previous_raw
  channel_path="$root/channels/$backend.json"
  if [[ ! -e "$channel_path" && ! -L "$channel_path" ]]; then
    printf '{"backend":"%s","result":"none"}' "$backend"
    return
  fi
  channel_raw=$(sc_local_runtime_file_json "$channel_path" "local runtime $backend channel")
  current=$(sc_local_runtime_json_string_field "$channel_raw" current)
  [[ "$current" =~ ^[0-9a-f]{64}$ ]] ||
    sc_die "local runtime $backend channel has an invalid current stage" 78
  stage_path="$root/stages/$current.json"
  stage_raw=$(sc_local_runtime_file_json "$stage_path" "local runtime $backend current stage")
  [[ "$(sc_local_runtime_json_string_field "$stage_raw" backend)" == "$backend" ]] ||
    sc_die "local runtime $backend stage backend mismatch" 78
  [[ "$(sc_local_runtime_json_string_field "$stage_raw" stage_id)" == "$current" ]] ||
    sc_die "local runtime $backend stage id mismatch" 78
  previous=$(sc_local_runtime_json_string_field "$channel_raw" previous)
  if [[ -n "$previous" ]]; then
    [[ "$previous" =~ ^[0-9a-f]{64}$ ]] ||
      sc_die "local runtime $backend channel has an invalid previous stage" 78
    previous_path="$root/stages/$previous.json"
    previous_raw=$(sc_local_runtime_file_json "$previous_path" "local runtime $backend previous stage")
  else
    previous_raw=null
  fi
  printf '{"backend":"%s","result":"active","channel":%s,"current":%s,"previous":%s}' \
    "$backend" "$channel_raw" "$stage_raw" "$previous_raw"
}

sc_local_runtime_status_shell_json() {
  local root cpu cuda
  root=$(sc_local_runtime_root)
  if [[ -e "$root" || -L "$root" ]]; then
    sc_owned_dir "$root" "local runtime channel root"
    if [[ -e "$root/channels" || -L "$root/channels" || -e "$root/stages" || -L "$root/stages" ]]; then
      [[ -d "$root/channels" && ! -L "$root/channels" && -d "$root/stages" && ! -L "$root/stages" ]] ||
        sc_die "local runtime channel layout is incomplete" 78
      sc_owned_dir "$root/channels" "local runtime channels"
      sc_owned_dir "$root/stages" "local runtime stages"
    fi
  fi
  cpu=$(sc_local_runtime_shell_channel_json "$root" cpu)
  cuda=$(sc_local_runtime_shell_channel_json "$root" cuda)
  printf '{"candidate_models":{"local_cuda_gtx1650":{"context_tokens":%s,"memory_mib":%s,"model":"%s","status":"operator-candidate-until-target-machine-digests-are-qualified"}},"channels":{"cpu":%s,"cuda":%s},"result":"status","schema":"sandcodex.local-runtime-result.v1"}\n' \
    "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB" "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$cpu" "$cuda"
}

sc_local_runtime_stage_print_shell() {
  local backend=$1 stage=$2 requested launch_backend context memory_mib memory_arg threads
  local keep_alive max_loaded num_parallel max_queue flash kv_cache
  printf '%s: current %s · nixpkgs %s · ollama %s\n' "$backend" \
    "$(sc_local_runtime_json_string_field "$stage" stage_id)" \
    "$(sc_local_runtime_json_string_field "$stage" nixpkgs_rev)" \
    "$(sc_local_runtime_json_string_field "$stage" provider_version)"
  threads=$(sc_local_runtime_json_int_field "$stage" model_profile_num_thread)
  if [[ -z "$threads" ]]; then
    if [[ "$stage" == *'"model_profile_num_thread":null'* ]]; then
      threads="provider-default"
    else
      threads=unrecorded
    fi
  fi
  printf '  model %s · context %s · threads %s\n' \
    "$(sc_local_runtime_json_string_field "$stage" qualified_model)" \
    "$(sc_local_runtime_json_int_field "$stage" context_tokens)" \
    "$threads"
  printf '  requested tag %s · source digest %s\n' \
    "$(sc_local_runtime_json_string_field "$stage" requested_model)" \
    "$(sc_local_runtime_json_string_field "$stage" source_model_digest_sha256)"
  keep_alive=$(sc_local_runtime_json_string_field "$stage" keep_alive)
  max_loaded=$(sc_local_runtime_json_int_field "$stage" max_loaded_models)
  num_parallel=$(sc_local_runtime_json_int_field "$stage" num_parallel)
  max_queue=$(sc_local_runtime_json_int_field "$stage" max_queue)
  flash=$(sed -n 's/.*"flash_attention":\(true\|false\).*/\1/p' <<<"$stage")
  kv_cache=$(sc_local_runtime_json_string_field "$stage" kv_cache_type)
  if [[ -n "$keep_alive" && -n "$max_loaded" && -n "$num_parallel" && -n "$max_queue" &&
        -n "$flash" && -n "$kv_cache" ]]; then
    printf '  server %s model · %s parallel · queue %s · KV %s · flash %s · idle %s\n' \
      "$max_loaded" "$num_parallel" "$max_queue" "$kv_cache" "$flash" "$keep_alive"
  else
    printf '  server legacy policy unrecorded\n'
  fi
  memory_mib=$(sed -n 's/.*"memory_max_mib":\([0-9][0-9]*\).*/\1/p' <<<"$stage")
  if [[ -n "$memory_mib" ]]; then
    printf '  memory recorded · max %s MiB\n' "$memory_mib"
  else
    printf '  memory legacy/unrecorded\n'
  fi
  requested=$(sc_local_runtime_json_string_field "$stage" requested_model)
  launch_backend=$(sc_local_backend_cli_option "$backend")
  context=" --local-context $(sc_local_runtime_json_int_field "$stage" context_tokens)"
  memory_arg=""
  if [[ "$backend" == cuda && "$requested" == "$SC_LOCAL_CUDA_CANDIDATE_MODEL" ]]; then
    memory_arg=" --local-memory-mib $SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
  fi
  if [[ -n "$requested" ]]; then
    printf '  fresh launch: sandcodex local %s %s%s%s\n' "$requested" "$launch_backend" "$context" "$memory_arg"
    printf '  resume:       sandcodex local %s %s%s%s --RESUME\n' "$requested" "$launch_backend" "$context" "$memory_arg"
    printf '  requalify:    sandcodex local update %s %s%s%s --no-pull\n' "$requested" "$launch_backend" "$context" "$memory_arg"
  fi
}

sc_local_runtime_status_print_shell() {
  local _status_json=${1:-} root backend channel_path channel_raw current stage_path stage
  root=$(sc_local_runtime_root)
  for backend in cpu cuda; do
    channel_path="$root/channels/$backend.json"
    if [[ ! -e "$channel_path" && ! -L "$channel_path" ]]; then
      printf '%s: no active qualified runtime\n' "$backend"
      if [[ "$backend" == cpu ]]; then
        printf '  prepare reference: sandcodex local update %s --cpu\n' "$SC_LOCAL_CPU_REFERENCE_MODEL"
      else
        printf '  probe GTX1650:     sandcodex local probe %s --backend cuda --local-context %s --local-memory-mib %s --local-ollama-bin /path/to/ollama\n' \
          "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
        printf '  activate later:    sandcodex local update %s --backend cuda --local-context %s --local-memory-mib %s\n' \
          "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
      fi
      continue
    fi
    channel_raw=$(sc_local_runtime_file_json "$channel_path" "local runtime $backend channel")
    current=$(sc_local_runtime_json_string_field "$channel_raw" current)
    [[ "$current" =~ ^[0-9a-f]{64}$ ]] ||
      sc_die "local runtime $backend channel has an invalid current stage" 78
    stage_path="$root/stages/$current.json"
    stage=$(sc_local_runtime_file_json "$stage_path" "local runtime $backend current stage")
    sc_local_runtime_stage_print_shell "$backend" "$stage"
  done
  printf 'project: run local rooms from a specific project directory or pass --project DIR; the home directory is refused\n'
  printf 'local worker: inside an interactive local room, use sandcodex-worker start --name NAME --turns N --prompt TEXT\n'
  printf 'scope: status is per Unix user; active channels affect future fresh local launches only, never bound resumes\n'
  printf 'paste-back diagnostics: sandcodex local report\n'
}

sc_local_runtime_lock_prepare() {
  local kind=$1 root lock
  case "$kind" in maintenance|lease) ;; *) sc_die "internal local runtime lock kind error" 70 ;; esac
  root=$(sc_local_runtime_root)
  sc_ensure_dir "$root" "local runtime channel"
  lock="$root/.$kind.lock"
  if [[ ! -e "$lock" && ! -L "$lock" ]]; then
    ( set -o noclobber; : >"$lock" ) 2>/dev/null || true
  fi
  [[ -f "$lock" && ! -L "$lock" ]] || sc_die "local runtime $kind lock is not a regular file" 78
  [[ "$(stat -c %u -- "$lock")" == "$EUID" && "$(stat -c %h -- "$lock")" == 1 ]] ||
    sc_die "local runtime $kind lock metadata is unsafe" 78
  chmod 600 -- "$lock"
  [[ "$(stat -c %a -- "$lock")" == 600 ]] || sc_die "local runtime $kind lock permissions are unsafe" 78
  printf '%s\n' "$lock"
}

sc_local_runtime_lock_acquire() {
  local kind=$1 mode=$2 lock root holder_shell flock_tool setpriv_tool flag pid_var ready_var
  local pid ready ready_seen=0 holder_rc=0
  case "$kind" in
    maintenance) pid_var=SC_LOCAL_RUNTIME_MAINTENANCE_LOCK_PID; ready_var=SC_LOCAL_RUNTIME_MAINTENANCE_LOCK_READY ;;
    lease) pid_var=SC_LOCAL_RUNTIME_LEASE_LOCK_PID; ready_var=SC_LOCAL_RUNTIME_LEASE_LOCK_READY ;;
    *) sc_die "internal local runtime lock kind error" 70 ;;
  esac
  case "$mode" in shared) flag=--shared ;; exclusive) flag=--exclusive ;; *) sc_die "internal local runtime lock mode error" 70 ;; esac
  [[ -z "${!pid_var}" ]] || sc_die "local runtime $kind lock is already held by this process" 70
  lock=$(sc_local_runtime_lock_prepare "$kind")
  root=$(sc_local_runtime_root)
  ready="$root/.$kind.ready.$$.$RANDOM"
  [[ ! -e "$ready" && ! -L "$ready" ]] || sc_die "local runtime $kind readiness path collision" 78
  holder_shell=$(command -v bash)
  flock_tool=${SC_FLOCK:-$(command -v flock)}
  setpriv_tool=${SC_SETPRIV:-$(command -v setpriv)}
  (
    sc_close_inherited_fds
    # The quoted program is interpreted by the deliberately selected child
    # shell; its positional argument, PID, and readiness path belong there.
    # shellcheck disable=SC2016
    exec "$setpriv_tool" --pdeathsig TERM "$flock_tool" "$flag" --nonblock --no-fork "$lock" \
      "$holder_shell" -c '
      set -eu
      ready=$1
      umask 077
      printf "%s\n" "$$" >"$ready"
      chmod 600 "$ready"
      exec sleep infinity
    ' sandcodex-local-runtime-lock "$ready"
  ) & pid=$!
  printf -v "$pid_var" '%s' "$pid"
  printf -v "$ready_var" '%s' "$ready"
  for _ in {1..100}; do
    if [[ -f "$ready" ]]; then
      kill -0 "$pid" 2>/dev/null && ready_seen=1
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then break; fi
    sleep 0.02
  done
  if (( ! ready_seen )); then
    wait "$pid" 2>/dev/null || holder_rc=$?
    printf -v "$pid_var" '%s' ""
    rm -f -- "$ready" 2>/dev/null || true
    printf -v "$ready_var" '%s' ""
    if (( holder_rc == 1 )); then
      sc_die "another Sandcodex local runtime $kind operation is active" 75
    fi
    sc_die "could not acquire the local runtime $kind lock" 75
  fi
  [[ ! -L "$ready" && "$(stat -c %u -- "$ready")" == "$EUID" && \
    "$(stat -c %a -- "$ready")" == 600 && "$(stat -c %h -- "$ready")" == 1 ]] ||
    sc_die "local runtime $kind readiness marker is invalid" 78
  rm -f -- "$ready"
  printf -v "$ready_var" '%s' ""
}

sc_local_runtime_lock_assert() {
  local kind=$1 pid_var pid
  case "$kind" in
    maintenance) pid_var=SC_LOCAL_RUNTIME_MAINTENANCE_LOCK_PID ;;
    lease) pid_var=SC_LOCAL_RUNTIME_LEASE_LOCK_PID ;;
    *) sc_die "internal local runtime lock kind error" 70 ;;
  esac
  pid=${!pid_var}
  [[ -n "$pid" ]] || sc_die "local runtime $kind lock is not held" 70
  kill -0 "$pid" 2>/dev/null || sc_die "local runtime $kind lock holder exited unexpectedly" 75
}

sc_local_runtime_lock_release() {
  local kind=$1 pid_var ready_var pid ready
  case "$kind" in
    maintenance) pid_var=SC_LOCAL_RUNTIME_MAINTENANCE_LOCK_PID; ready_var=SC_LOCAL_RUNTIME_MAINTENANCE_LOCK_READY ;;
    lease) pid_var=SC_LOCAL_RUNTIME_LEASE_LOCK_PID; ready_var=SC_LOCAL_RUNTIME_LEASE_LOCK_READY ;;
    *) return 0 ;;
  esac
  pid=${!pid_var}; ready=${!ready_var}
  [[ -z "$ready" ]] || rm -f -- "$ready" 2>/dev/null || true
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  printf -v "$pid_var" '%s' ""
  printf -v "$ready_var" '%s' ""
}

sc_local_runtime_release_lease() {
  sc_local_runtime_lock_release lease
}

sc_local_runtime_resolve_backend() {
  local requested=$1
  case "$requested" in
    cpu|cuda) printf '%s\n' "$requested" ;;
    auto)
      if command -v nvidia-smi >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 &&
        timeout 8s nvidia-smi -L >/dev/null 2>&1; then
        printf 'cuda\n'
      else
        printf 'cpu\n'
      fi
      ;;
    *) sc_die "local runtime backend must be auto, cuda, or cpu" 64 ;;
  esac
}

sc_local_runtime_channel_clear_applied() {
  if (( ! SC_LOCAL_RUNTIME_CHANNEL_APPLIED )); then
    # Also release a lease acquired before channel metadata could be committed.
    sc_local_runtime_release_lease
    return 0
  fi
  [[ "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" == "$SC_LOCAL_RUNTIME_CHANNEL_BIN" &&
     "${SANDCODEX_LOCAL_NIXPKGS_REV:-}" == "$SC_LOCAL_RUNTIME_CHANNEL_REV" ]] ||
    sc_die "active local runtime selection changed during launch" 78
  unset SANDCODEX_LOCAL_OLLAMA_BIN SANDCODEX_LOCAL_NIXPKGS_REV
  SC_LOCAL_RUNTIME_CHANNEL_APPLIED=0
  SC_LOCAL_RUNTIME_CHANNEL_BIN=""
  SC_LOCAL_RUNTIME_CHANNEL_REV=""
  sc_local_runtime_release_lease
}

sc_local_runtime_channel_apply() {
  local backend=$1 root result rc=0 executable pin stage
  (( ! SC_LOCAL_RESUME_BOUND && ! SC_LOCAL_RUNTIME_MAINTENANCE && ! SC_LOCAL_RUNTIME_USER_OVERRIDE )) || return 0
  sc_local_runtime_channel_clear_applied
  root=$(sc_local_runtime_root)
  [[ -d "$root" && ! -L "$root" ]] || return 0
  sc_local_runtime_lock_acquire lease shared
  result=$(sc_local_runtime_python resolve --root "$root" --backend "$backend" --optional) || rc=$?
  (( rc == 0 )) || sc_die "active $backend local runtime channel is invalid" "$rc"
  if [[ "$(jq -er '.result' <<<"$result")" != active ]]; then
    sc_local_runtime_release_lease
    return 0
  fi
  executable=$(jq -er '.current.executable' <<<"$result")
  pin=$(jq -er '.current.nixpkgs_rev' <<<"$result")
  stage=$(jq -er '.current.stage_id' <<<"$result")
  [[ -x "$executable" && "$pin" =~ ^[0-9a-f]{40}$ && "$stage" =~ ^[0-9a-f]{64}$ ]] ||
    sc_die "active local runtime channel resolved unsafe metadata" 78
  export SANDCODEX_LOCAL_OLLAMA_BIN="$executable"
  export SANDCODEX_LOCAL_NIXPKGS_REV="$pin"
  SC_LOCAL_RUNTIME_CHANNEL_APPLIED=1
  SC_LOCAL_RUNTIME_CHANNEL_BIN=$executable
  SC_LOCAL_RUNTIME_CHANNEL_REV=$pin
  sc_note "local · active $backend runtime stage $stage · nixpkgs $pin"
}

sc_local_runtime_render_result() {
  local result=$1
  if (( SC_LOCAL_RUNTIME_JSON )); then
    if jq -e '.result == "status"' <<<"$result" >/dev/null 2>&1; then
      jq -c --arg model "$SC_LOCAL_CUDA_CANDIDATE_MODEL" \
        --argjson context "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" \
        --argjson memory_mib "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB" '
          . + {candidate_models:{local_cuda_gtx1650:{
            model:$model,context_tokens:$context,memory_mib:$memory_mib,
            status:"operator-candidate-until-target-machine-digests-are-qualified"}}}' <<<"$result"
      return
    fi
    printf '%s\n' "$result"
    return
  fi
  case "$(jq -er '.result' <<<"$result")" in
    activated|already_active)
      printf 'local runtime %s: %s\n' "$(jq -r '.backend' <<<"$result")" "$(jq -r '.result' <<<"$result")"
      printf '  stage:    %s\n' "$(jq -r '.stage_id' <<<"$result")"
      printf '  nixpkgs:  %s\n' "$(jq -r '.stage.nixpkgs_rev' <<<"$result")"
      printf '  ollama:   %s\n' "$(jq -r '.stage.provider_version' <<<"$result")"
      printf '  qualified model/context: %s / %s\n' "$(jq -r '.stage.qualified_model' <<<"$result")" "$(jq -r '.stage.context_tokens' <<<"$result")"
      printf '  source digest / profile threads: %s / %s\n' \
        "$(jq -r '.stage.source_model_digest_sha256 // "unrecorded"' <<<"$result")" \
        "$(jq -r '.stage.model_profile_num_thread // "provider-default"' <<<"$result")"
      printf '  server:   %s\n' "$(jq -r '
        if .stage.server_policy == null then "legacy policy unrecorded"
        else (.stage.server_policy |
          "\(.max_loaded_models) model · \(.num_parallel) parallel · queue \(.max_queue) · KV \(.kv_cache_type) · flash \(.flash_attention) · idle \(.keep_alive)")
        end' <<<"$result")"
      ;;
    rolled_back)
      printf 'local runtime %s: rolled back to %s\n' "$(jq -r '.backend' <<<"$result")" "$(jq -r '.stage_id' <<<"$result")"
      printf '  nixpkgs: %s · ollama: %s\n' "$(jq -r '.stage.nixpkgs_rev' <<<"$result")" "$(jq -r '.stage.provider_version' <<<"$result")"
      ;;
    status)
      local backend state
      for backend in cpu cuda; do
        state=$(jq -r --arg backend "$backend" '.channels[$backend].result' <<<"$result")
        if [[ "$state" == none ]]; then
          printf '%s: no active qualified runtime\n' "$backend"
          if [[ "$backend" == cpu ]]; then
            printf '  prepare reference: sandcodex local update %s --cpu\n' "$SC_LOCAL_CPU_REFERENCE_MODEL"
          else
            printf '  probe GTX1650:     sandcodex local probe %s --backend cuda --local-context %s --local-memory-mib %s --local-ollama-bin /path/to/ollama\n' \
              "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
            printf '  activate later:    sandcodex local update %s --backend cuda --local-context %s --local-memory-mib %s\n' \
              "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
          fi
        else
          printf '%s: current %s · nixpkgs %s · ollama %s\n' "$backend" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.stage_id' <<<"$result")" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.nixpkgs_rev' <<<"$result")" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.provider_version' <<<"$result")"
          printf '  model %s · context %s · threads %s\n' \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.qualified_model' <<<"$result")" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.context_tokens' <<<"$result")" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.model_profile_num_thread // "unrecorded"' <<<"$result")"
          printf '  requested tag %s · source digest %s\n' \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.requested_model // "unrecorded"' <<<"$result")" \
            "$(jq -r --arg backend "$backend" '.channels[$backend].current.source_model_digest_sha256 // "unrecorded"' <<<"$result")"
          printf '  server %s\n' "$(jq -r --arg backend "$backend" '
            .channels[$backend].current.server_policy as $policy |
            if $policy == null then "legacy policy unrecorded"
            else ($policy |
              "\(.max_loaded_models) model · \(.num_parallel) parallel · queue \(.max_queue) · KV \(.kv_cache_type) · flash \(.flash_attention) · idle \(.keep_alive)")
            end' <<<"$result")"
          printf '  memory %s\n' "$(jq -r --arg backend "$backend" '
            .channels[$backend].current.memory_budget as $budget |
            if $budget == null then "legacy/unrecorded"
            else ($budget |
              "\(.policy) · max \(.memory_max_mib) MiB · high \(.memory_high_mib // "n/a") MiB · MemAvailable \(.host_memavailable_mib) MiB")
            end' <<<"$result")"
          if jq -e --arg backend "$backend" '.channels[$backend].previous != null' <<<"$result" >/dev/null; then
            printf '  previous %s\n' "$(jq -r --arg backend "$backend" '.channels[$backend].previous.stage_id' <<<"$result")"
          fi
          local requested launch_backend context_arg memory_arg memory_mib
          requested=$(jq -r --arg backend "$backend" '.channels[$backend].current.requested_model // empty' <<<"$result")
          launch_backend=$(sc_local_backend_cli_option "$backend")
          context_arg=$(jq -r --arg backend "$backend" '.channels[$backend].current.context_tokens | " --local-context \(.)"' <<<"$result")
          memory_mib=$(jq -r --arg backend "$backend" '
            .channels[$backend].current.memory_budget as $budget |
            if $budget != null and $budget.policy == "operator-explicit-mib" then ($budget.memory_max_mib|tostring) else empty end' <<<"$result")
          memory_arg=""
          if [[ -n "$memory_mib" ]]; then
            memory_arg=" --local-memory-mib $memory_mib"
          elif [[ "$backend" == cuda && "$requested" == "$SC_LOCAL_CUDA_CANDIDATE_MODEL" ]]; then
            memory_arg=" --local-memory-mib $SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB"
          fi
          if [[ -n "$requested" ]]; then
            printf '  fresh launch: sandcodex local %s %s%s%s\n' "$requested" "$launch_backend" "$context_arg" "$memory_arg"
            printf '  resume:       sandcodex local %s %s%s%s --RESUME\n' "$requested" "$launch_backend" "$context_arg" "$memory_arg"
            printf '  requalify:    sandcodex local update %s %s%s%s --no-pull\n' "$requested" "$launch_backend" "$context_arg" "$memory_arg"
          else
            printf '  fresh launch: sandcodex local MODEL %s%s\n' "$launch_backend" "$context_arg"
            printf '  resume:       sandcodex local MODEL %s%s --RESUME\n' "$launch_backend" "$context_arg"
          fi
        fi
      done
      printf 'project: run local rooms from a specific project directory or pass --project DIR; the home directory is refused\n'
      printf 'local worker: inside an interactive local room, use sandcodex-worker start --name NAME --turns N --prompt TEXT\n'
      printf 'scope: status is per Unix user; active channels affect future fresh local launches only, never bound resumes\n'
      printf 'paste-back diagnostics: sandcodex local report\n'
      ;;
    prune_plan|pruned)
      printf 'local runtime prune: %s\n' "$(jq -r '.result' <<<"$result")"
      printf '  unreachable stages: %s\n' "$(jq -r '.plan.remove_stage_ids|length' <<<"$result")"
      printf '  releasable channel roots: %s\n' "$(jq -r '.plan.remove_gc_roots|length' <<<"$result")"
      printf '  Nix store garbage collection: not run\n'
      ;;
    *) sc_die "local runtime helper returned an unknown result" 78 ;;
  esac
}

sc_local_runtime_host_tools() {
  local tool
  for tool in sed stat id; do
    command -v "$tool" >/dev/null 2>&1 ||
      sc_die "sandcodex local $SC_LOCAL_RUNTIME_ACTION needs host $tool so it can answer without realizing Nix" 69
  done
}

sc_local_runtime_report() {
  local root result="" rc=0 tool value ollama_path ollama_quoted
  root=$(sc_local_runtime_root)
  sc_local_runtime_host_tools
  if sc_local_runtime_json_tools_available; then
    result=$(sc_local_runtime_python status --root "$root") || rc=$?
    (( rc == 0 )) || sc_die "local runtime status failed validation" "$rc"
  fi

  printf 'sandcodex local report\n'
  printf 'generated: %s\n' "$(sc_now)"
  printf 'sandcodex: %s · artifact %s\n' "$SC_VERSION" "$(sc_artifact_sha256)"
  printf 'host: %s · %s\n' "$(uname -srm)" "$(uname -n 2>/dev/null || printf unknown)"
  if [[ -r /proc/meminfo && -n "$(command -v awk 2>/dev/null || true)" ]]; then
    awk '
      /^MemTotal:/ {total=int($2/1024)}
      /^MemAvailable:/ {avail=int($2/1024)}
      END {
        if (total || avail) printf "memory: MemTotal %s MiB · MemAvailable %s MiB\n", total, avail
      }' /proc/meminfo
  else
    printf 'memory: /proc/meminfo unavailable\n'
  fi
  for tool in nix python3 jq ollama nvidia-smi; do
    if command -v "$tool" >/dev/null 2>&1; then
      value=$(command -v "$tool")
      printf '%s: %s\n' "$tool" "$value"
    else
      printf '%s: missing\n' "$tool"
    fi
  done
  if command -v nix >/dev/null 2>&1 && command -v sed >/dev/null 2>&1; then
    nix --version 2>/dev/null | sed 's/^/nix-version: /' || true
  fi
  if command -v python3 >/dev/null 2>&1 && command -v sed >/dev/null 2>&1; then
    python3 --version 2>&1 | sed 's/^/python-version: /' || true
  fi
  if command -v jq >/dev/null 2>&1 && command -v sed >/dev/null 2>&1; then
    jq --version 2>&1 | sed 's/^/jq-version: /' || true
  fi
  if command -v ollama >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 && command -v sed >/dev/null 2>&1; then
    timeout 5s ollama --version 2>&1 | sed 's/^/ollama-version: /' || true
  fi
  if command -v nvidia-smi >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 && command -v sed >/dev/null 2>&1; then
    timeout 8s nvidia-smi -L 2>&1 | sed 's/^/nvidia-gpu: /' || true
    timeout 8s nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>&1 |
      sed 's/^/nvidia-query: /' || true
  fi

  printf '\nlocal runtime channels:\n'
  if [[ -n "$result" ]]; then
    sc_local_runtime_render_result "$result"
  else
    sc_local_runtime_status_print_shell
  fi

  printf '\nGTX1650 first-proof command:\n'
  if command -v ollama >/dev/null 2>&1; then
    ollama_path=$(command -v ollama)
    printf -v ollama_quoted '%q' "$ollama_path"
  else
    ollama_quoted=/absolute/path/to/ollama
  fi
  printf '  sandcodex local probe %s --backend cuda --local-context %s --local-memory-mib %s --local-ollama-bin %s\n' \
    "$SC_LOCAL_CUDA_CANDIDATE_MODEL" "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB" "$ollama_quoted"
  printf 'why: probe proves load/context/protocol without activating a channel and without asking Nix to realize ollama-cuda\n'
  printf 'paste-back: paste this terminal output directly; no redirection or log file required\n'
}

sc_local_runtime_update() {
  local root backend manifest result rc=0 receipt_sha package
  root=$(sc_local_runtime_root)
  sc_ensure_dir "$root" "local runtime channel"
  sc_ensure_dir "$root/roots" "local runtime channel GC roots"
  SC_CONTROL="$SC_GLOBAL/local-runtime-maintenance"
  sc_ensure_dir "$SC_CONTROL" "local runtime maintenance state"
  sc_ensure_dir "$SC_CONTROL/tmp" "local runtime maintenance temporary state"
  SC_LOCAL_RUNTIME_GC_ROOT_DIRECTORY="$root/roots"
  backend=$SC_LOCAL_BACKEND
  # Keep auto intact so the normal managed-startup policy may perform its one
  # bounded CUDA-load-to-CPU retry. The receipt, not inventory alone, decides
  # which backend stage is eligible for activation.
  [[ -z "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" ]] ||
    sc_die "local update activates only Nix-rooted channels; use local probe or direct sandcodex local with --local-ollama-bin" 64
  unset SANDCODEX_LOCAL_OLLAMA_BIN
  export SANDCODEX_LOCAL_NIXPKGS_REV="$SC_LOCAL_RUNTIME_NIXPKGS_REV"
  sc_note "local update · qualifying requested backend $backend at nixpkgs $SC_LOCAL_RUNTIME_NIXPKGS_REV"
  sc_local_provider_validate
  sc_family_prepare_local
  # Activation happens only after the owned qualification server has stopped.
  sc_local_stop_owned_runtime_required "runtime update"
  [[ -n "$SC_LOCAL_STARTUP_RECEIPT" ]] || sc_die "local update produced no startup receipt" 78
  sc_owned_single_file "$SC_LOCAL_STARTUP_RECEIPT" 600 "local update startup receipt"
  receipt_sha=$(sha256sum -- "$SC_LOCAL_STARTUP_RECEIPT" | awk '{print $1}')
  backend=$(jq -er '.runtime_provenance.backend' "$SC_LOCAL_STARTUP_RECEIPT")
  case "$backend" in cpu|cuda) ;; *) sc_die "qualified runtime receipt has an invalid backend" 78 ;; esac
  package="ollama-$backend"
  manifest=$(mktemp "$SC_CONTROL/tmp/runtime-stage.XXXXXXXXXXXX")
  chmod 600 "$manifest"
  jq -e --arg schema sandcodex.local-runtime-stage.v2 --arg package "$package" \
    --arg receipt_sha "$receipt_sha" --arg qualified_at "$(sc_now)" '
      select(.schema=="sandcodex.managed-local-startup.v1" and .result=="startup_checks_passed")
      | select(.runtime_provenance.backend==($package|sub("^ollama-";"")))
      | select(.runtime_provenance.store_output != null and .runtime_provenance.gc_root != null and
               .runtime_provenance.store_output_nar_hash != null and
               .runtime_provenance.closure_paths_sha256 != null and
               .runtime_provenance.full_runtime_closure_rooted == true)
      | select(.runtime_provenance.model_profile_num_thread ==
               (.model_pin.runtime_parameters.num_thread // null))
      | {schema:$schema,
         backend:.runtime_provenance.backend,
         nixpkgs_rev:.runtime_provenance.provider_nixpkgs_rev,
         package:$package,
         executable:.runtime_provenance.executable,
         executable_sha256:.runtime_provenance.executable_sha256,
         store_output:.runtime_provenance.store_output,
         store_output_nar_hash:.runtime_provenance.store_output_nar_hash,
         closure_paths_sha256:.runtime_provenance.closure_paths_sha256,
         gc_root:.runtime_provenance.gc_root,
         provider_version:.runtime_provenance.provider_version,
         requested_model:.requested_model,
         source_model_digest_sha256:(.model_pin.source_digest_sha256 // .model_pin.digest_sha256),
         qualified_model:.verification.model.resolved_name,
         qualified_model_digest_sha256:.verification.model.digest_sha256,
         model_profile_num_thread:(.model_pin.runtime_parameters.num_thread // null),
         server_policy:.runtime_provenance.server_policy,
         memory_budget:.memory_budget,
         context_tokens:.verification.model.context_tokens,
         qualification_sha256:.qualification_sha256,
         startup_receipt_sha256:$receipt_sha,
         qualified_at:$qualified_at}' "$SC_LOCAL_STARTUP_RECEIPT" >"$manifest" ||
    sc_die "qualified runtime receipt could not become a channel stage" 78
  sc_local_runtime_lock_assert maintenance
  result=$(sc_local_runtime_python stage-activate --root "$root" --manifest "$manifest" --timestamp "$(sc_now)") || rc=$?
  rm -f -- "$manifest"
  (( rc == 0 )) || sc_die "qualified local runtime was not activated" "$rc"
  sc_local_runtime_render_result "$result"
}

sc_local_runtime_probe() {
  local receipt_sha backend runtime_model provider_version executable placement context memory_policy memory_max
  SC_CONTROL="$SC_GLOBAL/local-runtime-maintenance"
  sc_ensure_dir "$SC_CONTROL" "local runtime maintenance state"
  sc_ensure_dir "$SC_CONTROL/tmp" "local runtime maintenance temporary state"
  export SANDCODEX_LOCAL_NIXPKGS_REV="$SC_LOCAL_RUNTIME_NIXPKGS_REV"
  if [[ -n "$SC_LOCAL_OLLAMA_BIN_CLI" ]]; then
    export SANDCODEX_LOCAL_OLLAMA_BIN="$SC_LOCAL_OLLAMA_BIN_CLI"
  fi
  if [[ -n "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" ]]; then
    sc_note "local probe · qualifying requested backend $SC_LOCAL_BACKEND with host Ollama ${SANDCODEX_LOCAL_OLLAMA_BIN}"
  else
    sc_note "local probe · qualifying requested backend $SC_LOCAL_BACKEND at nixpkgs $SC_LOCAL_RUNTIME_NIXPKGS_REV"
    if [[ "$SC_LOCAL_BACKEND" == cuda ]]; then
      sc_warn "CUDA probe without --local-ollama-bin may realize nixpkgs#ollama-cuda; use a host/prebuilt Ollama to avoid that build"
    fi
  fi
  sc_local_provider_validate
  sc_family_prepare_local
  sc_local_stop_owned_runtime_required "runtime probe"
  [[ -n "$SC_LOCAL_STARTUP_RECEIPT" ]] || sc_die "local probe produced no startup receipt" 78
  sc_owned_single_file "$SC_LOCAL_STARTUP_RECEIPT" 600 "local probe startup receipt"
  receipt_sha=$(sha256sum -- "$SC_LOCAL_STARTUP_RECEIPT" | awk '{print $1}')
  if (( SC_LOCAL_RUNTIME_JSON )); then
    jq -c --arg result local_probe_passed --arg receipt_path "$SC_LOCAL_STARTUP_RECEIPT" \
      --arg receipt_sha256 "$receipt_sha" \
      '{schema:"sandcodex.local-runtime-result.v1",result:$result,
        receipt_path:$receipt_path,receipt_sha256:$receipt_sha256,receipt:.}' \
      "$SC_LOCAL_STARTUP_RECEIPT"
    return
  fi
  backend=$(jq -er '.runtime_provenance.backend' "$SC_LOCAL_STARTUP_RECEIPT")
  runtime_model=$(jq -er '.runtime_model' "$SC_LOCAL_STARTUP_RECEIPT")
  provider_version=$(jq -er '.runtime_provenance.provider_version' "$SC_LOCAL_STARTUP_RECEIPT")
  executable=$(jq -er '.runtime_provenance.executable' "$SC_LOCAL_STARTUP_RECEIPT")
  placement=$(jq -er '.verification.runtime.placement' "$SC_LOCAL_STARTUP_RECEIPT")
  context=$(jq -er '.verification.model.context_tokens' "$SC_LOCAL_STARTUP_RECEIPT")
  memory_policy=$(jq -er '.memory_budget.policy' "$SC_LOCAL_STARTUP_RECEIPT")
  memory_max=$(jq -er '.memory_budget.memory_max_mib' "$SC_LOCAL_STARTUP_RECEIPT")
  printf 'local runtime probe: passed\n'
  printf '  backend:       %s\n' "$backend"
  printf '  requested:     %s\n' "$SC_LOCAL_REQUESTED_MODEL"
  printf '  runtime model: %s\n' "$runtime_model"
  printf '  digest:        %s\n' "$SC_LOCAL_MODEL_DIGEST"
  printf '  context:       %s tokens\n' "$context"
  printf '  placement:     %s (provider-reported)\n' "$placement"
  printf '  ollama:        %s · %s\n' "$provider_version" "$executable"
  printf '  memory:        %s · max %s MiB\n' "$memory_policy" "$memory_max"
  printf '  evidence:      %s · sha256 %s\n' "$SC_LOCAL_STARTUP_RECEIPT" "$receipt_sha"
  printf '  activated:     no; this was a proof only\n'
  printf 'paste-back: paste this terminal output directly; no redirection or log file required\n'
}

sc_local_runtime_dispatch() {
  local root result backend rc=0
  root=$(sc_local_runtime_root)
  case "$SC_LOCAL_RUNTIME_ACTION" in
    status)
      sc_local_runtime_host_tools
      if sc_local_runtime_json_tools_available; then
        result=$(sc_local_runtime_python status --root "$root") || rc=$?
        (( rc == 0 )) || sc_die "local runtime status failed validation" "$rc"
        sc_local_runtime_render_result "$result"
      else
        result=$(sc_local_runtime_status_shell_json)
        if (( SC_LOCAL_RUNTIME_JSON )); then
          printf '%s\n' "$result"
        else
          sc_local_runtime_status_print_shell "$result"
        fi
      fi
      ;;
    report)
      sc_local_runtime_report
      ;;
    rollback)
      sc_local_runtime_lock_acquire maintenance exclusive
      backend=$(sc_local_runtime_resolve_backend "$SC_LOCAL_BACKEND")
      result=$(sc_local_runtime_python rollback --root "$root" --backend "$backend" --timestamp "$(sc_now)") || rc=$?
      (( rc == 0 )) || sc_die "local runtime rollback could not be completed" "$rc"
      sc_local_runtime_render_result "$result"
      ;;
    update)
      sc_local_runtime_lock_acquire maintenance exclusive
      sc_local_runtime_update
      ;;
    probe)
      sc_local_runtime_lock_acquire maintenance exclusive
      sc_local_runtime_probe
      ;;
    prune)
      if [[ ! -d "$root" || -L "$root" ]]; then
        local -a absent_args=(prune --root "$root" --optional)
        (( ! SC_LOCAL_RUNTIME_PRUNE_DRY_RUN )) || absent_args+=(--dry-run)
        result=$(sc_local_runtime_python "${absent_args[@]}") || rc=$?
      else
        sc_local_runtime_lock_acquire maintenance exclusive
        if (( ! SC_LOCAL_RUNTIME_PRUNE_DRY_RUN )); then
          sc_local_runtime_lock_acquire lease exclusive
        fi
        local -a prune_args=(prune --root "$root")
        (( ! SC_LOCAL_RUNTIME_PRUNE_DRY_RUN )) || prune_args+=(--dry-run)
        result=$(sc_local_runtime_python "${prune_args[@]}") || rc=$?
      fi
      (( rc == 0 )) || sc_die "local runtime prune could not be completed" "$rc"
      sc_local_runtime_render_result "$result"
      ;;
    *) sc_die "internal local runtime action error" 70 ;;
  esac
}

# Explicit project-scoped managed-local conversation retirement.
# This does not delete native Codex history and does not run Nix GC.

sc_local_retire_help() {
  cat <<'EOF'
Sandcodex managed-local conversation retirement

  sandcodex local retire SESSION_UUID [--dry-run] [--json] [--project DIR]

After the native Codex thread has been hard-deleted, record an immutable
retirement authorization. The original provider binding is retained. Active and
archived Codex rollout trees are both checked; archive is not deletion.

Project runtime roots are keyed by runtime identity and can be shared by several
conversations. The root is released only for the last completed reference; it is
retained when another bound or unbound established local thread may need it.
This command never deletes history, model blobs, Nix store paths, or another
conversation's required root, and it never runs Nix garbage collection.
EOF
}

sc_parse_local_retire() {
  SC_HELP_TOPIC=local
  SC_COMMAND=local-retire
  SC_LOCAL_RETIRE_DRY_RUN=0
  SC_LOCAL_RETIRE_JSON=0
  case "${1:-}" in
    ''|-h|--help|help) sc_local_retire_help; exit 0 ;;
  esac
  [[ "$1" != -* ]] || sc_usage_error "sandcodex local retire requires SESSION_UUID before options"
  SC_LOCAL_RETIRE_THREAD=$1
  [[ "$SC_LOCAL_RETIRE_THREAD" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] ||
    sc_usage_error "local retire SESSION_UUID must be a canonical UUID"
  shift
  while (( $# )); do
    case "$1" in
      --dry-run) SC_LOCAL_RETIRE_DRY_RUN=1; shift ;;
      --json) SC_LOCAL_RETIRE_JSON=1; shift ;;
      --project)
        (( $# > 1 )) || sc_usage_error "--project requires a directory"
        [[ -z "${SC_PROJECT_ARG:-}" ]] || sc_usage_error "--project may be supplied only once"
        SC_PROJECT_ARG=$2; shift 2 ;;
      --project=*)
        [[ -z "${SC_PROJECT_ARG:-}" ]] || sc_usage_error "--project may be supplied only once"
        SC_PROJECT_ARG=${1#*=}; [[ -n "$SC_PROJECT_ARG" ]] || sc_usage_error "--project requires a directory"; shift ;;
      -h|--help|help) sc_local_retire_help; exit 0 ;;
      --) shift; (( $# == 0 )) || sc_usage_error "local retire accepts no Codex arguments" ;;
      *) sc_usage_error "unknown local retire option: $1" ;;
    esac
  done
}

sc_local_retire_render_result() {
  local result=$1 status
  if (( SC_LOCAL_RETIRE_JSON )); then
    printf '%s\n' "$result"
    return
  fi
  status=$(jq -er '.result' <<<"$result")
  case "$status" in
    retirement_plan)
      printf 'local conversation retirement plan: %s\n' "$(jq -r '.thread_id' <<<"$result")"
      printf '  native active/archive history: absent\n'
      if ! jq -e '.gc_root_release_required' <<<"$result" >/dev/null; then
        printf '  project runtime root: none (non-Nix runtime)\n'
      elif jq -e '.gc_root_release_authorized' <<<"$result" >/dev/null; then
        printf '  release project runtime root: %s\n' "$(jq -r '.gc_root' <<<"$result")"
      else
        printf '  retain shared project runtime root: %s\n' "$(jq -r '.gc_root' <<<"$result")"
        printf '  still referenced by: %s\n' "$(jq -r '.retained_for_thread_ids | join(", ")' <<<"$result")"
      fi
      printf '  binding preserved: yes · Nix garbage collection: not run\n'
      ;;
    retired|already_retired)
      printf 'local conversation %s: %s\n' "$(jq -r '.thread_id' <<<"$result")" "$status"
      case "$(jq -r '.gc_root_state' <<<"$result")" in
        released) printf '  project runtime root released: %s\n' "$(jq -r '.gc_root' <<<"$result")" ;;
        already-absent) printf '  project runtime root: already absent before completion\n' ;;
        retained-shared)
          printf '  project runtime root retained for: %s\n' "$(jq -r '.retained_for_thread_ids | join(", ")' <<<"$result")" ;;
        not-applicable) printf '  project runtime root: not applicable (non-Nix runtime)\n' ;;
        *) sc_die "local retirement helper returned an invalid root disposition" 78 ;;
      esac
      printf '  immutable provider binding preserved\n'
      printf '  Nix store garbage collection: not run\n'
      ;;
    *) sc_die "local retirement helper returned an unknown result" 78 ;;
  esac
}

sc_local_retire_dispatch() {
  local result rc=0
  [[ -d "$SC_CONTROL" && ! -L "$SC_CONTROL" ]] ||
    sc_die "this project has no existing Sandcodex control state to retire" 66
  sc_no_symlink_components "$SC_CONTROL" "project control state"
  sc_validate_project_control_state
  sc_family_install_session_tools
  sc_family_binding_state_dirs
  SC_LOCAL_RETIRE_TOOL="$SC_CONTROL/local-retire.py"
  sc_emit_local_retire | sc_atomic "$SC_LOCAL_RETIRE_TOOL" 700

  # Serialize project-root release against update/rollback/prune lifecycle work.
  # The project lock already excludes another cooperating launch in this project.
  sc_local_runtime_lock_acquire maintenance exclusive
  local -a args=(
    --thread-id "$SC_LOCAL_RETIRE_THREAD"
    --project "$SC_PROJECT"
    --binding-helper "$SC_SESSION_BINDING_TOOL"
    --selector-helper "$SC_SESSION_SELECTOR_TOOL"
    --bindings "$SC_SESSION_BINDING_DIRECTORY"
    --retirements "$SC_SESSION_BINDING_RETIREMENT_DIRECTORY"
    --receipts "$SC_SESSION_BINDING_RETIREMENT_RECEIPT_DIRECTORY"
    --sessions "$SC_CONTROL/codex-home/sessions"
    --archived-sessions "$SC_CONTROL/codex-home/archived_sessions"
    --runtime-roots "$SC_CONTROL/local-runtime-roots"
    --timestamp "$(sc_now)"
  )
  (( ! SC_LOCAL_RETIRE_DRY_RUN )) || args+=(--dry-run)
  result=$(python3 -P "$SC_LOCAL_RETIRE_TOOL" "${args[@]}") || rc=$?
  (( rc == 0 )) || sc_die "managed-local conversation retirement was refused" "$rc"
  sc_local_retire_render_result "$result"
}

sc_family_prepare_inference() {
  [[ "$SC_COMMAND" == run || "$SC_COMMAND" == loop ]] || return 0
  sc_family_select_resume
  if [[ "$SC_PROVIDER_MODE" != gpt && "$SC_PROVIDER_MODE" != gemini ]]; then
    (( SC_AGENT_POLICY_EXPLICIT )) || SC_SUBAGENTS=0
  fi
  if [[ "$SC_PROVIDER_MODE" == remote ]]; then
    [[ -z "$SC_LOCAL_PROVIDER" ]] || sc_die "remote/local provider collision" 64
    sc_family_prepare_remote
  elif [[ "$SC_PROVIDER_MODE" == gemini ]]; then
    [[ -z "$SC_LOCAL_PROVIDER" ]] || sc_die "Gemini/local provider collision" 64
    sc_family_prepare_gemini
  elif [[ "$SC_PROVIDER_MODE" == local ]]; then
    sc_local_provider_validate
    sc_family_prepare_local
  fi
  sc_family_prepare_session_binding
}

sc_emit_session_selector() {
  cat <<'SANDCODEX_SESSION_SELECTOR_PY'
#!/usr/bin/env python3
"""Read-only, project-scoped native Codex identity-prefix selector.

Codex—not Sandcodex—owns native transcript parsing, repair, and continuation.
This adapter reads only enough of a rollout's bounded prefix to identify a newly
established alternate-provider conversation or route an explicitly requested
alternate-provider resume. It never scans the conversation body, and standard
output contains metadata only, never message text.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import uuid

MAX_FILES = 10000
MAX_LINE_BYTES = 4 * 1024 * 1024
MAX_IDENTITY_PREFIX_BYTES = 16 * 1024 * 1024
MAX_ORDINAL = (1 << 64) - 1
ALLOWED_ROLLOUT_TYPES = frozenset({
    "session_meta",
    "response_item",
    "inter_agent_communication",
    "inter_agent_communication_metadata",
    "compacted",
    "turn_context",
    "token_usage_record",
    "world_state",
    "security_risk_score",
    "event_msg",
    "realtime_item",
})
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")


class SelectionError(Exception):
    pass


def timestamp(value: object, label: str) -> float:
    if not isinstance(value, str):
        raise SelectionError(f"{label} is missing or not a string")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            raise ValueError("timezone is required")
        return parsed.timestamp()
    except (ValueError, OverflowError, OSError):
        raise SelectionError(f"{label} is not a supported timezone-aware timestamp") from None


def safe_directory(path: Path) -> bool:
    try:
        st = path.lstat()
        return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and not st.st_mode & 0o022
    except OSError:
        return False


def valid_ordinal(value: object, label: str) -> int:
    if type(value) is not int or not 0 <= value <= MAX_ORDINAL:
        raise SelectionError(f"{label} is not a supported nonnegative ordinal")
    return value


def validate_history_base(value: object) -> dict | None:
    if value is None:
        return None
    if not isinstance(value, dict) or set(value) != {"thread_id", "end_ordinal_exclusive", "end_byte_offset"}:
        raise SelectionError("paginated history_base has an unsupported shape")
    try:
        thread_id = str(uuid.UUID(value["thread_id"]))
    except (ValueError, TypeError, AttributeError):
        raise SelectionError("paginated history_base thread ID is invalid") from None
    end_ordinal = valid_ordinal(value["end_ordinal_exclusive"], "paginated history_base end")
    end_offset = value["end_byte_offset"]
    if type(end_offset) is not int or end_offset < 0:
        raise SelectionError("paginated history_base byte offset is invalid")
    return {
        "thread_id": thread_id,
        "end_ordinal_exclusive": end_ordinal,
        "end_byte_offset": end_offset,
    }


def zstd_executable() -> str:
    executable = shutil.which("zstd")
    if not executable or not os.path.isabs(executable) or not os.access(executable, os.X_OK):
        raise SelectionError("compressed native rollout requires pinned zstd support")
    return executable


def read_rollout(
    path: Path,
    project: Path,
) -> tuple[dict | None, int]:
    """Read one safe rollout identity prefix and return metadata plus bytes scanned."""
    compressed = path.name.endswith(".jsonl.zst")
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    process: subprocess.Popen[bytes] | None = None
    stream = None
    normal_end = False
    returncode: int | None = None
    total = 0
    unrelated = False
    result: dict | None = None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_mode & 0o022:
            raise SelectionError("unsafe session file metadata")
        activity_hint = st.st_mtime_ns / 1_000_000_000

        if compressed:
            try:
                process = subprocess.Popen(
                    [zstd_executable(), "-q", "-d", "-c"],
                    stdin=fd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    close_fds=True,
                )
            except OSError as exc:
                raise SelectionError("could not start pinned zstd for compressed native rollout") from exc
            os.close(fd)
            fd = -1
            if process.stdout is None:
                raise SelectionError("pinned zstd did not expose a readable stream")
            stream = process.stdout
        else:
            stream = os.fdopen(fd, "rb")
            fd = -1

        meta = None
        provider = None
        model = None
        context = None
        activity = None
        observed = False
        physical_line = 0
        complete_records = 0
        history_mode = None
        history_base = None
        first_ordinal = None
        last_ordinal = None
        next_ordinal = None
        torn_tail_ignored = False
        while True:
            line = stream.readline(MAX_LINE_BYTES + 1)
            if not line:
                normal_end = True
                break
            physical_line += 1
            total += len(line)
            if len(line) > MAX_LINE_BYTES:
                raise SelectionError("session record exceeds bounded line limit")
            if total > MAX_IDENTITY_PREFIX_BYTES:
                raise SelectionError("session identity prefix exceeds the bounded adapter limit")
            if not line.endswith(b"\n"):
                # A final unterminated record is not part of the durable JSONL prefix.
                torn_tail_ignored = True
                normal_end = True
                break
            if not line.strip():
                raise SelectionError(f"blank complete native rollout record at line {physical_line}")
            complete_records += 1
            try:
                entry = json.loads(line)
            except (ValueError, UnicodeError):
                raise SelectionError(
                    f"invalid complete JSONL record at line {physical_line}; transcript was not modified"
                ) from None
            if not isinstance(entry, dict):
                raise SelectionError(f"invalid native rollout record at line {physical_line}")

            kind = entry.get("type")
            if kind not in ALLOWED_ROLLOUT_TYPES:
                raise SelectionError(f"unknown native rollout record type at line {physical_line}")
            payload = entry.get("payload")
            if not isinstance(payload, dict):
                raise SelectionError(f"invalid native rollout payload at line {physical_line}")
            entry_time = timestamp(entry.get("timestamp"), f"native rollout timestamp at line {physical_line}")
            if complete_records == 1:
                if kind != "session_meta":
                    raise SelectionError("rollout does not begin with session metadata")
                raw_mode = payload.get("history_mode", "legacy")
                if raw_mode not in ("legacy", "paginated"):
                    raise SelectionError("unknown native thread history mode")
                history_mode = raw_mode
                history_base = validate_history_base(payload.get("history_base"))
                if history_mode == "legacy":
                    if history_base is not None:
                        raise SelectionError("legacy history cannot declare a history_base")
                    if "ordinal" in entry:
                        raise SelectionError("legacy rollout unexpectedly contains an ordinal")
                else:
                    expected_start = history_base["end_ordinal_exclusive"] if history_base else 0
                    ordinal = valid_ordinal(entry.get("ordinal"), "paginated session metadata ordinal")
                    if ordinal != expected_start:
                        raise SelectionError(
                            f"paginated rollout begins at ordinal {ordinal}, expected {expected_start}"
                        )
                    first_ordinal = ordinal
                    last_ordinal = ordinal
                    next_ordinal = ordinal + 1
            elif history_mode == "legacy":
                if "ordinal" in entry:
                    raise SelectionError(
                        f"legacy rollout unexpectedly contains an ordinal at line {physical_line}"
                    )
            elif history_mode == "paginated":
                ordinal = valid_ordinal(entry.get("ordinal"), f"paginated rollout ordinal at line {physical_line}")
                assert next_ordinal is not None
                if ordinal != next_ordinal:
                    if ordinal == last_ordinal:
                        problem = "duplicate"
                    elif ordinal < next_ordinal:
                        problem = "regressed"
                    else:
                        problem = "gapped"
                    raise SelectionError(
                        f"paginated rollout has a {problem} ordinal at line {physical_line}: "
                        f"expected {next_ordinal}, got {ordinal}"
                    )
                last_ordinal = ordinal
                if ordinal == MAX_ORDINAL:
                    raise SelectionError("paginated rollout has exhausted the supported u64 ordinal space")
                next_ordinal = ordinal + 1
            else:
                raise SelectionError("rollout history mode was not established")

            if kind == "session_meta":
                if meta is not None:
                    raise SelectionError("duplicate session metadata")
                meta = payload
                provider = payload.get("model_provider")
                cwd = payload.get("cwd")
                if not isinstance(cwd, str) or not os.path.isabs(cwd) or Path(cwd).resolve() != project:
                    unrelated = True
                    break
                # Interactive frontends persist source=cli; `codex exec` and
                # `codex exec resume` persist source=exec. Both are primary
                # user-owned threads when no parent is present. Campaign and
                # loop continuation must be bindable without admitting native
                # subagent histories.
                if payload.get("source") not in ("cli", "exec") or payload.get("parent_thread_id"):
                    unrelated = True
                    break
                if payload.get("thread_source") not in (None, "user"):
                    unrelated = True
                    break
                subagent_start = payload.get("subagent_history_start_ordinal")
                if subagent_start is not None:
                    valid_ordinal(subagent_start, "subagent inherited-history boundary")
                    raise SelectionError("top-level project resume does not accept subagent inherited history")
            elif kind == "event_msg" and payload.get("type") == "thread_rolled_back":
                raise SelectionError("rolled-back history requires native adapter review")
            elif kind == "event_msg" and payload.get("type") == "thread_settings_applied":
                if meta is None:
                    raise SelectionError("thread settings precede session metadata")
                owner = payload.get("thread_id")
                if owner not in (None, meta.get("id")):
                    continue
                settings = payload.get("thread_settings")
                if not isinstance(settings, dict):
                    raise SelectionError("invalid durable thread settings")
                provider = settings.get("model_provider_id")
                candidate = settings.get("model")
                if not isinstance(candidate, str) or not MODEL.fullmatch(candidate):
                    raise SelectionError("invalid model in durable thread settings")
                model = candidate
            elif kind == "turn_context":
                candidate = payload.get("model")
                if isinstance(candidate, str) and MODEL.fullmatch(candidate):
                    model = candidate
                n = payload.get("model_context_window")
                if type(n) is int and 4096 <= n <= 262144 and n % 1024 == 0:
                    context = n
            elif kind == "event_msg" and payload.get("type") in ("user_message", "agent_message"):
                observed = True
                activity = entry_time if activity is None else max(activity, entry_time)
            elif (
                kind == "response_item"
                and payload.get("type") == "message"
                and payload.get("role") in ("user", "assistant")
            ):
                observed = True
                activity = entry_time if activity is None else max(activity, entry_time)

            # Provider identity is fixed at launch. Once one durable user/agent
            # event and the first model context have appeared, later transcript
            # bytes are Codex's concern and may be arbitrarily large.
            if meta is not None and observed and model is not None:
                break

        if unrelated:
            result = None
        elif meta is None or not observed or activity is None:
            result = None
        else:
            try:
                sid = str(uuid.UUID(meta["id"]))
            except (ValueError, KeyError, TypeError, AttributeError):
                raise SelectionError("invalid native session UUID") from None
            if not isinstance(provider, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,96}", provider):
                raise SelectionError("session provider is missing/unsupported; refusing to guess GPT or cloud")
            if history_mode not in ("legacy", "paginated"):
                raise SelectionError("session history mode is missing")
            if history_mode == "paginated" and last_ordinal == MAX_ORDINAL:
                raise SelectionError("paginated rollout has exhausted the supported u64 ordinal space")
            result = {
                "id": sid,
                "project": str(project),
                "provider": provider,
                "model": model,
                "context_tokens": context,
                "last_activity": activity,
                "history": {
                    "mode": history_mode,
                    "storage": "zstd" if compressed else "plain",
                    "history_base": history_base,
                    "first_ordinal": first_ordinal,
                    "last_ordinal": last_ordinal,
                    "complete_records": complete_records,
                    "torn_tail_ignored": torn_tail_ignored,
                    "integrity": "validated-identity-prefix",
                },
            }
            result["last_activity"] = max(activity, activity_hint)
    finally:
        if fd >= 0:
            os.close(fd)
        if stream is not None:
            stream.close()
        if process is not None:
            if not normal_end and process.poll() is None:
                process.terminate()
            try:
                returncode = process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                returncode = process.wait(timeout=5)
    if compressed and normal_end and returncode != 0:
        raise SelectionError("compressed native rollout failed zstd integrity validation")
    return result, total

def list_sessions(root: Path, project: Path, provider: str | None = None, *, allow_missing: bool = False) -> list[dict]:
    root = root.absolute()
    project = project.resolve(strict=True)
    if not project.is_dir():
        raise SelectionError("project must be a directory")
    for path in (root, *root.parents):
        if path.is_symlink():
            raise SelectionError("session root contains a symlink")
    if not root.exists():
        if allow_missing:
            return []
        raise FileNotFoundError("no saved conversation in this project")
    if not safe_directory(root):
        raise SelectionError("unsafe session directory")
    selected: list[dict] = []
    seen_ids: set[str] = set()
    count = 0
    for directory, dirs, files in os.walk(root, followlinks=False):
        here = Path(directory)
        for name in dirs:
            if not safe_directory(here / name):
                raise SelectionError("unsafe directory inside native session tree")
        plain_names = {name for name in files if name.endswith(".jsonl")}
        logical_files = list(plain_names)
        logical_files.extend(
            name for name in files
            if name.endswith(".jsonl.zst") and name[:-4] not in plain_names
        )
        for name in sorted(logical_files):
            path = here / name
            count += 1
            if count > MAX_FILES:
                raise SelectionError("project history exceeds bounded scan limits")
            try:
                item, _consumed = read_rollout(path, project)
            except SelectionError as exc:
                raise SelectionError(f"unsafe native rollout {name!r}: {exc}") from None
            if item is None:
                continue
            if item["id"] in seen_ids:
                raise SelectionError("duplicate native thread ID; review possible revert/history migration")
            seen_ids.add(item["id"])
            if provider and item["provider"] != provider:
                continue
            selected.append(item)
    selected.sort(key=lambda item: (item["last_activity"], item["id"]), reverse=True)
    return selected


def snapshot(root: Path, project: Path) -> dict:
    project = project.resolve(strict=True)
    return {
        "schema": "sandcodex.project-sessions.v1",
        "project": str(project),
        "sessions": list_sessions(root, project, allow_missing=True),
    }


def select(root: Path, project: Path, session_id: str | None = None, provider: str | None = None) -> dict:
    expected_id = str(uuid.UUID(session_id)) if session_id else None
    selected = [
        item for item in list_sessions(root, project, provider)
        if expected_id is None or item["id"] == expected_id
    ]
    if not selected:
        raise FileNotFoundError("no matching established conversation in this project")
    # This adapter routes only explicitly selected alternate providers. File
    # activity orders candidate identities; the immutable per-thread binding is
    # the authority for the provider/model/runtime actually restored.
    if len(selected) > 1 and selected[0]["last_activity"] == selected[1]["last_activity"] and not session_id:
        raise SelectionError("latest conversation is ambiguous; use --RESUME=SESSION_UUID")
    return {"schema": "sandcodex.project-resume.v2", **selected[0]}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sessions", required=True, type=Path)
    parser.add_argument("--project", required=True, type=Path)
    parser.add_argument("--id")
    parser.add_argument("--provider")
    parser.add_argument("--all", action="store_true", help="emit a metadata-only project snapshot, including an empty snapshot")
    args = parser.parse_args()
    if args.all and (args.id or args.provider):
        parser.error("--all cannot be combined with --id or --provider")
    try:
        result = snapshot(args.sessions, args.project) if args.all else select(args.sessions, args.project, args.id, args.provider)
    except FileNotFoundError as exc:
        print(f"sandcodex resume: {exc}; no fresh conversation was started", file=sys.stderr)
        return 66
    except (SelectionError, OSError, ValueError) as exc:
        print(f"sandcodex resume: {exc}; no fresh conversation was started", file=sys.stderr)
        return 78
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_SESSION_SELECTOR_PY
}

sc_emit_session_picker() {
  cat <<'SANDCODEX_SESSION_PICKER_PY'
#!/usr/bin/env python3
"""Interactive, metadata-only chooser for one canonical project's Codex sessions.

Input is the bounded identity snapshot produced by the read-only session
selector. Human interaction uses /dev/tty so stdout remains a single
machine-readable selection record. The caller must reselect the UUID and verify
its immutable alternate-provider binding before starting any provider.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import sys
import uuid
from typing import TextIO

MAX_INPUT_BYTES = 32 * 1024 * 1024
DEFAULT_PAGE_SIZE = 12
MAX_SESSIONS = 10_000
REMOTE_PROVIDER = re.compile(r"scr_[0-9a-f]{64}\Z")
GEMINI_PROVIDER = re.compile(r"scg_[0-9a-f]{64}\Z")
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")
SUPPORTED_HISTORY_MODES = frozenset({"legacy", "paginated"})
SUPPORTED_HISTORY_STORAGE = frozenset({"plain", "zstd"})
SNAPSHOT_KEYS = frozenset({"schema", "project", "sessions"})
SESSION_KEYS = frozenset({
    "id", "project", "provider", "model", "context_tokens", "last_activity", "history"
})
HISTORY_KEYS = frozenset({
    "mode", "storage", "history_base", "first_ordinal", "last_ordinal",
    "complete_records", "torn_tail_ignored", "integrity",
})


class PickerError(Exception):
    """Snapshot or selection cannot be handled safely."""


class PickerCancelled(Exception):
    """The human declined to select a conversation."""


def canonical_uuid(value: object, label: str = "session UUID") -> str:
    if not isinstance(value, str):
        raise PickerError(f"{label} is not a string")
    try:
        result = str(uuid.UUID(value))
    except (ValueError, TypeError, AttributeError):
        raise PickerError(f"{label} is invalid") from None
    if value != result:
        raise PickerError(f"{label} is not canonical")
    return result


def canonical_project(value: object) -> str:
    if not isinstance(value, str) or not os.path.isabs(value):
        raise PickerError("snapshot project is not an absolute path")
    path = Path(value)
    try:
        resolved = str(path.resolve(strict=True))
    except OSError as exc:
        raise PickerError("snapshot project is unavailable") from exc
    if not path.is_dir() or value != resolved:
        raise PickerError("snapshot project is not canonical")
    return resolved


def provider_mode(provider: object) -> str | None:
    if provider == "openai":
        return "gpt"
    if provider == "ollama":
        return "local"
    if isinstance(provider, str) and REMOTE_PROVIDER.fullmatch(provider):
        return "remote"
    if isinstance(provider, str) and GEMINI_PROVIDER.fullmatch(provider):
        return "gemini"
    return None


def validate_history(value: object) -> dict:
    if not isinstance(value, dict) or set(value) != HISTORY_KEYS:
        raise PickerError("session history metadata has an unsupported shape")
    mode = value.get("mode")
    storage = value.get("storage")
    if mode not in SUPPORTED_HISTORY_MODES or storage not in SUPPORTED_HISTORY_STORAGE:
        raise PickerError("session history mode or storage is unsupported")
    if value.get("integrity") != "validated-identity-prefix":
        raise PickerError("session history lacks validated identity-prefix evidence")
    complete = value.get("complete_records")
    if type(complete) is not int or complete < 1:
        raise PickerError("session history record count is invalid")
    if type(value.get("torn_tail_ignored")) is not bool:
        raise PickerError("session torn-tail evidence is invalid")
    first = value.get("first_ordinal")
    last = value.get("last_ordinal")
    if mode == "legacy":
        if first is not None or last is not None or value.get("history_base") is not None:
            raise PickerError("legacy history contains paginated metadata")
    else:
        if type(first) is not int or type(last) is not int or first < 0 or last < first:
            raise PickerError("paginated history ordinal range is invalid")
        base = value.get("history_base")
        if base is not None:
            expected = {"thread_id", "end_ordinal_exclusive", "end_byte_offset"}
            if not isinstance(base, dict) or set(base) != expected:
                raise PickerError("paginated history base is invalid")
            canonical_uuid(base.get("thread_id"), "history-base thread UUID")
            end_ordinal = base.get("end_ordinal_exclusive")
            end_offset = base.get("end_byte_offset")
            if type(end_ordinal) is not int or end_ordinal < 0 or end_ordinal != first:
                raise PickerError("paginated history-base ordinal is invalid")
            if type(end_offset) is not int or end_offset < 0:
                raise PickerError("paginated history-base byte offset is invalid")
    return value


def validate_session(value: object, project: str) -> dict:
    if not isinstance(value, dict) or set(value) != SESSION_KEYS:
        raise PickerError("session metadata has an unsupported shape")
    session_id = canonical_uuid(value.get("id"))
    if value.get("project") != project:
        raise PickerError("session belongs to a different project")
    provider = value.get("provider")
    if not isinstance(provider, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,96}", provider):
        raise PickerError("session provider is invalid")
    model = value.get("model")
    if model is not None and (not isinstance(model, str) or not MODEL.fullmatch(model)):
        raise PickerError("session model is invalid")
    context = value.get("context_tokens")
    if context is not None and (
        type(context) is not int or context < 4096 or context > 262_144 or context % 1024
    ):
        raise PickerError("session context is invalid")
    activity = value.get("last_activity")
    if isinstance(activity, bool) or not isinstance(activity, (int, float)):
        raise PickerError("session activity timestamp is invalid")
    activity = float(activity)
    try:
        rendered = dt.datetime.fromtimestamp(activity, tz=dt.timezone.utc)
    except (ValueError, OverflowError, OSError):
        raise PickerError("session activity timestamp is unsupported") from None
    history = validate_history(value.get("history"))
    return {
        "id": session_id,
        "project": project,
        "provider": provider,
        "mode": provider_mode(provider),
        "model": model,
        "context_tokens": context,
        "last_activity": activity,
        "activity_utc": rendered.strftime("%Y-%m-%d %H:%M:%SZ"),
        "history": history,
    }


def load_snapshot(stream: TextIO, expected_project: str | None = None) -> tuple[str, list[dict]]:
    raw = stream.buffer.read(MAX_INPUT_BYTES + 1) if hasattr(stream, "buffer") else stream.read(MAX_INPUT_BYTES + 1)
    if isinstance(raw, str):
        raw = raw.encode("utf-8")
    if len(raw) > MAX_INPUT_BYTES:
        raise PickerError("project session snapshot exceeds the picker input limit")
    try:
        value = json.loads(raw)
    except (ValueError, UnicodeError):
        raise PickerError("project session snapshot is not valid JSON") from None
    if not isinstance(value, dict) or set(value) != SNAPSHOT_KEYS:
        raise PickerError("project session snapshot has an unsupported shape")
    if value.get("schema") != "sandcodex.project-sessions.v1":
        raise PickerError("project session snapshot schema is unsupported")
    project = canonical_project(value.get("project"))
    if expected_project is not None:
        expected = canonical_project(expected_project)
        if project != expected:
            raise PickerError("project session snapshot does not match the requested project")
    raw_sessions = value.get("sessions")
    if not isinstance(raw_sessions, list) or len(raw_sessions) > MAX_SESSIONS:
        raise PickerError("project session list is invalid or too large")
    sessions = [validate_session(item, project) for item in raw_sessions]
    ids = [item["id"] for item in sessions]
    if len(ids) != len(set(ids)):
        raise PickerError("project session snapshot contains duplicate UUIDs")
    sessions.sort(key=lambda item: (item["last_activity"], item["id"]), reverse=True)
    return project, sessions


def eligible_sessions(sessions: list[dict], mode: str | None) -> tuple[list[dict], int]:
    unsupported = sum(item["mode"] is None for item in sessions)
    eligible = [
        item for item in sessions
        if item["mode"] is not None and (mode is None or item["mode"] == mode)
    ]
    return eligible, unsupported


def history_label(history: dict) -> str:
    if history["mode"] == "legacy":
        detail = "legacy"
    else:
        detail = f"paginated {history['first_ordinal']}-{history['last_ordinal']}"
    if history["torn_tail_ignored"]:
        detail += ", torn tail ignored"
    return f"{detail}/{history['storage']}"


def terminal_safe(value: str) -> str:
    # JSON escaping prevents project paths from injecting terminal controls/newlines.
    return json.dumps(value, ensure_ascii=True)[1:-1]


def clipped(value: str | None, width: int) -> str:
    if not value:
        return "(model not recorded)"
    safe = terminal_safe(value)
    if len(safe) <= width:
        return safe
    return safe[: max(1, width - 3)] + "..."


def render_page(
    tty: TextIO,
    project: str,
    sessions: list[dict],
    page: int,
    page_size: int,
    unsupported: int,
) -> None:
    pages = max(1, (len(sessions) + page_size - 1) // page_size)
    start = page * page_size
    end = min(len(sessions), start + page_size)
    tty.write("\nSandcodex project conversations\n")
    tty.write(f"Project: {terminal_safe(project)}\n")
    tty.write(f"Page {page + 1}/{pages} · {len(sessions)} selectable")
    if unsupported:
        tty.write(f" · {unsupported} unsupported provider record(s) hidden")
    tty.write("\n\n")
    for offset, item in enumerate(sessions[start:end], start=start + 1):
        tty.write(
            f"{offset:>4}. [{item['mode']:<6}] {item['activity_utc']}  "
            f"{clipped(item['model'], 48)}\n"
        )
        tty.write(
            f"      {item['id']}  · {history_label(item['history'])}\n"
        )
    tty.write("\nEnter a number or full UUID")
    if pages > 1:
        tty.write(", n for next, p for previous")
    tty.write(", q to cancel: ")
    tty.flush()


def resolve_selection(raw: str, sessions: list[dict]) -> dict | None:
    selection = raw.strip()
    if not selection:
        return None
    if selection.isdecimal():
        index = int(selection)
        if 1 <= index <= len(sessions):
            return sessions[index - 1]
        return None
    try:
        session_id = str(uuid.UUID(selection))
    except (ValueError, TypeError, AttributeError):
        return None
    if selection.lower() != session_id:
        return None
    return next((item for item in sessions if item["id"] == session_id), None)


def choose_interactively(
    project: str,
    sessions: list[dict],
    unsupported: int,
    page_size: int,
    tty_path: str = "/dev/tty",
) -> dict:
    try:
        # Separate streams avoid update-mode seek requirements on character devices.
        with open(tty_path, "r", encoding="utf-8", errors="strict", buffering=1) as reader, \
             open(tty_path, "w", encoding="utf-8", errors="strict", buffering=1) as writer:
            if not os.isatty(reader.fileno()) or not os.isatty(writer.fileno()):
                raise PickerError("resume picker requires an interactive terminal")
            page = 0
            pages = max(1, (len(sessions) + page_size - 1) // page_size)
            while True:
                render_page(writer, project, sessions, page, page_size, unsupported)
                line = reader.readline()
                if line == "":
                    raise PickerCancelled("resume picker input closed")
                command = line.strip().lower()
                if command in ("q", "quit", "cancel"):
                    raise PickerCancelled("resume picker cancelled")
                if command in ("n", "next") and pages > 1:
                    page = min(pages - 1, page + 1)
                    continue
                if command in ("p", "prev", "previous") and pages > 1:
                    page = max(0, page - 1)
                    continue
                selected = resolve_selection(line, sessions)
                if selected is not None:
                    return selected
                writer.write("Invalid selection. No conversation was chosen.\n")
                writer.flush()
    except FileNotFoundError as exc:
        raise PickerError("resume picker requires /dev/tty") from exc
    except PermissionError as exc:
        raise PickerError("resume picker cannot access /dev/tty") from exc


def selection_record(project: str, selected: dict) -> dict:
    return {
        "schema": "sandcodex.project-picker-selection.v1",
        "project": project,
        "id": selected["id"],
        "mode": selected["mode"],
        "provider": selected["provider"],
        "model": selected["model"],
        "context_tokens": selected["context_tokens"],
        "last_activity": selected["last_activity"],
        "history": selected["history"],
        "verification_required": "exact-reselection-and-provider-binding-before-start",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", required=True)
    parser.add_argument("--mode", choices=("gpt", "local", "remote", "gemini"))
    parser.add_argument("--page-size", type=int, default=DEFAULT_PAGE_SIZE)
    parser.add_argument(
        "--selection",
        help="noninteractive test seam: select an eligible global number or canonical UUID",
    )
    parser.add_argument("--tty", default="/dev/tty", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if not 1 <= args.page_size <= 100:
        parser.error("--page-size must be between 1 and 100")
    try:
        project, sessions = load_snapshot(sys.stdin, args.project)
        eligible, unsupported = eligible_sessions(sessions, args.mode)
        if not eligible:
            qualifier = f" for {args.mode}" if args.mode else ""
            raise FileNotFoundError(f"no selectable established conversation{qualifier} in this project")
        if args.selection is not None:
            selected = resolve_selection(args.selection, eligible)
            if selected is None:
                raise PickerError("requested test selection is not an eligible conversation")
        else:
            selected = choose_interactively(project, eligible, unsupported, args.page_size, args.tty)
    except FileNotFoundError as exc:
        print(f"sandcodex resume picker: {exc}; no fresh conversation was started", file=sys.stderr)
        return 66
    except PickerCancelled as exc:
        print(f"sandcodex resume picker: {exc}; no fresh conversation was started", file=sys.stderr)
        return 130
    except (PickerError, OSError, ValueError) as exc:
        print(f"sandcodex resume picker: {exc}; no fresh conversation was started", file=sys.stderr)
        return 78
    print(json.dumps(selection_record(project, selected), sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_SESSION_PICKER_PY
}

sc_emit_remote_qualifier() {
  cat <<'SANDCODEX_REMOTE_QUALIFIER_PY'
#!/usr/bin/env python3
"""Qualify a remote Responses provider without persisting credentials or content.

The first launch for one exact descriptor/model/probe-version performs three bounded
HTTPS requests: a streamed instructions probe, a forced strict function call, and
one stateless tool-result continuation. A private receipt may then be reused. Receipts are
protocol evidence, not cryptographic identity for provider-hosted model weights.
"""
from __future__ import annotations

import argparse
import copy
import datetime as dt
import fcntl
import hashlib
import http.client
import json
import math
import os
from pathlib import Path
import re
import secrets
import signal
import ssl
import stat
import sys
import tempfile
import time
from typing import Any, Callable
from urllib.parse import urlsplit

RECEIPT_SCHEMA = "sandcodex.remote-qualification.v1"
RESULT_SCHEMA = "sandcodex.remote-qualification-result.v1"
PROBE_VERSION = "responses-instructions-stream-tools-v5-sandideas-result-review"
HASH = re.compile(r"[0-9a-f]{64}\Z")
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")
PROVIDER_NAME = re.compile(r"[A-Za-z0-9_-]{1,48}\Z")
ENV_NAME = re.compile(r"[A-Z][A-Z0-9_]{0,79}(?:_API_KEY|_TOKEN|_SECRET)\Z")
SAFE_OBSERVED_MODEL = re.compile(r"[\x21-\x7e]{1,256}\Z")
MAX_SNAPSHOT_BYTES = 64 * 1024
MAX_CREDENTIAL_BYTES = 16 * 1024
MAX_REQUEST_BYTES = 64 * 1024
MAX_RESPONSE_BYTES = 1024 * 1024
MAX_EVENTS = 4096
DEFAULT_TIMEOUT = 45.0


class QualificationError(ValueError):
    pass


class QualificationBusy(QualificationError):
    pass


class ProviderUnavailable(QualificationError):
    pass


class RequestDeadlineExceeded(TimeoutError):
    pass


def with_request_deadline(seconds: float):
    class Deadline:
        def __enter__(self):
            self.old_handler = signal.getsignal(signal.SIGALRM)

            def raise_deadline(signum, frame):  # type: ignore[no-untyped-def]
                raise RequestDeadlineExceeded("remote qualification request exceeded its wall-clock deadline")

            signal.signal(signal.SIGALRM, raise_deadline)
            signal.setitimer(signal.ITIMER_REAL, max(1.0, float(seconds)))

        def __exit__(self, exc_type, exc, tb):  # type: ignore[no-untyped-def]
            signal.setitimer(signal.ITIMER_REAL, 0.0)
            signal.signal(signal.SIGALRM, self.old_handler)
            return False

    return Deadline()


def canonical_json(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("utf-8")


def digest_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def digest_file(path: Path, maximum: int = 4 * 1024 * 1024) -> str:
    raw = read_private_bytes(path, maximum)
    return digest_bytes(raw)


def strict_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    value: dict[str, object] = {}
    for key, item in pairs:
        if key in value:
            raise QualificationError(f"duplicate JSON field: {key}")
        value[key] = item
    return value


def assert_no_symlink_components(path: Path) -> None:
    absolute = path.absolute()
    cursor = Path(absolute.anchor)
    for component in absolute.parts[1:]:
        cursor /= component
        try:
            if cursor.is_symlink():
                raise QualificationError(f"path contains a symlink: {cursor}")
        except OSError as exc:
            raise QualificationError(f"path could not be inspected: {cursor}: {exc}") from exc


def read_private_bytes(path: Path, maximum: int) -> bytes:
    if not path.is_absolute():
        raise QualificationError("private input path must be absolute")
    assert_no_symlink_components(path)
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) & 0o077
        ):
            raise QualificationError("private input must be regular, single-linked, user-owned, and mode 0600-or-stricter")
        if metadata.st_size > maximum:
            raise QualificationError("private input exceeds its bounded size")
        raw = stream.read(maximum + 1)
    if len(raw) > maximum:
        raise QualificationError("private input exceeds its bounded size")
    return raw


def read_private_json(path: Path, maximum: int) -> dict[str, Any]:
    raw = read_private_bytes(path, maximum)
    try:
        value = json.loads(raw, object_pairs_hook=strict_object)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise QualificationError(f"private input is not strict JSON: {exc}") from exc
    if not isinstance(value, dict):
        raise QualificationError("private JSON root must be an object")
    return value


def normalize_snapshot(value: dict[str, Any]) -> dict[str, str]:
    if set(value) != {"name", "base_url", "env_key", "wire_api"}:
        raise QualificationError("remote snapshot fields differ from the pinned descriptor schema")
    name = value.get("name")
    base_url = value.get("base_url")
    env_key = value.get("env_key")
    wire_api = value.get("wire_api")
    if not isinstance(name, str) or not PROVIDER_NAME.fullmatch(name):
        raise QualificationError("remote snapshot provider name is invalid")
    if not isinstance(env_key, str) or not ENV_NAME.fullmatch(env_key):
        raise QualificationError("remote snapshot credential-variable name is invalid")
    if wire_api != "responses":
        raise QualificationError("remote snapshot does not require the Responses wire API")
    if not isinstance(base_url, str) or len(base_url) > 1024:
        raise QualificationError("remote snapshot base URL is invalid")
    try:
        parsed = urlsplit(base_url)
        port = parsed.port
    except ValueError as exc:
        raise QualificationError(f"remote snapshot base URL is invalid: {exc}") from exc
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username
        or parsed.password
        or parsed.query
        or parsed.fragment
        or port not in (None, 443)
    ):
        raise QualificationError("remote qualification requires descriptor-pinned HTTPS on port 443")
    host = parsed.hostname.lower()
    if not re.fullmatch(r"[A-Za-z0-9.-]+", host) or "." not in host:
        raise QualificationError("remote qualification requires a DNS hostname")
    path = parsed.path.rstrip("/")
    normalized = {
        "name": name,
        "base_url": f"https://{host}{path}",
        "env_key": env_key,
        "wire_api": "responses",
    }
    return normalized


def descriptor_identity(config: dict[str, str]) -> str:
    return digest_bytes(canonical_json(config))


def valid_model(value: str) -> str:
    if not isinstance(value, str) or not MODEL.fullmatch(value):
        raise QualificationError("remote model identifier is invalid")
    return value


def valid_timestamp(value: str | None) -> str:
    if value is None:
        return dt.datetime.now(dt.timezone.utc).isoformat()
    if not isinstance(value, str) or len(value) > 80:
        raise QualificationError("qualification timestamp is invalid")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise QualificationError("qualification timestamp is not ISO-8601") from exc
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise QualificationError("qualification timestamp must include a timezone")
    return value


def safe_observed_model(value: Any) -> str | None:
    if isinstance(value, str) and SAFE_OBSERVED_MODEL.fullmatch(value):
        return value
    return None


def response_output_text(value: Any) -> str:
    if not isinstance(value, dict):
        return ""
    direct = value.get("output_text")
    if isinstance(direct, str):
        return direct
    parts: list[str] = []
    output = value.get("output")
    if not isinstance(output, list):
        return ""
    for item in output:
        if not isinstance(item, dict) or item.get("type") != "message":
            continue
        content = item.get("content")
        if not isinstance(content, list):
            continue
        for part in content:
            if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str):
                parts.append(part["text"])
    return "".join(parts)


def response_function_calls(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, dict) or not isinstance(value.get("output"), list):
        return []
    result: list[dict[str, Any]] = []
    for item in value["output"]:
        if not isinstance(item, dict) or item.get("type") != "function_call":
            continue
        result.append({"name": item.get("name"), "arguments": item.get("arguments")})
    return result


def sc_decode_responses_sse(raw, *, max_bytes=4 * 1024 * 1024,
                            max_event_bytes=1024 * 1024, max_events=4096):
    """Decode complete blank-line-delimited events; never dispatch at EOF.

    Accepts UTF-8 with one optional BOM and CR, LF or CRLF line endings. Rejects
    duplicate/non-finite JSON and contradictory explicit event names. [DONE]
    is optional transport metadata, never a substitute for response.completed.
    An unfinished data block is reported separately rather than repaired.
    Raises ValueError with fixed content-free codes. stdlib-only and embeddable.
    """
    import json
    import math
    import re

    for value, ceiling in ((max_bytes, 4 * 1024 * 1024),
                           (max_event_bytes, 1024 * 1024), (max_events, 4096)):
        if type(value) is not int or not 1 <= value <= ceiling:
            raise ValueError("invalid_sse_limit")
    if not isinstance(raw, bytes) or len(raw) > max_bytes:
        raise ValueError("capture_size_limit")
    try:
        text = raw.decode("utf-8-sig", "strict")
    except UnicodeDecodeError:
        raise ValueError("invalid_utf8") from None

    class _StrictJSONError(ValueError):
        pass

    def pairs(rows):
        result = {}
        for key, value in rows:
            if key in result:
                raise _StrictJSONError("duplicate_json_field")
            result[key] = value
        return result

    def constant(_raw):
        raise _StrictJSONError("non_finite_json")

    def finite_float(raw_number):
        value = float(raw_number)
        if not math.isfinite(value):
            raise _StrictJSONError("non_finite_json")
        return value

    events, data = [], []
    size, event_name, done = 0, None, False
    # splitlines() is intentionally NOT used: U+2028 and U+0085 may be JSON data.
    lines = re.split(r"\r\n|\r|\n", text)
    if text.endswith(("\r", "\n")):
        lines.pop()  # A final separator is not an additional blank line.
    for line in lines:
        if line == "":
            if data:
                if done:
                    raise ValueError("data_after_done_sentinel")
                payload = "\n".join(data)
                if payload == "[DONE]":
                    done = True
                else:
                    try:
                        value = json.loads(payload, object_pairs_hook=pairs,
                                           parse_constant=constant, parse_float=finite_float)
                    except _StrictJSONError as exc:
                        raise ValueError(str(exc)) from None
                    except (ValueError, RecursionError):
                        raise ValueError("invalid_json_capture") from None
                    if not isinstance(value, dict) or not isinstance(value.get("type"), str):
                        raise ValueError("invalid_responses_event")
                    if event_name not in (None, "message", value["type"]):
                        raise ValueError("event_name_type_mismatch")
                    events.append(value)
                    if len(events) > max_events:
                        raise ValueError("event_count_limit")
            data, size, event_name = [], 0, None
            continue
        if line.startswith(":"):
            continue
        field, _separator, value = line.partition(":")
        if value.startswith(" "):
            value = value[1:]  # Exactly ONE U+0020, as specified by SSE.
        if field == "data":
            size += len(value.encode("utf-8")) + 1
            if size > max_event_bytes:
                raise ValueError("event_size_limit")
            data.append(value)
        elif field == "event":
            event_name = value or None
        # id/retry/unknown fields do not authorize reconnection or alter payload.
    return {"events": events, "done_sentinel": done,
            "trailing_partial_event": bool(data)}


def parse_sse(raw: bytes) -> tuple[list[dict[str, Any]], list[str]]:
    try:
        capture = sc_decode_responses_sse(
            raw, max_bytes=MAX_RESPONSE_BYTES,
            max_event_bytes=MAX_RESPONSE_BYTES, max_events=MAX_EVENTS,
        )
    except ValueError as exc:
        # The shared decoder returns fixed codes, not provider content.
        raise QualificationError("Responses SSE framing rejected: " + str(exc)) from None
    if capture["trailing_partial_event"]:
        raise QualificationError("Responses SSE framing rejected: unterminated_sse_event")
    events = capture["events"]
    if not events:
        raise QualificationError("Responses stream did not contain any JSON events")
    types = []
    for event in events:
        kind = event["type"]
        if not re.fullmatch(r"[a-z][a-z0-9_.-]{0,95}", kind):
            raise QualificationError("Responses stream event type is invalid")
        types.append(kind)
    return events, types


def stream_text(events: list[dict[str, Any]]) -> str:
    parts: list[str] = []
    for event in events:
        if event.get("type") == "response.output_text.delta" and isinstance(event.get("delta"), str):
            parts.append(event["delta"])
    return "".join(parts)


def stream_observed_models(events: list[dict[str, Any]]) -> set[str]:
    result: set[str] = set()
    for event in events:
        response = event.get("response")
        if isinstance(response, dict):
            model = safe_observed_model(response.get("model"))
            if model:
                result.add(model)
    return result


class HTTPSResponsesClient:
    def __init__(self, base_url: str, credential: str, timeout: float = DEFAULT_TIMEOUT):
        parsed = urlsplit(base_url)
        self.host = parsed.hostname or ""
        self.path = parsed.path.rstrip("/") + "/responses"
        self.credential = credential
        self.timeout = timeout
        self.context = ssl.create_default_context()

    def _request(self, body: dict[str, Any], *, accept: str) -> tuple[int, dict[str, str], bytes, int]:
        encoded = canonical_json(body)
        if len(encoded) > MAX_REQUEST_BYTES:
            raise QualificationError("qualification request exceeds its bounded size")
        headers = {
            "Authorization": f"Bearer {self.credential}",
            "Content-Type": "application/json",
            "Accept": accept,
            "User-Agent": "sandcodex-remote-qualify/1",
        }
        started = time.monotonic()
        connection: http.client.HTTPSConnection | None = None
        try:
            with with_request_deadline(self.timeout):
                connection = http.client.HTTPSConnection(self.host, port=443, timeout=self.timeout, context=self.context)
                connection.request("POST", self.path, body=encoded, headers=headers)
                response = connection.getresponse()
                status = int(response.status)
                response_headers = {key.lower(): value for key, value in response.getheaders()}
                raw = response.read(MAX_RESPONSE_BYTES + 1)
        except RequestDeadlineExceeded as exc:
            raise ProviderUnavailable("remote qualification transport timed out") from exc
        except (OSError, TimeoutError, ssl.SSLError, http.client.HTTPException) as exc:
            raise ProviderUnavailable(f"remote qualification transport failed: {type(exc).__name__}") from exc
        finally:
            if connection is not None:
                connection.close()
        duration_ms = max(0, int((time.monotonic() - started) * 1000))
        if len(raw) > MAX_RESPONSE_BYTES:
            raise QualificationError("remote qualification response exceeds 1 MiB")
        if 300 <= status < 400:
            raise QualificationError(f"remote provider returned redirect status {status}; redirects are forbidden")
        if status == 429 or status >= 500:
            raise ProviderUnavailable(f"remote provider is unavailable for qualification (HTTP {status})")
        if not 200 <= status < 300:
            raise QualificationError(f"remote provider rejected qualification request (HTTP {status})")
        return status, response_headers, raw, duration_ms

    def request_json(self, body: dict[str, Any]) -> tuple[int, dict[str, str], dict[str, Any], int]:
        status, headers, raw, duration_ms = self._request(body, accept="application/json")
        try:
            value = json.loads(raw, object_pairs_hook=strict_object)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise QualificationError("remote provider returned malformed Responses JSON") from exc
        if not isinstance(value, dict):
            raise QualificationError("remote provider returned a non-object Responses result")
        return status, headers, value, duration_ms

    def request_sse(self, body: dict[str, Any]) -> tuple[int, dict[str, str], list[dict[str, Any]], list[str], int]:
        status, headers, raw, duration_ms = self._request(body, accept="text/event-stream")
        content_type = headers.get("content-type", "").split(";", 1)[0].strip().lower()
        if content_type != "text/event-stream":
            raise QualificationError("remote provider did not return text/event-stream")
        events, event_types = parse_sse(raw)
        return status, headers, events, event_types, duration_ms


def sc_response_contract(value, *, streaming=False):
    """Audit decoded JSON or a decoded list of Responses SSE events.

    Unknown optional events are tolerated. Error messages, prompts, arguments,
    names, opaque state, model identifiers and raw IDs never enter the report.
    Tool items are delivery evidence, NOT evidence that a tool executed.
    A completed refusal is a protocol completion, not task success.
    """
    import json

    issues = []
    warnings = []
    terminal = None
    terminal_kind = None
    response_id = None
    error_seen = False
    tool_payload = False
    event_count = 0
    text_chars = 0
    text_parts = []
    done_tools = {}
    done_items = {}
    error_category = None
    known_categories = {
        "authentication", "permission_denied", "payment_required",
        "rate_limit_exceeded", "provider_overloaded", "provider_unavailable",
        "context_length_exceeded", "max_tokens_exceeded", "token_limit_exceeded",
        "invalid_request", "invalid_prompt", "timeout", "server", "server_error",
        "content_policy_violation", "refusal", "unmapped", "invalid_api_key",
    }
    local_types = {"function_call", "custom_tool_call", "tool_search_call"}

    def flag(code):
        if code not in issues:
            issues.append(code)

    def identity(raw):
        return raw if isinstance(raw, str) and 0 < len(raw) <= 1024 else None

    def remember_error(obj):
        nonlocal error_category
        if not isinstance(obj, dict):
            return
        raw = obj.get("error_type")
        error = obj.get("error")
        if raw is None and isinstance(error, dict):
            raw = error.get("code")
        if isinstance(raw, str):
            error_category = raw if raw in known_categories else "unmapped"

    def check_id(obj):
        nonlocal response_id
        current = identity(obj.get("id"))
        if current is None:
            flag("missing_response_id")
        elif response_id is None:
            response_id = current
        elif current != response_id:
            flag("response_identity_changed")

    def local_call(item):
        return isinstance(item.get("type"), str) and item["type"] in local_types and not (
            item.get("type") == "tool_search_call" and item.get("execution") != "client")

    def check_item(item):
        if not isinstance(item, dict):
            flag("non_object_output_item")
            return
        if item.get("status") not in (None, "completed"):
            flag("unfinished_output_item")
        if not local_call(item):
            return
        if identity(item.get("call_id")) is None:
            flag("missing_tool_call_id")
        if item.get("type") == "function_call":
            raw = item.get("arguments")
            if not isinstance(raw, str):
                flag("invalid_function_arguments")
                return
            def pairs(rows):
                result = {}
                for key, child in rows:
                    if key in result:
                        raise ValueError("duplicate field")
                    result[key] = child
                return result
            def constant(_raw):
                raise ValueError("non-finite JSON")
            try:
                parsed = json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)
                if not isinstance(parsed, dict):
                    flag("invalid_function_arguments")
            except (ValueError, TypeError, RecursionError):
                flag("invalid_function_arguments")
        elif item.get("type") == "custom_tool_call" and not isinstance(item.get("input"), str):
            flag("invalid_custom_input")
        elif item.get("type") == "tool_search_call" and not isinstance(item.get("arguments"), dict):
            flag("invalid_search_arguments")

    if streaming:
        if not isinstance(value, list) or len(value) > 4096:
            flag("invalid_event_collection")
            events = []
        else:
            events = value
        for event in events:
            event_count += 1
            if not isinstance(event, dict) or not isinstance(event.get("type"), str):
                flag("invalid_event")
                continue
            kind = event["type"]
            if terminal_kind is not None:
                flag("event_after_terminal")
            if kind in {"error", "response.error", "response.failed"}:
                error_seen = True
                remember_error(event.get("response", event))
            obj = event.get("response")
            if isinstance(obj, dict):
                check_id(obj)
                if obj.get("error") is not None:
                    error_seen = True
                    remember_error(obj)
                if kind == "response.created" and obj.get("status") not in ("in_progress", "queued"):
                    flag("premature_response_status")
                if kind == "response.in_progress" and obj.get("status") != "in_progress":
                    flag("premature_response_status")
            elif kind in {"response.created", "response.in_progress", "response.completed", "response.failed", "response.incomplete"}:
                flag("missing_response_envelope")
            if kind in {"response.completed", "response.failed", "response.incomplete"}:
                if terminal_kind is not None:
                    flag("multiple_terminal_events")
                terminal_kind = kind
                terminal = obj if isinstance(obj, dict) else {}
            if kind == "response.output_text.delta" and isinstance(event.get("delta"), str):
                text_chars += len(event["delta"])
                text_parts.append(event["delta"])
            if kind in {"response.function_call_arguments.delta", "response.custom_tool_call_input.delta"}:
                tool_payload = True
            item = event.get("item")
            if isinstance(item, dict) and local_call(item):
                tool_payload = True
            if kind == "response.output_item.done":
                check_item(item)
                if isinstance(item, dict):
                    key = identity(item.get("id"))
                    if key is None:
                        flag("missing_output_item_id")
                    elif key in done_items:
                        flag("duplicate_output_item_done")
                    else:
                        done_items[key] = item
                    if local_call(item):
                        key = identity(item.get("call_id"))
                        if key in done_tools:
                            flag("duplicate_tool_call_done")
                        if key is not None:
                            done_tools[key] = item
        if terminal_kind is None:
            warnings.append("no_terminal_event")
    else:
        if not isinstance(value, dict):
            flag("invalid_response_envelope")
        else:
            terminal = value
            check_id(value)
            if value.get("status") in ("completed", "failed", "incomplete"):
                terminal_kind = "response." + value["status"]
            if value.get("error") is not None or value.get("status") == "failed":
                error_seen = True
                remember_error(value)

    if terminal_kind and isinstance(terminal, dict):
        expected_status = terminal_kind.split(".")[-1]
        if terminal.get("status") != expected_status:
            flag("terminal_status_mismatch")
        if terminal_kind == "response.completed":
            if error_seen:
                flag("error_with_completion")
            if terminal.get("incomplete_details") is not None:
                flag("incomplete_details_with_completion")
        output = terminal.get("output")
        if terminal_kind == "response.completed" and not isinstance(output, list):
            flag("missing_terminal_output")
        output = output if isinstance(output, list) else []
        if len(output) > 4096:
            flag("too_many_output_items")
            output = []
        final_items = {}
        final_text_parts = []
        final_calls = set()
        for item in output:
            check_item(item)
            if not isinstance(item, dict):
                continue
            if item.get("type") == "message" and isinstance(item.get("content"), list):
                for part in item["content"]:
                    if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str):
                        final_text_parts.append(part["text"])
            key = identity(item.get("id"))
            if key is not None:
                if key in final_items:
                    flag("duplicate_terminal_output_id")
                final_items[key] = item
            if local_call(item):
                tool_payload = True
                call_id = identity(item.get("call_id"))
                if call_id in final_calls:
                    flag("duplicate_terminal_call_id")
                final_calls.add(call_id)
        if terminal_kind == "response.completed":
            if text_parts and "".join(text_parts) != "".join(final_text_parts):
                flag("terminal_text_mismatch")
            if isinstance(terminal.get("output_text"), str) and terminal["output_text"] != "".join(final_text_parts):
                flag("flattened_text_mismatch")
            for key, item in done_items.items():
                if key not in final_items:
                    flag("completed_item_missing_from_terminal")
                elif final_items[key] != item:
                    flag("terminal_output_changed")

    if issues:
        outcome = "invalid"
    elif error_seen or terminal_kind == "response.failed":
        outcome = "failed"
    elif terminal_kind == "response.incomplete":
        outcome = "incomplete"
    elif terminal_kind == "response.completed":
        outcome = "completed"
    else:
        outcome = "truncated" if streaming else "not_completed"
    return {
        "schema": "sandcodex-ideas.response-contract.v1",
        "outcome": outcome, "complete": outcome == "completed",
        "terminal_event": terminal_kind, "error_category": error_category,
        "issues": issues, "warnings": warnings,
        "counts": {"events": event_count, "visible_delta_characters": text_chars,
                   "completed_local_call_items": len(done_tools)},
        "tool_delivery": "observed_execution_unknown" if tool_payload else "not_observed",
        "automatic_retry_authorized": False,
        "tool_execution_observed": False,
        "task_success_proven": False,
    }


_SC_REMOTE_RESULT_CHALLENGE = re.compile(r"SANDCODEX_REMOTE_RESULT_[0-9a-f]{32}\Z")

def _strict_json_object(raw: str) -> dict[str, Any]:
    class Duplicate(ValueError):
        pass

    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in rows:
            if key in result:
                raise Duplicate("duplicate_argument_field")
            result[key] = value
        return result

    def constant(_raw: str) -> None:
        raise Duplicate("non_finite_argument")

    def finite_float(value: str) -> float:
        parsed = float(value)
        if not math.isfinite(parsed):
            raise Duplicate("non_finite_argument")
        return parsed

    try:
        value = json.loads(
            raw,
            object_pairs_hook=pairs,
            parse_constant=constant,
            parse_float=finite_float,
        )
    except Duplicate:
        raise
    except (json.JSONDecodeError, RecursionError) as exc:
        raise ValueError("invalid_argument_json") from exc
    if not isinstance(value, dict):
        raise ValueError("arguments_not_object")
    return value

def sc_prepare_remote_tool_result_followup(tool_request: dict[str, Any], tool_response: dict[str, Any], *, expected_name: str, expected_arguments: dict[str, Any], challenge: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Build one full-history, stateless follow-up request.

    The unpredictable challenge must be created only after the first response.
    Returned evidence contains no prompt, argument, result, model, or raw ID.
    The exact first response output is copied into the follow-up; it is not
    synthesized from parsed fields.
    """
    if not isinstance(tool_request, dict) or not isinstance(tool_response, dict):
        raise ValueError("request_or_response_not_object")
    if not isinstance(expected_name, str) or not expected_name or len(expected_name) > 128:
        raise ValueError("invalid_expected_tool_name")
    if not isinstance(expected_arguments, dict):
        raise ValueError("invalid_expected_arguments")
    if not isinstance(challenge, str) or not _SC_REMOTE_RESULT_CHALLENGE.fullmatch(challenge):
        raise ValueError("invalid_result_challenge")
    model = tool_request.get("model")
    original_input = tool_request.get("input")
    output = tool_response.get("output")
    if not isinstance(model, str) or not model or len(model) > 256:
        raise ValueError("invalid_request_model")
    if not isinstance(original_input, list) or not original_input:
        raise ValueError("tool_request_input_not_replayable")
    if not isinstance(output, list) or not output:
        raise ValueError("tool_response_output_not_replayable")

    calls = [item for item in output if isinstance(item, dict) and item.get("type") == "function_call"]
    if len(calls) != 1:
        raise ValueError("expected_one_function_call")
    call = calls[0]
    call_id = call.get("call_id")
    item_id = call.get("id")
    arguments = call.get("arguments")
    if not isinstance(call_id, str) or not 1 <= len(call_id) <= 1024:
        raise ValueError("invalid_call_id")
    if not isinstance(item_id, str) or not 1 <= len(item_id) <= 1024:
        raise ValueError("invalid_function_call_id")
    if call.get("name") != expected_name:
        raise ValueError("unexpected_function_name")
    if not isinstance(arguments, str) or len(arguments) > 8192:
        raise ValueError("invalid_function_arguments")
    if _strict_json_object(arguments) != expected_arguments:
        raise ValueError("unexpected_function_arguments")

    followup_input = copy.deepcopy(original_input)
    followup_input.extend(copy.deepcopy(output))
    followup_input.append({
        "type": "function_call_output",
        "call_id": call_id,
        "output": challenge,
    })
    body = {
        "model": model,
        "instructions": (
            "The function result in the conversation contains a challenge. "
            "Return only that challenge exactly. Do not call a tool."
        ),
        "input": followup_input,
        "max_output_tokens": 192,
        "store": False,
    }
    evidence = {
        "schema": "sandcodex-ideas.remote-tool-result-followup.v1",
        "full_history_replayed": True,
        "function_call_output_appended": True,
        "call_id_preserved": True,
        "store_false": True,
        "previous_response_id_used": False,
        "live_tools_declared": False,
        "challenge_created_after_first_response": True,
    }
    return body, evidence

def sc_verify_remote_tool_result_readback(response: dict[str, Any], *, expected_challenge: str) -> dict[str, Any]:
    """Verify exact visible readback and absence of another function call.

    Response lifecycle/completion is intentionally checked by the caller's
    independent response-contract audit. This helper proves neither tool
    execution nor general task quality.
    """
    if not isinstance(response, dict):
        raise ValueError("readback_response_not_object")
    if not isinstance(expected_challenge, str) or not _SC_REMOTE_RESULT_CHALLENGE.fullmatch(expected_challenge):
        raise ValueError("invalid_result_challenge")
    text_parts: list[str] = []
    calls = 0
    output = response.get("output")
    if not isinstance(output, list):
        raise ValueError("readback_output_not_list")
    for item in output:
        if not isinstance(item, dict):
            continue
        if item.get("type") == "function_call":
            calls += 1
        if item.get("type") != "message":
            continue
        content = item.get("content")
        if not isinstance(content, list):
            continue
        for part in content:
            if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str):
                text_parts.append(part["text"])
    observed = "".join(text_parts)
    return {
        "schema": "sandcodex-ideas.remote-tool-result-readback.v1",
        "exact_readback": observed == expected_challenge,
        "unexpected_function_calls": calls,
        "visible_text_present": bool(observed),
        "task_success_proven": False,
        "tool_execution_observed": False,
    }


def qualify_receipt(
    config: dict[str, str],
    descriptor_sha256: str,
    model: str,
    client: Any,
    timestamp: str,
) -> dict[str, Any]:
    model = valid_model(model)
    if not HASH.fullmatch(descriptor_sha256) or descriptor_identity(config) != descriptor_sha256:
        raise QualificationError("remote descriptor digest does not match its snapshot")

    stream_marker = "SANDCODEX_REMOTE_STREAM_91"
    stream_body = {
        "model": model,
        # Codex carries its governing prompt in the canonical Responses
        # `instructions` field.  Qualify that exact transport seam; adversarial
        # hierarchy obedience is a model-quality benchmark, not an API test.
        "instructions": f"The qualification marker is {stream_marker}. Return it exactly when asked.",
        "input": "Return the qualification marker exactly and nothing else.",
        "max_output_tokens": 512,
        "store": False,
        "stream": True,
    }
    stream_status, stream_headers, events, event_types, stream_ms = client.request_sse(stream_body)
    streamed = stream_text(events).strip()
    stream_contract = sc_response_contract(events, streaming=True)
    stream_ok = (
        streamed == stream_marker
        and "response.output_text.delta" in event_types
        and "response.completed" in event_types
        and stream_contract["complete"]
        and stream_headers.get("content-type", "").split(";", 1)[0].strip().lower() == "text/event-stream"
    )
    if not stream_ok:
        raise QualificationError("remote Responses instructions/streaming probe did not produce the exact required result")

    tool_name = "record_sandcodex_remote_probe"
    expected_args = {"marker": "REMOTE_TOOL_73", "count": 73}
    tool_body = {
        "model": model,
        "input": [{
            "type": "message",
            "role": "user",
            "content": [{
                "type": "input_text",
                "text": "Call record_sandcodex_remote_probe exactly once with marker REMOTE_TOOL_73 and count 73. Do not answer in prose.",
            }],
        }],
        "max_output_tokens": 192,
        "store": False,
        "parallel_tool_calls": False,
        "tools": [{
            "type": "function",
            "name": tool_name,
            "description": "Record a deterministic Sandcodex remote-provider qualification marker.",
            "strict": True,
            "parameters": {
                "type": "object",
                "properties": {
                    "marker": {"type": "string", "enum": ["REMOTE_TOOL_73"]},
                    "count": {"type": "integer", "enum": [73]},
                },
                "required": ["marker", "count"],
                "additionalProperties": False,
            },
        }],
        "tool_choice": {"type": "function", "name": tool_name},
    }
    tool_status, tool_headers, tool_response, tool_ms = client.request_json(tool_body)
    calls = response_function_calls(tool_response)
    parsed_calls: list[dict[str, Any]] = []
    for call in calls:
        arguments = call.get("arguments")
        if not isinstance(arguments, str) or len(arguments) > 8192:
            parsed = None
        else:
            try:
                parsed = json.loads(arguments, object_pairs_hook=strict_object)
            except json.JSONDecodeError:
                parsed = None
        parsed_calls.append({"name": call.get("name"), "arguments": parsed})
    tool_contract = sc_response_contract(tool_response)
    tool_ok = (len(parsed_calls) == 1
               and parsed_calls[0] == {"name": tool_name, "arguments": expected_args}
               and tool_contract["complete"])
    if not tool_ok:
        raise QualificationError("remote Responses strict function-call probe did not preserve one exact call")

    # The challenge is created only after the first response and appears only in
    # the matching function_call_output. This tests stateless result replay; it
    # is not evidence that any real tool executed or that coding quality is good.
    challenge = "SANDCODEX_REMOTE_RESULT_" + secrets.token_hex(16)
    try:
        continuation_body, continuation_evidence = sc_prepare_remote_tool_result_followup(
            tool_body, tool_response,
            expected_name=tool_name, expected_arguments=expected_args,
            challenge=challenge,
        )
    except ValueError as exc:
        raise QualificationError("remote tool-result continuation could not preserve the first response") from exc
    continuation_status, continuation_headers, continuation_response, continuation_ms = client.request_json(
        continuation_body
    )
    continuation_contract = sc_response_contract(continuation_response)
    try:
        readback_evidence = sc_verify_remote_tool_result_readback(
            continuation_response, expected_challenge=challenge,
        )
    except ValueError as exc:
        raise QualificationError("remote tool-result continuation response is invalid") from exc
    continuation_ok = (
        continuation_contract["complete"]
        and readback_evidence["exact_readback"]
        and readback_evidence["unexpected_function_calls"] == 0
    )
    if not continuation_ok:
        raise QualificationError("remote Responses tool-result continuation did not return the exact result")

    observed_models = stream_observed_models(events)
    tool_model = safe_observed_model(tool_response.get("model"))
    if tool_model:
        observed_models.add(tool_model)
    continuation_model = safe_observed_model(continuation_response.get("model"))
    if continuation_model:
        observed_models.add(continuation_model)
    provider_host = urlsplit(config["base_url"]).hostname
    return {
        "schema": RECEIPT_SCHEMA,
        "result": "qualified",
        "probe_version": PROBE_VERSION,
        "qualified_at": timestamp,
        "descriptor_sha256": descriptor_sha256,
        "provider": {
            "name": config["name"],
            "host": provider_host,
            "base_path": urlsplit(config["base_url"]).path or "/",
            "wire_api": "responses",
            "credential_env_key": config["env_key"],
        },
        "model": {
            "requested": model,
            "observed": sorted(observed_models),
            "identity_policy": "provider-defined-name-not-content-addressed",
            "immutable_weights_proven": False,
        },
        "probes": [
            {
                "name": "instructions_streaming",
                "result": "pass",
                "http_status": stream_status,
                "duration_ms": stream_ms,
                "content_type": stream_headers.get("content-type", "").split(";", 1)[0].strip().lower(),
                "event_types": sorted(set(event_types)),
                "exact_output": True,
                "response_contract": stream_contract,
                "framing_contract": "sandcodex-ideas.strict-responses-sse.v1",
                "output_sha256": digest_bytes(stream_marker.encode()),
            },
            {
                "name": "strict_function_call",
                "result": "pass",
                "http_status": tool_status,
                "duration_ms": tool_ms,
                "content_type": tool_headers.get("content-type", "").split(";", 1)[0].strip().lower(),
                "exact_single_call": True,
                "response_contract": tool_contract,
                "call_name": tool_name,
                "arguments_sha256": digest_bytes(canonical_json(expected_args)),
            },
            {
                "name": "tool_result_continuation",
                "result": "pass",
                "http_status": continuation_status,
                "duration_ms": continuation_ms,
                "content_type": continuation_headers.get("content-type", "").split(";", 1)[0].strip().lower(),
                "exact_readback": True,
                "output_sha256": digest_bytes(challenge.encode()),
                "followup_evidence": continuation_evidence,
                "readback_evidence": readback_evidence,
                "response_contract": continuation_contract,
            },
        ],
        "transport": {
            "https": True,
            "tls_verification": "system-default",
            "redirects_followed": False,
            "retries": 0,
            "request_count": 3,
        },
        "retention": {
            "credential_value_persisted": False,
            "authorization_header_persisted": False,
            "raw_request_persisted": False,
            "raw_response_persisted": False,
            "prompt_or_output_text_persisted": False,
        },
        "limits": {
            "request_bytes": MAX_REQUEST_BYTES,
            "response_bytes": MAX_RESPONSE_BYTES,
            "events": MAX_EVENTS,
            "automatic_requalification": False,
        },
    }


def validate_receipt(value: dict[str, Any], config: dict[str, str], descriptor_sha256: str, model: str) -> dict[str, Any]:
    expected_keys = {
        "schema", "result", "probe_version", "qualified_at", "descriptor_sha256", "provider",
        "model", "probes", "transport", "retention", "limits",
    }
    if set(value) != expected_keys or value.get("schema") != RECEIPT_SCHEMA or value.get("result") != "qualified":
        raise QualificationError("remote qualification receipt schema mismatch")
    if value.get("probe_version") != PROBE_VERSION or value.get("descriptor_sha256") != descriptor_sha256:
        raise QualificationError("remote qualification receipt identity mismatch")
    valid_timestamp(value.get("qualified_at"))
    provider = value.get("provider")
    expected_provider = {
        "name": config["name"],
        "host": urlsplit(config["base_url"]).hostname,
        "base_path": urlsplit(config["base_url"]).path or "/",
        "wire_api": "responses",
        "credential_env_key": config["env_key"],
    }
    if provider != expected_provider:
        raise QualificationError("remote qualification receipt provider metadata changed")
    model_value = value.get("model")
    if not isinstance(model_value, dict) or model_value.get("requested") != model:
        raise QualificationError("remote qualification receipt model mismatch")
    if model_value.get("identity_policy") != "provider-defined-name-not-content-addressed" or model_value.get("immutable_weights_proven") is not False:
        raise QualificationError("remote qualification receipt overstates model identity")
    observed = model_value.get("observed")
    if not isinstance(observed, list) or len(observed) > 16 or any(safe_observed_model(item) != item for item in observed):
        raise QualificationError("remote qualification receipt observed-model metadata is invalid")
    probes = value.get("probes")
    if not isinstance(probes, list) or len(probes) != 3:
        raise QualificationError("remote qualification receipt probe count is invalid")
    by_name = {row.get("name"): row for row in probes if isinstance(row, dict)}
    if set(by_name) != {"instructions_streaming", "strict_function_call", "tool_result_continuation"}:
        raise QualificationError("remote qualification receipt probe names are invalid")
    stream = by_name["instructions_streaming"]
    tool = by_name["strict_function_call"]
    continuation = by_name["tool_result_continuation"]
    if stream.get("framing_contract") != "sandcodex-ideas.strict-responses-sse.v1":
        raise QualificationError("remote qualification framing evidence is invalid")
    for probe in (stream, tool, continuation):
        contract = probe.get("response_contract")
        if not isinstance(contract, dict) or (
            contract.get("schema") != "sandcodex-ideas.response-contract.v1"
            or contract.get("outcome") != "completed"
            or contract.get("complete") is not True
            or contract.get("terminal_event") != "response.completed"
            or contract.get("error_category") is not None
            or contract.get("issues") != []
            or contract.get("warnings") != []
            or contract.get("automatic_retry_authorized") is not False
            or contract.get("tool_execution_observed") is not False
            or contract.get("task_success_proven") is not False
        ):
            raise QualificationError("remote qualification completion evidence is invalid")
    if (
        stream.get("result") != "pass" or stream.get("exact_output") is not True
        or stream.get("http_status") not in range(200, 300)
        or stream.get("content_type") != "text/event-stream"
        or not isinstance(stream.get("event_types"), list)
        or "response.output_text.delta" not in stream["event_types"]
        or "response.completed" not in stream["event_types"]
        or not HASH.fullmatch(str(stream.get("output_sha256", "")))
    ):
        raise QualificationError("remote qualification streaming evidence is invalid")
    if (
        tool.get("result") != "pass" or tool.get("exact_single_call") is not True
        or tool.get("http_status") not in range(200, 300)
        or tool.get("call_name") != "record_sandcodex_remote_probe"
        or not HASH.fullmatch(str(tool.get("arguments_sha256", "")))
    ):
        raise QualificationError("remote qualification function-call evidence is invalid")
    followup = continuation.get("followup_evidence")
    readback = continuation.get("readback_evidence")
    if (
        continuation.get("result") != "pass"
        or continuation.get("exact_readback") is not True
        or continuation.get("http_status") not in range(200, 300)
        or continuation.get("content_type") != "application/json"
        or not HASH.fullmatch(str(continuation.get("output_sha256", "")))
        or followup != {
            "schema": "sandcodex-ideas.remote-tool-result-followup.v1",
            "full_history_replayed": True,
            "function_call_output_appended": True,
            "call_id_preserved": True,
            "store_false": True,
            "previous_response_id_used": False,
            "live_tools_declared": False,
            "challenge_created_after_first_response": True,
        }
        or readback != {
            "schema": "sandcodex-ideas.remote-tool-result-readback.v1",
            "exact_readback": True,
            "unexpected_function_calls": 0,
            "visible_text_present": True,
            "task_success_proven": False,
            "tool_execution_observed": False,
        }
    ):
        raise QualificationError("remote qualification tool-result continuation evidence is invalid")
    if value.get("transport") != {
        "https": True, "tls_verification": "system-default", "redirects_followed": False,
        "retries": 0, "request_count": 3,
    }:
        raise QualificationError("remote qualification transport policy is invalid")
    if value.get("retention") != {
        "credential_value_persisted": False,
        "authorization_header_persisted": False,
        "raw_request_persisted": False,
        "raw_response_persisted": False,
        "prompt_or_output_text_persisted": False,
    }:
        raise QualificationError("remote qualification retention policy is invalid")
    limits = value.get("limits")
    if not isinstance(limits, dict) or limits.get("automatic_requalification") is not False:
        raise QualificationError("remote qualification cache policy is invalid")
    return value


def require_private_dir(path: Path) -> int:
    if not path.is_absolute():
        raise QualificationError("qualification cache root must be absolute")
    assert_no_symlink_components(path)
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    metadata = os.fstat(fd)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
        os.close(fd)
        raise QualificationError("qualification cache directory must be private and user-owned")
    return fd


def ensure_descriptor_dir(root: Path, descriptor_sha256: str) -> Path:
    root_fd = require_private_dir(root)
    try:
        try:
            os.mkdir(descriptor_sha256, 0o700, dir_fd=root_fd)
            os.fsync(root_fd)
        except FileExistsError:
            pass
        flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        child_fd = os.open(descriptor_sha256, flags, dir_fd=root_fd)
        try:
            metadata = os.fstat(child_fd)
            if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid() or stat.S_IMODE(metadata.st_mode) & 0o077:
                raise QualificationError("descriptor qualification directory is unsafe")
        finally:
            os.close(child_fd)
    finally:
        os.close(root_fd)
    return root / descriptor_sha256


class QualificationLock:
    def __init__(self, directory: Path, key: str):
        self.directory = directory
        self.key = key
        self.fd: int | None = None

    def __enter__(self) -> "QualificationLock":
        directory_fd = require_private_dir(self.directory)
        try:
            flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
            self.fd = os.open(f".{self.key}.lock", flags, 0o600, dir_fd=directory_fd)
        finally:
            os.close(directory_fd)
        metadata = os.fstat(self.fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077:
            os.close(self.fd)
            self.fd = None
            raise QualificationError("remote qualification lock is unsafe")
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            os.close(self.fd)
            self.fd = None
            raise QualificationBusy("another qualification for this descriptor/model is active") from exc
        return self

    def __exit__(self, _kind: object, _value: object, _traceback: object) -> None:
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


def atomic_receipt(path: Path, value: dict[str, Any]) -> None:
    directory_fd = require_private_dir(path.parent)
    data = json.dumps(value, sort_keys=True, indent=2, allow_nan=False).encode("utf-8") + b"\n"
    temporary_fd = -1
    temporary_name = ""
    try:
        temporary_fd, temporary_path = tempfile.mkstemp(prefix=".qualification-", dir=path.parent)
        temporary_name = Path(temporary_path).name
        with os.fdopen(temporary_fd, "wb", closefd=True) as stream:
            temporary_fd = -1
            os.fchmod(stream.fileno(), 0o600)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_name, path.name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        if temporary_fd >= 0:
            os.close(temporary_fd)
        if temporary_name:
            try:
                os.unlink(temporary_name, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
        os.close(directory_fd)


def result_record(receipt_path: Path, receipt: dict[str, Any], *, reused: bool, requests: int) -> dict[str, Any]:
    raw = read_private_bytes(receipt_path, 4 * 1024 * 1024)
    return {
        "schema": RESULT_SCHEMA,
        "result": "qualified",
        "reused": reused,
        "network_requests": requests,
        "receipt_path": str(receipt_path),
        "receipt_sha256": digest_bytes(raw),
        "descriptor_sha256": receipt["descriptor_sha256"],
        "model": receipt["model"]["requested"],
        "probe_version": receipt["probe_version"],
        "model_identity_policy": receipt["model"]["identity_policy"],
        "credential_value_disclosed": False,
        "raw_provider_content_disclosed": False,
    }


def qualify_cached(
    snapshot: Path,
    credential_file: Path,
    model: str,
    descriptor_sha256: str,
    root: Path,
    timeout: float,
    timestamp: str | None,
    force: bool = False,
    client_factory: Callable[[str, str, float], Any] = HTTPSResponsesClient,
) -> dict[str, Any]:
    config = normalize_snapshot(read_private_json(snapshot, MAX_SNAPSHOT_BYTES))
    model = valid_model(model)
    if not HASH.fullmatch(descriptor_sha256) or descriptor_identity(config) != descriptor_sha256:
        raise QualificationError("descriptor digest does not match the selected snapshot")
    if not 1 <= timeout <= 180:
        raise QualificationError("qualification timeout must be between 1 and 180 seconds")
    credential_raw = read_private_bytes(credential_file, MAX_CREDENTIAL_BYTES)
    try:
        credential = credential_raw.decode("utf-8", "strict")
    except UnicodeDecodeError as exc:
        raise QualificationError("remote credential is not UTF-8") from exc
    if not credential or "\n" in credential or "\r" in credential:
        raise QualificationError("remote credential is empty or contains a line break")
    descriptor_dir = ensure_descriptor_dir(root, descriptor_sha256)
    model_key = digest_bytes(model.encode("utf-8"))
    receipt_path = descriptor_dir / f"{model_key}.{PROBE_VERSION}.json"
    with QualificationLock(descriptor_dir, model_key):
        if not force and (receipt_path.exists() or receipt_path.is_symlink()):
            receipt = validate_receipt(read_private_json(receipt_path, 4 * 1024 * 1024), config, descriptor_sha256, model)
            return result_record(receipt_path, receipt, reused=True, requests=0)
        client = client_factory(config["base_url"], credential, timeout)
        receipt = qualify_receipt(config, descriptor_sha256, model, client, valid_timestamp(timestamp))
        validate_receipt(receipt, config, descriptor_sha256, model)
        atomic_receipt(receipt_path, receipt)
        return result_record(receipt_path, receipt, reused=False, requests=3)


def verify_cached(snapshot: Path, receipt_path: Path, model: str, descriptor_sha256: str) -> dict[str, Any]:
    config = normalize_snapshot(read_private_json(snapshot, MAX_SNAPSHOT_BYTES))
    if descriptor_identity(config) != descriptor_sha256:
        raise QualificationError("descriptor digest does not match the selected snapshot")
    receipt = validate_receipt(read_private_json(receipt_path, 4 * 1024 * 1024), config, descriptor_sha256, valid_model(model))
    return result_record(receipt_path, receipt, reused=True, requests=0)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)
    qualify = sub.add_parser("qualify")
    qualify.add_argument("--snapshot", type=Path, required=True)
    qualify.add_argument("--credential-file", type=Path, required=True)
    qualify.add_argument("--model", required=True)
    qualify.add_argument("--descriptor-sha256", required=True)
    qualify.add_argument("--root", type=Path, required=True)
    qualify.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT)
    qualify.add_argument("--timestamp")
    qualify.add_argument("--force", action="store_true", help="ignore an existing cached receipt and perform the bounded probes")
    verify = sub.add_parser("verify")
    verify.add_argument("--snapshot", type=Path, required=True)
    verify.add_argument("--receipt", type=Path, required=True)
    verify.add_argument("--model", required=True)
    verify.add_argument("--descriptor-sha256", required=True)
    return p


def fail(message: str, code: int) -> int:
    print(f"sandcodex remote qualification: {message}", file=sys.stderr)
    return code


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.command == "qualify":
            value = qualify_cached(
                args.snapshot, args.credential_file, args.model, args.descriptor_sha256,
                args.root, args.timeout, args.timestamp, args.force,
            )
        else:
            value = verify_cached(args.snapshot, args.receipt, args.model, args.descriptor_sha256)
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return 0
    except QualificationBusy as exc:
        return fail(str(exc), 75)
    except FileNotFoundError as exc:
        return fail(f"required private file is missing: {exc.filename or exc}", 66)
    except ProviderUnavailable as exc:
        return fail(str(exc), 69)
    except (QualificationError, OSError, ValueError, json.JSONDecodeError) as exc:
        return fail(str(exc), 78)


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_REMOTE_QUALIFIER_PY
}

sc_emit_remote_config() {
  cat <<'SANDCODEX_REMOTE_CONFIG_PY'
#!/usr/bin/env python3
"""Resolve and atomically manage a private Responses-provider catalog.

Credential *names* may be stored. Credential values never belong in the catalog,
provider snapshots, command arguments, or this program's output.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import re
import stat
import sys
from urllib.parse import urlsplit

MAX_CATALOG_BYTES = 64 * 1024
MAX_PROVIDERS = 64
PROVIDER_NAME = re.compile(r"[A-Za-z0-9_-]{1,48}\Z")
ENV_NAME = re.compile(
    r"(?=.{1,96}\Z)[A-Z][A-Z0-9_]*(?:_API_KEY|_TOKEN|_SECRET)\Z"
)
PATH_CHARS = re.compile(r"(?:[A-Za-z0-9._~/-]|%[0-9A-Fa-f]{2})*\Z")
BUILTIN_NAME = "openai_api"
BUILTIN_OPENAI = {
    "name": BUILTIN_NAME,
    "base_url": "https://api.openai.com/v1",
    "env_key": "OPENAI_API_KEY",
    "wire_api": "responses",
}
BUILTIN_OPENROUTER = {
    "name": "openrouter",
    "base_url": "https://openrouter.ai/api/v1",
    "env_key": "OPENROUTER_API_KEY",
    "wire_api": "responses",
}
BUILTINS = {
    BUILTIN_NAME: BUILTIN_OPENAI,
    "openrouter": BUILTIN_OPENROUTER,
}


class ConfigError(ValueError):
    pass


class CatalogBusy(ConfigError):
    pass


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")


def identity(config: dict) -> str:
    return hashlib.sha256(canonical_json(config).rstrip(b"\n")).hexdigest()


def strict_object(pairs: list[tuple[str, object]]) -> dict:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise ConfigError(f"duplicate JSON field: {key}")
        result[key] = value
    return result


def no_symlink_components(path: Path) -> None:
    absolute = path.absolute()
    cursor = Path(absolute.anchor)
    for component in absolute.parts[1:]:
        cursor /= component
        try:
            if cursor.is_symlink():
                raise ConfigError("remote provider path contains a symlink")
        except OSError as exc:
            raise ConfigError(f"remote provider path could not be inspected: {exc}") from exc


def read_private(path: Path) -> dict:
    no_symlink_components(path)
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as handle:
        metadata = os.fstat(handle.fileno())
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) & 0o077
        ):
            raise ConfigError(
                "remote provider config must be a private, single-linked, operator-owned file"
            )
        if metadata.st_size > MAX_CATALOG_BYTES:
            raise ConfigError("remote provider config is too large")
        try:
            result = json.load(handle, object_pairs_hook=strict_object)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ConfigError(f"remote provider config is not strict JSON: {exc}") from exc
    if not isinstance(result, dict):
        raise ConfigError("remote provider config must be an object")
    return result


def normalize(value: dict) -> dict:
    if not isinstance(value, dict):
        raise ConfigError("provider descriptor must be an object")
    if set(value) - {"name", "base_url", "env_key", "wire_api"}:
        raise ConfigError("unsupported provider fields; credentials do not belong in this file")
    name, url, key = (value.get(field) for field in ("name", "base_url", "env_key"))
    if not isinstance(name, str) or not PROVIDER_NAME.fullmatch(name):
        raise ConfigError("provider name must be a short identifier")
    if not isinstance(url, str) or len(url) > 1024 or any(ord(char) < 33 or ord(char) > 126 for char in url):
        raise ConfigError("invalid provider URL")
    try:
        parsed = urlsplit(url)
        port = parsed.port
    except ValueError as exc:
        raise ConfigError(f"invalid provider URL: {exc}") from exc
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username
        or parsed.password
        or parsed.query
        or parsed.fragment
    ):
        raise ConfigError("remote API requires HTTPS without URL credentials, queries, or fragments")
    host = parsed.hostname.lower()
    if port not in (None, 443) or not re.fullmatch(r"[A-Za-z0-9.-]+", host):
        raise ConfigError("remote API must use DNS and HTTPS port 443")
    if "." not in host or host.endswith((".localhost", ".local", ".internal")):
        raise ConfigError("remote API hostname must not be local")
    try:
        ipaddress.ip_address(host)
    except ValueError:
        pass
    else:
        raise ConfigError("remote provider IP literals are not supported by this adapter")
    if not PATH_CHARS.fullmatch(parsed.path) or ".." in parsed.path.split("/"):
        raise ConfigError("invalid provider base path")
    if not isinstance(key, str) or not ENV_NAME.fullmatch(key):
        raise ConfigError("env_key must end in _API_KEY, _TOKEN, or _SECRET")
    if value.get("wire_api", "responses") != "responses":
        raise ConfigError("this adapter requires a Responses-compatible provider, not arbitrary chat APIs")
    path = parsed.path.rstrip("/")
    return {
        "name": name,
        "base_url": f"https://{host}{path}",
        "env_key": key,
        "wire_api": "responses",
    }


def validate_catalog(data: dict | None) -> tuple[str, dict[str, dict]]:
    if data is None:
        return BUILTIN_NAME, {}
    if set(data) != {"default", "providers"} or not isinstance(data.get("providers"), dict):
        raise ConfigError("provider catalog requires exactly default and providers fields")
    default = data.get("default")
    providers = data["providers"]
    if not isinstance(default, str) or not PROVIDER_NAME.fullmatch(default):
        raise ConfigError("provider catalog default is invalid")
    if len(providers) > MAX_PROVIDERS:
        raise ConfigError("provider catalog contains too many providers")
    normalized: dict[str, dict] = {}
    for key, descriptor in providers.items():
        if not isinstance(key, str) or not PROVIDER_NAME.fullmatch(key):
            raise ConfigError("provider catalog key is invalid")
        item = normalize(descriptor)
        if item["name"] != key:
            raise ConfigError("provider catalog key and name differ")
        if key in BUILTINS:
            if item != BUILTINS[key]:
                raise ConfigError(f"{key} is reserved and cannot be redirected")
            continue
        normalized[key] = item
    if default not in BUILTINS and default not in normalized:
        raise ConfigError("provider catalog default is not configured")
    return default, normalized


def stored_catalog(default: str, providers: dict[str, dict]) -> dict:
    return {"default": default, "providers": {name: providers[name] for name in sorted(providers)}}


def effective_catalog(default: str, providers: dict[str, dict]) -> dict[str, dict]:
    result = {name: descriptor.copy() for name, descriptor in BUILTINS.items()}
    result.update(providers)
    if default not in result:
        raise ConfigError("provider catalog default is not configured")
    return result


def load_catalog(path: Path) -> tuple[bool, str, dict[str, dict], str | None]:
    no_symlink_components(path)
    present = path.exists() or path.is_symlink()
    if not present:
        return False, BUILTIN_NAME, {}, None
    data = read_private(path)
    default, providers = validate_catalog(data)
    digest = hashlib.sha256(canonical_json(stored_catalog(default, providers))).hexdigest()
    return True, default, providers, digest


def credential_state(env_key: str) -> str:
    value = os.environ.get(env_key)
    if value is None or not value:
        return "missing"
    if len(value) > 16384 or "\n" in value or "\r" in value:
        return "invalid"
    return "present"


def status_record(path: Path, *, result: str = "status", operation: dict | None = None) -> dict:
    present, default, custom, catalog_sha = load_catalog(path)
    providers = effective_catalog(default, custom)
    rows = []
    for name in sorted(providers):
        descriptor = providers[name]
        rows.append(
            {
                "name": name,
                "base_url": descriptor["base_url"],
                "host": urlsplit(descriptor["base_url"]).hostname,
                "env_key": descriptor["env_key"],
                "wire_api": "responses",
                "descriptor_sha256": identity(descriptor),
                "builtin": name in BUILTINS,
                "default": name == default,
                "credential_state": credential_state(descriptor["env_key"]),
            }
        )
    value = {
        "schema": "sandcodex.remote-provider-catalog-status.v1",
        "result": result,
        "catalog_path": str(path),
        "catalog_present": present,
        "catalog_sha256": catalog_sha,
        "default": default,
        "providers": rows,
        "credential_values_disclosed": False,
        "endpoint_probe_run": False,
        "existing_project_snapshots_changed": False,
        "existing_bound_conversations_retargeted": False,
    }
    if operation is not None:
        value["operation"] = operation
    return value


class CatalogLock:
    def __init__(self, catalog: Path):
        self.catalog = catalog
        self.parent = catalog.parent
        self.dir_fd: int | None = None
        self.lock_fd: int | None = None

    def __enter__(self) -> "CatalogLock":
        if not self.catalog.is_absolute() or self.catalog.name != "providers.json":
            raise ConfigError("remote catalog path must be an absolute providers.json path")
        no_symlink_components(self.parent)
        if not self.parent.exists():
            try:
                os.mkdir(self.parent, 0o700)
            except FileExistsError:
                pass
        flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        self.dir_fd = os.open(self.parent, flags)
        metadata = os.fstat(self.dir_fd)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise ConfigError("remote catalog directory is not operator-owned")
        os.fchmod(self.dir_fd, 0o700)
        lock_flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        self.lock_fd = os.open(".providers.lock", lock_flags, 0o600, dir_fd=self.dir_fd)
        lock_meta = os.fstat(self.lock_fd)
        if (
            not stat.S_ISREG(lock_meta.st_mode)
            or lock_meta.st_uid != os.getuid()
            or lock_meta.st_nlink != 1
        ):
            raise ConfigError("remote catalog lock is unsafe")
        os.fchmod(self.lock_fd, 0o600)
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise CatalogBusy("another remote catalog maintenance operation is active") from exc
        return self

    def write(self, value: dict) -> None:
        assert self.dir_fd is not None
        data = canonical_json(value)
        if len(data) > MAX_CATALOG_BYTES:
            raise ConfigError("remote provider catalog is too large")
        temporary = f".providers.json.tmp.{os.getpid()}.{os.urandom(8).hex()}"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(temporary, flags, 0o600, dir_fd=self.dir_fd)
        try:
            with os.fdopen(fd, "wb", closefd=False) as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.fchmod(fd, 0o600)
        finally:
            os.close(fd)
        try:
            os.replace(temporary, self.catalog.name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
            os.fsync(self.dir_fd)
        except BaseException:
            try:
                os.unlink(temporary, dir_fd=self.dir_fd)
            except OSError:
                pass
            raise

    def __exit__(self, exc_type, exc, traceback) -> None:
        if self.lock_fd is not None:
            try:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
            finally:
                os.close(self.lock_fd)
        if self.dir_fd is not None:
            os.close(self.dir_fd)


def resolve(file: Path | None, provider: str | None, snapshot: Path | None) -> dict:
    if snapshot is not None:
        if file is not None or provider is not None:
            raise ConfigError("snapshot resolution cannot be combined with catalog selection")
        result = normalize(read_private(snapshot))
        if snapshot.name != identity(result) + ".json":
            raise ConfigError("provider snapshot identity mismatch")
    else:
        path = file
        if path is None:
            default, custom = BUILTIN_NAME, {}
        else:
            _present, default, custom, _digest = load_catalog(path)
        providers = effective_catalog(default, custom)
        chosen = provider or default
        if not isinstance(chosen, str) or chosen not in providers:
            raise ConfigError("requested remote provider is not configured")
        result = providers[chosen]
    return {
        "config": result,
        "sha256": identity(result),
        "host": urlsplit(result["base_url"]).hostname,
    }


def mutate_catalog(args: argparse.Namespace) -> dict:
    path: Path = args.catalog
    with CatalogLock(path) as lock:
        _present, default, custom, before_sha = load_catalog(path)
        before = stored_catalog(default, custom)
        if args.catalog_action == "configure":
            if args.name in BUILTINS:
                raise ConfigError(f"{args.name} is built in and cannot be reconfigured")
            descriptor = normalize(
                {
                    "name": args.name,
                    "base_url": args.base_url,
                    "env_key": args.env_key,
                    "wire_api": "responses",
                }
            )
            previous = custom.get(args.name)
            custom[args.name] = descriptor
            if args.set_default:
                default = args.name
            operation = {
                "action": "configure",
                "name": args.name,
                "changed": previous != descriptor or before["default"] != default,
                "previous_descriptor_sha256": identity(previous) if previous else None,
                "descriptor_sha256": identity(descriptor),
                "set_default": bool(args.set_default),
                "timestamp": args.timestamp,
            }
            result = "configured" if operation["changed"] else "unchanged"
        elif args.catalog_action == "default":
            if args.name not in BUILTINS and args.name not in custom:
                raise ConfigError("requested default provider is not configured")
            previous_default = default
            default = args.name
            operation = {
                "action": "default",
                "name": args.name,
                "changed": previous_default != default,
                "previous_default": previous_default,
                "timestamp": args.timestamp,
            }
            result = "default_changed" if operation["changed"] else "unchanged"
        elif args.catalog_action == "remove":
            if args.name in BUILTINS:
                raise ConfigError(f"{args.name} is built in and cannot be removed")
            if args.name not in custom:
                raise ConfigError("remote provider is not configured")
            if default == args.name:
                raise ConfigError("cannot remove the default provider; select another default first")
            removed = custom.pop(args.name)
            operation = {
                "action": "remove",
                "name": args.name,
                "changed": True,
                "removed_descriptor_sha256": identity(removed),
                "timestamp": args.timestamp,
            }
            result = "removed"
        else:
            raise ConfigError("unknown catalog operation")
        after = stored_catalog(default, custom)
        if before != after:
            lock.write(after)
        record = status_record(path, result=result, operation=operation)
        record["previous_catalog_sha256"] = before_sha
        return record


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--file", type=Path)
    p.add_argument("--provider")
    p.add_argument("--snapshot", type=Path)
    return p


def catalog_parser(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog="sandcodex remote catalog", description=__doc__)
    p.add_argument("--catalog", type=Path, required=True)
    sub = p.add_subparsers(dest="catalog_action", required=True)
    status = sub.add_parser("status")
    configure = sub.add_parser("configure")
    configure.add_argument("--name", required=True)
    configure.add_argument("--base-url", required=True)
    configure.add_argument("--env-key", required=True)
    configure.add_argument("--set-default", action="store_true")
    configure.add_argument("--timestamp", required=True)
    default = sub.add_parser("default")
    default.add_argument("--name", required=True)
    default.add_argument("--timestamp", required=True)
    remove = sub.add_parser("remove")
    remove.add_argument("--name", required=True)
    remove.add_argument("--timestamp", required=True)
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        if argv and argv[0] == "catalog":
            args = catalog_parser(argv[1:])
            if args.catalog_action == "status":
                value = status_record(args.catalog)
            else:
                value = mutate_catalog(args)
        else:
            args = parser().parse_args(argv)
            value = resolve(args.file, args.provider, args.snapshot)
        print(json.dumps(value, sort_keys=True, separators=(",", ":")))
        return 0
    except CatalogBusy as exc:
        print(f"sandcodex remote: {exc}", file=sys.stderr)
        return 75
    except (OSError, ValueError, TypeError, KeyError) as exc:
        print(f"sandcodex remote: {exc}", file=sys.stderr)
        return 78


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_REMOTE_CONFIG_PY
}

sc_emit_local_library() {
  cat <<'SANDCODEX_LOCAL_RUNTIME_LIBRARY_SH'
readonly SCL_NIXPKGS_REV="8eb9f99282ae9b85dcc5912cd3bb50035b7f4289"
# Provider-only revision override. Never changes the Codex/Sandcodex pin.
SCL_PROVIDER_NIXPKGS_REV=""

scl_err()  { printf 'sandcodex-local: %s\n' "$*" >&2; }
scl_die()  { scl_err "$1"; exit "${2:-70}"; }
scl_note() { printf 'SANDCODEX_LOCAL_NOTE=%s\n' "$*" >&2; }
scl_have() { command -v "$1" >/dev/null 2>&1; }

scl_realpath() {
  if scl_have realpath; then realpath -m -- "$1"; else readlink -m -- "$1"; fi
}

scl_set_provider_nixpkgs_rev() {
  SCL_PROVIDER_NIXPKGS_REV="${SANDCODEX_LOCAL_NIXPKGS_REV:-$SCL_NIXPKGS_REV}"
}

scl_state_init() {
  scl_set_provider_nixpkgs_rev
  local base="${XDG_STATE_HOME:-$HOME/.local/state}/sandcodex/local"
  local data="${XDG_DATA_HOME:-$HOME/.local/share}/sandcodex/local"
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/sandcodex/local"
  SCL_STATE_ROOT="${SANDCODEX_LOCAL_STATE_ROOT:-$base}"
  SCL_DATA_ROOT="${SANDCODEX_LOCAL_DATA_ROOT:-$data}"
  SCL_CACHE_ROOT="${SANDCODEX_LOCAL_CACHE_ROOT:-$cache}"
  for d in "$SCL_STATE_ROOT" "$SCL_DATA_ROOT" "$SCL_CACHE_ROOT"; do
    [[ "$d" == /* ]] || scl_die "state roots must be absolute: $d" 64
    [[ ! -L "$d" ]] || scl_die "state root may not be a symlink: $d" 64
    install -d -m 0700 -- "$d"
    [[ "$(stat -c %u -- "$d")" == "$(id -u)" ]] || scl_die "state root is not owned by current user: $d" 77
    sc_private_dir "$d" "managed-local state root"
  done
  SCL_OLLAMA_MODELS="$SCL_DATA_ROOT/ollama-models"
  SCL_LOG_ROOT="$SCL_STATE_ROOT/logs"
  SCL_RUNTIME_HOME="$SCL_STATE_ROOT/runtime-home"
  SCL_RUNTIME_CACHE="$SCL_CACHE_ROOT/runtime"
  SCL_RUNTIME_CONFIG="$SCL_STATE_ROOT/runtime-config"
  SCL_RUNTIME_DATA="$SCL_DATA_ROOT/runtime"
  SCL_RUNTIME_STATE="$SCL_STATE_ROOT/runtime-state"
  SCL_RUNTIME_TMP="$SCL_CACHE_ROOT/tmp"
  install -d -m 0700 -- "$SCL_OLLAMA_MODELS" "$SCL_LOG_ROOT" "$SCL_RUNTIME_HOME" \
    "$SCL_RUNTIME_CACHE" "$SCL_RUNTIME_CONFIG" "$SCL_RUNTIME_DATA" "$SCL_RUNTIME_STATE" "$SCL_RUNTIME_TMP"
  sc_private_dir "$SCL_OLLAMA_MODELS" "managed-local model store"
  sc_private_dir "$SCL_LOG_ROOT" "managed-local log root"
  sc_private_dir "$SCL_RUNTIME_HOME" "managed-local runtime home"
  sc_private_dir "$SCL_RUNTIME_CACHE" "managed-local runtime cache"
  sc_private_dir "$SCL_RUNTIME_CONFIG" "managed-local runtime config"
  sc_private_dir "$SCL_RUNTIME_DATA" "managed-local runtime data"
  sc_private_dir "$SCL_RUNTIME_STATE" "managed-local runtime state"
  sc_private_dir "$SCL_RUNTIME_TMP" "managed-local runtime temporary directory"
}

scl_validate_model() {
  local model=$1
  [[ -n "$model" && ${#model} -le 192 ]] || scl_die "model identifier is empty or too long" 64
  [[ "$model" =~ ^[A-Za-z0-9][A-Za-z0-9._:+/@-]*$ ]] || scl_die "invalid model identifier: $model" 64
}

scl_curl() {
  command curl --fail --silent --show-error --max-time "${SANDCODEX_LOCAL_HTTP_TIMEOUT:-10}" "$@"
}

scl_server_version() {
  local port=$1
  scl_curl "http://127.0.0.1:${port}/api/version"
}

scl_port_listening() {
  local port=$1
  scl_server_version "$port" >/dev/null 2>&1
}

scl_select_backend() {
  local requested=$1
  case "$requested" in
    cpu) printf 'cpu\n'; return ;;
    auto|cuda) ;;
    *) scl_die "backend must be auto, cuda, or cpu" 64 ;;
  esac
  if scl_have nvidia-smi && scl_have timeout && \
    timeout 8s nvidia-smi -L >/dev/null 2>&1; then
    printf 'cuda\n'
  elif [[ "$requested" == cuda ]]; then
    scl_die "CUDA was required but NVIDIA inventory is unavailable; repair the host driver or select --backend cpu" 69
  else
    scl_note "NVIDIA inventory unavailable; selecting the CPU package (not a cloud fallback)"
    printf 'cpu\n'
  fi
}

scl_nix_ollama() {
  local attribute
  case "${SCL_BACKEND:-}" in
    cpu) attribute=ollama-cpu ;;
    cuda) attribute=ollama-cuda ;;
    *) scl_die "internal error: select a backend before realizing Ollama" 70 ;;
  esac
  [[ "$SCL_PROVIDER_NIXPKGS_REV" =~ ^[0-9a-f]{40}$ ]] || \
    scl_die "SANDCODEX_LOCAL_NIXPKGS_REV must be a full lowercase 40-character commit" 64
  local -a outputs=()
  local output candidate selected="" configured="${SANDCODEX_LOCAL_OLLAMA_BIN:-}"
  if [[ -n "$configured" ]]; then
    configured="$(scl_realpath "$configured")"
    [[ -f "$configured" && -x "$configured" ]] || scl_die "configured Ollama binary is not executable: $configured" 69
    scl_note "using configured host Ollama binary: $configured"
    printf '%s\n' "$configured"
    return
  fi
  scl_have nix || scl_die "nix is required to realize the pinned $attribute package" 69
  if [[ "$attribute" == ollama-cuda ]]; then
    scl_note "realizing nixpkgs#ollama-cuda; if substitutes are unavailable this can build a large CUDA/Ollama stack"
    scl_note "to avoid that path for first proof, use: sandcodex local probe MODEL --backend cuda --local-ollama-bin /path/to/ollama"
  fi
  mapfile -t outputs < <(
    # CUDA dependencies may be unfree. Scope permission to this realization;
    # do not modify the user's or host's nixpkgs configuration.
    NIXPKGS_ALLOW_UNFREE=1 nix --extra-experimental-features 'nix-command flakes' build \
      --impure --no-link --print-out-paths \
      "github:NixOS/nixpkgs/${SCL_PROVIDER_NIXPKGS_REV}#${attribute}"
  )
  for output in "${outputs[@]}"; do
    [[ "$output" == /nix/store/* && -d "$output" ]] || scl_die "Nix returned an unsafe output path: $output"
    candidate="$output/bin/ollama"
    [[ -x "$candidate" ]] || continue
    [[ -z "$selected" ]] || scl_die "multiple realized outputs contain bin/ollama"
    selected=$candidate
  done
  [[ -n "$selected" ]] || scl_die "pinned $attribute realization exposed no bin/ollama"
  printf '%s\n' "$selected"
}

scl_start_ollama() {
  local ollama=$1 port=$2 keep=$3 memory_high=$4 memory_max=$5 tasks_max=$6
  local stamp unit log
  SCL_START_SEQUENCE=$(( ${SCL_START_SEQUENCE:-0} + 1 ))
  stamp="$(date -u +%Y%m%dT%H%M%S%NZ)-$$-${SCL_START_SEQUENCE}"
  unit="sandcodex-local-ollama-${stamp}"
  log="$SCL_LOG_ROOT/${unit}.log"
  SCL_STARTED_UNIT=""
  SCL_STARTED_PID=""
  SCL_KEEP_SERVER=0

  if scl_port_listening "$port"; then
    (( SCL_REUSE_SERVER )) || scl_die "127.0.0.1:$port already serves an Ollama-compatible API; use --reuse-server deliberately" 73
    scl_note "reusing pre-existing loopback provider at 127.0.0.1:$port"
    return
  fi

  local -a env_args=(
    "OLLAMA_HOST=127.0.0.1:${port}"
    "OLLAMA_NO_CLOUD=1"
    "OLLAMA_CONTEXT_LENGTH=${SANDCODEX_LOCAL_CONTEXT_LENGTH:?launcher context policy is missing}"
    "OLLAMA_MODELS=$SCL_OLLAMA_MODELS"
    "HOME=$SCL_RUNTIME_HOME"
    "XDG_CACHE_HOME=$SCL_RUNTIME_CACHE"
    "XDG_CONFIG_HOME=$SCL_RUNTIME_CONFIG"
    "XDG_DATA_HOME=$SCL_RUNTIME_DATA"
    "XDG_STATE_HOME=$SCL_RUNTIME_STATE"
    "TMPDIR=$SCL_RUNTIME_TMP"
    "OLLAMA_KEEP_ALIVE=${SANDCODEX_LOCAL_KEEP_ALIVE:?launcher keep-alive policy is missing}"
    "OLLAMA_MAX_LOADED_MODELS=${SANDCODEX_LOCAL_MAX_LOADED_MODELS:?launcher model policy is missing}"
    "OLLAMA_NUM_PARALLEL=${SANDCODEX_LOCAL_NUM_PARALLEL:?launcher concurrency policy is missing}"
    "OLLAMA_MAX_QUEUE=${SANDCODEX_LOCAL_MAX_QUEUE:?launcher queue policy is missing}"
    "OLLAMA_FLASH_ATTENTION=${SANDCODEX_LOCAL_FLASH_ATTENTION:?launcher attention policy is missing}"
    "OLLAMA_KV_CACHE_TYPE=${SANDCODEX_LOCAL_KV_CACHE_TYPE:?launcher KV-cache policy is missing}"
  )

  if [[ "${SCL_BACKEND:-}" == cpu ]]; then
    # The default CPU-only package is the main guarantee. Mask devices as
    # defense in depth when the operator deliberately supplies another binary.
    env_args+=("CUDA_VISIBLE_DEVICES=-1" "ROCR_VISIBLE_DEVICES=-1" "HIP_VISIBLE_DEVICES=-1" "GGML_VK_VISIBLE_DEVICES=-1" "OLLAMA_VULKAN=0")
  fi

  if scl_have systemd-run && systemctl --user show-environment >/dev/null 2>&1; then
    local -a cmd=(systemd-run --user --quiet --collect --unit "$unit" --service-type=exec)
    cmd+=(--property "MemoryHigh=$memory_high" --property "MemoryMax=$memory_max")
    cmd+=(--property "TasksMax=$tasks_max" --property "OOMPolicy=stop")
    cmd+=(--property "StandardOutput=append:$log" --property "StandardError=append:$log")
    local e
    for e in "${env_args[@]}"; do cmd+=(--setenv "$e"); done
    cmd+=("$ollama" serve)
    "${cmd[@]}"
    SCL_STARTED_UNIT=$unit
  else
    scl_note "user systemd manager unavailable; using a directly supervised process without cgroup ceilings"
    (
      export "${env_args[@]}"
      exec "$ollama" serve
    ) >>"$log" 2>&1 &
    SCL_STARTED_PID=$!
    SCL_STARTED_START="$(awk '{sub(/^.*\) /, ""); print $20}' "/proc/$SCL_STARTED_PID/stat" 2>/dev/null || true)"
  fi

  local i
  for (( i=0; i<120; i++ )); do
    if scl_port_listening "$port"; then SCL_KEEP_SERVER=$keep; return; fi
    if [[ -n "$SCL_STARTED_UNIT" ]]; then
      systemctl --user is-active --quiet "$SCL_STARTED_UNIT.service" || break
    elif [[ -n "$SCL_STARTED_PID" ]]; then
      kill -0 "$SCL_STARTED_PID" 2>/dev/null || break
    fi
    sleep 0.25
  done
  [[ -s "$log" ]] && tail -n 120 "$log" >&2 || true
  scl_die "Ollama did not become healthy on 127.0.0.1:$port" 70
}

scl_stop_ollama() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if (( ${SCL_KEEP_SERVER:-0} )); then
    scl_note "leaving launcher-owned Ollama running by explicit --keep-server"
  elif [[ -n "${SCL_STARTED_UNIT:-}" ]]; then
    systemctl --user stop "${SCL_STARTED_UNIT}.service" >/dev/null 2>&1 || true
  elif [[ -n "${SCL_STARTED_PID:-}" ]]; then
    kill -TERM "$SCL_STARTED_PID" 2>/dev/null || true
    local i
    for (( i=0; i<40; i++ )); do kill -0 "$SCL_STARTED_PID" 2>/dev/null || break; sleep 0.1; done
    kill -KILL "$SCL_STARTED_PID" 2>/dev/null || true
    wait "$SCL_STARTED_PID" 2>/dev/null || true
  fi
  exit "$rc"
}

scl_model_present() {
  local ollama=$1 model=$2 port=$3
  OLLAMA_HOST="127.0.0.1:$port" "$ollama" show "$model" >/dev/null 2>&1
}

scl_model_pull() {
  local ollama=$1 model=$2 port=$3
  scl_validate_model "$model"
  OLLAMA_HOST="127.0.0.1:$port" OLLAMA_MODELS="$SCL_OLLAMA_MODELS" "$ollama" pull "$model"
}
SANDCODEX_LOCAL_RUNTIME_LIBRARY_SH
}

sc_emit_provider_doctor() {
  cat <<'SANDCODEX_PROVIDER_DOCTOR_PY'
#!/usr/bin/env python3
"""Read-only family inference readiness synthesis for Sandcodex.

The shell launcher supplies validated snapshots from the existing NVIDIA,
qualified-runtime-channel, and remote-provider-catalog helpers. This program
combines them with bounded host facts. It never starts a provider, downloads a
model, contacts a remote endpoint, modifies Nix state, or prints credential
values.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import platform
import re
import stat
import sys
from typing import Any

SCHEMA = "sandcodex.provider-doctor.v1"
NVIDIA_SCHEMA = "sandcodex.nvidia-qualification.v1"
RUNTIME_SCHEMA = "sandcodex.local-runtime-result.v1"
REMOTE_SCHEMA = "sandcodex.remote-provider-catalog-status.v1"
MAX_INPUT = 16 * 1024 * 1024
HEX = re.compile(r"[0-9a-f]{64}\Z")
PIN = re.compile(r"[0-9a-f]{40}\Z")


class DoctorError(RuntimeError):
    pass


def read_json(path: Path, label: str) -> Any:
    if not path.is_absolute():
        raise DoctorError(f"{label} path must be absolute")
    try:
        st = path.lstat()
    except OSError as exc:
        raise DoctorError(f"cannot inspect {label}: {exc}") from exc
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise DoctorError(f"{label} must be a regular non-symlink file")
    if st.st_uid != os.getuid() or st.st_nlink != 1:
        raise DoctorError(f"{label} must be single-linked and owned by this user")
    if stat.S_IMODE(st.st_mode) & 0o022:
        raise DoctorError(f"{label} may not be group/other writable")
    if st.st_size < 2 or st.st_size > MAX_INPUT:
        raise DoctorError(f"{label} must be 2..{MAX_INPUT} bytes")
    try:
        raw = path.read_bytes()
        return json.loads(raw.decode("utf-8"), parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as exc:
        raise DoctorError(f"{label} is not strict JSON") from exc


def clean_text(value: Any, label: str, *, maximum: int = 512) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum:
        raise DoctorError(f"{label} is invalid")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in value) or "|" in value:
        raise DoctorError(f"{label} contains unsafe terminal characters")
    return value


def human_bytes(value: int | None) -> str:
    if value is None or value < 0:
        return "unknown"
    units = ("B", "KiB", "MiB", "GiB", "TiB")
    amount = float(value)
    for unit in units:
        if amount < 1024.0 or unit == units[-1]:
            if unit in ("B", "KiB", "MiB"):
                return f"{amount:.0f} {unit}"
            return f"{amount:.1f} {unit}"
        amount /= 1024.0
    return f"{value} B"


def meminfo() -> tuple[int | None, int | None]:
    values: dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text(encoding="ascii", errors="strict").splitlines():
            key, rest = line.split(":", 1)
            match = re.fullmatch(r"\s*([0-9]+)\s+kB\s*", rest)
            if match:
                values[key] = int(match.group(1)) * 1024
    except (OSError, UnicodeError, ValueError):
        return None, None
    return values.get("MemTotal"), values.get("MemAvailable")


def os_release() -> dict[str, str]:
    result: dict[str, str] = {}
    try:
        lines = Path("/etc/os-release").read_text(encoding="utf-8", errors="strict").splitlines()
    except (OSError, UnicodeError):
        return result
    for line in lines:
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if not re.fullmatch(r"[A-Z0-9_]+", key):
            continue
        if value.startswith('"') and value.endswith('"'):
            value = value[1:-1].replace(r"\"", '"').replace(r"\\", "\\")
        if len(value) <= 256 and not any(ord(ch) < 32 for ch in value):
            result[key] = value
    return result


def add(checks: list[dict[str, str]], name: str, status: str, detail: str) -> None:
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", name):
        raise DoctorError("internal check name is invalid")
    if status not in {"ok", "warn", "fail"}:
        raise DoctorError("internal check status is invalid")
    detail = clean_text(detail, f"{name} detail", maximum=1024)
    checks.append({"name": name, "status": status, "detail": detail})


def validate_nvidia(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("schema") != NVIDIA_SCHEMA:
        raise DoctorError("NVIDIA inventory schema mismatch")
    gpus = value.get("gpus")
    nodes = value.get("device_nodes")
    smi = value.get("nvidia_smi")
    if not isinstance(gpus, list) or len(gpus) > 32:
        raise DoctorError("NVIDIA GPU inventory is invalid")
    if not isinstance(nodes, list) or len(nodes) > 256:
        raise DoctorError("NVIDIA device-node inventory is invalid")
    if not isinstance(smi, dict):
        raise DoctorError("NVIDIA nvidia-smi record is invalid")
    if value.get("available") is not bool(gpus):
        raise DoctorError("NVIDIA availability disagrees with inventory")
    return value


def validate_runtime(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("schema") != RUNTIME_SCHEMA or value.get("result") != "status":
        raise DoctorError("local runtime status schema mismatch")
    channels = value.get("channels")
    if not isinstance(channels, dict) or set(channels) != {"cpu", "cuda"}:
        raise DoctorError("local runtime status must contain CPU and CUDA channels")
    for backend in ("cpu", "cuda"):
        row = channels[backend]
        if not isinstance(row, dict) or row.get("backend") != backend or row.get("result") not in {"none", "active"}:
            raise DoctorError(f"{backend} runtime channel status is invalid")
        if row["result"] == "active":
            current = row.get("current")
            if not isinstance(current, dict):
                raise DoctorError(f"{backend} runtime current stage is missing")
            if current.get("backend") != backend:
                raise DoctorError(f"{backend} runtime current stage backend mismatch")
            if not isinstance(current.get("stage_id"), str) or not HEX.fullmatch(current["stage_id"]):
                raise DoctorError(f"{backend} runtime stage ID is invalid")
            if not isinstance(current.get("nixpkgs_rev"), str) or not PIN.fullmatch(current["nixpkgs_rev"]):
                raise DoctorError(f"{backend} runtime nixpkgs revision is invalid")
            clean_text(current.get("provider_version"), f"{backend} provider version", maximum=80)
            clean_text(current.get("qualified_model"), f"{backend} qualified model", maximum=192)
            context = current.get("context_tokens")
            if type(context) is not int or context < 4096 or context > 262144 or context % 1024:
                raise DoctorError(f"{backend} runtime context is invalid")
    return value


def validate_remote(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("schema") != REMOTE_SCHEMA or value.get("result") != "status":
        raise DoctorError("remote provider catalog status schema mismatch")
    if value.get("credential_values_disclosed") is not False or value.get("endpoint_probe_run") is not False:
        raise DoctorError("remote provider status violated the non-disclosure/no-probe contract")
    providers = value.get("providers")
    default = value.get("default")
    if not isinstance(providers, list) or not providers or len(providers) > 65 or not isinstance(default, str):
        raise DoctorError("remote provider catalog status is invalid")
    defaults = []
    for row in providers:
        if not isinstance(row, dict):
            raise DoctorError("remote provider row is invalid")
        name = clean_text(row.get("name"), "remote provider name", maximum=48)
        host = clean_text(row.get("host"), "remote provider host", maximum=253)
        env_key = clean_text(row.get("env_key"), "remote provider environment key", maximum=128)
        state = row.get("credential_state")
        if state not in {"present", "missing", "invalid"}:
            raise DoctorError("remote credential state is invalid")
        if row.get("wire_api") != "responses" or type(row.get("default")) is not bool or type(row.get("builtin")) is not bool:
            raise DoctorError("remote provider row contract is invalid")
        if row["default"]:
            defaults.append((name, host, env_key, state))
    if len(defaults) != 1 or defaults[0][0] != default:
        raise DoctorError("remote provider default is ambiguous")
    return value


def gpu_summary(gpu: dict[str, Any]) -> str:
    name = gpu.get("name")
    driver = gpu.get("driver_version")
    cap = gpu.get("compute_cap")
    total = gpu.get("memory.total")
    free = gpu.get("memory.free")
    safe_name = str(name)[:96] if name else "unnamed NVIDIA GPU"
    safe_name = "".join(ch if ord(ch) >= 32 and ch != "|" else "?" for ch in safe_name)
    parts = [safe_name]
    if driver:
        parts.append(f"driver {str(driver)[:40]}")
    if cap:
        parts.append(f"compute {str(cap)[:16]}")
    if isinstance(total, (int, float)):
        memory = f"{float(total) / 1024:.1f} GiB"
        if isinstance(free, (int, float)):
            memory += f" total, {float(free) / 1024:.1f} GiB free"
        parts.append(memory)
    return ", ".join(parts)


def build(
    nvidia: dict[str, Any],
    runtime: dict[str, Any],
    remote: dict[str, Any],
    nix_version: str,
    cuda_candidate_model: str,
    cuda_candidate_context: int,
    cuda_candidate_memory_mib: int,
) -> dict[str, Any]:
    checks: list[dict[str, str]] = []
    release = os_release()
    system = platform.system()
    machine = platform.machine()
    kernel = platform.release()
    distro = release.get("PRETTY_NAME") or release.get("NAME") or release.get("ID") or "unknown Linux distribution"
    host_status = "ok" if system == "Linux" and release.get("ID") == "nixos" and machine in {"x86_64", "amd64"} else "warn"
    if system != "Linux":
        host_status = "fail"
    add(checks, "provider_host", host_status, f"{distro}, {machine or 'unknown architecture'}, kernel {kernel}")

    total, available = meminfo()
    cpu_count = os.cpu_count()
    if total is None:
        add(checks, "provider_memory", "warn", "host memory inventory is unavailable; model fit cannot be screened")
    else:
        detail = f"{human_bytes(total)} total, {human_bytes(available)} available, {cpu_count or 'unknown'} logical CPUs"
        add(checks, "provider_memory", "ok", detail)

    nix_ok = bool(nix_version and nix_version != "missing")
    cpu_status = "ok" if system == "Linux" and machine in {"x86_64", "amd64"} and nix_ok else "fail"
    cpu_detail = "explicit --cpu and automatic CPU fallback are available; model fit and speed still require a real load test"
    if available is not None:
        cpu_detail += f"; {human_bytes(available)} RAM currently available"
    if not nix_ok:
        cpu_detail = "Nix is unavailable, so the managed CPU runtime cannot be realized"
    elif machine not in {"x86_64", "amd64"}:
        cpu_detail = f"managed local runtime is not qualified for architecture {machine or 'unknown'}"
    add(checks, "local_cpu_fallback", cpu_status, cpu_detail)

    gpus = nvidia["gpus"]
    nodes = nvidia["device_nodes"]
    proc_driver = nvidia.get("proc_driver_version")
    smi_path = nvidia["nvidia_smi"].get("path")
    if gpus:
        summaries = [gpu_summary(item) for item in gpus[:3] if isinstance(item, dict)]
        extra = f"; plus {len(gpus) - 3} more" if len(gpus) > 3 else ""
        add(checks, "nvidia_inventory", "ok", f"{len(gpus)} visible GPU(s): {'; '.join(summaries)}{extra}")
        query_errors = sum(len(item.get("query_errors", {})) for item in gpus if isinstance(item, dict) and isinstance(item.get("query_errors"), dict))
        status = "warn"
        detail = "inventory is visible, but CUDA model load, residency, context, and tool protocol still require managed startup qualification"
        if query_errors:
            detail += f"; {query_errors} optional nvidia-smi field query error(s) were recorded"
        add(checks, "cuda_runtime_qualification", status, detail)
    elif smi_path or nodes or proc_driver:
        error = nvidia["nvidia_smi"].get("error")
        detail = "NVIDIA driver evidence exists but no usable GPU inventory was returned"
        if error:
            detail += f": {str(error).replace('|', ';').replace(chr(10), ' ')[:400]}"
        add(checks, "nvidia_inventory", "fail", detail)
        add(checks, "cuda_runtime_qualification", "fail", "CUDA launch must not be attempted until the driver inventory is repaired; CPU remains an explicit fallback")
    else:
        add(checks, "nvidia_inventory", "warn", "no NVIDIA GPU is visible; automatic local mode should choose the CPU path")
        add(checks, "cuda_runtime_qualification", "warn", "not applicable on the current inventory; no cloud fallback is implied")

    for backend in ("cpu", "cuda"):
        row = runtime["channels"][backend]
        name = f"local_runtime_{backend}"
        if row["result"] == "none":
            if backend == "cpu":
                hint = "sandcodex local update MODEL --cpu"
            else:
                hint = (
                    f"sandcodex local probe {cuda_candidate_model} --backend cuda "
                    f"--local-context {cuda_candidate_context} --local-memory-mib {cuda_candidate_memory_mib} "
                    "--local-ollama-bin /path/to/ollama"
                )
            add(checks, name, "warn", f"no active qualified {backend.upper()} runtime channel; prequalify with {hint}")
        else:
            stage = row["current"]
            threads = stage.get("model_profile_num_thread")
            thread_detail = "provider default/unrecorded" if threads is None else str(threads)
            detail = (
                f"stage {stage['stage_id'][:12]}, Ollama {stage['provider_version']}, "
                f"model {stage['qualified_model']}, context {stage['context_tokens']}, "
                f"threads {thread_detail}, "
                f"nixpkgs {stage['nixpkgs_rev'][:12]}"
            )
            add(checks, name, "ok", detail)

    default_row = next(row for row in remote["providers"] if row["default"])
    catalog_kind = "private catalog" if remote.get("catalog_present") else "implicit built-in catalog"
    add(
        checks,
        "remote_catalog",
        "ok",
        f"{catalog_kind}, {len(remote['providers'])} provider(s), default {default_row['name']} at {default_row['host']}",
    )
    credential_state = default_row["credential_state"]
    credential_status = {"present": "ok", "missing": "warn", "invalid": "fail"}[credential_state]
    credential_detail = f"{default_row['env_key']} is {credential_state}; the value is not disclosed"
    add(checks, "remote_default_credential", credential_status, credential_detail)
    add(checks, "remote_endpoint_probe", "warn", "not run; catalog validation does not prove DNS, TLS, model availability, Responses streaming, tool calls, or billing behavior")
    add(checks, "local_multiuser_transport", "warn", "per-user state is separated, but unauthenticated loopback inference is not yet a Unix-user isolation boundary")

    statuses = {row["status"] for row in checks}
    result = "fail" if "fail" in statuses else ("review" if "warn" in statuses else "pass")
    return {
        "schema": SCHEMA,
        "result": result,
        "nix_version": nix_version,
        "checks": checks,
        "claims": {
            "read_only": True,
            "provider_started": False,
            "model_loaded": False,
            "remote_endpoint_contacted": False,
            "credential_values_disclosed": False,
            "nix_state_modified": False,
        },
        "candidate_models": {
            "local_cuda_gtx1650": {
                "model": cuda_candidate_model,
                "context_tokens": cuda_candidate_context,
                "memory_mib": cuda_candidate_memory_mib,
                "status": "operator-candidate-until-target-machine-digests-are-qualified",
            },
        },
        "limitations": [
            "Static host and catalog readiness is not a substitute for real CPU, CUDA, or remote Responses qualification.",
            "NVIDIA inventory does not establish that a particular Ollama build supports a GPU or model.",
            "Memory availability is a point-in-time observation and does not prove model fit.",
        ],
    }


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--nvidia", required=True, type=Path)
    p.add_argument("--runtime", required=True, type=Path)
    p.add_argument("--remote", required=True, type=Path)
    p.add_argument("--nix-version", required=True)
    p.add_argument("--cuda-candidate-model", required=True)
    p.add_argument("--cuda-candidate-context", required=True, type=int)
    p.add_argument("--cuda-candidate-memory-mib", required=True, type=int)
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        nvidia = validate_nvidia(read_json(args.nvidia, "NVIDIA inventory"))
        runtime = validate_runtime(read_json(args.runtime, "local runtime status"))
        remote = validate_remote(read_json(args.remote, "remote provider status"))
        nix_version = clean_text(args.nix_version, "Nix version", maximum=160)
        cuda_candidate_model = clean_text(args.cuda_candidate_model, "CUDA candidate model", maximum=192)
        if args.cuda_candidate_context < 4096 or args.cuda_candidate_context > 262144 or args.cuda_candidate_context % 1024:
            raise DoctorError("CUDA candidate context is invalid")
        if args.cuda_candidate_memory_mib < 2048 or args.cuda_candidate_memory_mib > 262144:
            raise DoctorError("CUDA candidate memory budget is invalid")
        report = build(
            nvidia,
            runtime,
            remote,
            nix_version,
            cuda_candidate_model,
            args.cuda_candidate_context,
            args.cuda_candidate_memory_mib,
        )
        print(json.dumps(report, sort_keys=True, separators=(",", ":")))
        return 0 if report["result"] != "fail" else 1
    except DoctorError as exc:
        print(f"sandcodex-provider-doctor: {exc}", file=sys.stderr)
        return 78


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_PROVIDER_DOCTOR_PY
}

sc_emit_nvidia_helper() {
  cat <<'SANDCODEX_NVIDIA_HELPER_PY'
#!/usr/bin/env python3
"""Bounded, card-name-agnostic NVIDIA evidence for Sandcodex.

The qualifier treats NVML/nvidia-smi measurements as facts and card-name based
expectations as non-authoritative labels. It supports display GPUs, datacenter
cards, multiple GPUs, and MIG-visible configurations without maintaining a GPU
SKU allowlist.
"""
from __future__ import annotations

import argparse
import csv
import glob
import json
import math
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
from typing import Any

SCHEMA = "sandcodex.nvidia-qualification.v1"
FIELDS = (
    "index",
    "uuid",
    "name",
    "serial",
    "pci.bus_id",
    "driver_version",
    "vbios_version",
    "memory.total",
    "memory.free",
    "memory.used",
    "compute_cap",
    "pstate",
    "power.limit",
    "temperature.gpu",
    "utilization.gpu",
    "mig.mode.current",
    "persistence_mode",
    "compute_mode",
    "display_active",
    "display_mode",
)
NUMERIC_FIELDS = {
    "index": int,
    "memory.total": float,
    "memory.free": float,
    "memory.used": float,
    "power.limit": float,
    "temperature.gpu": float,
    "utilization.gpu": float,
}


def run(argv: list[str], timeout: float = 8.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
        env={**os.environ, "LC_ALL": "C"},
    )


def clean(value: str) -> Any:
    value = value.strip()
    if not value or value.lower() in {"n/a", "[n/a]", "not supported", "unknown"}:
        return None
    return value


def query_one(binary: str, index: str, field: str) -> tuple[Any, str | None]:
    cp = run([binary, "-i", index, f"--query-gpu={field}", "--format=csv,noheader,nounits"])
    if cp.returncode != 0:
        return None, cp.stderr.strip()[:500] or f"query failed rc={cp.returncode}"
    rows = list(csv.reader(cp.stdout.splitlines()))
    if len(rows) != 1 or len(rows[0]) != 1:
        return None, f"unexpected row shape for {field}: {len(rows)}"
    value = clean(rows[0][0])
    cast = NUMERIC_FIELDS.get(field)
    if value is not None and cast is not None:
        try:
            value = cast(str(value))
        except ValueError:
            return None, f"non-numeric value for {field}: {value!r}"
    return value, None


def meminfo() -> dict[str, int]:
    result: dict[str, int] = {}
    try:
        for line in pathlib.Path("/proc/meminfo").read_text().splitlines():
            key, rest = line.split(":", 1)
            match = re.search(r"(\d+)", rest)
            if match:
                result[key] = int(match.group(1)) * 1024
    except (OSError, ValueError):
        pass
    return result


def device_node(path: str) -> dict[str, Any]:
    p = pathlib.Path(path)
    try:
        st = p.stat()
        kind = "character" if stat.S_ISCHR(st.st_mode) else "other"
        return {
            "path": path,
            "kind": kind,
            "major": os.major(st.st_rdev) if kind == "character" else None,
            "minor": os.minor(st.st_rdev) if kind == "character" else None,
            "mode": oct(stat.S_IMODE(st.st_mode)),
            "uid": st.st_uid,
            "gid": st.st_gid,
            "readable": os.access(path, os.R_OK),
            "writable": os.access(path, os.W_OK),
        }
    except OSError as exc:
        return {"path": path, "error": str(exc)}


def http_json(url: str, timeout: float = 3.0) -> tuple[Any | None, str | None]:
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "sandcodex-local-qualifier/1"})
        with urllib.request.urlopen(request, timeout=timeout) as response:
            if response.status != 200:
                return None, f"HTTP {response.status}"
            if int(response.headers.get("Content-Length", "0") or 0) > 8 * 1024 * 1024:
                return None, "response declared over 8 MiB"
            body = response.read(8 * 1024 * 1024 + 1)
            if len(body) > 8 * 1024 * 1024:
                return None, "response exceeded 8 MiB"
            return json.loads(body), None
    except (OSError, urllib.error.URLError, json.JSONDecodeError, ValueError) as exc:
        return None, str(exc)


def vram_class(mib: float) -> str:
    if mib < 4096:
        return "under-4GiB"
    if mib < 8192:
        return "4-to-7GiB"
    if mib < 12288:
        return "8-to-11GiB"
    if mib < 16384:
        return "12-to-15GiB"
    if mib < 24576:
        return "16-to-23GiB"
    return "24GiB-or-more"


def budgets(gpus: list[dict[str, Any]], memory: dict[str, int]) -> dict[str, Any]:
    totals = [float(g.get("memory.total") or 0.0) for g in gpus]
    frees = [float(g.get("memory.free") or 0.0) for g in gpus]
    max_total = max(totals, default=0.0)
    max_free = max(frees, default=0.0)
    aggregate_total = sum(totals)
    aggregate_free = sum(frees)
    # Conservative planning figures, not fit guarantees. KV cache, runtime
    # scratch, display use, and quantization metadata all consume additional
    # memory. Multi-GPU aggregation is reported but never assumed usable.
    resident = math.floor(max_free * 0.72)
    smoke = math.floor(max_free * 0.50)
    host_available_mib = memory.get("MemAvailable", 0) / (1024 * 1024)
    hybrid_host = math.floor(min(host_available_mib * 0.50, 32768.0))
    return {
        "planning_only": True,
        "warning": "budgets are conservative screening values, not a model-fit guarantee",
        "single_gpu": {
            "maximum_total_mib": max_total,
            "maximum_free_mib": max_free,
            "class": vram_class(max_total) if max_total else "none",
            "smoke_weight_screen_mib": smoke,
            "resident_weight_screen_mib": resident,
        },
        "aggregate_observation": {
            "total_mib": aggregate_total,
            "free_mib": aggregate_free,
            "not_assumed_usable_by_one_model": True,
        },
        "hybrid_cpu_screen": {
            "host_mem_available_mib": math.floor(host_available_mib),
            "suggested_host_weight_ceiling_mib": hybrid_host,
            "disk_is_storage_not_active_weight_memory": True,
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--ollama-url", default=os.environ.get("SANDCODEX_LOCAL_OLLAMA_URL", "http://127.0.0.1:11434"))
    parser.add_argument("--no-ollama", action="store_true")
    args = parser.parse_args()

    binary = shutil.which("nvidia-smi")
    result: dict[str, Any] = {
        "schema": SCHEMA,
        "observed_unix": int(time.time()),
        "hostname": os.uname().nodename,
        "uid": os.getuid(),
        "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
        "nvidia_smi": {"path": binary},
        "gpus": [],
        "device_nodes": [device_node(p) for p in sorted(set(glob.glob("/dev/nvidia*")))],
        "proc_driver_version": None,
        "host_memory_bytes": meminfo(),
        "ollama": None,
        "limitations": [
            "nvidia-smi/NVML visibility does not prove a model can initialize CUDA",
            "free VRAM is a point-in-time observation",
            "MIG, multi-GPU splitting, quantization overhead, context length, and backend support require runtime qualification",
            "GPU product names never grant compatibility or authority",
        ],
    }
    try:
        result["proc_driver_version"] = pathlib.Path("/proc/driver/nvidia/version").read_text()[:8192]
    except OSError:
        pass

    if binary:
        cp = run([binary, "--query-gpu=index", "--format=csv,noheader,nounits"])
        if cp.returncode == 0:
            indices = [line.strip() for line in cp.stdout.splitlines() if line.strip()]
            for index in indices:
                gpu: dict[str, Any] = {"query_errors": {}}
                for field in FIELDS:
                    value, error = query_one(binary, index, field)
                    gpu[field] = value
                    if error:
                        gpu["query_errors"][field] = error
                # A computed label, deliberately independent of SKU spelling.
                cap = gpu.get("compute_cap")
                try:
                    major = int(str(cap).split(".", 1)[0]) if cap is not None else None
                except ValueError:
                    major = None
                gpu["cuda_arch_screen"] = {
                    "compute_capability": cap,
                    "modern_cuda_likely": major is not None and major >= 6,
                    "runtime_probe_still_required": True,
                }
                result["gpus"].append(gpu)
        else:
            result["nvidia_smi"]["error"] = cp.stderr.strip()[:2000] or f"rc={cp.returncode}"

    result["available"] = bool(result["gpus"])
    result["budgets"] = budgets(result["gpus"], result["host_memory_bytes"])

    if not args.no_ollama:
        version, version_error = http_json(args.ollama_url.rstrip("/") + "/api/version")
        ps, ps_error = http_json(args.ollama_url.rstrip("/") + "/api/ps")
        result["ollama"] = {
            "url": args.ollama_url,
            "version": version,
            "version_error": version_error,
            "running_models": ps,
            "running_models_error": ps_error,
            "vram_evidence_note": "models[].size_vram is runtime evidence when supplied by Ollama; zero/absence is not a GPU success",
        }

    json.dump(result, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")
    return 0 if result["available"] else 2


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_NVIDIA_HELPER_PY
}


sc_emit_local_preflight() {
  cat <<'SANDCODEX_LOCAL_PREFLIGHT_PY'
#!/usr/bin/env python3
"""Internal managed-Ollama startup checks; not a new public Sandcodex command.

inventory -> load -> existing Responses qualifier -> verify. Exit 75 is reserved
for a narrowly recognized CUDA load failure or zero reported GPU residency in
*load*, never for protocol, model identity, context, transport or memory failures.
No model is pulled, substituted, deleted or updated by this program.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import http.client
import json
import math
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import urllib.parse
from typing import Any, Sequence

SCHEMA = "sandcodex.local-startup-check.v1"
MAX_BODY = 1024 * 1024
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")
DIGEST = re.compile(r"(?:sha256:)?([0-9a-fA-F]{64})\Z")
CPU_RUNTIME_RESERVE_BYTES = 1024 ** 3
KV_ELEMENT_BYTES = 2  # The launcher pins OLLAMA_KV_CACHE_TYPE=f16.
# Only apply to a JSON error returned by POST /api/generate with a server-error
# status. Do not infer CUDA failure from a process log, timeout, 404, or generic OOM.
CUDA_LOAD_MARKERS = (
    "cuda error: out of memory", "cuda error: no kernel image is available",
    "cuda error: invalid device function", "cuda driver version is insufficient",
    "cudaerrorinsufficientdriver", "cudaerrornodevice", "cudaerrorinitializationerror",
    "failed to initialize cuda", "failed to load cuda library",
)


class Failure(RuntimeError):
    def __init__(self, code: str, message: str, *, retry_cpu: bool = False):
        super().__init__(message)
        self.code, self.retry_cpu = code, retry_cpu


class HttpFailure(Failure):
    def __init__(self, status: int, detail: str):
        super().__init__("http_status", f"provider returned HTTP {status}; no fallback inferred")
        self.status, self.detail = status, detail


def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise Failure("protocol", "provider JSON contains a duplicate field")
        result[key] = value
    return result


def decode(raw: bytes) -> dict[str, Any]:
    try:
        obj = json.loads(raw, object_pairs_hook=unique_object,
                         parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
    except (ValueError, UnicodeError) as exc:
        raise Failure("protocol", "provider did not return valid finite JSON") from exc
    if not isinstance(obj, dict):
        raise Failure("protocol", "provider JSON must be an object")
    return obj


def integer(value: Any, label: str, *, minimum: int = 0) -> int:
    if type(value) is not int or value < minimum:
        raise Failure("protocol", f"provider {label} must be an integer >= {minimum}")
    return value


def digest(value: Any) -> str:
    m = DIGEST.fullmatch(value) if isinstance(value, str) else None
    if m is None:
        raise Failure("model_identity", "provider model digest is missing or malformed")
    return m.group(1).lower()


def canonical_name(value: Any) -> str:
    if not isinstance(value, str) or not MODEL.fullmatch(value):
        raise Failure("model_identity", "model name is not a supported provider identifier")
    tail = value.rsplit("/", 1)[-1]
    return value if ":" in tail else value + ":latest"


def kv_cache_estimate(model_info: dict[str, Any], context: int) -> dict[str, Any]:
    """Estimate the full-context f16 KV cache from advertised GGUF geometry.

    This deliberately assumes every block carries attention state. That is an
    upper estimate for common hybrid/sliding-window layouts, while unfamiliar
    or incomplete metadata falls back to the older fixed reserve rather than
    manufacturing geometry.
    """
    architecture = model_info.get("general.architecture")
    if not isinstance(architecture, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", architecture):
        return {"available": False, "reason": "general.architecture is absent or malformed"}

    def field(suffix: str, maximum: int = 1_000_000) -> int | None:
        value = model_info.get(f"{architecture}.{suffix}")
        return value if type(value) is int and 1 <= value <= maximum else None

    blocks = field("block_count")
    embedding = field("embedding_length")
    heads = field("attention.head_count")
    kv_heads = field("attention.head_count_kv") or heads
    if None in (blocks, embedding, heads, kv_heads) or embedding % heads:
        return {"available": False, "architecture": architecture,
                "reason": "standard attention geometry is incomplete or inconsistent"}
    head_dimension = embedding // heads
    key_length = field("attention.key_length") or head_dimension
    value_length = field("attention.value_length") or head_dimension
    estimated = context * blocks * kv_heads * (key_length + value_length) * KV_ELEMENT_BYTES
    return {
        "available": True,
        "architecture": architecture,
        "context_tokens": context,
        "block_count": blocks,
        "embedding_length": embedding,
        "attention_head_count": heads,
        "attention_kv_head_count": kv_heads,
        "key_length": key_length,
        "value_length": value_length,
        "element_bytes": KV_ELEMENT_BYTES,
        "estimated_bytes": estimated,
        "formula": "context*blocks*kv_heads*(key_length+value_length)*element_bytes",
        "assumption": "full-context f16 attention state for every advertised block",
    }


class Client:
    def __init__(self, endpoint: str, timeout: float = 120):
        # Fixed numeric host; http.client does not honor HTTP(S)_PROXY and this
        # client never follows redirects. No DNS or credential-bearing endpoint.
        if not re.fullmatch(r"http://127\.0\.0\.1:[1-9][0-9]{0,4}", endpoint):
            raise Failure("endpoint", "managed endpoint must be a numeric IPv4 loopback HTTP port")
        port = urllib.parse.urlsplit(endpoint).port
        if port is None or not 1 <= port <= 65535:
            raise Failure("endpoint", "managed endpoint port is out of range")
        if not math.isfinite(timeout) or not 0 < timeout <= 600:
            raise Failure("configuration", "request timeout must be finite and in (0, 600]")
        self.port, self.timeout = port, timeout

    def request(self, method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
        conn = http.client.HTTPConnection("127.0.0.1", self.port, timeout=self.timeout)
        try:
            payload = None if body is None else json.dumps(body, allow_nan=False).encode()
            conn.request(method, path, body=payload, headers={"Content-Type": "application/json"})
            res = conn.getresponse()
            raw = res.read(MAX_BODY + 1)
            if len(raw) > MAX_BODY:
                raise Failure("protocol", "provider response exceeds the startup size limit")
            obj = decode(raw)
            if res.status != 200:
                detail = obj.get("error")
                raise HttpFailure(res.status, detail[:4096] if isinstance(detail, str) else "")
            if "error" in obj:
                raise Failure("protocol", "provider returned an error inside a successful HTTP response")
            return obj
        except (OSError, http.client.HTTPException) as exc:
            raise Failure("transport", "provider connection failed or timed out; no CPU retry inferred") from exc
        finally:
            conn.close()


def select_model(payload: dict[str, Any], model: str) -> dict[str, Any]:
    rows = payload.get("models")
    if not isinstance(rows, list):
        raise Failure("protocol", "provider inventory lacks models[]")
    target = canonical_name(model)
    selected = []
    for row in rows:
        if not isinstance(row, dict):
            raise Failure("protocol", "provider inventory contains a non-object model")
        names = [canonical_name(row[k]) for k in ("name", "model") if k in row]
        if target in names:
            if any(n != target for n in names):
                raise Failure("model_identity", "selected inventory entry has conflicting names")
            selected.append(row)
    if len(selected) != 1:
        raise Failure("model_identity", "requested model must have exactly one inventory entry")
    return selected[0]


def inventory(client: Client, model: str, expected: str | None, context: int) -> dict[str, Any]:
    canonical = canonical_name(model)
    if "-cloud" in canonical.rsplit("/", 1)[-1]:
        raise Failure("local_only", "cloud model tags are not local inference")
    row = select_model(client.request("GET", "/api/tags"), model)
    observed = digest(row.get("digest"))
    if expected is not None and observed != digest(expected):
        raise Failure("model_identity", "model digest changed or differs from the requested digest")
    shown = client.request("POST", "/api/show", {"model": canonical})
    if any(shown.get(k) for k in ("remote_host", "remote_model")):
        raise Failure("local_only", "selected model describes remote inference; refusing it in local mode")
    caps = shown.get("capabilities")
    if (not isinstance(caps, list) or not all(isinstance(c, str) for c in caps) or
            not {"completion", "tools"}.issubset(caps)):
        raise Failure("capabilities", "selected local model does not advertise completion and tools")
    info = shown.get("model_info")
    if not isinstance(info, dict):
        raise Failure("context", "provider did not advertise native model context")
    contexts = [integer(v, k, minimum=1) for k, v in info.items() if k.endswith(".context_length")]
    if not contexts or context > min(contexts):
        raise Failure("context", "requested context exceeds or lacks provider-advertised native capacity")
    version = client.request("GET", "/api/version").get("version")
    if not isinstance(version, str) or not re.fullmatch(r"[A-Za-z0-9.+_-]{1,80}", version):
        raise Failure("protocol", "provider version is missing or malformed")
    return {"requested_name": model, "resolved_name": canonical, "digest_sha256": observed,
            "size_bytes": integer(row.get("size"), "model size", minimum=1),
            "native_context_tokens": min(contexts), "context_tokens": context,
            "provider_version": version, "capabilities": caps,
            "kv_cache_estimate": kv_cache_estimate(info, context)}


def cpu_budget(model: dict[str, Any], memory_max_bytes: int) -> dict[str, Any]:
    kv = model["kv_cache_estimate"]
    kv_bytes = kv.get("estimated_bytes") if kv.get("available") is True else None
    minimum = model["size_bytes"] + CPU_RUNTIME_RESERVE_BYTES
    if type(kv_bytes) is int:
        minimum += kv_bytes
    if minimum > memory_max_bytes:
        detail = "model bytes plus 1 GiB runtime reserve"
        if type(kv_bytes) is int:
            detail += " plus the advertised-geometry f16 KV estimate"
        raise Failure("memory_budget", f"CPU admission refused: {detail} exceed the launch budget")
    return {
        "policy": "model-bytes-plus-estimated-f16-kv-plus-1GiB-v2",
        "model_bytes": model["size_bytes"],
        "runtime_reserve_bytes": CPU_RUNTIME_RESERVE_BYTES,
        "kv_cache": kv,
        "minimum_bytes": minimum,
        "budget_bytes": memory_max_bytes,
        "margin_bytes": memory_max_bytes - minimum,
        "fit_proven": False,
        "limitation": (
            "A provider-advertised geometry estimate and fixed reserve screen obvious non-fit; "
            "only the subsequent cgroup-bounded real load observes runtime fit."
            if type(kv_bytes) is int else
            "Provider metadata could not support a KV estimate; model bytes plus the fixed reserve "
            "are only a coarse screen before the cgroup-bounded real load."
        ),
    }


def runtime(client: Client, model: dict[str, Any], backend: str, phase: str) -> dict[str, Any]:
    row = select_model(client.request("GET", "/api/ps"), model["resolved_name"])
    if digest(row.get("digest")) != model["digest_sha256"]:
        raise Failure("model_identity", "loaded model digest differs from inventory")
    context = integer(row.get("context_length"), "loaded context", minimum=1)
    if context != model["context_tokens"]:
        raise Failure("context", "loaded context differs from the requested context; refusing silent adjustment")
    vram = integer(row.get("size_vram"), "loaded VRAM bytes")
    size = integer(row.get("size"), "loaded size", minimum=1)
    if backend == "cuda" and vram == 0:
        raise Failure("cuda_no_residency", "CUDA launch reports zero model GPU residency", retry_cpu=phase == "load")
    if backend == "cpu" and vram != 0:
        raise Failure("backend_policy", "CPU-only launch unexpectedly reports GPU residency")
    return {"loaded_digest_sha256": model["digest_sha256"], "context_tokens": context,
            "size_bytes": size, "size_vram_bytes": vram,
            "placement": "cpu" if vram == 0 else ("gpu" if vram >= size else "mixed"),
            "evidence_kind": "provider-reported-snapshot-not-device-attestation"}


def check(client: Client, *, phase: str, model: str, expected: str | None,
          context: int, backend: str, memory_max_bytes: int) -> dict[str, Any]:
    info = inventory(client, model, expected, context)
    result: dict[str, Any] = {"model": info}
    if backend == "cpu":
        result["memory_admission"] = cpu_budget(info, memory_max_bytes)
    if phase == "inventory":
        return result
    if phase == "load":
        try:
            response = client.request("POST", "/api/generate", {
                "model": info["resolved_name"], "prompt": "", "stream": False,
                "keep_alive": "5m", "options": {"num_ctx": context},
            })
        except HttpFailure as exc:
            recognized = (backend == "cuda" and exc.status in (500, 503) and
                          any(marker in exc.detail.lower() for marker in CUDA_LOAD_MARKERS))
            if recognized:
                # Never surface arbitrary provider content as an operator instruction.
                raise Failure("cuda_load", "provider reported a recognized CUDA model-load failure", retry_cpu=True) from exc
            raise
        if response.get("done") is not True:
            raise Failure("protocol", "empty-prompt model load did not complete")
        if canonical_name(response.get("model")) != info["resolved_name"]:
            raise Failure("model_identity", "load response names a different model")
    # Detect mutable-tag drift even if the old bytes happen to remain resident.
    final = inventory(client, model, info["digest_sha256"], context)
    if final["provider_version"] != info["provider_version"]:
        raise Failure("runtime_identity", "provider version changed during startup checks")
    result["runtime"] = runtime(client, info, backend, phase)
    return result


def atomic_report(path: Path, value: dict[str, Any]) -> None:
    # Caller creates a private per-launch directory outside the project tree.
    parent = path.parent
    meta = parent.lstat()
    if (not stat.S_ISDIR(meta.st_mode) or meta.st_uid != os.getuid() or
            stat.S_IMODE(meta.st_mode) & 0o077):
        raise Failure("report_path", "startup report directory must be private and owned by this user")
    if path.exists() or path.is_symlink():
        raise Failure("report_path", "startup report already exists; refusing overwrite")
    fd, temporary = tempfile.mkstemp(prefix=".startup-", dir=parent)
    try:
        with os.fdopen(fd, "w") as out:
            os.fchmod(out.fileno(), 0o600)
            json.dump(value, out, sort_keys=True, indent=2, allow_nan=False)
            out.write("\n"); out.flush(); os.fsync(out.fileno())
        # link is an atomic no-overwrite commit, unlike replace.
        os.link(temporary, path)
        dfd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try: os.fsync(dfd)
        finally: os.close(dfd)
    finally:
        os.unlink(temporary)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--phase", required=True, choices=("inventory", "load", "verify"))
    p.add_argument("--endpoint", required=True)
    p.add_argument("--model", required=True)
    p.add_argument("--expected-digest")
    p.add_argument("--context-tokens", required=True, type=int)
    p.add_argument("--backend", required=True, choices=("cpu", "cuda"))
    p.add_argument("--memory-max-bytes", required=True, type=int)
    p.add_argument("--timeout", type=float, default=120)
    p.add_argument("--output", type=Path, required=True)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    now = lambda: dt.datetime.now(dt.timezone.utc).isoformat()
    report: dict[str, Any] = {"schema": SCHEMA, "phase": args.phase, "backend": args.backend,
        "endpoint": args.endpoint, "started_at": now(),
        "tool_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
    rc = 0
    try:
        if (not 4096 <= args.context_tokens <= 262144 or args.context_tokens % 1024 or
                args.memory_max_bytes < 1024 ** 3):
            raise Failure("configuration", "context or memory budget is outside the managed limits")
        client = Client(args.endpoint, args.timeout)
        report.update(check(client, phase=args.phase, model=args.model,
            expected=args.expected_digest, context=args.context_tokens, backend=args.backend,
            memory_max_bytes=args.memory_max_bytes))
        report.update(result="pass", retry_cpu=False)
    except (Failure, ValueError) as exc:
        retry = isinstance(exc, Failure) and exc.retry_cpu
        report.update(result="fail", retry_cpu=retry,
                      failure={"code": exc.code if isinstance(exc, Failure) else "configuration", "summary": str(exc)})
        rc = 75 if retry else 78
    report["finished_at"] = now()
    try:
        atomic_report(args.output, report)
    except (OSError, Failure) as exc:
        print(f"sandcodex-local-preflight: cannot persist report: {exc}", file=sys.stderr)
        return 78
    if rc:
        print("sandcodex-local-preflight: " + report["failure"]["summary"], file=sys.stderr)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_LOCAL_PREFLIGHT_PY
}

sc_emit_local_qualifier() {
  cat <<'SANDCODEX_LOCAL_QUALIFIER_PY'
#!/usr/bin/env python3
"""Qualify a loopback local-model provider for use beneath the Codex harness.

This program intentionally separates five claims that are often conflated:

1. the endpoint answered;
2. the selected mutable model name resolved to an exact provider digest;
3. the configured context does not exceed provider-advertised native context;
4. the provider's OpenAI Responses compatibility preserves the semantics Codex
   relies on (the instructions field, streaming, and function tool calls);
5. the provider reports non-zero GPU residency and the NVIDIA runtime can be
   independently observed.

It does not install, pull, load, or delete a model. It speaks only to an
operator-selected loopback endpoint and writes one atomic mode-0600 receipt.
"""
from __future__ import annotations

import argparse
import dataclasses
import copy
import datetime as dt
import hashlib
import http.client
import json
import os
import platform
import re
import secrets
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
from pathlib import Path
from typing import Any, Iterable, Iterator, Mapping, Sequence

PROGRAM = "sandcodex-local-qualify"
VERSION = "0.8.0-sandideas-result-review"
SCHEMA = "sandcodex.local-qualification.v2"
MAX_BODY_BYTES = 16 * 1024 * 1024
MAX_SSE_LINE_BYTES = 2 * 1024 * 1024
MAX_OUTPUT_BYTES = 1024 * 1024
DIGEST_RE = re.compile(r"^(?:sha256:)?([0-9a-fA-F]{64})$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}$")


class QualificationError(RuntimeError):
    """A controlled qualification failure."""


@dataclasses.dataclass(frozen=True)
class Endpoint:
    raw: str
    scheme: str
    host: str
    port: int
    base_path: str

@dataclasses.dataclass
class Check:
    name: str
    status: str
    summary: str
    evidence: dict[str, Any] = dataclasses.field(default_factory=dict)
    required: bool = True

    def as_json(self) -> dict[str, Any]:
        return dataclasses.asdict(self)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def canonical_json(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def normalize_digest(value: str | None) -> str | None:
    if not value:
        return None
    match = DIGEST_RE.fullmatch(value.strip())
    if not match:
        raise QualificationError("expected digest must be 64 hexadecimal SHA-256 characters, optionally prefixed by sha256:")
    return match.group(1).lower()


def parse_endpoint(raw: str) -> Endpoint:
    raw = raw.strip()
    if not raw:
        raw = "http://127.0.0.1:11434"
    parsed = urllib.parse.urlsplit(raw)
    if parsed.scheme != "http":
        raise QualificationError("provider endpoint must use plain HTTP over loopback; TLS termination belongs outside this local seam")
    if parsed.username is not None or parsed.password is not None:
        raise QualificationError("provider endpoint must not contain user information")
    if parsed.query or parsed.fragment:
        raise QualificationError("provider endpoint must not contain a query or fragment")
    host = (parsed.hostname or "").lower()
    if host not in {"127.0.0.1", "localhost", "::1"}:
        raise QualificationError("provider endpoint must use a loopback spelling: 127.0.0.1, ::1, or localhost")
    try:
        port = parsed.port
    except ValueError as exc:
        raise QualificationError(f"invalid provider port: {exc}") from exc
    if port is None:
        port = 80
    if not 1 <= port <= 65535:
        raise QualificationError("provider port is outside 1..65535")
    path = parsed.path.rstrip("/")
    if path not in {"", "/v1"}:
        raise QualificationError("provider endpoint path must be empty or /v1")
    return Endpoint(raw=raw, scheme="http", host=host, port=port, base_path=path)


def join_path(endpoint: Endpoint, path: str) -> str:
    if not path.startswith("/"):
        raise AssertionError(path)
    base = endpoint.base_path
    if base == "/v1" and path.startswith("/v1/"):
        return path
    return f"{base}{path}" or "/"


class HttpClient:
    def __init__(self, endpoint: Endpoint, timeout: float) -> None:
        self.endpoint = endpoint
        self.timeout = timeout

    def _connection(self) -> http.client.HTTPConnection:
        return http.client.HTTPConnection(self.endpoint.host, self.endpoint.port, timeout=self.timeout)

    def request_bytes(
        self,
        method: str,
        path: str,
        *,
        json_body: Any | None = None,
        accept: str = "application/json",
    ) -> tuple[int, Mapping[str, str], bytes]:
        if method not in {"GET", "POST"}:
            raise AssertionError(method)
        body: bytes | None = None
        headers = {"Accept": accept, "User-Agent": f"{PROGRAM}/{VERSION}", "Connection": "close"}
        if json_body is not None:
            body = canonical_json(json_body)
            headers["Content-Type"] = "application/json"
        conn = self._connection()
        try:
            conn.request(method, join_path(self.endpoint, path), body=body, headers=headers)
            response = conn.getresponse()
            response_headers = {key.lower(): value for key, value in response.getheaders()}
            length_header = response_headers.get("content-length")
            if length_header and length_header.isdigit() and int(length_header) > MAX_BODY_BYTES:
                raise QualificationError(f"provider response exceeds {MAX_BODY_BYTES} bytes")
            payload = response.read(MAX_BODY_BYTES + 1)
            if len(payload) > MAX_BODY_BYTES:
                raise QualificationError(f"provider response exceeds {MAX_BODY_BYTES} bytes")
            return response.status, response_headers, payload
        except (OSError, http.client.HTTPException, socket.timeout) as exc:
            raise QualificationError(f"provider HTTP request failed: {method} {path}: {exc}") from exc
        finally:
            conn.close()

    def request_json(self, method: str, path: str, *, json_body: Any | None = None) -> tuple[int, Mapping[str, str], Any, str]:
        status, headers, payload = self.request_bytes(method, path, json_body=json_body)
        text = payload.decode("utf-8", errors="replace")
        try:
            value = json.loads(text)
        except json.JSONDecodeError as exc:
            raise QualificationError(f"provider returned non-JSON for {method} {path}: {exc}; prefix={text[:240]!r}") from exc
        return status, headers, value, text

    def request_sse(self, path: str, *, json_body: Any) -> tuple[int, Mapping[str, str], list[dict[str, Any]], list[str], str]:
        status, headers, payload = self.request_bytes("POST", path, json_body=json_body, accept="text/event-stream")
        text = payload.decode("utf-8", errors="replace")
        events: list[dict[str, Any]] = []
        raw_types: list[str] = []
        for line in text.splitlines():
            if len(line.encode("utf-8", errors="replace")) > MAX_SSE_LINE_BYTES:
                raise QualificationError("provider emitted an overlong SSE line")
            if not line.startswith("data:"):
                continue
            data = line[5:].lstrip()
            if data == "[DONE]":
                raw_types.append("[DONE]")
                continue
            try:
                item = json.loads(data)
            except json.JSONDecodeError as exc:
                raise QualificationError(f"provider emitted malformed SSE JSON: {exc}; line={data[:240]!r}") from exc
            if isinstance(item, dict):
                events.append(item)
                raw_types.append(str(item.get("type", "unknown")))
        return status, headers, events, raw_types, text


def require_status(status: int, expected: Iterable[int], operation: str, body: str = "") -> None:
    expected_set = set(expected)
    if status not in expected_set:
        raise QualificationError(f"{operation} returned HTTP {status}; expected {sorted(expected_set)}; body={body[:500]!r}")


def exact_model_from_tags(models: Sequence[Any], requested: str) -> dict[str, Any]:
    matches: list[dict[str, Any]] = []
    for value in models:
        if not isinstance(value, dict):
            continue
        names = {str(value.get(key, "")) for key in ("name", "model")}
        if requested in names:
            matches.append(value)
    if len(matches) != 1:
        available = sorted({str(item.get("name") or item.get("model")) for item in models if isinstance(item, dict)})
        raise QualificationError(f"requested model {requested!r} had {len(matches)} exact tag matches; available={available[:40]!r}")
    return matches[0]


def extract_context_lengths(model_info: Any) -> dict[str, int]:
    found: dict[str, int] = {}
    if not isinstance(model_info, dict):
        return found
    for key, value in model_info.items():
        if not str(key).endswith(".context_length"):
            continue
        if isinstance(value, bool):
            continue
        try:
            integer = int(value)
        except (TypeError, ValueError):
            continue
        if integer > 0:
            found[str(key)] = integer
    return found


def response_output_text(response: Any) -> str:
    if not isinstance(response, dict):
        return ""
    direct = response.get("output_text")
    if isinstance(direct, str):
        return direct
    pieces: list[str] = []
    output = response.get("output")
    if isinstance(output, list):
        for item in output:
            if not isinstance(item, dict):
                continue
            content = item.get("content")
            if isinstance(content, list):
                for chunk in content:
                    if isinstance(chunk, dict) and isinstance(chunk.get("text"), str):
                        pieces.append(chunk["text"])
    return "".join(pieces)


def response_function_calls(response: Any) -> list[dict[str, Any]]:
    calls: list[dict[str, Any]] = []
    if not isinstance(response, dict):
        return calls
    output = response.get("output")
    if not isinstance(output, list):
        return calls
    for item in output:
        if not isinstance(item, dict):
            continue
        if item.get("type") == "function_call":
            calls.append(item)
        for chunk in item.get("content", []) if isinstance(item.get("content"), list) else []:
            if isinstance(chunk, dict) and chunk.get("type") in {"function_call", "tool_call"}:
                calls.append(chunk)
    return calls


def sse_output_text(events: Sequence[Mapping[str, Any]]) -> str:
    """Reconstruct only assistant-visible text from Responses SSE events.

    Reasoning and reasoning-summary deltas are separate protocol channels.  A
    thinking model may emit them before any answer text, so accepting every
    event whose type merely ends in ``.delta`` both corrupts the observation
    and can make a healthy stream look like a failed text response.
    """
    pieces: list[str] = []
    for event in events:
        event_type = str(event.get("type", ""))
        if event_type == "response.output_text.delta" and isinstance(event.get("delta"), str):
            pieces.append(event["delta"])
        elif event_type == "response.output_text.done" and not pieces:
            text = event.get("text")
            if isinstance(text, str):
                pieces.append(text)
    return "".join(pieces)


def sc_run_bounded_process(argv, *, cwd=None, env=None, timeout=30.0,
                           stdout_limit=524288, stderr_limit=32768,
                           terminate_grace=0.15):
    """Run argv; stop on a deadline or either stream exceeding its byte cap.

    Return a dict with byte prefixes, exit code, duration and explicit flags.
    The cap is a *retained-output* limit, not a kernel-level output prohibition.
    Process launch and pathological uninterruptible kernel waits cannot have a
    hard real-time guarantee. POSIX only; memory is O(stdout_limit+stderr_limit).
    A process group is always used so ordinary inherited children are stopped.
    env=None inherits the caller environment: integrations with secrets must
    instead supply the same minimal environment used by the original helper.
    """
    import math
    import os
    import selectors
    import signal
    import subprocess
    import time

    if os.name != "posix":
        raise RuntimeError("sc_run_bounded_process requires POSIX")
    if not isinstance(argv, (list, tuple)) or not argv:
        raise ValueError("argv must be a nonempty list or tuple")
    if not all(isinstance(arg, str) and "\x00" not in arg for arg in argv):
        raise ValueError("argv must contain NUL-free strings")
    for label, value in (("timeout", timeout), ("terminate_grace", terminate_grace)):
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
            raise ValueError(label + " must be positive and finite")
    for label, value in (("stdout_limit", stdout_limit), ("stderr_limit", stderr_limit)):
        if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 64 * 1024 * 1024:
            raise ValueError(label + " must be an integer in [0, 67108864]")

    began = time.monotonic()
    deadline = began + float(timeout)
    process = subprocess.Popen(
        list(argv), cwd=cwd, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    limits = {"stdout": stdout_limit, "stderr": stderr_limit}
    exceeded = {"stdout": False, "stderr": False}
    timed_out = False
    stopped = False
    kill_at = None
    killed = False
    selector = selectors.DefaultSelector()

    def signal_group(sig):
        # Even if the direct child exited, a child may still hold a pipe open.
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            pass

    def request_stop():
        nonlocal stopped, kill_at
        if not stopped:
            stopped = True
            kill_at = time.monotonic() + float(terminate_grace)
            signal_group(signal.SIGTERM)

    try:
        for label, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
            assert stream is not None
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, label)

        # Continue after direct-child exit while inherited pipes remain open.
        while selector.get_map() or process.poll() is None:
            now = time.monotonic()
            if not stopped and now >= deadline:
                timed_out = True
                request_stop()
            if stopped and kill_at is not None and now >= kill_at:
                signal_group(signal.SIGKILL)
                killed = True
                # Pipes held outside the group must not prolong our read loop.
                break
            next_deadline = kill_at if stopped else deadline
            delay = max(0.0, min(0.05, next_deadline - time.monotonic()))
            for key, _mask in selector.select(delay):
                label = key.data
                try:
                    chunk = os.read(key.fileobj.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    key.fileobj.close()
                    continue
                remaining = limits[label] - len(buffers[label])
                buffers[label].extend(chunk[:max(0, remaining)])
                if len(chunk) > remaining:
                    exceeded[label] = True
                    request_stop()

        # If pipes closed on TERM, still stop ordinary descendants in the group.
        if stopped and not killed:
            signal_group(signal.SIGKILL)
        try:
            process.wait(timeout=float(terminate_grace) + 1.0)
        except subprocess.TimeoutExpired as exc:
            signal_group(signal.SIGKILL)
            # Do not misreport an unreaped process as a successful bounded run.
            raise RuntimeError("child did not exit after group termination") from exc
    finally:
        for key in list(selector.get_map().values()):
            selector.unregister(key.fileobj)
            key.fileobj.close()
        selector.close()
        if process.poll() is None:
            signal_group(signal.SIGKILL)
            try:
                process.wait(timeout=float(terminate_grace) + 1.0)
            except subprocess.TimeoutExpired:
                pass  # The exception / caller's outer supervisor remains authoritative.

    return {
        "stdout": bytes(buffers["stdout"]), "stderr": bytes(buffers["stderr"]),
        "returncode": process.returncode, "timed_out": timed_out,
        "stdout_limited": exceeded["stdout"], "stderr_limited": exceeded["stderr"],
        "duration_seconds": time.monotonic() - began,
    }


def sc_diagnostic_command(argv, *, timeout=10.0, maximum=1048576):
    """Capture bounded prefixes without presenting an incomplete CSV as success.

    `status` retains ordinary exit status only for a completely captured run.
    On timeout/cap/error it is None. `process_status` is observational: even a
    zero exit can accompany incomplete capture. The caller owns argv selection
    and Sandcodex's existing cgroups remain the containment/lifecycle authority.
    """
    import os
    import time

    if not isinstance(argv, (list, tuple)):
        raise ValueError("argv must be a list or tuple")
    started = time.monotonic()
    try:
        captured = sc_run_bounded_process(
            list(argv), timeout=timeout, stdout_limit=maximum, stderr_limit=maximum,
            env={"PATH": os.environ.get("PATH", ""), "LC_ALL": "C", "LANG": "C"},
        )
    except OSError as exc:
        # Fixed summary, not str(exc): paths/argv may contain sensitive values.
        return {
            "argv": list(argv), "status": None, "process_status": None,
            "stdout": "", "stderr": "diagnostic process could not be started or captured",
            "duration_ms": round((time.monotonic() - started) * 1000),
            "truncated": False,
            "capture": {"schema": "sandcodex-ideas.diagnostic-capture.v1",
                        "complete": False, "reason": "os_error", "errno": exc.errno,
                        "timed_out": False, "stdout_limited": False, "stderr_limited": False},
        }
    except RuntimeError:
        # The underlying helper has attempted cleanup. Do not claim a process
        # is gone if it could not be reaped; the outer supervisor must decide.
        return {
            "argv": list(argv), "status": None, "process_status": None,
            "stdout": "", "stderr": "diagnostic lifecycle could not be confirmed",
            "duration_ms": round((time.monotonic() - started) * 1000),
            "truncated": False,
            "capture": {"schema": "sandcodex-ideas.diagnostic-capture.v1",
                        "complete": False, "reason": "lifecycle_unconfirmed", "errno": None,
                        "timed_out": False, "stdout_limited": False, "stderr_limited": False},
        }
    limited = captured["stdout_limited"] or captured["stderr_limited"]
    complete = not captured["timed_out"] and not limited
    reason = "timeout" if captured["timed_out"] else ("output_limit" if limited else "finished")
    return {
        "argv": list(argv), "status": captured["returncode"] if complete else None,
        "process_status": captured["returncode"],
        "stdout": captured["stdout"].decode("utf-8", errors="replace"),
        "stderr": captured["stderr"].decode("utf-8", errors="replace"),
        "duration_ms": round(captured["duration_seconds"] * 1000),
        "truncated": limited,
        "capture": {"schema": "sandcodex-ideas.diagnostic-capture.v1",
                    "complete": complete, "reason": reason, "errno": None,
                    "timed_out": captured["timed_out"],
                    "stdout_limited": captured["stdout_limited"],
                    "stderr_limited": captured["stderr_limited"]},
    }


def run_command(argv: Sequence[str], timeout: float = 10.0) -> dict[str, Any]:
    # G004: a bounded prefix is evidence, never a complete successful inventory.
    return sc_diagnostic_command(argv, timeout=timeout, maximum=MAX_OUTPUT_BYTES)


def parse_csv_rows(text: str, fields: Sequence[str]) -> list[dict[str, Any]]:
    import csv
    rows: list[dict[str, Any]] = []
    for raw in csv.reader(text.splitlines(), skipinitialspace=True):
        if not raw or all(not cell.strip() for cell in raw):
            continue
        values = [cell.strip() for cell in raw]
        row = {field: (values[index] if index < len(values) else None) for index, field in enumerate(fields)}
        rows.append(row)
    return rows


def maybe_int(value: Any) -> int | None:
    if value is None:
        return None
    text = str(value).strip()
    if text in {"", "N/A", "[Not Supported]", "Not Supported"}:
        return None
    match = re.match(r"^-?[0-9]+", text)
    return int(match.group(0)) if match else None


def nvidia_evidence() -> dict[str, Any]:
    smi = shutil.which("nvidia-smi")
    evidence: dict[str, Any] = {
        "available": bool(smi),
        "binary": smi,
        "gpus": [],
        "compute_processes": [],
        "limitations": [
            "GPU inventory is observational and does not prove model correctness.",
            "VRAM from distinct GPUs is never aggregated into one fictitious address space.",
            "A provider-reported size_vram is stronger model-placement evidence than process-name matching alone.",
        ],
    }
    if not smi:
        return evidence
    fields = ["index", "uuid", "name", "driver_version", "memory_total_mib", "memory_free_mib", "compute_capability"]
    query = "index,uuid,name,driver_version,memory.total,memory.free,compute_cap"
    result = run_command([smi, f"--query-gpu={query}", "--format=csv,noheader,nounits"], timeout=15)
    evidence["inventory_command"] = result
    rows: list[dict[str, Any]] = []
    if result["status"] == 0:
        rows = parse_csv_rows(result["stdout"], fields)
    else:
        fallback_fields = fields[:-1]
        fallback_query = "index,uuid,name,driver_version,memory.total,memory.free"
        fallback = run_command([smi, f"--query-gpu={fallback_query}", "--format=csv,noheader,nounits"], timeout=15)
        evidence["inventory_fallback_command"] = fallback
        if fallback["status"] == 0:
            rows = parse_csv_rows(fallback["stdout"], fallback_fields)
    normalized: list[dict[str, Any]] = []
    for row in rows:
        normalized.append({
            "index": maybe_int(row.get("index")),
            "uuid": row.get("uuid"),
            "name": row.get("name"),
            "driver_version": row.get("driver_version"),
            "memory_total_mib": maybe_int(row.get("memory_total_mib")),
            "memory_free_mib": maybe_int(row.get("memory_free_mib")),
            "compute_capability": row.get("compute_capability") or None,
        })
    evidence["gpus"] = normalized
    proc_fields = ["pid", "process_name", "gpu_uuid", "used_gpu_memory_mib"]
    proc = run_command([smi, "--query-compute-apps=pid,process_name,gpu_uuid,used_gpu_memory", "--format=csv,noheader,nounits"], timeout=15)
    evidence["process_command"] = proc
    if proc["status"] == 0:
        for row in parse_csv_rows(proc["stdout"], proc_fields):
            evidence["compute_processes"].append({
                "pid": maybe_int(row.get("pid")),
                "process_name": row.get("process_name"),
                "gpu_uuid": row.get("gpu_uuid"),
                "used_gpu_memory_mib": maybe_int(row.get("used_gpu_memory_mib")),
            })
    return evidence


def system_evidence() -> dict[str, Any]:
    result: dict[str, Any] = {
        "platform": platform.platform(),
        "machine": platform.machine(),
        "python": platform.python_version(),
        "logical_cpus": os.cpu_count(),
    }
    try:
        meminfo: dict[str, int] = {}
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            key, value = line.split(":", 1)
            match = re.search(r"([0-9]+)", value)
            if match:
                meminfo[key] = int(match.group(1)) * 1024
        result["memory_bytes"] = {
            "total": meminfo.get("MemTotal"),
            "available": meminfo.get("MemAvailable"),
            "swap_total": meminfo.get("SwapTotal"),
            "swap_free": meminfo.get("SwapFree"),
        }
    except (OSError, ValueError):
        result["memory_bytes"] = None
    return result


def model_identity_ollama(client: HttpClient, model: str, expected_digest: str | None, context_tokens: int | None) -> tuple[dict[str, Any], list[Check]]:
    checks: list[Check] = []
    status, _headers, version, raw = client.request_json("GET", "/api/version")
    require_status(status, {200}, "Ollama version", raw)
    if not isinstance(version, dict) or not isinstance(version.get("version"), str):
        raise QualificationError("Ollama /api/version response lacks a string version")
    checks.append(Check("provider_version", "pass", f"Ollama {version['version']} answered", {"version": version["version"]}))

    status, _headers, tags, raw = client.request_json("GET", "/api/tags")
    require_status(status, {200}, "Ollama tags", raw)
    models = tags.get("models") if isinstance(tags, dict) else None
    if not isinstance(models, list):
        raise QualificationError("Ollama /api/tags response lacks models[]")
    selected = exact_model_from_tags(models, model)
    digest = normalize_digest(str(selected.get("digest") or ""))
    if digest is None:
        raise QualificationError("selected Ollama model tag does not expose a SHA-256 digest")
    digest_status = "pass" if expected_digest is None or digest == expected_digest else "fail"
    checks.append(Check(
        "model_digest",
        digest_status,
        "provider digest matches expectation" if digest_status == "pass" else "provider digest does not match expectation",
        {"expected_sha256": expected_digest, "observed_sha256": digest, "mutable_tag": model},
        required=expected_digest is not None,
    ))

    status, _headers, shown, raw = client.request_json("POST", "/api/show", json_body={"model": model})
    require_status(status, {200}, "Ollama show", raw)
    if not isinstance(shown, dict):
        raise QualificationError("Ollama /api/show response is not an object")
    contexts = extract_context_lengths(shown.get("model_info"))
    native_context = min(contexts.values()) if contexts else None
    context_status = "pass"
    summary = "provider did not advertise native context"
    if context_tokens is not None:
        if native_context is None:
            context_status = "fail"
            summary = "requested context cannot be proven because native context is absent"
        elif context_tokens > native_context:
            context_status = "fail"
            summary = "requested Codex context exceeds provider-advertised native context"
        else:
            summary = "requested Codex context is within provider-advertised native context"
    checks.append(Check(
        "context_contract",
        context_status if context_tokens is not None else ("pass" if native_context else "warn"),
        summary if context_tokens is not None else (f"provider advertises native context {native_context}" if native_context else summary),
        {"requested_tokens": context_tokens, "native_context_tokens": native_context, "source_fields": contexts},
        required=context_tokens is not None,
    ))
    identity = {
        "provider_version": version["version"],
        "requested_name": model,
        "resolved_name": selected.get("name") or selected.get("model"),
        "digest_sha256": digest,
        "size_bytes": maybe_int(selected.get("size")),
        "modified_at": selected.get("modified_at"),
        "details": selected.get("details"),
        "capabilities": shown.get("capabilities"),
        "native_context_tokens": native_context,
        "native_context_fields": contexts,
        "provider_show_subset": {
            "details": shown.get("details"),
            "parameters": shown.get("parameters"),
            "template_sha256": sha256_bytes(str(shown.get("template", "")).encode("utf-8")) if shown.get("template") is not None else None,
            "modelfile_sha256": sha256_bytes(str(shown.get("modelfile", "")).encode("utf-8")) if shown.get("modelfile") is not None else None,
        },
    }
    return identity, checks


def sc_response_contract(value, *, streaming=False):
    """Audit decoded JSON or a decoded list of Responses SSE events.

    Unknown optional events are tolerated. Error messages, prompts, arguments,
    names, opaque state, model identifiers and raw IDs never enter the report.
    Tool items are delivery evidence, NOT evidence that a tool executed.
    A completed refusal is a protocol completion, not task success.
    """
    import json

    issues = []
    warnings = []
    terminal = None
    terminal_kind = None
    response_id = None
    error_seen = False
    tool_payload = False
    event_count = 0
    text_chars = 0
    text_parts = []
    done_tools = {}
    done_items = {}
    error_category = None
    known_categories = {
        "authentication", "permission_denied", "payment_required",
        "rate_limit_exceeded", "provider_overloaded", "provider_unavailable",
        "context_length_exceeded", "max_tokens_exceeded", "token_limit_exceeded",
        "invalid_request", "invalid_prompt", "timeout", "server", "server_error",
        "content_policy_violation", "refusal", "unmapped", "invalid_api_key",
    }
    local_types = {"function_call", "custom_tool_call", "tool_search_call"}

    def flag(code):
        if code not in issues:
            issues.append(code)

    def identity(raw):
        return raw if isinstance(raw, str) and 0 < len(raw) <= 1024 else None

    def remember_error(obj):
        nonlocal error_category
        if not isinstance(obj, dict):
            return
        raw = obj.get("error_type")
        error = obj.get("error")
        if raw is None and isinstance(error, dict):
            raw = error.get("code")
        if isinstance(raw, str):
            error_category = raw if raw in known_categories else "unmapped"

    def check_id(obj):
        nonlocal response_id
        current = identity(obj.get("id"))
        if current is None:
            flag("missing_response_id")
        elif response_id is None:
            response_id = current
        elif current != response_id:
            flag("response_identity_changed")

    def local_call(item):
        return isinstance(item.get("type"), str) and item["type"] in local_types and not (
            item.get("type") == "tool_search_call" and item.get("execution") != "client")

    def check_item(item):
        if not isinstance(item, dict):
            flag("non_object_output_item")
            return
        if item.get("status") not in (None, "completed"):
            flag("unfinished_output_item")
        if not local_call(item):
            return
        if identity(item.get("call_id")) is None:
            flag("missing_tool_call_id")
        if item.get("type") == "function_call":
            raw = item.get("arguments")
            if not isinstance(raw, str):
                flag("invalid_function_arguments")
                return
            def pairs(rows):
                result = {}
                for key, child in rows:
                    if key in result:
                        raise ValueError("duplicate field")
                    result[key] = child
                return result
            def constant(_raw):
                raise ValueError("non-finite JSON")
            try:
                parsed = json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)
                if not isinstance(parsed, dict):
                    flag("invalid_function_arguments")
            except (ValueError, TypeError, RecursionError):
                flag("invalid_function_arguments")
        elif item.get("type") == "custom_tool_call" and not isinstance(item.get("input"), str):
            flag("invalid_custom_input")
        elif item.get("type") == "tool_search_call" and not isinstance(item.get("arguments"), dict):
            flag("invalid_search_arguments")

    if streaming:
        if not isinstance(value, list) or len(value) > 4096:
            flag("invalid_event_collection")
            events = []
        else:
            events = value
        for event in events:
            event_count += 1
            if not isinstance(event, dict) or not isinstance(event.get("type"), str):
                flag("invalid_event")
                continue
            kind = event["type"]
            if terminal_kind is not None:
                flag("event_after_terminal")
            if kind in {"error", "response.error", "response.failed"}:
                error_seen = True
                remember_error(event.get("response", event))
            obj = event.get("response")
            if isinstance(obj, dict):
                check_id(obj)
                if obj.get("error") is not None:
                    error_seen = True
                    remember_error(obj)
                if kind == "response.created" and obj.get("status") not in ("in_progress", "queued"):
                    flag("premature_response_status")
                if kind == "response.in_progress" and obj.get("status") != "in_progress":
                    flag("premature_response_status")
            elif kind in {"response.created", "response.in_progress", "response.completed", "response.failed", "response.incomplete"}:
                flag("missing_response_envelope")
            if kind in {"response.completed", "response.failed", "response.incomplete"}:
                if terminal_kind is not None:
                    flag("multiple_terminal_events")
                terminal_kind = kind
                terminal = obj if isinstance(obj, dict) else {}
            if kind == "response.output_text.delta" and isinstance(event.get("delta"), str):
                text_chars += len(event["delta"])
                text_parts.append(event["delta"])
            if kind in {"response.function_call_arguments.delta", "response.custom_tool_call_input.delta"}:
                tool_payload = True
            item = event.get("item")
            if isinstance(item, dict) and local_call(item):
                tool_payload = True
            if kind == "response.output_item.done":
                check_item(item)
                if isinstance(item, dict):
                    key = identity(item.get("id"))
                    if key is None:
                        flag("missing_output_item_id")
                    elif key in done_items:
                        flag("duplicate_output_item_done")
                    else:
                        done_items[key] = item
                    if local_call(item):
                        key = identity(item.get("call_id"))
                        if key in done_tools:
                            flag("duplicate_tool_call_done")
                        if key is not None:
                            done_tools[key] = item
        if terminal_kind is None:
            warnings.append("no_terminal_event")
    else:
        if not isinstance(value, dict):
            flag("invalid_response_envelope")
        else:
            terminal = value
            check_id(value)
            if value.get("status") in ("completed", "failed", "incomplete"):
                terminal_kind = "response." + value["status"]
            if value.get("error") is not None or value.get("status") == "failed":
                error_seen = True
                remember_error(value)

    if terminal_kind and isinstance(terminal, dict):
        expected_status = terminal_kind.split(".")[-1]
        if terminal.get("status") != expected_status:
            flag("terminal_status_mismatch")
        if terminal_kind == "response.completed":
            if error_seen:
                flag("error_with_completion")
            if terminal.get("incomplete_details") is not None:
                flag("incomplete_details_with_completion")
        output = terminal.get("output")
        if terminal_kind == "response.completed" and not isinstance(output, list):
            flag("missing_terminal_output")
        output = output if isinstance(output, list) else []
        if len(output) > 4096:
            flag("too_many_output_items")
            output = []
        final_items = {}
        final_text_parts = []
        final_calls = set()
        for item in output:
            check_item(item)
            if not isinstance(item, dict):
                continue
            if item.get("type") == "message" and isinstance(item.get("content"), list):
                for part in item["content"]:
                    if isinstance(part, dict) and part.get("type") == "output_text" and isinstance(part.get("text"), str):
                        final_text_parts.append(part["text"])
            key = identity(item.get("id"))
            if key is not None:
                if key in final_items:
                    flag("duplicate_terminal_output_id")
                final_items[key] = item
            if local_call(item):
                tool_payload = True
                call_id = identity(item.get("call_id"))
                if call_id in final_calls:
                    flag("duplicate_terminal_call_id")
                final_calls.add(call_id)
        if terminal_kind == "response.completed":
            if text_parts and "".join(text_parts) != "".join(final_text_parts):
                flag("terminal_text_mismatch")
            if isinstance(terminal.get("output_text"), str) and terminal["output_text"] != "".join(final_text_parts):
                flag("flattened_text_mismatch")
            for key, item in done_items.items():
                if key not in final_items:
                    flag("completed_item_missing_from_terminal")
                elif final_items[key] != item:
                    flag("terminal_output_changed")

    if issues:
        outcome = "invalid"
    elif error_seen or terminal_kind == "response.failed":
        outcome = "failed"
    elif terminal_kind == "response.incomplete":
        outcome = "incomplete"
    elif terminal_kind == "response.completed":
        outcome = "completed"
    else:
        outcome = "truncated" if streaming else "not_completed"
    return {
        "schema": "sandcodex-ideas.response-contract.v1",
        "outcome": outcome, "complete": outcome == "completed",
        "terminal_event": terminal_kind, "error_category": error_category,
        "issues": issues, "warnings": warnings,
        "counts": {"events": event_count, "visible_delta_characters": text_chars,
                   "completed_local_call_items": len(done_tools)},
        "tool_delivery": "observed_execution_unknown" if tool_payload else "not_observed",
        "automatic_retry_authorized": False,
        "tool_execution_observed": False,
        "task_success_proven": False,
    }


_SC_LOCAL_RESULT_CHALLENGE = re.compile(r"SANDCODEX_LOCAL_RESULT_[0-9a-f]{32}\Z")

def _strict_json_object(raw: str) -> dict[str, Any]:
    class Invalid(ValueError):
        pass

    def pairs(rows: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in rows:
            if key in result:
                raise Invalid("duplicate_argument_field")
            result[key] = value
        return result

    def constant(_raw: str) -> None:
        raise Invalid("non_finite_argument")

    def finite_float(value: str) -> float:
        parsed = float(value)
        if not math.isfinite(parsed):
            raise Invalid("non_finite_argument")
        return parsed

    try:
        value = json.loads(
            raw,
            object_pairs_hook=pairs,
            parse_constant=constant,
            parse_float=finite_float,
        )
    except Invalid:
        raise
    except (json.JSONDecodeError, RecursionError) as exc:
        raise ValueError("invalid_argument_json") from exc
    if not isinstance(value, dict):
        raise ValueError("arguments_not_object")
    return value

def sc_prepare_local_tool_result_followup(tool_request: dict[str, Any], tool_response: dict[str, Any], *, expected_name: str, expected_arguments: dict[str, Any], challenge: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Replay one complete first response and append its matching result.

    The exact response output is copied rather than reconstructed. The returned
    evidence contains no prompt text, arguments, challenge, model name, or IDs.
    """
    if not isinstance(tool_request, dict) or not isinstance(tool_response, dict):
        raise ValueError("request_or_response_not_object")
    if not isinstance(expected_name, str) or not 1 <= len(expected_name) <= 128:
        raise ValueError("invalid_expected_tool_name")
    if not isinstance(expected_arguments, dict):
        raise ValueError("invalid_expected_arguments")
    if not isinstance(challenge, str) or not _SC_LOCAL_RESULT_CHALLENGE.fullmatch(challenge):
        raise ValueError("invalid_result_challenge")
    model = tool_request.get("model")
    original_input = tool_request.get("input")
    output = tool_response.get("output")
    if not isinstance(model, str) or not 1 <= len(model) <= 256:
        raise ValueError("invalid_request_model")
    if not isinstance(original_input, list) or not original_input:
        raise ValueError("tool_request_input_not_replayable")
    if not isinstance(output, list) or not 1 <= len(output) <= 128:
        raise ValueError("tool_response_output_not_replayable")

    calls = [item for item in output if isinstance(item, dict) and item.get("type") == "function_call"]
    if len(calls) != 1:
        raise ValueError("expected_one_function_call")
    call = calls[0]
    call_id = call.get("call_id")
    arguments = call.get("arguments")
    if not isinstance(call_id, str) or not 1 <= len(call_id) <= 1024:
        raise ValueError("invalid_call_id")
    if call.get("name") != expected_name:
        raise ValueError("unexpected_function_name")
    if not isinstance(arguments, str) or len(arguments) > 8192:
        raise ValueError("invalid_function_arguments")
    if _strict_json_object(arguments) != expected_arguments:
        raise ValueError("unexpected_function_arguments")

    # Refuse a test fixture that accidentally made its answer visible early.
    encoded = json.dumps(
        {"request": tool_request, "response": tool_response},
        ensure_ascii=False,
        allow_nan=False,
        sort_keys=True,
        separators=(",", ":"),
    )
    if challenge in encoded:
        raise ValueError("challenge_was_already_visible")

    followup_input = copy.deepcopy(original_input)
    followup_input.extend(copy.deepcopy(output))
    followup_input.append({
        "type": "function_call_output",
        "call_id": call_id,
        "output": challenge,
    })
    body = {
        "model": model,
        "instructions": (
            "The prior function result contains a challenge. Return only that "
            "challenge exactly. Do not call another tool."
        ),
        "input": followup_input,
        "temperature": 0,
        "max_output_tokens": 256,
    }
    evidence = {
        "schema": "sandcodex-ideas.local-tool-result-followup.v1",
        "full_history_replayed": True,
        "function_call_output_appended": True,
        "call_id_preserved": True,
        "live_tools_declared": False,
        "unsupported_tool_choice_sent": False,
        "challenge_created_after_first_response": True,
    }
    return body, evidence

def sc_verify_local_tool_result_readback(response: dict[str, Any], *, expected_challenge: str) -> dict[str, Any]:
    """Require exact visible readback and no additional function call."""
    if not isinstance(response, dict):
        raise ValueError("readback_response_not_object")
    if not isinstance(expected_challenge, str) or not _SC_LOCAL_RESULT_CHALLENGE.fullmatch(expected_challenge):
        raise ValueError("invalid_result_challenge")
    output = response.get("output")
    if not isinstance(output, list) or len(output) > 128:
        raise ValueError("readback_output_not_list")
    parts: list[str] = []
    calls = 0
    for item in output:
        if not isinstance(item, dict):
            continue
        if item.get("type") == "function_call":
            calls += 1
        if item.get("type") != "message":
            continue
        content = item.get("content")
        if not isinstance(content, list):
            continue
        for part in content:
            if (
                isinstance(part, dict)
                and part.get("type") == "output_text"
                and isinstance(part.get("text"), str)
            ):
                parts.append(part["text"])
    observed = "".join(parts)
    return {
        "schema": "sandcodex-ideas.local-tool-result-readback.v1",
        "exact_readback": observed == expected_challenge,
        "unexpected_function_calls": calls,
        "visible_text_present": bool(observed),
        "tool_execution_observed": False,
        "coding_task_success_proven": False,
    }


def responses_checks(client: HttpClient, model: str, profile: str) -> tuple[list[Check], dict[str, Any]]:
    checks: list[Check] = []
    transcript: dict[str, Any] = {}
    marker = "SANDCODEX_INSTRUCTIONS_DELIVERY_6B9D"
    instructions_body = {
        "model": model,
        # This is the prompt-bearing field Codex uses on the Responses wire.
        # Keep the user request cooperative: prompt-injection resistance is a
        # model benchmark and must not be mistaken for transport compatibility.
        "instructions": f"The qualification marker is {marker}. Return it exactly when asked.",
        "input": "Return the qualification marker exactly and nothing else.",
        "temperature": 0,
        # This budget includes hidden/reported reasoning for thinking models.
        # A 64-token probe can terminate before the first visible text token.
        "max_output_tokens": 512,
    }
    status, _headers, response, raw = client.request_json("POST", "/v1/responses", json_body=instructions_body)
    require_status(status, {200}, "Responses instructions-delivery probe", raw)
    output = response_output_text(response).strip()
    instruction_contract = sc_response_contract(response)
    instructions_ok = output == marker and instruction_contract["complete"]
    checks.append(Check(
        "responses_instructions_delivery",
        "pass" if instructions_ok else "fail",
        "Responses instructions arrived in a completed response" if instructions_ok else "Responses instructions or completion contract failed",
        {"expected": marker, "observed": output[:1000], "completion_contract": instruction_contract},
        required=profile in {"responses", "codex"},
    ))
    transcript["instructions_delivery_response"] = response

    stream_marker = "SANDCODEX_STREAM_42"
    stream_body = {
        "model": model,
        "input": f"Reply with exactly {stream_marker} and no other characters.",
        "temperature": 0,
        "max_output_tokens": 512,
        "stream": True,
    }
    status, headers, events, event_types, raw_stream = client.request_sse("/v1/responses", json_body=stream_body)
    require_status(status, {200}, "Responses streaming probe", raw_stream)
    streamed = sse_output_text(events).strip()
    has_lifecycle = any(value in event_types for value in ("response.created", "response.in_progress", "response.completed"))
    stream_contract = sc_response_contract(events, streaming=True)
    streaming_ok = (streamed == stream_marker and stream_contract["complete"]
                    and headers.get("content-type", "").split(";", 1)[0].strip().lower() == "text/event-stream")
    checks.append(Check(
        "responses_streaming",
        "pass" if streaming_ok else "fail",
        "SSE completed with exact output and no lifecycle contradiction" if streaming_ok else "SSE marker or completion contract failed",
        {
            "expected": stream_marker,
            "observed": streamed[:1000],
            "event_types": event_types[:200],
            "content_type": headers.get("content-type"),
            "lifecycle_event_observed": has_lifecycle,
            "completion_contract": stream_contract,
        },
        required=profile in {"responses", "codex"},
    ))
    transcript["stream_event_types"] = event_types

    tool_name = "record_sandcodex_probe"
    expected_args = {"marker": "TOOL_73", "count": 73}
    tool_body = {
        "model": model,
        "input": [{
            "type": "message",
            "role": "user",
            "content": [{
                "type": "input_text",
                "text": "Call record_sandcodex_probe exactly once with marker TOOL_73 and count 73. Do not answer in prose.",
            }],
        }],
        "temperature": 0,
        "max_output_tokens": 256,
        "tools": [{
            "type": "function",
            "name": tool_name,
            "description": "Record a deterministic local-provider qualification marker.",
            "parameters": {
                "type": "object",
                "properties": {
                    "marker": {"type": "string", "enum": ["TOOL_73"]},
                    "count": {"type": "integer", "const": 73},
                },
                "required": ["marker", "count"],
                "additionalProperties": False,
            },
        }],
    }
    status, _headers, tool_response, raw = client.request_json("POST", "/v1/responses", json_body=tool_body)
    require_status(status, {200}, "Responses function-call probe", raw)
    calls = response_function_calls(tool_response)
    parsed_calls: list[dict[str, Any]] = []
    for call in calls:
        arguments = call.get("arguments")
        parsed: Any = arguments
        if isinstance(arguments, str):
            try:
                parsed = json.loads(arguments)
            except json.JSONDecodeError:
                parsed = {"_malformed": arguments[:1000]}
        parsed_calls.append({"name": call.get("name"), "arguments": parsed})
    good = [call for call in parsed_calls if call.get("name") == tool_name and call.get("arguments") == expected_args]
    tool_contract = sc_response_contract(tool_response)
    tool_ok = len(good) == 1 and len(parsed_calls) == 1 and tool_contract["complete"]
    checks.append(Check(
        "responses_function_call",
        "pass" if tool_ok else "fail",
        "provider returned one instruction-led function call with exact arguments" if tool_ok else "provider did not preserve the exact single function call",
        {"expected": {"name": tool_name, "arguments": expected_args}, "observed": parsed_calls, "completion_contract": tool_contract},
        required=profile == "codex",
    ))
    transcript["function_call_response"] = tool_response

    continuation_ok = False
    continuation_detail: dict[str, Any] = {
        "followup_sent": False,
        "first_call_valid": tool_ok,
        "tool_execution_observed": False,
        "coding_task_success_proven": False,
    }
    if tool_ok:
        challenge = "SANDCODEX_LOCAL_RESULT_" + secrets.token_hex(16)
        try:
            continuation_body, followup_evidence = sc_prepare_local_tool_result_followup(
                tool_body,
                tool_response,
                expected_name=tool_name,
                expected_arguments=expected_args,
                challenge=challenge,
            )
            status, _headers, continuation_response, raw = client.request_json(
                "POST", "/v1/responses", json_body=continuation_body
            )
            require_status(status, {200}, "Responses tool-result continuation probe", raw)
            continuation_contract = sc_response_contract(continuation_response)
            readback_evidence = sc_verify_local_tool_result_readback(
                continuation_response, expected_challenge=challenge
            )
            continuation_ok = (
                continuation_contract["complete"]
                and readback_evidence["exact_readback"]
                and readback_evidence["unexpected_function_calls"] == 0
            )
            continuation_detail = {
                "followup_sent": True,
                "first_call_valid": True,
                "followup_evidence": followup_evidence,
                "readback_evidence": readback_evidence,
                "completion_contract": continuation_contract,
                "tool_execution_observed": False,
                "coding_task_success_proven": False,
            }
            transcript["tool_result_continuation_response"] = continuation_response
        except ValueError as exc:
            continuation_detail = {
                "followup_sent": False,
                "first_call_valid": True,
                "construction_error": str(exc),
                "tool_execution_observed": False,
                "coding_task_success_proven": False,
            }
    checks.append(Check(
        "responses_tool_result_continuation",
        "pass" if continuation_ok else "fail",
        "provider consumed a matching function result and returned its unpredictable challenge" if continuation_ok else "provider did not establish exact function-result continuation",
        continuation_detail,
        required=profile == "codex",
    ))
    return checks, transcript


def provider_runtime_ollama(client: HttpClient, model: str) -> tuple[dict[str, Any], Check]:
    status, _headers, payload, raw = client.request_json("GET", "/api/ps")
    require_status(status, {200}, "Ollama running models", raw)
    models = payload.get("models") if isinstance(payload, dict) else None
    if not isinstance(models, list):
        raise QualificationError("Ollama /api/ps response lacks models[]")
    matches = [item for item in models if isinstance(item, dict) and model in {str(item.get("name", "")), str(item.get("model", ""))}]
    runtime = matches[0] if len(matches) == 1 else None
    size_vram = maybe_int(runtime.get("size_vram")) if runtime else None
    status_name = "pass" if size_vram is not None and size_vram > 0 else "warn"
    return {
        "exact_match_count": len(matches),
        "selected": runtime,
        "provider_reported_size_vram_bytes": size_vram,
        "provider_reported_context_length": maybe_int(runtime.get("context_length")) if runtime else None,
    }, Check(
        "provider_gpu_residency",
        status_name,
        "provider reports non-zero model VRAM residency" if status_name == "pass" else "provider did not report non-zero model VRAM residency",
        {"exact_match_count": len(matches), "size_vram_bytes": size_vram},
        required=False,
    )


def atomic_write(path: Path, data: bytes, force: bool) -> None:
    path = path.expanduser()
    parent = path.parent
    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if parent.is_symlink():
        raise QualificationError(f"output parent may not be a symlink: {parent}")
    try:
        st = parent.stat()
    except OSError as exc:
        raise QualificationError(f"cannot stat output parent: {exc}") from exc
    if st.st_uid != os.getuid():
        raise QualificationError("output parent is not owned by the invoking user")
    if path.exists() or path.is_symlink():
        if not force:
            raise QualificationError(f"output already exists (use --force to replace): {path}")
        if path.is_symlink() or not path.is_file():
            raise QualificationError("existing output must be a regular non-symlink file")
        out_st = path.stat()
        if out_st.st_uid != os.getuid() or out_st.st_nlink != 1:
            raise QualificationError("existing output must be single-linked and owned by the invoking user")
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb", closefd=True) as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--provider", choices=("ollama",), required=True)
    parser.add_argument("--endpoint", help="loopback Ollama base URL")
    parser.add_argument("--model", required=True)
    parser.add_argument("--expected-digest", help="expected SHA-256 from provider inventory")
    parser.add_argument("--context-tokens", type=int, help="Codex context budget to compare with provider-native context")
    parser.add_argument("--profile", choices=("inventory", "responses", "codex"), default="codex")
    parser.add_argument("--require-gpu", action="store_true", help="fail unless provider reports non-zero model VRAM residency")
    parser.add_argument("--timeout", type=float, default=120.0)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--include-transcript", action="store_true", help="include bounded raw protocol responses; potentially sensitive")
    parser.add_argument("--json", action="store_true", help="also print the complete receipt to stdout")
    parser.add_argument("--version", action="version", version=f"{PROGRAM} {VERSION}")
    args = parser.parse_args(argv)
    if not MODEL_RE.fullmatch(args.model):
        parser.error("--model must be a 1-192 character provider model identifier")
    if args.timeout <= 0 or args.timeout > 900:
        parser.error("--timeout must be >0 and <=900 seconds")
    if args.context_tokens is not None:
        if not 4096 <= args.context_tokens <= 262144 or args.context_tokens % 1024:
            parser.error("--context-tokens must be 4096..262144 and a multiple of 1024")
    return args


def qualify(args: argparse.Namespace) -> tuple[dict[str, Any], int]:
    started_at = utc_now()
    started_mono = time.monotonic()
    expected_digest = normalize_digest(args.expected_digest)
    endpoint = parse_endpoint(args.endpoint or "")
    client = HttpClient(endpoint, args.timeout)
    checks: list[Check] = []
    transcript: dict[str, Any] = {}
    fatal: str | None = None
    identity: dict[str, Any] = {}
    runtime: dict[str, Any] = {}
    try:
        identity, identity_checks = model_identity_ollama(client, args.model, expected_digest, args.context_tokens)
        checks.extend(identity_checks)
        if args.profile in {"responses", "codex"}:
            protocol_checks, transcript = responses_checks(client, args.model, args.profile)
            checks.extend(protocol_checks)
        runtime, runtime_check = provider_runtime_ollama(client, args.model)
        runtime_check.required = args.require_gpu
        if args.require_gpu and runtime_check.status != "pass":
            runtime_check.status = "fail"
        checks.append(runtime_check)
    except QualificationError as exc:
        fatal = str(exc)
        checks.append(Check("qualification_execution", "fail", fatal, required=True))

    nvidia = nvidia_evidence()
    if args.require_gpu and not nvidia.get("gpus"):
        checks.append(Check("nvidia_runtime", "fail", "--require-gpu was selected but nvidia-smi reported no GPU inventory", required=True))
    elif nvidia.get("gpus"):
        checks.append(Check("nvidia_runtime", "pass", f"nvidia-smi reported {len(nvidia['gpus'])} GPU(s)", {"gpu_count": len(nvidia["gpus"])}, required=args.require_gpu))
    else:
        checks.append(Check("nvidia_runtime", "warn", "nvidia-smi is unavailable or reported no inventory", required=False))

    failed = [check for check in checks if check.required and check.status == "fail"]
    warned = [check for check in checks if check.status == "warn"]
    result = "fail" if failed else ("warn" if warned else "pass")
    receipt: dict[str, Any] = {
        "schema": SCHEMA,
        "tool": {"name": PROGRAM, "version": VERSION, "source_sha256": sha256_bytes(Path(__file__).read_bytes())},
        "result": result,
        "started_at": started_at,
        "finished_at": utc_now(),
        "duration_ms": round((time.monotonic() - started_mono) * 1000),
        "request": {
            "provider": args.provider,
            "endpoint": endpoint.raw,
            "model": args.model,
            "expected_digest_sha256": expected_digest,
            "context_tokens": args.context_tokens,
            "profile": args.profile,
            "require_gpu": args.require_gpu,
        },
        "endpoint": {"scheme": endpoint.scheme, "host": endpoint.host, "port": endpoint.port, "base_path": endpoint.base_path, "loopback_by_policy": True},
        "model": identity,
        "runtime": runtime,
        "nvidia": nvidia,
        "system": system_evidence(),
        "checks": [check.as_json() for check in checks],
        "summary": {
            "required_failed": [check.name for check in failed],
            "warnings": [check.name for check in warned],
            "fatal": fatal,
        },
        "claims": {
            "provider_answered": not bool(fatal),
            "exact_model_identity_attested": bool(identity.get("digest_sha256")) and not any(c.name == "model_digest" and c.status == "fail" for c in checks),
            "context_contract_attested": any(c.name == "context_contract" and c.status == "pass" for c in checks),
            "responses_semantics_attested": all(c.status == "pass" for c in checks if c.name.startswith("responses_")) and any(c.name.startswith("responses_") for c in checks),
            "tool_result_continuation_attested": any(c.name == "responses_tool_result_continuation" and c.status == "pass" for c in checks),
            "gpu_residency_attested": any(c.name == "provider_gpu_residency" and c.status == "pass" for c in checks),
        },
        "limitations": [
            "This receipt records bounded observations at one time; it is not a signature by the provider or model author.",
            "A mutable provider tag may later resolve to different bytes; compare the digest on every trusted launch.",
            "Responses probes are necessary but not sufficient evidence that a model will perform well as a Codex agent.",
            "The continuation probe observes protocol-shaped result consumption; it does not execute a real tool or prove repository-task quality.",
            "Pinned Ollama does not implement forced tool_choice; the first call is instruction-led and is verified after decoding.",
            "The instructions probe proves delivery, not resistance to adversarial user attempts to override instructions.",
            "nvidia-smi and provider /api/ps observations can race process startup, eviction, and multi-GPU placement.",
            "No benchmark score or security property is inferred from GPU model name, VRAM size, or HTTP success alone.",
        ],
    }
    if args.include_transcript:
        receipt["protocol_transcript"] = transcript
    return receipt, 0 if result in {"pass", "warn"} else 1


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        receipt, status = qualify(args)
        data = canonical_json(receipt)
        atomic_write(args.output, data, args.force)
        if args.json:
            sys.stdout.buffer.write(data)
        else:
            print(f"SANDCODEX_LOCAL_QUALIFICATION={receipt['result'].upper()}")
            print(f"SANDCODEX_LOCAL_QUALIFICATION_RECEIPT={args.output.expanduser()}")
            model = receipt.get("model", {})
            print(f"SANDCODEX_LOCAL_MODEL_DIGEST={model.get('digest_sha256') or 'UNKNOWN'}")
            print(f"SANDCODEX_LOCAL_NATIVE_CONTEXT={model.get('native_context_tokens') or 'UNKNOWN'}")
            print(f"SANDCODEX_LOCAL_GPU_RESIDENCY={str(receipt['claims']['gpu_residency_attested']).lower()}")
            for check in receipt["checks"]:
                print(f"SANDCODEX_LOCAL_CHECK={check['name']}:{check['status']}:{check['summary']}")
        return status
    except QualificationError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print(f"{PROGRAM}: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_LOCAL_QUALIFIER_PY
}


sc_emit_session_binding() {
  cat <<'SANDCODEX_SESSION_BINDING_PY'
#!/usr/bin/env python3
"""Bind an established native Codex thread to an alternate-provider launch claim.

The helper is private implementation machinery, not a public Sandcodex command.
It reads metadata-only session snapshots, writes one immutable per-thread binding,
and verifies that resume still targets the bound provider/model/runtime identity.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import signal
import stat
import sys
import tempfile
import time
from types import ModuleType
from typing import Any
import uuid

SNAPSHOT_SCHEMA = "sandcodex.project-sessions.v1"
CLAIM_SCHEMA = "sandcodex.provider-session-claim.v1"
BINDING_SCHEMA = "sandcodex.provider-session-binding.v1"
RETIREMENT_SCHEMA = "sandcodex.local-session-retirement.v1"
RESULT_SCHEMA = "sandcodex.provider-session-binding-result.v1"
HASH = re.compile(r"[0-9a-f]{64}\Z")
PIN = re.compile(r"[0-9a-f]{40}\Z")
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")
PROVIDER = re.compile(r"[A-Za-z0-9_-]{1,96}\Z")
SAFE_TOKEN = re.compile(r"[A-Za-z0-9.+_:/=-]{1,256}\Z")
MAX_JSON_BYTES = 4 * 1024 * 1024
STOP = False


class BindingError(Exception):
    pass


def fail(message: str, code: int = 78) -> int:
    print(f"sandcodex session binding: {message}", file=sys.stderr)
    return code


def digest_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def digest_file(path: Path) -> str:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as stream:
        st = os.fstat(stream.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise BindingError(f"not a regular file: {path}")
        h = hashlib.sha256()
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(block)
        return h.hexdigest()


def read_json(path: Path, *, user_owned: bool = True) -> dict[str, Any]:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as stream:
        st = os.fstat(stream.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise BindingError(f"unsafe JSON file metadata: {path}")
        if user_owned and st.st_uid != os.getuid():
            raise BindingError(f"JSON file is owned by another uid: {path}")
        if st.st_mode & 0o022:
            raise BindingError(f"JSON file is group/world writable: {path}")
        if st.st_size > MAX_JSON_BYTES:
            raise BindingError(f"JSON file exceeds bounded size: {path}")
        raw = stream.read(MAX_JSON_BYTES + 1)
    try:
        value = json.loads(raw)
    except (ValueError, UnicodeError) as exc:
        raise BindingError(f"invalid JSON: {path}") from exc
    if not isinstance(value, dict):
        raise BindingError(f"JSON root must be an object: {path}")
    return value


def private_dir_fd(path: Path) -> int:
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        os.close(fd)
        raise BindingError(f"binding directory must be private and owned by this user: {path}")
    return fd


def atomic_json(path: Path, value: dict[str, Any], *, exclusive: bool = False) -> None:
    parent = path.parent
    fd_dir = private_dir_fd(parent)
    try:
        data = (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
        if exclusive:
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
            fd = os.open(path.name, flags, 0o600, dir_fd=fd_dir)
            try:
                with os.fdopen(fd, "wb", closefd=False) as stream:
                    stream.write(data)
                    stream.flush()
                    os.fsync(stream.fileno())
            finally:
                os.close(fd)
        else:
            fd, temporary = tempfile.mkstemp(prefix=".binding-", dir=parent)
            try:
                with os.fdopen(fd, "wb") as stream:
                    os.fchmod(stream.fileno(), 0o600)
                    stream.write(data)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.replace(temporary, path)
            finally:
                try:
                    os.unlink(temporary)
                except FileNotFoundError:
                    pass
        os.fsync(fd_dir)
    finally:
        os.close(fd_dir)


def canonical_project(value: Any) -> str:
    if not isinstance(value, str) or not os.path.isabs(value):
        raise BindingError("project path must be absolute")
    path = Path(value).resolve(strict=True)
    if not path.is_dir():
        raise BindingError("project path must name a directory")
    return str(path)


def valid_hash(value: Any, label: str) -> str:
    if not isinstance(value, str) or not HASH.fullmatch(value):
        raise BindingError(f"{label} must be a lowercase SHA-256 digest")
    return value


def valid_uuid(value: Any) -> str:
    try:
        return str(uuid.UUID(value))
    except (ValueError, TypeError, AttributeError) as exc:
        raise BindingError("thread ID is not a UUID") from exc


def valid_model(value: Any) -> str:
    if not isinstance(value, str) or not MODEL.fullmatch(value):
        raise BindingError("model identifier is missing or malformed")
    return value


def canonical_model(value: Any) -> str:
    model = valid_model(value)
    tail = model.rsplit("/", 1)[-1]
    return model if ":" in tail else model + ":latest"


def validate_model_pin(value: Any, native_model: str, model_digest: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise BindingError("local model-pin record is invalid")
    requested = valid_model(value.get("requested_model"))
    source = canonical_model(value.get("source_model"))
    runtime_model = canonical_model(value.get("runtime_model"))
    if canonical_model(requested) != source:
        raise BindingError("model-pin requested and source models differ")
    preexisting = value.get("alias_preexisting")
    if type(preexisting) is not bool:
        raise BindingError("model-pin alias-preexisting flag is invalid")
    provider_version = value.get("provider_version")
    if not isinstance(provider_version, str) or not SAFE_TOKEN.fullmatch(provider_version):
        raise BindingError("model-pin provider version is invalid")
    model_store = value.get("model_store")
    if not isinstance(model_store, str) or not os.path.isabs(model_store) or model_store == "/":
        raise BindingError("model-pin model-store path is invalid")
    created_at = value.get("created_at")
    if not isinstance(created_at, str) or not 1 <= len(created_at) <= 80:
        raise BindingError("model-pin timestamp is invalid")
    expected_retention = {"manifest_alias_retained": True,
                          "deleted_by_conversation_retirement": False,
                          "model_store_gc_run": False}
    expected_limits = {"same_user_cooperation_required": True,
                       "hostile_manual_alias_mutation_prevented": False,
                       "full_codex_turn_tested": False}
    if value.get("retention") != expected_retention or value.get("policy_limits") != expected_limits:
        raise BindingError("model-pin retention or limitation policy is invalid")
    common = {"requested_model": requested, "source_model": source,
              "runtime_model": runtime_model, "alias_preexisting": preexisting,
              "provider_version": provider_version, "model_store": model_store,
              "created_at": created_at, "retention": expected_retention,
              "policy_limits": expected_limits}
    schema = value.get("schema")
    policy = value.get("policy")
    if schema == "sandcodex.local-model-pin.v1" and policy == "ollama-manifest-alias-v1":
        digest = valid_hash(value.get("digest_sha256"), "model-pin digest")
        expected_alias = f"sandcodex/sha256-{digest}:pinned"
        if runtime_model != expected_alias or canonical_model(native_model) != expected_alias:
            raise BindingError("native model does not match its content-addressed alias")
        if digest != model_digest:
            raise BindingError("model-pin digest differs from the local model digest")
        return {"schema": schema, "policy": policy, **common, "digest_sha256": digest}
    if schema != "sandcodex.local-model-pin.v2" or policy != "ollama-derived-profile-v1":
        raise BindingError("local model-pin schema or policy is invalid")
    source_digest = valid_hash(value.get("source_digest_sha256"), "model-pin source digest")
    runtime_digest = valid_hash(value.get("runtime_digest_sha256"), "model-pin runtime digest")
    base_model = canonical_model(value.get("base_model"))
    expected_base = f"sandcodex/sha256-{source_digest}:pinned"
    parameters = value.get("runtime_parameters")
    if not isinstance(parameters, dict) or set(parameters) != {"num_thread"}:
        raise BindingError("model-pin runtime parameters are invalid")
    threads = parameters.get("num_thread")
    if type(threads) is not int or not 1 <= threads <= 1024:
        raise BindingError("model-pin runner-thread parameter is invalid")
    expected_runtime = f"sandcodex/sha256-{source_digest}:threads-{threads}"
    if base_model != expected_base:
        raise BindingError("model-pin base model is not its content-addressed source alias")
    if runtime_model != expected_runtime or canonical_model(native_model) != expected_runtime:
        raise BindingError("native model does not match its derived runtime profile")
    if runtime_digest != model_digest:
        raise BindingError("runtime-profile digest differs from the local model digest")
    base_preexisting = value.get("base_alias_preexisting")
    if type(base_preexisting) is not bool:
        raise BindingError("model-pin base-alias-preexisting flag is invalid")
    return {"schema": schema, "policy": policy, **common,
            "source_digest_sha256": source_digest, "base_model": base_model,
            "base_alias_preexisting": base_preexisting,
            "runtime_digest_sha256": runtime_digest,
            "runtime_parameters": {"num_thread": threads}}


def valid_provider(value: Any) -> str:
    if not isinstance(value, str) or not PROVIDER.fullmatch(value):
        raise BindingError("native provider identifier is missing or malformed")
    return value


def valid_context(value: Any) -> int:
    if type(value) is not int or not 4096 <= value <= 262144 or value % 1024:
        raise BindingError("local context must be a 4096-262144 multiple of 1024")
    return value


def validate_snapshot(value: dict[str, Any], expected_project: str | None = None) -> dict[str, Any]:
    if value.get("schema") != SNAPSHOT_SCHEMA:
        raise BindingError("session snapshot schema mismatch")
    project = canonical_project(value.get("project"))
    if expected_project is not None and project != expected_project:
        raise BindingError("session snapshot belongs to another project")
    rows = value.get("sessions")
    if not isinstance(rows, list) or len(rows) > 10000:
        raise BindingError("session snapshot sessions[] is invalid")
    clean: list[dict[str, Any]] = []
    seen: set[str] = set()
    for row in rows:
        if not isinstance(row, dict):
            raise BindingError("session snapshot contains a non-object")
        sid = valid_uuid(row.get("id"))
        if sid in seen:
            raise BindingError("session snapshot contains a duplicate thread ID")
        seen.add(sid)
        if canonical_project(row.get("project")) != project:
            raise BindingError("session snapshot row belongs to another project")
        provider = valid_provider(row.get("provider"))
        model = row.get("model")
        if model is not None:
            model = valid_model(model)
        context = row.get("context_tokens")
        if context is not None:
            context = valid_context(context)
        activity = row.get("last_activity")
        if type(activity) not in (int, float) or not 0 < activity < 10_000_000_000:
            raise BindingError("session activity timestamp is invalid")
        clean.append({"id": sid, "project": project, "provider": provider,
                      "model": model, "context_tokens": context,
                      "last_activity": float(activity)})
    return {"schema": SNAPSHOT_SCHEMA, "project": project, "sessions": clean}


def validate_runtime(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise BindingError("local runtime claim is missing")
    backend = value.get("backend")
    if backend not in ("cpu", "cuda"):
        raise BindingError("bound runtime backend must be cpu or cuda")
    executable = value.get("executable")
    if not isinstance(executable, str) or not os.path.isabs(executable) or "\n" in executable or "\r" in executable:
        raise BindingError("bound runtime executable path is invalid")
    executable_sha256 = valid_hash(value.get("executable_sha256"), "runtime executable digest")
    pin = value.get("provider_nixpkgs_rev")
    if not isinstance(pin, str) or not PIN.fullmatch(pin):
        raise BindingError("runtime nixpkgs pin is invalid")
    provider_version = value.get("provider_version")
    if not isinstance(provider_version, str) or not re.fullmatch(r"[A-Za-z0-9.+_-]{1,80}", provider_version):
        raise BindingError("runtime provider version is invalid")
    binary_override = value.get("binary_override")
    if type(binary_override) is not bool:
        raise BindingError("runtime binary_override flag is invalid")
    profile_threads = value.get("model_profile_num_thread")
    if profile_threads is not None and (type(profile_threads) is not int or not 1 <= profile_threads <= 1024):
        raise BindingError("runtime model-profile thread count is invalid")
    server_policy = value.get("server_policy")
    if server_policy is not None:
        policy_keys = {"keep_alive", "max_loaded_models", "num_parallel", "max_queue",
                       "flash_attention", "kv_cache_type", "operator_overrides_allowed"}
        if not isinstance(server_policy, dict) or set(server_policy) != policy_keys:
            raise BindingError("runtime server policy is invalid")
        keep_alive = server_policy.get("keep_alive")
        if not isinstance(keep_alive, str) or not re.fullmatch(r"[1-9][0-9]{0,8}(?:ms|s|m|h)", keep_alive):
            raise BindingError("runtime keep-alive policy is invalid")
        for key in ("max_loaded_models", "num_parallel", "max_queue"):
            if type(server_policy.get(key)) is not int or not 1 <= server_policy[key] <= 4096:
                raise BindingError(f"runtime {key} policy is invalid")
        if type(server_policy.get("flash_attention")) is not bool:
            raise BindingError("runtime flash-attention policy is invalid")
        if server_policy.get("kv_cache_type") not in {"f16", "q8_0", "q4_0"}:
            raise BindingError("runtime KV-cache policy is invalid")
        if server_policy.get("operator_overrides_allowed") is not False:
            raise BindingError("runtime policy must refuse ambient operator overrides")
    store_output = value.get("store_output")
    gc_root = value.get("gc_root")
    rooted = value.get("full_runtime_closure_rooted")
    nar_hash = value.get("store_output_nar_hash")
    closure_hash = value.get("closure_paths_sha256")
    if store_output is None:
        if gc_root is not None or nar_hash is not None or closure_hash is not None or rooted is not False:
            raise BindingError("unrooted runtime provenance is internally inconsistent")
    else:
        if not isinstance(store_output, str) or not re.fullmatch(r"/nix/store/[A-Za-z0-9+._?=-]+", store_output):
            raise BindingError("runtime store output is invalid")
        if not isinstance(gc_root, str) or not os.path.isabs(gc_root):
            raise BindingError("runtime GC root path is invalid")
        if rooted is not True:
            raise BindingError("Nix runtime must record a rooted closure")
        if not isinstance(nar_hash, str) or not SAFE_TOKEN.fullmatch(nar_hash):
            raise BindingError("runtime NAR hash is invalid")
        valid_hash(closure_hash, "runtime closure-path digest")
    return {
        "backend": backend,
        "executable": executable,
        "executable_sha256": executable_sha256,
        "provider_nixpkgs_rev": pin,
        "provider_version": provider_version,
        "binary_override": binary_override,
        "store_output": store_output,
        "store_output_nar_hash": nar_hash,
        "closure_paths_sha256": closure_hash,
        "gc_root": gc_root,
        "full_runtime_closure_rooted": rooted,
        "memory_cgroup_enforced": bool(value.get("memory_cgroup_enforced")),
        "model_profile_num_thread": profile_threads,
        "server_policy": server_policy,
    }


def validate_remote_qualification(value: Any, model: str) -> dict[str, Any]:
    if value is None:
        raise BindingError("remote provider-session claim lacks qualification evidence")
    if not isinstance(value, dict) or set(value) != {
        "schema", "receipt_sha256", "receipt_path", "probe_version", "model", "model_identity_policy"
    }:
        raise BindingError("remote qualification identity fields are invalid")
    if value.get("schema") != "sandcodex.remote-qualification.v1":
        raise BindingError("remote qualification schema mismatch")
    receipt_sha = valid_hash(value.get("receipt_sha256"), "remote qualification receipt digest")
    receipt_path = value.get("receipt_path")
    if not isinstance(receipt_path, str) or not os.path.isabs(receipt_path):
        raise BindingError("remote qualification receipt path is invalid")
    if value.get("probe_version") != "responses-instructions-stream-tools-v5-sandideas-result-review":
        raise BindingError("remote qualification probe version is invalid")
    if valid_model(value.get("model")) != model:
        raise BindingError("remote qualification model differs from the native model")
    if value.get("model_identity_policy") != "provider-defined-name-not-content-addressed":
        raise BindingError("remote qualification model-identity policy is invalid")
    return {
        "schema": "sandcodex.remote-qualification.v1",
        "receipt_sha256": receipt_sha,
        "receipt_path": receipt_path,
        "probe_version": "responses-instructions-stream-tools-v5-sandideas-result-review",
        "model": model,
        "model_identity_policy": "provider-defined-name-not-content-addressed",
    }


def validate_openrouter_router(value: Any, model: str) -> dict[str, Any] | None:
    """Validate immutable relay identity without admitting credentials or content."""
    if value is None:
        return None
    expected = {
        "schema", "artifact_path", "artifact_sha256", "key_bank_path",
        "key_bank_sha256", "model_bank_path", "model_bank_sha256",
        "preferred_model", "preferred_key_id", "candidate_models", "upstream", "commit_policy",
        "tool_identity_policy", "maximum_route_attempts", "request_ceiling_seconds",
        "visible_replay", "credential_values_disclosed",
    }
    if not isinstance(value, dict) or set(value) != expected:
        raise BindingError("OpenRouter router identity fields are invalid")
    if value.get("schema") != "sandcodex.openrouter-router-binding.v1":
        raise BindingError("OpenRouter router identity schema is invalid")
    paths: dict[str, str] = {}
    for field in ("artifact_path", "key_bank_path", "model_bank_path"):
        candidate = value.get(field)
        if not isinstance(candidate, str) or not os.path.isabs(candidate):
            raise BindingError(f"OpenRouter router {field} is invalid")
        paths[field] = candidate
    artifact_sha = valid_hash(value.get("artifact_sha256"), "OpenRouter router artifact digest")
    key_bank_sha = valid_hash(value.get("key_bank_sha256"), "OpenRouter router key-bank digest")
    model_bank_sha = valid_hash(value.get("model_bank_sha256"), "OpenRouter router model-bank digest")
    preferred = valid_model(value.get("preferred_model"))
    preferred_key_id = value.get("preferred_key_id")
    if not isinstance(preferred_key_id, str) or re.fullmatch(r"[0-9a-f]{12}", preferred_key_id) is None:
        raise BindingError("OpenRouter router preferred key identity is invalid")
    candidates = value.get("candidate_models")
    if (
        not isinstance(candidates, list)
        or not 1 <= len(candidates) <= 256
        or len(set(candidates)) != len(candidates)
    ):
        raise BindingError("OpenRouter router candidate models are invalid")
    clean_candidates = [valid_model(candidate) for candidate in candidates]
    if preferred != model or preferred not in clean_candidates:
        raise BindingError("OpenRouter router preferred model differs from the native model")
    if (
        value.get("upstream") != "https://openrouter.ai/api/v1/responses"
        or value.get("commit_policy") != "buffer-complete-response-before-downstream-bytes"
        or value.get("tool_identity_policy") != "exact-request-scoped-reverse-map"
        or value.get("maximum_route_attempts") != 12
        or value.get("request_ceiling_seconds") != 240
        or value.get("visible_replay") is not False
        or value.get("credential_values_disclosed") is not False
    ):
        raise BindingError("OpenRouter router policy is invalid")
    return {
        "schema": "sandcodex.openrouter-router-binding.v1",
        **paths,
        "artifact_sha256": artifact_sha,
        "key_bank_sha256": key_bank_sha,
        "model_bank_sha256": model_bank_sha,
        "preferred_model": preferred,
        "preferred_key_id": preferred_key_id,
        "candidate_models": clean_candidates,
        "upstream": "https://openrouter.ai/api/v1/responses",
        "commit_policy": "buffer-complete-response-before-downstream-bytes",
        "tool_identity_policy": "exact-request-scoped-reverse-map",
        "maximum_route_attempts": 12,
        "request_ceiling_seconds": 240,
        "visible_replay": False,
        "credential_values_disclosed": False,
    }


def validate_gemini_identity(value: Any, provider: str, model: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != {
        "descriptor_sha256", "snapshot_sha256", "snapshot_path", "adapter_sha256",
        "adapter_path", "qualification", "route"
    }:
        raise BindingError("Gemini provider identity fields are invalid")
    descriptor = valid_hash(value.get("descriptor_sha256"), "Gemini descriptor digest")
    if provider != "scg_" + descriptor:
        raise BindingError("Gemini descriptor does not match native provider ID")
    snapshot_sha = valid_hash(value.get("snapshot_sha256"), "Gemini snapshot digest")
    snapshot = value.get("snapshot_path")
    adapter_sha = valid_hash(value.get("adapter_sha256"), "Gemini adapter digest")
    adapter = value.get("adapter_path")
    if not isinstance(snapshot, str) or not os.path.isabs(snapshot):
        raise BindingError("Gemini snapshot path is invalid")
    if not isinstance(adapter, str) or not os.path.isabs(adapter):
        raise BindingError("Gemini adapter path is invalid")
    qualification = value.get("qualification")
    if not isinstance(qualification, dict) or set(qualification) != {
        "schema", "receipt_sha256", "receipt_path"
    } or qualification.get("schema") != "sandcodex.gemini-adapter-qualification.v1":
        raise BindingError("Gemini qualification identity is invalid")
    receipt_sha = valid_hash(qualification.get("receipt_sha256"), "Gemini qualification digest")
    receipt = qualification.get("receipt_path")
    if not isinstance(receipt, str) or not os.path.isabs(receipt):
        raise BindingError("Gemini qualification path is invalid")
    route = value.get("route")
    if not isinstance(route, dict) or set(route) != {
        "routing_model", "auto", "free_only", "candidate_models", "state_schema",
        "model_switch_policy"
    }:
        raise BindingError("Gemini route policy is invalid")
    routing_model = valid_model(route.get("routing_model"))
    if routing_model != model or type(route.get("auto")) is not bool or route.get("free_only") is not True:
        raise BindingError("Gemini route identity differs from the native model")
    candidates = route.get("candidate_models")
    if (not isinstance(candidates, list) or not 1 <= len(candidates) <= 16
            or len(set(candidates)) != len(candidates)):
        raise BindingError("Gemini candidate model policy is invalid")
    candidates = [valid_model(candidate) for candidate in candidates]
    if route.get("auto") is False and candidates != [model]:
        raise BindingError("explicit Gemini route does not bind exactly one native model")
    if route.get("state_schema") != "sandcodex.gemini-reasoning-state.v1":
        raise BindingError("Gemini reasoning-state schema is invalid")
    if route.get("model_switch_policy") != "pre-visible-output-key-then-model-failover":
        raise BindingError("Gemini model-switch policy is invalid")
    return {
        "descriptor_sha256": descriptor,
        "snapshot_sha256": snapshot_sha,
        "snapshot_path": snapshot,
        "adapter_sha256": adapter_sha,
        "adapter_path": adapter,
        "qualification": {
            "schema": "sandcodex.gemini-adapter-qualification.v1",
            "receipt_sha256": receipt_sha,
            "receipt_path": receipt,
        },
        "route": {
            "routing_model": routing_model,
            "auto": route["auto"],
            "free_only": True,
            "candidate_models": candidates,
            "state_schema": "sandcodex.gemini-reasoning-state.v1",
            "model_switch_policy": "pre-visible-output-key-then-model-failover",
        },
    }


def validate_claim(value: dict[str, Any]) -> dict[str, Any]:
    if value.get("schema") != CLAIM_SCHEMA:
        raise BindingError("provider-session claim schema mismatch")
    project = canonical_project(value.get("project"))
    mode = value.get("mode")
    if mode not in ("local", "remote", "gemini"):
        raise BindingError("provider-session claim mode is invalid")
    provider = valid_provider(value.get("provider"))
    model = valid_model(value.get("model"))
    created_at = value.get("created_at")
    if not isinstance(created_at, str) or len(created_at) > 80:
        raise BindingError("provider-session claim timestamp is invalid")
    launch_id = value.get("launch_id")
    if not isinstance(launch_id, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,160}", launch_id):
        raise BindingError("provider-session launch ID is invalid")
    clean: dict[str, Any] = {
        "schema": CLAIM_SCHEMA,
        "project": project,
        "mode": mode,
        "provider": provider,
        "model": model,
        "created_at": created_at,
        "launch_id": launch_id,
    }
    if mode == "local":
        if provider != "ollama":
            raise BindingError("local claim provider is unsupported")
        context = valid_context(value.get("context_tokens"))
        local = value.get("local")
        if not isinstance(local, dict):
            raise BindingError("local provider-session claim is missing local{}")
        digest = valid_hash(local.get("model_digest_sha256"), "local model digest")
        qualification = valid_hash(local.get("qualification_sha256"), "local qualification digest")
        startup = valid_hash(local.get("startup_receipt_sha256"), "local startup receipt digest")
        retry = local.get("cpu_retry_used")
        if type(retry) is not bool:
            raise BindingError("local CPU retry flag is invalid")
        if local.get("resume_fallback_policy") != "exact-bound-backend-no-fallback":
            raise BindingError("local resume fallback policy is invalid")
        model_pin = validate_model_pin(local.get("model_pin"), model, digest)
        clean["context_tokens"] = context
        clean["local"] = {
            "model_digest_sha256": digest,
            "qualification_sha256": qualification,
            "startup_receipt_sha256": startup,
            "cpu_retry_used": retry,
            "resume_fallback_policy": "exact-bound-backend-no-fallback",
            "runtime": validate_runtime(local.get("runtime")),
            "model_pin": model_pin,
        }
    elif mode == "remote":
        if not provider.startswith("scr_") or not HASH.fullmatch(provider[4:]):
            raise BindingError("remote native provider must be a content-addressed scr_ descriptor")
        remote = value.get("remote")
        if not isinstance(remote, dict):
            raise BindingError("remote provider-session claim is missing remote{}")
        descriptor = valid_hash(remote.get("descriptor_sha256"), "remote descriptor digest")
        if provider != "scr_" + descriptor:
            raise BindingError("remote descriptor digest does not match native provider ID")
        snapshot_sha = valid_hash(remote.get("snapshot_sha256"), "remote snapshot file digest")
        snapshot = remote.get("snapshot_path")
        if not isinstance(snapshot, str) or not os.path.isabs(snapshot):
            raise BindingError("remote snapshot path is invalid")
        qualification = validate_remote_qualification(remote.get("qualification"), model)
        router = validate_openrouter_router(remote.get("router"), model)
        clean["context_tokens"] = None
        clean["remote"] = {
            "descriptor_sha256": descriptor,
            "snapshot_sha256": snapshot_sha,
            "snapshot_path": snapshot,
            "qualification": qualification,
            "router": router,
        }
    else:
        if not provider.startswith("scg_") or not HASH.fullmatch(provider[4:]):
            raise BindingError("Gemini native provider must be a content-addressed scg_ descriptor")
        clean["context_tokens"] = None
        clean["gemini"] = validate_gemini_identity(value.get("gemini"), provider, model)
    return clean


def expected_binding(session: dict[str, Any], claim: dict[str, Any]) -> dict[str, Any]:
    if session["project"] != claim["project"]:
        raise BindingError("new native conversation belongs to another project")
    if session["provider"] != claim["provider"]:
        raise BindingError("new native conversation provider differs from the launch claim")
    if session["model"] != claim["model"]:
        raise BindingError("new native conversation model differs from the launch claim")
    if claim["mode"] == "local" and session["context_tokens"] != claim["context_tokens"]:
        raise BindingError("new local conversation context differs from the launch claim")
    provider_details = claim[claim["mode"]]
    return {
        "schema": BINDING_SCHEMA,
        "thread_id": session["id"],
        "project": claim["project"],
        "mode": claim["mode"],
        "native": {
            "provider": session["provider"],
            "model": session["model"],
            "context_tokens": session["context_tokens"],
            "established_activity": session["last_activity"],
        },
        "provider_identity": provider_details,
        "claim": {
            "created_at": claim["created_at"],
            "launch_id": claim["launch_id"],
        },
        "policy": {
            "resume_requires_binding": True,
            "provider_substitution": False,
            "model_substitution": False,
            "context_reduction": False,
            "cloud_fallback": False,
        },
    }


def binding_core(value: dict[str, Any]) -> dict[str, Any]:
    copy = json.loads(json.dumps(value))
    native = copy.get("native")
    if isinstance(native, dict):
        native.pop("established_activity", None)
    return copy


def load_existing_binding(directory: Path, sid: str) -> tuple[dict[str, Any], bytes] | None:
    fd_dir = private_dir_fd(directory)
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(f"{sid}.json", flags, dir_fd=fd_dir)
        except FileNotFoundError:
            return None
        with os.fdopen(fd, "rb") as stream:
            st = os.fstat(stream.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_mode & 0o077:
                raise BindingError("existing session binding has unsafe metadata")
            if st.st_size > MAX_JSON_BYTES:
                raise BindingError("existing session binding exceeds bounded size")
            raw = stream.read(MAX_JSON_BYTES + 1)
        value = json.loads(raw)
        if not isinstance(value, dict):
            raise BindingError("existing session binding root is not an object")
        return value, raw
    finally:
        os.close(fd_dir)


def load_retirement(directory: Path, sid: str) -> dict[str, Any] | None:
    fd_dir = private_dir_fd(directory)
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
        try:
            fd = os.open(f"{sid}.json", flags, dir_fd=fd_dir)
        except FileNotFoundError:
            return None
        with os.fdopen(fd, "rb") as stream:
            st = os.fstat(stream.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or st.st_mode & 0o077:
                raise BindingError("session retirement authorization has unsafe metadata")
            if st.st_size > MAX_JSON_BYTES:
                raise BindingError("session retirement authorization exceeds bounded size")
            raw = stream.read(MAX_JSON_BYTES + 1)
        value = json.loads(raw)
        if not isinstance(value, dict) or value.get("schema") != RETIREMENT_SCHEMA:
            raise BindingError("session retirement authorization schema mismatch")
        if valid_uuid(value.get("thread_id")) != sid:
            raise BindingError("session retirement authorization thread ID mismatch")
        if value.get("policy", {}).get("thread_id_reuse_forbidden") is not True:
            raise BindingError("session retirement authorization reuse policy is invalid")
        return value
    finally:
        os.close(fd_dir)


def assert_not_retired(directory: Path | None, sid: str) -> None:
    if directory is not None and load_retirement(directory, sid) is not None:
        raise BindingError("thread ID has an immutable retirement authorization; resume and rebinding are refused")


def commit(baseline: dict[str, Any], current: dict[str, Any], claim: dict[str, Any], directory: Path,
           retirements: Path | None = None) -> dict[str, Any]:
    baseline = validate_snapshot(baseline, claim["project"])
    current = validate_snapshot(current, claim["project"])
    prior = {row["id"] for row in baseline["sessions"]}
    new_rows = [row for row in current["sessions"] if row["id"] not in prior]
    if not new_rows:
        return {"schema": RESULT_SCHEMA, "result": "no_established_session", "project": claim["project"]}
    if len(new_rows) != 1:
        raise BindingError("more than one new established primary conversation appeared; refusing to guess")
    expected = expected_binding(new_rows[0], claim)
    sid = expected["thread_id"]
    assert_not_retired(retirements, sid)
    existing = load_existing_binding(directory, sid)
    path = directory / f"{sid}.json"
    if existing is not None:
        value, raw = existing
        if binding_core(value) != binding_core(expected):
            raise BindingError("existing session binding conflicts with this launch claim")
        return {"schema": RESULT_SCHEMA, "result": "already_bound", "thread_id": sid,
                "binding_path": str(path), "binding_sha256": digest_bytes(raw)}
    atomic_json(path, expected, exclusive=True)
    raw = path.read_bytes()
    return {"schema": RESULT_SCHEMA, "result": "bound", "thread_id": sid,
            "binding_path": str(path), "binding_sha256": digest_bytes(raw)}


def validate_binding(value: dict[str, Any], selection: dict[str, Any]) -> dict[str, Any]:
    if value.get("schema") != BINDING_SCHEMA:
        raise BindingError("session binding schema mismatch")
    sid = valid_uuid(value.get("thread_id"))
    if sid != valid_uuid(selection.get("id")):
        raise BindingError("session binding thread ID mismatch")
    project = canonical_project(value.get("project"))
    if project != canonical_project(selection.get("project")):
        raise BindingError("session binding project mismatch")
    mode = value.get("mode")
    if mode not in ("local", "remote", "gemini"):
        raise BindingError("session binding mode is invalid")
    native = value.get("native")
    if not isinstance(native, dict):
        raise BindingError("session binding native identity is missing")
    provider = valid_provider(native.get("provider"))
    model = valid_model(native.get("model"))
    if provider != valid_provider(selection.get("provider")):
        raise BindingError("saved session provider no longer matches its binding")
    if model != valid_model(selection.get("model")):
        raise BindingError("saved session model no longer matches its binding")
    context = native.get("context_tokens")
    if context is not None:
        context = valid_context(context)
    policy = value.get("policy")
    expected_policy = {"resume_requires_binding": True, "provider_substitution": False,
                       "model_substitution": False, "context_reduction": False, "cloud_fallback": False}
    if policy != expected_policy:
        raise BindingError("session binding policy is invalid")
    identity = value.get("provider_identity")
    if mode == "local":
        if not isinstance(identity, dict):
            raise BindingError("local provider identity is missing")
        selected_context = selection.get("context_tokens")
        if selected_context is not None and valid_context(selected_context) != context:
            raise BindingError("saved local session context no longer matches its binding")
        model_digest = valid_hash(identity.get("model_digest_sha256"), "local model digest")
        model_pin = validate_model_pin(identity.get("model_pin"), model, model_digest)
        clean_identity = {
            "model_digest_sha256": model_digest,
            "qualification_sha256": valid_hash(identity.get("qualification_sha256"), "local qualification digest"),
            "startup_receipt_sha256": valid_hash(identity.get("startup_receipt_sha256"), "local startup receipt digest"),
            "cpu_retry_used": identity.get("cpu_retry_used"),
            "resume_fallback_policy": identity.get("resume_fallback_policy"),
            "runtime": validate_runtime(identity.get("runtime")),
            "model_pin": model_pin,
        }
        if (type(clean_identity["cpu_retry_used"]) is not bool or
                clean_identity["resume_fallback_policy"] != "exact-bound-backend-no-fallback"):
            raise BindingError("local binding fallback policy is invalid")
        return {"schema": RESULT_SCHEMA, "result": "verified", "thread_id": sid, "project": project,
                "mode": mode, "provider": provider, "model": model, "context_tokens": context,
                "local": clean_identity}
    if mode == "gemini":
        if context is not None and selection.get("context_tokens") is not None and selection.get("context_tokens") != context:
            raise BindingError("saved Gemini session context no longer matches its binding")
        clean_identity = validate_gemini_identity(identity, provider, model)
        return {"schema": RESULT_SCHEMA, "result": "verified", "thread_id": sid,
                "project": project, "mode": mode, "provider": provider, "model": model,
                "context_tokens": context, "gemini": clean_identity}
    if context is not None and selection.get("context_tokens") is not None and selection.get("context_tokens") != context:
        # Remote model context may evolve across provider-side model versions, but a native
        # transcript mutation is still evidence requiring review rather than silent acceptance.
        raise BindingError("saved remote session context no longer matches its binding")
    if not isinstance(identity, dict):
        raise BindingError("remote provider identity is missing")
    descriptor = valid_hash(identity.get("descriptor_sha256"), "remote descriptor digest")
    if provider != "scr_" + descriptor:
        raise BindingError("remote descriptor does not match native provider ID")
    snapshot_sha = valid_hash(identity.get("snapshot_sha256"), "remote snapshot digest")
    snapshot = identity.get("snapshot_path")
    if not isinstance(snapshot, str) or not os.path.isabs(snapshot):
        raise BindingError("remote snapshot path is invalid")
    qualification = validate_remote_qualification(identity.get("qualification"), model)
    router = validate_openrouter_router(identity.get("router"), model)
    return {"schema": RESULT_SCHEMA, "result": "verified", "thread_id": sid, "project": project,
            "mode": mode, "provider": provider, "model": model, "context_tokens": context,
            "remote": {"descriptor_sha256": descriptor, "snapshot_sha256": snapshot_sha,
                       "snapshot_path": snapshot, "qualification": qualification,
                       "router": router}}


def verify_live_identity(result: dict[str, Any]) -> None:
    if result["mode"] == "remote":
        path = Path(result["remote"]["snapshot_path"])
        if digest_file(path) != result["remote"]["snapshot_sha256"]:
            raise BindingError("remote provider snapshot bytes changed")
        qualification = result["remote"]["qualification"]
        receipt = Path(qualification["receipt_path"])
        if digest_file(receipt) != qualification["receipt_sha256"]:
            raise BindingError("remote qualification receipt bytes changed")
        router = result["remote"].get("router")
        if router is not None:
            for path_field, digest_field in (
                ("artifact_path", "artifact_sha256"),
                ("key_bank_path", "key_bank_sha256"),
                ("model_bank_path", "model_bank_sha256"),
            ):
                if digest_file(Path(router[path_field])) != router[digest_field]:
                    raise BindingError(f"OpenRouter router {path_field} bytes changed")
        return
    if result["mode"] == "gemini":
        identity = result["gemini"]
        if digest_file(Path(identity["snapshot_path"])) != identity["snapshot_sha256"]:
            raise BindingError("Gemini provider snapshot bytes changed")
        if digest_file(Path(identity["adapter_path"])) != identity["adapter_sha256"]:
            raise BindingError("Gemini adapter bytes changed")
        qualification = identity["qualification"]
        if digest_file(Path(qualification["receipt_path"])) != qualification["receipt_sha256"]:
            raise BindingError("Gemini qualification receipt bytes changed")
        return
    runtime = result["local"]["runtime"]
    executable = Path(runtime["executable"])
    if digest_file(executable) != runtime["executable_sha256"]:
        raise BindingError("bound local runtime executable is missing or changed")
    store_output = runtime["store_output"]
    if store_output is None:
        return
    root = Path(runtime["gc_root"])
    try:
        st = root.lstat()
    except FileNotFoundError as exc:
        raise BindingError("bound local runtime GC root is missing") from exc
    if not stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid():
        raise BindingError("bound local runtime GC root is unsafe")
    if str(root.resolve(strict=True)) != store_output:
        raise BindingError("bound local runtime GC root points elsewhere")
    if not Path(store_output).is_dir():
        raise BindingError("bound local runtime store output is missing")


def load_selector(path: Path) -> ModuleType:
    spec = importlib.util.spec_from_file_location("sandcodex_session_selector", path)
    if spec is None or spec.loader is None:
        raise BindingError("could not load the pinned session selector")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def current_snapshot(selector: ModuleType, sessions: Path, project: Path) -> dict[str, Any]:
    value = selector.snapshot(sessions, project)
    return validate_snapshot(value)


def parent_start(pid: int) -> str | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
        tail = raw.rsplit(") ", 1)[1].split()
        return tail[19]
    except (OSError, IndexError):
        return None


def stop_handler(_signum: int, _frame: object) -> None:
    global STOP
    STOP = True


def write_result(path: Path | None, result: dict[str, Any]) -> None:
    if path is not None:
        atomic_json(path, result, exclusive=True)


def command_snapshot(args: argparse.Namespace) -> int:
    selector = load_selector(args.selector)
    value = current_snapshot(selector, args.sessions, args.project)
    atomic_json(args.output, value, exclusive=True)
    return 0


def command_commit(args: argparse.Namespace) -> int:
    selector = load_selector(args.selector)
    baseline = read_json(args.baseline)
    claim = validate_claim(read_json(args.claim))
    result = commit(baseline, current_snapshot(selector, args.sessions, args.project), claim, args.bindings, args.retirements)
    print(json.dumps(result, sort_keys=True))
    return 0


def command_verify(args: argparse.Namespace) -> int:
    selection = read_json(args.selection)
    sid = valid_uuid(selection.get("id"))
    assert_not_retired(args.retirements, sid)
    existing = load_existing_binding(args.bindings, sid)
    if existing is None:
        raise FileNotFoundError("alternate-provider conversation has no immutable session binding; migration/review is required")
    value, raw = existing
    result = validate_binding(value, selection)
    verify_live_identity(result)
    result["binding_path"] = str(args.bindings / f"{sid}.json")
    result["binding_sha256"] = digest_bytes(raw)
    print(json.dumps(result, sort_keys=True))
    return 0


def command_watch(args: argparse.Namespace) -> int:
    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)
    signal.signal(signal.SIGHUP, stop_handler)
    selector = load_selector(args.selector)
    baseline = read_json(args.baseline)
    claim = validate_claim(read_json(args.claim))
    if parent_start(args.parent_pid) != args.parent_start:
        raise BindingError("binding watcher parent identity is not live")
    while not STOP and parent_start(args.parent_pid) == args.parent_start:
        result = commit(baseline, current_snapshot(selector, args.sessions, args.project), claim, args.bindings, args.retirements)
        if result["result"] != "no_established_session":
            write_result(args.result, result)
            return 0
        time.sleep(args.interval)
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)
    snap = sub.add_parser("snapshot")
    snap.add_argument("--selector", required=True, type=Path)
    snap.add_argument("--sessions", required=True, type=Path)
    snap.add_argument("--project", required=True, type=Path)
    snap.add_argument("--output", required=True, type=Path)
    snap.set_defaults(function=command_snapshot)
    commit_p = sub.add_parser("commit")
    commit_p.add_argument("--selector", required=True, type=Path)
    commit_p.add_argument("--sessions", required=True, type=Path)
    commit_p.add_argument("--project", required=True, type=Path)
    commit_p.add_argument("--baseline", required=True, type=Path)
    commit_p.add_argument("--claim", required=True, type=Path)
    commit_p.add_argument("--bindings", required=True, type=Path)
    commit_p.add_argument("--retirements", required=True, type=Path)
    commit_p.set_defaults(function=command_commit)
    verify = sub.add_parser("verify")
    verify.add_argument("--selection", required=True, type=Path)
    verify.add_argument("--bindings", required=True, type=Path)
    verify.add_argument("--retirements", required=True, type=Path)
    verify.set_defaults(function=command_verify)
    watch = sub.add_parser("watch")
    watch.add_argument("--selector", required=True, type=Path)
    watch.add_argument("--sessions", required=True, type=Path)
    watch.add_argument("--project", required=True, type=Path)
    watch.add_argument("--baseline", required=True, type=Path)
    watch.add_argument("--claim", required=True, type=Path)
    watch.add_argument("--bindings", required=True, type=Path)
    watch.add_argument("--retirements", required=True, type=Path)
    watch.add_argument("--result", required=True, type=Path)
    watch.add_argument("--parent-pid", required=True, type=int)
    watch.add_argument("--parent-start", required=True)
    watch.add_argument("--interval", type=float, default=0.5)
    watch.set_defaults(function=command_watch)
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if getattr(args, "interval", 0.5) < 0.05 or getattr(args, "interval", 0.5) > 10:
            raise BindingError("watch interval is outside 0.05-10 seconds")
        return args.function(args)
    except FileNotFoundError as exc:
        return fail(str(exc), 66)
    except (BindingError, OSError, ValueError, json.JSONDecodeError) as exc:
        return fail(str(exc), 78)


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_SESSION_BINDING_PY
}

sc_emit_local_model_pin() {
  cat <<'SANDCODEX_LOCAL_MODEL_PIN_PY'
#!/usr/bin/env python3
"""Create or verify a content-addressed Ollama runtime profile for one local model.

This helper never pulls or deletes a model.  It first retains an already-qualified
source manifest under a digest-derived alias.  With an explicit runner-thread count,
it asks the pinned provider to derive a second deterministic model profile, verifies
that profile's parent, parameter, and manifest digest, and records both identities.
Without runtime parameters it emits the original v1 alias record.  Every alias is
retained; model-store pruning is intentionally outside this tool's authority.
"""
from __future__ import annotations

import argparse
import datetime as dt
import http.client
import json
import math
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import urllib.parse
from typing import Any, Sequence

SCHEMA_V1 = "sandcodex.local-model-pin.v1"
POLICY_V1 = "ollama-manifest-alias-v1"
SCHEMA_V2 = "sandcodex.local-model-pin.v2"
POLICY_V2 = "ollama-derived-profile-v1"
MAX_BODY = 1024 * 1024
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}\Z")
DIGEST = re.compile(r"(?:sha256:)?([0-9a-fA-F]{64})\Z")
VERSION = re.compile(r"[A-Za-z0-9.+_-]{1,80}\Z")


class PinError(RuntimeError):
    pass


def unique_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise PinError("provider JSON contains a duplicate field")
        result[key] = value
    return result


def decode(raw: bytes) -> dict[str, Any]:
    try:
        value = json.loads(
            raw,
            object_pairs_hook=unique_object,
            parse_constant=lambda _: (_ for _ in ()).throw(ValueError()),
        )
    except (ValueError, UnicodeError) as exc:
        raise PinError("provider did not return valid finite JSON") from exc
    if not isinstance(value, dict):
        raise PinError("provider JSON must be an object")
    return value


def canonical_name(value: Any) -> str:
    if not isinstance(value, str) or MODEL.fullmatch(value) is None:
        raise PinError("model name is not a supported provider identifier")
    tail = value.rsplit("/", 1)[-1]
    return value if ":" in tail else value + ":latest"


def clean_digest(value: Any) -> str:
    match = DIGEST.fullmatch(value) if isinstance(value, str) else None
    if match is None:
        raise PinError("model digest is missing or malformed")
    return match.group(1).lower()


def alias_for(digest: str) -> str:
    clean = clean_digest(digest)
    # Each Ollama namespace/model/tag component stays within its documented
    # 80-character bound: "sha256-" + 64 hex = 71 characters.
    return f"sandcodex/sha256-{clean}:pinned"


def profile_alias_for(digest: str, threads: int) -> str:
    clean = clean_digest(digest)
    if type(threads) is not int or not 1 <= threads <= 1024:
        raise PinError("runtime thread count must be an integer from 1 through 1024")
    return f"sandcodex/sha256-{clean}:threads-{threads}"


def parameter_value(parameters: Any, key: str) -> str:
    if not isinstance(parameters, str):
        raise PinError("derived profile parameters are missing")
    values: list[str] = []
    for line in parameters.splitlines():
        fields = line.split()
        if fields and fields[0] == key:
            if len(fields) != 2:
                raise PinError(f"derived profile {key} parameter is malformed")
            values.append(fields[1])
    if len(values) != 1:
        raise PinError(f"derived profile must expose exactly one {key} parameter")
    return values[0]


class Client:
    def __init__(self, endpoint: str, timeout: float) -> None:
        if re.fullmatch(r"http://127\.0\.0\.1:[1-9][0-9]{0,4}", endpoint) is None:
            raise PinError("managed endpoint must be numeric IPv4 loopback HTTP")
        parsed = urllib.parse.urlsplit(endpoint)
        if parsed.port is None or not 1 <= parsed.port <= 65535:
            raise PinError("managed endpoint port is invalid")
        if not math.isfinite(timeout) or not 0 < timeout <= 600:
            raise PinError("request timeout must be finite and in (0, 600]")
        self.port = parsed.port
        self.timeout = timeout

    def request(
        self,
        method: str,
        path: str,
        body: dict[str, Any] | None = None,
        *,
        allow_empty_success: bool = False,
    ) -> dict[str, Any]:
        connection = http.client.HTTPConnection("127.0.0.1", self.port, timeout=self.timeout)
        try:
            payload = None if body is None else json.dumps(body, allow_nan=False).encode()
            connection.request(method, path, body=payload, headers={"Content-Type": "application/json"})
            response = connection.getresponse()
            raw = response.read(MAX_BODY + 1)
            if len(raw) > MAX_BODY:
                raise PinError("provider response exceeds the model-pin size limit")
            if response.status != 200:
                raise PinError(f"provider model-pin request failed with HTTP {response.status}")
            if not raw:
                if allow_empty_success:
                    return {}
                raise PinError("provider returned an empty model-pin response")
            value = decode(raw)
            if "error" in value:
                raise PinError("provider returned an error inside a successful model-pin response")
            return value
        except (OSError, http.client.HTTPException) as exc:
            raise PinError("provider model-pin connection failed or timed out") from exc
        finally:
            connection.close()


def inventory_rows(client: Client) -> list[dict[str, Any]]:
    rows = client.request("GET", "/api/tags").get("models")
    if not isinstance(rows, list):
        raise PinError("provider inventory lacks models[]")
    if not all(isinstance(row, dict) for row in rows):
        raise PinError("provider inventory contains a non-object model")
    return rows


def select(rows: list[dict[str, Any]], model: str, *, required: bool) -> dict[str, Any] | None:
    target = canonical_name(model)
    selected: list[dict[str, Any]] = []
    for row in rows:
        names = [canonical_name(row[key]) for key in ("name", "model") if key in row]
        if target in names:
            if any(name != target for name in names):
                raise PinError("selected inventory entry has conflicting names")
            selected.append(row)
    if len(selected) > 1 or (required and len(selected) != 1):
        raise PinError("model must have exactly one inventory entry")
    return selected[0] if selected else None


def verify_row(row: dict[str, Any], expected: str, label: str) -> None:
    if clean_digest(row.get("digest")) != expected:
        raise PinError(f"{label} model digest changed")
    size = row.get("size")
    if type(size) is not int or size <= 0:
        raise PinError(f"{label} model size is invalid")


def provider_version(client: Client) -> str:
    version = client.request("GET", "/api/version").get("version")
    if not isinstance(version, str) or VERSION.fullmatch(version) is None:
        raise PinError("provider version is missing or malformed")
    return version


def create_pin(
    client: Client,
    requested: str,
    source: str,
    expected_digest: str,
    expected_version: str,
    model_store: Path,
    runtime_threads: int | None = None,
    expected_runtime_digest: str | None = None,
) -> dict[str, Any]:
    requested_canonical = canonical_name(requested)
    source_canonical = canonical_name(source)
    if requested_canonical != source_canonical:
        raise PinError("resolved source model differs from the requested model")
    expected = clean_digest(expected_digest)
    if not isinstance(expected_version, str) or VERSION.fullmatch(expected_version) is None:
        raise PinError("expected provider version is invalid")
    base_alias = alias_for(expected)

    before = inventory_rows(client)
    source_row = select(before, source_canonical, required=True)
    assert source_row is not None
    verify_row(source_row, expected, "source")
    alias_row = select(before, base_alias, required=False)
    base_preexisting = alias_row is not None
    if alias_row is not None:
        verify_row(alias_row, expected, "existing source alias")
    else:
        # Pinned Ollama v0.34.0 succeeds with HTTP 200 and no response body.
        client.request(
            "POST",
            "/api/copy",
            {"source": source_canonical, "destination": base_alias},
            allow_empty_success=True,
        )

    after = inventory_rows(client)
    source_after = select(after, source_canonical, required=True)
    alias_after = select(after, base_alias, required=True)
    assert source_after is not None and alias_after is not None
    verify_row(source_after, expected, "source after copy")
    verify_row(alias_after, expected, "source alias after copy")
    observed_version = provider_version(client)
    if observed_version != expected_version:
        raise PinError("provider version changed while creating the model alias")

    if not model_store.is_absolute() or str(model_store) == "/":
        raise PinError("model store path must be an absolute non-root path")
    common = {
        "requested_model": requested,
        "source_model": source_canonical,
        "provider_version": observed_version,
        "model_store": str(model_store),
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "retention": {
            "manifest_alias_retained": True,
            "deleted_by_conversation_retirement": False,
            "model_store_gc_run": False,
        },
        "policy_limits": {
            "same_user_cooperation_required": True,
            "hostile_manual_alias_mutation_prevented": False,
            "full_codex_turn_tested": False,
        },
    }
    if runtime_threads is None:
        if expected_runtime_digest is not None:
            raise PinError("an expected runtime digest requires runtime parameters")
        return {
            "schema": SCHEMA_V1,
            "policy": POLICY_V1,
            **common,
            "runtime_model": base_alias,
            "digest_sha256": expected,
            "alias_preexisting": base_preexisting,
        }

    runtime_alias = profile_alias_for(expected, runtime_threads)
    runtime_before = select(after, runtime_alias, required=False)
    runtime_preexisting = runtime_before is not None
    if runtime_before is None:
        created = client.request(
            "POST",
            "/api/create",
            {"model": runtime_alias, "from": base_alias,
             "parameters": {"num_thread": runtime_threads}, "stream": False},
        )
        if created.get("status") != "success":
            raise PinError("provider did not confirm derived-profile creation")
    final_rows = inventory_rows(client)
    source_final = select(final_rows, source_canonical, required=True)
    base_final = select(final_rows, base_alias, required=True)
    runtime_final = select(final_rows, runtime_alias, required=True)
    assert source_final is not None and base_final is not None and runtime_final is not None
    verify_row(source_final, expected, "source after profile creation")
    verify_row(base_final, expected, "source alias after profile creation")
    runtime_digest = clean_digest(runtime_final.get("digest"))
    runtime_size = runtime_final.get("size")
    if type(runtime_size) is not int or runtime_size <= 0:
        raise PinError("derived profile model size is invalid")
    if expected_runtime_digest is not None and runtime_digest != clean_digest(expected_runtime_digest):
        raise PinError("derived profile manifest digest differs from the reviewed profile")
    shown = client.request("POST", "/api/show", {"model": runtime_alias})
    details = shown.get("details")
    if not isinstance(details, dict) or canonical_name(details.get("parent_model")) != base_alias:
        raise PinError("derived profile does not name the content-addressed source alias as parent")
    if parameter_value(shown.get("parameters"), "num_thread") != str(runtime_threads):
        raise PinError("derived profile runner-thread parameter differs")
    if provider_version(client) != observed_version:
        raise PinError("provider version changed while verifying the derived profile")
    return {
        "schema": SCHEMA_V2,
        "policy": POLICY_V2,
        **common,
        "source_digest_sha256": expected,
        "base_model": base_alias,
        "base_alias_preexisting": base_preexisting,
        "runtime_model": runtime_alias,
        "runtime_digest_sha256": runtime_digest,
        "runtime_parameters": {"num_thread": runtime_threads},
        "alias_preexisting": runtime_preexisting,
    }


def atomic_report(path: Path, value: dict[str, Any]) -> None:
    parent = path.parent
    meta = parent.lstat()
    if (not stat.S_ISDIR(meta.st_mode) or meta.st_uid != os.getuid() or stat.S_IMODE(meta.st_mode) & 0o077):
        raise PinError("model-pin report directory must be private and user-owned")
    if path.exists() or path.is_symlink():
        raise PinError("model-pin report already exists")
    descriptor, temporary = tempfile.mkstemp(prefix=".model-pin-", dir=parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            os.fchmod(handle.fileno(), 0o600)
            json.dump(value, handle, sort_keys=True, indent=2, allow_nan=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.link(temporary, path)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        os.unlink(temporary)


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(description=__doc__)
    value.add_argument("--endpoint", required=True)
    value.add_argument("--requested-model", required=True)
    value.add_argument("--source-model", required=True)
    value.add_argument("--expected-digest", required=True)
    value.add_argument("--provider-version", required=True)
    value.add_argument("--model-store", type=Path, required=True)
    value.add_argument("--runtime-threads", type=int)
    value.add_argument("--expected-runtime-digest")
    value.add_argument("--timeout", type=float, default=120)
    value.add_argument("--output", type=Path, required=True)
    return value


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        result = create_pin(
            Client(args.endpoint, args.timeout),
            args.requested_model,
            args.source_model,
            args.expected_digest,
            args.provider_version,
            args.model_store,
            args.runtime_threads,
            args.expected_runtime_digest,
        )
        atomic_report(args.output, result)
    except PinError as exc:
        print(f"sandcodex local model pin: {exc}", file=sys.stderr)
        return 78
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_LOCAL_MODEL_PIN_PY
}

sc_emit_local_retire() {
  cat <<'SANDCODEX_LOCAL_RETIRE_PY'
#!/usr/bin/env python3
"""Safely retire one project-bound managed-local conversation runtime root.

This private helper never deletes Codex history and never runs Nix garbage
collection. It requires the thread to be absent from both active and archived
native Codex rollout trees and records an immutable retirement authorization.
A project runtime GC-root is released only when no other non-retired binding or
unbound established local thread in the project may still require that root.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
from types import ModuleType
from typing import Any
import uuid

INTENT_SCHEMA = "sandcodex.local-session-retirement.v1"
RECEIPT_SCHEMA = "sandcodex.local-session-retirement-receipt.v1"
RESULT_SCHEMA = "sandcodex.local-session-retirement-result.v1"
MAX_JSON_BYTES = 4 * 1024 * 1024
MAX_TREE_ENTRIES = 250_000
TIMESTAMP = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\Z")


class RetirementError(Exception):
    pass


def fail(message: str, code: int = 78) -> int:
    print(f"sandcodex local retire: {message}", file=sys.stderr)
    return code


def digest_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def valid_uuid(value: Any) -> str:
    try:
        return str(uuid.UUID(value))
    except (ValueError, TypeError, AttributeError) as exc:
        raise RetirementError("thread ID is not a UUID") from exc


def canonical_existing_dir(path: Path, label: str) -> Path:
    try:
        resolved = path.resolve(strict=True)
    except FileNotFoundError as exc:
        raise RetirementError(f"{label} does not exist: {path}") from exc
    if not resolved.is_dir():
        raise RetirementError(f"{label} is not a directory: {resolved}")
    return resolved


def private_directory(path: Path, label: str, *, optional: bool = False) -> Path | None:
    try:
        st = path.lstat()
    except FileNotFoundError:
        if optional:
            return None
        raise RetirementError(f"{label} is missing: {path}")
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise RetirementError(f"{label} must be a private user-owned directory: {path}")
    return path


def read_private_json(path: Path) -> tuple[dict[str, Any], bytes]:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as stream:
        st = os.fstat(stream.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
            raise RetirementError(f"unsafe JSON file metadata: {path}")
        if st.st_mode & 0o077:
            raise RetirementError(f"JSON file is not private: {path}")
        if st.st_size > MAX_JSON_BYTES:
            raise RetirementError(f"JSON file exceeds bounded size: {path}")
        raw = stream.read(MAX_JSON_BYTES + 1)
    try:
        value = json.loads(raw)
    except (ValueError, UnicodeError) as exc:
        raise RetirementError(f"invalid JSON: {path}") from exc
    if not isinstance(value, dict):
        raise RetirementError(f"JSON root must be an object: {path}")
    return value, raw


def write_private_json_exclusive(path: Path, value: dict[str, Any]) -> bytes:
    parent = private_directory(path.parent, "retirement state directory")
    assert parent is not None
    data = (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    fd_dir = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
    try:
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(path.name, flags, 0o600, dir_fd=fd_dir)
        try:
            with os.fdopen(fd, "wb", closefd=False) as stream:
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
        finally:
            os.close(fd)
        os.fsync(fd_dir)
    finally:
        os.close(fd_dir)
    return data


def load_module(path: Path, name: str) -> ModuleType:
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RetirementError(f"could not load pinned helper: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def safe_tree_scan(root: Path, sid: str, label: str) -> dict[str, Any]:
    """Prove that no rollout filename for sid exists in one native tree.

    The pinned Codex recorder encodes the thread UUID in every rollout filename,
    including immutable revert rollouts. We reject linked, foreign, writable,
    cross-device, or unbounded trees rather than interpreting absence loosely.
    """
    try:
        root_st = root.lstat()
    except FileNotFoundError:
        return {"root": str(root), "exists": False, "entries_scanned": 0, "matches": []}
    if not stat.S_ISDIR(root_st.st_mode) or root_st.st_uid != os.getuid() or root_st.st_mode & 0o022:
        raise RetirementError(f"{label} root is linked, foreign, or writable by another principal")
    root_dev = root_st.st_dev
    entries = 0
    matches: list[str] = []
    for directory, names, files in os.walk(root, topdown=True, followlinks=False):
        names.sort()
        files.sort()
        directory_path = Path(directory)
        dst = directory_path.lstat()
        if not stat.S_ISDIR(dst.st_mode) or dst.st_uid != os.getuid() or dst.st_dev != root_dev or dst.st_mode & 0o022:
            raise RetirementError(f"{label} contains an unsafe directory: {directory_path}")
        entries += 1
        if entries > MAX_TREE_ENTRIES:
            raise RetirementError(f"{label} exceeds the bounded scan limit")
        for name in names:
            path = directory_path / name
            st = path.lstat()
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_dev != root_dev or st.st_mode & 0o022:
                raise RetirementError(f"{label} contains a linked, foreign, or unsafe directory: {path}")
        for name in files:
            path = directory_path / name
            st = path.lstat()
            if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1
                    or st.st_dev != root_dev or st.st_mode & 0o022):
                raise RetirementError(f"{label} contains a linked, foreign, or unsafe file: {path}")
            entries += 1
            if entries > MAX_TREE_ENTRIES:
                raise RetirementError(f"{label} exceeds the bounded scan limit")
            if sid in name.lower():
                matches.append(str(path))
    if matches:
        raise RetirementError(
            f"thread {sid} is still present in {label}; archive is not deletion and retirement is refused"
        )
    return {
        "root": str(root),
        "exists": True,
        "entries_scanned": entries,
        "matches": [],
        "root_device": root_dev,
        "root_inode": root_st.st_ino,
        "root_mtime_ns": root_st.st_mtime_ns,
        "root_ctime_ns": root_st.st_ctime_ns,
    }


def validated_binding(binding_module: ModuleType, bindings: Path, sid: str, project: str) -> tuple[dict[str, Any], str, Path]:
    try:
        existing = binding_module.load_existing_binding(bindings, sid)
    except Exception as exc:
        raise RetirementError(f"could not read session binding {sid}: {exc}") from exc
    if existing is None:
        raise RetirementError(f"managed-local conversation {sid} has no immutable provider binding")
    value, raw = existing
    native = value.get("native")
    if not isinstance(native, dict):
        raise RetirementError(f"session binding {sid} native identity is missing")
    selection = {
        "id": sid,
        "project": project,
        "provider": native.get("provider"),
        "model": native.get("model"),
        "context_tokens": native.get("context_tokens"),
    }
    try:
        result = binding_module.validate_binding(value, selection)
    except Exception as exc:  # the pinned module owns the detailed schema contract
        raise RetirementError(f"session binding {sid} failed validation: {exc}") from exc
    return result, digest_bytes(raw), bindings / f"{sid}.json"


def binding_result(binding_module: ModuleType, bindings: Path, sid: str, project: str) -> tuple[dict[str, Any], str, Path]:
    result, binding_sha, binding_path = validated_binding(binding_module, bindings, sid, project)
    if result.get("mode") != "local":
        raise RetirementError("only managed-local conversation bindings can release a local runtime root")
    return result, binding_sha, binding_path


def root_plan(runtime: dict[str, Any], root_directory: Path) -> dict[str, Any]:
    store_output = runtime.get("store_output")
    gc_root = runtime.get("gc_root")
    if store_output is None:
        if gc_root is not None:
            raise RetirementError("unrooted runtime binding has an unexpected GC root")
        return {"gc_root": None, "store_output": None, "root_release_required": False}
    root_directory = canonical_existing_dir(root_directory, "project runtime-root directory")
    root = Path(gc_root)
    try:
        root.relative_to(root_directory)
    except ValueError as exc:
        raise RetirementError("bound runtime GC root lies outside this project's runtime-root directory") from exc
    if root.parent != root_directory:
        raise RetirementError("bound runtime GC root is not a direct project-root entry")
    return {"gc_root": str(root), "store_output": store_output, "root_release_required": True}


def validate_root_for_release(plan: dict[str, Any], root_directory: Path) -> tuple[bool, dict[str, Any]]:
    if not plan["root_release_required"]:
        return False, {"present": False, "reason": "runtime was not Nix-store rooted"}
    root = Path(plan["gc_root"])
    root_directory = canonical_existing_dir(root_directory, "project runtime-root directory")
    parent_st = root_directory.lstat()
    if parent_st.st_uid != os.getuid() or parent_st.st_mode & 0o077:
        raise RetirementError("project runtime-root directory is not private")
    try:
        st = root.lstat()
    except FileNotFoundError:
        return False, {"present": False, "reason": "root already absent after a prior authorized attempt"}
    if not stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
        raise RetirementError("bound runtime GC root is not a single-link user-owned symlink")
    try:
        resolved = str(root.resolve(strict=True))
    except FileNotFoundError as exc:
        raise RetirementError("bound runtime GC root is dangling") from exc
    if resolved != plan["store_output"]:
        raise RetirementError("bound runtime GC root points to another store output")
    if not Path(resolved).is_dir():
        raise RetirementError("bound Nix store output is not a directory")
    return True, {
        "present": True,
        "device": st.st_dev,
        "inode": st.st_ino,
        "uid": st.st_uid,
        "links": st.st_nlink,
        "target": resolved,
    }


def unlink_validated_root(plan: dict[str, Any], root_directory: Path, identity: dict[str, Any]) -> None:
    root = Path(plan["gc_root"])
    root_directory = canonical_existing_dir(root_directory, "project runtime-root directory")
    fd_dir = os.open(root_directory, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
    try:
        st = os.stat(root.name, dir_fd=fd_dir, follow_symlinks=False)
        if (not stat.S_ISLNK(st.st_mode) or st.st_uid != identity["uid"] or st.st_nlink != identity["links"]
                or st.st_dev != identity["device"] or st.st_ino != identity["inode"]):
            raise RetirementError("bound runtime GC root changed before release")
        os.unlink(root.name, dir_fd=fd_dir)
        os.fsync(fd_dir)
    finally:
        os.close(fd_dir)


def expected_intent(*, sid: str, project: str, binding_path: Path, binding_sha: str,
                    result: dict[str, Any], plan: dict[str, Any], active: dict[str, Any],
                    archived: dict[str, Any], references: dict[str, Any], timestamp: str) -> dict[str, Any]:
    runtime = result["local"]["runtime"]
    return {
        "schema": INTENT_SCHEMA,
        "thread_id": sid,
        "project": project,
        "binding_path": str(binding_path),
        "binding_sha256": binding_sha,
        "model": result["model"],
        "provider": result["provider"],
        "runtime": {
            "backend": runtime["backend"],
            "executable_sha256": runtime["executable_sha256"],
            "store_output": plan["store_output"],
            "gc_root": plan["gc_root"],
        },
        "native_history": {
            "active_root": active["root"],
            "archived_root": archived["root"],
            "active_entries_scanned": active["entries_scanned"],
            "archived_entries_scanned": archived["entries_scanned"],
            "observed_absent": True,
        },
        "reference_snapshot": references,
        "authorized_at": timestamp,
        "policy": {
            "native_history_deleted_by_sandcodex": False,
            "archive_counts_as_deletion": False,
            "binding_preserved": True,
            "nix_gc_run": False,
            "thread_id_reuse_forbidden": True,
            "shared_runtime_root_requires_last_live_reference": True,
        },
    }


def validate_existing_intent(value: dict[str, Any], expected: dict[str, Any]) -> None:
    if value.get("schema") != INTENT_SCHEMA:
        raise RetirementError("retirement authorization schema mismatch")
    for key in ("thread_id", "project", "binding_path", "binding_sha256", "model", "provider", "runtime", "policy"):
        if value.get(key) != expected.get(key):
            raise RetirementError(f"existing retirement authorization conflicts at {key}")
    history = value.get("native_history")
    if (not isinstance(history, dict)
            or history.get("active_root") != expected["native_history"]["active_root"]
            or history.get("archived_root") != expected["native_history"]["archived_root"]
            or history.get("observed_absent") is not True):
        raise RetirementError("existing retirement authorization has invalid native-history evidence")
    refs = value.get("reference_snapshot")
    if not isinstance(refs, dict):
        raise RetirementError("existing retirement authorization reference snapshot is invalid")
    for key in ("live_binding_thread_ids", "completed_retired_binding_thread_ids", "unbound_local_native_thread_ids"):
        rows = refs.get(key)
        if not isinstance(rows, list) or rows != sorted(set(rows)):
            raise RetirementError("existing retirement authorization reference snapshot is malformed")
        for row in rows:
            valid_uuid(row)
    if not isinstance(value.get("authorized_at"), str) or not TIMESTAMP.fullmatch(value["authorized_at"]):
        raise RetirementError("existing retirement authorization timestamp is invalid")


def validate_receipt_value(value: dict[str, Any], *, sid: str, project: str,
                           intent_sha: str, plan: dict[str, Any]) -> None:
    expected = {
        "schema": RECEIPT_SCHEMA,
        "thread_id": sid,
        "project": project,
        "retirement_authorization_sha256": intent_sha,
        "gc_root": plan["gc_root"],
        "store_output": plan["store_output"],
        "gc_root_release_required": plan["root_release_required"],
        "binding_preserved": True,
        "nix_gc_run": False,
    }
    for key, wanted in expected.items():
        if value.get(key) != wanted:
            raise RetirementError(f"retirement receipt conflicts at {key}")
    state = value.get("gc_root_state")
    unlinked = value.get("gc_root_unlinked_by_command")
    retained = value.get("retained_for_thread_ids")
    if type(unlinked) is not bool or not isinstance(retained, list) or retained != sorted(set(retained)):
        raise RetirementError("retirement receipt root disposition is malformed")
    for row in retained:
        if valid_uuid(row) == sid:
            raise RetirementError("retirement receipt cannot retain its own thread ID")
    if not plan["root_release_required"]:
        if state != "not-applicable" or unlinked or retained:
            raise RetirementError("non-Nix retirement receipt has an invalid root disposition")
    elif retained:
        if state != "retained-shared" or unlinked:
            raise RetirementError("shared-root retirement receipt has an invalid disposition")
    elif state == "released":
        if not unlinked:
            raise RetirementError("released-root receipt does not record its unlink")
    elif state == "already-absent":
        if unlinked:
            raise RetirementError("already-absent root receipt incorrectly records an unlink")
    else:
        raise RetirementError("retirement receipt root disposition is invalid")
    if not isinstance(value.get("completed_at"), str) or not TIMESTAMP.fullmatch(value["completed_at"]):
        raise RetirementError("retirement receipt timestamp is invalid")


def validate_retirement_pair(*, sid: str, project: str, binding_path: Path,
                             binding_sha: str, plan: dict[str, Any], retirements: Path | None,
                             receipts: Path | None, active_root: Path, archived_root: Path) -> tuple[bool, dict[str, Any] | None]:
    if retirements is None or receipts is None:
        return False, None
    intent_path = retirements / f"{sid}.json"
    receipt_path = receipts / f"{sid}.json"
    intent_exists = os.path.lexists(intent_path)
    receipt_exists = os.path.lexists(receipt_path)
    if receipt_exists and not intent_exists:
        raise RetirementError(f"retirement receipt for {sid} has no authorization")
    if not intent_exists or not receipt_exists:
        return False, None
    intent, intent_raw = read_private_json(intent_path)
    stable_expected = {
        "schema": INTENT_SCHEMA,
        "thread_id": sid,
        "project": project,
        "binding_path": str(binding_path),
        "binding_sha256": binding_sha,
        "runtime": {
            "store_output": plan["store_output"],
            "gc_root": plan["gc_root"],
        },
    }
    for key in ("schema", "thread_id", "project", "binding_path", "binding_sha256"):
        if intent.get(key) != stable_expected[key]:
            raise RetirementError(f"retirement authorization for {sid} conflicts at {key}")
    runtime = intent.get("runtime")
    if not isinstance(runtime, dict) or runtime.get("store_output") != plan["store_output"] or runtime.get("gc_root") != plan["gc_root"]:
        raise RetirementError(f"retirement authorization for {sid} has a different runtime root")
    history = intent.get("native_history")
    if (not isinstance(history, dict) or history.get("active_root") != str(active_root)
            or history.get("archived_root") != str(archived_root)
            or history.get("observed_absent") is not True):
        raise RetirementError(f"retirement authorization for {sid} has invalid native-history evidence")
    policy = intent.get("policy")
    if (not isinstance(policy, dict) or policy.get("binding_preserved") is not True
            or policy.get("nix_gc_run") is not False
            or policy.get("thread_id_reuse_forbidden") is not True
            or policy.get("shared_runtime_root_requires_last_live_reference") is not True):
        raise RetirementError(f"retirement authorization for {sid} has an invalid policy")
    receipt, _raw = read_private_json(receipt_path)
    validate_receipt_value(receipt, sid=sid, project=project,
                           intent_sha=digest_bytes(intent_raw), plan=plan)
    return True, receipt


def binding_ids(bindings: Path) -> list[str]:
    private_directory(bindings, "session binding directory")
    ids: list[str] = []
    for path in sorted(bindings.iterdir(), key=lambda row: row.name):
        try:
            st = path.lstat()
        except OSError as exc:
            raise RetirementError(f"could not inspect session binding entry: {path}") from exc
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1
                or st.st_mode & 0o077):
            raise RetirementError(f"unsafe session binding entry: {path}")
        if path.suffix != ".json":
            raise RetirementError(f"unexpected session binding entry: {path.name}")
        sid = valid_uuid(path.stem)
        if path.name != f"{sid}.json":
            raise RetirementError(f"session binding filename is not canonical: {path.name}")
        ids.append(sid)
    if len(ids) != len(set(ids)):
        raise RetirementError("duplicate session binding IDs")
    return ids


def selector_sessions(selector_module: ModuleType, root: Path, project: Path, label: str) -> list[dict[str, Any]]:
    try:
        rows = selector_module.list_sessions(root, project, allow_missing=True)
    except Exception as exc:
        raise RetirementError(f"could not inspect {label} metadata: {exc}") from exc
    if not isinstance(rows, list):
        raise RetirementError(f"{label} selector result is invalid")
    return rows


def reference_graph(*, binding_module: ModuleType, selector_module: ModuleType,
                    bindings: Path, retirements: Path | None, receipts: Path | None,
                    sid: str, project: str, plan: dict[str, Any], sessions: Path,
                    archived_sessions: Path) -> dict[str, Any]:
    empty = {
        "live_binding_thread_ids": [],
        "completed_retired_binding_thread_ids": [],
        "unbound_local_native_thread_ids": [],
    }
    if not plan["root_release_required"]:
        return empty
    bound_ids = set(binding_ids(bindings))
    live: list[str] = []
    completed: list[str] = []
    for other_sid in sorted(bound_ids):
        if other_sid == sid:
            continue
        result, binding_sha, binding_path = validated_binding(binding_module, bindings, other_sid, project)
        if result.get("mode") != "local":
            continue
        runtime = result["local"]["runtime"]
        if runtime.get("gc_root") != plan["gc_root"]:
            continue
        if runtime.get("store_output") != plan["store_output"]:
            raise RetirementError(f"binding {other_sid} reuses the runtime root for another store output")
        other_plan = {
            "gc_root": runtime.get("gc_root"),
            "store_output": runtime.get("store_output"),
            "root_release_required": runtime.get("store_output") is not None,
        }
        retired, _receipt = validate_retirement_pair(
            sid=other_sid, project=project, binding_path=binding_path,
            binding_sha=binding_sha, plan=other_plan, retirements=retirements,
            receipts=receipts, active_root=sessions, archived_root=archived_sessions,
        )
        if retired:
            # A completed retirement remains trustworthy only while native history
            # for that UUID is still absent from both pinned rollout trees.
            safe_tree_scan(sessions, other_sid, "active Codex session tree")
            safe_tree_scan(archived_sessions, other_sid, "archived Codex session tree")
            completed.append(other_sid)
        else:
            live.append(other_sid)

    try:
        active_rows = selector_sessions(selector_module, sessions, Path(project), "active Codex session tree")
        archived_rows = selector_sessions(selector_module, archived_sessions, Path(project), "archived Codex session tree")
    except FileNotFoundError:
        active_rows, archived_rows = [], []
    seen_native: set[str] = set()
    unbound: list[str] = []
    for row in [*active_rows, *archived_rows]:
        row_sid = valid_uuid(row.get("id"))
        if row_sid in seen_native:
            raise RetirementError(f"native thread {row_sid} appears in both active/archive history or duplicate rollouts")
        seen_native.add(row_sid)
        if row_sid == sid or row.get("provider") != "ollama":
            continue
        if row_sid not in bound_ids:
            unbound.append(row_sid)
    return {
        "live_binding_thread_ids": sorted(set(live)),
        "completed_retired_binding_thread_ids": sorted(set(completed)),
        "unbound_local_native_thread_ids": sorted(set(unbound)),
    }


def blocking_reference_ids(references: dict[str, Any]) -> list[str]:
    return sorted(set(references["live_binding_thread_ids"]) |
                  set(references["unbound_local_native_thread_ids"]))


def result_base(*, sid: str, project: str, binding_path: Path, binding_sha: str,
                intent_path: Path, receipt_path: Path, plan: dict[str, Any],
                references: dict[str, Any], root_present: bool) -> dict[str, Any]:
    blockers = blocking_reference_ids(references)
    return {
        "schema": RESULT_SCHEMA,
        "result": "pending",
        "thread_id": sid,
        "project": project,
        "binding_path": str(binding_path),
        "binding_sha256": binding_sha,
        "retirement_authorization_path": str(intent_path),
        "retirement_receipt_path": str(receipt_path),
        "native_history_observed_absent": True,
        "gc_root": plan["gc_root"],
        "store_output": plan["store_output"],
        "gc_root_present": root_present,
        "gc_root_release_required": plan["root_release_required"],
        "gc_root_release_authorized": bool(plan["root_release_required"] and not blockers),
        "retained_for_thread_ids": blockers,
        "reference_snapshot": references,
        "binding_preserved": True,
        "nix_gc_run": False,
    }


def command_retire(args: argparse.Namespace) -> int:
    sid = valid_uuid(args.thread_id)
    if not TIMESTAMP.fullmatch(args.timestamp):
        raise RetirementError("timestamp must be UTC YYYY-MM-DDTHH:MM:SSZ")
    project_path = canonical_existing_dir(args.project, "project")
    project = str(project_path)
    bindings = private_directory(args.bindings, "session binding directory")
    assert bindings is not None
    binding_module = load_module(args.binding_helper, "sandcodex_retirement_binding")
    selector_module = load_module(args.selector_helper, "sandcodex_retirement_selector")
    result, binding_sha, binding_path = binding_result(binding_module, bindings, sid, project)
    plan = root_plan(result["local"]["runtime"], args.runtime_roots)

    retirements = private_directory(args.retirements, "retirement authorization directory", optional=args.dry_run)
    receipts = private_directory(args.receipts, "retirement receipt directory", optional=args.dry_run)
    active = safe_tree_scan(args.sessions, sid, "active Codex session tree")
    archived = safe_tree_scan(args.archived_sessions, sid, "archived Codex session tree")
    references = reference_graph(
        binding_module=binding_module, selector_module=selector_module,
        bindings=bindings, retirements=retirements, receipts=receipts,
        sid=sid, project=project, plan=plan, sessions=args.sessions,
        archived_sessions=args.archived_sessions,
    )
    intent_value = expected_intent(
        sid=sid, project=project, binding_path=binding_path, binding_sha=binding_sha,
        result=result, plan=plan, active=active, archived=archived,
        references=references, timestamp=args.timestamp,
    )

    intent_path = args.retirements / f"{sid}.json"
    receipt_path = args.receipts / f"{sid}.json"
    existing_intent: dict[str, Any] | None = None
    intent_raw: bytes | None = None
    if retirements is not None and os.path.lexists(intent_path):
        existing_intent, intent_raw = read_private_json(intent_path)
        validate_existing_intent(existing_intent, intent_value)

    root_present, root_identity = validate_root_for_release(plan, args.runtime_roots)
    blockers = blocking_reference_ids(references)
    if plan["root_release_required"] and blockers and not root_present:
        raise RetirementError("shared runtime root is missing while another local conversation still requires it")
    output = result_base(
        sid=sid, project=project, binding_path=binding_path, binding_sha=binding_sha,
        intent_path=intent_path, receipt_path=receipt_path, plan=plan,
        references=references, root_present=root_present,
    )
    if args.dry_run:
        output["result"] = "retirement_plan"
        print(json.dumps(output, sort_keys=True))
        return 0

    assert retirements is not None and receipts is not None
    if existing_intent is None:
        try:
            intent_raw = write_private_json_exclusive(intent_path, intent_value)
        except FileExistsError:
            existing_intent, intent_raw = read_private_json(intent_path)
            validate_existing_intent(existing_intent, intent_value)
    assert intent_raw is not None
    intent_sha = digest_bytes(intent_raw)

    # Re-scan after immutable authorization. Any native-history reappearance or
    # newly committed binding changes the release decision before the root moves.
    safe_tree_scan(args.sessions, sid, "active Codex session tree")
    safe_tree_scan(args.archived_sessions, sid, "archived Codex session tree")
    references = reference_graph(
        binding_module=binding_module, selector_module=selector_module,
        bindings=bindings, retirements=retirements, receipts=receipts,
        sid=sid, project=project, plan=plan, sessions=args.sessions,
        archived_sessions=args.archived_sessions,
    )
    blockers = blocking_reference_ids(references)

    if os.path.lexists(receipt_path):
        receipt, _raw = read_private_json(receipt_path)
        validate_receipt_value(receipt, sid=sid, project=project, intent_sha=intent_sha, plan=plan)
        now_present, _identity = validate_root_for_release(plan, args.runtime_roots)
        output = result_base(
            sid=sid, project=project, binding_path=binding_path, binding_sha=binding_sha,
            intent_path=intent_path, receipt_path=receipt_path, plan=plan,
            references=references, root_present=now_present,
        )
        output["result"] = "already_retired"
        output["gc_root_state"] = receipt["gc_root_state"]
        output["gc_root_unlinked_by_command"] = receipt["gc_root_unlinked_by_command"]
        output["retained_for_thread_ids"] = receipt["retained_for_thread_ids"]
        print(json.dumps(output, sort_keys=True))
        return 0

    root_present, root_identity = validate_root_for_release(plan, args.runtime_roots)
    if plan["root_release_required"] and blockers and not root_present:
        raise RetirementError("shared runtime root disappeared while another local conversation still requires it")
    if not plan["root_release_required"]:
        root_state = "not-applicable"
        unlinked = False
    elif blockers:
        root_state = "retained-shared"
        unlinked = False
    elif root_present:
        unlink_validated_root(plan, args.runtime_roots, root_identity)
        root_state = "released"
        unlinked = True
    else:
        root_state = "already-absent"
        unlinked = False

    receipt = {
        "schema": RECEIPT_SCHEMA,
        "thread_id": sid,
        "project": project,
        "retirement_authorization_sha256": intent_sha,
        "gc_root": plan["gc_root"],
        "store_output": plan["store_output"],
        "gc_root_release_required": plan["root_release_required"],
        "gc_root_state": root_state,
        "gc_root_unlinked_by_command": unlinked,
        "retained_for_thread_ids": blockers,
        "binding_preserved": True,
        "nix_gc_run": False,
        "completed_at": args.timestamp,
    }
    try:
        write_private_json_exclusive(receipt_path, receipt)
    except FileExistsError:
        existing_receipt, _raw = read_private_json(receipt_path)
        validate_receipt_value(existing_receipt, sid=sid, project=project,
                               intent_sha=intent_sha, plan=plan)
        receipt = existing_receipt
    output = result_base(
        sid=sid, project=project, binding_path=binding_path, binding_sha=binding_sha,
        intent_path=intent_path, receipt_path=receipt_path, plan=plan,
        references=references, root_present=os.path.lexists(Path(plan["gc_root"])) if plan["gc_root"] else False,
    )
    output["result"] = "retired"
    output["gc_root_state"] = receipt["gc_root_state"]
    output["gc_root_unlinked_by_command"] = receipt["gc_root_unlinked_by_command"]
    output["retained_for_thread_ids"] = receipt["retained_for_thread_ids"]
    print(json.dumps(output, sort_keys=True))
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--thread-id", required=True)
    p.add_argument("--project", required=True, type=Path)
    p.add_argument("--binding-helper", required=True, type=Path)
    p.add_argument("--selector-helper", required=True, type=Path)
    p.add_argument("--bindings", required=True, type=Path)
    p.add_argument("--retirements", required=True, type=Path)
    p.add_argument("--receipts", required=True, type=Path)
    p.add_argument("--sessions", required=True, type=Path)
    p.add_argument("--archived-sessions", required=True, type=Path)
    p.add_argument("--runtime-roots", required=True, type=Path)
    p.add_argument("--timestamp", required=True)
    p.add_argument("--dry-run", action="store_true")
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        return command_retire(args)
    except FileNotFoundError as exc:
        return fail(str(exc), 66)
    except (RetirementError, OSError, ValueError, json.JSONDecodeError) as exc:
        return fail(str(exc), 78)


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_LOCAL_RETIRE_PY
}

sc_emit_local_runtime_channel() {
  cat <<'SANDCODEX_LOCAL_RUNTIME_CHANNEL_PY'
#!/usr/bin/env python3
"""Private local-runtime channel registry.

This helper never downloads, starts, or garbage-collects a runtime. It validates
qualified stage records, atomically selects one stage per backend, supports
one-step rollback, and safely releases registry-owned roots for unreachable
stages. The shell launcher owns Nix realization, qualification, and long-lived
maintenance/launch leasing.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
from typing import Any

STAGE_SCHEMA = "sandcodex.local-runtime-stage.v2"
LEGACY_STAGE_SCHEMA = "sandcodex.local-runtime-stage.v1"
CHANNEL_SCHEMA = "sandcodex.local-runtime-channel.v1"
RESULT_SCHEMA = "sandcodex.local-runtime-result.v1"
HEX = re.compile(r"[0-9a-f]{64}")
PIN = re.compile(r"[0-9a-f]{40}")
MODEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}")
TOKEN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/=-]{0,255}")
STAMP = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{1,9})?Z")


class RuntimeChannelError(Exception):
    pass


def fail(message: str, code: int = 78) -> int:
    print(f"sandcodex-local-runtime: {message}", file=sys.stderr)
    return code


def canonical(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode()


def digest_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def valid_hash(value: Any, label: str) -> str:
    if not isinstance(value, str) or not HEX.fullmatch(value):
        raise RuntimeChannelError(f"{label} must be a lowercase SHA-256 digest")
    return value


def valid_timestamp(value: Any, label: str) -> str:
    if not isinstance(value, str) or not STAMP.fullmatch(value):
        raise RuntimeChannelError(f"{label} is not a canonical UTC timestamp")
    return value


def valid_backend(value: Any) -> str:
    if value not in ("cpu", "cuda"):
        raise RuntimeChannelError("runtime backend must be cpu or cuda")
    return value


def valid_server_policy(value: Any) -> dict[str, Any]:
    expected = {
        "keep_alive": "5m", "max_loaded_models": 1, "num_parallel": 1,
        "max_queue": 8, "flash_attention": True, "kv_cache_type": "f16",
        "operator_overrides_allowed": False,
    }
    if value != expected:
        raise RuntimeChannelError("runtime stage server policy is missing or differs from this launcher")
    return expected


def valid_memory_budget(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RuntimeChannelError("runtime stage memory budget must be an object")
    required = {"policy", "host_memavailable_mib", "memory_max_mib", "memory_max_bytes"}
    optional = {"memory_high_mib"}
    if not required.issubset(value) or set(value) - required - optional:
        raise RuntimeChannelError("runtime stage memory budget fields are invalid")
    policy = value.get("policy")
    if policy not in {"half-memavailable", "operator-explicit-mib"}:
        raise RuntimeChannelError("runtime stage memory budget policy is invalid")
    clean = {"policy": policy}
    for key in ("host_memavailable_mib", "memory_max_mib", "memory_max_bytes"):
        item = value.get(key)
        if type(item) is not int or item < 0 or item > 2**63 - 1:
            raise RuntimeChannelError("runtime stage memory budget value is invalid")
        clean[key] = item
    if "memory_high_mib" in value:
        high = value.get("memory_high_mib")
        if type(high) is not int or high < 0 or high > 2**63 - 1:
            raise RuntimeChannelError("runtime stage memory high value is invalid")
        clean["memory_high_mib"] = high
    return clean


def secure_dir(path: Path, *, create: bool = False) -> None:
    if create:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        st = path.lstat()
    except FileNotFoundError as exc:
        raise FileNotFoundError(f"runtime channel directory is missing: {path}") from exc
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise RuntimeChannelError(f"runtime channel path is not a real directory: {path}")
    if st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o700:
        raise RuntimeChannelError(f"runtime channel directory must be owned by this user with mode 0700: {path}")


def secure_file(path: Path, *, mode: int = 0o600) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise RuntimeChannelError(f"runtime channel file is not a regular file: {path}")
        if st.st_uid != os.getuid() or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != mode:
            raise RuntimeChannelError(f"runtime channel file metadata is unsafe: {path}")
        with os.fdopen(fd, "rb", closefd=False) as stream:
            return stream.read()
    finally:
        os.close(fd)


def decode(raw: bytes, label: str) -> Any:
    try:
        return json.loads(raw.decode("utf-8"), parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))
    except (UnicodeError, json.JSONDecodeError, ValueError) as exc:
        raise RuntimeChannelError(f"{label} is not strict JSON") from exc


def fsync_dir(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic_replace(path: Path, value: Any) -> None:
    raw = canonical(value)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(temporary)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb", closefd=True) as out:
            out.write(raw)
            out.flush()
            os.fsync(out.fileno())
        os.replace(tmp, path)
        fsync_dir(path.parent)
    finally:
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass


def exclusive_file(path: Path, value: Any) -> None:
    raw = canonical(value)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    fd = os.open(path, flags, 0o600)
    try:
        view = memoryview(raw)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("short write while creating runtime stage")
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    fsync_dir(path.parent)


def ensure_layout(root: Path) -> None:
    if not root.is_absolute():
        raise RuntimeChannelError("runtime channel root must be absolute")
    secure_dir(root, create=True)
    for name in ("stages", "channels", "roots"):
        secure_dir(root / name, create=True)
    lock = root / ".lock"
    if not os.path.lexists(lock):
        fd = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        os.close(fd)
        fsync_dir(root)
    secure_file(lock)


def stage_identity(stage: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in stage.items() if key != "stage_id"}


def validate_stage(value: Any, root: Path, *, require_id: bool) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RuntimeChannelError("runtime stage must be a JSON object")
    allowed = {
        "schema", "stage_id", "backend", "nixpkgs_rev", "package", "executable",
        "executable_sha256", "store_output", "store_output_nar_hash",
        "closure_paths_sha256", "gc_root", "provider_version", "qualified_model",
        "qualified_model_digest_sha256", "context_tokens", "qualification_sha256",
        "startup_receipt_sha256", "qualified_at", "requested_model",
        "source_model_digest_sha256", "model_profile_num_thread", "server_policy",
        "memory_budget",
    }
    if set(value) - allowed:
        raise RuntimeChannelError("runtime stage contains unknown fields")
    schema = value.get("schema")
    if schema not in {LEGACY_STAGE_SCHEMA, STAGE_SCHEMA}:
        raise RuntimeChannelError("runtime stage schema mismatch")
    backend = valid_backend(value.get("backend"))
    pin = value.get("nixpkgs_rev")
    if not isinstance(pin, str) or not PIN.fullmatch(pin):
        raise RuntimeChannelError("runtime stage nixpkgs revision must be a full lowercase commit")
    package = value.get("package")
    if package != f"ollama-{backend}":
        raise RuntimeChannelError("runtime stage package does not match its backend")
    executable = value.get("executable")
    store_output = value.get("store_output")
    if not isinstance(store_output, str) or not re.fullmatch(r"/nix/store/[A-Za-z0-9+._?=-]+", store_output):
        raise RuntimeChannelError("runtime stage store output is invalid")
    if executable != f"{store_output}/bin/ollama":
        raise RuntimeChannelError("runtime stage executable must be bin/ollama in the recorded store output")
    executable_sha = valid_hash(value.get("executable_sha256"), "runtime executable digest")
    nar_hash = value.get("store_output_nar_hash")
    if not isinstance(nar_hash, str) or not TOKEN.fullmatch(nar_hash):
        raise RuntimeChannelError("runtime stage NAR hash is invalid")
    closure = valid_hash(value.get("closure_paths_sha256"), "runtime closure-path digest")
    gc_root = value.get("gc_root")
    expected_root = root / "roots" / executable_sha
    if not isinstance(gc_root, str) or Path(gc_root) != expected_root:
        raise RuntimeChannelError("runtime stage GC root is outside the channel root or has the wrong name")
    provider_version = value.get("provider_version")
    if not isinstance(provider_version, str) or not re.fullmatch(r"[A-Za-z0-9.+_-]{1,80}", provider_version):
        raise RuntimeChannelError("runtime provider version is invalid")
    model = value.get("qualified_model")
    if not isinstance(model, str) or not MODEL.fullmatch(model):
        raise RuntimeChannelError("qualified model identifier is invalid")
    model_digest = valid_hash(value.get("qualified_model_digest_sha256"), "qualified model digest")
    profile_keys = {"requested_model", "source_model_digest_sha256", "model_profile_num_thread"}
    supplied_profile_keys = profile_keys.intersection(value)
    profile_identity: dict[str, Any] = {}
    if supplied_profile_keys:
        if supplied_profile_keys != profile_keys:
            raise RuntimeChannelError("runtime stage model-profile identity is incomplete")
        requested_model = value.get("requested_model")
        if not isinstance(requested_model, str) or not MODEL.fullmatch(requested_model):
            raise RuntimeChannelError("runtime stage requested model is invalid")
        source_digest = valid_hash(value.get("source_model_digest_sha256"), "source model digest")
        threads = value.get("model_profile_num_thread")
        if threads is not None and (type(threads) is not int or not 1 <= threads <= 1024):
            raise RuntimeChannelError("runtime stage model-profile thread count is invalid")
        expected_model = (f"sandcodex/sha256-{source_digest}:pinned" if threads is None else
                          f"sandcodex/sha256-{source_digest}:threads-{threads}")
        if model != expected_model:
            raise RuntimeChannelError("qualified model does not match the recorded source/profile identity")
        if threads is None and model_digest != source_digest:
            raise RuntimeChannelError("unparameterized model profile digest differs from its source")
        profile_identity = {
            "requested_model": requested_model,
            "source_model_digest_sha256": source_digest,
            "model_profile_num_thread": threads,
        }
    server_policy = value.get("server_policy")
    if server_policy is not None:
        server_policy = valid_server_policy(server_policy)
    if schema == STAGE_SCHEMA and server_policy is None:
        raise RuntimeChannelError("v2 runtime stage lacks its qualified server policy")
    memory_budget = value.get("memory_budget")
    if memory_budget is not None:
        memory_budget = valid_memory_budget(memory_budget)
    context = value.get("context_tokens")
    if type(context) is not int or context < 4096 or context > 262144 or context % 1024:
        raise RuntimeChannelError("qualified context must be 4096..262144 and a multiple of 1024")
    qualification = valid_hash(value.get("qualification_sha256"), "qualification digest")
    startup = valid_hash(value.get("startup_receipt_sha256"), "startup receipt digest")
    qualified_at = valid_timestamp(value.get("qualified_at"), "qualification timestamp")
    clean = {
        "schema": schema,
        "backend": backend,
        "nixpkgs_rev": pin,
        "package": package,
        "executable": executable,
        "executable_sha256": executable_sha,
        "store_output": store_output,
        "store_output_nar_hash": nar_hash,
        "closure_paths_sha256": closure,
        "gc_root": str(expected_root),
        "provider_version": provider_version,
        "qualified_model": model,
        "qualified_model_digest_sha256": model_digest,
        "context_tokens": context,
        "qualification_sha256": qualification,
        "startup_receipt_sha256": startup,
        "qualified_at": qualified_at,
    }
    clean.update(profile_identity)
    if server_policy is not None:
        clean["server_policy"] = server_policy
    if memory_budget is not None:
        clean["memory_budget"] = memory_budget
    stage_id = digest_bytes(canonical(clean))
    supplied = value.get("stage_id")
    if require_id and supplied != stage_id:
        raise RuntimeChannelError("runtime stage ID does not match its canonical contents")
    if supplied is not None and supplied != stage_id:
        raise RuntimeChannelError("runtime stage supplied a conflicting stage ID")
    clean["stage_id"] = stage_id
    return clean


def verify_live(stage: dict[str, Any], root: Path) -> None:
    executable = Path(stage["executable"])
    try:
        st = executable.stat()
    except FileNotFoundError as exc:
        raise RuntimeChannelError("qualified runtime executable is missing") from exc
    if not stat.S_ISREG(st.st_mode) or not os.access(executable, os.X_OK):
        raise RuntimeChannelError("qualified runtime executable is not an executable regular file")
    observed = hashlib.sha256(executable.read_bytes()).hexdigest()
    if observed != stage["executable_sha256"]:
        raise RuntimeChannelError("qualified runtime executable bytes changed")
    store_output = Path(stage["store_output"])
    if not store_output.is_dir():
        raise RuntimeChannelError("qualified runtime store output is missing")
    gc_root = Path(stage["gc_root"])
    try:
        root_st = gc_root.lstat()
    except FileNotFoundError as exc:
        raise RuntimeChannelError("qualified runtime GC root is missing") from exc
    if not stat.S_ISLNK(root_st.st_mode) or root_st.st_uid != os.getuid():
        raise RuntimeChannelError("qualified runtime GC root is unsafe")
    try:
        resolved = gc_root.resolve(strict=True)
    except OSError as exc:
        raise RuntimeChannelError("qualified runtime GC root cannot be resolved") from exc
    if resolved != store_output:
        raise RuntimeChannelError("qualified runtime GC root points to different bytes")
    if gc_root.parent != root / "roots":
        raise RuntimeChannelError("qualified runtime GC root escaped the channel")


def read_stage(root: Path, stage_id: str, *, live: bool = True) -> dict[str, Any]:
    valid_hash(stage_id, "runtime stage ID")
    path = root / "stages" / f"{stage_id}.json"
    raw = secure_file(path)
    value = validate_stage(decode(raw, "runtime stage"), root, require_id=True)
    if canonical(value) != raw:
        raise RuntimeChannelError("stored runtime stage is not canonical")
    if live:
        verify_live(value, root)
    return value


def channel_path(root: Path, backend: str) -> Path:
    return root / "channels" / f"{backend}.json"


def validate_channel(value: Any, backend: str) -> dict[str, Any]:
    if not isinstance(value, dict) or value.get("schema") != CHANNEL_SCHEMA:
        raise RuntimeChannelError("runtime channel schema mismatch")
    if set(value) != {"schema", "backend", "generation", "current", "previous", "activated_at"}:
        raise RuntimeChannelError("runtime channel fields are invalid")
    if value.get("backend") != backend:
        raise RuntimeChannelError("runtime channel backend mismatch")
    generation = value.get("generation")
    if type(generation) is not int or generation < 1 or generation > 2**63 - 1:
        raise RuntimeChannelError("runtime channel generation is invalid")
    current = valid_hash(value.get("current"), "current runtime stage ID")
    previous = value.get("previous")
    if previous is not None:
        previous = valid_hash(previous, "previous runtime stage ID")
        if previous == current:
            raise RuntimeChannelError("runtime channel current and previous stages are identical")
    activated = valid_timestamp(value.get("activated_at"), "runtime activation timestamp")
    return {"schema": CHANNEL_SCHEMA, "backend": backend, "generation": generation,
            "current": current, "previous": previous, "activated_at": activated}


def read_channel(root: Path, backend: str) -> dict[str, Any] | None:
    path = channel_path(root, backend)
    if not os.path.lexists(path):
        return None
    raw = secure_file(path)
    value = validate_channel(decode(raw, "runtime channel"), backend)
    if canonical(value) != raw:
        raise RuntimeChannelError("stored runtime channel is not canonical")
    return value


def stage_inventory(root: Path) -> dict[str, dict[str, Any]]:
    stages: dict[str, dict[str, Any]] = {}
    directory = root / "stages"
    with os.scandir(directory) as entries:
        for entry in entries:
            if entry.name.startswith(".") or not re.fullmatch(r"[0-9a-f]{64}\.json", entry.name):
                raise RuntimeChannelError(f"unexpected runtime stage entry: {entry.name}")
            stage_id = entry.name[:-5]
            if stage_id in stages:
                raise RuntimeChannelError("duplicate runtime stage entry")
            stages[stage_id] = read_stage(root, stage_id, live=False)
    return stages


def root_inventory(root: Path) -> dict[str, Path]:
    roots: dict[str, Path] = {}
    directory = root / "roots"
    with os.scandir(directory) as entries:
        for entry in entries:
            if not HEX.fullmatch(entry.name):
                raise RuntimeChannelError(f"unexpected runtime GC-root entry: {entry.name}")
            path = directory / entry.name
            st = path.lstat()
            if not stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
                raise RuntimeChannelError(f"runtime GC-root entry is unsafe: {path}")
            roots[entry.name] = path
    return roots


def prune_plan(root: Path) -> dict[str, Any]:
    channels: dict[str, dict[str, Any] | None] = {}
    protected: set[str] = set()
    protected_stages: dict[str, dict[str, Any]] = {}
    for backend in ("cpu", "cuda"):
        channel = read_channel(root, backend)
        channels[backend] = channel
        if channel is None:
            continue
        for stage_id in (channel["current"], channel["previous"]):
            if stage_id is None or stage_id in protected:
                continue
            stage = read_stage(root, stage_id, live=True)
            protected.add(stage_id)
            protected_stages[stage_id] = stage

    stages = stage_inventory(root)
    missing = sorted(protected - set(stages))
    if missing:
        raise RuntimeChannelError("runtime channel references a missing stage")
    removable = sorted(set(stages) - protected)
    retained_root_names = {Path(stage["gc_root"]).name for stage in protected_stages.values()}
    roots = root_inventory(root)
    removable_roots = sorted(str(path) for name, path in roots.items() if name not in retained_root_names)
    retained_roots = sorted(str(path) for name, path in roots.items() if name in retained_root_names)
    released_outputs = sorted({stages[stage_id]["store_output"] for stage_id in removable
                               if Path(stages[stage_id]["gc_root"]).name not in retained_root_names})
    return {
        "protected_stage_ids": sorted(protected),
        "remove_stage_ids": removable,
        "retained_gc_roots": retained_roots,
        "remove_gc_roots": removable_roots,
        "released_store_outputs": released_outputs,
        "channels": {backend: (None if channel is None else {
            "current": channel["current"], "previous": channel["previous"],
            "generation": channel["generation"],
        }) for backend, channel in channels.items()},
    }


def unlink_stage(root: Path, stage_id: str) -> None:
    # Re-validate immediately before unlink. The registry lock prevents a
    # cooperative writer from changing the channel graph during this operation.
    read_stage(root, stage_id, live=False)
    os.unlink(root / "stages" / f"{stage_id}.json")


def unlink_gc_root(root: Path, value: str) -> None:
    path = Path(value)
    if path.parent != root / "roots" or not HEX.fullmatch(path.name):
        raise RuntimeChannelError("prune plan contains an invalid GC-root path")
    st = path.lstat()
    if not stat.S_ISLNK(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
        raise RuntimeChannelError(f"runtime GC-root entry changed before prune: {path}")
    os.unlink(path)


def lock_root(root: Path):
    lock = root / ".lock"
    fd = os.open(lock, os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
        os.close(fd)
        raise RuntimeChannelError("runtime channel lock metadata is unsafe")
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def store_stage(root: Path, stage: dict[str, Any]) -> Path:
    path = root / "stages" / f"{stage['stage_id']}.json"
    if os.path.lexists(path):
        raw = secure_file(path)
        if raw != canonical(stage):
            raise RuntimeChannelError("existing runtime stage ID has conflicting contents")
    else:
        exclusive_file(path, stage)
    return path


def command_stage_activate(args: argparse.Namespace) -> int:
    ensure_layout(args.root)
    manifest_raw = secure_file(args.manifest)
    stage = validate_stage(decode(manifest_raw, "runtime stage manifest"), args.root, require_id=False)
    verify_live(stage, args.root)
    lock_fd = lock_root(args.root)
    try:
        # Recheck after acquiring the registry lock so activation cannot race a
        # same-user removal or replacement between qualification and commit.
        verify_live(stage, args.root)
        stage_path = store_stage(args.root, stage)
        current = read_channel(args.root, stage["backend"])
        if current is not None and current["current"] == stage["stage_id"]:
            result = "already_active"
            channel = current
        else:
            previous = current["current"] if current is not None else None
            generation = current["generation"] + 1 if current is not None else 1
            channel = {"schema": CHANNEL_SCHEMA, "backend": stage["backend"],
                       "generation": generation, "current": stage["stage_id"],
                       "previous": previous, "activated_at": args.timestamp}
            channel = validate_channel(channel, stage["backend"])
            atomic_replace(channel_path(args.root, stage["backend"]), channel)
            result = "activated"
    finally:
        os.close(lock_fd)
    print(json.dumps({"schema": RESULT_SCHEMA, "result": result, "backend": stage["backend"],
                      "stage_id": stage["stage_id"], "stage_path": str(stage_path),
                      "channel": channel, "stage": stage}, sort_keys=True))
    return 0


def command_rollback(args: argparse.Namespace) -> int:
    ensure_layout(args.root)
    backend = valid_backend(args.backend)
    lock_fd = lock_root(args.root)
    try:
        current = read_channel(args.root, backend)
        if current is None:
            raise FileNotFoundError(f"no active {backend} runtime exists")
        if current["previous"] is None:
            raise FileNotFoundError(f"no previous qualified {backend} runtime exists")
        current_stage = read_stage(args.root, current["current"])
        previous_stage = read_stage(args.root, current["previous"])
        channel = {"schema": CHANNEL_SCHEMA, "backend": backend,
                   "generation": current["generation"] + 1,
                   "current": previous_stage["stage_id"],
                   "previous": current_stage["stage_id"],
                   "activated_at": args.timestamp}
        channel = validate_channel(channel, backend)
        atomic_replace(channel_path(args.root, backend), channel)
    finally:
        os.close(lock_fd)
    print(json.dumps({"schema": RESULT_SCHEMA, "result": "rolled_back", "backend": backend,
                      "stage_id": previous_stage["stage_id"], "channel": channel,
                      "stage": previous_stage}, sort_keys=True))
    return 0


def resolve_backend(root: Path, backend: str) -> dict[str, Any] | None:
    channel = read_channel(root, backend)
    if channel is None:
        return None
    current = read_stage(root, channel["current"])
    previous = read_stage(root, channel["previous"]) if channel["previous"] is not None else None
    return {"channel": channel, "current": current, "previous": previous}


def command_resolve(args: argparse.Namespace) -> int:
    backend = valid_backend(args.backend)
    if not args.root.exists():
        if args.optional:
            print(json.dumps({"schema": RESULT_SCHEMA, "result": "none", "backend": backend}, sort_keys=True))
            return 0
        raise FileNotFoundError("local runtime channel has not been initialized")
    ensure_layout(args.root)
    channel = read_channel(args.root, backend)
    if channel is None:
        if args.optional:
            print(json.dumps({"schema": RESULT_SCHEMA, "result": "none", "backend": backend}, sort_keys=True))
            return 0
        raise FileNotFoundError(f"no active {backend} runtime exists")
    # A damaged previous stage disables rollback and makes status fail visibly,
    # but it must not strand an independently valid current stage. Fresh local
    # launch consumes only current; rollback validates both sides before swap.
    current = read_stage(args.root, channel["current"])
    print(json.dumps({"schema": RESULT_SCHEMA, "result": "active", "backend": backend,
                      "channel": channel, "current": current}, sort_keys=True))
    return 0


def command_status(args: argparse.Namespace) -> int:
    if not args.root.exists():
        value = {backend: {"result": "none", "backend": backend} for backend in ("cpu", "cuda")}
    else:
        ensure_layout(args.root)
        value = {}
        for backend in ("cpu", "cuda"):
            resolved = resolve_backend(args.root, backend)
            value[backend] = ({"result": "none", "backend": backend} if resolved is None
                              else {"result": "active", "backend": backend, **resolved})
    print(json.dumps({"schema": RESULT_SCHEMA, "result": "status", "channels": value}, sort_keys=True))
    return 0


def command_prune(args: argparse.Namespace) -> int:
    if not args.root.exists():
        if not args.optional:
            raise FileNotFoundError("local runtime channel has not been initialized")
        plan = {
            "protected_stage_ids": [], "remove_stage_ids": [],
            "retained_gc_roots": [], "remove_gc_roots": [],
            "released_store_outputs": [], "channels": {"cpu": None, "cuda": None},
        }
        result = "prune_plan" if args.dry_run else "pruned"
        print(json.dumps({"schema": RESULT_SCHEMA, "result": result, "dry_run": args.dry_run,
                          "nix_gc_run": False, "plan": plan}, sort_keys=True))
        return 0

    ensure_layout(args.root)
    lock_fd = lock_root(args.root)
    try:
        plan = prune_plan(args.root)
        if not args.dry_run:
            # Metadata goes first. A crash can leave an extra root, which the next
            # prune sees as orphaned; it cannot leave a live channel without a root.
            for stage_id in plan["remove_stage_ids"]:
                unlink_stage(args.root, stage_id)
            if plan["remove_stage_ids"]:
                fsync_dir(args.root / "stages")
            for path in plan["remove_gc_roots"]:
                unlink_gc_root(args.root, path)
            if plan["remove_gc_roots"]:
                fsync_dir(args.root / "roots")
    finally:
        os.close(lock_fd)
    result = "prune_plan" if args.dry_run else "pruned"
    print(json.dumps({"schema": RESULT_SCHEMA, "result": result, "dry_run": args.dry_run,
                      "nix_gc_run": False, "plan": plan}, sort_keys=True))
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)
    stage = sub.add_parser("stage-activate")
    stage.add_argument("--root", required=True, type=Path)
    stage.add_argument("--manifest", required=True, type=Path)
    stage.add_argument("--timestamp", required=True)
    stage.set_defaults(function=command_stage_activate)
    rollback = sub.add_parser("rollback")
    rollback.add_argument("--root", required=True, type=Path)
    rollback.add_argument("--backend", required=True)
    rollback.add_argument("--timestamp", required=True)
    rollback.set_defaults(function=command_rollback)
    resolve = sub.add_parser("resolve")
    resolve.add_argument("--root", required=True, type=Path)
    resolve.add_argument("--backend", required=True)
    resolve.add_argument("--optional", action="store_true")
    resolve.set_defaults(function=command_resolve)
    status = sub.add_parser("status")
    status.add_argument("--root", required=True, type=Path)
    status.set_defaults(function=command_status)
    prune = sub.add_parser("prune")
    prune.add_argument("--root", required=True, type=Path)
    prune.add_argument("--dry-run", action="store_true")
    prune.add_argument("--optional", action="store_true")
    prune.set_defaults(function=command_prune)
    return p


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        for field in ("timestamp",):
            if hasattr(args, field):
                valid_timestamp(getattr(args, field), field)
        return args.function(args)
    except FileNotFoundError as exc:
        return fail(str(exc), 66)
    except (RuntimeChannelError, OSError, ValueError) as exc:
        return fail(str(exc), 78)


if __name__ == "__main__":
    raise SystemExit(main())
