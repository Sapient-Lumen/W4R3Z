          credential_inventory:($base.active.key_count // 0),
          usable_credentials:($usable_key_ids|length),
          rotation_target_accounts:$rotation_target,
          account_start_policy:"per-logical-request-round-robin",
          account_scheduler_scope:($routing.capabilities.account_scheduler_scope // "unknown"),
          account_balancing_policy:($routing.capabilities.account_balancing_policy // "unknown"),
          successful_route_cooldown_healing:($routing.capabilities.successful_route_cooldown_healing // false),
          configured_account_goal_met:(($base.active.key_count // 0) >= $rotation_target),
          primary_credential:(if $primary == null then null else
            {key_id:$primary.key_id,key_label:$primary.label} end),
          authentication_standbys:([range(1; ($credentials|length))]|length),
          quota_rotation_accounts:([range(1; ($usable_key_ids|length))]|length),
          total_routes:(($routing.candidate_models|length) * ($base.active.key_count // 0)),
          usable_routes:($available|length),
          next_retry_at:$next,
          routes:$available
        },
        launch_ready:($base.key_available and (($available|length)>0)),
        capabilities:($routing.capabilities + {
          interactive_tui:true,loops:true,first_turn_task:true,companion_workers:true,
          native_subagents:true,project_shell_via_codex:true,
          apply_patch_via_codex:true,image_view_via_codex:true,
          mcp_via_sandcodex:true,nix_via_sandcodex:true,git_via_sandcodex:true,
          publication_via_sandcodex:true,inner_jail_via_sandcodex:true,
          operator_service_via_sandcodex:true,explicit_bare_metal_available:true,
          bound_resume:true,session_binding:true,
          provider_key_rotation:true,quota_key_rotation:true,
          cross_process_account_load_balancing:($routing.capabilities.account_scheduler_scope=="cross-process-shared-ledger"),
          successful_route_cooldown_healing:($routing.capabilities.successful_route_cooldown_healing // false),
          authentication_standby_promotion:true,
          pre_visible_output_model_failover:true,
          pending_tool_auth_standby_promotion:true,
          pending_tool_quota_key_rotation:true,
          pending_tool_model_failover:true,
          exact_cross_model_state_replay:true,clean_turn_retry:true,
          in_request_cooldown_wait:true,
          shared_transport_retry_window:true,aggregate_upstream_request_ceiling:true,
          live_tui_retarget:false,provider_quota_introspection:false,
          browser_via_sandcodex:true,desktop_via_sandcodex:true
        }),
        commands:{
          launch:("sandcodex gemini auto" + $credential_arg),
          resume:("sandcodex gemini auto" + $credential_arg + " --RESUME"),
          resume_picker:("sandcodex gemini auto" + $credential_arg + " --RESUME LIST"),
          first_turn:("sandcodex gemini auto" + $credential_arg + " task --prompt-file PROMPT.md --then-interactive"),
