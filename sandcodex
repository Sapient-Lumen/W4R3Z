    sc_die "project browser descriptor has no extension root"
  [[ "$extension_root" != /* && "$extension_root" != *'..'* ]] ||
    sc_die "project browser descriptor extension root is unsafe"
  extension_root="$(realpath -- "$SC_PROJECT/$extension_root" 2>/dev/null || true)"
  case "$extension_root/" in "$SC_PROJECT"/*/) ;; *) sc_die "project browser extension root escaped the selected project" ;; esac
  manifest="$extension_root/manifest.json"
  [[ -f "$manifest" && ! -L "$manifest" ]] || return 0
  key="$(jq -er '.key | select(type == "string" and length > 0)' "$manifest" 2>/dev/null || true)"
  [[ -n "$key" ]] || sc_die "deferred project extension needs a stable manifest key"
  extension_id="$(python3 -P - "$key" <<'PY'
