sc_write_agent_contract() {
  local extensions='[]' extension domains='[]' bundle='null'
  local operator_adapter='null'
  local gemini_candidates='[]'
  local contract_fact_root identity_fact inference_fact campaign_fact
  local gemini_quota_rotation=false
  local gemini_account_start_policy=bank-order-from-first-healthy
  local network_mode unrestricted_egress=false nix_daemon=false nix_trusted=null nix_profile='' nix_profile_on_path=false
  local nix_scope='host-native' git_excludes='' native_source=none
  rm -f -- "$SC_WORK/agent/glasstty-command-room-preflight.json"
  sc_write_desktop_viewer_helper
  sc_write_desktop_guide
  for extension in "${SC_BROWSER_EXTENSIONS[@]}"; do
    extensions="$(jq -c --arg value "$extension" '. + [$value]' <<<"$extensions")"
  done
  domains="$(printf '%s\n' "${SC_DOMAINS[@]}" | jq -Rsc 'split("\n") | map(select(length > 0)) | unique')"
  if [[ -n "$SC_BROWSER_BUNDLE_ARCHIVE" ]]; then
    native_source=bundle
    [[ -z "$SC_BROWSER_PROJECT_NATIVE_ENTRYPOINT" ]] || native_source=project
    bundle="$(jq -cn --arg name "$SC_BROWSER_BUNDLE_NAME" --arg version "$SC_BROWSER_BUNDLE_VERSION" \
      --arg archive "$SC_BROWSER_BUNDLE_ARCHIVE" --arg extensionId "$SC_BROWSER_BUNDLE_EXTENSION_ID" \
      --arg nativeSource "$native_source" \
      '{name:$name,version:$version,archive:$archive,extension_id:$extensionId,native_host_source:$nativeSource}')"
  fi
  [[ -z "$SC_BROWSER_PROJECT_NATIVE_ENTRYPOINT" ]] || native_source=project
  if (( SC_OPERATOR_ENABLED )); then
    operator_adapter="$(jq -c '.adapter // {mode:"socket-activation",target_port:null}' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  fi
  if [[ "$SC_PROVIDER_MODE" == gemini ]]; then
    if [[ -n "$SC_GEMINI_SNAPSHOT" && -r "$SC_GEMINI_SNAPSHOT" ]]; then
      gemini_candidates="$(jq -ce '.candidate_models' "$SC_GEMINI_SNAPSHOT")"
      gemini_quota_rotation="$(sc_gemini_snapshot_quota_rotation "$SC_GEMINI_SNAPSHOT")"
      gemini_account_start_policy="$(jq -er \
        '.capabilities.account_start_policy // "bank-order-from-first-healthy"' \
        "$SC_GEMINI_SNAPSHOT")"
      case "$gemini_account_start_policy" in
        per-logical-request-round-robin|bank-order-from-first-healthy) ;;
        *) sc_die "Gemini snapshot has an unknown account-start policy" 78 ;;
      esac
    else
      gemini_candidates="$(sc_gemini_free_models_json)"
    fi
  fi
  local node_version npm_version python_version pip_version pytest_version jsonschema_version resource_transport=none
  node_version="$(node --version)"; npm_version="$(npm --version)"
  python_version="$(python3 --version 2>&1 | awk '{print $2}')"; pip_version="$(pip --version | awk '{print $2}')"
  pytest_version="$(pytest --version | awk '{print $2}')"
  jsonschema_version="$(python3 -P -c 'import importlib.metadata; print(importlib.metadata.version("jsonschema"))')"
  if (( SC_BARE )); then
    network_mode=unrestricted
    unrestricted_egress=true
    nix_daemon=true
  elif (( SC_DEV_NET )); then
    network_mode=unrestricted
    unrestricted_egress=true
  else
    network_mode='provider-only'
  fi
  if (( ! SC_BARE && SC_NIX_DAEMON_SAFE )); then
    nix_daemon=true
    nix_trusted=false
    nix_profile="$SC_WORK/state/nix/profile"
    nix_profile_on_path=true
    nix_scope='untrusted host Nix daemon; builds are mandatory-sandboxed outside the Sandcodex cgroup, network namespace, and egress proxy'
    git_excludes="$SC_GIT_EXCLUDES"
  elif (( ! SC_BARE )); then
    nix_scope="$SC_NIX_DAEMON_DETAIL"
  fi
  case "${SANDCODEX_RESOURCE_SCOPE:-}" in
    *.scope) resource_transport=scope ;;
    *.service) resource_transport=service ;;
  esac
  contract_fact_root="$SC_CONTROL/tmp/agent-contract-facts-$SC_RUN_ID"
  identity_fact="$contract_fact_root/identity.json"
  inference_fact="$contract_fact_root/inference.json"
  campaign_fact="$contract_fact_root/campaign.json"
  sc_ensure_dir "$contract_fact_root" "agent contract fact root"
  jq -cn \
    --arg schema "$SC_AGENT_ENV_SCHEMA" --arg version "$SC_VERSION" \
    --arg mode "$([[ $SC_BARE == 1 ]] && printf bare-metal || printf sandbox)" \
    --argjson sudoTicket "$([[ $SC_BARE_SUDO_TICKET == 1 ]] && printf true || printf false)" \
    --arg project "$SC_PROJECT" --arg environment "$SC_AGENT_ENV" \
    '{schema:$schema,version:$version,mode:$mode,sudo_ticket:$sudoTicket,
      project:$project,environment:$environment}' |
    sc_atomic "$identity_fact" 400
  jq -cn \
    --arg providerMode "$SC_PROVIDER_MODE" --arg requestedModel "$SC_MODEL" \
    --arg remoteName "$SC_REMOTE_NAME" \
    --argjson remoteAuto "$([[ $SC_REMOTE_AUTO == 1 ]] && printf true || printf false)" \
    --argjson geminiAuto "$([[ $SC_GEMINI_AUTO == 1 ]] && printf true || printf false)" \
    --argjson geminiCandidates "$gemini_candidates" \
    --argjson geminiQuotaRotation "$gemini_quota_rotation" \
    --arg geminiAccountStartPolicy "$gemini_account_start_policy" \
    --argjson geminiRouteWait "$SC_GEMINI_ROUTE_WAIT_SECONDS" \
    --arg geminiDescriptor "$SC_GEMINI_SNAPSHOT_SHA256" \
    --arg geminiAdapter "$SC_GEMINI_ADAPTER_SHA256" \
    --arg geminiQualification "$SC_GEMINI_QUALIFICATION_SHA256" \
    --arg geminiStateSchema "$SC_GEMINI_ADAPTER_STATE_SCHEMA" \
    '{provider_mode:$providerMode,requested_model:$requestedModel,remote_name:$remoteName,
      remote_auto:$remoteAuto,gemini_auto:$geminiAuto,gemini_candidates:$geminiCandidates,
      gemini_quota_rotation:$geminiQuotaRotation,
      gemini_account_start_policy:$geminiAccountStartPolicy,
      gemini_route_wait_seconds:$geminiRouteWait,
      gemini_descriptor_sha256:$geminiDescriptor,gemini_adapter_sha256:$geminiAdapter,
      gemini_qualification_sha256:$geminiQualification,gemini_state_schema:$geminiStateSchema}' |
    sc_atomic "$inference_fact" 400
  jq -cn \
    --argjson available "$SC_CAMPAIGN_AVAILABLE" \
    --argjson teamAvailable "$([[ $SC_CAMPAIGN_AVAILABLE == 1 || -n $SC_TEAM_MEMBER_NAME ]] && printf true || printf false)" \
    --arg memberName "$SC_TEAM_MEMBER_NAME" --arg memberCampaign "$SC_TEAM_MEMBER_CAMPAIGN_ID" \
    --argjson maxCount "$SC_CAMPAIGN_MAX_COUNT" --argjson maxTurns "$SC_CAMPAIGN_MAX_TURNS" \
    --arg inference "$SC_PROVIDER_MODE" \
    --argjson openrouterWorkers "$SC_CAMPAIGN_OPENROUTER_WORKERS" \
    --arg budgetGroup "$SC_CAMPAIGN_BUDGET_GROUP" \
    --arg budgetMetering "$([[ $SC_CAMPAIGN_STORAGE_BUDGET_MIB == null ]] && printf observed-tree-usage || printf fixed-ext4-filesystem-capacity)" \
    --argjson budgetMax "$([[ $SC_CAMPAIGN_STORAGE_BUDGET_MIB == null ]] && printf null || printf '%s' "$((SC_CAMPAIGN_STORAGE_BUDGET_MIB * 1024 * 1024))")" \
    '{available:$available,team_available:$teamAvailable,member_name:$memberName,
      member_campaign:$memberCampaign,max_count:$maxCount,max_turns:$maxTurns,
      inference_mode:$inference,openrouter_workers:$openrouterWorkers,
      budget_group:$budgetGroup,budget_metering:$budgetMetering,budget_max_bytes:$budgetMax}' |
    sc_atomic "$campaign_fact" 400
  sc_owned_single_file "$identity_fact" 400 "agent contract identity facts"
  sc_owned_single_file "$inference_fact" 400 "agent contract inference facts"
  sc_owned_single_file "$campaign_fact" 400 "agent contract campaign facts"
  jq -n \
    --slurpfile identityInput "$identity_fact" \
    --slurpfile inferenceInput "$inference_fact" \
    --slurpfile campaignInput "$campaign_fact" \
    --arg projectState "$SC_LOCAL" --arg workRoot "$SC_WORK" \
    --arg home "$SC_WORK/home" --arg tmp "$SC_AGENT_TMP_VISIBLE" --arg cache "$SC_WORK/cache" \
    --arg state "$SC_WORK/state" --arg agentBin "$SC_AGENT_BIN" \
    --arg launcher "$SC_LOCAL/launcher/sandcodex" \
    --arg campaignHelper "$SC_LOCAL/launcher/sandcodex-campaign" \
    --arg operatorHelper "$SC_AGENT_BIN/sandcodex-operator-service" \
    --arg operatorSocket "$SC_OPERATOR_SOCKET" --arg operatorName "$SC_OPERATOR_NAME" \
    --arg operatorDeclaration "$SC_OPERATOR_DECLARATION_SHA256" \
    --argjson operatorStopGrace "$SC_OPERATOR_STOP_GRACE_SECONDS" \
    --argjson operatorLogMax "$SC_OPERATOR_LOG_MAX_BYTES" \
    --argjson operatorAdapter "$operator_adapter" \
    --arg downloads "$SC_BROWSER_DOWNLOADS" --arg scratch "$SC_WORK/scratch" \
    --arg browserOutput "$SC_BROWSER_OUTPUT" --arg browserHome "$SC_BROWSER_HOME" \
    --arg desktopOutput "$SC_DESKTOP_OUTPUT" --arg desktopHome "$SC_DESKTOP_HOME" \
    --arg desktopGuide "$SC_WORK/agent/desktop-control.md" \
    --arg desktopHelper "$SC_LOCAL/launcher/desktop-mcp" \
    --arg glassttyHome "$SC_GLASSTTY_HOME" \
    --arg glassttyRuntimeHome "$SC_GLASSTTY_RUNTIME_HOME" --arg virtualenv "$SC_DEV_VENV" \
    --arg browserRefresh "$SC_BROWSER_REFRESH_HELPER" \
    --arg browserCommandSocket "$([[ $SC_BARE == 1 ]] && printf '' || printf %s "$SC_BROWSER_COMMAND_SOCKET")" \
    --arg browserRecoverySocket "$SC_BROWSER_RECOVERY_SOCKET" \
    --arg browserViewerSocket "$([[ $SC_BARE == 1 ]] && printf '' || printf %s "$SC_BROWSER_VIEWER_SOCKET")" \
    --arg desktopViewerSocket "$([[ $SC_BARE == 1 ]] && printf '' || printf %s "$SC_DESKTOP_VIEWER_SOCKET")" \
    --arg publishConfig "$([[ ${#SC_PUBLISH_SPECS[@]} -gt 0 ]] && printf /run/sandcodex/proxy-host/publish.json || true)" \
    --arg gitMode "$SC_GIT_MODE" --arg managedGit "$SC_WORK/vcs" \
    --arg gitExcludes "$git_excludes" --arg gitConfig "$SC_WORK/agent/gitconfig" \
    --arg npmCache "$SC_WORK/cache/npm" --arg nixProfile "$nix_profile" --arg nixScope "$nix_scope" \
    --arg nixRegistry "$SC_NIX_REGISTRY" --arg nixpkgs "$SC_NIXPKGS" \
    --arg loopInbox "$SC_LOOP_ROOT/inbox" --arg loopAcks "$SC_LOOP_ROOT/acks" \
    --arg loopStatus "$SC_LOOP_ROOT/status.json" \
    --arg campaignInbox "$SC_CAMPAIGN_LOCAL_ROOT/inbox" \
    --arg campaignAcks "$SC_CAMPAIGN_LOCAL_ROOT/acks" \
    --arg networkMode "$network_mode" \
    --argjson unrestrictedEgress "$unrestricted_egress" --argjson domains "$domains" \
    --arg node "$node_version" --arg npm "$npm_version" \
    --arg python "$python_version" --arg pip "$pip_version" --arg pytest "$pytest_version" \
    --arg jsonschema "$jsonschema_version" --arg libxkbcommon "$SC_LIBXKBCOMMON_VERSION" --arg grimVersion "$SC_GRIM_VERSION" \
    --argjson browser "$([[ $SC_BROWSER == 1 ]] && printf true || printf false)" \
    --argjson desktop "$([[ $SC_DESKTOP == 1 ]] && printf true || printf false)" \
    --argjson desktopHeadful "$([[ $SC_HEADFUL == 1 ]] && printf true || printf false)" \
    --argjson resourceScope "$([[ $SC_RESOURCE_SCOPE == 1 ]] && printf true || printf false)" \
    --arg resourceTransport "$resource_transport" \
    --argjson desktopWidth "$SC_DESKTOP_WIDTH" --argjson desktopHeight "$SC_DESKTOP_HEIGHT" \
    --arg desktopBackend "$SC_DESKTOP_DISPLAY_BACKEND" \
    --argjson extensions "$extensions" --argjson bundle "$bundle" \
    --argjson nixDaemon "$nix_daemon" --argjson nixTrusted "$nix_trusted" \
    --argjson nixProfileOnPath "$nix_profile_on_path" \
    --argjson subagents "$SC_SUBAGENTS" --argjson agentDepth "$SC_AGENT_MAX_DEPTH" \
    --argjson agentThreads "$SC_AGENT_MAX_THREADS" \
    --argjson agentRuntime "$SC_AGENT_JOB_MAX_RUNTIME_SECONDS" \
    --argjson operatorAvailable "$SC_OPERATOR_ENABLED" \
    --arg nativeSource "$native_source" --argjson relayRequired "$SC_BROWSER_RELAY_REQUIRED" \
    --argjson reclaimedProjectIpc "$SC_RECLAIMED_PROJECT_IPC" \
    --slurpfile jail "$SC_JAIL_ENV" --slurpfile publish "$SC_PUBLISH_CONFIG" \
    "$(sc_emit_agent_contract_jq)" |
    sc_atomic "$SC_AGENT_ENV" 600
  rm -f -- "$identity_fact" "$inference_fact" "$campaign_fact"
  rmdir -- "$contract_fact_root" 2>/dev/null || true
}

sc_validate_project_work_state() {
  local marker="$SC_LOCAL/OWNER"
  sc_owned_dir "$SC_LOCAL" "project-local state"
  sc_owned_single_file "$marker" 600 "project ownership marker"
  sc_project_work_marker_matches "$marker" "$SC_PROJECT" "$SC_PROJECT_KEY" || \
    sc_die "project ownership marker does not match the selected project"
}

sc_validate_project_control_state() {
  local marker="$SC_CONTROL/OWNER"
  sc_owned_dir "$SC_CONTROL" "project control state"
  sc_owned_single_file "$marker" 600 "project control marker"
  sc_project_control_marker_matches "$SC_CONTROL" "$SC_PROJECT" "$SC_PROJECT_KEY" || \
    sc_die "project control marker does not match the selected project"
}

sc_project_state() {
  local marker="$SC_LOCAL/OWNER" bootstrap_fd attempt anchored=0
  for attempt in 1 2; do
    if [[ -e "$SC_LOCAL" || -L "$SC_LOCAL" ]]; then
      if [[ -L "$SC_LOCAL" || ! -d "$SC_LOCAL" ]]; then
        if sc_project_local_quarantine_allowed; then
          sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
            "not a real directory"
          continue
        fi
      fi
    fi
    sc_no_symlink_components "$SC_LOCAL" "project-local state"
    sc_ensure_dir "$SC_LOCAL" "project-local state"
    exec {bootstrap_fd}<"$SC_LOCAL" || sc_die "could not open project-local state for anchor locking"
    "$SC_FLOCK" --exclusive --timeout 5 "$bootstrap_fd" || \
      sc_die "timed out serializing the Sandcodex ownership anchor"
    if [[ -e "$marker" || -L "$marker" ]]; then
      if [[ ! -f "$marker" || -L "$marker" || \
        "$(stat -c %u -- "$marker" 2>/dev/null || true)" != "$(id -u)" || \
        "$(stat -c %h -- "$marker" 2>/dev/null || true)" != 1 ]]; then
        if ! sc_project_local_quarantine_allowed; then
          sc_owned_single_file "$marker" "" "project ownership marker"
        fi
        "$SC_FLOCK" --unlock "$bootstrap_fd"
        exec {bootstrap_fd}<&-
        sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
          "missing or invalid ownership marker"
        continue
      fi
      [[ "$(stat -c %a -- "$marker")" == 600 ]] || chmod 600 -- "$marker"
      sc_maybe_rebind_moved_project_state
      if ! sc_project_work_marker_matches "$marker" "$SC_PROJECT" "$SC_PROJECT_KEY"; then
        if ! sc_project_local_quarantine_allowed; then
          sc_validate_project_work_state
        fi
        "$SC_FLOCK" --unlock "$bootstrap_fd"
        exec {bootstrap_fd}<&-
        sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
          "ownership marker does not match this project"
        continue
      fi
      sc_validate_project_work_state
    else
      sc_atomic "$marker" 600 <<EOF
schema=$SC_SCHEMA
kind=project-work
uid=$(id -u)
project=$SC_PROJECT
project_key=$SC_PROJECT_KEY
EOF
      sc_validate_project_work_state
    fi
    "$SC_FLOCK" --unlock "$bootstrap_fd"
    exec {bootstrap_fd}<&-
    anchored=1
    break
  done
  (( anchored )) || sc_die "could not initialize fresh project-local state after quarantine"
  sc_ensure_dir "$SC_WORK" "project worker state"
  sc_ensure_dir "$SC_WORK/home" "project worker home"
  sc_ensure_dir "$SC_WORK/cache" "project worker cache"
  sc_ensure_dir "$SC_WORK/state" "project worker data"
  sc_ensure_dir "$SC_WORK/tmp" "project worker temporary state"
  SC_AGENT_TMP="$SC_WORK/tmp/$SC_RUN_ID"
  if (( SC_BARE )); then
    SC_AGENT_TMP_VISIBLE="$SC_AGENT_TMP"
  else
    SC_AGENT_TMP_VISIBLE="/run/sandcodex/tmp"
  fi
  sc_ensure_dir "$SC_AGENT_TMP" "per-run command temporary state"
  sc_ensure_dir "$SC_WORK/agent" "agent capability state"
  sc_ensure_dir "$SC_WORK/agent-bin" "protected agent helpers"
  sc_ensure_dir "$SC_WORK/dev" "development state"
  sc_ensure_dir "$SC_WORK/downloads" "durable browser downloads"
  sc_ensure_dir "$SC_WORK/scratch" "persistent agent scratch"
  sc_ensure_dir "$SC_WORK/browser-home" "isolated browser home"
  sc_ensure_dir "$SC_WORK/browser-output" "browser artifacts"
  sc_ensure_dir "$SC_LOOP_ROOT" "project loop state"
  sc_ensure_dir "$SC_LOOP_ROOT/inbox" "project loop inbox"
