        state->seat = NULL;
    }
    if (state->output != NULL) {
        wl_output_destroy(state->output);
        state->output = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
}

static int initialize_wayland(struct wayland_state *state) {
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            display_roundtrip(state) < 0 || state->manager == NULL || state->seat == NULL ||
            state->output == NULL || state->manager_version < 2U ||
            state->manager_count != 1U || state->seat_count != 1U || state->output_count != 1U) {
        errno = EPROTO;
        return -1;
    }
    state->pointer = zwlr_virtual_pointer_manager_v1_create_virtual_pointer_with_output(
        state->manager, state->seat, state->output);
    if (state->pointer == NULL || display_roundtrip(state) < 0) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int dispatch_command(struct wayland_state *state, const struct command *command) {
    const uint32_t timestamp = monotonic_milliseconds();
    switch (command->kind) {
    case COMMAND_MOTION:
        zwlr_virtual_pointer_v1_motion_absolute(state->pointer, timestamp,
            (uint32_t)command->values[0], (uint32_t)command->values[1],
            (uint32_t)command->values[2], (uint32_t)command->values[3]);
        zwlr_virtual_pointer_v1_frame(state->pointer);
        return display_roundtrip(state);
    case COMMAND_BUTTON: {
        const int button = command->values[0];
        const bool pressed = command->values[1] == 1;
        if ((pressed && state->held_button != 0) ||
                (!pressed && state->held_button != button)) {
            errno = EPROTO;
            return -1;
        }
        if (pressed) {
            /* Mark held before the roundtrip: delivery may precede a transport error. */
            state->held_button = button;
        }
        zwlr_virtual_pointer_v1_button(state->pointer, timestamp, protocol_button(button),
            pressed ? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED);
        zwlr_virtual_pointer_v1_frame(state->pointer);
        if (display_roundtrip(state) < 0) {
            return -1;
        }
        if (!pressed) {
            state->held_button = 0;
        }
        return 0;
    }
    case COMMAND_CLICK: {
        const int button = command->values[0];
        if (state->held_button != 0) {
            errno = EPROTO;
            return -1;
        }
        /* Keep the marker set until the compositor roundtrip confirms that the
         * complete press/release frame was consumed. If transport fails, final
         * cleanup attempts one more release before this process exits. */
        state->held_button = button;
        zwlr_virtual_pointer_v1_button(state->pointer, timestamp, protocol_button(button),
            WL_POINTER_BUTTON_STATE_PRESSED);
        zwlr_virtual_pointer_v1_button(state->pointer, timestamp, protocol_button(button),
            WL_POINTER_BUTTON_STATE_RELEASED);
        zwlr_virtual_pointer_v1_frame(state->pointer);
        if (display_roundtrip(state) < 0) {
            return -1;
        }
        state->held_button = 0;
        return 0;
    }
    case COMMAND_SCROLL:
        zwlr_virtual_pointer_v1_axis_source(state->pointer, WL_POINTER_AXIS_SOURCE_WHEEL);
        if (command->values[1] != 0) {
            zwlr_virtual_pointer_v1_axis_discrete(state->pointer, timestamp,
                WL_POINTER_AXIS_VERTICAL_SCROLL,
                wl_fixed_from_int(command->values[1] * SCROLL_FIXED_UNITS), command->values[1]);
        }
        if (command->values[0] != 0) {
            zwlr_virtual_pointer_v1_axis_discrete(state->pointer, timestamp,
                WL_POINTER_AXIS_HORIZONTAL_SCROLL,
                wl_fixed_from_int(command->values[0] * SCROLL_FIXED_UNITS), command->values[0]);
        }
        zwlr_virtual_pointer_v1_frame(state->pointer);
        return display_roundtrip(state);
    case COMMAND_PING:
        return display_roundtrip(state);
    case COMMAND_QUIT:
        return 0;
    }
    errno = EPROTO;
    return -1;
}

static int run_self_test(void) {
    struct command command = {0};
    char motion[] = "1 MOTION 0 0 1440 900\n";
    char button_down[] = "2 BUTTON 1 1\n";
    char button_up[] = "3 BUTTON 1 0\n";
    char click[] = "4 CLICK 3\n";
    char scroll[] = "5 SCROLL -1 1\n";
    char ping[] = "6 PING\n";
    char quit[] = "7 QUIT\n";
    char invalid_sequence[] = "9 PING\n";
    char invalid_extent[] = "8 MOTION 1440 0 1440 900\n";
    if (!parse_command(motion, 1U, &command) || command.kind != COMMAND_MOTION ||
            !parse_command(button_down, 2U, &command) || command.kind != COMMAND_BUTTON ||
            !parse_command(button_up, 3U, &command) || command.kind != COMMAND_BUTTON ||
            !parse_command(click, 4U, &command) || command.kind != COMMAND_CLICK ||
            !parse_command(scroll, 5U, &command) || command.kind != COMMAND_SCROLL ||
            !parse_command(ping, 6U, &command) || command.kind != COMMAND_PING ||
            !parse_command(quit, 7U, &command) || command.kind != COMMAND_QUIT ||
            parse_command(invalid_sequence, 8U, &command) ||
            parse_command(invalid_extent, 8U, &command) ||
            protocol_button(1) != BTN_LEFT_CODE || protocol_button(2) != BTN_MIDDLE_CODE ||
            protocol_button(3) != BTN_RIGHT_CODE || protocol_button(4) != 0U) {
        fputs("sandcodex-wayland-pointer-agent: self-test failed\n", stderr);
        return 1;
    }
    printf("{\"schema\":\"sandcodex.pointer-agent-self-test.v1\","
           "\"protocol\":\"%s\",\"ok\":true}\n", AGENT_PROTOCOL);
    return 0;
}

int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc != 1) {
        fprintf(stderr, "usage: %s [--self-test|--version]\n", argv[0]);
        return 64;
    }

    struct sigaction action = {0};
    action.sa_handler = on_signal;
    sigemptyset(&action.sa_mask);
    if (sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0 ||
            sigaction(SIGHUP, &action, NULL) < 0) {
        perror("sandcodex-wayland-pointer-agent: sigaction");
        return 1;
    }
    struct sigaction ignore = {0};
    ignore.sa_handler = SIG_IGN;
    sigemptyset(&ignore.sa_mask);
    if (sigaction(SIGPIPE, &ignore, NULL) < 0) {
        perror("sandcodex-wayland-pointer-agent: sigaction SIGPIPE");
        return 1;
    }

    struct wayland_state state = {0};
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-pointer-agent: Wayland initialization");
        destroy_wayland(&state);
        return 69;
    }
    if (printf("READY %s %ld\n", AGENT_PROTOCOL, (long)getpid()) < 0 || fflush(stdout) == EOF) {
        (void)release_held_button(&state);
        destroy_wayland(&state);
        return 74;
    }

    uint64_t expected_sequence = 1U;
    int result = 0;
    while (!stop_requested) {
        char line[MAX_LINE_BYTES + 2U] = {0};
        errno = 0;
        if (fgets(line, (int)sizeof(line), stdin) == NULL) {
            if (stop_requested || feof(stdin)) {
                break;
            }
            if (errno == EINTR) {
                clearerr(stdin);
                continue;
            }
            result = 74;
            break;
        }
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n') {
            fprintf(stdout, "ERR %" PRIu64 " malformed-command HELD %d\n", expected_sequence, state.held_button);
            (void)fflush(stdout);
            result = 65;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            fprintf(stdout, "ERR %" PRIu64 " malformed-command HELD %d\n", expected_sequence, state.held_button);
            (void)fflush(stdout);
            result = 65;
            break;
        }
        if (command.kind == COMMAND_QUIT) {
            if (state.held_button != 0 && release_held_button(&state) < 0) {
                fprintf(stdout, "ERR %" PRIu64 " held-release-failed HELD %d\n",
                    command.sequence, state.held_button);
                (void)fflush(stdout);
                result = 70;
                break;
            }
            if (destroy_virtual_pointer(&state) < 0) {
                fprintf(stdout, "ERR %" PRIu64 " device-destroy-failed HELD 0\n",
                    command.sequence);
                (void)fflush(stdout);
                result = 70;
                break;
            }
            fprintf(stdout, "BYE %" PRIu64 " HELD 0\n", command.sequence);
            (void)fflush(stdout);
            expected_sequence++;
            break;
        }
        if (dispatch_command(&state, &command) < 0) {
            fprintf(stdout, "ERR %" PRIu64 " wayland-dispatch-failed HELD %d\n",
                command.sequence, state.held_button);
            (void)fflush(stdout);
            result = 70;
            break;
        }
        fprintf(stdout, "OK %" PRIu64 " HELD %d\n", command.sequence, state.held_button);
        if (fflush(stdout) == EOF) {
            result = 74;
            break;
        }
        expected_sequence++;
    }

    if (state.held_button != 0 && release_held_button(&state) < 0) {
        result = result == 0 ? 70 : result;
    }
    destroy_wayland(&state);
    return result;
}
WAYLAND_POINTER_AGENT_C
}

