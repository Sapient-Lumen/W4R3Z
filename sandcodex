sc_campaign_source_git_json() {
  local git_dir marker="" marker_sha="" marker_identity=""
  sc_owned_dir "$SC_PROJECT" "campaign source worktree"
  sc_no_symlink_components "$SC_PROJECT" "campaign source worktree"
  case "$SC_GIT_MODE" in
    native)
      git_dir="$SC_PROJECT/.git"
      if [[ ! -e "$git_dir" && ! -L "$git_dir" ]]; then
        printf 'null\n'
        return 0
      fi
      sc_no_symlink_components "$git_dir" "campaign source Git directory"
      sc_owned_dir "$git_dir" "campaign source Git directory"
      ;;
    managed)
      git_dir="$SC_WORK/vcs"
      marker="$git_dir/SANDCODEX_MANAGED_VCS"
      [[ "$git_dir" == "$SC_PROJECT/.sandcodex/work/vcs" ]] || \
        sc_die "managed campaign source Git path escaped project state"
      sc_no_symlink_components "$git_dir" "managed campaign source Git directory"
      sc_owned_dir "$git_dir" "managed campaign source Git directory"
      sc_owned_single_file "$marker" 600 "managed campaign source Git marker"
      grep -Fx "project=$SC_PROJECT" "$marker" >/dev/null || \
        sc_die "managed campaign source Git belongs to another project"
      grep -Fx "uid=$(id -u)" "$marker" >/dev/null || \
        sc_die "managed campaign source Git belongs to another user"
      [[ "$(wc -l <"$marker")" == 2 ]] || \
        sc_die "managed campaign source Git marker is malformed"
      marker_sha="$(sha256sum -- "$marker" | awk '{print $1}')"
      marker_identity="$(stat -c '%d:%i' -- "$marker")"
      ;;
    *)
      sc_die "campaign source Git mode is invalid"
      ;;
  esac
  jq -cn \
    --arg mode "$SC_GIT_MODE" --arg work_tree "$SC_PROJECT" --arg git_dir "$git_dir" \
    --arg work_tree_identity "$(stat -c '%d:%i' -- "$SC_PROJECT")" \
    --arg work_tree_mode "$(stat -c '%a' -- "$SC_PROJECT")" \
    --arg git_dir_identity "$(stat -c '%d:%i' -- "$git_dir")" \
    --arg git_dir_mode "$(stat -c '%a' -- "$git_dir")" \
    --arg marker_path "$marker" --arg marker_sha256 "$marker_sha" \
    --arg marker_identity "$marker_identity" \
    '{mode:$mode,work_tree:$work_tree,git_dir:$git_dir,
      work_tree_identity:$work_tree_identity,work_tree_mode:$work_tree_mode,
      git_dir_identity:$git_dir_identity,git_dir_mode:$git_dir_mode,
      marker_path:(if $marker_path == "" then null else $marker_path end),
      marker_sha256:(if $marker_sha256 == "" then null else $marker_sha256 end),
      marker_identity:(if $marker_identity == "" then null else $marker_identity end)}'
}

sc_prepare_campaign_storage_budget() {
  local selection="$SC_GLOBAL/campaign-storage/$SC_PROJECT_KEY/selection.json"
  if [[ -e "$selection" || -L "$selection" ]]; then
    sc_owned_single_file "$selection" 600 "campaign storage selection"
    local selected_group selected_mib
    selected_group="$(jq -er --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" '
        select(.schema == $schema and .kind == "campaign-storage-selection" and
          .project == $project and .project_key == $key and
          (.group | type == "string") and (.maximum_mib | type == "number"))
        | .group
      ' "$selection")" || sc_die "campaign storage selection is invalid"
    selected_mib="$(jq -r '.maximum_mib' "$selection")"
    [[ "$selected_group" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ &&
      "$selected_mib" =~ ^[1-9][0-9]*$ &&
      "$selected_mib" -ge 64 && "$selected_mib" -le "$SC_CAMPAIGN_MAX_STORAGE_MIB" ]] ||
      sc_die "campaign storage selection fields are invalid"
    if [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" == null ]]; then
      SC_CAMPAIGN_STORAGE_BUDGET_MIB="$selected_mib"
      SC_CAMPAIGN_BUDGET_GROUP="$selected_group"
      sc_note "companion storage · reusing reviewed group $selected_group · ${selected_mib} MiB"
    elif [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != "$selected_mib" ||
      "$SC_CAMPAIGN_BUDGET_GROUP" != "$selected_group" ]]; then
      sc_die "campaign storage selection differs from this project's existing reviewed budget"
    fi
  fi
  SC_CAMPAIGN_STATE_ROOT="$SC_GLOBAL/campaigns/$SC_PROJECT_KEY"
  SC_CAMPAIGN_WORKSPACE_ROOT="${SC_GLOBAL}-workspaces"
  SC_CAMPAIGN_ENGINE_HOME="$SC_GLOBAL/campaign-home"
  SC_CAMPAIGN_WORKER_GLOBAL="$SC_GLOBAL"
  [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null ]] || return 0

  local group_root metadata image_tmp expected_bytes mounted=0 reused_mount=0
  local group_token fuse_bin service_load service_state
  group_root="$SC_GLOBAL/campaign-storage/$SC_PROJECT_KEY/$SC_CAMPAIGN_BUDGET_GROUP"
  SC_CAMPAIGN_STORAGE_IMAGE="$group_root/storage.ext4"
  SC_CAMPAIGN_STORAGE_MOUNT="$group_root/mount"
  group_token="$(printf '%s\0' "$SC_CAMPAIGN_BUDGET_GROUP" | sha256sum | awk '{print substr($1,1,12)}')"
  SC_CAMPAIGN_STORAGE_UNIT="sandcodex-campaign-storage-${SC_PROJECT_KEY:0:16}-$group_token.service"
  sc_ensure_dir "$SC_GLOBAL/campaign-storage" "campaign storage root"
  sc_ensure_dir "$SC_GLOBAL/campaign-storage/$SC_PROJECT_KEY" "project campaign storage root"
  sc_ensure_dir "$group_root" "campaign storage budget group"
  sc_ensure_dir "$SC_CAMPAIGN_STORAGE_MOUNT" "campaign storage mountpoint"
  metadata="$group_root/group.json"
  expected_bytes=$((SC_CAMPAIGN_STORAGE_BUDGET_MIB * 1024 * 1024))
  if mountpoint -q -- "$SC_CAMPAIGN_STORAGE_MOUNT"; then
    reused_mount=1
  fi
  if [[ -e "$SC_CAMPAIGN_STORAGE_IMAGE" || -L "$SC_CAMPAIGN_STORAGE_IMAGE" ]]; then
    sc_owned_single_file "$SC_CAMPAIGN_STORAGE_IMAGE" 600 "campaign storage image"
    [[ "$(stat -c %s -- "$SC_CAMPAIGN_STORAGE_IMAGE")" == "$expected_bytes" ]] ||
      sc_die "campaign storage image size differs from its reviewed budget"
    [[ -f "$metadata" && ! -L "$metadata" ]] ||
      sc_die "campaign storage group metadata is missing"
    jq -e --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" --arg group "$SC_CAMPAIGN_BUDGET_GROUP" \
      --arg mount_unit "$SC_CAMPAIGN_STORAGE_UNIT" \
      --argjson maximum "$expected_bytes" '
        .schema == $schema and .kind == "campaign-storage-budget-group" and
        .project == $project and .project_key == $key and .group == $group and
        .maximum_bytes == $maximum and .metering == "fixed-ext4-filesystem-capacity" and
        .mount_unit == $mount_unit
      ' "$metadata" >/dev/null ||
      sc_die "campaign storage group does not match this project or requested budget"
  else
    [[ ! -e "$metadata" && ! -L "$metadata" ]] ||
      sc_die "campaign storage metadata exists without its image"
    image_tmp="$(mktemp "$group_root/.storage.XXXXXX")"
    chmod 600 -- "$image_tmp"
    truncate -s "$expected_bytes" -- "$image_tmp"
    if ! mkfs.ext4 -F -q -m 0 -O '^has_journal' \
      -E "root_owner=$(id -u):$(id -g)" -- "$image_tmp"; then
      rm -f -- "$image_tmp"
      sc_die "could not initialize the hard campaign storage budget"
    fi
    mv -fT -- "$image_tmp" "$SC_CAMPAIGN_STORAGE_IMAGE"
    jq -n --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" --arg group "$SC_CAMPAIGN_BUDGET_GROUP" \
      --arg mount_unit "$SC_CAMPAIGN_STORAGE_UNIT" \
      --arg created "$(sc_now)" --argjson maximum "$expected_bytes" '{
        schema:$schema,kind:"campaign-storage-budget-group",project:$project,
        project_key:$key,group:$group,maximum_bytes:$maximum,
        metering:"fixed-ext4-filesystem-capacity",mount_unit:$mount_unit,created_at:$created
      }' | sc_atomic "$metadata" 600
  fi
  if [[ ! -e "$selection" && ! -L "$selection" ]]; then
    jq -n --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" --arg group "$SC_CAMPAIGN_BUDGET_GROUP" \
      --arg selected "$(sc_now)" --argjson maximum_mib "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" '{
        schema:$schema,kind:"campaign-storage-selection",project:$project,
        project_key:$key,group:$group,maximum_mib:$maximum_mib,selected_at:$selected
      }' | sc_atomic "$selection" 600
  fi
  if (( reused_mount )); then
    findmnt --json --mountpoint "$SC_CAMPAIGN_STORAGE_MOUNT" \
      --output TARGET,SOURCE,FSTYPE,OPTIONS |
      jq -e --arg target "$SC_CAMPAIGN_STORAGE_MOUNT" \
        --arg source "$SC_CAMPAIGN_STORAGE_IMAGE" '
          (.filesystems | length) == 1 and
          .filesystems[0].target == $target and
          .filesystems[0].source == $source and
          .filesystems[0].fstype == "fuse.ext4" and
          (.filesystems[0].options | split(",") | index("default_permissions")) != null
        ' >/dev/null ||
      sc_die "campaign storage mount identity does not match its reviewed image"
    [[ -n "$SC_SYSTEMCTL" && -x "$SC_SYSTEMCTL" ]] ||
      sc_die "campaign storage mount validation requires the user systemd manager"
    "$SC_SYSTEMCTL" --user is-active --quiet "$SC_CAMPAIGN_STORAGE_UNIT" ||
      sc_die "campaign storage mount exists without its broker-owned service"
    mounted=1
  else
    [[ -n "$SC_SYSTEMD_RUN" && -x "$SC_SYSTEMD_RUN" &&
      -n "$SC_SYSTEMCTL" && -x "$SC_SYSTEMCTL" ]] ||
      sc_die "finite companion storage requires the user systemd manager"
    fuse_bin="$(command -v fuse2fs)"
    for _ in {1..100}; do
      service_load="$("$SC_SYSTEMCTL" --user show "$SC_CAMPAIGN_STORAGE_UNIT" \
        --property LoadState --value 2>/dev/null || true)"
      [[ -z "$service_load" || "$service_load" == not-found ]] && break
      service_state="$("$SC_SYSTEMCTL" --user show "$SC_CAMPAIGN_STORAGE_UNIT" \
        --property ActiveState --value 2>/dev/null || true)"
      case "$service_state" in
        inactive|failed|deactivating)
          "$SC_SYSTEMCTL" --user reset-failed "$SC_CAMPAIGN_STORAGE_UNIT" >/dev/null 2>&1 || true
          sleep 0.05
          ;;
        *) sc_die "campaign storage service is active without its reviewed mount" ;;
      esac
    done
    [[ -z "$service_load" || "$service_load" == not-found ]] ||
      sc_die "previous campaign storage service was not collected"
    "$SC_SYSTEMD_RUN" --user --quiet --collect --unit "$SC_CAMPAIGN_STORAGE_UNIT" \
      -p Type=exec -p KillMode=mixed -- \
      "$fuse_bin" -f "$SC_CAMPAIGN_STORAGE_IMAGE" "$SC_CAMPAIGN_STORAGE_MOUNT" \
      -o fakeroot,default_permissions,noatime >/dev/null 2>&1 ||
      sc_die "could not mount the hard campaign storage budget"
    SC_CAMPAIGN_STORAGE_MOUNTED=1
    for _ in {1..100}; do
      if mountpoint -q -- "$SC_CAMPAIGN_STORAGE_MOUNT"; then mounted=1; break; fi
      sleep 0.02
    done
    if (( ! mounted )); then
      sc_unmount_campaign_storage
      sc_die "hard campaign storage budget did not become active"
    fi
    if ! "$SC_SYSTEMCTL" --user is-active --quiet "$SC_CAMPAIGN_STORAGE_UNIT"; then
      sc_unmount_campaign_storage
      sc_die "campaign storage service exited after mounting"
    fi
  fi
  SC_CAMPAIGN_STATE_ROOT="$SC_CAMPAIGN_STORAGE_MOUNT/principals"
  SC_CAMPAIGN_WORKSPACE_ROOT="$SC_CAMPAIGN_STORAGE_MOUNT/workspaces"
  SC_CAMPAIGN_ENGINE_HOME="$SC_CAMPAIGN_STORAGE_MOUNT/engine-home"
  SC_CAMPAIGN_WORKER_GLOBAL="$SC_CAMPAIGN_STORAGE_MOUNT/worker-global"
  mkdir -p -- "$SC_CAMPAIGN_STATE_ROOT" "$SC_CAMPAIGN_WORKSPACE_ROOT" \
    "$SC_CAMPAIGN_ENGINE_HOME" "$SC_CAMPAIGN_WORKER_GLOBAL"
  chmod 700 -- "$SC_CAMPAIGN_STATE_ROOT" "$SC_CAMPAIGN_WORKSPACE_ROOT" \
    "$SC_CAMPAIGN_ENGINE_HOME" "$SC_CAMPAIGN_WORKER_GLOBAL"
  sc_note "companion storage · group $SC_CAMPAIGN_BUDGET_GROUP · hard limit ${SC_CAMPAIGN_STORAGE_BUDGET_MIB} MiB"
}

sc_remove_campaign_storage_budget() {
  [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null ]] || return 0
  local project_root group_root metadata selection
  project_root="$SC_GLOBAL/campaign-storage/$SC_PROJECT_KEY"
  group_root="$project_root/$SC_CAMPAIGN_BUDGET_GROUP"
  metadata="$group_root/group.json"
  selection="$project_root/selection.json"

  sc_owned_dir "$project_root" "project campaign storage root"
  sc_owned_dir "$group_root" "campaign storage budget group"
  sc_owned_dir "$SC_CAMPAIGN_STORAGE_MOUNT" "campaign storage mountpoint"
  sc_owned_single_file "$SC_CAMPAIGN_STORAGE_IMAGE" 600 "campaign storage image"
  sc_owned_single_file "$metadata" 600 "campaign storage metadata"
  sc_owned_single_file "$selection" 600 "campaign storage selection"
  findmnt --json --mountpoint "$SC_CAMPAIGN_STORAGE_MOUNT" \
    --output TARGET,SOURCE,FSTYPE,OPTIONS |
    jq -e --arg target "$SC_CAMPAIGN_STORAGE_MOUNT" \
      --arg source "$SC_CAMPAIGN_STORAGE_IMAGE" '
        (.filesystems | length) == 1 and
        .filesystems[0].target == $target and
        .filesystems[0].source == $source and
        .filesystems[0].fstype == "fuse.ext4" and
        (.filesystems[0].options | split(",") | index("default_permissions")) != null
      ' >/dev/null ||
    sc_die "campaign storage cleanup refused an unexpected mount identity"

  SC_CAMPAIGN_STORAGE_MOUNTED=1
  sc_unmount_campaign_storage
  for _ in {1..100}; do
    mountpoint -q -- "$SC_CAMPAIGN_STORAGE_MOUNT" || break
    sleep 0.02
  done
  mountpoint -q -- "$SC_CAMPAIGN_STORAGE_MOUNT" &&
    sc_die "campaign storage cleanup could not unmount the reviewed image"
  [[ -z "$(find -P "$SC_CAMPAIGN_STORAGE_MOUNT" -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
    sc_die "campaign storage cleanup exposed unexpected files below the mountpoint"

  rm -f -- "$SC_CAMPAIGN_STORAGE_IMAGE" "$metadata" "$selection"
  rmdir -- "$SC_CAMPAIGN_STORAGE_MOUNT" "$group_root" "$project_root" ||
    sc_die "campaign storage cleanup found unexpected retained state"
  rmdir -- "$SC_GLOBAL/campaign-storage" 2>/dev/null || true
  sc_ok "removed finite companion storage group $SC_CAMPAIGN_BUDGET_GROUP"
}

sc_seed_campaign_worker_auth() {
  [[ "$SC_PROVIDER_MODE" != local ]] || return 0
  [[ "$SC_CAMPAIGN_WORKER_GLOBAL" != "$SC_GLOBAL" ]] || return 0
  local source="$SC_GLOBAL/auth-home/auth.json"
  local target_root="$SC_CAMPAIGN_WORKER_GLOBAL/auth-home"
  local target="$target_root/auth.json"
  sc_valid_auth "$source" || sc_die "campaign worker requires a valid trusted authentication cache"
  sc_ensure_dir "$target_root" "campaign worker authentication state"
  if [[ -e "$target" || -L "$target" ]]; then
    sc_valid_auth "$target" || sc_die "campaign worker authentication cache is unsafe or invalid"
    return 0
  fi
  sc_atomic "$target" 600 <"$source"
  sc_valid_auth "$target" || sc_die "campaign worker authentication cache could not be seeded safely"
}

sc_prepare_openrouter_worker_inferences() {
  local source staged copied digest saved_keybank_path stage_rc=0
  SC_CAMPAIGN_OPENROUTER_WORKERS=0
  if [[ -n "$SC_REMOTE_AUTO_KEYBANK_COPY" && -f "$SC_REMOTE_AUTO_KEYBANK_COPY" ]]; then
    source=$SC_REMOTE_AUTO_KEYBANK_COPY
  else
    source="$(sc_remote_keybank_default_path)"
    if [[ ! -e "$source" && ! -L "$source" ]]; then
      printf '{}\n'
      return 0
    fi
  fi
  saved_keybank_path=$SC_REMOTE_KEYBANK_PATH
  SC_REMOTE_KEYBANK_PATH=$source
  staged="$(sc_remote_keybank_stage)" || stage_rc=$?
  SC_REMOTE_KEYBANK_PATH=$saved_keybank_path
  if (( stage_rc != 0 )); then
    sc_warn "OpenRouter worker route disabled because the trusted key bank failed validation"
    printf '{}\n'
    return 0
  fi
  source="$(jq -er '.path' <<<"$staged")"
  copied="$SC_CONTROL/openrouter-worker-key-bank.txt"
  if [[ "$source" != "$copied" ]]; then
    cat -- "$source" | sc_atomic "$copied" 600
  fi
  sc_remote_keybank_unstage "$staged"
  sc_owned_single_file "$copied" 600 "delegated OpenRouter worker key bank"
  digest="$(sha256sum -- "$copied" | awk '{print $1}')"
  SC_CAMPAIGN_OPENROUTER_WORKERS=1
  jq -cn --arg key_bank "$copied" --arg key_bank_sha "$digest" \
    --arg profile "$SC_REMOTE_PROFILE_DEFAULT" '
      {openrouter:{mode:"remote",requested_model:"openrouter/free",
        parent_provider_contract:null,parent_provider_contract_sha256:null,
        auto:{enabled:true,key_bank_file:$key_bank,key_bank_sha256:$key_bank_sha,
          profile:$profile}}}'
}

sc_prepare_campaign_authority() {
  local jail_network="$SC_JAIL_NETWORK_CEILING" worker_json provider_json domains_json source_git_json inference_json
  local worker_inferences_json
  local campaign_min_free="$SC_LOOP_MIN_FREE_MIB" finite_reserve
  local -a worker=()
  SC_CAMPAIGN_OPENROUTER_WORKERS=0
  if (( SC_CAMPAIGN_MAX_COUNT == 0 )); then
    SC_CAMPAIGN_AVAILABLE=0
    SC_CAMPAIGN_AUTHORITY=""
    return 0
  fi
  if [[ "$SC_GIT_MODE" == native && ! -d "$SC_PROJECT/.git" ]]; then
    if [[ -f "$SC_WORK/vcs/SANDCODEX_MANAGED_VCS" && ! -L "$SC_WORK/vcs/SANDCODEX_MANAGED_VCS" ]]; then
      SC_GIT_MODE=managed
    else
      SC_CAMPAIGN_AVAILABLE=0
      SC_CAMPAIGN_AUTHORITY=""
      sc_debug "companion campaigns are unavailable until this project has initialized Git state"
      return 0
    fi
  fi
  sc_prepare_campaign_storage_budget
  sc_seed_campaign_worker_auth
  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    sc_write_local_parent_provider_contract
    inference_json=$(jq -cn --arg mode local --arg requested_model "$SC_LOCAL_REQUESTED_MODEL" \
      --arg contract "$SC_CAMPAIGN_PROVIDER_CONTRACT" \
      --arg contract_sha256 "$(sha256sum -- "$SC_CAMPAIGN_PROVIDER_CONTRACT" | awk '{print $1}')" \
      '{mode:$mode,requested_model:$requested_model,parent_provider_contract:$contract,
        parent_provider_contract_sha256:$contract_sha256}')
  elif [[ "$SC_PROVIDER_MODE" == remote ]]; then
    sc_write_remote_parent_provider_contract
    local remote_auto_keybank_sha=""
    if (( SC_REMOTE_AUTO )); then
      [[ -n "$SC_REMOTE_AUTO_KEYBANK_COPY" ]] ||
        sc_die "remote-auto companion inference requires the copied key bank" 78
      remote_auto_keybank_sha="$(sha256sum -- "$SC_REMOTE_AUTO_KEYBANK_COPY" | awk '{print $1}')"
    fi
    inference_json=$(jq -cn --arg mode remote --arg requested_model "$SC_MODEL" \
      --arg contract "$SC_CAMPAIGN_PROVIDER_CONTRACT" \
      --arg contract_sha256 "$(sha256sum -- "$SC_CAMPAIGN_PROVIDER_CONTRACT" | awk '{print $1}')" \
      --argjson auto_enabled "$SC_REMOTE_AUTO" --arg auto_key_bank "$SC_REMOTE_AUTO_KEYBANK_COPY" \
      --arg auto_key_bank_sha "$remote_auto_keybank_sha" --arg auto_profile "$SC_REMOTE_PROFILE" \
      '{mode:$mode,requested_model:$requested_model,parent_provider_contract:$contract,
        parent_provider_contract_sha256:$contract_sha256,
        auto:{enabled:($auto_enabled == 1),
              key_bank_file:(if $auto_key_bank=="" then null else $auto_key_bank end),
              key_bank_sha256:(if $auto_key_bank_sha=="" then null else $auto_key_bank_sha end),
              profile:$auto_profile}}')
  elif [[ "$SC_PROVIDER_MODE" == gemini ]]; then
    sc_write_gemini_parent_provider_contract
    inference_json=$(jq -cn --arg mode gemini --arg requested_model "$SC_MODEL" \
      --arg contract "$SC_CAMPAIGN_PROVIDER_CONTRACT" \
      --arg contract_sha256 "$(sha256sum -- "$SC_CAMPAIGN_PROVIDER_CONTRACT" | awk '{print $1}')" \
      '{mode:$mode,requested_model:$requested_model,parent_provider_contract:$contract,
        parent_provider_contract_sha256:$contract_sha256}')
  else
    inference_json=$(jq -cn --arg mode gpt '{mode:$mode,requested_model:null,
      parent_provider_contract:null,parent_provider_contract_sha256:null}')
  fi
  worker_inferences_json="$(sc_prepare_openrouter_worker_inferences)"
  if jq -e 'has("openrouter")' <<<"$worker_inferences_json" >/dev/null; then
    SC_CAMPAIGN_OPENROUTER_WORKERS=1
  else
    SC_CAMPAIGN_OPENROUTER_WORKERS=0
  fi
  SC_CAMPAIGN_AVAILABLE=1
  SC_CAMPAIGN_AUTHORITY="$SC_CONTROL/campaign-authority.json"
  sc_campaign_reset_requests
  (( SC_DEV_NET )) && worker+=(--dev-network) || worker+=(--restricted-network)
  if [[ "$jail_network" == host ]]; then jail_network=outer; fi
  worker+=(--jail-network "$jail_network")
  [[ $SC_JAIL_TIMEOUT_CEILING == null ]] || worker+=(--jail-max-timeout "$SC_JAIL_TIMEOUT_CEILING")
  [[ $SC_JAIL_CPU_CEILING == null ]] || worker+=(--jail-max-cpu "$SC_JAIL_CPU_CEILING")
  [[ $SC_JAIL_MEMORY_CEILING == null ]] || worker+=(--jail-max-memory "$SC_JAIL_MEMORY_CEILING")
  [[ $SC_JAIL_SWAP_CEILING == null ]] || worker+=(--jail-max-swap "$SC_JAIL_SWAP_CEILING")
  [[ $SC_JAIL_PIDS_CEILING == null ]] || worker+=(--jail-max-pids "$SC_JAIL_PIDS_CEILING")
  [[ $SC_JAIL_FILE_CEILING_MIB == null ]] || worker+=(--jail-max-file "$SC_JAIL_FILE_CEILING_MIB")
  [[ $SC_JAIL_TMP_CEILING_MIB == null ]] || worker+=(--jail-max-tmp "$SC_JAIL_TMP_CEILING_MIB")
  [[ $SC_JAIL_HOME_CEILING_MIB == null ]] || worker+=(--jail-max-home "$SC_JAIL_HOME_CEILING_MIB")
  [[ $SC_JAIL_STORAGE_BUDGET_MIB == null ]] || worker+=(--jail-storage-budget "$SC_JAIL_STORAGE_BUDGET_MIB")
  worker+=(--jail-budget-group "$SC_JAIL_BUDGET_GROUP")
  (( ! SC_BARE && ! SC_RESOURCE_SCOPE )) && worker+=(--no-resource-scope)
  case "$SC_NIX_DAEMON_MODE" in allow) worker+=(--nix-daemon);; deny) worker+=(--no-nix-daemon);; esac
  (( ! SC_TRUST_PROJECT )) || worker+=(--trust-project-config)
  (( SC_SUBAGENTS )) && worker+=(--subagents) || worker+=(--no-subagents)
  worker+=(--agent-depth "$SC_AGENT_MAX_DEPTH" --agent-threads "$SC_AGENT_MAX_THREADS")
  [[ "$SC_PROVIDER_MODE" != gpt ]] || (( ! SC_MODEL_SET )) || worker+=(--model "$SC_MODEL")
  (( ! SC_EFFORT_SET )) || worker+=(--effort "$SC_EFFORT")
  worker+=(--no-companion-campaigns)
  if [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null ]]; then
    finite_reserve=$((SC_CAMPAIGN_STORAGE_BUDGET_MIB / 16))
    (( finite_reserve >= 8 )) || finite_reserve=8
    (( campaign_min_free <= finite_reserve )) || campaign_min_free="$finite_reserve"
  fi
  worker+=(--retry-limit "$SC_LOOP_RETRY_LIMIT" --retry-base-seconds "$SC_LOOP_RETRY_BASE_SECONDS"
    --retry-max-seconds "$SC_LOOP_RETRY_MAX_SECONDS"
    --retry-max-wait-seconds "$SC_LOOP_RETRY_MAX_WAIT_SECONDS"
    --min-free-mib "$campaign_min_free"
    --max-project-growth-mib "$SC_LOOP_MAX_PROJECT_GROWTH_MIB"
    --max-downloads-mib "$SC_LOOP_MAX_DOWNLOADS_MIB"
    --max-profile-mib "$SC_LOOP_MAX_PROFILE_MIB")
  local domain
  for domain in "${SC_DOMAINS[@]}"; do worker+=(--allow-domain "$domain"); done
  worker_json="$(jq -cn --args '$ARGS.positional' -- "${worker[@]}")"
  provider_json="$(jq -cn --args '$ARGS.positional' -- "${SC_CODEX_ARGS[@]}")"
  domains_json="$(jq -cn --args '$ARGS.positional' -- "${SC_DOMAINS[@]}")"
  source_git_json="$(sc_campaign_source_git_json)"
  [[ "$source_git_json" != null ]] || sc_die "campaign launch authority requires initialized Git state"
  jq -n \
    --arg schema "$SC_CAMPAIGN_AUTHORITY_SCHEMA" --arg run_id "$SC_RUN_ID" \
    --arg project "$SC_PROJECT" --arg project_key "$SC_PROJECT_KEY" \
    --arg global_root "$SC_GLOBAL" --arg campaign_root "$SC_CAMPAIGN_STATE_ROOT" \
    --arg workspace_root "$SC_CAMPAIGN_WORKSPACE_ROOT" \
    --arg launcher "$SC_CAMPAIGN_LAUNCHER" --arg artifact_sha256 "$(sc_artifact_sha256)" \
    --arg host_path "$SC_CAMPAIGN_RUNTIME_PATH" --arg home "$SC_REAL_HOME" \
    --arg engine_home "$SC_CAMPAIGN_ENGINE_HOME" --arg worker_global "$SC_CAMPAIGN_WORKER_GLOBAL" \
    --arg budget_group "$SC_CAMPAIGN_BUDGET_GROUP" \
    --arg budget_metering "$([[ $SC_CAMPAIGN_STORAGE_BUDGET_MIB == null ]] && printf observed-tree-usage || printf fixed-ext4-filesystem-capacity)" \
    --arg git "$(command -v git)" \
	    --arg systemctl "$SC_SYSTEMCTL" --arg state_schema "$SC_SCHEMA" \
	    --arg inbox "$SC_CAMPAIGN_LOCAL_ROOT/inbox" --arg acks "$SC_CAMPAIGN_LOCAL_ROOT/acks" \
	    --arg authority_path "$SC_CAMPAIGN_AUTHORITY" \
	    --arg created_at "$(sc_now)" --arg parent_process_start "$SC_PROCESS_START" \
	    --argjson parent_pid "$$" --argjson max_campaigns "$SC_CAMPAIGN_MAX_COUNT" \
    --argjson max_turns "$SC_CAMPAIGN_MAX_TURNS" --argjson worker_options "$worker_json" \
    --argjson provider_args "$provider_json" --argjson domains "$domains_json" \
    --argjson source_git "$source_git_json" --argjson inference "$inference_json" \
    --argjson worker_inferences "$worker_inferences_json" \
    --argjson budget_max "$([[ $SC_CAMPAIGN_STORAGE_BUDGET_MIB == null ]] && printf null || printf '%s' "$((SC_CAMPAIGN_STORAGE_BUDGET_MIB * 1024 * 1024))")" \
    '{schema:$schema,status:"active",run_id:$run_id,parent_pid:$parent_pid,
      parent_process_start:$parent_process_start,project:$project,project_key:$project_key,
      global_root:$global_root,campaign_root:$campaign_root,workspace_root:$workspace_root,
      worker_global_root:$worker_global,launcher:$launcher,
      artifact_sha256:$artifact_sha256,host_path:$host_path,home:$home,
      engine_home:$engine_home,git:$git,source_git:$source_git,
      storage:{budget_group:$budget_group,maximum_bytes:$budget_max,metering:$budget_metering,
        hard_enforced:($budget_max != null)},
	      systemctl:$systemctl,state_schema:$state_schema,
	      inbox:$inbox,acks:$acks,max_campaigns:$max_campaigns,
	      launch_max_campaigns:$max_campaigns,
	      worker_grants:{schema:"sandcodex.worker-grants.v1",starts_enabled:true,
	        max_campaigns:$max_campaigns,remote_auto_enabled:true,
	        browser_modes:["none"],desktop_modes:["none"],updated_at:null,receipt_id:null},
	      authority_path:$authority_path,
	      max_turns:$max_turns,browser_modes:["none","isolated"],desktop_modes:["none","isolated"],worker_options:$worker_options,
	      provider_args:$provider_args,network_domains:$domains,inference:$inference,
	      worker_inferences:$worker_inferences,
	      created_at:$created_at}' |
    sc_atomic "$SC_CAMPAIGN_AUTHORITY" 600
}

sc_campaign_build_environment() {
  local name
  SC_CAMPAIGN_ENV=(env -i
    "PATH=$SC_CAMPAIGN_RUNTIME_PATH"
    "HOME=$SC_CAMPAIGN_ENGINE_HOME"
    "PYTHONSAFEPATH=1"
    "SANDCODEX_NIX_READY=1"
  )
  for name in \
    XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
    SANDCODEX_TESTING SANDCODEX_NO_NIX SANDCODEX_TEST_RESOURCE_SCOPE \
    SANDCODEX_TEST_CODEX_BIN SANDCODEX_TEST_SYSTEMD_RUN_BIN \
    SANDCODEX_TEST_SYSTEMCTL_BIN SANDCODEX_TEST_SYSTEMD_NOEXEC \
    SANDCODEX_SYSTEMD_CAPTURE SANDCODEX_SYSTEMCTL_CAPTURE \
    SANDCODEX_TEST_RETRY_DELAY_SECONDS; do
    [[ -v "$name" ]] && SC_CAMPAIGN_ENV+=("$name=${!name}")
  done
  return 0
}

sc_start_campaign_broker() {
  (( SC_CAMPAIGN_AVAILABLE )) || return 0
  [[ -x "$SC_CAMPAIGN_ENGINE" && -f "$SC_CAMPAIGN_AUTHORITY" ]] || \
    sc_die "campaign broker runtime is incomplete"
  sc_campaign_build_environment
  (
    sc_close_inherited_fds
    exec "${SC_CAMPAIGN_ENV[@]}" "$SC_SETPRIV" --pdeathsig TERM "$(command -v python3)" \
      "$SC_CAMPAIGN_ENGINE" broker "$SC_CAMPAIGN_AUTHORITY"
  ) >>"$SC_RUN_ROOT/campaign-broker.log" 2>&1 &
  SC_CAMPAIGN_BROKER_PID=$!
  SC_CAMPAIGN_BROKER_START="$(sc_process_start "$SC_CAMPAIGN_BROKER_PID" 2>/dev/null || true)"
  [[ "$SC_CAMPAIGN_BROKER_START" =~ ^[0-9]+$ ]] || sc_die "could not identify the campaign broker"
  sleep 0.05
  sc_pid_still_matches "$SC_CAMPAIGN_BROKER_PID" "$SC_CAMPAIGN_BROKER_START" || {
    tail -n 20 -- "$SC_RUN_ROOT/campaign-broker.log" >&2 2>/dev/null || true
    sc_die "campaign broker failed to start"
  }
  sc_log_event info campaign_broker "companion campaign broker started" \
    "max_campaigns=$SC_CAMPAIGN_MAX_COUNT" "max_turns=$SC_CAMPAIGN_MAX_TURNS" \
    "worker_gui_default=none"
}

