    def _dispatch_compositor_guarded_click(
        self,
        route: dict[str, Any],
        point_index: int,
        button: int,
        *,
        modifier_target: dict[str, Any] | None = None,
    ) -> dict[str, Any] | None:
        """Use patched Sway for the final recipient check and complete click.

        The persistent virtual pointer remains present so SeatSeal and patched
        Sway agree on one birth-pinned input device.  Unlike the ordinary
        virtual-pointer command path, however, the consequential press and
        release are emitted by Sway itself immediately after its exact target
        recheck, without returning to the Wayland event loop.
