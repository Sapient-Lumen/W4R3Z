        return strcmp(mime, MIME_PNG) == 0;
    }
    if (state->profile == PROFILE_FILES) {
        return strcmp(mime, MIME_URI_LIST) == 0;
    }
    return strcmp(mime, MIME_UTF8) == 0 || strcmp(mime, MIME_TEXT) == 0 ||
        strcmp(mime, MIME_UTF8_STRING) == 0 ||
        (state->payload_ascii && strcmp(mime, MIME_STRING) == 0);
}

static bool validate_utf8(const unsigned char *bytes, size_t length, bool *ascii) {
    *ascii = true;
    for (size_t index = 0U; index < length;) {
        const unsigned char first = bytes[index];
        if (first <= 0x7fU) {
            index++;
            continue;
        }
        *ascii = false;
        if (first >= 0xc2U && first <= 0xdfU) {
            if (index + 1U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U) {
                return false;
            }
            index += 2U;
            continue;
        }
        if (first >= 0xe0U && first <= 0xefU) {
            if (index + 2U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (first == 0xe0U && bytes[index + 1U] < 0xa0U) ||
                    (first == 0xedU && bytes[index + 1U] >= 0xa0U)) {
                return false;
            }
            index += 3U;
            continue;
        }
        if (first >= 0xf0U && first <= 0xf4U) {
            if (index + 3U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (bytes[index + 3U] & 0xc0U) != 0x80U ||
                    (first == 0xf0U && bytes[index + 1U] < 0x90U) ||
                    (first == 0xf4U && bytes[index + 1U] >= 0x90U)) {
                return false;
            }
            index += 4U;
            continue;
        }
        return false;
    }
    return true;
}

static int hex_nibble(unsigned char value) {
    if (value >= '0' && value <= '9') return (int)(value - '0');
    if (value >= 'A' && value <= 'F') return (int)(value - 'A') + 10;
    return -1;
}

static bool uri_unreserved(unsigned char value) {
    return ((value >= '0' && value <= '9') ||
        (value >= 'A' && value <= 'Z') ||
        (value >= 'a' && value <= 'z')) || value == '-' || value == '.' ||
        value == '_' || value == '~';
}

static bool validate_uri_path_line(const unsigned char *bytes,
        size_t line_start, size_t line_end) {
    static const unsigned char prefix[] =
        "file:///run/sandcodex-app/drop/dnd-";
    static const unsigned char files_marker[] = "/files/";
    static const unsigned char item_marker[] = "item-";
    const size_t prefix_length = sizeof(prefix) - 1U;
    const size_t marker_length = sizeof(files_marker) - 1U;
    const size_t item_marker_length = sizeof(item_marker) - 1U;
    if (line_end <= line_start || line_end - line_start <=
            prefix_length + 32U + marker_length + item_marker_length + 3U ||
            memcmp(bytes + line_start, prefix, prefix_length) != 0) {
        return false;
    }
    size_t input = line_start + prefix_length;
    for (size_t index = 0U; index < 32U; index++) {
        const unsigned char value = bytes[input + index];
        if (!((value >= '0' && value <= '9') ||
                (value >= 'a' && value <= 'f'))) {
            return false;
        }
    }
    input += 32U;
    if (input + marker_length >= line_end ||
            memcmp(bytes + input, files_marker, marker_length) != 0) {
        return false;
    }
    input += marker_length;
    if (input + item_marker_length + 3U >= line_end ||
            memcmp(bytes + input, item_marker, item_marker_length) != 0) {
        return false;
    }
    input += item_marker_length;
    if (bytes[input] != '0' || bytes[input + 1U] < '1' ||
            bytes[input + 1U] > '8' || bytes[input + 2U] != '/') {
        return false;
    }
    input += 3U;

    unsigned char decoded[NAME_MAX + 1U];
    size_t output = 0U;
    bool valid = true;
    while (valid && input < line_end) {
        const unsigned char value = bytes[input];
        if (output >= NAME_MAX || value == '/') {
            valid = false;
            break;
        }
        if (uri_unreserved(value)) {
            decoded[output++] = value;
            input++;
            continue;
        }
        if (value != '%' || input + 2U >= line_end) {
            valid = false;
            break;
        }
        const int high = hex_nibble(bytes[input + 1U]);
        const int low = hex_nibble(bytes[input + 2U]);
        if (high < 0 || low < 0) {
            valid = false;
            break;
        }
        const unsigned char decoded_value = (unsigned char)((high << 4) | low);
        /* The controller emits canonical URI spelling: unreserved bytes are
         * literal. Encoded separators, controls, NUL, and backslash could
         * change path structure after URI decoding and are always rejected. */
        if (uri_unreserved(decoded_value) || decoded_value == '/' ||
                decoded_value == '\\' || decoded_value == 0U ||
                decoded_value < 0x20U || decoded_value == 0x7fU) {
            valid = false;
            break;
        }
        decoded[output++] = decoded_value;
        input += 3U;
    }
    if (valid && (output == 0U ||
            (output == 1U && decoded[0] == '.') ||
            (output == 2U && decoded[0] == '.' && decoded[1] == '.'))) {
        valid = false;
    }
    bool ascii = false;
    if (valid && !validate_utf8(decoded, output, &ascii)) {
        valid = false;
    }
    return valid;
}

static bool validate_uri_list(const unsigned char *bytes, size_t length) {
    if (length == 0U || length > MAX_URI_LIST_PAYLOAD_BYTES) {
        return false;
    }
    size_t offset = 0U;
    uint32_t entries = 0U;
    while (offset < length) {
        const size_t line_start = offset;
        while (offset < length && bytes[offset] != '\r' && bytes[offset] != '\n') {
            if (bytes[offset] < 0x21U || bytes[offset] > 0x7eU) {
                return false;
            }
            offset++;
        }
        if (offset + 1U >= length || bytes[offset] != '\r' ||
                bytes[offset + 1U] != '\n' ||
                ++entries > MAX_URI_LIST_ENTRIES ||
                !validate_uri_path_line(bytes, line_start, offset)) {
            return false;
        }
        offset += 2U;
    }
    return entries >= 1U && entries <= MAX_URI_LIST_ENTRIES;
}

static uint32_t read_be32(const unsigned char *bytes) {
    return ((uint32_t)bytes[0] << 24U) | ((uint32_t)bytes[1] << 16U) |
        ((uint32_t)bytes[2] << 8U) | (uint32_t)bytes[3];
}

static uint32_t png_crc32(const unsigned char *bytes, size_t length) {
    uint32_t value = UINT32_C(0xffffffff);
    for (size_t index = 0U; index < length; index++) {
        value ^= (uint32_t)bytes[index];
        for (unsigned bit = 0U; bit < 8U; bit++) {
            const uint32_t mask = (uint32_t)-(int32_t)(value & 1U);
            value = (value >> 1U) ^ (UINT32_C(0xedb88320) & mask);
        }
    }
    return value ^ UINT32_C(0xffffffff);
}

static bool validate_png(const unsigned char *bytes, size_t length) {
    static const unsigned char signature[8] = {
        0x89U, 0x50U, 0x4eU, 0x47U, 0x0dU, 0x0aU, 0x1aU, 0x0aU,
    };
    if (length < 57U || memcmp(bytes, signature, sizeof(signature)) != 0) {
        return false;
    }
    size_t offset = sizeof(signature);
    uint32_t chunks = 0U;
    bool saw_header = false;
    bool saw_data = false;
    bool saw_end = false;
    while (offset < length) {
        if (++chunks > MAX_PNG_CHUNKS || length - offset < 12U) {
            return false;
        }
        const uint32_t data_length = read_be32(bytes + offset);
        if (data_length > INT32_MAX ||
                (uintmax_t)data_length > (uintmax_t)(length - offset - 12U)) {
            return false;
        }
        const unsigned char *type = bytes + offset + 4U;
        const unsigned char *data = bytes + offset + 8U;
        const size_t crc_offset = offset + 8U + (size_t)data_length;
        if (png_crc32(type, 4U + (size_t)data_length) !=
                read_be32(bytes + crc_offset)) {
            return false;
        }
        if (memcmp(type, "IHDR", 4U) == 0) {
            if (chunks != 1U || saw_header || data_length != 13U) {
                return false;
            }
            const uint32_t width = read_be32(data);
            const uint32_t height = read_be32(data + 4U);
            const uint64_t pixels = (uint64_t)width * (uint64_t)height;
            if (width == 0U || height == 0U || width > MAX_PNG_DIMENSION ||
                    height > MAX_PNG_DIMENSION || pixels > MAX_PNG_PIXELS ||
                    data[8] != 8U || (data[9] != 2U && data[9] != 6U) ||
                    data[10] != 0U || data[11] != 0U || data[12] != 0U) {
                return false;
            }
            saw_header = true;
        } else if (memcmp(type, "IDAT", 4U) == 0) {
            if (!saw_header || saw_end || data_length == 0U) {
                return false;
            }
            saw_data = true;
        } else if (memcmp(type, "IEND", 4U) == 0) {
            if (!saw_header || !saw_data || saw_end || data_length != 0U ||
                    crc_offset + 4U != length) {
                return false;
            }
            saw_end = true;
        } else {
            return false;
        }
        offset = crc_offset + 4U;
        if (saw_end) {
            break;
        }
    }
    return saw_header && saw_data && saw_end && offset == length;
}

static int inspect_pipe_endpoint(int descriptor, int expected_access,
        struct stat *metadata) {
    const int flags = fcntl(descriptor, F_GETFL);
    if (flags < 0 || (flags & O_ACCMODE) != expected_access ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, metadata) < 0 || !S_ISFIFO(metadata->st_mode) ||
            metadata->st_uid != geteuid() || metadata->st_nlink != 1U) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static bool same_pipe_endpoint(const struct stat *left, const struct stat *right) {
    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
}

static int inspect_descriptor_inventory(int payload_descriptor) {
    DIR *directory = opendir("/proc/self/fd");
    if (directory == NULL) {
        return -1;
    }
    const int inventory_descriptor = dirfd(directory);
    bool seen_standard[3] = {false, false, false};
    bool seen_payload = false;
    bool seen_inventory = false;
    size_t count = 0U;
    errno = 0;
    for (;;) {
        struct dirent *entry = readdir(directory);
        if (entry == NULL) {
            break;
        }
        if (entry->d_name[0] == '.') {
            continue;
        }
        uint64_t value = 0U;
        if (!parse_u64(entry->d_name, 0U, INT_MAX, &value)) {
            errno = EPROTO;
            (void)closedir(directory);
            return -1;
        }
        const int descriptor = (int)value;
        count++;
        if (descriptor >= 0 && descriptor <= 2) {
            seen_standard[descriptor] = true;
        } else if (descriptor == payload_descriptor) {
            if (seen_payload) {
                errno = EPROTO;
                (void)closedir(directory);
                return -1;
            }
            seen_payload = true;
        } else if (descriptor == inventory_descriptor) {
            seen_inventory = true;
        } else {
            errno = EPROTO;
            (void)closedir(directory);
            return -1;
        }
    }
    const int scan_errno = errno;
    const int close_result = closedir(directory);
    if (scan_errno != 0 || close_result < 0 || count != 5U ||
            !seen_standard[0] || !seen_standard[1] || !seen_standard[2] ||
            !seen_payload || !seen_inventory) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int inspect_payload(int descriptor, size_t expected_size,
        enum payload_profile profile, bool *payload_ascii, bool *payload_exec_sealed) {
    struct stat metadata = {0};
    const int flags = fcntl(descriptor, F_GETFL);
    const int descriptor_flags = fcntl(descriptor, F_GETFD);
    const int seals = fcntl(descriptor, F_GET_SEALS);
    const int required_seals = F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE |
        F_SEAL_SEAL | F_SEAL_EXEC;
    const size_t profile_limit = profile == PROFILE_PNG ?
        MAX_PNG_PAYLOAD_BYTES :
        (profile == PROFILE_FILES ? MAX_URI_LIST_PAYLOAD_BYTES :
            MAX_TEXT_PAYLOAD_BYTES);
    if (descriptor < 3 || expected_size > profile_limit || flags < 0 ||
            descriptor_flags < 0 || (flags & O_ACCMODE) != O_RDONLY ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
            metadata.st_uid != geteuid() || metadata.st_nlink != 0U ||
            (metadata.st_mode & 07777U) != 0600U || metadata.st_size < 0 ||
            (uintmax_t)metadata.st_size != (uintmax_t)expected_size ||
            seals != required_seals ||
            fcntl(descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
        errno = EPROTO;
        return -1;
    }
    *payload_ascii = true;
    *payload_exec_sealed = true;
    if ((profile == PROFILE_PNG && expected_size < 57U) ||
            (profile == PROFILE_FILES && expected_size == 0U)) {
        errno = EILSEQ;
        return -1;
    }
    if (expected_size > 0U) {
        void *mapping = mmap(NULL, expected_size, PROT_READ, MAP_PRIVATE, descriptor, 0);
        if (mapping == MAP_FAILED) {
            return -1;
        }
        const bool valid = profile == PROFILE_PNG ?
            validate_png(mapping, expected_size) :
            (profile == PROFILE_FILES ?
                validate_uri_list(mapping, expected_size) :
                validate_utf8(mapping, expected_size, payload_ascii));
        if (munmap(mapping, expected_size) < 0) {
            return -1;
        }
        if (!valid) {
            errno = EILSEQ;
            return -1;
        }
    } else if (profile == PROFILE_PNG || profile == PROFILE_FILES) {
        errno = EILSEQ;
        return -1;
    }
    return 0;
}

static int harden_process(int payload_descriptor, size_t payload_size,
        enum payload_profile profile, bool *payload_ascii,
        bool *payload_exec_sealed) {
    const pid_t parent = getppid();
    struct stat input = {0};
    struct stat output = {0};
    struct stat diagnostic = {0};
    const struct rlimit no_core = {.rlim_cur = 0, .rlim_max = 0};
    /* The only regular-file growth permitted is the fixed transparent origin memfd. */
    const struct rlimit origin_only_regular_file_output = {
        .rlim_cur = ORIGIN_BUFFER_BYTES,
        .rlim_max = ORIGIN_BUFFER_BYTES,
    };
    /* Standard streams, payload, one Wayland socket, and at most 16 target pipes. */
    const struct rlimit bounded_descriptors = {.rlim_cur = 64U, .rlim_max = 64U};
    if (parent <= 1 || inspect_descriptor_inventory(payload_descriptor) < 0 ||
            inspect_pipe_endpoint(STDIN_FILENO, O_RDONLY, &input) < 0 ||
            inspect_pipe_endpoint(STDOUT_FILENO, O_WRONLY, &output) < 0 ||
            inspect_pipe_endpoint(STDERR_FILENO, O_WRONLY, &diagnostic) < 0 ||
            same_pipe_endpoint(&input, &output) ||
            same_pipe_endpoint(&input, &diagnostic) ||
            same_pipe_endpoint(&output, &diagnostic) ||
            inspect_payload(payload_descriptor, payload_size, profile,
                payload_ascii, payload_exec_sealed) < 0 ||
            setrlimit(RLIMIT_CORE, &no_core) < 0 ||
            setrlimit(RLIMIT_FSIZE, &origin_only_regular_file_output) < 0 ||
            setrlimit(RLIMIT_NOFILE, &bounded_descriptors) < 0 ||
            prctl(PR_SET_PDEATHSIG, SIGTERM) < 0 || getppid() != parent ||
            prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) < 0 ||
            prctl(PR_SET_DUMPABLE, 0) < 0) {
        return -1;
    }
    return 0;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct drop_state *state = data;
    if (strcmp(interface, wl_compositor_interface.name) == 0) {
        state->compositor_count++;
        state->compositor_name = name;
        if (state->compositor == NULL) {
            state->compositor = wl_registry_bind(registry, name,
                &wl_compositor_interface, 1U);
        }
    } else if (strcmp(interface, wl_shm_interface.name) == 0) {
        state->shm_count++;
        state->shm_name = name;
        if (state->shm == NULL) {
            state->shm = wl_registry_bind(registry, name, &wl_shm_interface, 1U);
        }
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        state->seat_name = name;
        if (state->seat == NULL) {
            state->seat = wl_registry_bind(registry, name, &wl_seat_interface,
                version < 5U ? version : 5U);
        }
    } else if (strcmp(interface, wl_data_device_manager_interface.name) == 0) {
        state->manager_count++;
        state->manager_name = name;
        state->manager_version = version;
        if (state->manager == NULL && version >= 3U) {
            state->manager = wl_registry_bind(registry, name,
                &wl_data_device_manager_interface, 3U);
        }
    } else if (strcmp(interface, zwlr_layer_shell_v1_interface.name) == 0) {
        state->layer_shell_count++;
        state->layer_shell_name = name;
        if (state->layer_shell == NULL) {
            state->layer_shell = wl_registry_bind(registry, name,
                &zwlr_layer_shell_v1_interface, 1U);
        }
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    (void)registry;
    struct drop_state *state = data;
    if (name == state->compositor_name || name == state->shm_name ||
            name == state->seat_name || name == state->manager_name ||
            name == state->layer_shell_name) {
        state->topology_valid = false;
        state->terminal_error = true;
    }
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

