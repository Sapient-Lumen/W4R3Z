+            wheel_delta_degrees_256 >= SANDCODEX_STYLUS_WHEEL_DELTA_MIN_DEGREES_256 &&
+            wheel_delta_degrees_256 <= SANDCODEX_STYLUS_WHEEL_DELTA_MAX_DEGREES_256 &&
+            wheel_clicks >= SANDCODEX_STYLUS_WHEEL_CLICKS_MIN &&
+            wheel_clicks <= SANDCODEX_STYLUS_WHEEL_CLICKS_MAX &&
+            wheel_step <= steps &&
