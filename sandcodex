sc_emit_wayland_input_method_agent_source() {
  cat <<'WAYLAND_INPUT_METHOD_AGENT_C'
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L

/*
 * CommitSeal direct UTF-8 text transport for Sandcodex.
 *
 * The controller passes one immutable anonymous memfd.  This helper becomes
 * the private workstation's input method for one guarded operation, waits for
 * an application-owned zwp_text_input_v3 context to activate it, and submits
 * bounded UTF-8 commit_string requests using the exact serial established by
 * zwp_input_method_v2.done.  The helper never emits surrounding text, content
 * hints, or payload bytes on stdout/stderr.  Each controller COMMIT names only
 * a validated byte range in the sealed payload and receives a metadata-only
 * roundtrip receipt.
 */

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <poll.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <sys/prctl.h>
#include <sys/resource.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

#include <wayland-client.h>
#include "input-method-unstable-v2-client-protocol.h"

#define AGENT_PROTOCOL "sandcodex.input-method-agent.v1"
#define MAX_LINE_BYTES 256U
#define MAX_TOKENS 5U
#define MAX_PAYLOAD_BYTES (1024U * 1024U)
#define MAX_COMMIT_BYTES 3500U
#define MAX_COMMITS 512U
#define MAX_WAIT_MILLISECONDS 10000U

/* Linux 6.3 stable UAPI value; older libc headers may omit the name. */
#ifndef F_SEAL_EXEC
#define F_SEAL_EXEC 0x0020
#endif

struct input_method_state {
    struct wl_display *display;
    struct wl_registry *registry;
    struct wl_seat *seat;
    struct zwp_input_method_manager_v2 *manager;
    struct zwp_input_method_v2 *input_method;
    uint32_t manager_count;
    uint32_t seat_count;
    uint32_t manager_version;
    uint32_t manager_name;
    uint32_t seat_name;
    int payload_descriptor;
    size_t payload_size;
    bool payload_exec_sealed;
    bool topology_valid;
    bool unavailable;
    bool terminal_error;
    bool pending_active;
    bool active;
    bool commit_epoch_armed;
    uint32_t done_serial;
    uint32_t activations;
    uint32_t deactivations;
    uint32_t epoch_activations;
    uint32_t epoch_deactivations;
    uint32_t surrounding_events;
    uint32_t content_type_events;
    uint32_t commits_attempted;
    uint32_t commits_confirmed;
    uint64_t bytes_committed;
};

enum command_kind {
    COMMAND_WAIT_ACTIVE,
    COMMAND_COMMIT,
    COMMAND_PING,
    COMMAND_QUIT,
};

struct command {
    uint64_t sequence;
    enum command_kind kind;
    uint32_t timeout_milliseconds;
    size_t offset;
    size_t length;
};

static volatile sig_atomic_t stop_requested = 0;

static void on_signal(int signo) {
    (void)signo;
    stop_requested = 1;
}

static uint64_t monotonic_milliseconds(void) {
    struct timespec value = {0};
    if (clock_gettime(CLOCK_MONOTONIC, &value) < 0) {
        return 0U;
    }
    return (uint64_t)value.tv_sec * UINT64_C(1000) +
        (uint64_t)value.tv_nsec / UINT64_C(1000000);
}

static bool parse_u64(const char *text, uint64_t minimum, uint64_t maximum,
        uint64_t *output) {
    if (text == NULL || *text == '\0' || *text == '-' || *text == '+') {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' ||
            value < minimum || value > maximum) {
        return false;
    }
    *output = (uint64_t)value;
    return true;
}

static size_t tokenize(char *line, char **tokens) {
    size_t count = 0U;
    char *save = NULL;
    for (char *token = strtok_r(line, " \t\r\n", &save);
         token != NULL;
         token = strtok_r(NULL, " \t\r\n", &save)) {
        if (count == MAX_TOKENS) {
            return MAX_TOKENS + 1U;
        }
        tokens[count++] = token;
    }
    return count;
}

static bool parse_command(char *line, uint64_t expected_sequence,
        struct command *command) {
    char *tokens[MAX_TOKENS] = {0};
    const size_t count = tokenize(line, tokens);
    uint64_t sequence = 0U;
    if (count < 2U || count > MAX_TOKENS ||
            !parse_u64(tokens[0], 1U, UINT64_MAX, &sequence) ||
            sequence != expected_sequence) {
        return false;
    }
    command->sequence = sequence;
    if (strcmp(tokens[1], "WAIT_ACTIVE") == 0) {
        uint64_t timeout = 0U;
        if (count != 3U ||
                !parse_u64(tokens[2], 1U, MAX_WAIT_MILLISECONDS, &timeout)) {
            return false;
        }
        command->kind = COMMAND_WAIT_ACTIVE;
        command->timeout_milliseconds = (uint32_t)timeout;
        return true;
    }
    if (strcmp(tokens[1], "COMMIT") == 0) {
        uint64_t offset = 0U;
        uint64_t length = 0U;
        if (count != 4U ||
                !parse_u64(tokens[2], 0U, MAX_PAYLOAD_BYTES, &offset) ||
                !parse_u64(tokens[3], 1U, MAX_COMMIT_BYTES, &length) ||
                offset > SIZE_MAX || length > SIZE_MAX) {
            return false;
        }
        command->kind = COMMAND_COMMIT;
        command->offset = (size_t)offset;
        command->length = (size_t)length;
        return true;
    }
    if (strcmp(tokens[1], "PING") == 0 && count == 2U) {
        command->kind = COMMAND_PING;
        return true;
    }
    if (strcmp(tokens[1], "QUIT") == 0 && count == 2U) {
        command->kind = COMMAND_QUIT;
        return true;
    }
    return false;
}

static bool validate_utf8(const unsigned char *bytes, size_t length) {
    for (size_t index = 0U; index < length;) {
        const unsigned char first = bytes[index];
        if (first == 0U) {
            return false;
        }
        if (first <= 0x7fU) {
            index++;
            continue;
        }
        if (first >= 0xc2U && first <= 0xdfU) {
            if (index + 1U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U) {
                return false;
            }
            index += 2U;
            continue;
        }
        if (first >= 0xe0U && first <= 0xefU) {
            if (index + 2U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (first == 0xe0U && bytes[index + 1U] < 0xa0U) ||
                    (first == 0xedU && bytes[index + 1U] >= 0xa0U)) {
                return false;
            }
            index += 3U;
            continue;
        }
        if (first >= 0xf0U && first <= 0xf4U) {
            if (index + 3U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (bytes[index + 3U] & 0xc0U) != 0x80U ||
                    (first == 0xf0U && bytes[index + 1U] < 0x90U) ||
                    (first == 0xf4U && bytes[index + 1U] >= 0x90U)) {
                return false;
            }
            index += 4U;
            continue;
        }
        return false;
    }
    return true;
}

static int inspect_pipe_endpoint(int descriptor, int expected_access,
        struct stat *metadata) {
    const int flags = fcntl(descriptor, F_GETFL);
    if (flags < 0 || (flags & O_ACCMODE) != expected_access ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, metadata) < 0 || !S_ISFIFO(metadata->st_mode) ||
            metadata->st_uid != geteuid() || metadata->st_nlink != 1U) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static bool same_pipe_endpoint(const struct stat *left, const struct stat *right) {
    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
}

static int inspect_descriptor_inventory(int payload_descriptor) {
    DIR *directory = opendir("/proc/self/fd");
    if (directory == NULL) {
        return -1;
    }
    const int inventory_descriptor = dirfd(directory);
    if (inventory_descriptor < 0 || inventory_descriptor == payload_descriptor) {
        const int saved = errno == 0 ? EPROTO : errno;
        (void)closedir(directory);
        errno = saved;
        return -1;
    }
    for (;;) {
        errno = 0;
        struct dirent *entry = readdir(directory);
        if (entry == NULL) {
            if (errno != 0) {
                const int saved = errno;
                (void)closedir(directory);
                errno = saved;
                return -1;
            }
            break;
        }
        if (entry->d_name[0] == '.') {
            continue;
        }
        uint64_t parsed = 0U;
        if (!parse_u64(entry->d_name, 0U, INT_MAX, &parsed)) {
            (void)closedir(directory);
            errno = EPROTO;
            return -1;
        }
        const int descriptor = (int)parsed;
        if (descriptor == STDIN_FILENO || descriptor == STDOUT_FILENO ||
                descriptor == STDERR_FILENO || descriptor == payload_descriptor ||
                descriptor == inventory_descriptor) {
            continue;
        }
        (void)closedir(directory);
        errno = EPROTO;
        return -1;
    }
    if (closedir(directory) < 0) {
        return -1;
    }
    return 0;
}

static int inspect_payload(int descriptor, size_t expected_size,
        bool *exec_sealed) {
    struct stat metadata = {0};
    const int flags = fcntl(descriptor, F_GETFL);
    const int descriptor_flags = fcntl(descriptor, F_GETFD);
    const int seals = fcntl(descriptor, F_GET_SEALS);
    const int required_seals = F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE |
        F_SEAL_SEAL | F_SEAL_EXEC;
    if (descriptor < 3 || expected_size > MAX_PAYLOAD_BYTES || flags < 0 ||
            descriptor_flags < 0 || (flags & O_ACCMODE) != O_RDONLY ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
            metadata.st_uid != geteuid() || metadata.st_nlink != 0U ||
            (metadata.st_mode & 0777U) != 0600U ||
            metadata.st_size < 0 || (uintmax_t)metadata.st_size != (uintmax_t)expected_size ||
            seals != required_seals ||
            fcntl(descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
        errno = EPROTO;
        return -1;
    }
    *exec_sealed = (seals & F_SEAL_EXEC) == F_SEAL_EXEC;
    if (expected_size > 0U) {
        void *mapping = mmap(NULL, expected_size, PROT_READ, MAP_PRIVATE, descriptor, 0);
        if (mapping == MAP_FAILED) {
            return -1;
        }
        const bool valid = validate_utf8(mapping, expected_size);
        if (munmap(mapping, expected_size) < 0) {
            return -1;
        }
        if (!valid) {
            errno = EILSEQ;
            return -1;
        }
    }
    return 0;
}

static int harden_process(int payload_descriptor, size_t payload_size,
        bool *exec_sealed) {
    const pid_t parent = getppid();
    struct stat input = {0};
    struct stat output = {0};
    struct stat diagnostic = {0};
    const struct rlimit zero_limit = {.rlim_cur = 0, .rlim_max = 0};
    if (parent <= 1 || inspect_pipe_endpoint(STDIN_FILENO, O_RDONLY, &input) < 0 ||
            inspect_pipe_endpoint(STDOUT_FILENO, O_WRONLY, &output) < 0 ||
            inspect_pipe_endpoint(STDERR_FILENO, O_WRONLY, &diagnostic) < 0 ||
            same_pipe_endpoint(&input, &output) || same_pipe_endpoint(&input, &diagnostic) ||
            same_pipe_endpoint(&output, &diagnostic) ||
            inspect_descriptor_inventory(payload_descriptor) < 0 ||
            inspect_payload(payload_descriptor, payload_size, exec_sealed) < 0 ||
            setrlimit(RLIMIT_CORE, &zero_limit) < 0 ||
            setrlimit(RLIMIT_FSIZE, &zero_limit) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (prctl(PR_SET_PDEATHSIG, SIGTERM) < 0 || getppid() != parent ||
            prctl(PR_SET_NO_NEW_PRIVS, 1L, 0L, 0L, 0L) < 0 ||
            prctl(PR_SET_DUMPABLE, 0L, 0L, 0L, 0L) < 0) {
        return -1;
    }
    (void)umask(S_IRWXG | S_IRWXO);
    return 0;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct input_method_state *state = data;
    if (strcmp(interface, zwp_input_method_manager_v2_interface.name) == 0) {
        state->manager_count++;
        if (state->manager_count > 1U) {
            state->topology_valid = false;
            state->terminal_error = true;
        }
        if (state->manager == NULL && version >= 1U) {
            state->manager_version = 1U;
            state->manager_name = name;
            state->manager = wl_registry_bind(registry, name,
                &zwp_input_method_manager_v2_interface, 1U);
        }
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        if (state->seat_count > 1U) {
            state->topology_valid = false;
            state->terminal_error = true;
        }
        if (state->seat == NULL) {
            state->seat_name = name;
            state->seat = wl_registry_bind(registry, name, &wl_seat_interface,
                version < 1U ? version : 1U);
        }
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    (void)registry;
    struct input_method_state *state = data;
    if (name == state->manager_name || name == state->seat_name) {
        state->topology_valid = false;
        state->terminal_error = true;
    }
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

static void input_method_activate(void *data, struct zwp_input_method_v2 *input_method) {
    (void)input_method;
    struct input_method_state *state = data;
    state->pending_active = true;
    state->activations++;
}

static void input_method_deactivate(void *data, struct zwp_input_method_v2 *input_method) {
    (void)input_method;
    struct input_method_state *state = data;
    state->pending_active = false;
    state->deactivations++;
}

static void input_method_surrounding_text(void *data,
        struct zwp_input_method_v2 *input_method, const char *text,
        uint32_t cursor, uint32_t anchor) {
    (void)input_method;
    (void)text;
    (void)cursor;
    (void)anchor;
    struct input_method_state *state = data;
    state->surrounding_events++;
}

static void input_method_text_change_cause(void *data,
        struct zwp_input_method_v2 *input_method, uint32_t cause) {
    (void)data;
    (void)input_method;
    (void)cause;
}

static void input_method_content_type(void *data,
        struct zwp_input_method_v2 *input_method, uint32_t hint, uint32_t purpose) {
    (void)input_method;
    (void)hint;
    (void)purpose;
    struct input_method_state *state = data;
    state->content_type_events++;
}

static void input_method_done(void *data, struct zwp_input_method_v2 *input_method) {
    (void)input_method;
    struct input_method_state *state = data;
    /* The protocol serial is the count of done events already issued on this
     * object.  Refuse the practically unreachable wrap rather than reusing
     * serial zero and making an ancient controller observation ambiguous. */
    if (state->done_serial == UINT32_MAX) {
        state->terminal_error = true;
        state->active = false;
        state->pending_active = false;
        return;
    }
    state->active = state->pending_active;
    state->done_serial++;
}

static void input_method_unavailable(void *data,
        struct zwp_input_method_v2 *input_method) {
    (void)input_method;
    struct input_method_state *state = data;
    state->unavailable = true;
    state->active = false;
    state->pending_active = false;
    state->terminal_error = true;
}

static const struct zwp_input_method_v2_listener input_method_listener = {
    .activate = input_method_activate,
    .deactivate = input_method_deactivate,
    .surrounding_text = input_method_surrounding_text,
    .text_change_cause = input_method_text_change_cause,
    .content_type = input_method_content_type,
    .done = input_method_done,
    .unavailable = input_method_unavailable,
};

static int initialize_wayland(struct input_method_state *state) {
    state->topology_valid = true;
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 ||
            state->manager_count != 1U || state->seat_count != 1U ||
            state->manager == NULL || state->seat == NULL || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    state->input_method = zwp_input_method_manager_v2_get_input_method(
        state->manager, state->seat);
    if (state->input_method == NULL ||
            zwp_input_method_v2_add_listener(
                state->input_method, &input_method_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 ||
            state->unavailable || state->terminal_error || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static void cleanup(struct input_method_state *state) {
    if (state->input_method != NULL) {
        zwp_input_method_v2_destroy(state->input_method);
        state->input_method = NULL;
    }
    if (state->manager != NULL) {
        zwp_input_method_manager_v2_destroy(state->manager);
        state->manager = NULL;
    }
    if (state->seat != NULL) {
        wl_seat_destroy(state->seat);
        state->seat = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        (void)wl_display_flush(state->display);
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
    if (state->payload_descriptor >= 0) {
        (void)close(state->payload_descriptor);
        state->payload_descriptor = -1;
    }
}

static int wait_for_active(struct input_method_state *state,
        uint32_t timeout_milliseconds) {
    const uint64_t started = monotonic_milliseconds();
    const uint64_t deadline = started + timeout_milliseconds;
    while (!stop_requested && !state->terminal_error && !state->unavailable &&
            state->topology_valid && !state->active) {
        if (wl_display_dispatch_pending(state->display) < 0 ||
                wl_display_flush(state->display) < 0) {
            return -1;
        }
        if (state->active) {
            break;
        }
        const uint64_t now = monotonic_milliseconds();
        if (now >= deadline) {
            return 0;
        }
        const uint64_t remaining = deadline - now;
        const int poll_timeout = remaining > (uint64_t)INT_MAX ? INT_MAX : (int)remaining;
        struct pollfd descriptor = {
            .fd = wl_display_get_fd(state->display),
            .events = POLLIN | POLLERR | POLLHUP,
        };
        const int result = poll(&descriptor, 1U, poll_timeout);
        if (result < 0) {
            if (errno == EINTR) {
                continue;
            }
            return -1;
        }
        if (result == 0) {
            return 0;
        }
        if ((descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
                (descriptor.revents & POLLIN) == 0 ||
                wl_display_dispatch(state->display) < 0) {
            errno = EPIPE;
            return -1;
        }
    }
    if (state->terminal_error || state->unavailable || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    return state->active ? 1 : 0;
}

static void secure_wipe(char *buffer, size_t length) {
    volatile unsigned char *cursor = (volatile unsigned char *)buffer;
    while (length > 0U) {
        *cursor++ = 0U;
        length--;
    }
}

static bool commit_epoch_intact(const struct input_method_state *state) {
    return state->commit_epoch_armed && state->active &&
        state->activations == state->epoch_activations &&
        state->deactivations == state->epoch_deactivations;
}

static int commit_range(struct input_method_state *state,
        size_t offset, size_t length, uint32_t *serial_used) {
    if (!commit_epoch_intact(state) || state->terminal_error || state->unavailable ||
            !state->topology_valid || state->input_method == NULL ||
            length == 0U || length > MAX_COMMIT_BYTES ||
            offset > state->payload_size || length > state->payload_size - offset ||
            state->commits_attempted >= MAX_COMMITS) {
        errno = EPROTO;
        return -1;
    }
    char *text = calloc(length + 1U, 1U);
    if (text == NULL) {
        return -1;
    }
    size_t received = 0U;
    while (received < length) {
        const ssize_t count = pread(state->payload_descriptor, text + received,
            length - received, (off_t)(offset + received));
        if (count < 0) {
            if (errno == EINTR) {
                continue;
            }
            secure_wipe(text, length + 1U);
            free(text);
            return -1;
        }
        if (count == 0) {
            errno = EIO;
            secure_wipe(text, length + 1U);
            free(text);
            return -1;
        }
        received += (size_t)count;
    }
    if (!validate_utf8((const unsigned char *)text, length)) {
        errno = EILSEQ;
        secure_wipe(text, length + 1U);
        free(text);
        return -1;
    }
    /* Drain all queued input-method state immediately before selecting the
     * serial. A pending done/deactivate event must be reflected before any
     * payload byte can be submitted. */
    if (wl_display_roundtrip(state->display) < 0 || state->terminal_error ||
            state->unavailable || !state->topology_valid ||
            !commit_epoch_intact(state)) {
        errno = EPROTO;
        secure_wipe(text, length + 1U);
        free(text);
        return -1;
    }
    const uint32_t serial = state->done_serial;
    *serial_used = serial;
    state->commits_attempted++;
    zwp_input_method_v2_commit_string(state->input_method, text);
    zwp_input_method_v2_commit(state->input_method, serial);
    secure_wipe(text, length + 1U);
    free(text);
    if (wl_display_roundtrip(state->display) < 0 || state->terminal_error ||
            state->unavailable || !state->topology_valid ||
            !commit_epoch_intact(state)) {
        errno = EPROTO;
        return -1;
    }
    state->commits_confirmed++;
    state->bytes_committed += length;
    return 0;
}

static void reply_error(uint64_t sequence, const char *reason,
        const struct input_method_state *state) {
    printf("ERR %" PRIu64 " %s COMMITS %u BYTES %" PRIu64
           " ACTIVE %u SERIAL %u ACTIVATIONS %u DEACTIVATIONS %u\n",
        sequence, reason, state->commits_confirmed, state->bytes_committed,
        state->active ? 1U : 0U, state->done_serial,
        state->activations, state->deactivations);
}

static int run_self_test(void) {
    struct command command = {0};
    const unsigned char valid_utf8[] = {
        0x41U, 0xe2U, 0x82U, 0xacU, 0xf0U, 0x9fU, 0x98U, 0x80U,
    };
    const unsigned char invalid_utf8[] = {0xedU, 0xa0U, 0x80U};
    const unsigned char nul_utf8[] = {0x41U, 0x00U, 0x42U};
    char wait[] = "1 WAIT_ACTIVE 750\n";
    char commit[] = "2 COMMIT 5 17\n";
    char ping[] = "3 PING\n";
    char quit[] = "4 QUIT\n";
    char bad_sequence[] = "8 PING\n";
    char bad_size[] = "5 COMMIT 0 3501\n";
    if (!parse_command(wait, 1U, &command) ||
            command.kind != COMMAND_WAIT_ACTIVE ||
            command.timeout_milliseconds != 750U ||
            !parse_command(commit, 2U, &command) || command.kind != COMMAND_COMMIT ||
            command.offset != 5U || command.length != 17U ||
            !parse_command(ping, 3U, &command) || command.kind != COMMAND_PING ||
            !parse_command(quit, 4U, &command) || command.kind != COMMAND_QUIT ||
            parse_command(bad_sequence, 5U, &command) ||
            parse_command(bad_size, 5U, &command) ||
            !validate_utf8(valid_utf8, sizeof(valid_utf8)) ||
            validate_utf8(invalid_utf8, sizeof(invalid_utf8)) ||
            validate_utf8(nul_utf8, sizeof(nul_utf8))) {
        fputs("sandcodex-wayland-input-method-agent: self-test failed\n", stderr);
        return 1;
    }
    printf("{\"schema\":\"sandcodex.input-method-agent-self-test.v1\","
           "\"protocol\":\"%s\",\"ok\":true,"
           "\"maximum_payload_bytes\":%u,\"maximum_commit_bytes\":%u,"
           "\"maximum_commits\":%u,"
           "\"payload_storage\":\"mode-0600-non-executable-sealed-anonymous-memfd\","
           "\"payload_execution\":\"MFD_NOEXEC_SEAL+F_SEAL_EXEC-required\","
           "\"activation_policy\":\"application-text-input-activate+done\","
           "\"commit_policy\":\"utf8-byte-range+single-activation-epoch+done-serial+wayland-roundtrip\","
           "\"surrounding_text_policy\":\"count-only-never-relayed\","
           "\"registry_cardinality\":\"exactly-one-seat+one-input-method-manager\","
           "\"process_custody\":\"parent-death-signal+non-dumpable+no-new-privileges+exact-inherited-descriptor-inventory+three-distinct-directional-pipes+zero-regular-file-output\"}\n",
           AGENT_PROTOCOL, MAX_PAYLOAD_BYTES, MAX_COMMIT_BYTES, MAX_COMMITS);
    return 0;
}

int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc != 3) {
        fputs("usage: wayland-input-method-agent PAYLOAD_FD PAYLOAD_SIZE\n", stderr);
        return 64;
    }
    uint64_t descriptor_value = 0U;
    uint64_t payload_value = 0U;
    if (!parse_u64(argv[1], 3U, INT_MAX, &descriptor_value) ||
            !parse_u64(argv[2], 0U, MAX_PAYLOAD_BYTES, &payload_value)) {
        fputs("sandcodex-wayland-input-method-agent: invalid payload descriptor or size\n", stderr);
        return 64;
    }
    const int payload_descriptor = (int)descriptor_value;
    const size_t payload_size = (size_t)payload_value;

    struct sigaction action = {0};
    action.sa_handler = on_signal;
    if (sigemptyset(&action.sa_mask) < 0 ||
            sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0) {
        perror("sandcodex-wayland-input-method-agent: sigaction");
        return 70;
    }
    struct sigaction ignore = {0};
    ignore.sa_handler = SIG_IGN;
    if (sigemptyset(&ignore.sa_mask) < 0 || sigaction(SIGPIPE, &ignore, NULL) < 0) {
        perror("sandcodex-wayland-input-method-agent: sigaction SIGPIPE");
        return 70;
    }
    bool exec_sealed = false;
    if (harden_process(payload_descriptor, payload_size, &exec_sealed) < 0) {
        perror("sandcodex-wayland-input-method-agent: process hardening");
        return 70;
    }
    if (setvbuf(stdout, NULL, _IOLBF, 0U) != 0) {
        fputs("sandcodex-wayland-input-method-agent: stdout buffering failed\n", stderr);
        return 70;
    }

    struct input_method_state state = {
        .payload_descriptor = payload_descriptor,
        .payload_size = payload_size,
        .payload_exec_sealed = exec_sealed,
    };
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-input-method-agent: Wayland initialization");
        cleanup(&state);
        return 71;
    }
    printf("READY %s MANAGER %u SEATS %u PAYLOAD %zu ACTIVE %u SERIAL %u EXECSEALED %u\n",
        AGENT_PROTOCOL, state.manager_version, state.seat_count, state.payload_size,
        state.active ? 1U : 0U, state.done_serial, state.payload_exec_sealed ? 1U : 0U);

    char line[MAX_LINE_BYTES + 2U];
    uint64_t expected_sequence = 1U;
    int exit_code = 0;
    while (!stop_requested && fgets(line, sizeof(line), stdin) != NULL) {
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n' ||
                (length == MAX_LINE_BYTES + 1U && line[length - 1U] != '\n')) {
            reply_error(expected_sequence, "malformed-command", &state);
            exit_code = 72;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            reply_error(expected_sequence, "invalid-command", &state);
            exit_code = 72;
            break;
        }
        const uint64_t sequence = expected_sequence++;
        if (state.terminal_error || state.unavailable || !state.topology_valid) {
            reply_error(sequence, "terminal-state", &state);
            exit_code = 73;
            break;
        }
        if (command.kind == COMMAND_WAIT_ACTIVE) {
            const int active = wait_for_active(&state, command.timeout_milliseconds);
            if (active < 0) {
                reply_error(sequence, "activation-failed", &state);
                exit_code = 73;
                break;
            }
            if (active == 0) {
                printf("INACTIVE %" PRIu64 " SERIAL %u ACTIVATIONS %u DEACTIVATIONS %u\n",
                    sequence, state.done_serial, state.activations, state.deactivations);
            } else {
                if (!state.commit_epoch_armed) {
                    state.commit_epoch_armed = true;
                    state.epoch_activations = state.activations;
                    state.epoch_deactivations = state.deactivations;
                }
                if (!commit_epoch_intact(&state)) {
                    reply_error(sequence, "activation-epoch-changed", &state);
                    exit_code = 73;
                    break;
                }
                printf("ACTIVE %" PRIu64 " SERIAL %u ACTIVATIONS %u DEACTIVATIONS %u\n",
                    sequence, state.done_serial, state.activations, state.deactivations);
            }
        } else if (command.kind == COMMAND_COMMIT) {
            uint32_t serial_before = 0U;
            if (commit_range(&state, command.offset, command.length, &serial_before) < 0) {
                reply_error(sequence, "commit-failed", &state);
                exit_code = 74;
                break;
            }
            printf("COMMITTED %" PRIu64 " OFFSET %zu BYTES %zu SERIAL %u AFTER %u "
                   "COMMITS %u TOTAL %" PRIu64
                   " ACTIVE 1 ACTIVATIONS %u DEACTIVATIONS %u\n",
                sequence, command.offset, command.length, serial_before,
                state.done_serial, state.commits_confirmed, state.bytes_committed,
                state.activations, state.deactivations);
        } else if (command.kind == COMMAND_PING) {
            if (wl_display_roundtrip(state.display) < 0 || state.terminal_error ||
                    state.unavailable || !state.topology_valid) {
                reply_error(sequence, "ping-failed", &state);
                exit_code = 73;
                break;
            }
            printf("PONG %" PRIu64 " ACTIVE %u SERIAL %u COMMITS %u BYTES %" PRIu64
                   " ACTIVATIONS %u DEACTIVATIONS %u\n",
                sequence, state.active ? 1U : 0U, state.done_serial,
                state.commits_confirmed, state.bytes_committed,
                state.activations, state.deactivations);
        } else {
            printf("BYE %" PRIu64 " COMMITS %u BYTES %" PRIu64
                   " ACTIVE %u SERIAL %u ACTIVATIONS %u DEACTIVATIONS %u\n",
                sequence, state.commits_confirmed, state.bytes_committed,
                state.active ? 1U : 0U, state.done_serial,
                state.activations, state.deactivations);
            break;
        }
    }
    if (ferror(stdin) != 0 && exit_code == 0) {
        exit_code = 75;
    }
    cleanup(&state);
    return exit_code;
}
WAYLAND_INPUT_METHOD_AGENT_C
}

sc_write_desktop_stack_wayland() {
  SC_DESKTOP_DISPLAY_BACKEND=wayland
  local launch="$SC_RUN_ROOT/desktop-launch" server runtime boundary helper tmp
  local context_source context_header context_code context_object context_protocol_object context_helper
