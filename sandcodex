def stylus_rotation_degrees(
    start_degrees: int,
    delta_degrees: int,
    index: int,
    steps: int,
) -> int:
    """Mirror the compositor's signed cumulative tablet rotation interpolation."""
    if index == 0 or delta_degrees == 0:
        return start_degrees
    bounded_index = min(index, steps)
    magnitude = abs(delta_degrees)
    offset = magnitude * bounded_index // steps
    if delta_degrees < 0:
        offset = -offset
    return (start_degrees + offset) % 360


def stylus_slider_65535(
    start_65535: int,
    end_65535: int,
    index: int,
    steps: int,
) -> int:
    """Mirror the compositor's signed cumulative tablet slider interpolation."""
    if index == 0 or start_65535 == end_65535:
        return start_65535
    bounded_index = min(index, steps)
    delta = end_65535 - start_65535
    magnitude = abs(delta) * bounded_index // steps
    if delta < 0:
        magnitude = -magnitude
    return start_65535 + magnitude


def stylus_distance_65535(
    start_65535: int,
    end_65535: int,
    index: int,
    steps: int,
) -> int:
    """Mirror the compositor's unsigned cumulative tablet distance interpolation."""
    if index == 0 or start_65535 == end_65535:
        return start_65535
    bounded_index = min(index, steps)
    delta = end_65535 - start_65535
    magnitude = abs(delta) * bounded_index // steps
    if delta < 0:
        magnitude = -magnitude
    return start_65535 + magnitude
