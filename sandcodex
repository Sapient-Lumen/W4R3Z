            }

    def close(self) -> None:
        self.stop_event.set()
        with self.condition:
            self.condition.notify_all()
        for connection in (self.event_socket, self.command_socket):
            if connection is not None:
                with contextlib.suppress(OSError):
                    connection.shutdown(socket.SHUT_RDWR)
        if self.reader_thread is not None and self.reader_thread is not threading.current_thread():
            self.reader_thread.join(timeout=1.0)
        for connection in (self.event_socket, self.command_socket):
            if connection is not None:
                with contextlib.suppress(OSError):
                    connection.close()


class CompositorEventLedger:
    """Aggregate ordered compositor intervals without retaining application text."""

    INTERVAL_KINDS = frozenset({"preparation", "unit", "gap", "held", "release", "cleanup"})

    def __init__(self, seal: CompositorEventSeal | None, scope: str) -> None:
        self.seal = seal
        self.scope = scope[:128]
        self.event_types: set[str] = set()
        self.changes: set[str] = set()
        self.metadata_changes: set[str] = set()
        self.transition_changes: set[str] = set()
        self.fatal_changes: set[str] = set()
        self.input_lifecycle_counts: dict[str, int] = {}
        self.input_device_digests: set[str] = set()
        self.samples: list[dict[str, Any]] = []
        self.event_chain = "0" * 64
        self.evidence: dict[str, Any] = {
            "schema": COMPOSITOR_UNIT_LEDGER_SCHEMA,
            "event_schema": COMPOSITOR_EVENT_SEAL_SCHEMA,
            "scope": self.scope,
            "enforced": seal is not None,
            "barrier_protocol": "Sway-SEND_TICK-dual-marker-edge+commit",
            "ticks_per_logical_barrier": COMPOSITOR_TICKS_PER_LOGICAL_BARRIER,
            "barriers": 0,
            "sway_ticks": 0,
            "intervals": 0,
            "events": 0,
            "metadata_events": 0,
            "transition_events": 0,
            "fatal_events": 0,
            "event_types": [],
            "changes": [],
            "metadata_changes": [],
            "transition_changes": [],
            "fatal_changes": [],
            "input_lifecycle_counts": {},
            "input_device_digests": [],
            "samples": [],
            "event_chain_sha256": self.event_chain,
        }
        for kind in self.INTERVAL_KINDS:
            self.evidence[f"sealed_{kind}_intervals"] = 0

    def barrier(self, label: str) -> int:
        if self.seal is None:
            return 0
        sequence = self.seal.barrier(f"{self.scope}:{label}")
        self.evidence["barriers"] = int(self.evidence["barriers"]) + 1
        self.evidence["sway_ticks"] = (
            int(self.evidence["sway_ticks"]) + COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
        )
        self.evidence.setdefault("first_barrier_sequence", sequence)
        self.evidence["last_barrier_sequence"] = sequence
        return sequence

    def interval(self, start_sequence: int, end_sequence: int, kind: str) -> dict[str, Any]:
        if kind not in self.INTERVAL_KINDS:
            raise ToolError("unknown compositor unit-ledger interval kind")
        if self.seal is None:
            return {
                "schema": COMPOSITOR_EVENT_SEAL_SCHEMA,
                "enforced": False,
                "start_sequence": start_sequence,
                "end_sequence": end_sequence,
                "events": 0,
                "metadata_events": 0,
                "transition_events": 0,
                "fatal_events": 0,
                "event_types": [],
                "changes": [],
                "metadata_changes": [],
                "transition_changes": [],
                "fatal_changes": [],
                "input_lifecycle": [],
                "input_lifecycle_counts": {},
                "input_device_digests": [],
                "event_sha256": hashlib.sha256(b"[]").hexdigest(),
                "samples": [],
            }
        summary = self.seal.summarize(start_sequence, end_sequence)
        if summary.get("schema") != COMPOSITOR_EVENT_SEAL_SCHEMA or summary.get("enforced") is not True:
            raise ToolError("compositor event seal returned an invalid unit-ledger interval")
        self.evidence["intervals"] = int(self.evidence["intervals"]) + 1
        counter = f"sealed_{kind}_intervals"
        self.evidence[counter] = int(self.evidence[counter]) + 1
        for key in ("events", "metadata_events", "transition_events", "fatal_events"):
            self.evidence[key] = int(self.evidence[key]) + int(summary.get(key, 0))
        for target, key in (
            (self.event_types, "event_types"),
            (self.changes, "changes"),
            (self.metadata_changes, "metadata_changes"),
            (self.transition_changes, "transition_changes"),
            (self.fatal_changes, "fatal_changes"),
        ):
            for value in summary.get(key, []):
                if isinstance(value, str):
                    target.add(value)
        lifecycle_counts = summary.get("input_lifecycle_counts")
        if not isinstance(lifecycle_counts, dict):
            raise ToolError("compositor event seal returned invalid input lifecycle accounting")
        for key, count in lifecycle_counts.items():
            if (
                not isinstance(key, str)
                or not isinstance(count, int)
                or isinstance(count, bool)
                or count < 0
            ):
                raise ToolError("compositor event seal returned malformed input lifecycle accounting")
            self.input_lifecycle_counts[key] = self.input_lifecycle_counts.get(key, 0) + count
        for digest in summary.get("input_device_digests", []):
            if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                raise ToolError("compositor event seal returned a malformed input device digest")
            self.input_device_digests.add(digest)
        for sample in summary.get("samples", []):
            if isinstance(sample, dict) and len(self.samples) < COMPOSITOR_EVENT_MAX_SAMPLES:
                self.samples.append(dict(sample))
        projection = {
            "kind": kind,
            "start_sequence": summary.get("start_sequence"),
            "end_sequence": summary.get("end_sequence"),
            "events": summary.get("events"),
            "metadata_events": summary.get("metadata_events"),
            "transition_events": summary.get("transition_events"),
            "fatal_events": summary.get("fatal_events"),
            "input_lifecycle_counts": summary.get("input_lifecycle_counts"),
            "input_device_digests": summary.get("input_device_digests"),
            "event_sha256": summary.get("event_sha256"),
        }
        self.event_chain = hashlib.sha256(
            self.event_chain.encode("ascii") + canonical_json(projection)
        ).hexdigest()
        if kind not in {"preparation", "cleanup"}:
            self.reject_input_lifecycle(
                summary,
                f"virtual-input device lifecycle changed during compositor {kind} interval",
            )
        return summary

    @staticmethod
    def reason(summary: dict[str, Any], prefix: str) -> str:
        changes = summary.get("changes")
        detail = ",".join(str(value) for value in changes[:8]) if isinstance(changes, list) else "unknown"
        return f"{prefix}: {detail}"[:512]

    @classmethod
    def reject_fatal(
        cls,
        summary: dict[str, Any],
        context: str,
        *,
        allowed_changes: frozenset[str] = frozenset(),
    ) -> int:
        fatal = int(summary.get("fatal_events", 0))
        if not fatal:
            return 0
        changes = summary.get("fatal_changes")
        expected = (
            isinstance(changes, list)
            and bool(changes)
            and set(changes).issubset(allowed_changes)
        )
        if not expected:
            raise ToolError(cls.reason(summary, context))
        return fatal

    @staticmethod
    def input_lifecycle(summary: dict[str, Any]) -> list[dict[str, Any]]:
        lifecycle = summary.get("input_lifecycle")
        if not isinstance(lifecycle, list) or any(not isinstance(event, dict) for event in lifecycle):
            raise ToolError("compositor event seal returned malformed virtual-input lifecycle evidence")
        return [dict(event) for event in lifecycle]

    @classmethod
    def reject_input_lifecycle(cls, summary: dict[str, Any], context: str) -> None:
        lifecycle = cls.input_lifecycle(summary)
        if lifecycle:
            detail = ",".join(
                f"{event.get('change')}:{event.get('input_type')}"
                for event in lifecycle[:8]
            )
            raise ToolError(f"{context}: {detail}"[:512])

    @classmethod
    def require_input_lifecycle(
        cls,
        summary: dict[str, Any],
        change: str,
        input_type: str,
        context: str,
        *,
        expected_identity_sha256: str | None = None,
    ) -> dict[str, Any]:
        lifecycle = cls.input_lifecycle(summary)
        expected_key = f"{change}:{input_type}"
        counts = summary.get("input_lifecycle_counts")
        if not isinstance(counts, dict):
            raise ToolError(f"{context}: lifecycle counts are unavailable")
        if len(lifecycle) != 1 or counts != {expected_key: 1}:
            detail = ",".join(
                f"{event.get('change')}:{event.get('input_type')}"
                for event in lifecycle[:8]
            ) or "none"
            raise ToolError(f"{context}: expected exactly one {expected_key}, observed {detail}"[:512])
        event = lifecycle[0]
        identity = event.get("identity_sha256")
        if not isinstance(identity, str) or re.fullmatch(r"[0-9a-f]{64}", identity) is None:
            raise ToolError(f"{context}: virtual-input event identity is malformed")
        if expected_identity_sha256 is not None and not hmac.compare_digest(identity, expected_identity_sha256):
            raise ToolError(f"{context}: virtual-input event identity does not match SeatSeal inventory")
        return event

    @staticmethod
    def has_transition(summary: dict[str, Any]) -> bool:
        return int(summary.get("transition_events", 0)) > 0

    def finalize(self) -> dict[str, Any]:
        self.evidence["event_types"] = sorted(self.event_types)
        self.evidence["changes"] = sorted(self.changes)
        self.evidence["metadata_changes"] = sorted(self.metadata_changes)
        self.evidence["transition_changes"] = sorted(self.transition_changes)
        self.evidence["fatal_changes"] = sorted(self.fatal_changes)
        self.evidence["input_lifecycle_counts"] = dict(sorted(self.input_lifecycle_counts.items()))
        self.evidence["input_device_digests"] = sorted(self.input_device_digests)
        self.evidence["samples"] = list(self.samples)
        self.evidence["event_chain_sha256"] = self.event_chain
        barriers = self.evidence.get("barriers")
        sway_ticks = self.evidence.get("sway_ticks")
        if (
            not isinstance(barriers, int)
            or isinstance(barriers, bool)
            or barriers < 0
            or not isinstance(sway_ticks, int)
            or isinstance(sway_ticks, bool)
            or sway_ticks != barriers * COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
        ):
            raise ToolError("compositor unit-ledger physical tick accounting is inconsistent")
        first = self.evidence.get("first_barrier_sequence")
        last = self.evidence.get("last_barrier_sequence")
        if isinstance(first, int) and isinstance(last, int):
            self.evidence["barrier_sequence_span"] = max(0, last - first)
        return self.evidence


class WaylandPointerTransaction:
    """One birth-pinned virtual pointer connection for one guarded gesture.

    A virtual button belongs to the virtual device which emitted it. Spawning a
    one-shot client for press, motion, and release can therefore disconnect the
    device while a button is logically held. This transaction keeps one helper,
    one Wayland connection, and one ``zwlr_virtual_pointer_v1`` object alive from
    the first checkpoint through the final verified release.
    """

    def __init__(
        self,
        controller: Any,
        purpose: str,
        *,
        seat_companion_receipt: dict[str, Any] | None = None,
    ) -> None:
        self.controller = controller
        self.purpose = purpose
        self.seat_companion_receipt = seat_companion_receipt
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.commands_completed = 0
        self.helper_button_commands = 0
        self.held_button: int | None = None
        self.compositor_held_button: int | None = None
        self.release_confirmed = True
        self.release_failure_recorded = False
        self.closed = False
        self.ready = False
        self.seat_start_receipt: dict[str, Any] | None = None
        self.seat_stop_receipt: dict[str, Any] | None = None
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self._stdout_buffer = bytearray()
        self._start()

    def _diagnostic(self) -> str:
        process = self.process
        if process is None or process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
                break
            try:
                chunk = os.read(descriptor, min(2048 - len(chunks), 512))
            except OSError:
                break
            if not chunk:
                break
            chunks.extend(chunk)
        return bytes(chunks).decode("utf-8", "replace").strip()

    def _exact_alive(self) -> bool:
        return (
            self.pid is not None
            and self.start_ticks is not None
            and exact_process_alive(self.pid, self.start_ticks)
        )

    def _read_line(self, timeout: float) -> str:
        process = self.process
        if process is None or process.stdout is None:
            raise ToolError("private Wayland pointer transaction has no response channel")
        deadline = time.monotonic() + timeout
        descriptor = process.stdout.fileno()
        while b"\n" not in self._stdout_buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise ToolError("private Wayland pointer transaction response timed out")
            try:
                readable, _, _ = select.select([descriptor], [], [], remaining)
            except (OSError, ValueError) as error:
                raise ToolError(f"private Wayland pointer transaction response failed: {error}") from error
            if not readable:
                raise ToolError("private Wayland pointer transaction response timed out")
            try:
                chunk = os.read(descriptor, POINTER_AGENT_MAX_REPLY_BYTES + 1)
            except OSError as error:
                raise ToolError(f"private Wayland pointer transaction response failed: {error}") from error
            if not chunk:
                diagnostic = self._diagnostic()
                suffix = f": {diagnostic}" if diagnostic else ""
                raise ToolError(f"private Wayland pointer transaction exited before replying{suffix}")
            self._stdout_buffer.extend(chunk)
            if len(self._stdout_buffer) > POINTER_AGENT_MAX_REPLY_BYTES:
                raise ToolError("private Wayland pointer transaction returned an oversized reply")
        raw, _, remainder = self._stdout_buffer.partition(b"\n")
        self._stdout_buffer = bytearray(remainder)
        try:
            return raw.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("private Wayland pointer transaction returned a non-ASCII reply") from error

    def _write_line(self, value: str) -> None:
        process = self.process
        if process is None or process.stdin is None:
            raise ToolError("private Wayland pointer transaction has no command channel")
        payload = value.encode("ascii", "strict")
        descriptor = process.stdin.fileno()
        offset = 0
        try:
            while offset < len(payload):
                written = os.write(descriptor, payload[offset:])
                if written <= 0:
                    raise BrokenPipeError("zero-length write")
                offset += written
        except (BrokenPipeError, OSError) as error:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland pointer transaction command failed{suffix}") from error

    def _start(self) -> None:
        if getattr(self.controller, "_active_pointer_transaction", None) is not None:
            raise ToolError("another private Wayland pointer transaction is already active")
        helper = getattr(self.controller, "pointer_agent", None)
        if not isinstance(helper, Path):
            raise ToolError("private Wayland pointer transaction helper is unavailable")
        environment = self.controller._controller_environment()
        try:
            process = subprocess.Popen(
                [os.fspath(helper)],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=environment,
                start_new_session=True,
                close_fds=True,
                bufsize=0,
            )
        except OSError as error:
            raise ToolError(f"private Wayland pointer transaction could not start: {error}") from error
        self.process = process
        self.pid = process.pid
        identity = None
        for _ in range(100):
            identity = proc_identity(process.pid)
            if identity is not None:
                break
            if process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            with contextlib.suppress(Exception):
                process.kill()
            with contextlib.suppress(Exception):
                process.wait(timeout=1)
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland pointer transaction exited before custody was established{suffix}")
        self.start_ticks = int(identity["start_ticks"])
        try:
            ready = self._read_line(POINTER_AGENT_READY_TIMEOUT_SECONDS)
            expected = f"READY {POINTER_AGENT_PROTOCOL} {process.pid}"
            if ready != expected or not self._exact_alive():
                raise ToolError("private Wayland pointer transaction readiness identity is invalid")
        except Exception:
            self._terminate()
            raise
        try:
            if self.seat_companion_receipt is None:
                self.seat_start_receipt = self.controller._seat_transaction_started(
                    "pointer", self.purpose
                )
            else:
                self.seat_start_receipt = self.controller._seat_transaction_joined(
                    "pointer", self.purpose, self.seat_companion_receipt
                )
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.controller._active_pointer_transaction = self

    def _exchange(
        self,
        command: str,
        *,
        expected: str = "OK",
        expected_held: int | None = None,
    ) -> int:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland pointer transaction lost its birth-pinned helper")
        sequence = self.sequence
        self._write_line(f"{sequence} {command}\n")
        reply = self._read_line(POINTER_AGENT_COMMAND_TIMEOUT_SECONDS)
        match = re.fullmatch(r"(OK|BYE) ([1-9][0-9]*) HELD ([0-3])", reply)
        error_match = re.fullmatch(
            r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) HELD ([0-3])",
            reply,
        )
        if error_match is not None:
            reply_sequence = int(error_match.group(1))
            held = int(error_match.group(3))
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            if reply_sequence != sequence:
                raise ToolError(
                    f"private Wayland pointer transaction returned an error for unexpected sequence "
                    f"{reply_sequence} while awaiting {sequence}{suffix}"
                )
            raise ToolError(
                f"private Wayland pointer transaction rejected sequence {sequence}: "
                f"{error_match.group(2)} (helper-held={held}){suffix}"
            )
        if match is None or match.group(1) != expected or int(match.group(2)) != sequence:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland pointer transaction rejected sequence {sequence}: {reply}{suffix}")
        held = int(match.group(3))
        if expected_held is not None and held != expected_held:
            raise ToolError(
                f"private Wayland pointer transaction held-state acknowledgement changed: "
                f"expected {expected_held}, received {held}"
            )
        self.sequence += 1
        self.commands_completed += 1
        if expected != "BYE" and not self._exact_alive():
            raise ToolError("private Wayland pointer transaction helper changed identity after dispatch")
        return held

    def _expected_held(self) -> int:
        return self.held_button or 0

    def motion(self, x: int, y: int) -> None:
        self._exchange(
            f"MOTION {x} {y} {self.controller.width} {self.controller.height}",
            expected_held=self._expected_held(),
        )
        self.controller.pointer = {"x": x, "y": y}

    def _quarantine_release(self, reason: str) -> None:
        self.controller._quarantine_pointer(
            reason,
            release_failure=not self.release_failure_recorded,
        )
        self.release_failure_recorded = True

    def mark_compositor_press_pending(self, button: int) -> None:
        if button not in {1, 2, 3}:
            raise ToolError("compositor-native drag press supports buttons 1, 2, and 3")
        if (
            self.held_button is not None
            or self.compositor_held_button is not None
            or getattr(self.controller, "pointer_pressed_button", None) is not None
        ):
            self.controller._quarantine_pointer(
                "a compositor-native drag press was requested while a pointer button may already be held"
            )
            raise ToolError("private Wayland pointer transaction already has button authority")
        # The ticket validator runs immediately before dispatch. Mark held state
        # conservatively here because the compositor can accept the press even if
        # the IPC reply is subsequently lost.
        self.compositor_held_button = button
        self.release_confirmed = False
        self.controller.pointer_pressed_button = button

    def confirm_compositor_press(self, button: int) -> None:
        if (
            self.compositor_held_button != button
            or self.held_button is not None
            or getattr(self.controller, "pointer_pressed_button", None) != button
        ):
            self._quarantine_release(
                "compositor-native drag press receipt did not match conservative held state"
            )
            raise ToolError("compositor-native drag press held-state receipt is inconsistent")

    def confirm_compositor_release(self, button: int) -> None:
        if (
            self.compositor_held_button != button
            or self.held_button is not None
            or getattr(self.controller, "pointer_pressed_button", None) != button
        ):
            self._quarantine_release(
                "compositor-native drag release receipt did not match held state"
            )
            raise ToolError("compositor-native drag release held-state receipt is inconsistent")
        self.compositor_held_button = None
        self.release_confirmed = True
        self.controller.pointer_pressed_button = None

    def button(self, button: int, pressed: bool) -> None:
        if button not in {1, 2, 3}:
            raise ToolError("native Wayland pointer transaction supports buttons 1, 2, and 3")
        self.helper_button_commands += 1
        if pressed:
            if (
                self.held_button is not None
                or self.compositor_held_button is not None
                or getattr(self.controller, "pointer_pressed_button", None) is not None
            ):
                self.controller._quarantine_pointer(
                    "a second pointer press was requested during one virtual-pointer transaction"
                )
                raise ToolError("private Wayland pointer transaction already has a held button")
            # Conservatively mark the button before dispatch: the compositor may
            # accept the event even if the acknowledgement transport then fails.
            self.held_button = button
            self.release_confirmed = False
            self.controller.pointer_pressed_button = button
            self._exchange(f"BUTTON {button} 1", expected_held=button)
            return
        if self.held_button != button or getattr(self.controller, "pointer_pressed_button", None) != button:
            self._quarantine_release(
                f"release button {button} did not match the transaction-held button"
            )
            raise ToolError("pointer release did not match the transaction-held button")
        try:
            self._exchange(f"BUTTON {button} 0", expected_held=0)
        except Exception as error:
            self._quarantine_release(
                f"button {button} release could not be confirmed on its birth-pinned virtual pointer"
            )
            raise ToolError(
                "pointer release could not be confirmed on its birth-pinned virtual pointer"
            ) from error
        self.held_button = None
        self.release_confirmed = True
        self.controller.pointer_pressed_button = None

    def click(self, button: int) -> None:
        if button not in {1, 2, 3}:
            raise ToolError("native Wayland pointer transaction supports buttons 1, 2, and 3")
        if self.held_button is not None or getattr(self.controller, "pointer_pressed_button", None) is not None:
            raise ToolError("atomic click is denied while another pointer button is held")
        try:
            self._exchange(f"CLICK {button}", expected_held=0)
        except Exception as error:
            # The compositor can consume the press before the helper loses its
            # reply channel. Without the v2 HELD=0 acknowledgement, completion
            # and release are ambiguous, so no later pointer input is permitted.
            self._quarantine_release(
                f"atomic button {button} click did not return a confirmed released state"
            )
            raise ToolError("atomic pointer click release could not be confirmed") from error

    def scroll(self, delta_x: int, delta_y: int) -> None:
        if delta_x not in {-1, 0, 1} or delta_y not in {-1, 0, 1} or (delta_x == 0 and delta_y == 0):
            raise ToolError("one virtual-pointer scroll unit must contain signed unit deltas")
        self._exchange(f"SCROLL {delta_x} {delta_y}", expected_held=self._expected_held())

    def ping(self) -> None:
        self._exchange("PING", expected_held=self._expected_held())

    def evidence(self) -> dict[str, Any]:
        return {
            "transport": "birth-pinned-single-gesture-wlr-virtual-pointer",
            "protocol": POINTER_AGENT_PROTOCOL,
            "wire_acknowledgement": "sequence-plus-compositor-roundtrip-held-state",
            "connection_scope": "one-guarded-gesture",
            "helper_pid": self.pid,
            "helper_start_ticks": self.start_ticks,
            "commands_completed": self.commands_completed,
            "helper_button_commands": self.helper_button_commands,
            "helper_held_button": self.held_button,
            "compositor_held_button": self.compositor_held_button,
            "held_button": self.held_button or self.compositor_held_button,
            "button_authority": (
                "compositor-native-sway"
                if self.compositor_held_button is not None
                else ("virtual-pointer-helper" if self.held_button is not None else None)
            ),
            "release_confirmed": self.release_confirmed,
            "release_failure_recorded": self.release_failure_recorded,
            "seat_seal_start": self.seat_start_receipt,
            "seat_seal_stop": self.seat_stop_receipt,
            "seat_companion": self.seat_companion_receipt,
            "seat_mode": (
                "dual-device-modifier-gesture"
                if self.seat_companion_receipt is not None
                else "exclusive-pointer"
            ),
            "device_destroy_roundtrip": self.shutdown_confirmed,
            "shutdown_error": self.shutdown_error,
            "closed": self.closed,
        }

    def _terminate(self) -> None:
        process = self.process
        if process is None:
            return
        try:
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=1)
            if self.pid is not None and self.start_ticks is not None and self._exact_alive():
                signal_exact_process(self.pid, self.start_ticks, signal.SIGKILL)
                with contextlib.suppress(Exception):
                    process.wait(timeout=1)
        finally:
            # Transactions are deliberately short-lived, but without explicit
            # closure every completed gesture can retain three pipe descriptors
            # until cyclic GC runs. Close only after the birth-pinned helper has
            # received its shutdown/release opportunity.
            for stream in (process.stdin, process.stdout, process.stderr):
                if stream is not None:
                    with contextlib.suppress(Exception):
                        stream.close()

    def close(self) -> None:
        if self.closed:
            return
        close_error: Exception | None = None
        try:
            if self.compositor_held_button is not None:
                self._quarantine_release(
                    "virtual-pointer transaction ended before compositor-native drag release was confirmed"
                )
                close_error = ToolError(
                    "compositor-native drag button remained held at transport shutdown"
                )
            if self.held_button is not None:
                self.button(self.held_button, False)
            if self._exact_alive():
                self._exchange("QUIT", expected="BYE", expected_held=0)
                self.shutdown_confirmed = True
        except Exception as error:
            close_error = error
            self.shutdown_error = f"{type(error).__name__}: {error}"[:512]
            if self.held_button is not None or self.compositor_held_button is not None:
                self._quarantine_release(
                    "virtual-pointer transaction ended before its held button release was confirmed"
                )
        finally:
            self._terminate()
            try:
                if self.seat_companion_receipt is None:
                    self.seat_stop_receipt = self.controller._seat_transaction_stopped(
                        "pointer", self.purpose, self.seat_start_receipt
                    )
                else:
                    self.seat_stop_receipt = self.controller._seat_transaction_left(
                        "pointer",
                        self.purpose,
                        self.seat_start_receipt,
                        self.seat_companion_receipt,
                    )
            except Exception as seat_error:
                self.controller._quarantine_pointer(
                    f"SeatSeal could not prove virtual-pointer removal: {seat_error}"
                )
                if close_error is None:
                    close_error = seat_error
                else:
                    close_error = ToolError(
                        f"{close_error}; SeatSeal virtual-pointer cleanup also failed: {seat_error}"
                    )
            self.closed = True
            self.ready = False
            if getattr(self.controller, "_active_pointer_transaction", None) is self:
                self.controller._active_pointer_transaction = None
        if close_error is not None:
            raise close_error

    def __enter__(self) -> WaylandPointerTransaction:
        return self

    def __exit__(self, exc_type: Any, exc: BaseException | None, traceback_value: Any) -> bool:
        del exc_type, traceback_value
        try:
            self.close()
        except Exception:
            if exc is None:
                raise
        return False


class WaylandKeyboardTransaction:
    """One birth-pinned keyboard planner for one guarded keyboard operation.

    Guarded released key units are split deliberately.  The helper owns the
    sealed keymap and resolves one exact raw keycode plus serialized modifier
    mask without emitting a key or modifier request.  That one pending plan
    must be consumed immediately by a compositor-native dispatch bearing the
    exact same tuple, and the returned one-use receipt must bind that tuple
    before another plan can be requested.  Cross-device modifier gestures now
    use a compositor-owned exact-recipient arc: the helper remains physically
    released, while Sway owns hold lifetime and de-escalation-only clear.

    A helper command ambiguity remains terminal.  A compositor-native dispatch
    ambiguity is also terminal for the transaction, but it cannot strand
    helper-side key state: no helper key/modifier request was issued and the
    private Sway callback is defined as one complete released unit.
    """

    _modifier_masks = {
        "SHIFT": 1,
        "CTRL": 4,
        "CONTROL": 4,
        "ALT": 8,
        "META": 64,
        "SUPER": 64,
        "WIN": 64,
        "LOGO": 64,
        "ALTGR": 128,
    }
    _modifier_canonical = {
        1: "Shift",
        4: "Ctrl",
        8: "Alt",
        64: "Super",
        128: "AltGr",
    }

    def __init__(self, controller: Any, purpose: str) -> None:
        self.controller = controller
        self.purpose = purpose
        self.process: subprocess.Popen[bytes] | None = None
        self.pid: int | None = None
        self.start_ticks: int | None = None
        self.sequence = 1
        self.commands_completed = 0
        # Dispatch accounting is controller-owned rather than inferred from the
        # helper's aggregate command count.  The initialization probe can thus
        # prove that it exercised keymap preparation and sealing without ever
        # asking the virtual keyboard to emit a key or modifier event.
        self.input_dispatch_attempts = 0
        self.input_dispatches_confirmed = 0
        self.native_plans_completed = 0
        self.native_plans_consumed = 0
        self.native_dispatch_failures = 0
        self.modifier_arc_plans_completed = 0
        self.last_modifier_arc_serialized_mask: int | None = None
        self.modifier_arc_hold_attempts = 0
        self.modifier_arc_holds_confirmed = 0
        self.modifier_arc_release_attempts = 0
        self.modifier_arc_releases_confirmed = 0
        self.modifier_arc_cancellations = 0
        self.modifier_arc_failures = 0
        self.modifier_arc_hold_completion_aborts = 0
        self.modifier_arc_release_confirmation_aborts = 0
        self.modifier_arc_emergency_clear_attempts = 0
        self.modifier_arc_emergency_clears_confirmed = 0
        self.modifier_arc_revocation_forced = False
        self.last_modifier_arc_hold_receipt_sha256: str | None = None
        self.last_modifier_arc_release_receipt_sha256: str | None = None
        self._modifier_arc_pending_mask: int | None = None
        self._modifier_arc_active_mask: int | None = None
        self._modifier_arc_release_inflight: int | None = None
        self.native_plan_chain_sha256 = "0" * 64
        self.native_dispatch_receipt_chain_sha256 = "0" * 64
        self.native_dispatch_receipt_samples: list[dict[str, Any]] = []
        self.last_native_dispatch_receipt_sha256: str | None = None
        self._pending_native_plan: tuple[int, int, int] | None = None
        self._native_dispatch_inflight: tuple[int, int, int] | None = None
        self.held_key = 0
        self.modifier_mask = 0
        self.keymap_entries = 0
        self.keymap_generation = 0
        self.state_receipts = 0
        self.state_transition_failures = 0
        self.sealed_keymap_generation: int | None = None
        self.sealed_keymap_entries: int | None = None
        self.release_confirmed = True
        self.release_recovery_confirmed = False
        self.release_failure_recorded = False
        self.keymap_sealed = False
        self.preparation_locked = False
        self.preparation_completed = False
        self.preparation_commands = 0
        self.prepared_keysyms = 0
        self.runtime_keymap_mutations = 0
        self._pending_keymap_upload = False
        self._prepared_character_ids: set[tuple[str, int | str]] = set()
        self._prepared_chord_commands: set[str] = set()
        self.shutdown_confirmed = False
        self.shutdown_error: str | None = None
        self.terminal_error = False
        self.closed = False
        self.ready = False
        self.seat_start_receipt: dict[str, Any] | None = None
        self.seat_stop_receipt: dict[str, Any] | None = None
        self._stdout_buffer = bytearray()
        self._start()

    def _diagnostic(self) -> str:
        process = self.process
        if process is None or process.stderr is None:
            return ""
        chunks = bytearray()
        descriptor = process.stderr.fileno()
        while len(chunks) < 2048:
            try:
                readable, _, _ = select.select([descriptor], [], [], 0)
            except (OSError, ValueError):
                break
            if not readable:
