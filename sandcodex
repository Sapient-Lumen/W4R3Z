        class FixtureCooldowns:
            blocked = False

            def available(self, _key_id: str, _model: str, *, ignore: bool) -> bool:
                return ignore or not self.blocked

            def record(self, _field: str, _identity: str, _seconds: int, _reason: str) -> None:
                self.blocked = True

            def next_delay(self, _key_ids: Sequence[str], _models: Sequence[str],
                           *, ignore: bool) -> int | None:
                if ignore:
                    return 0
                if self.blocked:
                    self.blocked = False
                    return 1
                return 0

        runtime.cooldowns = FixtureCooldowns()  # type: ignore[assignment]
        calls = [0]
        clock = [0.0]
        original_google_request = globals()["google_request"]
        original_monotonic, original_sleep = time.monotonic, time.sleep

        def fixture_google_request(_base: str, _key: str, _body: dict[str, Any],
                                   _timeout: float) -> dict[str, Any]:
            calls[0] += 1
            if calls[0] == 1:
                raise UpstreamError(429, "quota", 1)
            return {"status": "completed", "steps": [
                {"type": "model_output", "content": "scheduler-ok"}], "usage": {}}

        try:
            globals()["google_request"] = fixture_google_request
            time.monotonic = lambda: clock[0]  # type: ignore[assignment]
            time.sleep = lambda seconds: clock.__setitem__(0, clock[0] + seconds)  # type: ignore[assignment]
            scheduler_request = {"model": "route", "store": False, "stream": False,
                                 "input": [{"type": "message", "role": "user",
                                            "content": [{"type": "input_text", "text": "fixture"}]}]}
            scheduled = runtime.run(scheduler_request)
        finally:
            globals()["google_request"] = original_google_request
            time.monotonic, time.sleep = original_monotonic, original_sleep
        assert calls[0] == 2 and scheduled[2] == "gemini-test"
        assert runtime.wait_count == 1 and runtime.waited_seconds == 1.0

        # The same logical request may make at most two non-authentication
        # attempts per model, even when Codex replays its buffered HTTP request.
        # This is the guard that prevents a 429 from becoming dozens of calls.
        class BudgetAvailable:
            def available(self, _key_id: str, _model: str, *, ignore: bool) -> bool:
                return True

            def record(self, _field: str, _identity: str, _seconds: int,
                       _reason: str) -> None:
                return

            def next_delay(self, _key_ids: Sequence[str], _models: Sequence[str],
                           *, ignore: bool) -> int | None:
                return 0

        runtime.cooldowns = BudgetAvailable()  # type: ignore[assignment]
        budget_calls = [0]

        def budget_google_request(_base: str, _key: str, _body: dict[str, Any],
                                  _timeout: float) -> dict[str, Any]:
            budget_calls[0] += 1
            raise UpstreamError(429, "rate-limit", 1, "model")

        budget_request = dict(scheduler_request)
        budget_request["input"] = [{"type": "message", "role": "user",
                                    "content": [{"type": "input_text",
                                                 "text": "retry-budget"}]}]
        budget_fingerprint = hashlib.sha256(canonical(budget_request)).hexdigest()
        try:
            globals()["google_request"] = budget_google_request
            for _ in range(2):
                try:
                    runtime.run(budget_request, budget_fingerprint)
                    raise AssertionError("rate-limited request unexpectedly succeeded")
                except AdapterError as error:
                    assert error.code == "request_retry_budget_exhausted"
            assert budget_calls[0] == MAX_ROUTE_FAILURES_PER_REQUEST
            assert runtime.retry_budget_exhaustions == 2
        finally:
            globals()["google_request"] = original_google_request

        # A provider response that cannot be projected onto the Responses
        # contract is a compatibility failure, not quota pressure. Preserve
        # the exact projection code and a 502 status after bounded fallback so
        # Codex and the operator never see a fictitious 429.
        projection_calls = [0]

        def projection_google_request(_base: str, _key: str, _body: dict[str, Any],
                                      _timeout: float) -> dict[str, Any]:
            projection_calls[0] += 1
            return {"status": "requires_action", "steps": [{
                "type": "function_call", "id": "unknown-1",
                "name": "not_declared_by_codex", "arguments": {},
            }], "usage": {}}

        projection_request = dict(scheduler_request)
        projection_request["input"] = [{
            "type": "message", "role": "user",
            "content": [{"type": "input_text", "text": "projection-failure"}],
        }]
        try:
            globals()["google_request"] = projection_google_request
            try:
                runtime.run(projection_request)
                raise AssertionError("unprojectable response unexpectedly succeeded")
            except AdapterError as error:
                assert error.status == 502
                assert error.code == "gemini_undeclared_function_call"
            assert projection_calls[0] == MAX_MODEL_FAILURES_PER_REQUEST
            assert runtime.last_error_class == "generation-protocol"
            assert runtime.last_error_code == "gemini_undeclared_function_call"
            assert runtime.projection_failures >= MAX_MODEL_FAILURES_PER_REQUEST
        finally:
            globals()["google_request"] = original_google_request

        # A transport-level replay of the same buffered request must inherit
        # the original deadlines.  Otherwise Codex's own 429 retries can turn
        # a 2-second route wait into an unbounded series of 2-second waits.
        class AlwaysCooling:
            def available(self, _key_id: str, _model: str, *, ignore: bool) -> bool:
                return ignore

            def record(self, _field: str, _identity: str, _seconds: int, _reason: str) -> None:
                return

            def next_delay(self, _key_ids: Sequence[str], _models: Sequence[str],
                           *, ignore: bool) -> int | None:
                return 0 if ignore else 2

        runtime.cooldowns = AlwaysCooling()  # type: ignore[assignment]
        retry_request = dict(scheduler_request)
        retry_request["input"] = [{"type": "message", "role": "user",
                                   "content": [{"type": "input_text", "text": "retry-window"}]}]
        retry_fingerprint = hashlib.sha256(canonical(retry_request)).hexdigest()
        try:
            clock[0] = 10.0
            time.monotonic = lambda: clock[0]  # type: ignore[assignment]
            time.sleep = lambda seconds: clock.__setitem__(0, clock[0] + seconds)  # type: ignore[assignment]
            before_waits = runtime.wait_count
            before_reuses = runtime.request_window_reuses
            try:
                runtime.run(retry_request, retry_fingerprint)
                raise AssertionError("cooling request unexpectedly succeeded")
            except AdapterError as error:
                assert error.code == "request_window_exhausted"
            after_first_waits = runtime.wait_count
            try:
                runtime.run(retry_request, retry_fingerprint)
                raise AssertionError("replayed cooling request unexpectedly succeeded")
            except AdapterError as error:
                assert error.code == "request_window_exhausted"
            assert after_first_waits == before_waits + 1
            assert runtime.wait_count == after_first_waits
            assert runtime.request_window_reuses == before_reuses + 1
        finally:
            time.monotonic, time.sleep = original_monotonic, original_sleep

        # A 429 on the model that emitted a signed function call must continue
        # on the next ranked model in the same logical request.  The exact
        # origin step and function result remain adjacent; no tool is replayed.
        runtime.candidates = ["gemini-origin", "gemini-fallback"]
        runtime.model_attempts = {model: 0 for model in runtime.candidates}
        runtime.model_successes = {model: 0 for model in runtime.candidates}
        runtime.model_failures = {model: 0 for model in runtime.candidates}

        class CrossModelAvailable:
            def available(self, _key_id: str, _model: str, *, ignore: bool) -> bool:
                return True

            def record(self, _field: str, _identity: str, _seconds: int,
                       _reason: str) -> None:
                return

            def next_delay(self, _key_ids: Sequence[str], _models: Sequence[str],
                           *, ignore: bool) -> int | None:
                return 0

        runtime.cooldowns = CrossModelAvailable()  # type: ignore[assignment]
        cross_models: list[str] = []
        cross_bodies: list[dict[str, Any]] = []
        cross_call = {
            "type": "function_call", "id": "cross-call", "name": "tool",
            "arguments": {"x": 9}, "signature": "cross-signature",
        }
        cross_request = {
            "model": "route", "store": False, "stream": False,
            "tools": request["tools"],
            "input": [
                request["input"][0],
