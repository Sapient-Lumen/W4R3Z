Known mutants:
1. incorrectly allows a leading hyphen
2. incorrectly allows uppercase letters
3. incorrectly requires at least one hyphen

Return the smallest candidate-label set that kills all three mutants, sorted and comma-separated.""",
    },
]


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def digest_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def read_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as stream:
        return json.load(stream)


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(value, stream, sort_keys=True, indent=2, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def parse_key_rows(path: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        if not raw.strip():
            continue
        key_id, credential_file, label, remaining = raw.split("\t")
        try:
            remaining_value = int(remaining)
        except ValueError:
            remaining_value = 999999
        rows.append({
            "key_id": key_id,
            "credential_file": credential_file,
            "label": label,
            "remaining": remaining_value,
            "usable": True,
        })
    if not rows:
        raise SystemExit("no usable OpenRouter keys for bench")
    return rows


def response_function_calls(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, dict) or not isinstance(value.get("output"), list):
        return []
    result: list[dict[str, Any]] = []
    for item in value["output"]:
        if not isinstance(item, dict) or item.get("type") != "function_call":
            continue
        result.append({"name": item.get("name"), "arguments": item.get("arguments")})
    return result


def extract_forced_tool_answer(response: dict[str, Any]) -> str:
    tool_name = "submit_sandcodex_bench_answer"
    calls = response_function_calls(response)
    if len(calls) != 1 or calls[0].get("name") != tool_name:
        raise ValueError("model did not make exactly one forced bench-answer tool call")
    arguments = calls[0].get("arguments")
    if not isinstance(arguments, str) or len(arguments) > 8192:
        raise ValueError("bench-answer tool arguments are not a bounded JSON string")
    parsed = json.loads(arguments)
    if not isinstance(parsed, dict) or set(parsed) != {"answer"} or not isinstance(parsed.get("answer"), str):
        raise ValueError("bench-answer tool arguments lack a string answer")
    return parsed["answer"]


def grade(task: dict[str, Any], answer: str) -> dict[str, Any]:
    output_sha = digest_bytes(answer.encode("utf-8", "replace"))
    if not isinstance(answer, str):
        return {
            "name": task["name"],
            "points": 0,
            "possible_points": task["points"],
            "passed": False,
            "detail": "answer_not_string",
            "output_sha256": output_sha,
        }
    expected = task["expected"]
    passed = answer.strip() == expected
    return {
        "name": task["name"],
        "points": task["points"] if passed else 0,
        "possible_points": task["points"],
        "passed": passed,
        "detail": "ok" if passed else "wrong_answer",
        "output_sha256": output_sha,
    }


class HTTPFailure(Exception):
    def __init__(self, status: int, category: str):
        super().__init__(category)
        self.status = status
        self.category = category


class RequestDeadlineExceeded(TimeoutError):
    pass


def classify_http_failure(status: int, payload: bytes) -> str:
    """Classify a bounded provider error privately; never retain its text."""
    lowered = payload.decode("utf-8", "replace").lower()
    if status == 429 and (
        "temporarily rate-limited upstream" in lowered
        or "provider returned error" in lowered
    ):
        return "upstream_model_rate_limited"
    if status == 403 and "only available on agentic harnesses" in lowered:
        return "model_requires_agentic_harness"
    if status in {401, 402, 403, 429}:
        return "account_or_quota"
    return f"http_{status}"


def classify_exception(error: Exception) -> str:
    if isinstance(error, RequestDeadlineExceeded):
        return "request_deadline"
    if isinstance(error, (urllib.error.URLError, TimeoutError, OSError)):
        return "transport"
    if isinstance(error, (ValueError, RuntimeError, json.JSONDecodeError)):
        return "invalid_provider_response"
    return "internal"


def with_request_deadline(seconds: float):
    class Deadline:
        def __enter__(self):
            self.old_handler = signal.getsignal(signal.SIGALRM)

            def raise_deadline(signum, frame):  # type: ignore[no-untyped-def]
                raise RequestDeadlineExceeded("request wall-clock deadline exceeded")

            signal.signal(signal.SIGALRM, raise_deadline)
            signal.setitimer(signal.ITIMER_REAL, max(1.0, float(seconds)))

        def __exit__(self, exc_type, exc, tb):  # type: ignore[no-untyped-def]
            signal.setitimer(signal.ITIMER_REAL, 0.0)
            signal.signal(signal.SIGALRM, self.old_handler)
            return False

    return Deadline()


def responses_request(model: str, task: dict[str, Any], key: dict[str, Any], timeout: float) -> tuple[str, int]:
    credential = Path(key["credential_file"]).read_text(encoding="utf-8")
    tool_name = "submit_sandcodex_bench_answer"
    body = {
        "model": model,
        "instructions": (
            "You are running a deterministic coding benchmark for Sandcodex. "
            "Use the forced tool call to submit the exact requested answer string. No prose."
        ),
        "input": task["prompt"],
        "max_output_tokens": 768,
        "store": False,
        "parallel_tool_calls": False,
        "tools": [{
            "type": "function",
            "name": tool_name,
            "description": "Submit one deterministic Sandcodex coding-benchmark answer.",
            "strict": True,
            "parameters": {
                "type": "object",
                "properties": {
                    "answer": {"type": "string", "minLength": 0, "maxLength": 512},
                },
                "required": ["answer"],
                "additionalProperties": False,
            },
        }],
        "tool_choice": {"type": "function", "name": tool_name},
    }
    data = canonical(body)
    if len(data) > MAX_REQUEST_BYTES:
        raise RuntimeError("bench request exceeded internal byte bound")
    request = urllib.request.Request(
        "https://openrouter.ai/api/v1/responses",
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {credential}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "sandcodex-openrouter-bench/1",
        },
    )
    started = time.monotonic()
    try:
        with with_request_deadline(timeout):
            with urllib.request.urlopen(request, timeout=timeout, context=ssl.create_default_context()) as response:
                payload = response.read(MAX_RESPONSE_BYTES + 1)
                status = response.status
    except urllib.error.HTTPError as error:
        category = classify_http_failure(error.code, error.read(4096))
        raise HTTPFailure(error.code, category) from error
    except RequestDeadlineExceeded:
        raise
    if len(payload) > MAX_RESPONSE_BYTES:
        raise RuntimeError("bench response exceeded byte bound")
    try:
        decoded = json.loads(payload.decode("utf-8", "replace"))
    except json.JSONDecodeError as exc:
        raise RuntimeError("provider response was not JSON") from exc
    duration_ms = int((time.monotonic() - started) * 1000)
    answer = extract_forced_tool_answer(decoded)
    return answer, duration_ms


def choose_key(keys: list[dict[str, Any]]) -> dict[str, Any] | None:
    usable = [row for row in keys if row.get("usable") and int(row.get("remaining", 0)) > 0]
    if not usable:
        return None
    usable.sort(key=lambda row: (-int(row.get("remaining", 0)), str(row.get("key_id", ""))))
    return usable[0]


def run_task(model: str, task: dict[str, Any], keys: list[dict[str, Any]], timeout: float) -> dict[str, Any]:
    attempts: list[dict[str, Any]] = []
    while True:
        key = choose_key(keys)
        if key is None:
            return {
                "name": task["name"],
                "points": 0,
                "possible_points": task["points"],
                "passed": False,
                "detail": "no_key_with_reported_remaining_quota",
                "attempts": attempts,
            }
        try:
            text, duration_ms = responses_request(model, task, key, timeout)
            if int(key.get("remaining", 999999)) != 999999:
                key["remaining"] = max(0, int(key["remaining"]) - 1)
            result = grade(task, text)
            result.update({
                "duration_ms": duration_ms,
                "key_id": key["key_id"],
                "attempts": attempts,
            })
            return result
        except HTTPFailure as exc:
            attempts.append({
                "key_id": key["key_id"], "status": exc.status, "category": exc.category,
            })
            if exc.category == "upstream_model_rate_limited":
                return {
                    "name": task["name"],
                    "points": 0,
                    "possible_points": task["points"],
                    "passed": False,
                    "detail": "http_429_upstream_model_rate_limited",
                    "attempts": attempts,
                }
            if exc.category == "model_requires_agentic_harness":
                return {
                    "name": task["name"],
                    "points": 0,
                    "possible_points": task["points"],
                    "passed": False,
                    "detail": "http_403_model_requires_agentic_harness",
                    "attempts": attempts,
                }
            if exc.status in {401, 402, 403, 429}:
                key["usable"] = False
                continue
            return {
                "name": task["name"],
                "points": 0,
                "possible_points": task["points"],
                "passed": False,
                "detail": f"http_{exc.status}",
                "attempts": attempts,
            }
        except Exception as exc:
            category = classify_exception(exc)
            attempts.append({"key_id": key["key_id"], "status": None, "category": category})
            return {
                "name": task["name"],
                "points": 0,
                "possible_points": task["points"],
                "passed": False,
                "detail": f"error:{category}",
                "attempts": attempts,
            }


def model_cache_path(root: Path, model: str) -> Path:
    return root / f"{digest_bytes((BENCH_VERSION + '\\0' + model).encode())}.json"


def valid_cached(value: Any, model: str) -> bool:
    return (
        isinstance(value, dict)
        and value.get("schema") == MODEL_SCHEMA
        and value.get("bench_version") == BENCH_VERSION
        and value.get("model") == model
        and isinstance(value.get("score"), dict)
        and isinstance(value.get("tasks"), list)
    )


def bench_model(model_row: dict[str, Any], keys: list[dict[str, Any]], cache_root: Path, timeout: float, force: bool) -> dict[str, Any]:
    model = model_row["id"]
    cache_path = model_cache_path(cache_root, model)
    if not force and cache_path.exists() and not cache_path.is_symlink():
        try:
            cached = read_json(cache_path)
            if valid_cached(cached, model):
                cached["cached"] = True
                return cached
        except Exception:
            pass
    started = time.monotonic()
    task_results = [run_task(model, task, keys, timeout) for task in TASKS]
    points = sum(int(row.get("points", 0)) for row in task_results)
    possible = sum(int(row["points"]) for row in TASKS)
    passed = sum(1 for row in task_results if row.get("passed") is True)
    result = {
        "schema": MODEL_SCHEMA,
        "result": "bench_model",
        "bench_version": BENCH_VERSION,
        "bench_version_sha256": digest_bytes(canonical(TASKS)),
        "created_at": utc_now(),
        "model": model,
        "catalog_rank": model_row.get("rank"),
        "metadata_strength_score": model_row.get("strength_score"),
        "score": {
            "points": points,
            "possible_points": possible,
            "passed_tasks": passed,
            "task_count": len(TASKS),
            "percent": round(points / possible, 4) if possible else 0,
        },
        "duration_ms": int((time.monotonic() - started) * 1000),
        "tasks": task_results,
        "cached": False,
        "retention": {
            "credential_value_persisted": False,
            "raw_prompt_persisted": False,
            "raw_provider_output_persisted": False,
        },
    }
    atomic_json(cache_path, result)
    return result


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--bank-file", type=Path, required=True)
    parser.add_argument("--keys-file", type=Path, required=True)
    parser.add_argument("--cache-root", type=Path, required=True)
    parser.add_argument("--sleep", type=float, default=1.0)
    parser.add_argument("--timeout", type=float, default=20.0)
    parser.add_argument("--timestamp")
    parser.add_argument("--force", action="store_true")
    args = parser.parse_args(argv)
    bank = read_json(args.bank_file)
    keys = parse_key_rows(args.keys_file)
    args.cache_root.mkdir(parents=True, exist_ok=True)
    os.chmod(args.cache_root, 0o700)
    rows = []
    total = len(bank.get("models", []))
    for index, model_row in enumerate(bank.get("models", []), 1):
        model = model_row.get("id")
        if not isinstance(model, str) or not model:
            continue
        print(f"bench openrouter free model {index}/{total} · {model}", file=sys.stderr, flush=True)
        result = bench_model(model_row, keys, args.cache_root, args.timeout, args.force)
        rows.append(result)
        if index < total and args.sleep > 0:
            time.sleep(args.sleep)
    for row in rows:
        score = row["score"]
        row["coding_rank_score"] = (
            int(score["points"]) * 100000
            + int(score["passed_tasks"]) * 1000
            + float(row.get("metadata_strength_score") or 0)
        )
    rows.sort(key=lambda row: (-float(row.get("coding_rank_score", 0)), -float(row.get("metadata_strength_score") or 0), row["model"]))
    for index, row in enumerate(rows, 1):
        row["coding_rank"] = index
    summary = {
        "schema": SCHEMA,
        "result": "bench",
        "provider": "openrouter",
        "created_at": args.timestamp or utc_now(),
        "source_url": bank.get("source_url"),
        "bench_version": BENCH_VERSION,
        "bench_version_sha256": digest_bytes(canonical(TASKS)),
        "candidate_count": total,
        "scored_count": len(rows),
        "filters": bank.get("filters"),
        "tasks": [
            {"name": task["name"], "points": task["points"], "kind": task["kind"]}
            for task in TASKS
        ],
        "credential_values_disclosed": False,
        "raw_provider_content_disclosed": False,
        "ranking_policy": "coding_rank_score = bench points first, passed task count second, metadata heuristic third",
        "request_timeout_seconds": args.timeout,
        "models": rows,
    }
    print(json.dumps(summary, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_REMOTE_BENCH_PY
}

sc_emit_openrouter_responses_router() {
  cat <<'SANDCODEX_OPENROUTER_RESPONSES_ROUTER_PY'
#!/usr/bin/env python3
"""Bounded, credential-isolating OpenRouter Responses relay for Sandcodex.

The relay is deliberately narrower than a general HTTP proxy.  It accepts one
loopback Responses endpoint, translates the reviewed Codex namespace/custom
tool surface to ordinary functions, buffers a complete upstream response, and
may retry another bound free agent-candidate model/key route only before any bytes are
visible to Codex.  It never executes a tool and never retains prompt or
provider-output content in its receipt. The preferred model has passed the full
Sandcodex qualifier; fallback models are metadata-admitted free agent
candidates whose actual response must pass this relay's structural validation
before it can become visible.
"""
from __future__ import annotations

import argparse
import copy
import hashlib
import hmac
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import ipaddress
import json
import os
from pathlib import Path
import re
import signal
import socket
import ssl
import stat
import tempfile
import threading
import time
from typing import Any, Mapping
from urllib.parse import urlsplit


SCHEMA = "sandcodex.openrouter-responses-router.v1"
STATE_SCHEMA = "sandcodex.openrouter-responses-router-state.v1"
READY_SCHEMA = "sandcodex.openrouter-responses-router-ready.v1"
KEY_RE = re.compile(r"^sk-or-v1-[A-Za-z0-9_-]{32,}$")
LABEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")
MODEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}$")
TOOL_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$")
RETRYABLE_HTTP = frozenset({402, 408, 409, 425, 429, 500, 502, 503, 504, 524, 529})
class RelayError(RuntimeError):
    def __init__(self, code: str, message: str, *, status: int = 502, retryable: bool = False):
        super().__init__(message)
        self.code = code
        self.status = status
        self.retryable = retryable


def canonical(value: object) -> bytes:
    try:
        return json.dumps(
            value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False,
        ).encode("utf-8")
    except (TypeError, ValueError) as exc:
        raise RelayError("invalid_json", "value is not canonical JSON", status=400) from exc


def safe_read(path: Path, *, maximum: int, mode: int | None = None) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as exc:
        raise RelayError("unsafe_input", f"could not open protected input: {path}", status=78) from exc
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1
            or metadata.st_mode & 0o022
            or mode is not None and stat.S_IMODE(metadata.st_mode) != mode
            or metadata.st_size > maximum
        ):
            raise RelayError("unsafe_input", f"protected input metadata is unsafe: {path}", status=78)
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(1 << 20, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        result = b"".join(chunks)
        if len(result) > maximum:
            raise RelayError("unsafe_input", f"protected input exceeds its byte limit: {path}", status=78)
        return result
    finally:
        os.close(descriptor)


def atomic_json(path: Path, value: Mapping[str, object]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            os.fchmod(output.fileno(), 0o600)
            output.write(canonical(value) + b"\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load_json_file(path: Path, *, maximum: int) -> dict[str, Any]:
    try:
        value = json.loads(safe_read(path, maximum=maximum))
    except (UnicodeError, ValueError) as exc:
        raise RelayError("invalid_input", f"protected JSON input is invalid: {path}", status=78) from exc
    if not isinstance(value, dict):
        raise RelayError("invalid_input", f"protected JSON input is not an object: {path}", status=78)
    return value


def parse_key_bank(path: Path) -> list[tuple[str, str, str]]:
    try:
        lines = safe_read(path, maximum=1 << 20, mode=0o600).decode("utf-8").splitlines()
    except UnicodeError as exc:
        raise RelayError("invalid_key_bank", "OpenRouter key bank is not UTF-8", status=78) from exc
    rows: list[tuple[str, str, str]] = []
    seen: set[str] = set()
    for number, raw in enumerate(lines, 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        label, key = "", line
        if "=" in line and not line.startswith("sk-or-v1-"):
            label, key = (part.strip() for part in line.split("=", 1))
        else:
            fields = line.split()
            if len(fields) == 2 and fields[1].startswith("sk-or-v1-"):
                label, key = fields
        if KEY_RE.fullmatch(key) is None:
            raise RelayError("invalid_key_bank", f"invalid OpenRouter key on line {number}", status=78)
        if label and LABEL_RE.fullmatch(label) is None:
            raise RelayError("invalid_key_bank", f"invalid OpenRouter label on line {number}", status=78)
        digest = hashlib.sha256(key.encode()).hexdigest()
        if digest in seen:
            continue
        seen.add(digest)
        rows.append((digest[:12], label or f"key-{len(rows) + 1:02d}", key))
    if not rows:
        raise RelayError("invalid_key_bank", "OpenRouter key bank contains no keys", status=78)
    return rows


def parse_model_bank(path: Path, preferred: str) -> list[str]:
    value = load_json_file(path, maximum=16 << 20)
    if value.get("schema") != "sandcodex.openrouter-model-bank.v1" or value.get("provider") != "openrouter":
        raise RelayError("invalid_model_bank", "OpenRouter model bank schema is invalid", status=78)
    raw = value.get("models")
    if not isinstance(raw, list) or not raw:
        raise RelayError("invalid_model_bank", "OpenRouter model bank has no candidates", status=78)
    models: list[str] = []
    for row in raw:
        if not isinstance(row, dict):
            continue
        model = row.get("id")
        if (
            isinstance(model, str)
            and MODEL_RE.fullmatch(model)
            and row.get("free") is True
            and row.get("agent_candidate") is True
            and model not in models
        ):
            models.append(model)
    if preferred not in models:
        raise RelayError("invalid_model_bank", "selected model is absent from the free agent-candidate bank", status=78)
    return [preferred, *(model for model in models if model != preferred)]


def alias_for(kind: str, name: str, namespace: str | None) -> str:
    if kind == "function" and namespace is None and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,63}", name):
        return name
    identity = f"{kind}\0{namespace or ''}\0{name}".encode()
    digest = hashlib.sha256(identity).hexdigest()[:12]
    stem = re.sub(r"[^A-Za-z0-9_]", "_", name).strip("_") or "tool"
    return f"sc_{digest}_{stem}"[:64]


def custom_parameters(name: str) -> tuple[str, dict[str, Any]]:
    field = "code" if name == "exec" else "patch" if name == "apply_patch" else "input"
    return field, {
        "type": "object",
        "properties": {field: {"type": "string"}},
        "required": [field],
        "additionalProperties": False,
    }


class ToolBridge:
    def __init__(self, request: Mapping[str, Any]):
        self.by_alias: dict[str, dict[str, str | None]] = {}
        self.by_identity: dict[tuple[str, str | None, str], str] = {}
        self._discover(request)

    def _register(self, kind: str, name: object, namespace: object = None) -> str:
        if kind not in {"function", "custom", "tool_search"}:
            raise RelayError("unsupported_tool", "unsupported Codex tool kind", status=422)
        if not isinstance(name, str) or TOOL_RE.fullmatch(name) is None:
            raise RelayError("invalid_tool", "tool name is malformed", status=422)
        if namespace is not None and (not isinstance(namespace, str) or TOOL_RE.fullmatch(namespace) is None):
            raise RelayError("invalid_tool", "tool namespace is malformed", status=422)
        identity = (kind, namespace, name)
        alias = alias_for(kind, name, namespace)
        previous = self.by_alias.get(alias)
        metadata = {"kind": kind, "namespace": namespace, "name": name}
        if previous is not None and previous != metadata:
            raise RelayError("tool_collision", "tool identities collide after flattening", status=422)
        self.by_alias[alias] = metadata
        self.by_identity[identity] = alias
        return alias

    def _discover_deferred(self, item: Mapping[str, Any]) -> None:
        tools = item.get("tools")
        if not isinstance(tools, list):
            raise RelayError("invalid_tool_search", "tool-search output has no tools array", status=422)
        for tool in tools:
            if not isinstance(tool, dict):
                raise RelayError("invalid_tool_search", "tool-search output contains a malformed tool", status=422)
            if tool.get("type") == "namespace":
                namespace = tool.get("name")
                children = tool.get("tools")
                if not isinstance(children, list) or not children:
                    raise RelayError("invalid_tool_search", "tool-search namespace is empty", status=422)
                for child in children:
                    if not isinstance(child, dict) or child.get("type") not in {"function", "custom"}:
                        raise RelayError("unsupported_tool", "tool-search namespace contains an unsupported tool", status=422)
                    self._register(str(child["type"]), child.get("name"), namespace)
            elif tool.get("type") in {"function", "custom"}:
                self._register(str(tool["type"]), tool.get("name"))
            else:
                raise RelayError("unsupported_tool", "tool-search output contains an unsupported tool", status=422)

    def _discover(self, request: Mapping[str, Any]) -> None:
        tools = request.get("tools", [])
        if not isinstance(tools, list) or len(tools) > 1024:
            raise RelayError("invalid_tools", "tools must be a bounded array", status=422)
        for tool in tools:
            if not isinstance(tool, dict):
                raise RelayError("invalid_tool", "tool declaration is not an object", status=422)
            kind = tool.get("type")
            if kind in {"function", "custom"}:
                self._register(str(kind), tool.get("name"))
            elif kind == "namespace":
                namespace, children = tool.get("name"), tool.get("tools")
                if not isinstance(children, list) or not children:
                    raise RelayError("invalid_tool", "namespace declaration is empty", status=422)
                for child in children:
                    if not isinstance(child, dict) or child.get("type") not in {"function", "custom"}:
                        raise RelayError("unsupported_tool", "namespace contains an unsupported tool", status=422)
                    self._register(str(child["type"]), child.get("name"), namespace)
            elif kind == "tool_search":
                self._register("tool_search", "tool_search")
            else:
                raise RelayError("unsupported_tool", "provider relay accepts only function, custom, namespace, and tool-search declarations", status=422)
        input_items = request.get("input", [])
        if isinstance(input_items, list):
            for item in input_items:
                if isinstance(item, dict) and item.get("type") == "tool_search_output":
                    self._discover_deferred(item)
        if len(self.by_alias) > 1024:
            raise RelayError("too_many_tools", "flattened tool declarations exceed the relay limit", status=422)

    def _ordinary(self, tool: Mapping[str, Any], *, namespace: str | None = None) -> dict[str, Any]:
        kind, name = tool.get("type"), tool.get("name")
        alias = self.by_identity[(str(kind), namespace, str(name))]
        row: dict[str, Any] = {"type": "function", "name": alias}
        description = tool.get("description")
        if description is not None and not isinstance(description, str):
            raise RelayError("invalid_tool", "tool description must be a string", status=422)
        if kind == "function":
            parameters = tool.get("parameters") or {"type": "object", "properties": {}}
            if not isinstance(parameters, dict):
                raise RelayError("invalid_tool", "function parameters must be an object", status=422)
            row["parameters"] = copy.deepcopy(parameters)
            if "strict" in tool:
                if not isinstance(tool["strict"], bool):
                    raise RelayError("invalid_tool", "function strict must be boolean", status=422)
                row["strict"] = tool["strict"]
        else:
            _field, parameters = custom_parameters(str(name))
            row["parameters"] = parameters
            row["strict"] = True
        prefix = f"Codex namespace {namespace!r}; original tool {name!r}. " if namespace else ""
        if kind == "tool_search":
            prefix += "Return matching client tool declarations; call a returned tool on the following turn. "
        if description or prefix:
            row["description"] = (prefix + (description or "")).strip()
        return row

    def flatten_tools(self, request: Mapping[str, Any]) -> list[dict[str, Any]]:
        result: list[dict[str, Any]] = []
        seen: set[str] = set()
        for tool in request.get("tools", []):
            kind = tool.get("type")
            if kind == "namespace":
                for child in tool["tools"]:
                    row = self._ordinary(child, namespace=tool["name"])
                    if row["name"] not in seen:
                        result.append(row); seen.add(row["name"])
            elif kind == "tool_search":
                synthetic = dict(tool); synthetic["type"] = "tool_search"; synthetic["name"] = "tool_search"
                row = self._ordinary(synthetic)
                if row["name"] not in seen:
                    result.append(row); seen.add(row["name"])
            else:
                row = self._ordinary(tool)
                if row["name"] not in seen:
                    result.append(row); seen.add(row["name"])
        # Deferred discoveries are declarations, not arbitrary model-visible content.
        for item in request.get("input", []) if isinstance(request.get("input"), list) else []:
            if not isinstance(item, dict) or item.get("type") != "tool_search_output":
                continue
            for tool in item["tools"]:
                if tool.get("type") == "namespace":
                    for child in tool["tools"]:
                        row = self._ordinary(child, namespace=tool["name"])
                        if row["name"] not in seen:
                            result.append(row); seen.add(row["name"])
                else:
                    row = self._ordinary(tool)
                    if row["name"] not in seen:
                        result.append(row); seen.add(row["name"])
        return result

    def _alias_for_item(self, item: Mapping[str, Any], kind: str) -> str:
        name = item.get("name")
        namespace = item.get("namespace")
        if kind == "tool_search":
            name, namespace = "tool_search", None
        identity = (kind, namespace if isinstance(namespace, str) else None, str(name))
        alias = self.by_identity.get(identity)
        if alias is None:
            raise RelayError("unknown_tool", "tool history names an undeclared identity", status=422)
        return alias

    def flatten_input(self, value: object) -> object:
        if isinstance(value, str) or value is None:
            return value
        if not isinstance(value, list) or len(value) > 100_000:
            raise RelayError("invalid_input", "Responses input must be a string or bounded array", status=422)
        result: list[object] = []
        calls: dict[str, str] = {}
        outputs: set[str] = set()
        for raw in value:
            if not isinstance(raw, dict):
                result.append(copy.deepcopy(raw)); continue
            item = copy.deepcopy(raw)
            kind = item.get("type")
            if kind in {"function_call", "custom_tool_call", "tool_search_call"}:
                logical = "function" if kind == "function_call" else "custom" if kind == "custom_tool_call" else "tool_search"
                alias = self._alias_for_item(item, logical)
                call_id = item.get("call_id")
                if not isinstance(call_id, str) or not call_id or call_id in calls:
                    raise RelayError("invalid_tool_history", "tool history has a missing or duplicate call identity", status=422)
                calls[call_id] = logical
                if logical == "function":
                    arguments = item.get("arguments")
                    if not isinstance(arguments, str):
                        raise RelayError("invalid_tool_history", "function call arguments must be a string", status=422)
                else:
                    source = item.get("input")
                    if not isinstance(source, str):
                        raise RelayError("invalid_tool_history", "custom tool input must be a string", status=422)
                    original_name = "tool_search" if logical == "tool_search" else str(item.get("name"))
                    field, _parameters = custom_parameters(original_name)
                    arguments = canonical({field: source}).decode()
                keep = {key: copy.deepcopy(item[key]) for key in ("id", "call_id", "status") if key in item}
                keep.update({"type": "function_call", "name": alias, "arguments": arguments})
                result.append(keep)
            elif kind in {"function_call_output", "custom_tool_call_output", "tool_search_output"}:
                call_id = item.get("call_id")
                if not isinstance(call_id, str) or call_id not in calls or call_id in outputs:
                    raise RelayError("invalid_tool_history", "tool result does not pair with exactly one prior call", status=422)
                outputs.add(call_id)
                output = item.get("output")
                if kind == "tool_search_output":
                    output = canonical({"tools": item.get("tools", [])}).decode()
                keep = {key: copy.deepcopy(item[key]) for key in ("id", "call_id", "status") if key in item}
                keep.update({"type": "function_call_output", "output": output})
                result.append(keep)
            else:
                result.append(item)
        if set(calls) != outputs:
            raise RelayError("invalid_tool_history", "provider-bound history contains unresolved tool calls", status=422)
        return result

    def flatten_request(self, request: Mapping[str, Any], model: str) -> dict[str, Any]:
        result = copy.deepcopy(dict(request))
        if result.get("previous_response_id") not in (None, ""):
            raise RelayError("stateful_request_unsupported", "router requires self-contained stateless history", status=422)
        result.pop("previous_response_id", None)
        result["store"] = False
        result["model"] = model
        result["tools"] = self.flatten_tools(request)
        result["input"] = self.flatten_input(request.get("input"))
        choice = request.get("tool_choice")
        if isinstance(choice, dict):
            kind = choice.get("type")
            logical = (
                "function" if kind == "function" else
                "custom" if kind == "custom" else
                "tool_search" if kind == "tool_search" else None
            )
            if logical is None:
                raise RelayError("unsupported_tool_choice", "tool choice is not translatable", status=422)
            identity = (
                ("tool_search", None, "tool_search") if logical == "tool_search" else
                (logical, choice.get("namespace"), choice.get("name"))
            )
            alias = self.by_identity.get(identity)
            if alias is None:
                raise RelayError("unsupported_tool_choice", "tool choice names an unavailable tool", status=422)
            result["tool_choice"] = {"type": "function", "name": alias}
        return result

    def restore_call(self, item: Mapping[str, Any]) -> dict[str, Any]:
        if item.get("type") != "function_call":
            return copy.deepcopy(dict(item))
        name = item.get("name")
        metadata = self.by_alias.get(str(name))
        if metadata is None:
            raise RelayError("unknown_provider_tool", "provider returned an unknown tool identity")
        result = copy.deepcopy(dict(item))
        kind = metadata["kind"]
        result["name"] = metadata["name"]
        if metadata["namespace"] is not None:
            result["namespace"] = metadata["namespace"]
        if kind == "function":
            return result
        try:
            arguments = json.loads(str(result.pop("arguments")))
        except (TypeError, ValueError) as exc:
            raise RelayError("invalid_provider_tool", "provider custom-tool arguments are invalid") from exc
        original_name = "tool_search" if kind == "tool_search" else str(metadata["name"])
        field, _parameters = custom_parameters(original_name)
        if not isinstance(arguments, dict) or set(arguments) != {field} or not isinstance(arguments[field], str):
            raise RelayError("invalid_provider_tool", "provider custom-tool arguments have the wrong shape")
        result["input"] = arguments[field]
        result["type"] = "tool_search_call" if kind == "tool_search" else "custom_tool_call"
        if kind == "tool_search":
            result.pop("name", None)
        return result

    def restore_response(self, response: Mapping[str, Any]) -> dict[str, Any]:
        result = copy.deepcopy(dict(response))
        output = result.get("output")
        if isinstance(output, list):
            result["output"] = [self.restore_call(item) if isinstance(item, dict) else item for item in output]
        return result

    def restore_sse(self, raw: bytes) -> bytes:
        try:
            text = raw.decode("utf-8")
        except UnicodeError as exc:
            raise RelayError("invalid_provider_stream", "provider SSE is not UTF-8") from exc
        frames: list[bytes] = []
        terminal = False
        done = False
        argument_buffers: dict[str, str] = {}
        custom_items: dict[str, dict[str, Any]] = {}
        for block in re.split(r"\r?\n\r?\n", text):
            if not block:
                continue
            prefix: list[str] = []
            data_lines: list[str] = []
            for line in block.splitlines():
                if line.startswith("data:"):
                    data_lines.append(line[5:].lstrip(" "))
                elif not line.startswith("event:"):
                    prefix.append(line)
            if not data_lines:
                continue
            data = "\n".join(data_lines)
            if data == "[DONE]":
                if not terminal or done:
                    raise RelayError(
                        "incomplete_provider_stream",
                        "provider stream ended before one completed terminal event",
                        retryable=True,
                    )
                done = True
                frames.append(b"data: [DONE]\n\n"); continue
            try:
                event = json.loads(data)
            except ValueError as exc:
                raise RelayError("invalid_provider_stream", "provider SSE event is not JSON") from exc
            if not isinstance(event, dict) or not isinstance(event.get("type"), str):
                raise RelayError("invalid_provider_stream", "provider SSE event shape is invalid")
            event_type = event["type"]
            if terminal:
                raise RelayError("invalid_provider_stream", "provider stream continued after completion", retryable=True)
            if event_type in {"error", "response.failed", "response.incomplete", "response.cancelled"}:
                # A syntactically complete failure is still safe to retry: this
                # method runs only while the entire provider stream is private
                # to the relay.  Never pass a failed/incomplete prefix through
                # as if it were a successful terminal response.
                raise RelayError(
                    "provider_response_failed",
                    "provider stream reached a failed or incomplete terminal event",
                    retryable=True,
                )
            if event_type == "response.completed":
                terminal = True
                response = event.get("response")
                if not isinstance(response, dict) or response.get("status") != "completed":
                    raise RelayError(
                        "provider_response_failed",
                        "provider completed event lacks a completed response",
                        retryable=True,
                    )
                event["response"] = self.restore_response(response)
            item = event.get("item")
            if isinstance(item, dict) and item.get("type") == "function_call":
                item_id = str(item.get("id") or event.get("item_id") or "")
                metadata = self.by_alias.get(str(item.get("name")))
                if metadata is not None and metadata["kind"] != "function" and item.get("arguments") == "":
                    restored = copy.deepcopy(item)
                    restored.pop("arguments", None)
                    restored["type"] = (
                        "tool_search_call" if metadata["kind"] == "tool_search" else "custom_tool_call"
                    )
                    restored["name"] = metadata["name"]
                    restored["input"] = ""
                    if metadata["namespace"] is not None:
                        restored["namespace"] = metadata["namespace"]
                    if metadata["kind"] == "tool_search":
                        restored.pop("name", None)
                else:
                    restored = self.restore_call(item)
                event["item"] = restored
                if item_id and metadata and metadata["kind"] != "function":
                    custom_items[item_id] = {
                        "metadata": metadata,
                        "call_id": item.get("call_id"),
                        "output_index": event.get("output_index"),
                    }
            item_id = str(event.get("item_id") or "")
            if event_type == "response.function_call_arguments.delta" and item_id in custom_items:
                delta = event.get("delta")
                if not isinstance(delta, str):
                    raise RelayError("invalid_provider_stream", "provider argument delta is malformed")
                argument_buffers[item_id] = argument_buffers.get(item_id, "") + delta
                continue
            if event_type == "response.function_call_arguments.done" and item_id in custom_items:
                arguments = event.get("arguments")
                if not isinstance(arguments, str):
                    arguments = argument_buffers.get(item_id, "")
                item_state = custom_items[item_id]
                metadata = item_state["metadata"]
                original_name = "tool_search" if metadata["kind"] == "tool_search" else str(metadata["name"])
                field, _parameters = custom_parameters(original_name)
                try:
                    decoded = json.loads(arguments)
                except ValueError as exc:
                    raise RelayError("invalid_provider_stream", "provider custom-tool arguments are invalid") from exc
                if not isinstance(decoded, dict) or set(decoded) != {field} or not isinstance(decoded[field], str):
                    raise RelayError("invalid_provider_stream", "provider custom-tool arguments have the wrong shape")
                done_type = (
                    "response.tool_search_call_input.done"
                    if metadata["kind"] == "tool_search"
                    else "response.custom_tool_call_input.done"
                )
                event = {
                    "type": done_type,
                    "item_id": item_id,
                    "input": decoded[field],
                }
                if isinstance(item_state.get("call_id"), str):
                    event["call_id"] = item_state["call_id"]
                if isinstance(item_state.get("output_index"), int):
                    event["output_index"] = item_state["output_index"]
                if decoded[field]:
                    delta = copy.deepcopy(event)
                    delta["type"] = done_type.removesuffix(".done") + ".delta"
                    delta["delta"] = delta.pop("input")
                    frames.append(
                        f"event: {delta['type']}\ndata: {canonical(delta).decode()}\n\n".encode()
                    )
                event_type = event["type"]
            wire = canonical(event).decode()
            header = f"event: {event_type}\n" if event_type else ""
            frames.append(("\n".join(prefix) + ("\n" if prefix else "") + header + f"data: {wire}\n\n").encode())
        if not terminal:
            raise RelayError("incomplete_provider_stream", "provider stream ended before a terminal event", retryable=True)
        return b"".join(frames)


class Upstream:
    def __init__(self, url: str):
        parsed = urlsplit(url)
        if parsed.scheme not in {"http", "https"} or not parsed.hostname:
            raise RelayError("invalid_upstream", "upstream URL must use HTTP(S) with a host", status=78)
        if parsed.username is not None or parsed.password is not None or parsed.query or parsed.fragment:
            raise RelayError("invalid_upstream", "upstream URL contains forbidden authority or suffix fields", status=78)
        if parsed.path not in {"/v1/responses", "/api/v1/responses"}:
            raise RelayError("invalid_upstream", "upstream path must be /v1/responses or /api/v1/responses", status=78)
        self.scheme = parsed.scheme
        self.host = parsed.hostname
        self.port = parsed.port or (443 if parsed.scheme == "https" else 80)
        self.path = parsed.path

    def request(
        self, body: bytes, key: str, *, timeout: float, deadline: float, maximum: int,
    ) -> tuple[int, str, bytes]:
        connection: http.client.HTTPConnection
        if self.scheme == "https":
            connection = http.client.HTTPSConnection(self.host, self.port, timeout=timeout, context=ssl.create_default_context())
        else:
            connection = http.client.HTTPConnection(self.host, self.port, timeout=timeout)
        try:
            connection.request("POST", self.path, body=body, headers={
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "Accept": "text/event-stream, application/json",
                "User-Agent": "sandcodex-openrouter-router/1",
                "Connection": "close",
            })
            response = connection.getresponse()
            content_type = response.getheader("Content-Type", "application/json").split(";", 1)[0].strip().lower()
            chunks: list[bytes] = []
            total = 0
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise RelayError(
                        "request_deadline", "aggregate relay request deadline expired",
                        status=504, retryable=True,
                    )
                if connection.sock is not None:
                    connection.sock.settimeout(min(timeout, max(0.1, remaining)))
                chunk = response.read(min(1 << 20, maximum - total + 1))
                if not chunk:
                    break
                chunks.append(chunk); total += len(chunk)
                if total > maximum:
                    raise RelayError("provider_response_too_large", "provider response exceeded the relay byte limit", retryable=True)
            return response.status, content_type, b"".join(chunks)
        except (OSError, socket.timeout, http.client.HTTPException) as exc:
            raise RelayError("upstream_transport", "upstream transport failed before downstream commit", retryable=True) from exc
        finally:
            connection.close()


class Runtime:
    def __init__(self, args: argparse.Namespace):
        self.keys = parse_key_bank(Path(args.key_bank))
        preferred_keys = [row for row in self.keys if row[0] == args.preferred_key_id]
        if len(preferred_keys) != 1:
            raise RelayError(
                "invalid_key_bank",
                "preflight-qualified key is absent from the protected key bank",
                status=78,
            )
        self.keys = [preferred_keys[0], *(row for row in self.keys if row[0] != args.preferred_key_id)]
        self.preferred_key_id = args.preferred_key_id
        self.models = parse_model_bank(Path(args.model_bank), args.preferred_model)
        self.upstream = Upstream(args.upstream)
        self.client_token = safe_read(Path(args.client_token_file), maximum=16_384, mode=0o600).decode()
        if not self.client_token or "\n" in self.client_token or "\r" in self.client_token:
            raise RelayError("invalid_client_token", "router client token is invalid", status=78)
        self.state_path = Path(args.state)
        self.artifact_sha256 = args.artifact_sha256
        self.key_bank_sha256 = hashlib.sha256(safe_read(Path(args.key_bank), maximum=1 << 20)).hexdigest()
        self.model_bank_sha256 = hashlib.sha256(safe_read(Path(args.model_bank), maximum=16 << 20)).hexdigest()
        self.max_attempts = min(args.max_attempts, len(self.keys) * len(self.models))
        self.timeout = args.timeout
        self.max_request_bytes = args.max_request_bytes
        self.max_response_bytes = args.max_response_bytes
        self.request_ceiling = args.request_ceiling
        self.lock = threading.Lock()
        self.sequence = 0
        self.cooldowns: dict[tuple[str, str], float] = {}
        self.requests = self.attempts = self.failovers = self.successes = self.failures = 0
        self.last: dict[str, object] | None = None
        self._write_state()

    def authorized(self, header: str | None) -> bool:
        return isinstance(header, str) and header.startswith("Bearer ") and hmac.compare_digest(header[7:], self.client_token)

    def routes(self) -> list[tuple[str, str, str]]:
        with self.lock:
            offset = self.sequence % len(self.keys)
            self.sequence += 1
            keys = self.keys[offset:] + self.keys[:offset]
            now = time.time()
            ordered = [(model, key_id, key) for model in self.models for key_id, _label, key in keys]
            healthy = [row for row in ordered if self.cooldowns.get((row[1], row[0]), 0) <= now]
            return (healthy or ordered)[: self.max_attempts]

    def _write_state(self) -> None:
        atomic_json(self.state_path, {
            "schema": STATE_SCHEMA,
            "updated_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "artifact_sha256": self.artifact_sha256,
            "key_bank_sha256": self.key_bank_sha256,
            "model_bank_sha256": self.model_bank_sha256,
            "candidate_model_count": len(self.models),
            "account_count": len(self.keys),
            "requests": self.requests,
            "attempts": self.attempts,
            "failovers": self.failovers,
            "successes": self.successes,
            "failures": self.failures,
            "last": self.last,
            "credential_values_disclosed": False,
            "raw_provider_content_disclosed": False,
            "request_content_retained": False,
            "response_content_retained": False,
            "commit_policy": "buffer-complete-response-before-downstream-bytes",
        })

    def _record(self, *, success: bool, attempts: int, model: str | None, key_id: str | None, category: str | None) -> None:
        with self.lock:
            self.requests += 1; self.attempts += attempts
            self.failovers += max(0, attempts - 1)
            if success: self.successes += 1
            else: self.failures += 1
            self.last = {"success": success, "attempts": attempts, "model": model, "key_id": key_id, "category": category}
            self._write_state()

    def relay(self, request: dict[str, Any]) -> tuple[int, str, bytes, dict[str, str]]:
        bridge = ToolBridge(request)
        deadline = time.monotonic() + self.request_ceiling
        last_error: RelayError | None = None
        last_status = 502
        attempts = 0
        last_model = last_key = None
        for model, key_id, key in self.routes():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                last_error = RelayError(
                    "request_deadline", "aggregate relay request deadline expired",
                    status=504, retryable=True,
                )
                last_status = 504
                break
            attempts += 1; last_model, last_key = model, key_id
            try:
                provider_request = bridge.flatten_request(request, model)
                body = canonical(provider_request)
                if len(body) > self.max_request_bytes:
                    raise RelayError("translated_request_too_large", "translated request exceeds relay byte limit", status=413)
                status_code, content_type, raw = self.upstream.request(
                    body, key, timeout=min(self.timeout, max(0.1, remaining)),
                    deadline=deadline, maximum=self.max_response_bytes,
                )
                last_status = status_code
                if status_code < 200 or status_code >= 300:
                    retryable = status_code in RETRYABLE_HTTP
                    error = RelayError("upstream_http", "upstream route returned an error", status=status_code, retryable=retryable)
                    if retryable:
                        seconds = 3600 if status_code == 402 else 120 if status_code == 429 else 30
                        with self.lock: self.cooldowns[(key_id, model)] = time.time() + seconds
                        last_error = error
                        continue
                    self._record(success=False, attempts=attempts, model=model, key_id=key_id, category=error.code)
                    return status_code, content_type or "application/json", raw, {"model": model, "key_id": key_id, "attempts": str(attempts)}
                if content_type == "text/event-stream":
                    returned = bridge.restore_sse(raw)
                else:
                    try:
                        payload = json.loads(raw)
                    except (UnicodeError, ValueError) as exc:
                        raise RelayError("invalid_provider_response", "provider response is not JSON", retryable=True) from exc
                    if not isinstance(payload, dict):
                        raise RelayError("invalid_provider_response", "provider response is not an object", retryable=True)
                    if payload.get("status") != "completed" or payload.get("error") is not None:
                        raise RelayError(
                            "provider_response_failed",
                            "provider response reached a failed or incomplete terminal state",
                            retryable=True,
                        )
                    returned = canonical(bridge.restore_response(payload))
                    content_type = "application/json"
                with self.lock: self.cooldowns.pop((key_id, model), None)
                self._record(success=True, attempts=attempts, model=model, key_id=key_id, category=None)
                return 200, content_type, returned, {"model": model, "key_id": key_id, "attempts": str(attempts)}
            except RelayError as exc:
                last_error = exc; last_status = exc.status
                if not exc.retryable:
                    self._record(success=False, attempts=attempts, model=model, key_id=key_id, category=exc.code)
                    raise
                with self.lock: self.cooldowns[(key_id, model)] = time.time() + 30
                continue
        category = last_error.code if last_error is not None else "routes_exhausted"
        self._record(success=False, attempts=attempts, model=last_model, key_id=last_key, category=category)
        raise RelayError("routes_exhausted", "all eligible OpenRouter routes failed before downstream commit", status=last_status)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = False

    def __init__(self, address: tuple[str, int], runtime: Runtime):
        if not ipaddress.ip_address(address[0]).is_loopback:
            raise RelayError("invalid_bind", "router must bind to loopback", status=78)
        self.runtime = runtime
        self.slots = threading.BoundedSemaphore(4)
        super().__init__(address, Handler)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "sandcodex-openrouter-router/1"
    sys_version = ""

    @property
    def relay_server(self) -> Server:
        return self.server  # type: ignore[return-value]

    def log_message(self, _format: str, *_args: object) -> None:
        return

    def error(self, error: RelayError) -> None:
        body = canonical({"error": {"code": error.code, "message": str(error)}})
        self.send_response(error.status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def do_GET(self) -> None:  # noqa: N802
        if self.path != "/health":
            self.error(RelayError("not_found", "not found", status=404)); return
        if not self.relay_server.runtime.authorized(self.headers.get("Authorization")):
            self.error(RelayError("unauthorized", "router authentication failed", status=401)); return
        body = canonical({"schema": SCHEMA, "status": "ok"})
        self.send_response(200); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body))); self.send_header("Connection", "close")
        self.end_headers(); self.wfile.write(body); self.close_connection = True

    def do_POST(self) -> None:  # noqa: N802
        if not self.relay_server.slots.acquire(blocking=False):
            self.error(RelayError("router_busy", "router concurrency limit reached", status=503)); return
        try:
            if self.path not in {"/v1/responses", "/responses"}:
                raise RelayError("not_found", "only /v1/responses is available", status=404)
            if not ipaddress.ip_address(self.client_address[0]).is_loopback:
                raise RelayError("forbidden", "router accepts loopback peers only", status=403)
            if not self.relay_server.runtime.authorized(self.headers.get("Authorization")):
                raise RelayError("unauthorized", "router authentication failed", status=401)
            if self.headers.get("Transfer-Encoding"):
                raise RelayError("length_required", "chunked request bodies are unsupported", status=411)
            length_text = self.headers.get("Content-Length")
            if length_text is None or not length_text.isdigit():
                raise RelayError("length_required", "decimal Content-Length is required", status=411)
            length = int(length_text)
            if length > self.relay_server.runtime.max_request_bytes:
                raise RelayError("request_too_large", "request exceeds relay byte limit", status=413)
            raw = self.rfile.read(length)
            if len(raw) != length:
                raise RelayError("incomplete_request", "request ended before Content-Length", status=400)
            try:
                request = json.loads(raw)
            except (UnicodeError, ValueError) as exc:
                raise RelayError("invalid_request", "request body is not JSON", status=400) from exc
            if not isinstance(request, dict):
                raise RelayError("invalid_request", "request body is not an object", status=400)
            status_code, content_type, body, route = self.relay_server.runtime.relay(request)
            self.send_response(status_code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Sandcodex-OpenRouter-Model", route["model"])
            self.send_header("X-Sandcodex-OpenRouter-Key-Id", route["key_id"])
            self.send_header("X-Sandcodex-OpenRouter-Attempts", route["attempts"])
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(body)
            self.close_connection = True
        except RelayError as exc:
            self.error(exc)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            self.close_connection = True
        finally:
            self.relay_server.slots.release()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--key-bank", required=True)
    parser.add_argument("--model-bank", required=True)
    parser.add_argument("--preferred-model", required=True)
    parser.add_argument("--preferred-key-id", required=True)
    parser.add_argument("--client-token-file", required=True)
    parser.add_argument("--state", required=True)
    parser.add_argument("--ready", required=True)
    parser.add_argument("--artifact-sha256", required=True)
    parser.add_argument("--upstream", default="https://openrouter.ai/api/v1/responses")
    parser.add_argument("--bind", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--max-attempts", type=int, default=12)
    parser.add_argument("--timeout", type=float, default=180.0)
    parser.add_argument("--request-ceiling", type=float, default=240.0)
    parser.add_argument("--max-request-bytes", type=int, default=16 << 20)
    parser.add_argument("--max-response-bytes", type=int, default=64 << 20)
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.self_test:
        target = Upstream(args.upstream)
        print(json.dumps({"schema": SCHEMA, "result": "self-test", "upstream_path": target.path}))
        return 0
    if not re.fullmatch(r"[0-9a-f]{64}", args.artifact_sha256):
        raise SystemExit("router artifact digest is invalid")
    if not re.fullmatch(r"[0-9a-f]{12}", args.preferred_key_id):
        raise SystemExit("router preferred key identity is invalid")
    if (not 1 <= args.max_attempts <= 64 or not 1 <= args.timeout <= 600
            or not 1 <= args.request_ceiling <= 900):
        raise SystemExit("router attempt or timeout policy is invalid")
    runtime = Runtime(args)
    server = Server((args.bind, args.port), runtime)
    stopping = threading.Event()

    def stop(_signum: int, _frame: object) -> None:
        if stopping.is_set():
            return
        stopping.set()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    host, port = server.server_address[:2]
    atomic_json(Path(args.ready), {
        "schema": READY_SCHEMA,
        "pid": os.getpid(),
        "url": f"http://{host}:{port}/v1/responses",
        "host": host,
        "port": port,
        "artifact_sha256": runtime.artifact_sha256,
        "key_bank_sha256": runtime.key_bank_sha256,
        "model_bank_sha256": runtime.model_bank_sha256,
        "candidate_model_count": len(runtime.models),
        "account_count": len(runtime.keys),
        "preferred_key_id": runtime.preferred_key_id,
        "upstream_path": runtime.upstream.path,
        "request_ceiling_seconds": runtime.request_ceiling,
        "credential_values_disclosed": False,
        "raw_provider_content_disclosed": False,
        "commit_policy": "buffer-complete-response-before-downstream-bytes",
    })
    try:
        server.serve_forever(poll_interval=0.2)
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_OPENROUTER_RESPONSES_ROUTER_PY
}

sc_remote_bench_render() {
  local bench=$1 saved=${2:-}
  if (( SC_REMOTE_MODELS_JSON )); then
    printf '%s\n' "$bench"
    return
  fi
  printf 'OpenRouter coding bench\n'
  printf '  coverage     %s candidates · %s scored\n' \
    "$(jq -r '.candidate_count' <<<"$bench")" "$(jq -r '.scored_count' <<<"$bench")"
  printf '  source       %s\n' "$(jq -r '.source_url' <<<"$bench")"
  printf '  benchmark    %s · %s\n' "$(jq -r '.bench_version' <<<"$bench")" "$(jq -r '.bench_version_sha256[0:12]' <<<"$bench")"
  printf '  timeout      %ss/request\n' "$(jq -r '.request_timeout_seconds // "unknown"' <<<"$bench")"
  printf '  evidence     %s cached · %s live\n' \
    "$(jq -r '[.models[] | select(.cached == true)] | length' <<<"$bench")" \
    "$(jq -r '[.models[] | select(.cached != true)] | length' <<<"$bench")"
  [[ -z "$saved" ]] || printf '  saved: %s\n' "$saved"
  printf '\ntasks\n'
  jq -r '.tasks[] | "  \(.name) · \(.points) point(s)"' <<<"$bench"
  printf '\nranked models\n'
  jq -r '.models[] |
    "  \(.coding_rank). \(.model)\n" +
    "     score \(.score.points)/\(.score.possible_points) · tasks \(.score.passed_tasks)/\(.score.task_count) · metadata \((.metadata_strength_score // 0)|floor) · " +
    (if .cached then "cached evidence" else "live evidence" end)' <<<"$bench"
  printf '\nnext\n'
  printf '  refresh catalog  sandcodex remote models --agent --save\n'
  printf '  fresh benchmark  sandcodex remote bench --force --save\n'
}

sc_remote_bench_dispatch() {
  local bank staged="" quota="" key_rows="" key_rows_file bank_file result root saved_path="" token_file="" credential use_keybank=0
  bank="$(sc_remote_models_bank)"
  jq -e '[.models[] | select(.free != true)] | length == 0' <<<"$bank" >/dev/null ||
    sc_die "refusing to bench non-free OpenRouter model candidates from this command" 64
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  sc_ensure_dir "$SC_GLOBAL/remote/bench" "remote bench cache"
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  bank_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bench-bank.XXXXXX")"
  key_rows_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bench-keys.XXXXXX")"
  printf '%s\n' "$bank" | sc_atomic "$bank_file" 600
  if [[ -n "$SC_REMOTE_KEYBANK_PATH" || ( -z "${OPENROUTER_API_KEY:-}" && -f "$(sc_remote_keybank_default_path)" ) ]]; then
    use_keybank=1
    staged="$(sc_remote_keybank_stage)"
    quota="$(sc_remote_keybank_quota_json "$staged")"
    key_rows="$(sc_remote_keybank_usable_rows "$staged" "$quota" 1)"
    if [[ -z "$key_rows" ]]; then
      sc_remote_keybank_unstage "$staged"
      rm -f -- "$bank_file" "$key_rows_file"
      sc_die "OpenRouter key bank has no usable keys with reported quota for bench" 69
    fi
    printf '%s\n' "$key_rows" | sc_atomic "$key_rows_file" 600
  else
    credential="${OPENROUTER_API_KEY:-}"
    [[ -n "$credential" && ${#credential} -le 16384 ]] ||
      sc_die "OPENROUTER_API_KEY is required for OpenRouter bench (or use --key-bank)" 78
    [[ "$credential" != *$'\n'* && "$credential" != *$'\r'* ]] ||
      sc_die "OPENROUTER_API_KEY contains a line break" 78
    token_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bench-token.XXXXXX")"
    printf '%s' "$credential" | sc_atomic "$token_file" 600
    printf 'env\t%s\tOPENROUTER_API_KEY\t999999\n' "$token_file" | sc_atomic "$key_rows_file" 600
  fi
  root="$SC_GLOBAL/remote/bench"
  local -a bench_args=(--bank-file "$bank_file" --keys-file "$key_rows_file" --cache-root "$root"
    --sleep "$SC_REMOTE_MODELS_SLEEP" --timeout "$SC_REMOTE_BENCH_TIMEOUT" --timestamp "$(sc_now)")
  (( ! SC_REMOTE_BENCH_FORCE )) || bench_args+=(--force)
  result="$(sc_emit_remote_bench | python3 -P - "${bench_args[@]}")" || {
      [[ "$use_keybank" == 0 ]] || sc_remote_keybank_unstage "$staged"
      rm -f -- "$bank_file" "$key_rows_file" "$token_file"
      sc_die "OpenRouter coding bench failed" 69
    }
  jq -e '.schema=="sandcodex.openrouter-coding-bench.v1" and .provider=="openrouter" and (.models|type)=="array"' \
    <<<"$result" >/dev/null || sc_die "OpenRouter coding bench helper returned invalid JSON" 78
  if (( SC_REMOTE_MODELS_SAVE )); then
    saved_path="$SC_GLOBAL/remote/openrouter-coding-bench-latest.json"
    result="$(jq -c --arg saved_path "$saved_path" '. + {saved_path:$saved_path}' <<<"$result")"
    printf '%s\n' "$result" | sc_atomic "$saved_path" 600
    printf '%s\n' "$result" | sc_atomic "$SC_GLOBAL/remote/openrouter-coding-bench-$(date -u +%Y%m%dT%H%M%SZ).json" 600
  fi
  [[ "$use_keybank" == 0 ]] || sc_remote_keybank_unstage "$staged"
  rm -f -- "$bank_file" "$key_rows_file" "$token_file"
  sc_remote_bench_render "$result" "$saved_path"
}

sc_remote_quota_dispatch() {
  local credential token_file raw quota rc=0
  credential="${OPENROUTER_API_KEY:-}"
  [[ -n "$credential" && ${#credential} -le 16384 ]] ||
    sc_die "OPENROUTER_API_KEY is required for OpenRouter quota inspection" 78
  [[ "$credential" != *$'\n'* && "$credential" != *$'\r'* ]] ||
    sc_die "OPENROUTER_API_KEY contains a line break" 78
  token_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-quota-token.XXXXXX")"
  printf '%s' "$credential" | sc_atomic "$token_file" 600
  raw="$(python3 -P - "$token_file" <<'PY'
import sys
import urllib.error
import urllib.request
from pathlib import Path

token = Path(sys.argv[1]).read_text(encoding="utf-8")
request = urllib.request.Request(
    "https://openrouter.ai/api/v1/key",
    headers={"Authorization": f"Bearer {token}"},
)
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        sys.stdout.write(response.read().decode("utf-8", "replace"))
except urllib.error.HTTPError as error:
    sys.stderr.write(f"HTTP {error.code}\n")
    raise SystemExit(10)
except Exception as error:
    sys.stderr.write(f"{type(error).__name__}: {error}\n")
    raise SystemExit(11)
PY
  )" || rc=$?
  rm -f -- "$token_file"
  (( rc == 0 )) || sc_die "OpenRouter quota inspection failed" 69
  quota="$(jq -c --arg schema "sandcodex.openrouter-quota.v1" \
    --arg checked_at "$(sc_now)" --arg source "https://openrouter.ai/api/v1/key" '
      if (.data | type) != "object" then error("OpenRouter key response lacks data object") else . end
      | .data as $d
      | {
          schema:$schema,
          result:"quota",
          provider:"openrouter",
          source_url:$source,
          checked_at:$checked_at,
          credential_value_disclosed:false,
          label_disclosed:false,
          is_free_tier:($d.is_free_tier // null),
          credit_limit:{
            limit:($d.limit // null),
            limit_reset:($d.limit_reset // null),
            limit_remaining:($d.limit_remaining // null)
          },
          usage:{
            all_time:($d.usage // null),
            daily:($d.usage_daily // null),
            weekly:($d.usage_weekly // null),
            monthly:($d.usage_monthly // null),
            byok_all_time:($d.byok_usage // null),
            byok_daily:($d.byok_usage_daily // null),
            byok_weekly:($d.byok_usage_weekly // null),
            byok_monthly:($d.byok_usage_monthly // null)
          },
          free_model_daily_requests:($d.free_model_daily_requests // null)
        }' <<<"$raw")" || sc_die "OpenRouter quota response could not be normalized" 78
  if (( SC_REMOTE_CATALOG_JSON )); then
    printf '%s\n' "$quota"
    return
  fi
  printf 'openrouter quota\n'
  printf '  free tier: %s\n' "$(jq -r '.is_free_tier // "unknown"' <<<"$quota")"
  jq -r '
    .free_model_daily_requests as $f |
    if ($f|type) == "object" then
      "  free-model daily: used=\($f.used // "unknown") limit=\($f.limit // "unknown") remaining=\($f.remaining // "unknown")"
    else
      "  free-model daily: unavailable"
    end,
    "  credit limit remaining: \(.credit_limit.limit_remaining // "unlimited-or-unreported")",
    "  usage: daily=\(.usage.daily // "unknown") weekly=\(.usage.weekly // "unknown") monthly=\(.usage.monthly // "unknown")"
  ' <<<"$quota"
  printf '  credential value disclosed: false\n'
}

