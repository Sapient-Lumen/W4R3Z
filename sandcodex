+static void sandcodex_cancel_dispatch(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length,
+		const char *operation, enum sandcodex_dispatch_kind expected_kind) {
+	json_object *ticket_object = NULL;
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == 2 &&
+		sandcodex_request_operation(request, operation) &&
+		json_object_object_get_ex(request, "ticket", &ticket_object) &&
+		json_object_is_type(ticket_object, json_type_string);
+	const char *ticket = valid_shape ? json_object_get_string(ticket_object) : NULL;
+	bool canonical = valid_shape && sandcodex_is_lower_hex_token(ticket,
+		SANDCODEX_DISPATCH_TICKET_LENGTH) &&
+		sandcodex_cancel_payload_canonical(payload, payload_length, operation, ticket);
+	bool ticket_matches = canonical && client->sandcodex_dispatch_ticket.armed &&
+		client->sandcodex_dispatch_ticket.kind == expected_kind &&
+		sandcodex_constant_time_equal(ticket,
+			client->sandcodex_dispatch_ticket.value,
+			SANDCODEX_DISPATCH_TICKET_LENGTH);
+	/* Any cancellation attempt consumes whatever authority was armed. */
+	sandcodex_clear_dispatch_ticket(client);
+	if (!ticket_matches) {
+		sandcodex_send_hit_test_failure(client, "dispatch-ticket-invalid-or-consumed");
+		return;
+	}
+
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(true));
+	json_object_object_add(reply, "operation", json_object_new_string(operation));
+	json_object_object_add(reply, "cancelled", json_object_new_boolean(true));
+	json_object_object_add(reply, "ticket_consumed", json_object_new_boolean(true));
+	const char *json_string = json_object_to_json_string_ext(reply,
+		JSON_C_TO_STRING_PLAIN);
+	ipc_send_reply(client, IPC_SANDCODEX_HIT_TEST, json_string,
+		(uint32_t)strlen(json_string));
+	json_object_put(reply);
+}
