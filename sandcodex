    def guarded_touchpad_hold(
        self,
        x: int,
        y: int,
        fingers: int,
        duration_milliseconds: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor touchpad-hold authority is unavailable")
        if type(x) is not int or type(y) is not int:
            raise ToolError("compositor touchpad-hold coordinates must be integers")
        if not 0 <= x <= SWAY_HIT_TEST_MAX_COORDINATE or not 0 <= y <= SWAY_HIT_TEST_MAX_COORDINATE:
            raise ToolError("compositor touchpad-hold coordinates exceed the sealed range")
        if type(fingers) is not int or not TOUCHPAD_HOLD_MIN_FINGERS <= fingers <= TOUCHPAD_HOLD_MAX_FINGERS:
            raise ToolError("native touchpad hold requires 1 through 5 fingers")
        if (
            type(duration_milliseconds) is not int
            or not 1 <= duration_milliseconds <= TOUCHPAD_HOLD_MAX_DURATION_MILLISECONDS
        ):
            raise ToolError(
                "native touchpad-hold duration must preserve increasing protocol timestamps"
            )
        if not callable(validator):
            raise ToolError("compositor touchpad-hold target validator is unavailable")

        action = {
            "duration_milliseconds": duration_milliseconds,
            "fingers": fingers,
            "x": x,
            "y": y,
        }
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-touchpad-hold", **action}),
                    "SANDCODEX_HIT_TEST arm-touchpad-hold",
                )
                target, ticket, resource_version = self._normalize_touchpad_hold_arm_reply(
                    arm_reply, x, y, fingers, duration_milliseconds
                )
                ticket_action = {"dispatch_kind": "touchpad-hold", **action}
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-touchpad-hold-ticket-v1\0"
                    + canonical_json(ticket_action) + b"\0" + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": TOUCHPAD_HOLD_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-recipient-touchpad-hold",
                    "dispatch_kind": "touchpad-hold",
                    **action,
                    "protocol_resource_min_version": TOUCHPAD_HOLD_PROTOCOL_MIN_VERSION,
                    "protocol_resource_version": resource_version,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": (
                        "view-surface+focused-hit-surface+pointer-gesture-hold-resource"
                    ),
                    "dispatch_path": COMPOSITOR_TOUCHPAD_HOLD_DISPATCH_PATH,
                    "dispatch_atomicity": GUARDED_TOUCHPAD_HOLD_DISPATCH_ATOMICITY,
                    "route_scope": COMPOSITOR_TOUCHPAD_HOLD_ROUTE_SCOPE,
                    "time_scope": COMPOSITOR_TOUCHPAD_HOLD_TIME_SCOPE,
                    "compositor_binding_policy": "bypass",
                    "wall_clock_pacing": False,
                    "key_fallback_policy": "deny",
                    "click_fallback_policy": "deny",
                    "pointer_motion_fallback_policy": "deny",
                    "scroll_fallback_policy": "deny",
                    "touch_fallback_policy": "deny",
                    "browser_fallback_policy": "deny",
                    "host_desktop_policy": "absent",
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorTouchpadHoldGrant(
                    x=x, y=y, fingers=fingers,
                    duration_milliseconds=duration_milliseconds,
                    protocol_resource_version=resource_version,
                    ticket=ticket, target=target, grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_touchpad_hold_arms += 1
                self.last_compositor_touchpad_hold_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_touchpad_hold_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touchpad hold could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-touchpad-hold",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-touchpad-hold",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_touchpad_hold_reply(cancel_reply)
                    self.compositor_touchpad_hold_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_touchpad_hold_dispatch_failures += 1
                    self._set_failure(cancel_error)
                    raise ToolError(
                        "compositor touchpad-hold validation failed and its private "
                        "ticket could not be cancelled; the compositor seal is quarantined"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        **action,
                        "op": "dispatch-touchpad-hold",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-touchpad-hold",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_touchpad_hold_reply(
                    dispatch_reply, grant
                )
                self.compositor_touchpad_hold_dispatches += 1
                self.last_compositor_touchpad_hold_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_touchpad_hold_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touchpad hold failed closed: {error}"
                ) from error

