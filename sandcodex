+        }
+        if (wheel_present && wheel_step == 0) {
+            wlr_tablet_v2_tablet_tool_notify_wheel(tool,
+                (double)wheel_delta_degrees_256 / 256.0, wheel_clicks);
+        }
+        exact = sandcodex_stylus_hover_state_exact(client, seat,
+            expected_surface, expected_target_client, tool, tool_client,
+            expected_pointer_grab_address, expected_pointer_default_grab_address,
+            expected_pointer_client_address);
+    }
+    for (uint32_t index = 1; exact && index <= steps; ++index) {
+        wlr_tablet_v2_tablet_tool_notify_motion(tool, sx[index], sy[index]);
+        if (rotation_present) {
+            wlr_tablet_v2_tablet_tool_notify_rotation(tool,
+                (double)sandcodex_stylus_rotation_degrees(
+                    rotation_start_degrees, rotation_delta_degrees,
+                    index, steps));
+        }
+        if (slider_present) {
+            wlr_tablet_v2_tablet_tool_notify_slider(tool,
+                (double)sandcodex_stylus_slider_65535(slider_start_65535,
+                    slider_end_65535, index, steps) /
+                (double)SANDCODEX_STYLUS_SLIDER_MAX_65535);
+        }
+        if (distance_present) {
+            wlr_tablet_v2_tablet_tool_notify_distance(tool,
+                (double)sandcodex_stylus_distance_65535(distance_start_65535,
+                    distance_end_65535, index, steps) /
+                (double)SANDCODEX_STYLUS_DISTANCE_MAX_65535);
+        }
+        if (wheel_present && wheel_step == index) {
+            wlr_tablet_v2_tablet_tool_notify_wheel(tool,
+                (double)wheel_delta_degrees_256 / 256.0, wheel_clicks);
+        }
+        exact = sandcodex_stylus_hover_state_exact(client, seat,
+            expected_surface, expected_target_client, tool, tool_client,
+            expected_pointer_grab_address, expected_pointer_default_grab_address,
+            expected_pointer_client_address);
+    }
+    if (exact) {
+        wlr_tablet_v2_tablet_tool_notify_proximity_out(tool);
+        visible = false;
+        exact = sandcodex_stylus_tool_idle() &&
+            sandcodex_stylus_route_quiet(client, seat, expected_surface,
+                expected_pointer_grab_address,
+                expected_pointer_default_grab_address,
+                expected_pointer_client_address);
+    }
+    if (!exact) {
+        if (visible) {
+            sandcodex_stylus_hover_deescalate(tool);
+        }
+        return false;
+    }
+    return true;
+}
