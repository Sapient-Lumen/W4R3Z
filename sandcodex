+        uintptr_t expected_pointer_grab_address,
+        uintptr_t expected_pointer_default_grab_address,
+        uintptr_t expected_pointer_client_address) {
+    if (pointer_client_out) {
+        *pointer_client_out = NULL;
+    }
+    if (target_client_out) {
+        *target_client_out = NULL;
+    }
+    if (!sandcodex_stylus_initialize(seat) || !sandcodex_stylus_tool_idle()) {
+        return false;
+    }
+    struct wlr_surface *target_surface = NULL;
+    double sx = 0, sy = 0;
