    def _normalize_drag_motion_arm_reply(
        self,
        value: Any,
        from_x: int,
        from_y: int,
        x: int,
        y: int,
        button: int,
    ) -> tuple[dict[str, Any], dict[str, Any], str]:
        if not isinstance(value, dict):
            raise RuntimeError("Sway compositor drag-motion arm reply is not an object")
        if value.get("operation") != "arm-drag-motion":
            raise RuntimeError("Sway compositor drag-motion arm operation changed")
        for field, expected in (
            ("from_x", from_x),
            ("from_y", from_y),
            ("button", button),
        ):
            number = value.get(field)
            if type(number) is not int or number != expected:
                raise RuntimeError(f"Sway compositor drag-motion {field} binding changed")

        adapted = dict(value)
        source_value = adapted.pop("source_target", None)
        if not isinstance(source_value, dict):
            fields = ",".join(sorted(str(field) for field in value))
            raise RuntimeError(
                "Sway compositor drag-motion source target is malformed "
                f"(type={type(source_value).__name__}, fields={fields})"
            )
        adapted.pop("from_x", None)
        adapted.pop("from_y", None)
        adapted.pop("button", None)
        adapted["operation"] = "arm-click"
        target, ticket = self._normalize_hit_test_reply(
            adapted,
            x,
            y,
            expected_operation="arm-click",
        )
        if ticket is None:
            raise RuntimeError("Sway compositor drag-motion arm omitted private authority")

        source_reply = {
            "schema": value.get("schema"),
            "patch_version": value.get("patch_version"),
            "success": value.get("success"),
            "operation": "hit-test",
            "x": from_x,
            "y": from_y,
            "dispatch_ticket": None,
            **source_value,
        }
        source_target, source_ticket = self._normalize_hit_test_reply(
            source_reply,
            from_x,
            from_y,
            expected_operation="hit-test",
        )
        if source_ticket is not None or source_target.get("hit") is not True:
            raise RuntimeError(
                "Sway compositor drag-motion source target is not exact input authority"
            )
        return source_target, target, ticket

    @staticmethod
    def _normalize_cancel_drag_motion_reply(value: Any) -> None:
        expected_fields = {
            "schema", "patch_version", "success", "operation", "cancelled",
            "ticket_consumed",
        }
        if not isinstance(value, dict) or set(value) != expected_fields:
            raise RuntimeError("Sway compositor drag-motion cancellation reply is malformed")
        required = {
            "schema": SWAY_HIT_TEST_SCHEMA,
            "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
            "success": True,
            "operation": "cancel-drag-motion",
            "cancelled": True,
            "ticket_consumed": True,
        }
        for field, expected in required.items():
            if value.get(field) != expected or type(value.get(field)) is not type(expected):
                raise RuntimeError(
                    f"Sway compositor drag-motion cancellation {field} is invalid"
                )

