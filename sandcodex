def _runtime(args: argparse.Namespace) -> int:
    _harden_process()
    if not APP_ID_RE.fullmatch(args.application_id):
        raise RuntimeError("invalid application identity")
    if not LAUNCH_ID_RE.fullmatch(args.launch_id):
        raise RuntimeError("invalid launch identity")

    features = _portal_features(args.portal_access)
    file_chooser_enabled = "file-chooser" in features
    open_uri_enabled = "open-uri" in features
    open_file_enabled = "open-file" in features
    open_directory_enabled = "open-directory" in features
    open_uri_interface_enabled = open_uri_enabled or open_file_enabled or open_directory_enabled
    policy = PortalPolicy.create(args.project, args.home, args.output, args.project_access)
    open_uri_policy = _sealed_open_uri_policy(
        args.portal_access,
        args.open_uri_policy,
        args.open_uri_policy_sha256,
    )
    if open_uri_enabled != (open_uri_policy is not None):
        raise RuntimeError("OpenURI authority state is inconsistent")
    open_file_policy = _sealed_open_file_policy(
        args.portal_access,
        args.open_file_policy,
        args.open_file_policy_sha256,
    )
    if open_file_enabled != (open_file_policy is not None):
        raise RuntimeError("OpenFile authority state is inconsistent")
    open_directory_policy = _sealed_open_directory_policy(
        args.portal_access,
        args.open_directory_policy,
        args.open_directory_policy_sha256,
    )
    if open_directory_enabled != (open_directory_policy is not None):
        raise RuntimeError("OpenDirectory authority state is inconsistent")

    import gi  # Imported only after --self-test so deterministic policy tests need no GI runtime.

    gi.require_version("Gio", "2.0")
    gi.require_version("GLib", "2.0")
    from gi.repository import Gio, GLib

    Gtk: Any = None
    if file_chooser_enabled:
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk as GtkModule

        Gtk = GtkModule
        initialized, _remaining = Gtk.init_check([])
        if not initialized:
            raise RuntimeError("private GTK portal could not connect to the launch Wayland display")
        settings = Gtk.Settings.get_default()
        if settings is not None:
            with contextlib_suppress(Exception):
                settings.set_property("gtk-enable-animations", False)

    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    if connection is None:
        raise RuntimeError("private session bus is unavailable")
    connection.set_exit_on_close(True)
    main_loop = GLib.MainLoop()

    request_node = Gio.DBusNodeInfo.new_for_xml(REQUEST_XML)
    request_interface = request_node.interfaces[0]
    portal_interface = None
    if file_chooser_enabled:
        portal_interface = Gio.DBusNodeInfo.new_for_xml(PORTAL_XML).interfaces[0]
    open_uri_interface = None
    if open_uri_interface_enabled:
        open_uri_interface = Gio.DBusNodeInfo.new_for_xml(OPEN_URI_XML).interfaces[0]

    active: dict[str, Any] = {}
    active_external_handlers: dict[int, subprocess.Popen[bytes]] = {}
    registration_ids: list[int] = []

    class PortalRequest:
        def __init__(self, spec: RequestSpec) -> None:
            self.spec = spec
            self.registration_id = 0
            self.dialog: Any = None
            self.choice_widgets: dict[str, Any] = {}
            self.filter_objects: list[tuple[FilterSpec, Any]] = []
            self.finished = False

        def register(self) -> None:
            self.registration_id = connection.register_object(
                self.spec.handle,
                request_interface,
                self._method_call,
                None,
                None,
            )
            if not self.registration_id:
                raise PortalError("could not register the private portal request")

        def _method_call(
            self,
            _connection: Any,
            sender: str,
            _object_path: str,
            _interface_name: str,
            method_name: str,
            _parameters: Any,
            invocation: Any,
        ) -> None:
            if sender != self.spec.sender:
                invocation.return_dbus_error(
                    "org.freedesktop.portal.Error.NotAllowed",
                    "only the request owner may close this launch-local dialog",
                )
                return
            if method_name != "Close":
                invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", "unknown request method")
                return
            invocation.return_value(None)
            self.close_without_response()

        def show(self) -> bool:
            if self.finished:
                return False
            try:
                return self._show()
            except Exception:
                # GTK construction/filter errors are boundary failures for this
                # request, not reasons to retain an orphaned registered object.
                self.finish(2, {})
                return False

        def _show(self) -> bool:
            if self.spec.method == "OpenFile":
                action = Gtk.FileChooserAction.SELECT_FOLDER if self.spec.directory else Gtk.FileChooserAction.OPEN
            elif self.spec.method == "SaveFile":
                action = Gtk.FileChooserAction.SAVE
            else:
                action = Gtk.FileChooserAction.SELECT_FOLDER
            dialog = Gtk.FileChooserDialog(title=self.spec.title, parent=None, action=action)
            # Track the dialog immediately: any later GTK setup failure must
            # destroy it and unregister the request rather than leak a hidden
            # toplevel in the private compositor.
            self.dialog = dialog
            dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
            dialog.add_button(self.spec.accept_label, Gtk.ResponseType.ACCEPT)
            dialog.set_default_response(Gtk.ResponseType.ACCEPT)
            dialog.set_modal(self.spec.modal)
            dialog.set_local_only(True)
            dialog.set_select_multiple(self.spec.multiple)
            if self.spec.method == "SaveFile":
                dialog.set_do_overwrite_confirmation(True)
            shortcut_roots = (
                policy.save_roots
                if self.spec.method in {"SaveFile", "SaveFiles"}
                else policy.open_roots
            )
            for root in shortcut_roots:
                with contextlib_suppress(Exception):
                    dialog.add_shortcut_folder(os.fspath(root))
            if self.spec.initial_folder is not None:
                with contextlib_suppress(Exception):
                    dialog.set_current_folder(os.fspath(self.spec.initial_folder))
            elif self.spec.method in {"SaveFile", "SaveFiles"}:
                dialog.set_current_folder(os.fspath(policy.output))
            else:
                dialog.set_current_folder(os.fspath(policy.project))
            if self.spec.current_file is not None:
                with contextlib_suppress(Exception):
                    dialog.set_filename(os.fspath(self.spec.current_file))
            elif self.spec.current_name is not None:
                dialog.set_current_name(self.spec.current_name)

            selected_filter = None
            filter_specs = list(self.spec.filters)
            # FileChooser v4 explicitly permits current_filter without a filters
            # list. In that case it is an unconditional chooser filter and must
            # still be represented in the response if selected.
            if self.spec.current_filter is not None and self.spec.current_filter not in filter_specs:
                filter_specs.append(self.spec.current_filter)
            for filter_spec in filter_specs:
                file_filter = Gtk.FileFilter()
                file_filter.set_name(filter_spec.name)
                for kind, text in filter_spec.rules:
                    if kind == 0:
                        file_filter.add_pattern(text)
                    else:
                        file_filter.add_mime_type(text)
                dialog.add_filter(file_filter)
                self.filter_objects.append((filter_spec, file_filter))
                if self.spec.current_filter == filter_spec:
                    selected_filter = file_filter
            if selected_filter is not None:
                dialog.set_filter(selected_filter)

            if self.spec.choices:
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                box.set_border_width(6)
                for choice in self.spec.choices:
                    if not choice.options:
                        widget = Gtk.CheckButton.new_with_label(choice.label)
                        widget.set_active(choice.initial == "true")
                        box.pack_start(widget, False, False, 0)
                    else:
                        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                        label = Gtk.Label(label=choice.label)
                        label.set_xalign(0.0)
                        widget = Gtk.ComboBoxText()
                        for option_id, option_label in choice.options:
                            widget.append(option_id, option_label)
                        widget.set_active_id(choice.initial or choice.options[0][0])
                        row.pack_start(label, True, True, 0)
                        row.pack_end(widget, False, False, 0)
                        box.pack_start(row, False, False, 0)
                    self.choice_widgets[choice.identifier] = widget
                box.show_all()
                dialog.set_extra_widget(box)

            dialog.connect("response", self._response)
            dialog.connect("delete-event", self._delete_event)
            dialog.show_all()
            return False

        def _delete_event(self, *_unused: Any) -> bool:
            self.finish(1, {})
            return True

        def _choice_results(self) -> list[tuple[str, str]]:
            result: list[tuple[str, str]] = []
            for choice in self.spec.choices:
                widget = self.choice_widgets[choice.identifier]
                if not choice.options:
                    value = "true" if widget.get_active() else "false"
                else:
                    value = widget.get_active_id() or choice.options[0][0]
                result.append((choice.identifier, value))
            return result

        def _current_filter_result(self) -> tuple[str, list[tuple[int, str]]] | None:
            if self.dialog is None:
                return None
            selected = self.dialog.get_filter()
            for spec, file_filter in self.filter_objects:
                if selected == file_filter:
                    return spec.name, list(spec.rules)
            return None

        def _response(self, _dialog: Any, response: int) -> None:
            if response != Gtk.ResponseType.ACCEPT:
                self.finish(1, {})
                return
            try:
                if self.spec.method == "OpenFile":
                    raw_paths = self.dialog.get_filenames()
                    if not raw_paths or len(raw_paths) > MAX_SELECTED_PATHS:
                        raise PortalError("file chooser returned an invalid selection count")
                    paths = [policy.open_path(path, directory=self.spec.directory) for path in raw_paths]
                elif self.spec.method == "SaveFile":
                    raw_path = self.dialog.get_filename()
                    if not raw_path:
                        raise PortalError("file chooser returned no save path")
                    paths = [policy.save_path(raw_path)]
                else:
                    raw_folder = self.dialog.get_filename()
                    if not raw_folder:
                        raise PortalError("file chooser returned no save folder")
                    folder = policy.save_folder(raw_folder)
                    paths = [policy.save_path(os.fspath(folder / filename)) for filename in self.spec.files]
                results: dict[str, tuple[str, Any]] = {
                    "uris": ("as", [Gio.File.new_for_path(os.fspath(path)).get_uri() for path in paths]),
                }
                if self.spec.choices:
                    results["choices"] = ("a(ss)", self._choice_results())
                selected_filter = self._current_filter_result()
                if selected_filter is not None:
                    results["current_filter"] = ("(sa(us))", selected_filter)
                self.finish(0, results)
            except Exception:
                # The application already has access to all capsule-visible paths.
                # Do not echo path content or parser details back through logs/results.
                self.finish(2, {})

        def finish(self, response: int, results: dict[str, tuple[str, Any]]) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                if self.dialog is not None:
                    self.dialog.destroy()
                    self.dialog = None
                variants = {
                    key: GLib.Variant(signature, value)
                    for key, (signature, value) in results.items()
                }
                connection.emit_signal(
                    self.spec.sender,
                    self.spec.handle,
                    REQUEST_INTERFACE,
                    "Response",
                    GLib.Variant("(ua{sv})", (response, variants)),
                )
            finally:
                # The private-bus peer may disappear between accepting the GTK
                # response and directed signal delivery. Variant construction,
                # dialog destruction, and signal emission are all inside the
                # same unconditional unregister boundary.
                self.dialog = None
                self.unregister()

        def close_without_response(self) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                if self.dialog is not None:
                    self.dialog.destroy()
            finally:
                self.dialog = None
                self.unregister()

        def unregister(self) -> None:
            active.pop(self.spec.handle, None)
            if self.registration_id:
                connection.unregister_object(self.registration_id)
                self.registration_id = 0



    def reap_external_handlers() -> bool:
        for pid, process in list(active_external_handlers.items()):
            if process.poll() is not None:
                active_external_handlers.pop(pid, None)
        return True

    class OpenUriRequest:
        def __init__(self, spec: OpenUriRequestSpec) -> None:
            self.spec = spec
            self.registration_id = 0
            self.finished = False

        def register(self) -> None:
            self.registration_id = connection.register_object(
                self.spec.handle,
                request_interface,
                self._method_call,
                None,
                None,
            )
            if not self.registration_id:
                raise PortalError("could not register the private OpenURI request")

        def _method_call(
            self,
            _connection: Any,
            sender: str,
            _object_path: str,
            _interface_name: str,
            method_name: str,
            _parameters: Any,
            invocation: Any,
        ) -> None:
            if sender != self.spec.sender:
                invocation.return_dbus_error(
                    "org.freedesktop.portal.Error.NotAllowed",
                    "only the request owner may close this launch-local OpenURI request",
                )
                return
            if method_name != "Close":
                invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", "unknown request method")
                return
            invocation.return_value(None)
            self.close_without_response()

        def dispatch(self) -> bool:
            if self.finished:
                return False
            try:
                reap_external_handlers()
                if len(active_external_handlers) >= MAX_ACTIVE_EXTERNAL_HANDLERS:
                    raise PortalError("the launch-local external handler limit has been reached")
                if open_uri_policy is None:
                    raise PortalError("OpenURI authority is unavailable")
                executable = open_uri_policy.handler[0]
                try:
                    metadata = os.stat(executable, follow_symlinks=False)
                except OSError as error:
                    raise PortalError("OpenURI handler executable is unavailable") from error
                if not stat.S_ISREG(metadata.st_mode) or not os.access(executable, os.X_OK):
                    raise PortalError("OpenURI handler executable is not an executable regular file")
                environment = os.environ.copy()
                # The exact handler remains on the private session bus so its GTK
                # file chooser can use this launch-local portal. Disable GIO URI
                # portal delegation in the child to prevent ambient recursive URI
                # dispatch from silently widening the one-shot authority.
                environment["GTK_USE_PORTAL"] = "1" if file_chooser_enabled else "0"
                environment["GIO_USE_PORTALS"] = "0"
                environment["SANDCODEX_DESKTOP_OPEN_URI_DISPATCH"] = "exact-launch-handler"
                environment["SANDCODEX_DESKTOP_OPEN_URI_POLICY_SHA256"] = open_uri_policy.digest
                process = subprocess.Popen(
                    open_uri_policy.argv(self.spec.uri),
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    env=environment,
                    start_new_session=True,
                    close_fds=True,
                    shell=False,
                )
                active_external_handlers[process.pid] = process
                self.finish(0)
            except Exception:
                # Do not return handler argv, URI content, or process errors over
                # the bus. The requesting app receives only the standard failure.
                self.finish(2)
            return False

        def finish(self, response: int) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                connection.emit_signal(
                    self.spec.sender,
                    self.spec.handle,
                    REQUEST_INTERFACE,
                    "Response",
                    GLib.Variant("(ua{sv})", (response, {})),
                )
            finally:
                self.unregister()

        def close_without_response(self) -> None:
            if self.finished:
                return
            self.finished = True
            self.unregister()

        def unregister(self) -> None:
            active.pop(self.spec.handle, None)
            if self.registration_id:
                connection.unregister_object(self.registration_id)
                self.registration_id = 0

    class OpenFileRequest:
        def __init__(self, spec: OpenFileRequestSpec) -> None:
            self.spec = spec
            self.registration_id = 0
            self.finished = False
            self.descriptor = spec.descriptor

        def register(self) -> None:
            self.registration_id = connection.register_object(
                self.spec.handle,
                request_interface,
                self._method_call,
                None,
                None,
            )
            if not self.registration_id:
                raise PortalError("could not register the private OpenFile request")

        def _method_call(
            self,
            _connection: Any,
            sender: str,
            _object_path: str,
            _interface_name: str,
            method_name: str,
            _parameters: Any,
            invocation: Any,
        ) -> None:
            if sender != self.spec.sender:
                invocation.return_dbus_error(
                    "org.freedesktop.portal.Error.NotAllowed",
                    "only the request owner may close this launch-local OpenFile request",
                )
                return
            if method_name != "Close":
                invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", "unknown request method")
                return
            invocation.return_value(None)
            self.close_without_response()

        def dispatch(self) -> bool:
            if self.finished:
                return False
            try:
                reap_external_handlers()
                if len(active_external_handlers) >= MAX_ACTIVE_EXTERNAL_HANDLERS:
                    raise PortalError("the launch-local external handler limit has been reached")
                if open_file_policy is None:
                    raise PortalError("OpenFile authority is unavailable")
                if self.descriptor < 0:
                    raise PortalError("OpenFile descriptor custody is unavailable")
                metadata = os.fstat(self.descriptor)
                if not stat.S_ISREG(metadata.st_mode):
                    raise PortalError("OpenFile retained object is no longer a regular file")
                flags = fcntl.fcntl(self.descriptor, fcntl.F_GETFL)
                expected_mode = os.O_RDONLY if self.spec.access == "readonly" else os.O_RDWR
                if (flags & os.O_ACCMODE) != expected_mode:
                    raise PortalError("OpenFile retained descriptor access changed")
                if self.spec.access == "readonly":
                    if self.spec.transfer != "sealed-memfd-snapshot":
                        raise PortalError("OpenFile read-only transfer lost its sealed snapshot authority")
                    seals = fcntl.fcntl(self.descriptor, fcntl.F_GET_SEALS)
                    if (seals & OPEN_FILE_READONLY_SEALS) != OPEN_FILE_READONLY_SEALS:
                        raise PortalError("OpenFile read-only transfer lost its immutable seals")
                elif self.spec.transfer != "retained-original-fd":
                    raise PortalError("OpenFile writable transfer lost its original descriptor authority")
                executable = open_file_policy.handler[0]
                try:
                    executable_metadata = os.stat(executable, follow_symlinks=False)
                except OSError as error:
                    raise PortalError("OpenFile handler executable is unavailable") from error
                if not stat.S_ISREG(executable_metadata.st_mode) or not os.access(executable, os.X_OK):
                    raise PortalError("OpenFile handler executable is not an executable regular file")
                process = _spawn_open_file_handler(
                    open_file_policy,
                    self.descriptor,
                    self.spec.access,
                    self.spec.transfer,
                    file_chooser_enabled=file_chooser_enabled,
                )
                active_external_handlers[process.pid] = process
                self._release_descriptor()
                self.finish(0)
            except Exception:
                # Do not return handler argv, descriptor number, inode metadata,
                # or process errors over the private bus.
                self.finish(2)
            return False

        def _release_descriptor(self) -> None:
            if self.descriptor >= 0:
                with contextlib_suppress(OSError):
                    os.close(self.descriptor)
                self.descriptor = -1

        def finish(self, response: int) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                connection.emit_signal(
                    self.spec.sender,
                    self.spec.handle,
                    REQUEST_INTERFACE,
                    "Response",
                    GLib.Variant("(ua{sv})", (response, {})),
                )
            finally:
                self._release_descriptor()
                self.unregister()

        def close_without_response(self) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                self._release_descriptor()
            finally:
                self.unregister()

        def unregister(self) -> None:
            active.pop(self.spec.handle, None)
            if self.registration_id:
                connection.unregister_object(self.registration_id)
                self.registration_id = 0

    class OpenDirectoryRequest:
        def __init__(self, spec: OpenDirectoryRequestSpec) -> None:
            self.spec = spec
            self.registration_id = 0
            self.finished = False
            self.object_descriptor = spec.object_descriptor
            self.directory_descriptor = spec.directory_descriptor

        def register(self) -> None:
            self.registration_id = connection.register_object(
                self.spec.handle,
                request_interface,
                self._method_call,
                None,
                None,
            )
            if not self.registration_id:
                raise PortalError("could not register the private OpenDirectory request")

        def _method_call(
            self,
            _connection: Any,
            sender: str,
            _object_path: str,
            _interface_name: str,
            method_name: str,
            _parameters: Any,
            invocation: Any,
        ) -> None:
            if sender != self.spec.sender:
                invocation.return_dbus_error(
                    "org.freedesktop.portal.Error.NotAllowed",
                    "only the request owner may close this launch-local OpenDirectory request",
                )
                return
            if method_name != "Close":
                invocation.return_dbus_error(
                    "org.freedesktop.DBus.Error.UnknownMethod",
                    "unknown request method",
                )
                return
            invocation.return_value(None)
            self.close_without_response()

        def dispatch(self) -> bool:
            if self.finished:
                return False
            try:
                reap_external_handlers()
                if len(active_external_handlers) >= MAX_ACTIVE_EXTERNAL_HANDLERS:
                    raise PortalError("the launch-local external handler limit has been reached")
                if open_directory_policy is None:
                    raise PortalError("OpenDirectory authority is unavailable")
                if self.object_descriptor < 0 or self.directory_descriptor < 0:
                    raise PortalError("OpenDirectory descriptor custody is unavailable")
                if self.object_descriptor == self.directory_descriptor:
                    raise PortalError("OpenDirectory descriptor custody is not distinct")

                object_metadata = os.fstat(self.object_descriptor)
                directory_metadata = os.fstat(self.directory_descriptor)
                if (
                    object_metadata.st_dev != self.spec.object_device
                    or object_metadata.st_ino != self.spec.object_inode
                ):
                    raise PortalError("OpenDirectory retained object identity changed")
                if (
                    directory_metadata.st_dev != self.spec.directory_device
                    or directory_metadata.st_ino != self.spec.directory_inode
                    or not stat.S_ISDIR(directory_metadata.st_mode)
                ):
                    raise PortalError("OpenDirectory retained directory identity changed")
                if self.spec.object_kind == "regular":
                    if not stat.S_ISREG(object_metadata.st_mode):
                        raise PortalError("OpenDirectory retained object kind changed")
                elif self.spec.object_kind == "directory":
                    if not stat.S_ISDIR(object_metadata.st_mode):
                        raise PortalError("OpenDirectory retained object kind changed")
                else:
                    raise PortalError("OpenDirectory retained object kind is invalid")

                if self.spec.selected_name:
                    try:
                        selected_metadata = os.stat(
                            self.spec.selected_name,
                            dir_fd=self.directory_descriptor,
                            follow_symlinks=False,
                        )
                    except OSError as error:
                        raise PortalError("OpenDirectory selected entry is unavailable") from error
                    if stat.S_ISLNK(selected_metadata.st_mode) or not _same_object(
                        object_metadata, selected_metadata
                    ):
                        raise PortalError("OpenDirectory selected entry no longer identifies the object")
                elif not _same_object(object_metadata, directory_metadata):
                    raise PortalError("OpenDirectory root-directory fallback lost identity")

                executable = open_directory_policy.handler[0]
                try:
                    executable_metadata = os.stat(executable, follow_symlinks=False)
                except OSError as error:
                    raise PortalError("OpenDirectory handler executable is unavailable") from error
                if not stat.S_ISREG(executable_metadata.st_mode) or not os.access(executable, os.X_OK):
                    raise PortalError(
                        "OpenDirectory handler executable is not an executable regular file"
                    )
                process = _spawn_open_directory_handler(
                    open_directory_policy,
                    self.object_descriptor,
                    self.directory_descriptor,
                    self.spec.object_kind,
                    self.spec.selected_name,
                    file_chooser_enabled=file_chooser_enabled,
                )
                active_external_handlers[process.pid] = process
                self._release_descriptors()
                self.finish(0)
            except Exception:
                self.finish(2)
            return False

        def _release_descriptors(self) -> None:
            if self.object_descriptor >= 0:
                with contextlib_suppress(OSError):
                    os.close(self.object_descriptor)
                self.object_descriptor = -1
            if self.directory_descriptor >= 0:
                with contextlib_suppress(OSError):
                    os.close(self.directory_descriptor)
                self.directory_descriptor = -1

        def finish(self, response: int) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                connection.emit_signal(
                    self.spec.sender,
                    self.spec.handle,
                    REQUEST_INTERFACE,
                    "Response",
                    GLib.Variant("(ua{sv})", (response, {})),
                )
            finally:
                self._release_descriptors()
                self.unregister()

        def close_without_response(self) -> None:
            if self.finished:
                return
            self.finished = True
            try:
                self._release_descriptors()
            finally:
                self.unregister()

        def unregister(self) -> None:
            active.pop(self.spec.handle, None)
            if self.registration_id:
                connection.unregister_object(self.registration_id)
                self.registration_id = 0

    def establish_request(
        invocation: Any,
        request: Any,
        callback: Any,
        failure_message: str,
    ) -> None:
        source_id = 0
        try:
            if request.spec.handle in active:
                raise PortalError("portal request handle is already active")
            request.register()
            active[request.spec.handle] = request
            source_id = GLib.idle_add(callback, priority=GLib.PRIORITY_DEFAULT)
            if not source_id:
                raise PortalError("could not schedule the private portal request")
            invocation.return_value(GLib.Variant("(o)", (request.spec.handle,)))
            return
        except PortalError:
            if source_id:
                with contextlib_suppress(Exception):
                    GLib.source_remove(source_id)
            with contextlib_suppress(Exception):
                request.close_without_response()
            raise
        except Exception as error:
            if source_id:
                with contextlib_suppress(Exception):
                    GLib.source_remove(source_id)
            with contextlib_suppress(Exception):
                request.close_without_response()
            raise PortalError(failure_message) from error

    def on_file_chooser_call(
        _connection: Any,
        sender: str,
        _object_path: str,
        _interface_name: str,
        method_name: str,
        parameters: Any,
        invocation: Any,
    ) -> None:
        try:
            if len(active) >= MAX_ACTIVE_REQUESTS:
                raise PortalError("the launch-local portal request limit has been reached")
            parent_window, title, options = _deep_unbox(parameters)
            spec = _parse_request(method_name, sender, parent_window, title, options, policy)
            request = PortalRequest(spec)
            establish_request(
                invocation,
                request,
                request.show,
                "the launch-local file chooser request could not be established",
            )
        except PortalError as error:
            invocation.return_dbus_error("org.freedesktop.portal.Error.InvalidArgument", str(error))
        except Exception:
            invocation.return_dbus_error(
                "org.freedesktop.portal.Error.Failed",
                "the launch-local file chooser request could not be established",
            )

    def on_open_uri_call(
        _connection: Any,
        sender: str,
        _object_path: str,
        _interface_name: str,
        method_name: str,
        parameters: Any,
        invocation: Any,
    ) -> None:
        try:
            if method_name == "SchemeSupported":
                scheme, options = _deep_unbox(parameters)
                invocation.return_value(
                    GLib.Variant(
                        "(b)",
                        (_scheme_supported_request(scheme, options, open_uri_policy),),
                    )
                )
                return
            if len(active) >= MAX_ACTIVE_REQUESTS:
                raise PortalError("the launch-local portal request limit has been reached")
            if method_name == "OpenURI":
                if open_uri_policy is None:
                    raise PortalError("OpenURI authority is unavailable")
                parent_window, uri, options = _deep_unbox(parameters)
                spec = _parse_open_uri_request(sender, parent_window, uri, options, open_uri_policy)
                request = OpenUriRequest(spec)
                establish_request(
                    invocation,
                    request,
                    request.dispatch,
                    "the launch-local OpenURI request could not be established",
                )
                return
            if method_name == "OpenFile":
                if open_file_policy is None:
                    raise PortalError("OpenFile authority is unavailable")
                parent_window, descriptor_index, options = _deep_unbox(parameters)
                spec = _parse_open_file_request(
                    sender,
                    parent_window,
                    descriptor_index,
                    options,
                    open_file_policy,
                    invocation,
                )
                request = OpenFileRequest(spec)
                establish_request(
                    invocation,
                    request,
                    request.dispatch,
                    "the launch-local OpenFile request could not be established",
                )
                return
            if method_name == "OpenDirectory":
                if open_directory_policy is None:
                    raise PortalError("OpenDirectory authority is unavailable")
                parent_window, descriptor_index, options = _deep_unbox(parameters)
                spec = _parse_open_directory_request(
                    sender,
                    parent_window,
                    descriptor_index,
                    options,
                    invocation,
                    policy,
                )
                request = OpenDirectoryRequest(spec)
                establish_request(
                    invocation,
                    request,
                    request.dispatch,
                    "the launch-local OpenDirectory request could not be established",
                )
                return
            raise PortalError("unsupported OpenURI interface method")
        except PortalError as error:
            invocation.return_dbus_error("org.freedesktop.portal.Error.InvalidArgument", str(error))
        except Exception:
            invocation.return_dbus_error(
                "org.freedesktop.portal.Error.Failed",
                "the launch-local OpenURI request could not be established",
            )

    def on_get_property(
        _connection: Any,
        _sender: str,
        _object_path: str,
        interface_name: str,
        property_name: str,
    ) -> Any:
        if interface_name == FILE_CHOOSER_INTERFACE and property_name == "version":
            return GLib.Variant("u", FILE_CHOOSER_VERSION)
        if interface_name == OPEN_URI_INTERFACE and property_name == "version":
            return GLib.Variant("u", OPEN_URI_VERSION)
        return None

    if file_chooser_enabled:
        registration_id = connection.register_object(
            DESKTOP_PATH,
            portal_interface,
            on_file_chooser_call,
            on_get_property,
            None,
        )
        if not registration_id:
            raise RuntimeError("could not register the launch-local FileChooser object")
        registration_ids.append(registration_id)
    if open_uri_interface_enabled:
        registration_id = connection.register_object(
            DESKTOP_PATH,
            open_uri_interface,
            on_open_uri_call,
            on_get_property,
            None,
        )
        if not registration_id:
            raise RuntimeError("could not register the launch-local OpenURI object")
        registration_ids.append(registration_id)

    reply = connection.call_sync(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus",
        "RequestName",
        GLib.Variant("(su)", (BUS_NAME, 4)),
        GLib.VariantType.new("(u)"),
        Gio.DBusCallFlags.NONE,
        5000,
        None,
    )
    result = reply.unpack()[0]
    if result not in {1, 4}:
        raise RuntimeError("launch-local portal bus name is already owned")

    def owner_changed(
        _connection: Any,
        _sender_name: str,
        _object_path: str,
        _interface_name: str,
        _signal_name: str,
        parameters: Any,
    ) -> None:
        name = _disconnected_unique_name(parameters)
        if name is None:
            return
        # A Request object belongs to one D-Bus unique name. Close without a
        # Response when that peer vanishes so abandoned requests cannot retain
        # the bounded launch-local slots.
        for request in list(active.values()):
            if request.spec.sender == name:
                request.close_without_response()

    owner_subscription = connection.signal_subscribe(
        "org.freedesktop.DBus",
        "org.freedesktop.DBus",
        "NameOwnerChanged",
        "/org/freedesktop/DBus",
        None,
        Gio.DBusSignalFlags.NONE,
        owner_changed,
    )
    if not owner_subscription:
        raise RuntimeError("could not subscribe to private-bus owner lifecycle")

    reap_source = GLib.timeout_add_seconds(1, reap_external_handlers)
    shutting_down = False

    def quit_main(*_unused: Any) -> bool:
        nonlocal shutting_down
        if shutting_down:
            return False
        shutting_down = True
        for request in list(active.values()):
            request.close_without_response()
        for process in active_external_handlers.values():
            if process.poll() is None:
                with contextlib_suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGTERM)
        for process in active_external_handlers.values():
            if process.poll() is None:
                with contextlib_suppress(Exception):
                    process.wait(timeout=0.25)
            if process.poll() is None:
                with contextlib_suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGKILL)
        for process in active_external_handlers.values():
            with contextlib_suppress(Exception):
                process.wait(timeout=0.25)
        active_external_handlers.clear()
        main_loop.quit()
        return False

    connection.connect("closed", lambda *_unused: quit_main())
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signum, quit_main)
    _write_ready(
        Path(args.ready_file),
        args.launch_id,
        args.portal_access,
        args.open_uri_policy_sha256,
        args.open_file_policy_sha256,
        args.open_directory_policy_sha256,
    )
    try:
        main_loop.run()
    finally:
        with contextlib_suppress(Exception):
            GLib.source_remove(reap_source)
        with contextlib_suppress(Exception):
            connection.signal_unsubscribe(owner_subscription)
        for registration_id in reversed(registration_ids):
            with contextlib_suppress(Exception):
                connection.unregister_object(registration_id)
    return 0


class contextlib_suppress:
    """Tiny local suppressor; keeps the trusted helper's imports minimal."""

    def __init__(self, *exceptions: type[BaseException]) -> None:
        self.exceptions = exceptions or (Exception,)

    def __enter__(self) -> None:
        return None

    def __exit__(self, kind: Any, _value: Any, _traceback: Any) -> bool:
        return kind is not None and issubclass(kind, self.exceptions)


def _arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--ready-file")
    parser.add_argument("--project")
    parser.add_argument("--home")
    parser.add_argument("--output")
    parser.add_argument("--project-access", choices=("readonly", "readwrite"))
    parser.add_argument("--application-id")
    parser.add_argument("--launch-id")
    parser.add_argument("--portal-access", choices=tuple(PORTAL_ACCESS_FEATURES))
    parser.add_argument("--open-uri-policy", default="")
    parser.add_argument("--open-uri-policy-sha256", default="")
    parser.add_argument("--open-file-policy", default="")
    parser.add_argument("--open-file-policy-sha256", default="")
    parser.add_argument("--open-directory-policy", default="")
    parser.add_argument("--open-directory-policy-sha256", default="")
    parsed = parser.parse_args(argv)
    if parsed.self_test or parsed.version:
        return parsed
    for name in (
        "ready_file",
        "project",
        "home",
        "output",
        "project_access",
        "application_id",
        "launch_id",
        "portal_access",
    ):
        if getattr(parsed, name) is None:
            parser.error(f"--{name.replace('_', '-')} is required")
    return parsed


def main(argv: list[str]) -> int:
    args = _arguments(argv)
    if args.version:
        print(PROTOCOL)
        return 0
    if args.self_test:
        return _self_test()
    return _runtime(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (PortalError, OSError, RuntimeError) as error:
        print(f"sandcodex private desktop portal: {error}", file=sys.stderr)
        raise SystemExit(70) from None
SANDCODEX_PRIVATE_FILE_PORTAL
}

sc_emit_desktop_app_launcher() {
  cat <<'SANDCODEX_DESKTOP_APP_LAUNCHER'
#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

: "${SANDCODEX_APP_BWRAP:?}"
: "${SANDCODEX_APP_PROJECT:?}"
: "${SANDCODEX_APP_HOME_ROOT:?}"
: "${SANDCODEX_APP_OUTPUT:?}"
: "${SANDCODEX_APP_OUTPUT_SCOPE:?}"
: "${SANDCODEX_APP_DROP_ROOT:?}"
: "${SANDCODEX_APP_DROP_SCOPE:?}"
: "${SANDCODEX_APP_WAYLAND_SOCKET:?}"
: "${SANDCODEX_APP_WAYLAND_DISPLAY:?}"
: "${SANDCODEX_APP_PATH:?}"
: "${SANDCODEX_APP_LAUNCH_ID:?}"
: "${SANDCODEX_APP_APPLICATION_ID:?}"
: "${SANDCODEX_APP_BASH:?}"

# Consume the controller pipe before invoking any external utility, then close
# it. The raw surface capability never occupies argv or any process
# environment, and the inherited descriptor cannot leak into validation tools.
notification_surface_inherited_fd=${SANDCODEX_APP_NOTIFICATION_SURFACE_FD-}
unset SANDCODEX_APP_NOTIFICATION_SURFACE_FD
export -n notification_surface_inherited_fd
notification_surface_token=
if [[ -n "$notification_surface_inherited_fd" ]]; then
  [[ "$notification_surface_inherited_fd" =~ ^[0-9]{1,9}$ && \
    -r "/proc/self/fd/$notification_surface_inherited_fd" && \
    -p "/proc/self/fd/$notification_surface_inherited_fd" ]] || {
    printf 'sandcodex desktop app launcher: private notification surface descriptor lost pipe custody\n' >&2
    exit 70
  }
  IFS= read -r notification_surface_token <&"$notification_surface_inherited_fd" || {
    printf 'sandcodex desktop app launcher: private notification surface descriptor was empty\n' >&2
    exit 70
  }
  notification_surface_extra=
  if IFS= read -r notification_surface_extra <&"$notification_surface_inherited_fd" || \
    [[ -n "$notification_surface_extra" ]]; then
    printf 'sandcodex desktop app launcher: private notification surface descriptor carried extra data\n' >&2
    exit 70
  fi
  notification_surface_extra=
  exec {notification_surface_inherited_fd}<&-
  notification_surface_inherited_fd=
  [[ "$notification_surface_token" =~ ^[0-9a-f]{32}$ ]] || {
    printf 'sandcodex desktop app launcher: private notification surface capability is invalid\n' >&2
    exit 70
  }
fi

# TrayOriginSeal uses an independent controller capability. Consume it with
# shell builtins and close the descriptor before invoking any external utility;
# the raw 128-bit surface identity must never reach validation helpers, argv,
# the application environment, or another process.
status_surface_inherited_fd=${SANDCODEX_APP_STATUS_SURFACE_FD-}
unset SANDCODEX_APP_STATUS_SURFACE_FD
export -n status_surface_inherited_fd
status_surface_token=
if [[ -n "$status_surface_inherited_fd" ]]; then
  [[ "$status_surface_inherited_fd" =~ ^[0-9]{1,9}$ && \
    -r "/proc/self/fd/$status_surface_inherited_fd" && \
    -p "/proc/self/fd/$status_surface_inherited_fd" ]] || {
    printf 'sandcodex desktop app launcher: private status surface descriptor lost pipe custody\n' >&2
    exit 70
  }
  IFS= read -r status_surface_token <&"$status_surface_inherited_fd" || {
    printf 'sandcodex desktop app launcher: private status surface descriptor was empty\n' >&2
    exit 70
  }
  status_surface_extra=
  if IFS= read -r status_surface_extra <&"$status_surface_inherited_fd" || \
    [[ -n "$status_surface_extra" ]]; then
    printf 'sandcodex desktop app launcher: private status surface descriptor carried extra data\n' >&2
    exit 70
  fi
  status_surface_extra=
  exec {status_surface_inherited_fd}<&-
  status_surface_inherited_fd=
  [[ "$status_surface_token" =~ ^[0-9a-f]{32}$ ]] || {
    printf 'sandcodex desktop app launcher: private status surface capability is invalid\n' >&2
    exit 70
  }
fi

