+            (!button_stroke || sandcodex_stylus_button_exact(tool, stylus_button)) &&
+            sandcodex_stylus_live_route_exact(client, seat, expected_surface,
+                expected_target_client, tool, tool_client,
+                expected_pointer_grab_address,
+                expected_pointer_default_grab_address,
+                expected_pointer_client_address) &&
