sc_emit_wayland_security_context_source() {
  cat <<'SANDCODEX_WAYLAND_CONTEXT_C'
#define _GNU_SOURCE
#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <stdbool.h>
#include <stddef.h>
