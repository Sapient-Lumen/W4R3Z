+static bool sandcodex_cursor_near_requested(struct sway_seat *seat, int64_t x,
+		int64_t y, double *actual_x_out, double *actual_y_out) {
+	if (!seat || !seat->cursor || !seat->cursor->cursor) {
+		return false;
+	}
+	double actual_x = seat->cursor->cursor->x;
+	double actual_y = seat->cursor->cursor->y;
+	bool matches = actual_x == actual_x && actual_y == actual_y &&
+		actual_x >= (double)x - 0.25 && actual_x <= (double)x + 0.25 &&
+		actual_y >= (double)y - 0.25 && actual_y <= (double)y + 0.25;
+	if (!matches) {
+		return false;
+	}
+	if (actual_x_out) {
+		*actual_x_out = actual_x;
+	}
+	if (actual_y_out) {
+		*actual_y_out = actual_y;
+	}
+	return true;
