sc_tty() { [[ -t 1 && -t 2 ]]; }
sc_colour() { sc_tty && [[ -z "${NO_COLOR:-}" ]] && printf '\033[%sm' "$1" || true; }
sc_reset() { sc_tty && [[ -z "${NO_COLOR:-}" ]] && printf '\033[0m' || true; }
sc_note() { (( SC_QUIET )) || printf '%s◇%s %s\n' "$(sc_colour 36)" "$(sc_reset)" "$*" >&2; }
sc_ok() { (( SC_QUIET )) || printf '%s✓%s %s\n' "$(sc_colour 32)" "$(sc_reset)" "$*" >&2; }
sc_warn() { printf '%s!%s %s\n' "$(sc_colour 33)" "$(sc_reset)" "$*" >&2; }
sc_err() { printf '%s✗%s %s\n' "$(sc_colour 31)" "$(sc_reset)" "$*" >&2; }
sc_now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }

sc_log_event() {
  local level="$1" event="$2" message="$3" timestamp text_message pair text_pair
  shift 3
  [[ -n "$SC_LOG" ]] || return 0
  timestamp="$(sc_now)"
  text_message="${message//$'\r'/\\r}"
  text_message="${text_message//$'\n'/\\n}"
  printf '%s [%s] %-22s %s' "$timestamp" "$level" "$event" "$text_message" >>"$SC_LOG"
  for pair in "$@"; do
    text_pair="${pair//$'\r'/\\r}"
    text_pair="${text_pair//$'\n'/\\n}"
    printf ' %s' "$text_pair" >>"$SC_LOG"
  done
  printf '\n' >>"$SC_LOG"
  local args=(--arg timestamp "$timestamp" --arg level "$level" --arg event "$event" --arg message "$message")
  # jq expands these names; the shell must not.
  # shellcheck disable=SC2016
  local filter='{timestamp:$timestamp,level:$level,event:$event,message:$message}' key value i=0
  for pair in "$@"; do
    key="${pair%%=*}"; value="${pair#*=}"
    args+=(--arg "k$i" "$key" --arg "v$i" "$value")
    filter+=" | .[\$k$i]=\$v$i"
    (( i += 1 ))
  done
  jq -cn "${args[@]}" "$filter" >>"$SC_EVENTS"
}

sc_debug() {
  (( SC_VERBOSE )) || return 0
  sc_note "$*"
  sc_log_event debug diagnostic "$*"
}

sc_die() {
  local message="$1" rc="${2:-1}"
  sc_err "$message"
  if [[ -n "$SC_LOG" ]]; then
    sc_log_event error failure "$message" "exit_code=$rc" "operation=$SC_OPERATION"
    SC_EXIT_LOGGED=1
    sc_err "trace: $SC_LOG"
  fi
  exit "$rc"
}

sc_usage_error() {
  local topic="${SC_HELP_TOPIC:-run}"
  sc_err "$1"
  printf 'Try: sandcodex help %s\n' "$topic" >&2
  exit 64
}

sc_pid_still_matches() {
  local pid="$1" started="$2" current
  [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || return 1
  current="$(sc_process_start "$pid" 2>/dev/null || true)"
  [[ "$current" == "$started" ]]
}

sc_stop_tracked_pid() {
  local pid="$1" started="$2" signal="${3:-TERM}" grace_tenths="${4:-50}" attempt
  [[ "$grace_tenths" =~ ^[1-9][0-9]{0,5}$ ]] || grace_tenths=50
  sc_pid_still_matches "$pid" "$started" || return 0
  kill -s "$signal" "$pid" 2>/dev/null || true
  for (( attempt=0; attempt<grace_tenths; attempt++ )); do
    sc_pid_still_matches "$pid" "$started" || return 0
    sleep 0.1
  done
  [[ "$signal" == KILL ]] || sc_stop_tracked_pid "$pid" "$started" KILL 50
}

sc_close_inherited_fds() {
  local keep=" $* " path fd
  for path in /proc/"$BASHPID"/fd/*; do
    fd="${path##*/}"
    case "$fd" in
      0|1|2) continue ;;
      *[!0-9]*|"") continue ;;
    esac
    [[ "$keep" != *" $fd "* ]] || continue
    { exec {fd}>&-; } 2>/dev/null || true
  done
}

sc_run_clean_fds() (
  sc_close_inherited_fds
  exec "$@"
)

# This brace-bodied helper is intentionally used only as an asynchronous job.
# Bash already forks once for a background function; exec then replaces that
# exact child. Calling the subshell-bodied sc_run_clean_fds asynchronously
# would introduce a second wrapper process, so killing $! could orphan Codex.
sc_exec_clean_fds() {
  sc_close_inherited_fds
  exec "$@"
}

sc_owner_uid() { stat -c '%u' -- "$1"; }
sc_mode_octal() { stat -c '%a' -- "$1"; }

sc_jail_fatal() {
  local message="$1" detail="" flattened
  shift || true
  if (( $# )); then
    detail="$*"
    printf '%s\n' "$detail" >&2
  fi
  if [[ "$SC_OPERATION" == doctor ]]; then
    if [[ -n "$detail" ]]; then
      flattened="${detail//$'\n'/; }"
      sc_log_event error inner_jail_failure "$message" "detail=${flattened:0:2000}"
    else
      sc_log_event error inner_jail_failure "$message"
    fi
    return 1
  fi
  sc_die "$message"
}

sc_stop_browser_services() {
  local pid started index owner_tracked=0 owner_reaped=0 singleton socket_target="" attempt
  local manifest_entrypoint="" restore=""
  local -a pids=(
    "$SC_BROWSER_PREFLIGHT_PID" "$SC_BROWSER_MCP_SUPERVISOR_PID" "$SC_BROWSER_BROKER_PID"
    "$SC_BROWSER_WEB_BRIDGE_PID" "$SC_BROWSER_VIEWER_PID" "$SC_BROWSER_DISPLAY_PID"
  )
  local -a starts=(
    "$SC_BROWSER_PREFLIGHT_START" "$SC_BROWSER_MCP_SUPERVISOR_START" "$SC_BROWSER_BROKER_START"
    "$SC_BROWSER_WEB_BRIDGE_START" "$SC_BROWSER_VIEWER_START" "$SC_BROWSER_DISPLAY_START"
  )
  [[ "$SC_BROWSER_MCP_SUPERVISOR_PID" =~ ^[0-9]+$ ]] && owner_tracked=1
  for index in "${!pids[@]}"; do
    pid="${pids[$index]}"; started="${starts[$index]}"
    sc_stop_tracked_pid "$pid" "$started" TERM
  done
  for pid in "${pids[@]}"; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    wait "$pid" 2>/dev/null || true
  done
  if [[ "$SC_BROWSER_MCP_SUPERVISOR_PID" =~ ^[0-9]+$ &&
    "$SC_BROWSER_MCP_SUPERVISOR_START" =~ ^[0-9]+$ &&
    -n "$SC_BROWSER_MCP_SUPERVISOR_STATUS" && -f "$SC_BROWSER_MCP_SUPERVISOR_STATUS" &&
    ! -L "$SC_BROWSER_MCP_SUPERVISOR_STATUS" ]]; then
    jq -e --argjson pid "$SC_BROWSER_MCP_SUPERVISOR_PID" --arg start "$SC_BROWSER_MCP_SUPERVISOR_START" '
      .schema == "sandcodex.browser-mcp-supervisor.v1" and
      .supervisor_pid == $pid and .supervisor_start_ticks == $start and
      .state == "stopped" and .owner_group_reaped == true and .stop_failure == null
    ' "$SC_BROWSER_MCP_SUPERVISOR_STATUS" >/dev/null 2>&1 && owner_reaped=1
  fi
  SC_BROWSER_PREFLIGHT_PID=""; SC_BROWSER_PREFLIGHT_START=""
  SC_BROWSER_MCP_OWNER_PID=""; SC_BROWSER_MCP_OWNER_START=""
  SC_BROWSER_MCP_SUPERVISOR_PID=""; SC_BROWSER_MCP_SUPERVISOR_START=""
  SC_BROWSER_BROKER_PID=""; SC_BROWSER_BROKER_START=""
  SC_BROWSER_WEB_BRIDGE_PID=""; SC_BROWSER_WEB_BRIDGE_START=""
  SC_BROWSER_VIEWER_PID=""; SC_BROWSER_VIEWER_START=""; SC_BROWSER_VIEWER_WINDOW=""
  SC_BROWSER_DISPLAY_PID=""; SC_BROWSER_DISPLAY_START=""
  [[ -z "$SC_BROWSER_SOCKET" ]] || rm -f -- "$SC_BROWSER_SOCKET" 2>/dev/null || true
  [[ -z "$SC_BROWSER_RECOVERY_SOCKET" ]] || rm -f -- "$SC_BROWSER_RECOVERY_SOCKET" 2>/dev/null || true
  [[ -z "$SC_BROWSER_VIEWER_SOCKET" ]] || rm -f -- "$SC_BROWSER_VIEWER_SOCKET" 2>/dev/null || true
  [[ -z "$SC_BROWSER_PROXY_CONFIG" ]] || rm -f -- "$SC_BROWSER_PROXY_CONFIG" 2>/dev/null || true
  [[ -z "$SC_BROWSER_WEB_SOCKET" ]] || rm -f -- "$SC_BROWSER_WEB_SOCKET" 2>/dev/null || true

  if [[ -n "$SC_BROWSER_PROFILE" && -d "$SC_BROWSER_PROFILE" && ! -L "$SC_BROWSER_PROFILE" ]]; then
    singleton="$SC_BROWSER_PROFILE/SingletonSocket"
    if (( owner_reaped )); then
      rm -f -- "$SC_BROWSER_PROFILE/SingletonLock" "$SC_BROWSER_PROFILE/SingletonSocket" \
        "$SC_BROWSER_PROFILE/SingletonCookie" 2>/dev/null || true
    elif (( ! owner_tracked )); then
      for (( attempt=0; attempt<50; attempt++ )); do
        socket_target=""
        [[ ! -L "$singleton" ]] || socket_target="$(readlink -- "$singleton" 2>/dev/null || true)"
        if [[ ! -S "$singleton" && ( "$socket_target" != /* || ! -S "$socket_target" ) ]]; then break; fi
        sleep 0.1
      done
      if [[ ! -S "$singleton" && ( "$socket_target" != /* || ! -S "$socket_target" ) ]] &&
        ! sc_browser_profile_process_alive "$SC_BROWSER_PROFILE"; then
        rm -f -- "$SC_BROWSER_PROFILE/SingletonLock" "$SC_BROWSER_PROFILE/SingletonSocket" \
          "$SC_BROWSER_PROFILE/SingletonCookie" 2>/dev/null || true
      fi
    fi
  fi

  if [[ -n "$SC_BROWSER_DOCTOR_NATIVE_MANIFEST" && \
    "$SC_BROWSER_DOCTOR_NATIVE_MANIFEST" == "$SC_BROWSER_HOME/.config/google-chrome-for-testing/NativeMessagingHosts/dev.sandcodex.doctor.json" ]]; then
    rm -f -- "$SC_BROWSER_DOCTOR_NATIVE_MANIFEST" 2>/dev/null || true
  fi
  if [[ -n "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" && -n "$SC_BROWSER_BUNDLE_NATIVE_ENTRYPOINT" && \
    "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" == "$SC_BROWSER_HOME/.config/google-chrome-for-testing/NativeMessagingHosts/"*.json ]]; then
    if [[ -f "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" && ! -L "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" ]]; then
      manifest_entrypoint="$(jq -r '.path // empty' "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" 2>/dev/null || true)"
    fi
    if [[ ! -e "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" || "$manifest_entrypoint" == "$SC_BROWSER_BUNDLE_BROWSER_ENTRYPOINT" ]]; then
      if [[ -n "$SC_BROWSER_BUNDLE_NATIVE_BACKUP" && -f "$SC_BROWSER_BUNDLE_NATIVE_BACKUP" && \
        ! -L "$SC_BROWSER_BUNDLE_NATIVE_BACKUP" ]]; then
        restore="$(mktemp "${SC_BROWSER_BUNDLE_NATIVE_MANIFEST%/*}/.sandcodex-native-restore.XXXXXX" 2>/dev/null || true)"
        if [[ -n "$restore" ]] && install -m 600 -- "$SC_BROWSER_BUNDLE_NATIVE_BACKUP" "$restore" 2>/dev/null && \
          mv -fT -- "$restore" "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" 2>/dev/null; then
          :
        else
          [[ -z "$restore" ]] || rm -f -- "$restore" 2>/dev/null || true
        fi
      elif [[ "$manifest_entrypoint" == "$SC_BROWSER_BUNDLE_BROWSER_ENTRYPOINT" ]]; then
        rm -f -- "$SC_BROWSER_BUNDLE_NATIVE_MANIFEST" 2>/dev/null || true
      fi
    fi
  fi
  if [[ -n "$SC_BROWSER_HOME" ]]; then
    local controlled_socket observed_socket
    for controlled_socket in \
      "$SC_BROWSER_HOME/.local/share/glasstty/run/daemon.sock" \
      "$SC_BROWSER_HOME/runtime"/*.sock; do
      [[ -S "$controlled_socket" ]] || continue
      observed_socket="$controlled_socket"
      if [[ -n "$SC_GLASSTTY_RUNTIME_HOME" && \
        "$controlled_socket" == "$SC_BROWSER_HOME/.local/share/glasstty/run/daemon.sock" ]]; then
        observed_socket="$SC_GLASSTTY_RUNTIME_HOME/run/daemon.sock"
      fi
      for (( attempt=0; attempt<50; attempt++ )); do
        if ! awk -v path="$controlled_socket" -v alias="$observed_socket" \
          '$NF == path || $NF == alias {found=1} END {exit !found}' /proc/net/unix; then
          rm -f -- "$controlled_socket" 2>/dev/null || true
          break
        fi
        sleep 0.1
      done
    done
  fi
}

sc_unmount_jail_storage() {
  (( SC_JAIL_STORAGE_MOUNTED )) || return 0
  local fusermount
  fusermount="$(command -v fusermount3 2>/dev/null || true)"
  [[ -x /run/wrappers/bin/fusermount3 ]] && fusermount=/run/wrappers/bin/fusermount3
  if [[ -n "$fusermount" && -n "$SC_JAIL_STORAGE_MOUNT" ]]; then
    "$fusermount" -u -- "$SC_JAIL_STORAGE_MOUNT" 2>/dev/null || \
      "$fusermount" -uz -- "$SC_JAIL_STORAGE_MOUNT" 2>/dev/null || true
  fi
  SC_JAIL_STORAGE_MOUNTED=0
}

sc_unmount_campaign_storage() {
  (( SC_CAMPAIGN_STORAGE_MOUNTED )) || return 0
  local fusermount
  if [[ -n "$SC_CAMPAIGN_STORAGE_UNIT" && -n "$SC_SYSTEMCTL" && -x "$SC_SYSTEMCTL" ]]; then
    "$SC_SYSTEMCTL" --user stop "$SC_CAMPAIGN_STORAGE_UNIT" >/dev/null 2>&1 || true
    "$SC_SYSTEMCTL" --user reset-failed "$SC_CAMPAIGN_STORAGE_UNIT" >/dev/null 2>&1 || true
  fi
  fusermount="$(command -v fusermount3 2>/dev/null || true)"
  [[ -x /run/wrappers/bin/fusermount3 ]] && fusermount=/run/wrappers/bin/fusermount3
  if mountpoint -q -- "$SC_CAMPAIGN_STORAGE_MOUNT" &&
    [[ -n "$fusermount" && -n "$SC_CAMPAIGN_STORAGE_MOUNT" ]]; then
    "$fusermount" -u -- "$SC_CAMPAIGN_STORAGE_MOUNT" 2>/dev/null ||
      "$fusermount" -uz -- "$SC_CAMPAIGN_STORAGE_MOUNT" 2>/dev/null || true
  fi
  SC_CAMPAIGN_STORAGE_MOUNTED=0
}

sc_remove_verified_runtime_tree() {
  local root="$1" label="$2" normalize_rc=0 quarantine diagnostic detail=""
  [[ -d "$root" && ! -L "$root" ]] || return 0
  diagnostic="$(mktemp "${SC_GLOBAL:-/tmp}/runtime/.reap-error.XXXXXX" 2>/dev/null || true)"
  [[ -n "$diagnostic" ]] || diagnostic=/dev/null
  python3 -P - "$root" "$(id -u)" 2>"$diagnostic" <<'PY' || normalize_rc=$?
import os
import re
import stat
import sys

root = os.path.abspath(sys.argv[1])
uid = int(sys.argv[2])


def decode_mount_path(value: str) -> str:
    return re.sub(r"\\([0-7]{3})", lambda match: chr(int(match.group(1), 8)), value)


try:
    with open("/proc/self/mountinfo", "r", encoding="utf-8") as stream:
        for line in stream:
            fields = line.split(" - ", 1)[0].split()
            if len(fields) < 5:
                raise RuntimeError("mount table is malformed")
            target = decode_mount_path(fields[4])
            if target == root or target.startswith(root + os.sep):
                print(f"contains a mount: {target}", file=sys.stderr)
                raise SystemExit(73)

    pending = [root]
    while pending:
        current = pending.pop()
        metadata = os.stat(current, follow_symlinks=False)
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != uid:
            print(f"contains a non-user-owned directory: {current}", file=sys.stderr)
            raise SystemExit(74)
        os.chmod(current, stat.S_IMODE(metadata.st_mode) | 0o700, follow_symlinks=False)
        with os.scandir(current) as entries:
            for entry in entries:
                child = entry.stat(follow_symlinks=False)
                if stat.S_ISDIR(child.st_mode):
                    pending.append(entry.path)
except SystemExit:
    raise
except (OSError, RuntimeError, UnicodeError) as error:
    print(f"could not normalize directories: {error}", file=sys.stderr)
    raise SystemExit(75)
PY
  if [[ "$diagnostic" != /dev/null ]]; then
    IFS= read -r detail <"$diagnostic" || true
    rm -f -- "$diagnostic"
  fi
  if (( normalize_rc == 0 )) && rm -rf -- "$root" 2>/dev/null; then
    return 0
  fi
  if (( normalize_rc == 73 )); then
    sc_warn "$label retained without blocking launch: ${detail:-runtime contains a live mount}"
    return 0
  fi
  quarantine="${root%/*}/.reap-${root##*/}-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  if mv -T -- "$root" "$quarantine" 2>/dev/null; then
    sc_warn "$label could not be deleted (${detail:-removal failed}); quarantined: $quarantine"
  else
    sc_warn "$label could not be deleted or quarantined; retained without blocking launch: $root"
  fi
  return 0
}

sc_cleanup_resource_handoff() {
  local root="$SC_RESOURCE_HANDOFF_ROOT" path
  [[ -n "$root" ]] || return 0
  case "$root" in
    "/run/user/$EUID"/sandcodex-resource-handoff.*) ;;
    *)
      sc_warn "resource-service handoff escaped its private runtime root; leaving it untouched"
      SC_RESOURCE_HANDOFF_ROOT=""; SC_RESOURCE_HANDOFF_ENV=""; SC_RESOURCE_HANDOFF_ENTER=""
      return 0
      ;;
  esac
  for path in "$SC_RESOURCE_HANDOFF_ENV" "$SC_RESOURCE_HANDOFF_ENTER"; do
    [[ -n "$path" && "$path" == "$root/"* ]] || continue
    if [[ ( -e "$path" || -L "$path" ) && "$(stat -c %u -- "$path" 2>/dev/null || true)" == "$EUID" ]]; then
      rm -f -- "$path" 2>/dev/null || true
    fi
  done
  if [[ -d "$root" && ! -L "$root" && "$(stat -c %u -- "$root" 2>/dev/null || true)" == "$EUID" ]]; then
    rmdir -- "$root" 2>/dev/null || true
  fi
  SC_RESOURCE_HANDOFF_ROOT=""; SC_RESOURCE_HANDOFF_ENV=""; SC_RESOURCE_HANDOFF_ENTER=""
}

sc_cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  sc_stop_operator_stack
  if [[ -n "$SC_CAMPAIGN_BROKER_PID" ]]; then
    sc_stop_tracked_pid "$SC_CAMPAIGN_BROKER_PID" "$SC_CAMPAIGN_BROKER_START" TERM
    wait "$SC_CAMPAIGN_BROKER_PID" 2>/dev/null || true
    SC_CAMPAIGN_BROKER_PID=""; SC_CAMPAIGN_BROKER_START=""
  fi
  if [[ -n "$SC_CAMPAIGN_AUTHORITY" && -f "$SC_CAMPAIGN_AUTHORITY" && \
    ! -L "$SC_CAMPAIGN_AUTHORITY" && "$(stat -c %u -- "$SC_CAMPAIGN_AUTHORITY" 2>/dev/null || true)" == "$EUID" ]]; then
    local authority_tmp
    authority_tmp="$(mktemp "${SC_CAMPAIGN_AUTHORITY%/*}/.campaign-authority.XXXXXX" 2>/dev/null || true)"
    if [[ -n "$authority_tmp" ]] && jq --arg ended_at "$(sc_now)" \
      '.status = "revoked" | .revoked_at = $ended_at' "$SC_CAMPAIGN_AUTHORITY" >"$authority_tmp" 2>/dev/null; then
      chmod 600 -- "$authority_tmp"
      mv -fT -- "$authority_tmp" "$SC_CAMPAIGN_AUTHORITY" 2>/dev/null || rm -f -- "$authority_tmp"
    else
      [[ -z "$authority_tmp" ]] || rm -f -- "$authority_tmp" 2>/dev/null || true
    fi
  fi
  if [[ -n "$SC_CAMPAIGN_PROVIDER_CONTRACT" && -f "$SC_CAMPAIGN_PROVIDER_CONTRACT" &&
    ! -L "$SC_CAMPAIGN_PROVIDER_CONTRACT" &&
    "$(stat -c %u:%h -- "$SC_CAMPAIGN_PROVIDER_CONTRACT" 2>/dev/null || true)" == "$EUID:1" ]]; then
    rm -f -- "$SC_CAMPAIGN_PROVIDER_CONTRACT" 2>/dev/null || true
  fi
  if [[ -n "$SC_CHILD_PID" ]]; then
    if [[ -n "$SC_CHILD_START" ]]; then
      sc_stop_tracked_pid "$SC_CHILD_PID" "$SC_CHILD_START" TERM 20
    else
      kill -TERM "$SC_CHILD_PID" 2>/dev/null || true
    fi
    wait "$SC_CHILD_PID" 2>/dev/null || true
    SC_CHILD_PID=""; SC_CHILD_START=""
  fi
  local loop_follow_pid
  for loop_follow_pid in "$SC_LOOP_STDOUT_FOLLOW_PID" "$SC_LOOP_STDERR_FOLLOW_PID"; do
    [[ "$loop_follow_pid" =~ ^[1-9][0-9]*$ ]] || continue
    kill -TERM "$loop_follow_pid" 2>/dev/null || true
    wait "$loop_follow_pid" 2>/dev/null || true
  done
  SC_LOOP_STDOUT_FOLLOW_PID=""; SC_LOOP_STDERR_FOLLOW_PID=""
  if declare -F sc_family_finalize_session_binding >/dev/null; then sc_family_finalize_session_binding 0; fi
  if declare -F sc_remote_router_stop >/dev/null; then sc_remote_router_stop; fi
  if declare -F sc_gemini_adapter_stop >/dev/null; then sc_gemini_adapter_stop; fi
  if [[ -n "${SC_GEMINI_RUNTIME_ROOT:-}" ]]; then
    case "$SC_GEMINI_RUNTIME_ROOT" in
      "$SC_GLOBAL"/runtime/.gemini-adapter.*)
        sc_remove_verified_runtime_tree "$SC_GEMINI_RUNTIME_ROOT" "Gemini adapter runtime"
        ;;
      *) sc_warn "Gemini adapter runtime path escaped its trusted root; leaving it untouched" ;;
    esac
    SC_GEMINI_RUNTIME_ROOT=""
  fi
  if declare -F sc_family_stop_local >/dev/null; then sc_family_stop_local; fi
  if [[ -n "${SC_REMOTE_TOKEN_FILE:-}" ]]; then rm -f -- "$SC_REMOTE_TOKEN_FILE" 2>/dev/null || true; fi
  if [[ -n "${SC_REMOTE_BOOTSTRAP_TOKEN_FILE:-}" ]]; then rm -f -- "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" 2>/dev/null || true; fi
  if [[ -n "$SC_SUDO_PID" ]]; then
    if sc_pid_still_matches "$SC_SUDO_PID" "$SC_SUDO_START" && \
        [[ "$SC_SUDO_PGID" =~ ^[1-9][0-9]*$ ]]; then
      kill -TERM -- "-$SC_SUDO_PGID" 2>/dev/null || true
      local sudo_attempt
      for sudo_attempt in {1..40}; do
        kill -0 -- "-$SC_SUDO_PGID" 2>/dev/null || break
        sleep 0.025
      done
      kill -KILL -- "-$SC_SUDO_PGID" 2>/dev/null || true
    fi
    sc_stop_tracked_pid "$SC_SUDO_PID" "$SC_SUDO_START" TERM 20
    wait "$SC_SUDO_PID" 2>/dev/null || true
    [[ -z "$SC_SUDO_PID_FILE" ]] || rm -f -- "$SC_SUDO_PID_FILE" 2>/dev/null || true
    SC_SUDO_PID=""; SC_SUDO_START=""; SC_SUDO_PGID=""; SC_SUDO_PID_FILE=""
  fi
  if [[ -n "$SC_BRIDGE_PID" ]]; then
    kill "$SC_BRIDGE_PID" 2>/dev/null || true
    wait "$SC_BRIDGE_PID" 2>/dev/null || true
  fi
  sc_publish_remove_locator
  sc_stop_publishers
  if declare -F sc_stop_inner_jail_broker >/dev/null; then
    sc_stop_inner_jail_broker
  fi
  sc_unmount_jail_storage
  # Campaign workers are detached from the interactive command room. Their
  # reviewed storage mount therefore remains live until an operator removes
  # the campaigns; command-room exit must not detach a filesystem they use.
  sc_stop_desktop_services
  sc_stop_browser_services
  if [[ -n "$SC_PROXY_PID" ]]; then
    kill "$SC_PROXY_PID" 2>/dev/null || true
    wait "$SC_PROXY_PID" 2>/dev/null || true
  fi
  if [[ -n "$SC_AGENT_TMP" && -d "$SC_AGENT_TMP" && ! -L "$SC_AGENT_TMP" && \
    "$(stat -c %u -- "$SC_AGENT_TMP" 2>/dev/null || true)" == "$EUID" ]]; then
    rm -rf -- "$SC_AGENT_TMP"
  fi
  if [[ -n "$SC_RUN_ROOT" && -d "$SC_RUN_ROOT" && ! -L "$SC_RUN_ROOT" ]]; then
    sc_remove_verified_runtime_tree "$SC_RUN_ROOT" "invocation runtime"
  fi
  if [[ -n "$SC_PROXY_TMP" && -d "$SC_PROXY_TMP" && ! -L "$SC_PROXY_TMP" ]]; then
    rm -rf -- "$SC_PROXY_TMP"
  fi
  if [[ -n "$SC_INSTALL_TMP" && -f "$SC_INSTALL_TMP" && ! -L "$SC_INSTALL_TMP" && \
    "$(stat -c %u -- "$SC_INSTALL_TMP" 2>/dev/null || true)" == "$(id -u)" ]]; then
    rm -f -- "$SC_INSTALL_TMP"
  fi
  sc_cleanup_resource_handoff
  local capture
  for capture in "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"; do
    [[ -n "$SC_CONTROL" && "$capture" == "$SC_CONTROL/tmp/.loop-"* ]] || continue
    rm -f -- "$capture" 2>/dev/null || true
  done
  if [[ -n "$SC_LOG" && $SC_EXIT_LOGGED -eq 0 ]]; then
    if (( rc == 0 )); then
      sc_log_event info complete "operation completed" "operation=$SC_OPERATION" "exit_code=0"
    else
      sc_log_event error failure "operation failed" "operation=$SC_OPERATION" "exit_code=$rc"
    fi
  fi
  if [[ -n "$SC_LOCK_READY" ]]; then
    rm -f -- "$SC_LOCK_READY" 2>/dev/null || true
  fi
  if [[ -n "$SC_LOCK_PID" ]]; then
    kill "$SC_LOCK_PID" 2>/dev/null || true
    wait "$SC_LOCK_PID" 2>/dev/null || true
  fi
  if declare -F sc_local_runtime_lock_release >/dev/null; then
    sc_local_runtime_lock_release lease
    sc_local_runtime_lock_release maintenance
  fi
  exit "$rc"
}
trap sc_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

sc_script_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -- "${BASH_SOURCE[0]}"
  else
    printf '%s/%s\n' "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" "$(basename -- "${BASH_SOURCE[0]}")"
  fi
}

sc_find_home() {
  if [[ -n "${SANDCODEX_REAL_HOME:-}" && \
    ( "${SANDCODEX_TESTING:-0}" == 1 || "${SANDCODEX_NIX_READY:-0}" == 1 || \
      "${SANDCODEX_SUPERVISED:-0}" == 1 ) ]]; then
    printf '%s\n' "$SANDCODEX_REAL_HOME"
    return
  fi
  local home=""
  if command -v getent >/dev/null 2>&1; then
    home="$(getent passwd "$(id -u)" 2>/dev/null | awk -F: 'NF >= 6 {print $6}')"
  fi
  [[ -n "$home" ]] || home="${HOME:-}"
  [[ "$home" == /* ]] || sc_die "cannot determine the invoking user's home directory"
  printf '%s\n' "$home"
}

sc_no_line_breaks() {
  local value="$1" label="$2"
  case "$value" in
    *$'\n'*|*$'\r'*) sc_die "$label contains a line break" ;;
  esac
}

sc_validate_global_root() {
  local path="$1"
  [[ "$path" != "$SC_REAL_HOME" ]] || sc_die "trusted state cannot be the entire home directory"
  [[ "${path#/}" == */* ]] || sc_die "refusing unsafe global control root: $path"
  case "$path" in
    /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib64/*|/nix/store/*|/proc/*|/root/*|/run/*|/sbin/*|/sys/*|/usr/*)
      sc_die "refusing global control state under a system runtime tree: $path" ;;
  esac
}

sc_no_symlink_components() {
  local path="$1" label="$2" cursor="/" component
  local -a components=()
  IFS='/' read -r -a components <<<"${path#/}"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    [[ "$cursor" == / ]] && cursor="/$component" || cursor+="/$component"
    [[ ! -L "$cursor" ]] || sc_die "$label contains a symlink component: $cursor"
  done
}

sc_owned_dir() {
  local path="$1" label="$2"
  [[ -d "$path" && ! -L "$path" ]] || sc_die "$label is not a real directory: $path"
  [[ "$(stat -c %u -- "$path")" == "$(id -u)" ]] || sc_die "$label is owned by another uid: $path"
}

sc_validate_project_for_inner_jail() {
  [[ "$SC_COMMAND" == run || "$SC_COMMAND" == doctor || \
    ( "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == run ) ]] || return 0
  local mode owner quoted
  [[ -d "$SC_PROJECT" && ! -L "$SC_PROJECT" ]] ||
    sc_die "selected project directory is not a real directory: $SC_PROJECT" 78
  owner="$(sc_owner_uid "$SC_PROJECT")"
  [[ "$owner" == "$EUID" ]] ||
    sc_die "selected project directory is owned by uid $owner, not uid $EUID: $SC_PROJECT" 78
  mode="$(sc_mode_octal "$SC_PROJECT")"
  [[ "$mode" =~ ^[0-7]+$ ]] || sc_die "selected project directory mode is unreadable: $SC_PROJECT" 78
  if (( (8#$mode & 8#022) != 0 )); then
    # This preflight protects the cgroup-backed inner jail's source-staging
    # invariants.  When the operator explicitly disables the resource scope,
    # the inner jail is unavailable for this launch anyway; do not turn that
    # already-declared degradation into an unrelated project-selection blocker.
    (( ! SC_BARE && ! SC_RESOURCE_SCOPE )) && return 0
    printf -v quoted '%q' "$SC_PROJECT"
    sc_die "selected project directory is group/world-writable (mode $mode), so the inner jail cannot start safely: $SC_PROJECT; run: chmod go-w -- $quoted" 78
  fi
}

sc_private_dir() {
  local path="$1" label="$2" private_python="$SC_PRIVATE_DIR_PYTHON"
  # Validate and normalize through one no-follow descriptor. A pathname chmod
  # can otherwise be redirected to an external directory if the validated
  # entry is replaced with a symlink between sc_owned_dir and this function.
  if [[ -z "$private_python" ]]; then
    private_python="$(command -v python3 2>/dev/null || true)"
  fi
  [[ -n "$private_python" && -x "$private_python" ]] ||
    sc_die "$label cannot be secured because the pinned Python runtime is unavailable"
  "$private_python" -P - "$path" "$label" <<'PY'
import os
import errno
import stat
import sys

path, label = sys.argv[1:]
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
flags |= getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(path, flags)
except OSError as error:
    print(f"sandcodex: {label} could not be opened without following links: {error}", file=sys.stderr)
    raise SystemExit(74)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
        print(f"sandcodex: {label} descriptor metadata is invalid", file=sys.stderr)
        raise SystemExit(74)
    # chmod changes an ACL mask but does not remove named or inheritable ACL
    # entries. Trusted/project-control roots must not inherit a parent's
    # collaboration ACL and pass it to a later child file.
    acl_names = {"system.posix_acl_access", "system.posix_acl_default"}
    try:
        present = set(os.listxattr(descriptor))
    except OSError as error:
        if error.errno not in {errno.ENODATA, errno.ENOTSUP, errno.EOPNOTSUPP}:
            print(f"sandcodex: {label} ACL inventory failed: {error}", file=sys.stderr)
            raise SystemExit(74)
        present = set()
    for attribute in sorted(acl_names & present):
        try:
            os.removexattr(descriptor, attribute)
        except OSError as error:
            print(f"sandcodex: {label} inherited ACL removal failed: {error}", file=sys.stderr)
            raise SystemExit(74)
    os.fchmod(descriptor, 0o700)
    try:
        remaining = acl_names & set(os.listxattr(descriptor))
    except OSError as error:
        if error.errno not in {errno.ENODATA, errno.ENOTSUP, errno.EOPNOTSUPP}:
            print(f"sandcodex: {label} ACL revalidation failed: {error}", file=sys.stderr)
            raise SystemExit(74)
        remaining = set()
    if remaining:
        print(f"sandcodex: {label} retained an extended POSIX ACL", file=sys.stderr)
        raise SystemExit(74)
finally:
    os.close(descriptor)
PY
  [[ "$(stat -c %a -- "$path")" == 700 ]] || sc_die "$label permissions could not be normalized to 0700"
}

sc_ensure_dir() {
  local path="$1" label="$2"
  if [[ -e "$path" || -L "$path" ]]; then
    sc_owned_dir "$path" "$label"
  else
    mkdir -- "$path"
  fi
  sc_private_dir "$path" "$label"
}

sc_owned_single_file() {
  local path="$1" mode="$2" label="$3"
  [[ -f "$path" && ! -L "$path" ]] || sc_die "$label is not a non-symlink regular file: $path"
  [[ "$(stat -c %u -- "$path")" == "$(id -u)" ]] || sc_die "$label is owned by another uid: $path"
  [[ "$(stat -c %h -- "$path")" == 1 ]] || sc_die "$label has multiple hardlinks: $path"
  [[ -z "$mode" || "$(stat -c %a -- "$path")" == "$mode" ]] || sc_die "$label permissions are not 0$mode: $path"
}

sc_init_global_bootstrap_permissions() {
  sc_no_symlink_components "$SC_GLOBAL" "global control root"
  mkdir -p -- "$SC_GLOBAL"
  sc_owned_dir "$SC_GLOBAL" "global control root"
  chmod 700 -- "$SC_GLOBAL"
  local directory label
  for directory in "$SC_GLOBAL/nix-home" "$SC_GLOBAL/cache"; do
    label="Nix bootstrap ${directory##*/}"
    [[ ! -L "$directory" ]] || sc_die "$label is a symlink: $directory"
    mkdir -p -- "$directory"
    sc_owned_dir "$directory" "$label"
    # chmod collapses an inherited ACL's effective mask even though it cannot
    # remove named/default entries. That is enough to protect the non-secret
    # bootstrap cache until pinned Python performs descriptor-based removal.
    chmod 700 -- "$directory"
  done
}

sc_init_global_minimal() {
  sc_init_global_bootstrap_permissions
  sc_private_dir "$SC_GLOBAL" "global control root"
  sc_ensure_dir "$SC_GLOBAL/nix-home" "Nix bootstrap home"
  sc_ensure_dir "$SC_GLOBAL/cache" "global cache"
}

sc_bootstrap_private_python() {
  local nix="$1" python_root rc=0
  # Trusted state must shed inherited default ACLs before its first child is
  # created, but Python is intentionally not part of the host contract. Realize
  # the pinned interpreter using bootstrap directories whose inherited ACL
  # masks have already been collapsed. The full realization reuses this cache.
  python_root=$(env -i HOME="$SC_GLOBAL/nix-home" XDG_CACHE_HOME="$SC_GLOBAL/cache" \
    NIXPKGS_ALLOW_UNFREE=1 PYTHONSAFEPATH=1 PATH="$PATH" \
    "$nix" --extra-experimental-features 'nix-command flakes' \
    build --no-link --print-out-paths "$SC_NIXPKGS#python312") || rc=$?
  (( rc == 0 )) || sc_die "Nix could not realize pinned Python for trusted-state initialization"
  [[ "$python_root" == /nix/store/*-python3-"$SC_PYTHON_VERSION" && \
    -x "$python_root/bin/python3" ]] ||
    sc_die "Nix returned an invalid bootstrap Python environment: $python_root"
  SC_PRIVATE_DIR_PYTHON="$python_root/bin/python3"
}

sc_remote_bootstrap_bridge() {
  [[ "$SC_PROVIDER_MODE" == remote ]] || return 0
  [[ "$SC_COMMAND" == run || "$SC_COMMAND" == loop ]] || return 0
  [[ -z "${SANDCODEX_REMOTE_PARENT_CONTRACT:-}" ]] || return 0
  (( ! SC_REMOTE_AUTO )) || return 0
  [[ -z "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" ]] || return 0
  local result rc=0 key credential bridge
  local -a args=(--file "$SC_GLOBAL/remote/providers.json")
  [[ -z "$SC_REMOTE_NAME" ]] || args+=(--provider "$SC_REMOTE_NAME")
  result="$(sc_emit_remote_config | "$SC_PRIVATE_DIR_PYTHON" -P - "${args[@]}")" || rc=$?
  (( rc == 0 )) || sc_die "remote provider configuration failed before Nix environment setup" "$rc"
  key="$("$SC_PRIVATE_DIR_PYTHON" -c 'import json,sys; print(json.load(sys.stdin)["config"]["env_key"])' <<<"$result")" || \
    sc_die "remote provider bootstrap could not read credential variable name" 78
  [[ "$key" =~ ^[A-Z][A-Z0-9_]{0,79}(_API_KEY|_TOKEN|_SECRET)$ ]] ||
    sc_die "remote provider bootstrap found an invalid credential variable name" 78
  credential="${!key:-}"
  [[ -n "$credential" && ${#credential} -le 16384 ]] ||
    sc_die "remote credential is missing or too large; export $key in the launching shell" 78
  [[ "$credential" != *$'\n'* && "$credential" != *$'\r'* ]] ||
    sc_die "remote credential contains a line break" 78
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  bridge="$SC_GLOBAL/runtime/remote-bootstrap-token.$$.$RANDOM"
  [[ ! -e "$bridge" && ! -L "$bridge" ]] || sc_die "remote credential bootstrap bridge path collision" 78
  printf '%s' "$credential" | sc_atomic "$bridge" 600
  SC_REMOTE_BOOTSTRAP_TOKEN_FILE=$bridge
  SC_REMOTE_BOOTSTRAP_ENV_KEY=$key
  credential=""
}

sc_sway_hit_test_build_marker() {
  printf '{"schema":"%s","sway_version":"%s","patch_sha256":"%s","ipc_type":%s,"nixpkgs_rev":"%s"}\n' \
    "$SC_SWAY_HIT_TEST_BUILD_SCHEMA" "$SC_SWAY_VERSION" \
    "$SC_SWAY_HIT_TEST_PATCH_SHA256" "$SC_SWAY_HIT_TEST_IPC_TYPE" \
    "$SC_NIXPKGS_REV"
}

sc_verify_sway_hit_test_build() {
  local root="$1" marker expected actual
  [[ "$root" == /nix/store/*-sandcodex-sway-"$SC_SWAY_VERSION"-* ]] || \
    sc_die "private Sway did not originate from the release-specific derivation: $root"
  marker="$root/share/sandcodex/sway-hit-test-build.json"
  [[ -f "$marker" && ! -L "$marker" && "$(stat -c %a -- "$marker")" == 444 ]] || \
    sc_die "private Sway build provenance marker is missing or unsafe"
  expected="$(sc_sway_hit_test_build_marker)"
  actual="$(cat -- "$marker")"
  [[ "$actual" == "$expected" ]] || \
    sc_die "private Sway build provenance marker does not match this Sandcodex release"
}

sc_uses_maintenance_runtime() {
  # `gemini` names only host-side inspection, credential management, inventory,
  # probing, and adapter qualification. Interactive Gemini rooms parse as
  # `run`, `loop`, or `gemini-auto-task` and therefore still receive the full
  # Codex/build/browser environment below.
  [[ "$SC_COMMAND" == state || "$SC_COMMAND" == gemini ]]
}

sc_bootstrap() {
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
    return
  fi
  [[ "${SANDCODEX_NIX_READY:-0}" != 1 ]] || return 0
  local nix
  nix="$(command -v nix 2>/dev/null || true)"
  [[ -n "$nix" ]] || sc_die "Nix with nix-command/flakes is required"
  sc_init_global_bootstrap_permissions
  sc_bootstrap_private_python "$nix"
  sc_init_global_minimal
  sc_remote_bootstrap_bridge
  local raw="${SANDCODEX_NIX_PACKAGES:-}" package
  if [[ -n "$raw" ]]; then
    read -r -a SC_EXTRA_PACKAGES <<<"$raw"
    for package in "${SC_EXTRA_PACKAGES[@]}"; do
      [[ "$package" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || sc_die "invalid Nix package attribute: $package"
    done
  fi
  local -a nix_env=(HOME="$SC_GLOBAL/nix-home" XDG_CACHE_HOME="$SC_GLOBAL/cache"
    NIXPKGS_ALLOW_UNFREE=1 PYTHONSAFEPATH=1)
  local -a nix_cmd=(env -i "${nix_env[@]}" PATH="$PATH" "$nix"
    --extra-experimental-features 'nix-command flakes')
  local -a packages=() installables=()
  local wayland_protocols_dir='' atspi_prefix='' gi_prefix='' glib_prefix='' gtk_prefix=''
  local wayland_dev='' xkbcommon_dev='' pinned_gi_typelib_path='' pinned_pkg_config_path=''
  if sc_uses_maintenance_runtime; then
    packages=(bash coreutils findutils gawk gnugrep gnused jq procps util-linux)
    if [[ "$SC_COMMAND" == gemini ]]; then
      # Gemini maintenance also performs reviewed HTTPS probes and compares the
      # emitted adapter with its digest-addressed store. Python remains an
      # explicit Nix installable, never a host prerequisite.
      packages+=(cacert curl diffutils)
    fi
    installables=("$SC_NIXPKGS#python312")
  else
    packages=(bash bubblewrap cacert cargo cmake codex coreutils curl diffutils fd file findutils
      gawk gcc git glibc.bin gnumake gnugrep gnused gnutar gzip jq landrun less ninja nix
      nodejs_22 openssh patch pkg-config procps ripgrep rsync shellcheck socat squid
      systemdMinimal tree unzip util-linux which xdg-utils xz yq-go zip zstd go rustc)
    (( ! SC_BROWSER )) || packages+=(playwright-mcp)
    (( ! SC_BROWSER && ! SC_DESKTOP )) || packages+=(xorg-server xauth)
    (( ! SC_BROWSER && ! SC_HEADFUL )) || packages+=(xdotool)
    (( ! SC_DESKTOP )) || packages+=(at-spi2-core dbus foot glib gobject-introspection grim gtk3 openbox wayland wayland-scanner wayland-protocols wayland-utils wl-clipboard libxkbcommon xauth xdg-dbus-proxy xterm xwayland-satellite)
    if [[ "$SC_JAIL_STORAGE_BUDGET_MIB" != null || "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null ]]; then
      packages+=(e2fsprogs fuse2fs)
    fi
    packages+=("${SC_EXTRA_PACKAGES[@]}")
    local system python_expr python_installable
    case "$(uname -m)" in
      x86_64) system=x86_64-linux ;;
      aarch64) system=aarch64-linux ;;
      *) sc_die "unsupported architecture: $(uname -m)" ;;
    esac
    printf -v python_expr '%s' "
      (import (builtins.getFlake \"$SC_NIXPKGS\").outPath { system = \"$system\"; }).python312.withPackages (ps: with ps; [
        pip pytest jsonschema pillow pygobject3 python-xlib setuptools wheel
      ])"
    if ! python_installable=$("${nix_cmd[@]}" build --no-link --print-out-paths --expr "$python_expr"); then
      sc_die "Nix could not build the pinned Python $SC_PYTHON_VERSION environment"
    fi
    [[ "$python_installable" == /nix/store/*-python3-"$SC_PYTHON_VERSION"-env && \
      -x "$python_installable/bin/python3" && -x "$python_installable/bin/pytest" ]] || \
      sc_die "Nix returned an invalid Python environment: $python_installable"
    installables+=("$python_installable")

    if (( SC_DESKTOP )); then
      atspi_prefix="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#at-spi2-core.out")" || \
        sc_die "Nix could not build pinned at-spi2-core"
      gi_prefix="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#gobject-introspection.out")" || \
        sc_die "Nix could not build pinned gobject-introspection"
      glib_prefix="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#glib.out")" || \
        sc_die "Nix could not build pinned glib"
      gtk_prefix="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#gtk3.out")" || \
        sc_die "Nix could not build pinned GTK 3"
      [[ "$atspi_prefix" == /nix/store/*-at-spi2-core-* && \
        -x "$atspi_prefix/libexec/at-spi-bus-launcher" && \
        -f "$atspi_prefix/lib/girepository-1.0/Atspi-2.0.typelib" && \
        "$gi_prefix" == /nix/store/*-gobject-introspection-* && \
        -d "$gi_prefix/lib/girepository-1.0" && "$glib_prefix" == /nix/store/*-glib-* && \
        "$gtk_prefix" == /nix/store/*-gtk+3-* && \
        -f "$glib_prefix/lib/girepository-1.0/GLib-2.0.typelib" ]] || \
        sc_die "Nix returned invalid pinned desktop introspection outputs"
      local closure_path typelib_dir
      local -a pinned_gi_paths=()
      while IFS= read -r closure_path; do
        [[ "$closure_path" == /nix/store/* && -d "$closure_path" ]] || continue
        while IFS= read -r typelib_dir; do pinned_gi_paths+=("$typelib_dir"); done < <(
          find "$closure_path" -type d -path '*/girepository-1.0' -print 2>/dev/null
        )
      done < <("${nix_cmd[@]}" path-info -r \
        "$atspi_prefix" "$gi_prefix" "$glib_prefix" "$gtk_prefix")
      (( ${#pinned_gi_paths[@]} )) || sc_die "pinned desktop closure has no introspection typelibs"
      pinned_gi_typelib_path="$(IFS=:; printf '%s' "${pinned_gi_paths[*]}")"
    fi

    if (( SC_DESKTOP )) && [[ "$SC_DESKTOP_BACKEND" == wayland ]]; then
      local sway_patch sway_patch_store sway_expr sway_installable sway_actual_sha256
      wayland_protocols_dir="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#wayland-protocols")" || \
        sc_die "Nix could not build pinned wayland-protocols"
      [[ "$wayland_protocols_dir" == /nix/store/*-wayland-protocols-* && \
        -f "$wayland_protocols_dir/share/wayland-protocols/staging/security-context/security-context-v1.xml" ]] || \
        sc_die "Nix returned invalid pinned wayland-protocols: $wayland_protocols_dir"
      wayland_protocols_dir+="/share/wayland-protocols"
      wayland_dev="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#wayland.dev")" || \
        sc_die "Nix could not build pinned Wayland development output"
      xkbcommon_dev="$("${nix_cmd[@]}" build --no-link --print-out-paths "$SC_NIXPKGS#libxkbcommon.dev")" || \
        sc_die "Nix could not build pinned libxkbcommon development output"
      [[ "$wayland_dev" == /nix/store/*-wayland-*-dev && \
        "$xkbcommon_dev" == /nix/store/*-libxkbcommon-*-dev && \
        "$wayland_protocols_dir" == /nix/store/*/share/wayland-protocols ]] || \
        sc_die "Nix returned invalid pinned Wayland development outputs"
      local pc_dir
      local -a pinned_pc_paths=()
      while IFS= read -r closure_path; do
        [[ "$closure_path" == /nix/store/* && -d "$closure_path" ]] || continue
        while IFS= read -r pc_dir; do pinned_pc_paths+=("$pc_dir"); done < <(
          find "$closure_path" -type d \( -path '*/lib/pkgconfig' -o -path '*/share/pkgconfig' \) -print 2>/dev/null
        )
      done < <("${nix_cmd[@]}" path-info -r \
        "$wayland_dev" "$xkbcommon_dev")
      (( ${#pinned_pc_paths[@]} )) || sc_die "pinned desktop closure has no pkg-config metadata"
      pinned_pkg_config_path="$(IFS=:; printf '%s' "${pinned_pc_paths[*]}")"
      sway_patch="$SC_GLOBAL/cache/sway-hit-test-seal-${SC_SWAY_HIT_TEST_PATCH_SHA256}.patch"
      sc_emit_sway_hit_test_patch | sc_atomic "$sway_patch" 600
      sway_actual_sha256="$(sha256sum -- "$sway_patch" | awk '{print $1}')"
      [[ "$sway_actual_sha256" == "$SC_SWAY_HIT_TEST_PATCH_SHA256" ]] || \
        sc_die "embedded private Sway HitTestSeal patch digest mismatch"
      sway_patch_store="$("${nix_cmd[@]}" store add-file "$sway_patch")" || \
        sc_die "Nix could not import the private Sway HitTestSeal patch"
      [[ "$sway_patch_store" == /nix/store/*-sway-hit-test-seal-*.patch && \
        -f "$sway_patch_store" ]] || \
        sc_die "Nix returned an invalid private Sway patch store path: $sway_patch_store"
      printf -v sway_expr '%s' "
        let
          pkgs = import (builtins.getFlake \"$SC_NIXPKGS\").outPath { system = \"$system\"; };
          sandcodexSwayUnwrapped = pkgs.sway-unwrapped.overrideAttrs (old: {
            patches = (old.patches or []) ++ [ $sway_patch_store ];
          });
          sandcodexSway = pkgs.sway.override { sway-unwrapped = sandcodexSwayUnwrapped; };
        in pkgs.symlinkJoin {
          name = \"sandcodex-sway-$SC_SWAY_VERSION-${SC_SWAY_HIT_TEST_PATCH_SHA256:0:12}\";
          paths = [ sandcodexSway ];
          postBuild = ''
            mkdir -p \$out/share/sandcodex
            printf '%s\n' '{\"schema\":\"sandcodex.sway-hit-test-build.v1\",\"sway_version\":\"1.12\",\"patch_sha256\":\"b1d362958d3d6f4ca64d82f00931b415bfc2147d8701a8da6bc04071ab8c3d05\",\"ipc_type\":102,\"nixpkgs_rev\":\"8eb9f99282ae9b85dcc5912cd3bb50035b7f4289\"}' > \$out/share/sandcodex/sway-hit-test-build.json
            chmod 0444 \$out/share/sandcodex/sway-hit-test-build.json
          '';
        }
      "
      sway_installable="$("${nix_cmd[@]}" build --impure --no-link --print-out-paths --expr "$sway_expr")" || \
        sc_die "Nix could not build patched private Sway $SC_SWAY_VERSION"
      [[ "$sway_installable" == /nix/store/*-sandcodex-sway-"$SC_SWAY_VERSION"-* && \
        -x "$sway_installable/bin/sway" && -x "$sway_installable/bin/swaymsg" ]] || \
        sc_die "Nix returned an invalid patched private Sway: $sway_installable"
      sc_verify_sway_hit_test_build "$sway_installable"
      [[ "$("$sway_installable/bin/sway" --version)" == "sway version $SC_SWAY_VERSION" ]] || \
        sc_die "patched private Sway version attestation failed"
      installables+=("$sway_installable")
    fi
  fi
  for package in "${packages[@]}"; do installables+=("$SC_NIXPKGS#$package"); done
  if [[ "$SC_COMMAND" == state ]]; then
    sc_note "entering pinned Nix state environment · Python $SC_PYTHON_VERSION"
  elif [[ "$SC_COMMAND" == gemini ]]; then
    sc_note "entering pinned Gemini maintenance environment · Python $SC_PYTHON_VERSION"
  else
    sc_note "entering pinned Nix environment · Codex $SC_CODEX_VERSION"
  fi
  local -a reexec_env=(
    SANDCODEX_NIX_READY=1
    "SANDCODEX_REAL_HOME=$SC_REAL_HOME"
    "SANDCODEX_HOST_PATH=$SC_HOST_PATH"
    "SANDCODEX_TEST_REAL_DESKTOP=${SANDCODEX_TEST_REAL_DESKTOP:-0}"
    "SANDCODEX_GLOBAL_ROOT=$SC_GLOBAL"
    "HOME=$SC_GLOBAL/nix-home"
    "XDG_CACHE_HOME=$SC_GLOBAL/cache"
    PYTHONSAFEPATH=1
    "SANDCODEX_PINNED_WAYLAND_PROTOCOLS_DIR=$wayland_protocols_dir"
    "SANDCODEX_PINNED_ATSPI_PREFIX=$atspi_prefix"
    "SANDCODEX_PINNED_GI_PREFIX=$gi_prefix"
    "SANDCODEX_PINNED_GLIB_PREFIX=$glib_prefix"
    "SANDCODEX_PINNED_GI_TYPELIB_PATH=$pinned_gi_typelib_path"
    "PKG_CONFIG_PATH=$pinned_pkg_config_path"
  )
  if [[ -n "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" ]]; then
    reexec_env+=(
      "SANDCODEX_REMOTE_BOOTSTRAP_TOKEN_FILE=$SC_REMOTE_BOOTSTRAP_TOKEN_FILE"
      "SANDCODEX_REMOTE_BOOTSTRAP_ENV_KEY=$SC_REMOTE_BOOTSTRAP_ENV_KEY"
    )
  fi
  case "$SC_PROVIDER_MODE:${SANDCODEX_INTERNAL_FOREGROUND_TASK:-}" in
    remote:remote-auto-task|gemini:gemini-auto-task)
      reexec_env+=("SANDCODEX_INTERNAL_FOREGROUND_TASK=$SANDCODEX_INTERNAL_FOREGROUND_TASK")
      ;;
  esac
  local -a reexec_cmd=(env "${reexec_env[@]}" "$nix"
    --extra-experimental-features 'nix-command flakes' shell
    "${installables[@]}" --command bash "$SC_SCRIPT" "$@")
  if [[ -n "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" ]]; then
    local rc=0
    "${reexec_cmd[@]}" || rc=$?
    rm -f -- "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" 2>/dev/null || true
    exit "$rc"
  fi
  exec "${reexec_cmd[@]}"
}

sc_runtime_tools() {
  local tool
  if sc_uses_maintenance_runtime; then
    local runtime_label=state
    local -a maintenance_tools=(awk bash find flock jq ps python3 readlink realpath sed setpriv sha256sum stat)
    if [[ "$SC_COMMAND" == gemini ]]; then
      runtime_label='Gemini maintenance'
      maintenance_tools+=(cmp curl od timeout)
    fi
    for tool in "${maintenance_tools[@]}"; do
      command -v "$tool" >/dev/null 2>&1 || sc_die "pinned $runtime_label runtime is missing $tool"
    done
    if [[ "$SC_COMMAND" == gemini ]]; then
      [[ "$(python3 --version 2>&1)" == "Python $SC_PYTHON_VERSION" ]] ||
        sc_die "pinned Gemini maintenance runtime has an unexpected Python version"
    fi
    SC_FLOCK="$(command -v flock)"; SC_SETPRIV="$(command -v setpriv)"
    local entry
    local -A maintenance_seen=()
    local -a maintenance_paths=() maintenance_entries=()
    IFS=: read -r -a maintenance_entries <<<"$PATH"
    for entry in "${maintenance_entries[@]}"; do
      [[ "$entry" == /nix/store/*/bin || "$entry" == /nix/store/*/sbin ]] || continue
      [[ -z "${maintenance_seen[$entry]:-}" ]] || continue
      maintenance_seen[$entry]=1; maintenance_paths+=("$entry")
    done
    if [[ "${SANDCODEX_TESTING:-0}" == 1 && ${#maintenance_paths[@]} -eq 0 ]]; then
      maintenance_paths=(/usr/bin /bin)
    fi
    (( ${#maintenance_paths[@]} )) || sc_die "could not derive a Nix-store-only $runtime_label PATH"
    SC_PATH="$(IFS=:; printf '%s' "${maintenance_paths[*]}")"
    return 0
  fi
  local -a required_tools=(
    awk bash bwrap cmake codex curl df du fd file find findmnt flock gcc git jq landrun make
    ninja nix nix-store node npm numfmt pip pkg-config pytest readlink realpath rg rsync sed setpriv setsid
    sha256sum shellcheck socat squid stat tee timeout tree unzip yq zip zstd
  )
  if [[ "${SANDCODEX_TESTING:-0}" != 1 || "${SANDCODEX_NO_NIX:-0}" != 1 ]]; then
    required_tools+=(go cargo rustc)
  fi
  if [[ "$SC_JAIL_STORAGE_BUDGET_MIB" != null || "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null ]]; then
    required_tools+=(fuse2fs mkfs.ext4 mountpoint truncate)
  fi
  for tool in "${required_tools[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || sc_die "pinned runtime is missing $tool"
  done
  if (( SC_BROWSER )); then
    command -v playwright-mcp >/dev/null 2>&1 || sc_die "pinned browser runtime is missing playwright-mcp"
    for tool in Xephyr Xvfb xauth mcookie; do
      command -v "$tool" >/dev/null 2>&1 || sc_die "pinned browser X11 runtime is missing $tool"
    done
  elif (( SC_DESKTOP )) && [[ "$SC_DESKTOP_BACKEND" == x11 ]]; then
    for tool in Xvfb xauth mcookie; do
      command -v "$tool" >/dev/null 2>&1 || sc_die "pinned desktop X11 runtime is missing $tool"
    done
  fi
  if (( SC_DESKTOP )); then
    for tool in dbus-daemon dbus-send xdg-dbus-proxy; do
      command -v "$tool" >/dev/null 2>&1 || sc_die "pinned desktop runtime is missing $tool"
    done
    if [[ "$SC_DESKTOP_BACKEND" == wayland ]]; then
      for tool in sway swaymsg grim wl-copy wl-paste wayland-info wayland-scanner foot xauth mcookie xwayland-satellite; do
        command -v "$tool" >/dev/null 2>&1 || sc_die "pinned Wayland desktop runtime is missing $tool"
      done
      [[ "$(sway --version)" == "sway version $SC_SWAY_VERSION" ]] ||
        sc_die "private Wayland compositor version mismatch: expected Sway $SC_SWAY_VERSION"
      if [[ "${SANDCODEX_TESTING:-0}" != 1 || "${SANDCODEX_NO_NIX:-0}" != 1 ]]; then
        local sway_runtime_path
        sway_runtime_path="$(command -v sway)"
        [[ "$sway_runtime_path" == /nix/store/*/bin/sway ]] ||
          sc_die "private Sway runtime path is outside the pinned Nix store"
        sc_verify_sway_hit_test_build "${sway_runtime_path%/bin/sway}"
      fi
    else
      for tool in openbox xterm; do
        command -v "$tool" >/dev/null 2>&1 || sc_die "pinned X11 desktop runtime is missing $tool"
      done
    fi
  fi
  SC_CODEX="$(command -v codex)"; SC_BWRAP="$(command -v bwrap)"
  SC_LANDRUN="$(command -v landrun)"
  SC_SQUID="$(command -v squid)"; SC_SOCAT="$(command -v socat)"
  SC_FLOCK="$(command -v flock)"
  SC_SYSTEMD_RUN="$(command -v systemd-run 2>/dev/null || true)"
  SC_SYSTEMCTL="$(command -v systemctl 2>/dev/null || true)"
  SC_SETPRIV="$(command -v setpriv)"
  if (( SC_BROWSER )); then
    SC_PLAYWRIGHT="$(command -v playwright-mcp)"
  fi
  if (( SC_BROWSER )); then
    SC_XEPHYR="$(command -v Xephyr)"; SC_XVFB="$(command -v Xvfb)"
    SC_XAUTH="$(command -v xauth)"; SC_MCOOKIE="$(command -v mcookie)"
    SC_XDOTOOL="$(command -v xdotool)"
  elif (( SC_DESKTOP )); then
    if (( SC_HEADFUL )); then
      SC_XEPHYR="$(command -v Xephyr)"; SC_XDOTOOL="$(command -v xdotool)"
    elif [[ "$SC_DESKTOP_BACKEND" == x11 ]]; then
      SC_XVFB="$(command -v Xvfb)"
    fi
    SC_XAUTH="$(command -v xauth)"; SC_MCOOKIE="$(command -v mcookie)"
  fi
  if (( SC_DESKTOP )); then
    SC_DBUS_DAEMON="$(command -v dbus-daemon)"
    SC_DBUS_SEND="$(command -v dbus-send)"
    SC_XDG_DBUS_PROXY="$(command -v xdg-dbus-proxy)"
    [[ "$("$SC_XDG_DBUS_PROXY" --version 2>/dev/null | head -n1)" == "xdg-dbus-proxy $SC_XDG_DBUS_PROXY_VERSION" ]] || \
      sc_die "pinned desktop runtime has an unexpected xdg-dbus-proxy version"
    if [[ "$SC_DESKTOP_BACKEND" == wayland ]]; then
      SC_SWAY="$(command -v sway)"; SC_SWAYMSG="$(command -v swaymsg)"
      SC_GRIM="$(command -v grim)"
      SC_WL_COPY="$(command -v wl-copy)"; SC_WL_PASTE="$(command -v wl-paste)"
      SC_WAYLAND_INFO="$(command -v wayland-info)"; SC_WAYLAND_SCANNER="$(command -v wayland-scanner)"
      SC_FOOT="$(command -v foot)"; SC_XWAYLAND_SATELLITE="$(command -v xwayland-satellite)"
      [[ "$("$SC_XWAYLAND_SATELLITE" -version 2>/dev/null | head -n1)" == "$SC_XWAYLAND_SATELLITE_REPORTED_VERSION" ]] || \
        sc_die "pinned desktop runtime has an unexpected xwayland-satellite version"
      if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
        SC_WAYLAND_PROTOCOLS_DIR="${SANDCODEX_TEST_WAYLAND_PROTOCOLS_DIR:-/tmp}"
      else
        SC_WAYLAND_PROTOCOLS_DIR="${SANDCODEX_PINNED_WAYLAND_PROTOCOLS_DIR:-}"
        [[ "$SC_WAYLAND_PROTOCOLS_DIR" == /nix/store/* && -f "$SC_WAYLAND_PROTOCOLS_DIR/staging/security-context/security-context-v1.xml" ]] ||           sc_die "pinned desktop runtime is missing security-context-v1.xml"
      fi
    else
      SC_OPENBOX="$(command -v openbox)"
      SC_XTERM="$(command -v xterm)"
    fi
    if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
      SC_ATSPI_LAUNCHER="${SANDCODEX_TEST_ATSPI_LAUNCHER:-$(command -v true)}"
      SC_ATSPI_TYPELIB_DIR="${SANDCODEX_TEST_ATSPI_TYPELIB_DIR:-/tmp}"
      SC_GI_TYPELIB_PATH="${SANDCODEX_TEST_GI_TYPELIB_PATH:-$SC_ATSPI_TYPELIB_DIR}"
    else
      local atspi_prefix atspi_typelib gi_prefix gi_typelib_dir glib_libdir gi_entry typelib namespace
      atspi_prefix="${SANDCODEX_PINNED_ATSPI_PREFIX:-}"
      [[ "$atspi_prefix" == /nix/store/* && -x "$atspi_prefix/libexec/at-spi-bus-launcher" ]] || \
        sc_die "pinned desktop runtime is missing the AT-SPI bus launcher"
      SC_ATSPI_LAUNCHER="$atspi_prefix/libexec/at-spi-bus-launcher"
      atspi_typelib="$(find "$atspi_prefix/lib" -type f -path '*/girepository-1.0/Atspi-2.0.typelib' -print -quit 2>/dev/null || true)"
      [[ "$atspi_typelib" == "$atspi_prefix"/* && -f "$atspi_typelib" ]] || \
        sc_die "pinned desktop runtime is missing the AT-SPI typelib"
      SC_ATSPI_TYPELIB_DIR="${atspi_typelib%/*}"
      gi_prefix="${SANDCODEX_PINNED_GI_PREFIX:-}"
      gi_typelib_dir="$gi_prefix/lib/girepository-1.0"
      glib_libdir="${SANDCODEX_PINNED_GLIB_PREFIX:-}/lib"
      [[ "$gi_prefix" == /nix/store/* && -d "$gi_prefix" && \
        "$gi_typelib_dir" == /nix/store/* && -d "$gi_typelib_dir" && \
        "$glib_libdir" == /nix/store/* && -d "$glib_libdir" ]] || \
        sc_die "pinned desktop runtime is missing a base GObject introspection path"
      local -A gi_seen=()
      local -a gi_paths=()
      for gi_entry in "$SC_ATSPI_TYPELIB_DIR" "$gi_typelib_dir"; do
        [[ -n "${gi_seen[$gi_entry]:-}" ]] || { gi_seen[$gi_entry]=1; gi_paths+=("$gi_entry"); }
      done
      for namespace in GLib-2.0 GObject-2.0 Gio-2.0; do
        typelib="$(find "$glib_libdir" "$gi_prefix" -type f \
          -path "*/girepository-1.0/$namespace.typelib" -print -quit 2>/dev/null || true)"
        [[ "$typelib" == /nix/store/* && -f "$typelib" ]] || \
          sc_die "pinned desktop runtime is missing the $namespace introspection typelib"
        gi_entry="${typelib%/*}"
        [[ -n "${gi_seen[$gi_entry]:-}" ]] || { gi_seen[$gi_entry]=1; gi_paths+=("$gi_entry"); }
      done
      local -a inherited_gi=()
      IFS=: read -r -a inherited_gi <<<"${SANDCODEX_PINNED_GI_TYPELIB_PATH:-}"
      for gi_entry in "${inherited_gi[@]}"; do
        [[ "$gi_entry" == /nix/store/* && -d "$gi_entry" ]] || continue
        [[ -n "${gi_seen[$gi_entry]:-}" ]] || { gi_seen[$gi_entry]=1; gi_paths+=("$gi_entry"); }
      done
      SC_GI_TYPELIB_PATH="$(IFS=:; printf '%s' "${gi_paths[*]}")"
    fi
  fi
  if [[ "${SANDCODEX_TESTING:-0}" == 1 ]]; then
    [[ -z "${SANDCODEX_TEST_CODEX_BIN:-}" ]] || SC_CODEX="$SANDCODEX_TEST_CODEX_BIN"
    [[ -z "${SANDCODEX_TEST_BWRAP_BIN:-}" ]] || SC_BWRAP="$SANDCODEX_TEST_BWRAP_BIN"
    [[ -z "${SANDCODEX_TEST_SYSTEMD_RUN_BIN:-}" ]] || SC_SYSTEMD_RUN="$SANDCODEX_TEST_SYSTEMD_RUN_BIN"
    [[ -z "${SANDCODEX_TEST_SYSTEMCTL_BIN:-}" ]] || SC_SYSTEMCTL="$SANDCODEX_TEST_SYSTEMCTL_BIN"
  else
    local cv bv lv tv sv nv pv wv
    cv="$(sc_run_clean_fds "$SC_CODEX" --version 2>/dev/null | awk '{print $NF}')"
    bv="$("$SC_BWRAP" --version 2>/dev/null | awk '{print $NF}')"
    lv="$("$SC_LANDRUN" --version 2>/dev/null | awk '{print $NF}')"
    tv="$("$SC_SQUID" -v 2>/dev/null | sed -n 's/^Squid Cache: Version //p' | head -n 1)"
    sv="$("$SC_SOCAT" -V 2>&1 | sed -n 's/^socat version \([^ ]*\).*/\1/p' | head -n 1)"
    nv="$(node --version 2>/dev/null)"
    pv="$(python3 --version 2>&1 | awk '{print $2}')"
    if (( SC_BROWSER )); then wv="$("$SC_PLAYWRIGHT" --version 2>/dev/null | awk '{print $NF}')"; fi
    [[ "$cv" == "$SC_CODEX_VERSION" ]] || sc_die "Codex mismatch: expected $SC_CODEX_VERSION, got ${cv:-unknown}"
    [[ "$bv" == "$SC_BWRAP_VERSION" ]] || sc_die "bubblewrap mismatch: expected $SC_BWRAP_VERSION, got ${bv:-unknown}"
    [[ "$lv" == "$SC_LANDRUN_VERSION" ]] || sc_die "landrun mismatch: expected $SC_LANDRUN_VERSION, got ${lv:-unknown}"
    [[ "$tv" == "$SC_SQUID_VERSION" ]] || sc_die "Squid mismatch: expected $SC_SQUID_VERSION, got ${tv:-unknown}"
    [[ "$sv" == "$SC_SOCAT_VERSION" ]] || sc_die "socat mismatch: expected $SC_SOCAT_VERSION, got ${sv:-unknown}"
    [[ "$nv" == "v$SC_NODE_VERSION" ]] || sc_die "Node mismatch: expected $SC_NODE_VERSION, got ${nv:-unknown}"
    [[ "$pv" == "$SC_PYTHON_VERSION" ]] || sc_die "Python mismatch: expected $SC_PYTHON_VERSION, got ${pv:-unknown}"
    (( ! SC_BROWSER )) || [[ "$wv" == "$SC_PLAYWRIGHT_MCP_VERSION" ]] || \
      sc_die "Playwright MCP mismatch: expected $SC_PLAYWRIGHT_MCP_VERSION, got ${wv:-unknown}"
    python3 -P -c 'import jsonschema, pytest' || sc_die "pinned Python is missing pytest or jsonschema"
    (( ! SC_DESKTOP )) || python3 -P -c 'from PIL import ImageGrab; from Xlib.ext import xtest' || \
      sc_die "pinned Python is missing Pillow or python-xlib"
    (( ! SC_DESKTOP )) || GI_TYPELIB_PATH="$SC_GI_TYPELIB_PATH" python3 -P -c \
      'import gi; gi.require_version("Atspi", "2.0"); gi.require_version("Gtk", "3.0"); from gi.repository import Atspi, Gtk; assert Atspi.get_version(); assert Gtk.MAJOR_VERSION == 3' || \
      sc_die "pinned Python is missing the AT-SPI or GTK 3 introspection binding"
  fi
  [[ ! -x /run/wrappers/bin/sudo ]] || SC_SUDO=/run/wrappers/bin/sudo
  [[ -n "$SC_SUDO" ]] || SC_SUDO="$(command -v sudo 2>/dev/null || true)"
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && -n "${SANDCODEX_TEST_SUDO_BIN:-}" ]]; then SC_SUDO="$SANDCODEX_TEST_SUDO_BIN"; fi
  local entry resolved
  local -A seen=()
  local -a paths=() entries=()
  IFS=: read -r -a entries <<<"$PATH"
  for entry in "${entries[@]}"; do
    [[ "$entry" == /nix/store/*/bin || "$entry" == /nix/store/*/sbin ]] || continue
    [[ -z "${seen[$entry]:-}" ]] || continue
    seen[$entry]=1; paths+=("$entry")
  done
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && ${#paths[@]} -eq 0 ]]; then
    # Deterministic fixtures may provide validated tools from several
    # non-Nix directories. Preserve the exact directories that satisfied the
    # runtime check so detached loops and campaign workers receive the same
    # executable closure after their environment is scrubbed.
    local -a fixture_tools=("${required_tools[@]}")
    (( ! SC_BROWSER )) || fixture_tools+=(playwright-mcp Xephyr Xvfb xauth mcookie)
    if (( SC_DESKTOP )); then
      fixture_tools+=(dbus-daemon dbus-send)
      if [[ "$SC_DESKTOP_BACKEND" == wayland ]]; then
        fixture_tools+=(sway swaymsg grim wl-copy wl-paste wayland-info wayland-scanner foot xauth mcookie xwayland-satellite)
      else
        fixture_tools+=(Xvfb xauth mcookie openbox xterm)
        (( ! SC_HEADFUL )) || fixture_tools+=(Xephyr xdotool)
      fi
    fi
    for tool in "${fixture_tools[@]}"; do
      resolved="$(command -v "$tool" 2>/dev/null || true)"
      [[ -n "$resolved" ]] || continue
      entry="$(dirname -- "$resolved")"
      [[ -z "${seen[$entry]:-}" ]] || continue
      seen[$entry]=1; paths+=("$entry")
    done
  fi
  (( ${#paths[@]} )) || sc_die "could not derive a Nix-store-only PATH"
  SC_PATH="$(IFS=:; printf '%s' "${paths[*]}")"
  if [[ -n "$SC_SUDO" ]]; then
    SC_BARE_PATH="$(dirname -- "$SC_SUDO"):$SC_PATH:$SC_HOST_PATH"
  else
    SC_BARE_PATH="$SC_PATH:$SC_HOST_PATH"
  fi
}

sc_verify_nix_daemon_boundary() {
  SC_NIX_DAEMON_SAFE=0
  SC_NIX_DAEMON_DETAIL="Nix daemon boundary check failed"
  local nix info config
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
    SC_NIX_DAEMON_DETAIL="withheld by no-Nix test fixture"
    return 0
  fi
  if [[ "$SC_NIX_DAEMON_MODE" == deny ]]; then
    SC_NIX_DAEMON_DETAIL="withheld by --no-nix-daemon"
    return 0
  fi
  if [[ "$SC_NIX_DAEMON_MODE" == auto && "$SC_DEV_NET" == 0 ]]; then
    SC_NIX_DAEMON_DETAIL="withheld by --restricted-network; use --nix-daemon to expose the host-daemon broker"
    return 0
  fi
  nix="$(command -v nix)"
  if [[ ! -S /nix/var/nix/daemon-socket/socket ]]; then
    SC_NIX_DAEMON_DETAIL="Nix daemon socket is unavailable"
    return 1
  fi
  info="$(env -i PATH="$SC_PATH" HOME="$SC_GLOBAL/nix-home" XDG_CACHE_HOME="$SC_GLOBAL/cache" \
    NIX_USER_CONF_FILES=/dev/null "$nix" --extra-experimental-features 'nix-command flakes' \
    store info --store daemon --json 2>/dev/null)" || {
      SC_NIX_DAEMON_DETAIL="Nix daemon trust status is unavailable"
      return 1
    }
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_TEST_NIX_DAEMON_TRUSTED:-0}" == 1 ]]; then
    info="$(jq -c '.trusted = true' <<<"$info")"
  fi
  if ! jq -e '.trusted == false and (.url | type == "string")' <<<"$info" >/dev/null; then
    SC_NIX_DAEMON_DETAIL="Nix daemon considers this client trusted and therefore root-equivalent"
    return 1
  fi
  config="$(env -i PATH="$SC_PATH" HOME="$SC_GLOBAL/nix-home" XDG_CACHE_HOME="$SC_GLOBAL/cache" \
    NIX_USER_CONF_FILES=/dev/null "$nix" --extra-experimental-features 'nix-command flakes' \
    config show --json 2>/dev/null)" || {
      SC_NIX_DAEMON_DETAIL="host Nix sandbox policy is unavailable"
      return 1
    }
  if ! jq -e '
    .sandbox.value == true and
    ."sandbox-fallback".value == false and
    (((."extra-sandbox-paths".value // {}) | length) == 0) and
    (((."sandbox-paths".value // {}) | to_entries) |
      all(.value.source | type == "string" and startswith("/nix/store/"))) and
    ((.builders.value == "") or (.builders.value == [])) and
    ((."external-builders".value // []) == []) and
    ((."pre-build-hook".value // "") == "") and
    ((."post-build-hook".value // "") == "") and
    ((."diff-hook".value // "") == "") and
    ((."run-diff-hook".value // false) == false) and
    (."build-hook".value as $hook |
      ($hook | type) == "array" and ($hook | length) == 2 and
      ($hook[0] | type) == "string" and ($hook[0] | startswith("/nix/store/")) and
      $hook[1] == "__build-remote")
  ' <<<"$config" >/dev/null; then
    SC_NIX_DAEMON_DETAIL="host Nix policy permits unsandboxed, host-mounted, remote, or hooked builds"
    return 1
  fi
  SC_NIX_DAEMON_SAFE=1
  SC_NIX_DAEMON_DETAIL="untrusted client; mandatory sandbox; store-only sandbox paths; daemon fetch/build workers bypass shell network and resource limits"
  sc_log_event info nix_daemon_boundary "Nix daemon access is non-root and sandboxed"
}

sc_resource_scope() {
  [[ "$SC_COMMAND" == doctor || "$SC_COMMAND" == clean || \
    ( "$SC_COMMAND" == run && $SC_BARE -eq 0 ) || \
    ( "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == run && $SC_BARE -eq 0 ) ]] || return 0
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_TEST_RESOURCE_SCOPE:-0}" != 1 ]]; then
    return 0
  fi
  if (( ! SC_RESOURCE_SCOPE )); then
    sc_note "resource scope disabled by explicit --no-resource-scope · no systemd cgroup memory/task/swap ceiling"
    return 0
  fi
  local active="${SANDCODEX_RESOURCE_SCOPE:-}" cgroup pids memory swap
  if [[ -n "$active" ]]; then
    cgroup="$(sed -n 's/^0:://p' /proc/self/cgroup)"
    [[ "${cgroup##*/}" == "$active" ]] || sc_die "resource-scope identity check failed"
    pids="$(<"/sys/fs/cgroup$cgroup/pids.max")"
    memory="$(<"/sys/fs/cgroup$cgroup/memory.max")"
    swap="$(<"/sys/fs/cgroup$cgroup/memory.swap.max")"
    [[ "$pids" =~ ^[0-9]+$ && "$pids" -le "$SC_TASKS_MAX" ]] || sc_die "resource-scope task limit is not enforced"
    [[ "$memory" =~ ^[0-9]+$ ]] || sc_die "resource-scope memory limit is not enforced"
    [[ "$swap" == 0 ]] || sc_die "resource-scope swap limit is not enforced"
    return 0
  fi
  [[ -n "$SC_SYSTEMD_RUN" && -x "$SC_SYSTEMD_RUN" ]] || sc_die "safe mode requires systemd-run and a user manager for resource isolation"
  local unit_base="sandcodex-$SC_PROJECT_KEY" unit="" candidate load_state state
  local scope_unit="$unit_base.scope" service_unit="$unit_base.service"
  # --collect is asynchronous: a completed unit can remain loaded briefly
  # after its process exits. Check both supported unit forms so a prior launch
  # cannot bypass the same-project exclusion by changing cgroup transport.
  for candidate in "$scope_unit" "$service_unit"; do
    for _ in {1..100}; do
      load_state="$("$SC_SYSTEMCTL" --user show "$candidate" --property LoadState --value 2>/dev/null || true)"
      [[ -z "$load_state" || "$load_state" == not-found ]] && break
      state="$("$SC_SYSTEMCTL" --user show "$candidate" --property ActiveState --value 2>/dev/null || true)"
      case "$state" in
        failed|inactive|deactivating)
          "$SC_SYSTEMCTL" --user reset-failed "$candidate" >/dev/null 2>&1 || true
          sleep 0.05
          ;;
        *) break ;;
      esac
    done
  done

  local self_cgroup manager_cgroup transport=scope scope_preflight_rc=0 service_preflight_rc=0
  self_cgroup="$(sed -n 's/^0:://p' /proc/self/cgroup)"
  manager_cgroup="$("$SC_SYSTEMCTL" --user show --property ControlGroup --value 2>/dev/null || true)"
  # A scope adopts the caller. Linux forbids moving a process between sibling
  # cgroup subtrees, which is common for shells launched in session-*.scope or
  # by a container/VM bridge. A transient user service starts beneath the user
  # manager instead and provides the same externally owned cgroup ceiling.
  if [[ -n "$manager_cgroup" && "$self_cgroup" != "$manager_cgroup" && \
    "$self_cgroup" != "$manager_cgroup"/* ]]; then
    transport=service
  fi
  if [[ "$transport" == scope ]]; then
    local scope_preflight_unit="sandcodex-preflight-$$-$RANDOM.scope"
    "$SC_SYSTEMD_RUN" --user --scope --quiet --collect --unit "$scope_preflight_unit" \
      -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 -p "TasksMax=$SC_TASKS_MAX" -p OOMPolicy=kill \
      env -i PATH="$PATH" true || scope_preflight_rc=$?
    if (( scope_preflight_rc != 0 )); then
      "$SC_SYSTEMCTL" --user reset-failed "$scope_preflight_unit" >/dev/null 2>&1 || true
      transport=service
    fi
  fi
  if [[ "$transport" == service ]]; then
    local service_preflight_unit="sandcodex-preflight-$$-$RANDOM.service"
    "$SC_SYSTEMD_RUN" --user --quiet --wait --collect --pipe --unit "$service_preflight_unit" \
      -p Type=exec -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 \
      -p "TasksMax=$SC_TASKS_MAX" -p OOMPolicy=kill -p KillMode=control-group \
      env -i PATH="$PATH" true || service_preflight_rc=$?
    if (( service_preflight_rc != 0 )); then
      sc_die "safe mode could not create a systemd user resource scope or service (scope exit $scope_preflight_rc; service exit $service_preflight_rc); fix the user manager/cgroup delegation, or use explicit --no-resource-scope for the documented narrow degradation. Details: journalctl --user -n 40 --no-pager" 70
    fi
    unit="$service_unit"
  else
    unit="$scope_unit"
  fi
  sc_note "resource cgroup · systemd user $transport · memory $SC_MEMORY_MAX · tasks $SC_TASKS_MAX · swap disabled"
  local -a scoped_env=(
    "SANDCODEX_RESOURCE_SCOPE=$unit"
    "SANDCODEX_NIX_READY=${SANDCODEX_NIX_READY:-0}"
    "SANDCODEX_REAL_HOME=$SC_REAL_HOME"
    "SANDCODEX_HOST_PATH=$SC_HOST_PATH"
    "SANDCODEX_TEST_REAL_DESKTOP=${SANDCODEX_TEST_REAL_DESKTOP:-0}"
    "SANDCODEX_GLOBAL_ROOT=$SC_GLOBAL"
    "HOME=$HOME"
    "XDG_CACHE_HOME=${XDG_CACHE_HOME:-}"
    "PYTHONSAFEPATH=${PYTHONSAFEPATH:-1}"
    "SANDCODEX_PINNED_WAYLAND_PROTOCOLS_DIR=${SANDCODEX_PINNED_WAYLAND_PROTOCOLS_DIR:-}"
    "SANDCODEX_PINNED_ATSPI_PREFIX=${SANDCODEX_PINNED_ATSPI_PREFIX:-}"
    "SANDCODEX_PINNED_GI_PREFIX=${SANDCODEX_PINNED_GI_PREFIX:-}"
    "SANDCODEX_PINNED_GLIB_PREFIX=${SANDCODEX_PINNED_GLIB_PREFIX:-}"
    "SANDCODEX_PINNED_GI_TYPELIB_PATH=${SANDCODEX_PINNED_GI_TYPELIB_PATH:-}"
    "PKG_CONFIG_PATH=${PKG_CONFIG_PATH:-}"
    "PATH=$PATH"
  )
  if [[ -n "${SC_REMOTE_BOOTSTRAP_TOKEN_FILE:-}" ]]; then
    scoped_env+=(
      "SANDCODEX_REMOTE_BOOTSTRAP_TOKEN_FILE=$SC_REMOTE_BOOTSTRAP_TOKEN_FILE"
      "SANDCODEX_REMOTE_BOOTSTRAP_ENV_KEY=$SC_REMOTE_BOOTSTRAP_ENV_KEY"
    )
  fi
  case "$SC_PROVIDER_MODE:${SANDCODEX_INTERNAL_FOREGROUND_TASK:-}" in
    remote:remote-auto-task|gemini:gemini-auto-task)
      scoped_env+=("SANDCODEX_INTERNAL_FOREGROUND_TASK=$SANDCODEX_INTERNAL_FOREGROUND_TASK")
      ;;
  esac
  if [[ "$transport" == scope ]]; then
    exec "$SC_SYSTEMD_RUN" --user --scope --quiet --collect --unit "$unit" \
      -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 -p "TasksMax=$SC_TASKS_MAX" -p OOMPolicy=kill \
      env "${scoped_env[@]}" "$SC_SCRIPT" "$@"
  fi

  # A service is born under the user manager rather than adopting this shell,
  # so it does not inherit caller-only environment entries. Preserve the exact
  # launch environment in a private, one-use runtime handoff instead of putting
  # credentials in the transient unit's argv, properties, or journal record.
  local runtime_root="/run/user/$EUID" handoff env_file enter rc=0
  [[ -d "$runtime_root" && ! -L "$runtime_root" && "$(stat -c %u -- "$runtime_root")" == "$EUID" ]] ||
    sc_die "safe-mode service fallback requires an owned user runtime directory: $runtime_root" 70
  handoff="$(mktemp -d "$runtime_root/sandcodex-resource-handoff.XXXXXX")"
  chmod 700 -- "$handoff"
  env_file="$handoff/environment"; enter="$handoff/enter"
  SC_RESOURCE_HANDOFF_ROOT="$handoff"
  SC_RESOURCE_HANDOFF_ENV="$env_file"
  SC_RESOURCE_HANDOFF_ENTER="$enter"
  env -0 "${scoped_env[@]}" >"$env_file"
  chmod 600 -- "$env_file"
  cat >"$enter" <<'RESOURCE_SERVICE_ENTER'
#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
environment=$1
root=$2
shift 2
uid=$(id -u)
[[ -d $root && ! -L $root && $(stat -c %u -- "$root") == "$uid" && $(stat -c %a -- "$root") == 700 ]]
[[ -f $environment && ! -L $environment && $(stat -c %u -- "$environment") == "$uid" && \
  $(stat -c %a -- "$environment") == 600 && $(stat -c %h -- "$environment") == 1 ]]
[[ -f $0 && ! -L $0 && $(stat -c %u -- "$0") == "$uid" && $(stat -c %h -- "$0") == 1 ]]
exec 3<"$environment"
rm -f -- "$environment" "$0"
rmdir -- "$root"
while IFS= read -r -d '' entry <&3; do
  name=${entry%%=*}
  [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  export "$entry"
done
exec 3<&-
exec "$@"
RESOURCE_SERVICE_ENTER
  chmod 500 -- "$enter"
  local -a stdio=(--pipe)
  if [[ -t 0 && -t 1 ]]; then stdio=(--pty); fi
  set +e
  "$SC_SYSTEMD_RUN" --user --quiet --wait --collect --send-sighup "${stdio[@]}" \
    --unit "$unit" --working-directory "$PWD" \
    -p Type=exec -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 \
    -p "TasksMax=$SC_TASKS_MAX" -p OOMPolicy=kill -p KillMode=control-group \
    env -i PATH="$PATH" HOME="$HOME" "$enter" "$env_file" "$handoff" "$SC_SCRIPT" "$@"
  rc=$?
  set -e
  sc_cleanup_resource_handoff
  exit "$rc"
}

sc_manual() {
  awk '
    /^# SANDCODEX_MANUAL_BEGIN$/ { inside=1; next }
    /^# SANDCODEX_MANUAL_END$/   { found_end=1; exit }
    inside {
      line=$0
      sub(/^# ?/, "", line)
      print line
    }
    END {
      if (!inside || !found_end) exit 1
    }
  ' "$SC_SCRIPT" || sc_die "embedded handbook markers are missing or malformed"
}

