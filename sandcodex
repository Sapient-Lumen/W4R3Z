  IFS= read -r raw <"/proc/$1/stat" 2>/dev/null || return 1
  rest=${raw##*) }
  set -- $rest
  (( $# >= 20 )) || return 1
  printf '%s' "${20}"
}
stop_exact() {
  local pid=${1:-} start=${2:-} attempt current
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$start" =~ ^[0-9]+$ ]] || return 0
  current="$(proc_start "$pid" 2>/dev/null || true)"
  [[ "$current" == "$start" ]] || return 0
  kill -TERM "$pid" 2>/dev/null || true
  for attempt in {1..80}; do
    current="$(proc_start "$pid" 2>/dev/null || true)"
    [[ "$current" == "$start" ]] || break
    sleep 0.025
