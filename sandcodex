def _spawn_open_file_handler(
    policy: OpenFilePolicy,
    descriptor: int,
    access: str,
    transfer: str,
    *,
    file_chooser_enabled: bool,
) -> subprocess.Popen[bytes]:
    """Exec one exact handler while inheriting only the retained file FD.

    Descriptor custody and executable identity are validated by the request
    dispatcher immediately before this helper is called.  Keeping the actual
    ``Popen`` boundary here makes the inherited-FD contract independently
    executable in deterministic tests: the child receives the same descriptor
    number, one child-local ``/proc/self/fd/N`` reference, no shell, and no
    other non-standard descriptor.
    """
    if not isinstance(descriptor, int) or descriptor < 0:
        raise PortalError("OpenFile descriptor custody is unavailable")
    if access not in {"readonly", "readwrite"}:
        raise PortalError("OpenFile handler access is invalid")
    if transfer not in {"sealed-memfd-snapshot", "retained-original-fd"}:
        raise PortalError("OpenFile handler transfer is invalid")
    if (access == "readonly") != (transfer == "sealed-memfd-snapshot"):
        raise PortalError("OpenFile handler access and transfer disagree")

    environment = os.environ.copy()
    # The exact handler remains in the launch capsule. It may use the same
    # private FileChooser, but recursive OpenURI/OpenFile portal delegation is
    # disabled so one descriptor cannot become ambient application selection.
    environment["GTK_USE_PORTAL"] = "1" if file_chooser_enabled else "0"
    environment["GIO_USE_PORTALS"] = "0"
    environment["SANDCODEX_DESKTOP_OPEN_FILE_DISPATCH"] = "exact-launch-fd-handler"
    environment["SANDCODEX_DESKTOP_OPEN_FILE_ACCESS"] = access
    environment["SANDCODEX_DESKTOP_OPEN_FILE_TRANSFER"] = transfer
    environment["SANDCODEX_DESKTOP_OPEN_FILE_FD"] = str(descriptor)
    environment["SANDCODEX_DESKTOP_OPEN_FILE_PATH"] = f"/proc/self/fd/{descriptor}"
    environment["SANDCODEX_DESKTOP_OPEN_FILE_POLICY_SHA256"] = policy.digest
    return subprocess.Popen(
        policy.argv(descriptor),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=environment,
        start_new_session=True,
        close_fds=True,
        pass_fds=(descriptor,),
        shell=False,
    )


def _spawn_open_directory_handler(
    policy: OpenDirectoryPolicy,
    object_descriptor: int,
    directory_descriptor: int,
    object_kind: str,
    selected_name: str,
    *,
    file_chooser_enabled: bool,
) -> subprocess.Popen[bytes]:
    """Exec one exact private file-manager handler with dual-FD custody."""
    if (
        not isinstance(object_descriptor, int)
        or object_descriptor < 0
        or not isinstance(directory_descriptor, int)
        or directory_descriptor < 0
        or object_descriptor == directory_descriptor
    ):
        raise PortalError("OpenDirectory descriptor custody is unavailable")
    if object_kind not in {"regular", "directory"}:
        raise PortalError("OpenDirectory object kind is invalid")
    encoded_name = base64.urlsafe_b64encode(os.fsencode(selected_name)).decode("ascii").rstrip("=")
    environment = os.environ.copy()
    environment["GTK_USE_PORTAL"] = "1" if file_chooser_enabled else "0"
    environment["GIO_USE_PORTALS"] = "0"
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_DISPATCH"] = "exact-launch-dual-fd-handler"
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_OBJECT_KIND"] = object_kind
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_OBJECT_FD"] = str(object_descriptor)
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_OBJECT_PATH"] = (
        f"/proc/self/fd/{object_descriptor}"
    )
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_DIRECTORY_FD"] = str(directory_descriptor)
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_DIRECTORY_PATH"] = (
        f"/proc/self/fd/{directory_descriptor}"
    )
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_SELECTED_NAME_B64URL"] = encoded_name
    environment["SANDCODEX_DESKTOP_OPEN_DIRECTORY_POLICY_SHA256"] = policy.digest
    return subprocess.Popen(
        policy.argv(directory_descriptor),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=environment,
        start_new_session=True,
        close_fds=True,
        pass_fds=(object_descriptor, directory_descriptor),
        shell=False,
    )


def _harden_process() -> None:
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    libc = ctypes.CDLL(None, use_errno=True)
    pr_set_pdeathsig = 1
    pr_set_dumpable = 4
    pr_set_no_new_privs = 38
    parent = os.getppid()
    for option, value, label in (
        (pr_set_pdeathsig, signal.SIGTERM, "parent-death signal"),
        (pr_set_dumpable, 0, "non-dumpable state"),
        (pr_set_no_new_privs, 1, "no-new-privileges state"),
    ):
        if libc.prctl(option, value, 0, 0, 0) != 0:
            error = ctypes.get_errno()
            raise OSError(error, f"could not establish {label}")
    if os.getppid() != parent or parent == 1:
        raise RuntimeError("portal parent changed while process custody was established")


def _write_ready(
    path: Path,
    launch_id: str,
    portal_access: str,
    open_uri_policy_sha256: str,
    open_file_policy_sha256: str,
    open_directory_policy_sha256: str,
) -> None:
    if not path.is_absolute() or path.parent != Path("/run/sandcodex-app"):
        raise RuntimeError("portal ready path is outside the private app runtime")
    features = _portal_features(portal_access)
    interfaces: list[str] = []
    if "file-chooser" in features:
        interfaces.append(FILE_CHOOSER_INTERFACE)
    if {"open-uri", "open-file", "open-directory"} & features:
        interfaces.append(OPEN_URI_INTERFACE)
    uri_digest = open_uri_policy_sha256 if "open-uri" in features else "none"
    file_digest = open_file_policy_sha256 if "open-file" in features else "none"
    directory_digest = (
        open_directory_policy_sha256 if "open-directory" in features else "none"
    )
    if uri_digest != "none" and SHA256_RE.fullmatch(uri_digest) is None:
        raise RuntimeError("portal readiness received an invalid OpenURI policy digest")
    if file_digest != "none" and SHA256_RE.fullmatch(file_digest) is None:
        raise RuntimeError("portal readiness received an invalid OpenFile policy digest")
    if directory_digest != "none" and SHA256_RE.fullmatch(directory_digest) is None:
        raise RuntimeError("portal readiness received an invalid OpenDirectory policy digest")
    payload = (
        f"{PROTOCOL} pid={os.getpid()} launch_id={launch_id} "
        f"bus={BUS_NAME} interfaces={','.join(interfaces)} "
        f"open_uri_policy_sha256={uri_digest} "
        f"open_file_policy_sha256={file_digest} "
        f"open_directory_policy_sha256={directory_digest}\n"
    )
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        data = payload.encode("ascii")
        offset = 0
        while offset < len(data):
            written = os.write(descriptor, data[offset:])
            if written <= 0:
                raise OSError(errno.EIO, "portal readiness write made no progress")
            offset += written
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


