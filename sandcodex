+static uint32_t sandcodex_stylus_pressure(uint32_t start, uint32_t end,
+        uint32_t index, uint32_t steps) {
+    if (index == 0 || start == end) {
+        return start;
+    }
+    if (index >= steps) {
+        return end;
+    }
+    int64_t delta = (int64_t)end - (int64_t)start;
+    return (uint32_t)((int64_t)start +
+        (delta * (int64_t)index) / (int64_t)steps);
+}
+
+static uint32_t sandcodex_stylus_rotation_degrees(uint32_t start,
+        int32_t delta, uint32_t index, uint32_t steps) {
+    if (index == 0 || delta == 0) {
+        return start;
+    }
+    uint32_t bounded_index = index >= steps ? steps : index;
+    int64_t magnitude = delta < 0 ? -(int64_t)delta : (int64_t)delta;
+    int64_t signed_offset = (magnitude * (int64_t)bounded_index) /
+        (int64_t)steps;
+    if (delta < 0) {
+        signed_offset = -signed_offset;
+    }
+    int64_t value = ((int64_t)start + signed_offset) % 360;
+    if (value < 0) {
+        value += 360;
+    }
+    return (uint32_t)value;
+}
+
+static int32_t sandcodex_stylus_slider_65535(int32_t start, int32_t end,
+        uint32_t index, uint32_t steps) {
+    if (index == 0 || start == end) {
+        return start;
+    }
+    uint32_t bounded_index = index >= steps ? steps : index;
+    int64_t delta = (int64_t)end - (int64_t)start;
+    int64_t magnitude = delta < 0 ? -delta : delta;
+    int64_t signed_offset = (magnitude * (int64_t)bounded_index) /
+        (int64_t)steps;
+    if (delta < 0) {
+        signed_offset = -signed_offset;
+    }
+    return (int32_t)((int64_t)start + signed_offset);
+}
+
+static uint32_t sandcodex_stylus_distance_65535(uint32_t start, uint32_t end,
+        uint32_t index, uint32_t steps) {
+    if (index == 0 || start == end) {
+        return start;
+    }
+    uint32_t bounded_index = index >= steps ? steps : index;
+    int64_t delta = (int64_t)end - (int64_t)start;
+    return (uint32_t)((int64_t)start +
+        (delta * (int64_t)bounded_index) / (int64_t)steps);
+}
