  sc_emit_wayland_security_context_source | sc_atomic "$context_source" 600
  "$SC_WAYLAND_SCANNER" client-header "$xml" "$context_header"
  "$SC_WAYLAND_SCANNER" private-code "$xml" "$context_code"
