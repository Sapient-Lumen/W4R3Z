    (( ${#SC_PUBLISH_SPECS[@]} == 0 )) || instructions+=" Read SANDCODEX_PUBLISH_CONFIG, bind only the declared loopback targets, and state application authentication and reachability assumptions."
    (( ! SC_OPERATOR_ENABLED )) || instructions+=" The reviewed operator service is available through SANDCODEX_OPERATOR_SERVICE and cannot change authority during this launch."
