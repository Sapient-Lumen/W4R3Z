+static bool sandcodex_random_ticket(
+		char output[SANDCODEX_DISPATCH_TICKET_LENGTH + 1]) {
+	unsigned char bytes[SANDCODEX_DISPATCH_TICKET_LENGTH / 2] = {0};
+	size_t offset = 0;
+	while (offset < sizeof(bytes)) {
+		ssize_t count = getrandom(bytes + offset, sizeof(bytes) - offset, 0);
+		if (count < 0 && errno == EINTR) {
+			continue;
+		}
+		if (count <= 0) {
+			sandcodex_secure_clear(bytes, sizeof(bytes));
+			return false;
+		}
+		offset += (size_t)count;
+	}
+	static const char hex[] = "0123456789abcdef";
+	for (size_t i = 0; i < sizeof(bytes); ++i) {
+		output[i * 2] = hex[bytes[i] >> 4];
+		output[i * 2 + 1] = hex[bytes[i] & 0x0f];
+	}
+	output[SANDCODEX_DISPATCH_TICKET_LENGTH] = '\0';
+	sandcodex_secure_clear(bytes, sizeof(bytes));
+	return true;
+}
