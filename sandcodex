sc_browser_boundary_preflight() {
  (( SC_BROWSER && ! SC_BARE )) || return 0
  local secret="$SC_CONTROL/.browser-boundary-$SC_RUN_ID"
  local output="$SC_BROWSER_VISIBLE_OUTPUT/.boundary-$SC_RUN_ID" output_host="$SC_BROWSER_ACTIVE_OUTPUT/.boundary-$SC_RUN_ID"
  local download="$SC_BROWSER_VISIBLE_DOWNLOADS/.boundary-$SC_RUN_ID" download_host="$SC_BROWSER_ACTIVE_DOWNLOADS/.boundary-$SC_RUN_ID"
  local project_write="$SC_PROJECT/.browser-boundary-$SC_RUN_ID"
  local native_target="$SC_BROWSER_HOME/.config/google-chrome-for-testing/NativeMessagingHosts"
  local native_probe="$native_target/.boundary-$SC_RUN_ID" rc=0 diagnostic="" errexit=0
  local host_netns
  host_netns="$(readlink /proc/self/ns/net)"
  printf 'browser-private\n' | sc_atomic "$secret" 600
  rm -f -- "$output_host" "$download_host" "$project_write" "$native_probe"
  [[ $- != *e* ]] || errexit=1
  set +e
  diagnostic="$(env -i PATH="$SC_PATH" DISPLAY="$SC_BROWSER_DISPLAY" XAUTHORITY="$SC_BROWSER_XAUTHORITY" \
    "$SC_BROWSER_BOUNDARY" bash -eux -c '
      project=$1; secret=$2; output=$3; download=$4; browser_home=$5
      profile=$6; native_probe=$7; project_write=$8; global=$9
      proxy_port=${10}; host_netns=${11}
      test -r "$project"
      test ! -r "$secret"
      test ! -e "$global"
      test ! -S /nix/var/nix/daemon-socket/socket
      test "$(readlink /proc/self/ns/net)" != "$host_netns"
      timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/\$1" -- "$proxy_port"
      python3 -P /run/sandcodex-browser/launch/browser-keyring-probe.py
      if (printf escaped >"$secret") 2>/dev/null; then exit 91; fi
      if (printf browser-project-bypass >"$project_write") 2>/dev/null; then exit 92; fi
      test -w "$browser_home"
      printf native-ok >"$native_probe"
      test "$(cat "$profile/NativeMessagingHosts/${native_probe##*/}")" = native-ok
      rm -f "$profile/NativeMessagingHosts/${native_probe##*/}"
      test ! -e "$native_probe"
      printf profile-ok >"$profile/.sandcodex-boundary"
      rm -f "$profile/.sandcodex-boundary"
      printf output-ok >"$output"
      printf download-ok >"$download"
    ' sandcodex-browser "$SC_PROJECT" "$secret" "$output" "$download" "$SC_BROWSER_HOME" \
      "$SC_BROWSER_PROFILE_MOUNT" "$native_probe" "$project_write" "$SC_GLOBAL" \
      "$SC_BROWSER_NAMESPACE_PROXY_PORT" "$host_netns" 2>&1)"
  rc=$?
  (( ! errexit )) || set -e
  if (( rc != 0 )) || [[ ! -f "$secret" || -L "$secret" || "$(<"$secret")" != browser-private || \
    ! -f "$output_host" || "$(<"$output_host")" != output-ok || \
    ! -f "$download_host" || "$(<"$download_host")" != download-ok || -e "$project_write" || -L "$project_write" ]]; then
    rm -f -- "$secret" "$output_host" "$download_host" "$project_write" "$native_probe" 2>/dev/null || true
    sc_log_event error browser_boundary "nested browser boundary failed" "exit_code=$rc" "diagnostic=${diagnostic:0:12000}"
    printf '%s\n' "$diagnostic" >&2
    sc_err "nested browser credential/source boundary preflight failed (status $rc)"
    return 1
  fi
  rm -f -- "$secret" "$output_host" "$download_host" "$project_write" "$native_probe"
  sc_log_event info browser_boundary "browser hides control credentials and protects project source"
}

