+        tilt_y_degrees <= SANDCODEX_STYLUS_TILT_MAX_DEGREES &&
+        ((!rotation_present && rotation_start_degrees == 0 &&
+            rotation_delta_degrees == 0) ||
+        (rotation_present &&
+            rotation_start_degrees <= SANDCODEX_STYLUS_ROTATION_START_MAX_DEGREES &&
+            rotation_delta_degrees >= -SANDCODEX_STYLUS_ROTATION_DELTA_MAX_DEGREES &&
