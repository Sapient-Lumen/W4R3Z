}

sc_remote_keybank_quota_json() {
  local staged=$1 quota rc=0
  quota="$(python3 -P - "$staged" <<'PY'
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path
from datetime import datetime, timezone

staged = json.loads(sys.argv[1])
rows = []
for key in staged["keys"]:
    token = Path(key["credential_file"]).read_text(encoding="utf-8")
    request = urllib.request.Request(
        "https://openrouter.ai/api/v1/key",
        headers={"Authorization": f"Bearer {token}"},
    )
    row = {
        "index": key["index"],
        "label": key["label"],
        "key_id": key["key_id"],
        "key_sha256": key["key_sha256"],
        "status": "unknown",
        "is_free_tier": None,
        "free_model_daily_requests": None,
        "credit_limit": None,
        "usage": None,
        "detail": None,
    }
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = json.loads(response.read().decode("utf-8", "replace"))
        data = body.get("data")
        if not isinstance(data, dict):
            raise ValueError("response lacks data object")
        row.update({
            "status": "ok",
            "is_free_tier": data.get("is_free_tier"),
            "free_model_daily_requests": data.get("free_model_daily_requests"),
            "credit_limit": {
                "limit": data.get("limit"),
                "limit_reset": data.get("limit_reset"),
                "limit_remaining": data.get("limit_remaining"),
            },
            "usage": {
                "all_time": data.get("usage"),
                "daily": data.get("usage_daily"),
                "weekly": data.get("usage_weekly"),
                "monthly": data.get("usage_monthly"),
            },
        })
    except urllib.error.HTTPError as error:
        row["status"] = "http_error"
        row["detail"] = f"HTTP {error.code}"
    except Exception as error:
        row["status"] = "error"
        row["detail"] = f"{type(error).__name__}: {error}"
    rows.append(row)
print(json.dumps({
    "schema": "sandcodex.openrouter-key-bank-quota.v1",
    "result": "quota",
    "provider": "openrouter",
    "source_url": "https://openrouter.ai/api/v1/key",
    "checked_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "path": staged["path"],
    "key_count": len(rows),
    "credential_values_disclosed": False,
    "provider_key_labels_disclosed": False,
    "keys": rows,
}, sort_keys=True, separators=(",", ":")))
PY
  )" || rc=$?
  (( rc == 0 )) || sc_die "OpenRouter key-bank quota inspection failed" 69
  jq -e '.schema=="sandcodex.openrouter-key-bank-quota.v1" and (.keys|type)=="array"' \
    <<<"$quota" >/dev/null || sc_die "OpenRouter key-bank quota helper returned invalid metadata" 78
  printf '%s\n' "$quota"
}

sc_remote_keybank_usable_rows() {
  local staged=$1 quota=$2 min_remaining=${3:-2}
  jq -r --argjson staged "$staged" --argjson quota "$quota" --argjson min_remaining "$min_remaining" '
    def remaining($x):
      if ($x.free_model_daily_requests|type) == "object" and (($x.free_model_daily_requests.remaining // null) != null)
      then ($x.free_model_daily_requests.remaining|tonumber) else 999999 end;
    [ $staged.keys[] as $s
      | $quota.keys[]
      | select(.key_sha256 == $s.key_sha256)
      | select(.status == "ok")
      | . + {credential_file:$s.credential_file, remaining:remaining(.)}
      | select(.remaining >= $min_remaining or .remaining == 999999) ]
    | sort_by(-.remaining, .index)
    | .[]
    | [.key_id, .credential_file, .label, (.remaining|tostring)] | @tsv' <<<"{}"
}

