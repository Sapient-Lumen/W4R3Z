sc_emit_wayland_drop_agent_source() {
  cat <<'WAYLAND_DROP_AGENT_C'
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L

/*
 * DropSeal compositor-mediated native Wayland drag-and-drop source.
 *
 * The helper maps one fully transparent 8x8 layer-shell surface at a
 * controller-selected output corner.  A birth-pinned virtual pointer must
 * enter that exact surface and press button 1, giving this client the genuine
 * implicit-grab serial required by wl_data_device.start_drag.  The drag offers
 * strict UTF-8 text, one controller-canonicalized still PNG, or one bounded
 * controller-generated text/uri-list that names only launch-private read-only
 * file snapshots, and fixes the negotiated action to copy.  A receive issued
 * before MIME/action
 * acceptance is closed empty because its future destination cannot be proven.
 * Every accepted wl_data_source.send descriptor is bound to the exact current
 * target generation and retained empty until the controller revalidates scope,
 * target, and TickSeal and authorizes that exact request and generation.
 * Payload bytes never enter argv,
 * environment, stdout, stderr, the audit journal, or a filesystem path.
 */

#include <ctype.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <poll.h>
