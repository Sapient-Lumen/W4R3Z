+static bool sandcodex_emit_tablet_pad_button(struct wlr_surface *surface,
+        struct wl_client *target_client, uint32_t button,
+        uint32_t mode_index) {
+    struct wlr_tablet_v2_tablet_pad *pad = sandcodex_stylus.pad_v2;
+    if (!surface || !surface->resource || !target_client ||
+            button != SANDCODEX_TABLET_PAD_BUTTON_INDEX ||
+            wl_resource_get_client(surface->resource) != target_client ||
+            !wlr_surface_accepts_tablet_v2(surface,
+                sandcodex_stylus.tablet_v2) ||
+            !sandcodex_tablet_pad_idle_at_mode(mode_index)) {
+        return false;
+    }
+    uint32_t time = get_current_time_in_msec();
+    uint32_t enter_serial = wlr_tablet_v2_tablet_pad_notify_enter(pad,
+        sandcodex_stylus.tablet_v2, surface);
+    bool entered = enter_serial != 0 && pad->current_client != NULL &&
+        pad->grab == &pad->default_grab && pad->group_count == 1 &&
+        pad->groups != NULL &&
+        pad->groups[SANDCODEX_TABLET_PAD_BUTTON_GROUP_INDEX] ==
+            mode_index;
+    if (!entered) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    /* The enter helper emits the current group-zero mode before returning. The
+     * synthetic button then changes state twice without yielding to clients. */
+    wlr_tablet_v2_tablet_pad_notify_button(pad, button, time,
+        ZWP_TABLET_PAD_V2_BUTTON_STATE_PRESSED);
+    if (pad->current_client == NULL || pad->grab != &pad->default_grab) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_button(pad, button, time,
+                ZWP_TABLET_PAD_V2_BUTTON_STATE_RELEASED);
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    wlr_tablet_v2_tablet_pad_notify_button(pad, button, time,
+        ZWP_TABLET_PAD_V2_BUTTON_STATE_RELEASED);
+    if (pad->current_client == NULL || pad->grab != &pad->default_grab) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    uint32_t leave_serial = wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+    /* wlroots retains current_client after leave; this one-shot synthetic pad
+     * owns no persistent focus and clears it before the final idle proof. */
+    pad->current_client = NULL;
+    return leave_serial != 0 &&
+        sandcodex_tablet_pad_idle_at_mode(mode_index);
+}
