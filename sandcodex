+static int32_t sandcodex_touchpad_pinch_cumulative(int32_t total,
+        uint32_t index, uint32_t steps) {
+    if (index == 0 || total == 0) {
+        return 0;
+    }
+    if (index >= steps) {
+        return total;
+    }
+    int64_t magnitude = total < 0 ? -(int64_t)total : (int64_t)total;
+    int64_t part = (magnitude * (int64_t)index) / (int64_t)steps;
+    return (int32_t)(total < 0 ? -part : part);
+}
+
+static double sandcodex_touchpad_pinch_fixed_to_double(int32_t raw) {
+    return (double)raw / 256.0;
+}
+
+static bool sandcodex_emit_touchpad_pinch(
+        struct wlr_pointer_gestures_v1 *gestures, struct wlr_seat *seat,
+        int32_t delta_x, int32_t delta_y, uint32_t fingers,
+        int32_t scale_256, int32_t rotation_degrees, uint32_t steps,
+        uint32_t duration_msec, uint32_t base_time) {
+    if (!gestures || !seat || !sandcodex_touchpad_pinch_shape_valid(
+            0, 0, delta_x, delta_y, fingers, scale_256, rotation_degrees,
+            steps, duration_msec) || base_time > UINT32_MAX - duration_msec) {
+        return false;
+    }
+    int32_t total_x_raw = delta_x * 256;
+    int32_t total_y_raw = delta_y * 256;
+    int32_t total_scale_delta_raw =
+        scale_256 - SANDCODEX_TOUCHPAD_PINCH_SCALE_UNITY_256;
+    int32_t total_rotation_raw = rotation_degrees * 256;
+    int32_t previous_x_raw = 0;
+    int32_t previous_y_raw = 0;
+    int32_t previous_scale_delta_raw = 0;
+    int32_t previous_rotation_raw = 0;
+
+    /* Validate every exact 24.8-grid update before pinch_begin. After begin
+     * becomes client-visible there is no branch that can omit pinch_end. */
+    for (uint32_t index = 1; index <= steps; ++index) {
+        int32_t x_raw = sandcodex_touchpad_pinch_cumulative(
+            total_x_raw, index, steps);
+        int32_t y_raw = sandcodex_touchpad_pinch_cumulative(
+            total_y_raw, index, steps);
+        int32_t scale_delta_raw = sandcodex_touchpad_pinch_cumulative(
+            total_scale_delta_raw, index, steps);
+        int32_t rotation_raw = sandcodex_touchpad_pinch_cumulative(
+            total_rotation_raw, index, steps);
+        if (x_raw == previous_x_raw && y_raw == previous_y_raw &&
+                scale_delta_raw == previous_scale_delta_raw &&
+                rotation_raw == previous_rotation_raw) {
+            return false;
+        }
+        previous_x_raw = x_raw;
+        previous_y_raw = y_raw;
+        previous_scale_delta_raw = scale_delta_raw;
+        previous_rotation_raw = rotation_raw;
+    }
+    if (previous_x_raw != total_x_raw || previous_y_raw != total_y_raw ||
+            previous_scale_delta_raw != total_scale_delta_raw ||
+            previous_rotation_raw != total_rotation_raw) {
+        return false;
+    }
+
+    previous_x_raw = 0;
+    previous_y_raw = 0;
+    previous_scale_delta_raw = 0;
+    previous_rotation_raw = 0;
+    wlr_pointer_gestures_v1_send_pinch_begin(
+        gestures, seat, base_time, fingers);
+    for (uint32_t index = 1; index <= steps; ++index) {
+        int32_t x_raw = sandcodex_touchpad_pinch_cumulative(
+            total_x_raw, index, steps);
+        int32_t y_raw = sandcodex_touchpad_pinch_cumulative(
+            total_y_raw, index, steps);
+        int32_t scale_delta_raw = sandcodex_touchpad_pinch_cumulative(
+            total_scale_delta_raw, index, steps);
+        int32_t rotation_raw = sandcodex_touchpad_pinch_cumulative(
+            total_rotation_raw, index, steps);
+        int32_t relative_x_raw = x_raw - previous_x_raw;
+        int32_t relative_y_raw = y_raw - previous_y_raw;
+        int32_t relative_rotation_raw = rotation_raw - previous_rotation_raw;
+        uint32_t offset = (uint32_t)(((uint64_t)duration_msec * index) /
+            (uint64_t)(steps + 1));
+        wlr_pointer_gestures_v1_send_pinch_update(
+            gestures, seat, base_time + offset,
+            sandcodex_touchpad_pinch_fixed_to_double(relative_x_raw),
+            sandcodex_touchpad_pinch_fixed_to_double(relative_y_raw),
+            sandcodex_touchpad_pinch_fixed_to_double(
+                SANDCODEX_TOUCHPAD_PINCH_SCALE_UNITY_256 + scale_delta_raw),
+            sandcodex_touchpad_pinch_fixed_to_double(relative_rotation_raw));
+        previous_x_raw = x_raw;
+        previous_y_raw = y_raw;
+        previous_scale_delta_raw = scale_delta_raw;
+        previous_rotation_raw = rotation_raw;
+    }
+    wlr_pointer_gestures_v1_send_pinch_end(
+        gestures, seat, base_time + duration_msec, false);
+    return previous_x_raw == total_x_raw && previous_y_raw == total_y_raw &&
+        previous_scale_delta_raw == total_scale_delta_raw &&
+        previous_rotation_raw == total_rotation_raw;
+}
