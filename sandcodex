    def guarded_touch_gesture(
        self,
        first_start_x: int,
        first_start_y: int,
        first_end_x: int,
        first_end_y: int,
        second_start_x: int,
        second_start_y: int,
        second_end_x: int,
        second_end_y: int,
        steps: int,
        duration_milliseconds: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        """Arm, validate, and atomically dispatch one native two-contact gesture."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor touch connection is unauthorized")
        coordinates = (
            (first_start_x, "first_start_x"), (first_start_y, "first_start_y"),
            (first_end_x, "first_end_x"), (first_end_y, "first_end_y"),
            (second_start_x, "second_start_x"), (second_start_y, "second_start_y"),
            (second_end_x, "second_end_x"), (second_end_y, "second_end_y"),
        )
        for value, label in coordinates:
            if type(value) is not int or not (
                -SWAY_HIT_TEST_MAX_COORDINATE <= value <= SWAY_HIT_TEST_MAX_COORDINATE
            ):
                raise ToolError(f"compositor touch-gesture {label} coordinate is invalid")
        if type(steps) is not int or not 1 <= steps <= TOUCH_GESTURE_MAX_STEPS:
            raise ToolError("compositor touch-gesture steps are outside the supported range")
        if type(duration_milliseconds) is not int or not (
            steps + 1 <= duration_milliseconds <= TOUCH_GESTURE_MAX_DURATION_MILLISECONDS
        ):
            raise ToolError(
                "compositor touch-gesture duration must permit strictly increasing "
                "event timestamps and remain within the supported range"
            )
        if not callable(validator):
            raise ToolError("compositor touch-gesture target validator is unavailable")
        action = {
            "duration_milliseconds": duration_milliseconds,
            "first_end_x": first_end_x,
            "first_end_y": first_end_y,
            "first_start_x": first_start_x,
            "first_start_y": first_start_y,
            "second_end_x": second_end_x,
            "second_end_y": second_end_y,
            "second_start_x": second_start_x,
            "second_start_y": second_start_y,
            "steps": steps,
        }
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-touch-gesture", **action}),
                    "SANDCODEX_HIT_TEST arm-touch-gesture",
                )
                target, ticket = self._normalize_touch_gesture_arm_reply(
                    arm_reply, first_start_x, first_start_y, first_end_x,
                    first_end_y, second_start_x, second_start_y, second_end_x,
                    second_end_y, steps, duration_milliseconds,
                )
                ticket_action = {"dispatch_kind": "touch-gesture", **action}
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-touch-gesture-ticket-v1\0"
                    + canonical_json(ticket_action) + b"\0" + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": TOUCH_GESTURE_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-recipient-two-contact-touch-gesture",
                    "dispatch_kind": "touch-gesture",
                    **action,
                    "path_points_per_contact": steps + 1,
                    "total_path_points": 2 * (steps + 1),
                    "contact_count": TOUCH_GESTURE_CONTACT_COUNT,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": "view-surface+hit-surface+wl-touch-resource",
                    "dispatch_path": COMPOSITOR_TOUCH_GESTURE_DISPATCH_PATH,
                    "dispatch_atomicity": GUARDED_TOUCH_GESTURE_DISPATCH_ATOMICITY,
                    "route_scope": COMPOSITOR_TOUCH_ROUTE_SCOPE,
                    "coordinate_scope": COMPOSITOR_TOUCH_COORDINATE_SCOPE,
                    "path_scope": COMPOSITOR_TOUCH_GESTURE_PATH_SCOPE,
                    "time_scope": COMPOSITOR_TOUCH_GESTURE_TIME_SCOPE,
                    "release_scope": COMPOSITOR_TOUCH_GESTURE_RELEASE_SCOPE,
                    "wall_clock_pacing": False,
                    "pointer_fallback_policy": "deny",
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorTouchGestureGrant(
                    first_start_x=first_start_x, first_start_y=first_start_y,
                    first_end_x=first_end_x, first_end_y=first_end_y,
                    second_start_x=second_start_x, second_start_y=second_start_y,
                    second_end_x=second_end_x, second_end_y=second_end_y,
                    steps=steps, duration_milliseconds=duration_milliseconds,
                    ticket=ticket, target=target, grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_touch_gesture_arms += 1
                self.last_compositor_touch_gesture_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_touch_gesture_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touch gesture could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-touch-gesture",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-touch-gesture",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_touch_gesture_reply(cancel_reply)
                    self.compositor_touch_gesture_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_touch_gesture_dispatch_failures += 1
                    self._set_failure(cancel_error)
                    raise ToolError(
                        "compositor touch-gesture validation failed and its private "
                        "ticket could not be cancelled; the compositor seal is quarantined"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        **action,
                        "op": "dispatch-touch-gesture",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-touch-gesture",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_touch_gesture_reply(
                    dispatch_reply, grant
                )
                self.compositor_touch_gesture_dispatches += 1
                self.last_compositor_touch_gesture_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_touch_gesture_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touch gesture failed closed: {error}"
                ) from error

    def _normalize_touchpad_swipe_arm_reply(
        self,
