sc_remote_report_render() {
  local report=$1
  printf 'Sandcodex OpenRouter report\n'
  printf '  result      %s\n' "$(jq -r 'if .key_bank.available and .model_bank.available then "READY" else "SETUP REQUIRED" end' <<<"$report")"
  printf '  generated   %s\n' "$(jq -r '.generated_at' <<<"$report")"
  printf '  provider    %s\n' "$(jq -r '.provider' <<<"$report")"
  printf '\n'
  jq -r '
    .key_bank as $k |
    if $k.available then
      "key bank     READY · \($k.key_count // 0) keys · \($k.path)" +
      (if .quota_checked then " · live quota checked" else " · quota not checked" end)
    else
      "key bank     NOT READY · \($k.path) · \($k.status)"
    end
  ' <<<"$report"
  if jq -e '.key_bank.quota.keys? | type == "array"' <<<"$report" >/dev/null; then
    jq -r '.key_bank.quota.keys[] |
      .free_model_daily_requests as $f |
      "  \(.index). \(.label) · \(.key_id) · \(.status)" +
      (if ($f|type) == "object" then
        " · free remaining=\($f.remaining // "unknown") limit=\($f.limit // "unknown")"
      else "" end) +
      (if .detail then " · " + .detail else "" end)' <<<"$report"
  fi
  jq -r '
    .model_bank as $m |
    if $m.available then
      "model bank   READY · \($m.model_count) models · fetched \($m.fetched_at // "unknown") · ranking \($m.ranking_source // "metadata")" +
      (if $m.profile then " · profile \($m.profile.name // "unknown")" else "" end)
    else
      "model bank   NOT READY · \($m.path) · \($m.status)"
    end
  ' <<<"$report"
  jq -r '
    .cooldowns as $c |
    "cooldowns    keys=\(($c.keys // {})|length) models=\(($c.models // {})|length) pairs=\(($c.pairs // {})|length) · locked atomic updates"
  ' <<<"$report"
  jq -r '
    .coding_bench as $b |
    if $b.available then
      "coding bench READY · \($b.model_count) models · \($b.bench_version // "unknown") · live \($b.live_count) cached \($b.cached_count)"
    else
      "coding bench OPTIONAL/MISSING · \($b.path) · \($b.status)"
    end
  ' <<<"$report"
  if jq -e '.coding_bench.top_models | length > 0' <<<"$report" >/dev/null; then
    printf '\ntop bench models\n'
    jq -r '.coding_bench.top_models[] |
      "  \(.rank // "?"). \(.model // "?")\n" +
      "     score \(.points // "?")/\(.possible_points // "?") · tasks \(.passed_tasks // "?")/\(.total_tasks // "?") · " +
      (if .cached then "cached evidence" else "live evidence" end)' <<<"$report"
  elif jq -e '.model_bank.top_models | length > 0' <<<"$report" >/dev/null; then
    printf '\ntop model-bank models\n'
    jq -r '.model_bank.top_models[] |
      "  \(.rank // "?"). \(.id // "?")\n" +
      "     metadata \((.strength_score // 0)|floor) · context \(.context_tokens // "?") · " +
      (if .tools then "tools" else "no tools" end) +
      (if .tool_choice then " · tool choice" else "" end)' <<<"$report"
  fi
  jq -r '
    .auto_selection as $s |
    if $s.available then
      "saved choice  \($s.model // "unknown") · key \($s.key_id // "unknown") · rank \($s.rank // "unknown") · profile \($s.profile // "coding") · \($s.selected_at // "unknown")"
    else
      "saved choice  none · \($s.path)"
    end
  ' <<<"$report"
  jq -r '
    .auto_failure as $f |
    if $f.available then
      "last failure \($f.attempt_count) attempts · \($f.failed_at // "unknown") · \($f.path)"
    else
      "last failure none · \($f.path)"
    end
  ' <<<"$report"
  printf '\n'
  printf 'current limits\n'
  printf '  - Switching applies to fresh auto launches and worker boundaries.\n'
  printf '  - A live provider request cannot change model or key mid-turn.\n'
  printf '  - Visible partial output cannot be retracted or replayed.\n'
  printf '  - An already-running TUI cannot be retargeted.\n'
  printf '\n'
  printf 'next\n'
  jq -r '.paste_back[] | "  " + .' <<<"$report"
  printf '\nprivacy\n  Credential values, prompts, and provider output are not printed.\n'
}

