sc_quarantine_project_local_path() {
  local path="$1" label="$2" reason="$3" base parent stamp destination
  [[ "$path" == "$SC_LOCAL" || "$path" == "$SC_LOCAL"/* ]] ||
    sc_die "internal quarantine target escapes project-local state: $path"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ -d "$path" && ! -L "$path" ]]; then
    sc_owned_dir "$path" "$label"
    sc_assert_no_mounts_at_or_below "$path" 1 "$label"
  elif [[ -f "$path" && ! -L "$path" ]]; then
    sc_owned_single_file "$path" "" "$label"
  elif [[ -L "$path" ]]; then
    [[ "$(stat -c %u -- "$path" 2>/dev/null || true)" == "$(id -u)" ]] ||
      sc_die "$label symlink is owned by another uid: $path"
  else
    sc_die "$label has an unsafe type and will not be auto-quarantined: $path"
  fi

  sc_ensure_dir "$SC_GLOBAL/quarantine" "project-local quarantine root"
  parent="$SC_GLOBAL/quarantine/$SC_PROJECT_KEY"
  sc_ensure_dir "$parent" "project-local quarantine bucket"
  base="${path##*/}"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
  destination="$parent/$base.$stamp"
  [[ ! -e "$destination" && ! -L "$destination" ]] ||
    sc_die "project-local quarantine path collision: $destination"
  if ! mv -T -- "$path" "$destination"; then
    sc_die "could not move stale $label out of the way: $path"
  fi
  sc_log_event warn project_local_state_quarantined \
    "moved stale disposable project-local state aside" \
    "label=$label" "reason=$reason" "source=$path" "destination=$destination"
  sc_warn "moved stale $label aside ($reason): $destination"
}

sc_old_project_still_owns_state() {
  local project="$1" key="$2" marker
  [[ -d "$project" && ! -L "$project" ]] || return 1
  [[ "$(realpath -- "$project" 2>/dev/null || true)" == "$project" ]] || return 1
  marker="$project/.sandcodex/OWNER"
  sc_project_work_marker_matches "$marker" "$project" "$key"
}

sc_relocate_codex_sessions() {
  local source="$1" target="$2" old_project="$3" detail
  [[ -e "$source" || -L "$source" ]] || return 0
  sc_no_symlink_components "$source" "prior Codex sessions"
  sc_owned_dir "$source" "prior Codex sessions"
  sc_assert_no_mounts_at_or_below "$source" 1 "prior Codex sessions"
  sc_ensure_dir "$(dirname -- "$target")" "relocated Codex session parent"

  if ! detail="$(python3 -P - "$source" "$target" "$old_project" "$SC_PROJECT" 2>&1 <<'PY'
import json
import os
from pathlib import Path
import shutil
import stat
import sys
import tempfile

source, target, old_project, new_project = map(os.path.abspath, sys.argv[1:])
uid = os.getuid()
max_entries = 100_000
max_total = 2 * 1024 * 1024 * 1024
max_file = 512 * 1024 * 1024
max_json_value = 64 * 1024 * 1024

def checked_directory(path, label):
    value = os.lstat(path)
    if not stat.S_ISDIR(value.st_mode) or value.st_uid != uid or os.path.realpath(path) != path:
        raise RuntimeError(f"{label} is not a canonical user-owned directory: {path}")
    return value

def relocate(value):
    if isinstance(value, str):
        if value == old_project:
            return new_project
        if value.startswith(old_project + os.sep):
            return new_project + value[len(old_project):]
        return value
    if isinstance(value, list):
        return [relocate(item) for item in value]
    if isinstance(value, dict):
        return {key: relocate(item) for key, item in value.items()}
    return value

def structured_bytes(path, size):
    suffix = Path(path).suffix
    if suffix == ".json":
        if size > max_json_value:
            raise RuntimeError(f"session JSON value is too large: {path}")
        with open(path, "rb") as stream:
            raw = stream.read()
        try:
            value = relocate(json.loads(raw.decode("utf-8")))
        except (UnicodeError, json.JSONDecodeError):
            return raw
        return (json.dumps(value, separators=(",", ":"), ensure_ascii=False) + "\n").encode()
    if suffix != ".jsonl":
        with open(path, "rb") as stream:
            return stream.read()
    output = bytearray()
    with open(path, "rb") as stream:
        while True:
            line = stream.readline(max_json_value + 1)
            if not line:
                break
            if len(line) > max_json_value:
                raise RuntimeError(f"session JSONL value is too large: {path}")
            if not line.strip():
                continue
            try:
                value = relocate(json.loads(line.decode("utf-8")))
                encoded = json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode()
            except (UnicodeError, json.JSONDecodeError):
                encoded = line.rstrip(b"\r\n")
            if output:
                output.extend(b"\n")
            output.extend(encoded)
            if len(output) > max_file:
                raise RuntimeError(f"relocated session file is too large: {path}")
    if output:
        output.extend(b"\n")
    return bytes(output)

checked_directory(source, "session source")
parent = os.path.dirname(target)
checked_directory(parent, "session destination parent")
stage = tempfile.mkdtemp(prefix=".sessions-rebind.", dir=parent)
os.chmod(stage, 0o700)
backup = None
entries = 0
total = 0
try:
    for directory, names, files in os.walk(source, topdown=True, followlinks=False):
        names.sort()
        files.sort()
        relative = os.path.relpath(directory, source)
        destination_directory = stage if relative == "." else os.path.join(stage, relative)
        if relative != ".":
            os.mkdir(destination_directory, 0o700)
        for name in names:
            path = os.path.join(directory, name)
            value = os.lstat(path)
            if not stat.S_ISDIR(value.st_mode) or value.st_uid != uid:
                raise RuntimeError(f"session tree contains a linked or foreign directory: {path}")
        for name in files:
            path = os.path.join(directory, name)
            value = os.lstat(path)
            if not stat.S_ISREG(value.st_mode) or value.st_uid != uid or value.st_nlink != 1:
                raise RuntimeError(f"session tree contains a linked, special, or foreign file: {path}")
            entries += 1
            total += value.st_size
            if entries > max_entries or total > max_total or value.st_size > max_file:
                raise RuntimeError("session tree exceeds relocation safety limits")
            data = structured_bytes(path, value.st_size)
            if len(data) > max_file:
                raise RuntimeError(f"relocated session file is too large: {path}")
            destination = os.path.join(destination_directory, name)
            with open(destination, "xb") as stream:
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(destination, 0o600)
            os.utime(destination, ns=(value.st_atime_ns, value.st_mtime_ns))

    if source == target:
        for directory, _names, files in os.walk(stage, topdown=False):
            relative = os.path.relpath(directory, stage)
            destination_directory = target if relative == "." else os.path.join(target, relative)
            for name in files:
                os.replace(os.path.join(directory, name), os.path.join(destination_directory, name))
        shutil.rmtree(stage)
        stage = None
    else:
        if os.path.lexists(target):
            checked_directory(target, "session destination")
            backup = tempfile.mkdtemp(prefix=".sessions-before-rebind.", dir=parent)
            os.rmdir(backup)
            os.replace(target, backup)
        try:
            os.replace(stage, target)
            stage = None
        except BaseException:
            if backup is not None and not os.path.lexists(target):
                os.replace(backup, target)
                backup = None
            raise
        if backup is not None:
            shutil.rmtree(backup)
            backup = None
finally:
    if stage is not None:
        shutil.rmtree(stage, ignore_errors=True)
    if backup is not None and not os.path.lexists(target):
        os.replace(backup, target)
PY
  )"; then
    sc_warn "could not carry prior Codex sessions into the moved project; launch will continue without them"
    sc_log_event warn project_session_relocation_skipped \
      "prior Codex sessions could not be relocated" "old_project=$old_project" "detail=$detail"
    return 1
  fi
}

sc_rebind_managed_git_state() {
  local old_project="$1" marker="$SC_WORK/vcs/SANDCODEX_MANAGED_VCS" git_config="$SC_WORK/vcs/config" git_bin
  [[ -e "$marker" || -L "$marker" ]] || return 0
  sc_owned_single_file "$marker" "" "managed Git ownership marker"
  grep -Fx "project=$old_project" "$marker" >/dev/null || return 0
  grep -Fx "uid=$(id -u)" "$marker" >/dev/null || return 0
  printf 'project=%s\nuid=%s\n' "$SC_PROJECT" "$(id -u)" | sc_atomic "$marker" 600
  if [[ -f "$git_config" && ! -L "$git_config" && "$(stat -c %u -- "$git_config")" == "$(id -u)" ]]; then
    git_bin="$(command -v git 2>/dev/null || true)"
    [[ -z "$git_bin" ]] || sc_git_clean_env \
      "$git_bin" config --file "$git_config" core.worktree "$SC_PROJECT" || true
  fi
}

