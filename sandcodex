def append_launch_log(root, completed):
    payload = (
        f"exit={completed.returncode}\n"
        + completed.stdout[-32768:]
        + "\n--- stderr ---\n"
        + completed.stderr[-32768:]
    ).encode("utf-8", "replace")
    atomic_bytes(os.path.join(root, "launch.log"), payload)


def command_failure_tail(completed, maximum=6):
    lines = []
    fallback = []
    for text in (completed.stderr, completed.stdout):
        for line in text.splitlines():
            stripped = line.strip()
            if not stripped:
                continue
            if len(stripped) > 600:
                stripped = stripped[:597] + "..."
            fallback.append(stripped)
            if stripped.startswith("Try: sandcodex help "):
                continue
            if stripped.startswith("these ") and " paths will be fetched" in stripped:
                continue
            if stripped.startswith("copying path "):
                continue
            if stripped.startswith("building '/nix/store/"):
                continue
            lines.append(stripped)
    chosen = lines[-maximum:] if lines else fallback[-maximum:]
    return " | ".join(chosen) if chosen else "launcher produced no diagnostic"


def detached_launch_receipt(completed):
    for line in reversed(completed.stdout.splitlines()):
        try:
            candidate = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(candidate, dict) and candidate.get("schema") == "sandcodex.detached-launch.v1":
            required = ("supervisor_id", "unit", "state_file")
            if all(isinstance(candidate.get(field), str) and candidate[field] for field in required):
                return candidate
    fail("detached campaign worker did not return a launch receipt")


def launcher_environment(context):
    environment = {
        "HOME": context["home"],
        "PATH": context["host_path"],
        "PYTHONSAFEPATH": "1",
        "SANDCODEX_REAL_HOME": context["home"],
        "SANDCODEX_GLOBAL_ROOT": context["worker_global_root"],
        "SANDCODEX_HOST_PATH": context["host_path"],
    }
    for name in (
        "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "SANDCODEX_NIX_READY",
        "SANDCODEX_TESTING", "SANDCODEX_NO_NIX", "SANDCODEX_TEST_RESOURCE_SCOPE",
        "SANDCODEX_TEST_CODEX_BIN", "SANDCODEX_TEST_SYSTEMD_RUN_BIN",
        "SANDCODEX_TEST_SYSTEMCTL_BIN", "SANDCODEX_TEST_SYSTEMD_NOEXEC",
        "SANDCODEX_SYSTEMD_CAPTURE", "SANDCODEX_SYSTEMCTL_CAPTURE",
        "SANDCODEX_TEST_RETRY_DELAY_SECONDS",
    ):
        if name in os.environ:
            environment[name] = os.environ[name]
    return environment


def launch_worker(context, root, principal, prompt_path):
    route = principal.get("provider_route")
    if route is None:
        route = principal.get("inference_mode", context["inference"]["mode"])
    inference = inference_routes(context).get(route)
    if inference is None:
        fail(f"worker provider route {route!r} is no longer authorized")
    command = [context["launcher"]]
    remote_auto_worker = False
    if inference["mode"] == "local":
        command.extend(["local", inference["requested_model"], "loop"])
    elif inference["mode"] == "gemini":
        command.extend(["gemini", "loop"])
    elif inference["mode"] == "remote":
        remote_auto = inference.get("auto") if isinstance(inference.get("auto"), dict) else {}
        if remote_auto.get("enabled") is True:
            remote_auto_worker = True
            key_bank = remote_auto.get("key_bank_file")
            key_bank_sha = remote_auto.get("key_bank_sha256")
            profile = remote_auto.get("profile") or "coding"
            if not isinstance(key_bank, str) or not key_bank.startswith("/") or not isinstance(key_bank_sha, str):
                fail("remote-auto worker authority lacks its copied key bank")
            if profile not in {"coding", "long-context-reading", "fast-cheap-worker", "tool-reliable", "fallback"}:
                fail("remote-auto worker profile is invalid")
            try:
                with open(key_bank, "rb") as stream:
                    observed = hashlib.sha256(stream.read()).hexdigest()
            except OSError as error:
                fail(f"remote-auto worker key bank is unavailable: {error}")
            if observed != key_bank_sha:
                fail("remote-auto worker key bank digest changed")
            command.extend(["remote", "auto", "--key-bank", key_bank, "--profile", profile, "loop"])
        else:
            command.extend(["remote", inference["requested_model"], "loop"])
    else:
        command.append("loop")
    command.extend([
        "--detach", "--project", principal["workspace"],
        "--turns", str(principal["turn_limit"]), "--prompt-file", prompt_path,
        "--json", "--auto-resume",
    ])
    command.append("--browser" if principal.get("browser", {}).get("mode") == "isolated" else "--no-browser")
    command.append("--desktop" if principal.get("desktop", {}).get("mode") == "isolated" else "--no-desktop")
    command.extend(context["worker_options"])
    if principal.get("effort"):
        command.extend(["--effort", principal["effort"]])
    if remote_auto_worker:
        policy = REMOTE_AUTO_WORKER_RETRY_POLICY
        command.extend([
            "--retry-limit", str(policy["retry_limit"]),
            "--retry-base-seconds", str(policy["retry_base_seconds"]),
            "--retry-max-seconds", str(policy["retry_max_seconds"]),
            "--retry-max-wait-seconds", str(policy["retry_max_wait_seconds"]),
        ])
    provider_args = context.get("provider_args", [])
    if provider_args:
        command.extend(["--", *provider_args])
    environment = launcher_environment(context)
    if principal.get("name") and principal.get("campaign_id"):
        environment["SANDCODEX_TEAM_MEMBER_NAME"] = principal["name"]
        environment["SANDCODEX_TEAM_CAMPAIGN_ID"] = principal["campaign_id"]
    if inference["mode"] == "local":
        environment["SANDCODEX_LOCAL_PARENT_CONTRACT"] = inference["parent_provider_contract"]
        environment["SANDCODEX_LOCAL_PARENT_CONTRACT_SHA256"] = inference["parent_provider_contract_sha256"]
    elif inference["mode"] == "gemini":
        environment["SANDCODEX_GEMINI_PARENT_CONTRACT"] = inference["parent_provider_contract"]
        environment["SANDCODEX_GEMINI_PARENT_CONTRACT_SHA256"] = inference["parent_provider_contract_sha256"]
    elif inference["mode"] == "remote" and not (
        isinstance(inference.get("auto"), dict) and inference["auto"].get("enabled") is True
    ):
        environment["SANDCODEX_REMOTE_PARENT_CONTRACT"] = inference["parent_provider_contract"]
        environment["SANDCODEX_REMOTE_PARENT_CONTRACT_SHA256"] = inference["parent_provider_contract_sha256"]
    completed = subprocess.run(
        command, env=environment, text=True, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=180, check=False,
    )
    append_launch_log(root, completed)
    if completed.returncode:
        fail(
            f"detached campaign worker launch failed with status {completed.returncode}: "
            f"{command_failure_tail(completed)}"
        )
    launch = detached_launch_receipt(completed)
    principal["supervisor_id"] = launch["supervisor_id"]
    principal["worker_unit"] = launch["unit"]
    principal["worker_state"] = launch["state_file"]
    principal["status"] = "queued"
    principal["started_at"] = now()
    save_principal(root, principal)
    event = {
        "supervisor_id": launch["supervisor_id"],
        "unit": launch["unit"],
        "turn_limit": principal["turn_limit"],
        "provider_route": route,
        "inference_mode": inference["mode"],
    }
    if remote_auto_worker:
        event["remote_auto_retry_policy"] = dict(REMOTE_AUTO_WORKER_RETRY_POLICY)
    append_event(root, "worker-launched", **event)
    sync_worker_inbox(context, root, principal)


def validate_request(doc, target=None):
    if not isinstance(doc, dict) or doc.get("schema") != REQUEST_SCHEMA:
        fail("campaign request schema is invalid")
    if not ID_RE.fullmatch(str(doc.get("id", ""))) or not ID_RE.fullmatch(str(doc.get("target_run_id", ""))):
        fail("campaign request identity is invalid")
    if target is not None and doc["target_run_id"] != target:
        fail("campaign request targets another command room")
    action = doc.get("action")
    if action not in {"start", "list", "status", "events", "send", "stop", "restart", "collect", "grant", "remove",
                      "inbox", "ack", "wait", "wait-any", "attach", "inspect", "top", "diff", "test", "stage", "adopt", "graph"}:
        fail("campaign request action is invalid")
    name = doc.get("name")
    unnamed = {"list", "grant", "top", "ack", "wait-any", "graph"}
    if action not in unnamed | {"inbox"} and not NAME_RE.fullmatch(str(name or "")):
        fail("campaign request name is invalid")
    if action in unnamed and name is not None:
        fail("campaign request name is unexpected for this action")
    if action == "inbox" and name is not None and not NAME_RE.fullmatch(str(name)):
        fail("team inbox worker name is invalid")
    turns = doc.get("turns")
    if not isinstance(turns, int) or isinstance(turns, bool) or turns < 0 or turns > 999999999:
        fail("campaign request turn count is invalid")
    cursor = doc.get("cursor")
    if not isinstance(cursor, int) or isinstance(cursor, bool) or cursor < 0 or cursor > 999999999:
        fail("campaign request cursor is invalid")
    if doc.get("browser") not in {"none", "isolated"}:
        fail("team worker browser mode is invalid")
    if action in {"start", "send"}:
        prompt = doc.get("prompt")
        if not isinstance(prompt, str) or not prompt.strip() or len(prompt.encode()) > 16384 or "\0" in prompt:
            fail("campaign request prompt is invalid")
    elif doc.get("prompt") is not None:
        fail("campaign request has an unexpected prompt")
    if action == "start" and not REV_RE.fullmatch(str(doc.get("base", ""))):
        fail("campaign base revision is invalid")
    output = doc.get("output")
    if action == "collect":
        if not isinstance(output, str) or not relative_path(output):
            fail("campaign collection output is invalid")
    elif output is not None:
        fail("campaign request has an unexpected output")
    dry_run = doc.get("dry_run", False)
    if not isinstance(dry_run, bool):
        fail("campaign request dry-run field is invalid")
    if dry_run and action != "remove":
        fail("campaign request has an unexpected dry-run field")
    doc["dry_run"] = dry_run
    grant = doc.get("grant")
    if action == "grant":
        if not isinstance(grant, dict) or set(grant) != {"action", "max_campaigns"}:
            fail("campaign grant request is invalid")
        grant_action = grant.get("action")
        if grant_action not in {"status", "allow-starts", "revoke-starts", "remote-auto-on", "remote-auto-off", "capacity",
                              "browser-isolated-on", "browser-isolated-off", "desktop-isolated-on", "desktop-isolated-off"}:
            fail("campaign grant action is invalid")
        maximum = grant.get("max_campaigns")
        if grant_action == "capacity":
            if not isinstance(maximum, int) or isinstance(maximum, bool) or maximum < 0 or maximum > 16:
                fail("campaign grant capacity is invalid")
        elif maximum is not None:
            fail("campaign grant capacity is unexpected")
    elif grant is not None:
        fail("campaign request has an unexpected grant field")
    default_team = {
        "interface": "campaign", "desktop": "none", "to": "foreman", "message_id": None,
        "attachment": None, "depends": [], "provider": "auto",
        "allowed_providers": [], "effort": None, "token_budget": None,
        "time_budget_seconds": None, "timeout_seconds": 1800, "poll_seconds": 2,
        "test_timeout_seconds": 900, "test_argv": [], "strategy": "cherry-pick",
        "verifier": None, "graph": None,
    }
    team = doc.get("team")
    if team is None:
        team = default_team
    if not isinstance(team, dict) or set(team) != set(default_team):
        fail("team request fields are invalid")
    if team.get("interface") not in {"campaign", "team"}:
        fail("team request interface is invalid")
    if team.get("desktop") not in {"none", "isolated"}:
        fail("team worker desktop mode is invalid")
    if action != "start" and (doc.get("browser") != "none" or team["desktop"] != "none"):
        fail("worker GUI modes are available only when starting a task")
    if team.get("to") != "foreman":
        fail("broker requests address workers by request name; peer --to is worker-only")
    message_id = team.get("message_id")
    if action == "ack":
        if not ID_RE.fullmatch(str(message_id or "")):
            fail("team acknowledgement message identity is invalid")
    elif message_id is not None:
        fail("team message identity is unexpected")
    attachment = team.get("attachment")
    if attachment is not None and (action != "send" or not isinstance(attachment, str) or not relative_path(attachment)):
        fail("team attachment path is invalid")
    depends = team.get("depends")
    if not isinstance(depends, list) or len(depends) > 64 or any(
            not NAME_RE.fullmatch(str(item)) or item == name for item in depends):
        fail("team task dependencies are invalid")
    if action != "start" and depends:
        fail("team dependencies are available only when starting a task")
    if team.get("provider") not in {"auto", "gpt", "gemini", "remote", "local", "openrouter"}:
        fail("team provider constraint is invalid")
    providers = team.get("allowed_providers")
    if not isinstance(providers, list) or len(providers) > 5 or any(
            item not in {"gpt", "gemini", "remote", "local", "openrouter"} for item in providers):
        fail("team allowed-provider constraints are invalid")
    effort = team.get("effort")
    if effort is not None and effort not in {"minimal", "low", "medium", "high", "xhigh", "max", "ultra"}:
        fail("team effort is invalid")
    for field, maximum in (("token_budget", 10**12), ("time_budget_seconds", 10**9)):
        value = team.get(field)
        if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value < 1 or value > maximum):
            fail(f"team {field.replace('_', ' ')} is invalid")
    if action != "start" and (
        team["provider"] != "auto" or providers or effort is not None or
        team["token_budget"] is not None or team["time_budget_seconds"] is not None
    ):
        fail("team provider, effort, and budget fields are start-only")
    for field, minimum, maximum in (("timeout_seconds", 0, 10**9), ("poll_seconds", 1, 100000),
                                    ("test_timeout_seconds", 1, 1000000)):
        value = team.get(field)
        if not isinstance(value, int) or isinstance(value, bool) or not minimum <= value <= maximum:
            fail(f"team {field.replace('_', ' ')} is invalid")
    argv = team.get("test_argv")
    if not isinstance(argv, list) or len(argv) > 256 or any(
            not isinstance(item, str) or not item or len(item) > 4096 or "\0" in item for item in argv):
        fail("team test command is invalid")
    if action != "test" and argv:
        fail("team test command is unexpected")
    verifier = team.get("verifier")
    if verifier is not None and (
            action != "start" or not isinstance(verifier, str) or not relative_path(verifier)
            or verifier == ".sandcodex" or verifier.startswith(".sandcodex/")):
        fail("team verifier must be a start-only tracked project-relative path outside .sandcodex")
    if team.get("strategy") not in {"cherry-pick", "merge"}:
        fail("team adoption strategy is invalid")
    if action != "adopt" and team["strategy"] != "cherry-pick":
        fail("team adoption strategy is unexpected")
    graph = team.get("graph")
    if action == "graph":
        if not isinstance(graph, dict):
            fail("team graph document is invalid")
    elif graph is not None:
        fail("team graph document is unexpected")
    doc["team"] = team
    return doc


def relative_path(value):
    if not value or value.startswith("/") or len(value) > 1024 or "\0" in value or "\n" in value or "\r" in value:
        return False
    return all(component not in {"", ".", ".."} for component in value.split("/"))


def dependency_state(context, dependencies, expected_run):
    if not dependencies:
        return "ready", []
    by_name = {
        principal["name"]: principal
        for _root, principal in campaign_roots(context)
        if principal.get("parent_run_id") == expected_run
    }
    missing = [name for name in dependencies if name not in by_name]
    if missing:
        fail("team task depends on unknown worker(s): " + ", ".join(missing))
    failed = [name for name in dependencies if by_name[name].get("status") in TERMINAL
              and by_name[name].get("status") != "completed"]
    if failed:
        return "failed", failed
    pending = [name for name in dependencies if by_name[name].get("status") != "completed"]
    return ("blocked", pending) if pending else ("ready", [])


def team_prompt(request, source_worktree, base_commit, provider_route):
    prompt = request["prompt"] + (
        "\n\nSandcodex team channel: you are worker " + request["name"] + ". "
        "The interactive foreman remains live and must be able to reason with you while you work. "
        "Before substantive work, send a concise plan with `sandcodex-team reply --message 'PLAN'`. "
        "At every turn boundary and after each material finding, test, decision, or blocker, send a "
        "progress report containing current focus, evidence, and next step; do not save all reporting "
        "for the final turn. Check `sandcodex-team inbox` at the start of every turn, acknowledge "
        "messages you act on, and use `--to WORKER` for a peer. When the assignment is genuinely "
        "complete, commit useful work and call `sandcodex-team complete --message 'FINAL REPORT'` "
        "with exact verification and remaining uncertainty; this ends an unbounded worker "
        "successfully after the current turn."
    )
    verifier_path = request.get("team", {}).get("verifier")
    if verifier_path:
        prompt += (
            "\n\nAdoption gate: the foreman sealed the tracked verifier "
            f"{verifier_path!r} from base commit {base_commit}. Your checkout "
            "cannot replace that input. Commit the candidate, finish the worker, and ask the "
            "foreman to run `sandcodex-team test " + request["name"] + "`; only a passing "
            "sealed receipt for the exact candidate and campaign epoch can authorize adoption."
        )
    excluded = source_worktree["dirty_paths_excluded"]
    if excluded:
        prompt += (
            f"\n\nSource snapshot: the foreman's primary worktree had {excluded} uncommitted "
            f"path(s) when this worker started. This clean clone intentionally begins at "
            f"commit {base_commit} and cannot see those uncommitted changes. Do not assume "
            "they were discarded or overwrite them; coordinate with the foreman if the task "
            "depends on work newer than that commit."
        )
    if provider_route == "openrouter":
        prompt += (
            "\n\nProvider boundary: this is an isolated OpenRouter worker selected from the "
            "qualified free tool-capable bank. Keep the assignment narrow and evidence-driven. "
            "Do not request credentials or attempt to start another worker; report uncertain "
            "claims and exact verification results to the foreman for review."
        )
    return prompt


def turns_authorized(turns, maximum):
    """Zero means unbounded for both a worker request and launch authority."""
    if turns == 0:
        return maximum == 0
    return maximum == 0 or turns <= maximum


def create_campaign(authority, request):
    authority = validate_authority(authority)
    grants = authority["worker_grants"]
    if not grants["starts_enabled"]:
        fail("companion worker starts are currently revoked by the interactive command room")
    if not turns_authorized(request["turns"], authority["max_turns"]):
        requested = "unbounded" if request["turns"] == 0 else str(request["turns"])
        permitted = "unbounded" if authority["max_turns"] == 0 else str(authority["max_turns"])
        fail(f"campaign asks for {requested} turns; launch authority permits {permitted}")
    team = request["team"]
    provider_route, inference = selected_worker_inference(authority, team["provider"])
    actual_provider = inference["mode"]
    if actual_provider == "remote" and inference.get("auto", {}).get("enabled") and not grants["remote_auto_enabled"]:
        fail("remote-auto companion worker selection is currently revoked by the interactive command room")
    if team["allowed_providers"] and provider_route not in team["allowed_providers"]:
        fail(f"team task does not allow this room's {provider_route!r} provider route")
    for mode, field in ((request["browser"], "browser_modes"), (team["desktop"], "desktop_modes")):
        if mode not in grants[field]:
            fail(f"worker {field.removesuffix('_modes')} mode {mode!r} is not currently granted")
    trusted, workspaces = roots(authority)
    with directory_lock(trusted, "project campaign registry"):
        existing = campaign_roots(authority)
        for root, principal in existing:
            principal, _ = refresh(authority, root, principal)
            if principal["name"] == request["name"]:
                fail(f"campaign name {request['name']!r} already exists for this project")
        active = sum(1 for root, principal in existing if refresh(authority, root, principal)[0]["status"] in ACTIVE)
        dependency_status, dependency_detail = dependency_state(
            authority, team["depends"], authority["run_id"])
        capacity_available = grants["max_campaigns"] > 0 and active < grants["max_campaigns"]
        if team["interface"] == "campaign" and not capacity_available:
            fail(f"companion capacity is exhausted ({active}/{grants['max_campaigns']})")

        top = source_git(authority, ["rev-parse", "--show-toplevel"]).stdout.strip()
        if canonical(top) != authority["project"]:
            fail("campaign source Git worktree does not match the selected project")
        alternates = os.path.join(authority["source_git"]["git_dir"], "objects", "info", "alternates")
        if os.path.lexists(alternates):
            fail("campaign source Git repository uses an external object alternates file")
        gitlinks = managed_gitlink_count(authority)
        if gitlinks:
            fail(
                "managed campaign source contains "
                f"{gitlinks} embedded Git repository entr{'y' if gitlinks == 1 else 'ies'}; "
                "restart Sandcodex with the exact repository root selected as the project"
            )
        dirty = source_git(
            authority, [
                "status", "--porcelain=v1", "--untracked-files=all", "--", ".",
                ":(exclude,top).sandcodex/**",
            ]
        ).stdout
        initial_dirty_count = len([line for line in dirty.splitlines() if line.strip()])
        if dirty and authority["source_git"]["mode"] == "managed":
            source_git(
                authority,
                [
                    "-c", "core.fsmonitor=false",
                    "-c", f"core.hooksPath={authority['source_git']['git_dir']}/no-hooks",
                    "add", "-A", "--", ".",
                ],
            )
            gitlinks = managed_gitlink_count(authority)
            if gitlinks:
                fail(
                    "managed campaign snapshot found "
                    f"{gitlinks} embedded Git repository entr{'y' if gitlinks == 1 else 'ies'}; "
                    "restart Sandcodex with the exact repository root selected as the project"
                )
            staged = source_git(authority, ["diff", "--cached", "--quiet"], check=False)
            if staged.returncode not in {0, 1}:
                fail("managed campaign source Git snapshot diff failed")
            if staged.returncode == 1:
                source_git(
                    authority,
                    [
                        "-c", "user.name=Sandcodex Agent",
                        "-c", "user.email=sandcodex@localhost",
                        "commit", "--quiet",
                        "-m", "Snapshot Sandcodex managed worktree for companion",
                    ],
                )
            dirty = source_git(
                authority, [
                    "status", "--porcelain=v1", "--untracked-files=all", "--", ".",
                    ":(exclude,top).sandcodex/**",
                ]
            ).stdout
        if dirty and authority["source_git"]["mode"] == "managed":
            count = len([line for line in dirty.splitlines() if line.strip()])
            fail(
                "campaign could not seal the managed primary Git snapshot "
                f"({count} changed path(s) remain)"
            )
        base_result = source_git(
            authority,
            ["rev-parse", "--verify", f"{request['base']}^{{commit}}"],
            check=False,
        )
        if base_result.returncode:
            fail(
                "campaign start requires a committed primary Git base; make an initial commit, "
                "choose --base REV, or launch from a directory without native .git so Sandcodex "
                "can create its managed scratch baseline"
            )
        base = base_result.stdout.strip()
        source_worktree = {
            "mode": authority["source_git"]["mode"],
            "base_policy": (
                "managed-snapshot" if authority["source_git"]["mode"] == "managed"
                and initial_dirty_count else "committed-base"
            ),
            "dirty_paths_observed": initial_dirty_count,
            "dirty_paths_included": (
                initial_dirty_count if authority["source_git"]["mode"] == "managed" else 0
            ),
            "dirty_paths_excluded": (
                initial_dirty_count if authority["source_git"]["mode"] == "native" else 0
            ),
        }
        object_format = source_git(authority, ["rev-parse", "--show-object-format"]).stdout.strip()
        if object_format not in {"sha1", "sha256"}:
            fail("campaign source Git object format is unsupported")
        resolved_verifier = resolve_campaign_verifier(
            authority, base, team.get("verifier"), object_format,
        )

        campaign_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(8)
        root = os.path.join(trusted, campaign_id)
        workspace_parent = os.path.join(workspaces, campaign_id)
        os.mkdir(root, 0o700)
        os.mkdir(workspace_parent, 0o700)
        try:
            verifier = install_campaign_verifier(root, resolved_verifier)
        except BaseException:
            shutil.rmtree(root)
            os.rmdir(workspace_parent)
            raise
        workspace = os.path.join(workspace_parent, "repo")
        prompt_path = os.path.join(root, "prompt")
        remote_auto_worker = bool(
            actual_provider == "remote"
            and inference.get("auto", {}).get("enabled")
        )
        initial_status = (
            "blocked_failed" if dependency_status == "failed" else
            "blocked_dependencies" if dependency_status == "blocked" else
            "blocked_capacity" if not capacity_available else "preparing"
        )
        principal = {
            "schema": PRINCIPAL_SCHEMA,
            "campaign_id": campaign_id,
            "root_campaign_id": campaign_id,
            "parent_principal_id": None,
            "parent_run_id": authority["run_id"],
            "project": authority["project"],
            "project_key": authority["project_key"],
            "name": request["name"],
            "epoch": 1,
            "status": initial_status,
            "base_commit": base,
            "verifier": verifier,
            "verification": None,
            "source_worktree": source_worktree,
            "object_format": object_format,
            "workspace": workspace,
            "workspace_id": campaign_id,
            "turn_counter": TURN_COUNTER,
            "turn_limit": request["turns"],
            "inference_mode": actual_provider,
            "provider_route": provider_route,
            "remote_auto_worker": remote_auto_worker,
            "remote_auto_retry_policy": dict(REMOTE_AUTO_WORKER_RETRY_POLICY) if remote_auto_worker else None,
            "automatic_restarts": 0,
            "automatic_restart_limit": REMOTE_AUTO_BROKER_REPLAY_POLICY["restart_limit"],
            "automatic_restart_launch_failures": 0,
            "automatic_restart_next_at": None,
            "retry_count": 0,
            "next_attempt_at": None,
            "last_exit": None,
            "worker_model": None,
            "worker_usage": None,
            "provider_constraint": team["provider"],
            "allowed_providers": team["allowed_providers"],
            "effort": team["effort"],
            "dependencies": team["depends"],
            "dependency_detail": dependency_detail,
            "budgets": {"tokens": team["token_budget"], "time_seconds": team["time_budget_seconds"]},
            "browser": {"mode": request["browser"], "realm": campaign_id if request["browser"] == "isolated" else None},
            "desktop": {"mode": team["desktop"], "realm": campaign_id if team["desktop"] == "isolated" else None},
            "created_at": now(),
            "updated_at": now(),
        }
        save_principal(root, principal)
        rendered_prompt = team_prompt(request, source_worktree, base, provider_route)
        atomic_bytes(prompt_path, rendered_prompt.encode())
        append_event(
            root, "accepted", campaign_id=campaign_id, name=request["name"],
            parent_run_id=authority["run_id"], base_commit=base,
            source_worktree=source_worktree,
            turn_counter=TURN_COUNTER, turn_limit=request["turns"], browser=request["browser"],
            desktop=team["desktop"], dependencies=team["depends"],
            provider_constraint=team["provider"], effort=team["effort"],
            token_budget=team["token_budget"], time_budget_seconds=team["time_budget_seconds"],
            inference_mode=actual_provider, provider_route=provider_route,
            verifier=({
                "schema": verifier["schema"],
                "source_path": verifier["source_path"],
                "expected_base": verifier["expected_base"],
                "blob_oid": verifier["blob_oid"],
                "input_sha256": verifier["input_sha256"],
                "input_bytes": verifier["input_bytes"],
            } if verifier else None),
            prompt_sha256=hashlib.sha256(request["prompt"].encode()).hexdigest(),
            prompt_bytes=len(request["prompt"].encode()),
        )
        try:
            git(
                authority,
                [
                    "clone", "--no-hardlinks", "--no-checkout", "--no-tags", "--",
                    authority["source_git"]["git_dir"], workspace,
                ],
                timeout=600,
            )
            git(authority, ["checkout", "--detach", base], cwd=workspace)
            git(authority, ["switch", "-c", f"sandcodex-campaign/{campaign_id}"], cwd=workspace)
            git(authority, ["remote", "remove", "origin"], cwd=workspace, check=False)
            alternates = os.path.join(workspace, ".git", "objects", "info", "alternates")
            if os.path.lexists(alternates):
                fail("campaign clone unexpectedly shares a Git object store")
            cloned = git(authority, ["rev-parse", "--verify", "HEAD^{commit}"], cwd=workspace).stdout.strip()
            if cloned != base:
                fail("campaign clone does not match the sealed base commit")
            principal["status"] = initial_status if initial_status in BLOCKED | {"blocked_failed"} else "queued"
            save_principal(root, principal)
            append_event(
                root, "workspace-ready", base_commit=base, object_format=object_format,
                source_worktree=source_worktree,
            )
            if principal["status"] == "queued":
                launch_worker(authority, root, principal, prompt_path)
            else:
                append_event(root, "scheduled", status=principal["status"], detail=dependency_detail)
        except BaseException as error:
            exhausted = storage_error(error)
            principal["status"] = "storage_hold" if exhausted else "failed"
            principal["failure"] = str(error)
            try:
                save_principal(root, principal)
                append_event(
                    root, "quota-exhausted" if exhausted else "launch-failed",
                    error=str(error), storage=storage_status(authority),
                )
            except OSError:
                pass
            if exhausted:
                fail(
                    "campaign storage quota exhausted; existing evidence is held for operator review",
                    "quota_exhausted",
                )
            raise
    return status_result(authority, root, principal)


def run_control(context, principal, action, prompt=None):
    command = [context["launcher"], "loop", action, "--project", principal["workspace"], "--json"]
    message_path = None
    if prompt is not None:
        root, _ = find_campaign(context, principal["name"], principal.get("parent_run_id"))
        messages = os.path.join(root, "messages")
        if not os.path.exists(messages):
            os.mkdir(messages, 0o700)
        checked_dir(messages, "campaign message root")
        message_path = os.path.join(messages, f"{int(time.time() * 1000000)}-{secrets.token_hex(4)}")
        atomic_bytes(message_path, prompt.encode())
        command.extend(["--message-file", message_path])
    environment = launcher_environment(context)
    try:
        completed = subprocess.run(
            command, env=environment, text=True, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=180, check=False,
        )
    finally:
        if message_path:
            try:
                os.unlink(message_path)
            except FileNotFoundError:
                pass
    if completed.returncode:
        detail = completed.stderr.strip().splitlines()
        fail(f"campaign {action} failed ({completed.returncode}): {detail[-1] if detail else 'launcher refusal'}")
    return completed


def force_stop_worker_unit(context, principal):
    """Stop the exact sealed worker unit when its loop controller is unavailable."""
    unit = principal.get("worker_unit")
    if not isinstance(unit, str):
        fail("campaign worker has no sealed systemd unit for forced revocation")
    environment = launcher_environment(context)

    def systemctl(arguments, timeout=60):
        try:
            return subprocess.run(
                [context["systemctl"], "--user", *arguments],
                env=environment, text=True, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                timeout=timeout, check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            fail(f"campaign worker unit control is unavailable: {error}")

    def inactive():
        state = systemctl(["is-active", "--quiet", unit], timeout=30)
        if state.returncode in {3, 4}:
            return True
        if state.returncode == 0:
            return False
        detail = state.stderr.strip().splitlines()
        fail(
            "campaign worker unit state could not be verified"
            + (f": {detail[-1][:600]}" if detail else "")
        )

    stopped = systemctl(["stop", unit])
    if inactive():
        return "systemd-stop"

    # A failed or incomplete graceful stop must not leave a revoked GUI realm
    # alive. The unit name was sealed into the validated campaign principal,
    # so this fallback cannot be redirected to an arbitrary host unit.
    killed = systemctl(["kill", "--kill-whom=all", "--signal=KILL", unit])
    systemctl(["stop", unit])
    if inactive():
        return "systemd-kill"
    details = []
    for completed in (stopped, killed):
        if completed.returncode and completed.stderr.strip():
            details.append(completed.stderr.strip().splitlines()[-1][:300])
    fail(
        "revoked campaign worker unit remained active"
        + (f": {' | '.join(details)}" if details else "")
    )


def marker_fields(path, label):
    path = checked_file(path, label, 64 * 1024)
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        fail(f"{label} is unreadable: {error}")
    result = {}
    for line in lines:
        if "=" not in line:
            fail(f"{label} contains a malformed field")
        key, value = line.split("=", 1)
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", key) or key in result:
            fail(f"{label} contains an invalid field")
        result[key] = value
    return result


def mount_path(value):
    return re.sub(
        r"\\([0-7]{3})",
        lambda match: chr(int(match.group(1), 8)),
        value,
    )


def reject_mounts(path, label):
    path = os.path.abspath(path)
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8") as stream:
            for line in stream:
                fields = line.split()
                if len(fields) < 5:
                    fail("kernel mount inventory is malformed")
                mounted = mount_path(fields[4])
                if mounted == path or mounted.startswith(path + os.sep):
                    fail(f"{label} contains a mounted filesystem: {mounted}")
    except OSError as error:
        fail(f"kernel mount inventory is unavailable: {error}")


def removable_directory(path, label, expected_parent=None, trusted=True):
    path = os.path.abspath(path)
    if expected_parent is not None and os.path.dirname(path) != expected_parent:
        fail(f"{label} is outside its expected parent")
    if canonical(path) != path:
        fail(f"{label} contains a symlink component")
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return None
    except OSError as error:
        fail(f"{label} is unavailable: {error}")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail(f"{label} metadata is invalid")
    if trusted and stat.S_IMODE(info.st_mode) != 0o700:
        fail(f"{label} permissions are invalid")
    reject_mounts(path, label)
    return path


def remove_tree(path, label):
    if removable_directory(path, label, trusted=False) is None:
        return False
    if not getattr(shutil.rmtree, "avoids_symlink_attacks", False):
        fail("this Python runtime cannot remove campaign trees without symlink-race protection")
    try:
        os.chmod(path, 0o700, follow_symlinks=False)
        for current, directories, _ in os.walk(path, topdown=True, followlinks=False):
            for name in directories:
                candidate = os.path.join(current, name)
                try:
                    info = os.lstat(candidate)
                    if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
                        os.chmod(candidate, 0o700, follow_symlinks=False)
                except FileNotFoundError:
                    pass
        shutil.rmtree(path)
        descriptor = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
    except OSError as error:
        fail(f"{label} could not be removed safely: {error}")
    return True


def require_inactive_unit(context, unit):
    environment = launcher_environment(context)
    try:
        completed = subprocess.run(
            [context["systemctl"], "--user", "is-active", "--quiet", unit],
            env=environment, text=True, stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"campaign worker unit state is unavailable: {error}")
    if completed.returncode == 0:
        fail("campaign removal requires an inactive worker unit")
    if completed.returncode not in {3, 4}:
        detail = completed.stderr.strip().splitlines()
        fail(
            "campaign worker unit state could not be verified"
            + (f": {detail[-1]}" if detail else "")
        )


def campaign_removal_plan(context, root, principal):
    principal, state = refresh(context, root, principal)
    if principal["status"] in ACTIVE:
        fail("campaign removal requires a stopped or terminal worker")
    if state and pid_matches(state.get("pid"), state.get("process_start")):
        fail("campaign removal refuses a live worker process")

    worker_key = project_key(principal["workspace"])
    workspace_parent = os.path.dirname(principal["workspace"])
    expected_workspace_parent = os.path.join(
        context["workspace_root"], context["project_key"], principal["campaign_id"]
    )
    if workspace_parent != expected_workspace_parent:
        fail("campaign workspace parent identity is invalid")
    workspace_registry = checked_dir(
        os.path.join(context["workspace_root"], context["project_key"]),
        "project campaign workspace registry",
    )
    removable_directory(
        workspace_parent, "campaign workspace container",
        expected_parent=workspace_registry, trusted=True,
    )
    if os.path.isdir(workspace_parent):
        unexpected = set(os.listdir(workspace_parent)) - {"repo"}
        if unexpected:
            fail("campaign workspace container has unexpected entries")
        removable_directory(
            principal["workspace"], "campaign workspace",
            expected_parent=workspace_parent, trusted=False,
        )

    worker_control = os.path.join(context["worker_global_root"], "projects", worker_key)
    if os.path.lexists(worker_control):
        checked_dir(os.path.join(context["worker_global_root"], "projects"), "project control registry")
        removable_directory(
            worker_control, "campaign worker control state",
            expected_parent=os.path.join(context["worker_global_root"], "projects"), trusted=True,
        )
        owner = marker_fields(os.path.join(worker_control, "OWNER"), "campaign worker control marker")
        if owner != {
            "schema": context["state_schema"],
            "kind": "project-control",
            "uid": str(os.getuid()),
            "project": principal["workspace"],
            "project_key": worker_key,
        }:
            fail("campaign worker control marker does not match its principal")

    supervisor_id = principal.get("supervisor_id")
    supervisor_root = None
    supervisor_registry = os.path.join(context["worker_global_root"], "supervisors", worker_key)
    if supervisor_id is not None:
        if not ID_RE.fullmatch(str(supervisor_id)):
            fail("campaign worker supervisor identity is invalid")
        unit = principal.get("worker_unit")
        if not isinstance(unit, str):
            fail("campaign worker unit identity is missing")
        require_inactive_unit(context, unit)
        if os.path.lexists(supervisor_registry):
            checked_dir(os.path.join(context["worker_global_root"], "supervisors"), "supervisor registry")
            removable_directory(
                supervisor_registry, "campaign worker supervisor registry",
                expected_parent=os.path.join(context["worker_global_root"], "supervisors"), trusted=True,
            )
            unexpected = set(os.listdir(supervisor_registry)) - {supervisor_id}
            if unexpected:
                fail("campaign worker supervisor registry has unexpected entries")
            supervisor_root = os.path.join(supervisor_registry, supervisor_id)
            if os.path.lexists(supervisor_root):
                removable_directory(
                    supervisor_root, "campaign worker supervisor",
                    expected_parent=supervisor_registry, trusted=True,
                )
                marker = marker_fields(
                    os.path.join(supervisor_root, "OWNER"), "campaign worker supervisor marker"
                )
                if marker.get("schema") != "sandcodex.supervisor.v1" or \
                   marker.get("id") != supervisor_id or \
                   marker.get("project") != principal["workspace"] or \
                   marker.get("uid") != str(os.getuid()) or \
                   not KEY_RE.fullmatch(marker.get("artifact_sha256", "")):
                    fail("campaign worker supervisor marker does not match its principal")
                spec = load_json(
                    os.path.join(supervisor_root, "spec.json"),
                    "campaign worker supervisor specification",
                    256 * 1024,
                )
                if spec.get("schema") != "sandcodex.supervisor.v1" or \
                   spec.get("id") != supervisor_id or \
                   spec.get("project") != principal["workspace"] or \
                   spec.get("recover_on_boot") is not False:
                    fail("campaign worker supervisor specification does not match its principal")

    return {
        "schema": CAMPAIGN_SCHEMA,
        "campaign_id": principal["campaign_id"],
        "name": principal["name"],
        "status": principal["status"],
        "workspace": workspace_parent,
        "worker_control": worker_control,
        "supervisor": supervisor_root,
        "evidence": root,
    }


def remove_campaign_plan(plan):
    if plan["supervisor"]:
        remove_tree(plan["supervisor"], "campaign worker supervisor")
        try:
            os.rmdir(os.path.dirname(plan["supervisor"]))
        except OSError:
            pass
    remove_tree(plan["worker_control"], "campaign worker control state")
    remove_tree(plan["workspace"], "campaign workspace container")
    try:
        os.rmdir(os.path.dirname(plan["workspace"]))
    except OSError:
        pass
    remove_tree(plan["evidence"], "campaign principal evidence")
    return {**plan, "removed": True, "dry_run": False}


def sc_observe_collection_event(send_event, *, expected_errors=()):
    """Call ``send_event`` once and return ``(row_or_none, observation)``.

    Only specific ordinary exception types supplied by the reviewed caller are
    demoted. Cancellation, process exit, programming errors, and every failure
    before durable publication continue to propagate. No retry is attempted.
    Exception text, paths and dynamic payloads are not copied into evidence.
    """
    if not callable(send_event):
        raise ValueError("collection_event_callback_must_be_callable")
    if not isinstance(expected_errors, tuple) or any(
        not isinstance(kind, type) or not issubclass(kind, Exception)
        or kind in (Exception, BaseException) for kind in expected_errors
    ):
        raise ValueError("collection_event_expected_errors_must_be_specific")
    observation = {
        "schema": "sandcodex.collection-event-observation.v1",
        "status": "unknown",
        "append_attempted": True,
        "append_returned_success": None,
        "retry_performed": False,
        "error_category": None,
    }
    try:
        row = send_event()
    except expected_errors:
        observation["error_category"] = "event_append_failed"
        return None, observation
    observation["status"] = "recorded"
    observation["append_returned_success"] = True
    return row, observation


def collect(context, root, principal, output):
    principal, _ = refresh(context, root, principal)
    if principal["status"] in ACTIVE:
        fail("campaign collection requires a stopped or terminal worker")
    workspace = principal["workspace"]
    base = principal["base_commit"]
    head = git(context, ["rev-parse", "--verify", "HEAD^{commit}"], cwd=workspace).stdout.strip()
    verification = campaign_verification_state(root, principal, head)
    if git(context, ["merge-base", "--is-ancestor", base, head], cwd=workspace, check=False).returncode:
        fail("campaign head is not descended from its sealed base")
    if git(
        context, ["diff", "--no-ext-diff", "--no-textconv", "--quiet", "--exit-code"],
        cwd=workspace, check=False,
    ).returncode or git(
        context, ["diff", "--cached", "--no-ext-diff", "--no-textconv", "--quiet", "--exit-code"],
        cwd=workspace, check=False,
    ).returncode:
        fail("campaign collection requires committed tracked changes")
    untracked = [
        line for line in git(context, ["ls-files", "--others", "--exclude-standard"], cwd=workspace).stdout.splitlines()
        if not line.startswith(".sandcodex/")
    ]
    if untracked:
        fail(f"campaign collection requires committed files; {len(untracked)} untracked path(s) remain")

    project = context["project"]
    parent_descriptor, artifact_name = open_project_parent(project, output)
    receipt_name = artifact_name + ".receipt.json"
    destination = os.path.join(project, output)
    receipt_destination = destination + ".receipt.json"
    for name in (artifact_name, receipt_name):
        try:
            os.stat(name, dir_fd=parent_descriptor, follow_symlinks=False)
        except FileNotFoundError:
            continue
        else:
            os.close(parent_descriptor)
            fail("campaign collection destination or receipt already exists")

    staged = None
    try:
        fd, staged = tempfile.mkstemp(prefix=".campaign-artifact.", dir=root)
        os.close(fd)
        if head == base:
            artifact_format = "no-change-json"
            atomic_bytes(staged, json_bytes({"schema": CAMPAIGN_SCHEMA, "campaign_id": principal["campaign_id"], "base_commit": base, "head_commit": head}))
        else:
            artifact_format = "git-bundle"
            os.unlink(staged)
            git(context, ["bundle", "create", staged, "HEAD", f"^{base}"], cwd=workspace, timeout=600)
            os.chmod(staged, 0o600)
            git(context, ["bundle", "verify", staged], cwd=workspace)
        artifact_sha = digest_file(staged)
        artifact_bytes = os.path.getsize(staged)
        receipt_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(6)
        receipt = {
            "schema": RECEIPT_SCHEMA,
            "receipt_id": receipt_id,
            "campaign_id": principal["campaign_id"],
            "name": principal["name"],
            "project_key": principal["project_key"],
            "parent_run_id": principal["parent_run_id"],
            "base_commit": base,
            "candidate_commit": head,
            "object_format": principal["object_format"],
            "worktree_clean": True,
            "verification": verification,
            "artifact": {"format": artifact_format, "sha256": artifact_sha, "bytes": artifact_bytes},
            "turn_counter": TURN_COUNTER,
            "turn_limit": principal["turn_limit"],
            "successful_turns": principal.get("successful_turns", 0),
            "counters": {
                TURN_COUNTER: {
                    "limit": principal["turn_limit"],
                    "attempted": principal.get("attempts", 0),
                    "successful": principal.get("successful_turns", 0),
                },
                "chatgpt_submissions": None,
                "campaign_episodes": None,
                "jail_actions": None,
            },
            "status": principal["status"],
            "inference": {
                "mode": principal.get("inference_mode", "gpt"),
                "route": principal.get("provider_route", principal.get("inference_mode", "gpt")),
                "model": principal.get("worker_model"),
                "usage": principal.get("worker_usage"),
            },
            "browser": principal.get("browser", {"mode": "none"}),
            "desktop": principal.get("desktop", {"mode": "none"}),
            "storage": storage_status(context),
            "collected_at": now(),
        }
        receipts = os.path.join(root, "receipts")
        if not os.path.exists(receipts):
            os.mkdir(receipts, 0o700)
        checked_dir(receipts, "campaign receipt root")
        trusted_receipt = os.path.join(receipts, receipt_id + ".json")
        copy_exclusive_at(staged, parent_descriptor, artifact_name)
        try:
            write_exclusive_at(parent_descriptor, receipt_name, json_bytes(receipt))
            atomic_json(trusted_receipt, receipt, replace=False)
        except BaseException:
            for name in (artifact_name, receipt_name):
                try:
                    os.unlink(name, dir_fd=parent_descriptor)
                except FileNotFoundError:
                    pass
            raise
        os.fsync(parent_descriptor)
        # Artifact and receipts are already published and the destination
        # directory has been fsynced. A bounded-ledger or I/O failure here must
        # not make that committed collection look safe to repeat.
        _event, event_observation = sc_observe_collection_event(
            lambda: append_event(
                root, "collected", receipt_id=receipt_id, base_commit=base,
                candidate_commit=head, artifact_sha256=artifact_sha,
                artifact_bytes=artifact_bytes,
            ),
            expected_errors=(CampaignError, OSError),
        )
        return {
            "campaign_id": principal["campaign_id"], "name": principal["name"],
            "artifact": os.path.relpath(destination, project),
            "receipt": os.path.relpath(receipt_destination, project),
            "receipt_id": receipt_id, "artifact_sha256": artifact_sha,
            "artifact_bytes": artifact_bytes, "base_commit": base, "candidate_commit": head,
            "inference": receipt["inference"],
            "adopted": False,
            "collection_committed": True,
            "event_observation": event_observation,
        }
    finally:
        os.close(parent_descriptor)
        if staged is not None:
            try:
                os.unlink(staged)
            except FileNotFoundError:
                pass


def open_project_parent(project, relative):
    components = relative.split("/")
    try:
        descriptor = os.open(
            project, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
        )
    except OSError as error:
        fail(f"campaign collection project root is unavailable: {error}")
    try:
        for component in components[:-1]:
            try:
                child = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=descriptor,
                )
            except OSError as error:
                fail(f"campaign collection parent is unavailable: {error}")
            info = os.fstat(child)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
                os.close(child)
                fail("campaign collection parent metadata is invalid")
            os.close(descriptor)
            descriptor = child
        return descriptor, components[-1]
    except BaseException:
        os.close(descriptor)
        raise


def copy_exclusive_at(source, parent_descriptor, name):
    try:
        source_fd = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError as error:
        fail(f"campaign artifact staging file is unavailable: {error}")
    try:
        try:
            destination_fd = os.open(
                name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=parent_descriptor,
            )
        except OSError as error:
            fail(f"campaign artifact destination is unavailable: {error}")
        try:
            while True:
                chunk = os.read(source_fd, 1024 * 1024)
                if not chunk:
                    break
                remaining = memoryview(chunk)
                while remaining:
                    written = os.write(destination_fd, remaining)
                    if written <= 0:
                        fail("campaign artifact copy made no progress")
                    remaining = remaining[written:]
            os.fsync(destination_fd)
        finally:
            os.close(destination_fd)
    finally:
        os.close(source_fd)


def write_exclusive_at(parent_descriptor, name, payload):
    try:
        descriptor = os.open(
            name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
            0o600,
            dir_fd=parent_descriptor,
        )
    except OSError as error:
        fail(f"campaign receipt destination is unavailable: {error}")
    try:
        remaining = memoryview(payload)
        while remaining:
            written = os.write(descriptor, remaining)
            if written <= 0:
                fail("campaign receipt write made no progress")
            remaining = remaining[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def events(root, cursor):
    path = os.path.join(root, "events.jsonl")
    rows = []
    if os.path.exists(path):
        checked_file(path, "campaign event ledger", 64 * 1024 * 1024)
        with open(path, "r", encoding="utf-8") as stream:
            for index, line in enumerate(stream):
                if index < cursor:
                    continue
                if len(rows) >= 256:
                    break
                try:
                    value = json.loads(line)
                except json.JSONDecodeError:
                    fail("campaign event ledger has a corrupt record")
                rows.append(value)
    return {"events": rows, "cursor": cursor, "next_cursor": cursor + len(rows)}


def team_rows(context, expected_run=None, refresh_each=True):
    rows = []
    for root, principal in campaign_roots(context):
        if expected_run is not None and principal.get("parent_run_id") != expected_run:
            continue
        with directory_lock(root, "campaign principal root"):
            principal = load_principal(root, context)
            if refresh_each:
                principal, _ = refresh(context, root, principal)
            rows.append((root, principal))
    rows.sort(key=lambda item: (item[1]["created_at"], item[1]["campaign_id"]))
    return rows


def team_inbox(context, expected_run=None, worker_name=None):
    messages = []
    for root, principal in team_rows(context, expected_run):
        if worker_name is not None and principal["name"] != worker_name:
            continue
        acknowledgements = team_records(root, "message-acks.jsonl")
        acked = {(row.get("message_id"), row.get("by")) for row in acknowledgements}
        for row in team_records(root, "messages.jsonl"):
            if row.get("to") != "foreman":
                continue
            messages.append({
                **row,
                "worker": principal["name"],
                "acknowledged": (row.get("message_id"), "foreman") in acked,
            })
    messages.sort(key=lambda row: (str(row.get("created_at", "")), str(row.get("message_id", ""))))
    return {
        "schema": TEAM_MESSAGE_SCHEMA,
        "messages": messages,
        "unread": sum(1 for row in messages if not row["acknowledged"]),
        "workers": len({row["worker"] for row in messages}),
    }


def team_ack(context, expected_run, message_id):
    matches = []
    for root, principal in team_rows(context, expected_run):
        for row in team_records(root, "messages.jsonl"):
            if row.get("message_id") == message_id and row.get("to") == "foreman":
                matches.append((root, principal, row))
    if not matches:
        fail(f"no foreman message {message_id!r} exists")
    if len(matches) != 1:
        fail("team message identity is ambiguous")
    root, principal, message = matches[0]
    with directory_lock(root, "campaign principal root"):
        existing = {
            (row.get("message_id"), row.get("by"))
            for row in team_records(root, "message-acks.jsonl")
        }
        changed = (message_id, "foreman") not in existing
        if changed:
            append_team_record(os.path.join(root, "message-acks.jsonl"), {
                "schema": TEAM_MESSAGE_SCHEMA,
                "message_id": message_id,
                "by": "foreman",
                "at": now(),
            })
            append_event(root, "team-message-acknowledged", message_id=message_id, by="foreman")
    return {
        "schema": TEAM_MESSAGE_SCHEMA,
        "message_id": message_id,
        "worker": principal["name"],
        "changed": changed,
        "message": message,
    }


def observed_worker_grants(context):
    if isinstance(context.get("worker_grants"), dict):
        return worker_grant_summary(context)
    authority_path = context.get("authority_path")
    if not isinstance(authority_path, str) or not authority_path.startswith("/"):
        return None
    try:
        os.lstat(authority_path)
    except FileNotFoundError:
        return None
    authority = validate_authority(
        load_json(authority_path, "campaign launch authority", 256 * 1024),
        require_live=False,
    )
    for field in ("project", "project_key", "campaign_root", "workspace_root", "artifact_sha256"):
        if authority.get(field) != context.get(field):
            fail("campaign launch authority does not match the operator context")
    return worker_grant_summary(authority)


def team_top(context, expected_run=None):
    campaigns = []
    by_status = {}
    by_provider = {}
    total_tokens = input_tokens = cached_tokens = output_tokens = unread = 0
    for root, principal in team_rows(context, expected_run, refresh_each=False):
        status = status_result(context, root, principal)
        campaigns.append(status)
        by_status[status["status"]] = by_status.get(status["status"], 0) + 1
        provider = status.get("provider_route", status.get("inference_mode", "gpt"))
        by_provider[provider] = by_provider.get(provider, 0) + 1
        usage = status.get("worker_usage") or {}
        total_tokens += int(usage.get("total_tokens", 0) or 0)
        input_tokens += int(usage.get("input_tokens", 0) or 0)
        cached_tokens += int(usage.get("cached_input_tokens", 0) or 0)
        output_tokens += int(usage.get("output_tokens", 0) or 0)
        unread += int(status.get("mailbox", {}).get("to_foreman_unread", 0) or 0)
    grants = observed_worker_grants(context)
    return {
        "schema": "sandcodex.team-top.v1",
        "campaigns": campaigns,
        "totals": {
            "workers": len(campaigns),
            "active": sum(1 for row in campaigns if row["status"] in ACTIVE),
            "blocked": sum(1 for row in campaigns if row["status"] in BLOCKED),
            "terminal": sum(1 for row in campaigns if row["status"] in TERMINAL),
            "unread_messages": unread,
            "usage": {
                "input_tokens": input_tokens,
                "cached_input_tokens": cached_tokens,
                "output_tokens": output_tokens,
                "total_tokens": total_tokens,
            },
        },
        "by_status": by_status,
        "by_provider": by_provider,
        "grants": grants,
        "generated_at": now(),
    }


def team_wait_any(context, expected_run=None):
    top = team_top(context, expected_run)
    ready = [row for row in top["campaigns"] if row["status"] in TERMINAL]
    ready.sort(key=lambda row: (row["updated_at"], row["campaign_id"]))
    return {
        "schema": "sandcodex.team-wait-any.v1",
        "ready": ready,
        "pending": [row for row in top["campaigns"] if row["status"] not in TERMINAL],
        "totals": top["totals"],
    }


def team_ack_evidence(context, root, principal, messages):
    def ack_counts(directory):
        reader = globals().get("iter_team_records")
        rows = reader(directory, "message-acks.jsonl") if reader is not None \
            else team_records(directory, "message-acks.jsonl")
        counts = {}
        for row in rows:
            key = (row.get("message_id"), row.get("by"))
            counts[key] = counts.get(key, 0) + 1
        return counts

    inbound = [row for row in messages if row.get("to") == principal.get("name")]
    local_counts = ack_counts(root)
    peer_campaigns = {
        row.get("campaign_id") for row in inbound
        if row.get("from") != "foreman"
        and row.get("campaign_id") != principal.get("campaign_id")
        and isinstance(row.get("campaign_id"), str)
    }
    source_index = {campaign_id: [] for campaign_id in peer_campaigns}
    registry_state = "available"
    if peer_campaigns:
        try:
            for candidate_root, candidate in campaign_roots(context):
                campaign_id = candidate.get("campaign_id")
                if (campaign_id in source_index
                        and candidate.get("parent_run_id") == principal.get("parent_run_id")):
                    source_index[campaign_id].append(candidate_root)
        except (CampaignError, OSError):
            registry_state = "read_error"

    source_cache = {}
    evidence = []
    summary = {}
    for row in inbound:
        message_id = row.get("message_id")
        actor = principal.get("name")
        local_count = local_counts.get((message_id, actor), 0)
        peer = (row.get("from") != "foreman"
                and row.get("campaign_id") != principal.get("campaign_id"))
        source_state = "not_applicable"
        source_count = None
        if peer:
            campaign_id = row.get("campaign_id")
            if registry_state != "available":
                source_state = registry_state
            elif not isinstance(campaign_id, str) or campaign_id not in source_index:
                source_state = "unavailable"
            else:
                matches = source_index[campaign_id]
                if not matches:
                    source_state = "unavailable"
                elif len(matches) != 1:
                    source_state = "ambiguous"
                else:
                    source_root = matches[0]
                    if source_root not in source_cache:
                        try:
                            source_cache[source_root] = ("available", ack_counts(source_root))
                        except (CampaignError, OSError):
                            source_cache[source_root] = ("read_error", {})
                    source_state, counts = source_cache[source_root]
                    if source_state == "available":
                        source_count = counts.get((message_id, actor), 0)
                        source_state = "duplicate" if source_count > 1 else ("present" if source_count == 1 else "missing")

        if local_count > 1 or source_state == "duplicate":
            state = "duplicate_evidence"
        elif not peer:
            state = "acknowledged" if local_count == 1 else "unacknowledged"
        elif source_state in ("unavailable", "ambiguous", "read_error"):
            state = "source_" + source_state
        elif local_count == 1 and source_state == "present":
            state = "mirrored"
        elif local_count == 1 and source_state == "missing":
            state = "local_only"
        elif local_count == 0 and source_state == "present":
            state = "source_only"
        else:
            state = "unacknowledged"
        summary[state] = summary.get(state, 0) + 1
        evidence.append({
            "message_id": message_id,
            "from": row.get("from"),
            "local_ack_count": local_count,
            "source_mirror": source_state,
            "source_ack_count": source_count,
            "state": state,
        })
    return {
        "schema": "sandcodex.team-ack-evidence.v1",
        "scope": "inbound messages in the returned 64-message attachment tail",
        "messages": evidence,
        "counts": dict(sorted(summary.items())),
        "registry_state": registry_state,
        "meaning": "journal evidence only; not proof that a worker read, understood, or acted on a message",
        "automatic_repair_or_resend": False,
    }


def team_attach(context, root, principal, cursor):
    from collections import deque
    status = status_result(context, root, principal)
    event_rows = events(root, cursor)
    # Consume the whole ledger, preserving validation even outside the tail.
    messages = list(deque(iter_team_records(root, "messages.jsonl"), maxlen=64))
    acknowledgements = list(deque(iter_team_records(root, "message-acks.jsonl"), maxlen=128))
    acknowledgement_evidence = team_ack_evidence(context, root, principal, messages)
    return {
        "schema": "sandcodex.team-attach.v1",
        "status": status,
        "events": event_rows["events"],
        "cursor": event_rows["cursor"],
        "next_cursor": event_rows["next_cursor"],
        "messages": messages,
        "acknowledgements": acknowledgements,
        "acknowledgement_evidence": acknowledgement_evidence,
    }


def checked_workspace(context, principal):
    workspace = os.path.abspath(principal["workspace"])
    expected_parent = os.path.join(context["workspace_root"], context["project_key"], principal["campaign_id"])
    if canonical(workspace) != workspace or os.path.dirname(workspace) != expected_parent:
        fail("campaign workspace path changed identity")
    try:
        info = os.lstat(workspace)
    except OSError as error:
        fail(f"campaign workspace is unavailable: {error}")
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o022:
        fail("campaign workspace metadata is unsafe")
    return workspace


def verify_candidate(context, root, principal, require_terminal=True):
    principal, _ = refresh(context, root, principal)
    if require_terminal and principal["status"] not in TERMINAL:
        fail("team review requires a stopped or terminal worker")
    workspace = checked_workspace(context, principal)
    base = principal["base_commit"]
    head = git(context, ["rev-parse", "--verify", "HEAD^{commit}"], cwd=workspace).stdout.strip()
    if git(context, ["merge-base", "--is-ancestor", base, head], cwd=workspace, check=False).returncode:
        fail("team candidate head is not descended from its sealed base")
    for arguments in (
        ["diff", "--no-ext-diff", "--no-textconv", "--quiet", "--exit-code"],
        ["diff", "--cached", "--no-ext-diff", "--no-textconv", "--quiet", "--exit-code"],
    ):
        result = git(context, arguments, cwd=workspace, check=False)
        if result.returncode not in {0, 1}:
            fail("team candidate cleanliness check failed")
        if result.returncode == 1:
            fail("team review requires committed tracked changes")
    untracked = [
        line for line in git(
            context, ["ls-files", "--others", "--exclude-standard"], cwd=workspace
        ).stdout.splitlines()
        if line and not line.startswith(".sandcodex/")
    ]
    if untracked:
        fail(f"team review requires committed files; {len(untracked)} untracked path(s) remain")
    commits = [
        line for line in git(
            context, ["rev-list", "--reverse", "--topo-order", f"{base}..{head}"], cwd=workspace
        ).stdout.splitlines() if line
    ]
    return principal, workspace, base, head, commits


def public_verifier_descriptor(verifier):
    if verifier is None:
        return None
    return {
        "schema": verifier["schema"],
        "source_path": verifier["source_path"],
        "expected_base": verifier["expected_base"],
        "blob_oid": verifier["blob_oid"],
        "input_sha256": verifier["input_sha256"],
        "input_bytes": verifier["input_bytes"],
        "interpreter": verifier["interpreter"],
    }


def campaign_verification_decision(principal, head, receipt=None):
    """Pure adoption decision over an immutable principal, candidate, and receipt."""
    base = principal["base_commit"]
    epoch = principal["epoch"]
    verifier = principal.get("verifier")
    common = {
        "schema": TEAM_VERIFICATION_SCHEMA,
        "configured": verifier is not None,
        "required": head != base,
        "candidate_commit": head,
        "principal_epoch": epoch,
        "test_id": None,
        "receipt_sha256": None,
        "verified_at": None,
    }
    if head == base:
        state = {**common, "state": "not-required-no-change", "adoption_eligible": True}
    elif verifier is None:
        state = {**common, "state": "unconfigured", "adoption_eligible": False}
    else:
        summary = principal.get("verification")
        if summary is None:
            state = {**common, "state": "missing", "adoption_eligible": False}
        elif (summary["principal_epoch"] != epoch or summary["base_commit"] != base
              or summary["candidate_commit"] != head):
            state = {
                **common, "state": "stale", "adoption_eligible": False,
                "test_id": summary["test_id"],
                "receipt_sha256": summary["receipt_sha256"],
                "verified_at": summary["verified_at"],
            }
        else:
            if receipt is None:
                fail("sealed verification receipt is missing for the durable campaign principal")
            result = receipt.get("result")
            valid = (
                receipt.get("schema") == TEAM_TEST_SCHEMA
                and receipt.get("test_id") == summary["test_id"]
                and receipt.get("campaign_id") == principal["campaign_id"]
                and receipt.get("name") == principal["name"]
                and receipt.get("principal_epoch") == epoch
                and receipt.get("base_commit") == base
                and receipt.get("candidate_commit") == head
                and receipt.get("verification_mode") == "sealed"
                and receipt.get("verifier") == public_verifier_descriptor(verifier)
                and isinstance(result, dict)
                and set(result) == {"schema", "state", "passed", "sha256", "bytes"}
                and result.get("schema") == VERIFIER_RESULT_SCHEMA
                and result.get("state") in {"valid", "missing", "invalid", "unsafe"}
                and isinstance(result.get("passed"), bool)
                and (result.get("sha256") is None
                     or KEY_RE.fullmatch(str(result.get("sha256", ""))) is not None)
                and isinstance(result.get("bytes"), int)
                and not isinstance(result.get("bytes"), bool)
                and 0 <= result["bytes"] <= 64 * 1024
                and (not result["passed"] or result["state"] == "valid")
                and receipt.get("status") == summary["status"]
                and receipt.get("adoption_eligible") == summary["passed"]
                and summary["passed"] == (receipt.get("status") == "passed" and result["passed"])
            )
            if not valid:
                fail("sealed verification receipt fields do not match the durable campaign principal")
            state = {
                **common,
                "state": "passed" if summary["passed"] else summary["status"],
                "adoption_eligible": summary["passed"],
                "test_id": summary["test_id"],
                "receipt_sha256": summary["receipt_sha256"],
                "verified_at": summary["verified_at"],
            }
    return state


def campaign_verification_state(root, principal, head, require=False):
    """Gather sealed evidence, then apply the pure campaign adoption decision."""
    receipt = None
    summary = principal.get("verification")
    if summary is not None and (
        summary["principal_epoch"] == principal["epoch"]
        and summary["base_commit"] == principal["base_commit"]
        and summary["candidate_commit"] == head
    ):
        receipt = load_json(
            summary["receipt_path"], "sealed verification receipt", 4 * 1024 * 1024,
        )
    state = campaign_verification_decision(principal, head, receipt)
    if require and not state["adoption_eligible"]:
        if state["state"] == "unconfigured":
            fail(
                "team adoption requires a sealed verifier; start a new worker with "
                "--verifier TRACKED_SHELL"
            )
        fail(
            "team adoption requires a passing sealed verification for this exact candidate "
            "and campaign epoch; run sandcodex-team test " + principal["name"]
        )
    return state


def sc_run_bounded_process(argv, *, cwd=None, env=None, timeout=30.0,
                           stdout_limit=524288, stderr_limit=32768,
                           terminate_grace=0.15):
    """Run argv; stop on a deadline or either stream exceeding its byte cap.

    Return a dict with byte prefixes, exit code, duration and explicit flags.
    The cap is a *retained-output* limit, not a kernel-level output prohibition.
    Process launch and pathological uninterruptible kernel waits cannot have a
    hard real-time guarantee. POSIX only; memory is O(stdout_limit+stderr_limit).
    A process group is always used so ordinary inherited children are stopped.
    env=None inherits the caller environment: integrations with secrets must
    instead supply the same minimal environment used by the original helper.
    """
    import math
    import os
    import selectors
    import signal
    import subprocess
    import time

    if os.name != "posix":
        raise RuntimeError("sc_run_bounded_process requires POSIX")
    if not isinstance(argv, (list, tuple)) or not argv:
        raise ValueError("argv must be a nonempty list or tuple")
    if not all(isinstance(arg, str) and "\x00" not in arg for arg in argv):
        raise ValueError("argv must contain NUL-free strings")
    for label, value in (("timeout", timeout), ("terminate_grace", terminate_grace)):
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
            raise ValueError(label + " must be positive and finite")
    for label, value in (("stdout_limit", stdout_limit), ("stderr_limit", stderr_limit)):
        if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 64 * 1024 * 1024:
            raise ValueError(label + " must be an integer in [0, 67108864]")

    began = time.monotonic()
    deadline = began + float(timeout)
    process = subprocess.Popen(
        list(argv), cwd=cwd, env=env, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
    )
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    limits = {"stdout": stdout_limit, "stderr": stderr_limit}
    exceeded = {"stdout": False, "stderr": False}
    timed_out = False
    stopped = False
    kill_at = None
    killed = False
    selector = selectors.DefaultSelector()

    def signal_group(sig):
        # Even if the direct child exited, a child may still hold a pipe open.
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            pass

    def request_stop():
        nonlocal stopped, kill_at
        if not stopped:
            stopped = True
            kill_at = time.monotonic() + float(terminate_grace)
            signal_group(signal.SIGTERM)

    try:
        for label, stream in (("stdout", process.stdout), ("stderr", process.stderr)):
            assert stream is not None
            os.set_blocking(stream.fileno(), False)
            selector.register(stream, selectors.EVENT_READ, label)

        # Continue after direct-child exit while inherited pipes remain open.
        while selector.get_map() or process.poll() is None:
            now = time.monotonic()
            if not stopped and now >= deadline:
                timed_out = True
                request_stop()
            if stopped and kill_at is not None and now >= kill_at:
                signal_group(signal.SIGKILL)
                killed = True
                # Pipes held outside the group must not prolong our read loop.
                break
            next_deadline = kill_at if stopped else deadline
            delay = max(0.0, min(0.05, next_deadline - time.monotonic()))
            for key, _mask in selector.select(delay):
                label = key.data
                try:
                    chunk = os.read(key.fileobj.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not chunk:
                    selector.unregister(key.fileobj)
                    key.fileobj.close()
                    continue
                remaining = limits[label] - len(buffers[label])
                buffers[label].extend(chunk[:max(0, remaining)])
                if len(chunk) > remaining:
                    exceeded[label] = True
                    request_stop()

        # If pipes closed on TERM, still stop ordinary descendants in the group.
        if stopped and not killed:
            signal_group(signal.SIGKILL)
        try:
            process.wait(timeout=float(terminate_grace) + 1.0)
        except subprocess.TimeoutExpired as exc:
            signal_group(signal.SIGKILL)
            # Do not misreport an unreaped process as a successful bounded run.
            raise RuntimeError("child did not exit after group termination") from exc
    finally:
        for key in list(selector.get_map().values()):
            selector.unregister(key.fileobj)
            key.fileobj.close()
        selector.close()
        if process.poll() is None:
            signal_group(signal.SIGKILL)
            try:
                process.wait(timeout=float(terminate_grace) + 1.0)
            except subprocess.TimeoutExpired:
                pass  # The exception / caller's outer supervisor remains authoritative.

    return {
        "stdout": bytes(buffers["stdout"]), "stderr": bytes(buffers["stderr"]),
        "returncode": process.returncode, "timed_out": timed_out,
        "stdout_limited": exceeded["stdout"], "stderr_limited": exceeded["stderr"],
        "duration_seconds": time.monotonic() - began,
    }


def git_prefix(context, arguments, cwd, maximum):
    executable = canonical(context.get("git") or shutil.which("git", path=context.get("host_path", "")) or "")
    if not os.path.isfile(executable) or not os.access(executable, os.X_OK):
        fail("trusted Git executable is unavailable")
    environment = {
        "PATH": context["host_path"], "HOME": context["engine_home"], "LC_ALL": "C",
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_SYSTEM": "/dev/null",
        "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_ATTR_NOSYSTEM": "1",
        "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0",
        "GIT_NO_REPLACE_OBJECTS": "1", "GIT_PAGER": "cat",
    }
    command = [
        executable, "-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false",
        "-c", "core.attributesFile=/dev/null", "-c", "credential.helper=",
        "-c", "protocol.ext.allow=never", "-c", "protocol.file.allow=always", *arguments,
    ]
    result = sc_run_bounded_process(
        command, cwd=cwd, env=environment, timeout=30.0,
        stdout_limit=maximum, stderr_limit=32768,
    )
    if result["timed_out"]:
        fail("Git prefix operation exceeded its 30-second deadline")
    if result["stderr_limited"]:
        fail("Git prefix operation exceeded its bounded diagnostic-output limit")
    truncated = result["stdout_limited"]
    if not truncated and result["returncode"]:
        detail = result["stderr"].decode("utf-8", "replace").strip().splitlines()
        fail(f"Git command failed ({result['returncode']}): {detail[-1] if detail else arguments[0]}")
    return result["stdout"].decode("utf-8", "replace"), truncated


def team_diff(context, root, principal):
    principal, workspace, base, head, commits = verify_candidate(context, root, principal)
    stat_text = git(
        context, ["diff", "--stat", "--summary", "--find-renames", f"{base}..{head}"], cwd=workspace
    ).stdout
    names = git(
        context, ["diff", "--name-status", "--find-renames", f"{base}..{head}"], cwd=workspace
    ).stdout.splitlines()
    patch, truncated = git_prefix(
        context,
        ["diff", "--no-ext-diff", "--no-textconv", "--find-renames", "--full-index", f"{base}..{head}"],
        workspace, 512 * 1024,
    )
    return {
        "schema": "sandcodex.team-diff.v1",
        "name": principal["name"], "campaign_id": principal["campaign_id"],
        "base_commit": base, "candidate_commit": head, "commits": commits,
        "changed_paths": names, "stat": stat_text, "patch": patch,
        "patch_truncated": truncated, "snapshot_at": now(),
    }


def private_child(parent, name, label):
    parent = checked_dir(parent, f"{label} parent")
    path = os.path.join(parent, name)
    if not os.path.exists(path):
        os.mkdir(path, 0o700)
    return checked_dir(path, label)


def stage_candidate(context, root, principal):
    principal, workspace, base, head, commits = verify_candidate(context, root, principal)
    verification = campaign_verification_state(root, principal, head)
    stages = private_child(root, "stages", "team stage root")
    stage_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(6)
    artifact = os.path.join(stages, stage_id + (".json" if head == base else ".bundle"))
    if head == base:
        atomic_json(artifact, {
            "schema": TEAM_STAGE_SCHEMA, "kind": "no-change", "base_commit": base,
            "candidate_commit": head,
        }, replace=False)
        artifact_format = "no-change-json"
    else:
        git(context, ["bundle", "create", artifact, "HEAD", f"^{base}"], cwd=workspace, timeout=600)
        os.chmod(artifact, 0o600)
        checked_file(artifact, "team stage artifact", 64 * 1024 * 1024 * 1024)
        git(context, ["bundle", "verify", artifact], cwd=workspace)
        artifact_format = "git-bundle"
    receipt = {
        "schema": TEAM_STAGE_SCHEMA, "stage_id": stage_id,
        "campaign_id": principal["campaign_id"], "name": principal["name"],
        "parent_run_id": principal["parent_run_id"], "base_commit": base,
        "candidate_commit": head, "commits": commits, "worktree_clean": True,
        "verification": verification,
        "artifact": {"format": artifact_format, "sha256": digest_file(artifact),
                     "bytes": os.path.getsize(artifact), "path": artifact},
        "inference": {"mode": principal.get("inference_mode"),
                      "route": principal.get("provider_route", principal.get("inference_mode")),
                      "model": principal.get("worker_model"),
                      "usage": principal.get("worker_usage")},
        "browser": principal.get("browser", {"mode": "none"}),
        "desktop": principal.get("desktop", {"mode": "none"}),
        "created_at": now(),
    }
    receipt_path = os.path.join(stages, stage_id + ".receipt.json")
    atomic_json(receipt_path, receipt, replace=False)
    append_event(root, "team-staged", stage_id=stage_id, candidate_commit=head,
                 artifact_sha256=receipt["artifact"]["sha256"])
    return {**receipt, "receipt": receipt_path}


def safe_test_path(context):
    entries = []
    for item in context.get("host_path", "").split(":"):
        if not item:
            continue
        resolved = canonical(item)
        if resolved.startswith("/nix/store/") and os.path.isdir(resolved) and resolved not in entries:
            entries.append(resolved)
    if not entries:
        fail("team test could not construct a Nix-store-only PATH")
    return ":".join(entries)


def stop_process_group(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def sc_team_test_output_accounting(stdout_bytes, stderr_bytes, *,
                                   already_limited=False,
                                   combined_limit=2 * 1024 * 1024,
                                   preview_limit=512 * 1024):
    for name, value in (('stdout_bytes', stdout_bytes), ('stderr_bytes', stderr_bytes),
                        ('combined_limit', combined_limit), ('preview_limit', preview_limit)):
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise ValueError(name + ' must be a nonnegative integer')
    if not isinstance(already_limited, bool):
        raise ValueError('already_limited must be boolean')
    total = stdout_bytes + stderr_bytes
    return {
        'schema': 'sandcodex.team-test-output-observation.v1',
        'stdout_bytes_observed': stdout_bytes,
        'stderr_bytes_observed': stderr_bytes,
        'combined_bytes_observed': total,
        'combined_limit_bytes': combined_limit,
        'preview_limit_bytes_per_stream': preview_limit,
        'limit_observed_while_running': already_limited,
        'limit_observed_at_final_size_check': total > combined_limit,
        'output_limited': already_limited or total > combined_limit,
        'stdout_preview_truncated': stdout_bytes > preview_limit,
        'stderr_preview_truncated': stderr_bytes > preview_limit,
        'size_observation_scope': 'post_direct_child_exit_not_atomic_log_snapshot',
        'hard_disk_bound_enforced': False,
    }


def read_sealed_verifier_result(path):
    public = {
        "schema": VERIFIER_RESULT_SCHEMA,
        "state": "missing",
        "passed": False,
        "sha256": None,
        "bytes": 0,
    }
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return public
    except OSError:
        return {**public, "state": "unsafe"}
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o022
            or not 1 <= info.st_size <= 64 * 1024):
        return {**public, "state": "unsafe", "bytes": max(0, info.st_size)}
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
        try:
            opened = os.fstat(descriptor)
            if (opened.st_dev, opened.st_ino, opened.st_size) != (info.st_dev, info.st_ino, info.st_size):
                return {**public, "state": "unsafe", "bytes": info.st_size}
            payload = b""
            while len(payload) < info.st_size:
                chunk = os.read(descriptor, info.st_size - len(payload))
                if not chunk:
                    break
                payload += chunk
        finally:
            os.close(descriptor)
    except OSError:
        return {**public, "state": "unsafe", "bytes": info.st_size}
    digest = hashlib.sha256(payload).hexdigest()
    observed = {**public, "sha256": digest, "bytes": len(payload)}
    if len(payload) != info.st_size:
        return {**observed, "state": "unsafe"}
    try:
        result = json.loads(payload.decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError):
        return {**observed, "state": "invalid"}
    if (not isinstance(result, dict) or set(result) != {"schema", "passed"}
            or result.get("schema") != VERIFIER_RESULT_SCHEMA
            or not isinstance(result.get("passed"), bool)):
        return {**observed, "state": "invalid"}
    return {**observed, "state": "valid", "passed": result["passed"]}


def team_test(context, root, principal, argv, timeout_seconds):
    principal, workspace, base, head, commits = verify_candidate(context, root, principal)
    sealed = not argv
    verifier = principal.get("verifier")
    if sealed and verifier is None:
        fail(
            "this campaign has no sealed verifier; use `sandcodex-team test NAME -- COMMAND` "
            "for a diagnostic, or start a new worker with --verifier TRACKED_SHELL"
        )
    tests = private_child(root, "test-runs", "team test root")
    test_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(6)
    run_root = os.path.join(tests, test_id)
    os.mkdir(run_root, 0o700)
    repo = os.path.join(run_root, "repo")
    stdout_path = os.path.join(run_root, "stdout")
    stderr_path = os.path.join(run_root, "stderr")
    result_path = os.path.join(run_root, "result.json")
    try:
        bwrap = canonical(shutil.which("bwrap", path=context.get("host_path", "")) or "")
        if not os.path.isfile(bwrap) or not os.access(bwrap, os.X_OK):
            fail("team test requires the pinned bubblewrap runtime")
        git(context, ["clone", "--no-hardlinks", "--no-checkout", "--no-tags", "--", workspace, repo], timeout=600)
        git(context, ["checkout", "--detach", head], cwd=repo)
        git(context, ["remote", "remove", "origin"], cwd=repo, check=False)
        path = safe_test_path(context)
        sandbox = [
            bwrap, "--unshare-user", "--unshare-pid", "--unshare-net", "--unshare-ipc", "--unshare-uts",
            "--hostname", "sandcodex-team-test", "--new-session", "--die-with-parent", "--cap-drop", "ALL",
            "--ro-bind", "/nix/store", "/nix/store", "--proc", "/proc", "--dev", "/dev",
            "--tmpfs", "/tmp", "--dir", "/home", "--dir", "/home/sandcodex",
            "--bind", repo, "/work", "--clearenv", "--setenv", "HOME", "/home/sandcodex",
            "--setenv", "TMPDIR", "/tmp", "--setenv", "PATH", path,
            "--setenv", "LANG", "C.UTF-8", "--setenv", "LC_ALL", "C.UTF-8",
            "--setenv", "PYTHONSAFEPATH", "1", "--setenv", "PYTHONDONTWRITEBYTECODE", "1",
            "--setenv", "NO_COLOR", "1",
        ]
        if sealed:
            bash = canonical(shutil.which("bash", path=path) or "")
            if not bash.startswith("/nix/store/") or not os.path.isfile(bash) or not os.access(bash, os.X_OK):
                fail("sealed verification requires pinned Bash in the Nix-store-only PATH")
            result_descriptor = os.open(
                result_path,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
            os.close(result_descriptor)
            sandbox.extend([
                "--dir", "/verify", "--ro-bind", verifier["input_path"], "/verify/input.sh",
                "--dir", "/result", "--bind", result_path, "/result/result.json",
                "--setenv", "SANDCODEX_EXPECTED_BASE", base,
                "--setenv", "SANDCODEX_CANDIDATE_COMMIT", head,
                "--setenv", "SANDCODEX_CAMPAIGN_ID", principal["campaign_id"],
                "--setenv", "SANDCODEX_PRINCIPAL_EPOCH", str(principal["epoch"]),
                "--setenv", "SANDCODEX_VERIFICATION_RESULT", "/result/result.json",
            ])
            child_argv = [bash, "/verify/input.sh"]
        else:
            child_argv = argv
        command = [*sandbox, "--chdir", "/work", "--", *child_argv]
        timed_out = output_limited = False
        started = time.monotonic()
        with open(stdout_path, "wb") as stdout_stream, open(stderr_path, "wb") as stderr_stream:
            os.chmod(stdout_path, 0o600)
            os.chmod(stderr_path, 0o600)
            process = subprocess.Popen(
                command, stdin=subprocess.DEVNULL, stdout=stdout_stream, stderr=stderr_stream,
                start_new_session=True,
            )
            deadline = started + timeout_seconds
            while process.poll() is None:
                if os.path.getsize(stdout_path) + os.path.getsize(stderr_path) > 2 * 1024 * 1024:
                    output_limited = True
                    stop_process_group(process)
                    break
                if time.monotonic() >= deadline:
                    timed_out = True
                    stop_process_group(process)
                    break
                time.sleep(0.05)
            returncode = process.returncode
        duration = max(0.0, time.monotonic() - started)
        output_observation = sc_team_test_output_accounting(
            os.path.getsize(stdout_path), os.path.getsize(stderr_path),
            already_limited=output_limited,
        )
        output_limited = output_observation["output_limited"]
        result = (
            read_sealed_verifier_result(result_path)
            if sealed else None
        )
        passed = (
            returncode == 0 and not timed_out and not output_limited
            and (not sealed or result["state"] == "valid" and result["passed"])
        )
        status = (
            "timeout" if timed_out else "output-limit" if output_limited
            else "passed" if passed else "failed"
        )

        def bounded_text(path):
            with open(path, "rb") as stream:
                return stream.read(512 * 1024).decode("utf-8", "replace")

        def output_fact(path):
            return {
                "sha256": digest_file(path), "bytes": os.path.getsize(path),
                "content_retained": not sealed,
            }

        receipt = {
            "schema": TEAM_TEST_SCHEMA, "test_id": test_id,
            "campaign_id": principal["campaign_id"], "name": principal["name"],
            "principal_epoch": principal["epoch"],
            "base_commit": base, "candidate_commit": head, "commits": commits,
            "verification_mode": "sealed" if sealed else "diagnostic",
            "verifier": public_verifier_descriptor(verifier) if sealed else None,
            "result": result,
            "adoption_eligible": bool(sealed and passed),
            "argv": None if sealed else argv, "timeout_seconds": timeout_seconds,
            "duration_seconds": round(duration, 3), "status": status,
            "exit_code": returncode, "timed_out": timed_out, "output_limited": output_limited,
            "network": "new empty namespace",
            "filesystem": (
                "candidate clone writable; sealed verifier and Nix store read-only; result directory writable"
                if sealed else "candidate clone writable; Nix store read-only"
            ),
            "stdout": None if sealed else bounded_text(stdout_path),
            "stderr": None if sealed else bounded_text(stderr_path),
            "output": {"stdout": output_fact(stdout_path), "stderr": output_fact(stderr_path)},
            "created_at": now(), "output_observation": output_observation,
        }
        receipt_path = os.path.join(tests, test_id + ".receipt.json")
        atomic_json(receipt_path, receipt, replace=False)
        receipt_sha256 = digest_file(receipt_path)
        if sealed:
            principal["verification"] = {
                "schema": TEAM_VERIFICATION_SCHEMA,
                "test_id": test_id,
                "receipt_path": receipt_path,
                "receipt_sha256": receipt_sha256,
                "principal_epoch": principal["epoch"],
                "base_commit": base,
                "candidate_commit": head,
                "status": status,
                "passed": passed,
                "verified_at": receipt["created_at"],
            }
            save_principal(root, principal)
        append_event(
            root, "team-tested", test_id=test_id, candidate_commit=head,
            verification_mode=receipt["verification_mode"], status=status,
            adoption_eligible=receipt["adoption_eligible"], exit_code=returncode,
            duration_seconds=receipt["duration_seconds"], receipt_sha256=receipt_sha256,
        )
        return {**receipt, "receipt": receipt_path, "receipt_sha256": receipt_sha256}
    finally:
        shutil.rmtree(run_root, ignore_errors=True)


def primary_clean(context):
    dirty = source_git(
        context, ["status", "--porcelain=v1", "--untracked-files=all", "--", ".",
                  ":(exclude,top).sandcodex/**"]
    ).stdout
    if dirty:
        count = len([line for line in dirty.splitlines() if line.strip()])
        fail(f"team adoption requires a clean primary Git worktree ({count} changed path(s))")


def sc_observe_adoption_publication(write_receipt, append_event, *, expected_errors=()):
    """Return ``(receipt_result, event_result, observation)``.

    Receipt publication is attempted first.  If its outcome is unknown, the
    event is not attempted because it would advertise a receipt that may not be
    readable.  Only reviewed ordinary exception types are demoted.  Programming
    errors, cancellation and process-exit signals continue to propagate.
    """
    if not callable(write_receipt) or not callable(append_event):
        raise ValueError("adoption_publication_callbacks_must_be_callable")
    if not isinstance(expected_errors, tuple) or any(
        not isinstance(kind, type)
        or not issubclass(kind, Exception)
        or kind in (Exception, BaseException)
        for kind in expected_errors
    ):
        raise ValueError("adoption_publication_expected_errors_must_be_specific")

    observation = {
        "schema": "sandcodex.adoption-publication-observation.v1",
        "adoption_committed": True,
        "receipt": {
            "status": "unknown",
            "attempted": True,
            "returned_success": None,
            "retry_performed": False,
        },
        "event": {
            "status": "not-attempted",
            "attempted": False,
            "returned_success": None,
            "retry_performed": False,
        },
        "inspect_before_repeat": True,
        "error_category": None,
    }

    try:
        receipt_result = write_receipt()
    except expected_errors:
        observation["error_category"] = "receipt_publication_failed"
        return None, None, observation

    observation["receipt"].update({
        "status": "recorded",
        "returned_success": True,
    })
    observation["event"]["attempted"] = True
    observation["event"]["status"] = "unknown"
    try:
        event_result = append_event()
    except expected_errors:
        observation["error_category"] = "event_append_failed"
        return receipt_result, None, observation

    observation["event"].update({
        "status": "recorded",
        "returned_success": True,
    })
    observation["inspect_before_repeat"] = False
    return receipt_result, event_result, observation


def team_adopt(context, root, principal, strategy):
    principal, workspace, base, head, commits = verify_candidate(context, root, principal)
    verification = campaign_verification_state(root, principal, head, require=True)
    primary_clean(context)
    before = source_git(context, ["rev-parse", "--verify", "HEAD^{commit}"]).stdout.strip()
    if source_git(context, ["merge-base", "--is-ancestor", base, before], check=False).returncode:
        fail("primary HEAD no longer descends from the worker's sealed base")
    if head == base:
        result = {
            "schema": "sandcodex.team-adoption.v1", "name": principal["name"],
            "campaign_id": principal["campaign_id"], "strategy": strategy,
            "before_commit": before, "candidate_commit": head, "after_commit": before,
            "commits": [], "changed": False, "verification": verification,
            "created_at": now(),
        }
    else:
        stage = stage_candidate(context, root, principal)
        artifact = stage["artifact"]["path"]
        temporary_ref = f"refs/sandcodex/team/{principal['campaign_id']}-{secrets.token_hex(4)}"
        source_git(context, ["fetch", "--no-tags", artifact, f"{head}:{temporary_ref}"], timeout=600)
        try:
            fetched = source_git(context, ["rev-parse", "--verify", f"{temporary_ref}^{{commit}}"]).stdout.strip()
            if fetched != head:
                fail("staged team candidate changed identity during adoption")
            if strategy == "cherry-pick":
                merges = source_git(
                    context, ["rev-list", "--merges", f"{base}..{temporary_ref}"]
                ).stdout.splitlines()
                if merges:
                    fail("cherry-pick adoption requires a linear worker history; use --strategy merge")
                completed = source_git(
                    context,
                    ["-c", "user.name=Sandcodex Team", "-c", "user.email=sandcodex@localhost",
                     "cherry-pick", *commits], check=False, timeout=600,
                )
                if completed.returncode:
                    source_git(context, ["cherry-pick", "--abort"], check=False)
                    detail = completed.stderr.strip().splitlines()
                    fail("team adoption conflicted and was aborted: " + (detail[-1] if detail else "cherry-pick failed"))
            else:
                completed = source_git(
                    context,
                    ["-c", "user.name=Sandcodex Team", "-c", "user.email=sandcodex@localhost",
                     "merge", "--no-ff", "--no-edit", temporary_ref], check=False, timeout=600,
                )
                if completed.returncode:
                    source_git(context, ["merge", "--abort"], check=False)
                    detail = completed.stderr.strip().splitlines()
                    fail("team adoption conflicted and was aborted: " + (detail[-1] if detail else "merge failed"))
            primary_clean(context)
            after = source_git(context, ["rev-parse", "--verify", "HEAD^{commit}"]).stdout.strip()
        finally:
            source_git(context, ["update-ref", "-d", temporary_ref], check=False)
        result = {
            "schema": "sandcodex.team-adoption.v1", "name": principal["name"],
            "campaign_id": principal["campaign_id"], "strategy": strategy,
            "before_commit": before, "candidate_commit": head, "after_commit": after,
            "commits": commits, "stage_id": stage["stage_id"],
            "stage_sha256": stage["artifact"]["sha256"], "changed": after != before,
            "verification": verification,
            "created_at": now(),
        }
    adoptions = private_child(root, "adoptions", "team adoption receipt root")
    receipt_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(6)
    receipt_path = os.path.join(adoptions, receipt_id + ".json")
    # The primary checkout has already advanced. A bounded receipt or event
    # failure here must not present the adoption as safe to replay.
    _receipt, _event, publication_observation = sc_observe_adoption_publication(
        lambda: (
            atomic_json(
                receipt_path,
                {**result, "receipt_id": receipt_id},
                replace=False,
            ),
            receipt_path,
        )[1],
        lambda: append_event(
            root, "team-adopted", receipt_id=receipt_id, strategy=strategy,
            before_commit=before, candidate_commit=head,
            after_commit=result["after_commit"],
        ),
        expected_errors=(CampaignError, OSError),
    )
    return {
        **result,
        "receipt_id": receipt_id,
        "receipt": (
            receipt_path
            if publication_observation["receipt"]["status"] == "recorded"
            else None
        ),
        "receipt_candidate": receipt_path,
        "adoption_committed": True,
        "publication_observation": publication_observation,
    }


def validate_team_graph(graph, authority):
    if set(graph) != {"schema", "tasks"} or graph.get("schema") != TEAM_GRAPH_SCHEMA:
        fail("team graph schema is invalid")
    tasks = graph.get("tasks")
    if not isinstance(tasks, list) or not tasks or len(tasks) > 64:
        fail("team graph must contain 1 through 64 tasks")
    allowed = {
        "name", "prompt", "turns", "base", "depends", "provider", "allowed_providers",
        "effort", "token_budget", "time_budget_seconds", "browser", "desktop",
        "verifier",
    }
    normalized = []
    names = set()
    for raw in tasks:
        if not isinstance(raw, dict) or not set(raw) <= allowed:
            fail("team graph task fields are invalid")
        name = raw.get("name")
        prompt = raw.get("prompt")
        turns = raw.get(
            "turns", 0 if authority["max_turns"] == 0 else min(12, authority["max_turns"])
        )
        depends = raw.get("depends", [])
        provider = raw.get("provider", "auto")
        providers = raw.get("allowed_providers", [])
        effort = raw.get("effort")
        token_budget = raw.get("token_budget")
        time_budget = raw.get("time_budget_seconds")
        browser = raw.get("browser", "none")
        desktop = raw.get("desktop", "none")
        verifier = raw.get("verifier")
        if not NAME_RE.fullmatch(str(name or "")) or name in names:
            fail("team graph task names must be unique valid worker names")
        if not isinstance(prompt, str) or not prompt.strip() or len(prompt.encode()) > 16384 or "\0" in prompt:
            fail(f"team graph task {name!r} has an invalid prompt")
        if (not isinstance(turns, int) or isinstance(turns, bool) or turns < 0
                or turns > 999999999 or not turns_authorized(turns, authority["max_turns"])):
            fail(f"team graph task {name!r} has an invalid turn count")
        if not isinstance(depends, list) or len(depends) > 64 or len(depends) != len(set(depends)) or any(
                not NAME_RE.fullmatch(str(item)) or item == name for item in depends):
            fail(f"team graph task {name!r} has invalid dependencies")
        if provider not in {"auto", "gpt", "gemini", "remote", "local", "openrouter"}:
            fail(f"team graph task {name!r} has an invalid provider")
        if not isinstance(providers, list) or len(providers) > 5 or any(
                item not in {"gpt", "gemini", "remote", "local", "openrouter"} for item in providers):
            fail(f"team graph task {name!r} has invalid allowed providers")
        if effort is not None and effort not in {"minimal", "low", "medium", "high", "xhigh", "max", "ultra"}:
            fail(f"team graph task {name!r} has invalid effort")
        for value, maximum, label in ((token_budget, 10**12, "token budget"),
                                      (time_budget, 10**9, "time budget")):
            if value is not None and (not isinstance(value, int) or isinstance(value, bool) or not 1 <= value <= maximum):
                fail(f"team graph task {name!r} has an invalid {label}")
        if browser not in {"none", "isolated"} or desktop not in {"none", "isolated"}:
            fail(f"team graph task {name!r} has invalid GUI modes")
        if verifier is not None and (
                not isinstance(verifier, str) or not relative_path(verifier)
                or verifier == ".sandcodex" or verifier.startswith(".sandcodex/")):
            fail(f"team graph task {name!r} has an invalid sealed verifier")
        names.add(name)
        normalized.append({
            "name": name, "prompt": prompt, "turns": turns, "base": raw.get("base", "HEAD"),
            "depends": depends, "provider": provider, "allowed_providers": providers,
            "effort": effort, "token_budget": token_budget,
            "time_budget_seconds": time_budget, "browser": browser, "desktop": desktop,
            "verifier": verifier,
        })
    existing = {
        principal["name"] for _root, principal in campaign_roots(authority)
        if principal.get("parent_run_id") == authority["run_id"]
    }
    if names & existing:
        fail("team graph reuses an existing worker name: " + ", ".join(sorted(names & existing)))
    for task in normalized:
        missing = [name for name in task["depends"] if name not in names and name not in existing]
        if missing:
            fail(f"team graph task {task['name']!r} depends on unknown workers: {', '.join(missing)}")
    by_name = {task["name"]: task for task in normalized}
    visiting = set()
    visited = set()
    order = []
    def visit(name):
        if name in visited:
            return
        if name in visiting:
            fail("team graph contains a dependency cycle")
        visiting.add(name)
        for dependency in by_name[name]["depends"]:
            if dependency in by_name:
                visit(dependency)
        visiting.remove(name)
        visited.add(name)
        order.append(by_name[name])
    for name in sorted(by_name):
        visit(name)
    return order


def create_team_graph(authority, request):
    authority = validate_authority(authority)
    tasks = validate_team_graph(request["team"]["graph"], authority)
    graph_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(6)
    results = []
    for task in tasks:
        child = dict(request)
        child["action"] = "start"
        child["name"] = task["name"]
        child["turns"] = task["turns"]
        child["base"] = task["base"]
        child["browser"] = task["browser"]
        child["prompt"] = task["prompt"]
        child["output"] = None
        child["dry_run"] = False
        child["grant"] = None
        child["team"] = {
            **request["team"], "interface": "team", "desktop": task["desktop"],
            "depends": task["depends"], "provider": task["provider"],
            "allowed_providers": task["allowed_providers"], "effort": task["effort"],
            "token_budget": task["token_budget"], "time_budget_seconds": task["time_budget_seconds"],
            "verifier": task["verifier"], "graph": None, "test_argv": [],
            "attachment": None, "message_id": None,
        }
        result = create_campaign(authority, validate_request(child, authority["run_id"]))
        results.append(result)
    return {"schema": TEAM_GRAPH_SCHEMA, "graph_id": graph_id, "tasks": results, "created_at": now()}


def sc_reconcile_stop_observation(observed_status: str, *, terminal_statuses: object) -> dict[str, object] | None:
    """Return content-free evidence only when retry suppression is justified.

    A terminal observation does not prove the controller request caused it.
    `draining` means a stop transition is already represented durably, but does
    not prove the worker has exited. Other states must propagate the original
    controller error so the caller does not mistake an active worker for a
    stopped one.
    """
    if not isinstance(observed_status, str) or not observed_status:
        raise ValueError("invalid_observed_status")
    if isinstance(terminal_statuses, (str, bytes)):
        raise ValueError("invalid_terminal_statuses")
    terminal = frozenset(terminal_statuses)
    if any(not isinstance(item, str) or not item for item in terminal):
        raise ValueError("invalid_terminal_statuses")
    if observed_status in terminal:
        state = "terminal_observed"
        terminal_observed = True
    elif observed_status == "draining":
        state = "draining_observed"
        terminal_observed = False
    else:
        return None
    return {
        "schema": "sandcodex.campaign-stop-control.v1",
        "request_attempted": True,
        "controller_outcome": "unknown",
        "observation": state,
        "observed_status": observed_status,
        "terminal_observed": terminal_observed,
        "causation_proven": False,
        "retry_performed": False,
    }


def handle_existing(context, request, root, principal):
    action = request["action"]
    if action in {"status", "wait"}:
        return status_result(context, root, principal), "campaign status read"
    if action == "events":
        refresh(context, root, principal)
        return events(root, request["cursor"]), "campaign events read"
    if action == "send":
        if request["team"]["interface"] == "team":
            message, _completed, delivery = foreman_team_message(
                context, root, principal, request["prompt"], request["team"].get("attachment")
            )
            return {
                "schema": TEAM_MESSAGE_SCHEMA,
                "message": message,
                "delivery": delivery,
                "status": status_result(context, root, principal),
            }, ("team message queued; controller nudge outcome unknown; inspect before resending"
                if delivery["nudge"]["status"] == "unknown" else "team message queued")
        completed = run_control(context, principal, "send", request["prompt"])
        append_event(
            root, "message-queued",
            message_sha256=hashlib.sha256(request["prompt"].encode()).hexdigest(),
            message_bytes=len(request["prompt"].encode()),
        )
        return status_result(context, root, principal), "campaign message queued"
    if action == "stop":
        principal, _ = refresh(context, root, principal)
        if principal["status"] in BLOCKED:
            previous = principal["status"]
            principal["status"] = "interrupted"
            save_principal(root, principal)
            append_event(root, "status", previous=previous, status="interrupted")
        elif principal["status"] in ACTIVE | {"paused", "draining"}:
            try:
                run_control(context, principal, "stop")
            except (CampaignError, OSError, subprocess.TimeoutExpired) as error:
                # The launcher subprocess may fail or time out after the worker
                # already changed state. Re-observe exactly once; never resend.
                principal, _ = refresh(context, root, principal)
                evidence = sc_reconcile_stop_observation(
                    principal["status"], terminal_statuses=TERMINAL,
                )
                if evidence is None:
                    raise
                evidence["controller_failure_class"] = (
                    "timeout" if isinstance(error, subprocess.TimeoutExpired)
                    else "launcher_error" if isinstance(error, CampaignError)
                    else "os_error"
                )
                append_event(
                    root, "stop-outcome-reconciled",
                    controller_outcome=evidence["controller_outcome"],
                    controller_failure_class=evidence["controller_failure_class"],
                    observation=evidence["observation"],
                    observed_status=evidence["observed_status"],
                    terminal_observed=evidence["terminal_observed"],
                    causation_proven=False, retry_performed=False,
                )
                result = status_result(context, root, principal)
                result["stop_control"] = evidence
                message = (
                    "campaign stop controller outcome unknown; terminal state observed; no retry performed"
                    if evidence["terminal_observed"]
                    else "campaign stop controller outcome unknown; worker reports draining; inspect before repeating"
                )
                return result, message
        else:
            return status_result(context, root, principal), "campaign was already terminal"
        append_event(root, "stop-requested")
        return status_result(context, root, principal), "campaign stop requested"
    if action == "restart":
        principal, _ = refresh(context, root, principal)
        if principal["status"] not in RESTARTABLE:
            if principal["status"] == "completed":
                fail(
                    "campaign restart is invalid after completion; review, test, stage, or adopt the completed candidate"
                )
            fail("campaign restart requires a stopped or recoverable failed worker")
        blockers = worker_restart_blockers(context, principal)
        if blockers:
            fail("campaign restart is blocked by current worker grants: " + ", ".join(blockers))
        completed = run_control(context, principal, "recover")
        launch = detached_launch_receipt(completed)
        principal["supervisor_id"] = launch["supervisor_id"]
        principal["worker_unit"] = launch["unit"]
        principal["worker_state"] = launch["state_file"]
        principal["status"] = "queued"
        principal["epoch"] = int(principal.get("epoch", 1)) + 1
        principal["started_at"] = now()
        principal.pop("budget_stop_requested", None)
        principal.pop("budget_exhausted", None)
        save_principal(root, principal)
        append_event(root, "restart-requested", epoch=principal["epoch"], automatic_replay=False)
        return status_result(context, root, principal), "campaign restart requested"
    if action == "collect":
        return collect(context, root, principal, request["output"]), "campaign result collected; no changes were adopted"
    if action in {"attach", "inspect"}:
        return team_attach(context, root, principal, request["cursor"]), "team worker inspected"
    if action == "diff":
        return team_diff(context, root, principal), "team candidate diff prepared"
    if action == "test":
        result = team_test(
            context, root, principal, request["team"]["test_argv"],
            request["team"]["test_timeout_seconds"],
        )
        return result, f"team candidate test {result['status']}"
    if action == "stage":
        return stage_candidate(context, root, principal), "team candidate staged; primary checkout unchanged"
    if action == "adopt":
        return team_adopt(context, root, principal, request["team"]["strategy"]), "team candidate explicitly adopted"
    fail("unsupported campaign action")


def maybe_auto_replay_remote_worker(authority, root, principal):
    principal, _ = refresh(authority, root, principal)
    if not principal.get("remote_auto_worker"):
        return
    if principal.get("status") != "retry_exhausted":
        return
    if principal.get("last_error_class") not in {"quota", "transient"}:
        return
    try:
        limit = int(principal.get(
            "automatic_restart_limit", REMOTE_AUTO_BROKER_REPLAY_POLICY["restart_limit"]))
        count = int(principal.get("automatic_restarts", 0))
    except (TypeError, ValueError):
        limit = REMOTE_AUTO_BROKER_REPLAY_POLICY["restart_limit"]
        count = 0
    if not 1 <= limit <= 100:
        limit = REMOTE_AUTO_BROKER_REPLAY_POLICY["restart_limit"]
    count = max(0, min(count, limit))
    next_attempt = principal.get("automatic_restart_next_at")
    if isinstance(next_attempt, str):
        try:
            next_time = datetime.strptime(next_attempt, "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=timezone.utc)
        except ValueError:
            next_time = None
        if next_time is not None and datetime.now(timezone.utc) < next_time:
            return
    signature = json.dumps(
        {
            "status": principal.get("status"),
            "error": principal.get("last_error_class"),
            "epoch": principal.get("epoch"),
            "attempts": principal.get("attempts"),
            "retry_count": principal.get("retry_count"),
            "model": principal.get("worker_model"),
        },
        sort_keys=True, separators=(",", ":"),
    )
    grants = authority.get("worker_grants") if isinstance(authority.get("worker_grants"), dict) else {}
    if count >= limit:
        if principal.get("last_automatic_restart_signature") != "exhausted:" + signature:
            principal["last_automatic_restart_signature"] = "exhausted:" + signature
            save_principal(root, principal)
            append_event(
                root, "automatic-restart-exhausted",
                reason=principal.get("last_error_class"),
                automatic_restarts=count,
                automatic_restart_limit=limit,
            )
        return
    blockers = worker_restart_blockers(authority, principal)
    if blockers:
        if principal.get("last_automatic_restart_signature") != "grant-blocked:" + signature:
            principal["last_automatic_restart_signature"] = "grant-blocked:" + signature
            save_principal(root, principal)
            append_event(
                root, "automatic-restart-skipped",
                reason="worker-grant-blocked",
                blockers=blockers,
                starts_enabled=grants.get("starts_enabled", True),
                remote_auto_enabled=grants.get("remote_auto_enabled", True),
            )
        return
    if principal.get("last_automatic_restart_signature") == "launched:" + signature:
        return
    try:
        completed = run_control(authority, principal, "recover")
        launch = detached_launch_receipt(completed)
    except CampaignError as error:
        try:
            prior_failures = int(principal.get("automatic_restart_launch_failures", 0))
        except (TypeError, ValueError):
            prior_failures = 0
        failures = max(0, min(prior_failures, 100)) + 1
        attempted = count + 1
        delay = min(
            REMOTE_AUTO_BROKER_REPLAY_POLICY["launch_failure_max_seconds"],
            REMOTE_AUTO_BROKER_REPLAY_POLICY["launch_failure_base_seconds"]
            * (2 ** min(failures - 1, 20)),
        )
        principal["automatic_restarts"] = attempted
        principal["automatic_restart_launch_failures"] = failures
        principal["automatic_restart_next_at"] = (
            datetime.fromtimestamp(time.time() + delay, timezone.utc).strftime(
                "%Y-%m-%dT%H:%M:%SZ")
            if attempted < limit else None
        )
        principal["last_automatic_restart_signature"] = "failed:" + signature
        save_principal(root, principal)
        append_event(
            root, "automatic-restart-failed",
            reason=principal.get("last_error_class"),
            error=str(error),
            automatic_restarts=attempted,
            automatic_restart_limit=limit,
            launch_failures=failures,
            retry_after_seconds=(delay if attempted < limit else None),
        )
        return
    principal["supervisor_id"] = launch["supervisor_id"]
    principal["worker_unit"] = launch["unit"]
    principal["worker_state"] = launch["state_file"]
    principal["status"] = "queued"
    principal["epoch"] = int(principal.get("epoch", 1)) + 1
    principal["automatic_restarts"] = count + 1
    principal["automatic_restart_launch_failures"] = 0
    principal["automatic_restart_next_at"] = None
    principal["last_automatic_restart_signature"] = "launched:" + signature
    principal["retry_count"] = 0
    principal["next_attempt_at"] = None
    principal["last_exit"] = None
    save_principal(root, principal)
    append_event(
        root, "restart-requested",
        epoch=principal["epoch"],
        automatic_replay=True,
        reason=principal.get("last_error_class"),
        automatic_restarts=principal["automatic_restarts"],
        automatic_restart_limit=limit,
    )


def auto_replay_remote_workers(authority):
    trusted, _ = roots(authority)
    with directory_lock(trusted, "project campaign registry"):
        for root, principal in campaign_roots(authority):
            if principal.get("parent_run_id") != authority.get("run_id"):
                continue
            with directory_lock(root, "campaign principal root"):
                principal = load_principal(root, authority)
                maybe_auto_replay_remote_worker(authority, root, principal)


def schedule_ready_team_tasks(authority):
    trusted, _ = roots(authority)
    with directory_lock(trusted, "project campaign registry"):
        rows = []
        for root, principal in campaign_roots(authority):
            if principal.get("parent_run_id") != authority.get("run_id"):
                continue
            with directory_lock(root, "campaign principal root"):
                principal = load_principal(root, authority)
                principal, _ = refresh(authority, root, principal)
                rows.append((root, principal))
        active = sum(1 for _root, principal in rows if principal.get("status") in ACTIVE)
        grants = authority["worker_grants"]
        capacity = grants["max_campaigns"]
        for root, principal in rows:
            if principal.get("status") not in BLOCKED:
                continue
            with directory_lock(root, "campaign principal root"):
                principal = load_principal(root, authority)
                state, detail = dependency_state(
                    authority, principal.get("dependencies", []), authority["run_id"])
                if state == "failed":
                    principal["status"] = "blocked_failed"
                    principal["dependency_detail"] = detail
                    save_principal(root, principal)
                    append_event(root, "dependency-failed", dependencies=detail)
                    continue
                if state == "blocked":
                    principal["status"] = "blocked_dependencies"
                    principal["dependency_detail"] = detail
                    save_principal(root, principal)
                    continue
                if active >= capacity or capacity == 0:
                    principal["status"] = "blocked_capacity"
                    principal["dependency_detail"] = []
                    save_principal(root, principal)
                    continue
                browser = principal.get("browser", {}).get("mode", "none")
                desktop = principal.get("desktop", {}).get("mode", "none")
                grant_reasons = []
                if not grants.get("starts_enabled", True):
                    grant_reasons.append("starts")
                if principal.get("remote_auto_worker") and not grants.get("remote_auto_enabled", True):
                    grant_reasons.append("remote-auto")
                if browser not in grants["browser_modes"]:
                    grant_reasons.append("browser:" + browser)
                if desktop not in grants["desktop_modes"]:
                    grant_reasons.append("desktop:" + desktop)
                if grant_reasons:
                    if principal.get("status") != "blocked_grant" or principal.get("dependency_detail") != grant_reasons:
                        principal["status"] = "blocked_grant"
                        principal["dependency_detail"] = grant_reasons
                        save_principal(root, principal)
                        append_event(root, "worker-grant-blocked", grants=grant_reasons)
                    continue
                principal["status"] = "queued"
                principal["dependency_detail"] = []
                save_principal(root, principal)
                append_event(root, "dependencies-satisfied", dependencies=principal.get("dependencies", []))
                try:
                    launch_worker(authority, root, principal, os.path.join(root, "prompt"))
                except Exception as error:
                    exhausted = storage_error(error)
                    principal["status"] = "storage_hold" if exhausted else "failed"
                    principal["failure"] = str(error)
                    save_principal(root, principal)
                    try:
                        append_event(
                            root, "quota-exhausted" if exhausted else "scheduled-launch-failed",
                            error=str(error), storage=storage_status(authority),
                        )
                    except (CampaignError, OSError):
                        pass
                    continue
                active += 1


def load_live_authority_for_context(context):
    authority_path = context.get("authority_path")
    if isinstance(authority_path, str) and authority_path.startswith("/"):
        return validate_authority(load_json(authority_path, "campaign launch authority", 256 * 1024))
    if context.get("schema") == AUTHORITY_SCHEMA:
        return validate_authority(context)
    fail("campaign command has no live authority pointer")


def worker_restart_blockers(authority, principal):
    grants = authority.get("worker_grants")
    if not isinstance(grants, dict):
        return ["authority"]
    blockers = []
    if not grants.get("starts_enabled", True):
        blockers.append("starts-revoked")
    if principal.get("remote_auto_worker") and not grants.get("remote_auto_enabled", True):
        blockers.append("remote-auto-revoked")
    browser = principal.get("browser", {}).get("mode", "none")
    desktop = principal.get("desktop", {}).get("mode", "none")
    if browser not in grants.get("browser_modes", ["none"]):
        blockers.append("browser:" + browser)
    if desktop not in grants.get("desktop_modes", ["none"]):
        blockers.append("desktop:" + desktop)
    active = sum(
        1 for _candidate_root, candidate in campaign_roots(authority)
        if candidate.get("parent_run_id") == authority.get("run_id")
        and candidate.get("campaign_id") != principal.get("campaign_id")
        and candidate.get("status") in ACTIVE
    )
    if active >= grants.get("max_campaigns", 0):
        blockers.append("capacity")
    return blockers


def mutate_worker_grants(grants, action, maximum, authority):
    after = dict(grants)
    if action == "allow-starts":
        after["starts_enabled"] = True
    elif action == "revoke-starts":
        after["starts_enabled"] = False
    elif action == "remote-auto-on":
        if not any(
            inference["mode"] == "remote" and inference.get("auto", {}).get("enabled")
            for inference in inference_routes(authority).values()
        ):
            fail("remote-auto worker grants cannot be enabled for this launch")
        after["remote_auto_enabled"] = True
    elif action == "remote-auto-off":
        after["remote_auto_enabled"] = False
    elif action == "capacity":
        if maximum > authority["launch_max_campaigns"]:
            fail(
                f"worker grant capacity {maximum} exceeds the launch ceiling "
                f"{authority['launch_max_campaigns']}"
            )
        after["max_campaigns"] = maximum
    elif action == "browser-isolated-on":
        if "isolated" not in authority.get("browser_modes", []):
            fail("isolated worker browser realms exceed this launch's authority ceiling")
        after["browser_modes"] = ["none", "isolated"]
    elif action == "browser-isolated-off":
        after["browser_modes"] = ["none"]
    elif action == "desktop-isolated-on":
        if "isolated" not in authority.get("desktop_modes", []):
            fail("isolated worker desktop realms exceed this launch's authority ceiling")
        after["desktop_modes"] = ["none", "isolated"]
    elif action == "desktop-isolated-off":
        after["desktop_modes"] = ["none"]
    elif action != "status":
        fail("unsupported worker grant action")
    return after


def apply_worker_grant(authority, request):
    authority = validate_authority(authority)
    grant = request["grant"]
    action = grant["action"]
    if action == "status":
        return {
            "schema": WORKER_GRANT_RECEIPT_SCHEMA,
            "action": action,
            "changed": False,
            "launch_max_campaigns": authority["launch_max_campaigns"],
            "grants": worker_grant_summary(authority),
            "receipt": None,
        }, "worker grants read"
    authority_path = authority.get("authority_path")
    if not authority_path:
        fail("this campaign broker does not expose mutable worker grants")
    with directory_lock(os.path.dirname(authority_path), "campaign launch authority parent"):
        doc = load_json(authority_path, "campaign launch authority", 256 * 1024)
        fresh = validate_authority(doc)
        if fresh["run_id"] != authority["run_id"]:
            fail("campaign launch authority changed identity")
        before = worker_grant_summary(fresh)
        after = mutate_worker_grants(before, action, grant.get("max_campaigns"), fresh)
        changed = after != before
        receipt_id = None
        receipt_path = None
        authority_before_sha256 = digest_file(authority_path)
        authority_after_sha256 = authority_before_sha256
        if changed:
            receipt_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + secrets.token_hex(8)
            after = dict(after, updated_at=now(), receipt_id=receipt_id)
            updated = dict(doc)
            updated["launch_max_campaigns"] = fresh["launch_max_campaigns"]
            updated["worker_grants"] = after
            validate_authority(updated)
            authority_after_sha256 = hashlib.sha256(json_bytes(updated)).hexdigest()
            atomic_json(authority_path, updated)
            receipt_root = checked_dir(
                os.path.join(os.path.dirname(authority_path), "campaign-grant-receipts"),
                "worker grant receipt root",
                create=True,
            )
            receipt_path = os.path.join(receipt_root, receipt_id + ".json")
            atomic_json(
                receipt_path,
                {
                    "schema": WORKER_GRANT_RECEIPT_SCHEMA,
                    "receipt_id": receipt_id,
                    "run_id": fresh["run_id"],
                    "action": action,
                    "changed": True,
                    "authority_path": authority_path,
                    "authority_sha256_before": authority_before_sha256,
                    "authority_sha256_after": authority_after_sha256,
                    "before": before,
                    "after": after,
                    "created_at": now(),
                },
                replace=False,
            )
            revoked_field = (
                "browser" if action == "browser-isolated-off" else
                "desktop" if action == "desktop-isolated-off" else None
            )
            if revoked_field is not None:
                failed_revocations = []
                for campaign_root, principal in campaign_roots(updated):
                    if principal.get("parent_run_id") != fresh["run_id"] or principal.get("status") not in ACTIVE:
                        continue
                    if principal.get(revoked_field, {}).get("mode") != "isolated":
                        continue
                    method = "controller"
                    try:
                        run_control(updated, principal, "stop")
                    except CampaignError:
                        try:
                            method = force_stop_worker_unit(updated, principal)
                        except CampaignError:
                            failed_revocations.append(
                                principal.get("name") or principal.get("campaign_id", "unknown")
                            )
                            append_event(
                                campaign_root, "gui-grant-revocation-failed",
                                realm=revoked_field,
                            )
                            continue
                    append_event(
                        campaign_root, "gui-grant-revoked",
                        realm=revoked_field, method=method,
                    )
                if failed_revocations:
                    fail(
                        f"{revoked_field} authority was revoked, but active worker termination "
                        "could not be proven for: " + ", ".join(sorted(failed_revocations))
                    )
        return {
            "schema": WORKER_GRANT_RECEIPT_SCHEMA,
            "action": action,
            "changed": changed,
            "launch_max_campaigns": fresh["launch_max_campaigns"],
            "grants": after,
            "receipt": receipt_path,
            "authority_sha256_before": authority_before_sha256,
            "authority_sha256_after": authority_after_sha256,
        }, "worker grant updated" if changed else "worker grant unchanged"


def handle(context, request, broker=False):
    context = validate_context(context)
    expected_run = context.get("run_id") if broker else None
    request = validate_request(request, expected_run)
    action = request["action"]
    if action == "start":
        authority = load_live_authority_for_context(context)
        return create_campaign(authority, request), "companion campaign launched"
    if action == "grant":
        return apply_worker_grant(load_live_authority_for_context(context), request)
    if action == "graph":
        authority = load_live_authority_for_context(context)
        return create_team_graph(authority, request), "team graph accepted"
    if action == "list":
        campaigns = []
        for root, principal in campaign_roots(context):
            if expected_run is not None and principal.get("parent_run_id") != expected_run:
                continue
            with directory_lock(root, "campaign principal root"):
                principal = load_principal(root, context)
                campaigns.append(status_result(context, root, principal))
        campaigns.sort(key=lambda item: (item["created_at"], item["campaign_id"]))
        return {"schema": CAMPAIGN_SCHEMA, "campaigns": campaigns}, f"{len(campaigns)} campaign(s)"
    if action == "top":
        return team_top(context, expected_run), "team telemetry read"
    if action == "inbox":
        return team_inbox(context, expected_run, request.get("name")), "team inbox read"
    if action == "ack":
        return team_ack(context, expected_run, request["team"]["message_id"]), "team message acknowledged"
    if action == "wait-any":
        return team_wait_any(context, expected_run), "team terminal-state snapshot read"
    if action == "remove":
        if broker:
            fail("campaign removal is operator-only")
        trusted, _ = roots(context)
        with directory_lock(trusted, "project campaign registry"):
            root, principal = find_campaign(context, request["name"], None)
            with directory_lock(root, "campaign principal root"):
                principal = load_principal(root, context)
                plan = campaign_removal_plan(context, root, principal)
            result = (
                {**plan, "removed": False, "dry_run": True}
                if request["dry_run"]
                else remove_campaign_plan(plan)
            )
        return result, (
            "campaign removal preflight passed"
            if request["dry_run"] else
            "terminal campaign state removed"
        )

    if action == "restart":
        context = load_live_authority_for_context(context)

    trusted, _ = roots(context)
    with directory_lock(trusted, "project campaign registry"):
        root, principal = find_campaign(context, request["name"], expected_run)
        with directory_lock(root, "campaign principal root"):
            principal = load_principal(root, context)
            if expected_run is not None and principal.get("parent_run_id") != expected_run:
                fail("campaign principal belongs to another command room")
            return handle_existing(context, request, root, principal)


def response(request_id, status, message, result=None, error_code=None):
    value = {
        "schema": REQUEST_SCHEMA, "id": request_id, "status": status,
        "message": message, "result": result,
    }
    if error_code is not None:
        value["error_code"] = error_code
    return value


def write_ack(ack_root, request_id, value):
    if not ID_RE.fullmatch(request_id):
        return
    path = os.path.join(ack_root, request_id + ".json")
    payload = json_bytes(value)
    if len(payload) > MAX_ACK:
        payload = json_bytes(response(request_id, "error", "campaign acknowledgement exceeded its size limit"))
    atomic_bytes(path, payload)


def reject_pending_requests(inbox, acks):
    """Return a bounded, content-free error while live authority is unavailable."""
    for path in sorted(Path(inbox).glob("*.json")):
        request_id = path.stem
        claimed = os.path.join(inbox, ".processing-" + path.name)
        value = None
        try:
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
               info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > MAX_REQUEST:
                os.unlink(path)
                continue
            os.replace(path, claimed)
            doc = load_json(claimed, "campaign request", MAX_REQUEST)
            if doc.get("id") != request_id:
                fail("campaign request filename and identity differ")
            value = response(
                request_id,
                "error",
                "campaign broker is temporarily unavailable because its live launch authority failed validation; retry after the command room recovers or restart the room",
                error_code="broker_authority_unavailable",
            )
        except CampaignError as error:
            value = response(request_id, "error", str(error), error_code=error.code)
        except OSError:
            value = response(
                request_id,
                "error",
                "campaign broker could not acknowledge a request while launch authority was unavailable",
                error_code="broker_authority_unavailable",
            )
        finally:
            try:
                os.unlink(claimed)
            except FileNotFoundError:
                pass
        if value is not None:
            try:
                write_ack(acks, request_id, value)
            except (CampaignError, OSError):
                pass


def sc_emit_maintenance_evidence(row):
    """Write one bounded content-free JSON line to broker stderr."""
    allowed = {
        "schema", "event", "stage", "error_class", "consecutive_failures",
        "suppressed_since_last", "total_failures", "failure_window_seconds",
    }
    if not isinstance(row, dict) or set(row) - allowed:
        raise ValueError("invalid maintenance evidence")
    payload = json.dumps(row, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    if len(payload.encode("ascii")) > 512:
        raise ValueError("maintenance evidence exceeds bound")
    print(payload, file=sys.stderr, flush=True)

def sc_run_maintenance_stage(states, stage, operation, *, expected_errors, observed_at=None, emit=None):
    """Run one stage once and report expected failures at bounded intervals.

    `observed_at` is a monotonic value and is used only for differences.  The
    returned mapping contains classifications, not exception messages.
    """
    if stage not in {"auto_replay_remote_workers", "schedule_ready_team_tasks"}:
        raise ValueError("unknown maintenance stage")
    if not isinstance(states, dict):
        raise TypeError("maintenance states must be a mapping")
    if not isinstance(expected_errors, tuple) or not expected_errors or not all(
        isinstance(item, type) and issubclass(item, BaseException) for item in expected_errors
    ):
        raise TypeError("expected_errors must be a non-empty exception tuple")
    if emit is None:
        emit = sc_emit_maintenance_evidence
    if observed_at is None:
        observed_at = time.monotonic()
    if type(observed_at) not in {int, float}:
        raise TypeError("observed_at must be numeric")
    observed_at = float(observed_at)

    state = states.setdefault(stage, {
        "consecutive_failures": 0,
        "total_failures": 0,
        "suppressed_since_last": 0,
        "first_failure_at": None,
        "next_emit_at": 0.0,
        "emissions": 0,
    })
    required = {
        "consecutive_failures", "total_failures", "suppressed_since_last",
        "first_failure_at", "next_emit_at", "emissions",
    }
    if set(state) != required:
        raise ValueError("invalid maintenance state")

    try:
        operation()
    except expected_errors as error:
        state["consecutive_failures"] += 1
        state["total_failures"] += 1
        if state["first_failure_at"] is None:
            state["first_failure_at"] = observed_at
        emitted = False
        if observed_at >= float(state["next_emit_at"]):
            row = {
                "schema": "sandcodex.campaign-maintenance-evidence.v1",
                "event": "expected_failure",
                "stage": stage,
                "error_class": type(error).__name__,
                "consecutive_failures": state["consecutive_failures"],
                "suppressed_since_last": state["suppressed_since_last"],
                "total_failures": state["total_failures"],
            }
            emit(row)
            emitted = True
            state["suppressed_since_last"] = 0
            state["emissions"] += 1
            delay = min(60.0, float(2 ** min(state["emissions"], 6)))
            state["next_emit_at"] = observed_at + delay
        else:
            state["suppressed_since_last"] += 1
        return {
            "status": "expected_failure",
            "stage": stage,
            "evidence_emitted": emitted,
            "error_class": type(error).__name__,
        }
    except BaseException:
        # Programming errors, cancellation and process-exit signals remain
        # visible.  Do not convert them into a continued broker loop.
        raise

    previous = state["consecutive_failures"]
    if previous:
        first = state["first_failure_at"]
        elapsed = max(0.0, observed_at - float(first)) if first is not None else 0.0
        emit({
            "schema": "sandcodex.campaign-maintenance-evidence.v1",
            "event": "recovered",
            "stage": stage,
            "consecutive_failures": previous,
            "suppressed_since_last": state["suppressed_since_last"],
            "total_failures": state["total_failures"],
            "failure_window_seconds": round(elapsed, 3),
        })
    states[stage] = {
        "consecutive_failures": 0,
        "total_failures": state["total_failures"],
        "suppressed_since_last": 0,
        "first_failure_at": None,
        "next_emit_at": 0.0,
        "emissions": 0,
    }
    return {"status": "ok", "stage": stage, "recovered_failures": previous}


def broker(authority_path):
    authority = validate_authority(load_json(authority_path, "campaign launch authority", 256 * 1024))
    inbox = checked_dir(authority["inbox"], "campaign inbox")
    acks = checked_dir(authority["acks"], "campaign acknowledgement root")
    last_auto_replay_scan = 0.0
    maintenance_states = {}
    while pid_matches(authority["parent_pid"], authority["parent_process_start"]):
        try:
            authority = validate_authority(load_json(authority_path, "campaign launch authority", 256 * 1024))
            inbox = checked_dir(authority["inbox"], "campaign inbox")
            acks = checked_dir(authority["acks"], "campaign acknowledgement root")
        except Exception:
            reject_pending_requests(inbox, acks)
            time.sleep(0.25)
            continue
        current_time = time.monotonic()
        if current_time - last_auto_replay_scan >= 2.0:
            # Run the independent maintenance stages once each. Expected
            # campaign/storage failures become bounded content-free evidence;
            # no retry is added. Programming errors and cancellation propagate.
            sc_run_maintenance_stage(
                maintenance_states,
                "auto_replay_remote_workers",
                lambda: auto_replay_remote_workers(authority),
                expected_errors=(CampaignError, OSError),
                observed_at=current_time,
            )
            sc_run_maintenance_stage(
                maintenance_states,
                "schedule_ready_team_tasks",
                lambda: schedule_ready_team_tasks(authority),
                expected_errors=(CampaignError, OSError),
                observed_at=current_time,
            )
            last_auto_replay_scan = current_time
        for path in sorted(Path(inbox).glob("*.json")):
            request_id = path.stem
            claimed = os.path.join(inbox, ".processing-" + path.name)
            try:
                info = os.lstat(path)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
                   info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > MAX_REQUEST:
                    os.unlink(path)
                    continue
                os.replace(path, claimed)
                doc = load_json(claimed, "campaign request", MAX_REQUEST)
                if doc.get("id") != request_id:
                    fail("campaign request filename and identity differ")
                result, message = handle(authority, doc, broker=True)
                value = response(request_id, "ok", message, result)
            except CampaignError as error:
                value = response(request_id, "error", str(error), error_code=error.code)
            except OSError as error:
                if storage_error(error):
                    value = response(
                        request_id, "error",
                        "campaign storage quota exhausted; existing evidence is held for operator review",
                        error_code="quota_exhausted",
                    )
                else:
                    value = response(request_id, "error", f"campaign broker internal failure: {type(error).__name__}")
            except BaseException as error:
                value = response(request_id, "error", f"campaign broker internal failure: {type(error).__name__}")
            finally:
                try:
                    os.unlink(claimed)
                except FileNotFoundError:
                    pass
            write_ack(acks, request_id, value)
        time.sleep(0.1)


def direct(context_path, request_path):
    context = validate_context(load_json(context_path, "campaign operator context", 256 * 1024))
    request = load_json(request_path, "campaign operator request", MAX_REQUEST)
    request_id = str(request.get("id", "operator"))
    try:
        result, message = handle(context, request, broker=False)
        value = response(request_id, "ok", message, result)
    except CampaignError as error:
        value = response(request_id, "error", str(error), error_code=error.code)
    except OSError as error:
        if storage_error(error):
            value = response(
                request_id, "error",
                "campaign storage quota exhausted; existing evidence is held for operator review",
                error_code="quota_exhausted",
            )
        else:
            value = response(request_id, "error", f"campaign operator internal failure: {type(error).__name__}")
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    return 0 if value["status"] == "ok" else 1


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "broker":
        broker(sys.argv[2])
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "direct":
        return direct(sys.argv[2], sys.argv[3])
    print("sandcodex campaign engine: invalid invocation", file=sys.stderr)
    return 64


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except CampaignError as error:
        print(f"sandcodex campaign engine: {error}", file=sys.stderr)
        raise SystemExit(1)
SANDCODEX_CAMPAIGN_ENGINE_PY
}

