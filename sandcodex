  done
  [[ "$SC_LOG_LINES" =~ ^[1-9][0-9]*$ && ${#SC_LOG_LINES} -le 6 ]] || \
    sc_usage_error "log line count must be an integer from 1 through 999999"
}

sc_parse_state() {
  SC_HELP_TOPIC=state
  case "${1:-}" in -h|--help|help) sc_help_topic state; exit 0 ;; esac
  (( $# )) || sc_usage_error "state requires migrate, rollback, export, or import"
  SC_STATE_ACTION="$1"; shift
  case "$SC_STATE_ACTION" in
    migrate)
      while (( $# )); do
        case "$1" in
          --dry-run) SC_STATE_DRY_RUN=1 ;;
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -h|--help|help) sc_help_topic state; exit 0 ;;
          *) sc_usage_error "unknown state migrate option: $1" ;;
        esac
        shift
      done
      ;;
    rollback)
      while (( $# )); do
        case "$1" in
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -h|--help|help) sc_help_topic state; exit 0 ;;
          -*) sc_usage_error "unknown state rollback option: $1" ;;
          *) [[ -z "$SC_STATE_TRANSACTION" ]] || sc_usage_error "state rollback accepts one transaction"; SC_STATE_TRANSACTION="$1" ;;
        esac
        shift
      done
      ;;
    export)
      (( $# )) || sc_usage_error "state export requires ARCHIVE"
      SC_STATE_ARCHIVE="$1"; shift
      while (( $# )); do
        case "$1" in
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -h|--help|help) sc_help_topic state; exit 0 ;;
          *) sc_usage_error "unknown state export option: $1" ;;
        esac
        shift
      done
      ;;
    import)
      (( $# )) || sc_usage_error "state import requires ARCHIVE"
      SC_STATE_ARCHIVE="$1"; shift
      while (( $# )); do
        case "$1" in
          --merge) SC_STATE_MERGE=1 ;;
          --dry-run) SC_STATE_DRY_RUN=1 ;;
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -h|--help|help) sc_help_topic state; exit 0 ;;
          *) sc_usage_error "unknown state import option: $1" ;;
        esac
        shift
      done
      ;;
    *) sc_usage_error "unknown state action: $SC_STATE_ACTION" ;;
  esac
}

