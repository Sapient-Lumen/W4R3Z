    def guarded_stylus_hover(
        self,
        start_x: int,
        start_y: int,
        end_x: int,
        end_y: int,
        steps: int,
        tilt_x_degrees: int,
        tilt_y_degrees: int,
        rotation_present: bool,
        rotation_start_degrees: int,
        rotation_delta_degrees: int,
        slider_present: bool,
        slider_start_65535: int,
        slider_end_65535: int,
        distance_present: bool,
        distance_start_65535: int,
        distance_end_65535: int,
        wheel_present: bool,
        wheel_delta_degrees_256: int,
        wheel_clicks: int,
        wheel_step: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor stylus-hover authority is unavailable")
        for label, coordinate in (
            ("start_x", start_x), ("start_y", start_y),
            ("end_x", end_x), ("end_y", end_y),
        ):
            if type(coordinate) is not int or not 0 <= coordinate <= SWAY_HIT_TEST_MAX_COORDINATE:
                raise ToolError(f"compositor stylus-hover {label} exceeds the sealed range")
        if type(steps) is not int or not 1 <= steps <= STYLUS_STROKE_MAX_STEPS:
            raise ToolError("compositor stylus-hover steps are outside the sealed range")
        for label, tilt in (
            ("tilt_x_degrees", tilt_x_degrees),
            ("tilt_y_degrees", tilt_y_degrees),
        ):
            if type(tilt) is not int or not STYLUS_TILT_MIN_DEGREES <= tilt <= STYLUS_TILT_MAX_DEGREES:
                raise ToolError(f"compositor stylus-hover {label} is outside the sealed range")
        if type(rotation_present) is not bool:
            raise ToolError("compositor stylus-hover rotation presence is invalid")
        if rotation_present:
            if type(rotation_start_degrees) is not int or not (
                STYLUS_ROTATION_START_MIN_DEGREES
                <= rotation_start_degrees
                <= STYLUS_ROTATION_START_MAX_DEGREES
            ):
                raise ToolError("compositor stylus-hover rotation start is outside the sealed range")
            if type(rotation_delta_degrees) is not int or not (
                STYLUS_ROTATION_DELTA_MIN_DEGREES
                <= rotation_delta_degrees
                <= STYLUS_ROTATION_DELTA_MAX_DEGREES
            ):
                raise ToolError("compositor stylus-hover rotation delta is outside the sealed range")
        elif rotation_start_degrees != 0 or rotation_delta_degrees != 0:
            raise ToolError("compositor stylus-hover omitted rotation must use canonical zero fields")
        if type(slider_present) is not bool:
            raise ToolError("compositor stylus-hover slider presence is invalid")
        if slider_present:
            for label, slider in (
                ("slider_start_65535", slider_start_65535),
                ("slider_end_65535", slider_end_65535),
            ):
                if type(slider) is not int or not STYLUS_SLIDER_MIN_65535 <= slider <= STYLUS_SLIDER_MAX_65535:
                    raise ToolError(f"compositor stylus-hover {label} is outside the sealed range")
        elif slider_start_65535 != 0 or slider_end_65535 != 0:
            raise ToolError("compositor stylus-hover omitted slider must use canonical zero fields")
        if type(distance_present) is not bool:
            raise ToolError("compositor stylus-hover distance presence is invalid")
        if distance_present:
            for label, distance in (
                ("distance_start_65535", distance_start_65535),
                ("distance_end_65535", distance_end_65535),
            ):
                if type(distance) is not int or not STYLUS_DISTANCE_MIN_65535 <= distance <= STYLUS_DISTANCE_MAX_65535:
                    raise ToolError(f"compositor stylus-hover {label} is outside the sealed range")
        elif distance_start_65535 != 0 or distance_end_65535 != 0:
            raise ToolError("compositor stylus-hover omitted distance must use canonical zero fields")
        if type(wheel_present) is not bool:
            raise ToolError("compositor stylus-hover wheel presence is invalid")
        if wheel_present:
            if type(wheel_delta_degrees_256) is not int or not (
                STYLUS_WHEEL_DELTA_MIN_DEGREES_256
                <= wheel_delta_degrees_256
                <= STYLUS_WHEEL_DELTA_MAX_DEGREES_256
            ):
                raise ToolError("compositor stylus-hover wheel degree delta is outside the sealed range")
            if type(wheel_clicks) is not int or not STYLUS_WHEEL_CLICKS_MIN <= wheel_clicks <= STYLUS_WHEEL_CLICKS_MAX:
                raise ToolError("compositor stylus-hover wheel clicks are outside the sealed range")
            if type(wheel_step) is not int or not 0 <= wheel_step <= steps:
                raise ToolError("compositor stylus-hover wheel step is outside the sealed path")
            if wheel_delta_degrees_256 == 0 and wheel_clicks == 0:
                raise ToolError("compositor stylus-hover wheel pulse cannot be a zero-degree zero-click event")
            if (
                wheel_delta_degrees_256 != 0
                and wheel_clicks != 0
                and (wheel_delta_degrees_256 < 0) != (wheel_clicks < 0)
            ):
                raise ToolError("compositor stylus-hover wheel channels have conflicting directions")
        elif wheel_delta_degrees_256 != 0 or wheel_clicks != 0 or wheel_step != 0:
            raise ToolError("compositor stylus-hover omitted wheel must use canonical zero fields")
        if not callable(validator):
            raise ToolError("compositor stylus-hover target validator is unavailable")

        action = {
            "distance_end_65535": distance_end_65535,
            "distance_present": distance_present,
            "distance_start_65535": distance_start_65535,
            "end_x": end_x,
