  server6.maxHeadersCount = 128;
  server6.headersTimeout = 30_000;
  server6.requestTimeout = 0;
  server6.keepAliveTimeout = 5_000;
  server6.maxRequestsPerSocket = 1_024;
  server6.on('upgrade', (_request, socket) => {
