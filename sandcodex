  ! timeout 1 bash -c 'exec 3<>/dev/tcp/127.0.0.1/3128' 2>/dev/null
fi
mkdir -p "$work/preflight"
ln -s "$denied_sentinel" "$work/preflight/denied-symlink"
if cat "$work/preflight/denied-symlink" >/dev/null 2>&1; then
  echo 'model command read frontend state through a symlink' >&2
  exit 1
fi
if { printf 'mutated\n' >"$work/preflight/denied-symlink"; } 2>/dev/null; then
  echo 'model command wrote frontend state through a symlink' >&2
  exit 1
fi
rm -f "$work/preflight/denied-symlink"
if codex login status >"$work/preflight/nested-login-status" 2>&1; then
  echo 'model command inherited frontend authentication' >&2
  exit 1
fi
rm -f "$work/preflight/nested-login-status"
nested=$(command -v sandcodex)
test "$nested" = "$work/agent-bin/sandcodex"
test -x "$nested"
protected="$work/../launcher/sandcodex"
if ln "$protected" "$work/preflight/protected-hardlink" 2>/dev/null; then
  rm -f "$work/preflight/protected-hardlink"
  echo 'model command created a writable alias to the protected launcher' >&2
  exit 1
fi
loop_output=$("$nested" loop --turns 1 --prompt 'sandcodex preflight continuation' --json)
jq -e '.status == "queued" and .action == "continue" and .turns == 1' <<<"$loop_output" >/dev/null
loop_request_id=$(jq -er '.id' <<<"$loop_output")
loop_request=
for candidate in "$work/loop/inbox"/*.json; do
  [[ -f $candidate && ! -L $candidate ]] || continue
  if jq -e --arg id "$loop_request_id" '.id == $id' "$candidate" >/dev/null 2>&1; then
    loop_request=$candidate
    break
  fi
done
test -n "$loop_request"
jq -e --arg run_id "$SANDCODEX_RUN_ID" '
  .schema == "sandcodex.loop-request.v1"
  and .target_run_id == $run_id
  and .action == "continue"
  and .turns == 1
  and .message == "sandcodex preflight continuation"
' "$loop_request" >/dev/null
rm -f "$loop_request"
if (( campaign_available > 0 )); then
  campaign_output=$("$SANDCODEX_CAMPAIGN" list --json)
  jq -e '.campaigns | type == "array"' <<<"$campaign_output" >/dev/null
  if (( campaign_max_turns == 0 )); then
    campaign_over_budget=1000000000
  else
    campaign_over_budget=$((campaign_max_turns + 1))
  fi
  set +e
  campaign_output=$("$SANDCODEX_CAMPAIGN" start --name preflight-over-budget \
    --turns "$campaign_over_budget" --prompt 'must not launch' --json 2>&1)
  campaign_rc=$?
  set -e
  test "$campaign_rc" != 0
  case "$campaign_output" in *'launch authority permits'*|*'campaign turns must be'*) ;; *) exit 1;; esac
else
  test -z "${SANDCODEX_CAMPAIGN:-}"
  if (( campaign_max_count > 0 )); then
    test "$(realpath -- "$(command -v sandcodex-campaign)")" = \
      "$(realpath -- "$work/../launcher/sandcodex-campaign")"
    set +e
    campaign_output=$(sandcodex-campaign list --json 2>&1)
    campaign_rc=$?
    set -e
    test "$campaign_rc" = 77
    case "$campaign_output" in *'companion campaigns are not authorized in this process'*) ;; *) exit 1;; esac
  else
    ! command -v sandcodex-campaign >/dev/null 2>&1
  fi
fi
set +e
nested_output=$("$nested" --project "$PWD" 2>&1)
nested_rc=$?
set -e
test "$nested_rc" = 77
case "$nested_output" in *'recursive launch is blocked'*) ;; *) exit 1;; esac
set +e
nested_output=$("$nested" loop --BARE-METAL --turns 1 2>&1)
nested_rc=$?
set -e
test "$nested_rc" = 77
case "$nested_output" in *'cannot promote loop control to BARE-METAL'*) ;; *) exit 1;; esac
set +e
nested_output=$("$nested" --BARE-METAL --project "$PWD" 2>&1)
nested_rc=$?
set -e
test "$nested_rc" = 77
case "$nested_output" in *'recursive launch is blocked'*) ;; *) exit 1;; esac
fallback_root=$(dirname -- "$outside")/nested-global
set +e
timeout 10 env -u SANDCODEX_ACTIVE -u SANDCODEX_OUTER_PROJECT \
  SANDCODEX_NIX_READY=1 SANDCODEX_GLOBAL_ROOT="$fallback_root" \
  "$nested" --project "$PWD" >"$work/preflight/nested-fallback" 2>&1
nested_rc=$?
set -e
test "$nested_rc" != 0
test "$nested_rc" != 124
rm -f "$work/preflight/nested-fallback"
if test "$testing" = 1 && test -d .git; then
  authority_backup="$work/preflight/project-authority-backup"
  mkdir -p "$authority_backup"
  authority_index=0
  for project_control in .git/config .git/hooks/pre-commit .codex/config.toml \
      .agents/probe .claude/agents/probe.md .mcp.json .vscode/settings.json \
      .idea/workspace.xml .gitmodules .bashrc .bash_profile .zshrc .zprofile \
      .profile .ripgreprc fake-codex; do
    authority_index=$((authority_index + 1))
    authority_saved="$authority_backup/$authority_index"
    authority_existed=0
    if test -e "$project_control" || test -L "$project_control"; then
      cp -a -- "$project_control" "$authority_saved"
      authority_existed=1
    fi
    mkdir -p -- "$(dirname -- "$project_control")"
    printf 'inner-sandbox-project-write\n' >"$project_control"
    test "$(cat "$project_control")" = inner-sandbox-project-write
    if test "$authority_existed" = 1; then
      cp -a -- "$authority_saved" "$project_control.restore"
      mv -fT -- "$project_control.restore" "$project_control"
    else
      rm -f -- "$project_control"
    fi
  done
  rm -rf -- "$authority_backup"
  printf 'project-authority-ok\n' >"$work/preflight/project-authority-proof"
fi
printf 'boundary-ok\n' >"$work/preflight/result"
test "$(cat "$work/preflight/result")" = boundary-ok
printf 'before\n' >"$work/preflight/patched"
apply_patch '*** Begin Patch
*** Update File: .sandcodex/work/preflight/patched
@@
-before
+apply-patch-ok
*** End Patch'
test "$(cat "$work/preflight/patched")" = apply-patch-ok
SANDCODEX_COMMAND_BOUNDARY_PREFLIGHT_SH
}

sc_outer_preflight_body() {
  cat <<'EOF'
set -Eeu
trap 'rc=$?; trap - ERR; printf "sandcodex: outer-boundary preflight failed at line %s (status %s)\n" "$LINENO" "$rc" >&2; exit "$rc"' ERR
project=$1; global=$2; shift 2
parent=$(dirname -- "$project")
for denied in / "$parent" "$global"; do
  test ! -w "$denied"
  probe="$denied/.sandcodex-write-probe-$$"
  if { printf 'denied\n' >"$probe"; } 2>/dev/null; then
    rm -f -- "$probe"
    echo "outer boundary unexpectedly wrote $denied" >&2
    exit 1
  fi
done
exec "$@"
EOF
}

sc_boundary_preflight() {
  local outside="$SC_RUN_ROOT/outside-sentinel" denied_sentinel="$SC_CONTROL/codex-home/.boundary-sentinel-$SC_RUN_ID"
  local visible_sentinel="$SC_SANDBOX_CONTROL/codex-home/.boundary-sentinel-$SC_RUN_ID"
  local output rc stop_rc=0 verified=1 errexit=0 nix_deep=0 preflight_timeout=45s
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_TEST_NIX_DEEP:-0}" == 1 ]]; then nix_deep=1; fi
  (( ! SC_BROWSER_RELAY_REQUIRED )) || preflight_timeout=75s
  printf 'private\n' >"$outside"; chmod 600 "$outside"
  printf 'frontend-private\n' | sc_atomic "$denied_sentinel" 600
  rm -rf -- "$SC_WORK/preflight"
  sc_debug "running direct outer and Codex inner boundary preflight"
  if (( SC_BROWSER_RELAY_REQUIRED )); then
    sc_note "activating the controlled browser on its private GlassTTY extension page"
    if ! sc_start_browser_relay_preflight_client; then
      sc_log_event error glasstty_command_room \
        "could not activate the controlled browser for command-room relay verification"
      rm -f -- "$denied_sentinel"
      return 1
    fi
  fi
  [[ $- != *e* ]] || errexit=1
  set +e
  output="$(SC_BWRAP_TIMEOUT="$preflight_timeout" sc_bwrap \
    bash -c "$(sc_outer_preflight_body)" -- "$SC_PROJECT" "$SC_GLOBAL" \
    "$SC_CODEX" sandbox -P "$SC_INNER_PROFILE" -- \
    bash -c "$(sc_emit_command_boundary_preflight)" -- "$outside" "$SC_SANDBOX_CONTROL/codex-home" "$visible_sentinel" \
    "$SC_WORK" "$SC_CODEX" 1 "$SC_AGENT_ENV" "$SC_DEV_VENV" "$SC_BROWSER" "$SC_NIX_DAEMON_SAFE" \
    "$SC_GLASSTTY_RUNTIME_HOME" "$nix_deep" "$SC_JAIL_NETWORK_CEILING" \
    "$([[ $SC_DEV_NET == 1 ]] && printf unrestricted || printf provider-only)" \
    "$([[ ${SANDCODEX_TESTING:-0} == 1 ]] && printf 1 || printf 0)" \
    "$SC_CAMPAIGN_AVAILABLE" "$SC_CAMPAIGN_MAX_COUNT" "$SC_CAMPAIGN_MAX_TURNS" \
    "$SC_BROWSER_RELAY_REQUIRED" \
    "$([[ $SC_CAMPAIGN_STORAGE_BUDGET_MIB == null ]] && printf null || printf '%s' "$((SC_CAMPAIGN_STORAGE_BUDGET_MIB * 1024 * 1024))")" \
    "$SC_AGENT_TMP_VISIBLE" \
    "$([[ $SC_BROWSER == 1 ]] && printf %s "$SC_BROWSER_COMMAND_SOCKET" || true)" \
    "$([[ $SC_BROWSER == 1 ]] && printf %s "$SC_BROWSER_RECOVERY_SOCKET" || true)" \
    "$([[ $SC_BROWSER == 1 ]] && printf %s "$SC_BROWSER_VIEWER_SOCKET" || true)" \
    "$SC_OPERATOR_ENABLED" "$SC_OPERATOR_SOCKET" "$SC_OPERATOR_HELPER" \
    "$SC_OPERATOR_STOP_GRACE_SECONDS" "$SC_DESKTOP" \
    "$([[ $SC_DESKTOP == 1 ]] && printf %s "$SC_DESKTOP_VIEWER_SOCKET" || true)" \
    "$([[ $SC_CAMPAIGN_AVAILABLE == 1 || -n $SC_TEAM_MEMBER_NAME ]] && printf 1 || printf 0)" \
    2>&1)"
  rc=$?
  if (( SC_BROWSER_RELAY_REQUIRED )); then
    sc_stop_browser_relay_preflight_client || stop_rc=$?
    if (( rc == 0 && stop_rc != 0 )); then rc=$stop_rc; fi
  fi
  (( ! errexit )) || set -e
  if (( rc != 0 )); then
    rm -f -- "$denied_sentinel"
    sc_log_event error boundary_preflight "nested boundary failed" "exit_code=$rc" \
      "diagnostic_head=${output:0:6000}" "diagnostic_tail=${output: -6000}"
    printf '%s\n' "$output" >&2
    return "$rc"
  fi
  [[ -f "$SC_WORK/preflight/result" && "$(<"$SC_WORK/preflight/result")" == boundary-ok ]] || verified=0
  [[ -f "$SC_WORK/preflight/patched" && "$(<"$SC_WORK/preflight/patched")" == apply-patch-ok ]] || verified=0
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && -d "$SC_PROJECT/.git" ]]; then
    [[ -f "$SC_WORK/preflight/project-authority-proof" &&
      "$(<"$SC_WORK/preflight/project-authority-proof")" == project-authority-ok ]] || verified=0
  fi
  if jq -e '.resource_scope.enabled == false and .jail.available == false' "$SC_AGENT_ENV" >/dev/null 2>&1; then
    [[ ! -e "$SC_WORK/preflight/inner-jail-self-test.json" ]] || verified=0
  else
    jq -e '.schema == "sand-jail.self-test.v3" and .product == "sandcodex" and .result == "ok" and
      .cgroup.enforced == true and .seccomp.enforced == true and .recursion.maximum_passed == true and
      .landlock.enforced == true' \
      "$SC_WORK/preflight/inner-jail-self-test.json" >/dev/null 2>&1 || verified=0
  fi
  if (( SC_BROWSER_RELAY_REQUIRED )); then
    jq -e '
      .schema == "sandcodex.glasstty-command-room-preflight.v1" and
      .result == "ok" and .acknowledged_before_completion == true and
      .correlated_terminal_responses == 1
    ' "$SC_WORK/preflight/glasstty-command-room-relay.json" >/dev/null 2>&1 || verified=0
  fi
  [[ -f "$denied_sentinel" && ! -L "$denied_sentinel" && "$(<"$denied_sentinel")" == frontend-private ]] || verified=0
  [[ -f "$outside" && ! -L "$outside" && "$(<"$outside")" == private ]] || verified=0
  [[ ! -e "$SC_RUN_ROOT/nested-global" ]] || verified=0
  rm -f -- "$denied_sentinel"
  (( verified )) || return 1
  if (( SC_BROWSER_RELAY_REQUIRED )); then
    install -m 600 -- "$SC_WORK/preflight/glasstty-command-room-relay.json" \
      "$SC_WORK/agent/glasstty-command-room-preflight.json"
    sc_log_event info glasstty_command_room \
      "private broker path and correlated request relay verified" \
      "socket=$SC_GLASSTTY_RUNTIME_HOME/run/daemon.sock" \
      "request=bridge.status" "terminal_responses=1"
  fi
  rm -rf -- "$SC_WORK/preflight"
  sc_log_event info boundary_preflight "nested boundary verified" \
    "outer=bubblewrap+$([[ $SC_DEV_NET == 1 ]] && printf unrestricted || printf provider-only)-proxy" \
    "inner=codex-project-profile" "action_jail=broker+cgroup+seccomp+bubblewrap+landlock" "apply_patch=verified"
}

# First-party local inference selection. Mutable project configuration and
# ambient environment variables never choose or retarget a provider.
sc_local_provider_enabled() {
  [[ -n "$SC_LOCAL_PROVIDER" ]]
}

sc_local_provider_resolve() {
  case "$SC_COMMAND" in run|loop|doctor) ;; *) return 0 ;; esac
  sc_local_provider_validate
}

sc_local_provider_validate() {
  if [[ -n "$SC_LOCAL_QUALIFICATION" && -z "$SC_LOCAL_STARTUP_DIRECTORY" ]]; then
    sc_usage_error "managed local creates its own qualification receipt"
  fi
  if ! sc_local_provider_enabled; then
    [[ -z "$SC_LOCAL_MODEL_DIGEST" ]] || sc_usage_error "--local-model-digest requires --local-provider"
    [[ -z "$SC_LOCAL_CONTEXT_TOKENS" ]] || sc_usage_error "--local-context requires --local-provider"
    [[ -z "$SC_LOCAL_THREADS" ]] || sc_usage_error "--local-threads requires --local-provider"
    [[ -z "$SC_LOCAL_QUALIFICATION" ]] || sc_usage_error "--local-qualification requires --local-provider"
    return 0
  fi
  case "$SC_LOCAL_PROVIDER" in
    ollama)
      SC_LOCAL_PROVIDER_PORT=11434
      [[ -n "$SC_LOCAL_PROVIDER_ENDPOINT" ]] || SC_LOCAL_PROVIDER_ENDPOINT=http://127.0.0.1:11434
      SC_LOCAL_PROVIDER_ENDPOINT="${SC_LOCAL_PROVIDER_ENDPOINT/localhost:/127.0.0.1:}"
      if [[ ! "$SC_LOCAL_PROVIDER_ENDPOINT" =~ ^http://127\.0\.0\.1:([1-9][0-9]{0,4})$ ]] ||
        (( BASH_REMATCH[1] > 65535 )); then
        sc_usage_error "ollama endpoint must be a canonical host-loopback HTTP port"
      fi
      SC_LOCAL_PROVIDER_HOST_PORT="${SC_LOCAL_PROVIDER_ENDPOINT##*:}"
      SC_PROVIDER_BRIDGE_HOST_PORT="$SC_LOCAL_PROVIDER_HOST_PORT"
      ;;
    *) sc_usage_error "local inference requires managed Ollama" ;;
  esac
  (( SC_MODEL_SET )) || sc_usage_error "--local-provider requires --model or --local-model"
  sc_no_line_breaks "$SC_MODEL" "local model"
  [[ ${#SC_MODEL} -le 192 && "$SC_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:+/@-]*$ ]] ||
    sc_usage_error "local model must be a 1-192 character provider model identifier"
  if [[ -n "$SC_LOCAL_MODEL_DIGEST" ]]; then
    SC_LOCAL_MODEL_DIGEST="${SC_LOCAL_MODEL_DIGEST#sha256:}"
    SC_LOCAL_MODEL_DIGEST="${SC_LOCAL_MODEL_DIGEST,,}"
    [[ "$SC_LOCAL_MODEL_DIGEST" =~ ^[0-9a-f]{64}$ ]] ||
      sc_usage_error "--local-model-digest must be 64 hexadecimal SHA-256 characters, optionally prefixed by sha256:"
  fi
  if [[ "$SC_MODEL" == "$SC_LOCAL_CPU_REFERENCE_MODEL" ]]; then
    if [[ -n "$SC_LOCAL_MODEL_DIGEST" && "$SC_LOCAL_MODEL_DIGEST" != "$SC_LOCAL_CPU_REFERENCE_SOURCE_DIGEST" ]]; then
      sc_usage_error "the pinned CPU reference model requires digest $SC_LOCAL_CPU_REFERENCE_SOURCE_DIGEST"
    fi
    # The public tag is a retrieval name, never identity. This one reviewed
    # reference profile fails closed if the registry later retargets it.
    SC_LOCAL_MODEL_DIGEST="$SC_LOCAL_CPU_REFERENCE_SOURCE_DIGEST"
    [[ -n "$SC_LOCAL_CONTEXT_TOKENS" ]] || SC_LOCAL_CONTEXT_TOKENS="$SC_LOCAL_CPU_REFERENCE_CONTEXT"
    [[ -n "$SC_LOCAL_THREADS" ]] || SC_LOCAL_THREADS="$SC_LOCAL_CPU_REFERENCE_THREADS"
  fi
  if [[ -n "$SC_LOCAL_CONTEXT_TOKENS" ]]; then
    [[ "$SC_LOCAL_CONTEXT_TOKENS" =~ ^[1-9][0-9]*$ && ${#SC_LOCAL_CONTEXT_TOKENS} -le 9 ]] ||
      sc_usage_error "--local-context must be a canonical positive integer"
    (( SC_LOCAL_CONTEXT_TOKENS >= SC_LOCAL_CONTEXT_MIN && SC_LOCAL_CONTEXT_TOKENS <= SC_LOCAL_CONTEXT_MAX )) ||
      sc_usage_error "--local-context must be $SC_LOCAL_CONTEXT_MIN through $SC_LOCAL_CONTEXT_MAX"
    (( SC_LOCAL_CONTEXT_TOKENS % 1024 == 0 )) ||
      sc_usage_error "--local-context must be a multiple of 1024"
  fi
  if [[ -n "$SC_LOCAL_THREADS" ]]; then
    [[ "$SC_LOCAL_THREADS" =~ ^[1-9][0-9]*$ && ${#SC_LOCAL_THREADS} -le 4 ]] ||
      sc_usage_error "--local-threads must be a canonical positive integer"
    (( SC_LOCAL_THREADS <= SC_LOCAL_THREADS_MAX )) ||
      sc_usage_error "--local-threads must be 1 through $SC_LOCAL_THREADS_MAX"
  fi
  SC_LOCAL_REQUIRE_GPU="${SANDCODEX_LOCAL_REQUIRE_GPU:-0}"
  [[ "$SC_LOCAL_REQUIRE_GPU" == 0 || "$SC_LOCAL_REQUIRE_GPU" == 1 ]] ||
    sc_usage_error "SANDCODEX_LOCAL_REQUIRE_GPU must be 0 or 1"
  [[ -z "$SC_LOCAL_QUALIFICATION" ]] || sc_local_provider_validate_qualification
}

sc_local_provider_validate_qualification() {
  local source="$SC_LOCAL_QUALIFICATION" resolved mode size owner links observed receipt_context native_context
  [[ "$source" == /* ]] || source="$PWD/$source"
  resolved="$(readlink -f -- "$source" 2>/dev/null)" || sc_usage_error "cannot resolve local qualification receipt: $SC_LOCAL_QUALIFICATION"
  [[ -f "$resolved" && ! -L "$source" && ! -L "$resolved" ]] ||
    sc_usage_error "local qualification receipt must be a regular non-symlink file"
  owner="$(stat -c %u -- "$resolved")"; links="$(stat -c %h -- "$resolved")"; mode="$(stat -c %a -- "$resolved")"; size="$(stat -c %s -- "$resolved")"
  [[ "$owner" == "$(id -u)" && "$links" == 1 ]] ||
    sc_usage_error "local qualification receipt must be single-linked and owned by the invoking user"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || sc_usage_error "cannot classify local qualification receipt mode"
  (( (8#$mode & 077) == 0 && (8#$mode & 0111) == 0 )) ||
    sc_usage_error "local qualification receipt must have no group/other or executable permission bits"
  (( size > 0 && size <= SC_LOCAL_QUALIFICATION_MAX_BYTES )) ||
    sc_usage_error "local qualification receipt must be 1..$SC_LOCAL_QUALIFICATION_MAX_BYTES bytes"
  jq -e --arg schema "$SC_LOCAL_QUALIFICATION_SCHEMA" --arg provider "$SC_LOCAL_PROVIDER"     --arg model "$SC_MODEL" --argjson port "$SC_LOCAL_PROVIDER_HOST_PORT" --argjson require_gpu "$([[ $SC_LOCAL_REQUIRE_GPU == 1 ]] && printf true || printf false)" '
      type=="object" and .schema==$schema and (.result=="pass" or .result=="warn") and
      (.summary.required_failed|type=="array" and length==0) and
      .request.provider==$provider and .request.model==$model and
      (.endpoint.loopback_by_policy==true) and (.endpoint.port==$port) and
      (.endpoint.host=="127.0.0.1" or .endpoint.host=="localhost" or .endpoint.host=="::1") and
      .claims.exact_model_identity_attested==true and
      .claims.responses_semantics_attested==true and
      .claims.tool_result_continuation_attested==true and
      ((($require_gpu|not)) or .claims.gpu_residency_attested==true)
    ' "$resolved" >/dev/null || sc_usage_error "local qualification receipt does not satisfy provider/model/protocol/GPU claim requirements"
  observed="$(jq -er '.model.digest_sha256 | select(type=="string" and test("^[0-9a-f]{64}$"))' "$resolved")" ||
    sc_usage_error "local qualification receipt lacks an exact lowercase model SHA-256"
  if [[ -n "$SC_LOCAL_MODEL_DIGEST" && "$SC_LOCAL_MODEL_DIGEST" != "$observed" ]]; then
    sc_usage_error "local qualification receipt digest does not match --local-model-digest"
  fi
  SC_LOCAL_MODEL_DIGEST="$observed"
  receipt_context="$(jq -r '.request.context_tokens // empty' "$resolved")"
  native_context="$(jq -r '.model.native_context_tokens // empty' "$resolved")"
  if [[ -n "$SC_LOCAL_CONTEXT_TOKENS" ]]; then
    [[ "$receipt_context" == "$SC_LOCAL_CONTEXT_TOKENS" ]] ||
      sc_usage_error "local qualification receipt context does not match --local-context"
    if [[ ! "$native_context" =~ ^[1-9][0-9]*$ ]] ||
      (( SC_LOCAL_CONTEXT_TOKENS > native_context )); then
      sc_usage_error "local qualification receipt does not prove requested context within native context"
    fi
    jq -e '.claims.context_contract_attested==true' "$resolved" >/dev/null ||
      sc_usage_error "local qualification receipt does not attest the requested context contract"
  elif [[ "$receipt_context" =~ ^[1-9][0-9]*$ ]]; then
    SC_LOCAL_CONTEXT_TOKENS="$receipt_context"
  fi
  SC_LOCAL_QUALIFICATION="$resolved"
  SC_LOCAL_QUALIFICATION_SHA256="$(sha256sum -- "$resolved" | awk '{print $1}')"
}

# A mutable tag is not identity. This file records the launch expectation and
# explicitly declines to claim provider attestation. The companion qualifier
# emits the exact digest, native context, protocol, tool, and GPU evidence.
sc_local_provider_write_contract() {
  SC_LOCAL_PROVIDER_CONTRACT="$SC_CONTROL/local-provider-contract.json"
  local visible="$SC_SANDBOX_CONTROL/local-provider-contract.json"
  local qualification_visible="" provider_attested=false
  if [[ -n "$SC_LOCAL_QUALIFICATION" ]]; then
    SC_LOCAL_QUALIFICATION_COPY="$SC_CONTROL/local-provider-qualification.json"
    cat -- "$SC_LOCAL_QUALIFICATION" | sc_atomic "$SC_LOCAL_QUALIFICATION_COPY" 600
    qualification_visible="$SC_SANDBOX_CONTROL/local-provider-qualification.json"
    provider_attested=true
  fi
  jq -n \
    --arg schema "$SC_LOCAL_PROVIDER_SCHEMA" \
    --argjson enabled "$([[ -n $SC_LOCAL_PROVIDER ]] && printf true || printf false)" \
    --arg provider "$SC_LOCAL_PROVIDER" --arg endpoint "$SC_LOCAL_PROVIDER_ENDPOINT" \
    --arg source "$SC_LOCAL_PROVIDER_SOURCE" --arg model "$SC_MODEL" \
    --arg digest "$SC_LOCAL_MODEL_DIGEST" --arg context "$SC_LOCAL_CONTEXT_TOKENS" \
    --arg threads "$SC_LOCAL_THREADS" \
    --arg keep_alive "$SC_LOCAL_KEEP_ALIVE" --argjson max_loaded "$SC_LOCAL_MAX_LOADED_MODELS" \
    --argjson parallel "$SC_LOCAL_NUM_PARALLEL" --argjson max_queue "$SC_LOCAL_MAX_QUEUE" \
    --argjson flash "$SC_LOCAL_FLASH_ATTENTION" --arg kv_cache "$SC_LOCAL_KV_CACHE_TYPE" \
    --arg visible "$visible" --arg qualification "$qualification_visible" \
    --arg qualification_sha256 "$SC_LOCAL_QUALIFICATION_SHA256" --argjson provider_attested "$provider_attested" \
    '{schema:$schema,enabled:$enabled,provider:(if $provider=="" then null else $provider end),
      endpoint:(if $endpoint=="" then null else $endpoint end),selection_source:$source,
      model:{name:(if $model=="" then null else $model end),tag_is_mutable:true,
        expected_sha256:(if $digest=="" then null else $digest end),
        codex_context_tokens:(if $context=="" then null else ($context|tonumber) end),
        runtime_parameters:{num_thread:(if $threads=="" then null else ($threads|tonumber) end)}},
      server_policy:{keep_alive:$keep_alive,max_loaded_models:$max_loaded,
        num_parallel:$parallel,max_queue:$max_queue,flash_attention:$flash,
        kv_cache_type:$kv_cache,operator_overrides_allowed:false},
      verification:{provider_attested:$provider_attested,
        qualification_receipt:(if $qualification=="" then null else {path:$qualification,sha256:$qualification_sha256} end),
        limitation:(if $provider_attested then
          "receipt is a bounded host observation and must be requalified after provider/model/runtime change"
        else
          "launch expectation only; run the host-side qualifier before claiming exact model identity, native context, tool behavior, or GPU placement"
        end)},
      agent_visible_path:$visible}' | sc_atomic "$SC_LOCAL_PROVIDER_CONTRACT" 600
}

sc_local_provider_append_codex_argv() {
  local -n _sc_local_argv=$1
  sc_local_provider_enabled || return 0
  _sc_local_argv+=(--oss --local-provider "$SC_LOCAL_PROVIDER" -m "$SC_MODEL")
}

sc_codex_argv() {
  # The referenced output is an array; ShellCheck cannot infer the caller's type.
  # shellcheck disable=SC2178
  local -n out=$1
  out=("$SC_CODEX" -C "$SC_PROJECT")
  sc_local_provider_append_codex_argv out
  if (( SC_BARE )); then out+=(--dangerously-bypass-approvals-and-sandbox); else out+=(-a never); fi
  case "$SC_RESUME" in
    fresh) ;;
    last) out+=(resume --last) ;;
    list) out+=(resume) ;;
    id) out+=(resume "$SC_RESUME_ID") ;;
    *) sc_die "internal resume mode error" ;;
  esac
  out+=("${SC_CODEX_ARGS[@]}")
}

sc_loop_codex_argv() {
  local -n argv_ref=$1
  local resume_target="$2"
  argv_ref=("$SC_CODEX" -C "$SC_PROJECT")
  sc_local_provider_append_codex_argv argv_ref
  if (( SC_BARE )); then argv_ref+=(--dangerously-bypass-approvals-and-sandbox); else argv_ref+=(-a never); fi
  argv_ref+=(exec)
  case "$resume_target" in
    fresh) ;;
    last) argv_ref+=(resume --last) ;;
    *)
      [[ "$resume_target" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] ||
        sc_die "internal loop resume target is invalid" 70
      argv_ref+=(resume "$resume_target")
      ;;
  esac
  argv_ref+=(--skip-git-repo-check)
  (( ! SC_LOOP_JSON )) || argv_ref+=(--json)
  argv_ref+=("${SC_CODEX_ARGS[@]}" -)
}

sc_loop_validate_provider_args() {
  local arg
  for arg in "${SC_CODEX_ARGS[@]}"; do
    case "$arg" in
      --ephemeral) sc_die "loop sessions cannot be ephemeral" 64 ;;
    esac
  done
}

sc_loop_validate_policy() {
  local name value
  for name in SC_LOOP_RETRY_LIMIT SC_LOOP_RETRY_BASE_SECONDS SC_LOOP_RETRY_MAX_SECONDS \
    SC_LOOP_RETRY_MAX_WAIT_SECONDS SC_LOOP_MIN_FREE_MIB SC_LOOP_MAX_PROJECT_GROWTH_MIB \
    SC_LOOP_MAX_DOWNLOADS_MIB SC_LOOP_MAX_PROFILE_MIB; do
    value="${!name}"
    [[ "$value" =~ ^(0|[1-9][0-9]*)$ && ${#value} -le 9 ]] || \
      sc_usage_error "loop retry and storage limits must be canonical non-negative integers"
  done
  (( SC_LOOP_RETRY_BASE_SECONDS <= SC_LOOP_RETRY_MAX_SECONDS )) || \
    sc_usage_error "--retry-base-seconds cannot exceed --retry-max-seconds"
  (( SC_LOOP_RETRY_MAX_WAIT_SECONDS == 0 || SC_LOOP_RETRY_MAX_SECONDS <= SC_LOOP_RETRY_MAX_WAIT_SECONDS )) || \
    sc_usage_error "--retry-max-seconds cannot exceed --retry-max-wait-seconds"
  if (( SC_BARE && ! SC_LOOP_AUTO_RESUME_EXPLICIT )); then SC_LOOP_AUTO_RESUME=0; fi
  (( ! SC_LOOP_DETACH || ! SC_BARE )) || sc_usage_error "BARE-METAL loops cannot detach"
}

sc_shell_array() {
  local output="$1" name="$2"; shift 2
  # shellcheck disable=SC2129  # This helper intentionally appends one shell array.
  printf '%s=(' "$name" >>"$output"
  (( $# == 0 )) || printf ' %q' "$@" >>"$output"
  printf ' )\n' >>"$output"
}

sc_systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"; value="${value//\"/\\\"}"; value="${value//%/%%}"
  printf '"%s"' "$value"
}

sc_start_detached_loop() {
  [[ -n "$SC_SYSTEMD_RUN" && -x "$SC_SYSTEMD_RUN" ]] || sc_die "detached loops require systemd-run and a user manager"
  if [[ "$SC_PROVIDER_MODE" == remote && -z "${SANDCODEX_REMOTE_PARENT_CONTRACT:-}" && "$SC_REMOTE_AUTO" != 1 ]]; then
    sc_die "detached remote loops require a live parent provider capability or remote auto; start an interactive remote room and use sandcodex-worker, or run a foreground remote loop" 64
  fi
  sc_loop_normalize_turns; sc_loop_load_prompt
  sc_ensure_dir "$SC_GLOBAL/supervisors" "loop supervisor state"
  sc_ensure_dir "$SC_GLOBAL/supervisors/$SC_PROJECT_KEY" "project loop supervisors"
  local id root launcher prompt runner spec active recoverable unit digest tmp unit_file status_file sessions_dir
  local -a base provider
  id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$(printf '%06x' "$(( RANDOM * RANDOM % 16777216 ))")"
  root="$SC_GLOBAL/supervisors/$SC_PROJECT_KEY/$id"
  mkdir -m 700 -- "$root"
  launcher="$root/sandcodex"; prompt="$root/prompt"; runner="$root/runner"
  spec="$root/spec.json"; active="$root/active"; recoverable="$root/recoverable"
  install -m 500 -- "$SC_SCRIPT" "$launcher"
  printf '%s' "$SC_LOOP_PROMPT" >"$prompt"; chmod 600 -- "$prompt"
  printf 'active\n' >"$active"; chmod 600 -- "$active"
  digest="$(sha256sum -- "$launcher" | awk '{print $1}')"
  unit="sandcodex-loop-${SC_PROJECT_KEY:0:16}-${id//[^A-Za-z0-9]/}"
  status_file="$SC_CONTROL/loop-state.json"; sessions_dir="$SC_CONTROL/codex-home/sessions"

  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    base=(local "${SC_LOCAL_REQUESTED_MODEL:-$SC_MODEL}")
    base+=(--backend "$SC_LOCAL_BACKEND")
    [[ -z "$SC_LOCAL_CONTEXT_TOKENS" ]] || base+=(--local-context "$SC_LOCAL_CONTEXT_TOKENS")
    [[ -z "$SC_LOCAL_THREADS" ]] || base+=(--local-threads "$SC_LOCAL_THREADS")
    (( SC_LOCAL_PULL )) || base+=(--no-pull)
    (( ! SC_LOCAL_MODEL_DIGEST_EXPLICIT )) || base+=(--local-model-digest "$SC_LOCAL_MODEL_DIGEST")
    base+=(loop --project "$SC_PROJECT" --prompt-file "$prompt" --json)
  elif [[ "$SC_PROVIDER_MODE" == remote ]]; then
    if (( SC_REMOTE_AUTO )); then
      base=(remote auto)
      [[ -z "$SC_REMOTE_KEYBANK_PATH" ]] || base+=(--key-bank "$(sc_remote_keybank_path)")
      base+=(--profile "$SC_REMOTE_PROFILE")
    else
      base=(remote "$SC_MODEL")
      [[ -z "$SC_REMOTE_NAME" ]] || base+=(--provider "$SC_REMOTE_NAME")
    fi
    base+=(loop --project "$SC_PROJECT" --prompt-file "$prompt" --json)
  elif [[ "$SC_PROVIDER_MODE" == gemini ]]; then
    base=(gemini)
    (( SC_GEMINI_AUTO )) || base+=("$SC_GEMINI_MODEL")
    if [[ -z "${SANDCODEX_GEMINI_PARENT_CONTRACT:-}" ]]; then
      [[ -z "$SC_GEMINI_KEY_PATH" ]] || base+=(--key-file "$SC_GEMINI_KEY_PATH")
      [[ -z "$SC_GEMINI_KEYBANK_PATH" ]] || base+=(--key-bank "$SC_GEMINI_KEYBANK_PATH")
      [[ -z "$SC_GEMINI_KEY_LABEL" ]] || base+=(--key-label "$SC_GEMINI_KEY_LABEL")
      (( ! SC_GEMINI_IGNORE_COOLDOWNS )) || base+=(--ignore-cooldowns)
      [[ "$SC_GEMINI_ROUTE_WAIT_SECONDS" == "$SC_GEMINI_ROUTE_WAIT_SECONDS_DEFAULT" ]] ||
        base+=(--route-wait-seconds "$SC_GEMINI_ROUTE_WAIT_SECONDS")
      (( ! SC_GEMINI_FORCE )) || base+=(--force)
    fi
    base+=(loop --project "$SC_PROJECT" --prompt-file "$prompt" --json)
  else
    base=(loop --project "$SC_PROJECT" --prompt-file "$prompt" --json)
  fi
  (( SC_LOOP_AUTO_RESUME )) && base+=(--auto-resume) || base+=(--no-auto-resume)
  base+=(--retry-limit "$SC_LOOP_RETRY_LIMIT" --retry-base-seconds "$SC_LOOP_RETRY_BASE_SECONDS"
    --retry-max-seconds "$SC_LOOP_RETRY_MAX_SECONDS" --retry-max-wait-seconds "$SC_LOOP_RETRY_MAX_WAIT_SECONDS"
    --min-free-mib "$SC_LOOP_MIN_FREE_MIB" --max-project-growth-mib "$SC_LOOP_MAX_PROJECT_GROWTH_MIB"
    --max-downloads-mib "$SC_LOOP_MAX_DOWNLOADS_MIB" --max-profile-mib "$SC_LOOP_MAX_PROFILE_MIB")
  (( SC_DEV_NET )) && base+=(--dev-network) || base+=(--restricted-network)
  base+=(--jail-network "$SC_JAIL_NETWORK_CEILING")
  [[ $SC_JAIL_TIMEOUT_CEILING == null ]] || base+=(--jail-max-timeout "$SC_JAIL_TIMEOUT_CEILING")
  [[ $SC_JAIL_CPU_CEILING == null ]] || base+=(--jail-max-cpu "$SC_JAIL_CPU_CEILING")
  [[ $SC_JAIL_MEMORY_CEILING == null ]] || base+=(--jail-max-memory "$SC_JAIL_MEMORY_CEILING")
  [[ $SC_JAIL_SWAP_CEILING == null ]] || base+=(--jail-max-swap "$SC_JAIL_SWAP_CEILING")
  [[ $SC_JAIL_PIDS_CEILING == null ]] || base+=(--jail-max-pids "$SC_JAIL_PIDS_CEILING")
  [[ $SC_JAIL_FILE_CEILING_MIB == null ]] || base+=(--jail-max-file "$SC_JAIL_FILE_CEILING_MIB")
  [[ $SC_JAIL_TMP_CEILING_MIB == null ]] || base+=(--jail-max-tmp "$SC_JAIL_TMP_CEILING_MIB")
  [[ $SC_JAIL_HOME_CEILING_MIB == null ]] || base+=(--jail-max-home "$SC_JAIL_HOME_CEILING_MIB")
  [[ $SC_JAIL_STORAGE_BUDGET_MIB == null ]] || base+=(--jail-storage-budget "$SC_JAIL_STORAGE_BUDGET_MIB")
  base+=(--jail-budget-group "$SC_JAIL_BUDGET_GROUP")
  (( SC_BROWSER )) && base+=(--browser) || base+=(--no-browser)
  if (( SC_DESKTOP )); then
    base+=(--desktop --desktop-backend "$SC_DESKTOP_BACKEND")
    (( SC_HEADFUL )) && base+=(--headful)
  else
    base+=(--no-desktop)
  fi
  base+=(--no-companion-campaigns)
  case "$SC_NIX_DAEMON_MODE" in allow) base+=(--nix-daemon);; deny) base+=(--no-nix-daemon);; esac
  (( ! SC_TRUST_PROJECT )) || base+=(--trust-project-config)
  (( SC_SUBAGENTS )) && base+=(--subagents) || base+=(--no-subagents)
  base+=(--agent-depth "$SC_AGENT_MAX_DEPTH" --agent-threads "$SC_AGENT_MAX_THREADS")
  [[ "$SC_PROVIDER_MODE" != gpt ]] || (( ! SC_MODEL_SET )) || base+=(--model "$SC_MODEL")
  (( ! SC_EFFORT_SET )) || base+=(--effort "$SC_EFFORT")
  local domain
  for domain in "${SC_DOMAINS[@]}"; do base+=(--allow-domain "$domain"); done
  local publish_spec
  for publish_spec in "${SC_PUBLISH_SPECS[@]}"; do base+=(--publish "$publish_spec"); done
  provider=("${SC_CODEX_ARGS[@]}")

  : >"$runner"
  # shellcheck disable=SC2129  # The following blocks build one private runner.
  cat >>"$runner" <<'RUNNER_HEAD'
#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
RUNNER_HEAD
  printf 'launcher=%q\nprompt=%q\nspec=%q\nactive=%q\nrecoverable=%q\nstate=%q\nsessions=%q\nid=%q\n' \
    "$launcher" "$prompt" "$spec" "$active" "$recoverable" "$status_file" "$sessions_dir" "$id" >>"$runner"
  printf 'export HOME=%q SANDCODEX_REAL_HOME=%q SANDCODEX_GLOBAL_ROOT=%q SANDCODEX_HOST_PATH=%q PATH=%q\n' \
    "$SC_REAL_HOME" "$SC_REAL_HOME" "$SC_GLOBAL" "$SC_HOST_PATH" "$SC_PATH:$SC_HOST_PATH" >>"$runner"
  if [[ -n "${SANDCODEX_LOCAL_PARENT_CONTRACT:-}" ]]; then
    printf 'export SANDCODEX_LOCAL_PARENT_CONTRACT=%q\n' "$SANDCODEX_LOCAL_PARENT_CONTRACT" >>"$runner"
    printf 'export SANDCODEX_LOCAL_PARENT_CONTRACT_SHA256=%q\n' "${SANDCODEX_LOCAL_PARENT_CONTRACT_SHA256:-}" >>"$runner"
  fi
  if [[ -n "${SANDCODEX_REMOTE_PARENT_CONTRACT:-}" ]]; then
    printf 'export SANDCODEX_REMOTE_PARENT_CONTRACT=%q\n' "$SANDCODEX_REMOTE_PARENT_CONTRACT" >>"$runner"
    printf 'export SANDCODEX_REMOTE_PARENT_CONTRACT_SHA256=%q\n' "${SANDCODEX_REMOTE_PARENT_CONTRACT_SHA256:-}" >>"$runner"
  fi
  if [[ -n "${SANDCODEX_GEMINI_PARENT_CONTRACT:-}" ]]; then
    printf 'export SANDCODEX_GEMINI_PARENT_CONTRACT=%q\n' "$SANDCODEX_GEMINI_PARENT_CONTRACT" >>"$runner"
    printf 'export SANDCODEX_GEMINI_PARENT_CONTRACT_SHA256=%q\n' "${SANDCODEX_GEMINI_PARENT_CONTRACT_SHA256:-}" >>"$runner"
  fi
  if [[ -n "$SC_TEAM_MEMBER_NAME" || -n "$SC_TEAM_MEMBER_CAMPAIGN_ID" ]]; then
    [[ -n "$SC_TEAM_MEMBER_NAME" && -n "$SC_TEAM_MEMBER_CAMPAIGN_ID" ]] || \
      sc_die "detached worker team identity is incomplete" 70
    printf 'export SANDCODEX_TEAM_MEMBER_NAME=%q\n' "$SC_TEAM_MEMBER_NAME" >>"$runner"
    printf 'export SANDCODEX_TEAM_CAMPAIGN_ID=%q\n' "$SC_TEAM_MEMBER_CAMPAIGN_ID" >>"$runner"
  fi
  if [[ "${SANDCODEX_TESTING:-0}" == 1 ]]; then
    printf 'export SANDCODEX_TESTING=1 SANDCODEX_TEST_RESOURCE_SCOPE=%q SANDCODEX_TEST_CODEX_BIN=%q\n' \
      "${SANDCODEX_TEST_RESOURCE_SCOPE:-0}" "$SC_CODEX" >>"$runner"
  fi
  printf 'turns=%q\nresume=%q\n' "$SC_LOOP_TURNS" "$([[ $SC_RESUME == fresh ]] && printf 0 || printf 1)" >>"$runner"
  sc_shell_array "$runner" base "${base[@]}"
  sc_shell_array "$runner" provider "${provider[@]}"
  cat >>"$runner" <<'RUNNER_BODY'
already_complete=0
if [[ -f $state && ! -L $state ]] && jq -e --arg id "$id" '.supervisor_id == $id' "$state" >/dev/null 2>&1; then
  saved_limit=$(jq -r '.turn_limit' "$state")
  saved_success=$(jq -r '.successful_turns // 0' "$state")
  if [[ $saved_limit =~ ^[0-9]+$ && $saved_success =~ ^[0-9]+$ ]]; then
    if ((saved_limit == 0)); then turns=0; else turns=$((saved_limit - saved_success)); fi
    if ((turns <= 0 && saved_limit != 0)); then already_complete=1; fi
    if [[ -d $sessions ]] && find "$sessions" -type f -name '*.jsonl' -print -quit 2>/dev/null | grep -q .; then resume=1; fi
  fi
fi
command=("${base[@]}" --turns "$turns")
((resume == 0)) || command+=(--RESUME)
((${#provider[@]} == 0)) || command+=(-- "${provider[@]}")
if ((already_complete)); then
  rc=0; final=completed
else
  set +e
  env SANDCODEX_SUPERVISED=1 SANDCODEX_SUPERVISOR_ID="$id" \
    SANDCODEX_SUPERVISOR_UNIT="${SANDCODEX_SUPERVISOR_UNIT:-}" "$launcher" "${command[@]}"
  rc=$?
  set -e
  final=interrupted
  if [[ -f $state && ! -L $state ]]; then
    final=$(jq -r '.status // "interrupted"' "$state" 2>/dev/null || printf interrupted)
  elif ((rc == 0)); then
    final=completed
  elif ((rc == 130 || rc == 143)); then
    final=interrupted
  else
    final=failed
  fi
fi
case "$final" in
  completed|drained|failed|retry_exhausted|guarded|interrupted|stale|storage_hold|blocked_failed) ;;
  *)
    if ((rc == 130 || rc == 143)); then final=interrupted; else final=failed; fi
    ;;
esac
case "$final" in
  completed)
    rm -f -- "$active" "$recoverable"
    ;;
  interrupted)
    if jq -e '.recover_on_boot == true' "$spec" >/dev/null 2>&1; then
      # Preserve the boot condition only for an explicitly persistent loop.
      rm -f -- "$recoverable"
    else
      tmp=$(mktemp "${recoverable%/*}/.recoverable.XXXXXX")
      printf '%s\n' "$final" >"$tmp"; chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$recoverable"
      rm -f -- "$active"
    fi
    ;;
  drained|failed|retry_exhausted|guarded|stale|storage_hold|blocked_failed)
    # A terminal-but-incomplete loop is manually recoverable. Do not leave the
    # boot-active marker behind: an explicit stop must stay stopped across boot.
    tmp=$(mktemp "${recoverable%/*}/.recoverable.XXXXXX")
    printf '%s\n' "$final" >"$tmp"; chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$recoverable"
    rm -f -- "$active"
    ;;
esac
tmp=$(mktemp "${spec%/*}/.spec.XXXXXX")
jq --arg status "$final" --arg completed_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --argjson exit_code "$rc" \
  '.status=$status | .last_exit=$exit_code | .updated_at=$completed_at' "$spec" >"$tmp"
chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$spec"
if [[ ! -e $active ]] && jq -e '.recover_on_boot == true' "$spec" >/dev/null 2>&1; then
  boot_unit=$(jq -r '.unit' "$spec")
  if systemctl_bin=$(command -v systemctl 2>/dev/null); then
    "$systemctl_bin" --user disable "$boot_unit" >/dev/null 2>&1 || true
  fi
fi
exit "$rc"
RUNNER_BODY
  chmod 500 -- "$runner"

  jq -cn --arg schema "sandcodex.supervisor.v1" --arg id "$id" --arg project "$SC_PROJECT" \
    --arg unit "$unit.service" --arg created_at "$(sc_now)" --arg artifact_sha256 "$digest" \
    --arg prompt_sha256 "$(sha256sum -- "$prompt" | awk '{print $1}')" --argjson turns "$SC_LOOP_TURNS" \
    --argjson recover_on_boot "$SC_LOOP_RECOVER_ON_BOOT" \
    '{schema:$schema,id:$id,project:$project,unit:$unit,status:"queued",turns:$turns,
      recover_on_boot:($recover_on_boot == 1),artifact_sha256:$artifact_sha256,
      prompt_sha256:$prompt_sha256,created_at:$created_at,updated_at:$created_at,last_exit:null}' >"$spec"
  chmod 600 -- "$spec"
  cat >"$root/OWNER" <<EOF
schema=sandcodex.supervisor.v1
id=$id
project=$SC_PROJECT
uid=$(id -u)
artifact_sha256=$digest
EOF
  chmod 600 -- "$root/OWNER"

  if (( SC_LOOP_RECOVER_ON_BOOT )); then
    [[ -n "$SC_SYSTEMCTL" && -x "$SC_SYSTEMCTL" ]] || sc_die "--recover-on-boot requires systemctl --user"
    unit_file="$root/$unit.service"
    cat >"$unit_file" <<EOF
[Unit]
Description=Sandcodex supervised loop
After=network-online.target
ConditionPathExists=$(sc_systemd_quote "$active")

[Service]
Type=exec
ExecStart=$(sc_systemd_quote "$runner")
Environment=$(sc_systemd_quote "SANDCODEX_SUPERVISOR_UNIT=$unit.service")
Environment=$(sc_systemd_quote "SANDCODEX_RESOURCE_SCOPE=$unit.service")
MemoryMax=$SC_MEMORY_MAX
MemorySwapMax=0
TasksMax=$SC_TASKS_MAX
OOMPolicy=kill
KillMode=control-group

[Install]
WantedBy=default.target
EOF
    chmod 600 -- "$unit_file"
    "$SC_SYSTEMCTL" --user link "$unit_file" >/dev/null
    "$SC_SYSTEMCTL" --user enable --now "$unit.service" >/dev/null
  else
    "$SC_SYSTEMD_RUN" --user --quiet --collect --no-block --unit "$unit" \
      -p Type=exec -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 -p "TasksMax=$SC_TASKS_MAX" \
      -p OOMPolicy=kill -p KillMode=control-group \
      env "SANDCODEX_SUPERVISOR_UNIT=$unit.service" "SANDCODEX_RESOURCE_SCOPE=$unit.service" "$runner"
  fi
  if (( SC_LOOP_JSON )); then
    jq -cn --arg schema "sandcodex.detached-launch.v1" --arg supervisor_id "$id" \
      --arg unit "$unit.service" --arg project "$SC_PROJECT" --arg state_file "$status_file" \
      --arg created_at "$(sc_now)" --argjson turns "$SC_LOOP_TURNS" \
      '{schema:$schema,status:"started",supervisor_id:$supervisor_id,unit:$unit,
        project:$project,state_file:$state_file,turns:$turns,created_at:$created_at}'
  else
    sc_ok "detached loop started · $unit.service"
    sc_note "status: sandcodex loop status · journal: journalctl --user -u $unit.service -f"
  fi
}

sc_recover_detached_loop() {
  [[ -n "$SC_SYSTEMD_RUN" && -x "$SC_SYSTEMD_RUN" ]] || sc_die "loop recovery requires systemd-run"
  local project_root="$SC_GLOBAL/supervisors/$SC_PROJECT_KEY" root marker id digest unit state="" tmp
  local status_file="$SC_CONTROL/loop-state.json" turns recovery_marker=""
  [[ -d "$project_root" && ! -L "$project_root" ]] || sc_die "no recoverable Sandcodex loop exists for this project"
  root="$(find -P "$project_root" -mindepth 2 -maxdepth 2 -type f \
    \( -name active -o -name recoverable \) -printf '%h\n' | LC_ALL=C sort -u | tail -n 1)"
  [[ -n "$root" ]] || sc_die "no recoverable Sandcodex loop exists for this project"
  marker="$root/OWNER"
  sc_owned_dir "$root" "loop supervisor directory"; sc_owned_single_file "$marker" 600 "loop supervisor marker"
  [[ "$(sc_marker "$marker" schema)" == sandcodex.supervisor.v1 && \
    "$(sc_marker "$marker" project)" == "$SC_PROJECT" && "$(sc_marker "$marker" uid)" == "$(id -u)" ]] || \
    sc_die "recoverable loop supervisor marker is invalid"
  id="$(sc_marker "$marker" id)"; digest="$(sc_marker "$marker" artifact_sha256)"
  sc_owned_single_file "$root/sandcodex" 500 "supervised launcher"; sc_owned_single_file "$root/runner" 500 "loop supervisor runner"
  sc_owned_single_file "$root/spec.json" 600 "loop supervisor specification"
  [[ "$(sha256sum -- "$root/sandcodex" | awk '{print $1}')" == "$digest" ]] || sc_die "supervised launcher digest mismatch"
  if [[ -e "$root/active" && -e "$root/recoverable" ]]; then
    sc_die "loop supervisor has ambiguous active and recoverable markers"
  elif [[ -f "$root/active" && ! -L "$root/active" ]]; then
    sc_owned_single_file "$root/active" 600 "active loop supervisor marker"
  else
    recovery_marker="$root/recoverable"
    sc_owned_single_file "$recovery_marker" 600 "recoverable loop supervisor marker"
  fi
  if [[ -f "$SC_CONTROL/loop-state.json" && ! -L "$SC_CONTROL/loop-state.json" ]]; then
    state="$(sc_loop_read_state "$SC_CONTROL/loop-state.json")"
    if sc_loop_state_process_is_live "$state"; then sc_die "the supervised loop is still running"; fi
  fi
  unit="sandcodex-loop-${SC_PROJECT_KEY:0:16}-recover-$(date -u +%H%M%S)-$$"
  if [[ -n "$recovery_marker" ]]; then
    tmp="$(mktemp "$root/.active.XXXXXX")"
    printf 'active\n' >"$tmp"; chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$root/active"
    rm -f -- "$recovery_marker"
  fi
  tmp="$(mktemp "$root/.spec.XXXXXX")"
  jq --arg unit "$unit.service" --arg updated_at "$(sc_now)" \
    '.unit=$unit | .status="queued" | .updated_at=$updated_at | .last_exit=null' \
    "$root/spec.json" >"$tmp"
  chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$root/spec.json"
  "$SC_SYSTEMD_RUN" --user --quiet --collect --no-block --unit "$unit" \
    -p Type=exec -p "MemoryMax=$SC_MEMORY_MAX" -p MemorySwapMax=0 -p "TasksMax=$SC_TASKS_MAX" \
    -p OOMPolicy=kill -p KillMode=control-group \
    env "SANDCODEX_SUPERVISOR_UNIT=$unit.service" "SANDCODEX_RESOURCE_SCOPE=$unit.service" "$root/runner"
  if (( SC_LOOP_JSON )); then
    turns="$(jq -r '.turns' "$root/spec.json")"
    [[ "$turns" =~ ^[0-9]+$ ]] || sc_die "recoverable loop turn limit is invalid"
    jq -cn --arg schema "sandcodex.detached-launch.v1" --arg supervisor_id "$id" \
      --arg unit "$unit.service" --arg project "$SC_PROJECT" --arg state_file "$status_file" \
      --arg created_at "$(sc_now)" --argjson turns "$turns" \
      '{schema:$schema,status:"recovered",supervisor_id:$supervisor_id,unit:$unit,
        project:$project,state_file:$state_file,turns:$turns,created_at:$created_at}'
  else
    sc_ok "recovered supervised loop $id · $unit.service"
  fi
}

sc_loop_failure_class() {
  local stdout_file="$1" stderr_file="$2" rc="$3"
  (( rc != 0 )) || { printf 'none\n'; return; }
  # Rust reserves 101 for a panic. Check its concrete trailer before scanning
  # provider text: tool output is untrusted and may merely discuss quotas,
  # authentication, or transient failures.
  if (( rc == 101 )) && tail -c 131072 -- "$stderr_file" 2>/dev/null |
      rg -qi "thread '[^']+' .*panicked at|failed printing to (stdout|stderr):.*(os error|broken pipe|resource temporarily unavailable)"; then
    printf 'boundary\n'
  elif rg -qi 'unauthori[sz]ed|authentication (failed|required)|invalid (api[ -]?key|token)|login required|http[^0-9]*401|status[^0-9]*401' \
      "$stdout_file" "$stderr_file" 2>/dev/null; then
    printf 'auth\n'
  elif rg -qi 'usage[_ -]?limit|rate[_ -]?limit|too many requests|quota|http[^0-9]*429|status[^0-9]*429|resets? (at|in)|try again (at|in)' \
      "$stdout_file" "$stderr_file" 2>/dev/null; then
    printf 'quota\n'
  elif rg -qi 'overloaded|capacity|temporar(il)?y unavailable|service unavailable|connection (reset|closed)|timed? out|timeout|http[^0-9]*(502|503|504)|status[^0-9]*(502|503|504)' \
      "$stdout_file" "$stderr_file" 2>/dev/null; then
    printf 'transient\n'
  elif rg -qi 'bubblewrap|\bbwrap\b|sandbox preflight|boundary preflight|invalid (configuration|config)|unknown (argument|option)|usage:|permission denied' \
      "$stdout_file" "$stderr_file" 2>/dev/null; then
    printf 'boundary\n'
  else
    printf 'provider\n'
  fi
}

sc_loop_record_usage() {
  local stdout_file="$1" metrics input cached output session reported
  metrics="$(jq -Rsc '
    split("\n") | map(try fromjson catch empty) as $events
    | [$events[] | select(.type == "turn.completed" or .type == "result") | .usage? | select(type == "object")] as $usage
    | {
        reported:($usage | length > 0),
        input:([$usage[] | (.input_tokens // 0)] | add // 0),
        cached:([$usage[] | (.cached_input_tokens // .cache_read_input_tokens // 0)] | add // 0),
        output:([$usage[] | (.output_tokens // 0)] | add // 0),
        session:([$events[] | (.thread_id? // .session_id? // empty) | select(type == "string")] | last // "")
      }
  ' "$stdout_file" 2>/dev/null || printf '{"reported":false,"input":0,"cached":0,"output":0,"session":""}')"
  input="$(jq -r '.input // 0' <<<"$metrics")"; cached="$(jq -r '.cached // 0' <<<"$metrics")"
  output="$(jq -r '.output // 0' <<<"$metrics")"; session="$(jq -r '.session // ""' <<<"$metrics")"
  reported="$(jq -r 'if .reported then 1 else 0 end' <<<"$metrics")"
  [[ "$input" =~ ^[0-9]+$ && "$cached" =~ ^[0-9]+$ && "$output" =~ ^[0-9]+$ ]] || return 0
  (( SC_LOOP_INPUT_TOKENS += input ))
  (( SC_LOOP_CACHED_INPUT_TOKENS += cached ))
  (( SC_LOOP_OUTPUT_TOKENS += output ))
  (( SC_LOOP_USAGE_REPORTED |= reported ))
  [[ "$session" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] &&
    SC_LOOP_SESSION_ID="${session,,}"
}

sc_loop_expected_native_provider() {
  case "$SC_PROVIDER_MODE" in
    gpt) printf 'openai\n' ;;
    local) printf '%s\n' "${SC_LOCAL_PROVIDER:-ollama}" ;;
    remote) printf '%s\n' "$SC_REMOTE_NATIVE_PROVIDER" ;;
    gemini) printf '%s\n' "$SC_GEMINI_NATIVE_PROVIDER" ;;
    *) return 1 ;;
  esac
}

sc_loop_human_session_id() {
  local stderr_file="$1"
  python3 -P - "$stderr_file" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
try:
    data = path.read_bytes()[: 512 * 1024].decode("utf-8", "replace")
except OSError:
    raise SystemExit(0)
data = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", data)
pattern = re.compile(
    r"^\s*session id:\s*"
    r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\s*$"
)
for line in data.splitlines():
    match = pattern.fullmatch(line)
    if match:
        print(match.group(1).lower())
        break
PY
}

sc_loop_resolve_attempt_session() {
  local resume_target="$1" stdout_file="$2" stderr_file="$3"
  local expected candidate observed="" human selected rc=0
  local -a candidates=()
  expected=$(sc_loop_expected_native_provider) || return 78
  : "$stdout_file"  # JSON session identity was already collected by sc_loop_record_usage.
  [[ -z "$SC_SESSION_BINDING_THREAD_ID" ]] || candidates+=("${SC_SESSION_BINDING_THREAD_ID,,}")
  [[ -z "$SC_LOOP_SESSION_ID" ]] || candidates+=("${SC_LOOP_SESSION_ID,,}")
  human=$(sc_loop_human_session_id "$stderr_file")
  [[ -z "$human" ]] || candidates+=("$human")
  if [[ "$resume_target" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    candidates+=("${resume_target,,}")
  fi
  for candidate in "${candidates[@]}"; do
    [[ "$candidate" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 78
    if [[ -n "$observed" && "$candidate" != "$observed" ]]; then
      sc_err "Codex attempt reported conflicting conversation identities; refusing ambiguous continuation"
      return 78
    fi
    observed=$candidate
  done
  if [[ -z "$observed" && "$resume_target" == last ]]; then
    selected=$(sc_emit_session_selector | python3 -P - \
      --sessions "$SC_CONTROL/codex-home/sessions" --project "$SC_PROJECT" --provider "$expected") || rc=$?
    if (( rc == 0 )); then observed=$(jq -er '.id' <<<"$selected") || return 78; fi
  fi
  [[ -n "$observed" ]] || return 1
  rc=0
  selected=$(sc_emit_session_selector | python3 -P - \
    --sessions "$SC_CONTROL/codex-home/sessions" --project "$SC_PROJECT" \
    --id "$observed" --provider "$expected") || rc=$?
  if (( rc != 0 )); then
    # A fresh Codex process prints its UUID before the first durable user turn.
    # With no established history there can be no completed tool side effect,
    # so replaying the original prompt is safe. Known resume targets must never
    # disappear or silently turn into another conversation.
    [[ "$resume_target" == fresh && $rc == 66 ]] && return 1
    sc_err "the exact Codex conversation could not be reselected for continuation"
    return 78
  fi
  [[ "$(jq -er '.id' <<<"$selected")" == "$observed" &&
      "$(jq -er '.provider' <<<"$selected")" == "$expected" ]] || return 78
  SC_LOOP_SESSION_ID=$observed
  return 0
}

sc_loop_append_telemetry() {
  local started_at="$1" duration="$2" rc="$3" class="$4"
  [[ -n "$SC_LOOP_TELEMETRY" ]] || return 0
  jq -cn --arg schema "$SC_LOOP_SCHEMA" --arg run_id "$SC_RUN_ID" --arg started_at "$started_at" \
    --arg completed_at "$(sc_now)" --arg class "$class" --arg model "$SC_MODEL" \
    --arg session_id "$SC_LOOP_SESSION_ID" --argjson turn "$SC_LOOP_CURRENT_TURN" \
    --argjson attempt "$SC_LOOP_ATTEMPTS" --argjson duration "$duration" --argjson exit_code "$rc" \
    --argjson input_tokens "$SC_LOOP_INPUT_TOKENS" --argjson cached_input_tokens "$SC_LOOP_CACHED_INPUT_TOKENS" \
    --argjson output_tokens "$SC_LOOP_OUTPUT_TOKENS" \
    '{schema:$schema,run_id:$run_id,turn:$turn,attempt:$attempt,started_at:$started_at,
      completed_at:$completed_at,duration_seconds:$duration,exit_code:$exit_code,class:$class,
      model:(if $model == "" then null else $model end),session_id:(if $session_id == "" then null else $session_id end),
      cumulative_usage:{input_tokens:$input_tokens,cached_input_tokens:$cached_input_tokens,
        output_tokens:$output_tokens,total_tokens:($input_tokens+$output_tokens)}}' >>"$SC_LOOP_TELEMETRY"
}

sc_loop_retry_delay() {
  local capture="$1" delay="$SC_LOOP_RETRY_BASE_SECONDS" i hinted="" room jitter=0
  for ((i=1; i<SC_LOOP_RETRY_COUNT; i++)); do
    (( delay >= SC_LOOP_RETRY_MAX_SECONDS )) && break
    (( delay *= 2 ))
  done
  (( delay <= SC_LOOP_RETRY_MAX_SECONDS )) || delay="$SC_LOOP_RETRY_MAX_SECONDS"
  hinted="$(rg -io 'retry[-_ ]?after[" :]+[0-9]{1,7}' "$capture" 2>/dev/null | rg -o '[0-9]+' | head -n 1 || true)"
  if [[ "$hinted" =~ ^[0-9]+$ && "$hinted" -le "$SC_LOOP_RETRY_MAX_SECONDS" ]]; then delay="$hinted"; fi
  if [[ "${SANDCODEX_TEST_RETRY_DELAY_SECONDS:-}" =~ ^[0-9]+$ ]]; then
    delay="$SANDCODEX_TEST_RETRY_DELAY_SECONDS"
  elif (( delay < SC_LOOP_RETRY_MAX_SECONDS )); then
    room=$((SC_LOOP_RETRY_MAX_SECONDS - delay)); (( room <= 10 )) || room=10
    jitter=$((RANDOM % (room + 1))); (( delay += jitter ))
  fi
  printf '%s\n' "$delay"
}

sc_loop_wait_for_retry() {
  local class="$1" delay="$2" now next step
  now="$(date +%s)"; next=$((now + delay))
  SC_LOOP_STATUS="waiting_$class"
  SC_LOOP_NEXT_ATTEMPT_AT="$(date -u -d "@$next" '+%Y-%m-%dT%H:%M:%SZ')"
  sc_loop_write_state
  sc_warn "loop $class limit · retry $SC_LOOP_RETRY_COUNT / $SC_LOOP_RETRY_LIMIT at $SC_LOOP_NEXT_ATTEMPT_AT"
  while :; do
    sc_loop_consume_requests
    sc_loop_write_state
    (( ! SC_LOOP_STOP )) || return 1
    now="$(date +%s)"
    (( now < next )) || break
    step=$((next - now)); (( step <= 5 )) || step=5
    sleep "$step"
  done
  SC_LOOP_NEXT_ATTEMPT_AT=""
  return 0
}

sc_loop_disk_guard() {
  local free_kib required_kib current growth limit downloads profile nix_free_kib
  if (( SC_LOOP_PROJECT_BASELINE_BYTES == 0 )); then
    SC_LOOP_PROJECT_BASELINE_BYTES="$(sc_path_bytes "$SC_PROJECT")"
  fi
  free_kib="$(df -Pk -- "$SC_PROJECT" | awk 'END {print $4}')"
  nix_free_kib="$(df -Pk -- /nix/store 2>/dev/null | awk 'END {print $4}' || true)"
  [[ "$free_kib" =~ ^[0-9]+$ ]] || free_kib=0
  if [[ "$nix_free_kib" =~ ^[0-9]+$ && "$nix_free_kib" -lt "$free_kib" ]]; then free_kib="$nix_free_kib"; fi
  required_kib=$((SC_LOOP_MIN_FREE_MIB * 1024))
  if (( required_kib > 0 && free_kib < required_kib )); then
    SC_LOOP_LAST_ERROR_CLASS=disk; SC_LOOP_STATUS=guarded; SC_LOOP_NEXT_ATTEMPT_AT=""; sc_loop_write_state
    sc_err "loop storage guard: only $((free_kib / 1024)) MiB free; requires $SC_LOOP_MIN_FREE_MIB MiB"
    return 78
  fi
  current="$(sc_path_bytes "$SC_PROJECT")"; growth=$((current - SC_LOOP_PROJECT_BASELINE_BYTES))
  (( growth >= 0 )) || growth=0
  limit=$((SC_LOOP_MAX_PROJECT_GROWTH_MIB * 1024 * 1024))
  if (( limit > 0 && growth > limit )); then
    SC_LOOP_LAST_ERROR_CLASS=disk; SC_LOOP_STATUS=guarded; sc_loop_write_state
    sc_err "loop storage guard: project grew by more than $SC_LOOP_MAX_PROJECT_GROWTH_MIB MiB"
    return 78
  fi
  downloads="$(sc_path_bytes "$SC_BROWSER_DOWNLOADS")"
  limit=$((SC_LOOP_MAX_DOWNLOADS_MIB * 1024 * 1024))
  if (( limit > 0 && downloads > limit )); then
    SC_LOOP_LAST_ERROR_CLASS=disk; SC_LOOP_STATUS=guarded; sc_loop_write_state
    sc_err "loop storage guard: downloads exceed $SC_LOOP_MAX_DOWNLOADS_MIB MiB"
    return 78
  fi
  profile=0; [[ -z "$SC_BROWSER_PROFILE" ]] || profile="$(sc_path_bytes "$SC_BROWSER_PROFILE")"
  limit=$((SC_LOOP_MAX_PROFILE_MIB * 1024 * 1024))
  if (( limit > 0 && profile > limit )); then
    SC_LOOP_LAST_ERROR_CLASS=disk; SC_LOOP_STATUS=guarded; sc_loop_write_state
    sc_err "loop storage guard: browser profile exceeds $SC_LOOP_MAX_PROFILE_MIB MiB"
    return 78
  fi
}

sc_loop_launch_turn() {
  local resume_target="$1" prompt="$2" rc=0
  local provider_pid=""
  local -a argv=() campaign_env=()
  SC_LOOP_CAPTURE_STDOUT="$SC_CONTROL/tmp/.loop-$SC_RUN_ID.stdout"
  SC_LOOP_CAPTURE_STDERR="$SC_CONTROL/tmp/.loop-$SC_RUN_ID.stderr"
  : >"$SC_LOOP_CAPTURE_STDOUT"; : >"$SC_LOOP_CAPTURE_STDERR"
  chmod 600 -- "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"
  sc_loop_codex_argv argv "$resume_target"
  sc_log_event info loop_turn_launch "launching Codex loop turn" \
    "posture=$([[ $SC_BARE == 1 ]] && printf bare-metal || printf safe)" \
    "turn=$SC_LOOP_CURRENT_TURN" "resume_target=$resume_target"
  if (( SC_BARE )); then
    (( ! SC_CAMPAIGN_AVAILABLE )) || campaign_env=(
      "SANDCODEX_CAMPAIGN=$SC_LOCAL/launcher/sandcodex-campaign"
      "SANDCODEX_WORKER=$SC_AGENT_BIN/sandcodex-worker"
    )
    if (( SC_CAMPAIGN_AVAILABLE )) || [[ -n "$SC_TEAM_MEMBER_NAME" ]]; then
      campaign_env+=("SANDCODEX_TEAM=$SC_AGENT_BIN/sandcodex-team")
    fi
    sc_exec_clean_fds "$SC_SETPRIV" --pdeathsig TERM env HOME="$SC_CONTROL/frontend-home" CODEX_HOME="$SC_CONTROL/codex-home" \
      TMPDIR="$SC_CONTROL/tmp" XDG_CACHE_HOME="$SC_CONTROL/xdg-cache" \
      XDG_CONFIG_HOME="$SC_CONTROL/xdg-config" XDG_DATA_HOME="$SC_CONTROL/xdg-data" \
      XDG_STATE_HOME="$SC_CONTROL/xdg-state" \
      PATH="$SC_AGENT_BIN:$SC_LOCAL/launcher:$SC_BARE_PATH" \
      SANDCODEX_ACTIVE=1 SANDCODEX_OUTER_PROJECT="$SC_PROJECT" \
      SANDCODEX_RUN_ID="$SC_RUN_ID" SANDCODEX_LOOPER="$SC_LOCAL/launcher/sandcodex" \
      SANDCODEX_BARE_METAL=1 "${campaign_env[@]}" "${argv[@]}" < <(printf '%s\n' "$prompt") \
      >"$SC_LOOP_CAPTURE_STDOUT" 2>"$SC_LOOP_CAPTURE_STDERR" & SC_CHILD_PID=$!
  else
    SC_BWRAP_EXEC=1 sc_bwrap "${argv[@]}" < <(printf '%s\n' "$prompt") \
      >"$SC_LOOP_CAPTURE_STDOUT" 2>"$SC_LOOP_CAPTURE_STDERR" & SC_CHILD_PID=$!
  fi
  provider_pid="$SC_CHILD_PID"
  SC_CHILD_START="$(sc_process_start "$SC_CHILD_PID" 2>/dev/null || true)"
  # Codex writes only to private regular files. Followers preserve live output
  # without letting a slow or temporarily blocked terminal stall the provider.
  tail --pid="$provider_pid" --sleep-interval=0.05 -n +1 -f -- "$SC_LOOP_CAPTURE_STDOUT" &
  SC_LOOP_STDOUT_FOLLOW_PID=$!
  tail --pid="$provider_pid" --sleep-interval=0.05 -n +1 -f -- "$SC_LOOP_CAPTURE_STDERR" >&2 &
  SC_LOOP_STDERR_FOLLOW_PID=$!
  sc_family_start_session_binding_watcher
  if (( SC_BARE )); then
    wait "$SC_CHILD_PID" || rc=$?
    SC_CHILD_PID=""; SC_CHILD_START=""
  else
    sc_wait_safe_provider || rc=$?
  fi
  wait "$SC_LOOP_STDOUT_FOLLOW_PID" 2>/dev/null || true
  wait "$SC_LOOP_STDERR_FOLLOW_PID" 2>/dev/null || true
  SC_LOOP_STDOUT_FOLLOW_PID=""; SC_LOOP_STDERR_FOLLOW_PID=""
  sc_family_finalize_session_binding 1 "$(( rc != 0 ))"
  sc_reconcile_frontend_auth
  if (( SC_FRONTEND_LOGOUT )); then
    printf 'Sandcodex authentication was removed by the Codex frontend\n' >&2
    (( rc != 0 )) || rc=77
  fi
  sleep 0.02
  return "$rc"
}

sc_loop_execute_turn() {
  local resume="$1" prompt="$2" rc class started_epoch started_at duration delay now elapsed retryable
  local resume_target=fresh session_rc=0
  if (( resume )); then
    if [[ "$SC_LOOP_SESSION_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      resume_target=${SC_LOOP_SESSION_ID,,}
    elif [[ "$SC_RESUME_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
      resume_target=${SC_RESUME_ID,,}
    else
      resume_target=last
    fi
  fi
  while :; do
    sc_loop_disk_guard || return $?
    (( SC_LOOP_ATTEMPTS += 1 ))
    SC_LOOP_STATUS=running; SC_LOOP_LAST_ERROR_CLASS=none; SC_LOOP_NEXT_ATTEMPT_AT=""
    sc_loop_write_state
    started_epoch="$(date +%s)"; started_at="$(sc_now)"
    rc=0; sc_loop_launch_turn "$resume_target" "$prompt" || rc=$?
    duration=$(( $(date +%s) - started_epoch )); (( duration >= 0 )) || duration=0
    (( SC_LOOP_TOTAL_DURATION_SECONDS += duration ))
    class="$(sc_loop_failure_class "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR" "$rc")"
    sc_loop_record_usage "$SC_LOOP_CAPTURE_STDOUT"
    session_rc=0
    sc_loop_resolve_attempt_session "$resume_target" "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR" || session_rc=$?
    if (( session_rc == 78 )); then
      class=continuity
      rc=78
    fi
    sc_loop_append_telemetry "$started_at" "$duration" "$rc" "$class"
    SC_LOOP_LAST_EXIT=$rc; SC_LOOP_LAST_ERROR_CLASS="$class"
    if (( rc == 0 )); then
      rm -f -- "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"
      SC_LOOP_CAPTURE_STDOUT=""; SC_LOOP_CAPTURE_STDERR=""
      (( SC_LOOP_SUCCESSFUL_TURNS += 1 ))
      SC_LOOP_LAST_ERROR_CLASS=none; SC_LOOP_RETRY_STARTED_EPOCH=0
      sc_loop_write_state
      return 0
    fi
    retryable=0; [[ "$class" == quota || "$class" == transient ]] && retryable=1
    if (( ! retryable || ! SC_LOOP_AUTO_RESUME || SC_LOOP_RETRY_COUNT >= SC_LOOP_RETRY_LIMIT )); then
      rm -f -- "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"
      SC_LOOP_CAPTURE_STDOUT=""; SC_LOOP_CAPTURE_STDERR=""
      if (( retryable && SC_LOOP_AUTO_RESUME )); then SC_LOOP_STATUS=retry_exhausted; else SC_LOOP_STATUS=failed; fi
      sc_loop_write_state
      return "$rc"
    fi
    if [[ "$SC_LOOP_SESSION_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
      resume_target=$SC_LOOP_SESSION_ID
      prompt=$SC_LOOP_RETRY_CONTINUATION_PROMPT
    elif (( SC_SESSION_BINDING_PENDING )); then
      # The alternate-provider binding helper proved that no durable user turn
      # exists. Replaying the original prompt into a fresh thread cannot repeat
      # a tool side effect, and the same immutable claim remains armed.
      resume_target=fresh
    elif (( session_rc == 1 )) && [[ "$resume_target" == fresh ]]; then
      # Codex did not persist an established user turn, so the original prompt
      # has not crossed a tool boundary and is safe to submit again.
      resume_target=fresh
    else
      rm -f -- "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"
      SC_LOOP_CAPTURE_STDOUT=""; SC_LOOP_CAPTURE_STDERR=""
      SC_LOOP_LAST_ERROR_CLASS=continuity; SC_LOOP_STATUS=failed
      sc_loop_write_state
      sc_err "automatic retry could not pin the interrupted Codex conversation; refusing to replay the original prompt"
      return 78
    fi
    now="$(date +%s)"
    (( SC_LOOP_RETRY_STARTED_EPOCH != 0 )) || SC_LOOP_RETRY_STARTED_EPOCH=$now
    (( SC_LOOP_RETRY_COUNT += 1 ))
    delay="$(sc_loop_retry_delay "$SC_LOOP_CAPTURE_STDERR")"
    rm -f -- "$SC_LOOP_CAPTURE_STDOUT" "$SC_LOOP_CAPTURE_STDERR"
    SC_LOOP_CAPTURE_STDOUT=""; SC_LOOP_CAPTURE_STDERR=""
    elapsed=$((now - SC_LOOP_RETRY_STARTED_EPOCH))
    if (( SC_LOOP_RETRY_MAX_WAIT_SECONDS > 0 && elapsed + delay > SC_LOOP_RETRY_MAX_WAIT_SECONDS )); then
      SC_LOOP_STATUS=retry_exhausted; sc_loop_write_state
      return "$rc"
    fi
    if ! sc_loop_wait_for_retry "$class" "$delay"; then
      SC_LOOP_STATUS=drained; SC_LOOP_LAST_EXIT=0; SC_LOOP_NEXT_ATTEMPT_AT=""; sc_loop_write_state
      return 0
    fi
    if [[ -n "$SC_LOOP_CONTROL_PROMPT" ]]; then
      prompt+="$SC_LOOP_CONTROL_PROMPT"
      SC_LOOP_CONTROL_PROMPT=""
    fi
  done
}

sc_loop_run_turns() {
  local resume="$1" prompt rc
  while :; do
    sc_loop_consume_requests
    if (( SC_LOOP_STOP )); then
      SC_LOOP_STATUS=drained; SC_LOOP_LAST_EXIT=0; sc_loop_write_state
      sc_ok "loop drained after turn $SC_LOOP_CURRENT_TURN"
      return 0
    fi
    (( SC_LOOP_REMAINING != 0 )) || break
    (( SC_LOOP_REMAINING == -1 )) || (( SC_LOOP_REMAINING -= 1 ))
    (( SC_LOOP_CURRENT_TURN += 1 ))
    prompt="$SC_LOOP_REPEAT_PROMPT$SC_LOOP_CONTROL_PROMPT"
    SC_LOOP_CONTROL_PROMPT=""
    SC_LOOP_MODE=loop; SC_LOOP_STATUS=running; sc_loop_write_state
    sc_note "loop · turn $SC_LOOP_CURRENT_TURN / $([[ $SC_LOOP_TURN_LIMIT == 0 ]] && printf unbounded || printf '%s' "$SC_LOOP_TURN_LIMIT") · $([[ $SC_BARE == 1 ]] && printf BARE-METAL || printf safe)"
    rc=0; sc_loop_execute_turn "$resume" "$prompt" || rc=$?
    if (( SC_LOOP_STOP )); then
      SC_LOOP_STATUS=drained; SC_LOOP_LAST_EXIT=0; sc_loop_write_state
      sc_ok "loop drained after turn $SC_LOOP_CURRENT_TURN"
      return 0
    fi
    if (( rc != 0 )); then
      return "$rc"
    fi
    resume=1
  done
  SC_LOOP_STATUS=completed; SC_LOOP_LAST_EXIT=0; sc_loop_write_state
  if [[ "$SC_LOOP_MODE" == interactive && "$SC_LOOP_CURRENT_TURN" == 1 ]]; then
    sc_ok "interactive session closed"
  else
    sc_ok "loop complete · $SC_LOOP_CURRENT_TURN turns"
  fi
}

