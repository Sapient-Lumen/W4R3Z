static void seat_capabilities(void *data, struct wl_seat *seat,
        uint32_t capabilities) {
    struct drop_state *state = data;
    const bool pointer_available =
        (capabilities & WL_SEAT_CAPABILITY_POINTER) != 0U;
    if (pointer_available && state->pointer == NULL) {
        state->pointer = wl_seat_get_pointer(seat);
        if (state->pointer == NULL ||
                wl_pointer_add_listener(state->pointer, &pointer_listener, state) < 0) {
            state->terminal_error = true;
            return;
        }
    } else if (!pointer_available && state->pointer != NULL) {
        wl_pointer_destroy(state->pointer);
        state->pointer = NULL;
        state->pointer_entered = false;
        if (state->started) {
            state->terminal_error = true;
        }
    }
    state->pointer_available = pointer_available;
}

