        runtime.candidates = ["gemini-strong", "gemini-fallback"]
        runtime.key_schedule_starts = {key_id: 0 for key_id, _label, _key in runtime.keys}
        runtime.account_cursor = 0
        runtime.account_cursor_assignments = 0
        schedules: list[list[tuple[str, str, str]]] = []
        for index in range(5):
            cursor_request = {"model": "route", "input": f"cursor-{index}"}
            cursor_fingerprint, _route_deadline, _request_deadline = \
                runtime.request_window(cursor_request, None)
            rows = runtime.attempts(fingerprint=cursor_fingerprint)
            assert runtime.reserve_attempt(cursor_fingerprint, rows[0][0], rows[0][1])
            schedules.append(rows)
            runtime.complete_request_window(cursor_fingerprint)
        assert [rows[0][1] for rows in schedules] == [
            "000000000001", "000000000002", "000000000003",
            "000000000004", "000000000005"]
        for index, rows in enumerate(schedules):
            key_order = runtime.keys[index:] + runtime.keys[:index]
            expected = [
                (model, key_id)
                for model in runtime.candidates
                for key_id, _label, _key in key_order
            ]
            assert [row[:2] for row in rows] == expected
        assert runtime.key_schedule_starts == {
            "000000000001": 1, "000000000002": 1, "000000000003": 1,
            "000000000004": 1, "000000000005": 1}
        assert runtime.account_cursor_assignments == 5
        runtime.account_cursor = 0
        runtime.key_schedule_starts = {
            key_id: 0 for key_id, _label, _key in runtime.keys}

        class PrimaryUnavailable:
            def available(self, key_id: str, _model: str, *, ignore: bool) -> bool:
