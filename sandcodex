    "  endpoint     downstream /v1/responses → OpenRouter \(.transaction_contract.upstream_path)",
    "  commit       complete response buffered before any downstream bytes",
    "  attempts     up to \(.transaction_contract.maximum_route_attempts) bound model/key routes · \(.transaction_contract.aggregate_request_ceiling_seconds)s aggregate",
    "",
    "supported now",
    "  - fail over within a live remote-auto request before visible output",
    "  - preserve namespaced/custom/tool-search identities and exact call IDs",
    "  - restart a bound resume with the exact relay artifact and bank digests",
    "  - replay an exhausted worker at a clean turn boundary within broker limits",
    "",
    "not supported",
    "  - retry or replay after any bytes become visible",
    "  - incremental token display (safe failover requires full buffering)",
    "  - previous_response_id or provider-side conversation storage",
    "  - replacing a live conversation\u0027s sealed artifact or banks",
    "",
    "implementation inventory",
    (.implemented_router_pieces[] | "    - " + .),
    "",
    "engineering backlog",
    (.next_practical_build[] | "    - " + .),
    "",
    "next",
    "  inspect readiness  sandcodex remote report",
    "  preview selection  sandcodex remote auto --dry-run",
    "  launch             sandcodex remote auto",
    "",
    "privacy",
    "  Read-only inspection; no credential value is printed."
  ' <<<"$result"
}

sc_remote_router_dispatch() {
  local result
  result="$(sc_remote_router_status_json)"
  jq -e '.schema=="sandcodex.remote-router-status.v1" and .automatic_switching.in_flight_responses_router==true and .automatic_switching.transparent_mid_turn_failover==true and .automatic_switching.transparent_stream_replay==false and .automatic_switching.already_running_tui_retarget==false and .automatic_switching.non_router_tui_retarget==false and .transaction_contract.upstream_path=="/api/v1/responses" and .credential_values_disclosed==false' \
    <<<"$result" >/dev/null || sc_die "remote router helper produced invalid JSON" 78
  if (( SC_REMOTE_CATALOG_JSON )); then
    printf '%s\n' "$result"
  else
    sc_remote_router_status_render "$result"
  fi
}

sc_remote_catalog_render_result() {
  local result=$1
  jq -e '
    .schema=="sandcodex.remote-provider-catalog-status.v1" and
    (.default|type)=="string" and (.providers|type)=="array" and
    .credential_values_disclosed==false and .endpoint_probe_run==false and
    .existing_project_snapshots_changed==false and
    .existing_bound_conversations_retargeted==false
  ' <<<"$result" >/dev/null || sc_die "remote catalog helper returned invalid metadata" 78
  if (( SC_REMOTE_CATALOG_JSON )); then
    printf '%s\n' "$result"
    return
  fi
  case "$(jq -r '.result' <<<"$result")" in
    status) printf 'Sandcodex remote providers\n  result      INSPECTION ONLY\n' ;;
    configured) printf 'Sandcodex remote providers\n  result      CONFIGURED · %s\n' "$(jq -r '.operation.name' <<<"$result")" ;;
    default_changed) printf 'Sandcodex remote providers\n  result      DEFAULT CHANGED · %s\n' "$(jq -r '.operation.name' <<<"$result")" ;;
    removed) printf 'Sandcodex remote providers\n  result      REMOVED · %s\n' "$(jq -r '.operation.name' <<<"$result")" ;;
    unchanged) printf 'Sandcodex remote providers\n  result      UNCHANGED\n' ;;
    *) sc_die "remote catalog helper returned an unknown result" 78 ;;
  esac
  printf '  default     %s\n' "$(jq -r '.default' <<<"$result")"
  printf '  network     not contacted\n'
  printf '\nproviders\n'
  jq -r '.providers[] |
    "  " + .name + (if .default then " · DEFAULT" else "" end) +
    (if .builtin then " · built in" else "" end) + "\n" +
    "    endpoint    " + .host + "\n" +
    "    credential  " + .credential_state + " via " + .env_key' <<<"$result"
  printf '\nnotes\n'
  printf '  Credential state above describes provider environment variables; OpenRouter\n'
  printf '  key-bank readiness is reported separately. No key value or endpoint probe is shown.\n'
  printf '  Existing project snapshots and bound conversations were not changed.\n'
  printf '\nnext\n'
  printf '  OpenRouter keys   sandcodex remote keys status\n'
  printf '  OpenRouter models sandcodex remote models --agent --free\n'
  printf '  readiness         sandcodex remote report\n'
  printf '  launch provider   sandcodex remote MODEL --provider NAME\n'
}

sc_remote_catalog_dispatch() {
  local result rc=0 catalog="$SC_GLOBAL/remote/providers.json"
  if [[ "$SC_REMOTE_CATALOG_ACTION" == models ]]; then
    sc_remote_models_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == bench ]]; then
    sc_remote_bench_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == report ]]; then
    sc_remote_report_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == continuity ]]; then
    sc_remote_continuity_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == router ]]; then
    sc_remote_router_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == quota ]]; then
    sc_remote_quota_dispatch
    return
  fi
  if [[ "$SC_REMOTE_CATALOG_ACTION" == keys ]]; then
    sc_remote_keys_dispatch
    return
  fi
  local -a args=(catalog --catalog "$catalog" "$SC_REMOTE_CATALOG_ACTION")
  case "$SC_REMOTE_CATALOG_ACTION" in
    status) ;;
    configure)
      args+=(--name "$SC_REMOTE_CATALOG_NAME" --base-url "$SC_REMOTE_CATALOG_BASE_URL"
        --env-key "$SC_REMOTE_CATALOG_ENV_KEY" --timestamp "$(sc_now)")
      (( ! SC_REMOTE_CATALOG_SET_DEFAULT )) || args+=(--set-default)
      ;;
    default|remove)
      args+=(--name "$SC_REMOTE_CATALOG_NAME" --timestamp "$(sc_now)")
      ;;
    *) sc_die "internal remote catalog action error" 70 ;;
  esac
  result="$(sc_emit_remote_config | python3 -P - "${args[@]}")" || rc=$?
  (( rc == 0 )) || sc_die "remote provider catalog operation was refused" "$rc"
  sc_remote_catalog_render_result "$result"
}

sc_remote_task_append_common_options() {
  # shellcheck disable=SC2178
  local -n option_ref=$1
  (( SC_BARE )) && option_ref+=(--BARE-METAL)
  (( SC_BARE && ! SC_BARE_SUDO_TICKET )) && option_ref+=(--no-sudo-ticket)
  (( ! SC_RESOURCE_SCOPE )) && option_ref+=(--no-resource-scope)
  (( SC_DEV_NET )) && option_ref+=(--dev-network) || option_ref+=(--restricted-network)
  local domain
  for domain in "${SC_DOMAINS[@]}"; do option_ref+=(--allow-domain "$domain"); done
  if (( SC_BROWSER )); then option_ref+=(--browser); else option_ref+=(--no-browser); fi
  if (( SC_DESKTOP )); then
    option_ref+=(--desktop --desktop-backend "$SC_DESKTOP_BACKEND")
    (( SC_HEADFUL )) && option_ref+=(--headful)
  else
    option_ref+=(--no-desktop)
  fi
  (( SC_TRUST_PROJECT )) && option_ref+=(--trust-project-config)
  (( SC_EFFORT_SET )) && option_ref+=(--effort "$SC_EFFORT")
  (( SC_CAMPAIGN_MAX_COUNT > 0 )) || option_ref+=(--no-companion-campaigns)
  # This helper is called as a simple command under `set -e`.  Optional flags
  # being absent is successful composition, not a false return status from the
  # final arithmetic test.
  return 0
}

