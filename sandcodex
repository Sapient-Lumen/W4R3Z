+static bool sandcodex_tablet_pad_idle_at_mode(uint32_t mode_index) {
+    if (!sandcodex_tablet_pad_mode_index_valid(mode_index) ||
+            !sandcodex_stylus.initialized || !sandcodex_stylus.tablet_v2 ||
+            !sandcodex_stylus.pad_v2 ||
