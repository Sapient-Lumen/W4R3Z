+static bool sandcodex_capture_hit_target_with_coords(struct sway_seat *seat,
+		double x, double y, struct sandcodex_hit_target *target,
+		struct sway_view **view_out, struct wlr_surface **view_surface_out,
+		struct wlr_surface **target_surface_out, double *sx_out, double *sy_out) {
+	memset(target, 0, sizeof(*target));
+	if (view_out) {
+		*view_out = NULL;
+	}
+	if (view_surface_out) {
+		*view_surface_out = NULL;
+	}
+	if (target_surface_out) {
+		*target_surface_out = NULL;
+	}
+	if (sx_out) {
+		*sx_out = 0;
+	}
+	if (sy_out) {
+		*sy_out = 0;
+	}
+	struct wlr_surface *surface = NULL;
+	double sx = 0, sy = 0;
+	struct sway_node *node = seat ? node_at_coords(seat,
+		x, y, &surface, &sx, &sy) : NULL;
+	struct sway_container *container = node && node->type == N_CONTAINER
+		? node->sway_container : NULL;
+	struct sway_view *view = container ? container->view : NULL;
+	bool owner_valid = view && view->pid > 0 && view->surface &&
+		view->surface->resource && node->id > 0 &&
+		node->id <= (size_t)INT64_MAX;
+	bool surface_hit = owner_valid && surface && surface->resource &&
+		sx == sx && sy == sy &&
+		sx >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sx <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sy >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		sy <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT;
+	bool decoration_hit = owner_valid && !surface;
+	struct wl_client *surface_client = surface_hit
+		? wl_resource_get_client(surface->resource) : NULL;
+	surface_hit = surface_hit && surface_client;
+	target->hit = surface_hit || decoration_hit;
+	if (!target->hit) {
+		return true;
+	}
+
+	target->surface_hit = surface_hit;
+	target->surface_toplevel = surface_hit && surface == view->surface;
+	target->container_id = (int64_t)node->id;
+	target->view_pid = (int64_t)view->pid;
+	target->view_surface_address = (uintptr_t)view->surface;
+	target->target_surface_address = surface_hit ? (uintptr_t)surface : 0;
+	if (surface_hit) {
+		pid_t client_pid = 0;
+		uid_t client_uid = 0;
+		gid_t client_gid = 0;
+		wl_client_get_credentials(surface_client, &client_pid, &client_uid,
+			&client_gid);
+		uint32_t resource_id = wl_resource_get_id(surface->resource);
+		if (client_pid <= 0 || resource_id == 0) {
+			memset(target, 0, sizeof(*target));
+			return true;
+		}
+		target->surface_resource_id = (int64_t)resource_id;
+		target->surface_client_pid = (int64_t)client_pid;
+		target->surface_client_uid = (int64_t)client_uid;
+		target->surface_client_gid = (int64_t)client_gid;
+	}
+	if (view_out) {
+		*view_out = view;
+	}
+	if (view_surface_out) {
+		*view_surface_out = view->surface;
+	}
+	if (target_surface_out) {
+		*target_surface_out = surface_hit ? surface : NULL;
+	}
+	if (surface_hit && sx_out) {
+		*sx_out = sx;
+	}
+	if (surface_hit && sy_out) {
+		*sy_out = sy;
+	}
+	return true;
+}
+
+static bool sandcodex_capture_hit_target(struct sway_seat *seat,
+		double x, double y, struct sandcodex_hit_target *target,
+		struct sway_view **view_out, struct wlr_surface **view_surface_out,
+		struct wlr_surface **target_surface_out) {
+	return sandcodex_capture_hit_target_with_coords(seat, x, y, target,
+		view_out, view_surface_out, target_surface_out, NULL, NULL);
+}
