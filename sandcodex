    def guarded_drag_abort_release(self, button: int) -> dict[str, Any]:
        """Release one exact held grab without requiring a current hit target."""
        if not self.hit_test_authorized:
            raise ToolError(
                "patched-Sway compositor drag abort-release connection is unauthorized"
            )
        if type(button) is not int or not 1 <= button <= 3:
            raise ToolError("compositor drag abort-release Linux button is invalid")
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"button": button, "op": "arm-drag-abort-release"}),
                    "SANDCODEX_HIT_TEST arm-drag-abort-release",
                )
                ticket = self._normalize_drag_abort_release_arm_reply(
                    arm_reply, button
                )
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-drag-abort-release-ticket-v1\0"
                    + canonical_json({"button": button})
                    + b"\0"
                    + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": POINTER_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-drag-abort-release",
                    "dispatch_kind": "drag-abort-release",
                    "button": button,
                    "target_independent": True,
                    "deescalation_only": True,
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": "device",
                    "constraint_scope": COMPOSITOR_DRAG_ABORT_RELEASE_CONSTRAINT_SCOPE,
                    "frame_scope": COMPOSITOR_DRAG_BUTTON_FRAME_SCOPE,
                    "grab_scope": COMPOSITOR_DRAG_ABORT_RELEASE_GRAB_SCOPE,
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key,
                    canonical_json(grant_projection),
                    hashlib.sha256,
                ).hexdigest()
                grant = CompositorDragAbortReleaseGrant(
                    button=button,
                    ticket=ticket,
                    grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_drag_abort_release_arms += 1
                self.last_compositor_drag_abort_release_grant_sha256 = grant_sha256
            except Exception as error:
                self.compositor_drag_abort_release_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor drag abort-release could not be armed: {error}"
                ) from error

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        "button": button,
                        "op": "dispatch-drag-abort-release",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-drag-abort-release",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_drag_abort_release_reply(
                    dispatch_reply, grant
                )
                self.compositor_drag_abort_release_dispatches += 1
                self.last_compositor_drag_abort_release_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_drag_abort_release_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor drag abort-release failed closed: {error}"
                ) from error

