+		grant->keyboard_resource_address;
+	uint32_t expected_keyboard_resource_id = grant->keyboard_resource_id;
+	uint32_t expected_keycode = grant->keycode;
+	uint32_t expected_modifiers = grant->modifiers;
+	char expected_device_identifier[SANDCODEX_DEVICE_IDENTIFIER_LIMIT + 1] = {0};
+	if (grant->armed) {
+		memcpy(expected_device_identifier, grant->device_identifier,
+			sizeof(expected_device_identifier));
+	}
+	bool lifetime_bound = grant->device_destroy_linked &&
+		grant->view_surface_destroy_linked &&
+		grant->keyboard_resource_destroy_linked &&
+		(grant->target.target_surface_address ==
+			grant->target.view_surface_address || grant->target_surface_destroy_linked);
+	bool ticket_matches = canonical && grant->armed && lifetime_bound &&
+		grant->kind == SANDCODEX_DISPATCH_KEYBOARD_UNIT &&
+		expected_keycode == keycode && expected_modifiers == modifiers &&
+		expected_focused_surface_address != 0 &&
+		expected_keyboard_grab_address != 0 &&
+		expected_keyboard_grab_address == expected_keyboard_default_grab_address &&
+		expected_keyboard_focused_client_address != 0 &&
+		expected_keyboard_resource_address != 0 &&
+		expected_keyboard_resource_id != 0 &&
+		sandcodex_constant_time_equal(ticket, grant->value,
+			SANDCODEX_DISPATCH_TICKET_LENGTH);
+	/* Consume before observing mutable focus or emitting input. No client can run
+	 * between this erasure, the exact focus proof, and the complete key unit. */
+	sandcodex_clear_dispatch_ticket(client);
+	if (!ticket_matches) {
+		sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+		sandcodex_secure_clear(expected_device_identifier,
+			sizeof(expected_device_identifier));
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-ticket-invalid-or-consumed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sway_seat_device *device = sandcodex_single_virtual_keyboard(seat);
+	struct sandcodex_hit_target current = {0};
+	struct wlr_surface *focused_surface = NULL;
+	bool same_device = device && device->input_device &&
+		(uintptr_t)device == expected_sway_device_address &&
+		(uintptr_t)device->input_device->wlr_device == expected_wlr_device_address &&
+		strcmp(device->input_device->identifier,
+			expected_device_identifier) == 0;
+	bool same_target = same_device && sandcodex_keyboard_released(seat, device) &&
+		sandcodex_keyboard_default_route(seat,
+			expected_keyboard_grab_address,
+			expected_keyboard_default_grab_address,
+			expected_keyboard_focused_client_address) &&
+		sandcodex_keyboard_recipient_exact(
+			seat->wlr_seat->keyboard_state.focused_client,
+			expected_keyboard_resource_address,
+			expected_keyboard_resource_id, NULL, NULL) &&
+		sandcodex_keyboard_plan_valid(device, expected_keycode,
+			expected_modifiers) &&
+		sandcodex_capture_keyboard_target(seat, &current, NULL, NULL,
+			&focused_surface) &&
+		sandcodex_hit_target_equal(&current, &expected_target) &&
+		(uintptr_t)focused_surface == expected_focused_surface_address;
+	if (!same_target) {
+		sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+		sandcodex_secure_clear(&current, sizeof(current));
+		sandcodex_secure_clear(expected_device_identifier,
+			sizeof(expected_device_identifier));
+		sandcodex_send_hit_test_failure(client, "dispatch-recipient-changed");
+		return;
+	}
+
+	bool dispatched = sandcodex_dispatch_keyboard_unit(seat, device,
+		focused_surface, expected_keyboard_grab_address,
+		expected_keyboard_default_grab_address,
+		expected_keyboard_focused_client_address,
+		expected_keyboard_resource_address, expected_keyboard_resource_id,
+		expected_keycode, expected_modifiers);
+	sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+	sandcodex_secure_clear(&current, sizeof(current));
+	sandcodex_secure_clear(expected_device_identifier,
+		sizeof(expected_device_identifier));
+	if (!dispatched) {
+		sandcodex_send_hit_test_failure(client, "dispatch-failed");
+		return;
+	}
+
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(true));
+	json_object_object_add(reply, "operation",
+		json_object_new_string("dispatch-keyboard-unit"));
+	json_object_object_add(reply, "dispatched", json_object_new_boolean(true));
+	json_object_object_add(reply, "ticket_consumed", json_object_new_boolean(true));
+	json_object_object_add(reply, "recipient_unchanged",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "lifetime_revocation_armed",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "device_scope",
+		json_object_new_string("single-destroy-watched-virtual-keyboard"));
+	json_object_object_add(reply, "focus_scope",
+		json_object_new_string("exact-destroy-watched-focused-client-surface"));
+	json_object_object_add(reply, "route_scope",
+		json_object_new_string(SANDCODEX_KEYBOARD_ROUTE_SCOPE));
+	json_object_object_add(reply, "event_loop_scope",
+		json_object_new_string("one-sway-ipc-callback"));
+	json_object_object_add(reply, "keycode", json_object_new_int64(keycode));
+	json_object_object_add(reply, "modifiers", json_object_new_int64(modifiers));
+	json_object_object_add(reply, "key_events", json_object_new_int(2));
+	json_object_object_add(reply, "modifier_events", json_object_new_int(2));
+	json_object_object_add(reply, "released", json_object_new_boolean(true));
+	json_object_object_add(reply, "input_method_grab_absent",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "keyboard_grab_unchanged",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "keyboard_grab_default",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "focused_client_unchanged",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "keyboard_recipient_resources",
+		json_object_new_int(1));
+	json_object_object_add(reply, "keyboard_recipient_resource_unchanged",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "keyboard_recipient_resource_destroy_watched",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "modifier_mask_allowlisted",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "compositor_bindings_bypassed",
+		json_object_new_boolean(true));
+	const char *json_string = json_object_to_json_string_ext(reply,
+		JSON_C_TO_STRING_PLAIN);
+	ipc_send_reply(client, IPC_SANDCODEX_HIT_TEST, json_string,
+		(uint32_t)strlen(json_string));
+	json_object_put(reply);
+}
