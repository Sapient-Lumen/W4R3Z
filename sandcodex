sc_desktop_boundary_preflight() {
  (( SC_DESKTOP )) || return 0
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && \
    "${SANDCODEX_TEST_REAL_DESKTOP:-0}" != 1 ]]; then
    sc_log_event info desktop_boundary_preflight "desktop boundary skipped by deterministic test harness"
