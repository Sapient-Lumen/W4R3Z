+static bool sandcodex_pointer_swipe_recipient_exact(struct sway_seat *seat,
+        struct wlr_seat_client *focused_client,
+        uintptr_t expected_resource_address, uint32_t expected_resource_id,
+        uintptr_t *resource_address_out, uint32_t *resource_id_out) {
+    if (resource_address_out) {
+        *resource_address_out = 0;
+    }
+    if (resource_id_out) {
+        *resource_id_out = 0;
+    }
+    if (!seat || !seat->wlr_seat || !focused_client ||
+            focused_client->seat != seat->wlr_seat || !focused_client->client ||
+            !server.input || !server.input->pointer_gestures ||
+            (expected_resource_address == 0) != (expected_resource_id == 0)) {
+        return false;
+    }
+    struct wl_resource *resource = NULL;
+    struct wl_resource *recipient = NULL;
+    uint32_t recipient_id = 0;
+    size_t live_count = 0;
+    wl_resource_for_each(resource, &server.input->pointer_gestures->swipes) {
+        struct wlr_seat *resource_seat = wl_resource_get_user_data(resource);
+        if (resource_seat != seat->wlr_seat ||
+                wl_resource_get_client(resource) != focused_client->client) {
+            continue;
+        }
+        uint32_t id = wl_resource_get_id(resource);
+        if (id == 0 || ++live_count != 1) {
+            return false;
+        }
+        recipient = resource;
+        recipient_id = id;
+    }
+    if (live_count != 1 || !recipient ||
+            (expected_resource_address != 0 &&
+                (uintptr_t)recipient != expected_resource_address) ||
+            (expected_resource_id != 0 && recipient_id != expected_resource_id)) {
+        return false;
+    }
+    if (resource_address_out) {
+        *resource_address_out = (uintptr_t)recipient;
+    }
+    if (resource_id_out) {
+        *resource_id_out = recipient_id;
+    }
+    return true;
+}
