+		json_object_new_int((int)(2 * (steps + 1))));
+	json_object_object_add(reply, "duration_milliseconds",
+		json_object_new_int((int)duration_msec));
+	json_object_object_add(reply, "contact_count", json_object_new_int(2));
+	json_object_object_add(reply, "same_surface_paths",
