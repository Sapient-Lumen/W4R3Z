    def guarded_touchpad_pinch(
        self,
        x: int,
        y: int,
        delta_x: int,
        delta_y: int,
        scale_256: int,
        rotation_degrees: int,
        fingers: int,
        steps: int,
        duration_milliseconds: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        """Arm, validate, and atomically dispatch one native pointer pinch."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor touchpad-pinch connection is unauthorized")
        for value, label in ((x, "x"), (y, "y")):
            if type(value) is not int or not (
                -SWAY_HIT_TEST_MAX_COORDINATE <= value <= SWAY_HIT_TEST_MAX_COORDINATE
            ):
                raise ToolError(f"compositor touchpad-pinch {label} coordinate is invalid")
        for value, label in ((delta_x, "delta_x"), (delta_y, "delta_y")):
            if type(value) is not int or not -TOUCHPAD_PINCH_MAX_DELTA <= value <= TOUCHPAD_PINCH_MAX_DELTA:
                raise ToolError(f"compositor touchpad-pinch {label} is invalid")
        if type(scale_256) is not int or not (
            TOUCHPAD_PINCH_MIN_SCALE_256
            <= scale_256
            <= TOUCHPAD_PINCH_MAX_SCALE_256
        ):
            raise ToolError("compositor touchpad-pinch scale is unsupported")
        if type(rotation_degrees) is not int or not (
            -TOUCHPAD_PINCH_MAX_ROTATION_DEGREES
            <= rotation_degrees
            <= TOUCHPAD_PINCH_MAX_ROTATION_DEGREES
        ):
            raise ToolError("compositor touchpad-pinch rotation is unsupported")
        scale_delta_raw = scale_256 - TOUCHPAD_PINCH_SCALE_UNITY_256
        maximum_raw_magnitude = max(
            abs(delta_x) * 256,
            abs(delta_y) * 256,
            abs(scale_delta_raw),
            abs(rotation_degrees) * 256,
        )
        if maximum_raw_magnitude == 0:
            raise ToolError("compositor touchpad pinch requires pan, scale, or rotation")
        if type(fingers) is not int or not TOUCHPAD_PINCH_MIN_FINGERS <= fingers <= TOUCHPAD_PINCH_MAX_FINGERS:
            raise ToolError("compositor touchpad-pinch finger count is unsupported")
        if type(steps) is not int or not 1 <= steps <= TOUCHPAD_PINCH_MAX_STEPS:
            raise ToolError("compositor touchpad-pinch steps are outside the supported range")
        if steps > maximum_raw_magnitude:
            raise ToolError("compositor touchpad-pinch steps would create a neutral update")
        if type(duration_milliseconds) is not int or not (
            steps + 1 <= duration_milliseconds <= TOUCHPAD_PINCH_MAX_DURATION_MILLISECONDS
        ):
            raise ToolError(
                "compositor touchpad-pinch duration must permit strictly increasing "
                "event timestamps and remain within the supported range"
            )
        if not callable(validator):
            raise ToolError("compositor touchpad-pinch target validator is unavailable")

        action = {
            "delta_x": delta_x,
            "delta_y": delta_y,
            "duration_milliseconds": duration_milliseconds,
            "fingers": fingers,
            "rotation_degrees": rotation_degrees,
            "scale_256": scale_256,
            "steps": steps,
            "x": x,
            "y": y,
        }
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-touchpad-pinch", **action}),
                    "SANDCODEX_HIT_TEST arm-touchpad-pinch",
                )
                target, ticket = self._normalize_touchpad_pinch_arm_reply(
                    arm_reply, x, y, delta_x, delta_y, scale_256,
                    rotation_degrees, fingers, steps, duration_milliseconds,
                )
                ticket_action = {"dispatch_kind": "touchpad-pinch", **action}
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-touchpad-pinch-ticket-v1\0"
                    + canonical_json(ticket_action) + b"\0" + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": TOUCHPAD_PINCH_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-recipient-touchpad-pinch",
                    "dispatch_kind": "touchpad-pinch",
                    **action,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": (
                        "view-surface+focused-hit-surface+pointer-gesture-pinch-resource"
                    ),
                    "dispatch_path": COMPOSITOR_TOUCHPAD_PINCH_DISPATCH_PATH,
                    "dispatch_atomicity": GUARDED_TOUCHPAD_PINCH_DISPATCH_ATOMICITY,
                    "route_scope": COMPOSITOR_TOUCHPAD_PINCH_ROUTE_SCOPE,
                    "time_scope": COMPOSITOR_TOUCHPAD_PINCH_TIME_SCOPE,
                    "fixed_point_scope": COMPOSITOR_TOUCHPAD_PINCH_FIXED_POINT_SCOPE,
                    "compositor_binding_policy": "bypass",
                    "wall_clock_pacing": False,
                    "pointer_motion_fallback_policy": "deny",
                    "scroll_fallback_policy": "deny",
                    "touch_fallback_policy": "deny",
                    "browser_fallback_policy": "deny",
                    "host_desktop_policy": "absent",
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorTouchpadPinchGrant(
                    x=x, y=y, delta_x=delta_x, delta_y=delta_y,
                    scale_256=scale_256,
                    rotation_degrees=rotation_degrees,
                    fingers=fingers, steps=steps,
                    duration_milliseconds=duration_milliseconds,
                    ticket=ticket, target=target, grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_touchpad_pinch_arms += 1
                self.last_compositor_touchpad_pinch_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_touchpad_pinch_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touchpad pinch could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-touchpad-pinch",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-touchpad-pinch",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_touchpad_pinch_reply(cancel_reply)
                    self.compositor_touchpad_pinch_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_touchpad_pinch_dispatch_failures += 1
                    self._set_failure(cancel_error)
                    raise ToolError(
                        "compositor touchpad-pinch validation failed and its private "
                        "ticket could not be cancelled; the compositor seal is quarantined"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        **action,
                        "op": "dispatch-touchpad-pinch",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-touchpad-pinch",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_touchpad_pinch_reply(
                    dispatch_reply, grant
                )
                self.compositor_touchpad_pinch_dispatches += 1
                self.last_compositor_touchpad_pinch_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_touchpad_pinch_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touchpad pinch failed closed: {error}"
