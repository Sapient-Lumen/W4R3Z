                # operation map, upload its fully sealed memfd, cross the one-way
                # preparation lock, then prove the compositor connection remains
                # responsive.  A bare PING would leave the most security-critical
                # authority transition untested until the first real keystroke.
                keyboard_transaction.prepare_characters("A")
                keyboard_transaction.ping()
            self.keyboard_transport_initialization = keyboard_transaction.evidence()
            self.journal.append(
                "keyboard-transport",
                "desktop-keyboard-initialize",
                {
                    "input_emitted": False,
                    "probe": "sealed-operation-map-without-dispatch",
                    "probe_keysyms": 2,
                },
                self.keyboard_transport_initialization,
            )
