+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		!client->sandcodex_modifier_arc.active &&
+		json_object_object_length(request) == 11 &&
+		sandcodex_request_operation(request, "arm-touch-gesture");
+	for (size_t index = 0; valid_shape && index < 10; ++index) {
+		valid_shape = json_object_object_get_ex(request, names[index],
+			&values[index]) && json_object_is_type(values[index], json_type_int);
+	}
+	int64_t duration_raw = valid_shape ? json_object_get_int64(values[0]) : 0;
+	int64_t first_end_x = valid_shape ? json_object_get_int64(values[1]) : 0;
+	int64_t first_end_y = valid_shape ? json_object_get_int64(values[2]) : 0;
+	int64_t first_start_x = valid_shape ? json_object_get_int64(values[3]) : 0;
+	int64_t first_start_y = valid_shape ? json_object_get_int64(values[4]) : 0;
+	int64_t second_end_x = valid_shape ? json_object_get_int64(values[5]) : 0;
+	int64_t second_end_y = valid_shape ? json_object_get_int64(values[6]) : 0;
+	int64_t second_start_x = valid_shape ? json_object_get_int64(values[7]) : 0;
+	int64_t second_start_y = valid_shape ? json_object_get_int64(values[8]) : 0;
+	int64_t steps_raw = valid_shape ? json_object_get_int64(values[9]) : 0;
+	uint32_t steps = steps_raw > 0 &&
+		steps_raw <= SANDCODEX_TOUCH_GESTURE_MAX_STEPS
+		? (uint32_t)steps_raw : 0;
+	uint32_t duration_msec = duration_raw > 0 &&
+		duration_raw <= SANDCODEX_TOUCH_GESTURE_MAX_DURATION_MSEC
+		? (uint32_t)duration_raw : 0;
+	bool canonical = valid_shape && sandcodex_touch_gesture_shape_valid(
+		first_start_x, first_start_y, first_end_x, first_end_y,
+		second_start_x, second_start_y, second_end_x, second_end_y,
+		steps, duration_msec) &&
+		sandcodex_touch_gesture_arm_payload_canonical(payload, payload_length,
+			duration_msec, first_end_x, first_end_y, first_start_x,
+			first_start_y, second_end_x, second_end_y, second_start_x,
+			second_start_y, steps);
+	if (!canonical) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sandcodex_hit_target first_target = {0};
+	struct sway_view *first_view = NULL;
+	struct wlr_surface *first_view_surface = NULL;
+	struct wlr_surface *first_surface = NULL;
+	struct wlr_seat_client *first_client = NULL;
+	uintptr_t touch_resource_address = 0;
+	uint32_t touch_resource_id = 0;
+	uint64_t first_sx_bits[SANDCODEX_TOUCH_GESTURE_MAX_POINTS] = {0};
+	uint64_t first_sy_bits[SANDCODEX_TOUCH_GESTURE_MAX_POINTS] = {0};
+	uint64_t second_sx_bits[SANDCODEX_TOUCH_GESTURE_MAX_POINTS] = {0};
+	uint64_t second_sy_bits[SANDCODEX_TOUCH_GESTURE_MAX_POINTS] = {0};
+	bool paths_valid = true;
+	for (uint32_t index = 0; index <= steps; ++index) {
+		int64_t first_x = sandcodex_touch_stroke_coordinate(first_start_x,
+			first_end_x, index, steps);
+		int64_t first_y = sandcodex_touch_stroke_coordinate(first_start_y,
+			first_end_y, index, steps);
+		int64_t second_x = sandcodex_touch_stroke_coordinate(second_start_x,
+			second_end_x, index, steps);
+		int64_t second_y = sandcodex_touch_stroke_coordinate(second_start_y,
+			second_end_y, index, steps);
+		if (first_x == second_x && first_y == second_y) {
+			paths_valid = false;
+			break;
+		}
+		for (uint32_t contact = 0; paths_valid && contact < 2; ++contact) {
+			int64_t x = contact == 0 ? first_x : second_x;
+			int64_t y = contact == 0 ? first_y : second_y;
+			struct sandcodex_hit_target target = {0};
+			struct sway_view *view = NULL;
+			struct wlr_surface *view_surface = NULL;
+			struct wlr_surface *surface = NULL;
+			struct wlr_seat_client *seat_client = NULL;
+			double sx = 0, sy = 0;
+			if (!sandcodex_capture_touch_target(seat, (double)x, (double)y,
+					&target, &view, &view_surface, &surface, &seat_client,
+					&sx, &sy)) {
+				paths_valid = false;
+				sandcodex_secure_clear(&target, sizeof(target));
+				break;
+			}
+			if (index == 0 && contact == 0) {
+				first_target = target;
+				first_view = view;
+				first_view_surface = view_surface;
+				first_surface = surface;
+				first_client = seat_client;
+				paths_valid = sandcodex_touch_recipient_exact(first_client,
+					0, 0, &touch_resource_address, &touch_resource_id);
+			} else {
+				paths_valid = sandcodex_hit_target_equal(&target, &first_target) &&
+					view == first_view && view_surface == first_view_surface &&
+					surface == first_surface && seat_client == first_client &&
+					sandcodex_touch_recipient_exact(first_client,
+						touch_resource_address, touch_resource_id, NULL, NULL);
+			}
+			if (contact == 0) {
+				first_sx_bits[index] = sandcodex_double_bits(sx);
+				first_sy_bits[index] = sandcodex_double_bits(sy);
+			} else {
+				second_sx_bits[index] = sandcodex_double_bits(sx);
+				second_sy_bits[index] = sandcodex_double_bits(sy);
+			}
+			sandcodex_secure_clear(&target, sizeof(target));
+		}
+		if (!paths_valid) {
+			break;
+		}
+	}
+	if (!paths_valid || !first_surface || !first_client ||
+			touch_resource_address == 0 || touch_resource_id == 0) {
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(first_sx_bits, sizeof(first_sx_bits));
+		sandcodex_secure_clear(first_sy_bits, sizeof(first_sy_bits));
+		sandcodex_secure_clear(second_sx_bits, sizeof(second_sx_bits));
+		sandcodex_secure_clear(second_sy_bits, sizeof(second_sy_bits));
+		sandcodex_send_hit_test_failure(client,
+			"touch-gesture-path-or-recipient-invalid");
+		return;
+	}
+
+	struct sandcodex_dispatch_ticket *grant = &client->sandcodex_dispatch_ticket;
+	char ticket[SANDCODEX_DISPATCH_TICKET_LENGTH + 1] = {0};
+	if (!sandcodex_random_ticket(ticket)) {
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(first_sx_bits, sizeof(first_sx_bits));
+		sandcodex_secure_clear(first_sy_bits, sizeof(first_sy_bits));
+		sandcodex_secure_clear(second_sx_bits, sizeof(second_sx_bits));
+		sandcodex_secure_clear(second_sy_bits, sizeof(second_sy_bits));
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-ticket-generation-failed");
+		return;
+	}
+	grant->armed = true;
+	grant->kind = SANDCODEX_DISPATCH_TOUCH_GESTURE;
+	memcpy(grant->value, ticket, sizeof(grant->value));
+	grant->from_x = first_start_x;
+	grant->from_y = first_start_y;
+	grant->x = first_end_x;
+	grant->y = first_end_y;
+	grant->touch_gesture_second_start_x = second_start_x;
+	grant->touch_gesture_second_start_y = second_start_y;
+	grant->touch_gesture_second_end_x = second_end_x;
+	grant->touch_gesture_second_end_y = second_end_y;
+	grant->target = first_target;
+	grant->touch_stroke_steps = steps;
+	grant->touch_stroke_duration_msec = duration_msec;
+	memcpy(grant->touch_gesture_first_sx_bits, first_sx_bits,
+		(steps + 1) * sizeof(first_sx_bits[0]));
+	memcpy(grant->touch_gesture_first_sy_bits, first_sy_bits,
+		(steps + 1) * sizeof(first_sy_bits[0]));
+	memcpy(grant->touch_gesture_second_sx_bits, second_sx_bits,
+		(steps + 1) * sizeof(second_sx_bits[0]));
+	memcpy(grant->touch_gesture_second_sy_bits, second_sy_bits,
+		(steps + 1) * sizeof(second_sy_bits[0]));
+	grant->touch_grab_address = (uintptr_t)seat->wlr_seat->touch_state.grab;
+	grant->touch_default_grab_address =
+		(uintptr_t)seat->wlr_seat->touch_state.default_grab;
+	grant->touch_seat_client_address = (uintptr_t)first_client;
+	grant->touch_resource_address = touch_resource_address;
+	grant->touch_resource_id = touch_resource_id;
+	if (!sandcodex_bind_surface_ticket(client, first_view_surface, first_surface) ||
+			!sandcodex_bind_touch_resource_ticket(client,
+				(struct wl_resource *)touch_resource_address)) {
+		sandcodex_secure_clear(ticket, sizeof(ticket));
+		sandcodex_secure_clear(&first_target, sizeof(first_target));
+		sandcodex_secure_clear(first_sx_bits, sizeof(first_sx_bits));
+		sandcodex_secure_clear(first_sy_bits, sizeof(first_sy_bits));
+		sandcodex_secure_clear(second_sx_bits, sizeof(second_sx_bits));
+		sandcodex_secure_clear(second_sy_bits, sizeof(second_sy_bits));
+		sandcodex_clear_dispatch_ticket(client);
+		sandcodex_send_hit_test_failure(client, "dispatch-lifetime-bind-failed");
+		return;
+	}
+	sandcodex_send_touch_gesture_target(client, &first_target, first_view,
+		ticket, first_start_x, first_start_y, first_end_x, first_end_y,
+		second_start_x, second_start_y, second_end_x, second_end_y,
+		steps, duration_msec);
+	sandcodex_secure_clear(ticket, sizeof(ticket));
+	sandcodex_secure_clear(&first_target, sizeof(first_target));
+	sandcodex_secure_clear(first_sx_bits, sizeof(first_sx_bits));
+	sandcodex_secure_clear(first_sy_bits, sizeof(first_sy_bits));
+	sandcodex_secure_clear(second_sx_bits, sizeof(second_sx_bits));
+	sandcodex_secure_clear(second_sy_bits, sizeof(second_sy_bits));
+}
