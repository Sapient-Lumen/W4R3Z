      jq -e '.ok == true' <<<"$response" >/dev/null || {
        jq -r '.error // "operator service control failed"' <<<"$response" >&2; return 1;
      }
      if (( SC_OPERATOR_JSON )); then
        printf '%s\n' "$response"
      else
        jq -r '"operator service \(.status.state) · generation \(.status.service_generation)"' <<<"$response"
      fi
      ;;
