def storage_error(error):
    return isinstance(error, OSError) and error.errno in {errno.ENOSPC, errno.EDQUOT}


def canonical(path):
    return os.path.realpath(os.path.abspath(path))


def pid_start(pid):
    try:
        line = Path(f"/proc/{pid}/stat").read_text()
        rest = line.rsplit(") ", 1)[1].split()
        if rest[0] in {"Z", "X", "x"}:
            return None
        return rest[19]
    except (OSError, IndexError, ValueError):
        return None


def pid_matches(pid, started):
    return isinstance(pid, int) and pid > 0 and isinstance(started, str) and started.isdigit() and pid_start(pid) == started


def checked_file(path, label, maximum, executable=False):
    path = os.path.abspath(path)
    if canonical(path) != path:
        fail(f"{label} contains a symlink component")
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"{label} is unavailable: {error}")
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        fail(f"{label} metadata is invalid")
    expected = 0o500 if executable else 0o600
    if stat.S_IMODE(info.st_mode) != expected or info.st_size > maximum:
        fail(f"{label} permissions or size are invalid")
    return path


def checked_sealed_file(path, label, maximum):
    """Validate a broker-owned immutable input without relaxing checked_file."""
    path = os.path.abspath(path)
    if canonical(path) != path:
        fail(f"{label} contains a symlink component")
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"{label} is unavailable: {error}")
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o400
            or info.st_size > maximum):
        fail(f"{label} metadata is invalid")
    return path


def checked_dir(path, label, create=False):
    path = os.path.abspath(path)
    if canonical(path) != path:
        fail(f"{label} contains a symlink component")
    if create and not os.path.exists(path):
        parent = checked_dir(os.path.dirname(path), f"{label} parent")
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"{label} is unavailable: {error}")
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        fail(f"{label} metadata is invalid")
    return path


def load_json(path, label, maximum=MAX_ACK, executable=False):
    path = checked_file(path, label, maximum, executable=executable)
    try:
        with open(path, "r", encoding="utf-8") as stream:
            value = json.load(stream)
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"{label} is invalid JSON: {error}")
    if not isinstance(value, dict):
        fail(f"{label} must be a JSON object")
    return value


def json_bytes(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n").encode()


def atomic_bytes(path, payload, mode=0o600, replace=True):
    parent = checked_dir(os.path.dirname(path), "atomic-write parent")
    fd, temporary = tempfile.mkstemp(prefix=".campaign.", dir=parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb", closefd=True) as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            os.replace(temporary, path)
        else:
            try:
                os.link(temporary, path, follow_symlinks=False)
            except FileExistsError:
                fail(f"destination already exists: {path}")
            os.unlink(temporary)
        directory_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def atomic_json(path, value, replace=True):
    atomic_bytes(path, json_bytes(value), replace=replace)


def digest_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def append_locked_record(path, payload, label, maximum=64 * 1024 * 1024):
    flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
           info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600:
            fail(f"{label} metadata is invalid")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        info = os.fstat(descriptor)
        if info.st_size + len(payload) > maximum:
            fail(f"{label} exceeds its bounded size")
        remaining = memoryview(payload)
        while remaining:
            written = os.write(descriptor, remaining)
            if written <= 0:
                fail(f"{label} write made no progress")
            remaining = remaining[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


