        runtime.cooldowns = AllAvailable()  # type: ignore[assignment]
        runtime.keys = [
            ("000000000001", "one", "secret-one"),
            ("000000000002", "two", "secret-two"),
            ("000000000003", "three", "secret-three"),
            ("000000000004", "four", "secret-four"),
            ("000000000005", "five", "secret-five"),
