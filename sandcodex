+		json_object_is_type(end_x_object, json_type_int) &&
+		json_object_is_type(end_y_object, json_type_int) &&
+		json_object_is_type(start_x_object, json_type_int) &&
+		json_object_is_type(start_y_object, json_type_int) &&
+		json_object_is_type(steps_object, json_type_int) &&
+		json_object_is_type(ticket_object, json_type_string);
+	int64_t duration_raw = valid_shape ? json_object_get_int64(duration_object) : 0;
+	int64_t end_x = valid_shape ? json_object_get_int64(end_x_object) : 0;
+	int64_t end_y = valid_shape ? json_object_get_int64(end_y_object) : 0;
+	int64_t start_x = valid_shape ? json_object_get_int64(start_x_object) : 0;
+	int64_t start_y = valid_shape ? json_object_get_int64(start_y_object) : 0;
+	int64_t steps_raw = valid_shape ? json_object_get_int64(steps_object) : 0;
+	const char *ticket = valid_shape ? json_object_get_string(ticket_object) : NULL;
+	uint32_t steps = steps_raw > 0 && steps_raw <= SANDCODEX_TOUCH_STROKE_MAX_STEPS
+		? (uint32_t)steps_raw : 0;
+	uint32_t duration_msec = duration_raw > 0 &&
+		duration_raw <= SANDCODEX_TOUCH_STROKE_MAX_DURATION_MSEC
+		? (uint32_t)duration_raw : 0;
+	bool canonical = valid_shape && steps != 0 && duration_msec >= steps + 1 &&
+		start_x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		start_y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_x >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+		end_y >= -SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
