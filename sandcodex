sc_parse_gemini() {
  SC_HELP_TOPIC=gemini
  SC_COMMAND=gemini
  SC_GEMINI_ACTION="${1:-status}"
  case "$SC_GEMINI_ACTION" in
    status|models|probe|qualify|path|cooldowns|report|continuity|quota)
      [[ $# == 0 ]] || shift
      ;;
    router)
      shift
      if (( $# )) && [[ "$1" != -* ]]; then
        [[ "$1" == status ]] || sc_usage_error "gemini router accepts only status"
        shift
      fi
      ;;
    keys)
      shift
      SC_GEMINI_KEYS_ACTION="${1:-status}"
      case "$SC_GEMINI_KEYS_ACTION" in
        path|status|add|remove|test)
          [[ $# == 0 ]] || shift
          ;;
        -h|--help|help)
          sc_help_topic gemini; exit 0
          ;;
        *)
          sc_usage_error "gemini keys action must be path, status, add, remove, or test"
          ;;
      esac
      ;;
    -h|--help|help)
      sc_help_topic gemini; exit 0
      ;;
    *)
      sc_usage_error "unknown gemini action: $SC_GEMINI_ACTION"
      ;;
  esac
  SC_GEMINI_JSON=0
  SC_GEMINI_KEY_PATH=""
  SC_GEMINI_KEYBANK_PATH=""
  SC_GEMINI_KEY_LABEL=""
  SC_GEMINI_KEY_ID=""
  SC_GEMINI_KEY_INPUT_FILE=""
  SC_GEMINI_KEY_STDIN=0
  SC_GEMINI_MODEL="$SC_GEMINI_DEFAULT_MODEL"
  SC_GEMINI_MODEL_EXPLICIT=0
  SC_GEMINI_LIMIT=80
  SC_GEMINI_FREE_ONLY=1
  SC_GEMINI_IGNORE_COOLDOWNS=0
  SC_GEMINI_ROUTE_WAIT_SECONDS="$SC_GEMINI_ROUTE_WAIT_SECONDS_DEFAULT"
  SC_GEMINI_ROUTE_WAIT_EXPLICIT=0
  while (( $# )); do
    case "$1" in
      --json) SC_GEMINI_JSON=1; SC_QUIET=1; shift ;;
      --key-file|--key-path)
        (( $# > 1 )) || sc_usage_error "$1 requires FILE"
        SC_GEMINI_KEY_PATH="$2"; shift 2 ;;
      --key-file=*|--key-path=*) SC_GEMINI_KEY_PATH="${1#*=}"; shift ;;
      --key-bank|--keybank)
        (( $# > 1 )) || sc_usage_error "$1 requires FILE"
        SC_GEMINI_KEYBANK_PATH="$2"; shift 2 ;;
      --key-bank=*|--keybank=*) SC_GEMINI_KEYBANK_PATH="${1#*=}"; shift ;;
      --key-label|--key)
        (( $# > 1 )) || sc_usage_error "$1 requires LABEL"
        SC_GEMINI_KEY_LABEL="$2"; shift 2 ;;
      --key-label=*|--key=*) SC_GEMINI_KEY_LABEL="${1#*=}"; shift ;;
      --key-id)
        (( $# > 1 )) || sc_usage_error "--key-id requires ID"
        SC_GEMINI_KEY_ID="$2"; shift 2 ;;
      --key-id=*) SC_GEMINI_KEY_ID="${1#*=}"; shift ;;
      --from-file)
        (( $# > 1 )) || sc_usage_error "--from-file requires FILE"
        SC_GEMINI_KEY_INPUT_FILE="$2"; shift 2 ;;
      --from-file=*) SC_GEMINI_KEY_INPUT_FILE="${1#*=}"; shift ;;
      --stdin) SC_GEMINI_KEY_STDIN=1; shift ;;
      -y|--yes) SC_YES=1; shift ;;
      --model)
        (( $# > 1 )) || sc_usage_error "--model requires MODEL"
        SC_GEMINI_MODEL="$2"; SC_GEMINI_MODEL_EXPLICIT=1; shift 2 ;;
      --model=*) SC_GEMINI_MODEL="${1#*=}"; SC_GEMINI_MODEL_EXPLICIT=1; shift ;;
      --limit)
        (( $# > 1 )) || sc_usage_error "--limit requires N"
        SC_GEMINI_LIMIT="$2"; shift 2 ;;
      --limit=*) SC_GEMINI_LIMIT="${1#*=}"; shift ;;
      --free-only) SC_GEMINI_FREE_ONLY=1; shift ;;
      --allow-paid) sc_usage_error "Sandcodex Gemini routes are deliberately free-tier-model-only" ;;
      --ignore-cooldowns) SC_GEMINI_IGNORE_COOLDOWNS=1; shift ;;
      --route-wait-seconds)
        (( $# > 1 )) || sc_usage_error "--route-wait-seconds requires N"
        SC_GEMINI_ROUTE_WAIT_SECONDS="$2"; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift 2 ;;
      --route-wait-seconds=*) SC_GEMINI_ROUTE_WAIT_SECONDS="${1#*=}"; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift ;;
      --no-route-wait) SC_GEMINI_ROUTE_WAIT_SECONDS=0; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift ;;
      --force) SC_GEMINI_FORCE=1; shift ;;
      -h|--help|help) sc_help_topic gemini; exit 0 ;;
      --) shift; (( $# == 0 )) || sc_usage_error "gemini accepts no trailing positional arguments" ;;
      *) sc_usage_error "unknown gemini option: $1" ;;
    esac
  done
  [[ "$SC_GEMINI_LIMIT" =~ ^[0-9]+$ ]] || sc_usage_error "--limit requires a non-negative integer"
  [[ "$SC_GEMINI_ROUTE_WAIT_SECONDS" =~ ^[0-9]+$ && ${#SC_GEMINI_ROUTE_WAIT_SECONDS} -le 4 && \
    "$SC_GEMINI_ROUTE_WAIT_SECONDS" -le "$SC_GEMINI_ROUTE_WAIT_SECONDS_MAX" ]] ||
    sc_usage_error "--route-wait-seconds must be an integer from 0 through $SC_GEMINI_ROUTE_WAIT_SECONDS_MAX"
  [[ "$SC_GEMINI_MODEL" =~ ^(models/)?[A-Za-z0-9._:-]+$ ]] || sc_usage_error "Gemini model contains unsupported characters"
  [[ -z "$SC_GEMINI_KEY_LABEL" || "$SC_GEMINI_KEY_LABEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$ ]] ||
    sc_usage_error "Gemini key label must be 1-48 letters, digits, dots, underscores, or hyphens"
  [[ -z "$SC_GEMINI_KEY_ID" || "$SC_GEMINI_KEY_ID" =~ ^[0-9a-f]{12}$ ]] ||
    sc_usage_error "Gemini key ID must be the exact 12-character lowercase hexadecimal ID printed by keys status"
  case "$SC_GEMINI_KEYS_ACTION" in
    add)
      [[ -z "$SC_GEMINI_KEY_ID" ]] || sc_usage_error "gemini keys add does not accept --key-id"
      (( ! SC_GEMINI_KEY_STDIN || ${#SC_GEMINI_KEY_INPUT_FILE} == 0 )) ||
        sc_usage_error "gemini keys add accepts only one of --stdin or --from-file"
      [[ -z "$SC_GEMINI_KEY_PATH" ]] ||
        sc_usage_error "gemini keys add writes --key-bank; --key-file is not an import option (use --from-file)"
      (( ! SC_YES )) || sc_usage_error "--yes is valid only for gemini keys remove"
      ;;
    remove)
      (( (${#SC_GEMINI_KEY_LABEL} > 0) != (${#SC_GEMINI_KEY_ID} > 0) )) ||
        sc_usage_error "gemini keys remove requires exactly one of --key-label LABEL or --key-id ID"
      [[ -z "$SC_GEMINI_KEY_INPUT_FILE" && "$SC_GEMINI_KEY_STDIN" == 0 ]] ||
        sc_usage_error "gemini keys remove does not accept key input"
      [[ -z "$SC_GEMINI_KEY_PATH" ]] || sc_usage_error "gemini keys remove mutates --key-bank, not --key-file"
      ;;
    path|status)
      [[ -z "$SC_GEMINI_KEY_LABEL" && -z "$SC_GEMINI_KEY_ID" &&
        -z "$SC_GEMINI_KEY_INPUT_FILE" && "$SC_GEMINI_KEY_STDIN" == 0 ]] ||
        sc_usage_error "Gemini key mutation options require 'gemini keys add' or 'gemini keys remove'"
      (( ! SC_YES )) || sc_usage_error "--yes is valid only for gemini keys remove"
      ;;
    test)
      [[ -z "$SC_GEMINI_KEY_ID" && -z "$SC_GEMINI_KEY_INPUT_FILE" && "$SC_GEMINI_KEY_STDIN" == 0 ]] ||
        sc_usage_error "gemini keys test accepts only --key-label, --model, --key-bank, and --json"
      (( ! SC_YES )) || sc_usage_error "--yes is valid only for gemini keys remove"
      ;;
    *)
      [[ -z "$SC_GEMINI_KEY_ID" && -z "$SC_GEMINI_KEY_INPUT_FILE" && "$SC_GEMINI_KEY_STDIN" == 0 ]] ||
        sc_usage_error "Gemini key mutation options require 'gemini keys add' or 'gemini keys remove'"
      (( ! SC_YES )) || sc_usage_error "--yes is valid only for gemini keys remove"
      ;;
  esac
}

sc_parse_gemini_provider() {
  SC_HELP_TOPIC=gemini
  SC_PROVIDER_MODE=gemini
  SC_PROVIDER_MODE_EXPLICIT=1
  SC_GEMINI_AUTO=1
  SC_GEMINI_MODEL="$SC_GEMINI_DEFAULT_MODEL"
  SC_GEMINI_MODEL_EXPLICIT=0
  SC_MODEL="$SC_GEMINI_AUTO_MODEL"
  SC_MODEL_SET=1
  SC_CAMPAIGN_MAX_COUNT="$SC_CAMPAIGN_DEFAULT_MAX_COUNT"

  case "${1:-}" in
    auto) shift ;;
    ''|loop) ;;
    -*) ;;
    *)
      SC_GEMINI_MODEL="$(sc_gemini_model_slug "$1")"
      SC_GEMINI_MODEL_EXPLICIT=1
      SC_GEMINI_AUTO=0
      SC_MODEL="$SC_GEMINI_MODEL"
      shift
      ;;
  esac

  local -a normal=()
  while (( $# )); do
    case "$1" in
      --key-file|--key-path)
        (( $# > 1 )) || sc_usage_error "$1 requires FILE"
        SC_GEMINI_KEY_PATH=$2; shift 2 ;;
      --key-file=*|--key-path=*) SC_GEMINI_KEY_PATH=${1#*=}; shift ;;
      --key-bank|--keybank)
        (( $# > 1 )) || sc_usage_error "$1 requires FILE"
        SC_GEMINI_KEYBANK_PATH=$2; shift 2 ;;
      --key-bank=*|--keybank=*) SC_GEMINI_KEYBANK_PATH=${1#*=}; shift ;;
      --key-label|--key)
        (( $# > 1 )) || sc_usage_error "$1 requires LABEL"
        SC_GEMINI_KEY_LABEL=$2; shift 2 ;;
      --key-label=*|--key=*) SC_GEMINI_KEY_LABEL=${1#*=}; shift ;;
      --free-only) SC_GEMINI_FREE_ONLY=1; shift ;;
      --allow-paid) sc_usage_error "Sandcodex Gemini routes are deliberately free-tier-model-only" ;;
      --ignore-cooldowns) SC_GEMINI_IGNORE_COOLDOWNS=1; shift ;;
      --route-wait-seconds)
        (( $# > 1 )) || sc_usage_error "--route-wait-seconds requires N"
        SC_GEMINI_ROUTE_WAIT_SECONDS=$2; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift 2 ;;
      --route-wait-seconds=*) SC_GEMINI_ROUTE_WAIT_SECONDS=${1#*=}; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift ;;
      --no-route-wait) SC_GEMINI_ROUTE_WAIT_SECONDS=0; SC_GEMINI_ROUTE_WAIT_EXPLICIT=1; shift ;;
      --force) SC_GEMINI_FORCE=1; shift ;;
      --model|--model=*|-m|-m=*)
        sc_usage_error "Gemini route is already selected; put an explicit Gemini MODEL immediately after 'gemini'" ;;
      --) normal+=("$@"); break ;;
      *) normal+=("$1"); shift ;;
    esac
  done
  [[ -z "$SC_GEMINI_KEY_LABEL" || "$SC_GEMINI_KEY_LABEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$ ]] ||
    sc_usage_error "Gemini key label must be 1-48 letters, digits, dots, underscores, or hyphens"
  [[ "$SC_GEMINI_ROUTE_WAIT_SECONDS" =~ ^[0-9]+$ && ${#SC_GEMINI_ROUTE_WAIT_SECONDS} -le 4 && \
    "$SC_GEMINI_ROUTE_WAIT_SECONDS" -le "$SC_GEMINI_ROUTE_WAIT_SECONDS_MAX" ]] ||
    sc_usage_error "--route-wait-seconds must be an integer from 0 through $SC_GEMINI_ROUTE_WAIT_SECONDS_MAX"
  if (( ! SC_GEMINI_AUTO )); then
    sc_gemini_require_free_model "$SC_GEMINI_MODEL"
  fi
  if [[ "${normal[0]:-}" == loop ]]; then
    SC_COMMAND=loop
    sc_parse_loop "${normal[@]:1}"
  elif [[ "${normal[0]:-}" == task && "$SC_GEMINI_AUTO" == 1 ]]; then
    sc_parse_gemini_auto_task "${normal[@]:1}"
  else
    sc_parse_run "${normal[@]}"
  fi
}

sc_benchmark_help() {
  cat <<'EOF'
Sandcodex execution-grounded agent benchmark

  sandcodex benchmark list [--json]
  sandcodex benchmark prepare CASE --output DIR [--json]
  sandcodex benchmark grade CASE --project DIR [--json]
  sandcodex benchmark run COURSE --route ROUTE [OPTIONS]
  sandcodex benchmark report [RUN_ID] [--json]
  sandcodex benchmark compare RUN_ID RUN_ID [...] [--json]

COURSE is ladder, core, operator, maintainer, patcher, smoke, rung-N, or one CASE.

Routes:
  gpt                 authenticated first-party Codex; optional --model
  gemini-auto         complete Gemini free-route policy
  gemini              exact allowlisted Gemini --model
  openrouter-auto     current free OpenRouter selection policy
  openrouter          exact OpenRouter --model (trusted key bank or exported credential)
  local               exact local --model; optional --local-backend auto|cuda|cpu

Run options:
  --turns N           fixed Codex turn budget per task (default: 1; maximum: 4)
  --key-bank FILE     trusted OpenRouter account bank (exact or auto route)
  --json              emit the final content-minimized receipt as JSON

`patcher`, `maintainer`, and `operator` progressively exercise rungs 1-2, 1-3,
and 1-5. `core` preserves the original three-task regression course and
`ladder` is the `operator` course; `rung-1` through `rung-5` isolate one level.
Provider, boundary, quota, or continuity failures are unscored infrastructure
failures rather than false zero-quality answers. Candidate projects use a
private sibling workspace, while content-minimized receipts stay under trusted
per-user Sandcodex state.
`compare` accepts only otherwise-identical exact OpenRouter runs and reports
quality and operational capability floors separately.
EOF
}

sc_parse_benchmark() {
  SC_HELP_TOPIC=benchmark
  SC_COMMAND=benchmark
  SC_BENCHMARK_ACTION="${1:-list}"
  case "$SC_BENCHMARK_ACTION" in
    list|prepare|grade|run|report|compare) (( $# == 0 )) || shift ;;
    -h|--help|help) sc_benchmark_help; exit 0 ;;
    *) sc_usage_error "benchmark action must be list, prepare, grade, run, report, or compare" ;;
  esac
  local -a positional=()
  while (( $# )); do
    case "$1" in
      --output)
        (( $# > 1 )) || sc_usage_error "--output requires DIR"
        SC_BENCHMARK_OUTPUT=$2; shift 2 ;;
      --output=*) SC_BENCHMARK_OUTPUT=${1#*=}; shift ;;
      --project)
        (( $# > 1 )) || sc_usage_error "--project requires DIR"
        SC_BENCHMARK_PROJECT=$2; shift 2 ;;
      --project=*) SC_BENCHMARK_PROJECT=${1#*=}; shift ;;
      --route)
        (( $# > 1 )) || sc_usage_error "--route requires NAME"
        SC_BENCHMARK_ROUTE=$2; shift 2 ;;
      --route=*) SC_BENCHMARK_ROUTE=${1#*=}; shift ;;
      --model)
        (( $# > 1 )) || sc_usage_error "--model requires MODEL"
        SC_BENCHMARK_MODEL=$2; shift 2 ;;
      --model=*) SC_BENCHMARK_MODEL=${1#*=}; shift ;;
      --key-bank)
        (( $# > 1 )) || sc_usage_error "--key-bank requires FILE"
        SC_REMOTE_KEYBANK_PATH=$2; shift 2 ;;
      --key-bank=*) SC_REMOTE_KEYBANK_PATH=${1#*=}; shift ;;
      --local-backend|--backend)
        (( $# > 1 )) || sc_usage_error "$1 requires auto, cuda, or cpu"
        SC_BENCHMARK_LOCAL_BACKEND=$2; shift 2 ;;
      --local-backend=*|--backend=*) SC_BENCHMARK_LOCAL_BACKEND=${1#*=}; shift ;;
      --turns)
        (( $# > 1 )) || sc_usage_error "--turns requires N"
        SC_BENCHMARK_TURNS=$2; shift 2 ;;
      --turns=*) SC_BENCHMARK_TURNS=${1#*=}; shift ;;
      --json) SC_BENCHMARK_JSON=1; SC_QUIET=1; shift ;;
      -h|--help|help) sc_benchmark_help; exit 0 ;;
      --) shift; positional+=("$@"); break ;;
      -*) sc_usage_error "unknown benchmark option: $1" ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  case "$SC_BENCHMARK_ACTION" in
    list)
      (( ${#positional[@]} == 0 )) || sc_usage_error "benchmark list accepts no positional arguments"
      [[ -z "$SC_BENCHMARK_OUTPUT$SC_BENCHMARK_PROJECT$SC_BENCHMARK_ROUTE$SC_BENCHMARK_MODEL" ]] ||
        sc_usage_error "benchmark list accepts only --json"
      ;;
    prepare)
      (( ${#positional[@]} == 1 )) || sc_usage_error "benchmark prepare requires CASE"
      SC_BENCHMARK_TARGET=${positional[0]}
      [[ -n "$SC_BENCHMARK_OUTPUT" ]] || sc_usage_error "benchmark prepare requires --output DIR"
      [[ -z "$SC_BENCHMARK_PROJECT$SC_BENCHMARK_ROUTE$SC_BENCHMARK_MODEL" ]] ||
        sc_usage_error "benchmark prepare accepts CASE, --output, and --json only"
      ;;
    grade)
      (( ${#positional[@]} == 1 )) || sc_usage_error "benchmark grade requires CASE"
      SC_BENCHMARK_TARGET=${positional[0]}
      [[ -n "$SC_BENCHMARK_PROJECT" ]] || sc_usage_error "benchmark grade requires --project DIR"
      [[ -z "$SC_BENCHMARK_OUTPUT$SC_BENCHMARK_ROUTE$SC_BENCHMARK_MODEL" ]] ||
        sc_usage_error "benchmark grade accepts CASE, --project, and --json only"
      ;;
    run)
      (( ${#positional[@]} <= 1 )) || sc_usage_error "benchmark run accepts at most one course or case"
      (( ${#positional[@]} == 0 )) || SC_BENCHMARK_TARGET=${positional[0]}
      [[ -n "$SC_BENCHMARK_ROUTE" ]] || sc_usage_error "benchmark run requires --route ROUTE"
      [[ -z "$SC_BENCHMARK_OUTPUT$SC_BENCHMARK_PROJECT" ]] ||
        sc_usage_error "benchmark run does not accept --output or --project"
      ;;
    report)
      (( ${#positional[@]} <= 1 )) || sc_usage_error "benchmark report accepts at most one RUN_ID"
      (( ${#positional[@]} == 0 )) || SC_BENCHMARK_RUN_ID=${positional[0]}
      [[ -z "$SC_BENCHMARK_OUTPUT$SC_BENCHMARK_PROJECT$SC_BENCHMARK_ROUTE$SC_BENCHMARK_MODEL" ]] ||
        sc_usage_error "benchmark report accepts only RUN_ID and --json"
      ;;
    compare)
      (( ${#positional[@]} >= 2 )) || sc_usage_error "benchmark compare requires at least two RUN_ID arguments"
      SC_BENCHMARK_RUN_IDS=("${positional[@]}")
      [[ -z "$SC_BENCHMARK_OUTPUT$SC_BENCHMARK_PROJECT$SC_BENCHMARK_ROUTE$SC_BENCHMARK_MODEL" ]] ||
        sc_usage_error "benchmark compare accepts only RUN_ID arguments and --json"
      ;;
  esac
  [[ "$SC_BENCHMARK_TARGET" =~ ^[a-z][a-z0-9-]{0,63}$ ]] || sc_usage_error "invalid benchmark course or case"
  [[ "$SC_BENCHMARK_TURNS" =~ ^[1-4]$ ]] || sc_usage_error "benchmark --turns must be an integer from 1 through 4"
  [[ "$SC_BENCHMARK_LOCAL_BACKEND" =~ ^(auto|cuda|cpu)$ ]] ||
    sc_usage_error "benchmark --local-backend requires auto, cuda, or cpu"
  [[ -z "$SC_BENCHMARK_RUN_ID" || "$SC_BENCHMARK_RUN_ID" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9a-f]{8}$ ]] ||
    sc_usage_error "invalid benchmark run ID"
  local benchmark_run_id
  for benchmark_run_id in "${SC_BENCHMARK_RUN_IDS[@]}"; do
    [[ "$benchmark_run_id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9a-f]{8}$ ]] ||
      sc_usage_error "invalid benchmark run ID"
  done
  if [[ "$SC_BENCHMARK_ACTION" != run ]]; then
    [[ "$SC_BENCHMARK_LOCAL_BACKEND" == auto && "$SC_BENCHMARK_TURNS" == 1 ]] ||
      sc_usage_error "--turns and --local-backend are valid only for benchmark runs"
  fi
  if [[ "$SC_BENCHMARK_ACTION" == run ]]; then
    case "$SC_BENCHMARK_ROUTE" in
      gpt) ;;
      gemini-auto|openrouter-auto)
        [[ -z "$SC_BENCHMARK_MODEL" ]] || sc_usage_error "$SC_BENCHMARK_ROUTE selects its model automatically"
        ;;
      gemini|openrouter|local)
        [[ -n "$SC_BENCHMARK_MODEL" ]] || sc_usage_error "--route $SC_BENCHMARK_ROUTE requires --model MODEL"
        ;;
      *) sc_usage_error "benchmark route must be gpt, gemini-auto, gemini, openrouter-auto, openrouter, or local" ;;
    esac
    if [[ -n "$SC_REMOTE_KEYBANK_PATH" && "$SC_BENCHMARK_ROUTE" != openrouter &&
      "$SC_BENCHMARK_ROUTE" != openrouter-auto ]]; then
      sc_usage_error "benchmark --key-bank is available only for OpenRouter routes"
    fi
  elif [[ -n "$SC_REMOTE_KEYBANK_PATH" ]]; then
    sc_usage_error "benchmark --key-bank is available only with benchmark run"
  fi
}

sc_parse() {
  local doctor_browser_requested=0 doctor_desktop_disabled=0
  (( $# )) || return 0
  case "$1" in
    help|-h|--help) shift; sc_help_topic "$@"; exit 0 ;;
    manual) SC_HELP_TOPIC=manual; shift; (( $# == 0 )) || sc_usage_error "manual accepts no options"; sc_manual; exit 0 ;;
    version|-V|--version)
      SC_HELP_TOPIC=version
      shift
      if (( $# == 0 )); then
        sc_version
      elif (( $# == 1 )) && [[ "$1" == --json ]]; then
        sc_version json
      elif (( $# == 1 )) && [[ "$1" == -h || "$1" == --help || "$1" == help ]]; then
        sc_help_topic version
      else
        sc_usage_error "version accepts only --json"
      fi
      exit 0
      ;;
    local|remote)
      local provider_mode=$1
      SC_HELP_TOPIC=$provider_mode
      shift
      sc_parse_provider_mode "$provider_mode" "$@"
      ;;
    gemini)
      SC_HELP_TOPIC=gemini
      shift
      case "${1:-}" in
        status|models|probe|qualify|path|cooldowns|keys|report|continuity|quota|router) sc_parse_gemini "$@" ;;
        -h|--help|help) sc_help_topic gemini; exit 0 ;;
        *) sc_parse_gemini_provider "$@" ;;
      esac
      ;;
    ready)
      SC_HELP_TOPIC=ready
      SC_COMMAND=ready; shift
      while (( $# )); do
        case "$1" in
          --json) SC_READY_JSON=1; SC_QUIET=1; shift ;;
          -h|--help|help) sc_help_topic ready; exit 0 ;;
          --) shift; (( $# == 0 )) || sc_usage_error "ready accepts no trailing arguments" ;;
          *) sc_usage_error "unknown ready option: $1" ;;
        esac
      done
      ;;
    run) SC_HELP_TOPIC=run; shift; sc_parse_run "$@" ;;
    loop) SC_COMMAND=loop; shift; sc_parse_loop "$@" ;;
    benchmark) shift; sc_parse_benchmark "$@" ;;
    campaign) SC_COMMAND=campaign; shift; sc_parse_campaign "$@" ;;
    team) SC_COMMAND=campaign; SC_TEAM_MODE=1; shift; sc_parse_campaign "$@" ;;
    operator) SC_COMMAND=operator; shift; sc_parse_operator "$@" ;;
    publish) SC_COMMAND=publish; shift; sc_parse_publish_inspect "$@" ;;
    login) SC_HELP_TOPIC=auth; SC_COMMAND=login; shift; SC_CODEX_ARGS=("$@") ;;
    logout) SC_HELP_TOPIC=auth; SC_COMMAND=logout; shift; SC_CODEX_ARGS=("$@") ;;
    reauth) SC_HELP_TOPIC=auth; SC_COMMAND=reauth; shift; SC_CODEX_ARGS=("$@") ;;
    auth) SC_HELP_TOPIC=auth; SC_COMMAND=auth; shift; SC_CODEX_ARGS=("$@") ;;
    install)
      SC_HELP_TOPIC=install
      SC_COMMAND=install; shift
      while (( $# )); do
        case "$1" in
          --bin-dir) (( $# > 1 )) || sc_usage_error "--bin-dir requires DIR"; SC_INSTALL_BIN_DIR="$2"; shift ;;
          --bin-dir=*) SC_INSTALL_BIN_DIR="${1#*=}" ;;
          -h|--help) sc_help_topic install; exit 0 ;;
          *) sc_usage_error "unknown install option: $1" ;;
        esac
        shift
      done
      ;;
    logs) SC_HELP_TOPIC=logs; SC_COMMAND=logs; shift; sc_parse_logs "$@" ;;
    state) SC_HELP_TOPIC=state; SC_COMMAND=state; shift; sc_parse_state "$@" ;;
    doctor)
      SC_HELP_TOPIC=doctor
      SC_COMMAND=doctor; shift
      while (( $# )); do
        case "$1" in
          --deep) SC_DOCTOR_DEEP=1 ;;
          --desktop-only) SC_DOCTOR_DEEP=1; SC_DOCTOR_DESKTOP_ONLY=1; SC_DESKTOP=1; SC_DESKTOP_EXPLICIT=1; SC_BROWSER=0; SC_BROWSER_EXPLICIT=1 ;;
          --json) SC_DOCTOR_JSON=1; SC_QUIET=1 ;;
          --dev-network) SC_DEV_NET=1; SC_NETWORK_EXPLICIT=1 ;;
          --restricted-network) SC_DEV_NET=0; SC_NETWORK_EXPLICIT=1 ;;
          --allow-domain) (( $# > 1 )) || sc_usage_error "--allow-domain requires HOST"; SC_DOMAINS+=("$2"); shift ;;
          --allow-domain=*) SC_DOMAINS+=("${1#*=}") ;;
          --jail-network) (( $# > 1 )) || sc_usage_error "--jail-network requires auto, none, outer, or host"; SC_JAIL_NETWORK_CEILING="${2,,}"; shift ;;
          --jail-network=*) SC_JAIL_NETWORK_CEILING="${1#*=}"; SC_JAIL_NETWORK_CEILING="${SC_JAIL_NETWORK_CEILING,,}" ;;
          --jail-max-timeout) (( $# > 1 )) || sc_usage_error "--jail-max-timeout requires seconds"; SC_JAIL_TIMEOUT_CEILING="$2"; shift ;;
          --jail-max-timeout=*) SC_JAIL_TIMEOUT_CEILING="${1#*=}" ;;
          --jail-max-cpu) (( $# > 1 )) || sc_usage_error "--jail-max-cpu requires percent"; SC_JAIL_CPU_CEILING="$2"; shift ;;
          --jail-max-cpu=*) SC_JAIL_CPU_CEILING="${1#*=}" ;;
          --jail-max-memory) (( $# > 1 )) || sc_usage_error "--jail-max-memory requires MiB"; SC_JAIL_MEMORY_CEILING="$2"; shift ;;
          --jail-max-memory=*) SC_JAIL_MEMORY_CEILING="${1#*=}" ;;
          --jail-max-swap) (( $# > 1 )) || sc_usage_error "--jail-max-swap requires MiB"; SC_JAIL_SWAP_CEILING="$2"; shift ;;
          --jail-max-swap=*) SC_JAIL_SWAP_CEILING="${1#*=}" ;;
          --jail-max-pids) (( $# > 1 )) || sc_usage_error "--jail-max-pids requires a count"; SC_JAIL_PIDS_CEILING="$2"; shift ;;
          --jail-max-pids=*) SC_JAIL_PIDS_CEILING="${1#*=}" ;;
          --jail-max-file) (( $# > 1 )) || sc_usage_error "--jail-max-file requires MiB"; SC_JAIL_FILE_CEILING_MIB="$2"; shift ;;
          --jail-max-file=*) SC_JAIL_FILE_CEILING_MIB="${1#*=}" ;;
          --jail-max-tmp) (( $# > 1 )) || sc_usage_error "--jail-max-tmp requires MiB"; SC_JAIL_TMP_CEILING_MIB="$2"; shift ;;
          --jail-max-tmp=*) SC_JAIL_TMP_CEILING_MIB="${1#*=}" ;;
          --jail-max-home) (( $# > 1 )) || sc_usage_error "--jail-max-home requires MiB"; SC_JAIL_HOME_CEILING_MIB="$2"; shift ;;
          --jail-max-home=*) SC_JAIL_HOME_CEILING_MIB="${1#*=}" ;;
          --jail-storage-budget) (( $# > 1 )) || sc_usage_error "--jail-storage-budget requires MiB"; SC_JAIL_STORAGE_BUDGET_MIB="$2"; shift ;;
          --jail-storage-budget=*) SC_JAIL_STORAGE_BUDGET_MIB="${1#*=}" ;;
          --jail-budget-group) (( $# > 1 )) || sc_usage_error "--jail-budget-group requires ID"; SC_JAIL_BUDGET_GROUP="$2"; shift ;;
          --jail-budget-group=*) SC_JAIL_BUDGET_GROUP="${1#*=}" ;;
          --nix-daemon) SC_NIX_DAEMON_MODE=allow ;;
          --no-nix-daemon) SC_NIX_DAEMON_MODE=deny ;;
          --no-resource-scope) SC_RESOURCE_SCOPE=0 ;;
          --browser) SC_BROWSER=1; SC_BROWSER_EXPLICIT=1; doctor_browser_requested=1 ;;
          --no-browser) SC_BROWSER=0; SC_BROWSER_EXPLICIT=1 ;;
          --desktop) SC_DESKTOP=1; SC_DESKTOP_EXPLICIT=1 ;;
          --desktop-backend) (( $# > 1 )) || sc_usage_error "--desktop-backend requires wayland or x11"; SC_DESKTOP_BACKEND="${2,,}"; SC_DESKTOP_BACKEND_EXPLICIT=1; shift ;;
          --desktop-backend=*) SC_DESKTOP_BACKEND="${1#*=}"; SC_DESKTOP_BACKEND="${SC_DESKTOP_BACKEND,,}"; SC_DESKTOP_BACKEND_EXPLICIT=1 ;;
          --headful) SC_HEADFUL=1; SC_DESKTOP=1; SC_DESKTOP_EXPLICIT=1 ;;
          --no-desktop) SC_DESKTOP=0; SC_DESKTOP_EXPLICIT=1; SC_DESKTOP_DISABLED_EXPLICIT=1; doctor_desktop_disabled=1 ;;
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -m|--model) (( $# > 1 )) || sc_usage_error "$1 requires MODEL"; SC_MODEL="$2"; SC_MODEL_SET=1; shift ;;
          -m=*|--model=*) SC_MODEL="${1#*=}"; SC_MODEL_SET=1 ;;
          -v|--verbose) (( SC_VERBOSE += 1 )) ;;
          -h|--help) sc_help_topic doctor; exit 0 ;;
          *) sc_usage_error "unknown doctor option: $1" ;;
        esac
        shift
      done
      if (( SC_DOCTOR_DESKTOP_ONLY && ( doctor_browser_requested || doctor_desktop_disabled ) )); then
        sc_usage_error "--desktop-only cannot be combined with --browser or --no-desktop"
      fi
      ;;
    clean)
      SC_HELP_TOPIC=clean
      SC_COMMAND=clean; shift
      while (( $# )); do
        case "$1" in
          --sessions) SC_CLEAN_SESSIONS=1 ;;
          --downloads) SC_CLEAN_DOWNLOADS=1 ;;
          --browser) SC_CLEAN_BROWSER=1 ;;
          --desktop) SC_CLEAN_DESKTOP=1 ;;
          --logs) SC_CLEAN_LOGS=1 ;;
          --everything)
            SC_CLEAN_EVERYTHING=1
            SC_CLEAN_SESSIONS=1
            SC_CLEAN_DOWNLOADS=1
            SC_CLEAN_BROWSER=1
            SC_CLEAN_DESKTOP=1
            SC_CLEAN_LOGS=1
            ;;
          --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift ;;
          --project=*) SC_PROJECT_ARG="${1#*=}" ;;
          -y|--yes) SC_YES=1 ;;
          -h|--help) sc_help_topic clean; exit 0 ;;
          *) sc_usage_error "unknown clean option: $1" ;;
        esac
        shift
      done
      ;;
    *) sc_parse_run "$@" ;;
  esac
  case "$SC_COMMAND" in
    login|logout|reauth|auth|clean|install|logs|state|benchmark|campaign|operator|publish|local-runtime|local-retire|gemini) SC_BROWSER=0; SC_DESKTOP=0 ;;
    loop) [[ "$SC_LOOP_ACTION" == run ]] || { SC_BROWSER=0; SC_DESKTOP=0; } ;;
  esac
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "$SC_DESKTOP_EXPLICIT" == 0 && \
    "${SANDCODEX_TEST_DESKTOP_DEFAULT:-0}" != 1 ]]; then
    SC_DESKTOP=0
  fi
}

sc_validate_domain() {
  local raw="$1" domain label
  [[ ${#raw} -le 253 && "$raw" != *://* && "$raw" != */* && "$raw" != *:* ]] || sc_die "invalid host pattern: $raw"
  domain="${raw#\*\*\.}"; domain="${domain#\*\.}"
  [[ "$domain" == *.* && "$domain" != .* && "$domain" != *. ]] || sc_die "domain must be a public DNS name: $raw"
  [[ ! "$domain" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || sc_die "IP literals are not domain rules: $raw"
  local -a labels=()
  IFS=. read -r -a labels <<<"$domain"
  for label in "${labels[@]}"; do
    [[ ${#label} -ge 1 && ${#label} -le 63 && "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || sc_die "invalid host pattern: $raw"
  done
}

sc_validate_requested_domains() {
  local domain
  for domain in "${SC_DOMAINS[@]}"; do
    sc_validate_domain "$domain"
  done
}

sc_validate_jail_ceiling() {
  local value=$1 option=$2 minimum=$3 maximum=$4
  [[ $value == null ]] && return 0
  [[ $value =~ ^(0|[1-9][0-9]*)$ && ${#value} -le 9 ]] ||
    sc_usage_error "$option must be a canonical non-negative integer"
  (( value >= minimum && value <= maximum )) ||
    sc_usage_error "$option must be an integer from $minimum through $maximum"
}

sc_validate_jail_resource_ceilings() {
  sc_validate_jail_ceiling "$SC_JAIL_TIMEOUT_CEILING" --jail-max-timeout 1 "$SC_JAIL_MAX_TIMEOUT"
  sc_validate_jail_ceiling "$SC_JAIL_CPU_CEILING" --jail-max-cpu 1 "$SC_JAIL_MAX_CPU_PERCENT"
  sc_validate_jail_ceiling "$SC_JAIL_MEMORY_CEILING" --jail-max-memory 32 "$SC_JAIL_MAX_MEMORY_MIB"
  sc_validate_jail_ceiling "$SC_JAIL_SWAP_CEILING" --jail-max-swap 0 "$SC_JAIL_MAX_SWAP_MIB"
  sc_validate_jail_ceiling "$SC_JAIL_PIDS_CEILING" --jail-max-pids 8 "$SC_JAIL_MAX_PIDS"
  sc_validate_jail_ceiling "$SC_JAIL_FILE_CEILING_MIB" --jail-max-file 1 "$SC_JAIL_MAX_STORAGE_MIB"
  sc_validate_jail_ceiling "$SC_JAIL_TMP_CEILING_MIB" --jail-max-tmp 1 "$SC_JAIL_MAX_STORAGE_MIB"
  sc_validate_jail_ceiling "$SC_JAIL_HOME_CEILING_MIB" --jail-max-home 1 "$SC_JAIL_MAX_STORAGE_MIB"
  sc_validate_jail_ceiling "$SC_JAIL_STORAGE_BUDGET_MIB" --jail-storage-budget 64 "$SC_JAIL_MAX_STORAGE_MIB"
  [[ "$SC_JAIL_BUDGET_GROUP" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
    sc_usage_error "--jail-budget-group must be a 1-64 character identifier"
  [[ "$SC_JAIL_STORAGE_BUDGET_MIB" != null || "$SC_JAIL_BUDGET_GROUP" == default ]] ||
    sc_usage_error "--jail-budget-group requires --jail-storage-budget"
}

sc_publish_valid_ipv4() {
  local address="$1" first second third fourth extra octet
  IFS=. read -r first second third fourth extra <<<"$address"
  [[ -z "$extra" && -n "$first" && -n "$second" && -n "$third" && -n "$fourth" ]] || return 1
  for octet in "$first" "$second" "$third" "$fourth"; do
    [[ "$octet" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    (( 10#$octet <= 255 )) || return 1
  done
}

sc_validate_publish() {
  local spec bind host_port target_port remainder existing
  local -a normalized=()
  SC_PUBLISH_BINDS=(); SC_PUBLISH_HOST_PORTS=(); SC_PUBLISH_TARGET_PORTS=()
  (( ${#SC_PUBLISH_SPECS[@]} <= SC_PUBLISH_MAX_LISTENERS )) ||
    sc_usage_error "--publish may be repeated at most $SC_PUBLISH_MAX_LISTENERS times"
  (( ${#SC_PUBLISH_SPECS[@]} == 0 || ! SC_BARE )) ||
    sc_usage_error "--publish is a safe-mode bridge; BARE-METAL services can bind host addresses directly"
  for spec in "${SC_PUBLISH_SPECS[@]}"; do
    sc_no_line_breaks "$spec" "publish specification"
    bind=127.0.0.1
    if [[ "$spec" != *:* ]]; then
      host_port="$spec"; target_port="$spec"
    else
      host_port="${spec%%:*}"; remainder="${spec#*:}"
      if [[ "$remainder" == *:* ]]; then
        bind="$host_port"; host_port="${remainder%%:*}"; target_port="${remainder#*:}"
        [[ "$target_port" != *:* ]] ||
          sc_usage_error "invalid --publish '$spec': IPv6 is not supported; use PORT, HOST_PORT:TARGET_PORT, or IPv4:HOST_PORT:TARGET_PORT"
      else
        target_port="$remainder"
      fi
    fi
    sc_publish_valid_ipv4 "$bind" ||
      sc_usage_error "invalid --publish '$spec': bind address must be a canonical IPv4 literal"
    if [[ ! "$host_port" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#$host_port > 65535 )); then
      sc_usage_error "invalid --publish '$spec': host port must be 1 through 65535"
    fi
    if [[ ! "$target_port" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#$target_port > 65535 )); then
      sc_usage_error "invalid --publish '$spec': agent target port must be 1 through 65535"
    fi
    for existing in "${SC_PUBLISH_HOST_PORTS[@]}"; do
      [[ "$existing" != "$host_port" ]] ||
        sc_usage_error "invalid --publish '$spec': host port $host_port is declared more than once"
    done
    SC_PUBLISH_BINDS+=("$bind")
    SC_PUBLISH_HOST_PORTS+=("$host_port")
    SC_PUBLISH_TARGET_PORTS+=("$target_port")
    normalized+=("$bind:$host_port:$target_port")
  done
  SC_PUBLISH_SPECS=("${normalized[@]}")
}

sc_validate_local_memory_mib() {
  [[ -z "$SC_LOCAL_MEMORY_MIB" ]] && return 0
  [[ "$SC_LOCAL_MEMORY_MIB" =~ ^[1-9][0-9]*$ && ${#SC_LOCAL_MEMORY_MIB} -le 6 ]] ||
    sc_usage_error "--local-memory-mib requires a canonical positive integer"
  (( 10#$SC_LOCAL_MEMORY_MIB >= 2048 && 10#$SC_LOCAL_MEMORY_MIB <= 262144 )) ||
    sc_usage_error "--local-memory-mib must be 2048 through 262144"
}

sc_set_local_ollama_bin_cli() {
  local value=$1
  [[ -n "$value" && ${#value} -le 4096 ]] || sc_usage_error "--local-ollama-bin requires PATH"
  sc_no_line_breaks "$value" "local Ollama binary path"
  SC_LOCAL_OLLAMA_BIN_CLI=$value
  export SANDCODEX_LOCAL_OLLAMA_BIN="$value"
  SC_LOCAL_RUNTIME_USER_OVERRIDE=1
}

sc_validate_selection() {
  sc_local_provider_resolve
  sc_validate_publish
  (( SC_BARE || SC_BARE_SUDO_TICKET )) ||
    sc_usage_error "--no-sudo-ticket requires --BARE-METAL"
  [[ "$SC_PROVIDER_MODE" != local ]] || (( ! SC_BARE )) ||
    sc_usage_error "managed local inference is available only in the normal Sandcodex boundary"
  if (( SC_HEADFUL )); then
    (( ! SC_DESKTOP_DISABLED_EXPLICIT )) || sc_usage_error "--headful cannot be combined with --no-desktop"
    (( ! SC_BARE )) || sc_usage_error "--headful is available only in safe mode"
    (( ! SC_DESKTOP_BACKEND_EXPLICIT )) || [[ "$SC_DESKTOP_BACKEND" == x11 ]] || \
      sc_usage_error "--headful conflicts with --desktop-backend wayland"
    SC_DESKTOP_BACKEND=x11
  fi
  if (( SC_MODEL_SET )); then
    sc_no_line_breaks "$SC_MODEL" "model"
    if sc_local_provider_enabled || [[ "$SC_PROVIDER_MODE" == remote || "$SC_PROVIDER_MODE" == gemini ]]; then
      # Local and third-party remote registries commonly use namespaces, tags,
      # quantization suffixes, and repository-like identifiers. The provider
      # validator already owns the wider grammar; do not reject a valid
      # provider identifier here with the narrower OpenAI model grammar.
      [[ ${#SC_MODEL} -le 192 && "$SC_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:+/@-]*$ ]] || \
        sc_usage_error "$SC_PROVIDER_MODE model must be a 1-192 character provider model identifier"
    else
      [[ ${#SC_MODEL} -le 160 && "$SC_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]] || \
        sc_usage_error "model must be a model identifier without whitespace"
    fi
  fi
  if (( SC_EFFORT_SET )); then
    case "$SC_EFFORT" in
      minimal|low|medium|high|xhigh|max|ultra) ;;
      *) sc_usage_error "effort must be minimal, low, medium, high, xhigh, max, or ultra" ;;
    esac
  fi
  [[ "$SC_AGENT_MAX_DEPTH" =~ ^[1-5]$ ]] || sc_usage_error "--agent-depth must be an integer from 1 through 5"
  [[ "$SC_AGENT_MAX_THREADS" =~ ^([1-9]|1[0-2])$ ]] || sc_usage_error "--agent-threads must be an integer from 1 through 12"
  case "$SC_DESKTOP_BACKEND" in wayland|x11) ;; *) sc_usage_error "--desktop-backend must be wayland or x11" ;; esac
  [[ "$SC_PROVIDER_MODE" != local ]] || sc_validate_local_memory_mib
  [[ "$SC_CAMPAIGN_MAX_COUNT" =~ ^(0|[1-9][0-9]*)$ && ${#SC_CAMPAIGN_MAX_COUNT} -le 2 && \
    "$SC_CAMPAIGN_MAX_COUNT" -le "$SC_CAMPAIGN_MAX_COUNT_LIMIT" ]] || \
    sc_usage_error "--companion-campaigns must be an integer from 0 through $SC_CAMPAIGN_MAX_COUNT_LIMIT"
  [[ "$SC_CAMPAIGN_MAX_TURNS" =~ ^(0|[1-9][0-9]*)$ && ${#SC_CAMPAIGN_MAX_TURNS} -le 9 && \
    "$SC_CAMPAIGN_MAX_TURNS" -le "$SC_CAMPAIGN_MAX_TURNS_LIMIT" ]] || \
    sc_usage_error "--companion-max-turns must be 0 (unbounded) or an integer through $SC_CAMPAIGN_MAX_TURNS_LIMIT"
  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    (( SC_CAMPAIGN_MAX_COUNT < SC_LOCAL_MAX_QUEUE )) ||
      sc_usage_error "managed-local companions must be fewer than the provider queue ceiling ($SC_LOCAL_MAX_QUEUE)"
  fi
  sc_validate_jail_ceiling "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" --companion-storage-budget 64 "$SC_CAMPAIGN_MAX_STORAGE_MIB"
  [[ "$SC_CAMPAIGN_BUDGET_GROUP" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
    sc_usage_error "--companion-budget-group must be a 1-64 character identifier"
  [[ "$SC_CAMPAIGN_STORAGE_BUDGET_MIB" != null || "$SC_CAMPAIGN_BUDGET_GROUP" == default ]] ||
    sc_usage_error "--companion-budget-group requires --companion-storage-budget"
  case "$SC_JAIL_NETWORK_CEILING" in
    auto) (( SC_BARE )) && SC_JAIL_NETWORK_CEILING=host || SC_JAIL_NETWORK_CEILING=outer ;;
    none) ;;
    outer) (( ! SC_BARE )) || sc_usage_error "--jail-network outer is available only in safe mode" ;;
    host) (( SC_BARE )) || sc_usage_error "--jail-network host requires --BARE-METAL" ;;
    *) sc_usage_error "--jail-network must be auto, none, outer, or host" ;;
  esac
  sc_validate_jail_resource_ceilings
  [[ -n "$SC_OPERATOR_DECLARATION" || $SC_OPERATOR_OPEN -eq 0 ]] ||
    sc_usage_error "--open-operator requires --operator-service FILE"
  if [[ -n "$SC_OPERATOR_DECLARATION" ]]; then
    SC_OPERATOR_ENABLED=1
    (( SC_BROWSER )) || sc_usage_error "--operator-service requires the controlled browser"
  fi
}

sc_safe_args() {
  (( ! SC_BARE )) || return 0
  local arg
  for arg in "${SC_CODEX_ARGS[@]}"; do
    case "$arg" in
      --dangerously-bypass-approvals-and-sandbox|--dangerously-bypass-approvals-and-sandbox=*|\
      --dangerously-bypass-hook-trust|--dangerously-bypass-hook-trust=*|--yolo|--yolo=*|\
      --full-auto|--full-auto=*|--sandbox|--sandbox=*|-s|-s=*|-s?*|\
      --ask-for-approval|--ask-for-approval=*|-a|-a=*|-a?*|--approve-for-me|--approve-for-me=*|\
      --add-dir|--add-dir=*|--cd|--cd=*|-C|-C=*|-C?*|--worktree|--worktree=*|\
      --config|--config=*|-c|-c=*|-c?*|--profile|--profile=*|-p|-p=*|-p?*|\
      --remote|--remote=*|--remote-auth-token-env|--remote-auth-token-env=*|\
      --enable|--enable=*|--disable|--disable=*|--ignore-user-config|--ignore-user-config=*|\
      --ignore-rules|--ignore-rules=*|--search|--search=*|--thread-source|--thread-source=*|\
      --ephemeral|--ephemeral=*|\
      --oss|--oss=*|--local-provider|--local-provider=*|--all|--all=*|resume|fork)
        sc_die "safe mode owns Codex authority; rejected argument: $arg" 64 ;;
    esac
  done
}

sc_select_project() {
  local requested="${SC_PROJECT_ARG:-$PWD}"
  sc_no_line_breaks "$requested" "project path"
  [[ -d "$requested" ]] || sc_die "project does not exist: $requested"
  SC_PROJECT="$(realpath -- "$requested")"
  sc_no_line_breaks "$SC_PROJECT" "canonical project path"
  [[ "$SC_PROJECT" != *:* ]] || sc_die "project path cannot contain ':' because its launcher is added to PATH"
  case "$SC_PROJECT" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/mnt|/nix|/proc|/root|/run|/sbin|/sys|/tmp|/usr|/var) sc_die "refusing unsafe project root: $SC_PROJECT" ;;
  esac
  [[ "$SC_PROJECT" != "$SC_REAL_HOME" ]] ||
    sc_die "refusing the entire home directory as project; cd into a smaller project or pass --project DIR"
  [[ "$SC_PROJECT" != "$SC_GLOBAL" && "$SC_PROJECT" != "$SC_GLOBAL"/* ]] || sc_die "project cannot be inside trusted state"
  [[ "$SC_GLOBAL" != "$SC_PROJECT"/* ]] || sc_die "trusted state cannot be inside the project"
  [[ "$SC_COMMAND" == logs || "$SC_COMMAND" == publish || -w "$SC_PROJECT" ]] ||
    sc_die "project is not writable: $SC_PROJECT"
  SC_PROJECT_KEY="$(printf '%s\0' "$SC_PROJECT" | sha256sum | awk '{print $1}')"
  SC_CONTROL="$SC_GLOBAL/projects/$SC_PROJECT_KEY"
  SC_LOCAL="$SC_PROJECT/.sandcodex"
  SC_WORK="$SC_LOCAL/work"
  SC_LOOP_ROOT="$SC_WORK/loop"
  SC_CAMPAIGN_LOCAL_ROOT="$SC_WORK/campaign"
}

sc_validate_operator_declaration() {
  (( SC_OPERATOR_ENABLED )) || return 0
  local requested="$SC_OPERATOR_DECLARATION" path bytes mode cwd expected_cwd
  sc_no_line_breaks "$requested" "operator declaration path"
  [[ "$requested" == /* ]] || requested="$SC_PROJECT/$requested"
  path="$(realpath -e -- "$requested" 2>/dev/null || true)"
  [[ -n "$path" ]] || sc_die "operator declaration does not exist: $SC_OPERATOR_DECLARATION"
  sc_no_line_breaks "$path" "canonical operator declaration path"
  case "$path" in
    "$SC_PROJECT"/*) ;;
    *) sc_die "operator declaration must be inside the selected project" ;;
  esac
  case "$path" in
    "$SC_LOCAL"|"$SC_LOCAL"/*)
      sc_die "operator declaration cannot be inside a protected control plane" ;;
  esac
  sc_no_symlink_components "$path" "operator declaration"
  sc_owned_single_file "$path" "" "operator declaration"
  mode="$(stat -c %a -- "$path")"; bytes="$(stat -c %s -- "$path")"
  (( (8#$mode & 8#022) == 0 )) || sc_die "operator declaration must not be group- or world-writable"
  (( bytes > 0 && bytes <= SC_OPERATOR_DECLARATION_MAX_BYTES )) ||
    sc_die "operator declaration must be 1-$SC_OPERATOR_DECLARATION_MAX_BYTES bytes"
  jq -e \
    --argjson requestMax "$SC_OPERATOR_REQUEST_MAX_BYTES" \
    --argjson responseMax "$SC_OPERATOR_RESPONSE_MAX_BYTES" '
      type == "object" and
      ((keys - ["stop","adapter"]) | sort) == (["argv","capabilities","cwd","ingress","listen","name","network","ready_timeout_seconds","restart","schema"] | sort) and
      .schema == "sandcodex.operator-service-declaration.v1" and
      (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")) and
      (.cwd | type == "string" and length >= 1 and length <= 1024 and startswith("/") == false and
        (. == "." or (split("/") | all(. != "" and . != "." and . != "..")))) and
      (.argv | type == "array" and length >= 1 and length <= 128 and
        all(type == "string" and length >= 1 and length <= 4096 and contains("\u0000") == false)) and
      ((has("adapter") | not) or
        (.adapter | type == "object" and
          (keys | sort) == (["mode","target_port"] | sort) and
          .mode == "tcp-loopback" and
          (.target_port | type == "number" and floor == . and . >= 1 and . <= 65535))) and
      .network == "none" and
      (.capabilities | type == "array" and length <= 3 and unique == . and
        all(. == "glasstty-broker" or . == "jail-actions" or . == "campaign-control")) and
      (.listen | type == "string" and length <= 64 and test("^[A-Za-z0-9][A-Za-z0-9._-]*\\.sock$")) and
      (.ready_timeout_seconds | type == "number" and floor == . and . >= 1 and . <= 300) and
      (.restart | type == "object" and
        (keys | sort) == (["base_delay_seconds","limit","mode","window_seconds"] | sort) and
        (.mode == "never" or .mode == "on-failure") and
        (.limit | type == "number" and floor == . and . >= 0 and . <= 10) and
        (.window_seconds | type == "number" and floor == . and . >= 1 and . <= 3600) and
        (.base_delay_seconds | type == "number" and floor == . and . >= 0 and . <= 60)) and
      ((has("stop") | not) or
        (.stop | type == "object" and
          (keys | sort) == ["grace_seconds"] and
          (.grace_seconds | type == "number" and floor == . and . >= 1 and . <= 900))) and
      (.ingress | type == "object" and
        (keys | sort) == (["protocol","request_max_bytes","response_max_bytes"] | sort) and
        .protocol == "http-websocket" and
        (.request_max_bytes | type == "number" and floor == . and . >= 1 and . <= $requestMax) and
        (.response_max_bytes | type == "number" and floor == . and . >= 1 and . <= $responseMax))
    ' "$path" >/dev/null || sc_die "operator declaration does not match sandcodex.operator-service-declaration.v1"
  cwd="$(jq -er '.cwd' "$path")"
  expected_cwd="$(realpath -e -- "$SC_PROJECT/$cwd" 2>/dev/null || true)"
  [[ -n "$expected_cwd" && -d "$expected_cwd" ]] || sc_die "operator declaration cwd is not an existing directory"
  case "$expected_cwd" in
    "$SC_PROJECT"|"$SC_PROJECT"/*) ;;
    *) sc_die "operator declaration cwd escapes the selected project" ;;
  esac
  case "$expected_cwd" in
    "$SC_LOCAL"|"$SC_LOCAL"/*)
      sc_die "operator declaration cwd is inside a protected control plane" ;;
  esac
  SC_OPERATOR_DECLARATION_PATH="$path"
  SC_OPERATOR_DECLARATION_JSON="$(jq -cS . "$path")"
  SC_OPERATOR_DECLARATION_SHA256="$(sha256sum -- "$path" | awk '{print $1}')"
  SC_OPERATOR_STOP_GRACE_SECONDS="$(jq -r ".stop.grace_seconds // $SC_OPERATOR_STOP_GRACE_DEFAULT_SECONDS" <<<"$SC_OPERATOR_DECLARATION_JSON")"
  SC_OPERATOR_NAME="$(jq -r '.name' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  SC_OPERATOR_LISTEN="$(jq -r '.listen' <<<"$SC_OPERATOR_DECLARATION_JSON")"
}

sc_assert_no_mounts_at_or_below() {
  local root="$1" include_root="$2" label="$3" mount_target scan scan_error=""
  scan="$(mktemp "$SC_GLOBAL/runtime/.mounts.XXXXXX")"
  if ! findmnt --json --list --output TARGET | jq -j '.filesystems[]? | (.target // empty), "\u0000"' >"$scan"; then
    rm -f -- "$scan"
    sc_die "$label mount scan failed"
  fi
  while IFS= read -r -d '' mount_target; do
    if (( include_root )) && [[ "$mount_target" == "$root" ]]; then
      scan_error="$label is itself a mount: $mount_target"
      break
    fi
    case "$mount_target" in
      "$root"/*)
        scan_error="$label contains a nested mount: $mount_target"
        break
        ;;
    esac
  done <"$scan"
  rm -f -- "$scan"
  [[ -z "$scan_error" ]] || sc_die "$scan_error"
}

sc_project_path_protected() {
