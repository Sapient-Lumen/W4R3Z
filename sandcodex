@contextlib.contextmanager
def directory_lock(root, label):
    root = checked_dir(root, label)
    path = os.path.join(root, ".lock")
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags, 0o600)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
           info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600:
            fail(f"{label} lock metadata is invalid")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def project_key(path):
    return hashlib.sha256(os.fsencode(path) + b"\0").hexdigest()


def checked_source_git(context, project):
    source = context.get("source_git")
    if not isinstance(source, dict):
        fail("campaign source Git identity is missing")
    mode = source.get("mode")
    if mode not in {"native", "managed"}:
        fail("campaign source Git mode is invalid")
    work_tree = os.path.abspath(source.get("work_tree", ""))
    git_dir = os.path.abspath(source.get("git_dir", ""))
    expected_git_dir = os.path.join(
        project, ".git" if mode == "native" else ".sandcodex/work/vcs"
    )
    if work_tree != project or canonical(work_tree) != work_tree or \
       git_dir != expected_git_dir or canonical(git_dir) != git_dir:
        fail("campaign source Git paths do not match the selected project")
    for path, label, identity, mode_value in (
        (
            work_tree, "campaign source worktree",
            source.get("work_tree_identity"), source.get("work_tree_mode"),
        ),
        (
            git_dir, "campaign source Git directory",
            source.get("git_dir_identity"), source.get("git_dir_mode"),
        ),
    ):
        try:
            info = os.lstat(path)
        except OSError as error:
            fail(f"{label} is unavailable: {error}")
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or \
           identity != f"{info.st_dev}:{info.st_ino}" or \
           mode_value != format(stat.S_IMODE(info.st_mode), "o"):
            fail(f"{label} metadata changed after authority was granted")
    marker_path = source.get("marker_path")
    marker_digest = source.get("marker_sha256")
    marker_identity = source.get("marker_identity")
    if mode == "native":
        if marker_path is not None or marker_digest is not None or marker_identity is not None:
            fail("native campaign source Git identity contains a managed marker")
    else:
        if source.get("git_dir_mode") != "700":
            fail("managed campaign source Git directory permissions are invalid")
        expected_marker = os.path.join(git_dir, "SANDCODEX_MANAGED_VCS")
        if marker_path != expected_marker or not re.fullmatch(r"[0-9a-f]{64}", str(marker_digest or "")):
            fail("managed campaign source Git marker identity is invalid")
        checked_file(expected_marker, "managed campaign source Git marker", 4096)
        marker_info = os.lstat(expected_marker)
        if marker_identity != f"{marker_info.st_dev}:{marker_info.st_ino}":
            fail("managed campaign source Git marker changed after authority was granted")
        if digest_file(expected_marker) != marker_digest:
            fail("managed campaign source Git marker changed after authority was granted")
        try:
            fields = dict(
                line.split("=", 1)
                for line in Path(expected_marker).read_text(encoding="utf-8").splitlines()
            )
        except (OSError, UnicodeError, ValueError):
            fail("managed campaign source Git marker is malformed")
        if fields != {"project": project, "uid": str(os.getuid())}:
            fail("managed campaign source Git marker does not match the selected project")
    return {
        "mode": mode,
        "work_tree": work_tree,
        "git_dir": git_dir,
        "work_tree_identity": source["work_tree_identity"],
        "work_tree_mode": source["work_tree_mode"],
        "git_dir_identity": source["git_dir_identity"],
        "git_dir_mode": source["git_dir_mode"],
        "marker_path": marker_path,
        "marker_sha256": marker_digest,
        "marker_identity": marker_identity,
    }


def validate_context(context):
    if context.get("schema") not in {AUTHORITY_SCHEMA, "sandcodex.campaign-context.v1"}:
        fail("campaign context schema is incompatible")
    project = os.path.abspath(context.get("project", ""))
    global_root = os.path.abspath(context.get("global_root", ""))
    campaign_root = os.path.abspath(context.get("campaign_root", ""))
    workspace_root = os.path.abspath(context.get("workspace_root", ""))
    engine_home = os.path.abspath(context.get("engine_home", ""))
    worker_global_root = os.path.abspath(context.get("worker_global_root", ""))
    key = context.get("project_key")
    if not project or canonical(project) != project or not os.path.isdir(project) or \
       not KEY_RE.fullmatch(str(key or "")):
        fail("campaign context project identity is invalid")
    if project_key(project) != key:
        fail("campaign context project digest does not match")
    source_git = (
        checked_source_git(context, project)
        if context.get("source_git") is not None
        else None
    )
    if not re.fullmatch(r"sandcodex\.state\.v[0-9]+", str(context.get("state_schema", ""))):
        fail("campaign context state schema is invalid")
    checked_dir(global_root, "global campaign control root")
    checked_dir(campaign_root, "trusted campaign root")
    checked_dir(workspace_root, "campaign workspace root")
    checked_dir(engine_home, "campaign engine home")
    checked_dir(worker_global_root, "campaign worker global root")
    storage = context.get("storage")
    if (
        not isinstance(storage, dict)
        or set(storage) != {"budget_group", "maximum_bytes", "metering", "hard_enforced"}
        or not NAME_RE.fullmatch(str(storage.get("budget_group", "")))
        or (
            storage.get("maximum_bytes") is not None
            and (
                not isinstance(storage["maximum_bytes"], int)
                or isinstance(storage["maximum_bytes"], bool)
                or storage["maximum_bytes"] < 64 * 1024 * 1024
            )
        )
        or storage.get("hard_enforced") != (storage.get("maximum_bytes") is not None)
    ):
        fail("campaign storage authority is invalid")
    launcher = checked_file(context.get("launcher", ""), "campaign launcher", 64 * 1024 * 1024, executable=True)
    if digest_file(launcher) != context.get("artifact_sha256"):
        fail("campaign launcher digest does not match its context")
    systemctl = canonical(context.get("systemctl", ""))
    if not os.path.isfile(systemctl) or not os.access(systemctl, os.X_OK):
        fail("trusted systemctl executable is unavailable")
    context = dict(context)
    context.update(
        project=project, global_root=global_root, campaign_root=campaign_root,
        workspace_root=workspace_root, engine_home=engine_home,
        worker_global_root=worker_global_root, launcher=launcher, systemctl=systemctl,
        source_git=source_git,
    )
    return context


def normalize_worker_grants(authority):
    launch_max = authority.get("launch_max_campaigns", authority.get("max_campaigns"))
    if not isinstance(launch_max, int) or isinstance(launch_max, bool) or launch_max < 0 or launch_max > 16:
        fail("campaign launch worker-grant ceiling is invalid")
    if authority.get("max_campaigns") > launch_max:
        fail("campaign launch worker-grant ceiling is narrower than the launch capacity")
    raw = authority.get("worker_grants")
    if raw is None:
        return {
            "schema": WORKER_GRANTS_SCHEMA,
            "starts_enabled": True,
            "max_campaigns": authority["max_campaigns"],
            "remote_auto_enabled": True,
            "browser_modes": ["none"],
            "desktop_modes": ["none"],
            "updated_at": None,
            "receipt_id": None,
        }, launch_max
    expected = {
        "schema", "starts_enabled", "max_campaigns", "remote_auto_enabled",
        "browser_modes", "desktop_modes", "updated_at", "receipt_id",
    }
    if not isinstance(raw, dict) or set(raw) != expected or raw.get("schema") != WORKER_GRANTS_SCHEMA:
        fail("campaign worker grants are invalid")
    if not isinstance(raw.get("starts_enabled"), bool) or not isinstance(raw.get("remote_auto_enabled"), bool):
        fail("campaign worker grant booleans are invalid")
    maximum = raw.get("max_campaigns")
    if not isinstance(maximum, int) or isinstance(maximum, bool) or maximum < 0 or maximum > launch_max:
        fail("campaign worker grant capacity is invalid")
    browser_ceiling = authority.get("browser_modes", ["none"])
    desktop_ceiling = authority.get("desktop_modes", ["none"])
    for field, ceiling in (("browser_modes", browser_ceiling), ("desktop_modes", desktop_ceiling)):
        value = raw.get(field)
        if not isinstance(ceiling, list) or ceiling[0:1] != ["none"] or any(
                item not in {"none", "isolated"} for item in ceiling):
            fail(f"campaign worker {field} ceiling is invalid")
        if not isinstance(value, list) or value[0:1] != ["none"] or len(value) != len(set(value)) or any(
                item not in ceiling for item in value):
            fail(f"campaign worker {field} grants are invalid")
    updated_at = raw.get("updated_at")
    if updated_at is not None and (
        not isinstance(updated_at, str) or len(updated_at) > 64 or "\0" in updated_at
    ):
        fail("campaign worker grant timestamp is invalid")
    receipt_id = raw.get("receipt_id")
    if receipt_id is not None and not ID_RE.fullmatch(str(receipt_id)):
        fail("campaign worker grant receipt identity is invalid")
    return dict(raw), launch_max


