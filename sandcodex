    @staticmethod
    def _assert_pointer_fence_deadline(started: float) -> None:
        if time.monotonic() - started > MAX_ACTION_SECONDS:
            raise ToolError("guarded pointer gesture exceeded the action runtime limit")

    def _check_pointer_fence(
        self,
        route: dict[str, Any],
        point_index: int,
        evidence: dict[str, Any],
    ) -> None:
        evidence["route_check_attempts"] = int(evidence["route_check_attempts"]) + 1
        self._assert_pointer_route(route, point_index)
        evidence["route_checks"] = int(evidence["route_checks"]) + 1

    def _dispatch_compositor_guarded_keyboard_unit(
        self,
        target: dict[str, Any],
        transaction: WaylandKeyboardTransaction,
        keycode: int,
        modifiers: int,
    ) -> dict[str, Any]:
        """Let Sway recheck and deliver one complete exact-focus key unit."""
        if not self.is_wayland:
            raise ToolError("compositor-native keyboard dispatch requires Wayland")
        if transaction is not getattr(self, "_active_keyboard_transaction", None):
            raise ToolError("compositor keyboard dispatch lost its birth-pinned transaction")
        if transaction.closed or not transaction.release_confirmed:
            raise ToolError("compositor keyboard dispatch lost released helper state")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor keyboard dispatch has no SeatSeal device receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor keyboard virtual-device identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor keyboard dispatch is unavailable")
        focus_context: dict[str, Any] = {}

        def validate(prepared_focus: dict[str, Any]) -> None:
            nonlocal focus_context
            self._assert_keyboard_target(target)
            _active, _signature, windows, active_window_id = self._window_scene()
            if active_window_id != target.get("window_id"):
                raise KeyboardTargetTransition(
                    "keyboard focus changed after compositor arm; input was withheld"
                )
            scene_launch_ids = target.get("scene_launch_ids")
            allowed_launch_ids = (
                set(scene_launch_ids) if isinstance(scene_launch_ids, tuple) and scene_launch_ids else None
            )
            focus_context = self._pointer_hit_test_seal(
                0,
                0,
                windows,
                launch_id=(None if allowed_launch_ids is not None else target.get("launch_id")),
                allowed_launch_ids=allowed_launch_ids,
                expected_window_id=target.get("window_id"),
                hit_override=prepared_focus,
            )
            self._assert_keyboard_target(target)

        transaction.begin_native_dispatch(keycode, modifiers)
        try:
            receipt = seal.guarded_keyboard_unit(keycode, modifiers, validate)
        except Exception:
            transaction.fail_native_dispatch()
            raise
        transaction.confirm_native_dispatch(receipt)
        return {
            **receipt,
            "controller_target_identity_sha256": target.get("identity_sha256"),
            "virtual_keyboard_identity_sha256": device_identity,
            "focus_context_sha256": focus_context.get("hit_test_context_sha256"),
            "focus_recipient_process_scope": focus_context.get(
                "hit_test_recipient_process_scope"
            ),
            "controller_focus_revalidated_against_arm_target": True,
        }


    def _dispatch_compositor_guarded_touch(
        self,
        route: dict[str, Any],
        point_index: int,
    ) -> dict[str, Any]:
        """Use patched Sway for one exact-recipient native wl_touch tap."""
        if not self.is_wayland:
            raise ToolError("native compositor touch dispatch requires Wayland")
        points = route.get("points")
        if not isinstance(points, list) or not 0 <= point_index < len(points):
            raise ToolError("compositor touch route lost its exact point")
        point_record = points[point_index]
        point = point_record.get("point") if isinstance(point_record, dict) else None
        if (
            not isinstance(point, list)
            or len(point) != 2
            or any(type(value) is not int for value in point)
        ):
            raise ToolError("compositor touch route point is malformed")
        x, y = point
        if self.pointer != {"x": x, "y": y}:
            raise ToolError("compositor touch cursor left its reviewed route point")
        transaction = getattr(self, "_active_pointer_transaction", None)
        if transaction is None or transaction.closed:
            raise ToolError("compositor touch lost its birth-pinned route pointer")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor touch has no SeatSeal route-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor touch route-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor touch dispatch is unavailable")

        def validate(prepared_hit: dict[str, Any]) -> None:
            self._assert_pointer_route(
                route,
                point_index,
                prepared_hit=prepared_hit,
            )

        receipt = seal.guarded_touch_tap(x, y, validate)
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "point_index": point_index,
            "route_pointer_identity_sha256": device_identity,
            "controller_route_revalidated_against_arm_target": True,
            "mouse_fallback_used": False,
        }

    def _dispatch_compositor_guarded_modifier_arc(
        self,
        target: dict[str, Any],
        transaction: WaylandKeyboardTransaction,
        modifiers: int,
    ) -> tuple[CompositorModifierArc, dict[str, Any]]:
        """Establish one compositor-owned modifier arc for a pointer gesture.

        The keyboard helper remains physically released.  Sway arms against one
        exact keyboard recipient, the controller independently revalidates that
        same target, and Sway then emits the logical modifier-down directly to
        the recipient before returning from the authenticated IPC callback.
        """
        seal = getattr(self, "compositor_event_seal", None)
        arc: CompositorModifierArc | None = None
        try:
            if not self.is_wayland:
                raise ToolError("compositor modifier arcs require Wayland")
            if transaction is not getattr(self, "_active_keyboard_transaction", None):
                raise ToolError(
                    "compositor modifier arc lost its birth-pinned keyboard transaction"
                )
            if transaction.closed or not transaction.release_confirmed:
                raise ToolError(
                    "compositor modifier arc lost physically released helper state"
                )
            if transaction.held_key != 0 or transaction.modifier_mask != 0:
                raise ToolError(
                    "compositor modifier arc cannot coexist with helper-emitted input"
                )
            if transaction._modifier_arc_pending_mask != modifiers:
                raise ToolError(
                    "compositor modifier arc does not match its sealed transaction plan"
                )
            start_receipt = transaction.seat_start_receipt
            if not isinstance(start_receipt, dict):
                raise ToolError(
                    "compositor modifier arc has no SeatSeal virtual-keyboard receipt"
                )
            device_identity = start_receipt.get("active_device_identity_sha256")
            if not isinstance(device_identity, str) or re.fullmatch(
                r"[0-9a-f]{64}", device_identity
            ) is None:
                raise ToolError(
                    "compositor modifier-arc virtual-keyboard identity is malformed"
                )
            if seal is None or seal.hit_test_authorized is not True:
                raise ToolError(
                    "patched-Sway compositor modifier-arc dispatch is unavailable"
                )
            focus_context: dict[str, Any] = {}

            def validate(prepared_focus: dict[str, Any]) -> None:
                nonlocal focus_context
                self._assert_keyboard_target(target)
                _active, _signature, windows, active_window_id = self._window_scene()
                if active_window_id != target.get("window_id"):
                    raise KeyboardTargetTransition(
                        "keyboard focus changed after modifier-arc arm; modifiers were withheld"
                    )
                scene_launch_ids = target.get("scene_launch_ids")
                allowed_launch_ids = (
                    set(scene_launch_ids)
                    if isinstance(scene_launch_ids, tuple) and scene_launch_ids
                    else None
                )
                focus_context = self._pointer_hit_test_seal(
                    0,
                    0,
                    windows,
                    launch_id=(
                        None
                        if allowed_launch_ids is not None
                        else target.get("launch_id")
                    ),
                    allowed_launch_ids=allowed_launch_ids,
                    expected_window_id=target.get("window_id"),
                    hit_override=prepared_focus,
                )
                self._assert_keyboard_target(target)

            arc, receipt = seal.guarded_modifier_arc(modifiers, validate)
            transaction.confirm_modifier_arc_hold(receipt)
            enriched = {
                **receipt,
                "controller_target_identity_sha256": target.get("identity_sha256"),
                "virtual_keyboard_identity_sha256": device_identity,
                "focus_context_sha256": focus_context.get("hit_test_context_sha256"),
                "focus_recipient_process_scope": focus_context.get(
                    "hit_test_recipient_process_scope"
                ),
                "controller_focus_revalidated_against_arm_target": True,
            }
            return arc, enriched
        except Exception:
            if arc is not None:
                # Dispatch returned a private arc token, so modifiers may be
                # down even when receipt confirmation or later evidence
                # construction failed.  Cancellation is no longer sound.
                clear_confirmed = False
                try:
                    assert seal is not None
                    seal.release_modifier_arc(arc)
                    clear_confirmed = True
                except Exception:
                    # release_modifier_arc revokes the authenticated command
                    # connection on ambiguity; Sway's disconnect path then owns
                    # the de-escalation-only clear.
                    pass
                transaction.abort_modifier_arc_hold_completion(
                    modifiers,
                    clear_attempted=True,
                    clear_confirmed=clear_confirmed,
                )
            elif transaction._modifier_arc_pending_mask == modifiers:
                if seal is not None and seal.failure is not None:
                    transaction.fail_modifier_arc_hold(modifiers)
                else:
                    transaction.cancel_modifier_arc_preparation(modifiers)
            raise

    def _release_compositor_guarded_modifier_arc(
        self,
        arc: CompositorModifierArc,
        transaction: WaylandKeyboardTransaction,
    ) -> dict[str, Any]:
        """Clear one active modifier arc without reauthorizing any target."""
        if transaction is not getattr(self, "_active_keyboard_transaction", None):
            raise ToolError(
                "compositor modifier-arc release lost its birth-pinned transaction"
            )
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None:
            raise ToolError(
                "patched-Sway compositor modifier-arc release is unavailable"
            )
        transaction.begin_modifier_arc_release(arc.modifiers)
        try:
            receipt = seal.release_modifier_arc(arc)
        except Exception:
            transaction.fail_modifier_arc_release(arc.modifiers)
            raise
        try:
            transaction.confirm_modifier_arc_release(receipt)
        except Exception:
            # CompositorEventSeal returned only after validating a consumed arc
            # and a target-independent clear.  Do not replay the one-use token;
            # consume local state and terminate on the evidence mismatch.
            transaction.abort_modifier_arc_release_confirmation(arc.modifiers)
            raise
        return {
            **receipt,
            "controller_target_identity_sha256": arc.target.get(
                "identity_authority_sha256"
            ),
            "release_order": "pointer-release+pointer-destroy+modifier-clear",
            "controller_target_revalidation_performed": False,
        }

    def _dispatch_compositor_guarded_touch_stroke(
        self,
        route: dict[str, Any],
        arguments: dict[str, Any],
    ) -> dict[str, Any]:
        """Use patched Sway for one whole-path exact-recipient native touch stroke."""
        if not self.is_wayland:
            raise ToolError("native compositor touch-stroke dispatch requires Wayland")
        normalized = dict(arguments)
        expected_points = self._touch_stroke_points(normalized)
        points = route.get("points")
        if not isinstance(points, list) or len(points) != len(expected_points):
            raise ToolError("compositor touch-stroke route lost its exact path")
        for index, (record, expected) in enumerate(zip(points, expected_points)):
            if not isinstance(record, dict) or record.get("point") != list(expected):
                raise ToolError(
                    f"compositor touch-stroke route point {index} is malformed"
                )
        start_x, start_y = expected_points[0]
        end_x, end_y = expected_points[-1]
        if self.pointer != {"x": start_x, "y": start_y}:
            raise ToolError(
                "compositor touch-stroke cursor left its reviewed start point"
            )
        transaction = getattr(self, "_active_pointer_transaction", None)
        if transaction is None or transaction.closed:
            raise ToolError("compositor touch-stroke lost its birth-pinned route pointer")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor touch-stroke has no SeatSeal route-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor touch-stroke route-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor touch-stroke dispatch is unavailable")

        def validate(prepared_hit: dict[str, Any]) -> None:
            self._assert_pointer_route(route, 0, prepared_hit=prepared_hit)
            identities = {
                (
                    point.get("hit_test_recipient_identity_sha256"),
                    point.get("hit_test_window_id"),
                    point.get("hit_test_target_kind"),
                    point.get("hit_test_surface_class"),
                )
                for point in points
                if isinstance(point, dict)
            }
            if len(identities) != 1 or next(iter(identities))[2] != "surface":
                raise PointerRouteTransition(
                    "native touch-stroke path no longer names one exact client surface"
                )

        receipt = seal.guarded_touch_stroke(
            start_x,
            start_y,
            end_x,
            end_y,
            int(normalized["steps"]),
            int(normalized["duration_milliseconds"]),
            validate,
        )
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "point_index": 0,
            "route_points": len(points),
            "route_pointer_identity_sha256": device_identity,
