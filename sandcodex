         exact_model_step_replay_qualified:$receipt[0].probes.exact_model_step_replay,
         semantic_pair_validation_qualified:$receipt[0].probes.semantic_pair_validation,
         cross_model_exact_state_replay_qualified:$receipt[0].probes.cross_model_exact_state_replay,
