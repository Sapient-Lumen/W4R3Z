sc_gemini_cooldowns_dispatch() {
  local cooldowns
  cooldowns="$(sc_gemini_cooldowns_json)"
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$cooldowns"
    return
  fi
  printf 'gemini cooldowns\n'
  printf '  path: %s\n' "$(sc_gemini_cooldowns_path)"
  jq -r '"  account keys: \((.keys // {})|length) · models: \((.models // {})|length) · account/model routes: \((.pairs // {})|length)"' <<<"$cooldowns"
  jq -r 'if .normalization.legacy_model_quota_ignored_count > 0 then
    "  self-healing: ignoring " + (.normalization.legacy_model_quota_ignored_count|tostring) +
    " legacy global quota cooldown(s); the current adapter removes them on first use" else
    "  self-healing: no legacy global quota cooldowns pending" end' <<<"$cooldowns"
  jq -r '.keys | to_entries[]? | "  key " + .key + " until " + .value.until + " · " + (.value.reason // "cooldown")' <<<"$cooldowns"
  jq -r '.models | to_entries[]? | "  model " + .key + " until " + .value.until + " · " + (.value.reason // "cooldown")' <<<"$cooldowns"
  jq -r '.pairs | to_entries[]? | "  account/model " + .key + " until " + .value.until + " · " + (.value.reason // "cooldown")' <<<"$cooldowns"
  jq -r '.route_events[-10:][]? |
    "  event " + .at + " · " + .event +
    (if .model then " · model " + .model else "" end) +
    (if .key_id then " · key " + .key_id else "" end) +
    (if .category then " · " + .category else "" end) +
    (if .scope then " · " + .scope else "" end)' <<<"$cooldowns"
  printf '  credential value: not disclosed · raw provider content: not printed\n'
}

