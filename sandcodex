    def _prune_observations(self) -> None:
        now = time.monotonic()
        for identifier, observation in list(self.observations.items()):
            if now - observation.created > OBSERVATION_TTL_SECONDS or observation.consumed:
                self.observations.pop(identifier, None)
        if len(self.observations) > MAX_OBSERVATIONS:
            oldest = sorted(self.observations.values(), key=lambda item: item.created)
            for observation in oldest[: len(self.observations) - MAX_OBSERVATIONS]:
                self.observations.pop(observation.observation_id, None)

    @staticmethod
    def _encoded_image(image: Image.Image, maximum: int) -> tuple[bytes, str]:
        buffer = io.BytesIO()
        image.save(buffer, format="PNG", optimize=True)
        payload = buffer.getvalue()
        if len(payload) > maximum:
            raise ToolError("desktop observation exceeds the configured output limit")
        return payload, base64.b64encode(payload).decode("ascii")

    @staticmethod
    def _semantic_options(value: Any) -> dict[str, Any]:
        if not isinstance(value, dict):
            raise ToolError("accessibility must be an object")
        allowed = {
            "max_nodes", "max_depth", "text_limit", "timeout_milliseconds",
            "query", "roles", "process_ids",
        }
        unknown = sorted(set(value) - allowed)
        if unknown:
            raise ToolError(f"unsupported accessibility observation options: {unknown}")
        try:
            # Break aliases and reject values that cannot cross the MCP JSON boundary.
            normalized = json.loads(json.dumps(value, ensure_ascii=False))
        except (TypeError, ValueError) as error:
            raise ToolError("accessibility observation options must be JSON values") from error
        if not isinstance(normalized, dict):
            raise ToolError("accessibility must be an object")
        return normalized

    @staticmethod
    def _semantic_projection(snapshot: dict[str, Any]) -> dict[str, Any]:
        nodes_value = snapshot.get("nodes", [])
        nodes = nodes_value if isinstance(nodes_value, list) else []
        indexes = {
            str(node.get("node_id") or node.get("id")): index
            for index, node in enumerate(nodes)
            if isinstance(node, dict) and (node.get("node_id") or node.get("id"))
        }
        projected: list[dict[str, Any]] = []
        for node in nodes:
            if not isinstance(node, dict):
                continue
            clean = {
                key: value for key, value in node.items()
                if key not in {"id", "node_id", "parent_id"}
            }
            parent = node.get("parent_id")
            clean["parent_index"] = indexes.get(str(parent)) if isinstance(parent, str) else None
            projected.append(clean)
        return {
            "available": snapshot.get("available") is True,
            "nodes": projected,
            "count": snapshot.get("count"),
            "scanned": snapshot.get("scanned"),
            "truncated": snapshot.get("truncated"),
            "timed_out": snapshot.get("timed_out"),
            "max_nodes": snapshot.get("max_nodes"),
            "max_depth": snapshot.get("max_depth"),
            "text_limit": snapshot.get("text_limit"),
            "process_ids": snapshot.get("process_ids", []),
        }

    @classmethod
    def _semantic_fingerprint(cls, snapshot: dict[str, Any]) -> tuple[str, tuple[str, ...]]:
        nodes = snapshot.get("nodes", [])
        node_ids = tuple(
            str(node.get("node_id") or node.get("id"))
            for node in nodes
            if isinstance(node, dict) and (node.get("node_id") or node.get("id"))
        ) if isinstance(nodes, list) else ()
        digest = hashlib.sha256(canonical_json(cls._semantic_projection(snapshot))).hexdigest()
        return digest, node_ids

    def _capture_semantic_pair(
        self,
        capture_arguments: dict[str, Any],
        semantic_options: dict[str, Any],
        minimum_frame_gap_milliseconds: int = 0,
    ) -> tuple[
        Image.Image, dict[str, int] | None, int | None,
        str, str, dict[str, Any], str, tuple[str, ...], float, dict[str, Any],
        dict[str, Any] | None, dict[str, Any] | None,
    ]:
        last_difference = 1.0
        for _attempt in range(SEMANTIC_PAIR_ATTEMPTS):
            before_active, before_windows = self._active_and_window_signatures()
            before_frame = self._capture_region(capture_arguments)
            before_image = before_frame.image
            before_crop = before_frame.crop
            before_window = before_frame.window_id
            before_source = self._capture_source_from_frame(before_frame)
            before_transient_map = self._scene_transient_map_from_frame(
                before_frame, before_source
            )
            before_occlusion_map = self._scene_occlusion_map_from_frame(
                before_frame, before_source
            )
            semantic = self.accessibility.snapshot(semantic_options)
            if semantic.get("timed_out"):
                raise ToolError("accessibility observation timed out before a stable scene could be sealed")
            if minimum_frame_gap_milliseconds:
                time.sleep(minimum_frame_gap_milliseconds / 1000)
            after_frame = self._capture_region(capture_arguments)
            after_image = after_frame.image
            after_crop = after_frame.crop
            after_window = after_frame.window_id
            after_source = self._capture_source_from_frame(after_frame)
            after_transient_map = self._scene_transient_map_from_frame(
                after_frame, after_source
            )
            after_occlusion_map = self._scene_occlusion_map_from_frame(
                after_frame, after_source
            )
            after_active, after_windows = self._active_and_window_signatures()
            last_difference = self._visual_difference(
                self._visual_sample(before_image), self._visual_sample(after_image)
            )
            stable = (
                before_crop == after_crop
                and before_window == after_window
                and before_source == after_source
                and before_transient_map == after_transient_map
                and before_occlusion_map == after_occlusion_map
                and before_active == after_active
                and before_windows == after_windows
                and before_image.size == after_image.size
                and (
                    self._image_fingerprint(before_image) == self._image_fingerprint(after_image)
                    or last_difference <= SEMANTIC_PAIR_THRESHOLD
                )
            )
            if stable:
                semantic_sha256, semantic_node_ids = self._semantic_fingerprint(semantic)
                return (
                    after_image, after_crop, after_window,
                    after_active, after_windows, semantic,
                    semantic_sha256, semantic_node_ids, last_difference, after_source,
                    after_transient_map, after_occlusion_map,
                )
        raise ToolError(
            "desktop changed while pairing pixels with accessibility "
            f"(visual difference {last_difference:.6f})"
        )

    def _capture_pixel_pair(
        self,
        capture_arguments: dict[str, Any],
        difference_threshold: float,
    ) -> tuple[
        Image.Image, dict[str, int] | None, int | None,
        str, str, float, dict[str, Any], dict[str, Any] | None,
        dict[str, Any] | None,
    ]:
        """Capture two stable post-hover frames plus compositor signatures."""
        last_difference = 1.0
        for _attempt in range(POINTER_LATCH_PAIR_ATTEMPTS):
            before_active, before_windows = self._active_and_window_signatures()
            before_frame = self._capture_region(capture_arguments)
            before_image = before_frame.image
            before_crop = before_frame.crop
            before_window = before_frame.window_id
            before_source = self._capture_source_from_frame(before_frame)
            before_transient_map = self._scene_transient_map_from_frame(
                before_frame, before_source
            )
            before_occlusion_map = self._scene_occlusion_map_from_frame(
                before_frame, before_source
            )
            time.sleep(POINTER_LATCH_FRAME_GAP_MILLISECONDS / 1000)
            after_frame = self._capture_region(capture_arguments)
            after_image = after_frame.image
            after_crop = after_frame.crop
            after_window = after_frame.window_id
            after_source = self._capture_source_from_frame(after_frame)
            after_transient_map = self._scene_transient_map_from_frame(
                after_frame, after_source
            )
            after_occlusion_map = self._scene_occlusion_map_from_frame(
                after_frame, after_source
            )
            after_active, after_windows = self._active_and_window_signatures()
            last_difference = self._visual_difference(
                self._visual_sample(before_image), self._visual_sample(after_image)
            )
            stable = (
                before_crop == after_crop
                and before_window == after_window
                and before_source == after_source
                and before_transient_map == after_transient_map
                and before_occlusion_map == after_occlusion_map
                and before_active == after_active
                and before_windows == after_windows
                and before_image.size == after_image.size
                and (
                    self._image_fingerprint(before_image) == self._image_fingerprint(after_image)
                    or last_difference <= difference_threshold
                )
            )
            if stable:
                return (
                    after_image,
                    after_crop,
                    after_window,
                    after_active,
                    after_windows,
                    last_difference,
                    after_source,
                    after_transient_map,
                    after_occlusion_map,
                )
        raise ToolError(
            "desktop did not stabilize after pointer hover "
            f"(visual difference {last_difference:.6f})"
        )

    @classmethod
    def _normalize_outcome_policy(
        cls,
        value: Any,
        observation: Observation,
    ) -> dict[str, Any] | None:
        """Normalize one bounded post-action assertion without publishing secrets.

        OutcomeSeal is deliberately optional.  When supplied it is part of the
        single-use action authority and cannot be widened after dispatch.  The
        selector remains controller-private; only keyed policy/result digests
        and bounded condition counts enter the public receipt.
        """
        if value is None:
            return None
        if not isinstance(value, dict) or len(value) > 16:
            raise ToolError("outcome must be a bounded object")
        allowed = {
            "scope", "screen", "active_window", "window_scene", "accessibility",
            "timeout_milliseconds", "poll_milliseconds", "stable_milliseconds",
            "difference_threshold", "required",
        }
        unknown = sorted(set(value) - allowed)
        if unknown:
            raise ToolError(f"outcome contains unsupported fields: {unknown}")
        scope = value.get("scope", "reviewed")
        if scope not in {"reviewed", "active", "workstation"}:
            raise ToolError("outcome.scope must be reviewed, active, or workstation")
        if (
            observation.launch_id is not None or observation.scene_id is not None
        ) and scope == "workstation":
            raise ToolError("guarded launch or scene outcomes cannot inspect the whole workstation")
        conditions: dict[str, str] = {}
        for field_name in ("screen", "active_window", "window_scene"):
            condition = value.get(field_name, "any")
            if condition not in {"any", "same", "changed"}:
                raise ToolError(f"outcome.{field_name} must be any, same, or changed")
            conditions[field_name] = condition
        timeout_ms = as_int(
            value.get("timeout_milliseconds", OUTCOME_DEFAULT_TIMEOUT_MILLISECONDS),
            0,
            OUTCOME_MAX_TIMEOUT_MILLISECONDS,
            "outcome.timeout_milliseconds",
        )
        poll_ms = as_int(
            value.get("poll_milliseconds", OUTCOME_DEFAULT_POLL_MILLISECONDS),
            OUTCOME_MIN_POLL_MILLISECONDS,
            OUTCOME_MAX_POLL_MILLISECONDS,
            "outcome.poll_milliseconds",
        )
        stable_ms = as_int(
            value.get("stable_milliseconds", OUTCOME_DEFAULT_STABLE_MILLISECONDS),
            0,
            OUTCOME_MAX_STABLE_MILLISECONDS,
            "outcome.stable_milliseconds",
        )
        if stable_ms > timeout_ms:
            raise ToolError("outcome.stable_milliseconds cannot exceed outcome.timeout_milliseconds")
        threshold = as_number(
            value.get("difference_threshold", OUTCOME_DEFAULT_DIFFERENCE_THRESHOLD),
            0.0,
            OUTCOME_MAX_DIFFERENCE_THRESHOLD,
            "outcome.difference_threshold",
        )
        accessibility_value = value.get("accessibility")
        accessibility: dict[str, Any] | None = None
        if accessibility_value is not None:
            if not isinstance(accessibility_value, dict) or len(accessibility_value) > 8:
                raise ToolError("outcome.accessibility must be a bounded object")
            accessibility_allowed = {
                "selector", "condition", "max_nodes", "max_depth", "text_limit",
                "timeout_milliseconds",
            }
            accessibility_unknown = sorted(set(accessibility_value) - accessibility_allowed)
            if accessibility_unknown:
                raise ToolError(
                    "outcome.accessibility contains unsupported fields: "
                    f"{accessibility_unknown}"
                )
            selector = AccessibilityBridge._normalize_selector(
                accessibility_value.get("selector")
            )
            if not selector:
                raise ToolError("outcome.accessibility.selector must contain at least one condition")
            condition = accessibility_value.get("condition", "present")
            if condition not in {"present", "absent", "unique"}:
                raise ToolError(
                    "outcome.accessibility.condition must be present, absent, or unique"
                )
            accessibility = {
                "selector": selector,
                "condition": condition,
                "max_nodes": as_int(
                    accessibility_value.get("max_nodes", MAX_A11Y_NODES),
                    1,
                    MAX_A11Y_NODES,
                    "outcome.accessibility.max_nodes",
                ),
                "max_depth": as_int(
                    accessibility_value.get("max_depth", MAX_A11Y_DEPTH),
                    0,
                    MAX_A11Y_DEPTH,
                    "outcome.accessibility.max_depth",
                ),
                "text_limit": as_int(
                    accessibility_value.get("text_limit", 1024),
                    0,
                    MAX_A11Y_TEXT,
                    "outcome.accessibility.text_limit",
                ),
                "timeout_milliseconds": as_int(
                    accessibility_value.get(
                        "timeout_milliseconds",
                        min(10000, MAX_A11Y_SNAPSHOT_MILLISECONDS),
                    ),
                    100,
                    MAX_A11Y_SNAPSHOT_MILLISECONDS,
                    "outcome.accessibility.timeout_milliseconds",
                ),
            }
        return {
            "schema": OUTCOME_SEAL_SCHEMA,
            "scope": scope,
            **conditions,
            "accessibility": accessibility,
            "timeout_milliseconds": timeout_ms,
            "poll_milliseconds": poll_ms,
            "stable_milliseconds": stable_ms,
            "difference_threshold": threshold,
            "required": as_bool(value.get("required", True), "outcome.required"),
        }

    @staticmethod
    def _observation_uses_launch_scene(observation: Observation) -> bool:
        source = observation.capture_source
        return isinstance(source, dict) and source.get("scope") == "launch-scene"

    @staticmethod
    def _observation_uses_scene_set(observation: Observation) -> bool:
        source = observation.capture_source
        return isinstance(source, dict) and source.get("scope") == "scene-set"

    def _outcome_capture_arguments(
        self,
        observation: Observation,
        managed: ManagedProcess | None,
        policy: dict[str, Any],
    ) -> dict[str, Any]:
        scope = policy["scope"]
        if scope == "reviewed":
            return dict(observation.capture_arguments)
        if observation.scene_id is not None:
            if not self._observation_uses_scene_set(observation):
                raise ToolError("scene-scoped outcome lost its full-output capture authority")
            if not observation.scene_launch_ids:
                raise ToolError("scene-scoped outcome lost its exact member set")
            # Active scope may follow focus between scene members, but must not
            # collapse to one toplevel and silently discard the cooperating
            # applications or shared coordinate space.
            return {
                "capture_mode": "scene-set",
                "scene_id": observation.scene_id,
                "scene_launch_ids": list(observation.scene_launch_ids),
            }
        if scope == "workstation":
            if managed is not None:
                raise ToolError("launch-scoped outcome escaped its application trust domain")
            return {}
        if managed is not None:
            window = self._require_active_launch(managed)
            if self._observation_uses_launch_scene(observation):
                # Active outcome scope may follow a new dialog/top-level, but a
                # LaunchSceneSeal review must not silently collapse back to one
                # foreign-toplevel frame. Menus, popups, subsurfaces, and the
                # newly active launch-owned window remain part of the same
                # explicitly selected private-output trust domain.
                return {
                    "capture_mode": "launch-scene",
                    "launch_id": managed.launch_id,
                }
            return {"window_id": int(window["id"])}
        _active, _windows, _scene, active_window_id = self._window_scene()
        if active_window_id is None:
            raise ToolError("outcome active-window scope has no focused top-level")
        return {"window_id": int(active_window_id)}

    def _validate_outcome_launch_capture(
        self,
        managed: ManagedProcess | None,
        crop: dict[str, int] | None,
        capture_source: dict[str, Any],
        observation: Observation | None = None,
    ) -> None:
        if observation is not None and observation.scene_id is not None:
            if crop is not None or capture_source.get("scope") != "scene-set":
                raise ToolError("scene-set outcome unexpectedly lost its private-output source")
            members = self._managed_scene(
                observation.scene_id,
                expected_launch_ids=observation.scene_launch_ids,
            )
            authority = self._assert_scene_set_authority(
                members,
                capture_source.get("scene_set_authority_sha256"),
            )
            for key in (
                "scene_id_sha256", "workspace_sha256", "member_set_sha256",
                "active_launch_id_sha256", "output_authority_sha256",
                "visible_scene_sha256", "active_window_identity_sha256",
                "scene_member_count", "visible_window_count",
            ):
                if capture_source.get(key) != authority.get(key):
                    raise ToolError("scene-set outcome source authority changed during verification")
            return
        if managed is None:
            return
        self._refresh_managed(managed)
        if managed.context_failed or not self._context_alive(managed):
            raise ToolError("guarded launch lost its Wayland security context during outcome verification")
        if capture_source.get("scope") == "launch-scene":
            if crop is not None:
                raise ToolError("launch-scene outcome unexpectedly resolved to a bounded capture")
            authority = self._assert_launch_scene_authority(
                managed, capture_source.get("launch_scene_authority_sha256")
            )
            for key in (
                "launch_id_sha256", "workspace_sha256", "output_authority_sha256",
                "visible_scene_sha256", "active_window_identity_sha256",
                "visible_window_count",
            ):
                if capture_source.get(key) != authority.get(key):
                    raise ToolError("launch-scene outcome source authority changed during verification")
            return
        if crop is None:
            raise ToolError("launch-scoped outcome did not resolve to a bounded capture")
        left, top = int(crop["x"]), int(crop["y"])
        right = left + int(crop["width"]) - 1
        bottom = top + int(crop["height"]) - 1
        if not any(
            self._point_in_window(window, left, top)
            and self._point_in_window(window, right, bottom)
            for window in self._scoped_windows(managed)
        ):
            raise ToolError("outcome capture is not contained by the guarded launch")
        self._require_isolated_launch_capture(managed, crop)

    @classmethod
    def _outcome_selector_matches(
        cls,
        snapshot: dict[str, Any],
        selector: dict[str, Any],
    ) -> list[dict[str, Any]]:
        nodes_value = snapshot.get("nodes", [])
        nodes = nodes_value if isinstance(nodes_value, list) else []
        by_id = {
            str(node.get("node_id")): node
            for node in nodes
            if isinstance(node, dict) and isinstance(node.get("node_id"), str)
        }
        matches = [
            node for node in nodes
            if isinstance(node, dict)
            and AccessibilityBridge._selector_matches(node, selector, by_id)
        ]
        occurrence = selector.get("occurrence")
        if occurrence is not None:
            matches = matches[int(occurrence):int(occurrence) + 1]
        return matches[:MAX_SELECTOR_RESULTS]

    @classmethod
    def _outcome_match_digest(cls, matches: list[dict[str, Any]]) -> str:
        projection = []
        for node in matches:
            projection.append({
                key: value
                for key, value in node.items()
                if key not in {"id", "node_id", "parent_id"}
            })
        return cls._authority_digest(projection)

    def _capture_outcome_probe(
        self,
        observation: Observation,
        managed: ManagedProcess | None,
        policy: dict[str, Any],
    ) -> dict[str, Any]:
        capture_arguments = self._outcome_capture_arguments(observation, managed, policy)
        scene_members = (
            self._managed_scene(
                observation.scene_id,
                expected_launch_ids=observation.scene_launch_ids,
            )
            if observation.scene_id is not None else []
        )
        accessibility_policy = policy.get("accessibility")
        semantic: dict[str, Any] | None = None
        semantic_sha256: str | None = None
        if isinstance(accessibility_policy, dict):
            semantic_options = {
                key: accessibility_policy[key]
                for key in ("max_nodes", "max_depth", "text_limit", "timeout_milliseconds")
            }
            if scene_members:
                semantic_options["process_ids"] = self._semantic_process_ids_for_scene(scene_members)
            elif managed is not None:
                semantic_options["process_ids"] = self._semantic_process_ids(managed)
            (
                image, crop, window_id, active_signature, window_signature,
                semantic, semantic_sha256, _semantic_node_ids, pair_difference,
                capture_source, _scene_transient_map, _scene_occlusion_map,
            ) = self._capture_semantic_pair(capture_arguments, semantic_options)
        else:
            before_active, before_windows = self._active_and_window_signatures()
            frame = self._capture_region(capture_arguments)
            image = frame.image
            crop = frame.crop
            window_id = frame.window_id
            capture_source = self._capture_source_from_frame(frame)
            active_signature, window_signature = self._active_and_window_signatures()
            if before_active != active_signature or before_windows != window_signature:
                raise ToolError("desktop topology changed while capturing an outcome probe")
            pair_difference = 0.0
        self._validate_outcome_launch_capture(
            managed,
            crop,
            capture_source,
            observation,
        )
        matches: list[dict[str, Any]] = []
        if isinstance(accessibility_policy, dict):
            if semantic is None:
                raise ToolError("outcome accessibility snapshot is absent")
            matches = self._outcome_selector_matches(
                semantic,
                accessibility_policy["selector"],
            )
        sample = self._visual_sample(image)
        probe = {
            "captured_monotonic": time.monotonic(),
            "scope": policy["scope"],
            "capture_arguments": capture_arguments,
            "crop": dict(crop) if crop is not None else None,
            "window_id": window_id,
            "capture_source": capture_source,
            "screen_sha256": self._image_fingerprint(image),
            "visual_sample": sample,
            "visual_sample_sha256": hashlib.sha256(sample).hexdigest(),
            "width": image.width,
            "height": image.height,
            "active_signature": active_signature,
            "window_signature": window_signature,
            "semantic_sha256": semantic_sha256,
            "selector_match_count": len(matches),
            "selector_match_sha256": self._outcome_match_digest(matches),
            "pair_difference": pair_difference,
        }
        probe["probe_sha256"] = self._authority_digest({
            key: value
            for key, value in probe.items()
            if key not in {"captured_monotonic", "visual_sample", "probe_sha256"}
        })
        return probe

    @classmethod
    def _evaluate_outcome_probe(
        cls,
        observation: Observation,
        policy: dict[str, Any],
        probe: dict[str, Any],
    ) -> tuple[bool, dict[str, Any]]:
        difference = cls._visual_difference(observation.visual_sample, probe["visual_sample"])
        screen_same = (
            probe["screen_sha256"] == observation.screen_sha256
            or difference <= policy["difference_threshold"]
        )
        active_same = probe["active_signature"] == observation.active_signature
        scene_same = probe["window_signature"] == observation.window_signature
        accessibility_policy = policy.get("accessibility")
        accessibility_matched = True
        accessibility_condition = None
        if isinstance(accessibility_policy, dict):
            accessibility_condition = accessibility_policy["condition"]
            count = int(probe["selector_match_count"])
            accessibility_matched = (
                (accessibility_condition == "present" and count > 0)
                or (accessibility_condition == "absent" and count == 0)
                or (accessibility_condition == "unique" and count == 1)
            )
        tests = {
            "screen": (
                True if policy["screen"] == "any"
                else screen_same if policy["screen"] == "same"
                else not screen_same
            ),
            "active_window": (
                True if policy["active_window"] == "any"
                else active_same if policy["active_window"] == "same"
                else not active_same
            ),
            "window_scene": (
                True if policy["window_scene"] == "any"
                else scene_same if policy["window_scene"] == "same"
                else not scene_same
            ),
            "accessibility": accessibility_matched,
        }
        return all(tests.values()), {
            "tests": tests,
            "screen_difference_from_reviewed": difference,
            "screen_same_as_reviewed": screen_same,
            "active_window_same_as_reviewed": active_same,
            "window_scene_same_as_reviewed": scene_same,
            "accessibility_condition": accessibility_condition,
            "selector_match_count": int(probe["selector_match_count"]),
        }

    @classmethod
    def _outcome_probes_quiescent(
        cls,
        left: dict[str, Any],
        right: dict[str, Any],
        difference_threshold: float,
    ) -> tuple[bool, float]:
        difference = cls._visual_difference(left["visual_sample"], right["visual_sample"])
        stable = (
            left["crop"] == right["crop"]
            and left["window_id"] == right["window_id"]
            and left["capture_source"] == right["capture_source"]
            and left["active_signature"] == right["active_signature"]
            and left["window_signature"] == right["window_signature"]
            and left["width"] == right["width"]
            and left["height"] == right["height"]
            and (
                left["screen_sha256"] == right["screen_sha256"]
                or difference <= difference_threshold
            )
            and left["semantic_sha256"] == right["semantic_sha256"]
            and left["selector_match_count"] == right["selector_match_count"]
            and left["selector_match_sha256"] == right["selector_match_sha256"]
        )
        return stable, difference

    @classmethod
    def _public_outcome_probe(cls, probe: dict[str, Any]) -> dict[str, Any]:
        return {
            "scope": probe["scope"],
            "crop": probe["crop"],
            "window_id": probe["window_id"],
            "capture_source_sha256": cls._authority_digest(probe["capture_source"]),
            "width": probe["width"],
            "height": probe["height"],
            "screen_sha256": probe["screen_sha256"],
            "active_signature": probe["active_signature"],
            "window_signature": probe["window_signature"],
            "semantic_sha256": probe["semantic_sha256"],
            "selector_match_count": probe["selector_match_count"],
            "selector_match_sha256": probe["selector_match_sha256"],
            "pair_difference": probe["pair_difference"],
            "probe_sha256": probe["probe_sha256"],
        }

    def _wait_for_outcome(
        self,
        observation: Observation,
        managed: ManagedProcess | None,
        policy: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any] | None]:
        started = time.monotonic()
        deadline = started + policy["timeout_milliseconds"] / 1000
        polls = 0
        transient_failures = 0
        stable_since: float | None = None
        stable_probe: dict[str, Any] | None = None
        last_probe: dict[str, Any] | None = None
        last_evaluation: dict[str, Any] | None = None
        last_quiescence_difference: float | None = None
        chain = "0" * 64
        matched = False
        maximum_polls = min(
            OUTCOME_MAX_POLLS,
            max(1, 2 + policy["timeout_milliseconds"] // policy["poll_milliseconds"]),
        )
        while polls < maximum_polls:
            polls += 1
            now = time.monotonic()
            try:
                probe = self._capture_outcome_probe(observation, managed, policy)
            except ToolError:
                transient_failures += 1
                stable_since = None
                stable_probe = None
                probe = None
            if probe is not None:
                last_probe = probe
                public_probe = self._public_outcome_probe(probe)
                chain = hashlib.sha256(
                    chain.encode("ascii") + canonical_json(public_probe)
                ).hexdigest()
                conditions_match, evaluation = self._evaluate_outcome_probe(
                    observation, policy, probe
                )
                last_evaluation = evaluation
                now = time.monotonic()
                if conditions_match:
                    if stable_probe is None:
                        stable_probe = probe
                        stable_since = now
                        last_quiescence_difference = 0.0
                    else:
                        quiescent, last_quiescence_difference = self._outcome_probes_quiescent(
                            stable_probe,
                            probe,
                            policy["difference_threshold"],
                        )
                        if not quiescent:
                            stable_probe = probe
                            stable_since = now
                    if (
                        stable_since is not None
                        and (now - stable_since) * 1000 >= policy["stable_milliseconds"]
                    ):
                        matched = True
                        stable_probe = probe
                        break
                else:
                    stable_since = None
                    stable_probe = None
            now = time.monotonic()
            if now >= deadline:
                break
            time.sleep(min(
                policy["poll_milliseconds"] / 1000,
                max(0.0, deadline - now),
            ))
        elapsed_ms = round((time.monotonic() - started) * 1000)
        stable_for_ms = (
            round((time.monotonic() - stable_since) * 1000)
            if stable_since is not None else 0
        )
        accessibility_policy = policy.get("accessibility")
        seal = {
            "schema": OUTCOME_SEAL_SCHEMA,
            "enforced": True,
            "matched": matched,
            "required": policy["required"],
            "timed_out": not matched,
            "scope": policy["scope"],
            "conditions": {
                "screen": policy["screen"],
                "active_window": policy["active_window"],
                "window_scene": policy["window_scene"],
                "accessibility": (
                    accessibility_policy["condition"]
                    if isinstance(accessibility_policy, dict) else None
                ),
            },
            "selector_sha256": (
                self._authority_digest(accessibility_policy["selector"])
                if isinstance(accessibility_policy, dict) else None
            ),
            "timeout_milliseconds": policy["timeout_milliseconds"],
            "poll_milliseconds": policy["poll_milliseconds"],
            "stable_milliseconds": policy["stable_milliseconds"],
            "difference_threshold": policy["difference_threshold"],
            "elapsed_milliseconds": elapsed_ms,
            "polls": polls,
            "transient_probe_failures": transient_failures,
            "stable_for_milliseconds": stable_for_ms,
            "last_quiescence_difference": last_quiescence_difference,
            "last_evaluation": last_evaluation,
            "last_probe": (
                self._public_outcome_probe(last_probe) if last_probe is not None else None
            ),
            "probe_chain_sha256": chain,
        }
        seal["seal_sha256"] = hashlib.sha256(canonical_json(seal)).hexdigest()
        return seal, stable_probe if matched else None

    @staticmethod
    def _preserve_launch_scene_capture(
        observation: Observation,
        arguments: dict[str, Any],
    ) -> dict[str, Any]:
        """Keep explicit full-output authority sticky across post-action capture.

        A menu click may replace focus, create a dialog, or close the parent
        top-level. Falling back to the default window capture at that boundary
        would discard the very popup/subsurface pixels that launch-scene mode
        was selected to control. Re-mint the complete private-output authority
        instead; observe() will fail closed if the new scene is contaminated.
        Multi-launch SceneSetSeal likewise retains the complete exact member set
        so a focus transition cannot collapse authority to one application.
        """
        uses_launch_scene = DesktopController._observation_uses_launch_scene(observation)
        uses_scene_set = DesktopController._observation_uses_scene_set(observation)
        if not uses_launch_scene and not uses_scene_set:
            return arguments
        preserved = dict(arguments)
        preserved.pop("window_id", None)
        preserved.pop("crop", None)
        if uses_launch_scene:
            if not isinstance(observation.launch_id, str) or not observation.launch_id:
                raise ToolError("launch-scene observation lost its launch identity")
            preserved["capture_mode"] = "launch-scene"
            preserved["launch_id"] = observation.launch_id
        else:
            if (
                not isinstance(observation.scene_id, str)
                or not observation.scene_id
                or not 2 <= len(observation.scene_launch_ids) <= SCENE_SET_MAX_LAUNCHES
            ):
                raise ToolError("scene-set observation lost its exact scene identity")
            preserved.pop("launch_id", None)
            preserved["capture_mode"] = "scene-set"
            preserved["scene_id"] = observation.scene_id
            preserved["scene_launch_ids"] = list(observation.scene_launch_ids)
            if observation.capture_arguments.get("include_transient_attribution") is True:
                preserved["include_transient_attribution"] = True
            elif observation.capture_arguments.get("include_occlusion_attribution") is True:
                preserved["include_occlusion_attribution"] = True
        return preserved

    @classmethod
    def _fresh_matches_outcome_anchor(
        cls,
        fresh: Observation,
        anchor: dict[str, Any],
        policy: dict[str, Any],
        accessibility_snapshot: dict[str, Any] | None,
    ) -> tuple[bool, dict[str, Any]]:
        difference = cls._visual_difference(fresh.visual_sample, anchor["visual_sample"])
        selector_count = 0
        selector_digest = cls._outcome_match_digest([])
        accessibility_policy = policy.get("accessibility")
        if isinstance(accessibility_policy, dict):
            if not isinstance(accessibility_snapshot, dict):
                return False, {"reason": "fresh accessibility snapshot is absent"}
            matches = cls._outcome_selector_matches(
                accessibility_snapshot,
                accessibility_policy["selector"],
            )
            selector_count = len(matches)
            selector_digest = cls._outcome_match_digest(matches)
        checks = {
            "capture_crop": fresh.capture_crop == anchor["crop"],
            "capture_window": fresh.capture_window_id == anchor["window_id"],
            "capture_source": fresh.capture_source == anchor["capture_source"],
            "active_window": fresh.active_signature == anchor["active_signature"],
            "window_scene": fresh.window_signature == anchor["window_signature"],
            "screen": (
                fresh.screen_sha256 == anchor["screen_sha256"]
                or difference <= policy["difference_threshold"]
            ),
            "semantic_scene": fresh.semantic_sha256 == anchor["semantic_sha256"],
            "selector_count": selector_count == anchor["selector_match_count"],
            "selector_projection": selector_digest == anchor["selector_match_sha256"],
        }
        return all(checks.values()), {
            "checks": checks,
            "difference": difference,
            "selector_match_count": selector_count,
        }

    @staticmethod
    def _pointer_activation_target(action_name: str, arguments: dict[str, Any]) -> tuple[int, int] | None:
        if action_name in {
            "desktop_click", "desktop_touch", "desktop_touchpad_swipe",
            "desktop_touchpad_pinch", "desktop_touchpad_hold", "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
            "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
            "desktop_relative_motion", "desktop_scroll", "desktop_drop",
        }:
            return int(arguments["x"]), int(arguments["y"])
        if (
            action_name == "desktop_paste"
            and arguments.get("delivery") == "primary-middle-click"
        ):
            return int(arguments["x"]), int(arguments["y"])
        if action_name in {
            "desktop_drag", "desktop_touch_swipe", "desktop_stylus_hover", "desktop_stylus_stroke",
            "desktop_eraser_stroke",
        }:
            return int(arguments["start_x"]), int(arguments["start_y"])
        if action_name == "desktop_touch_gesture":
            return int(arguments["first_start_x"]), int(arguments["first_start_y"])
        return None

    def _latch_pointer_activation(
        self,
        observation: Observation,
        action_name: str,
        action_arguments: dict[str, Any],
        pointer_route: dict[str, Any],
        baseline_image: Image.Image,
        baseline_crop: dict[str, int] | None,
        active_signature: str,
        window_signature: str,
        difference_threshold: float,
        target_difference_threshold: float,
        settle_milliseconds: int,
    ) -> dict[str, Any] | None:
        """Prepare one pointer-routed action without widening its input authority.

        Ordinary activation uses MotionSeal to bind source cursor bits, source
        and destination recipients, one destroy-watched virtual pointer, and the
        exact destination before Sway emits relative motion, seatop motion, and
        one pointer frame in the same IPC callback. LockedPointerSeal is the
        deliberate exception: an active locked-pointer constraint is itself the
        authority being preserved, so desktop_relative_motion performs no hover
        motion and instead stabilizes the reviewed scene around an unchanged
        compositor cursor. Both paths reject overlays or hostile replacements
        before the action-specific compositor ticket is armed.
        """
        target = self._pointer_activation_target(action_name, action_arguments)
        if target is None:
            return None
        x, y = target
        audit_arguments = {
            "action": action_name,
            "target": [x, y],
            "settle_milliseconds": settle_milliseconds,
            "difference_threshold": difference_threshold,
            "target_difference_threshold": target_difference_threshold,
        }
        try:
            observed_target = self._observation_target_sample(observation, x, y)
            baseline_target = self._image_target_sample(baseline_image, baseline_crop, x, y)
            prehover_target_difference = self._visual_difference(observed_target, baseline_target)
            if prehover_target_difference > target_difference_threshold:
                raise ToolError(
                    "pointer target changed locally since observation "
                    f"(local visual difference {prehover_target_difference:.6f})"
                )
            previous_pointer = dict(self.pointer_position())
            points = pointer_route.get("points")
            if (
                not isinstance(points, list)
                or not points
                or not isinstance(points[0], dict)
                or points[0].get("point") != [x, y]
            ):
                raise ToolError("MotionSeal pointer latch lost its reviewed first route point")
            locked_relative_motion = action_name == "desktop_relative_motion"
            stabilization_label = (
                "locked-pointer no-input stabilization"
                if locked_relative_motion
                else "pointer hover"
            )
            if locked_relative_motion:
                # MotionSeal intentionally rejects active pointer constraints.
                # Do not try to move or hover a cursor that the reviewed client
                # has locked. The action-specific Sway callback will bind the
                # exact cursor bits, focused seat client, sole relative-pointer
                # object, and active locked constraint immediately before it
                # emits any client-visible event.
                motion_seal = {
                    "schema": RELATIVE_MOTION_DISPATCH_SEAL_SCHEMA,
                    "operation": "preserve-active-locked-pointer-before-relative-motion",
                    "input_emitted": False,
                    "cursor_motion_emitted": False,
                    "pointer_frame_emitted": False,
                    "active_locked_constraint_required": True,
                    "ordinary_motion_seal_bypassed": True,
                    "bypass_reason": "ordinary-motion-seal-denies-active-pointer-constraints",
                }
                motion_transaction_evidence = {
                    "opened": False,
                    "input_emitted": False,
                    "reason": "active-locked-pointer-preserved",
                }
            else:
                with WaylandPointerTransaction(
                    self, "desktop_hover-motion-seal"
                ) as motion_transaction:
                    motion_seal = self._dispatch_compositor_guarded_motion(
                        pointer_route, 0, x, y
                    )
                motion_transaction_evidence = motion_transaction.evidence()
            time.sleep(settle_milliseconds / 1000)
            semantic_sha256: str | None = None
            pair_difference: float
            if observation.semantic_sha256 is not None:
                if observation.semantic_options is None:
                    raise ToolError("pointer latch lost its accessibility observation options")
                semantic_pair = self._capture_semantic_pair(
                    observation.capture_arguments,
                    dict(observation.semantic_options),
                    POINTER_LATCH_FRAME_GAP_MILLISECONDS,
                )
                (
                    hovered_image, hovered_crop, hovered_window,
                    hovered_active, hovered_windows, _semantic,
                    semantic_sha256, _node_ids, pair_difference, hovered_capture_source,
                    _hovered_transient_map, _hovered_occlusion_map,
                ) = semantic_pair
                if pair_difference > difference_threshold:
                    raise ToolError(
                        f"desktop did not stabilize after {stabilization_label} "
                        f"(visual difference {pair_difference:.6f})"
                    )
                if semantic_sha256 != observation.semantic_sha256:
                    raise ToolError(
                        f"{stabilization_label} changed the accessibility target scene; "
                        "use desktop_move, observe the hovered scene, then activate it"
                    )
            else:
                pixel_pair = self._capture_pixel_pair(
                    observation.capture_arguments,
                    difference_threshold,
                )
                (
                    hovered_image, hovered_crop, hovered_window,
                    hovered_active, hovered_windows, pair_difference, hovered_capture_source,
                    _hovered_transient_map, _hovered_occlusion_map,
                ) = pixel_pair
            if hovered_crop != observation.capture_crop or hovered_window != observation.capture_window_id:
                raise ToolError(f"{stabilization_label} changed the guarded capture envelope")
            if observation.capture_source != hovered_capture_source:
                raise ToolError(
                    f"{stabilization_label} changed the guarded capture source identity"
                )
            if hovered_active != active_signature or hovered_windows != window_signature:
                raise ToolError(
                    f"{stabilization_label} changed desktop window or focus state; "
                    "use desktop_move, observe the hovered scene, then activate it"
                )
            scene_difference = self._visual_difference(
                self._visual_sample(baseline_image), self._visual_sample(hovered_image)
            )
            target_difference = self._visual_difference(
                observed_target,
                self._image_target_sample(hovered_image, hovered_crop, x, y),
            )
            if (
                self._image_fingerprint(baseline_image) != self._image_fingerprint(hovered_image)
                and scene_difference > difference_threshold
            ):
                raise ToolError(
                    f"{stabilization_label} changed the guarded desktop scene "
                    f"(visual difference {scene_difference:.6f}); "
                    "use desktop_move, observe the hovered scene, then activate it"
                )
            if target_difference > target_difference_threshold:
                raise ToolError(
                    f"{stabilization_label} changed the guarded target envelope "
                    f"(local visual difference {target_difference:.6f}); "
                    "use desktop_move, observe the hovered scene, then activate it"
                )
            current_pointer = dict(self.pointer_position())
            if locked_relative_motion and current_pointer != previous_pointer:
                raise ToolError(
                    "locked-pointer compositor cursor changed during no-input stabilization"
                )
            result = {
                "latched": True,
                "latch_kind": (
                    "locked-pointer-no-input-stabilization"
                    if locked_relative_motion
                    else "motion-seal-hover-stabilization"
                ),
                "target": [x, y],
                "pointer_before": {
                    "x": int(previous_pointer.get("x", 0)),
                    "y": int(previous_pointer.get("y", 0)),
                },
                "pointer_after": {
                    "x": int(current_pointer.get("x", 0)),
                    "y": int(current_pointer.get("y", 0)),
                },
                "settle_milliseconds": settle_milliseconds,
                "stability_frame_gap_milliseconds": POINTER_LATCH_FRAME_GAP_MILLISECONDS,
                "scene_difference": scene_difference,
                "prehover_target_difference": prehover_target_difference,
                "target_difference": target_difference,
                "pair_difference": pair_difference,
                "semantic_scene_revalidated": semantic_sha256 is not None,
                "motion_seal": motion_seal,
                "motion_transaction": motion_transaction_evidence,
                "motion_dispatch_scope": (
                    "none-active-locked-pointer-preserved"
                    if locked_relative_motion
                    else "pre-activation-hover-only"
                ),
                "input_emitted_during_latch": not locked_relative_motion,
                "locked_pointer_preserved_without_hover_motion": locked_relative_motion,
                "held_drag_segments_motion_sealed": True,
            }
            self.journal.append("pointer-latch", action_name, audit_arguments, result)
            return result
        except Exception as error:
            self.journal.append("pointer-latch", action_name, audit_arguments, error=str(error))
            raise

    @staticmethod
    def _remap_semantic_node(
        observation: Observation,
        current_node_ids: tuple[str, ...],
        action_name: str,
        arguments: dict[str, Any],
    ) -> dict[str, Any]:
        direct = {
            "desktop_accessibility_action", "desktop_accessibility_focus",
            "desktop_accessibility_text", "desktop_accessibility_value",
            "desktop_accessibility_scroll", "desktop_accessibility_selection",
        }
        remapped = dict(arguments)
        if action_name not in direct:
            return remapped
        old_id = as_string(remapped.get("node_id"), "node_id", maximum=128, allow_empty=False)
        try:
            index = observation.semantic_node_ids.index(old_id)
            remapped["node_id"] = current_node_ids[index]
        except (ValueError, IndexError) as error:
            raise ToolError("semantic node is absent from the guarded observation") from error
        return remapped

    def _semantic_process_ids(self, managed: ManagedProcess) -> list[int]:
        """Return exact semantic principals for one launch.

        AT-SPI's process id is obtained from the accessible application's D-Bus
        connection. A client connected through xdg-dbus-proxy is therefore
        represented on the source bus by that launch's exact proxy process,
        not necessarily by the nested application PID. Include both identities:
        app custody remains useful for direct/private-bus toolkits, while the
        birth-pinned per-launch proxy is the strong filtered-bus principal.
        """
        self._refresh_managed(managed)
        process_ids = set(managed.members)
        context = managed.security_context
        if context is not None and exact_process_alive(context.atspi_process.pid, context.atspi_start_ticks):
            process_ids.add(context.atspi_process.pid)
        return sorted(process_ids)

    def _semantic_process_ids_for_scene(
        self,
        members: list[ManagedProcess],
    ) -> list[int]:
        if not 2 <= len(members) <= SCENE_SET_MAX_LAUNCHES:
            raise ToolError("scene-set accessibility scope has an invalid member count")
        process_ids: set[int] = set()
        for managed in members:
            process_ids.update(self._semantic_process_ids(managed))
        if not process_ids:
            raise ToolError("scene-set accessibility scope has no live semantic principals")
        return sorted(process_ids)

    def _observation_region(self, observation: Observation) -> dict[str, int]:
        if observation.capture_crop is None:
            return {"x": 0, "y": 0, "width": self.width, "height": self.height}
        return dict(observation.capture_crop)

    @staticmethod
    def _point_in_rectangle(rectangle: dict[str, Any], x: int, y: int) -> bool:
        left = int(rectangle.get("x", 0))
        top = int(rectangle.get("y", 0))
        width = max(0, int(rectangle.get("width", 0)))
        height = max(0, int(rectangle.get("height", 0)))
        return width > 0 and height > 0 and left <= x < left + width and top <= y < top + height

    @staticmethod
    def _rectangle_inside(outer: dict[str, Any], inner: dict[str, Any]) -> bool:
        ox = int(outer.get("x", 0))
        oy = int(outer.get("y", 0))
        ow = max(0, int(outer.get("width", 0)))
        oh = max(0, int(outer.get("height", 0)))
        ix = int(inner.get("x", 0))
        iy = int(inner.get("y", 0))
        iw = max(0, int(inner.get("width", 0)))
        ih = max(0, int(inner.get("height", 0)))
        return ow > 0 and oh > 0 and iw > 0 and ih > 0 and ox <= ix and oy <= iy and ix + iw <= ox + ow and iy + ih <= oy + oh

    def _visible_window_rectangle(self, window: dict[str, Any]) -> dict[str, int] | None:
        left = max(0, int(window.get("x", 0)))
        top = max(0, int(window.get("y", 0)))
        right = min(self.width, int(window.get("x", 0)) + max(0, int(window.get("width", 0))))
        bottom = min(self.height, int(window.get("y", 0)) + max(0, int(window.get("height", 0))))
        if right <= left or bottom <= top:
            return None
        return {"x": left, "y": top, "width": right - left, "height": bottom - top}

    @staticmethod
    def _scene_window(windows: list[dict[str, Any]], value: Any) -> dict[str, Any]:
        identifier = parse_window_id(value)
        window = next((item for item in windows if item.get("id") == identifier), None)
        if window is None:
            raise ToolError("target window was not visible in the guarded observation")
        return window

    @staticmethod
    def _semantic_node_from_snapshot(snapshot: dict[str, Any], value: Any) -> dict[str, Any]:
        node_id = as_string(value, "node_id", maximum=128, allow_empty=False)
        nodes = snapshot.get("nodes", [])
        if not isinstance(nodes, list):
            raise ToolError("guarded accessibility snapshot is invalid")
        node = next(
            (
                item for item in nodes
                if isinstance(item, dict) and str(item.get("node_id") or item.get("id")) == node_id
            ),
            None,
        )
        if node is None:
            raise ToolError("semantic node is absent from the guarded accessibility scene")
        return node

    @staticmethod
    def _step_difference_threshold(value: Any) -> float:
        # A caller may demand stricter equality, but cannot widen the release's
        # reviewed observe-to-act tolerance after seeing an untrusted page/app.
        return as_number(value, 0.0, SEMANTIC_PAIR_THRESHOLD, "difference_threshold")

    def _validate_rich_paste_spec(self, arguments: dict[str, Any]) -> dict[str, Any]:
        allowed = {
            "kind", "text", "source_path", "source_paths", "paste_chord",
            "delivery", "x", "y",
        }
        unexpected = sorted(set(arguments) - allowed)
        if unexpected:
            raise ToolError(f"desktop_paste received unsupported fields: {', '.join(unexpected)}")
        scoped = dict(arguments)
        kind = scoped.get("kind")
        if kind not in {"text", "png", "files", "directory"}:
            raise ToolError("kind must be text, png, files, or directory")
        scoped["kind"] = kind
        delivery = scoped.get("delivery", "clipboard-chord")
        if delivery not in {"clipboard-chord", "primary-middle-click"}:
            raise ToolError("delivery must be clipboard-chord or primary-middle-click")
        scoped["delivery"] = delivery
        x_supplied = "x" in scoped and scoped.get("x") is not None
        y_supplied = "y" in scoped and scoped.get("y") is not None
        if x_supplied != y_supplied:
            raise ToolError("x and y must be supplied together")
        if delivery == "primary-middle-click":
            if kind != "text":
                raise ToolError("PRIMARY middle-click paste accepts UTF-8 text only")
            if not x_supplied:
                raise ToolError("PRIMARY middle-click paste requires exact x and y target coordinates")
            if "paste_chord" in scoped and scoped.get("paste_chord") is not None:
                raise ToolError("PRIMARY middle-click paste does not accept paste_chord")
            scoped["x"] = as_int(scoped.get("x"), 0, self.width - 1, "x")
            scoped["y"] = as_int(scoped.get("y"), 0, self.height - 1, "y")
            scoped.pop("paste_chord", None)
        else:
            if x_supplied:
                raise ToolError("clipboard-chord paste does not accept pointer coordinates")
            scoped["paste_chord"] = self._normalize_paste_chord(
                scoped.get("paste_chord", "CTRL+V")
            )
            scoped.pop("x", None)
            scoped.pop("y", None)
        if kind == "text":
            if scoped.get("source_path") is not None or scoped.get("source_paths") is not None:
                raise ToolError("text rich paste cannot also name source files")
            text = as_string(scoped.get("text"), "text")
            if len(text.encode("utf-8")) > MAX_TEXT_BYTES:
                raise ToolError("rich paste text exceeds the UTF-8 payload limit")
            scoped["text"] = text
            scoped.pop("source_path", None)
            scoped.pop("source_paths", None)
        elif kind == "png":
            if scoped.get("text") is not None or scoped.get("source_paths") is not None:
                raise ToolError("PNG rich paste cannot also contain text or source_paths")
            scoped["source_path"] = self._canonical_project_relative_path(
                scoped.get("source_path"), "source_path"
            )
            scoped.pop("text", None)
            scoped.pop("source_paths", None)
        elif kind == "files":
            if scoped.get("text") is not None or scoped.get("source_path") is not None:
                raise ToolError("files paste cannot also contain text or source_path")
            source_paths = scoped.get("source_paths")
            if (
                not isinstance(source_paths, list)
                or not 1 <= len(source_paths) <= MAX_FILE_DROP_FILES
            ):
                raise ToolError(
                    f"source_paths must contain from 1 through {MAX_FILE_DROP_FILES} project files"
                )
            normalized = [
                self._canonical_project_relative_path(value, f"source_paths[{index}]")
                for index, value in enumerate(source_paths)
            ]
            if len(set(normalized)) != len(normalized):
                raise ToolError("source_paths contains a duplicate project file")
            scoped["source_paths"] = normalized
            scoped.pop("text", None)
            scoped.pop("source_path", None)
        else:
            if scoped.get("text") is not None or scoped.get("source_paths") is not None:
                raise ToolError(
                    "directory paste cannot also contain text or source_paths"
                )
            relative = self._canonical_project_relative_path(
                scoped.get("source_path"), "source_path"
            )
            parts = tuple(
                self._directory_copy_name(
                    part, f"source_path component {index}"
                )
                for index, part in enumerate(Path(relative).parts, start=1)
            )
            if (
                len(b"/".join(os.fsencode(part) for part in parts))
                > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES
            ):
                raise ToolError("directory paste source_path exceeds its byte ceiling")
            scoped["source_path"] = relative
            scoped.pop("text", None)
            scoped.pop("source_paths", None)
        return scoped

    def _validate_drop_spec(self, arguments: dict[str, Any]) -> dict[str, Any]:
        """Normalize one sealed drag payload without importing paste semantics."""
        if "paste_chord" in arguments:
            raise ToolError("desktop_drop does not accept a paste_chord")
        allowed = {
            "kind", "text", "source_path", "source_paths", "x", "y", "duration",
            "waypoints", "timeout_milliseconds",
        }
        unexpected = sorted(set(arguments) - allowed)
        if unexpected:
            raise ToolError(f"desktop_drop received unsupported fields: {', '.join(unexpected)}")
        kind = arguments.get("kind")
        if kind not in {"text", "png", "files", "directory"}:
            raise ToolError("kind must be text, png, files, or directory")
        if kind == "files":
            if arguments.get("text") is not None or arguments.get("source_path") is not None:
                raise ToolError("files drop cannot also contain text or source_path")
            source_paths = arguments.get("source_paths")
            if (
                not isinstance(source_paths, list)
                or not 1 <= len(source_paths) <= MAX_FILE_DROP_FILES
            ):
                raise ToolError(
                    f"source_paths must contain from 1 through {MAX_FILE_DROP_FILES} project files"
                )
            normalized = [
                self._canonical_project_relative_path(value, f"source_paths[{index}]")
                for index, value in enumerate(source_paths)
            ]
            if len(set(normalized)) != len(normalized):
                raise ToolError("source_paths contains a duplicate project file")
            scoped = dict(arguments)
            scoped["kind"] = "files"
            scoped["source_paths"] = normalized
            scoped.pop("text", None)
            scoped.pop("source_path", None)
        elif kind == "directory":
            if arguments.get("text") is not None or arguments.get("source_paths") is not None:
                raise ToolError(
                    "directory drop cannot also contain text or source_paths"
                )
            relative = self._canonical_project_relative_path(
                arguments.get("source_path"), "source_path"
            )
            parts = tuple(
                self._directory_copy_name(
                    part, f"source_path component {index}"
                )
                for index, part in enumerate(Path(relative).parts, start=1)
            )
            if (
                len(b"/".join(os.fsencode(part) for part in parts))
                > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES
            ):
                raise ToolError("directory drop source_path exceeds its byte ceiling")
            scoped = dict(arguments)
            scoped["kind"] = "directory"
            scoped["source_path"] = relative
            scoped.pop("text", None)
            scoped.pop("source_paths", None)
        else:
            if arguments.get("source_paths") is not None:
                raise ToolError(f"{kind} drop cannot also contain source_paths")
            payload_arguments = {
                key: value
                for key, value in arguments.items()
                if key in {"kind", "text", "source_path"}
            }
            validated_payload = self._validate_rich_paste_spec(payload_arguments)
            validated_payload.pop("paste_chord", None)
            validated_payload.pop("delivery", None)
            validated_payload.pop("source_paths", None)
            scoped = dict(arguments)
            scoped.update(validated_payload)
        scoped["x"] = as_int(scoped.get("x"), 0, self.width - 1, "x")
        scoped["y"] = as_int(scoped.get("y"), 0, self.height - 1, "y")
        scoped["duration"] = as_number(scoped.get("duration", 0.5), 0.0, 10.0, "duration")
        scoped["timeout_milliseconds"] = as_int(
            scoped.get("timeout_milliseconds", DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS),
            100,
            10000,
            "timeout_milliseconds",
        )
        raw_waypoints = scoped.get("waypoints", [])
        if raw_waypoints is None:
            raw_waypoints = []
        if not isinstance(raw_waypoints, list) or len(raw_waypoints) > POINTER_FENCE_MAX_DRAG_WAYPOINTS:
            raise ToolError(
                f"waypoints must be an array with at most {POINTER_FENCE_MAX_DRAG_WAYPOINTS} coordinate objects"
            )
        waypoints: list[dict[str, int]] = []
        for index, raw in enumerate(raw_waypoints):
            if not isinstance(raw, dict) or set(raw) != {"x", "y"}:
                raise ToolError(f"waypoints[{index}] must contain exactly integer x and y fields")
            waypoints.append({
                "x": as_int(raw.get("x"), 0, self.width - 1, f"waypoints[{index}].x"),
                "y": as_int(raw.get("y"), 0, self.height - 1, f"waypoints[{index}].y"),
            })
        scoped["waypoints"] = waypoints
        return scoped

    def _validate_observation_action(
        self,
        observation: Observation,
        action_name: str,
        arguments: dict[str, Any],
        windows: list[dict[str, Any]],
        active_window_id: int | None,
        current_semantic: dict[str, Any] | None,
        resolved_semantic_node: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        """Bind one mutation to the exact visual/semantic observation envelope."""
        scoped = dict(arguments)
        region = self._observation_region(observation)

        def require_point(x: int, y: int, label: str) -> None:
            if not self._point_in_rectangle(region, x, y):
                raise ToolError(f"{label} is outside the guarded observation region")

        def require_window(value: Any) -> dict[str, Any]:
            window = self._scene_window(windows, value)
            rectangle = self._visible_window_rectangle(window)
            if rectangle is None or not self._rectangle_inside(region, rectangle):
                raise ToolError("target window is not fully represented by the guarded observation")
            return window

        if action_name == "desktop_move":
            x = as_int(scoped.get("x"), 0, self.width - 1, "x")
            y = as_int(scoped.get("y"), 0, self.height - 1, "y")
            require_point(x, y, "pointer destination")
        elif action_name in {"desktop_click", "desktop_touch", "desktop_scroll", "desktop_drop"}:
            x_supplied = "x" in scoped and scoped.get("x") is not None
            y_supplied = "y" in scoped and scoped.get("y") is not None
            if x_supplied != y_supplied:
                raise ToolError("x and y must be supplied together")
            if action_name in {"desktop_touch", "desktop_drop"} and not x_supplied:
                raise ToolError(f"{action_name} requires exact x and y target coordinates")
            if x_supplied:
                x = as_int(scoped.get("x"), 0, self.width - 1, "x")
                y = as_int(scoped.get("y"), 0, self.height - 1, "y")
            else:
                x, y = observation.pointer
            target_label = {
                "desktop_click": "click",
                "desktop_touch": "native touch",
                "desktop_scroll": "scroll",
                "desktop_drop": "drop target",
            }[action_name]
            require_point(x, y, target_label)
            # Make pointer-relative actions deterministic and immune to another
            # stale token having moved the controller-tracked cursor meanwhile.
            scoped["x"], scoped["y"] = x, y
            if action_name == "desktop_drop":
                scoped = self._validate_drop_spec(scoped)
                if scoped.get("kind") in {"files", "directory"} and (
                    observation.launch_id is None
                    or observation.scene_id is not None
                    or observation.scene_launch_ids
                ):
                    raise ToolError(
                        "native file or directory DropSeal requires one exact launch-scoped observation; "
                        "workstation and scene-set destinations are intentionally denied"
                    )
                if observation.scene_id is not None:
                    self._assert_clipboard_scene_exclusive(
                        observation.scene_id,
                        observation.scene_launch_ids,
                    )
                elif observation.capture_crop is not None and observation.launch_id is None:
                    raise ToolError(
                        "unscoped DropSeal requires a whole-workstation observation"
                    )
                elif observation.launch_id is not None:
                    self._assert_clipboard_launch_exclusive(observation.launch_id)
            else:
                modifiers, _modifier_mask = WaylandKeyboardTransaction.normalize_modifiers(
                    scoped.get("modifiers")
                )
                if modifiers:
                    scoped["modifiers"] = list(modifiers)
                else:
                    scoped.pop("modifiers", None)
        elif action_name == "desktop_touchpad_pinch":
            parameters = self._touchpad_pinch_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native touchpad pinch focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_touchpad_hold":
            parameters = self._touchpad_hold_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native touchpad hold focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_tablet_pad_ring":
            parameters = self._tablet_pad_ring_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native tablet-pad ring focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_tablet_pad_strip":
            parameters = self._tablet_pad_strip_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native tablet-pad strip focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_tablet_pad_button":
            parameters = self._tablet_pad_button_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native tablet-pad button focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_tablet_pad_mode":
            parameters = self._tablet_pad_mode_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native tablet-pad mode focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_relative_motion":
            parameters = self._relative_motion_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "locked relative-motion focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_touchpad_swipe":
            parameters = self._touchpad_swipe_parameters(scoped)
            require_point(
                parameters["x"], parameters["y"], "native touchpad swipe focus point"
            )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_touch_swipe":
            points = self._touch_stroke_points(scoped)
            for index, (x, y) in enumerate(points):
                require_point(x, y, f"native touch swipe path point {index}")
            scoped.pop("modifiers", None)
        elif action_name == "desktop_stylus_hover":
            points = self._stylus_hover_points(scoped)
            for index, (x, y) in enumerate(points):
                require_point(x, y, f"native stylus-hover path point {index}")
        elif action_name == "desktop_stylus_stroke":
            points = self._stylus_stroke_points(scoped)
            for index, (x, y) in enumerate(points):
                require_point(x, y, f"native stylus-stroke path point {index}")
            scoped.pop("modifiers", None)
        elif action_name == "desktop_eraser_stroke":
            points = self._eraser_stroke_points(scoped)
            for index, (x, y) in enumerate(points):
                require_point(x, y, f"native eraser-stroke path point {index}")
            scoped.pop("modifiers", None)
        elif action_name == "desktop_touch_gesture":
            first_path, second_path = self._touch_gesture_paths(scoped)
            for index, (first, second) in enumerate(zip(first_path, second_path)):
                require_point(
                    first[0], first[1],
                    f"native touch gesture first-contact path point {index}",
                )
                require_point(
                    second[0], second[1],
                    f"native touch gesture second-contact path point {index}",
                )
            scoped.pop("modifiers", None)
        elif action_name == "desktop_drag":
            start_x = as_int(scoped.get("start_x"), 0, self.width - 1, "start_x")
            start_y = as_int(scoped.get("start_y"), 0, self.height - 1, "start_y")
            end_x = as_int(scoped.get("end_x"), 0, self.width - 1, "end_x")
            end_y = as_int(scoped.get("end_y"), 0, self.height - 1, "end_y")
            require_point(start_x, start_y, "drag start")
            require_point(end_x, end_y, "drag end")
            modifiers, _modifier_mask = WaylandKeyboardTransaction.normalize_modifiers(
                scoped.get("modifiers")
            )
            if modifiers:
                scoped["modifiers"] = list(modifiers)
            else:
                scoped.pop("modifiers", None)
        elif action_name in {"desktop_focus", "desktop_close"}:
            require_window(scoped.get("window_id"))
        elif action_name == "desktop_window_state":
            state = self._window_state_name(scoped.get("state"))
            scoped["state"] = state
            if state in {"floating", "tiled", "minimized", "restored"}:
                if not self._whole_workstation_observation(observation):
                    raise ToolError(
                        f"{state} requires a whole-workstation observation because the target "
                        "changes the visible layout or crosses the visible observation set"
                    )
                if state == "restored":
                    # A restored target is intentionally absent from visible
                    # pixels. Its one-time lease supplies the exact hidden
                    # container, inventory, and origin authority instead.
                    parse_window_id(scoped.get("window_id"))
                    as_string(
                        scoped.get("restore_token"),
                        "restore_token",
                        maximum=WINDOW_RESTORE_TOKEN_LENGTH,
                        allow_empty=False,
                    )
                else:
                    require_window(scoped.get("window_id"))
            else:
                require_window(scoped.get("window_id"))
        elif action_name == "desktop_move_resize":
            require_window(scoped.get("window_id"))
            destination = {
                "x": as_int(scoped.get("x"), 0, self.width - 1, "x"),
                "y": as_int(scoped.get("y"), 0, self.height - 1, "y"),
                "width": as_int(scoped.get("width"), 1, self.width, "width"),
                "height": as_int(scoped.get("height"), 1, self.height, "height"),
            }
            if not self._rectangle_inside(region, destination):
                raise ToolError("requested window geometry escapes the guarded observation region")
        elif action_name == "desktop_paste":
            if active_window_id is None:
                raise ToolError("guarded paste requires an observed active window")
            require_window(active_window_id)
            scoped = self._validate_rich_paste_spec(scoped)
            if scoped.get("delivery") == "primary-middle-click":
                require_point(int(scoped["x"]), int(scoped["y"]), "PRIMARY paste target")
            if scoped.get("kind") in {"files", "directory"} and (
                observation.scene_id is not None or observation.launch_id is None
            ):
                raise ToolError(
                    "file and directory paste require one exact launch-scoped observation; "
                    "workstation and scene-set destinations are intentionally denied"
                )
            if observation.scene_id is not None:
                self._assert_clipboard_scene_exclusive(
                    observation.scene_id,
                    observation.scene_launch_ids,
                )
            elif observation.capture_crop is not None and observation.launch_id is None:
                raise ToolError(
                    "unscoped RichPasteSeal requires a whole-workstation observation"
                )
            elif observation.launch_id is not None:
                self._assert_clipboard_launch_exclusive(observation.launch_id)
        elif action_name in {"desktop_type", "desktop_key"}:
            if active_window_id is None:
                raise ToolError("guarded text/key input requires an observed active window")
            require_window(active_window_id)
            if action_name == "desktop_type":
                text = as_string(scoped.get("text"), "text")
                interval = as_number(scoped.get("interval", 0.01), 0.0, 2.0, "interval")
                method = scoped.get("method", "auto")
                if method not in {"auto", "keys", "input-method", "clipboard"}:
                    raise ToolError("method must be auto, keys, input-method, or clipboard")
                key_budget_ok = (
                    len(text) <= MAX_SYNTHETIC_CHARACTERS
                    and max(0, len(text) - 1) * interval <= MAX_ACTION_SECONDS
                    and WaylandKeyboardTransaction.can_prepare_characters(text)
                )
                uses_clipboard = method == "clipboard" or (method == "auto" and not key_budget_ok)
                if uses_clipboard:
                    if observation.scene_id is not None:
                        self._assert_clipboard_scene_exclusive(
                            observation.scene_id,
                            observation.scene_launch_ids,
                        )
                    elif observation.capture_crop is not None and observation.launch_id is None:
                        raise ToolError(
                            "unscoped clipboard-backed typing requires a whole-workstation observation"
                        )
                    elif observation.launch_id is not None:
                        self._assert_clipboard_launch_exclusive(observation.launch_id)
        elif action_name == "desktop_copy":
            scoped = self._normalize_copy_spec(scoped)
            if scoped.get("source") == "launch-output":
                if observation.scene_id is not None or observation.launch_id is None:
                    raise ToolError(
                        "OutputSnapshotSeal requires one exact launch-scoped observation; "
                        "workstation and scene-set sources are intentionally denied"
                    )
                self._assert_file_copy_source_custody(
                    observation.launch_id,
                    "launch-output",
                )
            else:
                if active_window_id is None:
                    raise ToolError("guarded copy requires an observed active window")
                require_window(active_window_id)
                if scoped.get("kind") in {"files", "directory"} and (
                    observation.scene_id is not None or observation.launch_id is None
                ):
                    raise ToolError(
                        "FileCopySeal and DirectoryCopySeal require one exact launch-scoped observation; "
                        "workstation and scene-set sources are intentionally denied"
                    )
                if observation.scene_id is not None:
                    self._assert_clipboard_scene_exclusive(
                        observation.scene_id,
                        observation.scene_launch_ids,
                    )
                elif observation.launch_id is not None:
                    self._assert_clipboard_launch_exclusive(observation.launch_id)
                elif observation.capture_crop is not None:
                    raise ToolError(
                        "unscoped RichCopySeal requires a whole-workstation observation because "
                        "ext-data-control does not identify the selection source"
                    )
        elif action_name in {"desktop_clipboard", "desktop_launch"}:
            if observation.scene_id is not None:
                raise ToolError(f"{action_name} is not authorized by a multi-principal scene-set observation")
            if observation.capture_crop is not None:
                raise ToolError(f"{action_name} requires a whole-workstation observation")
        elif action_name == "desktop_terminate":
            if observation.launch_id is None and observation.capture_crop is not None:
                raise ToolError("unscoped termination requires a whole-workstation observation")

        if action_name.startswith("desktop_accessibility_"):
            if current_semantic is None:
                raise ToolError("semantic action is not bound to an accessibility observation")
            node = resolved_semantic_node or self._semantic_node_from_snapshot(current_semantic, scoped.get("node_id"))
            bounds = node.get("bounds")
            if not isinstance(bounds, dict) or not self._rectangle_inside(region, bounds):
                raise ToolError("semantic target is not fully represented by the guarded visual observation")
            states = {str(value).casefold() for value in node.get("states", [])}
            if "visible" not in states and "showing" not in states:
                raise ToolError("semantic target was not visibly present in the guarded observation")
            scroll_arguments: dict[str, Any] | None = None
            if action_name == "desktop_accessibility_scroll":
                scroll_arguments = scoped
            elif action_name == "desktop_accessibility_perform" and scoped.get("operation") == "scroll":
                nested = scoped.get("arguments", {})
                if not isinstance(nested, dict):
                    raise ToolError("arguments must be an object")
                scroll_arguments = nested
            if scroll_arguments is not None and ("x" in scroll_arguments or "y" in scroll_arguments):
                if "x" not in scroll_arguments or "y" not in scroll_arguments:
                    raise ToolError("x and y must be supplied together")
                x = as_int(scroll_arguments.get("x"), -100000, 100000, "x")
                y = as_int(scroll_arguments.get("y"), -100000, 100000, "y")
                require_point(x, y, "semantic scroll destination")
        return scoped

    def _scoped_windows(self, managed: ManagedProcess) -> list[dict[str, Any]]:
        if not self.is_wayland:
            raise ToolError("launch-scoped control requires the private Wayland backend")
        return [window for window in self._wayland_windows() if window.get("launch_id") == managed.launch_id]

    def _scene_scoped_windows(self, members: list[ManagedProcess]) -> list[dict[str, Any]]:
        if not self.is_wayland:
            raise ToolError("scene-scoped control requires the private Wayland backend")
        launch_ids = {managed.launch_id for managed in members}
        return [
            window
            for window in self._wayland_windows()
            if window.get("launch_id") in launch_ids
            and window.get("origin_verified") is True
        ]

    def _activate_launch_workspace(self, managed: ManagedProcess) -> list[dict[str, Any]]:
        """Acquire one compositor visibility lease for a guarded launch.

        Native Wayland windows and launch-private X11 windows exported through
        xwayland-satellite are assigned before process start using exact
        security-context metadata. This method also relocates already-attributed
        windows by immutable Sway container ID. The final tree must show only the
        requested launch on the active private workspace before pixels or input
        are exposed.
        """
        workspace = managed.workspace
        if not self.is_wayland or workspace is None:
            raise ToolError("launch has no private compositor workspace")
        self._refresh_managed(managed)
        if managed.context_failed or not self._context_alive(managed):
            raise ToolError("guarded launch lost its Wayland security context")

        windows = self._wayland_windows()
        owned = [window for window in windows if window.get("launch_id") == managed.launch_id]
        for window in owned:
            # A WindowStateSeal scratchpad member is intentionally hidden. A
            # later scoped observe must not silently turn minimize into restore
            # while reacquiring the launch workspace.
            if window.get("scratchpad_state") == "fresh":
                continue
            if window.get("workspace") == workspace:
                continue
            identifier = parse_window_id(window.get("id"))
            self._sway_command(f"[con_id={identifier}] move container to workspace {workspace}")

        self._sway_command(f"workspace --no-auto-back-and-forth {workspace}")
        final = self._wayland_windows()
        final = self._place_private_notification_windows([managed], workspace, final)
        final = self._place_private_status_windows([managed], workspace, final)
        owned = [window for window in final if window.get("launch_id") == managed.launch_id]
        misplaced = [
            window for window in owned
            if window.get("scratchpad_state") != "fresh"
            and window.get("workspace") != workspace
        ]
        if misplaced:
            raise ToolError("guarded launch windows escaped their private compositor workspace")
        foreign_workspace = [
            window for window in final
            if window.get("workspace") == workspace and window.get("launch_id") != managed.launch_id
        ]
        if foreign_workspace:
            raise ToolError("private launch workspace is contaminated by another application trust domain")
        return owned

    def _activate_scene_workspace(
        self,
        members: list[ManagedProcess],
    ) -> list[dict[str, Any]]:
        """Acquire one explicit shared-workspace lease for a bounded launch set.

        Each member still has its own security context, process tree, D-Bus,
        accessibility proxy, network namespace, output directory, and optional
        Xwayland satellite.  Only compositor placement is shared.  Windows from
        any principal outside the exact member set poison the scene.
        """
        if not self.is_wayland:
            raise ToolError("scene-set control requires the private Wayland backend")
        if not 2 <= len(members) <= SCENE_SET_MAX_LAUNCHES:
            raise ToolError("scene-set workspace requires a bounded multi-launch member set")
        scene_ids = {managed.scene_id for managed in members}
        workspaces = {managed.workspace for managed in members}
        if len(scene_ids) != 1 or None in scene_ids or len(workspaces) != 1 or None in workspaces:
            raise ToolError("scene-set members do not share one explicit private workspace")
        workspace = next(iter(workspaces))
        assert isinstance(workspace, str)
        launch_ids = {managed.launch_id for managed in members}
        for managed in members:
            self._refresh_managed(managed)
            if managed.context_failed or not self._context_alive(managed):
                raise ToolError("scene-set member lost its Wayland security context")

        windows = self._wayland_windows()
        owned = [window for window in windows if window.get("launch_id") in launch_ids]
        for window in owned:
            if window.get("scratchpad_state") == "fresh":
                continue
            if window.get("workspace") == workspace:
                continue
            identifier = parse_window_id(window.get("id"))
            self._sway_command(f"[con_id={identifier}] move container to workspace {workspace}")

        self._sway_command(f"workspace --no-auto-back-and-forth {workspace}")
        final = self._wayland_windows()
        final = self._place_private_notification_windows(members, workspace, final)
        final = self._place_private_status_windows(members, workspace, final)
        owned = [window for window in final if window.get("launch_id") in launch_ids]
        represented = {
            str(window.get("launch_id"))
            for window in owned
            if window.get("scratchpad_state") != "fresh" and window.get("visible", True)
        }
        if represented != launch_ids:
            raise ToolError("scene-set observation requires one mapped top-level from every member launch")
        misplaced = [
            window for window in owned
            if window.get("scratchpad_state") != "fresh"
            and window.get("workspace") != workspace
        ]
        if misplaced:
            raise ToolError("scene-set member windows escaped their shared private workspace")
        foreign_workspace = [
            window
            for window in final
            if window.get("workspace") == workspace
            and (
                window.get("launch_id") not in launch_ids
                or window.get("origin_verified") is not True
            )
        ]
        if foreign_workspace:
            raise ToolError("scene-set workspace contains a foreign or unattributed trust domain")
        return owned

    def _window_for_launch(self, managed: ManagedProcess, value: Any) -> dict[str, Any]:
        identifier = parse_window_id(value)
        window = next((item for item in self._scoped_windows(managed) if item.get("id") == identifier), None)
        if window is None:
            raise ToolError("window is not attributable to the guarded launch")
        return window

    def _window_for_scene(
        self,
        members: list[ManagedProcess],
        value: Any,
    ) -> dict[str, Any]:
        identifier = parse_window_id(value)
        window = next(
            (item for item in self._scene_scoped_windows(members) if item.get("id") == identifier),
            None,
        )
        if window is None:
            raise ToolError("window is not attributable to the guarded scene set")
        return window

    @staticmethod
    def _point_in_window(window: dict[str, Any], x: int, y: int) -> bool:
        left = int(window.get("x", 0))
        top = int(window.get("y", 0))
        width = max(0, int(window.get("width", 0)))
        height = max(0, int(window.get("height", 0)))
        return width > 0 and height > 0 and left <= x < left + width and top <= y < top + height

    @staticmethod
    def _rectangles_intersect(left: dict[str, int], right: dict[str, Any]) -> bool:
        lx = int(left.get("x", 0))
        ly = int(left.get("y", 0))
        lw = max(0, int(left.get("width", 0)))
        lh = max(0, int(left.get("height", 0)))
        rx = int(right.get("x", 0))
        ry = int(right.get("y", 0))
        rw = max(0, int(right.get("width", 0)))
        rh = max(0, int(right.get("height", 0)))
        return lw > 0 and lh > 0 and rw > 0 and rh > 0 and lx < rx + rw and rx < lx + lw and ly < ry + rh and ry < ly + lh

    def _require_isolated_launch_capture(self, managed: ManagedProcess, crop: dict[str, int]) -> None:
        windows = [item for item in self._wayland_windows() if item.get("visible", True)]
        owners = [item for item in windows if self._rectangles_intersect(crop, item)]
        if not owners:
            raise ToolError("launch-scoped observation does not intersect an attributable window")
        if not any(item.get("launch_id") == managed.launch_id for item in owners):
            raise ToolError("launch-scoped observation is not contained by the requested launch")
        foreign = [item for item in owners if item.get("launch_id") != managed.launch_id]
        if foreign:
            raise ToolError("launch-scoped observation is occluded by another application trust domain")
        if managed.workspace is not None and any(item.get("workspace") != managed.workspace for item in owners):
            raise ToolError("launch-scoped observation escaped its private compositor workspace")

    def _default_launch_capture(self, managed: ManagedProcess) -> int:
        windows = [item for item in self._scoped_windows(managed) if item.get("visible", True)]
        focused = [item for item in windows if item.get("focused")]
        if len(focused) == 1:
            return int(focused[0]["id"])
        if len(windows) == 1:
            return int(windows[0]["id"])
        if not windows:
            raise ToolError("launch-scoped observation requires a visible attributable window")
        raise ToolError("launch-scoped observation requires window_id or crop when the launch owns multiple windows")

    def _require_point_in_active_launch(self, managed: ManagedProcess, x: int, y: int, label: str) -> dict[str, Any]:
        active = self._require_active_launch(managed)
        if not self._point_in_window(active, x, y):
            raise ToolError(f"{label} is outside the active window attributable to the guarded launch")
        foreign = [
            window for window in self._wayland_windows()
            if window.get("visible", True)
            and window.get("launch_id") != managed.launch_id
            and self._point_in_window(window, x, y)
        ]
        if foreign:
            raise ToolError(f"{label} overlaps another application trust domain")
        return active

    def _require_active_launch(self, managed: ManagedProcess) -> dict[str, Any]:
        window = next((item for item in self._scoped_windows(managed) if item.get("focused")), None)
        if window is None:
            raise ToolError("the guarded launch does not own the active window")
        return window

    def _require_active_scene(
        self,
        members: list[ManagedProcess],
    ) -> tuple[ManagedProcess, dict[str, Any]]:
        windows = self._scene_scoped_windows(members)
        active = [window for window in windows if window.get("focused") is True]
        if len(active) != 1:
            raise ToolError("the guarded scene set does not own exactly one active window")
        launch_id = active[0].get("launch_id")
        managed = next(
            (member for member in members if member.launch_id == launch_id),
            None,
        )
        if managed is None:
            raise ToolError("the active scene window lost its managed launch principal")
        return managed, active[0]

    def _validate_scoped_action(
        self,
        managed: ManagedProcess,
        action_name: str,
        arguments: dict[str, Any],
        *,
        launch_scene_authority_sha256: str | None = None,
    ) -> dict[str, Any]:
        self._refresh_managed(managed)
        if managed.context_failed or not self._context_alive(managed):
            raise ToolError("guarded launch lost its Wayland security context")
        if launch_scene_authority_sha256 is not None:
            if re.fullmatch(r"[0-9a-f]{64}", launch_scene_authority_sha256) is None:
                raise ToolError("launch-scene action authority is invalid")
            self._assert_launch_scene_authority(managed, launch_scene_authority_sha256)
        scoped = dict(arguments)
        if action_name == "desktop_launch":
            raise ToolError("a launch-scoped observation cannot authorize another application launch")
        if action_name in {"desktop_focus", "desktop_move_resize", "desktop_close"}:
            self._window_for_launch(managed, scoped.get("window_id"))
        elif action_name == "desktop_window_state":
            state = self._window_state_name(scoped.get("state"))
            if state in {"floating", "tiled", "minimized", "restored"}:
                raise ToolError(
                    f"launch-scoped {state} is denied; use a fresh whole-workstation observation"
                )
            self._window_for_launch(managed, scoped.get("window_id"))
            scoped["state"] = state
        elif action_name == "desktop_terminate":
            pid = as_int(scoped.get("pid"), 1, 2**31 - 1, "pid")
            if pid != managed.process.pid:
                raise ToolError("guarded observation may terminate only its own launch leader")
        elif action_name == "desktop_move":
            x = as_int(scoped.get("x"), 0, self.width - 1, "x")
            y = as_int(scoped.get("y"), 0, self.height - 1, "y")
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(managed, x, y, "pointer destination")
        elif action_name == "desktop_click":
            x = as_int(scoped.get("x", self.pointer["x"]), 0, self.width - 1, "x")
            y = as_int(scoped.get("y", self.pointer["y"]), 0, self.height - 1, "y")
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(managed, x, y, "click")
        elif action_name == "desktop_touch":
            x = as_int(scoped.get("x"), 0, self.width - 1, "x")
            y = as_int(scoped.get("y"), 0, self.height - 1, "y")
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(managed, x, y, "native touch")
        elif action_name == "desktop_touchpad_pinch":
            parameters = self._touchpad_pinch_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native touchpad pinch focus point",
                )
        elif action_name == "desktop_touchpad_hold":
            parameters = self._touchpad_hold_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native touchpad hold focus point",
                )
        elif action_name == "desktop_tablet_pad_ring":
            parameters = self._tablet_pad_ring_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native tablet-pad ring focus point",
                )
        elif action_name == "desktop_tablet_pad_strip":
            parameters = self._tablet_pad_strip_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native tablet-pad strip focus point",
                )
        elif action_name == "desktop_tablet_pad_button":
            parameters = self._tablet_pad_button_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native tablet-pad button focus point",
                )
        elif action_name == "desktop_tablet_pad_mode":
            parameters = self._tablet_pad_mode_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native tablet-pad mode focus point",
                )
        elif action_name == "desktop_relative_motion":
            parameters = self._relative_motion_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "locked relative-motion focus point",
                )
        elif action_name == "desktop_touchpad_swipe":
            parameters = self._touchpad_swipe_parameters(scoped)
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(
                    managed,
                    parameters["x"],
                    parameters["y"],
                    "native touchpad swipe focus point",
                )
        elif action_name == "desktop_touch_swipe":
            points = self._touch_stroke_points(scoped)
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(
                    managed, points[0][0], points[0][1], "native touch swipe start"
                )
                for index, (x, y) in enumerate(points[1:], start=1):
                    if not self._point_in_window(active, x, y):
                        raise ToolError(
                            f"native touch swipe path point {index} is outside the same active launch window"
                        )
        elif action_name == "desktop_stylus_hover":
            points = self._stylus_hover_points(scoped)
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(
                    points[0][0], points[0][1], expected_launch_id=launch_id
                )
                expected_window_id = active["window"]["window_id"]
                for index, (x, y) in enumerate(points[1:], start=1):
                    current = self._require_point_in_active_launch(
                        x, y, expected_launch_id=launch_id
                    )
                    if current["window"]["window_id"] != expected_window_id:
                        raise ToolError(
                            f"native stylus hover path point {index} is outside the same active launch window"
                        )
        elif action_name == "desktop_stylus_stroke":
            points = self._stylus_stroke_points(scoped)
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(
                    managed, points[0][0], points[0][1], "native stylus-stroke start"
                )
                for index, (x, y) in enumerate(points[1:], start=1):
                    if not self._point_in_window(active, x, y):
                        raise ToolError(
                            f"native stylus-stroke path point {index} is outside the same active launch window"
                        )
        elif action_name == "desktop_eraser_stroke":
            points = self._eraser_stroke_points(scoped)
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(
                    managed, points[0][0], points[0][1], "native eraser-stroke start"
                )
                for index, (x, y) in enumerate(points[1:], start=1):
                    if not self._point_in_window(active, x, y):
                        raise ToolError(
                            f"native eraser-stroke path point {index} is outside the same active launch window"
                        )
        elif action_name == "desktop_touch_gesture":
            first_path, second_path = self._touch_gesture_paths(scoped)
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(
                    managed,
                    first_path[0][0],
                    first_path[0][1],
                    "native touch gesture first-contact start",
                )
                for contact, path_points in (
                    ("first", first_path),
                    ("second", second_path),
                ):
                    for index, (x, y) in enumerate(path_points):
                        if not self._point_in_window(active, x, y):
                            raise ToolError(
                                f"native touch gesture {contact}-contact path point {index} "
                                "is outside the same active launch window"
                            )
        elif action_name == "desktop_scroll":
            x = as_int(scoped.get("x", self.pointer["x"]), 0, self.width - 1, "x")
            y = as_int(scoped.get("y", self.pointer["y"]), 0, self.height - 1, "y")
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(managed, x, y, "scroll")
        elif action_name == "desktop_drag":
            start_x = as_int(scoped.get("start_x"), 0, self.width - 1, "start_x")
            start_y = as_int(scoped.get("start_y"), 0, self.height - 1, "start_y")
            end_x = as_int(scoped.get("end_x"), 0, self.width - 1, "end_x")
            end_y = as_int(scoped.get("end_y"), 0, self.height - 1, "end_y")
            if launch_scene_authority_sha256 is None:
                active = self._require_point_in_active_launch(managed, start_x, start_y, "drag start")
                if not self._point_in_window(active, end_x, end_y):
                    raise ToolError("drag end is outside the same active launch window")
        elif action_name == "desktop_drop":
            scoped = self._validate_drop_spec(scoped)
            target_x = int(scoped["x"])
            target_y = int(scoped["y"])
            if launch_scene_authority_sha256 is None:
                self._require_point_in_active_launch(managed, target_x, target_y, "drop target")
            self._assert_clipboard_launch_exclusive(managed.launch_id)
        elif action_name == "desktop_type":
            self._require_active_launch(managed)
            text = as_string(scoped.get("text"), "text")
            interval = as_number(scoped.get("interval", 0.01), 0.0, 2.0, "interval")
            method = scoped.get("method", "auto")
            if method not in {"auto", "keys", "input-method", "clipboard"}:
                raise ToolError("method must be auto, keys, input-method, or clipboard")
            key_budget_ok = (
                len(text) <= MAX_SYNTHETIC_CHARACTERS
                and max(0, len(text) - 1) * interval <= MAX_ACTION_SECONDS
                and WaylandKeyboardTransaction.can_prepare_characters(text)
            )
            uses_clipboard = method == "clipboard" or (method == "auto" and not key_budget_ok)
            scoped["method"] = method
            if uses_clipboard:
                self._assert_clipboard_launch_exclusive(managed.launch_id)
        elif action_name == "desktop_paste":
            self._require_active_launch(managed)
            scoped = self._validate_rich_paste_spec(scoped)
            if (
                scoped.get("delivery") == "primary-middle-click"
                and launch_scene_authority_sha256 is None
            ):
                self._require_point_in_active_launch(
                    managed,
                    int(scoped["x"]),
                    int(scoped["y"]),
                    "PRIMARY paste target",
                )
            self._assert_clipboard_launch_exclusive(managed.launch_id)
        elif action_name == "desktop_clipboard":
            raise ToolError("launch-scoped observations cannot authorize the workstation-global clipboard")
        elif action_name == "desktop_key":
            self._require_active_launch(managed)
        elif action_name == "desktop_copy":
            scoped = self._normalize_copy_spec(scoped)
            if scoped.get("source") == "launch-output":
                self._assert_file_copy_source_custody(
                    managed.launch_id,
                    "launch-output",
                )
            else:
                self._require_active_launch(managed)
                self._assert_clipboard_launch_exclusive(managed.launch_id)
        elif action_name.startswith("desktop_accessibility_"):
            process_ids = self._semantic_process_ids(managed)
            if action_name == "desktop_accessibility_perform":
                scoped["process_ids"] = process_ids
            else:
                process_id = self.accessibility.node_process_id(scoped.get("node_id"))
                if process_id not in process_ids:
                    raise ToolError("accessibility node is not attributable to the guarded launch")
        return scoped

    def _validate_scene_action(
        self,
        members: list[ManagedProcess],
        action_name: str,
        arguments: dict[str, Any],
        *,
        scene_set_authority_sha256: str,
    ) -> dict[str, Any]:
        """Narrow one mutation to an exact, already-reviewed multi-app scene.

        A scene is not a relaxation to the host desktop. It is a bounded
        cooperation domain whose members retain independent process, network,
        D-Bus, accessibility, filesystem, and Wayland security contexts. Only
        their shared private workspace and full-output pixels are combined.
        """
        if (
            not isinstance(scene_set_authority_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", scene_set_authority_sha256) is None
        ):
            raise ToolError("scene-set action authority is invalid")
        self._assert_scene_set_authority(members, scene_set_authority_sha256)
        scoped = dict(arguments)
        launch_ids = tuple(sorted(managed.launch_id for managed in members))
        if action_name == "desktop_launch":
            raise ToolError(
                "a scene-scoped observation cannot authorize a late application join; "
                "launch the member first, then mint a new exact scene observation"
            )
        if action_name in {"desktop_focus", "desktop_move_resize", "desktop_close"}:
            target_window = self._window_for_scene(members, scoped.get("window_id"))
            if action_name == "desktop_close":
                target_launch_id = target_window.get("launch_id")
                target_window_id = parse_window_id(target_window.get("id"))
                remaining = [
                    window
                    for window in self._scene_scoped_windows(members)
                    if window.get("launch_id") == target_launch_id
                    and window.get("visible", True)
                    and parse_window_id(window.get("id")) != target_window_id
                ]
                if not remaining:
                    raise ToolError(
                        "scene-set close cannot remove a member's last observed top-level; "
                        "close it from a fresh single-launch or workstation observation"
                    )
        elif action_name == "desktop_window_state":
            state = self._window_state_name(scoped.get("state"))
            if state in {"floating", "tiled", "minimized", "restored"}:
                raise ToolError(
                    f"scene-scoped {state} is denied; use a fresh whole-workstation observation"
                )
            self._window_for_scene(members, scoped.get("window_id"))
            scoped["state"] = state
        elif action_name == "desktop_terminate":
            raise ToolError(
                "scene-set termination is denied because removing an exact member would make "
                "the compulsory post-action scene observation unreportable; terminate from a "
                "fresh single-launch or whole-workstation observation"
            )
        elif action_name in {
            "desktop_move", "desktop_click", "desktop_touch",
            "desktop_touch_swipe", "desktop_touch_gesture",
            "desktop_touchpad_swipe", "desktop_touchpad_pinch",
            "desktop_touchpad_hold", "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
            "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
            "desktop_relative_motion", "desktop_stylus_hover", "desktop_stylus_stroke",
            "desktop_eraser_stroke", "desktop_scroll", "desktop_drag",
        }:
            # Full-output SceneSetSeal owns the coordinate envelope. PointerRoute
            # performs the stronger per-unit trust-domain and geometry checks.
            pass
        elif action_name == "desktop_drop":
            scoped = self._validate_drop_spec(scoped)
            if scoped.get("kind") in {"files", "directory"}:
                raise ToolError(
                    "scene-set native file or directory DropSeal is denied because text/uri-list paths are "
                    "mounted only into one exact launch capsule"
                )
            scene_id = members[0].scene_id
            assert isinstance(scene_id, str)
            self._assert_clipboard_scene_exclusive(scene_id, launch_ids)
        elif action_name == "desktop_type":
            self._require_active_scene(members)
            text = as_string(scoped.get("text"), "text")
            interval = as_number(scoped.get("interval", 0.01), 0.0, 2.0, "interval")
            method = scoped.get("method", "auto")
            if method not in {"auto", "keys", "input-method", "clipboard"}:
                raise ToolError("method must be auto, keys, input-method, or clipboard")
            key_budget_ok = (
                len(text) <= MAX_SYNTHETIC_CHARACTERS
                and max(0, len(text) - 1) * interval <= MAX_ACTION_SECONDS
                and WaylandKeyboardTransaction.can_prepare_characters(text)
            )
            uses_clipboard = method == "clipboard" or (method == "auto" and not key_budget_ok)
            if uses_clipboard:
                scene_id = members[0].scene_id
                assert isinstance(scene_id, str)
                self._assert_clipboard_scene_exclusive(scene_id, launch_ids)
            scoped["method"] = method
        elif action_name == "desktop_paste":
            self._require_active_scene(members)
            scoped = self._validate_rich_paste_spec(scoped)
            if scoped.get("kind") in {"files", "directory"}:
                raise ToolError(
                    "scene-set file or directory paste is denied because text/uri-list "
                    "paths are mounted only into one exact launch capsule"
                )
            scene_id = members[0].scene_id
            assert isinstance(scene_id, str)
            self._assert_clipboard_scene_exclusive(scene_id, launch_ids)
        elif action_name == "desktop_clipboard":
            raise ToolError(
                "scene-scoped observations cannot authorize a persistent workstation-global clipboard"
            )
        elif action_name == "desktop_key":
            self._require_active_scene(members)
        elif action_name == "desktop_copy":
            scoped = self._normalize_copy_spec(scoped)
            if scoped.get("source") == "launch-output":
                raise ToolError(
                    "scene-set OutputSnapshotSeal is denied; use a fresh exact launch observation"
                )
            self._require_active_scene(members)
            if scoped.get("kind") in {"files", "directory"}:
                raise ToolError(
                    "scene-set FileCopySeal and DirectoryCopySeal are denied because copied URIs are "
                    "admitted only from one exact launch-private output mount"
                )
            scene_id = members[0].scene_id
            assert isinstance(scene_id, str)
            self._assert_clipboard_scene_exclusive(scene_id, launch_ids)
        elif action_name.startswith("desktop_accessibility_"):
            process_ids = self._semantic_process_ids_for_scene(members)
            if action_name == "desktop_accessibility_perform":
                scoped["process_ids"] = process_ids
            else:
                process_id = self.accessibility.node_process_id(scoped.get("node_id"))
                if process_id not in process_ids:
                    raise ToolError(
                        "accessibility node is not attributable to the guarded scene set"
                    )
        return scoped

    def observe(self, arguments: dict[str, Any]) -> dict[str, Any]:
        launch_id_value = arguments.get("launch_id")
        scene_id_value = arguments.get("scene_id")
        if launch_id_value is not None and scene_id_value is not None:
            raise ToolError("launch_id and scene_id are mutually exclusive observation scopes")
        capture_mode = arguments.get("capture_mode", "window")
        if capture_mode not in {"window", "launch-scene", "scene-set"}:
            raise ToolError("capture_mode must be window, launch-scene, or scene-set")
        include_transient_attribution = as_bool(
            arguments.get("include_transient_attribution", False),
            "include_transient_attribution",
        )
        if include_transient_attribution and capture_mode != "scene-set":
            raise ToolError("include_transient_attribution requires capture_mode=scene-set")
        if capture_mode != "scene-set" and "include_transient_attribution" in arguments:
            raise ToolError("include_transient_attribution requires capture_mode=scene-set")
        include_occlusion_attribution = as_bool(
            arguments.get("include_occlusion_attribution", False),
            "include_occlusion_attribution",
        )
        if include_occlusion_attribution and capture_mode != "scene-set":
            raise ToolError("include_occlusion_attribution requires capture_mode=scene-set")
        if capture_mode != "scene-set" and "include_occlusion_attribution" in arguments:
            raise ToolError("include_occlusion_attribution requires capture_mode=scene-set")
        if include_transient_attribution and include_occlusion_attribution:
            raise ToolError(
                "include_transient_attribution and include_occlusion_attribution are mutually exclusive"
            )

        managed: ManagedProcess | None = None
        scene_id: str | None = None
        scene_members: list[ManagedProcess] = []
        scene_launch_ids: tuple[str, ...] = ()
        expected_scene_launch_ids: tuple[str, ...] | None = None
        expected_scene_value = arguments.get("scene_launch_ids")
        if expected_scene_value is not None:
            if (
                not isinstance(expected_scene_value, list)
                or not 2 <= len(expected_scene_value) <= SCENE_SET_MAX_LAUNCHES
                or any(
                    not isinstance(item, str)
                    or re.fullmatch(r"launch-[0-9a-f]{24}", item) is None
                    for item in expected_scene_value
                )
            ):
                raise ToolError("scene_launch_ids is an invalid exact scene membership vector")
            expected_scene_launch_ids = tuple(sorted(expected_scene_value))
            if len(set(expected_scene_launch_ids)) != len(expected_scene_launch_ids):
                raise ToolError("scene_launch_ids contains duplicate launch identities")
        if launch_id_value is not None:
            if capture_mode == "scene-set":
                raise ToolError("scene-set observation uses scene_id rather than launch_id")
            managed = self._managed_by_launch_id(launch_id_value)
            if not self.is_wayland:
                raise ToolError("launch-scoped observations require the private Wayland backend")
            self._activate_launch_workspace(managed)
        elif scene_id_value is not None:
            if capture_mode != "scene-set":
                raise ToolError("scene_id requires capture_mode=scene-set")
            if not self.is_wayland:
                raise ToolError("scene-set observations require the private Wayland backend")
            scene_id = self._scene_id(scene_id_value, required=True)
            assert scene_id is not None
            scene_members = self._managed_scene(
                scene_id,
                expected_launch_ids=expected_scene_launch_ids,
            )
            scene_launch_ids = tuple(member.launch_id for member in scene_members)
            self._activate_scene_workspace(scene_members)
        elif capture_mode == "scene-set":
            raise ToolError("scene-set observation requires scene_id")
        elif expected_scene_launch_ids is not None:
            raise ToolError("scene_launch_ids requires a scene-set observation")

        if capture_mode == "launch-scene":
            if managed is None:
                raise ToolError("launch-scene observation requires launch_id")
            if "crop" in arguments or "window_id" in arguments:
                raise ToolError("launch-scene observation forbids crop and window_id")
            capture_arguments = {
                "capture_mode": "launch-scene",
                "launch_id": managed.launch_id,
            }
        elif capture_mode == "scene-set":
            if not scene_members or scene_id is None:
                raise ToolError("scene-set observation has no exact member set")
            if "crop" in arguments or "window_id" in arguments:
                raise ToolError("scene-set observation forbids crop and window_id")
            capture_arguments = {
                "capture_mode": "scene-set",
                "scene_id": scene_id,
                "scene_launch_ids": list(scene_launch_ids),
            }
            if include_transient_attribution:
                capture_arguments["include_transient_attribution"] = True
            elif include_occlusion_attribution:
                capture_arguments["include_occlusion_attribution"] = True
        else:
            capture_arguments = {
                key: arguments[key]
                for key in ("crop", "window_id")
                if key in arguments
            }
            if managed is not None:
                if "window_id" in capture_arguments:
                    self._window_for_launch(managed, capture_arguments["window_id"])
                elif "crop" not in capture_arguments:
                    capture_arguments["window_id"] = self._default_launch_capture(managed)

        frame_fence: dict[str, Any] | None = None
        frame_fence_arguments = arguments.get("frame_fence")
        if frame_fence_arguments is not None:
            frame_fence = self._arm_frame_fence(
                frame_fence_arguments,
                capture_arguments,
            )

        event_scope: dict[str, Any] | None = None
        event_fence: dict[str, Any] | None = None
        event_fence_arguments = arguments.get("event_fence")
        if event_fence_arguments is not None:
            if not self.is_wayland:
                raise ToolError("EventFenceSeal requires the private Wayland backend")
            if managed is not None:
                event_scope = {
                    "kind": "launch",
                    "launch_ids": [managed.launch_id],
                    "scene_id": None,
                }
            elif scene_members and scene_id is not None:
                event_scope = {
                    "kind": "scene",
                    "launch_ids": list(scene_launch_ids),
                    "scene_id": scene_id,
                }
            else:
                raise ToolError(
                    "event_fence requires an exact launch- or scene-scoped observation"
                )
            event_fence = self.accessibility.arm_event_fence(
                event_fence_arguments,
                event_scope,
            )

        include_accessibility = as_bool(
            arguments.get("include_accessibility", False),
            "include_accessibility",
        )
        semantic: dict[str, Any] | None = None
        semantic_options: dict[str, Any] | None = None
        semantic_sha256: str | None = None
        semantic_node_ids: tuple[str, ...] = ()
        semantic_pair_difference: float | None = None
        scene_transient_map: dict[str, Any] | None = None
        scene_occlusion_map: dict[str, Any] | None = None
        if include_accessibility:
            semantic_options = self._semantic_options(arguments.get("accessibility", {}))
            if managed is not None or scene_members:
                if "process_ids" in semantic_options:
                    raise ToolError("accessibility.process_ids is controlled by guarded scope")
                semantic_options["process_ids"] = (
                    self._semantic_process_ids(managed)
                    if managed is not None
                    else self._semantic_process_ids_for_scene(scene_members)
                )
            (
                image, crop_value, window_id, active_signature, window_signature,
                semantic, semantic_sha256, semantic_node_ids, semantic_pair_difference,
                capture_source, scene_transient_map, scene_occlusion_map,
            ) = self._capture_semantic_pair(capture_arguments, semantic_options)
        else:
            before_active_signature, before_window_signature = self._active_and_window_signatures()
            frame = self._capture_region(capture_arguments)
            image = frame.image
            crop_value = frame.crop
            window_id = frame.window_id
            capture_source = self._capture_source_from_frame(frame)
            scene_transient_map = self._scene_transient_map_from_frame(frame, capture_source)
            scene_occlusion_map = self._scene_occlusion_map_from_frame(frame, capture_source)
            active_signature, window_signature = self._active_and_window_signatures()
            if (
                before_active_signature != active_signature
                or before_window_signature != window_signature
            ):
                raise ToolError("desktop topology changed while capturing the guarded observation")

        if scene_members:
            if crop_value is not None or window_id is not None:
                raise ToolError("scene-set observation resolved to an unexpected bounded source")
            if capture_source.get("scope") != "scene-set":
                raise ToolError("scene-set observation lost its private-output source authority")
            scene_authority = self._assert_scene_set_authority(
                scene_members,
                capture_source.get("scene_set_authority_sha256"),
            )
            for key in (
                "scene_id_sha256", "workspace_sha256", "member_set_sha256",
                "active_launch_id_sha256", "output_authority_sha256",
                "visible_scene_sha256", "active_window_identity_sha256",
                "scene_member_count", "visible_window_count",
            ):
                if capture_source.get(key) != scene_authority.get(key):
                    raise ToolError(
                        "scene-set source authority disagrees with the final compositor scene"
                    )
        elif managed is not None:
            if capture_mode == "launch-scene":
                if crop_value is not None or window_id is not None:
                    raise ToolError("launch-scene observation resolved to an unexpected bounded source")
                if capture_source.get("scope") != "launch-scene":
                    raise ToolError("launch-scene observation lost its private-output source authority")
                scene_authority = self._assert_launch_scene_authority(
                    managed,
                    capture_source.get("launch_scene_authority_sha256"),
                )
                for key in (
                    "launch_id_sha256", "workspace_sha256", "output_authority_sha256",
                    "visible_scene_sha256", "active_window_identity_sha256",
                    "visible_window_count",
                ):
                    if capture_source.get(key) != scene_authority.get(key):
                        raise ToolError(
                            "launch-scene source authority disagrees with the final compositor scene"
                        )
            else:
                if crop_value is None:
                    raise ToolError("launch-scoped observation did not resolve to a bounded capture")
                left, top = crop_value["x"], crop_value["y"]
                right = left + crop_value["width"] - 1
                bottom = top + crop_value["height"] - 1
                scoped_windows = self._scoped_windows(managed)
                if not any(
                    self._point_in_window(window, left, top)
                    and self._point_in_window(window, right, bottom)
                    for window in scoped_windows
                ):
                    raise ToolError(
                        "observation region is not contained by one window attributable to the guarded launch"
                    )
                self._require_isolated_launch_capture(managed, crop_value)

        final_active_signature, final_window_signature, _scene_windows, active_window_id = (
            self._window_scene()
        )
        if final_active_signature != active_signature or final_window_signature != window_signature:
            raise ToolError(
                "desktop window or focus state changed while finalizing the guarded observation"
            )
        if frame_fence is not None:
            frame_fence = self._complete_frame_fence(
                frame_fence,
                capture_arguments,
                image,
                capture_source,
            )
            (
                post_frame_active_signature,
                post_frame_window_signature,
                _post_frame_windows,
                post_frame_active_window_id,
            ) = self._window_scene()
            if (
                post_frame_active_signature != active_signature
                or post_frame_window_signature != window_signature
            ):
                raise ToolError(
                    "desktop topology changed while closing the FrameFenceSeal observation"
                )
            active_window_id = post_frame_active_window_id
        if event_fence is not None:
            assert event_scope is not None
            event_fence = self.accessibility.complete_event_fence(
                event_fence,
                event_scope,
            )
        pointer = self.pointer_position()
        guard_width, guard_height, guard_pixels = self._observation_guard(image)
        payload, encoded = self._encoded_image(image, self.max_output_bytes)
        observation_id = "obs-" + secrets.token_hex(24)
        observation = Observation(
            observation_id=observation_id,
            created=time.monotonic(),
            capture_arguments=capture_arguments,
            screen_sha256=self._image_fingerprint(image),
            visual_sample=self._visual_sample(image),
            active_signature=active_signature,
            window_signature=window_signature,
            launch_id=managed.launch_id if managed is not None else None,
            scene_id=scene_id,
            scene_launch_ids=scene_launch_ids,
            semantic_sha256=semantic_sha256,
            semantic_options=semantic_options,
            semantic_node_ids=semantic_node_ids,
            capture_crop=dict(crop_value) if crop_value is not None else None,
            capture_window_id=window_id,
            capture_source=dict(capture_source),
            scene_transient_map=scene_transient_map,
            scene_occlusion_map=scene_occlusion_map,
            event_fence=event_fence,
            frame_fence=frame_fence,
            pointer=(int(pointer["x"]), int(pointer["y"])),
            active_window_id=active_window_id,
            guard_width=guard_width,
            guard_height=guard_height,
            guard_pixels=guard_pixels,
        )
        self._prune_observations()
        self.observations[observation_id] = observation
        raw_scoped_windows = (
            self._scoped_windows(managed)
            if managed is not None
            else self._scene_scoped_windows(scene_members)
            if scene_members
            else None
        )
        scoped_windows = (
            self._public_wayland_windows(raw_scoped_windows)
            if raw_scoped_windows is not None
            else None
        )
        metadata: dict[str, Any] = {
            "observation_id": observation_id,
            "expires_in_milliseconds": int(OBSERVATION_TTL_SECONDS * 1000),
            "captured_at": utc_now(),
            "width": image.width,
            "height": image.height,
            "bytes": len(payload),
            "sha256": observation.screen_sha256,
            "crop": crop_value,
            "window_id": window_id,
            "capture_source": capture_source,
            "capture_mode": capture_mode,
            "launch_id": observation.launch_id,
            "launch_grants": self._grants(managed) if managed is not None else None,
            "launch_windows": scoped_windows if managed is not None else None,
            "scene_id": observation.scene_id,
            "scene_launch_ids": list(observation.scene_launch_ids),
            "scene_member_count": len(observation.scene_launch_ids),
            "scene_grants": (
                [
                    {
                        "launch_id": member.launch_id,
                        "application_id": member.application_id,
                        "grants": self._grants(member),
                    }
                    for member in scene_members
                ]
                if scene_members else None
            ),
            "scene_windows": scoped_windows if scene_members else None,
            "active_signature": active_signature,
            "window_signature": window_signature,
            "semantic_sha256": semantic_sha256,
            "semantic_pair_difference": semantic_pair_difference,
            "semantic_scene_bound": semantic_sha256 is not None,
            "event_fence": (
                self.accessibility.public_event_fence(event_fence)
                if event_fence is not None
                else None
            ),
            "frame_fence": self._public_frame_fence(frame_fence),
            "pointer": pointer,
            "observation_envelope": {
                "visual_region": self._observation_region(observation),
                "whole_workstation": (
                    observation.capture_crop is None
                    and observation.launch_id is None
                    and observation.scene_id is None
                ),
                "whole_private_output": observation.capture_crop is None,
                "launch_scene": capture_source.get("scope") == "launch-scene",
                "scene_set": capture_source.get("scope") == "scene-set",
                "transient_surfaces_actionable": (
                    capture_source.get("scope") == "launch-scene"
                    or (
                        capture_source.get("scope") == "scene-set"
                        and capture_source.get("scene_transient_attribution") is True
                        and int(capture_source.get("scene_transient_pixel_count") or 0) > 0
                    )
                ),
                "scene_set_uncovered_pixels_actionable": (
                    capture_source.get("scope") == "scene-set"
                    and capture_source.get("scene_transient_attribution") is True
                    and int(capture_source.get("scene_transient_pixel_count") or 0) > 0
                ),
                "scene_set_overlapping_toplevel_pixels_actionable": (
                    capture_source.get("scope") == "scene-set"
                    and capture_source.get("scene_occlusion_attribution") is True
                    and int(capture_source.get("scene_occlusion_pixel_count") or 0) > 0
                ),
                "scene_set_occlusion_overlap_pixels": (
                    int(capture_source.get("scene_occlusion_overlap_pixel_count") or 0)
                    if capture_source.get("scope") == "scene-set"
                    and capture_source.get("scene_occlusion_attribution") is True
                    else 0
                ),
                "active_window_id": observation.active_window_id,
                "mutation_targets_must_be_represented": True,
                "semantic_event_frontier_bound": event_fence is not None,
                "visual_wait_frontier_bound": frame_fence is not None,
                "target_reference": {
                    "width": guard_width,
                    "height": guard_height,
                    "maximum_dimension": OBSERVATION_GUARD_MAX_DIMENSION,
                    "radius_pixels": POINTER_LATCH_TARGET_RADIUS,
                    "maximum_difference_threshold": POINTER_LATCH_TARGET_THRESHOLD,
                },
            },
            "accessibility": semantic,
        }
        return {
            "content": [
                {"type": "text", "text": json.dumps(metadata, sort_keys=True)},
                {"type": "image", "data": encoded, "mimeType": "image/png"},
            ],
            "structuredContent": metadata,
        }

    def _invalidate_observation_result(self, result: dict[str, Any]) -> str | None:
        structured = result.get("structuredContent")
        identifier = structured.get("observation_id") if isinstance(structured, dict) else None
        if not isinstance(identifier, str):
            return None
        unstable = self.observations.pop(identifier, None)
        if unstable is not None:
            unstable.consumed = True
        return identifier

    @staticmethod
    def _authority_digest(value: Any) -> str:
        # Authority projections can contain hashes of typed text or other
        # low-entropy private inputs. A plain public digest would permit offline
        # guessing. Key the projection inside the credentialless controller so
        # receipts remain tamper-evident without becoming a password oracle.
        return hmac.new(
            _COMPOSITOR_ACTION_AUTHORITY_KEY,
            canonical_json(value),
            hashlib.sha256,
        ).hexdigest()

    @classmethod
    def _compositor_observation_binding(cls, observation: Observation) -> dict[str, Any]:
        binding = {
            "observation_id_sha256": hashlib.sha256(
                observation.observation_id.encode("utf-8", "replace")
            ).hexdigest(),
            "screen_sha256": observation.screen_sha256,
            "visual_sample_sha256": hashlib.sha256(observation.visual_sample).hexdigest(),
            "semantic_sha256": observation.semantic_sha256,
            "semantic_options_sha256": cls._authority_digest(observation.semantic_options),
            "semantic_node_ids_sha256": cls._authority_digest(observation.semantic_node_ids),
            "active_signature": observation.active_signature,
            "window_signature": observation.window_signature,
            "capture_arguments_sha256": cls._authority_digest(observation.capture_arguments),
            "capture_crop_sha256": cls._authority_digest(observation.capture_crop),
            "capture_window_id_sha256": cls._authority_digest(observation.capture_window_id),
            "capture_source_sha256": cls._authority_digest(observation.capture_source),
            "scene_transient_map_sha256": cls._authority_digest(observation.scene_transient_map),
            "scene_occlusion_map_sha256": cls._authority_digest(observation.scene_occlusion_map),
            "event_fence_sha256": cls._authority_digest(observation.event_fence),
            "frame_fence_sha256": cls._authority_digest(observation.frame_fence),
            "pointer_sha256": cls._authority_digest(observation.pointer),
            "active_window_id_sha256": cls._authority_digest(observation.active_window_id),
            "guard_geometry_sha256": cls._authority_digest({
                "width": observation.guard_width,
                "height": observation.guard_height,
            }),
            "guard_pixels_sha256": hashlib.sha256(observation.guard_pixels).hexdigest(),
            "launch_id_sha256": (
                hashlib.sha256(observation.launch_id.encode("utf-8", "replace")).hexdigest()
                if observation.launch_id is not None else None
            ),
            "scene_id_sha256": (
                hashlib.sha256(observation.scene_id.encode("utf-8", "replace")).hexdigest()
                if observation.scene_id is not None else None
            ),
            "scene_launch_ids_sha256": (
                cls._authority_digest(list(observation.scene_launch_ids))
                if observation.scene_id is not None else None
            ),
        }
        binding["binding_sha256"] = cls._authority_digest(binding)
        return binding

    @classmethod
    def _new_compositor_action_receipt(
        cls,
        action_name: str,
        observation: Observation,
        requested_action_arguments: dict[str, Any],
        outcome_policy: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        if not isinstance(action_name, str) or not action_name:
            raise ToolError("guarded compositor action name is invalid")
        if not isinstance(requested_action_arguments, dict):
            raise ToolError("guarded compositor action arguments are invalid")
        if outcome_policy is not None and (
            not isinstance(outcome_policy, dict)
            or outcome_policy.get("schema") != OUTCOME_SEAL_SCHEMA
        ):
            raise ToolError("guarded compositor outcome policy is invalid")
        observation_binding = cls._compositor_observation_binding(observation)
        requested_action_sha256 = cls._authority_digest({
            "name": action_name,
            "arguments": requested_action_arguments,
        })
        outcome_policy_sha256 = cls._authority_digest(outcome_policy)
        reviewed_projection = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "observation_binding_sha256": observation_binding["binding_sha256"],
            "requested_action_sha256": requested_action_sha256,
            "outcome_policy_sha256": outcome_policy_sha256,
        }
        authority = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "observation": observation_binding,
            "requested_action_sha256": requested_action_sha256,
            "outcome_policy_sha256": outcome_policy_sha256,
            "reviewed_authority_sha256": cls._authority_digest(reviewed_projection),
            "validated_action_sha256": None,
            "validated_action_differs": None,
            "dispatch_authority_sha256": None,
            "outcome_result_sha256": None,
            "outcome_authority_sha256": None,
            "post_observation": None,
            "post_observation_authority_sha256": None,
        }
        return {
            "schema": COMPOSITOR_ACTION_SEAL_SCHEMA,
            "enforced": True,
            "action": action_name,
            "outcome_requested": outcome_policy is not None,
            "outcome_seal": None,
            "event_fence_requested": observation.event_fence is not None,
            "event_fence": None,
            "frame_fence_requested": observation.frame_fence is not None,
            "frame_fence": None,
            "authority": authority,
            "peer_authentication": "SO_PEERCRED+proc-start-ticks",
            "barrier": "Sway-SEND_TICK-dual-marker-ordered-event-drain",
            "ticks_per_logical_barrier": COMPOSITOR_TICKS_PER_LOGICAL_BARRIER,
            "barriers": {},
            "sway_ticks": 0,
            "intervals": [],
            "events": 0,
            "metadata_events": 0,
            "transition_events": 0,
            "fatal_events": 0,
            "event_types": [],
            "changes": [],
            "samples": [],
            "event_chain_sha256": "0" * 64,
            "post_observation_attempts": 0,
            "invalidated_post_observations": 0,
            "unstable_post_observation_captures": 0,
        }

    @classmethod
    def _bind_compositor_action_dispatch(
        cls,
        receipt: dict[str, Any],
        action_name: str,
        validated_action_arguments: dict[str, Any],
    ) -> None:
        if receipt.get("action") != action_name or not isinstance(validated_action_arguments, dict):
            raise ToolError("guarded compositor dispatch authority does not match the receipt")
        authority = receipt.get("authority")
        if (
            not isinstance(authority, dict)
            or authority.get("schema") != COMPOSITOR_ACTION_AUTHORITY_SCHEMA
            or authority.get("digest") != COMPOSITOR_ACTION_AUTHORITY_DIGEST
        ):
            raise ToolError("guarded compositor action authority is malformed")
        if authority.get("validated_action_sha256") is not None or authority.get("dispatch_authority_sha256") is not None:
            raise ToolError("guarded compositor dispatch authority was already bound")
        reviewed = authority.get("reviewed_authority_sha256")
        requested = authority.get("requested_action_sha256")
        if (
            not isinstance(reviewed, str)
            or re.fullmatch(r"[0-9a-f]{64}", reviewed) is None
            or not isinstance(requested, str)
            or re.fullmatch(r"[0-9a-f]{64}", requested) is None
        ):
            raise ToolError("guarded compositor reviewed authority digest is malformed")
        validated = cls._authority_digest({
            "name": action_name,
            "arguments": validated_action_arguments,
        })
        authority["validated_action_sha256"] = validated
        authority["validated_action_differs"] = validated != requested
        authority["dispatch_authority_sha256"] = cls._authority_digest({
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "reviewed_authority_sha256": reviewed,
            "validated_action_sha256": validated,
        })

    @classmethod
    def _bind_compositor_action_outcome(
        cls,
        receipt: dict[str, Any],
        outcome_seal: dict[str, Any] | None,
    ) -> None:
        authority = receipt.get("authority")
        action_name = receipt.get("action")
        requested = receipt.get("outcome_requested")
        if (
            not isinstance(action_name, str)
            or not isinstance(requested, bool)
            or not isinstance(authority, dict)
            or authority.get("schema") != COMPOSITOR_ACTION_AUTHORITY_SCHEMA
            or authority.get("digest") != COMPOSITOR_ACTION_AUTHORITY_DIGEST
            or authority.get("action") != action_name
        ):
            raise ToolError("guarded compositor outcome authority is malformed")
        dispatch = authority.get("dispatch_authority_sha256")
        policy_digest = authority.get("outcome_policy_sha256")
        if (
            not isinstance(dispatch, str)
            or re.fullmatch(r"[0-9a-f]{64}", dispatch) is None
            or not isinstance(policy_digest, str)
            or re.fullmatch(r"[0-9a-f]{64}", policy_digest) is None
        ):
            raise ToolError("guarded compositor dispatch authority is incomplete before outcome binding")
        if (
            authority.get("outcome_result_sha256") is not None
            or authority.get("outcome_authority_sha256") is not None
        ):
            raise ToolError("guarded compositor outcome authority was already bound")
        if requested:
            if (
                not isinstance(outcome_seal, dict)
                or outcome_seal.get("schema") != OUTCOME_SEAL_SCHEMA
                or outcome_seal.get("enforced") is not True
            ):
                raise ToolError("guarded compositor requested outcome seal is absent or malformed")
        elif outcome_seal is not None:
            raise ToolError("guarded compositor receipt received an unrequested outcome seal")
        result_digest = cls._authority_digest(outcome_seal)
        authority["outcome_result_sha256"] = result_digest
        authority["outcome_authority_sha256"] = cls._authority_digest({
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "dispatch_authority_sha256": dispatch,
            "outcome_policy_sha256": policy_digest,
            "outcome_result_sha256": result_digest,
        })
        receipt["outcome_seal"] = outcome_seal

    @classmethod
    def _bind_compositor_post_observation(
        cls,
        receipt: dict[str, Any],
        observation: Observation,
    ) -> None:
        authority = receipt.get("authority")
        action_name = receipt.get("action")
        if (
            not isinstance(action_name, str)
            or not isinstance(authority, dict)
            or authority.get("schema") != COMPOSITOR_ACTION_AUTHORITY_SCHEMA
            or authority.get("digest") != COMPOSITOR_ACTION_AUTHORITY_DIGEST
            or authority.get("action") != action_name
        ):
            raise ToolError("guarded compositor post-observation authority is malformed")
        dispatch = authority.get("dispatch_authority_sha256")
        if not isinstance(dispatch, str) or re.fullmatch(r"[0-9a-f]{64}", dispatch) is None:
            raise ToolError("guarded compositor dispatch authority is incomplete before post-observation")
        if authority.get("outcome_authority_sha256") is None:
            if receipt.get("outcome_requested") is True:
                raise ToolError("guarded compositor requested outcome is incomplete before post-observation")
            cls._bind_compositor_action_outcome(receipt, None)
            authority = receipt.get("authority")
            if not isinstance(authority, dict):
                raise ToolError("guarded compositor outcome authority disappeared")
        outcome_authority = authority.get("outcome_authority_sha256")
        if not isinstance(outcome_authority, str) or re.fullmatch(r"[0-9a-f]{64}", outcome_authority) is None:
            raise ToolError("guarded compositor outcome authority is incomplete before post-observation")
        if authority.get("post_observation") is not None or authority.get("post_observation_authority_sha256") is not None:
            raise ToolError("guarded compositor post-observation authority was already bound")
        post_binding = cls._compositor_observation_binding(observation)
        authority["post_observation"] = post_binding
        authority["post_observation_authority_sha256"] = cls._authority_digest({
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "dispatch_authority_sha256": dispatch,
            "outcome_authority_sha256": outcome_authority,
            "post_observation_binding_sha256": post_binding["binding_sha256"],
        })

    @classmethod
    def _validate_compositor_observation_binding(
        cls,
        binding: Any,
        label: str,
    ) -> str:
        if not isinstance(binding, dict):
            raise ToolError(f"guarded compositor {label} observation authority is malformed")
        required = {
            "observation_id_sha256", "screen_sha256", "visual_sample_sha256",
            "semantic_sha256", "semantic_options_sha256", "semantic_node_ids_sha256",
            "active_signature", "window_signature", "capture_arguments_sha256",
            "capture_crop_sha256", "capture_window_id_sha256", "capture_source_sha256",
            "scene_transient_map_sha256", "scene_occlusion_map_sha256",
            "event_fence_sha256", "frame_fence_sha256",
            "pointer_sha256",
            "active_window_id_sha256", "guard_geometry_sha256", "guard_pixels_sha256",
            "launch_id_sha256", "scene_id_sha256", "scene_launch_ids_sha256",
            "binding_sha256",
        }
        if set(binding) != required:
            raise ToolError(f"guarded compositor {label} observation authority fields are incomplete")
        nullable = {
            "semantic_sha256", "launch_id_sha256",
            "scene_id_sha256", "scene_launch_ids_sha256",
        }
        for key in required - {"binding_sha256"}:
            value = binding.get(key)
            if key in nullable and value is None:
                continue
            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                raise ToolError(f"guarded compositor {label} observation authority digest is malformed")
        digest = binding.get("binding_sha256")
        projection = dict(binding)
        projection.pop("binding_sha256", None)
        if not isinstance(digest, str) or digest != cls._authority_digest(projection):
            raise ToolError(f"guarded compositor {label} observation authority digest is inconsistent")
        return digest

    def _compositor_action_barrier(
        self,
        receipt: dict[str, Any],
        phase: str,
    ) -> int:
        if not isinstance(phase, str) or re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", phase) is None:
            raise ToolError("guarded compositor action barrier phase is invalid")
        barriers = receipt.get("barriers")
        if not isinstance(barriers, dict):
            raise ToolError("guarded compositor action receipt is malformed")
        if phase in barriers:
            raise ToolError("guarded compositor action barrier phase was duplicated")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None:
            raise ToolError("birth-pinned compositor event seal is unavailable; guarded action was withheld")
        sequence = seal.barrier(f"{receipt['action']}:{phase}")
        if not isinstance(sequence, int) or isinstance(sequence, bool) or sequence < 0:
            raise ToolError("guarded compositor action barrier returned an invalid sequence")
        if barriers and sequence <= next(reversed(barriers.values())):
            raise ToolError("guarded compositor action barrier sequence did not advance")
        barriers[phase] = sequence
        receipt["sway_ticks"] = (
            int(receipt.get("sway_ticks", 0)) + COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
        )
        return sequence

    @staticmethod
    def _merge_compositor_action_summary(
        receipt: dict[str, Any],
        phase: str,
        summary: dict[str, Any],
    ) -> None:
        if summary.get("schema") != COMPOSITOR_EVENT_SEAL_SCHEMA or summary.get("enforced") is not True:
            raise ToolError("compositor event seal returned an invalid guarded-action interval receipt")
        intervals = receipt.get("intervals")
        if not isinstance(intervals, list):
            raise ToolError("guarded compositor action receipt is malformed")
        if any(isinstance(value, dict) and value.get("phase") == phase for value in intervals):
            raise ToolError("guarded compositor action interval phase was duplicated")
        counts: dict[str, int] = {}
        for key in ("events", "metadata_events", "transition_events", "fatal_events"):
            value = summary.get(key, 0)
            if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                raise ToolError("guarded compositor action interval has an invalid event count")
            counts[key] = value
        if counts["events"] != counts["metadata_events"] + counts["transition_events"] + counts["fatal_events"]:
            raise ToolError("guarded compositor action interval event classifications are inconsistent")
        event_sha256 = summary.get("event_sha256")
        if not isinstance(event_sha256, str) or re.fullmatch(r"[0-9a-f]{64}", event_sha256) is None:
            raise ToolError("guarded compositor action interval digest is malformed")
        interval = {
            "phase": phase,
            "start_sequence": summary.get("start_sequence"),
            "end_sequence": summary.get("end_sequence"),
            **counts,
            "event_sha256": event_sha256,
        }
        start_sequence = interval.get("start_sequence")
        end_sequence = interval.get("end_sequence")
        if (
            not isinstance(start_sequence, int)
            or isinstance(start_sequence, bool)
            or not isinstance(end_sequence, int)
            or isinstance(end_sequence, bool)
            or start_sequence < 0
            or end_sequence < start_sequence
        ):
            raise ToolError("guarded compositor action interval has invalid sequence bounds")
        if intervals:
            previous_end = intervals[-1].get("end_sequence")
            if previous_end != start_sequence:
                raise ToolError("guarded compositor action intervals are not contiguous")
        intervals.append(interval)
        for key, value in counts.items():
            receipt[key] = int(receipt.get(key, 0)) + value
        receipt["event_types"] = sorted({
            *[value for value in receipt.get("event_types", []) if isinstance(value, str)],
            *[value for value in summary.get("event_types", []) if isinstance(value, str)],
        })
        receipt["changes"] = sorted({
            *[value for value in receipt.get("changes", []) if isinstance(value, str)],
            *[value for value in summary.get("changes", []) if isinstance(value, str)],
        })
        samples = receipt.get("samples")
        if not isinstance(samples, list):
            raise ToolError("guarded compositor action receipt is malformed")
        summary_samples = summary.get("samples", [])
        if not isinstance(summary_samples, list):
            raise ToolError("guarded compositor action interval samples are malformed")
        for value in summary_samples:
            if len(samples) >= COMPOSITOR_EVENT_MAX_SAMPLES:
                break
            if isinstance(value, dict):
                samples.append({"phase": phase, **value})
        prior = receipt.get("event_chain_sha256")
        if not isinstance(prior, str) or re.fullmatch(r"[0-9a-f]{64}", prior) is None:
            raise ToolError("guarded compositor action receipt chain is malformed")
        receipt["event_chain_sha256"] = hashlib.sha256(
            prior.encode("ascii") + canonical_json(interval)
        ).hexdigest()

    @classmethod
    def _finalize_compositor_action_receipt(cls, receipt: dict[str, Any]) -> None:
        intervals = receipt.get("intervals")
        barriers = receipt.get("barriers")
        if not isinstance(intervals, list) or not isinstance(barriers, dict):
            raise ToolError("guarded compositor action receipt is malformed at completion")
        if receipt.get("complete") is not None or receipt.get("transaction_sha256") is not None:
            raise ToolError("guarded compositor action receipt was finalized more than once")
        phases = [value.get("phase") for value in intervals if isinstance(value, dict)]
        outcome_requested = receipt.get("outcome_requested")
        if not isinstance(outcome_requested, bool):
            raise ToolError("guarded compositor outcome request state is malformed")
        post_index = 5 if outcome_requested else 4
        if (
            len(phases) < post_index + 1
            or len(phases) != len(intervals)
            or phases[:4] != ["validation", "pre-dispatch", "dispatch", "settlement"]
            or (outcome_requested and phases[4] != "outcome-wait")
            or phases[post_index] != "post-observation"
            or any(
                value != f"post-observation-retry-{index}"
                for index, value in enumerate(phases[post_index + 1:], start=2)
            )
        ):
            raise ToolError("guarded compositor action receipt has incomplete phase coverage")
        expected_barrier_phases = [
            "validation-start", "validation-complete", "dispatch-ready", "dispatch-complete", "settled",
            *(["outcome-complete"] if outcome_requested else []),
            *phases[post_index:],
        ]
        if list(barriers) != expected_barrier_phases or len(barriers) != len(intervals) + 1:
            raise ToolError("guarded compositor action receipt has an invalid barrier phase chain")
        ticks_per_barrier = receipt.get("ticks_per_logical_barrier")
        sway_ticks = receipt.get("sway_ticks")
        if (
            ticks_per_barrier != COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
            or not isinstance(sway_ticks, int)
            or isinstance(sway_ticks, bool)
            or sway_ticks != len(barriers) * COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
        ):
            raise ToolError("guarded compositor action physical tick accounting is inconsistent")
        sequences = list(barriers.values())
        if (
            any(not isinstance(value, int) or isinstance(value, bool) or value < 0 for value in sequences)
            or any(right <= left for left, right in zip(sequences, sequences[1:]))
        ):
            raise ToolError("guarded compositor action barrier sequence is not strictly ordered")
        for index, interval in enumerate(intervals):
            if (
                not isinstance(interval, dict)
                or interval.get("start_sequence") != sequences[index]
                or interval.get("end_sequence") != sequences[index + 1]
            ):
                raise ToolError("guarded compositor action receipt does not match its barrier chain")
        attempts = receipt.get("post_observation_attempts")
        invalidated = receipt.get("invalidated_post_observations")
        unstable_captures = receipt.get("unstable_post_observation_captures")
        post_intervals = len(phases) - post_index
        if (
            not isinstance(attempts, int)
            or isinstance(attempts, bool)
            or attempts != post_intervals
            or not isinstance(invalidated, int)
            or isinstance(invalidated, bool)
            or not isinstance(unstable_captures, int)
            or isinstance(unstable_captures, bool)
            or invalidated < 0
            or unstable_captures < 0
            or invalidated + unstable_captures != attempts - 1
        ):
            raise ToolError("guarded compositor post-observation accounting is inconsistent")
        recomputed_counts = {
            key: sum(int(interval.get(key, -1)) for interval in intervals)
            for key in ("events", "metadata_events", "transition_events", "fatal_events")
        }
        if any(int(receipt.get(key, -1)) != value for key, value in recomputed_counts.items()):
            raise ToolError("guarded compositor action aggregate event counts are inconsistent")
        if recomputed_counts["fatal_events"] != 0:
            raise ToolError("guarded compositor action receipt contains a fatal compositor event")
        chain = "0" * 64
        for interval in intervals:
            chain = hashlib.sha256(chain.encode("ascii") + canonical_json(interval)).hexdigest()
        if receipt.get("event_chain_sha256") != chain:
            raise ToolError("guarded compositor action event chain digest is inconsistent")
        authority = receipt.get("authority")
        if (
            not isinstance(authority, dict)
            or authority.get("schema") != COMPOSITOR_ACTION_AUTHORITY_SCHEMA
            or authority.get("digest") != COMPOSITOR_ACTION_AUTHORITY_DIGEST
        ):
            raise ToolError("guarded compositor action authority is missing at completion")
        action_name = receipt.get("action")
        if not isinstance(action_name, str) or authority.get("action") != action_name:
            raise ToolError("guarded compositor action authority names a different action")
        binding_digest = cls._validate_compositor_observation_binding(
            authority.get("observation"), "reviewed"
        )
        post_binding_digest = cls._validate_compositor_observation_binding(
            authority.get("post_observation"), "post-action"
        )
        for key in (
            "requested_action_sha256", "outcome_policy_sha256", "reviewed_authority_sha256",
            "validated_action_sha256", "dispatch_authority_sha256",
            "outcome_result_sha256", "outcome_authority_sha256",
            "post_observation_authority_sha256",
        ):
            value = authority.get(key)
            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                raise ToolError("guarded compositor action authority digest is incomplete")
        reviewed_projection = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "observation_binding_sha256": binding_digest,
            "requested_action_sha256": authority["requested_action_sha256"],
            "outcome_policy_sha256": authority["outcome_policy_sha256"],
        }
        if authority["reviewed_authority_sha256"] != cls._authority_digest(reviewed_projection):
            raise ToolError("guarded compositor reviewed authority digest is inconsistent")
        dispatch_projection = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "reviewed_authority_sha256": authority["reviewed_authority_sha256"],
            "validated_action_sha256": authority["validated_action_sha256"],
        }
        if authority["dispatch_authority_sha256"] != cls._authority_digest(dispatch_projection):
            raise ToolError("guarded compositor dispatch authority digest is inconsistent")
        expected_difference = authority["validated_action_sha256"] != authority["requested_action_sha256"]
        if authority.get("validated_action_differs") is not expected_difference:
            raise ToolError("guarded compositor validated-action comparison is incomplete")
        outcome_seal = receipt.get("outcome_seal")
        if outcome_requested:
            if (
                not isinstance(outcome_seal, dict)
                or outcome_seal.get("schema") != OUTCOME_SEAL_SCHEMA
                or outcome_seal.get("enforced") is not True
            ):
                raise ToolError("guarded compositor outcome seal is missing at completion")
        elif outcome_seal is not None:
            raise ToolError("guarded compositor receipt contains an unrequested outcome seal")
        if authority["outcome_result_sha256"] != cls._authority_digest(outcome_seal):
            raise ToolError("guarded compositor outcome result digest is inconsistent")
        outcome_projection = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "dispatch_authority_sha256": authority["dispatch_authority_sha256"],
            "outcome_policy_sha256": authority["outcome_policy_sha256"],
            "outcome_result_sha256": authority["outcome_result_sha256"],
        }
        if authority["outcome_authority_sha256"] != cls._authority_digest(outcome_projection):
            raise ToolError("guarded compositor outcome authority digest is inconsistent")
        post_projection = {
            "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
            "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
            "action": action_name,
            "dispatch_authority_sha256": authority["dispatch_authority_sha256"],
            "outcome_authority_sha256": authority["outcome_authority_sha256"],
            "post_observation_binding_sha256": post_binding_digest,
        }
        if authority["post_observation_authority_sha256"] != cls._authority_digest(post_projection):
            raise ToolError("guarded compositor post-observation authority digest is inconsistent")
        frame_fence_requested = receipt.get("frame_fence_requested")
        frame_fence_receipt = receipt.get("frame_fence")
        if not isinstance(frame_fence_requested, bool):
            raise ToolError("guarded compositor FrameFenceSeal request state is malformed")
        if frame_fence_requested:
            if (
                not isinstance(frame_fence_receipt, dict)
                or frame_fence_receipt.get("schema") != FRAME_FENCE_SCHEMA
                or frame_fence_receipt.get("enforced") is not True
                or frame_fence_receipt.get("capture_complete") is not True
                or frame_fence_receipt.get("validated_for_dispatch") is not True
                or frame_fence_receipt.get("exact_pixels_stable") is not True
                or frame_fence_receipt.get("cursor_single_observation_attempt") is not True
                or frame_fence_receipt.get("raw_cursor_retained_by_controller") is not False
                or frame_fence_receipt.get("completion_recapture_required") is not True
                or not isinstance(frame_fence_receipt.get("pointer_latch_handoff"), bool)
            ):
                raise ToolError("guarded compositor FrameFenceSeal receipt is incomplete")
            for key in (
                "screen_sha256", "capture_arguments_sha256", "capture_source_sha256",
            ):
                value = frame_fence_receipt.get(key)
                if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                    raise ToolError("guarded compositor FrameFenceSeal digest is malformed")
            phase = frame_fence_receipt.get("validation_phase")
            pointer_handoff_phases = {
                "pre-hover+pointer-latch-handoff",
                "pre-input+locked-pointer-no-input-latch-handoff",
            }
            if phase not in {"post-tick-pre-dispatch", *pointer_handoff_phases}:
                raise ToolError("guarded compositor FrameFenceSeal phase is invalid")
            if (phase in pointer_handoff_phases) is not frame_fence_receipt[
                "pointer_latch_handoff"
            ]:
                raise ToolError("guarded compositor FrameFenceSeal handoff is inconsistent")
        elif frame_fence_receipt is not None:
            raise ToolError("guarded compositor receipt contains an unrequested FrameFenceSeal")
        receipt["complete"] = True
        receipt["phase_order"] = phases
        receipt["interval_count"] = len(intervals)
        receipt["first_barrier_sequence"] = sequences[0]
        receipt["final_barrier_sequence"] = sequences[-1]
        receipt["barrier_count"] = len(sequences)
        projection = dict(receipt)
        projection.pop("transaction_sha256", None)
        receipt["transaction_sha256"] = hashlib.sha256(canonical_json(projection)).hexdigest()

    @staticmethod
    def _reject_compositor_interval(
        summary: dict[str, Any],
        context: str,
        *,
        reject_transitions: bool,
    ) -> None:
        fatal = int(summary.get("fatal_events", 0))
        transitions = int(summary.get("transition_events", 0))
        if not fatal and not (reject_transitions and transitions):
            return
        changes = summary.get("changes")
        detail = ",".join(str(value) for value in changes[:8]) if isinstance(changes, list) else "unknown"
        if fatal:
            raise ToolError(f"compositor environment changed {context}: {detail}"[:1024])
        raise ToolError(f"compositor target changed {context}; guarded action was withheld: {detail}"[:1024])

    @staticmethod
    def _retryable_post_observation_capture(error: Exception) -> bool:
        """Admit only read-only capture races after an action already dispatched.

        Replaying the action would be unsafe because it may have completed.  A
        fresh capture is side-effect free, so the bounded post-observation loop
        may retry these exact topology/authority races while retaining the same
        action receipt.  Every other error still fails immediately.
        """
        return (
            isinstance(error, ToolError)
            and str(error) in POST_OBSERVATION_RETRYABLE_CAPTURE_ERRORS
        )

    def step(self, arguments: dict[str, Any]) -> dict[str, Any]:
        identifier = as_string(arguments.get("observation_id"), "observation_id", maximum=128, allow_empty=False)
        action = arguments.get("action")
        if not isinstance(action, dict) or not isinstance(action.get("name"), str):
            raise ToolError("action must contain a desktop tool name and optional arguments object")
        action_name = action["name"]
        action_arguments = action.get("arguments", {})
        if not isinstance(action_arguments, dict):
            raise ToolError("action.arguments must be an object")
        allowed = {
            "desktop_accessibility_action", "desktop_accessibility_focus", "desktop_accessibility_text",
            "desktop_accessibility_value", "desktop_accessibility_perform", "desktop_accessibility_scroll",
            "desktop_accessibility_selection", "desktop_move", "desktop_click", "desktop_touch",
            "desktop_touch_swipe", "desktop_touch_gesture", "desktop_touchpad_swipe", "desktop_touchpad_pinch", "desktop_touchpad_hold", "desktop_tablet_pad_ring", "desktop_tablet_pad_strip", "desktop_tablet_pad_button", "desktop_tablet_pad_mode", "desktop_relative_motion", "desktop_stylus_hover", "desktop_stylus_stroke", "desktop_eraser_stroke", "desktop_drag", "desktop_drop", "desktop_scroll", "desktop_type", "desktop_paste", "desktop_copy", "desktop_clipboard", "desktop_key", "desktop_focus",
            "desktop_move_resize", "desktop_window_state", "desktop_close", "desktop_launch", "desktop_terminate",
        }
        if action_name not in allowed:
            raise ToolError("desktop_step action is not an approved mutating desktop tool")
        self._prune_observations()
        observation = self.observations.get(identifier)
        if observation is None or observation.consumed:
            raise ToolError("observation token is absent, expired, or already consumed")
        if time.monotonic() - observation.created > OBSERVATION_TTL_SECONDS:
            self.observations.pop(identifier, None)
            raise ToolError("observation token expired")
        # A valid token authorizes one attempt, not one successful dispatch.
        # Consume before any context, scene, or target validation so a failed
        # check cannot be retried against a subtly different desktop state.
        observation.consumed = True
        self.journal.append(
            "guarded-attempt",
            action_name,
            {
                "observation_id": identifier,
                "launch_id": observation.launch_id,
                "scene_id": observation.scene_id,
                "scene_launch_ids": list(observation.scene_launch_ids),
                "action_arguments": action_arguments,
            },
            {"token_consumed": True},
        )
        semantic_action = action_name.startswith("desktop_accessibility_")
        managed: ManagedProcess | None = None
        scene_members: list[ManagedProcess] = []
        if observation.launch_id is not None:
            if observation.scene_id is not None or observation.scene_launch_ids:
                raise ToolError("guarded observation mixes launch and scene authority")
            managed = self._managed_by_launch_id(observation.launch_id)
            self._activate_launch_workspace(managed)
        elif observation.scene_id is not None:
            scene_members = self._managed_scene(
                observation.scene_id,
                expected_launch_ids=observation.scene_launch_ids,
            )
            self._activate_scene_workspace(scene_members)
        event_scope: dict[str, Any] | None = None
        if observation.event_fence is not None:
            if not self.is_wayland:
                raise ToolError("EventFenceSeal requires the private Wayland backend")
            if managed is not None:
                event_scope = {
                    "kind": "launch",
                    "launch_ids": [managed.launch_id],
                    "scene_id": None,
                }
            elif scene_members and observation.scene_id is not None:
                event_scope = {
                    "kind": "scene",
                    "launch_ids": list(observation.scene_launch_ids),
                    "scene_id": observation.scene_id,
                }
            else:
                raise ToolError(
                    "accessibility event fence lost its exact launch or scene authority"
                )
        outcome_policy = self._normalize_outcome_policy(arguments.get("outcome"), observation)

        # TickSeal begins before pixel/semantic revalidation. The workspace
        # lease is reacquired first because that operation is explicit scope
        # setup, not part of the reviewed application mutation. Every later
        # compositor transition through dispatch and the fresh observation is
        # ordered into one receipt.
        action_event_receipt: dict[str, Any] | None = None
        action_event_validation_start_sequence: int | None = None
        action_event_validation_complete_sequence: int | None = None
        action_event_dispatch_sequence: int | None = None
        action_event_complete_sequence: int | None = None
        action_event_settled_sequence: int | None = None
        action_event_outcome_sequence: int | None = None
        if self.is_wayland:
            action_event_receipt = self._new_compositor_action_receipt(
                action_name,
                observation,
                action_arguments,
                outcome_policy,
            )
            action_event_validation_start_sequence = self._compositor_action_barrier(
                action_event_receipt, "validation-start"
            )

        current_semantic: dict[str, Any] | None = None
        current_node_ids: tuple[str, ...] = ()
        current_scene_transient_map: dict[str, Any] | None = None
        current_scene_occlusion_map: dict[str, Any] | None = None
        if observation.semantic_sha256 is not None:
            if observation.semantic_options is None:
                raise ToolError("guarded observation lost its accessibility options")
            (
                current_image, current_crop, current_window, active_signature, window_signature,
                current_semantic, current_semantic_sha256, current_node_ids, _pair_difference,
                current_capture_source, current_scene_transient_map,
                current_scene_occlusion_map,
            ) = self._capture_semantic_pair(
                observation.capture_arguments,
                dict(observation.semantic_options),
            )
            if current_semantic_sha256 != observation.semantic_sha256:
                raise ToolError("desktop accessibility scene changed since observation")
        else:
            if semantic_action:
                raise ToolError("semantic desktop_step actions require an accessibility-bound observation")
            current_frame = self._capture_region(observation.capture_arguments)
            current_image = current_frame.image
            current_crop = current_frame.crop
            current_window = current_frame.window_id
            current_capture_source = self._capture_source_from_frame(current_frame)
            current_scene_transient_map = self._scene_transient_map_from_frame(
                current_frame, current_capture_source
            )
            current_scene_occlusion_map = self._scene_occlusion_map_from_frame(
                current_frame, current_capture_source
            )
            active_signature, window_signature = self._active_and_window_signatures()
        if current_crop != observation.capture_crop or current_window != observation.capture_window_id:
            raise ToolError("guarded capture envelope changed since observation")
        if observation.capture_source != current_capture_source:
            raise ToolError("guarded capture source identity changed since observation")
        if observation.scene_transient_map != current_scene_transient_map:
            raise ToolError("guarded scene transient ownership changed since observation")
        if observation.scene_occlusion_map != current_scene_occlusion_map:
            raise ToolError("guarded scene occlusion ownership changed since observation")
        launch_scene_authority_sha256: str | None = None
        scene_set_authority_sha256: str | None = None
        if current_capture_source.get("scope") == "launch-scene":
            value = current_capture_source.get("launch_scene_authority_sha256")
            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                raise ToolError("guarded launch-scene capture lost its action authority")
            launch_scene_authority_sha256 = value
        elif current_capture_source.get("scope") == "scene-set":
            value = current_capture_source.get("scene_set_authority_sha256")
            if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
                raise ToolError("guarded scene-set capture lost its action authority")
            scene_set_authority_sha256 = value
        current_hash = self._image_fingerprint(current_image)
        current_sample = self._visual_sample(current_image)
        frame_fence_receipt: dict[str, Any] | None = None
        if observation.frame_fence is not None:
            frame_fence_receipt = self._validate_frame_fence_for_step(
                observation.frame_fence,
                observation.capture_arguments,
                current_image,
                current_capture_source,
                phase="initial-revalidation",
            )
        threshold = self._step_difference_threshold(arguments.get("difference_threshold", SEMANTIC_PAIR_THRESHOLD))
        difference = self._visual_difference(observation.visual_sample, current_sample)
        if current_hash != observation.screen_sha256 and difference > threshold:
            raise ToolError(f"desktop changed since observation (visual difference {difference:.6f})")
        if active_signature != observation.active_signature or window_signature != observation.window_signature:
            raise ToolError("desktop window or focus state changed since observation")
        action_arguments = self._remap_semantic_node(
            observation, current_node_ids, action_name, action_arguments
        )
        if managed is not None:
            action_arguments = self._validate_scoped_action(
                managed,
                action_name,
                action_arguments,
                launch_scene_authority_sha256=launch_scene_authority_sha256,
            )
        elif scene_members:
            if scene_set_authority_sha256 is None:
                raise ToolError("guarded scene-set action lost its sealed capture authority")
            action_arguments = self._validate_scene_action(
                scene_members,
                action_name,
                action_arguments,
                scene_set_authority_sha256=scene_set_authority_sha256,
            )
        scene_active, scene_windows_signature, scene_windows, active_window_id = self._window_scene()
        if scene_active != active_signature or scene_windows_signature != window_signature:
            raise ToolError("desktop window or focus state changed during guarded-action validation")
        resolved_semantic_node: dict[str, Any] | None = None
        if semantic_action:
            if current_semantic is None:
                raise ToolError("semantic action is not bound to an accessibility observation")
            if action_name == "desktop_accessibility_perform":
                resolved_semantic_node = self.accessibility.resolve_from_snapshot(action_arguments, current_semantic)
            else:
                resolved_semantic_node = self._semantic_node_from_snapshot(current_semantic, action_arguments.get("node_id"))
        action_arguments = self._validate_observation_action(
            observation,
            action_name,
            action_arguments,
            scene_windows,
            active_window_id,
            current_semantic,
            resolved_semantic_node,
        )
        primary_paste = (
            action_name == "desktop_paste"
            and action_arguments.get("delivery") == "primary-middle-click"
        )
        pointer_action = (
            action_name in {
                "desktop_click", "desktop_touch", "desktop_touch_swipe",
                "desktop_touch_gesture", "desktop_touchpad_swipe",
                "desktop_touchpad_pinch", "desktop_touchpad_hold",
                "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
                "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
                "desktop_relative_motion",
                "desktop_stylus_hover", "desktop_stylus_stroke", "desktop_eraser_stroke", "desktop_scroll", "desktop_drag",
                "desktop_drop",
            }
            or primary_paste
        )
        if self.is_wayland:
            if action_event_receipt is None or action_event_validation_start_sequence is None:
                raise ToolError("guarded compositor validation seal was not initialized")
            self._bind_compositor_action_dispatch(
                action_event_receipt,
                action_name,
                action_arguments,
            )
            action_event_validation_complete_sequence = self._compositor_action_barrier(
                action_event_receipt, "validation-complete"
            )
            seal = self.compositor_event_seal
            if seal is None:
                raise ToolError("birth-pinned compositor event seal disappeared during validation")
            validation_summary = seal.summarize(
                action_event_validation_start_sequence,
                action_event_validation_complete_sequence,
            )
            self._merge_compositor_action_summary(
                action_event_receipt, "validation", validation_summary
            )
            self._reject_compositor_interval(
                validation_summary,
                "during guarded scene revalidation",
                reject_transitions=True,
            )

        # Pointer activation deliberately changes the reviewed scene by moving
        # the cursor and may reveal a tooltip or popup. Close FrameFenceSeal at
        # the last non-mutating moment immediately before that hover begins,
        # then hand authority to the existing two-frame FrameLatch. This avoids
        # treating the earlier initial recapture as if it were adjacent to the
        # pointer move after semantic/route validation has consumed time.
        if self.is_wayland and pointer_action and observation.frame_fence is not None:
            prehover_frame = self._capture_region(dict(observation.capture_arguments))
            prehover_image = prehover_frame.image
            prehover_crop = prehover_frame.crop
            prehover_window = prehover_frame.window_id
            prehover_source = self._capture_source_from_frame(prehover_frame)
            frame_fence_receipt = self._validate_frame_fence_for_step(
                observation.frame_fence,
                observation.capture_arguments,
                prehover_image,
                prehover_source,
                phase="pre-hover",
            )
            if (
                prehover_crop != observation.capture_crop
                or prehover_window != observation.capture_window_id
            ):
                raise ToolError("FrameFenceSeal pre-hover capture envelope changed")
            prehover_active, prehover_windows = self._active_and_window_signatures()
            if prehover_active != active_signature or prehover_windows != window_signature:
                raise ToolError(
                    "desktop topology changed during pre-hover FrameFenceSeal recapture"
                )
            current_image = prehover_image
            current_crop = prehover_crop

        pointer_route = None
        if self.is_wayland and pointer_action:
            pointer_route = self._pointer_route(
                action_name,
                action_arguments,
                scene_windows,
                observation.launch_id,
                launch_scene_authority_sha256,
                scene_set_authority_sha256=scene_set_authority_sha256,
                scene_launch_ids=(
                    observation.scene_launch_ids if scene_members else None
                ),
                scene_id=observation.scene_id if scene_members else None,
                scene_transient_map=current_scene_transient_map,
                scene_occlusion_map=current_scene_occlusion_map,
            )
            if pointer_route is None:
                raise ToolError("MotionSeal pointer action lost its guarded coordinate route")
        pointer_latch = None
        if self.is_wayland and pointer_action:
            if pointer_route is None:
                raise ToolError("MotionSeal pointer latch lost its precomputed route")
            pointer_latch = self._latch_pointer_activation(
                observation,
                action_name,
                action_arguments,
                pointer_route,
                current_image,
                current_crop,
                active_signature,
                window_signature,
                threshold,
                as_number(
                    arguments.get(
                        "pointer_target_difference_threshold",
                        POINTER_LATCH_TARGET_THRESHOLD,
                    ),
                    0.0,
                    POINTER_LATCH_TARGET_THRESHOLD,
                    "pointer_target_difference_threshold",
                ),
                as_int(
                    arguments.get(
                        "pointer_settle_milliseconds",
                        POINTER_LATCH_DEFAULT_SETTLE_MILLISECONDS,
                    ),
                    POINTER_LATCH_MIN_SETTLE_MILLISECONDS,
                    POINTER_LATCH_MAX_SETTLE_MILLISECONDS,
                    "pointer_settle_milliseconds",
                ),
            )
        keyboard_target = None
        if (
            self.is_wayland
            and action_name in {"desktop_click", "desktop_scroll", "desktop_drag"}
            and action_arguments.get("modifiers")
        ):
            keyboard_target = self._keyboard_target(
                scene_windows,
                active_window_id,
                observation.launch_id,
                observation.scene_launch_ids if scene_members else None,
                observation.scene_id if scene_members else None,
                scene_set_authority_sha256,
            )
            if pointer_route is None:
                raise ToolError("modified pointer input lost its guarded coordinate route")
            self._assert_modified_pointer_target(pointer_route, keyboard_target)
        elif self.is_wayland and (
            action_name in {"desktop_type", "desktop_paste", "desktop_key"}
            or (
                action_name == "desktop_copy"
                and action_arguments.get("source", "selection") == "selection"
            )
        ):
            keyboard_target = self._keyboard_target(
                scene_windows,
                active_window_id,
                observation.launch_id,
                observation.scene_launch_ids if scene_members else None,
                observation.scene_id if scene_members else None,
                scene_set_authority_sha256,
            )
        final_active, final_windows = self._active_and_window_signatures()
        if final_active != active_signature or final_windows != window_signature:
            raise ToolError("desktop window or focus state changed before guarded-action dispatch")

        if self.is_wayland:
            if action_event_receipt is None or action_event_validation_complete_sequence is None:
                raise ToolError("guarded compositor validation receipt is incomplete")
            action_event_dispatch_sequence = self._compositor_action_barrier(
                action_event_receipt, "dispatch-ready"
            )
            seal = self.compositor_event_seal
            if seal is None:
                raise ToolError("birth-pinned compositor event seal disappeared before dispatch")
            predispatch_summary = seal.summarize(
                action_event_validation_complete_sequence, action_event_dispatch_sequence
            )
            self._merge_compositor_action_summary(
                action_event_receipt, "pre-dispatch", predispatch_summary
            )
            self._reject_compositor_interval(
                predispatch_summary,
                "after guarded validation and before dispatch",
                reject_transitions=True,
            )
            if observation.event_fence is not None:
                if event_scope is None:
                    raise ToolError("accessibility event fence scope is unavailable")
                action_event_receipt["event_fence"] = (
                    self.accessibility.validate_event_fence(
                        observation.event_fence,
                        event_scope,
                    )
                )
            if observation.frame_fence is not None:
                if frame_fence_receipt is None:
                    raise ToolError("FrameFenceSeal lost its initial exact-pixel validation")
                if pointer_action:
                    if pointer_latch is None:
                        raise ToolError(
                            "FrameFenceSeal pointer action lost its PointerLatch handoff"
                        )
                    latch_kind = pointer_latch.get("latch_kind")
                    if latch_kind == "motion-seal-hover-stabilization":
                        validation_phase = "pre-hover+pointer-latch-handoff"
                    elif latch_kind == "locked-pointer-no-input-stabilization":
                        validation_phase = (
                            "pre-input+locked-pointer-no-input-latch-handoff"
                        )
                    else:
                        raise ToolError(
                            "FrameFenceSeal pointer action returned an unknown PointerLatch kind"
                        )
                    frame_fence_receipt = dict(frame_fence_receipt)
                    frame_fence_receipt.update({
                        "validation_phase": validation_phase,
                        "pointer_latch_handoff": True,
                    })
                else:
                    frame_fence_receipt = self._recapture_frame_fence_for_step(
                        observation.frame_fence,
                        observation.capture_arguments,
                        phase="post-tick-pre-dispatch",
                    )
                    frame_fence_receipt["pointer_latch_handoff"] = False
                    exact_active, exact_windows = self._active_and_window_signatures()
                    if (
                        exact_active != active_signature
                        or exact_windows != window_signature
                    ):
                        raise ToolError(
                            "desktop topology changed during final FrameFenceSeal recapture"
                        )
                action_event_receipt["frame_fence"] = frame_fence_receipt

        handler = self._handlers().get(action_name)
        if handler is None:
            raise ToolError("desktop_step action handler is unavailable")

        keyboard_fence = None
        pointer_fence = None
        output_snapshot_fence: dict[str, Any] | None = None
        copied_image_content: dict[str, Any] | None = None
        deferred_file_copy: DeferredFileCopy | None = None
        deferred_output_watch: DeferredOutputWatch | None = None
        result: dict[str, Any] | None = None
        try:
            if action_name == "desktop_accessibility_perform":
                if resolved_semantic_node is None:
                    raise ToolError("semantic perform requires an accessibility-bound observation")
                result = json_result(self.accessibility.perform_resolved(action_arguments, resolved_semantic_node))
            elif action_name == "desktop_type" and keyboard_target is not None:
                action_result, keyboard_fence = self._fenced_type_text(action_arguments, keyboard_target)
                result = json_result(action_result)
            elif action_name == "desktop_paste" and primary_paste:
                if keyboard_target is None or pointer_route is None:
                    raise ToolError(
                        "PrimaryPasteSeal lost its exact active-window or pointer-route authority"
                    )
                action_result, pointer_fence = self._fenced_primary_paste(
                    action_arguments,
                    keyboard_target,
                    pointer_route,
                )
                result = json_result(action_result)
            elif action_name == "desktop_paste" and keyboard_target is not None:
                action_result, keyboard_fence = self._fenced_rich_paste(
                    action_arguments, keyboard_target
                )
                result = json_result(action_result)
            elif action_name == "desktop_key" and keyboard_target is not None:
                action_result, keyboard_fence = self._fenced_key(action_arguments, keyboard_target)
                result = json_result(action_result)
            elif (
                action_name == "desktop_copy"
                and action_arguments.get("source") == "launch-output"
            ):
                if observation.launch_id is None:
                    raise ToolError(
                        "OutputSnapshotSeal lost its exact launch-scoped observation"
                    )
                output_kind = action_arguments.get("kind")
                if output_kind == "watch":
                    output_snapshot_fence, deferred_output_watch = (
                        self._defer_output_watch(
                            action_arguments,
                            observation.launch_id,
                        )
