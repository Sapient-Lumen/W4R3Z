sc_write_development_command_helpers() {
  {
    printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
    printf 'environment=%q\n' "$SC_AGENT_ENV"
    sc_emit_agent_environment_helper_body
  } | sc_atomic "$SC_AGENT_BIN/sandcodex-env" 500

  {
    printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
    printf 'exec %q "$@"\n' "$SC_LOCAL/launcher/sandcodex"
  } | sc_atomic "$SC_AGENT_BIN/sandcodex" 500

  {
    cat <<'EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
case "${1-}" in
  -h|--help|help)
    printf "usage: apply_patch [PATCH]\n       apply_patch < PATCH\n"
    exit 0
    ;;
esac
patch=${1-}
if [[ $# -eq 0 ]]; then
  patch="$(cat)"
elif [[ $# -gt 1 ]]; then
  printf "apply_patch: expected patch on stdin or as one argument\n" >&2
  exit 64
fi
if [[ -z "$patch" ]]; then
  printf "apply_patch: empty patch\n" >&2
  exit 64
fi
EOF
    printf 'exec %q --codex-run-as-apply-patch "$%s"\n' "$SC_CODEX" "patch"
  } | sc_atomic "$SC_AGENT_BIN/apply_patch" 500

  sc_write_worker_helper
}

sc_prepare_development_venv() {
  SC_DEV_VENV="$SC_WORK/dev/venv"
  local marker="$SC_DEV_VENV/.sandcodex-python-version" rebuild=0
  if [[ -e "$SC_DEV_VENV" || -L "$SC_DEV_VENV" ]]; then
    if [[ ! -d "$SC_DEV_VENV" || -L "$SC_DEV_VENV" || \
      "$(stat -c %u -- "$SC_DEV_VENV" 2>/dev/null || true)" != "$(id -u)" || \
      ! -f "$marker" || -L "$marker" || "$(<"$marker")" != "$SC_PYTHON_VERSION" || \
      ! -x "$SC_DEV_VENV/bin/python" || ! -x "$SC_DEV_VENV/bin/pip" ]]; then
      rebuild=1
    fi
  else
    rebuild=1
  fi
  if (( rebuild )); then
    if [[ -e "$SC_DEV_VENV" || -L "$SC_DEV_VENV" ]]; then
      [[ -d "$SC_DEV_VENV" && ! -L "$SC_DEV_VENV" && \
        "$(stat -c %u -- "$SC_DEV_VENV")" == "$(id -u)" ]] || \
        sc_die "refusing unsafe development virtual environment: $SC_DEV_VENV"
      sc_assert_no_mounts_at_or_below "$SC_DEV_VENV" 1 "development virtual environment"
      rm -rf -- "$SC_DEV_VENV"
    fi
    if ! PYTHONSAFEPATH=1 python3 -P -m venv --system-site-packages "$SC_DEV_VENV"; then
      rm -rf -- "$SC_DEV_VENV"
      sc_die "could not create the project Python virtual environment"
    fi
    printf '%s\n' "$SC_PYTHON_VERSION" | sc_atomic "$marker" 600
  fi
}

sc_prepare_development_git() {
  local real_git="$1" managed="$2" managed_marker="$2/SANDCODEX_MANAGED_VCS"
  local managed_initial=0 managed_gitlinks=0
  if [[ -d "$SC_PROJECT/.git" && ! -L "$SC_PROJECT/.git" ]]; then
    SC_GIT_MODE=native
  else
    SC_GIT_MODE=managed
    if [[ -e "$managed_marker" || -L "$managed_marker" ]]; then
      local managed_reason=""
      if [[ ! -d "$managed" || -L "$managed" ]]; then
        managed_reason="not a real directory"
      elif [[ ! -f "$managed_marker" || -L "$managed_marker" || \
        "$(stat -c %u -- "$managed_marker" 2>/dev/null || true)" != "$(id -u)" || \
        "$(stat -c %h -- "$managed_marker" 2>/dev/null || true)" != 1 ]]; then
        managed_reason="invalid marker"
      elif ! grep -Fx "uid=$(id -u)" "$managed_marker" >/dev/null; then
        managed_reason="marker uid does not match this user"
      elif ! grep -Fx "project=$SC_PROJECT" "$managed_marker" >/dev/null; then
        managed_reason="marker belongs to another project"
      fi
      if [[ -n "$managed_reason" ]]; then
        sc_quarantine_project_local_path "$managed" "managed Git state" "$managed_reason"
      else
        sc_ensure_dir "$managed" "managed Git state"
      fi
    fi
    if [[ ! -e "$managed_marker" && ! -L "$managed_marker" ]]; then
      if [[ -e "$managed" || -L "$managed" ]]; then
        sc_quarantine_project_local_path "$managed" "managed Git state" \
          "incomplete state without a marker"
      fi
      sc_ensure_dir "$managed" "managed Git state"
      sc_git_clean_env "$real_git" init --bare --quiet "$managed"
      sc_git_clean_env "$real_git" config --file "$managed/config" core.bare false
      sc_git_clean_env "$real_git" config --file "$managed/config" core.worktree "$SC_PROJECT"
      sc_ensure_dir "$managed/no-hooks" "managed Git hooks"
      sc_git_clean_env "$real_git" config --file "$managed/config" core.hooksPath "$managed/no-hooks"
      printf '/.sandcodex/\n' >"$managed/info/exclude"
      printf 'project=%s\nuid=%s\n' "$SC_PROJECT" "$(id -u)" | sc_atomic "$managed_marker" 600
    fi
    if ! sc_managed_git "$real_git" "$managed" \
      rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
      managed_initial=1
      sc_managed_git "$real_git" "$managed" \
        -c core.hooksPath="$managed/no-hooks" -c core.fsmonitor=false \
        add -A -- . ||
        sc_die "could not snapshot the initial managed Git worktree"
    fi
    managed_gitlinks="$(
      sc_managed_git "$real_git" "$managed" ls-files --stage |
        awk '$1 == "160000" { count += 1 } END { print count + 0 }'
    )" || sc_die "could not inspect the managed Git snapshot for embedded repositories"
    if (( managed_gitlinks > 0 )); then
      sc_die "selected project contains embedded Git repository entries ($managed_gitlinks); relaunch with --project set to the exact repository root"
    fi
    if (( managed_initial )); then
      sc_managed_git "$real_git" "$managed" \
        -c core.hooksPath="$managed/no-hooks" -c core.fsmonitor=false \
        -c user.name='Sandcodex Agent' -c user.email='sandcodex@localhost' \
        commit --allow-empty --quiet -m 'Initialize Sandcodex managed worktree' ||
        sc_die "could not create the initial managed Git baseline"
    fi
  fi
}

