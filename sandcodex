  printf 'args+=(--setenv SSL_CERT_FILE %q --setenv NIX_SSL_CERT_FILE %q --setenv SANDCODEX_DOWNLOADS %q --setenv GLASSTTY_HOME %q --chdir %q)\n' \
    "${SSL_CERT_FILE:-/etc/ssl/certs/ca-bundle.crt}" "${NIX_SSL_CERT_FILE:-${SSL_CERT_FILE:-/etc/ssl/certs/ca-bundle.crt}}" \
    "$SC_BROWSER_VISIBLE_DOWNLOADS" "$SC_GLASSTTY_RUNTIME_HOME" "$SC_PROJECT" >>"$tmp"
  printf 'exec %q "${args[@]}" --seccomp "$seccomp_fd" -- /run/sandcodex-browser/launch/browser-network "$@"\n' "$SC_BWRAP" >>"$tmp"
  chmod 700 "$tmp"; mv -fT -- "$tmp" "$SC_BROWSER_BOUNDARY"
