def ordinary_empty_directory(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        path.mkdir(mode=0o700)
        info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail("project must be an owned ordinary directory")
    if any(path.iterdir()):
        fail("project directory must be empty")
    path.chmod(0o700)


def exclusive_write(path: Path, content: str, mode: int = 0o644) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, mode)
    try:
        raw = content.encode("utf-8")
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def prepare(task_id: str, project: Path) -> dict[str, Any]:
    contract = task_contract(task_id)
    ordinary_empty_directory(project)
    for relative, content in contract["public_files"].items():
        exclusive_write(project / relative, content)
    directory = os.open(project, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return {
        "schema": SCHEMA_PREPARE,
        "bench_version": BENCH_VERSION,
        "bench_version_sha256": bench_digest(),
        "case_id": task_id,
        "task_digest_sha256": contract["task_digest_sha256"],
        "project": os.fspath(project.resolve()),
        "prompt_file": os.fspath((project / "TASK.md").resolve()),
        "source_file": contract["source"],
        "protected_files": contract["protected"],
        "public_file_sha256": {
            name: digest(content.encode("utf-8"))
            for name, content in sorted(contract["public_files"].items())
        },
    }


def read_regular(path: Path, maximum: int) -> bytes:
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > maximum:
            raise ValueError("unsafe regular file")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        content = b"".join(chunks)
        if len(content) > maximum:
            raise ValueError("oversized file")
        return content
    finally:
        os.close(descriptor)


def focused_inventory(project: Path, expected: set[str]) -> tuple[bool, int]:
    extras = 0
    unsafe = False
    ignored = {".git", ".sandcodex", "__pycache__", ".pytest_cache"}
    stack = [(project, "")]
    while stack:
        directory, prefix = stack.pop()
        with os.scandir(directory) as entries:
            for entry in entries:
                relative = f"{prefix}/{entry.name}" if prefix else entry.name
                if entry.name in ignored and not prefix:
                    if entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
                        unsafe = True
                    continue
                if entry.is_symlink():
                    unsafe = True
                    continue
                if entry.is_dir(follow_symlinks=False):
                    stack.append((Path(entry.path), relative))
                elif entry.is_file(follow_symlinks=False):
                    focused_test = (
                        "/" not in relative
                        and relative.startswith("test_")
                        and relative.endswith(".py")
                        and entry.stat(follow_symlinks=False).st_size <= MAX_SOURCE_BYTES
                    )
                    if relative not in expected and not focused_test:
                        extras += 1
                else:
                    unsafe = True
    return not unsafe and extras == 0, extras


def bounded_check(source: Path, task_id: str) -> dict[str, Any]:
    process = subprocess.Popen(
        [sys.executable, "-I", "-S", "-B", "-c", CHECK_CODE, os.fspath(source), task_id],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env={"PATH": "/nonexistent", "LC_ALL": "C", "PYTHONDONTWRITEBYTECODE": "1"},
        cwd=source.parent,
        start_new_session=True,
    )
    assert process.stdout is not None and process.stderr is not None
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    captured = {"stdout": bytearray(), "stderr": bytearray()}
    limited = False
    deadline = time.monotonic() + 4.0
    timed_out = False
    while selector.get_map():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break
        for key, _ in selector.select(min(remaining, 0.1)):
            chunk = os.read(key.fileobj.fileno(), 4096)
            if not chunk:
                selector.unregister(key.fileobj)
                continue
            bucket = captured[key.data]
            room = MAX_CAPTURE_BYTES - len(bucket)
            if room > 0:
                bucket.extend(chunk[:room])
            if len(chunk) > room:
                limited = True
    if timed_out or limited:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        returncode = process.wait(timeout=1.0)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        returncode = process.wait()
        timed_out = True
    return {
        "passed": returncode == 0 and not timed_out and not limited,
        "returncode": returncode,
        "timed_out": timed_out,
        "output_limited": limited,
    }


def grade(task_id: str, project: Path) -> dict[str, Any]:
    task = TASKS[task_id]
    contract = task_contract(task_id)
    expected_files = set(contract["public_files"])
    result: dict[str, Any] = {
        "schema": SCHEMA_GRADE,
        "bench_version": BENCH_VERSION,
        "bench_version_sha256": bench_digest(),
        "case_id": task_id,
        "task_digest_sha256": contract["task_digest_sha256"],
        "possible_points": 10,
        "candidate_output_retained": False,
        "grader_network": "isolated-by-launcher",
    }
    try:
        info = project.lstat()
        if not stat.S_ISDIR(info.st_mode):
            raise ValueError("candidate is not an ordinary directory")
        source = project / task["source"]
        before = {
            relative: read_regular(project / relative, MAX_SOURCE_BYTES)
            for relative in sorted(expected_files)
        }
        focused_before, extra_before = focused_inventory(project, expected_files)
        check = bounded_check(source, task_id)
        after = {
            relative: read_regular(project / relative, MAX_SOURCE_BYTES)
            for relative in sorted(expected_files)
        }
        focused_after, extra_after = focused_inventory(project, expected_files)
        stable = before == after
        visible_expected = task["files"]["test_visible.py"].encode("utf-8")
        assignment_expected = task["prompt"].encode("utf-8")
        visible_ok = before["test_visible.py"] == visible_expected and after["test_visible.py"] == visible_expected
        assignment_ok = before["TASK.md"] == assignment_expected and after["TASK.md"] == assignment_expected
        protected_ok = all(
            before[relative] == task["files"][relative].encode("utf-8")
            and after[relative] == task["files"][relative].encode("utf-8")
            for relative in task.get("protected", [])
        )
        focused = focused_before and focused_after
        extra_count = max(extra_before, extra_after)
        functional = check["passed"] and stable and protected_ok
        points = (7 if functional else 0) + (1 if visible_ok else 0) + (1 if assignment_ok else 0) + (1 if focused else 0)
        result.update(
            {
                "classification": "passed" if points == 10 else "incorrect",
                "points_awarded": points,
                "accepted": points == 10,
                "candidate_sha256": digest(before[task["source"]]),
                "checks": {
                    "functional_hidden_checks": functional,
                    "visible_test_integrity": visible_ok,
                    "assignment_integrity": assignment_ok,
                    "protected_file_integrity": protected_ok,
                    "focused_file_scope": focused,
                    "candidate_unchanged_during_grading": stable,
                },
                "scope_extra_file_count": extra_count,
                "execution": {
                    "returncode": check["returncode"],
                    "timed_out": check["timed_out"],
                    "output_limited": check["output_limited"],
                },
            }
        )
    except (FileNotFoundError, OSError, UnicodeError, ValueError):
        result.update(
            {
                "classification": "invalid_candidate",
                "points_awarded": 0,
                "accepted": False,
                "candidate_sha256": None,
                "checks": {
                    "functional_hidden_checks": False,
                    "visible_test_integrity": False,
                    "assignment_integrity": False,
                    "protected_file_integrity": False,
                    "focused_file_scope": False,
                    "candidate_unchanged_during_grading": False,
                },
                "scope_extra_file_count": None,
                "execution": {"returncode": None, "timed_out": False, "output_limited": False},
            }
        )
    return result


def load_comparison_report(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(read_regular(path, MAX_REPORT_BYTES))
    except (FileNotFoundError, OSError, UnicodeError, ValueError, json.JSONDecodeError):
        fail("comparison input is not a bounded ordinary benchmark report")
    if not isinstance(value, dict) or value.get("schema") != "sandcodex.agent-benchmark-run.v1":
        fail("comparison input has an unsupported schema")
    condition = value.get("condition")
    tasks = value.get("tasks")
    score = value.get("score")
    if not isinstance(condition, dict) or not isinstance(tasks, list) or not tasks or not isinstance(score, dict):
        fail("comparison input is missing benchmark condition, task, or score evidence")
    if condition.get("route") != "openrouter" or condition.get("provider") != "openrouter":
        fail("comparison accepts only exact-model OpenRouter benchmark runs")
    if not isinstance(condition.get("model"), str) or not condition["model"]:
        fail("comparison input does not identify an exact OpenRouter model")
    if value.get("status") not in {"completed", "incomplete"}:
        fail("comparison input has an invalid run status")
    if not isinstance(value.get("run_id"), str) or not value["run_id"]:
        fail("comparison input has no run identity")
    for field in ("bench_version_sha256", "launcher_artifact_sha256"):
        candidate = value.get(field)
        if (
            not isinstance(candidate, str)
            or len(candidate) != 64
            or any(character not in "0123456789abcdef" for character in candidate)
        ):
            fail("comparison input has an invalid benchmark or launcher digest")
    if (
        not isinstance(value.get("target"), str)
        or type(condition.get("turns_per_task")) is not int
        or condition["turns_per_task"] < 1
        or condition.get("network") != "provider-only"
        or condition.get("browser") is not False
        or condition.get("desktop") is not False
        or condition.get("subagents") is not False
    ):
        fail("comparison input has an invalid benchmark condition")
    score_fields = (
        "quality_points",
        "quality_possible_points",
        "accepted_tasks",
        "scored_tasks",
        "total_tasks",
        "infrastructure_failures",
    )
    if any(type(score.get(field)) is not int or score[field] < 0 for field in score_fields):
        fail("comparison input contains an invalid aggregate score")
    seen_cases: set[str] = set()
    seen_rungs: set[int] = set()
    for task in tasks:
        if not isinstance(task, dict):
            fail("comparison input contains a malformed task result")
        if (
            not isinstance(task.get("case_id"), str)
            or not isinstance(task.get("rung"), int)
            or task.get("outcome") not in {"passed", "incorrect", "infrastructure_error"}
            or not isinstance(task.get("scored"), bool)
            or not isinstance(task.get("task_digest_sha256"), str)
        ):
            fail("comparison input contains incomplete task evidence")
        if task["case_id"] in seen_cases or task["rung"] in seen_rungs:
            fail("comparison input repeats a task or rung")
        seen_cases.add(task["case_id"])
        seen_rungs.add(task["rung"])
        if task["scored"] != (task["outcome"] != "infrastructure_error"):
            fail("comparison input has inconsistent task scoring evidence")
        grade_value = task.get("grade")
        execution = task.get("execution")
        if not isinstance(grade_value, dict) or not isinstance(execution, dict):
            fail("comparison input contains incomplete grade or execution evidence")
        if (
            type(grade_value.get("points_awarded")) is not int
            or type(grade_value.get("possible_points")) is not int
            or grade_value["possible_points"] < 1
            or not 0 <= grade_value["points_awarded"] <= grade_value["possible_points"]
            or type(execution.get("wall_seconds")) is not int
            or execution["wall_seconds"] < 0
        ):
            fail("comparison input contains an invalid score")
    scored_tasks = [task for task in tasks if task["scored"]]
    infrastructure_failures = sum(
        task["outcome"] == "infrastructure_error" for task in tasks
    )
    if (
        score["total_tasks"] != len(tasks)
        or score["scored_tasks"] != len(scored_tasks)
        or score["infrastructure_failures"] != infrastructure_failures
        or score["accepted_tasks"]
        != sum(task["outcome"] == "passed" for task in scored_tasks)
        or score["quality_points"]
        != sum(task["grade"]["points_awarded"] for task in scored_tasks)
        or score["quality_possible_points"]
        != sum(task["grade"]["possible_points"] for task in scored_tasks)
        or (value["status"] == "completed") != (infrastructure_failures == 0)
    ):
        fail("comparison input aggregate score does not match its task evidence")
    return value


def median(values: list[int]) -> int | float | None:
    if not values:
        return None
    ordered = sorted(values)
    middle = len(ordered) // 2
    if len(ordered) % 2:
        return ordered[middle]
    total = ordered[middle - 1] + ordered[middle]
    return total // 2 if total % 2 == 0 else total / 2


def role_for_rung(rung: int) -> str:
    eligible = [candidate for candidate in ROUTING_ROLES if candidate <= rung]
    return ROUTING_ROLES[max(eligible)] if eligible else ROUTING_ROLES[0]


def comparison_signature(report: dict[str, Any]) -> dict[str, Any]:
    condition = report["condition"]
    return {
        "bench_version_sha256": report.get("bench_version_sha256"),
        "launcher_artifact_sha256": report.get("launcher_artifact_sha256"),
        "target": report.get("target"),
        "turns_per_task": condition.get("turns_per_task"),
        "network": condition.get("network"),
        "browser": condition.get("browser"),
        "desktop": condition.get("desktop"),
        "subagents": condition.get("subagents"),
        "tasks": [
            {
                "case_id": task["case_id"],
                "rung": task["rung"],
                "task_digest_sha256": task["task_digest_sha256"],
            }
            for task in report["tasks"]
        ],
    }


def compare(report_paths: list[Path]) -> dict[str, Any]:
    if len(report_paths) < 2:
        fail("comparison requires at least two benchmark run reports")
    reports = [load_comparison_report(path) for path in report_paths]
    run_ids = [report["run_id"] for report in reports]
    if len(set(run_ids)) != len(run_ids):
        fail("comparison input repeats a run identity")
    signature = comparison_signature(reports[0])
    if any(comparison_signature(report) != signature for report in reports[1:]):
        fail("benchmark runs are not comparable: launcher, course, budget, boundary, or task identity differs")

    expected_tasks = signature["tasks"]
    rungs = [task["rung"] for task in expected_tasks]
    if rungs != list(range(1, len(rungs) + 1)):
        fail("comparison requires a progressive course beginning at rung 1")
    groups: dict[str, list[dict[str, Any]]] = {}
    for report in reports:
        groups.setdefault(report["condition"]["model"], []).append(report)

    models: list[dict[str, Any]] = []
    for model, trials in groups.items():
        per_task = []
        for expected in expected_tasks:
            rows = [
                next(task for task in trial["tasks"] if task["case_id"] == expected["case_id"])
                for trial in trials
            ]
            scored = [row for row in rows if row["scored"]]
            passed = sum(row["outcome"] == "passed" for row in rows)
            infrastructure = sum(row["outcome"] == "infrastructure_error" for row in rows)
            per_task.append(
                {
                    "case_id": expected["case_id"],
                    "rung": expected["rung"],
                    "trials": len(rows),
                    "scored_trials": len(scored),
                    "passed_trials": passed,
                    "infrastructure_failures": infrastructure,
                    "quality_pass_rate": round(passed / len(scored), 4) if scored else None,
                    "operational_pass_rate": round(passed / len(rows), 4),
                }
            )

        quality_floor = 0
        operational_floor = 0
        for task in sorted(per_task, key=lambda row: row["rung"]):
            if task["scored_trials"] > 0 and task["passed_trials"] == task["scored_trials"]:
                quality_floor = task["rung"]
            else:
                break
        for task in sorted(per_task, key=lambda row: row["rung"]):
            if task["passed_trials"] == task["trials"]:
                operational_floor = task["rung"]
            else:
                break

        quality_points = sum(int(trial["score"]["quality_points"]) for trial in trials)
        quality_possible = sum(int(trial["score"]["quality_possible_points"]) for trial in trials)
        completed = sum(trial["status"] == "completed" for trial in trials)
        infrastructure = sum(int(trial["score"]["infrastructure_failures"]) for trial in trials)
        full_passes = sum(
            trial["status"] == "completed"
            and trial["score"]["accepted_tasks"] == trial["score"]["total_tasks"]
            for trial in trials
        )
        durations = [
            sum(int(task["execution"].get("wall_seconds", 0)) for task in trial["tasks"])
            for trial in trials
        ]
        models.append(
            {
                "model": model,
                "trials": len(trials),
                "run_ids": sorted(trial["run_id"] for trial in trials),
                "completed_trials": completed,
                "full_course_passes": full_passes,
                "infrastructure_failures": infrastructure,
                "infrastructure_clean_rate": round(completed / len(trials), 4),
                "quality_points": quality_points,
                "quality_possible_points": quality_possible,
                "quality_percent": round(quality_points / quality_possible, 4)
                if quality_possible
                else None,
                "quality_floor_rung": quality_floor,
                "quality_role": role_for_rung(quality_floor),
                "operational_floor_rung": operational_floor,
                "operational_role": role_for_rung(operational_floor),
                "median_wall_seconds": median(durations),
                "provisional": len(trials) < 3,
                "tasks": per_task,
            }
        )

    models.sort(
        key=lambda row: (
            -row["operational_floor_rung"],
            -row["quality_floor_rung"],
            -(row["full_course_passes"] / row["trials"]),
            -(row["quality_percent"] if row["quality_percent"] is not None else -1),
            -row["infrastructure_clean_rate"],
            row["median_wall_seconds"] if row["median_wall_seconds"] is not None else sys.maxsize,
            row["model"],
        )
    )
    for rank, row in enumerate(models, 1):
        row["rank"] = rank

    return {
        "schema": SCHEMA_COMPARISON,
        "comparison_sha256": digest(canonical(sorted(run_ids))),
        "provider": "openrouter",
        "run_count": len(reports),
        "model_count": len(models),
        "condition": signature,
        "ranking_policy": [
            "operational contiguous pass floor",
            "quality contiguous pass floor excluding infrastructure failures",
            "full-course pass rate",
            "quality points",
            "infrastructure-clean rate",
            "median wall time",
        ],
        "models": models,
        "retention": {
            "raw_prompt": False,
            "raw_provider_output": False,
            "credentials": False,
            "run_ids": True,
        },
        "limitations": [
            "A result with fewer than three trials is provisional.",
            "Quality and operational floors are separate so transport failures are not mislabeled as bad code.",
            "This comparison is a routing signal for this fixed course, not a general model ranking.",
        ],
    }


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("catalog")
    prepare_parser = commands.add_parser("prepare")
    prepare_parser.add_argument("--case", required=True, choices=TASKS)
    prepare_parser.add_argument("--project", required=True, type=Path)
    grade_parser = commands.add_parser("grade")
    grade_parser.add_argument("--case", required=True, choices=TASKS)
    grade_parser.add_argument("--project", required=True, type=Path)
    compare_parser = commands.add_parser("compare")
    compare_parser.add_argument("--report", action="append", required=True, type=Path)
    return root


def main() -> int:
    args = parser().parse_args()
    if args.command == "catalog":
        value = catalog()
    elif args.command == "prepare":
        value = prepare(args.case, args.project)
    elif args.command == "grade":
        value = grade(args.case, args.project)
    elif args.command == "compare":
        value = compare(args.report)
    else:
        fail("unknown command")
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
SANDCODEX_AGENT_BENCHMARK_PY
