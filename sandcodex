    rich_body, rich_bridge, rich_dropped = build_interaction(rich_request, "gemini-test")
    assert rich_dropped == 0
    assert [part["type"] for part in rich_body["input"][0]["content"]] == [
        "text", "image", "audio", "document"]
    assert rich_body["response_format"] == {
        "type": "text", "mime_type": "application/json",
        "schema": rich_request["text"]["format"]["schema"],
