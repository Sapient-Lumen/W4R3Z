sc_remote_models_bank() {
  local raw bank rc=0 free_json text_json tools_json agent_json
  (( SC_REMOTE_MODELS_FREE )) && free_json=true || free_json=false
  (( SC_REMOTE_MODELS_TEXT )) && text_json=true || text_json=false
  (( SC_REMOTE_MODELS_TOOLS )) && tools_json=true || tools_json=false
  (( SC_REMOTE_MODELS_AGENT )) && agent_json=true || agent_json=false
  raw="$(curl -fsSL --max-time 45 "$SC_REMOTE_MODELS_SOURCE")" || rc=$?
  (( rc == 0 )) || sc_die "OpenRouter model metadata fetch failed (curl exit $rc)" 69
  bank="$(jq -c \
    --arg schema "sandcodex.openrouter-model-bank.v1" \
    --arg source "$SC_REMOTE_MODELS_SOURCE" \
    --arg fetched_at "$(sc_now)" \
    --argjson only_free "$free_json" \
    --argjson text_output "$text_json" \
    --argjson require_tools "$tools_json" \
    --argjson require_agent "$agent_json" \
    --argjson limit "$SC_REMOTE_MODELS_LIMIT" '
      def arr(x): if (x|type) == "array" then x else [] end;
      def hasval(x; y): (arr(x) | index(y)) != null;
      def num(x): try (x | tonumber) catch 0;
      def price_zero(x): (x != null) and ((try (x | tonumber) catch -1) == 0);
      def cap(x; n): if x > n then n else x end;
      if (.data | type) != "array" then error("OpenRouter model response lacks data[]") else . end
      | [.data[] | select(type == "object")
        | {
            id:(.id // ""),
            canonical_slug:(.canonical_slug // null),
            name:(.name // ""),
            created:(.created // null),
            context_tokens:(.context_length // .top_provider.context_length // null),
            max_completion_tokens:(.top_provider.max_completion_tokens // null),
            prompt_price_per_token:(.pricing.prompt // null),
            completion_price_per_token:(.pricing.completion // null),
            input_modalities:arr(.architecture.input_modalities),
            output_modalities:arr(.architecture.output_modalities),
            supported_parameters:arr(.supported_parameters),
            tokenizer:(.architecture.tokenizer // null),
            instruct_type:(.architecture.instruct_type // null),
            reasoning:(.reasoning // null),
            top_provider:(.top_provider // null),
            per_request_limits:(.per_request_limits // null),
            description:(.description // "")
          }
        | .free = (price_zero(.prompt_price_per_token) and price_zero(.completion_price_per_token))
        | .text_input = hasval(.input_modalities; "text")
        | .text_output = hasval(.output_modalities; "text")
        | .tools = hasval(.supported_parameters; "tools")
        | .tool_choice = hasval(.supported_parameters; "tool_choice")
        | .structured_outputs = (hasval(.supported_parameters; "structured_outputs") or hasval(.supported_parameters; "response_format"))
        | .reasoning_parameter = hasval(.supported_parameters; "reasoning")
        | .agent_candidate = (.text_input and .text_output and .tools and .tool_choice)
        | .strength_score = (
            (if .agent_candidate then 1000 elif .tools then 700 else 0 end)
            + (if .tool_choice then 100 else 0 end)
            + (if .structured_outputs then 45 else 0 end)
            + (if .reasoning_parameter then 35 else 0 end)
            + (if (.id|test("coder|code|north"; "i")) then 80 else 0 end)
            + (if (.id|test("550b"; "i")) then 550
               elif (.id|test("120b"; "i")) then 120
               elif (.id|test("70b|72b"; "i")) then 70
               elif (.id|test("31b"; "i")) then 31
               elif (.id|test("30b|27b|26b"; "i")) then 28
               elif (.id|test("14b|12b"; "i")) then 13
               elif (.id|test("7b|8b"; "i")) then 8
               else 0 end)
            + cap(((.context_tokens // 0) / 65536); 20)
            + cap(((.max_completion_tokens // 0) / 32768); 20)
          )
        | .strength_basis = "agent tools/tool_choice first; coding-name bonus; rough parameter-size bonus; capped context/completion bonus; schema/reasoning bonus"
        | .launch_command = ("OPENROUTER_API_KEY=... sandcodex remote " + (.id | @sh) + " --provider openrouter")
        | select((.id | type) == "string" and (.id | length) > 0)
        | select(($only_free | not) or .free)
        | select(($text_output | not) or .text_output)
        | select(($require_tools | not) or .tools)
        | select(($require_agent | not) or .agent_candidate)]
      | sort_by(-(.strength_score // 0), -(.context_tokens // 0), -(.max_completion_tokens // 0), .id)
      | if $limit > 0 then .[:$limit] else . end
      | to_entries | map(.value + {rank:(.key + 1)})
      | {
          schema:$schema,
          result:"model_bank",
          provider:"openrouter",
          source_url:$source,
          fetched_at:$fetched_at,
          filters:{free:$only_free, text_output:$text_output, tools:$require_tools, agent:$require_agent, limit:$limit},
          model_count:length,
          qualification_run:false,
          models:.
        }' <<<"$raw")" || rc=$?
  (( rc == 0 )) || sc_die "OpenRouter model metadata could not be normalized" 78
  jq -e '.schema=="sandcodex.openrouter-model-bank.v1" and .provider=="openrouter" and (.models|type)=="array"' \
    <<<"$bank" >/dev/null || sc_die "OpenRouter model-bank helper returned invalid JSON" 78
  printf '%s\n' "$bank"
}

sc_remote_apply_bench_ranking() {
  local bank=$1 bench_path="$SC_GLOBAL/remote/openrouter-coding-bench-latest.json" ranked rc=0
  [[ -f "$bench_path" ]] || {
    printf '%s\n' "$bank"
    return
  }
  sc_owned_single_file "$bench_path" 600 "OpenRouter coding bench"
  ranked="$(jq -c --slurpfile bench "$bench_path" '
    def valid_bench:
      type == "object" and .schema == "sandcodex.openrouter-coding-bench.v1" and
      .provider == "openrouter" and (.models | type) == "array";
    def bench_for($id):
      first(($bench[0].models // [])[]? | select(.model == $id)) // null;
    if ($bench[0] | valid_bench | not) then
      .
    else
      .models |= (
        map(. as $model | (bench_for($model.id)) as $b |
          if $b == null then
            $model
          else
            $model + {
              coding_bench_rank:($b.coding_rank // null),
              coding_bench_score:($b.coding_rank_score // null),
              coding_bench_points:($b.score.points // null),
              coding_bench_possible_points:($b.score.possible_points // null),
              coding_bench_passed_tasks:($b.score.passed_tasks // null),
              coding_bench_total_tasks:($b.score.total_tasks // $b.score.task_count // null),
              coding_bench_created_at:($b.created_at // null),
              coding_bench_version:($bench[0].bench_version // null)
            }
          end
        )
        | sort_by(-(.coding_bench_score // -1), -(.strength_score // 0), -(.context_tokens // 0), .id)
        | to_entries | map(.value + {rank:(.key + 1)})
      )
      | .ranking_source = (if any(.models[]; has("coding_bench_score")) then
          "coding-bench-latest+metadata-fallback"
        else
          "metadata"
        end)
      | .coding_bench = {
          path:$bench[0].saved_path,
          created_at:$bench[0].created_at,
          bench_version:$bench[0].bench_version,
          model_count:($bench[0].model_count // 0)
        }
    end
  ' <<<"$bank")" || rc=$?
  if (( rc != 0 )); then
    sc_warn "OpenRouter coding bench ranking could not be applied; falling back to metadata ranking"
    printf '%s\n' "$bank"
    return
  fi
  printf '%s\n' "$ranked"
}

sc_remote_apply_profile_ranking() {
  local bank=$1 ranked rc=0
  ranked="$(jq -c --arg profile "$SC_REMOTE_PROFILE" '
    def n(x): (x // 0) | tonumber;
    def has_id($re): (.id | test($re; "i"));
    def bench: n(.coding_bench_score);
    def strength: n(.strength_score);
    def ctx: n(.context_tokens);
    def out: n(.max_completion_tokens);
    def bool_score(x; v): if x then v else 0 end;
    .models |= (
      map(. + {
        profile_score:(
          if $profile == "coding" then
            (bench * 1000) + strength + bool_score(.tools; 200) + bool_score(.tool_choice; 200) + bool_score(has_id("coder|code|north|nemotron|qwen"); 120)
          elif $profile == "long-context-reading" then
            (ctx / 1024) + (out / 512) + (bench * 25) + strength
          elif $profile == "fast-cheap-worker" then
            (bench * 60) + bool_score(has_id("mini|flash|nano|small|xs|lightning|2\\.6b|4b|8b"); 200000)
            + bool_score(.tools; 500) + bool_score(.tool_choice; 500)
            - bool_score(has_id("550b|120b|70b|72b"); 20000)
            + strength
          elif $profile == "tool-reliable" then
            (bench * 500) + bool_score(.tools; 10000) + bool_score(.tool_choice; 10000)
            + bool_score(.structured_outputs; 5000) + bool_score(.reasoning_parameter; 500)
            + strength
          elif $profile == "fallback" then
            (n(.coding_bench_passed_tasks) * 100000) + (n(.coding_bench_points) * 10000)
            + (bench * 10) + bool_score(.agent_candidate; 5000) + strength
          else
            (bench * 1000) + strength
          end
        ),
        profile:$profile
      })
      | sort_by(-(.profile_score // 0), -(.coding_bench_score // -1), -(.strength_score // 0), .id)
      | to_entries | map(.value + {rank:(.key + 1)})
    )
    | .model_count = (.models | length)
    | .profile = {
        name:$profile,
        policy:(if $profile == "coding" then
          "latest coding bench first, then metadata/tool heuristic"
        elif $profile == "long-context-reading" then
          "context and completion window first, with coding/tool scores as tie breakers"
        elif $profile == "fast-cheap-worker" then
          "small/flash/mini/nano worker models first, avoiding giant models unless needed"
        elif $profile == "tool-reliable" then
          "tool_choice, tools, structured outputs, and coding bench reliability first"
        elif $profile == "fallback" then
          "conservative bench-passing models first, then ordinary metadata strength"
        else
          "coding"
        end)
      }
    | .ranking_source = ((.ranking_source // "metadata") + "+profile:" + $profile)
  ' <<<"$bank")" || rc=$?
  if (( rc != 0 )); then
    sc_warn "OpenRouter profile ranking could not be applied; falling back to prior ranking"
    printf '%s\n' "$bank"
    return
  fi
  printf '%s\n' "$ranked"
}

