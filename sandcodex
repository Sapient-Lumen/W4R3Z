                # connection without requiring or synthesizing an application
                # text-input activation during startup.
                input_method_transaction.ping()
            self.input_method_transport_initialization = input_method_transaction.evidence()
            self.journal.append(
                "input-method-transport",
                "desktop-input-method-initialize",
                {
                    "payload_bytes": 0,
                    "input_emitted": False,
                    "probe": "bind-ping-destroy-without-activation-or-commit",
