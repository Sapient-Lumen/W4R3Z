    def _wayland_windows(self) -> list[dict[str, Any]]:
        self._reap_processes()
        values = self._walk_sway_tree(self._sway_json("get_tree"))
        launch_by_instance = {
            managed.launch_id: managed
            for managed in self.processes.values()
            if managed.security_context is not None
        }
        for value in values:
            instance = value.get("sandbox_instance_id")
            candidate = launch_by_instance.get(instance) if isinstance(instance, str) else None
            managed: ManagedProcess | None = None
            origin = "unmanaged"
            verified = False
            if candidate is not None and (
                value.get("sandbox_engine") == SANDBOX_ENGINE
                and value.get("sandbox_app_id") == candidate.application_id
                and instance == candidate.launch_id
            ):
                managed = candidate
                origin = "wayland-security-context"
                verified = True
            elif str(value.get("shell") or "").lower() == "xwayland":
                # Sway's compositor-wide Xwayland is disabled in native mode.
                # Opt-in X11 windows are exported by a launch-scoped satellite
                # as xdg-shell surfaces and therefore take the verified metadata
                # path above. A raw Xwayland surface is an unmanaged invariant
                # breach and must never gain authority from PID proximity.
                origin = "unmanaged-compositor-xwayland"
            value["launch_id"] = managed.launch_id if managed is not None else None
            value["scene_id"] = managed.scene_id if managed is not None else None
            value["managed_pid"] = managed.process.pid if managed is not None else None
            value["origin"] = origin
            value["origin_verified"] = verified
            value["grants"] = self._grants(managed) if managed is not None else None
        return values

    @staticmethod
    def _private_notification_layout(
        windows: list[dict[str, Any]],
        output_width: int,
        output_height: int,
    ) -> dict[int, dict[str, int]]:
        """Pack exact notification top-levels from top-right without overlap.

        Notification services remain independent launch principals in a scene
        set.  A global ``sticky`` rule would project each service across every
        workspace and collapse that isolation.  Instead the controller places
        only the exact currently attributed containers after workspace custody
        has been acquired.  The deterministic right-to-left column layout is
        derived entirely from compositor-observed natural heights.
        """
        if (
            isinstance(output_width, bool)
            or isinstance(output_height, bool)
            or not isinstance(output_width, int)
            or not isinstance(output_height, int)
        ):
            raise ToolError("private notification output geometry is invalid")
        available_width = output_width - 2 * PRIVATE_NOTIFICATION_MARGIN
        available_height = output_height - 2 * PRIVATE_NOTIFICATION_MARGIN
        width = min(PRIVATE_NOTIFICATION_WIDTH, available_width)
        if width < PRIVATE_NOTIFICATION_MIN_WIDTH or available_height < PRIVATE_NOTIFICATION_MIN_HEIGHT:
            raise ToolError("private output is too small for a bounded notification surface")

        result: dict[int, dict[str, int]] = {}
        x = output_width - PRIVATE_NOTIFICATION_MARGIN - width
        y = PRIVATE_NOTIFICATION_MARGIN
        for window in sorted(
            windows,
            key=lambda item: (str(item.get("launch_id") or ""), parse_window_id(item.get("id"))),
        ):
            identifier = parse_window_id(window.get("id"))
            height = window.get("height")
            if isinstance(height, bool) or not isinstance(height, int):
                raise ToolError("private notification surface has invalid compositor geometry")
            if not PRIVATE_NOTIFICATION_MIN_HEIGHT <= height <= available_height:
                raise ToolError("private notification surface exceeds its bounded output geometry")
            if y != PRIVATE_NOTIFICATION_MARGIN and y + height > output_height - PRIVATE_NOTIFICATION_MARGIN:
                x -= width + PRIVATE_NOTIFICATION_GAP
                y = PRIVATE_NOTIFICATION_MARGIN
            if x < PRIVATE_NOTIFICATION_MARGIN or y + height > output_height - PRIVATE_NOTIFICATION_MARGIN:
                raise ToolError("private notification surfaces cannot be placed without overlap")
            result[identifier] = {"x": x, "y": y, "width": width, "height": height}
            y += height + PRIVATE_NOTIFICATION_GAP
        return result

    def _place_private_notification_windows(
        self,
        members: list[ManagedProcess],
        workspace: str,
        windows: list[dict[str, Any]] | None = None,
    ) -> list[dict[str, Any]]:
        """Place and prove launch-private notification windows in one workspace."""
        member_by_launch = {managed.launch_id: managed for managed in members}
        if not member_by_launch:
            return windows if windows is not None else self._wayland_windows()
        current = windows if windows is not None else self._wayland_windows()
        owned = [
            window for window in current
            if window.get("launch_id") in member_by_launch
            and window.get("scratchpad_state") != "fresh"
        ]
        # Notification top-levels use a controller-generated 128-bit app-id
        # capability.  The raw identifier is delivered to the trusted helper
        # through a helper-only exact-byte startup file and is never exposed to the application.  A
        # static title or prefix is therefore only a *claim* that must match the
        # exact private value retained in ManagedProcess before it can receive
        # notification placement or input authority.
        branded = []
        for window in owned:
            app_id = window.get("app_id")
            title = window.get("title")
            claims_notification = (
                title == PRIVATE_NOTIFICATION_TITLE
                or (
                    isinstance(app_id, str)
                    and app_id.startswith(PRIVATE_NOTIFICATION_APP_ID_PREFIX)
                )
            )
            if not claims_notification:
                continue
            launch_id = str(window.get("launch_id") or "")
            managed = member_by_launch.get(launch_id)
            if (
                managed is None
                or managed.notification_access != "private"
                or managed.notification_surface_app_id is None
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
                or app_id != managed.notification_surface_app_id
                or title != PRIVATE_NOTIFICATION_TITLE
                or window.get("fullscreen") is True
                or window.get("focused") is True
            ):
                raise ToolError(
                    "private notification surface lost capability origin, launch attribution, "
                    "or focus isolation"
                )
            branded.append(window)

        if not branded:
            return current

        by_launch: dict[str, dict[str, Any]] = {}
        for window in branded:
            launch_id = str(window.get("launch_id") or "")
            if launch_id in by_launch:
                raise ToolError("one launch mapped multiple private notification top-levels")
            by_launch[launch_id] = window

        width = min(
            PRIVATE_NOTIFICATION_WIDTH,
            self.width - 2 * PRIVATE_NOTIFICATION_MARGIN,
        )
        if width < PRIVATE_NOTIFICATION_MIN_WIDTH:
            raise ToolError("private output is too narrow for notification placement")
        identifiers = {parse_window_id(window.get("id")) for window in branded}
        for identifier in sorted(identifiers):
            selector = f"[con_id={identifier}]"
            self._sway_command(
                f"{selector} floating enable, "
                f"{selector} border none, "
                f"{selector} resize set width {width} px"
            )

        sized = self._wayland_windows()
        sized_branded = [
            window for window in sized
            if parse_window_id(window.get("id")) in identifiers
        ]
        if {parse_window_id(window.get("id")) for window in sized_branded} != identifiers:
            raise ToolError("private notification surface changed during placement")
        layout = self._private_notification_layout(sized_branded, self.width, self.height)
        for identifier, geometry in sorted(layout.items()):
            selector = f"[con_id={identifier}]"
            self._sway_command(
                f"{selector} move absolute position {geometry['x']} px {geometry['y']} px"
            )

        final = self._wayland_windows()
        final_by_id = {}
        for window in final:
            launch_id = str(window.get("launch_id") or "")
            if launch_id not in member_by_launch:
                # Helper surfaces owned by a different launch remain private to
                # that launch's workspace.  A scoped placement proof must not
                # fail merely because another isolated application also opted
                # into notifications elsewhere in the compositor tree.
                continue
            managed = member_by_launch.get(launch_id)
            app_id = window.get("app_id")
            title = window.get("title")
            claims_notification = (
                title == PRIVATE_NOTIFICATION_TITLE
                or (
                    isinstance(app_id, str)
                    and app_id.startswith(PRIVATE_NOTIFICATION_APP_ID_PREFIX)
                )
            )
            if not claims_notification:
                continue
            if (
                managed is None
                or managed.notification_surface_app_id is None
                or app_id != managed.notification_surface_app_id
                or title != PRIVATE_NOTIFICATION_TITLE
            ):
                raise ToolError("private notification surface capability changed before proof")
            final_by_id[parse_window_id(window.get("id"))] = window
        if set(final_by_id) != identifiers:
            raise ToolError("private notification surface changed before placement proof")
        for identifier, expected in layout.items():
            window = final_by_id[identifier]
            managed = member_by_launch.get(str(window.get("launch_id") or ""))
            if (
                managed is None
                or managed.notification_access != "private"
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
                or managed.notification_surface_app_id is None
                or window.get("app_id") != managed.notification_surface_app_id
                or window.get("title") != PRIVATE_NOTIFICATION_TITLE
                or window.get("focused") is True
                or window.get("fullscreen") is True
                or window.get("floating") not in {"auto_on", "user_on"}
                or window.get("x") != expected["x"]
                or window.get("y") != expected["y"]
                or window.get("width") != expected["width"]
                or window.get("height") != expected["height"]
            ):
                raise ToolError("private notification placement proof failed")
        return final


    @staticmethod
    def _rectangles_overlap(first: Mapping[str, int], second: Mapping[str, int]) -> bool:
        return not (
            first["x"] + first["width"] <= second["x"]
            or second["x"] + second["width"] <= first["x"]
            or first["y"] + first["height"] <= second["y"]
            or second["y"] + second["height"] <= first["y"]
        )

    @staticmethod
    def _private_status_layout(
        windows: list[dict[str, Any]],
        output_width: int,
        output_height: int,
        obstacles: Iterable[Mapping[str, int]] = (),
    ) -> dict[int, dict[str, int]]:
        """Pack exact status surfaces bottom-up while avoiding trusted overlays."""
        if (
            isinstance(output_width, bool)
            or isinstance(output_height, bool)
            or not isinstance(output_width, int)
            or not isinstance(output_height, int)
        ):
            raise ToolError("private status output geometry is invalid")
        available_width = output_width - 2 * PRIVATE_STATUS_MARGIN
        available_height = output_height - 2 * PRIVATE_STATUS_MARGIN
        width = min(PRIVATE_STATUS_WIDTH, available_width)
        if width < PRIVATE_STATUS_MIN_WIDTH or available_height < PRIVATE_STATUS_MIN_HEIGHT:
            raise ToolError("private output is too small for a bounded status surface")

        obstacle_rectangles: list[dict[str, int]] = []
        for raw in obstacles:
            rectangle: dict[str, int] = {}
            for field in ("x", "y", "width", "height"):
                value = raw.get(field)
                if isinstance(value, bool) or not isinstance(value, int):
                    raise ToolError("private status placement obstacle is malformed")
                rectangle[field] = value
            if rectangle["width"] <= 0 or rectangle["height"] <= 0:
                raise ToolError("private status placement obstacle is empty")
            if (
                rectangle["x"] < 0
                or rectangle["y"] < 0
                or rectangle["x"] + rectangle["width"] > output_width
                or rectangle["y"] + rectangle["height"] > output_height
            ):
                raise ToolError("private status placement obstacle escaped the output")
            obstacle_rectangles.append(rectangle)

        result: dict[int, dict[str, int]] = {}
        occupied = list(obstacle_rectangles)
        x = output_width - PRIVATE_STATUS_MARGIN - width
        cursor_bottom = output_height - PRIVATE_STATUS_MARGIN
        for window in sorted(
            windows,
            key=lambda item: (str(item.get("launch_id") or ""), parse_window_id(item.get("id"))),
        ):
            identifier = parse_window_id(window.get("id"))
            height = window.get("height")
            if isinstance(height, bool) or not isinstance(height, int):
                raise ToolError("private status surface has invalid compositor geometry")
            if not PRIVATE_STATUS_MIN_HEIGHT <= height <= available_height:
                raise ToolError("private status surface exceeds its bounded output geometry")
            attempts = 0
            while True:
                attempts += 1
                if attempts > 512:
                    raise ToolError("private status placement search exceeded its bound")
                candidate = {
                    "x": x,
                    "y": cursor_bottom - height,
                    "width": width,
                    "height": height,
                }
                conflicts = [
                    rectangle
                    for rectangle in occupied
                    if DesktopController._rectangles_overlap(candidate, rectangle)
                ]
                if candidate["y"] < PRIVATE_STATUS_MARGIN:
                    x -= width + PRIVATE_STATUS_GAP
                    cursor_bottom = output_height - PRIVATE_STATUS_MARGIN
                    if x < PRIVATE_STATUS_MARGIN:
                        raise ToolError("private status surfaces cannot be placed without overlap")
                    continue
                if conflicts:
                    cursor_bottom = min(rectangle["y"] for rectangle in conflicts) - PRIVATE_STATUS_GAP
                    continue
                result[identifier] = candidate
                occupied.append(candidate)
                cursor_bottom = candidate["y"] - PRIVATE_STATUS_GAP
                break
        return result

    def _place_private_status_windows(
        self,
        members: list[ManagedProcess],
        workspace: str,
        windows: list[dict[str, Any]] | None = None,
    ) -> list[dict[str, Any]]:
        """Place and prove launch-private StatusNotifierHost windows."""
        member_by_launch = {managed.launch_id: managed for managed in members}
        if not member_by_launch:
            return windows if windows is not None else self._wayland_windows()
        current = windows if windows is not None else self._wayland_windows()
        owned = [
            window for window in current
            if window.get("launch_id") in member_by_launch
        ]
        branded: list[dict[str, Any]] = []
        for window in owned:
            app_id = window.get("app_id")
            title = window.get("title")
            claims_status = (
                title == PRIVATE_STATUS_TITLE
                or (isinstance(app_id, str) and app_id.startswith(PRIVATE_STATUS_APP_ID_PREFIX))
            )
            if not claims_status:
                continue
            launch_id = str(window.get("launch_id") or "")
            managed = member_by_launch.get(launch_id)
            if (
                managed is None
                or managed.status_notifier_access != "private"
                or managed.status_surface_app_id is None
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
                or app_id != managed.status_surface_app_id
                or title != PRIVATE_STATUS_TITLE
                or window.get("scratchpad_state") == "fresh"
                or window.get("fullscreen") is True
                or window.get("focused") is True
            ):
                raise ToolError(
                    "private status surface lost capability origin, launch attribution, "
                    "or focus isolation"
                )
            branded.append(window)
        if not branded:
            return current

        by_launch: dict[str, dict[str, Any]] = {}
        for window in branded:
            launch_id = str(window.get("launch_id") or "")
            if launch_id in by_launch:
                raise ToolError("one launch mapped multiple private status top-levels")
            by_launch[launch_id] = window

        width = min(PRIVATE_STATUS_WIDTH, self.width - 2 * PRIVATE_STATUS_MARGIN)
        if width < PRIVATE_STATUS_MIN_WIDTH:
            raise ToolError("private output is too narrow for status placement")
        identifiers = {parse_window_id(window.get("id")) for window in branded}
        for identifier in sorted(identifiers):
            selector = f"[con_id={identifier}]"
            self._sway_command(
                f"{selector} floating enable, {selector} border none, "
                f"{selector} resize set width {width} px"
            )

        sized = self._wayland_windows()
        sized_branded: list[dict[str, Any]] = []
        sized_identifiers: set[int] = set()
        for window in sized:
            identifier = parse_window_id(window.get("id"))
            if identifier not in identifiers:
                continue
            if identifier in sized_identifiers:
                raise ToolError("private status surface identity was duplicated during placement")
            sized_identifiers.add(identifier)
            launch_id = str(window.get("launch_id") or "")
            managed = member_by_launch.get(launch_id)
            if (
                managed is None
                or managed.status_notifier_access != "private"
                or managed.status_surface_app_id is None
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
                or window.get("app_id") != managed.status_surface_app_id
                or window.get("title") != PRIVATE_STATUS_TITLE
                or window.get("scratchpad_state") == "fresh"
                or window.get("focused") is True
                or window.get("fullscreen") is True
            ):
                raise ToolError(
                    "private status surface changed origin or focus during placement"
                )
            sized_branded.append(window)
        if sized_identifiers != identifiers:
            raise ToolError("private status surface changed during placement")

        def trusted_notification_obstacles(
            source: Iterable[Mapping[str, Any]],
        ) -> dict[int, dict[str, int]]:
            trusted: dict[int, dict[str, int]] = {}
            for window in source:
                launch_id = str(window.get("launch_id") or "")
                if launch_id not in member_by_launch:
                    continue
                managed = member_by_launch[launch_id]
                app_id = window.get("app_id")
                title = window.get("title")
                claims_notification = (
                    title == PRIVATE_NOTIFICATION_TITLE
                    or (
                        isinstance(app_id, str)
                        and app_id.startswith(PRIVATE_NOTIFICATION_APP_ID_PREFIX)
                    )
                )
                if not claims_notification:
                    continue
                if (
                    managed.notification_access != "private"
                    or managed.notification_surface_app_id is None
                    or app_id != managed.notification_surface_app_id
                    or title != PRIVATE_NOTIFICATION_TITLE
                    or window.get("origin_verified") is not True
                    or window.get("workspace") != workspace
                    or window.get("focused") is True
                    or window.get("fullscreen") is True
                    or window.get("floating") not in {"auto_on", "user_on"}
                ):
                    raise ToolError(
                        "private notification obstacle lost its exact placement authority"
                    )
                identifier = parse_window_id(window.get("id"))
                if identifier in trusted:
                    raise ToolError("private notification obstacle identity was duplicated")
                rectangle: dict[str, int] = {}
                for field in ("x", "y", "width", "height"):
                    value = window.get(field)
                    if isinstance(value, bool) or not isinstance(value, int):
                        raise ToolError("private notification obstacle geometry is invalid")
                    rectangle[field] = value
                trusted[identifier] = rectangle
            return trusted

        obstacle_by_id = trusted_notification_obstacles(sized)
        obstacles = list(obstacle_by_id.values())

        layout = self._private_status_layout(
            sized_branded, self.width, self.height, obstacles
        )
        for identifier, geometry in sorted(layout.items()):
            selector = f"[con_id={identifier}]"
            self._sway_command(
                f"{selector} move absolute position {geometry['x']} px {geometry['y']} px"
            )

        final = self._wayland_windows()
        final_by_id: dict[int, dict[str, Any]] = {}
        for window in final:
            launch_id = str(window.get("launch_id") or "")
            if launch_id not in member_by_launch:
                # Other launch-private tray hosts are proved only when their
                # own workspace or scene lease is acquired.
                continue
            managed = member_by_launch.get(launch_id)
            app_id = window.get("app_id")
            title = window.get("title")
            claims_status = (
                title == PRIVATE_STATUS_TITLE
                or (isinstance(app_id, str) and app_id.startswith(PRIVATE_STATUS_APP_ID_PREFIX))
            )
            if not claims_status:
                continue
            if (
                managed is None
                or managed.status_surface_app_id is None
                or app_id != managed.status_surface_app_id
                or title != PRIVATE_STATUS_TITLE
            ):
                raise ToolError("private status surface capability changed before proof")
            identifier = parse_window_id(window.get("id"))
            if identifier in final_by_id:
                raise ToolError("private status surface identity duplicated before proof")
            final_by_id[identifier] = window
        if set(final_by_id) != identifiers:
            raise ToolError("private status surface changed before placement proof")
        if trusted_notification_obstacles(final) != obstacle_by_id:
            raise ToolError(
                "private notification obstacles changed during status placement"
            )
        for identifier, expected in layout.items():
            window = final_by_id[identifier]
            managed = member_by_launch.get(str(window.get("launch_id") or ""))
            if (
                managed is None
                or managed.status_notifier_access != "private"
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
                or managed.status_surface_app_id is None
                or window.get("app_id") != managed.status_surface_app_id
                or window.get("title") != PRIVATE_STATUS_TITLE
                or window.get("focused") is True
                or window.get("fullscreen") is True
                or window.get("floating") not in {"auto_on", "user_on"}
                or window.get("x") != expected["x"]
                or window.get("y") != expected["y"]
                or window.get("width") != expected["width"]
                or window.get("height") != expected["height"]
            ):
                raise ToolError("private status placement proof failed")
            for obstacle in obstacles:
                if self._rectangles_overlap(expected, obstacle):
                    raise ToolError("private status placement overlaps a trusted notification")
        return final

    @staticmethod
    def _public_wayland_window(
        window: dict[str, Any],
        trusted_notification_origins: Mapping[str, str] | None = None,
        trusted_status_origins: Mapping[str, str] | None = None,
    ) -> dict[str, Any]:
        """Publish window metadata without leaking reusable origin authority.

        The notification renderer and private StatusNotifierHost each authenticate
        one GTK surface with an independent controller-generated app-id suffix.
        Any application can spell either reserved syntax, so public trust is
        based only on an exact controller-held ID, matching launch attribution,
        and compositor-verified origin.  Reserved look-alikes remain redacted
        and explicitly untrusted.
        """
        public = {
            key: value
            for key, value in window.items()
            if not key.startswith("_")
        }
        app_id = public.get("app_id")
        if isinstance(app_id, str) and PRIVATE_NOTIFICATION_APP_ID_RE.fullmatch(app_id):
            expected_launch = (
                trusted_notification_origins.get(app_id)
                if trusted_notification_origins is not None
                else None
            )
            controller_private = (
                expected_launch is not None
                and public.get("launch_id") == expected_launch
                and public.get("origin_verified") is True
            )
            public["app_id"] = PRIVATE_NOTIFICATION_PUBLIC_APP_ID
            public["app_id_redacted"] = True
            public["app_id_controller_private"] = controller_private
            public["private_surface_kind"] = "notification"
            if not controller_private:
                public["app_id_reserved_pattern_untrusted"] = True
        elif isinstance(app_id, str) and PRIVATE_STATUS_APP_ID_RE.fullmatch(app_id):
            expected_launch = (
                trusted_status_origins.get(app_id)
                if trusted_status_origins is not None
                else None
            )
            controller_private = (
                expected_launch is not None
                and public.get("launch_id") == expected_launch
                and public.get("origin_verified") is True
            )
            public["app_id"] = PRIVATE_STATUS_PUBLIC_APP_ID
            public["app_id_redacted"] = True
            public["app_id_controller_private"] = controller_private
            public["private_surface_kind"] = "status-notifier"
            if not controller_private:
                public["app_id_reserved_pattern_untrusted"] = True
        return public

    def _trusted_notification_surface_origins(self) -> dict[str, str]:
        """Return exact controller-minted surface ID to launch bindings.

        This map is never serialized.  It exists only long enough to distinguish
        a controller-minted notification surface from an application-chosen
        look-alike that happens to match the reserved app-id syntax.
        """
        origins: dict[str, str] = {}
        processes = getattr(self, "processes", {})
        if not isinstance(processes, dict):
            return origins
        for managed in processes.values():
            app_id = getattr(managed, "notification_surface_app_id", None)
            launch_id = getattr(managed, "launch_id", None)
            notification_access = getattr(managed, "notification_access", None)
            if (
                notification_access == "private"
                and isinstance(app_id, str)
                and PRIVATE_NOTIFICATION_APP_ID_RE.fullmatch(app_id)
                and isinstance(launch_id, str)
                and re.fullmatch(r"launch-[0-9a-f]{24}", launch_id)
            ):
                origins[app_id] = launch_id
        return origins

    def _trusted_status_surface_origins(self) -> dict[str, str]:
        """Return exact controller-minted status-surface ID to launch bindings."""
        origins: dict[str, str] = {}
        processes = getattr(self, "processes", {})
        if not isinstance(processes, dict):
            return origins
        for managed in processes.values():
            app_id = getattr(managed, "status_surface_app_id", None)
            launch_id = getattr(managed, "launch_id", None)
            access = getattr(managed, "status_notifier_access", None)
            if (
                access == "private"
                and isinstance(app_id, str)
                and PRIVATE_STATUS_APP_ID_RE.fullmatch(app_id)
                and isinstance(launch_id, str)
                and re.fullmatch(r"launch-[0-9a-f]{24}", launch_id)
            ):
                origins[app_id] = launch_id
        return origins

    def _public_wayland_windows(
        self,
        windows: list[dict[str, Any]],
    ) -> list[dict[str, Any]]:
        """Apply controller-private helper-surface projection to a result set."""
        notification_origins = self._trusted_notification_surface_origins()
        status_origins = self._trusted_status_surface_origins()
        return [
            self._public_wayland_window(window, notification_origins, status_origins)
            for window in windows
        ]

    @staticmethod
    def _capture_window_authority(window: dict[str, Any]) -> dict[str, Any]:
        """Project one Sway node into exact direct-capture authority.

        The raw foreign-toplevel handle is deliberately excluded. Its digest,
        container geometry, launch-origin tuple, and shell identity are enough
        to prove that the same compositor object remained authoritative across
        the external grim capture round trip.
        """
        return {
            "schema": CAPTURE_SEAL_SCHEMA,
            "window_id": window.get("id"),
            "x": window.get("x"),
            "y": window.get("y"),
            "width": window.get("width"),
            "height": window.get("height"),
            "window_rect": window.get("window_rect"),
            "deco_rect": window.get("deco_rect"),
            "pid": window.get("pid"),
            "shell": window.get("shell"),
            "workspace": window.get("workspace"),
            "sandbox_engine": window.get("sandbox_engine"),
            "sandbox_app_id": window.get("sandbox_app_id"),
            "sandbox_instance_id": window.get("sandbox_instance_id"),
            "launch_id": window.get("launch_id"),
            "scene_id": window.get("scene_id"),
            "managed_pid": window.get("managed_pid"),
            "origin": window.get("origin"),
            "origin_verified": window.get("origin_verified"),
            "capture_identity_sha256": window.get("capture_identity_sha256"),
        }

    @classmethod
    def _capture_window_authority_sha256(cls, window: dict[str, Any]) -> str:
        return hashlib.sha256(canonical_json(cls._capture_window_authority(window))).hexdigest()

    def _launch_scene_authority(
        self,
        managed: ManagedProcess,
        windows: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        """Seal one launch's complete visible private-output scene.

        An xdg_popup is not an independent Sway tree node, so an exact
        foreign-toplevel frame cannot provide a global coordinate map for a
        popup extending beyond its parent.  A launch-scene observation instead
        captures the private output only after proving that every visible
        top-level belongs to one birth-pinned launch security context and its
        private workspace.  This makes popup/menu pixels actionable without
        projecting the host desktop or another launch into the frame.
        """
        if not self.is_wayland:
            raise ToolError("launch-scene authority requires the private Wayland backend")
        self._refresh_managed(managed)
        if managed.context_failed or not self._context_alive(managed):
            raise ToolError("guarded launch lost its Wayland security context")
        if managed.workspace is None:
            raise ToolError("guarded launch has no private compositor workspace")
        context = managed.security_context
        if context is None:
            raise ToolError("guarded launch has no birth-pinned Wayland security context")
        if context.app_id != managed.application_id or context.instance_id != managed.launch_id:
            raise ToolError("guarded launch security-context identity no longer matches its custody record")
        probe = context.capability_probe
        if not isinstance(probe, dict):
            raise ToolError("guarded launch lost its Wayland capability proof")
        if (
            probe.get("required_present") != sorted(REQUIRED_APP_WAYLAND_GLOBALS)
            or probe.get("privileged_absent") != sorted(PRIVILEGED_APP_WAYLAND_GLOBALS)
            or isinstance(probe.get("interface_count"), bool)
            or not isinstance(probe.get("interface_count"), int)
            or probe["interface_count"] < len(REQUIRED_APP_WAYLAND_GLOBALS)
        ):
            raise ToolError("guarded launch Wayland capability proof is incomplete or inconsistent")
        if context.atspi_policy_sha256 != ATSPI_PROXY_POLICY_SHA256:
            raise ToolError("guarded launch AT-SPI proxy policy changed after admission")
        if not managed.members:
            raise ToolError("launch-scene observation requires a live launch-owned process tree")
        capture_attestation = getattr(self, "capture_stack_attestation", None) or {}
        output_attestation = capture_attestation.get("output")
        if not isinstance(output_attestation, dict):
            raise ToolError("launch-scene capture has no attested private-output authority")

        current = self._wayland_windows() if windows is None else windows
        if not isinstance(current, list):
            raise ToolError("launch-scene compositor inventory is invalid")
        current = [window for window in current if isinstance(window, dict)]
        foreign_workspace = [
            window
            for window in current
            if window.get("workspace") == managed.workspace
            and (
                window.get("launch_id") != managed.launch_id
                or window.get("origin_verified") is not True
            )
        ]
        if foreign_workspace:
            raise ToolError(
                "launch-scene private workspace contains another or unattributed application trust domain"
            )
        visible = [window for window in current if isinstance(window, dict) and window.get("visible", True)]
        if not visible:
            raise ToolError("launch-scene observation requires a visible attributable top-level")
        if len(visible) > LAUNCH_SCENE_MAX_VISIBLE_TOPLEVELS:
            raise ToolError("launch-scene visible top-level inventory exceeds the bounded authority limit")
        for window in visible:
            if (
                window.get("launch_id") != managed.launch_id
                or window.get("origin_verified") is not True
            ):
                raise ToolError(
                    "launch-scene private output contains another or unattributed application trust domain"
                )
            if window.get("workspace") != managed.workspace:
                raise ToolError("launch-scene visible top-level escaped its private compositor workspace")
            identity = window.get("capture_identity_sha256")
            if (
                window.get("capture_identity_available") is not True
                or not isinstance(identity, str)
                or re.fullmatch(r"[0-9a-f]{64}", identity) is None
            ):
                raise ToolError("launch-scene top-level lacks a valid compositor capture identity")
        focused = [window for window in visible if window.get("focused") is True]
        if len(focused) != 1:
            raise ToolError("launch-scene authority requires exactly one focused launch top-level")

        visible_identities = [self._pointer_window_identity(window) for window in visible]
        visible_identities.sort(key=lambda value: int(value.get("window_id") or 0))
        active_identity = self._keyboard_window_identity(focused[0])
        output_authority_sha256 = hashlib.sha256(canonical_json(output_attestation)).hexdigest()
        projection = {
            "schema": LAUNCH_SCENE_AUTHORITY_SCHEMA,
            "launch_id": managed.launch_id,
            "workspace": managed.workspace,
            "application_id": managed.application_id,
            "leader": {
                "pid": managed.process.pid,
                "start_ticks": managed.leader_start_ticks,
            },
            # Membership is intentionally a live predicate rather than an
            # exact set in the authority. GUI runtimes may spawn or reap
            # short-lived helpers between observation and activation. The
            # immutable leader/context identities and security-context origin
            # tag remain the launch principal; requiring at least one exact
            # admitted member prevents an empty/stale launch from retaining it.
            "process_tree_live": True,
            "security_context": {
                "pid": context.process.pid,
                "start_ticks": context.start_ticks,
                "atspi_pid": context.atspi_process.pid,
                "atspi_start_ticks": context.atspi_start_ticks,
                "app_id": context.app_id,
                "instance_id": context.instance_id,
                "capability_probe": context.capability_probe,
                "atspi_policy_sha256": context.atspi_policy_sha256,
            },
            "capture_stack_attestation_sha256": hashlib.sha256(
                canonical_json(capture_attestation)
            ).hexdigest(),
            "output_attestation_sha256": output_authority_sha256,
            "visible_top_levels": visible_identities,
            "active_top_level": active_identity,
            "surface_scope": "same-security-context-xdg-toplevel-and-transient-xdg-popup",
            "privileged_application_globals_absent": sorted(PRIVILEGED_APP_WAYLAND_GLOBALS),
        }
        return {
            "schema": LAUNCH_SCENE_AUTHORITY_SCHEMA,
            "authority_sha256": self._authority_digest(projection),
            "launch_id_sha256": hashlib.sha256(managed.launch_id.encode("utf-8")).hexdigest(),
            "workspace_sha256": hashlib.sha256(managed.workspace.encode("utf-8")).hexdigest(),
            "output_authority_sha256": output_authority_sha256,
            "visible_scene_sha256": hashlib.sha256(canonical_json(visible_identities)).hexdigest(),
            "active_window_identity_sha256": hashlib.sha256(canonical_json(active_identity)).hexdigest(),
            "visible_window_count": len(visible),
        }

    def _assert_launch_scene_authority(
        self,
        managed: ManagedProcess,
        expected_sha256: str | None = None,
        windows: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        authority = self._launch_scene_authority(managed, windows)
        if expected_sha256 is not None:
            if not isinstance(expected_sha256, str) or re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None:
                raise ToolError("launch-scene expected authority digest is invalid")
            if not hmac.compare_digest(authority["authority_sha256"], expected_sha256):
                raise ToolError("launch-scene authority changed after observation")
        return authority

    def _scene_member_principal(self, managed: ManagedProcess) -> dict[str, Any]:
        self._refresh_managed(managed)
        if managed.context_failed or not self._context_alive(managed):
            raise ToolError("scene-set member lost its Wayland security context")
        context = managed.security_context
        if context is None:
            raise ToolError("scene-set member has no birth-pinned Wayland security context")
        if context.app_id != managed.application_id or context.instance_id != managed.launch_id:
            raise ToolError("scene-set member security-context identity changed after admission")
        probe = context.capability_probe
        if not isinstance(probe, dict) or (
            probe.get("required_present") != sorted(REQUIRED_APP_WAYLAND_GLOBALS)
            or probe.get("privileged_absent") != sorted(PRIVILEGED_APP_WAYLAND_GLOBALS)
            or isinstance(probe.get("interface_count"), bool)
            or not isinstance(probe.get("interface_count"), int)
            or probe["interface_count"] < len(REQUIRED_APP_WAYLAND_GLOBALS)
        ):
            raise ToolError("scene-set member Wayland capability proof is incomplete or inconsistent")
        if context.atspi_policy_sha256 != ATSPI_PROXY_POLICY_SHA256:
            raise ToolError("scene-set member AT-SPI proxy policy changed after admission")
        if not managed.members:
            raise ToolError("scene-set authority requires every member process tree to remain live")
        return {
            "launch_id": managed.launch_id,
            "application_id": managed.application_id,
            "leader": {
                "pid": managed.process.pid,
                "start_ticks": managed.leader_start_ticks,
            },
            "process_tree_live": True,
            "security_context": {
                "pid": context.process.pid,
                "start_ticks": context.start_ticks,
                "atspi_pid": context.atspi_process.pid,
                "atspi_start_ticks": context.atspi_start_ticks,
                "app_id": context.app_id,
                "instance_id": context.instance_id,
                "capability_probe": context.capability_probe,
                "atspi_policy_sha256": context.atspi_policy_sha256,
            },
        }

    def _scene_set_authority(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        """Seal one explicit multi-application private-output trust set.

        The scene broadens only compositor placement and capture. Each launch
        remains an independent least-authority principal. Every frame and input
        checkpoint binds the exact member set, every birth-pinned context, the
        shared private workspace, the complete visible top-level inventory, and
        the currently focused member.
        """
        if not self.is_wayland:
            raise ToolError("scene-set authority requires the private Wayland backend")
        if not 2 <= len(members) <= SCENE_SET_MAX_LAUNCHES:
            raise ToolError("scene-set authority requires a bounded multi-launch member set")
        ordered = sorted(members, key=lambda managed: managed.launch_id)
        launch_ids = tuple(managed.launch_id for managed in ordered)
        if len(set(launch_ids)) != len(ordered):
            raise ToolError("scene-set launch membership contains a duplicate principal")
        scene_ids = {managed.scene_id for managed in ordered}
        workspaces = {managed.workspace for managed in ordered}
        if len(scene_ids) != 1 or None in scene_ids or len(workspaces) != 1 or None in workspaces:
            raise ToolError("scene-set members do not share one explicit private workspace")
        scene_id = next(iter(scene_ids))
        workspace = next(iter(workspaces))
        assert isinstance(scene_id, str) and isinstance(workspace, str)
        if workspace != self._scene_workspace_name(scene_id):
            raise ToolError("scene-set workspace identity no longer matches its scene name")

        principals = [self._scene_member_principal(managed) for managed in ordered]
        capture_attestation = getattr(self, "capture_stack_attestation", None) or {}
        output_attestation = capture_attestation.get("output")
        if not isinstance(output_attestation, dict):
            raise ToolError("scene-set capture has no attested private-output authority")

        current = self._wayland_windows() if windows is None else windows
        if not isinstance(current, list):
            raise ToolError("scene-set compositor inventory is invalid")
        current = [window for window in current if isinstance(window, dict)]
        allowed = set(launch_ids)
        workspace_windows = [window for window in current if window.get("workspace") == workspace]
        foreign_workspace = [
            window
            for window in workspace_windows
            if window.get("launch_id") not in allowed
            or window.get("origin_verified") is not True
        ]
        if foreign_workspace:
            raise ToolError("scene-set workspace contains a foreign or unattributed trust domain")
        represented = {str(window.get("launch_id")) for window in workspace_windows}
        if represented != allowed:
            raise ToolError("scene-set authority requires a mapped top-level from every exact member")

        visible = [window for window in current if window.get("visible", True)]
        if not visible:
            raise ToolError("scene-set observation requires visible attributable top-levels")
        if len(visible) > SCENE_SET_MAX_VISIBLE_TOPLEVELS:
            raise ToolError("scene-set visible top-level inventory exceeds the authority limit")
        for window in visible:
            if (
                window.get("launch_id") not in allowed
                or window.get("origin_verified") is not True
                or window.get("workspace") != workspace
            ):
                raise ToolError("scene-set private output contains a foreign or escaped trust domain")
            identity = window.get("capture_identity_sha256")
            if (
                window.get("capture_identity_available") is not True
                or not isinstance(identity, str)
                or re.fullmatch(r"[0-9a-f]{64}", identity) is None
            ):
                raise ToolError("scene-set top-level lacks a valid compositor capture identity")
        focused = [window for window in visible if window.get("focused") is True]
        if len(focused) != 1:
            raise ToolError("scene-set authority requires exactly one focused member top-level")
        active_launch_id = focused[0].get("launch_id")
        if active_launch_id not in allowed:
            raise ToolError("scene-set active top-level is not an exact member")

        visible_identities = [self._pointer_window_identity(window) for window in visible]
        visible_identities.sort(key=lambda value: int(value.get("window_id") or 0))
        active_identity = self._keyboard_window_identity(focused[0])
        output_authority_sha256 = hashlib.sha256(canonical_json(output_attestation)).hexdigest()
        projection = {
            "schema": SCENE_SET_AUTHORITY_SCHEMA,
            "scene_id": scene_id,
            "workspace": workspace,
            "members": principals,
            "capture_stack_attestation_sha256": hashlib.sha256(
                canonical_json(capture_attestation)
            ).hexdigest(),
            "output_attestation_sha256": output_authority_sha256,
            "visible_top_levels": visible_identities,
            "active_top_level": active_identity,
            "surface_scope": "explicit-multi-security-context-private-output-scene",
            "transient_surface_policy": "uncovered-pixels-non-actionable-without-member-toplevel-attribution",
            "privileged_application_globals_absent": sorted(PRIVILEGED_APP_WAYLAND_GLOBALS),
        }
        return {
            "schema": SCENE_SET_AUTHORITY_SCHEMA,
            "authority_sha256": self._authority_digest(projection),
            "scene_id_sha256": hashlib.sha256(scene_id.encode("utf-8")).hexdigest(),
            "workspace_sha256": hashlib.sha256(workspace.encode("utf-8")).hexdigest(),
            "member_set_sha256": hashlib.sha256(canonical_json(list(launch_ids))).hexdigest(),
            "active_launch_id_sha256": hashlib.sha256(
                str(active_launch_id).encode("utf-8")
            ).hexdigest(),
            "output_authority_sha256": output_authority_sha256,
            "visible_scene_sha256": hashlib.sha256(canonical_json(visible_identities)).hexdigest(),
            "active_window_identity_sha256": hashlib.sha256(canonical_json(active_identity)).hexdigest(),
            "scene_member_count": len(ordered),
            "visible_window_count": len(visible),
        }

    def _assert_scene_set_authority(
        self,
        members: list[ManagedProcess],
        expected_sha256: str | None = None,
        windows: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        authority = self._scene_set_authority(members, windows)
        if expected_sha256 is not None:
            if (
                not isinstance(expected_sha256, str)
                or re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None
            ):
                raise ToolError("scene-set expected authority digest is invalid")
            if not hmac.compare_digest(authority["authority_sha256"], expected_sha256):
                raise ToolError("scene-set authority changed after observation")
        return authority

    @staticmethod
    def _window_signature_value(windows: list[dict[str, Any]]) -> str:
        projection = [
            {
                "id": window.get("id"), "title": window.get("title"), "app_id": window.get("app_id"),
                "x": window.get("x"), "y": window.get("y"), "width": window.get("width"),
                "height": window.get("height"), "focused": window.get("focused"),
                "window_rect": window.get("window_rect"),
                "deco_rect": window.get("deco_rect"),
                "visible": window.get("visible"), "workspace": window.get("workspace"),
                "fullscreen": window.get("fullscreen"), "urgent": window.get("urgent"),
                "floating": window.get("floating"),
                "scratchpad_state": window.get("scratchpad_state"),
                "pid": window.get("pid"), "shell": window.get("shell"),
                "sandbox_engine": window.get("sandbox_engine"),
                "sandbox_app_id": window.get("sandbox_app_id"),
                "sandbox_instance_id": window.get("sandbox_instance_id"),
                "launch_id": window.get("launch_id"),
                "scene_id": window.get("scene_id"),
                "managed_pid": window.get("managed_pid"),
                "origin": window.get("origin"),
                "origin_verified": window.get("origin_verified"),
                "capture_identity_available": window.get("capture_identity_available"),
                "capture_identity_sha256": window.get("capture_identity_sha256"),
            }
            for window in sorted(windows, key=lambda value: int(value.get("id", 0)))
        ]
        return hashlib.sha256(canonical_json(projection)).hexdigest()

    @staticmethod
    def _window_state_name(value: Any) -> str:
        state = as_string(value, "state", maximum=16, allow_empty=False).casefold()
        if state not in {
            "fullscreen", "windowed", "floating", "tiled", "minimized", "restored",
        }:
            raise ToolError(
                "state must be fullscreen, windowed, floating, tiled, minimized, or restored"
            )
        return state

    @staticmethod
    def _window_floating_enabled(window: dict[str, Any]) -> bool:
        return window.get("floating") in {"auto_on", "user_on"}

    @staticmethod
    def _window_state_identity(window: dict[str, Any]) -> dict[str, Any]:
        """Project immutable compositor and launch identity for WindowStateSeal.

        Titles, geometry, focus, workspace, visibility, fullscreen, floating,
        urgency, and scratchpad state are the reviewed transition rather than
        identity. A replacement container, changed sandbox principal, recycled
        process, or capture-handle change cannot inherit a state transition or
        a later restore capability.
        """
        return {
            "schema": WINDOW_STATE_SEAL_SCHEMA,
            "window_id": window.get("id"),
            "app_id": window.get("app_id"),
            "class": window.get("class"),
            "instance": window.get("instance"),
            "pid": window.get("pid"),
            "shell": window.get("shell"),
            "sandbox_engine": window.get("sandbox_engine"),
            "sandbox_app_id": window.get("sandbox_app_id"),
            "sandbox_instance_id": window.get("sandbox_instance_id"),
            "launch_id": window.get("launch_id"),
            "scene_id": window.get("scene_id"),
            "managed_pid": window.get("managed_pid"),
            "origin": window.get("origin"),
            "origin_verified": window.get("origin_verified"),
            "capture_identity_available": window.get("capture_identity_available"),
            "capture_identity_sha256": window.get("capture_identity_sha256"),
        }

    @classmethod
    def _window_state_identity_sha256(cls, window: dict[str, Any]) -> str:
        return hashlib.sha256(canonical_json(cls._window_state_identity(window))).hexdigest()

    @staticmethod
    def _window_geometry(window: dict[str, Any]) -> dict[str, int]:
        """Return the exact compositor rectangle used by WindowStateSeal."""
        return {
            "x": int(window.get("x", 0)),
            "y": int(window.get("y", 0)),
            "width": int(window.get("width", 0)),
            "height": int(window.get("height", 0)),
        }

    @classmethod
    def _window_layout_matches(
        cls,
        window: dict[str, Any],
        *,
        floating_enabled: bool,
        geometry: dict[str, int],
    ) -> bool:
        if cls._window_floating_enabled(window) != floating_enabled:
            return False
        if not floating_enabled:
            return True
        return cls._window_geometry(window) == geometry

    @classmethod
    def _window_state_inventory(cls, windows: list[dict[str, Any]]) -> dict[int, str]:
        inventory: dict[int, str] = {}
        for window in windows:
            identifier = parse_window_id(window.get("id"))
            if identifier in inventory:
                raise ToolError("private compositor published a duplicate window container identity")
            inventory[identifier] = cls._window_state_identity_sha256(window)
        return inventory

    @staticmethod
    def _window_state_inventory_sha256(inventory: dict[int, str]) -> str:
        projection = [
            {"window_id": identifier, "identity_sha256": inventory[identifier]}
            for identifier in sorted(inventory)
        ]
        return hashlib.sha256(canonical_json(projection)).hexdigest()

    @classmethod
    def _window_restore_inventory_from_lease(
        cls,
        lease: dict[str, Any],
    ) -> dict[int, str]:
        value = lease.get("inventory")
        if not isinstance(value, dict) or not value:
            raise ToolError("restore capability lost its immutable workstation inventory")
        inventory: dict[int, str] = {}
        for raw_identifier, raw_digest in value.items():
            if not isinstance(raw_identifier, int) or raw_identifier <= 0:
                raise ToolError("restore capability contains an invalid window inventory key")
            if (
                not isinstance(raw_digest, str)
                or re.fullmatch(r"[0-9a-f]{64}", raw_digest) is None
            ):
                raise ToolError("restore capability contains an invalid window identity digest")
            if raw_identifier in inventory:
                raise ToolError("restore capability contains a duplicate window inventory key")
            inventory[raw_identifier] = raw_digest
        expected = lease.get("inventory_sha256")
        actual = cls._window_state_inventory_sha256(inventory)
        if (
            not isinstance(expected, str)
            or re.fullmatch(r"[0-9a-f]{64}", expected) is None
            or not hmac.compare_digest(actual, expected)
        ):
            raise ToolError("restore capability workstation inventory digest is invalid")
        return inventory

    def _window_restore_lease_store(self) -> dict[str, dict[str, Any]]:
        store = getattr(self, "window_restore_leases", None)
        if not isinstance(store, dict):
            store = {}
            self.window_restore_leases = store
        return store

    def _prune_window_restore_leases(
        self,
        windows: list[dict[str, Any]] | None = None,
    ) -> int:
        store = self._window_restore_lease_store()
        if not store:
            return 0
        current = windows if windows is not None else self._wayland_windows()
        inventory = self._window_state_inventory(current)
        now = time.monotonic()
        removed = 0
        for digest, lease in list(store.items()):
            identifier = lease.get("window_id")
            identity_sha256 = lease.get("identity_sha256")
            created = lease.get("created_monotonic")
            try:
                sealed_inventory = self._window_restore_inventory_from_lease(lease)
            except ToolError:
                sealed_inventory = None
            if (
                not isinstance(identifier, int)
                or not isinstance(identity_sha256, str)
                or not isinstance(created, (int, float))
                or created > now
                or now - float(created) > WINDOW_RESTORE_LEASE_TTL_SECONDS
                or inventory.get(identifier) != identity_sha256
                or sealed_inventory is None
                or inventory != sealed_inventory
            ):
                store.pop(digest, None)
                removed += 1
        return removed

    @staticmethod
    def _whole_workstation_observation(observation: Observation) -> bool:
        source = observation.capture_source
        return (
            observation.launch_id is None
            and observation.scene_id is None
            and not observation.scene_launch_ids
            and observation.capture_crop is None
            and observation.capture_window_id is None
            and isinstance(source, dict)
            and source.get("scope") == "workstation"
        )

    @classmethod
    def _window_state_seal(
        cls,
        *,
        requested_state: str,
        before: dict[str, Any],
        after: dict[str, Any],
        inventory: dict[int, str],
        changed: bool,
        restore_capability_issued: bool = False,
        restore_capability_consumed: bool = False,
        restore_inventory_verified: bool = False,
        layout_restore: str | None = None,
        minimized_inventory_sha256: str | None = None,
        layout_checkpoint: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        identifier = parse_window_id(after.get("id"))
        if cls._window_state_identity_sha256(before) != cls._window_state_identity_sha256(after):
            raise ToolError("window identity changed during state transition")
        inventory_sha256 = cls._window_state_inventory_sha256(inventory)
        if minimized_inventory_sha256 is not None:
            if re.fullmatch(r"[0-9a-f]{64}", minimized_inventory_sha256) is None:
                raise ToolError("WindowStateSeal received an invalid minimized inventory digest")
            if not hmac.compare_digest(inventory_sha256, minimized_inventory_sha256):
                raise ToolError("window inventory changed since the minimize capability was issued")
        seal = {
            "schema": WINDOW_STATE_SEAL_SCHEMA,
            "window_id": identifier,
            "requested_state": requested_state,
            "changed": changed,
            "identity_sha256": cls._window_state_identity_sha256(after),
            "inventory_sha256": inventory_sha256,
            "inventory_count": len(inventory),
            "minimized_inventory_sha256": minimized_inventory_sha256,
            "before": {
                "visible": before.get("visible"),
                "workspace": before.get("workspace"),
                "fullscreen": before.get("fullscreen"),
                "floating": before.get("floating"),
                "scratchpad_state": before.get("scratchpad_state"),
            },
            "after": {
                "visible": after.get("visible"),
                "workspace": after.get("workspace"),
                "fullscreen": after.get("fullscreen"),
                "floating": after.get("floating"),
                "scratchpad_state": after.get("scratchpad_state"),
            },
            "restore_capability_issued": restore_capability_issued,
            "restore_capability_consumed": restore_capability_consumed,
            "restore_inventory_verified": restore_inventory_verified,
            "layout_restore": layout_restore,
            "layout_checkpoint": layout_checkpoint,
            "host_desktop_exposed": False,
        }
        seal["seal_sha256"] = hashlib.sha256(canonical_json(seal)).hexdigest()
        return seal

    def _wait_for_window_state(
        self,
        identifier: int,
        identity_sha256: str,
        inventory: dict[int, str],
        predicate: Callable[[dict[str, Any]], bool],
        description: str,
    ) -> tuple[list[dict[str, Any]], dict[str, Any]]:
        deadline = time.monotonic() + WINDOW_STATE_TRANSITION_TIMEOUT_SECONDS
        while True:
            windows = self._wayland_windows()
            current_inventory = self._window_state_inventory(windows)
            if current_inventory != inventory:
                raise ToolError(
                    "window inventory or immutable origin changed during WindowStateSeal transition"
                )
            window = next((item for item in windows if item.get("id") == identifier), None)
            if window is None:
                raise ToolError("window disappeared during WindowStateSeal transition")
            if not hmac.compare_digest(
                self._window_state_identity_sha256(window), identity_sha256
            ):
                raise ToolError("window identity changed during WindowStateSeal transition")
            if predicate(window):
                return windows, window
            if time.monotonic() >= deadline:
                raise ToolError(f"window did not become {description} before the bounded deadline")
            time.sleep(0.025)

    def _rollback_failed_minimize_preparation(
        self,
        *,
        identifier: int,
        identity_sha256: str,
        inventory: dict[int, str],
        workspace: str,
        focus_window_id: int,
    ) -> None:
        """Restore the reviewed fullscreen/focus state before scratchpad admission.

        Minimize must temporarily leave fullscreen so the latent floating class
        and geometry can be sealed. A compositor command, bounded waiter, token
        mint, or geometry-validation failure in that preparation phase must not
        silently leave the window windowed. Re-observe the exact immutable
        inventory, accept only the same visible origin, then explicitly restore
        fullscreen and the exact pre-minimize focused top-level.
        """
        windows = self._wayland_windows()
        if self._window_state_inventory(windows) != inventory:
            raise ToolError("window inventory changed during minimize-preparation rollback")
        window = next((item for item in windows if item.get("id") == identifier), None)
        if window is None or not hmac.compare_digest(
            self._window_state_identity_sha256(window), identity_sha256
        ):
            raise ToolError("window identity changed during minimize-preparation rollback")
        if (
            window.get("visible") is not True
            or window.get("scratchpad_state") != "none"
            or window.get("workspace") != workspace
        ):
            raise ToolError(
                "minimize-preparation rollback found the target outside its reviewed visible origin"
            )
        focus_window = next(
            (item for item in windows if item.get("id") == focus_window_id),
            None,
        )
        if (
            focus_window is None
            or focus_window.get("visible") is not True
            or focus_window.get("scratchpad_state") != "none"
        ):
            raise ToolError(
                "minimize-preparation rollback lost the exact pre-minimize focus target"
            )

        selector = f'[con_id="{identifier}"]'
        focus_selector = f'[con_id="{focus_window_id}"]'
        self._sway_command(f"{selector} fullscreen enable")
        self._sway_command(f"{focus_selector} focus")
        windows_after, _window_after = self._wait_for_window_state(
            identifier,
            identity_sha256,
            inventory,
            lambda candidate: (
                candidate.get("visible") is True
                and candidate.get("scratchpad_state") == "none"
                and candidate.get("workspace") == workspace
                and candidate.get("fullscreen") is True
                and candidate.get("focused") is (focus_window_id == identifier)
            ),
            "its exact fullscreen state after minimize-preparation rollback",
        )
        focused_ids = sorted(
            parse_window_id(item.get("id"))
            for item in windows_after
            if item.get("focused") is True
        )
        if focused_ids != [focus_window_id]:
            raise ToolError(
                "minimize-preparation rollback could not prove the exact pre-minimize focus"
            )
        focused_after = next(
            item for item in windows_after if item.get("id") == focus_window_id
        )
        if (
            focused_after.get("visible") is not True
            or focused_after.get("scratchpad_state") != "none"
        ):
            raise ToolError(
                "minimize-preparation rollback focus target is not visibly restorable"
            )

    def _rollback_failed_minimize(
        self,
        *,
        identifier: int,
        identity_sha256: str,
        inventory: dict[int, str],
        workspace: str,
        original_fullscreen: bool,
        floating_enabled: bool,
        geometry: dict[str, int],
        focus_window_id: int,
    ) -> None:
        """Restore the exact reviewed visible state after uncertain scratchpad admission.

        A Sway command can be accepted before the bounded state waiter observes
        its result.  A timeout after ``move container to scratchpad`` must not
        leave a now-hidden window without the one-time restore capability that
        would normally be minted only after a proven admission.  Re-observe the
        immutable inventory, distinguish the two safe rollback starting states
        (still-visible origin or exact hidden scratchpad member), then rebuild
        and prove the latent windowed layout before reinstating fullscreen.
        """
        windows = self._wayland_windows()
        if self._window_state_inventory(windows) != inventory:
            raise ToolError("window inventory changed during failed-minimize rollback")
        window = next((item for item in windows if item.get("id") == identifier), None)
        if window is None or not hmac.compare_digest(
            self._window_state_identity_sha256(window), identity_sha256
        ):
            raise ToolError("window identity changed during failed-minimize rollback")
        if focus_window_id not in inventory:
            raise ToolError("failed-minimize rollback lost its exact focus identity")
        focus_window = next(
            (item for item in windows if item.get("id") == focus_window_id),
            None,
        )
        if focus_window is None:
            raise ToolError("failed-minimize rollback focus target disappeared")
        if focus_window_id != identifier and (
            focus_window.get("visible") is not True
            or focus_window.get("scratchpad_state") != "none"
        ):
            raise ToolError("failed-minimize rollback focus target is no longer visible")

        selector = f'[con_id="{identifier}"]'
        hidden = (
            window.get("visible") is False
            and window.get("scratchpad_state") == "fresh"
        )
        visible_origin = (
            window.get("visible") is True
            and window.get("scratchpad_state") == "none"
            and window.get("workspace") == workspace
        )
        if hidden:
            self._sway_command(f"workspace --no-auto-back-and-forth {workspace}")
            self._sway_command(f"{selector} scratchpad show")
            self._sway_command(f"{selector} move container to workspace {workspace}")
        elif not visible_origin:
            raise ToolError(
                "failed-minimize rollback found neither the reviewed visible window "
                "nor its exact hidden scratchpad container"
            )

        x = as_int(geometry.get("x"), 0, self.width - 1, "rollback geometry x")
        y = as_int(geometry.get("y"), 0, self.height - 1, "rollback geometry y")
        width = as_int(geometry.get("width"), 1, self.width, "rollback geometry width")
        height = as_int(geometry.get("height"), 1, self.height, "rollback geometry height")
        self._sway_command(f"{selector} fullscreen disable")
        if floating_enabled:
            self._sway_command(
                f"{selector} floating enable, "
                f"{selector} move absolute position {x} px {y} px, "
                f"{selector} resize set width {width} px height {height} px"
            )
        else:
            self._sway_command(f"{selector} floating disable")

        self._wait_for_window_state(
            identifier,
            identity_sha256,
            inventory,
            lambda candidate: (
                candidate.get("visible") is True
                and candidate.get("scratchpad_state") == "none"
                and candidate.get("workspace") == workspace
                and candidate.get("fullscreen") is False
                and self._window_layout_matches(
                    candidate,
                    floating_enabled=floating_enabled,
                    geometry={"x": x, "y": y, "width": width, "height": height},
                )
            ),
            "its pre-minimize windowed layout during rollback",
        )
        if original_fullscreen:
            self._sway_command(f"{selector} fullscreen enable")
        focus_selector = f'[con_id="{focus_window_id}"]'
        self._sway_command(f"{focus_selector} focus")
        windows_after, _window_after = self._wait_for_window_state(
            identifier,
            identity_sha256,
            inventory,
            lambda candidate: (
                candidate.get("visible") is True
                and candidate.get("scratchpad_state") == "none"
                and candidate.get("workspace") == workspace
                and bool(candidate.get("fullscreen")) == original_fullscreen
                and self._window_floating_enabled(candidate) == floating_enabled
                and (
                    original_fullscreen
                    or self._window_layout_matches(
                        candidate,
                        floating_enabled=floating_enabled,
                        geometry={"x": x, "y": y, "width": width, "height": height},
                    )
                )
                and candidate.get("focused") is (focus_window_id == identifier)
            ),
            "its exact reviewed state after failed-minimize rollback",
        )
        focused_ids = sorted(
            parse_window_id(item.get("id"))
            for item in windows_after
            if item.get("focused") is True
        )
        if focused_ids != [focus_window_id]:
            raise ToolError("failed-minimize rollback could not prove the exact prior focus")
        focused_after = next(
            item for item in windows_after if item.get("id") == focus_window_id
        )
        if (
            focused_after.get("visible") is not True
            or focused_after.get("scratchpad_state") != "none"
        ):
            raise ToolError("failed-minimize rollback focus target is not visible")

    def _window_scene(self) -> tuple[str, str, list[dict[str, Any]], int | None]:
        structured = self.windows({})["structuredContent"]
        windows = structured.get("windows", [])
        active = structured.get("active_window")
        active_value = next((window for window in windows if window.get("id") == active), None)
        active_signature = hashlib.sha256(canonical_json(active_value)).hexdigest() if active_value else "0" * 64
        return active_signature, self._window_signature_value(windows), windows, active

    def _active_and_window_signatures(self) -> tuple[str, str]:
        active_signature, window_signature, _windows, _active = self._window_scene()
        return active_signature, window_signature

    @staticmethod
    def _keyboard_window_identity(window: dict[str, Any]) -> dict[str, Any]:
        """Project one top-level into a stable keyboard-routing identity.

        Titles, geometry, urgency, and ordinary rendered state may legitimately
        change while text is entered.  The compositor container and immutable
        launch-origin fields may not: a different focused top-level must never
        inherit the remainder of a keyboard sequence.
        """
        return {
            "schema": KEYBOARD_FENCE_TARGET_IDENTITY_SCHEMA,
            "window_id": window.get("id"),
            "app_id": window.get("app_id"),
            "pid": window.get("pid"),
            "shell": window.get("shell"),
            "workspace": window.get("workspace"),
            "sandbox_engine": window.get("sandbox_engine"),
            "sandbox_app_id": window.get("sandbox_app_id"),
            "sandbox_instance_id": window.get("sandbox_instance_id"),
            "launch_id": window.get("launch_id"),
            "scene_id": window.get("scene_id"),
            "managed_pid": window.get("managed_pid"),
            "origin": window.get("origin"),
            "origin_verified": window.get("origin_verified"),
            "capture_identity_available": window.get("capture_identity_available"),
            "capture_identity_sha256": window.get("capture_identity_sha256"),
        }

    def _keyboard_target(
        self,
        windows: list[dict[str, Any]],
        active_window_id: int | None,
        launch_id: str | None,
        scene_launch_ids: tuple[str, ...] | None = None,
        scene_id: str | None = None,
        scene_set_authority_sha256: str | None = None,
    ) -> dict[str, Any]:
        if active_window_id is None:
            raise ToolError("guarded keyboard input requires an observed active window")
        window = next((item for item in windows if item.get("id") == active_window_id), None)
        if window is None:
            raise ToolError("guarded keyboard target is absent from the observed compositor scene")
        if launch_id is not None and scene_launch_ids is not None:
            raise ToolError("guarded keyboard target cannot mix launch and scene-set scope")
        if launch_id is not None:
            if window.get("launch_id") != launch_id or window.get("origin_verified") is not True:
                raise ToolError("guarded keyboard target is not owned by the scoped launch")
        if scene_launch_ids is not None:
            allowed = set(scene_launch_ids)
            if (
                not 2 <= len(allowed) <= SCENE_SET_MAX_LAUNCHES
                or len(allowed) != len(scene_launch_ids)
                or window.get("launch_id") not in allowed
                or window.get("origin_verified") is not True
            ):
                raise ToolError("guarded keyboard target is not owned by the exact scene-set")
            normalized_scene = self._scene_id(scene_id, required=True)
            assert normalized_scene is not None
            if (
                not isinstance(scene_set_authority_sha256, str)
                or re.fullmatch(r"[0-9a-f]{64}", scene_set_authority_sha256) is None
            ):
                raise ToolError("guarded keyboard scene-set authority is invalid")
        else:
            normalized_scene = None
        identity = self._keyboard_window_identity(window)
        return {
            "window_id": active_window_id,
            "launch_id": window.get("launch_id"),
            "scene_id": normalized_scene,
            "scene_launch_ids": (
                tuple(sorted(scene_launch_ids)) if scene_launch_ids is not None else ()
            ),
            "scene_set_authority_sha256": scene_set_authority_sha256,
            "scene_member_set_sha256": (
                hashlib.sha256(canonical_json(sorted(scene_launch_ids))).hexdigest()
                if scene_launch_ids is not None else None
            ),
            "origin": window.get("origin"),
            "identity": identity,
            "identity_sha256": hashlib.sha256(canonical_json(identity)).hexdigest(),
        }

    def _assert_keyboard_target(self, target: dict[str, Any]) -> None:
        _active_signature, _window_signature, windows, active_window_id = self._window_scene()
        if active_window_id != target.get("window_id"):
            raise KeyboardTargetTransition(
                "keyboard focus left the guarded top-level; no further input was emitted"
            )
        window = next((item for item in windows if item.get("id") == active_window_id), None)
        if window is None:
            raise KeyboardTargetTransition(
                "guarded keyboard target disappeared; no further input was emitted"
            )
        identity = self._keyboard_window_identity(window)
        if hashlib.sha256(canonical_json(identity)).hexdigest() != target.get("identity_sha256"):
            raise KeyboardTargetTransition(
                "guarded keyboard target identity changed; no further input was emitted"
            )
        launch_id = target.get("launch_id")
        if launch_id is not None and (
            window.get("launch_id") != launch_id or window.get("origin_verified") is not True
        ):
            raise KeyboardTargetTransition(
                "guarded keyboard target lost its launch attribution; no further input was emitted"
            )
        scene_launch_ids = target.get("scene_launch_ids")
        if scene_launch_ids:
            try:
                if not isinstance(scene_launch_ids, tuple):
                    raise ToolError("guarded keyboard scene membership is malformed")
                members = self._managed_scene(
                    target.get("scene_id"),
                    expected_launch_ids=scene_launch_ids,
                )
                self._assert_scene_set_authority(
                    members,
                    target.get("scene_set_authority_sha256"),
                    windows,
                )
                if (
                    window.get("launch_id") not in set(scene_launch_ids)
                    or window.get("origin_verified") is not True
                ):
                    raise ToolError("guarded keyboard target left the scene-set")
            except ToolError as error:
                raise KeyboardTargetTransition(
                    "guarded keyboard scene-set authority changed; no further input was emitted"
                ) from error

    @staticmethod
    def _pointer_window_identity(window: dict[str, Any]) -> dict[str, Any]:
        """Project one top-level into a stable pointer-routing identity.

        Pointer delivery depends on geometry as well as compositor and launch
        identity. Titles, focus, urgency, and ordinary rendered contents may
        legitimately change after input. A replacement, moved, resized, hidden,
        re-attributed, or newly interposed top-level must not inherit another
        unit from the same guarded gesture.
        """
        return {
            "schema": POINTER_FENCE_TARGET_IDENTITY_SCHEMA,
            "window_id": window.get("id"),
            "app_id": window.get("app_id"),
            "class": window.get("class"),
            "instance": window.get("instance"),
            "pid": window.get("pid"),
            "shell": window.get("shell"),
            "workspace": window.get("workspace"),
            "x": window.get("x"),
            "y": window.get("y"),
            "width": window.get("width"),
            "height": window.get("height"),
            "window_rect": window.get("window_rect"),
            "deco_rect": window.get("deco_rect"),
            "visible": window.get("visible"),
            "fullscreen": window.get("fullscreen"),
            "sandbox_engine": window.get("sandbox_engine"),
            "sandbox_app_id": window.get("sandbox_app_id"),
            "sandbox_instance_id": window.get("sandbox_instance_id"),
            "launch_id": window.get("launch_id"),
            "scene_id": window.get("scene_id"),
            "managed_pid": window.get("managed_pid"),
            "origin": window.get("origin"),
            "origin_verified": window.get("origin_verified"),
            "capture_identity_available": window.get("capture_identity_available"),
            "capture_identity_sha256": window.get("capture_identity_sha256"),
        }

    @classmethod
    def _pointer_window_identity_sha256(cls, window: dict[str, Any]) -> str:
        return hashlib.sha256(canonical_json(cls._pointer_window_identity(window))).hexdigest()

    @classmethod
    def _pointer_scene_sha256(cls, windows: list[dict[str, Any]]) -> str:
        identities = [
            cls._pointer_window_identity(window)
            for window in windows
            if window.get("visible", True)
        ]
        identities.sort(key=lambda identity: int(identity.get("window_id") or 0))
        return hashlib.sha256(canonical_json(identities)).hexdigest()

    @classmethod
    def _pointer_covering_identities(
        cls,
        windows: list[dict[str, Any]],
        x: int,
        y: int,
    ) -> tuple[str, ...]:
        values = [
            cls._pointer_window_identity_sha256(window)
            for window in windows
            if window.get("visible", True) and cls._point_in_window(window, x, y)
        ]
        return tuple(sorted(values))

    def _pointer_hit_test_seal(
        self,
        x: int,
        y: int,
        windows: list[dict[str, Any]],
        *,
        launch_id: str | None,
        allowed_launch_ids: set[str] | None,
        expected_window_id: int | None,
        hit_override: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        """Bind one pointer checkpoint to Sway's exact dispatch target.

        The patched compositor calls the same ``node_at_coords`` scene-graph
        oracle as pointer dispatch. A hit is either an exact client surface or
        a server-side decoration owned by an exact view. Raw Wayland object and
        client credentials remain inside ``CompositorEventSeal``; the route
        carries only a keyed identity and a context digest.
        """
        if getattr(self, "pointer_hit_test_required", False) is not True:
            raise ToolError("production pointer HitTestSeal authority is not enabled")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway HitTestSeal is unavailable")
        if hit_override is None:
            hit = seal.hit_test(x, y)
        elif not isinstance(hit_override, dict):
            raise ToolError("prepared compositor HitTestSeal authority is malformed")
        else:
            hit = dict(hit_override)
        if hit.get("schema") != HIT_TEST_SEAL_SCHEMA or hit.get("hit") is not True:
            raise ToolError("pointer checkpoint has no compositor dispatch target")

        target_kind = hit.get("target_kind")
        if target_kind not in {"surface", "decoration"}:
            raise ToolError("compositor HitTestSeal returned an invalid target kind")
        surface_class = hit.get("surface_class")
        if target_kind == "surface" and surface_class not in {"toplevel", "child"}:
            raise ToolError("compositor HitTestSeal returned an invalid surface class")
        if target_kind == "decoration" and surface_class != "decoration":
            raise ToolError("compositor HitTestSeal returned an invalid decoration class")

        container_id = hit.get("container_id")
        if type(container_id) is not int or container_id <= 0:
            raise ToolError("compositor HitTestSeal returned an invalid top-level owner")
        owner = next(
            (
                window for window in windows
                if window.get("visible", True) and window.get("id") == container_id
            ),
            None,
        )
        if owner is None:
            raise ToolError("compositor dispatch owner is absent from the sealed tree")
        if expected_window_id is not None and container_id != expected_window_id:
            raise ToolError("compositor dispatch owner differs from reviewed visual ownership")

        owner_launch_id = owner.get("launch_id")
        scoped = launch_id is not None or allowed_launch_ids is not None
        if scoped:
            if owner.get("origin_verified") is not True:
                raise ToolError("compositor dispatch owner has no verified launch origin")
            if not isinstance(owner_launch_id, str) or not owner_launch_id:
                raise ToolError("compositor dispatch owner has no launch identity")
            if launch_id is not None and owner_launch_id != launch_id:
                raise ToolError("compositor dispatch owner left the guarded launch")
            if allowed_launch_ids is not None and owner_launch_id not in allowed_launch_ids:
                raise ToolError("compositor dispatch owner is outside the guarded scene-set")
        elif owner_launch_id is not None and not isinstance(owner_launch_id, str):
            raise ToolError("compositor dispatch owner launch identity is malformed")

        # The tree and point query are independent compositor observations.
        # Their complete security-context projections must agree.
        for field in ("sandbox_engine", "sandbox_app_id", "sandbox_instance_id"):
            observed = hit.get(field)
            reviewed = owner.get(field)
            if observed != reviewed:
                raise ToolError(
                    f"compositor dispatch owner {field.replace('_', ' ')} changed"
                )
            if observed is not None and (not isinstance(observed, str) or not observed):
                raise ToolError(
                    f"compositor dispatch owner {field.replace('_', ' ')} is malformed"
                )
        if scoped:
            if hit.get("sandbox_engine") != SANDBOX_ENGINE:
                raise ToolError("compositor dispatch owner is outside Sandcodex custody")
            if hit.get("sandbox_instance_id") != owner_launch_id:
                raise ToolError("compositor dispatch owner instance is not its launch capability")

        def normalized_shell(value: Any) -> str:
            return str(value or "").strip().lower().replace("-", "_")

        shell = normalized_shell(hit.get("shell"))
        if shell != normalized_shell(owner.get("shell")):
            raise ToolError("compositor dispatch owner shell identity changed")
        owner_pid = owner.get("pid")
        view_pid = hit.get("view_pid")
        for label, value in (("tree owner", owner_pid), ("view owner", view_pid)):
            if type(value) is not int or value <= 0:
                raise ToolError(f"compositor dispatch {label} process identity is invalid")
        if view_pid != owner_pid:
            raise ToolError("compositor tree and point-query view process identities changed")

        managed = None
        if scoped:
            assert isinstance(owner_launch_id, str) and owner_launch_id
            managed = self._managed_by_launch_id(owner_launch_id)
            self._refresh_managed(managed)
            if owner.get("managed_pid") != managed.process.pid:
                raise ToolError("compositor dispatch owner launch leader identity changed")
            if not managed.members:
                raise ToolError("compositor dispatch owner launch process tree is empty")
            for label, value in (("tree owner", owner_pid), ("view owner", view_pid)):
                if value not in managed.members:
                    raise ToolError(
                        f"compositor dispatch {label} escaped the birth-pinned launch process tree"
                    )

        client_input_region = target_kind == "surface"
        if target_kind == "decoration":
            for field in (
                "surface_resource_id", "surface_client_pid",
                "surface_client_uid", "surface_client_gid",
            ):
                if hit.get(field) is not None:
                    raise ToolError("compositor decoration target invented surface credentials")
            recipient_process_scope = (
                "birth-pinned-launch-view+compositor-decoration"
                if scoped else "exact-compositor-view+decoration"
            )
        else:
            resource_id = hit.get("surface_resource_id")
            client_pid = hit.get("surface_client_pid")
            client_uid = hit.get("surface_client_uid")
            client_gid = hit.get("surface_client_gid")
            if type(resource_id) is not int or resource_id <= 0:
                raise ToolError("compositor dispatch surface resource identity is invalid")
            if type(client_pid) is not int or client_pid <= 0:
                raise ToolError("compositor dispatch surface client process identity is invalid")
            if client_uid != os.geteuid() or client_gid != os.getegid():
                raise ToolError("compositor dispatch surface credentials left the private user")

            xwayland_proxy = shell == "xwayland" and (
                managed is None or client_pid not in managed.members
            )
            if scoped:
                assert managed is not None
                if client_pid in managed.members:
                    recipient_process_scope = "birth-pinned-launch-process-tree"
                elif xwayland_proxy:
                    if proc_identity(client_pid) is None:
                        raise ToolError("Xwayland compositor proxy process is no longer live")
                    recipient_process_scope = "birth-pinned-view+xwayland-proxy-client"
                else:
                    raise ToolError(
                        "compositor dispatch surface client escaped the birth-pinned launch process tree"
                    )
            elif client_pid == owner_pid:
                recipient_process_scope = "exact-compositor-client"
            elif xwayland_proxy:
                if proc_identity(client_pid) is None:
                    raise ToolError("Xwayland compositor proxy process is no longer live")
                recipient_process_scope = "exact-view+xwayland-proxy-client"
            else:
                raise ToolError("unscoped compositor dispatch recipient process identity changed")

        identity = hit.get("identity_authority_sha256")
        if not isinstance(identity, str) or re.fullmatch(r"[0-9a-f]{64}", identity) is None:
            raise ToolError("compositor dispatch authority digest is invalid")
        recipient_identity = hit.get("recipient_authority_sha256")
        if (
            target_kind == "surface"
            and (
                not isinstance(recipient_identity, str)
                or re.fullmatch(r"[0-9a-f]{64}", recipient_identity) is None
            )
        ):
            raise ToolError("compositor dispatch recipient authority digest is invalid")
        if target_kind == "decoration" and recipient_identity is not None:
            if (
                not isinstance(recipient_identity, str)
                or re.fullmatch(r"[0-9a-f]{64}", recipient_identity) is None
            ):
                raise ToolError("compositor decoration recipient authority digest is invalid")
        context_projection = {
            "sandbox_engine": hit["sandbox_engine"],
            "sandbox_app_id": hit["sandbox_app_id"],
            "sandbox_instance_id": hit["sandbox_instance_id"],
            "shell": shell,
            "window_id": container_id,
            "launch_id": owner_launch_id,
            "target_kind": target_kind,
            "surface_class": surface_class,
            "recipient_process_scope": recipient_process_scope,
            "dispatch_path": HIT_TEST_DISPATCH_PATH,
        }
        return {
            "hit_test_schema": HIT_TEST_SEAL_SCHEMA,
            "hit_test_identity_sha256": identity,
            "hit_test_recipient_identity_sha256": recipient_identity,
            "hit_test_context_sha256": hashlib.sha256(
                canonical_json(context_projection)
            ).hexdigest(),
            "hit_test_window_id": container_id,
            "hit_test_launch_id": owner_launch_id,
            "hit_test_target_kind": target_kind,
            "hit_test_surface_class": surface_class,
            "hit_test_recipient_process_scope": recipient_process_scope,
            "hit_test_exact_dispatch_target": True,
            "hit_test_client_input_region": client_input_region,
            "hit_test_dispatch_path": HIT_TEST_DISPATCH_PATH,
        }

    def _drag_anchors(self, arguments: dict[str, Any]) -> list[tuple[int, int]]:
        start = (
            as_int(arguments.get("start_x"), 0, self.width - 1, "start_x"),
            as_int(arguments.get("start_y"), 0, self.height - 1, "start_y"),
        )
        end = (
            as_int(arguments.get("end_x"), 0, self.width - 1, "end_x"),
            as_int(arguments.get("end_y"), 0, self.height - 1, "end_y"),
        )
        raw_waypoints = arguments.get("waypoints", [])
        if raw_waypoints is None:
            raw_waypoints = []
        if not isinstance(raw_waypoints, list) or len(raw_waypoints) > POINTER_FENCE_MAX_DRAG_WAYPOINTS:
            raise ToolError(
                f"waypoints must be an array with at most {POINTER_FENCE_MAX_DRAG_WAYPOINTS} coordinate objects"
            )
        anchors = [start]
        for index, raw in enumerate(raw_waypoints):
            if not isinstance(raw, dict) or set(raw) != {"x", "y"}:
                raise ToolError(f"waypoints[{index}] must contain exactly integer x and y fields")
            point = (
                as_int(raw.get("x"), 0, self.width - 1, f"waypoints[{index}].x"),
                as_int(raw.get("y"), 0, self.height - 1, f"waypoints[{index}].y"),
            )
            if point != anchors[-1]:
                anchors.append(point)
        if end != anchors[-1]:
            anchors.append(end)
        return anchors

    def _drag_points(self, arguments: dict[str, Any]) -> list[tuple[int, int]]:
        """Return a bounded polyline with both spatial and temporal checkpoints."""
        anchors = self._drag_anchors(arguments)
        duration = as_number(arguments.get("duration", 0.4), 0.0, 10.0, "duration")
        if len(anchors) == 1:
            units = max(1, math.ceil(duration * 1000 / POINTER_FENCE_MAX_SEGMENT_MILLISECONDS))
            if units > POINTER_FENCE_MAX_DRAG_SEGMENTS:
                raise ToolError("drag duration exceeds the guarded checkpoint limit")
            return [anchors[0]] * (units + 1)

        metrics: list[int] = []
        required: list[int] = []
        for start, end in zip(anchors, anchors[1:]):
            metric = max(abs(end[0] - start[0]), abs(end[1] - start[1]))
            metrics.append(metric)
            required.append(max(1, math.ceil(metric / POINTER_FENCE_MAX_SEGMENT_PIXELS)))
        required_total = sum(required)
        temporal_total = max(1, math.ceil(duration * 1000 / POINTER_FENCE_MAX_SEGMENT_MILLISECONDS))
        target_total = max(required_total, temporal_total)
        if target_total > POINTER_FENCE_MAX_DRAG_SEGMENTS:
            raise ToolError(
                "drag route requires too many guarded segments; shorten the route, reduce waypoints, or split it across fresh observations"
            )

        allocations = list(required)
        extra = target_total - required_total
        metric_total = sum(metrics)
        if extra and metric_total:
            exact = [extra * metric / metric_total for metric in metrics]
            floors = [math.floor(value) for value in exact]
            allocations = [base + addition for base, addition in zip(allocations, floors)]
            remaining = extra - sum(floors)
            order = sorted(
                range(len(metrics)),
                key=lambda index: (exact[index] - floors[index], metrics[index], -index),
                reverse=True,
            )
            for index in order[:remaining]:
                allocations[index] += 1

        points = [anchors[0]]
        for anchor_start, anchor_end, steps in zip(anchors, anchors[1:], allocations):
            for step in range(1, steps + 1):
                fraction = step / steps
                points.append((
                    round(anchor_start[0] + (anchor_end[0] - anchor_start[0]) * fraction),
                    round(anchor_start[1] + (anchor_end[1] - anchor_start[1]) * fraction),
                ))
        if points[-1] != anchors[-1]:
            raise ToolError("internal guarded drag endpoint construction failed")
        for previous, current in zip(points, points[1:]):
            if max(abs(current[0] - previous[0]), abs(current[1] - previous[1])) > POINTER_FENCE_MAX_SEGMENT_PIXELS:
                raise ToolError("internal guarded drag segment exceeded its spatial ceiling")
        return points

    def _touch_stroke_points(
        self, arguments: dict[str, Any]
    ) -> list[tuple[int, int]]:
        """Build the exact bounded integer path that private Sway will attest."""
        start_x = as_int(arguments.get("start_x"), 0, self.width - 1, "start_x")
        start_y = as_int(arguments.get("start_y"), 0, self.height - 1, "start_y")
        end_x = as_int(arguments.get("end_x"), 0, self.width - 1, "end_x")
        end_y = as_int(arguments.get("end_y"), 0, self.height - 1, "end_y")
        steps = as_int(
            arguments.get("steps", TOUCH_STROKE_DEFAULT_STEPS),
            1,
            TOUCH_STROKE_MAX_STEPS,
            "steps",
        )
        duration_milliseconds = as_int(
            arguments.get(
                "duration_milliseconds",
                TOUCH_STROKE_DEFAULT_DURATION_MILLISECONDS,
            ),
            steps + 1,
            TOUCH_STROKE_MAX_DURATION_MILLISECONDS,
            "duration_milliseconds",
        )
        arguments["steps"] = steps
        arguments["duration_milliseconds"] = duration_milliseconds

        def coordinate(start: int, end: int, index: int) -> int:
            if index == 0 or start == end:
                return start
            if index >= steps:
                return end
            delta = end - start
            magnitude = (abs(delta) * index) // steps
            return start + (-magnitude if delta < 0 else magnitude)

        points = [
            (coordinate(start_x, end_x, index), coordinate(start_y, end_y, index))
            for index in range(steps + 1)
        ]
        if points[0] != (start_x, start_y) or points[-1] != (end_x, end_y):
            raise ToolError("internal native touch-stroke endpoint construction failed")
        return points

