sc_campaign_help() {
  case "${1:-}" in
    start)
      printf '%s\n' 'usage: sandcodex-campaign start --name NAME [--turns N] [--verifier TRACKED_SHELL] --prompt TEXT'
      printf '%s\n' '       sandcodex-campaign start NAME [--turns N] --prompt-file RELATIVE_PATH'
      printf '%s\n' '       turns defaults to 0 (unbounded); a positive launch ceiling may require N'
      ;;
    status|events|send|stop|restart|collect|remove)
      printf 'usage: sandcodex-campaign %s --name NAME' "$1"
      [[ "$1" != events ]] || printf ' [--follow] [--cursor N]'
      [[ "$1" != send ]] || printf ' --message TEXT'
      [[ "$1" != collect ]] || printf ' --output RELATIVE_BUNDLE_PATH'
      printf '\n'
      ;;
    grant)
      printf '%s\n' 'usage: sandcodex-campaign grant status|allow-starts|revoke-starts|capacity|remote-auto-on|remote-auto-off'
      ;;
    list)
      printf '%s\n' 'usage: sandcodex-campaign list [--json]'
      ;;
    *)
      cat <<'EOF'
Sandcodex companion campaign broker

  sandcodex-campaign start --name worker-1 --turns 8 --prompt 'Task text'
  sandcodex-campaign list
  sandcodex-campaign status --name worker-1
  sandcodex-campaign events --name worker-1 --follow
  sandcodex-campaign send --name worker-1 --message 'Steer the worker.'
  sandcodex-campaign stop --name worker-1
  sandcodex-campaign restart --name worker-1
  sandcodex-campaign collect --name worker-1 --output .sandcodex/work/campaign-artifacts/worker-1.bundle

This helper talks only to the already-authorized broker. It does not require
inspecting /run or provider contracts. `sandcodex-worker` is its friendlier
action-first alias inside an interactive room.
EOF
      ;;
  esac
}

sc_team_help() {
  cat <<'EOF'
Sandcodex team control plane

  sandcodex-team start NAME [--turns N] --prompt 'Task' [--depends OTHER]
                         [--provider auto|gpt|gemini|remote|local|openrouter]
                         [--verifier TRACKED_SHELL]
  sandcodex-team list | top | status NAME | inspect NAME | events NAME --follow
  sandcodex-team send NAME --message 'Steer it' [--attachment RELATIVE_PATH]
  sandcodex-team inbox [--name NAME] | ack --message-id ID
  sandcodex-team wait NAME | wait-any [--timeout 1800]
  sandcodex-team attach NAME | collect NAME --output RELATIVE_BUNDLE_PATH
  sandcodex-team diff NAME | test NAME | test NAME -- COMMAND... | stage NAME
  sandcodex-team adopt NAME [--strategy cherry-pick|merge]
  sandcodex-team graph --file TEAM.json
  sandcodex-team grant status|allow-starts|revoke-starts|capacity
  sandcodex-team grant browser-isolated-on|browser-isolated-off
  sandcodex-team grant desktop-isolated-on|desktop-isolated-off

Workers are independent, contained Git clones. A tracked verifier is sealed
from the exact base with `--verifier`; `test NAME` runs it beyond worker control.
`test NAME -- COMMAND...` is diagnostic and cannot authorize adoption. Changed
work enters the primary checkout only through explicit `adopt` after a passing
sealed receipt for that exact candidate and campaign epoch. Browser
and desktop access are separate worker realms and require explicit live grants.
Turns default to 0 (unbounded until completion or stop); a positive launch
ceiling may require a finite N. Status and events are authoritative progress,
not elapsed-time estimates.
The compatibility names sandcodex-worker and sandcodex campaign remain valid.
EOF
}

sc_parse_campaign() {
  SC_HELP_TOPIC=team
  (( $# )) || {
    (( SC_TEAM_MODE )) && sc_team_help && exit 0
    sc_usage_error "campaign requires start, list, status, events, send, stop, restart, collect, grant, or remove"
  }
  SC_CAMPAIGN_ACTION="$1"; shift
  case "$SC_CAMPAIGN_ACTION" in
    start|list|status|events|send|stop|restart|collect|grant|remove) ;;
    inbox|ack|wait|wait-any|attach|inspect|top|diff|test|stage|adopt|graph)
      (( SC_TEAM_MODE )) || sc_usage_error "unknown campaign action: $SC_CAMPAIGN_ACTION"
      ;;
    -h|--help|help)
      if (( SC_TEAM_MODE )); then sc_team_help; else sc_campaign_help; fi
      exit 0
      ;;
    *) sc_usage_error "unknown campaign action: $SC_CAMPAIGN_ACTION" ;;
  esac
  if [[ "$SC_CAMPAIGN_ACTION" == grant && $# -gt 0 && "$1" != -* ]]; then
    SC_CAMPAIGN_GRANT_ACTION="$1"
    SC_CAMPAIGN_GRANT_ACTION_SET=1
    shift
  fi
  if [[ "$SC_CAMPAIGN_ACTION" != list && "$SC_CAMPAIGN_ACTION" != top && \
        "$SC_CAMPAIGN_ACTION" != wait-any && "$SC_CAMPAIGN_ACTION" != inbox && \
        "$SC_CAMPAIGN_ACTION" != ack && "$SC_CAMPAIGN_ACTION" != graph && \
        "$SC_CAMPAIGN_ACTION" != grant && $# -gt 0 && "$1" != -* ]]; then
    SC_CAMPAIGN_NAME="$1"
    shift
  fi
  while (( $# )); do
    case "$1" in
      --project) (( $# > 1 )) || sc_usage_error "--project requires DIR"; SC_PROJECT_ARG="$2"; shift 2 ;;
      --project=*) SC_PROJECT_ARG="${1#*=}"; shift ;;
      --name) (( $# > 1 )) || sc_usage_error "--name requires NAME"; SC_CAMPAIGN_NAME="$2"; shift 2 ;;
      --name=*) SC_CAMPAIGN_NAME="${1#*=}"; shift ;;
      --turns) (( $# > 1 )) || sc_usage_error "--turns requires N"; SC_CAMPAIGN_TURNS="$2"; shift 2 ;;
      --turns=*) SC_CAMPAIGN_TURNS="${1#*=}"; shift ;;
      --base) (( $# > 1 )) || sc_usage_error "--base requires REV"; SC_CAMPAIGN_BASE="$2"; shift 2 ;;
      --base=*) SC_CAMPAIGN_BASE="${1#*=}"; shift ;;
      --browser) (( $# > 1 )) || sc_usage_error "--browser requires none or isolated"; SC_CAMPAIGN_BROWSER="${2,,}"; shift 2 ;;
      --browser=*) SC_CAMPAIGN_BROWSER="${1#*=}"; SC_CAMPAIGN_BROWSER="${SC_CAMPAIGN_BROWSER,,}"; shift ;;
      --desktop) (( $# > 1 )) || sc_usage_error "--desktop requires none or isolated"; SC_CAMPAIGN_DESKTOP="${2,,}"; shift 2 ;;
      --desktop=*) SC_CAMPAIGN_DESKTOP="${1#*=}"; SC_CAMPAIGN_DESKTOP="${SC_CAMPAIGN_DESKTOP,,}"; shift ;;
      --prompt|--message)
        (( $# > 1 )) || sc_usage_error "$1 requires TEXT"
        (( ! SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "choose exactly one campaign prompt or message source"
        SC_CAMPAIGN_PROMPT="$2"; SC_CAMPAIGN_PROMPT_SET=1; shift 2
        ;;
      --prompt=*|--message=*)
        (( ! SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "choose exactly one campaign prompt or message source"
        SC_CAMPAIGN_PROMPT="${1#*=}"; SC_CAMPAIGN_PROMPT_SET=1; shift
        ;;
      --prompt-file|--message-file)
        (( $# > 1 )) || sc_usage_error "$1 requires a project-relative PATH"
        (( ! SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "choose exactly one campaign prompt or message source"
        SC_CAMPAIGN_PROMPT_FILE="$2"; SC_CAMPAIGN_PROMPT_SET=1; shift 2
        ;;
      --prompt-file=*|--message-file=*)
        (( ! SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "choose exactly one campaign prompt or message source"
        SC_CAMPAIGN_PROMPT_FILE="${1#*=}"; SC_CAMPAIGN_PROMPT_SET=1; shift
        ;;
      --output) (( $# > 1 )) || sc_usage_error "--output requires a project-relative PATH"; SC_CAMPAIGN_OUTPUT="$2"; shift 2 ;;
      --output=*) SC_CAMPAIGN_OUTPUT="${1#*=}"; shift ;;
      --to) (( $# > 1 )) || sc_usage_error "--to requires foreman or a worker name"; SC_TEAM_TO="$2"; shift 2 ;;
      --to=*) SC_TEAM_TO="${1#*=}"; shift ;;
      --message-id) (( $# > 1 )) || sc_usage_error "--message-id requires ID"; SC_TEAM_MESSAGE_ID="$2"; shift 2 ;;
      --message-id=*) SC_TEAM_MESSAGE_ID="${1#*=}"; shift ;;
      --attachment) (( $# > 1 )) || sc_usage_error "--attachment requires a project-relative PATH"; SC_TEAM_ATTACHMENT="$2"; shift 2 ;;
      --attachment=*) SC_TEAM_ATTACHMENT="${1#*=}"; shift ;;
      --depends) (( $# > 1 )) || sc_usage_error "--depends requires NAME"; SC_TEAM_DEPENDS+=("$2"); shift 2 ;;
      --depends=*) SC_TEAM_DEPENDS+=("${1#*=}"); shift ;;
      --provider) (( $# > 1 )) || sc_usage_error "--provider requires auto, gpt, gemini, remote, local, or openrouter"; SC_TEAM_PROVIDER="${2,,}"; shift 2 ;;
      --provider=*) SC_TEAM_PROVIDER="${1#*=}"; SC_TEAM_PROVIDER="${SC_TEAM_PROVIDER,,}"; shift ;;
      --allow-provider) (( $# > 1 )) || sc_usage_error "--allow-provider requires a provider kind"; SC_TEAM_ALLOWED_PROVIDERS+=("${2,,}"); shift 2 ;;
      --allow-provider=*) SC_TEAM_ALLOWED_PROVIDERS+=("${1#*=}"); shift ;;
      --effort) (( $# > 1 )) || sc_usage_error "--effort requires LEVEL"; SC_TEAM_EFFORT="${2,,}"; shift 2 ;;
      --effort=*) SC_TEAM_EFFORT="${1#*=}"; SC_TEAM_EFFORT="${SC_TEAM_EFFORT,,}"; shift ;;
      --token-budget) (( $# > 1 )) || sc_usage_error "--token-budget requires N"; SC_TEAM_TOKEN_BUDGET="$2"; shift 2 ;;
      --token-budget=*) SC_TEAM_TOKEN_BUDGET="${1#*=}"; shift ;;
      --time-budget) (( $# > 1 )) || sc_usage_error "--time-budget requires SECONDS"; SC_TEAM_TIME_BUDGET="$2"; shift 2 ;;
      --time-budget=*) SC_TEAM_TIME_BUDGET="${1#*=}"; shift ;;
      --timeout) (( $# > 1 )) || sc_usage_error "--timeout requires SECONDS"; SC_TEAM_TIMEOUT="$2"; shift 2 ;;
      --timeout=*) SC_TEAM_TIMEOUT="${1#*=}"; shift ;;
      --poll) (( $# > 1 )) || sc_usage_error "--poll requires SECONDS"; SC_TEAM_POLL="$2"; shift 2 ;;
      --poll=*) SC_TEAM_POLL="${1#*=}"; shift ;;
      --test-timeout) (( $# > 1 )) || sc_usage_error "--test-timeout requires SECONDS"; SC_TEAM_TEST_TIMEOUT="$2"; shift 2 ;;
      --test-timeout=*) SC_TEAM_TEST_TIMEOUT="${1#*=}"; shift ;;
      --verifier) (( $# > 1 )) || sc_usage_error "--verifier requires a tracked project-relative shell path"; SC_TEAM_VERIFIER="$2"; shift 2 ;;
      --verifier=*) SC_TEAM_VERIFIER="${1#*=}"; shift ;;
      --file|--graph-file) (( $# > 1 )) || sc_usage_error "$1 requires a project-relative PATH"; SC_TEAM_GRAPH_FILE="$2"; shift 2 ;;
      --file=*|--graph-file=*) SC_TEAM_GRAPH_FILE="${1#*=}"; shift ;;
      --strategy) (( $# > 1 )) || sc_usage_error "--strategy requires cherry-pick or merge"; SC_TEAM_ADOPT_STRATEGY="${2,,}"; shift 2 ;;
      --strategy=*) SC_TEAM_ADOPT_STRATEGY="${1#*=}"; SC_TEAM_ADOPT_STRATEGY="${SC_TEAM_ADOPT_STRATEGY,,}"; shift ;;
      --cursor) (( $# > 1 )) || sc_usage_error "--cursor requires N"; SC_CAMPAIGN_CURSOR="$2"; shift 2 ;;
      --cursor=*) SC_CAMPAIGN_CURSOR="${1#*=}"; shift ;;
      --max|--max-campaigns) (( $# > 1 )) || sc_usage_error "$1 requires N"; SC_CAMPAIGN_GRANT_MAX="$2"; shift 2 ;;
      --max=*|--max-campaigns=*) SC_CAMPAIGN_GRANT_MAX="${1#*=}"; shift ;;
      --follow) SC_CAMPAIGN_FOLLOW=1; shift ;;
      --dry-run) SC_CAMPAIGN_DRY_RUN=1; shift ;;
      --json) SC_CAMPAIGN_JSON=1; SC_QUIET=1; shift ;;
      -y|--yes) SC_YES=1; shift ;;
      -v|--verbose) (( SC_VERBOSE += 1 )); shift ;;
      -q|--quiet) SC_QUIET=1; shift ;;
      -h|--help)
        if (( SC_TEAM_MODE )); then sc_team_help; else sc_campaign_help "$SC_CAMPAIGN_ACTION"; fi
        exit 0
        ;;
      --)
        shift
        [[ "$SC_CAMPAIGN_ACTION" == test ]] || sc_usage_error "-- command is available only with team test"
        SC_TEAM_TEST_ARGS=("$@")
        break
        ;;
      *)
        if [[ "$SC_CAMPAIGN_ACTION" != list && "$SC_CAMPAIGN_ACTION" != top && \
              "$SC_CAMPAIGN_ACTION" != wait-any && "$SC_CAMPAIGN_ACTION" != inbox && \
              "$SC_CAMPAIGN_ACTION" != ack && "$SC_CAMPAIGN_ACTION" != graph && \
              "$SC_CAMPAIGN_ACTION" != grant && -z "$SC_CAMPAIGN_NAME" && "$1" != -* ]]; then
          SC_CAMPAIGN_NAME="$1"
          shift
        elif [[ "$SC_CAMPAIGN_ACTION" == grant && $SC_CAMPAIGN_GRANT_ACTION_SET -eq 0 && "$1" != -* ]]; then
          SC_CAMPAIGN_GRANT_ACTION="$1"
          SC_CAMPAIGN_GRANT_ACTION_SET=1
          shift
        else
          sc_usage_error "unknown campaign option: $1"
        fi
        ;;
    esac
  done
}

