+        json_object_object_get_ex(request, "y", &y_object) &&
+        json_object_is_type(y_object, json_type_int);
+    int64_t delta_x_raw = valid_shape ? json_object_get_int64(delta_x_object) : 0;
+    int64_t delta_y_raw = valid_shape ? json_object_get_int64(delta_y_object) : 0;
+    int64_t duration_raw = valid_shape ? json_object_get_int64(duration_object) : 0;
+    int64_t fingers_raw = valid_shape ? json_object_get_int64(fingers_object) : 0;
+    int64_t rotation_raw = valid_shape ? json_object_get_int64(rotation_object) : 0;
+    int64_t scale_raw = valid_shape ? json_object_get_int64(scale_object) : 0;
+    int64_t steps_raw = valid_shape ? json_object_get_int64(steps_object) : 0;
+    int64_t x = valid_shape ? json_object_get_int64(x_object) : 0;
+    int64_t y = valid_shape ? json_object_get_int64(y_object) : 0;
+    bool integer_ranges = valid_shape && delta_x_raw >= INT32_MIN &&
+        delta_x_raw <= INT32_MAX && delta_y_raw >= INT32_MIN &&
+        delta_y_raw <= INT32_MAX && duration_raw >= 0 &&
+        duration_raw <= UINT32_MAX && fingers_raw >= 0 &&
+        fingers_raw <= UINT32_MAX && rotation_raw >= INT32_MIN &&
+        rotation_raw <= INT32_MAX && scale_raw >= INT32_MIN &&
