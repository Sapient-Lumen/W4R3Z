sc_state_dispatch() {
  SC_OPERATION="state-$SC_STATE_ACTION"
  local transactions="$SC_GLOBAL/state-transactions/$SC_PROJECT_KEY"
  sc_ensure_dir "$SC_GLOBAL/state-transactions" "state transaction root"
  sc_ensure_dir "$transactions" "project state transaction root"
  python3 - "$SC_STATE_ACTION" sandcodex "$SC_PORTABLE_SCHEMA" "$SC_SCHEMA" "$SC_STATE_FORMAT" \
    "$SC_VERSION" "$(sc_artifact_sha256)" "$SC_PROJECT" \
    "$SC_LOCAL/STATE-MANIFEST.json" "$SC_CONTROL/STATE-MANIFEST.json" "$transactions" \
    "$SC_CONTROL/codex-home/sessions" "$SC_WORK/scratch" "$SC_STATE_ARCHIVE" \
    "$SC_STATE_TRANSACTION" "$SC_STATE_MERGE" "$SC_STATE_DRY_RUN" <<'PY'
import datetime as dt
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import secrets
import shutil
import stat
import sys
import tempfile
import zipfile

(action, product, portable_schema, state_schema, state_format, product_version,
 artifact_sha, project, local_manifest, trusted_manifest, tx_root, sessions_root,
 scratch_root, archive_arg, transaction_arg, merge_arg, dry_arg) = sys.argv[1:]
state_format = int(state_format)
merge = merge_arg == "1"
dry_run = dry_arg == "1"
uid = os.getuid()
MAX_ENTRIES = 100_000
MAX_TOTAL = 2 * 1024 * 1024 * 1024
MAX_FILE = 512 * 1024 * 1024
MAX_MANIFEST = 64 * 1024 * 1024
MAX_JSON_VALUE = 64 * 1024 * 1024

def fail(message):
    raise SystemExit(f"{product} state: {message}")

def utc_now():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")

def digest_bytes(data):
    return hashlib.sha256(data).hexdigest()

def digest_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()

def checked_dir(path, label):
    path = os.path.abspath(path)
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        fail(f"{label} is missing: {path}")
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or os.path.realpath(path) != path:
        fail(f"{label} is not a canonical user-owned directory: {path}")
    return path

def checked_file(path, label, private=False):
    path = os.path.abspath(path)
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        fail(f"{label} is missing: {path}")
    if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1 or os.path.realpath(path) != path:
        fail(f"{label} must be a canonical user-owned single-link regular file: {path}")
    if private and st.st_mode & 0o077:
        fail(f"{label} must not be accessible by group or other users: {path}")
    return path

def atomic_write(path, data, mode=0o600):
    parent = checked_dir(os.path.dirname(path), "state destination parent")
    fd, temporary = tempfile.mkstemp(prefix=".sandcodex-state.", dir=parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb", closefd=True) as target:
            target.write(data)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except BaseException:
        try: os.close(fd)
        except OSError: pass
        try: os.unlink(temporary)
        except FileNotFoundError: pass
        raise

def json_data(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()

def new_transaction(kind):
    root = checked_dir(tx_root, "state transaction root")
    ident = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + f"-{os.getpid()}-{secrets.token_hex(4)}"
    path = os.path.join(root, ident)
    os.mkdir(path, 0o700)
    return ident, path

def read_state_manifest(path):
    path = os.path.abspath(path)
    if not os.path.lexists(path):
        return None
    checked_file(path, "state manifest", private=True)
    if os.path.getsize(path) > 1024 * 1024:
        fail(f"state manifest is too large: {path}")
    try:
        value = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"state manifest is invalid: {path}: {error}")
    if not isinstance(value, dict) or value.get("schema") != state_schema:
        fail(f"state manifest schema is unsupported: {path}")
    if value.get("state_format") != state_format:
        fail(f"state format {value.get('state_format')!r} is unsupported by this artifact")
    return value

def migrate_state():
    targets = [os.path.abspath(p) for p in (local_manifest, trusted_manifest) if p]
    existing = {path: read_state_manifest(path) for path in targets}
    missing = [path for path, value in existing.items() if value is None]
    plan = {"action":"migrate","from":"unversioned" if missing else state_format,
            "to":state_format,"targets":missing,"dry_run":dry_run}
    if not missing:
        print(json.dumps({**plan, "status":"current"}, sort_keys=True))
        return
    if dry_run:
        print(json.dumps({**plan, "status":"planned"}, sort_keys=True))
        return
    ident, transaction = new_transaction("migration")
    records = []
    committed = []
    try:
        for index, path in enumerate(targets):
            before = os.path.lexists(path)
            backup = None
            before_sha = None
            if before:
                checked_file(path, "state manifest", private=True)
                before_sha = digest_file(path)
                backup = f"before-{index}.json"
                shutil.copyfile(path, os.path.join(transaction, backup), follow_symlinks=False)
                os.chmod(os.path.join(transaction, backup), 0o600)
            document = {
                "schema": state_schema, "state_format": state_format, "product": product,
                "project": project, "created_at": utc_now(), "created_by_version": product_version,
                "artifact_sha256": artifact_sha,
            }
            after = json_data(document)
            records.append({"path":path,"before_exists":before,"before_sha256":before_sha,
                            "backup":backup,"after_sha256":digest_bytes(after)})
        record = {"schema":f"{product}.state-transaction.v1","kind":"migration","id":ident,
                  "status":"prepared","project":project,"created_at":utc_now(),
                  "state_format":state_format,"targets":records}
        atomic_write(os.path.join(transaction, "transaction.json"), json_data(record))
        for item in records:
            document = {"schema":state_schema,"state_format":state_format,"product":product,
                        "project":project,"created_at":record["created_at"],
                        "created_by_version":product_version,"artifact_sha256":artifact_sha}
            atomic_write(item["path"], json_data(document))
            committed.append(item)
        record["status"] = "committed"
        record["committed_at"] = utc_now()
        atomic_write(os.path.join(transaction, "transaction.json"), json_data(record))
    except BaseException:
        for item in reversed(committed):
            try:
                if item["before_exists"]:
                    atomic_write(item["path"], Path(transaction, item["backup"]).read_bytes())
                else:
                    os.unlink(item["path"])
            except OSError:
                pass
        raise
    print(json.dumps({"action":"migrate","status":"committed","transaction":ident,
                      "state_format":state_format}, sort_keys=True))

def rollback_state():
    root = checked_dir(tx_root, "state transaction root")
    allowed = {os.path.abspath(p) for p in (local_manifest, trusted_manifest) if p}
    ident = transaction_arg
    if ident:
        if not ident.replace("-", "").isalnum() or "/" in ident or "." in ident:
            fail("invalid transaction identifier")
        candidates = [ident]
    else:
        candidates = sorted((name for name in os.listdir(root) if os.path.isdir(os.path.join(root, name))), reverse=True)
    transaction = record = None
    for candidate in candidates:
        path = os.path.join(root, candidate)
        record_path = os.path.join(path, "transaction.json")
        if not os.path.isfile(record_path) or os.path.islink(record_path):
            continue
        checked_dir(path, "state transaction")
        checked_file(record_path, "state transaction record", private=True)
        if os.path.getsize(record_path) > 1024 * 1024:
            fail(f"state transaction record is too large: {candidate}")
        try:
            value = json.loads(Path(record_path).read_text(encoding="utf-8"))
        except (UnicodeError, json.JSONDecodeError) as error:
            fail(f"state transaction record is invalid: {candidate}: {error}")
        if not isinstance(value, dict):
            fail(f"state transaction record is invalid: {candidate}")
        if value.get("kind") == "migration" and value.get("status") == "committed":
            targets = value.get("targets")
            if (value.get("schema") != f"{product}.state-transaction.v1" or
                value.get("project") != project or value.get("state_format") != state_format or
                not isinstance(targets, list) or not targets or
                any(not isinstance(item, dict) for item in targets)):
                fail(f"migration transaction record is invalid: {candidate}")
            ident, transaction, record = candidate, path, value
            break
    if record is None:
        fail("no committed migration transaction is available to roll back")
    seen = set()
    for index, item in enumerate(record["targets"]):
        destination = item.get("path")
        after_sha = item.get("after_sha256")
        before_exists = item.get("before_exists")
        backup_name = item.get("backup")
        if (not isinstance(destination, str) or not isinstance(before_exists, bool) or
            not isinstance(after_sha, str) or len(after_sha) != 64 or
            any(character not in "0123456789abcdef" for character in after_sha) or
            (before_exists and backup_name != f"before-{index}.json") or
            (not before_exists and backup_name is not None)):
            fail("migration transaction target metadata is invalid")
        path = os.path.abspath(destination)
        if path not in allowed or path in seen:
            fail("transaction names a destination outside this project's state")
        seen.add(path)
        checked_file(path, "current state manifest", private=True)
        if digest_file(path) != after_sha:
            fail(f"state manifest changed after migration; refusing rollback: {path}")
        if before_exists:
            backup = os.path.join(transaction, backup_name)
            checked_file(backup, "migration backup", private=True)
    snapshots = []
    try:
        for index, item in enumerate(record["targets"]):
            path = os.path.abspath(item["path"])
            current = os.path.join(transaction, f"rollback-current-{index}.json")
            shutil.copyfile(path, current, follow_symlinks=False); os.chmod(current, 0o600)
            snapshots.append((path, current))
        for item in record["targets"]:
            path = os.path.abspath(item["path"])
            if item.get("before_exists"):
                atomic_write(path, Path(transaction, item["backup"]).read_bytes())
            else:
                os.unlink(path)
        record["status"] = "rolled_back"; record["rolled_back_at"] = utc_now()
        atomic_write(os.path.join(transaction, "transaction.json"), json_data(record))
    except BaseException:
        for path, current in snapshots:
            try: atomic_write(path, Path(current).read_bytes())
            except OSError: pass
        raise
    print(json.dumps({"action":"rollback","status":"rolled_back","transaction":ident}, sort_keys=True))

def collect_payload(root, prefix):
    root = checked_dir(root, f"{prefix} root")
    result = []
    total = 0
    for directory, names, files in os.walk(root, topdown=True, followlinks=False):
        names.sort(); files.sort()
        for name in list(names):
            path = os.path.join(directory, name); st = os.lstat(path)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid:
                fail(f"portable state refuses linked or foreign directory: {path}")
        for name in files:
            path = os.path.join(directory, name); st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_nlink != 1:
                fail(f"portable state refuses linked, special, or foreign file: {path}")
            relative = Path(path).relative_to(root).as_posix()
            logical = f"{prefix}/{relative}"
            if st.st_size > MAX_FILE:
                fail(f"portable state file exceeds 512 MiB: {logical}")
            result.append((logical, path, st.st_size, digest_file(path)))
            total += st.st_size
            if len(result) > MAX_ENTRIES or total > MAX_TOTAL:
                fail("portable state exceeds the archive safety limits")
    return result

def archive_path(output):
    path = os.path.abspath(os.path.expanduser(output))
    parent = checked_dir(os.path.dirname(path), "archive parent")
    if os.path.realpath(parent) != parent:
        fail("archive parent may not contain symlinks")
    return path

def checked_export_parent_fd(path, label):
    """Open one canonical user-owned export parent without following a symlink."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        observed = os.fstat(descriptor)
        if not stat.S_ISDIR(observed.st_mode) or observed.st_uid != uid:
            fail(f"{label} is not a user-owned directory")
    except BaseException:
        os.close(descriptor)
        raise
    return descriptor

def open_export_staging(parent_fd):
    """Create one private staging file inside the already-open export parent."""
    flags = (os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC |
             getattr(os, "O_NOFOLLOW", 0))
    for _attempt in range(32):
        name = f".sandcodex-export.{secrets.token_hex(16)}.zip"
        try:
            descriptor = os.open(name, flags, 0o600, dir_fd=parent_fd)
        except FileExistsError:
            continue
        observed = os.fstat(descriptor)
        if (not stat.S_ISREG(observed.st_mode) or observed.st_uid != uid or
                observed.st_nlink != 1):
            os.close(descriptor)
            try: os.unlink(name, dir_fd=parent_fd)
            except OSError: pass
            fail("archive staging file identity is unsafe")
        os.fchmod(descriptor, 0o600)
        return descriptor, name
    fail("could not allocate a unique archive staging file")

def export_publication_result(output, payload, directory_sync):
    """Build the existing export result plus bounded publication evidence."""
    result = {
        "action": "export",
        "status": "created",
        "archive": output,
        "files": len(payload),
        "bytes": sum(item[2] for item in payload),
        "publication": "committed",
        "directory_sync": directory_sync,
        "inspect_before_repeat": directory_sync != "synced",
    }
    if directory_sync != "synced":
        result["warning"] = "archive was published; inspect before repeating"
    return result

def export_state():
    """Build and durably publish one portable-state archive without replay."""
    if not archive_arg:
        fail("export requires an archive path")
    output = archive_path(archive_arg)
    if os.path.lexists(output):
        fail(f"archive destination already exists: {output}")
    payload = collect_payload(sessions_root, "sessions") + collect_payload(scratch_root, "scratch")
    manifest = {
        "schema":portable_schema,"format":1,"product":product,"created_at":utc_now(),
        "source_project":project,"source_version":product_version,"source_artifact_sha256":artifact_sha,
        "payload":[{"path":logical,"size":size,"sha256":sha,"mode":"0600"}
                   for logical, _path, size, sha in payload],
        "excluded":["authentication","browser-profiles","downloads","logs","caches","runtime",
                    "generated-policy","nix-profiles","git-metadata"],
    }
    parent = os.path.dirname(output)
    parent_fd = checked_export_parent_fd(parent, "archive parent")
    temporary_name = None
    staging_fd = None
    published = False
    try:
        staging_fd, temporary_name = open_export_staging(parent_fd)
        with os.fdopen(staging_fd, "w+b", closefd=True) as staging:
            staging_fd = None
            with zipfile.ZipFile(
                staging, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6
            ) as archive:
                info = zipfile.ZipInfo("manifest.json"); info.external_attr = (stat.S_IFREG | 0o600) << 16
                archive.writestr(info, json_data(manifest))
                for logical, path, _size, _sha in payload:
                    info = zipfile.ZipInfo(logical); info.external_attr = (stat.S_IFREG | 0o600) << 16
                    with open(path, "rb") as source, archive.open(info, "w") as target:
                        shutil.copyfileobj(source, target, 1024 * 1024)
            staging.flush()
            os.fsync(staging.fileno())
        # Publish without replacing a destination that appeared after the
        # initial existence check.  link+unlink is the portable Linux/Python
        # no-clobber publication primitive; both names stay inside parent_fd.
        os.link(
            temporary_name,
            os.path.basename(output),
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
            follow_symlinks=False,
        )
        published = True
        try:
            os.unlink(temporary_name, dir_fd=parent_fd)
            temporary_name = None
        except OSError:
            result = export_publication_result(output, payload, "unknown")
            result["staging_cleanup"] = "unknown"
            result["warning"] = (
                "archive was published; staging cleanup outcome is unknown; "
                "inspect before repeating"
            )
            print(json.dumps(result, sort_keys=True))
            return
        try:
            os.fsync(parent_fd)
        except OSError:
            print(json.dumps(export_publication_result(output, payload, "unknown"), sort_keys=True))
            return
        print(json.dumps(export_publication_result(output, payload, "synced"), sort_keys=True))
    except BaseException:
        if staging_fd is not None:
            try: os.close(staging_fd)
            except OSError: pass
        if temporary_name is not None and not published:
            try: os.unlink(temporary_name, dir_fd=parent_fd)
            except FileNotFoundError: pass
        raise
    finally:
        os.close(parent_fd)

def safe_member(name):
    if not name or "\\" in name or "\x00" in name:
        return False
    path = PurePosixPath(name)
    return not path.is_absolute() and all(part not in ("", ".", "..") for part in path.parts)

def relocate(value, old, new, growth=None):
    if isinstance(value, str):
        if value == old:
            result = new
        elif value.startswith(old + os.sep):
            result = new + value[len(old):]
        else:
            result = value
        if growth is not None and result != value:
            growth[0] += max(0, len(result.encode("utf-8")) - len(value.encode("utf-8")))
            if growth[0] > growth[1]:
                fail(f"session path relocation expands beyond 512 MiB: {growth[2]}")
        return result
    if isinstance(value, list): return [relocate(item, old, new, growth) for item in value]
    if isinstance(value, dict): return {key:relocate(item, old, new, growth) for key, item in value.items()}
    return value

def stage_member(archive, info, output, expected_size, expected_sha):
    digest = hashlib.sha256()
    count = 0
    with archive.open(info, "r") as source, open(output, "wb") as target:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            count += len(chunk)
            if count > expected_size:
                fail(f"portable payload size mismatch: {info.filename}")
            digest.update(chunk)
            target.write(chunk)
        target.flush()
        os.fsync(target.fileno())
    os.chmod(output, 0o600)
    if count != expected_size or digest.hexdigest() != expected_sha:
        fail(f"portable payload digest mismatch: {info.filename}")

def relocate_session_file(source, output, name, old, new, source_size):
    if not old or old == new or not (name.endswith(".json") or name.endswith(".jsonl")):
        os.replace(source, output)
        return
    try:
        growth = [0, MAX_FILE - source_size, name]
        if name.endswith(".json"):
            if source_size > MAX_JSON_VALUE:
                fail(f"structured session JSON exceeds 64 MiB: {name}")
            with open(source, "r", encoding="utf-8") as stream:
                value = relocate(json.load(stream), old, new, growth)
            encoded = json_data(value)
            if len(encoded) > MAX_FILE:
                fail(f"relocated session file exceeds 512 MiB: {name}")
            with open(output, "xb") as target:
                target.write(encoded)
        else:
            first = True
            trailing_newline = False
            with open(source, "rb") as stream, open(output, "xb") as target:
                while True:
                    line = stream.readline(MAX_JSON_VALUE + 1)
                    if not line:
                        break
                    if len(line) > MAX_JSON_VALUE:
                        fail(f"structured session JSONL value exceeds 64 MiB: {name}")
                    trailing_newline = line.endswith(b"\n")
                    if not line.strip():
                        continue
                    value = relocate(json.loads(line.decode("utf-8")), old, new, growth)
                    encoded = json.dumps(value, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
                    required = len(encoded) + (0 if first else 1)
                    if target.tell() + required > MAX_FILE:
                        fail(f"relocated session file exceeds 512 MiB: {name}")
                    if not first:
                        target.write(b"\n")
                    target.write(encoded)
                    first = False
                if trailing_newline and not first:
                    if target.tell() + 1 > MAX_FILE:
                        fail(f"relocated session file exceeds 512 MiB: {name}")
                    target.write(b"\n")
        os.chmod(output, 0o600)
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"session metadata is not valid structured JSON: {name}: {error}")
    finally:
        try: os.unlink(source)
        except FileNotFoundError: pass

def root_has_files(root):
    return any(files or any(os.path.islink(os.path.join(directory, name)) for name in dirs)
               for directory, dirs, files in os.walk(root, followlinks=False))

def import_state():
    source = checked_file(archive_arg, "portable archive")
    if os.path.getsize(source) > MAX_TOTAL:
        fail("portable archive exceeds 2 GiB")
    session_target = checked_dir(sessions_root, "sessions root")
    scratch_target = checked_dir(scratch_root, "scratch root")
    stages = {}
    prepared = []
    prepared_total = 0
    try:
        for root in (session_target, scratch_target):
            stages[root] = tempfile.mkdtemp(prefix=".sandcodex-import.", dir=os.path.dirname(root))
            os.chmod(stages[root], 0o700)
        with zipfile.ZipFile(source, "r") as archive:
            infos = archive.infolist()
            names = [info.filename for info in infos]
            if len(names) != len(set(names)) or len(names) > MAX_ENTRIES + 1:
                fail("portable archive has duplicate or excessive entries")
            if "manifest.json" not in names or any(not safe_member(name) for name in names):
                fail("portable archive contains an unsafe path")
            info_by_name = {info.filename:info for info in infos}
            total = 0
            for info in infos:
                mode = (info.external_attr >> 16) & 0xffff
                if info.flag_bits & 1 or info.is_dir() or (mode and not stat.S_ISREG(mode)):
                    fail(f"portable archive contains unsupported entry: {info.filename}")
                total += info.file_size
                if info.file_size > MAX_FILE or total > MAX_TOTAL:
                    fail("portable archive expands beyond its safety limits")
                if info.compress_size and info.file_size > info.compress_size * 1000 + 1024 * 1024:
                    fail(f"portable archive entry has an unsafe compression ratio: {info.filename}")
            manifest_info = info_by_name["manifest.json"]
            if manifest_info.file_size > MAX_MANIFEST:
                fail("portable manifest exceeds 64 MiB")
            try:
                manifest = json.loads(archive.read(manifest_info))
            except (KeyError, UnicodeError, json.JSONDecodeError) as error:
                fail(f"portable manifest is invalid: {error}")
            if (not isinstance(manifest, dict) or manifest.get("schema") != portable_schema or
                manifest.get("format") != 1 or manifest.get("product") != product):
                fail("portable archive schema or product is incompatible")
            entries = manifest.get("payload")
            if not isinstance(entries, list): fail("portable manifest payload is invalid")
            listed = [item.get("path") for item in entries if isinstance(item, dict)]
            if len(listed) != len(entries) or len(listed) != len(set(listed)) or set(names) != {"manifest.json", *listed}:
                fail("portable manifest does not exactly describe the archive")
            for item in entries:
                name = item["path"]
                size = item.get("size"); expected_sha = item.get("sha256")
                if (not safe_member(name) or not (name.startswith("sessions/") or name.startswith("scratch/"))):
                    fail(f"portable payload path is outside the allowed roots: {name}")
                if (not isinstance(size, int) or isinstance(size, bool) or size < 0 or size > MAX_FILE or
                    not isinstance(expected_sha, str) or len(expected_sha) != 64 or
                    any(character not in "0123456789abcdef" for character in expected_sha) or
                    item.get("mode") != "0600" or info_by_name[name].file_size != size):
                    fail(f"portable manifest metadata is invalid: {name}")
            if not merge and (root_has_files(session_target) or root_has_files(scratch_target)):
                fail("portable import target is not empty; use --merge for non-destructive merging")
            old_project = manifest.get("source_project")
            if not isinstance(old_project, str) or not os.path.isabs(old_project) or "\x00" in old_project:
                fail("portable manifest source project is invalid")
            for item in entries:
                name = item["path"]
                kind, relative = name.split("/", 1)
                if not relative: fail(f"portable payload has an empty destination: {name}")
                target_root = session_target if kind == "sessions" else scratch_target
                target = os.path.abspath(os.path.join(target_root, *PurePosixPath(relative).parts))
                if target == target_root or os.path.commonpath((target_root, target)) != target_root:
                    fail(f"portable payload escaped its target: {name}")
                stage = os.path.join(stages[target_root], *PurePosixPath(relative).parts)
                os.makedirs(os.path.dirname(stage), mode=0o700, exist_ok=True)
                raw_fd, raw = tempfile.mkstemp(prefix=".member-", dir=stages[target_root])
                os.close(raw_fd)
                stage_member(archive, info_by_name[name], raw, item["size"], item["sha256"])
                if kind == "sessions":
                    relocate_session_file(raw, stage, name, old_project, project, item["size"])
                else:
                    os.replace(raw, stage)
                os.chmod(stage, 0o600)
                staged_size = os.path.getsize(stage)
                prepared_total += staged_size
                if staged_size > MAX_FILE or prepared_total > MAX_TOTAL:
                    fail("portable payload expands beyond its safety limits after relocation")
                prepared.append((name, target_root, target, stage, digest_file(stage)))
            for name, _root, target, _stage, staged_sha in prepared:
                if os.path.lexists(target):
                    checked_file(target, "existing import target")
                    if not merge or digest_file(target) != staged_sha:
                        fail(f"portable import conflicts with existing state: {name}")
            if dry_run:
                print(json.dumps({"action":"import","status":"planned","archive":source,
                                  "files":len(prepared),"merge":merge,"dry_run":True}, sort_keys=True))
                return
            ident, transaction = new_transaction("import")
            record = {"schema":f"{product}.state-transaction.v1","kind":"import","id":ident,
                      "status":"prepared","project":project,"created_at":utc_now(),
                      "archive_sha256":digest_file(source),"files":[name for name, *_ in prepared]}
            atomic_write(os.path.join(transaction, "transaction.json"), json_data(record))
            created_files = []
            created_dirs = []
            try:
                for name, root, target, stage, _staged_sha in prepared:
                    if os.path.lexists(target): continue
                    parent = os.path.dirname(target); missing = []
                    cursor = parent
                    while cursor != root and not os.path.exists(cursor):
                        missing.append(cursor); cursor = os.path.dirname(cursor)
                    if os.path.realpath(cursor) != cursor: fail(f"import target has a symlink component: {name}")
                    for directory in reversed(missing):
                        os.mkdir(directory, 0o700); created_dirs.append(directory)
                    os.replace(stage, target); created_files.append(target)
                record["status"] = "committed"; record["committed_at"] = utc_now()
                atomic_write(os.path.join(transaction, "transaction.json"), json_data(record))
            except BaseException:
                for path in reversed(created_files):
                    try: os.unlink(path)
                    except FileNotFoundError: pass
                for path in reversed(created_dirs):
                    try: os.rmdir(path)
                    except OSError: pass
                raise
    finally:
        for stage_root in stages.values(): shutil.rmtree(stage_root, ignore_errors=True)
    print(json.dumps({"action":"import","status":"committed","transaction":ident,
                      "archive":source,"files":len(prepared),"merge":merge}, sort_keys=True))

try:
    if action == "migrate": migrate_state()
    elif action == "rollback": rollback_state()
    elif action == "export": export_state()
    elif action == "import": import_state()
    else: fail(f"unsupported action: {action}")
except (zipfile.BadZipFile, zipfile.LargeZipFile, OSError, EOFError) as error:
    fail(f"state operation failed safely: {error}")
PY
}

sc_active_remote_catalog_dispatch() {
  case "$SC_REMOTE_CATALOG_ACTION" in
    status|report|continuity|router|quota|keys) ;;
    models)
      (( ! SC_REMOTE_MODELS_SAVE && ! SC_REMOTE_MODELS_QUALIFY )) ||
        sc_die "active-room remote models inspection cannot use --save or --qualify; run that from the host terminal" 77
      ;;
    *)
      sc_die "active-room remote catalog permits only status, report, continuity, router, quota, keys, and non-mutating models" 77
      ;;
  esac
  [[ "$(uname -s)" == Linux ]] || sc_die "Sandcodex currently supports Linux only"
  [[ "$(id -u)" != 0 ]] || sc_die "do not run as root"
  SC_HOST_PATH="${SANDCODEX_HOST_PATH-${PATH:-}}"
  SC_REAL_HOME="$(sc_find_home)"
  sc_no_line_breaks "$SC_REAL_HOME" "home directory"
  local global_requested="${SANDCODEX_GLOBAL_ROOT:-$SC_REAL_HOME/.sandstuff/sandcodex}"
  [[ "$global_requested" == /* ]] || sc_die "SANDCODEX_GLOBAL_ROOT must be absolute"
  sc_no_line_breaks "$global_requested" "global control root"
  global_requested="$(realpath -ms -- "$global_requested")"
  sc_no_line_breaks "$global_requested" "canonical global control root"
  sc_validate_global_root "$global_requested"
  sc_no_symlink_components "$global_requested" "global control root"
  SC_GLOBAL="$(realpath -m -- "$global_requested")"
  SC_PROJECT="${SANDCODEX_OUTER_PROJECT:-<active>}"
  if [[ "$SC_PROJECT" == /* && -d "$SC_PROJECT" ]]; then
    SC_PROJECT="$(realpath -- "$SC_PROJECT")"
    SC_PROJECT_KEY="$(printf '%s\0' "$SC_PROJECT" | sha256sum | awk '{print $1}')"
    SC_CONTROL="$SC_GLOBAL/projects/$SC_PROJECT_KEY"
  else
    SC_PROJECT='<active>'
    SC_PROJECT_KEY='<active>'
    SC_CONTROL=""
  fi
  SC_OPERATION="remote-$SC_REMOTE_CATALOG_ACTION"
  sc_global_state
  sc_remote_catalog_dispatch
}

sc_active_gemini_dispatch() {
  local environment="${SANDCODEX_ENVIRONMENT:-}" result action="$SC_GEMINI_ACTION"
  [[ -n "$environment" && -r "$environment" ]] ||
    sc_die "active Gemini metadata is unavailable in this room" 77
  jq -e '.schema=="sandcodex.agent-environment.v1" and .gemini.active==true and
    .gemini.credential_values_disclosed==false' "$environment" >/dev/null ||
    sc_die "active Gemini metadata failed validation" 78
  case "$action" in
    probe|qualify)
      sc_die "active-room Gemini qualification is host-owned; use status/continuity/report/router/quota/models, or run qualification from a host terminal" 77
      ;;
    models)
      result="$(jq -c '{schema:"sandcodex.gemini-active-models.v1",result:"models",
        provider:.gemini.provider,free_only:true,models:[.gemini.candidate_models[] | {id:.,eligible:true}],
        network_requested:false,credential_values_disclosed:false,raw_provider_content_disclosed:false}' "$environment")"
      if (( SC_GEMINI_JSON )); then
        printf '%s\n' "$result"
      else
        printf 'active Gemini free route models\n'
        jq -r '.models[] | "  " + .id' <<<"$result"
        printf '  source: launch-sealed provider contract · network requested: false\n'
      fi
      ;;
    keys|path)
      if [[ "$action" == keys && "$SC_GEMINI_KEYS_ACTION" != path && "$SC_GEMINI_KEYS_ACTION" != status ]]; then
        sc_die "Gemini key-bank mutation is host-only; run it outside the active command room" 77
      fi
      result="$(jq -cn '{schema:"sandcodex.gemini-active-credentials.v1",result:"delegated-status",
        raw_google_credentials_delegated:false,loopback_adapter_token_visible:false,
        credential_values_disclosed:false,
        note:"Google credentials are held by the host-side adapter and are intentionally not projected into this room."}')"
      if (( SC_GEMINI_JSON )); then printf '%s\n' "$result"; else jq -r '.note' <<<"$result"; fi
      ;;
    status|report|continuity|quota|router|cooldowns)
      # The generated room contract is the authoritative no-secret, no-network
      # view.  It is deliberately sufficient for worker diagnosis without
      # projecting the host key bank or adapter bearer token.
      SC_READY_JSON=$SC_GEMINI_JSON
      sc_active_ready_dispatch
      ;;
    *) sc_die "active-room Gemini action is unsupported: $action" 77 ;;
  esac
}

sc_main() {
  [[ -z "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" && -z "${SANDCODEX_LOCAL_NIXPKGS_REV:-}" ]] ||     SC_LOCAL_RUNTIME_USER_OVERRIDE=1
  SC_SCRIPT="$(sc_script_path)"
  sc_no_line_breaks "$SC_SCRIPT" "launcher path"
  sc_parse "$@"
  sc_validate_requested_domains
  if [[ "${SANDCODEX_ACTIVE:-0}" == 1 ]]; then
    if [[ "$SC_COMMAND" == loop ]]; then
      sc_loop_set_project_paths "${SANDCODEX_OUTER_PROJECT:-}"
      if [[ -n "$SC_PROJECT_ARG" && "$(realpath -- "$SC_PROJECT_ARG" 2>/dev/null || true)" != "$SC_PROJECT" ]]; then
        sc_die "loop control cannot target another project" 77
      fi
      sc_loop_control_dispatch
      return
    fi
    if [[ "$SC_COMMAND" == campaign ]]; then
      sc_campaign_set_project_paths "${SANDCODEX_OUTER_PROJECT:-}"
      if [[ -n "$SC_PROJECT_ARG" && "$(realpath -- "$SC_PROJECT_ARG" 2>/dev/null || true)" != "$SC_PROJECT" ]]; then
        sc_die "campaign control cannot target another project" 77
      fi
      sc_campaign_client_dispatch
      return
    fi
    if [[ "$SC_COMMAND" == remote-catalog ]]; then
      sc_active_remote_catalog_dispatch
      return
    fi
    if [[ "$SC_COMMAND" == gemini ]]; then
      sc_active_gemini_dispatch
      return
    fi
    if [[ "$SC_COMMAND" == ready ]]; then
      sc_active_ready_dispatch
      return
    fi
    sc_die "Sandcodex is already active for ${SANDCODEX_OUTER_PROJECT:-this project}; recursive launch is blocked" 77
  fi
  if [[ "$SC_COMMAND" == run || "$SC_COMMAND" == doctor || "$SC_COMMAND" == clean || \
    ( "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == run ) ]]; then
    sc_validate_selection
    sc_safe_args
  fi
  if [[ "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == run ]]; then
    sc_loop_validate_provider_args
    sc_loop_validate_policy
  fi
  [[ "$(uname -s)" == Linux ]] || sc_die "Sandcodex currently supports Linux only"
  [[ "$(id -u)" != 0 ]] || sc_die "do not run as root; use --BARE-METAL for sudo authority"
  SC_HOST_PATH="${SANDCODEX_HOST_PATH-${PATH:-}}"
  SC_REAL_HOME="$(sc_find_home)"
  sc_no_line_breaks "$SC_REAL_HOME" "home directory"
  if [[ "$SC_COMMAND" == install ]]; then
    sc_install
    return
  fi
  local global_requested="${SANDCODEX_GLOBAL_ROOT:-$SC_REAL_HOME/.sandstuff/sandcodex}"
  [[ "$global_requested" == /* ]] || sc_die "SANDCODEX_GLOBAL_ROOT must be absolute"
  sc_no_line_breaks "$global_requested" "global control root"
  global_requested="$(realpath -ms -- "$global_requested")"
  sc_no_line_breaks "$global_requested" "canonical global control root"
  sc_validate_global_root "$global_requested"
  sc_no_symlink_components "$global_requested" "global control root"
  SC_GLOBAL="$(realpath -m -- "$global_requested")"
  if [[ "$SC_COMMAND" == logs ]]; then
    sc_select_project
    sc_logs_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == publish ]]; then
    sc_select_project
    sc_publish_host_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == local-runtime &&
    ( "$SC_LOCAL_RUNTIME_ACTION" == status || "$SC_LOCAL_RUNTIME_ACTION" == report ) ]]; then
    SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
    SC_OPERATION="local-$SC_LOCAL_RUNTIME_ACTION"
    sc_local_runtime_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == run || "$SC_COMMAND" == doctor || "$SC_COMMAND" == clean || \
    "$SC_COMMAND" == state || "$SC_COMMAND" == operator || "$SC_COMMAND" == campaign || \
    "$SC_COMMAND" == local-retire || "$SC_COMMAND" == loop ]]; then
    sc_select_project
    sc_validate_project_for_inner_jail
  fi
  sc_bootstrap "$@"; sc_runtime_tools
  if [[ "$SC_COMMAND" == benchmark ]]; then
    SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
    SC_OPERATION="benchmark-$SC_BENCHMARK_ACTION"
    # Catalog inspection is a read-only discovery path.  Do not create the
    # trusted global root or an audit log merely because a person asked what
    # courses exist.
    if [[ "$SC_BENCHMARK_ACTION" != list ]]; then
      sc_global_state
      sc_start_log
    fi
    sc_agent_benchmark_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == gemini &&
    ( "$SC_GEMINI_ACTION" == path || "$SC_GEMINI_ACTION" == status ||
      ( "$SC_GEMINI_ACTION" == keys &&
        ( "$SC_GEMINI_KEYS_ACTION" == path || "$SC_GEMINI_KEYS_ACTION" == status ) ) ||
      "$SC_GEMINI_ACTION" == cooldowns ||
      "$SC_GEMINI_ACTION" == report || "$SC_GEMINI_ACTION" == continuity ||
      "$SC_GEMINI_ACTION" == quota || "$SC_GEMINI_ACTION" == router ) ]]; then
    SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
    SC_OPERATION="gemini-$SC_GEMINI_ACTION"
    sc_gemini_dispatch
