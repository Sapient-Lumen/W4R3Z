sc_parse_loop() {
  SC_HELP_TOPIC=loop
  # True sequential loop processes are workers, not command rooms. They never
  # mint concurrent campaign authority, including across detached runner hops.
  # The remote/Gemini first-turn task lanes reuse the loop executor, but remain
  # foreground command rooms and therefore retain their explicitly bounded
  # companion authority. An explicit --no-companion-campaigns below still wins.
  if (( $# )); then
    case "$1" in
      run) SC_LOOP_ACTION=run; shift ;;
      send) SC_LOOP_ACTION=send; shift ;;
      stop) SC_LOOP_ACTION=stop; shift ;;
      status) SC_LOOP_ACTION=status; shift ;;
