+static void sandcodex_authorize_hit_test(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	/* Authorization is also a sequencing boundary. A duplicate or malformed
+	 * attempt must not leave any previously armed input authority reusable. */
+	sandcodex_clear_dispatch_ticket(client);
+	json_object *token = NULL;
+	bool valid_shape = json_object_object_length(request) == 2 &&
+		sandcodex_request_operation(request, "authorize") &&
+		json_object_object_get_ex(request, "token", &token) &&
+		json_object_is_type(token, json_type_string);
+	const char *token_value = valid_shape ? json_object_get_string(token) : NULL;
+	bool canonical = valid_shape && sandcodex_authorize_payload_canonical(
+		payload, payload_length, token_value);
+	bool token_matches = valid_shape && sandcodex_token_equal(token_value);
+	struct sway_seat *seat = input_manager_get_default_seat();
+	if (client->sandcodex_hit_test_authorized || !canonical || !token_matches ||
+			!sandcodex_hit_test_environment_erased || !seat || !seat->wlr_seat) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	wlr_seat_set_capabilities(seat->wlr_seat,
+		seat->wlr_seat->capabilities | WL_SEAT_CAPABILITY_TOUCH);
+	if ((seat->wlr_seat->capabilities & WL_SEAT_CAPABILITY_TOUCH) == 0) {
+		sandcodex_send_hit_test_failure(client, "touch-capability-advertise-failed");
+		return;
+	}
+	/* Publish the process-lifetime synthetic tablet, pen, and eraser while authorization
+	 * is still a fail-closed sequencing boundary. The controller cannot arm a
+	 * stroke until both tablet-v2 tool announcements have preceded this IPC reply. */
+	struct sway_seat *stylus_seat = input_manager_get_default_seat();
+	if (!sandcodex_stylus_initialize(stylus_seat)) {
+		sandcodex_send_hit_test_failure(client,
+			"stylus-initialization-failed");
+		return;
+	}
+	if (!sandcodex_stylus_tool_idle()) {
+		sandcodex_send_hit_test_failure(client, "stylus-initial-idle-failed");
+		return;
+	}
+	if (!sandcodex_tablet_pad_idle()) {
+		sandcodex_send_hit_test_failure(client, "tablet-pad-initial-idle-failed");
+		return;
+	}
+	client->sandcodex_hit_test_authorized = true;
