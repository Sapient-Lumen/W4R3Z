sc_install() {
  SC_OPERATION=install
  local destination="$SC_INSTALL_BIN_DIR" parent target tmp
  if [[ -z "$destination" ]]; then
    sc_owned_dir "$SC_REAL_HOME" "home directory"
    parent="$SC_REAL_HOME/.local"
    sc_no_symlink_components "$parent" "default install path"
    if [[ -e "$parent" || -L "$parent" ]]; then
      sc_owned_dir "$parent" "user-local directory"
    else
      mkdir -m 700 -- "$parent"
    fi
    destination="$parent/bin"
    if [[ -e "$destination" || -L "$destination" ]]; then
      sc_owned_dir "$destination" "user-local bin directory"
    else
      mkdir -m 700 -- "$destination"
    fi
  else
    sc_no_line_breaks "$destination" "install bin directory"
    [[ "$destination" == /* ]] || sc_usage_error "--bin-dir must be absolute"
    [[ "$destination" != *:* ]] || sc_usage_error "--bin-dir cannot contain ':'"
    destination="$(realpath -ms -- "$destination")"
    sc_no_symlink_components "$destination" "install bin directory"
    sc_owned_dir "$destination" "install bin directory"
  fi
  [[ -w "$destination" ]] || sc_die "install bin directory is not writable: $destination"
  target="$destination/sandcodex"
  [[ -f "$SC_SCRIPT" && ! -L "$SC_SCRIPT" ]] || sc_die "launcher source is not a regular file: $SC_SCRIPT"
  if [[ -e "$target" || -L "$target" ]]; then
    sc_owned_single_file "$target" "" "installed Sandcodex artifact"
    if [[ "$target" -ef "$SC_SCRIPT" ]]; then
      sc_ok "Sandcodex $SC_VERSION is already installed at $target"
      return
    fi
    if [[ "$(stat -c %a -- "$target")" == 755 ]] && cmp -s -- "$SC_SCRIPT" "$target"; then
      sc_ok "Sandcodex $SC_VERSION is already installed at $target"
      return
    fi
  fi
  tmp="$(mktemp "$destination/.sandcodex.install.XXXXXX")"
  SC_INSTALL_TMP="$tmp"
  if ! cp --reflink=auto -- "$SC_SCRIPT" "$tmp" || ! chmod 755 -- "$tmp" || ! bash -n -- "$tmp"; then
    rm -f -- "$tmp"; SC_INSTALL_TMP=""
    sc_die "could not stage a valid standalone Sandcodex artifact"
  fi
  if ! mv -fT -- "$tmp" "$target"; then
    rm -f -- "$tmp"; SC_INSTALL_TMP=""
    sc_die "could not atomically install Sandcodex at $target"
  fi
  SC_INSTALL_TMP=""
  sc_owned_single_file "$target" 755 "installed Sandcodex artifact"
  cmp -s -- "$SC_SCRIPT" "$target" || sc_die "installed artifact verification failed: $target"
  sc_ok "installed Sandcodex $SC_VERSION · $target"
  case ":${PATH:-}:" in
    *":$destination:"*) ;;
    *) sc_note "add $destination to PATH to invoke sandcodex by name" ;;
  esac
}

