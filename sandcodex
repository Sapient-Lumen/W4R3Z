sc_remote_keybank_stage() {
  local path stage metadata rc=0
  path="$(sc_remote_keybank_path)"
  [[ -f "$path" ]] || sc_die "OpenRouter key bank is missing: $path" 78
  sc_no_symlink_components "$path" "OpenRouter key bank"
  sc_owned_single_file "$path" 600 "OpenRouter key bank"
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  stage="$(mktemp -d "$SC_GLOBAL/runtime/.openrouter-keybank.XXXXXX")"
  chmod 700 -- "$stage"
  metadata="$(python3 -P - "$path" "$stage" <<'PY'
import hashlib
import json
import os
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
stage = Path(sys.argv[2])
key_re = re.compile(r"^sk-or-v1-[A-Za-z0-9_-]{32,}$")
label_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")
rows = []
seen = set()
for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    label = ""
    key = line
    if "=" in line and not line.startswith("sk-or-v1-"):
        maybe_label, maybe_key = line.split("=", 1)
        label = maybe_label.strip()
        key = maybe_key.strip()
    else:
        parts = line.split()
        if len(parts) == 2 and parts[1].startswith("sk-or-v1-"):
            label, key = parts[0], parts[1]
    if not key_re.fullmatch(key):
        raise SystemExit(f"invalid OpenRouter key on line {number}")
    if label and not label_re.fullmatch(label):
        raise SystemExit(f"invalid key label on line {number}")
    digest = hashlib.sha256(key.encode()).hexdigest()
    if digest in seen:
        continue
    seen.add(digest)
    index = len(rows) + 1
    if not label:
        label = f"key-{index:02d}"
    key_file = stage / f"key-{index:03d}"
    fd = os.open(key_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, key.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    rows.append({
        "index": index,
        "label": label,
        "key_sha256": digest,
        "key_id": digest[:12],
        "credential_file": str(key_file),
        "source_line": number,
    })
if not rows:
    raise SystemExit("OpenRouter key bank contains no keys")
print(json.dumps({
    "schema": "sandcodex.openrouter-key-bank.v1",
    "result": "staged",
    "path": str(path),
    "stage": str(stage),
    "key_count": len(rows),
    "keys": rows,
    "credential_values_disclosed": False,
}, sort_keys=True, separators=(",", ":")))
PY
  )" || rc=$?
  if (( rc != 0 )); then
    [[ -z "${stage:-}" ]] || rm -rf -- "$stage" 2>/dev/null || true
    sc_die "OpenRouter key bank could not be staged" 78
  fi
  jq -e '.schema=="sandcodex.openrouter-key-bank.v1" and (.keys|type)=="array" and .key_count == (.keys|length)' \
    <<<"$metadata" >/dev/null || sc_die "OpenRouter key bank helper returned invalid metadata" 78
  printf '%s\n' "$metadata"
}

sc_remote_keybank_unstage() {
  local staged=$1 stage
  stage="$(jq -r '.stage // empty' <<<"$staged" 2>/dev/null || true)"
  case "$stage" in
    "$SC_GLOBAL"/runtime/.openrouter-keybank.*)
      find "$stage" -maxdepth 1 -type f -name 'key-[0-9][0-9][0-9]' -exec rm -f -- {} + 2>/dev/null || true
      rmdir -- "$stage" 2>/dev/null || true
      ;;
  esac
}

sc_remote_keybank_public_json() {
