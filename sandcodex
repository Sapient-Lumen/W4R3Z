        """Consume one watch capability and discover one bounded changed output set."""
        spec = self._normalize_copy_spec(arguments)
        if spec.get("source") != "launch-output" or spec.get("kind") != "changes":
            raise ToolError(
                "OutputWatchSeal change export requires source=launch-output kind=changes"
            )
        limits = {
            "maximum_file_bytes": int(spec["maximum_file_bytes"]),
            "maximum_total_bytes": int(spec["maximum_total_bytes"]),
            "maximum_entries": int(spec["maximum_entries"]),
            "maximum_directories": int(spec["maximum_directories"]),
            "maximum_depth": int(spec["maximum_depth"]),
        }
        lease = self._consume_output_watch_lease(
            watch_token=spec.get("watch_token"),
            launch_id=launch_id,
            limits=limits,
        )
        current: dict[str, Any] | None = None
        try:
            baseline = lease.get("manifest")
            if not isinstance(baseline, dict):
                raise ToolError("OutputWatchSeal consumed baseline is unavailable")
            current = self._wait_for_output_watch_manifest(
                launch_id,
                **limits,
                quiet_milliseconds=int(spec["quiet_milliseconds"]),
                timeout_milliseconds=int(spec["timeout_milliseconds"]),
                baseline=baseline,
            )
            discovered = self._output_watch_changed_paths(baseline, current)
            paths = discovered["paths"]
            copy_kind = str(discovered["copy_kind"])
            if not isinstance(paths, tuple) or not paths:
                raise ToolError("OutputWatchSeal discovered path set is invalid")
            payload = self._launch_output_uri_payload(paths)
            action_authority_sha256 = self._authority_digest({
                "name": "desktop_copy",
                "arguments": spec,
            })
            deferred = DeferredFileCopy(
                launch_id,
                payload,
                maximum_file_bytes=limits["maximum_file_bytes"],
                maximum_total_bytes=limits["maximum_total_bytes"],
                chord=None,
                copy_kind=copy_kind,
                maximum_entries=limits["maximum_entries"],
                maximum_directories=limits["maximum_directories"],
                maximum_depth=limits["maximum_depth"],
                source_mode="output-watch",
                source_count=len(paths),
                action_authority_sha256=action_authority_sha256,
            )
            evidence = {
                "schema": OUTPUT_WATCH_SEAL_SCHEMA,
                "enforced": True,
                "method": "output-watch-changes",
                "target_launch_id": launch_id,
                "unit_kind": f"watch-changes-{copy_kind}",
                "planned_units": 1,
                "completed_units": 1,
                "keyboard_injection": False,
                "clipboard_selection_used": False,
                "watch_capability_consumed": True,
                "copy_kind": copy_kind,
                "source_path_count": len(paths),
                "changed_top_level_count": discovered["changed_top_level_count"],
                "deleted_top_level_count": discovered["deleted_top_level_count"],
                "source_paths_exposed": False,
                "source_paths_persisted": False,
                "stable_content_fingerprint_retained": False,
                "output_watch_seal": {
                    "publication_status": "deferred-until-outer-dispatch-complete",
                    "publication_order": "after-one-attempt-capability-consumption+action-authority+outer-TickSeal",
                    "source_namespace": "exact-launch-private-output-only",
                    "source_mode": "output-watch",
                    "operation": "changes",
                    "copy_kind": copy_kind,
                    "canonical_path_envelope_bytes": deferred.uri_list_bytes,
                    "source_path_count": len(paths),
                    "changed_top_level_count": discovered["changed_top_level_count"],
                    "deleted_top_level_count": discovered["deleted_top_level_count"],
                    "source_paths_exposed": False,
                    "source_paths_persisted": False,
                    "stable_content_fingerprint_retained": False,
                },
            }
            return evidence, deferred
        finally:
            if isinstance(current, dict):
                current.clear()
            self._clear_output_watch_lease_record(lease)

    def _fenced_copy(
        self,
        arguments: dict[str, Any],
        target: dict[str, Any],
    ) -> tuple[
        dict[str, Any] | None,
        dict[str, Any],
        bytes | None,
        DeferredFileCopy | None,
    ]:
        spec = self._normalize_copy_spec(arguments)
        if spec.get("source") != "selection":
            raise ToolError("RichCopySeal keyboard capture requires source=selection")
        copy_kind = str(spec["kind"])
        profile = "files" if copy_kind == "directory" else copy_kind
        chord = str(spec["chord"])
        maximum_bytes = int(spec["maximum_bytes"])
        timeout_milliseconds = int(spec["timeout_milliseconds"])
        quiet_milliseconds = int(spec["quiet_milliseconds"])
        maximum_file_bytes = int(spec.get("maximum_file_bytes", 0))
        maximum_total_bytes = int(spec.get("maximum_total_bytes", 0))
        maximum_entries = int(spec.get("maximum_entries", MAX_DIRECTORY_COPY_ENTRIES))
        maximum_directories = int(
            spec.get("maximum_directories", MAX_DIRECTORY_COPY_DIRECTORIES)
        )
        maximum_depth = int(spec.get("maximum_depth", MAX_DIRECTORY_COPY_DEPTH))
        selection_evidence: dict[str, Any] | None = None
        captured_payload: str | bytes | None = None
        file_copy_launch_id: str | None = None

        def copy(
            transaction: WaylandKeyboardTransaction,
            _index: int,
            checkpoint: Callable[[str], None],
        ) -> None:
            nonlocal selection_evidence, captured_payload, file_copy_launch_id
            scene_launch_ids_value = target.get("scene_launch_ids")
            scene_launch_ids = (
                tuple(scene_launch_ids_value)
                if isinstance(scene_launch_ids_value, tuple) and scene_launch_ids_value
                else ()
            )
            scene_id_value = target.get("scene_id") if scene_launch_ids else None
            scene_id = str(scene_id_value) if isinstance(scene_id_value, str) else None
            launch_id = target.get("launch_id")
            launch_id_value = (
                str(launch_id)
                if isinstance(launch_id, str) and not scene_launch_ids
                else None
            )
            if copy_kind in {"files", "directory"} and (
                launch_id_value is None or scene_launch_ids or scene_id is not None
            ):
                raise ToolError(
                    "FileCopySeal and DirectoryCopySeal require one exact launch-scoped guarded target"
                )

            def assert_selection_scope() -> None:
                if scene_launch_ids:
                    self._assert_clipboard_scene_exclusive(scene_id, scene_launch_ids)
                elif launch_id_value is not None:
                    self._assert_clipboard_launch_exclusive(launch_id_value)

            capture_error: Exception | None = None
            capture: WaylandSelectionCaptureTransaction | None = None
            try:
                with WaylandSelectionCaptureTransaction(
                    self,
                    "desktop_copy",
                    launch_id_value,
                    scene_id=scene_id,
                    scene_launch_ids=scene_launch_ids,
                    profile=profile,
                    maximum_bytes=maximum_bytes,
                ) as capture:
                    capture.arm()
                    assert_selection_scope()
                    checkpoint(f"copy-{profile}-armed-selection-empty")
                    assert_selection_scope()

                    keycode, modifiers = transaction.plan_chord(chord)
                    self._dispatch_compositor_guarded_keyboard_unit(
                        target, transaction, keycode, modifiers
                    )
                    offer = capture.next_offer(
                        timeout_milliseconds=timeout_milliseconds,
                        quiet_milliseconds=quiet_milliseconds,
                    )
                    offer_id = offer.get("offer_id")
                    expected_mime = (
                        "image/png" if profile == "png"
                        else FILE_DROP_MIME if profile == "files"
                        else offer.get("mime")
                    )
                    if not isinstance(offer_id, int) or isinstance(offer_id, bool):
                        raise ToolError("RichCopySeal returned an invalid retained offer identifier")
                    if profile in {"png", "files"} and offer.get("mime") != expected_mime:
                        raise ToolError(
                            f"RichCopySeal {profile} profile did not retain {expected_mime}"
                        )

                    # ext-data-control does not identify the source principal.
                    # Re-prove the complete scoped trust domain and exact focus
                    # before the sole receive request.
                    assert_selection_scope()
                    checkpoint(f"copy-{profile}-offer-{offer_id}-retained")
                    assert_selection_scope()
                    capture.authorization_checkpoints += 1
                    captured_payload = capture.capture(offer_id)

                    # Receipt is not success. Seal the complete transfer, clear
                    # the workstation-global selection, and seal that release
                    # before any application-controlled PNG is decoded.
                    assert_selection_scope()
                    checkpoint(f"copy-{profile}-offer-{offer_id}-transfer-complete")
                    assert_selection_scope()
                    capture.post_transfer_checkpoints += 1
                    capture.clear()
                    checkpoint(f"copy-{profile}-selection-cleared")
                    assert_selection_scope()
                    if (
                        captured_payload is None
                        or not capture.capture_complete
                        or capture.authorization_checkpoints != 1
                        or capture.post_transfer_checkpoints != 1
                        or not capture.clear_confirmed
                    ):
                        raise ToolError(
                            "RichCopySeal did not complete one fully checkpointed capture and clear"
                        )
                    if profile == "files":
                        if not isinstance(captured_payload, bytes) or launch_id_value is None:
                            raise ToolError("FileCopySeal did not receive one binary URI-list payload")
                        # Defer persistent publication until KeyFence has fully
                        # completed and released its birth-pinned keyboard.  A
                        # late focus, TickSeal, or release failure therefore
                        # cannot leave a successfully published but unreported
                        # file-copy artifact.
                        file_copy_launch_id = launch_id_value
            except Exception as error:
                capture_error = error
                raise
            finally:
                if capture is not None:
                    selection_evidence = capture.evidence()
                    with contextlib.suppress(Exception):
                        self.journal.append(
                            "selection-capture",
                            "desktop_copy",
                            {
                                "target_window_id": target.get("window_id"),
                                "target_launch_id": target.get("launch_id"),
                                "target_scene_member_count": (
                                    len(scene_launch_ids) if scene_launch_ids else None
                                ),
                                "kind": copy_kind,
                                "capture_profile": profile,
                                "chord": chord,
                                "maximum_bytes": maximum_bytes,
                                "maximum_file_bytes": (
                                    maximum_file_bytes if profile == "files" else None
                                ),
                                "maximum_total_bytes": (
                                    maximum_total_bytes if profile == "files" else None
                                ),
                                "maximum_entries": (
                                    maximum_entries if copy_kind == "directory" else None
                                ),
                                "maximum_directories": (
                                    maximum_directories if copy_kind == "directory" else None
                                ),
                                "maximum_depth": (
                                    maximum_depth if copy_kind == "directory" else None
                                ),
                                "timeout_milliseconds": timeout_milliseconds,
                                "quiet_milliseconds": quiet_milliseconds,
                            },
                            selection_evidence,
                            error=str(capture_error) if capture_error is not None else None,
                        )

        evidence = self._run_keyboard_fence(
            target,
            "desktop_copy",
            "rich-copy-seal",
            f"copy-{copy_kind}-chord",
            1,
            0.0,
            "desktop_copy",
            lambda transaction: transaction.prepare_chord(chord),
            copy,
        )
        if captured_payload is None or selection_evidence is None:
            raise ToolError("RichCopySeal completed without a payload custody receipt")
        if (
            selection_evidence.get("capture_profile") != profile
            or selection_evidence.get("payload_fingerprint_retained") is not False
            or selection_evidence.get("source_payload_retained") is not False
            or selection_evidence.get("stable_payload_fingerprint_retained") is not False
        ):
            raise ToolError("RichCopySeal profile or no-fingerprint custody is inconsistent")
        evidence["copy_seal"] = selection_evidence
        evidence["selection_scope"] = "private-workstation-global"
        evidence["selection_capture"] = (
            "post-arm-profile-matched-offer+controller-authorized-one-shot-receive"
        )
        evidence["selection_retention"] = (
            "cleared-and-roundtrip-confirmed-before-decode-or-file-admission-and-success"
        )
        evidence["captured_payload_logged"] = False
        evidence["captured_payload_fingerprinted"] = False
        if target.get("scene_launch_ids"):
            evidence["selection_source_mitigation"] = (
                "exact-scene-set-equals-complete-live-managed-domain-before-arm+capture+clear"
            )
        elif target.get("launch_id") is not None:
            evidence["selection_source_mitigation"] = (
                "sole-live-managed-launch-before-arm+capture+clear"
            )
        else:
            evidence["selection_source_mitigation"] = "private-workstation-trust-domain"

        if profile == "text":
            if not isinstance(captured_payload, str):
                raise ToolError("RichCopySeal text profile returned non-text payload")
            payload_bytes = len(captured_payload.encode("utf-8"))
            if selection_evidence.get("payload_bytes") != payload_bytes:
                raise ToolError("RichCopySeal text payload accounting is inconsistent")
            return {
                "copied": True,
                "kind": "text",
                "text": captured_payload,
                "characters": len(captured_payload),
                "bytes": payload_bytes,
                "mime": selection_evidence.get("mime"),
                "chord": chord,
                "untrusted": True,
                "trust": "controlled-application-output",
            }, evidence, None, None

        if profile == "files":
            if not isinstance(captured_payload, bytes):
                raise ToolError("FileCopySeal returned a non-binary URI-list payload")
            if selection_evidence.get("payload_bytes") != len(captured_payload):
                raise ToolError("FileCopySeal URI-list byte accounting is inconsistent")
            if file_copy_launch_id is None:
                raise ToolError("FileCopySeal completed without exact launch custody")
            deferred = DeferredFileCopy(
                file_copy_launch_id,
                captured_payload,
                maximum_file_bytes=maximum_file_bytes,
                maximum_total_bytes=maximum_total_bytes,
                chord=chord,
                copy_kind=copy_kind,
                maximum_entries=maximum_entries,
                maximum_directories=maximum_directories,
                maximum_depth=maximum_depth,
                source_mode="selection",
                source_count=1,
                action_authority_sha256=self._authority_digest({
                    "name": "desktop_copy",
                    "arguments": spec,
                }),
            )
            # Drop the immutable capture reference immediately.  The deferred
            # object keeps only a redacted mutable buffer and will publish only
            # after DesktopController proves the outer dispatch-complete seal.
            captured_payload = None
            evidence["file_copy_seal"] = {
                "publication_status": "deferred-until-outer-dispatch-complete",
                "publication_order": "after-keyfence-release+outer-TickSeal",
                "source_namespace": "exact-launch-private-output-only",
                "source_mode": "selection",
                "copy_kind": copy_kind,
                "uri_list_bytes": deferred.uri_list_bytes,
                "source_paths_retained": False,
                "stable_payload_fingerprint_retained": False,
            }
            return None, evidence, None, deferred

        if not isinstance(captured_payload, bytes):
            raise ToolError("RichCopySeal PNG profile returned non-binary payload")
        if selection_evidence.get("payload_bytes") != len(captured_payload):
            raise ToolError("RichCopySeal PNG source-byte accounting is inconsistent")
        canonical, metadata = self._sanitize_png_for_copy(captured_payload)
        if len(canonical) > maximum_bytes:
            raise ToolError("canonical copied PNG exceeds maximum_bytes")
        result = {
            "copied": True,
            **metadata,
            "chord": chord,
            "untrusted": True,
            "trust": "controlled-application-output",
        }
        evidence["image_copy"] = {
            "source_bytes": len(captured_payload),
            "canonical_bytes": len(canonical),
            "width": metadata["width"],
            "height": metadata["height"],
            "canonical_chunks": metadata["canonical_chunks"],
            "metadata_retained": False,
            "decoded_only_after_clear": True,
            "payload_written_to_disk": False,
            "stable_payload_fingerprint_retained": False,
        }
        return result, evidence, canonical, None

    def _desktop_copy_dispatch_publication_receipt(
        self,
        expected_action_sha256: str,
        action_event_receipt: dict[str, Any],
    ) -> tuple[str, int]:
        """Validate the common outer TickSeal and exact desktop_copy authority."""
        barriers = action_event_receipt.get("barriers")
        intervals = action_event_receipt.get("intervals")
        event_chain = action_event_receipt.get("event_chain_sha256")
        fatal_events = action_event_receipt.get("fatal_events")
        authority = action_event_receipt.get("authority")
        requested = authority.get("requested_action_sha256") if isinstance(authority, dict) else None
        reviewed = authority.get("reviewed_authority_sha256") if isinstance(authority, dict) else None
        validated = authority.get("validated_action_sha256") if isinstance(authority, dict) else None
        dispatch = authority.get("dispatch_authority_sha256") if isinstance(authority, dict) else None
        expected_dispatch = None
        if (
            isinstance(reviewed, str)
            and re.fullmatch(r"[0-9a-f]{64}", reviewed) is not None
            and isinstance(validated, str)
            and re.fullmatch(r"[0-9a-f]{64}", validated) is not None
        ):
            expected_dispatch = self._authority_digest({
                "schema": COMPOSITOR_ACTION_AUTHORITY_SCHEMA,
                "digest": COMPOSITOR_ACTION_AUTHORITY_DIGEST,
                "action": "desktop_copy",
                "reviewed_authority_sha256": reviewed,
                "validated_action_sha256": validated,
            })
        ready = barriers.get("dispatch-ready") if isinstance(barriers, dict) else None
        complete = barriers.get("dispatch-complete") if isinstance(barriers, dict) else None
        valid = (
            action_event_receipt.get("action") == "desktop_copy"
            and isinstance(authority, dict)
            and authority.get("schema") == COMPOSITOR_ACTION_AUTHORITY_SCHEMA
            and authority.get("digest") == COMPOSITOR_ACTION_AUTHORITY_DIGEST
            and authority.get("action") == "desktop_copy"
            and isinstance(requested, str)
            and re.fullmatch(r"[0-9a-f]{64}", requested) is not None
            and validated == expected_action_sha256
            and authority.get("validated_action_differs") is (validated != requested)
            and isinstance(reviewed, str)
            and re.fullmatch(r"[0-9a-f]{64}", reviewed) is not None
            and isinstance(dispatch, str)
            and hmac.compare_digest(dispatch, expected_dispatch or "")
            and isinstance(barriers, dict)
            and list(barriers)[-1:] == ["dispatch-complete"]
            and isinstance(ready, int)
            and not isinstance(ready, bool)
            and isinstance(complete, int)
            and not isinstance(complete, bool)
            and complete > ready
            and isinstance(intervals, list)
            and bool(intervals)
            and isinstance(intervals[-1], dict)
            and intervals[-1].get("phase") == "dispatch"
            and intervals[-1].get("start_sequence") == ready
            and intervals[-1].get("end_sequence") == complete
            and isinstance(fatal_events, int)
            and not isinstance(fatal_events, bool)
            and fatal_events == 0
            and isinstance(event_chain, str)
            and re.fullmatch(r"[0-9a-f]{64}", event_chain) is not None
        )
        if not valid:
            raise ToolError(
                "saved-output publication was withheld without exact outer dispatch authority"
            )
        return event_chain, complete

    def _publish_output_watch_after_dispatch(
        self,
        deferred: DeferredOutputWatch,
        watch_fence: dict[str, Any],
        action_event_receipt: dict[str, Any],
    ) -> dict[str, Any]:
        """Mint one output-watch capability only behind the outer TickSeal."""
        try:
            event_chain, dispatch_complete = (
                self._desktop_copy_dispatch_publication_receipt(
                    deferred.action_authority_sha256,
                    action_event_receipt,
                )
            )
            source_seal = watch_fence.get("output_watch_seal")
            valid = (
                watch_fence.get("schema") == OUTPUT_WATCH_SEAL_SCHEMA
                and watch_fence.get("enforced") is True
                and watch_fence.get("method") == "output-watch-arm"
                and watch_fence.get("target_launch_id") == deferred.launch_id
                and watch_fence.get("unit_kind") == "watch-baseline"
                and watch_fence.get("planned_units") == 1
                and watch_fence.get("completed_units") == 1
                and watch_fence.get("keyboard_injection") is False
                and watch_fence.get("clipboard_selection_used") is False
                and watch_fence.get("baseline_paths_exposed") is False
                and watch_fence.get("baseline_paths_persisted") is False
                and watch_fence.get("stable_content_fingerprint_retained") is False
                and isinstance(source_seal, dict)
                and source_seal.get("publication_status")
                == "deferred-until-outer-dispatch-complete"
                and source_seal.get("publication_order")
                == "after-baseline-revalidation+action-authority+outer-TickSeal"
                and source_seal.get("source_namespace")
                == "exact-launch-private-output-only"
                and source_seal.get("source_mode") == "output-watch"
                and source_seal.get("operation") == "watch"
                and source_seal.get("baseline_paths_exposed") is False
                and source_seal.get("baseline_paths_persisted") is False
                and source_seal.get("stable_content_fingerprint_retained") is False
            )
            if not valid:
                raise ToolError(
                    "OutputWatchSeal capability publication lost its baseline source seal"
                )
            result = deferred.publish(self)
        except Exception:
            deferred.discard()
            raise
        publication = {
            "publication_status": "published",
            "publication_order": (
                "after-baseline-revalidation+action-authority+"
                "outer-dispatch-complete-TickSeal"
            ),
