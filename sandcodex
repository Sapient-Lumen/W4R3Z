sc_help_topic() {
  local topic="${1:-}"
  [[ $# -le 1 ]] || {
    sc_err "help accepts one topic"
    printf 'Try: sandcodex help topics\n' >&2
    exit 64
  }
  case "${topic,,}" in
    ''|quick) sc_help ;;
    topics|help) sc_help_topics ;;
    all|reference|full) sc_help_all ;;
    manual|handbook)
      printf '%s\n' 'Run sandcodex manual to print the complete embedded field handbook.'
      printf '%s\n' 'It performs no project selection, state mutation, Nix realization, or provider request.'
      ;;
    run|room) sc_run_help ;;
    provider|providers|inference) sc_providers_help ;;
    provider-all|providers-all|inference-all) sc_providers_reference ;;
    local) sc_local_help ;;
    remote|openrouter) sc_remote_help ;;
    gemini) sc_gemini_help ;;
    loop|looper) sc_loop_help ;;
    team|teams|worker|workers|campaign|campaigns) sc_team_help ;;
    benchmark|bench) sc_benchmark_help ;;
    ready|doctor|logs|clean|state|auth|operator|publish|install|version)
      sc_lifecycle_help "${topic,,}"
      ;;
    *)
      sc_err "unknown help topic: $topic"
      sc_help_topics >&2
      exit 64
      ;;
  esac
}

