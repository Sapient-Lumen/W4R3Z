sc_emit_wayland_selection_agent_source() {
  cat <<'WAYLAND_SELECTION_AGENT_C'
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L

/*
 * RichCopySeal request-gated selection capture for Sandcodex.
 *
 * The controller starts this helper before emitting one guarded native copy
 * chord.  A launch-fixed profile selects bounded UTF-8 text, one PNG offer, or
 * one bounded text/uri-list file selection.  The helper clears stale clipboard
 * state, records an arm generation,
 * retains the first later profile-matching offer without requesting bytes, and
 * reports only bounded metadata.  The controller must revalidate focus,
 * launch/scene custody, and its ordered compositor-event interval before
 * authorizing the receive request.  Payload bytes cross one dedicated one-shot
 * pipe, never argv, environment, stdout, stderr, or disk.  Text is fully UTF-8
 * validated here.  File URI lists receive a strict ASCII framing pass before
 * the controller clears the selection, resolves only launch-private output
 * paths, and snapshots each admitted regular file descriptor-relatively.  PNG
 * receives a strict structural/CRC/APNG rejection pass before the controller
 * fully decodes, strips metadata, and canonically re-encodes it after a
 * round-trip-confirmed selection clear.
 */

#include <ctype.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <poll.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/prctl.h>
#include <sys/resource.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

#include <wayland-client.h>
#include "ext-data-control-v1-client-protocol.h"

#define AGENT_PROTOCOL "sandcodex.selection-agent.v3"
#define MAX_LINE_BYTES 256U
#define MAX_TOKENS 5U
#define MAX_TEXT_CAPTURE_BYTES (1024U * 1024U)
#define MAX_PNG_CAPTURE_BYTES (16U * 1024U * 1024U)
#define MAX_FILE_URI_LIST_BYTES (64U * 1024U)
#define MAX_PNG_DIMENSION 8192U
#define MAX_PNG_PIXELS (16U * 1024U * 1024U)
#define MAX_PNG_CHUNKS 4096U
#define MIN_PNG_BYTES 58U
#define MAX_OFFERS 8U
#define MAX_MIME_EVENTS 32U
#define MAX_MIME_BYTES 63U
#define MAX_NEXT_TIMEOUT_MILLISECONDS 10000U
#define MAX_QUIET_MILLISECONDS 1000U
#define TRANSFER_TIMEOUT_MILLISECONDS 5000U
#define TRANSFER_CHUNK_BYTES 16384U

static const char MIME_UTF8[] = "text/plain;charset=utf-8";
static const char MIME_TEXT[] = "text/plain";
static const char MIME_UTF8_STRING[] = "UTF8_STRING";
static const char MIME_PNG[] = "image/png";
static const char MIME_URI_LIST[] = "text/uri-list";

enum capture_profile {
    PROFILE_TEXT,
    PROFILE_PNG,
    PROFILE_FILES,
};

enum command_kind {
    COMMAND_ARM,
    COMMAND_NEXT,
    COMMAND_CAPTURE,
    COMMAND_CLEAR,
    COMMAND_PING,
    COMMAND_QUIT,
};

struct command {
    uint64_t sequence;
    enum command_kind kind;
    uint32_t timeout_milliseconds;
    uint32_t quiet_milliseconds;
    uint32_t offer_id;
};

struct offer_slot {
    struct ext_data_control_offer_v1 *object;
    uint32_t id;
    uint32_t mime_events;
    bool mime_utf8;
    bool mime_text;
    bool mime_utf8_string;
    bool mime_png;
    bool mime_uri_list;
    bool selected;
};

struct selection_state {
    struct wl_display *display;
    struct wl_registry *registry;
    struct wl_seat *seat;
    struct ext_data_control_manager_v1 *manager;
    struct ext_data_control_device_v1 *device;
    enum capture_profile profile;
    uint32_t manager_count;
    uint32_t seat_count;
    uint32_t manager_version;
    uint32_t manager_name;
    uint32_t seat_name;
    struct offer_slot offers[MAX_OFFERS];
    struct offer_slot *current;
    uint32_t next_offer_id;
    uint32_t offers_seen;
    uint32_t selection_generation;
    uint32_t armed_generation;
    uint32_t announced_offer_id;
    uint32_t captured_offer_id;
    uint32_t selection_events;
    uint32_t null_selection_events;
    uint64_t last_activity_milliseconds;
    int output_descriptor;
    size_t maximum_bytes;
    size_t captured_bytes;
    char captured_mime[MAX_MIME_BYTES + 1U];
    bool topology_valid;
    bool device_finished;
    bool terminal_error;
    bool baseline_clear_confirmed;
    bool armed;
    bool offer_announced;
    bool capture_in_progress;
    bool capture_complete;
    bool selection_changed_during_capture;
    bool clear_in_progress;
    bool final_clear_confirmed;
};

static volatile sig_atomic_t stop_requested = 0;

static void on_signal(int signo) {
    (void)signo;
    stop_requested = 1;
}

static uint64_t monotonic_milliseconds(void) {
    struct timespec value = {0};
    if (clock_gettime(CLOCK_MONOTONIC, &value) < 0) {
        return 0U;
    }
    return (uint64_t)value.tv_sec * UINT64_C(1000) +
        (uint64_t)value.tv_nsec / UINT64_C(1000000);
}

static bool parse_u64(const char *text, uint64_t minimum, uint64_t maximum,
        uint64_t *output) {
    if (text == NULL || *text == '\0' || *text == '-' || *text == '+') {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' ||
            value < minimum || value > maximum) {
        return false;
    }
    *output = (uint64_t)value;
    return true;
}

static size_t tokenize(char *line, char **tokens) {
    size_t count = 0U;
    char *save = NULL;
    for (char *token = strtok_r(line, " \t\r\n", &save);
         token != NULL;
         token = strtok_r(NULL, " \t\r\n", &save)) {
        if (count == MAX_TOKENS) {
            return MAX_TOKENS + 1U;
        }
        tokens[count++] = token;
    }
    return count;
}

static bool parse_command(char *line, uint64_t expected_sequence,
        struct command *command) {
    char *tokens[MAX_TOKENS] = {0};
    const size_t count = tokenize(line, tokens);
    uint64_t sequence = 0U;
    if (count < 2U || count > MAX_TOKENS ||
            !parse_u64(tokens[0], 1U, UINT64_MAX, &sequence) ||
            sequence != expected_sequence) {
        return false;
    }
    command->sequence = sequence;
    if (strcmp(tokens[1], "ARM") == 0 && count == 2U) {
        command->kind = COMMAND_ARM;
        return true;
    }
    if (strcmp(tokens[1], "NEXT") == 0) {
        uint64_t timeout = 0U;
        uint64_t quiet = 0U;
        if (count != 4U ||
                !parse_u64(tokens[2], 1U, MAX_NEXT_TIMEOUT_MILLISECONDS, &timeout) ||
                !parse_u64(tokens[3], 1U, MAX_QUIET_MILLISECONDS, &quiet)) {
            return false;
        }
        command->kind = COMMAND_NEXT;
        command->timeout_milliseconds = (uint32_t)timeout;
        command->quiet_milliseconds = (uint32_t)quiet;
        return true;
    }
    if (strcmp(tokens[1], "CAPTURE") == 0) {
        uint64_t offer_id = 0U;
        if (count != 3U || !parse_u64(tokens[2], 1U, UINT32_MAX, &offer_id)) {
            return false;
        }
        command->kind = COMMAND_CAPTURE;
        command->offer_id = (uint32_t)offer_id;
        return true;
    }
    if (strcmp(tokens[1], "CLEAR") == 0 && count == 2U) {
        command->kind = COMMAND_CLEAR;
        return true;
    }
    if (strcmp(tokens[1], "PING") == 0 && count == 2U) {
        command->kind = COMMAND_PING;
        return true;
    }
    if (strcmp(tokens[1], "QUIT") == 0 && count == 2U) {
        command->kind = COMMAND_QUIT;
        return true;
    }
    return false;
}

static void secure_zero(void *pointer, size_t length) {
    volatile unsigned char *cursor = pointer;
    while (length > 0U) {
        *cursor++ = 0U;
        length--;
    }
}

static bool validate_utf8(const unsigned char *bytes, size_t length) {
    for (size_t index = 0U; index < length;) {
        const unsigned char first = bytes[index];
        if (first == 0U) {
            return false;
        }
        if (first <= 0x7fU) {
            index++;
            continue;
        }
        if (first >= 0xc2U && first <= 0xdfU) {
            if (index + 1U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U) {
                return false;
            }
            index += 2U;
            continue;
        }
        if (first >= 0xe0U && first <= 0xefU) {
            if (index + 2U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (first == 0xe0U && bytes[index + 1U] < 0xa0U) ||
                    (first == 0xedU && bytes[index + 1U] >= 0xa0U)) {
                return false;
            }
            index += 3U;
            continue;
        }
        if (first >= 0xf0U && first <= 0xf4U) {
            if (index + 3U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (bytes[index + 3U] & 0xc0U) != 0x80U ||
                    (first == 0xf0U && bytes[index + 1U] < 0x90U) ||
                    (first == 0xf4U && bytes[index + 1U] >= 0x90U)) {
                return false;
            }
            index += 4U;
            continue;
        }
        return false;
    }
    return true;
}

static const char *profile_name(enum capture_profile profile) {
    if (profile == PROFILE_PNG) {
        return "png";
    }
    if (profile == PROFILE_FILES) {
        return "files";
    }
    return "text";
}

static bool parse_profile(const char *value, enum capture_profile *profile) {
    if (value != NULL && strcmp(value, "text") == 0) {
        *profile = PROFILE_TEXT;
        return true;
    }
    if (value != NULL && strcmp(value, "png") == 0) {
        *profile = PROFILE_PNG;
        return true;
    }
    if (value != NULL && strcmp(value, "files") == 0) {
        *profile = PROFILE_FILES;
        return true;
    }
    return false;
}

static bool validate_uri_list(const unsigned char *bytes, size_t length) {
    /*
     * RFC 2483 Section 5 specifies CRLF-delimited text/uri-list records and
     * comment lines. Native file managers also commonly emit LF-only records. Keep
     * this helper deliberately syntax-only: require bounded printable ASCII,
     * reject bare CR and controls, cap record count, and require at least one
     * non-comment record.  The controller performs the security decision after
     * the workstation-global selection is cleared: file scheme only, empty
     * authority, strict percent decoding, exact launch-private output root,
     * canonical path components, entry count, and descriptor-relative custody.
     */
    if (bytes == NULL || length == 0U || length > MAX_FILE_URI_LIST_BYTES) {
        return false;
    }
    size_t records = 0U;
    size_t record_start = 0U;
    bool usable_record = false;
    for (size_t index = 0U; index < length; index++) {
        const unsigned char value = bytes[index];
        if (value == '\r') {
            if (index + 1U >= length || bytes[index + 1U] != '\n') {
                return false;
            }
            continue;
        }
        if (value == '\n') {
            const size_t record_end = index > record_start && bytes[index - 1U] == '\r'
                ? index - 1U : index;
            records++;
            if (records > 64U) {
                return false;
            }
            if (record_end > record_start && bytes[record_start] != '#') {
                usable_record = true;
            }
            record_start = index + 1U;
            continue;
        }
        if (value < 0x20U || value > 0x7eU) {
            return false;
        }
    }
    if (record_start < length) {
        records++;
        if (records > 64U) {
            return false;
        }
        if (bytes[record_start] != '#') {
            usable_record = true;
        }
    }
    return records > 0U && usable_record;
}

static uint32_t read_be32(const unsigned char *bytes) {
    return ((uint32_t)bytes[0] << 24U) | ((uint32_t)bytes[1] << 16U) |
        ((uint32_t)bytes[2] << 8U) | (uint32_t)bytes[3];
}

static uint32_t png_crc32(const unsigned char *bytes, size_t length) {
    uint32_t value = UINT32_C(0xffffffff);
    for (size_t index = 0U; index < length; index++) {
        value ^= (uint32_t)bytes[index];
        for (unsigned bit = 0U; bit < 8U; bit++) {
            const uint32_t mask = (uint32_t)-(int32_t)(value & 1U);
            value = (value >> 1U) ^ (UINT32_C(0xedb88320) & mask);
        }
    }
    return value ^ UINT32_C(0xffffffff);
}

static bool png_bit_depth_valid(unsigned color_type, unsigned bit_depth) {
    switch (color_type) {
        case 0U:
            return bit_depth == 1U || bit_depth == 2U || bit_depth == 4U ||
                bit_depth == 8U || bit_depth == 16U;
        case 2U:
            return bit_depth == 8U || bit_depth == 16U;
        case 3U:
            return bit_depth == 1U || bit_depth == 2U ||
                bit_depth == 4U || bit_depth == 8U;
        case 4U:
        case 6U:
            return bit_depth == 8U || bit_depth == 16U;
        default:
            return false;
    }
}

static bool png_type_valid(const unsigned char *type) {
    for (size_t index = 0U; index < 4U; index++) {
        if (!((type[index] >= (unsigned char)'A' && type[index] <= (unsigned char)'Z') ||
                (type[index] >= (unsigned char)'a' && type[index] <= (unsigned char)'z'))) {
            return false;
        }
    }
    /* PNG reserves the lowercase bit in the third type byte. */
    return (type[2] & 0x20U) == 0U;
}

static bool png_type_is(const unsigned char *type, const char *value) {
    return memcmp(type, value, 4U) == 0;
}

static bool validate_png(const unsigned char *bytes, size_t length) {
    static const unsigned char signature[8] = {
        0x89U, 0x50U, 0x4eU, 0x47U, 0x0dU, 0x0aU, 0x1aU, 0x0aU,
    };
    if (bytes == NULL || length < MIN_PNG_BYTES ||
            length > MAX_PNG_CAPTURE_BYTES || memcmp(bytes, signature, sizeof(signature)) != 0) {
        return false;
    }
    size_t offset = sizeof(signature);
    uint32_t chunks = 0U;
    uint64_t idat_bytes = 0U;
    bool saw_ihdr = false;
    bool saw_plte = false;
    bool saw_idat = false;
    bool idat_ended = false;
    bool saw_iend = false;
    unsigned bit_depth = 0U;
    unsigned color_type = 0U;
    while (offset < length) {
        if (length - offset < 12U || chunks >= MAX_PNG_CHUNKS) {
            return false;
        }
        const uint32_t chunk_length = read_be32(bytes + offset);
        const unsigned char *type = bytes + offset + 4U;
        const size_t payload_offset = offset + 8U;
        if (!png_type_valid(type) || (size_t)chunk_length > length - payload_offset - 4U) {
            return false;
        }
        const size_t crc_offset = payload_offset + (size_t)chunk_length;
        const uint32_t expected_crc = read_be32(bytes + crc_offset);
        if (png_crc32(type, 4U + (size_t)chunk_length) != expected_crc) {
            return false;
        }
        chunks++;
        if (!saw_ihdr) {
            if (!png_type_is(type, "IHDR") || chunk_length != 13U) {
                return false;
            }
            const unsigned char *header = bytes + payload_offset;
            const uint32_t width = read_be32(header);
            const uint32_t height = read_be32(header + 4U);
            bit_depth = header[8];
            color_type = header[9];
            if (width == 0U || height == 0U || width > MAX_PNG_DIMENSION ||
                    height > MAX_PNG_DIMENSION ||
                    (uint64_t)width * (uint64_t)height > MAX_PNG_PIXELS ||
                    !png_bit_depth_valid(color_type, bit_depth) ||
                    header[10] != 0U || header[11] != 0U || header[12] > 1U) {
                return false;
            }
            saw_ihdr = true;
        } else if (png_type_is(type, "IHDR")) {
            return false;
        } else if (png_type_is(type, "PLTE")) {
            if (saw_plte || saw_idat || chunk_length == 0U ||
                    chunk_length > 768U || chunk_length % 3U != 0U ||
                    color_type == 0U || color_type == 4U ||
                    (color_type == 3U && chunk_length / 3U > (1U << bit_depth))) {
                return false;
            }
            saw_plte = true;
        } else if (png_type_is(type, "IDAT")) {
            if (idat_ended || saw_iend) {
                return false;
            }
            saw_idat = true;
            idat_bytes += chunk_length;
            if (idat_bytes > MAX_PNG_CAPTURE_BYTES) {
                return false;
            }
        } else if (png_type_is(type, "IEND")) {
            if (chunk_length != 0U || !saw_idat || idat_bytes == 0U ||
                    (color_type == 3U && !saw_plte) || saw_iend) {
                return false;
            }
            saw_iend = true;
            offset = crc_offset + 4U;
            return offset == length;
        } else {
            if (png_type_is(type, "acTL") || png_type_is(type, "fcTL") ||
                    png_type_is(type, "fdAT")) {
                return false;
            }
            /* Unknown critical chunks are not safe to reinterpret. */
            if ((type[0] & 0x20U) == 0U) {
                return false;
            }
            if (saw_idat) {
                idat_ended = true;
            }
        }
        offset = crc_offset + 4U;
    }
    return false;
}

static int inspect_pipe_endpoint(int descriptor, int expected_access,
        struct stat *metadata) {
    const int flags = fcntl(descriptor, F_GETFL);
    if (flags < 0 || (flags & O_ACCMODE) != expected_access ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, metadata) < 0 || !S_ISFIFO(metadata->st_mode) ||
            metadata->st_uid != geteuid() || metadata->st_nlink != 1U) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static bool same_pipe_endpoint(const struct stat *left, const struct stat *right) {
    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
}

static int inspect_descriptor_inventory(int output_descriptor) {
    DIR *directory = opendir("/proc/self/fd");
    if (directory == NULL) {
        return -1;
    }
    const int inventory_descriptor = dirfd(directory);
    if (inventory_descriptor < 0 || inventory_descriptor == output_descriptor) {
        const int saved = errno == 0 ? EPROTO : errno;
        (void)closedir(directory);
        errno = saved;
        return -1;
    }
    for (;;) {
        errno = 0;
        struct dirent *entry = readdir(directory);
        if (entry == NULL) {
            if (errno != 0) {
                const int saved = errno;
                (void)closedir(directory);
                errno = saved;
                return -1;
            }
            break;
        }
        if (entry->d_name[0] == '.') {
            continue;
        }
        uint64_t parsed = 0U;
        if (!parse_u64(entry->d_name, 0U, INT_MAX, &parsed)) {
            (void)closedir(directory);
            errno = EPROTO;
            return -1;
        }
        const int descriptor = (int)parsed;
        if (descriptor == STDIN_FILENO || descriptor == STDOUT_FILENO ||
                descriptor == STDERR_FILENO || descriptor == output_descriptor ||
                descriptor == inventory_descriptor) {
            continue;
        }
        (void)closedir(directory);
        errno = EPROTO;
        return -1;
    }
    if (closedir(directory) < 0) {
        return -1;
    }
    return 0;
}

static int harden_process(int output_descriptor) {
    const pid_t parent = getppid();
    struct stat input = {0};
    struct stat output = {0};
    struct stat diagnostic = {0};
    struct stat payload = {0};
    const struct rlimit no_core = {.rlim_cur = 0, .rlim_max = 0};
    const struct rlimit no_regular_file_output = {.rlim_cur = 0, .rlim_max = 0};
    if (output_descriptor < 3 || parent <= 1 ||
            inspect_pipe_endpoint(STDIN_FILENO, O_RDONLY, &input) < 0 ||
            inspect_pipe_endpoint(STDOUT_FILENO, O_WRONLY, &output) < 0 ||
            inspect_pipe_endpoint(STDERR_FILENO, O_WRONLY, &diagnostic) < 0 ||
            inspect_pipe_endpoint(output_descriptor, O_WRONLY, &payload) < 0 ||
            same_pipe_endpoint(&input, &output) ||
            same_pipe_endpoint(&input, &diagnostic) ||
            same_pipe_endpoint(&input, &payload) ||
            same_pipe_endpoint(&output, &diagnostic) ||
            same_pipe_endpoint(&output, &payload) ||
            same_pipe_endpoint(&diagnostic, &payload) ||
            inspect_descriptor_inventory(output_descriptor) < 0 ||
            setrlimit(RLIMIT_CORE, &no_core) < 0 ||
            setrlimit(RLIMIT_FSIZE, &no_regular_file_output) < 0) {
        errno = EPROTO;
        return -1;
    }
    const int descriptor_flags = fcntl(output_descriptor, F_GETFD);
    const int status_flags = fcntl(output_descriptor, F_GETFL);
    if (descriptor_flags < 0 || status_flags < 0 ||
            fcntl(output_descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0 ||
            fcntl(output_descriptor, F_SETFL, status_flags | O_NONBLOCK) < 0 ||
            prctl(PR_SET_PDEATHSIG, SIGTERM) < 0 || getppid() != parent ||
            prctl(PR_SET_NO_NEW_PRIVS, 1L, 0L, 0L, 0L) < 0 ||
            prctl(PR_SET_DUMPABLE, 0L, 0L, 0L, 0L) < 0) {
        return -1;
    }
    (void)umask(S_IRWXG | S_IRWXO);
    return 0;
}

static struct offer_slot *find_offer(struct selection_state *state,
        struct ext_data_control_offer_v1 *object) {
    for (size_t index = 0U; index < MAX_OFFERS; index++) {
        if (state->offers[index].object == object) {
            return &state->offers[index];
        }
    }
    return NULL;
}

static struct offer_slot *allocate_offer(struct selection_state *state,
        struct ext_data_control_offer_v1 *object) {
    for (size_t index = 0U; index < MAX_OFFERS; index++) {
        if (state->offers[index].object == NULL) {
            state->next_offer_id++;
            if (state->next_offer_id == 0U) {
                errno = EOVERFLOW;
                return NULL;
            }
            state->offers[index] = (struct offer_slot){
                .object = object,
                .id = state->next_offer_id,
            };
            return &state->offers[index];
        }
    }
    errno = ENOSPC;
    return NULL;
}

static void destroy_offer(struct selection_state *state, struct offer_slot *slot) {
    if (slot == NULL || slot->object == NULL) {
        return;
    }
    if (state->current == slot) {
        state->current = NULL;
    }
    ext_data_control_offer_v1_destroy(slot->object);
    *slot = (struct offer_slot){0};
}

static void destroy_all_offers(struct selection_state *state) {
    for (size_t index = 0U; index < MAX_OFFERS; index++) {
        destroy_offer(state, &state->offers[index]);
    }
    state->current = NULL;
}

static const char *preferred_mime(const struct selection_state *state,
        const struct offer_slot *slot) {
    if (state == NULL || slot == NULL) {
        return NULL;
    }
    if (state->profile == PROFILE_PNG) {
        return slot->mime_png ? MIME_PNG : NULL;
    }
    if (state->profile == PROFILE_FILES) {
        return slot->mime_uri_list ? MIME_URI_LIST : NULL;
    }
    if (slot->mime_utf8) {
        return MIME_UTF8;
    }
    if (slot->mime_utf8_string) {
        return MIME_UTF8_STRING;
    }
    if (slot->mime_text) {
        return MIME_TEXT;
    }
    return NULL;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct selection_state *state = data;
    if (strcmp(interface, ext_data_control_manager_v1_interface.name) == 0) {
        state->manager_count++;
        if (state->manager == NULL) {
            state->manager_version = version < 1U ? version : 1U;
            state->manager_name = name;
            state->manager = wl_registry_bind(registry, name,
                &ext_data_control_manager_v1_interface, state->manager_version);
        }
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        if (state->seat == NULL) {
            state->seat_name = name;
            state->seat = wl_registry_bind(registry, name, &wl_seat_interface,
                version < 1U ? version : 1U);
        }
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    (void)registry;
    struct selection_state *state = data;
    if (name == state->manager_name || name == state->seat_name) {
        state->topology_valid = false;
        state->terminal_error = true;
    }
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

static void offer_mime(void *data, struct ext_data_control_offer_v1 *object,
        const char *mime_type) {
    struct selection_state *state = data;
    struct offer_slot *slot = find_offer(state, object);
    if (slot == NULL || mime_type == NULL) {
        state->terminal_error = true;
        return;
    }
    const size_t length = strnlen(mime_type, MAX_MIME_BYTES + 1U);
    if (length == 0U || length > MAX_MIME_BYTES || slot->mime_events >= MAX_MIME_EVENTS) {
        state->terminal_error = true;
        return;
    }
    for (size_t index = 0U; index < length; index++) {
        const unsigned char value = (unsigned char)mime_type[index];
        if (value < 0x21U || value > 0x7eU) {
            state->terminal_error = true;
            return;
        }
    }
    slot->mime_events++;
    if (strcmp(mime_type, MIME_UTF8) == 0) {
        slot->mime_utf8 = true;
    } else if (strcmp(mime_type, MIME_TEXT) == 0) {
        slot->mime_text = true;
    } else if (strcmp(mime_type, MIME_UTF8_STRING) == 0) {
        slot->mime_utf8_string = true;
    } else if (strcmp(mime_type, MIME_PNG) == 0) {
        slot->mime_png = true;
    } else if (strcmp(mime_type, MIME_URI_LIST) == 0) {
        slot->mime_uri_list = true;
    }
    state->last_activity_milliseconds = monotonic_milliseconds();
}

static const struct ext_data_control_offer_v1_listener offer_listener = {
    .offer = offer_mime,
};

static void device_data_offer(void *data, struct ext_data_control_device_v1 *device,
        struct ext_data_control_offer_v1 *object) {
    (void)device;
    struct selection_state *state = data;
    state->offers_seen++;
    if (state->offers_seen == 0U || object == NULL ||
            allocate_offer(state, object) == NULL ||
            ext_data_control_offer_v1_add_listener(object, &offer_listener, state) < 0) {
        if (object != NULL && find_offer(state, object) == NULL) {
            ext_data_control_offer_v1_destroy(object);
        }
        state->terminal_error = true;
        return;
    }
    state->last_activity_milliseconds = monotonic_milliseconds();
}

static void device_selection(void *data, struct ext_data_control_device_v1 *device,
        struct ext_data_control_offer_v1 *object) {
    (void)device;
    struct selection_state *state = data;
    state->selection_events++;
    state->selection_generation++;
    if (state->selection_generation == 0U) {
        state->terminal_error = true;
        return;
    }
    if (state->capture_in_progress) {
        state->selection_changed_during_capture = true;
    }
    if (object == NULL) {
        state->null_selection_events++;
        if (state->current != NULL) {
            destroy_offer(state, state->current);
        }
    } else {
        struct offer_slot *slot = find_offer(state, object);
        if (slot == NULL || state->clear_in_progress) {
            state->terminal_error = true;
            return;
        }
        if (state->current != NULL && state->current != slot) {
            destroy_offer(state, state->current);
        }
        slot->selected = true;
        state->current = slot;
    }
    state->last_activity_milliseconds = monotonic_milliseconds();
}

static void device_finished(void *data, struct ext_data_control_device_v1 *device) {
    (void)device;
    struct selection_state *state = data;
    state->device_finished = true;
    state->terminal_error = true;
}

static void device_primary_selection(void *data,
        struct ext_data_control_device_v1 *device,
        struct ext_data_control_offer_v1 *object) {
    (void)device;
    struct selection_state *state = data;
    if (object != NULL) {
        struct offer_slot *slot = find_offer(state, object);
        if (slot == NULL || slot == state->current) {
            state->terminal_error = true;
            return;
        }
        destroy_offer(state, slot);
    }
    state->last_activity_milliseconds = monotonic_milliseconds();
}

static const struct ext_data_control_device_v1_listener device_listener = {
    .data_offer = device_data_offer,
    .selection = device_selection,
    .finished = device_finished,
    .primary_selection = device_primary_selection,
};

static int display_roundtrip(struct selection_state *state) {
    if (!state->topology_valid || state->display == NULL ||
            wl_display_roundtrip(state->display) < 0 || !state->topology_valid ||
            state->device_finished || state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int dispatch_ready_events(struct selection_state *state, int timeout_milliseconds) {
    if (!state->topology_valid || state->display == NULL ||
            wl_display_dispatch_pending(state->display) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (state->terminal_error || state->device_finished) {
        errno = EPROTO;
        return -1;
    }
    if (wl_display_flush(state->display) < 0 && errno != EAGAIN) {
        return -1;
    }
    const int descriptor = wl_display_get_fd(state->display);
    if (descriptor < 0) {
        errno = EPROTO;
        return -1;
    }
    struct pollfd item = {
        .fd = descriptor,
        .events = POLLIN,
        .revents = 0,
    };
    int result = 0;
    do {
        result = poll(&item, 1U, timeout_milliseconds);
    } while (result < 0 && errno == EINTR && !stop_requested);
    if (result < 0) {
        return -1;
    }
    if (result == 0) {
        return 0;
    }
    if ((item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
            (item.revents & POLLIN) == 0 || wl_display_dispatch(state->display) < 0 ||
            state->terminal_error || state->device_finished || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    return 1;
}

static int clear_selection(struct selection_state *state, bool baseline) {
    if ((!baseline && state->final_clear_confirmed) || state->device == NULL ||
            state->display == NULL || !state->topology_valid) {
        if (!baseline && state->final_clear_confirmed) {
            return 0;
        }
        errno = EPROTO;
        return -1;
    }
    state->clear_in_progress = true;
    ext_data_control_device_v1_set_selection(state->device, NULL);
    const int result = wl_display_roundtrip(state->display);
    state->clear_in_progress = false;
    if (result < 0 || !state->topology_valid || state->device_finished ||
            state->terminal_error || state->current != NULL) {
        errno = EPROTO;
        return -1;
    }
    if (baseline) {
        state->baseline_clear_confirmed = true;
    } else {
        state->final_clear_confirmed = true;
    }
    state->last_activity_milliseconds = monotonic_milliseconds();
    return 0;
}

static int initialize_wayland(struct selection_state *state) {
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->topology_valid = true;
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 || state->manager == NULL ||
            state->seat == NULL || state->manager_count != 1U || state->seat_count != 1U ||
            state->manager_version < 1U || state->manager_name == 0U ||
            state->seat_name == 0U || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    state->device = ext_data_control_manager_v1_get_data_device(state->manager, state->seat);
    if (state->device == NULL ||
            ext_data_control_device_v1_add_listener(state->device, &device_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 || state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    return clear_selection(state, true);
}

static int arm_capture(struct selection_state *state) {
    if (state->armed || state->capture_complete || state->terminal_error ||
            clear_selection(state, true) < 0) {
        errno = EPROTO;
        return -1;
    }
    state->armed = true;
    state->armed_generation = state->selection_generation;
    state->offer_announced = false;
    state->announced_offer_id = 0U;
    return 0;
}

static int next_offer(struct selection_state *state, uint32_t timeout_milliseconds,
        uint32_t quiet_milliseconds, struct offer_slot **result) {
    if (!state->armed || state->offer_announced || state->capture_complete ||
            state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    const uint64_t deadline = monotonic_milliseconds() + timeout_milliseconds;
    while (!stop_requested) {
        const uint64_t now = monotonic_milliseconds();
        if (state->current != NULL && state->current->selected &&
                state->selection_generation > state->armed_generation &&
                preferred_mime(state, state->current) != NULL &&
                now >= state->last_activity_milliseconds + quiet_milliseconds) {
            state->offer_announced = true;
            state->announced_offer_id = state->current->id;
            *result = state->current;
            return 0;
        }
        if (now >= deadline) {
            errno = ETIMEDOUT;
            return -1;
        }
        uint64_t remaining = deadline - now;
        uint64_t wait = remaining;
        if (state->current != NULL && state->selection_generation > state->armed_generation) {
            const uint64_t quiet_deadline = state->last_activity_milliseconds + quiet_milliseconds;
            if (quiet_deadline > now && quiet_deadline - now < wait) {
                wait = quiet_deadline - now;
            }
        }
        if (wait > (uint64_t)INT_MAX) {
            wait = (uint64_t)INT_MAX;
        }
        if (dispatch_ready_events(state, (int)wait) < 0) {
            return -1;
        }
    }
    errno = EINTR;
    return -1;
}

static int write_output(struct selection_state *state,
        const unsigned char *bytes, size_t length) {
    size_t offset = 0U;
    const uint64_t deadline = monotonic_milliseconds() + TRANSFER_TIMEOUT_MILLISECONDS;
    while (offset < length && !stop_requested) {
        const ssize_t count = write(state->output_descriptor, bytes + offset, length - offset);
        if (count > 0) {
            offset += (size_t)count;
            continue;
        }
        if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
            return -1;
        }
        const uint64_t now = monotonic_milliseconds();
        if (now >= deadline) {
            errno = ETIMEDOUT;
            return -1;
        }
        uint64_t remaining = deadline - now;
        if (remaining > (uint64_t)INT_MAX) {
            remaining = (uint64_t)INT_MAX;
        }
        struct pollfd item = {
            .fd = state->output_descriptor,
            .events = POLLOUT,
            .revents = 0,
        };
        int result = 0;
        do {
            result = poll(&item, 1U, (int)remaining);
        } while (result < 0 && errno == EINTR && !stop_requested);
        if (result <= 0 || (item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
                (item.revents & POLLOUT) == 0) {
            errno = result == 0 ? ETIMEDOUT : EPIPE;
            return -1;
        }
    }
    if (stop_requested) {
        errno = EINTR;
        return -1;
    }
    return 0;
}

static int capture_offer(struct selection_state *state, uint32_t offer_id) {
    if (!state->armed || !state->offer_announced || state->capture_complete ||
            state->output_descriptor < 0 || state->current == NULL ||
            state->current->id != offer_id || state->announced_offer_id != offer_id ||
            state->selection_generation <= state->armed_generation ||
            state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    const char *mime = preferred_mime(state, state->current);
    if (mime == NULL || strlen(mime) > MAX_MIME_BYTES) {
        errno = EPROTO;
        return -1;
    }
    int descriptors[2] = {-1, -1};
    if (pipe2(descriptors, O_CLOEXEC) < 0) {
        return -1;
    }
    const int flags = fcntl(descriptors[0], F_GETFL);
    if (flags < 0 || fcntl(descriptors[0], F_SETFL, flags | O_NONBLOCK) < 0) {
        const int saved = errno;
        (void)close(descriptors[0]);
        (void)close(descriptors[1]);
        errno = saved;
        return -1;
    }
    unsigned char *buffer = malloc(state->maximum_bytes + 1U);
    if (buffer == NULL) {
        const int saved = errno;
        (void)close(descriptors[0]);
        (void)close(descriptors[1]);
        errno = saved;
        return -1;
    }
    state->capture_in_progress = true;
    state->selection_changed_during_capture = false;
    ext_data_control_offer_v1_receive(state->current->object, mime, descriptors[1]);
    (void)close(descriptors[1]);
    descriptors[1] = -1;
    if (wl_display_flush(state->display) < 0 && errno != EAGAIN) {
        goto failed;
    }

    size_t length = 0U;
    bool eof = false;
    const uint64_t deadline = monotonic_milliseconds() + TRANSFER_TIMEOUT_MILLISECONDS;
    while (!eof && !stop_requested) {
        if (state->terminal_error || state->selection_changed_during_capture ||
                state->current == NULL || state->current->id != offer_id) {
            errno = EPROTO;
            goto failed;
        }
        if (wl_display_dispatch_pending(state->display) < 0 ||
                (wl_display_flush(state->display) < 0 && errno != EAGAIN)) {
            goto failed;
        }
        const uint64_t now = monotonic_milliseconds();
        if (now >= deadline) {
            errno = ETIMEDOUT;
            goto failed;
        }
        uint64_t remaining = deadline - now;
        if (remaining > (uint64_t)INT_MAX) {
            remaining = (uint64_t)INT_MAX;
        }
        struct pollfd items[2] = {
            {.fd = wl_display_get_fd(state->display), .events = POLLIN, .revents = 0},
            {.fd = descriptors[0], .events = POLLIN | POLLHUP, .revents = 0},
        };
        if (items[0].fd < 0) {
            errno = EPROTO;
            goto failed;
        }
        int result = 0;
        do {
            result = poll(items, 2U, (int)remaining);
        } while (result < 0 && errno == EINTR && !stop_requested);
        if (result <= 0) {
            errno = result == 0 ? ETIMEDOUT : errno;
            goto failed;
        }
        if ((items[0].revents & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
            errno = EPROTO;
            goto failed;
        }
        if ((items[0].revents & POLLIN) != 0 && wl_display_dispatch(state->display) < 0) {
            goto failed;
        }
        if ((items[1].revents & (POLLERR | POLLNVAL)) != 0) {
            errno = EPIPE;
            goto failed;
        }
        if ((items[1].revents & (POLLIN | POLLHUP)) != 0) {
            for (;;) {
                const size_t remaining_buffer = state->maximum_bytes + 1U - length;
                if (remaining_buffer == 0U) {
                    errno = EFBIG;
                    goto failed;
                }
                const ssize_t count = read(descriptors[0], buffer + length, remaining_buffer);
                if (count > 0) {
                    length += (size_t)count;
                    if (length > state->maximum_bytes) {
                        errno = EFBIG;
                        goto failed;
                    }
                    continue;
                }
                if (count == 0) {
                    eof = true;
                    break;
                }
                if (errno == EAGAIN || errno == EWOULDBLOCK) {
                    break;
                }
                if (errno == EINTR) {
                    continue;
                }
                goto failed;
            }
        }
        if (state->terminal_error || state->selection_changed_during_capture ||
                state->current == NULL || state->current->id != offer_id) {
            errno = EPROTO;
            goto failed;
        }
    }
    if (stop_requested) {
        errno = EINTR;
        goto failed;
    }
    /*
     * A final transfer read and a selection transition can be readable in the
     * same poll cycle.  Re-checking only at the top of the loop would allow EOF
     * to terminate the loop before the transition invalidated the receive.
     * Drain already-ready compositor events once the data pipe reaches EOF and
     * reject any changed offer before validating or releasing payload bytes.
     */
    for (;;) {
        const int dispatched = dispatch_ready_events(state, 0);
        if (dispatched < 0) {
            goto failed;
        }
        if (state->terminal_error || state->selection_changed_during_capture ||
                state->current == NULL || state->current->id != offer_id) {
            errno = EPROTO;
            goto failed;
        }
        if (dispatched == 0) {
            break;
        }
    }
    if (display_roundtrip(state) < 0 || state->selection_changed_during_capture ||
            state->current == NULL || state->current->id != offer_id) {
        errno = EPROTO;
        goto failed;
    }
    if (state->profile == PROFILE_PNG) {
        if (!validate_png(buffer, length)) {
            errno = EBADMSG;
            goto failed;
        }
    } else if (state->profile == PROFILE_FILES) {
        if (!validate_uri_list(buffer, length)) {
            errno = ENOMSG;
            goto failed;
        }
    } else if (!validate_utf8(buffer, length)) {
        errno = EILSEQ;
        goto failed;
    }
    if (write_output(state, buffer, length) < 0) {
        goto failed;
    }
    if (close(state->output_descriptor) < 0) {
        state->output_descriptor = -1;
        goto failed;
    }
    state->output_descriptor = -1;
    state->captured_bytes = length;
    state->captured_offer_id = offer_id;
    (void)snprintf(state->captured_mime, sizeof(state->captured_mime), "%s", mime);
    state->capture_complete = true;
    state->capture_in_progress = false;
    secure_zero(buffer, state->maximum_bytes + 1U);
    free(buffer);
    (void)close(descriptors[0]);
    return 0;

failed:
    {
        const int saved = errno == 0 ? EPROTO : errno;
        state->capture_in_progress = false;
        state->terminal_error = true;
        secure_zero(buffer, state->maximum_bytes + 1U);
        free(buffer);
        if (descriptors[0] >= 0) {
            (void)close(descriptors[0]);
        }
        if (descriptors[1] >= 0) {
            (void)close(descriptors[1]);
        }
        errno = saved;
        return -1;
    }
}

static void cleanup(struct selection_state *state) {
    if (state->device != NULL && state->display != NULL && state->topology_valid &&
            !state->final_clear_confirmed) {
        state->clear_in_progress = true;
        ext_data_control_device_v1_set_selection(state->device, NULL);
        (void)wl_display_roundtrip(state->display);
        state->clear_in_progress = false;
    }
    destroy_all_offers(state);
    if (state->device != NULL) {
        ext_data_control_device_v1_destroy(state->device);
        state->device = NULL;
    }
    if (state->manager != NULL) {
        ext_data_control_manager_v1_destroy(state->manager);
        state->manager = NULL;
    }
    if (state->seat != NULL) {
        wl_seat_destroy(state->seat);
        state->seat = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
    if (state->output_descriptor >= 0) {
        (void)close(state->output_descriptor);
        state->output_descriptor = -1;
    }
}

static const char *error_reason(int value) {
    switch (value) {
        case ETIMEDOUT:
            return "selection-timeout";
        case EFBIG:
            return "selection-too-large";
        case EILSEQ:
            return "selection-not-utf8";
        case EBADMSG:
            return "selection-png-invalid";
        case ENOMSG:
            return "selection-uri-list-invalid";
        case EPIPE:
            return "selection-output-closed";
        case EINTR:
            return "selection-interrupted";
        default:
            return "selection-state-invalid";
    }
}

static void reply_error(uint64_t sequence, const char *reason,
        const struct selection_state *state) {
    fprintf(stdout,
        "ERR %" PRIu64 " %s OFFERS %u GENERATION %u CAPTURED %u CLEARED %u\n",
        sequence, reason, state->offers_seen, state->selection_generation,
        state->capture_complete ? 1U : 0U, state->final_clear_confirmed ? 1U : 0U);
    (void)fflush(stdout);
}

