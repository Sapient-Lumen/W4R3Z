sc_prime_sudo() {
  [[ -n "$SC_SUDO" && -x "$SC_SUDO" ]] || sc_die "BARE-METAL requires sudo"
  [[ -r /dev/tty || -t 0 ]] || sc_die "password sudo requires a terminal"
  local setsid_bin pgid sudo_attempt sudo_uid id_bin
  setsid_bin="$(command -v setsid 2>/dev/null || true)"
  [[ -n "$setsid_bin" && -x "$setsid_bin" ]] || sc_die "BARE-METAL requires setsid for bounded sudo-ticket lifecycle"
  id_bin="$(command -v id 2>/dev/null || true)"
  [[ -n "$id_bin" && -x "$id_bin" ]] || sc_die "BARE-METAL requires id for sudo authority verification"
  sc_note "sudo will read your password directly"
  "$SC_SUDO" -v
  "$SC_SUDO" -n true || sc_die "sudo timestamp is not reusable by descendants"
  sudo_uid="$("$SC_SUDO" -n -- "$id_bin" -u 2>/dev/null)" || \
    sc_die "sudo ticket cannot execute non-interactive root commands"
  [[ "$sudo_uid" == 0 ]] || sc_die "sudo ticket did not yield uid 0"
  SC_SUDO_PID_FILE="$(mktemp "$SC_CONTROL/tmp/.sudo-keepalive.XXXXXX")"
  chmod 600 -- "$SC_SUDO_PID_FILE"
  # The tracked supervisor cannot disappear when setsid needs to fork. It
  # receives a parent-death signal, forwards shutdown to the child session,
  # and waits for the exact session leader before exiting.
  # shellcheck disable=SC2016
  # Bash keeps its lazily-read script on a private descriptor (normally 255).
  # Do not let either nested shell inherit that shared open-file description:
  # a descendant Bash may otherwise reuse/seek it and corrupt the parent
  # launcher's parse position while Sandcodex is still running.
  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM bash -c '
      set -Eeuo pipefail
      setsid_bin=$1; pid_file=$2; sudo=$3; child=
      cleanup() {
        rc=$?
        trap - EXIT INT TERM HUP
        if [[ -s "$pid_file" ]]; then
          pgid=$(<"$pid_file")
          [[ "$pgid" =~ ^[1-9][0-9]*$ ]] && kill -TERM -- "-$pgid" 2>/dev/null || true
        fi
        [[ -z "$child" ]] || { kill -TERM "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; }
        exit "$rc"
      }
      trap cleanup EXIT INT TERM HUP
      "$setsid_bin" --fork --wait bash -c '\''
        set -Eeuo pipefail
        pid_file=$1; sudo=$2
        printf "%s\\n" "$$" >"$pid_file"
        chmod 600 -- "$pid_file"
        while sleep 30; do "$sudo" -n -v || exit 1; done
      '\'' sandcodex-keepalive "$pid_file" "$sudo" 2>/dev/null & child=$!
      wait "$child"
    ' sandcodex-sudo-supervisor "$setsid_bin" "$SC_SUDO_PID_FILE" "$SC_SUDO"
  ) & SC_SUDO_PID=$!
  SC_SUDO_START="$(sc_process_start "$SC_SUDO_PID" 2>/dev/null || true)"
  [[ "$SC_SUDO_START" =~ ^[0-9]+$ ]] || sc_die "could not birth-pin the sudo keepalive"
  pgid=""
  for (( sudo_attempt=0; sudo_attempt<200; sudo_attempt++ )); do
    sc_pid_still_matches "$SC_SUDO_PID" "$SC_SUDO_START" || break
    if [[ -f "$SC_SUDO_PID_FILE" && ! -L "$SC_SUDO_PID_FILE" && \
      "$(stat -c %u:%a:%h -- "$SC_SUDO_PID_FILE" 2>/dev/null || true)" == "$(id -u):600:1" ]]; then
      pgid="$(<"$SC_SUDO_PID_FILE")"
      [[ "$pgid" =~ ^[1-9][0-9]*$ ]] && kill -0 -- "-$pgid" 2>/dev/null && break
    fi
    sleep 0.01
  done
  [[ "$pgid" =~ ^[1-9][0-9]*$ ]] || sc_die "sudo keepalive did not publish its private process group"
  SC_SUDO_PGID="$pgid"
  sc_log_event info sudo_ready "sudo timestamp primed for descendants"
}

sc_wait_safe_provider() {
  local exited="" rc=0 index label
  local -a pids=("$SC_CHILD_PID") labels=(provider)
  for index in "${!SC_PUBLISH_PIDS[@]}"; do
    if [[ "${SC_PUBLISH_PIDS[$index]}" =~ ^[1-9][0-9]*$ ]]; then
      pids+=("${SC_PUBLISH_PIDS[$index]}")
      labels+=("publisher:${SC_PUBLISH_SPECS[$index]}")
    fi
  done
  if (( SC_DESKTOP )); then
    if [[ "$SC_DESKTOP_SERVER_PID" =~ ^[1-9][0-9]*$ ]]; then
      pids+=("$SC_DESKTOP_SERVER_PID"); labels+=(desktop-controller)
    fi
    if [[ "$SC_DESKTOP_DISPLAY_BACKEND" == xvfb ]]; then
      if [[ "$SC_DESKTOP_DISPLAY_RELAY_PID" =~ ^[1-9][0-9]*$ ]]; then
        pids+=("$SC_DESKTOP_DISPLAY_RELAY_PID"); labels+=(desktop-display-relay)
      fi
      if [[ "$SC_DESKTOP_DISPLAY_PID" =~ ^[1-9][0-9]*$ ]]; then
        pids+=("$SC_DESKTOP_DISPLAY_PID")
        labels+=("$([[ $SC_HEADFUL == 1 ]] && printf xephyr-display || printf xvfb-display)")
      fi
    fi
  fi
  SC_PROVIDER_WAIT_FAILURE=""
  set +e
  wait -n -p exited "${pids[@]}"
  rc=$?
  set -e
  if [[ "$exited" == "$SC_CHILD_PID" ]]; then
    SC_CHILD_PID=""; SC_CHILD_START=""
    return "$rc"
  fi
  label=unknown-required-service
  for index in "${!pids[@]}"; do
    [[ "$exited" == "${pids[$index]}" ]] || continue
    label="${labels[$index]}"
    break
  done
  SC_PROVIDER_WAIT_FAILURE="$label"
  if [[ "$label" == publisher:* ]]; then
    sc_log_event error publish_service_lost "required TCP publisher exited while Codex was active" \
      "service=$label" "service_exit=$rc" "provider_terminated=true"
  else
    sc_log_event error desktop_service_lost "required desktop service exited while Codex was active" \
      "service=$label" "service_exit=$rc" "provider_terminated=true"
  fi
  sc_err "required $label exited while Codex was active; terminating the session"
  sc_stop_tracked_pid "$SC_CHILD_PID" "$SC_CHILD_START" TERM 80
  wait "$SC_CHILD_PID" 2>/dev/null || true
  SC_CHILD_PID=""; SC_CHILD_START=""
  return 78
}

sc_run_safe() {
  SC_OPERATION=safe-run
  sc_ensure_auth
  sc_seed_auth
  sc_resolve_requested_resume
  sc_loop_reset_requests
  sc_loop_initialize_state interactive 1 1 0 -1 "$SC_LOOP_DEFAULT_PROMPT"
  sc_domains; sc_runtime_begin
  sc_write_browser_stack
  sc_write_desktop_stack
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_TEST_BROWSER_BUNDLE_ONLY:-0}" == 1 ]]; then
    [[ -n "$SC_BROWSER_BUNDLE_ARCHIVE" ]] || sc_die 'browser-bundle-only test requires an automatic browser archive'
    sc_ok 'browser bundle validation-only test passed'
    return 0
  fi
  sc_proxy_start || sc_die "could not start the Sandcodex network proxy"
  sc_start_desktop_proxy_bridge || sc_die "could not start the isolated desktop network bridge"
  sc_start_and_verify_inner_jail
  sc_prepare_campaign_authority
  sc_write_worker_helper
  sc_start_campaign_broker
  sc_write_agent_contract
  sc_write_child_config
  sc_start_browser_broker || sc_die "complete browser initialization failed"
  sc_browser_boundary_preflight || sc_die "browser boundary preflight failed closed"
  sc_desktop_boundary_preflight || sc_die "desktop boundary preflight failed closed"
  sc_start_desktop_broker || sc_die "isolated desktop initialization failed"
  sc_start_operator_stack
  sc_start_publishers || sc_die "agent TCP publication failed closed"
  sc_boundary_preflight || sc_die "sandbox preflight failed closed"
  sc_ok "boundary verified · project-only writes · trusted state hidden"
  local -a argv=()
  sc_codex_argv argv
  sc_log_event info provider_launch "launching Codex in nested boundary" "posture=safe" \
    "outer=bubblewrap+$([[ $SC_DEV_NET == 1 ]] && printf unrestricted || printf provider-only)-proxy" \
    "resume=$SC_RESUME" "dev_network=$SC_DEV_NET" "project_authority=full" \
    "project_config_trusted=$SC_TRUST_PROJECT" \
    "local_provider=${SC_LOCAL_PROVIDER:-none}" "local_model=${SC_MODEL:-none}" \
    "local_model_digest=${SC_LOCAL_MODEL_DIGEST:-unconstrained}" "local_context_tokens=${SC_LOCAL_CONTEXT_TOKENS:-provider-default}" \
    "local_profile_threads=${SC_LOCAL_THREADS:-provider-default}" \
    "local_qualification_sha256=${SC_LOCAL_QUALIFICATION_SHA256:-none}"
  sc_note "launch · safe · Codex $SC_CODEX_VERSION · log $SC_LOG"
  SC_BWRAP_EXEC=1 sc_bwrap "${argv[@]}" <&0 & SC_CHILD_PID=$!
  SC_CHILD_START="$(sc_process_start "$SC_CHILD_PID" 2>/dev/null || true)"
  sc_family_start_session_binding_watcher
  local rc=0; sc_wait_safe_provider || rc=$?
  sc_family_finalize_session_binding 1
  sc_reconcile_frontend_auth
  (( ! SC_FRONTEND_LOGOUT )) || rc=0
  SC_LOOP_LAST_EXIT=$rc
  if (( rc != 0 )); then
    SC_LOOP_STATUS=failed; sc_loop_write_state
    if [[ -n "$SC_PROVIDER_WAIT_FAILURE" ]]; then
      sc_die "Sandcodex ended the session after losing $SC_PROVIDER_WAIT_FAILURE" "$rc"
    fi
    sc_die "Codex exited with status $rc" "$rc"
  fi
  rc=0; sc_loop_run_turns 1 || rc=$?
  (( rc == 0 )) || sc_die "Codex loop turn exited with status $rc" "$rc"
}

sc_run_bare() {
  SC_OPERATION=bare-metal-run
  sc_ensure_auth
  sc_seed_auth
  sc_resolve_requested_resume
  (( SC_BARE_SUDO_TICKET )) && sc_prime_sudo
  sc_loop_reset_requests
  sc_loop_initialize_state interactive 1 1 0 -1 "$SC_LOOP_DEFAULT_PROMPT"
  (( ! SC_DESKTOP )) || sc_domains
  sc_runtime_begin
  sc_write_browser_stack
  sc_write_desktop_stack
  if (( SC_DESKTOP )); then
    sc_proxy_start || sc_die "could not start the isolated desktop network proxy"
    sc_start_desktop_proxy_bridge || sc_die "could not start the isolated desktop network bridge"
  fi
  sc_start_and_verify_inner_jail
  sc_prepare_campaign_authority
  sc_write_worker_helper
  sc_start_campaign_broker
  sc_write_agent_contract
  sc_write_child_config
  sc_start_browser_broker || sc_die "complete browser initialization failed"
  sc_desktop_boundary_preflight || sc_die "desktop boundary preflight failed closed"
  sc_start_desktop_broker || sc_die "isolated desktop initialization failed"
  sc_start_operator_stack
  local -a argv=(); sc_codex_argv argv
  local -a campaign_env=()
  (( ! SC_CAMPAIGN_AVAILABLE )) || campaign_env=(
    "SANDCODEX_CAMPAIGN=$SC_LOCAL/launcher/sandcodex-campaign"
    "SANDCODEX_WORKER=$SC_AGENT_BIN/sandcodex-worker"
  )
  if (( SC_CAMPAIGN_AVAILABLE )) || [[ -n "$SC_TEAM_MEMBER_NAME" ]]; then
    campaign_env+=("SANDCODEX_TEAM=$SC_AGENT_BIN/sandcodex-team")
  fi
  local -a operator_env=()
  (( ! SC_OPERATOR_ENABLED )) || operator_env=(
    "SANDCODEX_OPERATOR_SOCKET=$SC_OPERATOR_SOCKET"
    "SANDCODEX_OPERATOR_SERVICE=$SC_OPERATOR_HELPER"
    "GLASSTTY_HOME=$SC_GLASSTTY_RUNTIME_HOME"
  )
  sc_log_event info provider_launch "launching Codex without a sandbox" "posture=bare-metal" "resume=$SC_RESUME" \
    "sudo_ticket=$([[ $SC_BARE_SUDO_TICKET == 1 ]] && printf true || printf false)"
  if (( SC_BARE_SUDO_TICKET )); then
    sc_note "launch · BARE METAL · no sandbox · live sudo ticket"
  else
    sc_note "launch · BARE METAL · no sandbox · sudo ticket not primed"
  fi
  sc_exec_clean_fds "$SC_SETPRIV" --pdeathsig TERM env HOME="$SC_CONTROL/frontend-home" CODEX_HOME="$SC_CONTROL/codex-home" \
    TMPDIR="$SC_CONTROL/tmp" XDG_CACHE_HOME="$SC_CONTROL/xdg-cache" \
    XDG_CONFIG_HOME="$SC_CONTROL/xdg-config" XDG_DATA_HOME="$SC_CONTROL/xdg-data" \
    XDG_STATE_HOME="$SC_CONTROL/xdg-state" \
    PATH="$SC_AGENT_BIN:$SC_LOCAL/launcher:$SC_BARE_PATH" \
    SANDCODEX_ACTIVE=1 SANDCODEX_OUTER_PROJECT="$SC_PROJECT" \
      SANDCODEX_RUN_ID="$SC_RUN_ID" SANDCODEX_LOOPER="$SC_LOCAL/launcher/sandcodex" \
      SANDCODEX_BARE_METAL=1 "${campaign_env[@]}" "${operator_env[@]}" "${argv[@]}" <&0 & SC_CHILD_PID=$!
  SC_CHILD_START="$(sc_process_start "$SC_CHILD_PID" 2>/dev/null || true)"
  sc_family_start_session_binding_watcher
  local rc=0; wait "$SC_CHILD_PID" || rc=$?; SC_CHILD_PID=""; SC_CHILD_START=""
  sc_family_finalize_session_binding 1
  sc_reconcile_frontend_auth
  (( ! SC_FRONTEND_LOGOUT )) || rc=0
  SC_LOOP_LAST_EXIT=$rc
  if (( rc != 0 )); then SC_LOOP_STATUS=failed; sc_loop_write_state; sc_die "bare-metal Codex exited with status $rc" "$rc"; fi
  rc=0; sc_loop_run_turns 1 || rc=$?
  (( rc == 0 )) || sc_die "bare-metal Codex loop turn exited with status $rc" "$rc"
}

sc_run_loop() {
  SC_OPERATION=$([[ $SC_BARE == 1 ]] && printf bare-metal-loop || printf safe-loop)
  [[ "$SC_RESUME" != list ]] || sc_die "loop mode does not use the interactive session picker" 64
  sc_loop_normalize_turns
  sc_loop_load_prompt
  sc_loop_validate_provider_args
  sc_safe_args
  sc_ensure_auth
  sc_seed_auth
  sc_resolve_requested_resume
  (( ! SC_BARE || ! SC_BARE_SUDO_TICKET )) || sc_prime_sudo
  sc_loop_reset_requests
  local remaining="$SC_LOOP_TURNS" delegated=0 resume=0 rc=0
  (( remaining != 0 )) || remaining=-1
  (( ! SC_BARE )) || delegated=-1
  [[ "$SC_RESUME" == fresh ]] || resume=1
  sc_loop_initialize_state loop 0 "$SC_LOOP_TURNS" "$remaining" "$delegated" "$SC_LOOP_PROMPT"
  if (( ! SC_BARE )); then
    sc_domains; sc_runtime_begin
    sc_write_browser_stack
    sc_write_desktop_stack
    sc_proxy_start || sc_die "could not start the Sandcodex network proxy"
    sc_start_desktop_proxy_bridge || sc_die "could not start the isolated desktop network bridge"
    sc_start_and_verify_inner_jail
    # Ordinary loops deliberately parse with a zero companion ceiling.  The
    # foreground `remote auto task` and `gemini auto task` lanes retain their
    # one-hop campaign authority so the first-turn sandperson can delegate
    # without switching into an interactive TUI.  Prepare the broker in both
    # cases: every helper below is a no-op at a zero ceiling, while the
    # foreground task receives the same reviewed campaign substrate as an
    # interactive command room.
    sc_prepare_campaign_authority
    sc_write_worker_helper
    sc_start_campaign_broker
    sc_write_agent_contract
    sc_write_child_config
    sc_start_browser_broker || sc_die "complete browser initialization failed"
    sc_browser_boundary_preflight || sc_die "browser boundary preflight failed closed"
    sc_desktop_boundary_preflight || sc_die "desktop boundary preflight failed closed"
    sc_start_desktop_broker || sc_die "isolated desktop initialization failed"
    sc_start_publishers || sc_die "agent TCP publication failed closed"
    sc_boundary_preflight || sc_die "sandbox preflight failed closed"
    sc_ok "boundary verified · project-only writes · trusted state hidden"
  else
    (( ! SC_DESKTOP )) || sc_domains
    sc_runtime_begin
    sc_write_browser_stack
    sc_write_desktop_stack
    if (( SC_DESKTOP )); then
      sc_proxy_start || sc_die "could not start the isolated desktop network proxy"
      sc_start_desktop_proxy_bridge || sc_die "could not start the isolated desktop network bridge"
    fi
    sc_start_and_verify_inner_jail
    sc_prepare_campaign_authority
    sc_write_worker_helper
    sc_start_campaign_broker
    sc_write_agent_contract
    sc_write_child_config
    sc_start_browser_broker || sc_die "complete browser initialization failed"
    sc_desktop_boundary_preflight || sc_die "desktop boundary preflight failed closed"
    sc_start_desktop_broker || sc_die "isolated desktop initialization failed"
  fi
  sc_log_event info loop_start "starting Codex turn loop" \
    "posture=$([[ $SC_BARE == 1 ]] && printf bare-metal || printf safe)" \
    "turn_limit=$SC_LOOP_TURNS" "resume=$SC_RESUME" \
    "sudo_ticket=$([[ $SC_BARE == 1 && $SC_BARE_SUDO_TICKET == 1 ]] && printf true || printf false)"
  local launch_label=safe
  if (( SC_BARE )); then
    if (( SC_BARE_SUDO_TICKET )); then
      launch_label='BARE METAL · no sandbox · live sudo ticket'
    else
      launch_label='BARE METAL · no sandbox · sudo ticket not primed'
    fi
  fi
  sc_note "launch · $launch_label · loop $([[ $SC_LOOP_TURNS == 0 ]] && printf unbounded || printf '%s turns' "$SC_LOOP_TURNS") · log $SC_LOG"
  sc_loop_run_turns "$resume" || rc=$?
  (( rc == 0 )) || sc_die "Codex loop turn exited with status $rc" "$rc"
}

sc_check_add() {
  local -n rows_ref=$1; local -n overall_ref=$2
  local name="$3" status="$4" detail="$5"
  rows_ref+=("$name|$status|$detail")
  # shellcheck disable=SC2034
  [[ "$status" != fail ]] || overall_ref=0
}

sc_path_bytes() {
  local path="$1" output bytes
  [[ -e "$path" || -L "$path" ]] || { printf '0\n'; return; }
  output="$(du -sb -- "$path" 2>/dev/null || true)"
  bytes="${output%%[[:space:]]*}"
  [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
  printf '%s\n' "$bytes"
}

sc_sum_bytes() {
  local total=0 path bytes
  for path in "$@"; do
    bytes="$(sc_path_bytes "$path")"
    total=$(( total + bytes ))
  done
  printf '%s\n' "$total"
}

sc_human_bytes() {
  numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || printf '%sB\n' "$1"
}

sc_doctor_safe_diagnostic() {
  local source=$1 value
  value=$(tail -c 1200 -- "$source" 2>/dev/null | tr '\n\r\t|' '    ' | sed 's/[[:space:]][[:space:]]*/ /g' || true)
  printf '%s\n' "${value:-helper produced no diagnostic}"
}

sc_doctor_provider_readiness() {
  local rows_name=$1 overall_name=$2 nix_version=${3:-missing}
  local root="$SC_RUN_ROOT/provider-readiness"
  local nvidia="$root/nvidia.json" runtime="$root/runtime.json" remote="$root/remote.json"
  local report="$root/report.json" nvidia_err="$root/nvidia.stderr"
  local runtime_err="$root/runtime.stderr" remote_err="$root/remote.stderr" report_err="$root/report.stderr"
  local nvidia_rc=0 runtime_rc=0 remote_rc=0 report_rc=0 helpers_ok=1
  local name status detail

  sc_ensure_dir "$root" "provider readiness diagnostics"

  set +e
  sc_emit_nvidia_helper | python3 -P - --no-ollama >"$nvidia" 2>"$nvidia_err"
  nvidia_rc=$?
  set -e
  case "$nvidia_rc" in
    0|2) ;;
    *)
      sc_check_add "$rows_name" "$overall_name" provider_nvidia_snapshot fail \
        "NVIDIA inventory helper exit $nvidia_rc: $(sc_doctor_safe_diagnostic "$nvidia_err")"
      helpers_ok=0
      ;;
  esac

  set +e
  sc_local_runtime_python status --root "$(sc_local_runtime_root)" >"$runtime" 2>"$runtime_err"
  runtime_rc=$?
  set -e
  if (( runtime_rc != 0 )); then
    sc_check_add "$rows_name" "$overall_name" provider_runtime_registry fail \
      "qualified local runtime registry refused validation: $(sc_doctor_safe_diagnostic "$runtime_err")"
    helpers_ok=0
  fi

  set +e
  sc_emit_remote_config | python3 -P - catalog --catalog "$SC_GLOBAL/remote/providers.json" status \
    >"$remote" 2>"$remote_err"
  remote_rc=$?
  set -e
  if (( remote_rc != 0 )); then
    sc_check_add "$rows_name" "$overall_name" provider_remote_catalog fail \
      "remote provider catalog refused validation: $(sc_doctor_safe_diagnostic "$remote_err")"
    helpers_ok=0
  fi

  (( helpers_ok )) || {
    sc_check_add "$rows_name" "$overall_name" provider_readiness fail \
      "provider readiness synthesis stopped because one or more authoritative snapshots failed"
    return 0
  }

  set +e
  sc_emit_provider_doctor | python3 -P - --nvidia "$nvidia" --runtime "$runtime" --remote "$remote" \
    --nix-version "$nix_version" \
    --cuda-candidate-model "$SC_LOCAL_CUDA_CANDIDATE_MODEL" \
    --cuda-candidate-context "$SC_LOCAL_CUDA_CANDIDATE_CONTEXT" \
    --cuda-candidate-memory-mib "$SC_LOCAL_CUDA_CANDIDATE_MEMORY_MIB" \
    >"$report" 2>"$report_err"
  report_rc=$?
  set -e
  if (( report_rc != 0 && report_rc != 1 )); then
    sc_check_add "$rows_name" "$overall_name" provider_readiness fail \
      "provider readiness helper exit $report_rc: $(sc_doctor_safe_diagnostic "$report_err")"
    return 0
  fi
  if ! jq -e '
      .schema=="sandcodex.provider-doctor.v1" and
      (.result=="pass" or .result=="review" or .result=="fail") and
      (.checks|type)=="array" and (.checks|length)>=8 and (.checks|length)<=32 and
      all(.checks[];
        (.name|type)=="string" and (.name|test("^[a-z][a-z0-9_]{0,63}$")) and
        (.status=="ok" or .status=="warn" or .status=="fail") and
        (.detail|type)=="string" and (.detail|length)>0 and (.detail|length)<=1024) and
      .claims.read_only==true and .claims.provider_started==false and
      .claims.model_loaded==false and .claims.remote_endpoint_contacted==false and
      .claims.credential_values_disclosed==false and .claims.nix_state_modified==false
    ' "$report" >/dev/null; then
    sc_check_add "$rows_name" "$overall_name" provider_readiness fail \
      "provider readiness helper returned invalid metadata"
    return 0
  fi

  while IFS=$'\t' read -r name status detail; do
    sc_check_add "$rows_name" "$overall_name" "$name" "$status" "$detail"
  done < <(jq -r '.checks[] | [.name,.status,.detail] | @tsv' "$report")
}

sc_doctor_gemini_readiness() {
  local rows_name=$1 overall_name=$2
  local root="$SC_RUN_ROOT/provider-readiness" status_file error_file
  local rc=0 reason key_count target routes total qualified
  status_file="$root/gemini.json"
  error_file="$root/gemini.stderr"
  sc_ensure_dir "$root" "provider readiness diagnostics"

  set +e
  sc_gemini_status_json >"$status_file" 2>"$error_file"
  rc=$?
  set -e
  if (( rc != 0 )); then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_state fail \
      "Gemini trusted state refused validation: $(sc_doctor_safe_diagnostic "$error_file")"
    return 0
  fi
  if ! jq -e '
      .schema=="sandcodex.gemini-status.v1" and .provider=="google-ai-studio" and
      (.active|type)=="object" and (.routing|type)=="object" and
      (.routing.free_only==true) and (.routing.qualification.current|type)=="boolean" and
      (.route_availability.total_models|type)=="number" and
      (.route_availability.usable_models|type)=="number" and
      (.route_availability.usable_credentials|type)=="number" and
      .route_availability.rotation_target_accounts==5 and
      (.route_availability.total_routes|type)=="number" and
      (.route_availability.usable_routes|type)=="number" and
      (.route_availability.authentication_standbys|type)=="number" and
      .capabilities.quota_key_rotation==true and
      .credential_value_disclosed==false and
      .cooldowns.credential_values_disclosed==false and
      .cooldowns.raw_provider_content_disclosed==false
    ' "$status_file" >/dev/null; then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_state fail \
      "Gemini status helper returned invalid metadata"
    return 0
  fi

  reason="$(jq -r '.key_reason' "$status_file")"
  key_count="$(jq -r '.key_count' "$status_file")"
  target="$(jq -r '.route_availability.rotation_target_accounts' "$status_file")"
  routes="$(jq -r '.route_availability.usable_models' "$status_file")"
  total="$(jq -r '.route_availability.total_models' "$status_file")"
  qualified="$(jq -r '.routing.qualification.current' "$status_file")"
  if [[ "$(jq -r '.key_available' "$status_file")" == true && "$key_count" -ge "$target" ]]; then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_credentials ok \
      "$key_count/$target account keys configured for automatic quota rotation · credential values not disclosed"
  elif [[ "$(jq -r '.key_available' "$status_file")" == true ]]; then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_credentials warn \
      "$key_count/$target account keys configured; Gemini works now but the intended rotation bank is incomplete"
  elif [[ "$reason" == missing || "$reason" == no-keys ]]; then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_credentials warn \
      "optional free Gemini key bank is not ready ($reason)"
  else
    sc_check_add "$rows_name" "$overall_name" provider_gemini_credentials fail \
      "Gemini credential state is unsafe or malformed ($reason)"
  fi
  if [[ "$qualified" == true ]]; then
    sc_check_add "$rows_name" "$overall_name" provider_gemini_qualification ok \
      "current adapter receipt · free-tier-model-only route · usable models $routes/$total"
  else
    sc_check_add "$rows_name" "$overall_name" provider_gemini_qualification warn \
      "no current live adapter receipt; run: sandcodex gemini qualify --force"
  fi
}

sc_doctor() {
  SC_OPERATION=doctor
  local overall=1 auth="not logged in" rc=0 old_quiet=$SC_QUIET
  local -a rows=()
  local cv bv tv sv nv nodev pythonv wv="" global_bytes project_bytes session_bytes cache_bytes
  cv="$(sc_run_clean_fds "$SC_CODEX" --version 2>/dev/null | awk '{print $NF}' || true)"
  bv="$("$SC_BWRAP" --version 2>/dev/null | awk '{print $NF}' || true)"
  tv="$("$SC_SQUID" -v 2>/dev/null | sed -n 's/^Squid Cache: Version //p' | head -n 1 || true)"
  sv="$("$SC_SOCAT" -V 2>&1 | sed -n 's/^socat version \([^ ]*\).*/\1/p' | head -n 1 || true)"
  nv="$(nix --version 2>/dev/null || true)"
  nodev="$(node --version 2>/dev/null || true)"
  pythonv="$(python3 --version 2>&1 | awk '{print $2}' || true)"
  (( ! SC_BROWSER )) || wv="$("$SC_PLAYWRIGHT" --version 2>/dev/null | awk '{print $NF}' || true)"
  if [[ "$cv" == "$SC_CODEX_VERSION" ]]; then sc_check_add rows overall codex ok "$cv"; else sc_check_add rows overall codex fail "expected $SC_CODEX_VERSION; got ${cv:-missing}"; fi
  if [[ "$bv" == "$SC_BWRAP_VERSION" ]]; then sc_check_add rows overall bubblewrap ok "$bv"; else sc_check_add rows overall bubblewrap fail "expected $SC_BWRAP_VERSION; got ${bv:-missing}"; fi
  if [[ "$tv" == "$SC_SQUID_VERSION" ]]; then sc_check_add rows overall squid ok "$tv"; else sc_check_add rows overall squid fail "expected $SC_SQUID_VERSION; got ${tv:-missing}"; fi
  if [[ "$sv" == "$SC_SOCAT_VERSION" ]]; then sc_check_add rows overall socat ok "$sv"; else sc_check_add rows overall socat fail "expected $SC_SOCAT_VERSION; got ${sv:-missing}"; fi
  if [[ "$nodev" == "v$SC_NODE_VERSION" ]]; then sc_check_add rows overall node ok "$nodev"; else sc_check_add rows overall node fail "expected $SC_NODE_VERSION; got ${nodev:-missing}"; fi
  if [[ "$pythonv" == "$SC_PYTHON_VERSION" ]]; then sc_check_add rows overall python ok "$pythonv"; else sc_check_add rows overall python fail "expected $SC_PYTHON_VERSION; got ${pythonv:-missing}"; fi
  if (( SC_BROWSER )); then
    if [[ "$wv" == "$SC_PLAYWRIGHT_MCP_VERSION" ]]; then sc_check_add rows overall playwright_mcp ok "$wv"; else sc_check_add rows overall playwright_mcp fail "expected $SC_PLAYWRIGHT_MCP_VERSION; got ${wv:-missing}"; fi
  else
    sc_check_add rows overall playwright_mcp warn "disabled with --no-browser"
  fi
  if (( SC_DESKTOP )); then
    sc_check_add rows overall isolated_desktop ok "${SC_DESKTOP_BACKEND} private GUI + guarded 53-tool MCP · ${SC_DESKTOP_WIDTH}x${SC_DESKTOP_HEIGHT}"
  else
    sc_check_add rows overall isolated_desktop warn "disabled with --no-desktop"
  fi
  if [[ -n "$nv" ]]; then sc_check_add rows overall nix ok "$nv"; else sc_check_add rows overall nix fail missing; fi
  if (( SC_NIX_DAEMON_SAFE )); then
    sc_check_add rows overall nix_daemon_boundary ok "$SC_NIX_DAEMON_DETAIL"
  elif [[ "$SC_NIX_DAEMON_MODE" != allow && ( "$SC_NIX_DAEMON_MODE" == deny || "$SC_DEV_NET" == 0 || "${SANDCODEX_NO_NIX:-0}" == 1 ) ]]; then
    sc_check_add rows overall nix_daemon_boundary warn "$SC_NIX_DAEMON_DETAIL"
  else
    sc_check_add rows overall nix_daemon_boundary fail "$SC_NIX_DAEMON_DETAIL"
  fi
  if [[ "$(id -u)" != 0 ]]; then sc_check_add rows overall user ok "uid=$(id -u)"; else sc_check_add rows overall user fail "safe mode refuses root"; fi
  if [[ -n "${SANDCODEX_RESOURCE_SCOPE:-}" ]]; then
    local resource_cgroup resource_pids resource_memory resource_swap
    resource_cgroup="$(sed -n 's/^0:://p' /proc/self/cgroup)"
    resource_pids="$(<"/sys/fs/cgroup$resource_cgroup/pids.max")"
    resource_memory="$(<"/sys/fs/cgroup$resource_cgroup/memory.max")"
    resource_swap="$(<"/sys/fs/cgroup$resource_cgroup/memory.swap.max")"
    sc_check_add rows overall resource_scope ok "memory=$resource_memory tasks=$resource_pids swap=$resource_swap"
  elif (( ! SC_RESOURCE_SCOPE )); then
    sc_check_add rows overall resource_scope warn "disabled by explicit --no-resource-scope"
  else
    sc_check_add rows overall resource_scope warn "disabled by test harness"
  fi
  if [[ -r /proc/sys/user/max_user_namespaces && "$(</proc/sys/user/max_user_namespaces)" -gt 0 ]]; then
    sc_check_add rows overall user_namespaces ok "max=$(</proc/sys/user/max_user_namespaces)"
  else sc_check_add rows overall user_namespaces fail disabled; fi
  sc_check_add rows overall project ok "$SC_PROJECT"
  sc_check_add rows overall global_state ok "$SC_GLOBAL"
  sc_check_add rows overall local_state ok "$SC_LOCAL"
  global_bytes="$(sc_path_bytes "$SC_GLOBAL")"
  project_bytes="$(sc_sum_bytes "$SC_LOCAL" "$SC_CONTROL")"
  session_bytes="$(sc_path_bytes "$SC_CONTROL/codex-home/sessions")"
  cache_bytes="$(sc_sum_bytes "$SC_WORK/cache" "$SC_WORK/tmp" "$SC_WORK/browser-output" "$SC_WORK/desktop-output" \
    "$SC_WORK/inner-jail/caches" \
    "$SC_BROWSER_HOME/cache" "$SC_BROWSER_HOME/runtime" \
    "$SC_DESKTOP_HOME/.cache" "$SC_DESKTOP_HOME/.local/state" \
    "$SC_CONTROL/codex-home/cache" "$SC_CONTROL/codex-home/plugins/cache" \
    "$SC_CONTROL/xdg-cache" "$SC_CONTROL/tmp")"
  sc_check_add rows overall global_usage ok "$(sc_human_bytes "$global_bytes")"
  sc_check_add rows overall project_usage ok "$(sc_human_bytes "$project_bytes")"
  sc_check_add rows overall session_usage ok "$(sc_human_bytes "$session_bytes")"
  sc_check_add rows overall cache_usage ok "$(sc_human_bytes "$cache_bytes") (clean with: sandcodex clean)"
  if sc_local_provider_enabled; then
    sc_check_add rows overall local_provider ok \
      "$SC_LOCAL_PROVIDER · model=$SC_MODEL · expected_digest=${SC_LOCAL_MODEL_DIGEST:-unconstrained} · context=${SC_LOCAL_CONTEXT_TOKENS:-provider-default} · threads=${SC_LOCAL_THREADS:-provider-default} · qualification=${SC_LOCAL_QUALIFICATION_SHA256:-none} · endpoint=$SC_LOCAL_PROVIDER_ENDPOINT · source=$SC_LOCAL_PROVIDER_SOURCE"
    sc_check_add rows overall authentication ok "not required for launcher-owned local inference"
  elif sc_valid_auth "$(sc_auth_path)"; then
    auth="$(sc_global_auth_codex login status 2>&1 || true)"
    sc_check_add rows overall authentication ok "$auth"
  else
    sc_check_add rows overall authentication warn "run sandcodex login"
  fi
  if [[ -n "$SC_SUDO" ]]; then sc_check_add rows overall sudo ok "$SC_SUDO (password sudo supported)"; else sc_check_add rows overall sudo warn "missing; only BARE-METAL needs it"; fi

  (( ! SC_DOCTOR_DEEP || SC_DOCTOR_DESKTOP_ONLY )) || SC_DOMAINS+=(localhost.localdomain)
  sc_domains; sc_runtime_begin
  sc_doctor_provider_readiness rows overall "${nv:-missing}"
  sc_doctor_gemini_readiness rows overall
  sc_write_browser_stack
  sc_write_desktop_stack
  SC_QUIET=1
  set +e; sc_proxy_start >/dev/null 2>&1; rc=$?; set -e
  if (( rc == 0 )); then
    sc_check_add rows overall proxy ok "$([[ $SC_DEV_NET == 1 ]] && printf unrestricted || printf provider-only) bridge started"
  else
    sc_check_add rows overall proxy fail "startup exit $rc"
  fi
  (( rc == 0 )) || overall=0
  if (( rc == 0 && SC_DESKTOP )); then
    set +e; sc_start_desktop_proxy_bridge >/dev/null 2>&1; rc=$?; set -e
    if (( rc == 0 )); then
      sc_check_add rows overall desktop_network ok "private Unix-socket proxy bridge started"
    else
      sc_check_add rows overall desktop_network fail "startup exit $rc"
      overall=0
    fi
  fi
  if (( rc == 0 )); then
    local jail_rc=0
    if (( ! SC_JAIL_AVAILABLE )); then
      sc_check_add rows overall inner_jail warn "unavailable by explicit --no-resource-scope"
    else
      set +e; sc_start_and_verify_inner_jail >/dev/null 2>&1; jail_rc=$?; set -e
      if (( jail_rc == 0 )); then
      sc_check_add rows overall inner_jail ok "launch self-test passed · cgroup + seccomp + recursion + Landlock"
      else
        sc_check_add rows overall inner_jail fail "launch self-test exit $jail_rc"
        overall=0
        rc=$jail_rc
      fi
    fi
  fi
  sc_write_agent_contract
  sc_write_child_config
  if (( rc == 0 && SC_BROWSER )); then
    set +e; sc_start_browser_broker >/dev/null 2>&1; rc=$?; set -e
    if (( rc == 0 )); then sc_check_add rows overall browser_broker ok "one persistent Playwright owner started"; else sc_check_add rows overall browser_broker fail "startup exit $rc"; fi
  fi
  if (( rc == 0 && SC_BROWSER )); then
    set +e; sc_browser_boundary_preflight >/dev/null 2>&1; rc=$?; set -e
    if (( rc == 0 )); then sc_check_add rows overall browser_boundary ok "credentials hidden; project read-only"; else sc_check_add rows overall browser_boundary fail "preflight exit $rc"; fi
  fi
  if (( rc == 0 && SC_DESKTOP )); then
    set +e
    if (( SC_VERBOSE )); then
      sc_desktop_boundary_preflight
    else
      sc_desktop_boundary_preflight >/dev/null 2>&1
    fi
    rc=$?
    set -e
    if (( rc == 0 )); then
      sc_check_add rows overall desktop_boundary ok "host desktop and credentials absent; project writable"
    else
      sc_check_add rows overall desktop_boundary fail "preflight exit $rc"
    fi
  fi
  if (( rc == 0 && SC_DESKTOP )); then
    set +e; sc_start_desktop_broker >/dev/null 2>&1; rc=$?; set -e
    if (( rc == 0 )); then
      sc_check_add rows overall desktop_broker ok \
        "persistent isolated $([[ $SC_HEADFUL == 1 ]] && printf xephyr-headful || printf '%s' "$SC_DESKTOP_DISPLAY_BACKEND") workstation started"
    else
      sc_check_add rows overall desktop_broker fail "startup exit $rc"
    fi
  fi
  set +e; sc_boundary_preflight >/dev/null 2>&1; rc=$?; set -e; SC_QUIET=$old_quiet
  if (( rc == 0 )); then sc_check_add rows overall boundary ok "mount, namespace, and apply_patch preflight passed"; else sc_check_add rows overall boundary fail "preflight exit $rc"; fi

  if (( SC_DOCTOR_DEEP && ! SC_DOCTOR_DESKTOP_ONLY && rc == 0 )); then
    local allowed=0 blocked=0 private=0 direct=0 allowed_output="" blocked_output="" private_output="" direct_output="" proxy_env=""
    local allowed_url=https://api.openai.com/v1/models allowed_label=api.openai.com
    if sc_local_provider_enabled; then
      allowed_url=http://127.0.0.1:11434/api/version
      allowed_label="$SC_LOCAL_PROVIDER namespace relay"
    fi
    # Expand these variables only after entering the clean sandbox environment.
    # shellcheck disable=SC2016
    proxy_env="$(sc_bwrap sh -c 'printf "HTTP_PROXY=%s\nHTTPS_PROXY=%s\nALL_PROXY=%s\nNO_PROXY=%s\nSSL_CERT_FILE=%s\n" "${HTTP_PROXY:-}" "${HTTPS_PROXY:-}" "${ALL_PROXY:-}" "${NO_PROXY:-}" "${SSL_CERT_FILE:-}"' 2>&1 || true)"
    allowed_output="$(sc_bwrap curl -sS --max-time 15 -o /dev/null -w '%{http_code}' "$allowed_url" 2>&1)" || allowed=$?
    blocked_output="$(sc_bwrap curl -fsS --max-time 10 -o /dev/null -w '%{http_code}' https://example.com/ 2>&1)" || blocked=$?
    private_output="$(sc_bwrap curl -kfsS --max-time 10 https://localhost.localdomain/ 2>&1)" || private=$?
    direct_output="$(sc_bwrap timeout 4 bash -c 'exec 3<>/dev/tcp/1.1.1.1/443' 2>&1)" || direct=$?
    sc_log_event debug network_probe "deep network probes completed" "allowed_exit=$allowed" "blocked_exit=$blocked" "private_exit=$private" "direct_exit=$direct" "proxy_env=${proxy_env:0:1200}" "allowed_diagnostic=${allowed_output:0:800}" "blocked_diagnostic=${blocked_output:0:800}" "private_diagnostic=${private_output:0:800}" "direct_diagnostic=${direct_output:0:800}"
    if sc_local_provider_enabled && (( allowed == 0 )) && [[ "$allowed_output" =~ ^2[0-9][0-9]$ ]]; then
      sc_check_add rows overall provider_network ok "$allowed_label reached (HTTP $allowed_output)"
    elif ! sc_local_provider_enabled && (( allowed == 0 )) && [[ "$allowed_output" =~ ^[1-5][0-9][0-9]$ ]]; then
      sc_check_add rows overall provider_network ok \
        "$allowed_label route and verified TLS answered (HTTP $allowed_output; authorization and model readiness not tested)"
    else
      sc_check_add rows overall provider_network fail "$allowed_label exit $allowed HTTP ${allowed_output//$'\n'/ }"
    fi
    if (( SC_DEV_NET )); then
      if (( blocked == 0 )); then sc_check_add rows overall unrestricted_network ok "example.com reached"; else sc_check_add rows overall unrestricted_network fail "exit $blocked: ${blocked_output//$'\n'/ }"; fi
      sc_check_add rows overall private_egress warn "open mode permits LAN/loopback proxy targets; no listening doctor target was created"
    else
      if (( blocked != 0 )); then sc_check_add rows overall network_deny ok "example.com blocked"; else sc_check_add rows overall network_deny fail "unlisted host reachable"; fi
      if (( private != 0 )); then sc_check_add rows overall private_egress_deny ok "allowlisted loopback resolution blocked"; else sc_check_add rows overall private_egress_deny fail "allowlisted name reached a private address"; fi
    fi
    if (( direct != 0 )); then sc_check_add rows overall direct_egress_deny ok "direct TCP blocked"; else sc_check_add rows overall direct_egress_deny fail "direct TCP reachable"; fi
  fi

  if (( SC_DOCTOR_DEEP && SC_BROWSER )); then
    local browser_rc=0
    set +e; sc_browser_deep_preflight; browser_rc=$?; set -e
    if (( browser_rc == 0 )); then
      sc_check_add rows overall browser_behavior ok "HTTPS, Google login, loopback, downloads, CDP extensions, native messaging"
    else
      sc_check_add rows overall browser_behavior fail "behavioral preflight exit $browser_rc"
    fi
  fi

  if (( SC_DOCTOR_DEEP && SC_DESKTOP )); then
    local desktop_rc=0
    set +e; sc_desktop_behavior_preflight; desktop_rc=$?; set -e
    if (( desktop_rc == 0 )); then
      if [[ "$SC_DESKTOP_DISPLAY_BACKEND" == wayland ]]; then
        sc_check_add rows overall desktop_behavior ok "launch, windows, focus, post-hover pointer latch, focus-bound keyboard fence, and PNG screenshot · proof: $SC_DESKTOP_BEHAVIOR_SCREENSHOT"
      else
        sc_check_add rows overall desktop_behavior ok "launch, windows, focus, direct compatibility typing, and PNG screenshot · proof: $SC_DESKTOP_BEHAVIOR_SCREENSHOT"
      fi
    else
      sc_check_add rows overall desktop_behavior fail "behavioral preflight exit $desktop_rc"
      overall=0
    fi
  fi

  if (( SC_DOCTOR_JSON )); then
    local json='[]' row name status detail
    for row in "${rows[@]}"; do
      IFS='|' read -r name status detail <<<"$row"
      json="$(jq -cn --argjson old "$json" --arg name "$name" --arg status "$status" --arg detail "$detail" '$old + [{name:$name,status:$status,detail:$detail}]')"
    done
    jq -cn --arg schema sandcodex.doctor.v1 --arg version "$SC_VERSION" --arg project "$SC_PROJECT" \
      --arg global_root "$SC_GLOBAL" --arg log "$SC_LOG" --argjson checks "$json" \
      --argjson ok "$([[ $overall == 1 ]] && printf true || printf false)" \
      '{schema:$schema,ok:$ok,version:$version,project:$project,global_root:$global_root,log:$log,checks:$checks}'
  else
    printf '\n%ssandcodex doctor%s\n' "$(sc_colour '1;36')" "$(sc_reset)"
    local row name status detail glyph colour ok_count=0 warn_count=0 fail_count=0
    for row in "${rows[@]}"; do
      IFS='|' read -r name status detail <<<"$row"
      case "$status" in
        ok) glyph=✓; colour=32; (( ok_count += 1 )) ;;
        warn) glyph='!'; colour=33; (( warn_count += 1 )) ;;
        *) glyph=✗; colour=31; (( fail_count += 1 )) ;;
      esac
      printf '  %s%s%s %-20s %s\n' "$(sc_colour "$colour")" "$glyph" "$(sc_reset)" "$name" "$detail"
    done
    printf '\n  result   %s · %s passed · %s warnings · %s failed\n' \
      "$([[ $overall == 1 ]] && printf READY || printf 'NOT READY')" \
      "$ok_count" "$warn_count" "$fail_count"
    printf '  evidence %s\n' "$SC_LOG"
    if (( ! overall )); then
      printf '  next     fix the failed checks, then rerun: sandcodex doctor%s\n' \
        "$([[ $SC_DOCTOR_DEEP == 1 ]] && printf ' --deep' || true)"
    fi
  fi
  (( overall ))
}

sc_confirm_delete() {
  (( ! SC_YES )) || return 0
  [[ -r /dev/tty && -w /dev/tty ]] || \
    sc_die "cleanup confirmation needs a terminal; use -y only after reviewing the selected scopes"
  printf 'About to delete %s.\nType DELETE to continue: ' "$1" >/dev/tty
  local answer; IFS= read -r answer </dev/tty
  [[ "$answer" == DELETE ]] || sc_die "cleanup cancelled; no selected state was removed" 130
}

sc_set_browser_profile_path() {
  SC_BROWSER_PROFILE="$SC_GLOBAL/browser/profiles/${SC_PROJECT_KEY:0:32}"
}

sc_validate_browser_profile_cleanup() {
  local marker="$SC_BROWSER_PROFILE.owner" singleton socket_target=""
  if [[ ! -e "$SC_BROWSER_PROFILE" && ! -L "$SC_BROWSER_PROFILE" && \
    ! -e "$marker" && ! -L "$marker" ]]; then
    return 0
  fi
  sc_no_symlink_components "$marker" "browser profile marker"
  sc_owned_single_file "$marker" 600 "browser profile marker"
  grep -Fx "project=$SC_PROJECT" "$marker" >/dev/null || sc_die "browser profile marker belongs to another project"
  grep -Fx "uid=$(id -u)" "$marker" >/dev/null || sc_die "browser profile marker belongs to another user"
  sc_assert_no_mounts_at_or_below "$marker" 1 "browser profile marker"
  if [[ -e "$SC_BROWSER_PROFILE" || -L "$SC_BROWSER_PROFILE" ]]; then
    sc_no_symlink_components "$SC_BROWSER_PROFILE" "persistent browser profile"
    sc_owned_dir "$SC_BROWSER_PROFILE" "persistent browser profile"
    singleton="$SC_BROWSER_PROFILE/SingletonSocket"
    if [[ -L "$singleton" ]]; then socket_target="$(readlink -- "$singleton" 2>/dev/null || true)"; fi
    if [[ -S "$singleton" || ( "$socket_target" == /* && -S "$socket_target" ) ]]; then
      sc_die "the persistent browser profile is still in use"
    fi
    if sc_browser_profile_process_alive "$SC_BROWSER_PROFILE"; then
      sc_die "a matching browser process is still using the persistent profile"
    fi
    sc_assert_no_mounts_at_or_below "$SC_BROWSER_PROFILE" 1 "persistent browser profile"
  fi
}

sc_remove_browser_profile() {
  local marker="$SC_BROWSER_PROFILE.owner"
  [[ ! -e "$SC_BROWSER_PROFILE" && ! -L "$SC_BROWSER_PROFILE" ]] || rm -rf -- "$SC_BROWSER_PROFILE"
  [[ ! -e "$marker" && ! -L "$marker" ]] || rm -f -- "$marker"
}

sc_validate_project_auxiliary_cleanup() {
  local supervisors="$SC_GLOBAL/supervisors/$SC_PROJECT_KEY"
  local transactions="$SC_GLOBAL/state-transactions/$SC_PROJECT_KEY"
  local publish_locator="$SC_GLOBAL/publish-active/$SC_PROJECT_KEY.json"
  local root record marker spec unit publish_pid publish_start
  for root in "$supervisors" "$transactions"; do
    [[ -e "$root" || -L "$root" ]] || continue
    sc_no_symlink_components "$root" "trusted project lifecycle state"
    sc_owned_dir "$root" "trusted project lifecycle state"
    [[ "$(stat -c %a -- "$root")" == 700 ]] || \
      sc_die "trusted project lifecycle state permissions are not 0700: $root"
    sc_assert_no_mounts_at_or_below "$root" 1 "trusted project lifecycle state"
  done
  if [[ -e "$publish_locator" || -L "$publish_locator" ]]; then
    sc_owned_single_file "$publish_locator" 600 "active publication locator"
    jq -e --arg project "$SC_PROJECT" --arg key "$SC_PROJECT_KEY" '
      .schema == "sandcodex.publish-active.v1" and .project == $project and
      .project_key == $key and (.launcher.pid | type == "number") and
      (.launcher.start_ticks | type == "string" and test("^[0-9]+$"))
    ' "$publish_locator" >/dev/null || sc_die "active publication locator is invalid"
    publish_pid="$(jq -r '.launcher.pid' "$publish_locator")"
    publish_start="$(jq -r '.launcher.start_ticks' "$publish_locator")"
    if sc_pid_still_matches "$publish_pid" "$publish_start"; then
      sc_die "publication is still active for this project"
    fi
  fi
  [[ -d "$supervisors" && ! -L "$supervisors" ]] || return 0
  while IFS= read -r -d '' record; do
    sc_owned_dir "$record" "loop supervisor record"
    [[ "$(stat -c %a -- "$record")" == 700 ]] || \
      sc_die "loop supervisor record permissions are not 0700: $record"
    marker="$record/OWNER"; spec="$record/spec.json"
    sc_owned_single_file "$marker" 600 "loop supervisor marker"
    sc_owned_single_file "$spec" 600 "loop supervisor specification"
    grep -Fx 'schema=sandcodex.supervisor.v1' "$marker" >/dev/null || \
      sc_die "loop supervisor marker schema is invalid: $record"
    grep -Fx "project=$SC_PROJECT" "$marker" >/dev/null || \
      sc_die "loop supervisor marker belongs to another project: $record"
    grep -Fx "uid=$(id -u)" "$marker" >/dev/null || \
      sc_die "loop supervisor marker belongs to another uid: $record"
    jq -e --arg project "$SC_PROJECT" \
      '.schema == "sandcodex.supervisor.v1" and .project == $project and
       (.unit | type == "string") and (.recover_on_boot | type == "boolean")' \
      "$spec" >/dev/null || sc_die "loop supervisor specification is invalid: $record"
    unit="$(jq -r '.unit' "$spec")"
    [[ "$unit" =~ ^sandcodex-loop-${SC_PROJECT_KEY:0:16}-[A-Za-z0-9][A-Za-z0-9-]*\.service$ ]] || \
      sc_die "loop supervisor unit name is invalid: $unit"
    if jq -e '.recover_on_boot == true' "$spec" >/dev/null; then
      sc_owned_single_file "$record/$unit" 600 "persistent loop unit"
    fi
  done < <(find -P "$supervisors" -mindepth 1 -maxdepth 1 -print0)
}

sc_remove_project_auxiliary_state() {
  local supervisors="$SC_GLOBAL/supervisors/$SC_PROJECT_KEY"
  local transactions="$SC_GLOBAL/state-transactions/$SC_PROJECT_KEY"
  local publish_locator="$SC_GLOBAL/publish-active/$SC_PROJECT_KEY.json"
  local record spec unit
  if [[ -d "$supervisors" && ! -L "$supervisors" ]]; then
    while IFS= read -r -d '' record; do
      spec="$record/spec.json"; unit="$(jq -r '.unit' "$spec")"
      if [[ -n "$SC_SYSTEMCTL" && -x "$SC_SYSTEMCTL" ]]; then
        "$SC_SYSTEMCTL" --user stop "$unit" >/dev/null 2>&1 || true
        if jq -e '.recover_on_boot == true' "$spec" >/dev/null; then
          "$SC_SYSTEMCTL" --user disable "$unit" >/dev/null || \
            sc_die "could not disable persistent loop unit: $unit"
        fi
      elif jq -e '.recover_on_boot == true' "$spec" >/dev/null; then
        sc_die "removing persistent loop state requires systemctl --user"
      fi
    done < <(find -P "$supervisors" -mindepth 1 -maxdepth 1 -type d -print0)
    rm -rf -- "$supervisors"
    rmdir -- "$SC_GLOBAL/supervisors" 2>/dev/null || true
  fi
  if [[ -d "$transactions" && ! -L "$transactions" ]]; then
    rm -rf -- "$transactions"
    rmdir -- "$SC_GLOBAL/state-transactions" 2>/dev/null || true
  fi
  [[ ! -e "$publish_locator" && ! -L "$publish_locator" ]] || unlink -- "$publish_locator"
}

