def _runtime(args: argparse.Namespace) -> int:
    _harden_process()
    if not APP_ID_RE.fullmatch(args.application_id):
        raise RuntimeError("invalid application identity")
    if not LAUNCH_ID_RE.fullmatch(args.launch_id):
        raise RuntimeError("invalid launch identity")
    instance_token = _read_secret_token(Path(args.instance_token_file), "instance token")
    surface_token = _read_secret_token(Path(args.surface_token_file), "surface token")
    window_app_id = _surface_app_id(surface_token)
    surface_token = ""

    import gi  # Imported only at runtime; --self-test remains dependency-free.

    gi.require_version("Gio", "2.0")
    gi.require_version("GLib", "2.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Pango", "1.0")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango

    GLib.set_prgname(window_app_id)
    GLib.set_application_name(WINDOW_TITLE)
    with _suppress(Exception):
        Gdk.set_program_class(window_app_id)
    initialized, _remaining = Gtk.init_check([])
    if not initialized:
        raise RuntimeError("private status notifier could not connect to launch Wayland")
    settings = Gtk.Settings.get_default()
    if settings is not None:
        with _suppress(Exception):
            settings.set_property("gtk-enable-animations", False)

    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    if connection is None:
        raise RuntimeError("private session bus is unavailable")
    connection.set_exit_on_close(True)
    main_loop = GLib.MainLoop()
    items: dict[tuple[str, str], RuntimeItem] = {}
    registrations: list[int] = []
    shutting_down = False
    window: Any = None
    flow: Any = None
    count_label: Any = None

    def dbus_call(
        destination: str,
        object_path: str,
        interface: str,
        method: str,
        parameters: Any,
        reply_signature: str | None,
        *,
        maximum: int = MAX_CALL_BYTES,
    ) -> Any:
        result = connection.call_sync(
            destination,
            object_path,
            interface,
            method,
            parameters,
            None if reply_signature is None else GLib.VariantType.new(reply_signature),
            Gio.DBusCallFlags.NO_AUTO_START,
            DBUS_TIMEOUT_MILLISECONDS,
            None,
        )
        if result is not None and result.get_size() > maximum:
            raise StatusNotifierError("private-bus reply exceeds its byte limit")
        return result

    def request_name(name: str) -> None:
        reply = dbus_call(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "RequestName",
            GLib.Variant("(su)", (name, 4)),
            "(u)",
        )
        result = reply.unpack()[0]
        if result not in {1, 4}:
            raise RuntimeError(f"private status notifier bus name is already owned: {name}")

    def owner_of(name: str) -> str:
        reply = dbus_call(
            "org.freedesktop.DBus",
            "/org/freedesktop/DBus",
            "org.freedesktop.DBus",
            "GetNameOwner",
            GLib.Variant("(s)", (name,)),
            "(s)",
        )
        return _canonical_unique_name(reply.unpack()[0], "resolved owner")

    def watcher_emit(member: str, values: tuple[Any, ...] = ()) -> None:
        signature = "(s)" if values else "()"
        for interface in WATCHER_INTERFACES:
            with _suppress(Exception):
                connection.emit_signal(
                    None,
                    WATCHER_OBJECT_PATH,
                    interface,
                    member,
                    GLib.Variant(signature, values),
                )

    def properties_changed() -> None:
        values = sorted(item.address.public_registration for item in items.values())
        for interface in WATCHER_INTERFACES:
            with _suppress(Exception):
                connection.emit_signal(
                    None,
                    WATCHER_OBJECT_PATH,
                    DBUS_PROPERTIES_INTERFACE,
                    "PropertiesChanged",
                    GLib.Variant(
                        "(sa{sv}as)",
                        (
                            interface,
                            {
                                "RegisteredStatusNotifierItems": GLib.Variant("as", values),
                                "IsStatusNotifierHostRegistered": GLib.Variant("b", True),
                            },
                            [],
                        ),
                    ),
                )

    def refresh_window() -> None:
        nonlocal window, flow, count_label
        if window is None:
            window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
            window.set_title(WINDOW_TITLE)
            window.set_default_size(420, -1)
            window.set_resizable(False)
            window.set_decorated(False)
            window.set_accept_focus(False)
            window.set_keep_above(True)
            window.set_skip_taskbar_hint(True)
            window.set_skip_pager_hint(True)
            window.set_focus_on_map(False)
            window.set_type_hint(Gdk.WindowTypeHint.DOCK)
            window.set_border_width(8)
            window.connect("delete-event", lambda *_unused: True)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title = Gtk.Label(label="Status items")
            title.set_xalign(0.0)
            title.get_style_context().add_class("title")
            count_label = Gtk.Label(label="0")
            count_label.set_xalign(1.0)
            header.pack_start(title, True, True, 0)
            header.pack_end(count_label, False, False, 0)
            outer.pack_start(header, False, False, 0)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
            scroller.set_min_content_width(400)
            scroller.set_max_content_height(MAX_WINDOW_CONTENT_HEIGHT)
            flow = Gtk.FlowBox()
            flow.set_selection_mode(Gtk.SelectionMode.NONE)
            flow.set_row_spacing(6)
            flow.set_column_spacing(6)
            flow.set_max_children_per_line(6)
            flow.set_min_children_per_line(1)
            scroller.add(flow)
            outer.pack_start(scroller, True, True, 0)
            window.add(outer)
        if count_label is not None:
            count_label.set_text(str(len(items)))
        if items:
            window.show_all()
        else:
            window.hide()

    def screen_coordinates(event: Any) -> tuple[int, int]:
        x = getattr(event, "x_root", 0.0)
        y = getattr(event, "y_root", 0.0)
        try:
            return (max(-(2**31), min(2**31 - 1, int(x))), max(-(2**31), min(2**31 - 1, int(y))))
        except (TypeError, ValueError, OverflowError):
            return (0, 0)

    def call_item(item: RuntimeItem, method: str, parameters: Any) -> bool:
        try:
            if owner_of(item.address.service) != item.address.sender:
                remove_item(item.address.key)
                return False
            dbus_call(
                item.address.sender,
                item.address.object_path,
                item.interface,
                method,
                parameters,
                None,
            )
            return True
        except Exception:
            return False

    def menu_event(item: RuntimeItem, menu_id: int, timestamp: int) -> None:
        if item.spec.menu_path is None:
            return
        timestamp = max(0, min(0xFFFFFFFF, timestamp))
        with _suppress(Exception):
            if owner_of(item.address.service) != item.address.sender:
                remove_item(item.address.key)
                return
            dbus_call(
                item.address.sender,
                item.spec.menu_path,
                DBUSMENU_INTERFACE,
                "Event",
                GLib.Variant(
                    "(isvu)",
                    (menu_id, "clicked", GLib.Variant("i", 0), timestamp),
                ),
                None,
                maximum=MAX_MENU_CALL_BYTES,
            )

    def load_menu(item: RuntimeItem) -> MenuNode | None:
        path = item.spec.menu_path
        if path is None:
            return None
        if owner_of(item.address.service) != item.address.sender:
            remove_item(item.address.key)
            return None
        with _suppress(Exception):
            dbus_call(
                item.address.sender,
                path,
                DBUSMENU_INTERFACE,
                "AboutToShow",
                GLib.Variant("(i)", (0,)),
                "(b)",
                maximum=MAX_MENU_CALL_BYTES,
            )
        reply = dbus_call(
            item.address.sender,
            path,
            DBUSMENU_INTERFACE,
            "GetLayout",
            GLib.Variant(
                "(iias)",
                (
                    0,
                    MAX_MENU_DEPTH,
                    [
                        "label",
                        "enabled",
                        "visible",
                        "type",
                        "toggle-type",
                        "toggle-state",
                        "children-display",
                        "disposition",
                    ],
                ),
            ),
            "(u(ia{sv}av))",
            maximum=MAX_MENU_CALL_BYTES,
        )
        _revision, root = _parse_menu_layout(reply.unpack())
        return root

    def gtk_menu_for(item: RuntimeItem, root: MenuNode, timestamp: int) -> Any:
        menu = Gtk.Menu()

        def append(parent: Any, node: MenuNode) -> None:
            if not node.visible:
                return
            if node.kind == "separator":
                parent.append(Gtk.SeparatorMenuItem())
                return
            if node.toggle_type:
                widget = Gtk.CheckMenuItem.new_with_label(node.label or "Unnamed action")
                widget.set_active(node.toggle_state == 1)
                widget.set_draw_as_radio(node.toggle_type == "radio")
            else:
                widget = Gtk.MenuItem.new_with_label(node.label or "Unnamed action")
            widget.set_sensitive(node.enabled)
            widget.set_can_focus(False)
            with _suppress(Exception):
                widget.get_accessible().set_name(
                    f"Status menu action {node.label or 'unnamed'} from {args.application_id}"
                )
            if node.children:
                submenu = Gtk.Menu()
                for child in node.children:
                    append(submenu, child)
                widget.set_submenu(submenu)
            else:
                widget.connect(
                    "activate",
                    lambda _widget, identifier=node.identifier: menu_event(
                        item, identifier, timestamp
                    ),
                )
            parent.append(widget)

        for child in root.children:
            append(menu, child)
        return menu

    def show_menu(item: RuntimeItem, event: Any) -> bool:
        timestamp = int(getattr(event, "time", 0) or int(time.monotonic() * 1000)) & 0xFFFFFFFF
        try:
            root = load_menu(item)
        except Exception:
            root = None
        if root is not None and root.children:
            menu = gtk_menu_for(item, root, timestamp)
            menu.show_all()
            with _suppress(Exception):
                menu.popup_at_pointer(event)
                return True
        x, y = screen_coordinates(event)
        return call_item(item, "ContextMenu", GLib.Variant("(ii)", (x, y)))

    def on_button(_widget: Any, event: Any, item: RuntimeItem) -> bool:
        button = int(getattr(event, "button", 0) or 0)
        x, y = screen_coordinates(event)
        if button == 1:
            if item.spec.item_is_menu:
                return show_menu(item, event)
            return call_item(item, "Activate", GLib.Variant("(ii)", (x, y)))
        if button == 2:
            return call_item(item, "SecondaryActivate", GLib.Variant("(ii)", (x, y)))
        if button == 3:
            return show_menu(item, event)
        return False

    def on_scroll(_widget: Any, event: Any, item: RuntimeItem) -> bool:
        direction = getattr(event, "direction", None)
        delta = 0
        orientation = "vertical"
        if direction == Gdk.ScrollDirection.UP:
            delta = 1
        elif direction == Gdk.ScrollDirection.DOWN:
            delta = -1
        elif direction == Gdk.ScrollDirection.LEFT:
            delta = -1
            orientation = "horizontal"
        elif direction == Gdk.ScrollDirection.RIGHT:
            delta = 1
            orientation = "horizontal"
        elif direction == Gdk.ScrollDirection.SMOOTH:
            dx = float(getattr(event, "delta_x", 0.0) or 0.0)
            dy = float(getattr(event, "delta_y", 0.0) or 0.0)
            if abs(dx) > abs(dy):
                orientation = "horizontal"
                delta = -1 if dx > 0 else 1
            elif dy:
                delta = -1 if dy > 0 else 1
        if not delta or orientation not in ALLOWED_ORIENTATIONS:
            return False
        return call_item(item, "Scroll", GLib.Variant("(is)", (delta, orientation)))

    def pixbuf_for(icon: IconPixmap) -> Any:
        data = GLib.Bytes.new(icon.rgba)
        pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(
            data,
            GdkPixbuf.Colorspace.RGB,
            True,
            8,
            icon.width,
            icon.height,
            icon.width * 4,
        )
        if icon.width != 32 or icon.height != 32:
            pixbuf = pixbuf.scale_simple(32, 32, GdkPixbuf.InterpType.BILINEAR)
        return pixbuf

    def render_item(item: RuntimeItem) -> None:
        if flow is None:
            refresh_window()
        if item.button is not None:
            with _suppress(Exception):
                child = item.button.get_parent()
                flow.remove(child if child is not None else item.button)
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_focus_on_click(False)
        button.set_can_focus(False)
        button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.SCROLL_MASK)
        button.connect("button-press-event", on_button, item)
        button.connect("scroll-event", on_scroll, item)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        if item.spec.icon is not None:
            with _suppress(Exception):
                box.pack_start(Gtk.Image.new_from_pixbuf(pixbuf_for(item.spec.icon)), False, False, 0)
        label = Gtk.Label(label=item.spec.visible_title)
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(18)
        box.pack_start(label, False, False, 0)
        button.add(box)
        tooltip = item.spec.tooltip_text or item.spec.tooltip_title
        if tooltip:
            button.set_tooltip_text(tooltip)
        with _suppress(Exception):
            button.get_accessible().set_name(
                f"Status item from {args.application_id}: {item.spec.visible_title}; "
                f"status {item.spec.status}; left activate, middle secondary activate, "
                "right menu, scroll adjust"
            )
        if item.spec.status == "NeedsAttention":
            button.get_style_context().add_class("suggested-action")
        elif item.spec.status == "Passive":
            button.set_opacity(0.65)
        item.button = button
        flow.add(button)
        button.show_all()
        refresh_window()

    def fetch_properties(item: RuntimeItem) -> tuple[str, StatusItemSpec]:
        last_error: Exception | None = None
        for interface in ITEM_INTERFACES:
            try:
                reply = dbus_call(
                    item.address.sender,
                    item.address.object_path,
                    DBUS_PROPERTIES_INTERFACE,
                    "GetAll",
                    GLib.Variant("(s)", (interface,)),
                    "(a{sv})",
                )
                return interface, _parse_item_properties(reply.unpack()[0])
            except Exception as error:
                last_error = error
        raise StatusNotifierError("registered status item does not expose a supported interface") from last_error

    def refresh_item(key: tuple[str, str]) -> bool:
        item = items.get(key)
        if item is None:
            return False
        item.refresh_source = 0
        try:
            interface, spec = fetch_properties(item)
            item.interface = interface
            item.spec = spec
            item.refresh_failures = 0
            render_item(item)
        except Exception:
            item.refresh_failures += 1
            if item.refresh_failures <= 3:
                item.refresh_source = GLib.timeout_add(120, refresh_item, key)
            else:
                remove_item(key)
        return False

    def schedule_refresh(item: RuntimeItem) -> None:
        if item.refresh_source:
            return
        item.refresh_source = GLib.idle_add(refresh_item, item.address.key)

    def on_item_signal(
        _connection: Any,
        sender_name: str,
        object_path: str,
        interface_name: str,
        signal_name: str,
        _parameters: Any,
    ) -> None:
        key = (sender_name, object_path)
        item = items.get(key)
        if item is None:
            return
        if interface_name == DBUS_PROPERTIES_INTERFACE or signal_name in ITEM_SIGNAL_NAMES:
            schedule_refresh(item)

    def subscribe_item(item: RuntimeItem) -> None:
        for interface in (*ITEM_INTERFACES, DBUS_PROPERTIES_INTERFACE):
            subscription = connection.signal_subscribe(
                item.address.sender,
                interface,
                None,
                item.address.object_path,
                None,
                Gio.DBusSignalFlags.NONE,
                on_item_signal,
            )
            if subscription:
                item.subscriptions.append(subscription)

    def add_item(address: ItemAddress) -> None:
        if address.key in items:
            return
        if len(items) >= MAX_ITEMS:
            raise StatusNotifierError("the launch status item limit has been reached")
        item = RuntimeItem(address=address)
        items[address.key] = item
        subscribe_item(item)
        # Registration is visible immediately, as required by the watcher
        # contract, but no graphical placeholder is rendered until the item
        # proves one supported interface and a bounded property set.
        schedule_refresh(item)
        watcher_emit("StatusNotifierItemRegistered", (address.public_registration,))
        properties_changed()

    def remove_item(key: tuple[str, str]) -> None:
        item = items.pop(key, None)
        if item is None:
            return
        if item.refresh_source:
            with _suppress(Exception):
                GLib.source_remove(item.refresh_source)
            item.refresh_source = 0
        for subscription in item.subscriptions:
            with _suppress(Exception):
                connection.signal_unsubscribe(subscription)
        if item.button is not None and flow is not None:
            with _suppress(Exception):
                child = item.button.get_parent()
                flow.remove(child if child is not None else item.button)
        watcher_emit("StatusNotifierItemUnregistered", (item.address.public_registration,))
        properties_changed()
        refresh_window()

    def watcher_method(
        _connection: Any,
        sender: str,
        _object_path: str,
        _interface_name: str,
        method_name: str,
        parameters: Any,
        invocation: Any,
    ) -> None:
        try:
            if parameters.get_size() > MAX_REGISTRATION_BYTES:
                raise StatusNotifierError("status notifier registration exceeds its byte limit")
            unpacked = parameters.unpack()
            if len(unpacked) != 1:
                raise StatusNotifierError("status notifier registration is malformed")
            if method_name == "RegisterStatusNotifierItem":
                add_item(_registration_address(sender, unpacked[0], owner_of))
                invocation.return_value(None)
                return
            if method_name == "RegisterStatusNotifierHost":
                # Validate same-sender custody but retain no app-selected host
                # authority; this helper's own launch-private host remains the
                # only graphical representation.
                _registration_address(sender, unpacked[0], owner_of)
                watcher_emit("StatusNotifierHostRegistered")
                invocation.return_value(None)
                return
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod",
                "unknown status notifier watcher method",
            )
        except StatusNotifierError as error:
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.InvalidArgs",
                str(error),
            )
        except Exception:
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.Failed",
                "launch-private status notifier request failed",
            )

    def watcher_property(
        _connection: Any,
        _sender: str,
        _object_path: str,
        _interface_name: str,
        property_name: str,
    ) -> Any:
        if property_name == "RegisteredStatusNotifierItems":
            return GLib.Variant(
                "as",
                sorted(item.address.public_registration for item in items.values()),
            )
        if property_name == "IsStatusNotifierHostRegistered":
            return GLib.Variant("b", True)
        if property_name == "ProtocolVersion":
            return GLib.Variant("i", PROTOCOL_VERSION)
        return None

    for bus_name in WATCHER_BUS_NAMES:
        request_name(bus_name)
    host_suffix = secrets.token_hex(8)
    host_names = tuple(prefix + host_suffix for prefix in HOST_BUS_PREFIXES)
    for host_name in host_names:
        request_name(host_name)
    for interface in WATCHER_INTERFACES:
        node = Gio.DBusNodeInfo.new_for_xml(_watcher_xml(interface))
        registration = connection.register_object(
            WATCHER_OBJECT_PATH,
            node.interfaces[0],
            watcher_method,
            watcher_property,
            None,
        )
        if not registration:
            raise RuntimeError(f"could not register private status watcher interface {interface}")
        registrations.append(registration)

    # The helper is the launch-private StatusNotifierHost. Announce its already-
    # owned compatibility names only after both watcher objects exist, so items
    # can treat the signal and IsStatusNotifierHostRegistered as one atomic
    # readiness transition.
    watcher_emit("StatusNotifierHostRegistered")

    def owner_changed(
        _connection: Any,
        _sender_name: str,
        _object_path: str,
        _interface_name: str,
        _signal_name: str,
        parameters: Any,
    ) -> None:
        name, old_owner, new_owner = parameters.unpack()
        if not all(isinstance(value, str) for value in (name, old_owner, new_owner)):
            return
        if UNIQUE_BUS_NAME_RE.fullmatch(name) is not None:
            if old_owner != name or new_owner:
                return
            for key in [candidate for candidate in items if candidate[0] == name]:
                remove_item(key)
            return
        if WELL_KNOWN_BUS_NAME_RE.fullmatch(name) is None or not old_owner:
            return
        # A registration through a well-known service is valid only while that
        # exact service remains owned by the birth-observed unique sender.  Do
        # not let a still-running client retain stale UI after releasing its
        # advertised service, and never transfer an item to a replacement
        # owner that acquires the same name later.
        for key, item in list(items.items()):
            if item.address.service == name and item.address.sender == old_owner:
                remove_item(key)

    owner_subscription = connection.signal_subscribe(
        "org.freedesktop.DBus",
        "org.freedesktop.DBus",
        "NameOwnerChanged",
        "/org/freedesktop/DBus",
        None,
        Gio.DBusSignalFlags.NONE,
        owner_changed,
    )
    if not owner_subscription:
        raise RuntimeError("could not subscribe to private-bus owner lifecycle")

    def quit_main(*_unused: Any) -> bool:
        nonlocal shutting_down
        if shutting_down:
            return False
        shutting_down = True
        for key in list(items):
            remove_item(key)
        if window is not None:
            with _suppress(Exception):
                window.destroy()
        main_loop.quit()
        return False

    connection.connect("closed", lambda *_unused: quit_main())
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signum, quit_main)
    _write_ready(
        Path(args.ready_file),
        args.launch_id,
        args.application_id,
        instance_token,
        window_app_id,
    )
    try:
        main_loop.run()
    finally:
        with _suppress(Exception):
            connection.signal_unsubscribe(owner_subscription)
        for registration in registrations:
            with _suppress(Exception):
                connection.unregister_object(registration)
    return 0


class _suppress:
    def __init__(self, *exceptions: type[BaseException]) -> None:
        self.exceptions = exceptions or (Exception,)

    def __enter__(self) -> None:
        return None

    def __exit__(self, kind: Any, _value: Any, _traceback: Any) -> bool:
        return kind is not None and issubclass(kind, self.exceptions)


def _arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--ready-file")
    parser.add_argument("--application-id")
    parser.add_argument("--launch-id")
    parser.add_argument("--instance-token-file")
    parser.add_argument("--surface-token-file")
    parsed = parser.parse_args(argv)
    if parsed.self_test or parsed.version:
        return parsed
    for name in (
        "ready_file",
        "application_id",
        "launch_id",
        "instance_token_file",
        "surface_token_file",
    ):
        if getattr(parsed, name) is None:
            parser.error(f"--{name.replace('_', '-')} is required")
    return parsed


def main(argv: list[str]) -> int:
    args = _arguments(argv)
    if args.version:
        print(PROTOCOL)
        return 0
    if args.self_test:
        return _self_test()
    return _runtime(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (OSError, RuntimeError, StatusNotifierError) as error:
        print(f"sandcodex private status notifier: {error}", file=sys.stderr)
        raise SystemExit(70) from None
SANDCODEX_PRIVATE_STATUS_NOTIFIER_SERVICE
}

sc_emit_private_file_portal() {
  cat <<'SANDCODEX_PRIVATE_FILE_PORTAL'
#!/usr/bin/env python3
"""Launch-local XDG desktop portal for Sandcodex application capsules.

This is intentionally *not* a general xdg-desktop-portal replacement.  It owns
``org.freedesktop.portal.Desktop`` only on one launch-private session bus and
implements deliberately small standard FileChooser, OpenURI, and Request
interfaces. Every chooser dialog and exact URI/file handler is a client in the
same launch capsule and compositor security context as the requesting app.
Chooser paths are revalidated against capsule-visible roots. OpenURI appends
one validated URI to one launch-authorized argv prefix. OpenFile transfers one
regular file through a caller-supplied Unix descriptor. Writable requests
retain the exact O_RDWR open file description; read-only requests become
immutable, size-bounded, mode-0600 non-executable sealed memfd snapshots before
the child receives its ``/proc/self/fd/N`` reference. Only one
launch-authorized argv prefix is used. OpenDirectory takes custody of one
caller-supplied regular-file or directory descriptor, independently opens and
pins its capsule-visible containing directory, and passes both exact kernel
objects to one launch-authorized handler while appending only the pinned
directory reference to argv. This enables a private "show in folder" workflow
without a host file manager, host session bus, or pathname-only handoff.
Neither path uses a shell or ambient desktop application chooser.

There is no host session bus, host document portal, FUSE grant, persistent
permission store, host file chooser, host URI/file dispatcher, or host desktop
authority in this design.
"""
from __future__ import annotations

import argparse
import base64
import binascii
import ctypes
import errno
import fcntl
import hashlib
import hmac
import json
import os
import re
import resource
import secrets
import signal
import stat
import subprocess
import sys
import tempfile
import urllib.parse
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterable


PROTOCOL = "sandcodex.private-file-portal.v4"
