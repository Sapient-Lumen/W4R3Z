};

static volatile sig_atomic_t stop_requested = 0;

static void on_signal(int signo) {
    (void)signo;
    stop_requested = 1;
}

static int inspect_pipe_endpoint(int descriptor, int expected_access, struct stat *metadata) {
    const int status_flags = fcntl(descriptor, F_GETFL);
    if (status_flags < 0 || (status_flags & O_ACCMODE) != expected_access ||
            (status_flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, metadata) < 0 || !S_ISFIFO(metadata->st_mode) ||
            metadata->st_uid != geteuid() || metadata->st_nlink != 1U) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static bool same_pipe_endpoint(const struct stat *left, const struct stat *right) {
    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
}

static int harden_process(void) {
    const pid_t parent = getppid();
    struct stat input = {0};
    struct stat output = {0};
    struct stat diagnostic = {0};
    const struct rlimit no_core = {
        .rlim_cur = 0,
        .rlim_max = 0,
    };
    if (parent <= 1) {
        errno = ESRCH;
        return -1;
    }
    if (inspect_pipe_endpoint(STDIN_FILENO, O_RDONLY, &input) < 0 ||
            inspect_pipe_endpoint(STDOUT_FILENO, O_WRONLY, &output) < 0 ||
            inspect_pipe_endpoint(STDERR_FILENO, O_WRONLY, &diagnostic) < 0 ||
            same_pipe_endpoint(&input, &output) ||
            same_pipe_endpoint(&input, &diagnostic) ||
            same_pipe_endpoint(&output, &diagnostic) ||
            setrlimit(RLIMIT_CORE, &no_core) < 0) {
        errno = EPROTO;
        return -1;
    }
    /*
     * The command pipe is already close-on-exec, but parent-death signalling
     * closes the remaining scheduling window if the Python controller is
     * killed while this helper is blocked in Wayland or stdio.  The parent
     * identity check is required because PR_SET_PDEATHSIG is not retroactive.
     */
    if (prctl(PR_SET_PDEATHSIG, SIGTERM) < 0) {
        return -1;
    }
    if (getppid() != parent) {
        errno = ESRCH;
        return -1;
    }
    if (prctl(PR_SET_NO_NEW_PRIVS, 1L, 0L, 0L, 0L) < 0 ||
            prctl(PR_SET_DUMPABLE, 0L, 0L, 0L, 0L) < 0) {
        return -1;
    }
    (void)umask(S_IRWXG | S_IRWXO);
    return 0;
}

static uint32_t monotonic_milliseconds(void) {
    struct timespec value = {0};
    if (clock_gettime(CLOCK_MONOTONIC, &value) < 0) {
        return 0U;
    }
    const uint64_t milliseconds =
        (uint64_t)value.tv_sec * UINT64_C(1000) + (uint64_t)value.tv_nsec / UINT64_C(1000000);
    return (uint32_t)(milliseconds & UINT32_MAX);
}

static void key_settle(void) {
    const struct timespec delay = {
        .tv_sec = 0,
        .tv_nsec = KEY_SETTLE_NANOSECONDS,
    };
    struct timespec remainder = {0};
    if (nanosleep(&delay, &remainder) < 0 && errno == EINTR) {
        (void)nanosleep(&remainder, NULL);
    }
}

static bool parse_u64(const char *text, uint64_t minimum, uint64_t maximum, uint64_t *output) {
    if (text == NULL || *text == '\0' || *text == '-' || *text == '+') {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' || value < minimum || value > maximum) {
        return false;
    }
    *output = (uint64_t)value;
    return true;
}

static bool parse_hex_u32(const char *text, uint32_t *output) {
    if (text == NULL || *text == '\0' || strlen(text) > 8U) {
        return false;
    }
    for (const char *cursor = text; *cursor != '\0'; cursor++) {
        if (!isxdigit((unsigned char)*cursor)) {
            return false;
        }
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 16);
    if (errno != 0 || end == text || *end != '\0' || value > UINT32_MAX) {
        return false;
    }
    *output = (uint32_t)value;
    return true;
}

static bool valid_codepoint(uint32_t codepoint) {
    return codepoint > 0U && codepoint <= UINT32_C(0x10ffff) &&
        !(codepoint >= UINT32_C(0xd800) && codepoint <= UINT32_C(0xdfff));
}

static bool valid_modifiers(uint32_t modifiers) {
    return (modifiers & ~ALLOWED_MODIFIERS) == 0U;
}

static bool valid_key_name(const char *name) {
    if (name == NULL) {
        return false;
    }
    const size_t length = strlen(name);
    if (length == 0U || length > MAX_KEY_NAME_BYTES) {
        return false;
    }
    for (size_t index = 0U; index < length; index++) {
        const unsigned char value = (unsigned char)name[index];
        if (!((value >= (unsigned char)'0' && value <= (unsigned char)'9') ||
                (value >= (unsigned char)'A' && value <= (unsigned char)'Z') ||
                (value >= (unsigned char)'a' && value <= (unsigned char)'z') ||
                value == (unsigned char)'_')) {
            return false;
        }
    }
    return true;
}

static bool allowed_named_keysym(const char *name) {
    static const char *const allowed[] = {
        "Return", "Tab", "Escape", "BackSpace", "Delete", "Insert",
        "Home", "End", "Page_Up", "Page_Down", "Up", "Down", "Left",
        "Right", "space", "Print", "Menu",
    };
    if (name == NULL) {
        return false;
    }
    for (size_t index = 0U; index < sizeof(allowed) / sizeof(allowed[0]); index++) {
        if (strcmp(name, allowed[index]) == 0) {
            return true;
        }
    }
    if (name[0] == 'F') {
        uint64_t number = 0U;
        return parse_u64(name + 1, 1U, 24U, &number);
    }
    return false;
}

static size_t tokenize(char *line, char **tokens) {
    size_t count = 0U;
    char *save = NULL;
    for (char *token = strtok_r(line, " \t\r\n", &save);
         token != NULL;
         token = strtok_r(NULL, " \t\r\n", &save)) {
        if (count == MAX_TOKENS) {
            return MAX_TOKENS + 1U;
        }
        tokens[count++] = token;
    }
    return count;
}

static bool parse_command(char *line, uint64_t expected_sequence, struct command *command) {
    char *tokens[MAX_TOKENS] = {0};
    const size_t count = tokenize(line, tokens);
    uint64_t sequence = 0U;
    if (count < 2U || count > MAX_TOKENS ||
            !parse_u64(tokens[0], 1U, UINT64_MAX, &sequence) || sequence != expected_sequence) {
        return false;
    }
    command->sequence = sequence;

    if (strcmp(tokens[1], "PREPU") == 0) {
        if (count != 3U || !parse_hex_u32(tokens[2], &command->codepoint) ||
                !valid_codepoint(command->codepoint)) {
            return false;
        }
        command->kind = COMMAND_PREPARE_UNICODE;
        return true;
    }
    if (strcmp(tokens[1], "PREPK") == 0) {
        if (count != 3U || !valid_key_name(tokens[2])) {
            return false;
        }
        (void)snprintf(command->key_name, sizeof(command->key_name), "%s", tokens[2]);
        command->kind = COMMAND_PREPARE_KEYSYM;
        return true;
    }
    if (strcmp(tokens[1], "SEAL") == 0 && count == 2U) {
        command->kind = COMMAND_SEAL;
        return true;
    }
    if (strcmp(tokens[1], "PLANU") == 0) {
        uint64_t modifiers = 0U;
        if (count != 4U || !parse_u64(tokens[2], 0U, UINT32_MAX, &modifiers) ||
                !valid_modifiers((uint32_t)modifiers) ||
                !parse_hex_u32(tokens[3], &command->codepoint) ||
                !valid_codepoint(command->codepoint)) {
            return false;
        }
        command->modifiers = (uint32_t)modifiers;
        command->kind = COMMAND_PLAN_UNICODE;
        return true;
    }
    if (strcmp(tokens[1], "PLANK") == 0) {
        uint64_t modifiers = 0U;
        if (count != 4U || !parse_u64(tokens[2], 0U, UINT32_MAX, &modifiers) ||
                !valid_modifiers((uint32_t)modifiers) || !valid_key_name(tokens[3])) {
            return false;
        }
        command->modifiers = (uint32_t)modifiers;
        (void)snprintf(command->key_name, sizeof(command->key_name), "%s", tokens[3]);
        command->kind = COMMAND_PLAN_KEYSYM;
        return true;
    }
    if (strcmp(tokens[1], "PLANM") == 0) {
        uint64_t modifiers = 0U;
        if (count != 3U || !parse_u64(tokens[2], 1U, UINT32_MAX, &modifiers) ||
                !valid_modifiers((uint32_t)modifiers)) {
            return false;
        }
        command->modifiers = (uint32_t)modifiers;
        command->kind = COMMAND_PLAN_MODIFIERS;
        return true;
    }
    if (strcmp(tokens[1], "TYPE") == 0) {
        if (count != 3U || !parse_hex_u32(tokens[2], &command->codepoint) ||
                !valid_codepoint(command->codepoint)) {
            return false;
        }
        command->kind = COMMAND_TYPE;
        return true;
    }
    if (strcmp(tokens[1], "CHORDU") == 0) {
        uint64_t modifiers = 0U;
        if (count != 4U || !parse_u64(tokens[2], 0U, UINT32_MAX, &modifiers) ||
                !valid_modifiers((uint32_t)modifiers) ||
                !parse_hex_u32(tokens[3], &command->codepoint) ||
                !valid_codepoint(command->codepoint)) {
            return false;
        }
        command->modifiers = (uint32_t)modifiers;
        command->kind = COMMAND_CHORD_UNICODE;
        return true;
    }
    if (strcmp(tokens[1], "CHORDK") == 0) {
        uint64_t modifiers = 0U;
        if (count != 4U || !parse_u64(tokens[2], 0U, UINT32_MAX, &modifiers) ||
                !valid_modifiers((uint32_t)modifiers) || !valid_key_name(tokens[3])) {
            return false;
        }
        command->modifiers = (uint32_t)modifiers;
        (void)snprintf(command->key_name, sizeof(command->key_name), "%s", tokens[3]);
        command->kind = COMMAND_CHORD_KEYSYM;
        return true;
    }
    if (strcmp(tokens[1], "PING") == 0 && count == 2U) {
        command->kind = COMMAND_PING;
        return true;
    }
    if (strcmp(tokens[1], "QUIT") == 0 && count == 2U) {
        command->kind = COMMAND_QUIT;
        return true;
    }
    return false;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct wayland_state *state = data;
    if (strcmp(interface, zwp_virtual_keyboard_manager_v1_interface.name) == 0) {
        state->manager_count++;
        if (version < 1U || state->manager != NULL) {
            state->topology_valid = false;
            return;
        }
        state->manager_name = name;
        state->manager = wl_registry_bind(registry, name,
            &zwp_virtual_keyboard_manager_v1_interface, 1U);
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        if (version < 1U || state->seat != NULL) {
            state->topology_valid = false;
            return;
        }
        state->seat_name = name;
        state->seat = wl_registry_bind(registry, name, &wl_seat_interface, 1U);
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    struct wayland_state *state = data;
    (void)registry;
    if (name == state->manager_name || name == state->seat_name) {
        state->topology_valid = false;
    }
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

static int display_roundtrip(struct wayland_state *state) {
    if (state->display == NULL || wl_display_roundtrip(state->display) < 0) {
        return -1;
    }
    if (!state->topology_valid) {
        errno = ENODEV;
        return -1;
    }
    return 0;
}

static xkb_keysym_t keysym_for_codepoint(uint32_t codepoint) {
    switch (codepoint) {
    case UINT32_C(0x08):
        return XKB_KEY_BackSpace;
    case UINT32_C(0x0a):
    case UINT32_C(0x0d):
        return XKB_KEY_Return;
    case UINT32_C(0x09):
        return XKB_KEY_Tab;
    case UINT32_C(0x1b):
        return XKB_KEY_Escape;
    case UINT32_C(0x7f):
        return XKB_KEY_Delete;
    default:
        return xkb_utf32_to_keysym(codepoint);
    }
}

static int print_keysym(FILE *stream, xkb_keysym_t keysym) {
    char name[128] = {0};
    const int length = xkb_keysym_get_name(keysym, name, sizeof(name));
    if (length <= 0 || (size_t)length >= sizeof(name) || !valid_key_name(name)) {
        errno = EINVAL;
        return -1;
    }
    return fprintf(stream, "%s", name) < 0 ? -1 : 0;
}

static int modifier_mask(struct xkb_keymap *keymap, const char *name, uint32_t *output) {
    /*
     * A modifier index is not necessarily the real-modifier encoding expected
     * on the wire. libxkbcommon 1.10+ exposes the compiled mapping directly;
     * reject an absent or unmapped modifier rather than deriving one as
     * 1 << xkb_keymap_mod_get_index().
     */
    const xkb_mod_mask_t mask = xkb_keymap_mod_get_mask(keymap, name);
    if (mask == 0U) {
        errno = EPROTO;
        return -1;
    }
    *output = (uint32_t)mask;
    return 0;
}

static int read_modifier_mapping(struct xkb_keymap *keymap,
        uint32_t *shift, uint32_t *control, uint32_t *alt,
        uint32_t *logo, uint32_t *altgr) {
    if (modifier_mask(keymap, "Shift", shift) < 0 ||
            modifier_mask(keymap, "Control", control) < 0 ||
            modifier_mask(keymap, "Mod1", alt) < 0 ||
            modifier_mask(keymap, "Mod4", logo) < 0 ||
            modifier_mask(keymap, "Mod5", altgr) < 0) {
        return -1;
    }
    const uint32_t values[] = {*shift, *control, *alt, *logo, *altgr};
    uint32_t seen = 0U;
    for (size_t index = 0U; index < sizeof(values) / sizeof(values[0]); index++) {
        if (values[index] == 0U || (seen & values[index]) != 0U) {
            errno = EPROTO;
            return -1;
        }
        seen |= values[index];
    }
    return 0;
}

static int serialize_modifiers(const struct wayland_state *state,
        uint32_t semantic, uint32_t *serialized) {
    if (!state->modifier_mapping_valid || !valid_modifiers(semantic)) {
        errno = EPROTO;
        return -1;
    }
    uint32_t result = 0U;
    if ((semantic & MOD_SHIFT) != 0U) {
        result |= state->serialized_shift;
    }
    if ((semantic & MOD_CTRL) != 0U) {
        result |= state->serialized_control;
    }
    if ((semantic & MOD_ALT) != 0U) {
        result |= state->serialized_alt;
    }
    if ((semantic & MOD_LOGO) != 0U) {
        result |= state->serialized_logo;
    }
    if ((semantic & MOD_ALTGR) != 0U) {
        result |= state->serialized_altgr;
    }
    *serialized = result;
    return 0;
}

static int upload_keymap(struct wayland_state *state) {
    if (state->keyboard == NULL || state->keymap_count == 0U ||
            state->keymap_count > MAX_KEYMAP_ENTRIES || state->held_key != 0U ||
            state->held_modifiers != 0U || state->preparation_locked ||
            state->keymap_generation >= MAX_KEYMAP_GENERATIONS) {
        errno = EPROTO;
        return -1;
    }
    const int descriptor = memfd_create("sandcodex-wayland-keymap",
        MFD_CLOEXEC | MFD_ALLOW_SEALING);
    if (descriptor < 0) {
        return -1;
    }
    if (fchmod(descriptor, S_IRUSR | S_IWUSR) < 0) {
        const int saved_errno = errno;
        (void)close(descriptor);
        errno = saved_errno;
        return -1;
    }
    FILE *stream = fdopen(descriptor, "w+");
    if (stream == NULL) {
        const int saved_errno = errno;
        (void)close(descriptor);
        errno = saved_errno;
        return -1;
    }

    int result = 0;
    if (fprintf(stream,
            "xkb_keymap {\n"
            "xkb_keycodes \"(unnamed)\" { minimum = 8; maximum = %zu;\n",
            state->keymap_count + 8U) < 0) {
        result = -1;
    }
    for (size_t index = 0U; result == 0 && index < state->keymap_count; index++) {
        if (fprintf(stream, "<K%zu> = %zu;\n", index + 1U, index + 9U) < 0) {
            result = -1;
        }
    }
    if (result == 0 && fprintf(stream,
            "};\n"
            "xkb_types \"(unnamed)\" { include \"complete\" };\n"
            "xkb_compatibility \"(unnamed)\" { include \"complete\" };\n"
            "xkb_symbols \"(unnamed)\" {\n") < 0) {
        result = -1;
    }
    for (size_t index = 0U; result == 0 && index < state->keymap_count; index++) {
        if (fprintf(stream, "key <K%zu> { [ ", index + 1U) < 0 ||
                print_keysym(stream, state->keymap[index]) < 0 ||
                fprintf(stream, " ] };\n") < 0) {
            result = -1;
        }
    }
    if (result == 0 && (fprintf(stream, "};\n};\n") < 0 || fflush(stream) == EOF)) {
        result = -1;
    }
    long size = result == 0 ? ftell(stream) : -1L;
    if (result == 0 && (size <= 0L || (uintmax_t)size >= MAX_KEYMAP_BYTES)) {
        errno = EOVERFLOW;
        result = -1;
    }
    uint32_t serialized_shift = 0U;
    uint32_t serialized_control = 0U;
    uint32_t serialized_alt = 0U;
    uint32_t serialized_logo = 0U;
    uint32_t serialized_altgr = 0U;
    if (result == 0) {
        rewind(stream);
        struct xkb_keymap *validated = xkb_keymap_new_from_file(state->xkb_context, stream,
            XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS);
        if (validated == NULL) {
            errno = EINVAL;
            result = -1;
        } else {
            if (read_modifier_mapping(validated, &serialized_shift, &serialized_control,
                    &serialized_alt, &serialized_logo, &serialized_altgr) < 0) {
                result = -1;
            }
            xkb_keymap_unref(validated);
        }
    }
    if (result == 0 && (fseek(stream, 0L, SEEK_END) != 0 || fputc('\0', stream) == EOF ||
            fflush(stream) == EOF)) {
        result = -1;
    }
    size = result == 0 ? ftell(stream) : -1L;
    if (result == 0 && (size <= 0L || (uintmax_t)size > MAX_KEYMAP_BYTES ||
            (uintmax_t)size > UINT32_MAX)) {
        errno = EOVERFLOW;
        result = -1;
    }
    const int required_seals = F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL;
    if (result == 0 && fcntl(fileno(stream), F_ADD_SEALS, required_seals) < 0) {
        result = -1;
    }
    if (result == 0) {
        const int actual_seals = fcntl(fileno(stream), F_GET_SEALS);
        if (actual_seals < 0 || (actual_seals & required_seals) != required_seals) {
            errno = EPROTO;
            result = -1;
        }
    }
    if (result == 0) {
        zwp_virtual_keyboard_v1_keymap(state->keyboard, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1,
            fileno(stream), (uint32_t)size);
        result = display_roundtrip(state);
    }
    if (result == 0) {
        state->serialized_shift = serialized_shift;
        state->serialized_control = serialized_control;
        state->serialized_alt = serialized_alt;
        state->serialized_logo = serialized_logo;
        state->serialized_altgr = serialized_altgr;
        state->modifier_mapping_valid = true;
        state->keymap_dirty = false;
        state->keymap_sealed = true;
        state->keymap_generation++;
    }
    int saved_errno = errno;
    if (fclose(stream) == EOF && result == 0) {
        saved_errno = errno;
        result = -1;
    }
    errno = saved_errno;
    return result;
}

static int stage_keysym(struct wayland_state *state, xkb_keysym_t keysym) {
    if (keysym == XKB_KEY_NoSymbol) {
        errno = EINVAL;
        return -1;
    }
    if (state->preparation_locked) {
        errno = EPERM;
        return -1;
    }
    if (state->held_key != 0U || state->held_modifiers != 0U) {
        errno = EBUSY;
        return -1;
    }
    for (size_t index = 0U; index < state->keymap_count; index++) {
        if (state->keymap[index] == keysym) {
            errno = EEXIST;
            return -1;
        }
    }
    if (state->keymap_count >= MAX_KEYMAP_ENTRIES) {
        errno = ENOSPC;
        return -1;
    }
    state->keymap[state->keymap_count] = keysym;
    state->keymap_count++;
    state->keymap_dirty = true;
    state->keymap_sealed = false;
    return 0;
}

static int lookup_keysym(const struct wayland_state *state, xkb_keysym_t keysym,
        uint32_t *key_code) {
    if (keysym == XKB_KEY_NoSymbol || state->keymap_dirty || !state->keymap_sealed ||
            !state->preparation_locked) {
        errno = EPROTO;
        return -1;
    }
    for (size_t index = 0U; index < state->keymap_count; index++) {
        if (state->keymap[index] == keysym) {
            *key_code = (uint32_t)(index + 1U);
            return 0;
        }
    }
    errno = ENOENT;
    return -1;
}

static int release_keyboard_state(struct wayland_state *state, bool force_modifier_clear) {
    if (state->keyboard == NULL) {
        errno = EPROTO;
        return state->held_key == 0U && state->held_modifiers == 0U ? 0 : -1;
    }
    bool emitted = false;
    if (state->held_key != 0U) {
        zwp_virtual_keyboard_v1_key(state->keyboard, monotonic_milliseconds(),
            state->held_key, WL_KEYBOARD_KEY_STATE_RELEASED);
        emitted = true;
    }
    if (state->held_modifiers != 0U || force_modifier_clear) {
        zwp_virtual_keyboard_v1_modifiers(state->keyboard, 0U, 0U, 0U, 0U);
        emitted = true;
    }
    if (emitted && display_roundtrip(state) < 0) {
        return -1;
    }
    state->held_key = 0U;
    state->held_modifiers = 0U;
    return 0;
}

static int destroy_virtual_keyboard(struct wayland_state *state) {
    if (state->keyboard == NULL) {
        errno = EPROTO;
        return -1;
    }
    zwp_virtual_keyboard_v1_destroy(state->keyboard);
    state->keyboard = NULL;
    /* The sync reply proves Sway consumed the destroy request before BYE,
     * making the input::removed event and baseline seat inventory mandatory
     * parts of one guarded keyboard transaction. */
    return display_roundtrip(state);
}

static void destroy_wayland(struct wayland_state *state) {
    if (state->keyboard != NULL) {
        zwp_virtual_keyboard_v1_destroy(state->keyboard);
        state->keyboard = NULL;
    }
    if (state->manager != NULL) {
        zwp_virtual_keyboard_manager_v1_destroy(state->manager);
        state->manager = NULL;
    }
    if (state->seat != NULL) {
        wl_seat_destroy(state->seat);
        state->seat = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
    if (state->xkb_context != NULL) {
        xkb_context_unref(state->xkb_context);
        state->xkb_context = NULL;
    }
}

static int initialize_wayland(struct wayland_state *state) {
    state->topology_valid = true;
    state->xkb_context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
    if (state->xkb_context == NULL) {
        errno = ENOMEM;
        return -1;
    }
    xkb_context_set_log_level(state->xkb_context, XKB_LOG_LEVEL_CRITICAL);
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            display_roundtrip(state) < 0 || state->manager == NULL || state->seat == NULL ||
            state->manager_count != 1U || state->seat_count != 1U ||
            state->manager_name == 0U || state->seat_name == 0U || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    state->keyboard = zwp_virtual_keyboard_manager_v1_create_virtual_keyboard(
        state->manager, state->seat);
    if (state->keyboard == NULL) {
        errno = EPROTO;
        return -1;
    }
    state->keymap[0] = XKB_KEY_space;
    state->keymap_count = 1U;
    state->keymap_dirty = true;
    state->keymap_sealed = false;
    return upload_keymap(state);
}

static int dispatch_key(struct wayland_state *state, uint32_t key_code,
        uint32_t modifiers, const char **reason) {
    if (state->held_key != 0U || state->held_modifiers != 0U) {
        *reason = "held-state-conflict";
        errno = EBUSY;
        return -1;
    }
    uint32_t serialized = 0U;
    if (serialize_modifiers(state, modifiers, &serialized) < 0) {
        *reason = "modifier-map-unavailable";
        return -1;
    }
    if (modifiers != 0U) {
        state->held_modifiers = modifiers;
        zwp_virtual_keyboard_v1_modifiers(state->keyboard, serialized, 0U, 0U, 0U);
        if (display_roundtrip(state) < 0) {
            goto dispatch_failed;
        }
    }

    state->held_key = key_code;
    zwp_virtual_keyboard_v1_key(state->keyboard, monotonic_milliseconds(), key_code,
        WL_KEYBOARD_KEY_STATE_PRESSED);
    if (display_roundtrip(state) < 0) {
        goto dispatch_failed;
    }
    key_settle();

    zwp_virtual_keyboard_v1_key(state->keyboard, monotonic_milliseconds(), key_code,
        WL_KEYBOARD_KEY_STATE_RELEASED);
    if (display_roundtrip(state) < 0) {
        goto dispatch_failed;
    }
    state->held_key = 0U;
    key_settle();

    if (state->held_modifiers != 0U) {
        zwp_virtual_keyboard_v1_modifiers(state->keyboard, 0U, 0U, 0U, 0U);
        if (display_roundtrip(state) < 0) {
            goto dispatch_failed;
        }
        state->held_modifiers = 0U;
    }
    return 0;

dispatch_failed:
    if (release_keyboard_state(state, true) == 0) {
        *reason = "wayland-dispatch-failed-release-confirmed";
    } else {
        *reason = "wayland-dispatch-failed-release-ambiguous";
    }
    return -1;
}

static int dispatch_command(struct wayland_state *state, const struct command *command,
        const char **reason) {
    state->plan_valid = false;
    state->planned_key = 0U;
    state->planned_modifiers = 0U;
    if (command->kind == COMMAND_PING) {
        if (display_roundtrip(state) < 0) {
            *reason = "wayland-ping-failed";
            return -1;
        }
        return 0;
    }

    if (command->kind == COMMAND_PREPARE_UNICODE ||
            command->kind == COMMAND_PREPARE_KEYSYM) {
        xkb_keysym_t prepared = XKB_KEY_NoSymbol;
        if (command->kind == COMMAND_PREPARE_UNICODE) {
            prepared = keysym_for_codepoint(command->codepoint);
        } else {
            if (!allowed_named_keysym(command->key_name)) {
                *reason = "named-keysym-denied";
                errno = EPERM;
                return -1;
            }
            prepared = xkb_keysym_from_name(command->key_name, XKB_KEYSYM_CASE_INSENSITIVE);
        }
        if (stage_keysym(state, prepared) < 0) {
            if (errno == ENOSPC) {
                *reason = "keymap-capacity-exceeded";
            } else if (errno == EPERM) {
                *reason = "keymap-preparation-locked";
            } else if (errno == EEXIST) {
                *reason = "keysym-already-staged";
            } else {
                *reason = "keymap-stage-failed";
            }
            return -1;
        }
        return 0;
    }
    if (command->kind == COMMAND_SEAL) {
        if (state->preparation_locked) {
            *reason = "keymap-preparation-locked";
            errno = EPERM;
            return -1;
        }
        if (state->held_key != 0U || state->held_modifiers != 0U) {
            *reason = "keymap-seal-held-state";
            errno = EBUSY;
            return -1;
        }
        if (state->keymap_dirty) {
            if (upload_keymap(state) < 0) {
                *reason = "keymap-seal-failed";
                return -1;
            }
        } else if (display_roundtrip(state) < 0) {
            *reason = "keymap-seal-roundtrip-failed";
            return -1;
        }
        state->preparation_locked = true;
        return 0;
    }
    if (command->kind == COMMAND_PLAN_MODIFIERS) {
        uint32_t serialized = 0U;
        if (!state->preparation_locked || state->keymap_dirty ||
                !state->keymap_sealed || state->held_key != 0U ||
                state->held_modifiers != 0U || command->modifiers == 0U ||
                serialize_modifiers(state, command->modifiers, &serialized) < 0 ||
                serialized == 0U) {
            *reason = "modifier-plan-state-invalid";
            return -1;
        }
        /* PLANM serializes the reviewed abstract modifier names through the
         * exact sealed helper keymap. It performs a display roundtrip but emits
         * no key or modifier request; Sway owns the later logical arc. */
        if (display_roundtrip(state) < 0) {
            *reason = "modifier-plan-roundtrip-failed";
            return -1;
        }
        state->planned_key = 0U;
        state->planned_modifiers = serialized;
        state->plan_valid = true;
        return 0;
    }

    xkb_keysym_t keysym = XKB_KEY_NoSymbol;
    uint32_t modifiers = 0U;
    bool planning = false;
    if (command->kind == COMMAND_PLAN_UNICODE) {
        keysym = keysym_for_codepoint(command->codepoint);
        modifiers = command->modifiers;
        planning = true;
    } else if (command->kind == COMMAND_PLAN_KEYSYM) {
        if (!allowed_named_keysym(command->key_name)) {
            *reason = "named-keysym-denied";
            errno = EPERM;
            return -1;
        }
        keysym = xkb_keysym_from_name(command->key_name, XKB_KEYSYM_CASE_INSENSITIVE);
        modifiers = command->modifiers;
        planning = true;
    } else if (command->kind == COMMAND_TYPE) {
        keysym = keysym_for_codepoint(command->codepoint);
    } else if (command->kind == COMMAND_CHORD_UNICODE) {
        keysym = keysym_for_codepoint(command->codepoint);
        modifiers = command->modifiers;
    } else if (command->kind == COMMAND_CHORD_KEYSYM) {
        if (!allowed_named_keysym(command->key_name)) {
            *reason = "named-keysym-denied";
            errno = EPERM;
            return -1;
        }
        keysym = xkb_keysym_from_name(command->key_name, XKB_KEYSYM_CASE_INSENSITIVE);
        modifiers = command->modifiers;
    }
    if (keysym == XKB_KEY_NoSymbol) {
        *reason = "unknown-keysym";
        errno = EINVAL;
        return -1;
    }
    uint32_t key_code = 0U;
    if (lookup_keysym(state, keysym, &key_code) < 0) {
        *reason = "keysym-not-prepared";
        return -1;
    }
    if (planning) {
        uint32_t serialized = 0U;
        if (state->held_key != 0U || state->held_modifiers != 0U ||
                serialize_modifiers(state, modifiers, &serialized) < 0) {
            *reason = "plan-state-invalid";
            return -1;
        }
        /* A roundtrip proves that the exact birth-pinned virtual keyboard and
         * its sealed keymap remain accepted by the compositor. PLAN never
         * sends a key or modifier request; Sway owns the later guarded unit. */
        if (display_roundtrip(state) < 0) {
            *reason = "plan-roundtrip-failed";
            return -1;
        }
        state->planned_key = key_code;
        state->planned_modifiers = serialized;
        state->plan_valid = true;
        return 0;
    }
    return dispatch_key(state, key_code, modifiers, reason);
}

static int run_self_test(void) {
    struct command command = {0};
    char prepare_unicode[] = "1 PREPU 03bb\n";
    char prepare_keysym[] = "2 PREPK Insert\n";
    char seal[] = "3 SEAL\n";
    char plan_unicode[] = "4 PLANU 4 03bb\n";
    char plan_keysym[] = "5 PLANK 1 Insert\n";
    char plan_modifiers[] = "6 PLANM 12\n";
    char type[] = "7 TYPE 03bb\n";
    char chord_unicode[] = "8 CHORDU 4 0063\n";
    char chord_keysym[] = "9 CHORDK 1 Insert\n";
    char ping[] = "10 PING\n";
    char invalid_hold[] = "11 HOLD 12\n";
    char invalid_clear[] = "11 CLEAR\n";
    char invalid_reset[] = "11 RESET\n";
    char quit[] = "11 QUIT\n";
    char invalid_sequence[] = "13 PING\n";
    char invalid_codepoint[] = "12 PREPU D800\n";
    char invalid_modifiers[] = "12 PLANU 2 0063\n";
    char invalid_modifier_plan[] = "12 PLANM 2\n";
    if (!parse_command(prepare_unicode, 1U, &command) ||
            command.kind != COMMAND_PREPARE_UNICODE ||
            command.codepoint != UINT32_C(0x03bb) ||
            !parse_command(prepare_keysym, 2U, &command) ||
            command.kind != COMMAND_PREPARE_KEYSYM ||
            strcmp(command.key_name, "Insert") != 0 ||
            !parse_command(seal, 3U, &command) || command.kind != COMMAND_SEAL ||
            !parse_command(plan_unicode, 4U, &command) ||
            command.kind != COMMAND_PLAN_UNICODE || command.modifiers != MOD_CTRL ||
            command.codepoint != UINT32_C(0x03bb) ||
            !parse_command(plan_keysym, 5U, &command) ||
            command.kind != COMMAND_PLAN_KEYSYM || command.modifiers != MOD_SHIFT ||
            strcmp(command.key_name, "Insert") != 0 ||
            !parse_command(plan_modifiers, 6U, &command) ||
            command.kind != COMMAND_PLAN_MODIFIERS ||
            command.modifiers != (MOD_CTRL | MOD_ALT) ||
            !parse_command(type, 7U, &command) || command.kind != COMMAND_TYPE ||
            command.codepoint != UINT32_C(0x03bb) ||
            !parse_command(chord_unicode, 8U, &command) ||
            command.kind != COMMAND_CHORD_UNICODE || command.modifiers != MOD_CTRL ||
            !parse_command(chord_keysym, 9U, &command) ||
            command.kind != COMMAND_CHORD_KEYSYM || command.modifiers != MOD_SHIFT ||
            strcmp(command.key_name, "Insert") != 0 ||
            !parse_command(ping, 10U, &command) || command.kind != COMMAND_PING ||
            parse_command(invalid_hold, 11U, &command) ||
            parse_command(invalid_clear, 11U, &command) ||
            parse_command(invalid_reset, 11U, &command) ||
            !parse_command(quit, 11U, &command) || command.kind != COMMAND_QUIT ||
            parse_command(invalid_sequence, 12U, &command) ||
            parse_command(invalid_codepoint, 12U, &command) ||
            parse_command(invalid_modifiers, 12U, &command) ||
            parse_command(invalid_modifier_plan, 12U, &command) ||
            !allowed_named_keysym("Return") || !allowed_named_keysym("F24") ||
            allowed_named_keysym("F25") || allowed_named_keysym("Caps_Lock") ||
            allowed_named_keysym("ISO_Next_Group") ||
            keysym_for_codepoint(UINT32_C(0x08)) != XKB_KEY_BackSpace ||
            keysym_for_codepoint(UINT32_C(0x09)) != XKB_KEY_Tab ||
            keysym_for_codepoint(UINT32_C(0x0a)) != XKB_KEY_Return ||
            keysym_for_codepoint(UINT32_C(0x0d)) != XKB_KEY_Return ||
            keysym_for_codepoint(UINT32_C(0x1b)) != XKB_KEY_Escape ||
            keysym_for_codepoint(UINT32_C(0x7f)) != XKB_KEY_Delete) {
        fputs("sandcodex-wayland-keyboard-agent: self-test failed\n", stderr);
        return 1;
    }
    printf("{\"schema\":\"sandcodex.keyboard-agent-self-test.v1\","
           "\"protocol\":\"%s\",\"ok\":true,"
           "\"maximum_keymap_entries\":%u,"
           "\"maximum_keymap_bytes\":%u,"
           "\"keymap_validation\":\"local-libxkbcommon-before-compositor-upload\","
           "\"keymap_seals\":\"shrink+grow+write+seal-verified\","
           "\"modifier_serialization\":\"canonical-compiled-keymap-mask-api\","
           "\"modifier_hold_protocol\":\"compositor-owned-exact-recipient-modifier-arc+connection-owned-target-independent-clear\","
           "\"modifier_plan_protocol\":\"PLANM+sealed-keymap+display-roundtrip+zero-input-requests\","
           "\"dispatch_keymap_policy\":\"presealed-no-runtime-keymap-mutation\","
           "\"reply_state\":\"keymap-generation+preparation-lock\","
           "\"preparation_barrier\":\"one-way-seal-before-dispatch\","
           "\"reply_transition_model\":\"initial-map1-gen1+prepare-grow+seal-generation+immutable-dispatch\","
           "\"maximum_keymap_generations\":%u,"
           "\"minimum_libxkbcommon\":\"1.10.0\","
           "\"resolved_libxkbcommon\":\"%s\","
           "\"named_keysym_policy\":\"reviewed-nonlocking-allowlist\","
           "\"registry_cardinality\":\"exactly-one-seat+one-virtual-keyboard-manager\","
           "\"topology_change\":\"terminal-helper-failure\","
           "\"process_custody\":\"parent-death-signal+non-dumpable+no-new-privileges+three-distinct-directional-pipes\"}\n",
           AGENT_PROTOCOL, MAX_KEYMAP_ENTRIES, MAX_KEYMAP_BYTES,
           MAX_KEYMAP_GENERATIONS, SANDCODEX_LIBXKBCOMMON_VERSION);
    return 0;
}

static void reply_error(uint64_t sequence, const char *reason,
        const struct wayland_state *state) {
    fprintf(stdout,
        "ERR %" PRIu64 " %s PLAN 0 KEY 0 SMODS 0 HELD %u MODS %u MAP %zu GEN %u LOCKED %u\n",
        sequence, reason, state->held_key != 0U ? 1U : 0U,
        state->held_modifiers, state->keymap_count,
        state->keymap_generation, state->preparation_locked ? 1U : 0U);
    (void)fflush(stdout);
}

int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc != 1) {
        fprintf(stderr, "usage: %s [--self-test|--version]\n", argv[0]);
        return 64;
    }

    struct sigaction action = {0};
    action.sa_handler = on_signal;
    sigemptyset(&action.sa_mask);
    if (sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0 ||
            sigaction(SIGHUP, &action, NULL) < 0) {
        perror("sandcodex-wayland-keyboard-agent: sigaction");
        return 1;
    }
    struct sigaction ignore = {0};
    ignore.sa_handler = SIG_IGN;
    sigemptyset(&ignore.sa_mask);
    if (sigaction(SIGPIPE, &ignore, NULL) < 0) {
        perror("sandcodex-wayland-keyboard-agent: sigaction SIGPIPE");
        return 1;
    }
    if (harden_process() < 0) {
        perror("sandcodex-wayland-keyboard-agent: process hardening");
        return 77;
    }

    struct wayland_state state = {0};
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-keyboard-agent: Wayland initialization");
        destroy_wayland(&state);
        return 69;
    }
    if (printf("READY %s %ld\n", AGENT_PROTOCOL, (long)getpid()) < 0 || fflush(stdout) == EOF) {
        (void)release_keyboard_state(&state, false);
        destroy_wayland(&state);
        return 74;
    }

    uint64_t expected_sequence = 1U;
    int result = 0;
    while (!stop_requested) {
        char line[MAX_LINE_BYTES + 2U] = {0};
        errno = 0;
        if (fgets(line, (int)sizeof(line), stdin) == NULL) {
            if (stop_requested || feof(stdin)) {
                break;
            }
            if (errno == EINTR) {
                clearerr(stdin);
                continue;
            }
            result = 74;
            break;
        }
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n') {
            reply_error(expected_sequence, "malformed-command", &state);
            result = 65;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            reply_error(expected_sequence, "malformed-command", &state);
            result = 65;
            break;
        }
        if (command.kind == COMMAND_QUIT) {
            if (release_keyboard_state(&state, false) < 0) {
                reply_error(command.sequence, "held-release-failed", &state);
                result = 70;
                break;
            }
            if (destroy_virtual_keyboard(&state) < 0) {
                reply_error(command.sequence, "device-destroy-failed", &state);
                result = 70;
                break;
            }
            fprintf(stdout,
                "BYE %" PRIu64 " PLAN 0 KEY 0 SMODS 0 HELD 0 MODS 0 MAP %zu GEN %u LOCKED %u\n",
                command.sequence, state.keymap_count, state.keymap_generation,
                state.preparation_locked ? 1U : 0U);
            (void)fflush(stdout);
            expected_sequence++;
            break;
        }
        const char *reason = "wayland-dispatch-failed-release-ambiguous";
        if (dispatch_command(&state, &command, &reason) < 0) {
            reply_error(command.sequence, reason, &state);
            result = 70;
            break;
        }
        fprintf(stdout,
            "OK %" PRIu64 " PLAN %u KEY %u SMODS %u HELD %u MODS %u MAP %zu GEN %u LOCKED %u\n",
            command.sequence, state.plan_valid ? 1U : 0U, state.planned_key,
            state.planned_modifiers, state.held_key != 0U ? 1U : 0U,
            state.held_modifiers, state.keymap_count, state.keymap_generation,
            state.preparation_locked ? 1U : 0U);
        if (fflush(stdout) == EOF) {
            result = 74;
            break;
        }
        expected_sequence++;
    }

    if (release_keyboard_state(&state, false) < 0) {
        result = result == 0 ? 70 : result;
    }
    destroy_wayland(&state);
    return result;
}
WAYLAND_KEYBOARD_AGENT_C
}

