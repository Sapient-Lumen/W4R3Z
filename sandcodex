    return 0


def _runtime(args: argparse.Namespace) -> int:
    _harden_process()
    if not APP_ID_RE.fullmatch(args.application_id):
        raise RuntimeError("invalid application identity")
    if not LAUNCH_ID_RE.fullmatch(args.launch_id):
        raise RuntimeError("invalid launch identity")
    instance_token = _read_instance_token(Path(args.instance_token_file))
    surface_token = _read_surface_token(Path(args.surface_token_file))
    window_app_id = _surface_app_id(surface_token)
    surface_token = ""

    import gi  # Imported only at runtime; --self-test remains dependency-free.

    gi.require_version("Gio", "2.0")
    gi.require_version("GLib", "2.0")
    gi.require_version("Gtk", "3.0")
    gi.require_version("Pango", "1.0")
    from gi.repository import Gdk, Gio, GLib, Gtk, Pango

    GLib.set_prgname(window_app_id)
    GLib.set_application_name(WINDOW_TITLE)
    with _suppress(Exception):
        Gdk.set_program_class(window_app_id)
    initialized, _remaining = Gtk.init_check([])
    if not initialized:
        raise RuntimeError("private notification service could not connect to launch Wayland")
    settings = Gtk.Settings.get_default()
    if settings is not None:
        with _suppress(Exception):
            settings.set_property("gtk-enable-animations", False)

    connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    if connection is None:
        raise RuntimeError("private session bus is unavailable")
    connection.set_exit_on_close(True)
    main_loop = GLib.MainLoop()
    node = Gio.DBusNodeInfo.new_for_xml(NOTIFICATION_XML)
    interface_info = node.interfaces[0]

    active: dict[int, Any] = {}
    next_identifier = 1
    window: Any = None
    rows: Any = None
    count_label: Any = None
    shutting_down = False

    def emit(destination: str, member: str, signature: str, values: tuple[Any, ...]) -> bool:
        # The sender may disappear between an input event and signal dispatch.
        # Never retain an actionable row merely because directed delivery raced
        # owner loss; closing the notification is the fail-closed outcome.
        try:
            return bool(
                connection.emit_signal(
                    destination,
                    OBJECT_PATH,
                    INTERFACE,
                    member,
                    GLib.Variant(signature, values),
                )
            )
        except Exception:
            return False

    def refresh_window() -> None:
        nonlocal window, rows, count_label
        if window is None:
            window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
            window.set_title(WINDOW_TITLE)
            window.set_default_size(420, -1)
            window.set_resizable(False)
            window.set_decorated(False)
            window.set_accept_focus(False)
            window.set_keep_above(True)
            window.set_skip_taskbar_hint(True)
            window.set_skip_pager_hint(True)
            window.set_focus_on_map(False)
            window.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
            window.set_border_width(8)
            window.connect("delete-event", lambda *_unused: True)

            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title = Gtk.Label(label="Notifications")
            title.set_xalign(0.0)
            title.get_style_context().add_class("title")
            count_label = Gtk.Label(label="0")
            count_label.set_xalign(1.0)
            header.pack_start(title, True, True, 0)
            header.pack_end(count_label, False, False, 0)
            outer.pack_start(header, False, False, 0)

            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_min_content_width(400)
            # Bound one launch's notification surface so multiple independently
            # attributed services can be placed without consuming the workstation.
            scroller.set_max_content_height(MAX_WINDOW_CONTENT_HEIGHT)
            rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            scroller.add(rows)
            outer.pack_start(scroller, True, True, 0)
            window.add(outer)
        if count_label is not None:
            count_label.set_text(str(len(active)))
        if active:
            window.show_all()
        else:
            window.hide()

    class ActiveNotification:
        def __init__(self, identifier: int, spec: NotificationSpec) -> None:
            self.identifier = identifier
            self.spec = spec
            self.row: Any = None
            self.expire_source = 0
            self.closed = False

        def _label(self, text: str, *, summary: bool = False) -> Any:
            label = Gtk.Label(label=text)
            label.set_xalign(0.0)
            label.set_line_wrap(True)
            label.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            label.set_selectable(False)
            if summary:
                label.get_style_context().add_class("title")
            return label

        def render(self) -> None:
            refresh_window()
            if self.row is not None:
                rows.remove(self.row)
            frame = Gtk.Frame()
            frame.set_name(f"sandcodex-notification-{self.identifier}")
            with _suppress(Exception):
                frame.get_accessible().set_name(
                    f"Notification {self.identifier}: "
                    f"{self.spec.summary or 'Notification'} from {args.application_id}"
                )
            frame.set_shadow_type(Gtk.ShadowType.ETCHED_IN)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.set_border_width(8)
            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            source_text = f"Source: {args.application_id}"
            source = self._label(source_text)
            source.get_style_context().add_class("dim-label")
            with _suppress(Exception):
                source.get_accessible().set_name(
                    f"Trusted notification source: {args.application_id}"
                )
            content.pack_start(source, False, False, 0)
            if self.spec.app_name:
                reported_text = f"Reported label: {self.spec.app_name}"
                reported = self._label(reported_text)
                reported.get_style_context().add_class("dim-label")
                with _suppress(Exception):
                    reported.get_accessible().set_name(
                        f"Untrusted application-reported notification label: {self.spec.app_name}"
                    )
                content.pack_start(reported, False, False, 0)
            summary_text = self.spec.summary or "Notification"
            summary = self._label(summary_text, summary=True)
            with _suppress(Exception):
                summary.get_accessible().set_name(
                    f"Notification summary from {args.application_id}: {summary_text}"
                )
            content.pack_start(summary, False, False, 0)
            if self.spec.body:
                body = self._label(self.spec.body)
                with _suppress(Exception):
                    body.get_accessible().set_name(
                        f"Notification body from {args.application_id}: {self.spec.body}"
                    )
                content.pack_start(body, False, False, 0)

            if self.spec.default_action is not None:
                default_button = Gtk.Button()
                default_button.set_relief(Gtk.ReliefStyle.NONE)
                default_button.set_focus_on_click(False)
                default_button.set_can_focus(False)
                default_button.set_tooltip_text("Activate notification")
                with _suppress(Exception):
                    default_button.get_accessible().set_name(
                        f"Activate notification {self.identifier} from {args.application_id}"
                    )
                default_button.add(content)
                default_button.connect(
                    "clicked", lambda *_unused: self.invoke("default")
                )
                top.pack_start(default_button, True, True, 0)
            else:
                top.pack_start(content, True, True, 0)

            close_button = Gtk.Button.new_with_label("×")
            close_button.set_tooltip_text("Dismiss notification")
            close_button.set_relief(Gtk.ReliefStyle.NONE)
            close_button.set_focus_on_click(False)
            close_button.set_can_focus(False)
            with _suppress(Exception):
                close_button.get_accessible().set_name(
                    f"Dismiss notification {self.identifier} from {args.application_id}"
                )
            close_button.connect("clicked", lambda *_unused: self.close(2, emit_signal=True))
            top.pack_end(close_button, False, False, 0)
            box.pack_start(top, False, False, 0)
            if self.spec.visible_actions:
                actions_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                for key, label_text in self.spec.visible_actions:
                    button = Gtk.Button.new_with_label(label_text)
                    button.set_focus_on_click(False)
                    button.set_can_focus(False)
                    with _suppress(Exception):
                        button.get_accessible().set_name(
                            f"{label_text} — notification {self.identifier} "
                            f"from {args.application_id}"
                        )
                    button.connect("clicked", lambda _button, action=key: self.invoke(action))
                    actions_box.pack_end(button, False, False, 0)
                box.pack_start(actions_box, False, False, 0)
            frame.add(box)
            self.row = frame
            rows.pack_start(frame, False, False, 0)
            rows.reorder_child(frame, 0)
            frame.show_all()
            if self.expire_source:
                GLib.source_remove(self.expire_source)
                self.expire_source = 0
            if self.spec.expire_milliseconds is not None:
                self.expire_source = GLib.timeout_add(
                    self.spec.expire_milliseconds,
                    self._expire,
                )
            refresh_window()

        def replace(self, spec: NotificationSpec) -> None:
            if self.closed:
                raise NotificationError("notification replacement target is closed")
            self.spec = spec
            self.render()

        def _expire(self) -> bool:
            self.expire_source = 0
            self.close(1, emit_signal=True)
            return False

        def invoke(self, action: str) -> None:
            if self.closed:
                return
            if action not in {key for key, _label in self.spec.actions}:
                return
            emit(self.spec.sender, "ActionInvoked", "(us)", (self.identifier, action))
            self.close(2, emit_signal=True)

        def close(self, reason: int, *, emit_signal: bool) -> None:
            if self.closed:
                return
            self.closed = True
            active.pop(self.identifier, None)
            if self.expire_source:
                with _suppress(Exception):
                    GLib.source_remove(self.expire_source)
                self.expire_source = 0
            if self.row is not None and rows is not None:
                with _suppress(Exception):
                    rows.remove(self.row)
                self.row = None
            if emit_signal:
                emit(
                    self.spec.sender,
                    "NotificationClosed",
                    "(uu)",
                    (self.identifier, reason),
                )
            refresh_window()

    def allocate_identifier() -> int:
        nonlocal next_identifier
        for _unused in range(0xFFFFFFFF):
            candidate = next_identifier
            next_identifier = 1 if next_identifier == 0xFFFFFFFF else next_identifier + 1
            if candidate != 0 and candidate not in active:
                return candidate
        raise NotificationError("notification identifier space is exhausted")

    def on_method_call(
        _connection: Any,
        sender: str,
        _object_path: str,
        _interface_name: str,
        method_name: str,
        parameters: Any,
        invocation: Any,
    ) -> None:
        try:
            if parameters.get_size() > MAX_CALL_BYTES:
                raise NotificationError("notification call exceeds its byte limit")
            unpacked = parameters.unpack()
            if method_name == "GetCapabilities":
                invocation.return_value(GLib.Variant("(as)", (list(CAPABILITIES),)))
                return
            if method_name == "GetServerInformation":
                invocation.return_value(
                    GLib.Variant(
                        "(ssss)",
                        (SERVER_NAME, SERVER_VENDOR, SERVER_VERSION, SPEC_VERSION),
                    )
                )
                return
            if method_name == "Notify":
                if len(unpacked) != 8:
                    raise NotificationError("Notify arguments are malformed")
                (
                    app_name,
                    replaces_id,
                    app_icon,
                    summary,
                    body,
                    actions,
                    hints,
                    expire_timeout,
                ) = unpacked
                spec = _parse_notification(
                    sender,
                    app_name,
                    app_icon,
                    summary,
                    body,
                    actions,
                    hints,
                    expire_timeout,
                )
                identifier, replacing = _select_identifier(
                    {identifier: item.spec.sender for identifier, item in active.items()},
                    replaces_id,
                    sender,
                    allocate_identifier,
                )
                if replacing:
                    existing = active[identifier]
                    existing.replace(spec)
                else:
                    if len(active) >= MAX_ACTIVE_NOTIFICATIONS:
                        raise NotificationError("the launch notification limit has been reached")
                    notification = ActiveNotification(identifier, spec)
                    active[identifier] = notification
                    notification.render()
                invocation.return_value(GLib.Variant("(u)", (identifier,)))
                return
            if method_name == "CloseNotification":
                if len(unpacked) != 1:
                    raise NotificationError("CloseNotification arguments are malformed")
                identifier = unpacked[0]
                if not isinstance(identifier, int) or isinstance(identifier, bool):
                    raise NotificationError("notification id must be an unsigned integer")
                notification = active.get(identifier)
                if notification is None:
                    invocation.return_dbus_error(
                        "org.freedesktop.Notifications.InvalidNotificationId",
                        "",
                    )
                    return
                if notification.spec.sender != sender:
                    invocation.return_dbus_error(
                        "org.freedesktop.DBus.Error.AccessDenied",
                        "notification belongs to another private-bus sender",
                    )
                    return
                notification.close(3, emit_signal=True)
                invocation.return_value(None)
                return
            invocation.return_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod",
                "unknown notification method",
            )
        except NotificationError as error:
            invocation.return_dbus_error(
                "org.freedesktop.Notifications.InvalidArgs",
                str(error),
            )
        except Exception:
            invocation.return_dbus_error(
                "org.freedesktop.Notifications.InternalError",
                "the launch-private notification request failed",
            )

    registration_id = connection.register_object(
        OBJECT_PATH,
        interface_info,
        on_method_call,
        None,
        None,
    )
    if not registration_id:
        raise RuntimeError("could not register launch-private notification object")
    reply = connection.call_sync(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus",
        "RequestName",
        GLib.Variant("(su)", (BUS_NAME, 4)),
        GLib.VariantType.new("(u)"),
        Gio.DBusCallFlags.NONE,
        5000,
        None,
    )
    name_result = reply.unpack()[0]
    if name_result not in {1, 4}:
        raise RuntimeError("launch-private notification bus name is already owned")

    def owner_changed(
        _connection: Any,
        _sender_name: str,
        _object_path: str,
        _interface_name: str,
        _signal_name: str,
        parameters: Any,
    ) -> None:
        name, old_owner, new_owner = parameters.unpack()
        if not isinstance(name, str) or not name.startswith(":"):
            return
        if old_owner != name or new_owner:
            return
        for notification in list(active.values()):
            if notification.spec.sender == name:
                notification.close(3, emit_signal=False)

    owner_subscription = connection.signal_subscribe(
        "org.freedesktop.DBus",
        "org.freedesktop.DBus",
        "NameOwnerChanged",
        "/org/freedesktop/DBus",
        None,
        Gio.DBusSignalFlags.NONE,
        owner_changed,
    )
    if not owner_subscription:
        raise RuntimeError("could not subscribe to private-bus owner lifecycle")

    def quit_main(*_unused: Any) -> bool:
        nonlocal shutting_down
        if shutting_down:
            return False
        shutting_down = True
        for notification in list(active.values()):
            notification.close(3, emit_signal=False)
        if window is not None:
            with _suppress(Exception):
                window.destroy()
        main_loop.quit()
        return False

    connection.connect("closed", lambda *_unused: quit_main())
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signum, quit_main)
    _write_ready(
        Path(args.ready_file),
        args.launch_id,
        args.application_id,
        instance_token,
        window_app_id,
    )
    try:
        main_loop.run()
    finally:
        with _suppress(Exception):
            connection.signal_unsubscribe(owner_subscription)
        with _suppress(Exception):
            connection.unregister_object(registration_id)
    return 0


class _suppress:
    """Small local context manager; avoids importing a larger helper module."""

    def __init__(self, *exceptions: type[BaseException]) -> None:
        self.exceptions = exceptions or (Exception,)

    def __enter__(self) -> None:
        return None

    def __exit__(self, kind: Any, _value: Any, _traceback: Any) -> bool:
        return kind is not None and issubclass(kind, self.exceptions)


def _arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--ready-file")
    parser.add_argument("--application-id")
    parser.add_argument("--launch-id")
    parser.add_argument("--instance-token-file")
    parser.add_argument("--surface-token-file")
    parsed = parser.parse_args(argv)
    if parsed.self_test or parsed.version:
        return parsed
    for name in (
        "ready_file",
        "application_id",
        "launch_id",
        "instance_token_file",
        "surface_token_file",
    ):
        if getattr(parsed, name) is None:
            parser.error(f"--{name.replace('_', '-')} is required")
    return parsed


def main(argv: list[str]) -> int:
    args = _arguments(argv)
    if args.version:
        print(PROTOCOL)
        return 0
    if args.self_test:
        return _self_test()
    return _runtime(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (NotificationError, OSError, RuntimeError) as error:
        print(f"sandcodex private notifications: {error}", file=sys.stderr)
        raise SystemExit(70) from None
SANDCODEX_PRIVATE_NOTIFICATION_SERVICE
}

