class CompositorEventSeal:
    """Birth-pinned, ordered Sway IPC event barrier for guarded GUI input.

    Sway's SEND_TICK contract guarantees that a subscribed client has received
    every compositor event which preceded the matching tick.  Two authenticated
    AF_UNIX connections are used: one receives the subscribed stream while the
    other issues barriers.  The kernel peer credentials on both connections
    must identify the exact Sway process started by the private workstation.
    """

    EVENT_NAMES = {
        SWAY_IPC_EVENT_WORKSPACE: "workspace",
        SWAY_IPC_EVENT_OUTPUT: "output",
        SWAY_IPC_EVENT_MODE: "mode",
        SWAY_IPC_EVENT_WINDOW: "window",
        SWAY_IPC_EVENT_BINDING: "binding",
        SWAY_IPC_EVENT_SHUTDOWN: "shutdown",
        SWAY_IPC_EVENT_TICK: "tick",
        SWAY_IPC_EVENT_INPUT: "input",
    }
    SUBSCRIPTIONS = (
        "workspace", "output", "mode", "window", "binding", "shutdown", "tick", "input",
    )

    def __init__(
        self,
        socket_path: Path,
        expected_pid: int,
        expected_start_ticks: int,
        *,
        barrier_timeout: float = COMPOSITOR_EVENT_BARRIER_TIMEOUT_SECONDS,
        maximum_events: int = COMPOSITOR_EVENT_MAX_BUFFERED,
        hit_test_token: str | None = None,
    ) -> None:
        if not 0.05 <= barrier_timeout <= 30.0:
            raise RuntimeError("compositor event barrier timeout is outside the supported range")
        if not 4 <= maximum_events <= 65536:
            raise RuntimeError("compositor event buffer limit is outside the supported range")
        self.socket_path = socket_path
        self.expected_pid = expected_pid
        self.expected_start_ticks = expected_start_ticks
        self.barrier_timeout = barrier_timeout
        self.maximum_events = maximum_events
        self.condition = threading.Condition(threading.RLock())
        self.command_lock = threading.Lock()
        self.stop_event = threading.Event()
        self.events: deque[dict[str, Any]] = deque()
