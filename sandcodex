+        dy <= SANDCODEX_RELATIVE_MOTION_MAX_DELTA &&
+        (dx != 0 || dy != 0) && steps >= 1 &&
+        steps <= SANDCODEX_RELATIVE_MOTION_MAX_STEPS &&
+        (int64_t)steps <= major && duration_msec >= steps &&
+        duration_msec <= SANDCODEX_RELATIVE_MOTION_MAX_DURATION_MSEC;
