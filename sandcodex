+static bool sandcodex_touchpad_swipe_modifier_quiet(
+        struct ipc_client *client, struct sway_seat *seat) {
+    struct sway_seat_device *keyboard =
+        sandcodex_single_virtual_keyboard(seat);
+    return client && !client->sandcodex_modifier_arc.active &&
+        keyboard && sandcodex_keyboard_released(seat, keyboard);
+}
