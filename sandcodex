    def click(self, arguments: dict[str, Any]) -> dict[str, Any]:
        x = arguments.get("x")
        y = arguments.get("y")
        if (x is None) != (y is None):
            raise ToolError("x and y must be supplied together")
        if x is not None:
            self._move(as_int(x, 0, self.width - 1, "x"), as_int(y, 0, self.height - 1, "y"))
        button = as_int(arguments.get("button", 1), 1, 5, "button")
        count = as_int(arguments.get("count", 1), 1, 4, "count")
        interval = as_number(arguments.get("interval", 0.08), 0.0, 2.0, "interval")
        with self._x11_pointer_modifier_arc(arguments) as modifiers:
            for index in range(count):
                self._click(button)
                if index + 1 < count and interval:
                    time.sleep(interval)
        return json_result({
            "clicked": True, "button": button, "count": count,
            "modifiers": modifiers, **self.pointer_position(),
        })

    def touch(self, arguments: dict[str, Any]) -> dict[str, Any]:
        as_int(arguments.get("x"), 0, self.width - 1, "x")
        as_int(arguments.get("y"), 0, self.height - 1, "y")
        raise ToolError(
            "desktop_touch is native wl_touch input and requires a guarded Wayland "
            "desktop_observe + desktop_step transaction; mouse fallback is denied"
        )

    def drag(self, arguments: dict[str, Any]) -> dict[str, Any]:
        points = self._drag_points(arguments)
        start_x, start_y = points[0]
        end_x, end_y = points[-1]
        button = as_int(arguments.get("button", 1), 1, 5, "button")
        duration = as_number(arguments.get("duration", 0.4), 0.0, 10.0, "duration")
        transaction: WaylandPointerTransaction | None = None
        with self._x11_pointer_modifier_arc(arguments) as modifiers:
            try:
                if self.is_wayland:
                    transaction = WaylandPointerTransaction(self, "desktop_drag-direct")
                self._move(start_x, start_y)
                button_pressed = False
                try:
                    self._press_pointer_button(button)
                    button_pressed = True
                    self._pointer_drag_active = True
                    for point in points[1:]:
                        self._move(*point)
                        if duration:
                            time.sleep(duration / max(1, len(points) - 1))
                finally:
                    self._pointer_drag_active = False
                    if button_pressed:
                        self._release_pointer_button(button)
            finally:
                if transaction is not None:
                    transaction.close()
        return json_result({
            "dragged": True,
            "start": [start_x, start_y],
            "end": [end_x, end_y],
            "button": button,
            "modifiers": modifiers,
            "segments": len(points) - 1,
        })

    def scroll(self, arguments: dict[str, Any]) -> dict[str, Any]:
        self._require_pointer_healthy()
        x = arguments.get("x")
        y = arguments.get("y")
        if (x is None) != (y is None):
            raise ToolError("x and y must be supplied together")
        if x is not None:
            self._move(as_int(x, 0, self.width - 1, "x"), as_int(y, 0, self.height - 1, "y"))
        delta_y = as_int(arguments.get("delta_y", 0), -100, 100, "delta_y")
        delta_x = as_int(arguments.get("delta_x", 0), -100, 100, "delta_x")
        if delta_x == 0 and delta_y == 0:
            raise ToolError("at least one scroll delta must be non-zero")
        interval = as_number(arguments.get("interval", 0.02), 0.0, 1.0, "interval")
        with self._x11_pointer_modifier_arc(arguments) as modifiers:
            if self.is_wayland:
                units = self._scroll_units(delta_x, delta_y)
                if max(0, len(units) - 1) * interval > MAX_ACTION_SECONDS:
                    raise ToolError("scroll duration exceeds the action limit")
                with WaylandPointerTransaction(self, "desktop_scroll-direct") as transaction:
                    for index, (unit_x, unit_y) in enumerate(units):
                        transaction.scroll(unit_x, unit_y)
                        if interval and index + 1 < len(units):
                            time.sleep(interval)
            else:
                events: list[int] = []
                events.extend([5 if delta_y > 0 else 4] * abs(delta_y))
                events.extend([7 if delta_x > 0 else 6] * abs(delta_x))
                if max(0, len(events) - 1) * interval > MAX_ACTION_SECONDS:
                    raise ToolError("scroll duration exceeds the action limit")
                for index, button in enumerate(events):
                    self._click(button)
                    if interval and index + 1 < len(events):
                        time.sleep(interval)
        return json_result({
            "scrolled": True, "delta_x": delta_x, "delta_y": delta_y,
            "modifiers": modifiers, **self.pointer_position(),
        })

    def _tablet_pad_mode_parameters(
        self, arguments: dict[str, Any]
    ) -> dict[str, int]:
        """Normalize one exact persistent native tablet-v2 pad-group mode switch."""
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        mode = as_int(
            arguments.get("mode"),
            TABLET_PAD_MODE_MIN_INDEX,
            TABLET_PAD_MODE_MAX_INDEX,
            "mode",
        )
        normalized = {"x": x, "y": y, "mode": mode}
        arguments.update(normalized)
        return normalized

    def tablet_pad_mode(self, arguments: dict[str, Any]) -> dict[str, Any]:
        self._tablet_pad_mode_parameters(dict(arguments))
        raise ToolError(
            "desktop_tablet_pad_mode is a persistent native tablet-v2 group-mode "
            "transition and requires a guarded Wayland desktop_observe + desktop_step "
            "transaction; pointer, keyboard, touch, stylus-tool, browser, physical-tablet, "
            "host-input, and real-desktop fallbacks are denied"
        )

