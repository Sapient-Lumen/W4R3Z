    def _dispatch_compositor_guarded_touch_gesture(
        self,
        route: dict[str, Any],
        arguments: dict[str, Any],
    ) -> dict[str, Any]:
        """Dispatch one exact-recipient native two-contact wl_touch gesture."""
        if not self.is_wayland:
            raise ToolError("native compositor touch-gesture dispatch requires Wayland")
        normalized = dict(arguments)
        first_path, second_path = self._touch_gesture_paths(normalized)
        expected_points = [
            point
            for pair in zip(first_path, second_path)
            for point in pair
        ]
        points = route.get("points")
        if not isinstance(points, list) or len(points) != len(expected_points):
            raise ToolError("compositor touch-gesture route lost its exact paired paths")
        for index, (record, expected) in enumerate(zip(points, expected_points)):
            if (
                not isinstance(record, dict)
                or record.get("point") != list(expected)
                or record.get("touch_contact_id") != index % TOUCH_GESTURE_CONTACT_COUNT
                or record.get("touch_path_index") != index // TOUCH_GESTURE_CONTACT_COUNT
            ):
                raise ToolError(
                    f"compositor touch-gesture route point {index} is malformed"
                )
        first_start_x, first_start_y = first_path[0]
        first_end_x, first_end_y = first_path[-1]
        second_start_x, second_start_y = second_path[0]
        second_end_x, second_end_y = second_path[-1]
        if self.pointer != {"x": first_start_x, "y": first_start_y}:
            raise ToolError(
                "compositor touch-gesture cursor left its reviewed first-contact start"
            )
        transaction = getattr(self, "_active_pointer_transaction", None)
        if transaction is None or transaction.closed:
            raise ToolError("compositor touch-gesture lost its birth-pinned route pointer")
        start_receipt = transaction.seat_start_receipt
