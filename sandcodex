+				sandcodex_double_bits(sx[index]) != expected_sx_bits[index] ||
+				sandcodex_double_bits(sy[index]) != expected_sy_bits[index] ||
+				!sandcodex_touch_default_route(seat, expected_grab_address,
+					expected_default_grab_address) ||
+				!sandcodex_touch_recipient_exact(current_client,
+					expected_resource_address, expected_resource_id, NULL, NULL)) {
+			same_path = false;
+		}
+		if (index == 0) {
+			target_surface = current_surface;
+			seat_client = current_client;
+		} else if (current_surface != target_surface || current_client != seat_client) {
+			same_path = false;
+		}
+		sandcodex_secure_clear(&current, sizeof(current));
+		if (!same_path) {
+			break;
+		}
+	}
+	if (!same_path || !target_surface || !seat_client) {
+		sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+		sandcodex_secure_clear(expected_sx_bits, sizeof(expected_sx_bits));
+		sandcodex_secure_clear(expected_sy_bits, sizeof(expected_sy_bits));
+		sandcodex_secure_clear(sx, sizeof(sx));
+		sandcodex_secure_clear(sy, sizeof(sy));
+		sandcodex_send_hit_test_failure(client, "dispatch-touch-path-changed");
+		return;
+	}
+
+	bool dispatched = sandcodex_dispatch_touch_stroke(seat, target_surface,
+		seat_client, expected_grab_address, expected_default_grab_address,
+		expected_resource_address, expected_resource_id, sx, sy, steps,
+		duration_msec);
+	sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+	sandcodex_secure_clear(expected_sx_bits, sizeof(expected_sx_bits));
+	sandcodex_secure_clear(expected_sy_bits, sizeof(expected_sy_bits));
+	sandcodex_secure_clear(sx, sizeof(sx));
+	sandcodex_secure_clear(sy, sizeof(sy));
+	if (!dispatched) {
+		sandcodex_send_hit_test_failure(client, "dispatch-failed");
+		return;
+	}
