        definition("team_stop", "Stop one worker without stopping the interactive room.", {"name": NAME}, ["name"]),
        definition("team_collect", "Collect a committed worker result as evidence without adopting it.", {
            "name": NAME, "output": STRING}, ["name"]),
        definition("team_diff", "Inspect a bounded candidate diff without adopting it.", {"name": NAME}, ["name"]),
        definition("team_test", "Run the campaign's sealed verifier. Supplying command runs a diagnostic that cannot authorize adoption.", {
            "name": NAME, "command": {"type": "array", "items": STRING, "minItems": 1, "maxItems": 256},
            "timeout_seconds": INTEGER}, ["name"]),
