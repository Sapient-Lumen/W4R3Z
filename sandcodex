+static bool sandcodex_emit_tablet_pad_mode(struct wlr_surface *surface,
+        struct wl_client *target_client, uint32_t from_mode,
+        uint32_t to_mode) {
+    struct wlr_tablet_v2_tablet_pad *pad = sandcodex_stylus.pad_v2;
+    if (!surface || !surface->resource || !target_client ||
+            !sandcodex_tablet_pad_mode_index_valid(from_mode) ||
+            !sandcodex_tablet_pad_mode_index_valid(to_mode) ||
+            from_mode == to_mode ||
+            wl_resource_get_client(surface->resource) != target_client ||
+            !wlr_surface_accepts_tablet_v2(surface,
+                sandcodex_stylus.tablet_v2) ||
+            !sandcodex_tablet_pad_idle_at_mode(from_mode)) {
+        return false;
+    }
+    uint32_t time = get_current_time_in_msec();
+    uint32_t enter_serial = wlr_tablet_v2_tablet_pad_notify_enter(pad,
+        sandcodex_stylus.tablet_v2, surface);
+    bool entered = enter_serial != 0 && pad->current_client != NULL &&
+        pad->grab == &pad->default_grab && pad->group_count == 1 &&
+        pad->groups != NULL &&
+        pad->groups[SANDCODEX_TABLET_PAD_MODE_GROUP_INDEX] == from_mode;
+    if (!entered) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    uint32_t mode_serial = wlr_tablet_v2_tablet_pad_notify_mode(pad,
+        SANDCODEX_TABLET_PAD_MODE_GROUP_INDEX, to_mode, time);
+    bool switched = mode_serial != 0 && pad->current_client != NULL &&
+        pad->grab == &pad->default_grab && pad->groups != NULL &&
+        pad->groups[SANDCODEX_TABLET_PAD_MODE_GROUP_INDEX] == to_mode;
+    if (!switched) {
+        if (pad->current_client != NULL) {
+            wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+            pad->current_client = NULL;
+        }
+        return false;
+    }
+    uint32_t leave_serial = wlr_tablet_v2_tablet_pad_notify_leave(pad, surface);
+    /* The synthetic pad has no persistent focus, but its group mode is durable
+     * compositor state. Clear only wlroots' retained current client. */
+    pad->current_client = NULL;
+    return leave_serial != 0 && sandcodex_tablet_pad_idle_at_mode(to_mode);
+}
