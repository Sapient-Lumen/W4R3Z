  case "$SC_COMMAND" in
    login|logout|reauth|auth)
      sc_global_state
      SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'; sc_start_log
      case "$SC_COMMAND" in
        login) sc_login ;;
        logout) sc_logout ;;
        reauth) sc_reauth ;;
        auth) sc_auth_command ;;
      esac
      return
      ;;
    local-runtime)
      SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
      SC_OPERATION="local-$SC_LOCAL_RUNTIME_ACTION"
      sc_global_state
      sc_start_log
      sc_local_runtime_dispatch
      return
      ;;
    remote-catalog)
      SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
      SC_OPERATION="remote-$SC_REMOTE_CATALOG_ACTION"
      sc_global_state
      sc_start_log
      sc_remote_catalog_dispatch
      return
      ;;
    gemini)
      SC_PROJECT='<none>'; SC_PROJECT_KEY='<none>'
      SC_OPERATION="gemini-$SC_GEMINI_ACTION"
      sc_global_state
      sc_start_log
      sc_gemini_dispatch
      return
      ;;
  esac
  if [[ "$SC_COMMAND" == ready ]]; then
    sc_select_project
    sc_global_state
    SC_OPERATION=ready
    sc_ready_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == remote-auto-task ]]; then
    sc_select_project
    sc_global_state
    SC_OPERATION="remote-auto-task"
    sc_remote_auto_task_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == gemini-auto-task ]]; then
    sc_select_project
    sc_global_state
    SC_OPERATION="gemini-auto-task"
    sc_gemini_auto_task_dispatch
    return
  fi
  sc_select_project
  if [[ "$SC_COMMAND" == local-retire ]]; then
    SC_OPERATION=local-retire
    sc_global_state
    sc_acquire_project_lock
    sc_start_log
    sc_local_retire_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == run ]]; then
    sc_validate_operator_declaration
  fi
  if [[ "$SC_COMMAND" == operator ]]; then
    sc_global_state
    sc_start_log
    sc_operator_host_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == campaign ]]; then
    sc_global_state
    sc_start_log
    sc_campaign_host_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == recover ]]; then
    sc_global_state
    sc_recover_detached_loop
    return
  fi
  if [[ "$SC_COMMAND" == state ]]; then
    sc_global_state
    sc_acquire_project_lock
    sc_start_log
    sc_project_state
    sc_state_dispatch
    return
  fi
  if [[ "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" == run && $SC_LOOP_DETACH -eq 1 ]]; then
    sc_global_state
    sc_start_detached_loop
    return
  fi
  if [[ "$SC_COMMAND" == loop && "$SC_LOOP_ACTION" != run ]]; then
    sc_no_symlink_components "$SC_CONTROL" "project control state"
    sc_loop_control_dispatch
    return
  fi
  sc_resource_scope "$@"
  [[ -z "${SANDCODEX_INTERNAL_FOREGROUND_TASK:-}" ]] || \
    sc_die "private foreground-task authority survived the final launcher boundary" 70
  sc_global_state
  sc_acquire_project_lock
  sc_start_log
  if [[ "$SC_COMMAND" == doctor || ( "$SC_COMMAND" == run && $SC_BARE -eq 0 ) || \
    ( "$SC_COMMAND" == loop && $SC_BARE -eq 0 ) ]]; then
    if ! sc_verify_nix_daemon_boundary; then
      sc_log_event error nix_daemon_boundary "$SC_NIX_DAEMON_DETAIL"
      [[ "$SC_COMMAND" == doctor ]] || sc_die "$SC_NIX_DAEMON_DETAIL"
    fi
    sc_prepare_existing_project_state_for_audit
    sc_reclaim_stale_project_browser_sockets
    sc_reclaim_stale_project_scratch_sockets
    sc_project_hygiene
  fi
  sc_project_state
  sc_family_prepare_inference
  sc_discover_browser_host_display
  case "$SC_COMMAND" in
    run)
      if (( SC_BARE )); then sc_run_bare; else sc_run_safe; fi
      ;;
    loop) sc_run_loop ;;
    doctor) sc_doctor ;;
    clean) sc_clean ;;
    *) sc_die "internal command dispatch error: $SC_COMMAND" ;;
  esac
}

sc_providers_reference() {
  cat <<'EOF'
Sandcodex inference providers

  sandcodex                         Ordinary GPT/Codex in the current project
  sandcodex --RESUME [LIST]         Native GPT continuation or picker for this project
  sandcodex --RESUME=SESSION_UUID   Exact GPT thread, after project-identity validation
  sandcodex local MODEL [OPTIONS]   Managed, qualified Ollama beneath the same harness
  sandcodex remote MODEL [OPTIONS]  Qualified Responses-compatible remote API
  sandcodex remote auto [OPTIONS]   Select a free OpenRouter model and usable key
  sandcodex remote auto loop [...]  Run a loop with fresh free-model/key selection
  sandcodex remote auto task [...]  Run one prompt file; optionally resume interactively
  sandcodex remote auto --dry-run   Print selection without launching Codex
  sandcodex gemini auto [OPTIONS]   Start the strongest-first free Gemini router
  sandcodex gemini MODEL [OPTIONS]  Start Codex on one allowlisted free Gemini model
  sandcodex gemini auto loop [...]  Run retrying Gemini turns without leaving a TUI open
  sandcodex gemini auto task [...]  Run one prompt file; optionally resume interactively

  sandcodex local MODEL --RESUME
  sandcodex remote MODEL --RESUME [--provider NAME]
                                    Resume a provider-bound alternate conversation
  sandcodex gemini [auto | MODEL] --RESUME
                                    Resume exact signed Gemini history
  sandcodex local MODEL loop [LOOP-OPTIONS]
                                    Run sequential local turns without a TUI
  sandcodex remote MODEL loop [LOOP-OPTIONS]
                                    Run sequential remote turns without a TUI
  sandcodex gemini [auto | MODEL] loop [LOOP-OPTIONS]
                                    Run sequential Gemini turns with bounded retry

  sandcodex local probe MODEL ...  Qualify a runtime without activation
  sandcodex local update MODEL ... Qualify and activate a Nix-rooted runtime
  sandcodex local rollback [...]   Swap to the previous qualified backend runtime
  sandcodex local status [--json]  Inspect per-user CPU/CUDA runtime channels
  sandcodex local report           Paste-ready host/runtime/local-readiness report
  sandcodex local prune [...]      Release unreachable channel stages and GC roots
  sandcodex local retire UUID ...  Release a deleted local thread's runtime root

  sandcodex remote status [--json] Inspect the private per-user provider catalog
  sandcodex remote models [--free] [--text] [--tools | --agent] [--limit N]
                                  Inspect OpenRouter's free text model bank
  sandcodex remote bench [...]     Score free OpenRouter coding candidates
  sandcodex remote continuity      Print the no-secret handoff/resume/worker card
  sandcodex remote router status  Inspect the bound pre-visible failover relay
  sandcodex remote quota [--json]  Inspect OpenRouter key/free-model quota
  sandcodex remote keys [...]      Inspect the trusted OpenRouter key bank
  sandcodex gemini status          Inspect Google AI Studio key-bank readiness
  sandcodex gemini report          Paste-ready Gemini adapter/key/route readiness card
  sandcodex gemini continuity      Print the no-secret launch/resume/worker handoff card
  sandcodex gemini router status   Inspect account rotation and model-fallback semantics
  sandcodex gemini quota           Inspect local cooldown/route availability facts
  sandcodex gemini keys status     Inspect the trusted Gemini key bank
  sandcodex gemini keys add ...    Securely add one Google AI Studio key
  sandcodex gemini keys remove ... Remove one key by exact label or short ID
  sandcodex gemini keys test       Prove bank keys without exposing them
  sandcodex gemini models          List Gemini API models without printing key values
  sandcodex gemini probe           Prove one free model through the key bank
  sandcodex gemini qualify         Qualify free Interactions text/tool/signature seams
  sandcodex gemini cooldowns       Inspect Gemini credential/model cooldowns
  sandcodex remote configure NAME --base-url URL --env-key ENV [--default]
  sandcodex remote default NAME    Select the provider used when --provider is omitted
  sandcodex remote remove NAME     Remove one non-default custom provider
  sandcodex doctor                 Whole-harness and inference-readiness diagnostic

Local options: --backend auto|cuda|cpu, --cpu, --no-pull, --local-context TOKENS,
--local-threads N, --local-memory-mib MIB, --local-model-digest SHA256,
--local-ollama-bin PATH.
Managed local mode is safe-boundary only. It checks exact model digest, advertised
and loaded context, CPU/GPU placement, Responses instructions, and strict
tool calls. Runtime parameters become part of a derived, digest-checked Ollama
profile; bound resume never pulls, recreates, downgrades, retunes, changes backend,
or silently falls back to cloud.

Pinned CPU reference: qwen3:4b-instruct-2507-q4_K_M at 8192 tokens and four
runner threads. Sandcodex requires its embedded source and derived-profile digests
automatically when this exact retrieval tag uses the default thread profile.
Use `sandcodex local status` as the quick readiness card and
`sandcodex local report` as the paste-back diagnostic. Both run before the
pinned Nix shell is realized, so asking "what is ready?" does not fetch or build
the world. `--json` on status remains the exact machine contract.

GTX-1650 coding candidate: hf.co/unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:UD-Q4_K_XL
is intentionally not enforced as a reference until target-machine qualification
captures real digests. The readiness card prints the first-proof command and the
later activation command with an 8192-token context and a 24576 MiB
managed-runtime memory envelope. Prefer `local probe ... --local-ollama-bin
PATH` before any reproducible CUDA channel activation, because
`nixpkgs#ollama-cuda` may be a large local build on machines without substitutes.

Interactive managed-local, remote, and Gemini rooms authorize four concurrent
staged workers by default. The foreground agent orchestrates them with
sandcodex-team, its role-scoped MCP server, or the compatible
SANDCODEX_CAMPAIGN helper while the TUI remains live. Local foreman and workers
share the exact parent Ollama process; inference requests queue under
num_parallel=1, but their tool work can overlap. Remote foreman and worker share
a sealed Responses endpoint snapshot and copied credential; scheduling remains
provider-defined. Gemini foreman and workers share the parent-owned qualified
adapter, free-tier-model-only route, and exact signed-step continuation
contract. Every worker lives in an independent clean Git clone. Diff, test,
stage, collection, and completion never merge; only explicit adopt can change a
clean primary checkout. --no-companion-campaigns disables it.

Runtime maintenance is per Unix user and affects only future fresh local threads.
Update, rollback, and prune are serialized. Prune never removes a project-bound
runtime root and never runs whole-store Nix GC. Retire requires native hard deletion,
preserves the immutable thread binding, and releases only an unshared exact root.

Remote --provider NAME resolves a private per-user descriptor; openai_api is the
built-in default and openrouter is the built-in OpenRouter descriptor. Catalogs
contain endpoint and credential-variable names only.
Credential names must end in _API_KEY, _TOKEN, or _SECRET. Values are copied to
trusted frontend state, removed from the launch environment, and never appear in
catalogs, config literals, receipts, argv, project files, or launcher logs.
`sandcodex remote models` reads OpenRouter's public model metadata and defaults
to zero-price text-output candidates. Add --qualify to run the same bounded
Responses streaming + strict function-call probe Sandcodex uses before launch;
probes are sequential and cache their receipts rather than attempting to bypass
provider rate limits.
`sandcodex remote auto` uses the trusted OpenRouter key bank, current free model
metadata, key quota facts, and cached/live qualification receipts to choose the
strongest available model and live usable key before starting a fresh interactive room.
Add --dry-run or --select-only to run the same selection and print a redacted
receipt without starting Codex or retaining a bootstrap credential.
Use --profile coding, long-context-reading, fast-cheap-worker, tool-reliable, or
fallback to bias fresh auto selection and remote-auto workers. `remote auto task`
is the paste-safe first-turn lane: it runs one prompt from a file through the
loop harness and, with --then-interactive, immediately resumes the bound thread
in the TUI.

`sandcodex gemini` is a complete Codex backend built on Google AI Studio's stable
Gemini Interactions v1 API. It is deliberately free-tier-model-only: paid-only
routes and `--allow-paid` are rejected, and only Sandcodex's reviewed Flash text
allowlist can enter the route.
The default trusted bank is ~/.sandstuff/sandcodex/remote/gemini-keys.txt, one
key per line or LABEL=KEY. Use `gemini keys add --key-label NAME` for a hidden
terminal prompt, or explicitly select `--stdin` / `--from-file FILE`; remove a
credential by exact label or printed short ID. Mutations lock, validate, and
atomically replace the mode-0600 single-link bank, and receipts never contain
credential values. `gemini keys test` makes one tiny free-model request per
selected key and prints only its label, short identifier, HTTP outcome, and
safe cooldown facts; it never prints provider output or credential material.
The intended deployment has five separately owned accounts. Add one labeled
key for each account (for example `account-1` through `account-5`) and launch
without `--key-label` so the complete bank participates in automatic rotation.
The host-side, digest-bound adapter translates the OpenAI Responses protocol
expected by Codex into stateless Interactions requests. It preserves Google's
opaque thought signatures and complete model/tool steps, so normal interactive
use, exact resume, loops, first-turn tasks, MCP/function/custom tools, native
Codex subagents, browser/desktop tools, and concurrent companion workers stay in
the ordinary Sandcodex harness. Raw Google keys never enter the command room or
worker clone; Codex receives only a random loopback bearer token.

`gemini auto` buffers an upstream interaction before exposing semantic Responses
events. Its primary goal is seamless use of the available free capacity across
the five-account bank. Each new logical request atomically starts with the
least-scheduled account that has a usable candidate route, using trusted
content-free counters shared across rooms and workers. It then tries the
strongest allowlisted model across healthy keys with bank-order wraparound. A
project-wide quota/rate failure cools that account key; a model-specific failure
cools only that account/model
pair; authentication or permission failure also cools the affected key. The
same buffered request immediately rotates to the next healthy account key on
the same model. Only after every usable account route for that model is cooling
does auto mode descend to the next qualified free model.

The same account rotation applies when a signed function call is pending. The
adapter resends the complete exact Interactions history with the next account
key on the originating model; if necessary, it then carries that history to the
next ranked model. The loop and worker supervisors classify quota and
transient failures and retry whole clean Codex turns without duplicating a
visible tool call. An already-running TUI is never silently retargeted, and a
partially visible stream is never replayed.

If every eligible route is cooling down, that still-buffered request waits up
to 240 seconds by default. The adapter honors bounded Retry-After and Google
RetryInfo hints, wakes for the earliest eligible route, and stops on downstream
disconnect. Use --route-wait-seconds N for a 0-3600 second ceiling or
--no-route-wait for immediate failure. Identical Codex transport retries share
the first request's opaque-digest window instead of receiving a fresh wait, and
all model attempts share one aggregate request deadline. Candidate count and
retry count therefore cannot multiply the advertised ceiling. No prompt or
request bytes are retained in that retry ledger. This wait never crosses
visible output; pending signed tool calls may migrate only with exact provider
history and before any response from that logical request becomes visible.

`gemini qualify` runs five bounded live requests proving streaming text, strict
function calling, signed stateless function-result continuation, multimodal
structured output, and exact parallel calls. Its offline protocol matrix also
proves image/audio/PDF input, custom apply_patch, namespaced MCP, deferred tool
search, namespaced tool choice, exact signed-step replay, semantic-pair tamper
rejection, adapter restart, cooldown scheduling, branch-local schema
normalization, and strongest-model-first account/key rotation.
Offline qualification proves strongest-model-first account/key ordering and
quota-driven rotation before model downgrade. It also proves that independent
adapter processes share least-scheduled-account assignments and that positive
route success heals only matching stale cooldowns. The five live probes use
the same shared scheduler, while any quota, rate, authentication, or permission
failure can move a probe to the next banked account.
Qualification receipts
bind the adapter digest, model route, API revision, and pinned Codex version.
Each of the five intended keys represents a separately owned account/project;
the bank and cooldown ledger let Sandcodex consume their available free routes
as one ordered pool. Native Google Search is intentionally disabled on the free lane;
Sandcodex's reviewed browser/MCP surface remains available instead.

A Gemini binding retains the exact adapter bytes, provider snapshot, and
qualification receipt. Resume after a launcher upgrade accepts only a finite
known historical qualification contract and restores that exact artifact; it
does not silently requalify or retarget old signed history through the current
adapter. Features absent from a historical adapter remain absent on its resume.

Fresh local, remote, and Gemini threads receive immutable per-thread provider
bindings after their first durable user/assistant event. Alternate-provider
continuation requires the same explicit namespace and a valid binding.
Sandcodex validates only a bounded native rollout identity prefix; Codex owns
the potentially multi-gigabyte transcript body and the ordinary GPT picker. No
resume operation updates provider software.
EOF
}

sc_parse_provider_mode() {
  SC_PROVIDER_MODE=$1; SC_PROVIDER_MODE_EXPLICIT=1; SC_HELP_TOPIC=$1; shift
  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    case "${1:-}" in
      probe|update|rollback|status|report|prune)
        local maintenance_action=$1; shift
        sc_parse_local_runtime_maintenance "$maintenance_action" "$@"
        return
        ;;
      retire)
        shift
        sc_parse_local_retire "$@"
        return
        ;;
    esac
  elif [[ "$SC_PROVIDER_MODE" == remote ]]; then
    case "${1:-}" in
      auto)
        shift
        SC_REMOTE_AUTO=1
        SC_REMOTE_NAME=openrouter
        SC_MODEL="openrouter/free"
        SC_MODEL_SET=1
        local -a auto_normal=()
        while (( $# )); do
          if [[ "$1" == loop || "$1" == task ]]; then
            auto_normal+=("$@")
            break
          fi
          case "$1" in
            --key-bank|--openrouter-keys)
              (( $# > 1 )) || sc_usage_error "$1 requires FILE"
              SC_REMOTE_KEYBANK_PATH=$2; shift 2 ;;
            --key-bank=*|--openrouter-keys=*) SC_REMOTE_KEYBANK_PATH=${1#*=}; shift ;;
            --dry-run|--select-only|--plan)
              SC_REMOTE_AUTO_DRY_RUN=1; shift ;;
            --profile)
              (( $# > 1 )) || sc_usage_error "--profile requires NAME"
              sc_remote_profile_valid "$2" || sc_usage_error "$(sc_remote_profile_usage)"
              SC_REMOTE_PROFILE=$2; shift 2 ;;
            --profile=*)
              sc_remote_profile_valid "${1#*=}" || sc_usage_error "$(sc_remote_profile_usage)"
              SC_REMOTE_PROFILE=${1#*=}; shift ;;
            --json)
              SC_REMOTE_CATALOG_JSON=1; SC_QUIET=1; shift ;;
            --provider)
              (( $# > 1 )) || sc_usage_error "--provider requires NAME"
              [[ "$2" == openrouter ]] || sc_usage_error "remote auto currently supports only --provider openrouter"
              shift 2 ;;
            --provider=*)
              [[ "${1#*=}" == openrouter ]] || sc_usage_error "remote auto currently supports only --provider openrouter"
              shift ;;
            -m|--model|-m=*|--model=*)
              sc_usage_error "remote auto selects the model from the OpenRouter bank; do not supply --model" ;;
            *) auto_normal+=("$1"); shift ;;
          esac
        done
        if (( SC_REMOTE_CATALOG_JSON && ! SC_REMOTE_AUTO_DRY_RUN )); then
          sc_usage_error "remote auto --json is available only with --dry-run"
        fi
        if [[ "${auto_normal[0]:-}" == loop ]]; then
          SC_COMMAND=loop
          sc_parse_loop "${auto_normal[@]:1}"
        elif [[ "${auto_normal[0]:-}" == task ]]; then
          sc_parse_remote_auto_task "${auto_normal[@]:1}"
        else
          sc_parse_run "${auto_normal[@]}"
        fi
        return
        ;;
      status|configure|default|remove|models|bench|report|continuity|router|quota|keys)
        local maintenance_action=$1; shift
        sc_parse_remote_catalog_maintenance "$maintenance_action" "$@"
        return
        ;;
    esac
  fi
  case "${1:-}" in
    ''|-h|--help|help) sc_help_topic "$SC_PROVIDER_MODE"; exit 0 ;;
    sessions|probe|update|rollback|status|report|prune|retire|configure|default|remove|doctor)
      sc_usage_error "sandcodex $SC_PROVIDER_MODE $1 is not a supported provider-maintenance command (use sandcodex doctor)" ;;
  esac
  [[ "$1" != -* ]] || sc_usage_error "$SC_PROVIDER_MODE requires MODEL before options"
  SC_MODEL=$1; SC_MODEL_SET=1; shift
  # Keep GPT defaults unchanged. Alternate inference starts with one primary
  # agent and a four-worker staged team by default; local shares a serialized Ollama
  # runtime, while remote receives a snapshot-bound credential capability.
  SC_SUBAGENTS=0
  if [[ "$SC_PROVIDER_MODE" == local || "$SC_PROVIDER_MODE" == remote ]]; then
    SC_CAMPAIGN_MAX_COUNT="$SC_CAMPAIGN_DEFAULT_MAX_COUNT"
  fi
  if [[ "$SC_PROVIDER_MODE" == local ]]; then
    SC_LOCAL_REQUESTED_MODEL=$SC_MODEL
    SC_LOCAL_PROVIDER=ollama; SC_LOCAL_PROVIDER_SOURCE=cli
  fi
  local -a normal=()
  while (( $# )); do
    case "$1" in
      --) normal+=("$@"); break ;;
      --backend)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--backend requires local and a value"
        SC_LOCAL_BACKEND=$2; SC_LOCAL_BACKEND_EXPLICIT=1; shift 2 ;;
      --backend=*) [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--backend is local-only"; SC_LOCAL_BACKEND=${1#*=}; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
      --cpu) [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--cpu is local-only"; SC_LOCAL_BACKEND=cpu; SC_LOCAL_BACKEND_EXPLICIT=1; shift ;;
      --no-pull) [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--no-pull is local-only"; SC_LOCAL_PULL=0; shift ;;
      --local-context)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--local-context requires local and TOKENS"
        SC_LOCAL_CONTEXT_TOKENS=$2; SC_LOCAL_CONTEXT_EXPLICIT=1; shift 2 ;;
      --local-context=*)
        [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--local-context is local-only"
        SC_LOCAL_CONTEXT_TOKENS=${1#*=}; SC_LOCAL_CONTEXT_EXPLICIT=1; shift ;;
      --local-threads)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--local-threads requires local and N"
        SC_LOCAL_THREADS=$2; SC_LOCAL_THREADS_EXPLICIT=1; shift 2 ;;
      --local-threads=*)
        [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--local-threads is local-only"
        SC_LOCAL_THREADS=${1#*=}; SC_LOCAL_THREADS_EXPLICIT=1; shift ;;
      --local-memory|--local-memory-mib)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--local-memory-mib requires local and MIB"
        SC_LOCAL_MEMORY_MIB=$2; SC_LOCAL_MEMORY_EXPLICIT=1; shift 2 ;;
      --local-memory=*|--local-memory-mib=*)
        [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--local-memory-mib is local-only"
        SC_LOCAL_MEMORY_MIB=${1#*=}; SC_LOCAL_MEMORY_EXPLICIT=1; shift ;;
      --local-ollama-bin)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--local-ollama-bin requires local and PATH"
        sc_set_local_ollama_bin_cli "$2"; shift 2 ;;
      --local-ollama-bin=*)
        [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--local-ollama-bin is local-only"
        sc_set_local_ollama_bin_cli "${1#*=}"; shift ;;
      --local-model-digest)
        [[ "$SC_PROVIDER_MODE" == local && $# -gt 1 ]] || sc_usage_error "--local-model-digest requires local and SHA256"
        SC_LOCAL_MODEL_DIGEST=$2; SC_LOCAL_MODEL_DIGEST_EXPLICIT=1; shift 2 ;;
      --local-model-digest=*)
        [[ "$SC_PROVIDER_MODE" == local ]] || sc_usage_error "--local-model-digest is local-only"
        SC_LOCAL_MODEL_DIGEST=${1#*=}; SC_LOCAL_MODEL_DIGEST_EXPLICIT=1; shift ;;
      --provider)
        [[ "$SC_PROVIDER_MODE" == remote && $# -gt 1 ]] || sc_usage_error "--provider requires remote and a name"
        SC_REMOTE_NAME=$2; shift 2 ;;
      --provider=*) [[ "$SC_PROVIDER_MODE" == remote ]] || sc_usage_error "--provider is remote-only"; SC_REMOTE_NAME=${1#*=}; shift ;;
      --model|--model=*|-m|-m=*|--local-model|--local-model=*|--local-provider|--local-provider=*|--local-qualification|--local-qualification=*)
        sc_usage_error "provider mode and MODEL are already selected; do not supply conflicting selectors" ;;
      *) normal+=("$1"); shift ;;
    esac
  done
  case "$SC_LOCAL_BACKEND" in auto|cuda|cpu) ;; *) sc_usage_error "--backend requires auto, cuda, or cpu" ;; esac
  [[ -z "$SC_REMOTE_NAME" || "$SC_REMOTE_NAME" =~ ^[A-Za-z0-9_-]{1,48}$ ]] || sc_usage_error "invalid provider name"
  if [[ "${normal[0]:-}" == loop ]]; then
    SC_COMMAND=loop
    sc_parse_loop "${normal[@]:1}"
  else
    sc_parse_run "${normal[@]}"
  fi
  [[ "$SC_PROVIDER_MODE" != remote || -z "$SC_LOCAL_PROVIDER" ]] || sc_usage_error "remote and local cannot be combined"
}

sc_remote_catalog_help() {
  cat <<'EOF'
Sandcodex remote provider catalog

  sandcodex remote status [--json]
  sandcodex remote models [--free | --all] [--text] [--tools | --agent]
                           [--limit N] [--save] [--qualify [--force]] [--key-bank FILE] [--sleep N] [--json]
  sandcodex remote bench [--limit N] [--force] [--save] [--key-bank FILE] [--sleep N] [--json]
  sandcodex remote report [--key-bank FILE] [--quota] [--json]
  sandcodex remote continuity [--key-bank FILE] [--quota] [--json]
  sandcodex remote router [status] [--json]
  sandcodex remote quota [--json]
  sandcodex remote keys [path | status | quota] [--key-bank FILE] [--json]
  sandcodex remote auto [--key-bank FILE] [--profile NAME] [RUN-OPTIONS]
  sandcodex remote auto task --prompt-file PATH [--then-interactive] [RUN-OPTIONS]
  sandcodex remote configure NAME --base-url URL --env-key ENV [--default] [--json]
  sandcodex remote default NAME [--json]
  sandcodex remote remove NAME [--json]

The catalog is private per-user state. It stores provider names, HTTPS base URLs,
and credential environment-variable names. It never stores or prints credential
values and does not contact an endpoint. Existing project snapshots and bound
conversations remain immutable when the catalog changes.

`remote models` is OpenRouter-specific model-bank discovery. It reads the public
https://openrouter.ai/api/v1/models metadata endpoint, filters to zero-price
text-output models by default, and can write a private snapshot with --save.
--tools requires advertised client-tool support. --agent additionally requires
advertised tool_choice support, which is the minimum catalog shape used by
remote auto and the forced-tool coding bench.
With --qualify it tests each selected model through Sandcodex's existing
Responses streaming, strict-tool-call, and exact stateless tool-result
continuation qualification sequentially. It uses
OPENROUTER_API_KEY when exported, or the trusted OpenRouter key bank when
--key-bank is supplied or the default bank exists.
--force makes every qualification live instead of accepting a cached receipt.
`remote bench` runs the free, text-output, tool-capable bank through a small
deterministic coding obstacle course and ranks by bench score before the
metadata heuristic. It caches per-model receipts; --force spends fresh requests.
`remote report` prints one paste-back-safe operator card for the key bank, saved
model bank, latest coding bench, current auto-selection, and failure receipts;
--quota adds authenticated live key checks without disclosing credential values.
`remote continuity` prints the no-secret remote handoff card: exact safe
commands for fresh remote-auto launch, bound resume, worker doctor/start/status/
events/collect, plus the honest list of which model/key switches are automatic
today and the remaining commit-point limits.
`remote router status` is side-effect-free. Every remote-auto room and worker
uses an owned loopback Responses relay bound into conversation identity. The
relay targets OpenRouter's `/api/v1/responses`, buffers a complete validated
response, preserves reviewed tool/call identities, and may retry another
bound model/account route only before response headers or bytes reach
Codex. This makes live-request failover safe but delays incremental token
display. It never retries after visible output and never replaces a bound
conversation's sealed relay artifact or model/key banks.
`remote keys` inspects that bank without printing values. `remote quota` reads a
single exported key's authenticated /api/v1/key card; `remote keys quota` checks
the bank. `remote auto` picks one free model from the ranked bank, performs a
fresh bounded probe with one usable key, and starts a fresh interactive room
with that sealed selection. `remote auto task` runs a first prompt from a file
through the same loop harness and can immediately resume the bound room with
--then-interactive. Profiles are deterministic selection preferences:
coding, long-context-reading, fast-cheap-worker, tool-reliable, and fallback.
Cooldown state skips recently rate-limited keys/models for fresh auto selection.
None of these commands creates accounts or bypasses provider rate limits.

Built-ins cannot be redirected or removed:

  openai_api    https://api.openai.com/v1       OPENAI_API_KEY
  openrouter    https://openrouter.ai/api/v1    OPENROUTER_API_KEY

To remove a custom default provider, first select another default.
EOF
}

