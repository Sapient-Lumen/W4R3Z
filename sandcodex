+static bool sandcodex_capture_keyboard_target(struct sway_seat *seat,
+		struct sandcodex_hit_target *target, struct sway_view **view_out,
+		struct wlr_surface **view_surface_out,
+		struct wlr_surface **focused_surface_out) {
+	memset(target, 0, sizeof(*target));
+	if (view_out) {
+		*view_out = NULL;
+	}
+	if (view_surface_out) {
+		*view_surface_out = NULL;
+	}
+	if (focused_surface_out) {
+		*focused_surface_out = NULL;
+	}
+	if (!seat || !seat->wlr_seat || seat->focused_layer ||
+			seat->has_exclusive_layer || server.session_lock.lock ||
+			!sandcodex_input_method_grab_absent(seat) ||
+			!sandcodex_keyboard_default_route(seat, 0, 0, 0)) {
+		return false;
+	}
+
+	struct wlr_surface *focused =
+		seat->wlr_seat->keyboard_state.focused_surface;
+	struct sway_container *container = seat_get_focused_container(seat);
+	struct sway_view *view = container ? container->view : NULL;
+	if (!focused || !focused->resource || !view || view->pid <= 0 ||
+			!view->surface || !view->surface->resource ||
+			container->node.id == 0 || container->node.id > (size_t)INT64_MAX ||
+			wlr_surface_get_root_surface(focused) != view->surface) {
+		return false;
+	}
+	struct wl_client *focused_client = wl_resource_get_client(focused->resource);
+	struct wl_client *view_client = wl_resource_get_client(view->surface->resource);
+	if (!focused_client || focused_client != view_client) {
+		return false;
+	}
+
+	pid_t client_pid = 0;
+	uid_t client_uid = 0;
+	gid_t client_gid = 0;
+	wl_client_get_credentials(focused_client, &client_pid, &client_uid,
+		&client_gid);
+	uint32_t resource_id = wl_resource_get_id(focused->resource);
+	if (client_pid <= 0 || resource_id == 0) {
+		return false;
+	}
+
+	target->hit = true;
+	target->surface_hit = true;
+	target->surface_toplevel = focused == view->surface;
+	target->container_id = (int64_t)container->node.id;
+	target->view_pid = (int64_t)view->pid;
+	target->surface_resource_id = (int64_t)resource_id;
+	target->surface_client_pid = (int64_t)client_pid;
+	target->surface_client_uid = (int64_t)client_uid;
+	target->surface_client_gid = (int64_t)client_gid;
+	target->view_surface_address = (uintptr_t)view->surface;
+	target->target_surface_address = (uintptr_t)focused;
+	if (view_out) {
+		*view_out = view;
+	}
+	if (view_surface_out) {
+		*view_surface_out = view->surface;
+	}
+	if (focused_surface_out) {
+		*focused_surface_out = focused;
+	}
+	return true;
+}
