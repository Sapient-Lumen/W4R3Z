sc_clear_external_frontend_account_state() {
  local codex_home="$SC_CONTROL/codex-home" path
  local -a files=(
    "$codex_home/auth.json"
    "$codex_home/models_cache.json"
    "$SC_CONTROL/auth-source.sha256"
  )
  local -a directories=(
    "$codex_home/cache/codex_app_directory"
    "$codex_home/cache/codex_apps_server_info"
    "$codex_home/cache/codex_apps_tools"
  )
  for path in "${files[@]}"; do
    sc_validate_optional_auth_file "$path" "external-provider account cache"
  done
  for path in "${directories[@]}"; do
    sc_validate_optional_auth_dir "$path" "external-provider connector cache"
  done
  rm -f -- "${files[@]}"
  rm -rf -- "${directories[@]}"
}

sc_seed_auth() {
  if ! sc_frontend_requires_openai_auth; then
    # An external/local provider authenticates through its own reviewed seam.
    # A stale OpenAI token only triggers irrelevant refresh and connector
    # failures, so discard the disposable project copy while preserving the
    # trusted global login for future native launches.
    sc_clear_external_frontend_account_state
    return 0
  fi
  local source target marker source_hash imported_hash="" tmp
  source="$(sc_auth_path)"; target="$SC_CONTROL/codex-home/auth.json"; marker="$SC_CONTROL/auth-source.sha256"
  sc_valid_auth "$source" || sc_die "no valid Sandcodex login; run: sandcodex login"
  source_hash="$(sha256sum -- "$source" | awk '{print $1}')"
  [[ ! -f "$marker" || -L "$marker" ]] || imported_hash="$(sed -n 1p "$marker")"
  if ! sc_valid_auth "$target" || [[ "$imported_hash" != "$source_hash" ]]; then
    tmp="$(mktemp "$SC_CONTROL/codex-home/.auth.seed.XXXXXX")"
    cp -- "$source" "$tmp"; chmod 600 "$tmp"; mv -fT -- "$tmp" "$target"
    printf '%s\n' "$source_hash" | sc_atomic "$marker" 600
    sc_log_event info auth_seed "project authentication seeded" "project_key=$SC_PROJECT_KEY"
  fi
}

sc_login() {
  SC_OPERATION=login
  local -a args=()
  if (( ${#SC_CODEX_ARGS[@]} == 1 )); then
    case "${SC_CODEX_ARGS[0]}" in
      --device) args=(--device-auth) ;;
      --api-key) args=(--with-api-key) ;;
      --access-token) args=(--with-access-token) ;;
      -h|--help) printf 'Usage: sandcodex login [--device | --api-key | --access-token]\n'; return ;;
      *) sc_usage_error "unknown login option: ${SC_CODEX_ARGS[0]}" ;;
    esac
  elif (( ${#SC_CODEX_ARGS[@]} > 1 )); then
    sc_usage_error "login accepts at most one mode"
  fi
  sc_clear_account_caches
  sc_note "host-side login · credentials stay under $SC_GLOBAL/auth-home"
  sc_log_event info login_start "starting host-side Codex login" "mode=${args[*]:-browser}"
  sc_global_auth_codex login "${args[@]}"
  sc_valid_auth "$(sc_auth_path)" || sc_die "login returned without a valid file credential cache"
  sc_clear_account_caches
  sc_mark_auth_active
  sc_ok "login stored in trusted Sandcodex state"
}

sc_validate_optional_auth_file() {
  local path="$1" label="$2"
  [[ -e "$path" || -L "$path" ]] || return 0
  sc_no_symlink_components "$path" "$label"
  sc_owned_single_file "$path" "" "$label"
}

sc_validate_optional_auth_dir() {
  local path="$1" label="$2"
  [[ -e "$path" || -L "$path" ]] || return 0
  sc_no_symlink_components "$path" "$label"
  sc_owned_dir "$path" "$label"
}

sc_prepare_auth_cleanup() {
  local scope="$1"
  local -n homes_ref=$2
  local -n controls_ref=$3
  local control codex_home base path
  homes_ref=("$SC_GLOBAL/auth-home")
  controls_ref=()
  sc_no_symlink_components "$SC_GLOBAL/auth-home" "authentication cleanup root"
  sc_owned_dir "$SC_GLOBAL/auth-home" "authentication cleanup root"
  sc_no_symlink_components "$SC_GLOBAL/projects" "project authentication cleanup root"
  sc_owned_dir "$SC_GLOBAL/projects" "project authentication cleanup root"
  sc_assert_no_mounts_at_or_below "$SC_GLOBAL/auth-home" 1 "authentication cleanup root"
  sc_assert_no_mounts_at_or_below "$SC_GLOBAL/projects" 1 "project authentication cleanup root"
  while IFS= read -r -d '' control; do
    base="${control##*/}"
    [[ "$base" =~ ^[0-9a-f]{64}$ ]] || \
      sc_die "project authentication cleanup found an invalid control entry: $control"
    sc_no_symlink_components "$control" "project authentication control"
    sc_owned_dir "$control" "project authentication control"
    controls_ref+=("$control")
    codex_home="$control/codex-home"
    if [[ -e "$codex_home" || -L "$codex_home" ]]; then
      sc_no_symlink_components "$codex_home" "project authentication home"
      sc_owned_dir "$codex_home" "project authentication home"
      homes_ref+=("$codex_home")
    fi
  done < <(find -P "$SC_GLOBAL/projects" -mindepth 1 -maxdepth 1 -print0)
  for codex_home in "${homes_ref[@]}"; do
    sc_validate_optional_auth_file "$codex_home/models_cache.json" "account model cache"
    sc_validate_optional_auth_dir "$codex_home/cache" "account cache root"
    for path in codex_app_directory codex_apps_server_info codex_apps_tools; do
      sc_validate_optional_auth_dir "$codex_home/cache/$path" "account connector cache"
    done
    if [[ "$scope" == all ]]; then
      sc_validate_optional_auth_file "$codex_home/auth.json" "authentication cache"
      sc_validate_optional_auth_file "$codex_home/.credentials.json" "MCP credential cache"
      sc_validate_optional_auth_dir "$codex_home/mcp-oauth-locks" "MCP OAuth lock root"
    fi
  done
  if [[ "$scope" == all ]]; then
    for control in "${controls_ref[@]}"; do
      sc_validate_optional_auth_file "$control/auth-source.sha256" "project authentication marker"
    done
  fi
}

sc_remove_account_caches() {
  local -n cache_homes_ref=$1
  local codex_home
  for codex_home in "${cache_homes_ref[@]}"; do
    rm -f -- "$codex_home/models_cache.json"
    rm -rf -- "$codex_home/cache/codex_app_directory" \
      "$codex_home/cache/codex_apps_server_info" \
      "$codex_home/cache/codex_apps_tools"
  done
}

sc_clear_account_caches() {
  local -a homes=() controls=()
  sc_prepare_auth_cleanup account homes controls
  sc_remove_account_caches homes
}

sc_validate_auth_cleanup() {
  local -a homes=() controls=()
  sc_prepare_auth_cleanup all homes controls
}

sc_clear_auth_state() {
  local codex_home control
  local -a homes=() controls=()
  sc_prepare_auth_cleanup all homes controls
  for codex_home in "${homes[@]}"; do
    rm -f -- "$codex_home/auth.json" "$codex_home/.credentials.json"
    rm -rf -- "$codex_home/mcp-oauth-locks"
  done
  for control in "${controls[@]}"; do rm -f -- "$control/auth-source.sha256"; done
  sc_remove_account_caches homes
  sc_mark_auth_logged_out
}

sc_reconcile_frontend_auth() {
  sc_frontend_requires_openai_auth || return 0
  local source target marker source_hash target_hash
  target="$SC_CONTROL/codex-home/auth.json"
  marker="$SC_CONTROL/auth-source.sha256"
  [[ -f "$marker" && ! -L "$marker" ]] || return 0
  sc_owned_single_file "$marker" 600 "project authentication marker"
  if [[ ! -e "$target" && ! -L "$target" ]]; then
    sc_clear_auth_state
    SC_FRONTEND_LOGOUT=1
    sc_log_event info frontend_logout "propagated Codex frontend logout to trusted authentication state"
    sc_ok "Codex logout propagated to Sandcodex"
    return 0
  fi
  if ! sc_valid_auth "$target"; then
    sc_warn "Codex left an invalid project credential copy; trusted authentication was not replaced"
    sc_log_event warn frontend_auth_invalid "project credential copy was not eligible for promotion"
    return 0
  fi
  source="$(sc_auth_path)"
  target_hash="$(sha256sum -- "$target" | awk '{print $1}')"
  source_hash=""
  sc_valid_auth "$source" && source_hash="$(sha256sum -- "$source" | awk '{print $1}')"
  if [[ "$target_hash" != "$source_hash" ]]; then
    sc_atomic "$source" 600 <"$target"
    printf '%s\n' "$target_hash" | sc_atomic "$marker" 600
    sc_log_event info auth_refresh "promoted refreshed frontend authentication to trusted state"
  fi
}

sc_ensure_auth() {
  sc_frontend_requires_openai_auth || return 0
  local path candidate old_operation mode=browser auto_import=1
  local -a saved_args=("${SC_CODEX_ARGS[@]}")
  path="$(sc_auth_path)"
  if sc_valid_auth "$path"; then return 0; fi
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ -f "$path" && ! -L "$path" && "$(stat -c %u -- "$path")" == "$(id -u)" && \
      "$(stat -c %h -- "$path")" == 1 && "$(stat -c %s -- "$path")" -le "$SC_AUTH_MAX_BYTES" ]]; then
      chmod 600 -- "$path"
      if sc_valid_auth "$path"; then
        sc_log_event info auth_repair "normalized trusted authentication permissions"
        return 0
      fi
    fi
    sc_die "trusted authentication cache is unsafe or invalid; run 'sandcodex logout', then retry"
  fi
  sc_auth_auto_import_disabled && auto_import=0
  candidate="$SC_REAL_HOME/.codex/auth.json"
  if (( auto_import )) && [[ -f "$candidate" && ! -L "$candidate" && \
    "$(stat -c %u -- "$candidate")" == "$(id -u)" && \
    "$(stat -c %h -- "$candidate")" == 1 && \
    "$(stat -c %s -- "$candidate")" -le "$SC_AUTH_MAX_BYTES" ]] && \
    jq -e 'type == "object" and length > 0' "$candidate" >/dev/null 2>&1; then
    sc_note "first run · importing existing Codex authentication"
    sc_import_auth "$candidate"
    return 0
  fi
  if [[ "${SANDCODEX_TESTING:-0}" != 1 && ! -t 0 && \
    ( ! -r /dev/tty || ! -w /dev/tty ) ]]; then
    sc_die "first-run authentication needs a terminal; run 'sandcodex login --device' interactively"
  fi
  if [[ -n "${SSH_CONNECTION:-}" || ( -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ) ]]; then
    mode=device
    SC_CODEX_ARGS=(--device)
  else
    SC_CODEX_ARGS=()
  fi
  old_operation="$SC_OPERATION"
  sc_note "first run · starting host-side $mode authentication"
  sc_login
  SC_CODEX_ARGS=("${saved_args[@]}")
  SC_OPERATION="$old_operation"
}

sc_logout() {
  SC_OPERATION=logout
  if (( ${#SC_CODEX_ARGS[@]} == 1 )) && [[ "${SC_CODEX_ARGS[0]}" == -h || "${SC_CODEX_ARGS[0]}" == --help ]]; then
    printf 'Usage: sandcodex logout\n'
    return
  fi
  (( ${#SC_CODEX_ARGS[@]} == 0 )) || sc_usage_error "logout takes no arguments"
  local provider_rc=0
  sc_validate_auth_cleanup
  sc_global_auth_codex logout >/dev/null 2>&1 || provider_rc=$?
  sc_clear_auth_state
  if (( provider_rc != 0 )); then
    sc_warn "Codex logout returned status $provider_rc; Sandcodex removed every local credential copy anyway"
  fi
  sc_log_event info logout "global and per-project auth copies removed"
  sc_ok "Sandcodex authentication removed"
}

sc_reauth() {
  SC_OPERATION=reauth
  local provider_rc=0
  if (( ${#SC_CODEX_ARGS[@]} == 1 )) && [[ "${SC_CODEX_ARGS[0]}" == -h || "${SC_CODEX_ARGS[0]}" == --help ]]; then
    printf 'Usage: sandcodex reauth [--device | --api-key | --access-token]\n'
    return
  fi
  if (( ${#SC_CODEX_ARGS[@]} == 1 )); then
    case "${SC_CODEX_ARGS[0]}" in
      --device|--api-key|--access-token) ;;
      *) sc_usage_error "unknown reauth option: ${SC_CODEX_ARGS[0]}" ;;
    esac
  elif (( ${#SC_CODEX_ARGS[@]} > 1 )); then
    sc_usage_error "reauth accepts at most one mode"
  fi
  sc_note "reauthenticating · removing stale local credential copies first"
  sc_validate_auth_cleanup
  sc_global_auth_codex logout >/dev/null 2>&1 || provider_rc=$?
  sc_clear_auth_state
  (( provider_rc == 0 )) || \
    sc_log_event warn logout_provider_failure "Codex logout failed during reauthentication" "exit_code=$provider_rc"
  sc_login
  SC_OPERATION=reauth
}

sc_auth_command() {
  SC_OPERATION=auth
  local sub="${SC_CODEX_ARGS[0]:-status}" source auth_status auth_rc=0
  case "$sub" in
    status)
      (( ${#SC_CODEX_ARGS[@]} <= 1 )) || sc_usage_error "auth status takes no arguments"
      if sc_valid_auth "$(sc_auth_path)"; then
        auth_status="$(sc_global_auth_codex login status 2>&1)" || auth_rc=$?
        printf 'sandcodex authentication\n'
        if (( auth_rc == 0 )); then
          printf '  result     READY\n'
          printf '  account    %s\n' "${auth_status//$'\n'/ · }"
          printf '  source     %s\n' "$(sc_auth_path)"
          printf '  next       sandcodex --RESUME\n'
        else
          printf '  result     CHECK REQUIRED\n'
          printf '  credential present, but Codex could not confirm it (exit %s)\n' "$auth_rc"
          printf '  source     %s\n' "$(sc_auth_path)"
          printf '  next       sandcodex reauth --device\n'
          return "$auth_rc"
        fi
      else
        printf 'sandcodex authentication\n'
        printf '  result     SIGNED OUT\n'
        printf '  source     %s\n' "$(sc_auth_path)"
        printf '  next       sandcodex login --device\n'
        return 1
      fi
      ;;
    login)
      SC_CODEX_ARGS=("${SC_CODEX_ARGS[@]:1}")
      sc_login
      ;;
    logout)
      SC_CODEX_ARGS=("${SC_CODEX_ARGS[@]:1}")
      sc_logout
      ;;
    reauth)
      SC_CODEX_ARGS=("${SC_CODEX_ARGS[@]:1}")
      sc_reauth
      ;;
    path) (( ${#SC_CODEX_ARGS[@]} <= 1 )) || sc_usage_error "auth path takes no arguments"; sc_auth_path ;;
    import)
      (( ${#SC_CODEX_ARGS[@]} <= 2 )) || sc_usage_error "auth import accepts one path"
      source="${SC_CODEX_ARGS[1]:-${CODEX_HOME:-$SC_REAL_HOME/.codex}/auth.json}"
      sc_import_auth "$source"
      ;;
    -h|--help|help) sc_help_topic auth ;;
    *) sc_usage_error "unknown auth command: $sub" ;;
  esac
}

sc_domains() {
  SC_DOMAINS=(
    api.openai.com auth.openai.com chat.openai.com chatgpt.com '**.chatgpt.com'
    persistent.oaistatic.com '**.oaiusercontent.com' "${SC_DOMAINS[@]}"
  )
  if (( SC_DEV_NET )); then
    SC_DOMAINS+=(
      github.com api.github.com '*.github.com' '*.githubusercontent.com'
      raw.githubusercontent.com codeload.github.com
      gitlab.com '*.gitlab.com' registry.npmjs.org registry.yarnpkg.com
      pypi.org files.pythonhosted.org
      crates.io '*.crates.io' static.crates.io index.crates.io
      proxy.golang.org sum.golang.org storage.googleapis.com
      sourceware.org '*.sourceware.org' static.rust-lang.org
    )
  fi
  local domain
  local -A seen=()
  local -a unique=()
  for domain in "${SC_DOMAINS[@]}"; do
    sc_validate_domain "$domain"; domain="${domain,,}"
    [[ -z "${seen[$domain]:-}" ]] || continue
    seen[$domain]=1; unique+=("$domain")
  done
  SC_DOMAINS=("${unique[@]}")
}

sc_runtime_begin() {
  local runtime_base runtime_uid publish_json='[]' publish_socket bind host_port target_port index
  SC_RUN_ROOT="$SC_GLOBAL/runtime/$SC_RUN_ID"
  [[ ! -e "$SC_RUN_ROOT" && ! -L "$SC_RUN_ROOT" ]] || sc_die "runtime identifier collision: $SC_RUN_ROOT"
  sc_ensure_dir "$SC_RUN_ROOT" "invocation runtime"
  SC_JAIL_BROKER_ROOT="$SC_RUN_ROOT/inner-jail-broker"
  sc_ensure_dir "$SC_JAIL_BROKER_ROOT" "inner-jail broker runtime"
  [[ "$SC_PROCESS_START" =~ ^[0-9]+$ ]] || sc_die "launcher process identity is unavailable"
  sc_atomic "$SC_RUN_ROOT/OWNER" 600 <<EOF
schema=$SC_SCHEMA
kind=runtime
uid=$(id -u)
run_id=$SC_RUN_ID
pid=$$
process_start=$SC_PROCESS_START
EOF
  runtime_uid="$(id -u)"
  runtime_base="/run/user/$runtime_uid"
  if [[ ! -d "$runtime_base" || -L "$runtime_base" ||
    "$(stat -c %u -- "$runtime_base" 2>/dev/null || printf invalid)" != "$runtime_uid" ||
    "$(stat -c %a -- "$runtime_base" 2>/dev/null || printf invalid)" != 700 ]]; then
    runtime_base=/tmp
  fi
  SC_PROXY_TMP="$(mktemp -d "$runtime_base/scx.XXXXXX")"
  chmod 700 -- "$SC_PROXY_TMP"
  sc_ensure_dir "$SC_PROXY_TMP/jail-control" "inner-jail broker transport"
  SC_JAIL_BROKER_SOCKET="$SC_PROXY_TMP/jail-control/broker.sock"
  SC_JAIL_RELAY_ROOT="$SC_PROXY_TMP/jail-relays"
  SC_BROWSER_COMMAND_SOCKET="$SC_JAIL_RELAY_ROOT/browser-mcp.sock"
  SC_BROWSER_RECOVERY_SOCKET="$SC_JAIL_RELAY_ROOT/browser-recover.sock"
  SC_BROWSER_VIEWER_SOCKET="$SC_JAIL_RELAY_ROOT/browser-viewer.sock"
  SC_DESKTOP_VIEWER_SOCKET="$SC_JAIL_RELAY_ROOT/desktop-viewer.sock"
  (( ${#SC_JAIL_RELAY_ROOT} + 32 < 108 )) ||
    sc_die "proxy transit path is too long for Linux Unix sockets: $SC_PROXY_TMP"
  sc_ensure_dir "$SC_JAIL_RELAY_ROOT" "inner-jail relay runtime"
  sc_write_inner_jail_helper
  sc_atomic "$SC_PROXY_TMP/OWNER" 600 <<EOF
schema=$SC_SCHEMA
kind=proxy-transit
uid=$(id -u)
run_id=$SC_RUN_ID
EOF
  mkdir -- "$SC_PROXY_TMP/agent"
  chmod 700 -- "$SC_PROXY_TMP/agent"
  SC_AGENT_SOCKET="$SC_PROXY_TMP/agent/loopback.sock"
  SC_AGENT_RELAY_SCRIPT="$SC_PROXY_TMP/agent-loopback-relay.js"
  SC_PUBLISH_MAP="$SC_PROXY_TMP/publish.map"
  SC_PUBLISH_CONFIG="$SC_PROXY_TMP/publish.json"
  SC_PUBLISH_SOCKETS=()
  : >"$SC_PUBLISH_MAP"
  for index in "${!SC_PUBLISH_SPECS[@]}"; do
    bind="${SC_PUBLISH_BINDS[$index]}"
    host_port="${SC_PUBLISH_HOST_PORTS[$index]}"
    target_port="${SC_PUBLISH_TARGET_PORTS[$index]}"
    publish_socket="$SC_PROXY_TMP/agent/publish-$index.sock"
    SC_PUBLISH_SOCKETS+=("$publish_socket")
    printf '/run/sandcodex/agent-bridge/publish-%s.sock\t%s\n' "$index" "$target_port" >>"$SC_PUBLISH_MAP"
    publish_json="$(jq -c --arg bind "$bind" --argjson host_port "$host_port" \
      --argjson target_port "$target_port" '. + [{transport:"tcp",bind_address:$bind,
        host_port:$host_port,target_address:"127.0.0.1",target_port:$target_port,
        authentication:"none"}]' <<<"$publish_json")"
  done
  chmod 400 -- "$SC_PUBLISH_MAP"
  jq -cn --arg schema sandcodex.publish.v1 --argjson listeners "$publish_json" \
    '{schema:$schema,enabled:($listeners | length > 0),lifetime:"command-room",
      config_path:"/run/sandcodex/proxy-host/publish.json",listeners:$listeners,
      application_lifecycle:{ad_hoc:"keep the owning shell tool call alive",
        durable:"use a reviewed --operator-service declaration at the next outer launch"},
      diagnostics:{host_status:"sandcodex publish status --project DIR",
        host_doctor:"sandcodex publish doctor --project DIR",
        application_readiness:"unproven",external_reachability:"unproven"},
      note:"Raw TCP ingress only. Sandcodex does not add HTTP, TLS, or authentication."}' |
    sc_atomic "$SC_PUBLISH_CONFIG" 400
  if (( SC_DESKTOP )); then
    SC_DESKTOP_CONTROL="$SC_PROXY_TMP/desktop-control"
    SC_DESKTOP_DROP_ROOT="$SC_DESKTOP_CONTROL/file-drop"
    SC_DESKTOP_NETWORK="$SC_PROXY_TMP/desktop-network"
    sc_ensure_dir "$SC_DESKTOP_CONTROL" "isolated desktop control transit"
    sc_ensure_dir "$SC_DESKTOP_DROP_ROOT" "controller-private desktop file-drop storage"
    sc_ensure_dir "$SC_DESKTOP_NETWORK" "isolated desktop network transit"
    SC_DESKTOP_SOCKET="$SC_DESKTOP_CONTROL/mcp.sock"
    SC_DESKTOP_STATUS="$SC_DESKTOP_CONTROL/status.json"
    SC_DESKTOP_PROXY_SOCKET="$SC_DESKTOP_NETWORK/proxy.sock"
    (( ${#SC_DESKTOP_SOCKET} < 104 && ${#SC_DESKTOP_PROXY_SOCKET} < 104 )) ||
      sc_die "desktop transit path is too long for Linux Unix sockets"
  fi
  if (( SC_OPERATOR_ENABLED )); then
    SC_OPERATOR_CONTROL="$SC_PROXY_TMP/op"
    sc_ensure_dir "$SC_OPERATOR_CONTROL" "operator-service control transit"
    SC_OPERATOR_SERVICE_CONFIG="$SC_OPERATOR_CONTROL/service.json"
    SC_OPERATOR_SERVICE_STATUS="$SC_OPERATOR_CONTROL/service-status.json"
    SC_OPERATOR_SERVICE_SOCKET="$SC_OPERATOR_CONTROL/$SC_OPERATOR_NAME.service.sock"
    SC_OPERATOR_INGRESS_CONFIG="$SC_OPERATOR_CONTROL/ingress.json"
    SC_OPERATOR_INGRESS_STATUS="$SC_OPERATOR_CONTROL/ingress-status.json"
    SC_OPERATOR_INGRESS_SOCKET="$SC_OPERATOR_CONTROL/ingress.sock"
    SC_OPERATOR_BOOTSTRAP_ROOT="$SC_RUN_ROOT/operator-bootstrap"
    sc_ensure_dir "$SC_OPERATOR_BOOTSTRAP_ROOT" "operator bootstrap state"
    sc_ensure_dir "$SC_PROXY_TMP/operator-agent" "operator command-room transport"
    SC_OPERATOR_LOCATOR="$SC_GLOBAL/operator-active/$SC_PROJECT_KEY.json"
    (( ${#SC_OPERATOR_SERVICE_SOCKET} < 104 && ${#SC_OPERATOR_INGRESS_SOCKET} < 104 )) ||
      sc_die "operator control transit path is too long for Linux Unix sockets"
  fi
  if (( SC_BARE )); then
    SC_GLASSTTY_RUNTIME_HOME="$SC_PROXY_TMP/glasstty"
    ln -s -- "$SC_GLASSTTY_HOME" "$SC_GLASSTTY_RUNTIME_HOME"
    [[ -L "$SC_GLASSTTY_RUNTIME_HOME" && "$(realpath -- "$SC_GLASSTTY_RUNTIME_HOME")" == "$SC_GLASSTTY_HOME" ]] || \
      sc_die "could not create the private GlassTTY runtime alias"
  else
    SC_GLASSTTY_RUNTIME_HOME="/run/scg-${SC_PROJECT_KEY:0:32}"
  fi
  local socket_suffix=/run/daemon.sock
  (( ${#SC_GLASSTTY_RUNTIME_HOME} + ${#socket_suffix} < 108 )) || \
    sc_die "GlassTTY runtime path exceeds the Linux Unix-socket limit"
  if (( SC_OPERATOR_ENABLED )); then
    sc_ensure_dir "$SC_GLASSTTY_HOME/run" "private GlassTTY runtime"
    if (( SC_BARE )); then
      SC_OPERATOR_LISTENER_ROOT="$SC_GLASSTTY_HOME/run"
    else
      SC_OPERATOR_LISTENER_ROOT="$SC_PROXY_TMP/operator-listener"
      sc_ensure_dir "$SC_OPERATOR_LISTENER_ROOT" "operator stable-listener transit"
    fi
    SC_OPERATOR_SOCKET="$SC_GLASSTTY_RUNTIME_HOME/run/$SC_OPERATOR_LISTEN"
    (( ${#SC_OPERATOR_SOCKET} < 108 && ${#SC_OPERATOR_LISTENER_ROOT} + ${#SC_OPERATOR_LISTEN} + 1 < 108 )) ||
      sc_die "operator listener path exceeds the Linux Unix-socket limit"
  fi
  printf '%s\n' "$SC_PROXY_TMP" | sc_atomic "$SC_RUN_ROOT/proxy-path" 600
}

sc_emit_operator_ingress() {
  cat <<'OPERATOR_INGRESS'
#!/usr/bin/env node
'use strict';

const crypto = require('node:crypto');
const fs = require('node:fs');
const http = require('node:http');
const net = require('node:net');
const path = require('node:path');

const CONFIG_SCHEMA = 'sandcodex.operator-ingress-config.v1';
const STATUS_SCHEMA = 'sandcodex.operator-ingress-status.v1';
const SESSION_SCHEMA = 'sandcodex.operator-ingress-session.v1';
const MAX_CONFIG_BYTES = 1024 * 1024;
const MAX_CONTROL_BYTES = 8192;
const MAX_HEADER_BYTES = 32768;
const COOKIE_NAME = 'sandcodex_operator';
const INTERNAL_PREFIX = 'x-sandcodex-';
const HOP_HEADERS = new Set([
  'connection', 'keep-alive', 'proxy-authenticate', 'proxy-authorization',
  'te', 'trailer', 'transfer-encoding', 'upgrade',
]);
const SECURITY_HEADERS = {
  'cache-control': 'no-store',
  'content-security-policy': "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; worker-src 'none'",
  'cross-origin-opener-policy': 'same-origin',
  'referrer-policy': 'no-referrer',
  'x-content-type-options': 'nosniff',
  'x-frame-options': 'DENY',
};

function fail(message, code = 70) {
  process.stderr.write(`sandcodex-operator-ingress: ${message}\n`);
  process.exit(code);
}

function privateDirectory(value, label) {
  if (typeof value !== 'string' || !path.isAbsolute(value) || value.includes('\0')) throw new Error(`${label} is invalid`);
  const info = fs.lstatSync(value);
  if (!info.isDirectory() || info.isSymbolicLink() || info.uid !== process.geteuid() || (info.mode & 0o7777) !== 0o700 || fs.realpathSync(value) !== value) {
    throw new Error(`${label} is not one canonical owned mode-0700 directory`);
  }
  return value;
}

function privateFile(value, label) {
  const info = fs.lstatSync(value);
  if (!info.isFile() || info.isSymbolicLink() || info.uid !== process.geteuid() || (info.mode & 0o7777) !== 0o600 || info.nlink !== 1) {
    throw new Error(`${label} is not one owned mode-0600 single-link file`);
  }
  return info;
}

function integer(value, minimum, maximum, label) {
  if (!Number.isInteger(value) || value < minimum || value > maximum) throw new Error(`${label} is invalid`);
  return value;
}

function safeRelativeSocket(value) {
  if (typeof value !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._/-]{0,95}$/.test(value) || value.split('/').some(part => !part || part === '.' || part === '..')) {
    throw new Error('target_relative is invalid');
  }
  return value;
}

function processStartTicks(pid) {
  try {
    const raw = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
    const tail = raw.slice(raw.lastIndexOf(') ') + 2).split(/\s+/);
    return tail.length > 19 ? tail[19] : null;
  } catch { return null; }
}

function atomicJson(filename, value) {
  const temporary = path.join(path.dirname(filename), `.${path.basename(filename)}.${process.pid}.${crypto.randomBytes(8).toString('hex')}.tmp`);
  fs.writeFileSync(temporary, `${JSON.stringify(value)}\n`, { mode: 0o600, flag: 'wx' });
  fs.renameSync(temporary, filename);
}

function readConfig(filename) {
  const info = privateFile(filename, 'configuration');
  if (info.size > MAX_CONFIG_BYTES) throw new Error('configuration is too large');
  const value = JSON.parse(fs.readFileSync(filename, 'utf8'));
  if (!value || typeof value !== 'object' || Array.isArray(value) || value.schema !== CONFIG_SCHEMA) throw new Error('unsupported configuration schema');
  const expected = ['bootstrap_root', 'control_root', 'generation', 'idle_timeout_ms', 'max_connections', 'name', 'request_max_bytes', 'response_max_bytes', 'run_id', 'runtime_root', 'schema', 'status_file', 'target_relative'].sort();
  if (Object.keys(value).sort().join('\0') !== expected.join('\0')) throw new Error('configuration has unknown or missing fields');
  if (typeof value.name !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$/.test(value.name)) throw new Error('name is invalid');
  if (typeof value.run_id !== 'string' || !/^[A-Za-z0-9._:-]{1,96}$/.test(value.run_id)) throw new Error('run id is invalid');
  value.generation = integer(value.generation, 1, 999999999, 'generation');
  value.request_max_bytes = integer(value.request_max_bytes, 1, 8 * 1024 * 1024, 'request bound');
  value.response_max_bytes = integer(value.response_max_bytes, 1, 64 * 1024 * 1024, 'response bound');
  value.max_connections = integer(value.max_connections, 1, 256, 'connection bound');
  value.idle_timeout_ms = integer(value.idle_timeout_ms, 100, 300000, 'idle timeout');
  value.runtime_root = privateDirectory(value.runtime_root, 'runtime root');
  value.control_root = privateDirectory(value.control_root, 'control root');
  value.bootstrap_root = privateDirectory(value.bootstrap_root, 'bootstrap root');
  value.target_relative = safeRelativeSocket(value.target_relative);
  value.status_file = path.resolve(value.status_file);
  if (path.dirname(value.status_file) !== value.control_root) throw new Error('status file must be directly below control root');
  return value;
}

class Ingress {
  constructor(config) {
    this.config = config;
    this.name = config.name;
    this.runId = config.run_id;
    this.generation = config.generation;
    this.target = path.join(config.runtime_root, config.target_relative);
    this.statusPath = config.status_file;
    this.controlPath = path.join(config.control_root, 'ingress.sock');
    this.state = 'starting';
    this.startedAt = new Date().toISOString();
    this.targetIdentity = null;
    this.listener = null;
    this.control = null;
    this.port = null;
    this.origin = null;
    this.sessions = new Map();
    this.bootstraps = new Map();
    this.connections = 0;
    this.websockets = new Set();
    this.stopping = false;
  }

  inspectTarget() {
    const info = fs.lstatSync(this.target, { bigint: true });
    if (!info.isSocket() || info.isSymbolicLink() || info.uid !== BigInt(process.geteuid()) || info.nlink !== 1n || (info.mode & 0o7777n) !== 0o600n) {
      throw new Error('target is not one owned mode-0600 Unix socket');
    }
    return {
      dev: info.dev.toString(),
      ino: info.ino.toString(),
      ctime_ns: info.ctimeNs.toString(),
      uid: Number(info.uid),
      mode: '0600',
    };
  }

  targetMatches() {
    if (this.state === 'target-identity-lost') return false;
    try {
      const current = this.inspectTarget();
      if (current.dev === this.targetIdentity.dev &&
          current.ino === this.targetIdentity.ino &&
          current.ctime_ns === this.targetIdentity.ctime_ns) return true;
    } catch {}
    this.state = 'target-identity-lost';
    this.writeStatus();
    return false;
  }

  status() {
    return {
      schema: STATUS_SCHEMA,
      name: this.name,
      run_id: this.runId,
      ingress_generation: this.generation,
      ingress_pid: process.pid,
      ingress_start_ticks: processStartTicks(process.pid),
      state: this.state,
      started_at: this.startedAt,
      listener: this.port === null ? null : { address: '127.0.0.1', port: this.port, url: this.origin },
      target_identity: this.targetIdentity,
      active_sessions: this.sessions.size,
      pending_bootstraps: this.bootstraps.size,
      active_connections: this.connections,
      request_max_bytes: this.config.request_max_bytes,
      response_max_bytes: this.config.response_max_bytes,
    };
  }

  writeStatus() { atomicJson(this.statusPath, this.status()); }

  securityHeaders(headers = {}) {
    for (const [key, value] of Object.entries(SECURITY_HEADERS)) headers[key] = value;
    return headers;
  }

  send(response, status, body = '', headers = {}) {
    const payload = Buffer.isBuffer(body) ? body : Buffer.from(body);
    const safe = this.securityHeaders({ ...headers, 'content-length': String(payload.length) });
    response.writeHead(status, safe);
    response.end(payload);
  }

  exactHost(request) { return request.headers.host === `127.0.0.1:${this.port}`; }

  parseSession(request) {
    const raw = request.headers.cookie;
    if (typeof raw !== 'string') return null;
    for (const item of raw.split(';')) {
      const [key, ...rest] = item.trim().split('=');
      if (key === COOKIE_NAME) {
        const token = rest.join('=');
        const session = this.sessions.get(token);
        return session ? { token, ...session } : null;
      }
    }
    return null;
  }

  readBody(request) {
    return new Promise((resolve, reject) => {
      const chunks = [];
      let bytes = 0;
      request.on('data', chunk => {
        bytes += chunk.length;
        if (bytes > this.config.request_max_bytes) {
          reject(Object.assign(new Error('request-too-large'), { code: 'ETOOBIG' }));
          request.destroy();
          return;
        }
        chunks.push(chunk);
      });
      request.on('end', () => resolve(Buffer.concat(chunks)));
      request.on('error', reject);
    });
  }

  createBootstrap(revokeExisting = false) {
    if (revokeExisting) {
      this.sessions.clear();
      for (const entry of this.bootstraps.values()) {
        try { fs.unlinkSync(entry.filename); } catch (error) { if (error.code !== 'ENOENT') throw error; }
      }
      this.bootstraps.clear();
    }
    const token = crypto.randomBytes(32).toString('base64url');
    const nonce = crypto.randomBytes(12).toString('hex');
    const filename = path.join(this.config.bootstrap_root, `operator-${this.generation}-${nonce}.html`);
    const action = `${this.origin}/_sandcodex/bootstrap/${nonce}`;
    const escapedAction = action.replaceAll('&', '&amp;').replaceAll('"', '&quot;');
    const markup = `<!doctype html><meta charset="utf-8"><meta name="referrer" content="no-referrer"><title>Sandcodex operator</title><form method="post" action="${escapedAction}"><input type="hidden" name="token" value="${token}"><noscript><button type="submit">Open operator cockpit</button></noscript></form><script>document.forms[0].submit()</script>\n`;
    fs.writeFileSync(filename, markup, { mode: 0o600, flag: 'wx' });
    this.bootstraps.set(nonce, { token, filename });
    this.writeStatus();
    return filename;
  }

  consumeBootstrap(request, response, body) {
    const match = /^\/_sandcodex\/bootstrap\/([0-9a-f]{24})$/.exec(request.url || '');
    const entry = match ? this.bootstraps.get(match[1]) : null;
    let supplied = null;
    try { supplied = new URLSearchParams(body.toString('utf8')).get('token'); } catch {}
    if (!entry || typeof supplied !== 'string' || supplied.length !== entry.token.length || !crypto.timingSafeEqual(Buffer.from(supplied), Buffer.from(entry.token))) {
      this.send(response, 403, 'Forbidden\n');
      return;
    }
    this.bootstraps.delete(match[1]);
    try { fs.unlinkSync(entry.filename); } catch (error) { if (error.code !== 'ENOENT') throw error; }
    const sessionToken = crypto.randomBytes(32).toString('base64url');
    const sessionId = crypto.randomBytes(16).toString('hex');
    const csrf = crypto.randomBytes(32).toString('base64url');
    this.sessions.set(sessionToken, { id: sessionId, csrf, created_at: new Date().toISOString() });
    this.writeStatus();
    this.send(response, 303, '', {
      location: '/',
      'set-cookie': `${COOKIE_NAME}=${sessionToken}; Path=/; HttpOnly; SameSite=Strict`,
    });
  }

  requireMutationAuthority(request, session) {
    return request.headers.origin === this.origin &&
      typeof request.headers['x-sandcodex-csrf'] === 'string' &&
      request.headers['x-sandcodex-csrf'] === session.csrf;
  }

  upstreamHeaders(request, session, websocket = false, websocketProtocols = null) {
    const headers = {};
    const connectionTokens = new Set(String(request.headers.connection || '').toLowerCase().split(',').map(value => value.trim()).filter(Boolean));
    for (const [key, value] of Object.entries(request.headers)) {
      const lower = key.toLowerCase();
      if (lower === 'cookie' || lower === 'host' || lower === 'origin' || lower === 'x-sandcodex-csrf' || lower.startsWith(INTERNAL_PREFIX) || HOP_HEADERS.has(lower) || connectionTokens.has(lower) || lower === 'sec-websocket-protocol') continue;
      headers[lower] = value;
    }
    headers.host = 'sandcodex-operator';
    headers['x-sandcodex-ingress-name'] = this.name;
    headers['x-sandcodex-operator-session'] = session.id;
    if (websocket) {
      headers.connection = 'Upgrade';
      headers.upgrade = 'websocket';
      if (websocketProtocols) headers['sec-websocket-protocol'] = websocketProtocols;
    }
    return headers;
  }

  proxy(request, response, body, session) {
    if (!this.targetMatches()) { this.send(response, 503, 'Operator service unavailable\n'); return; }
    const upstream = http.request({
      socketPath: this.target,
      method: request.method,
      path: request.url,
      headers: this.upstreamHeaders(request, session),
      timeout: this.config.idle_timeout_ms,
    }, result => {
      const chunks = [];
      let bytes = 0;
      result.on('data', chunk => {
        bytes += chunk.length;
        if (bytes > this.config.response_max_bytes) {
          result.destroy(Object.assign(new Error('response-too-large'), { code: 'ETOOBIG' }));
          return;
        }
        chunks.push(chunk);
      });
      result.on('end', () => {
        const headers = {};
        const connectionTokens = new Set(String(result.headers.connection || '').toLowerCase().split(',').map(value => value.trim()).filter(Boolean));
        for (const [key, value] of Object.entries(result.headers)) {
          const lower = key.toLowerCase();
          if (lower === 'set-cookie' || lower.startsWith(INTERNAL_PREFIX) || HOP_HEADERS.has(lower) || connectionTokens.has(lower) || lower === 'content-length') continue;
          headers[lower] = value;
        }
        this.send(response, result.statusCode || 502, Buffer.concat(chunks), headers);
      });
      result.on('error', error => {
        if (!response.headersSent) this.send(response, error.code === 'ETOOBIG' ? 502 : 503, 'Operator service unavailable\n');
        else response.destroy();
      });
    });
    upstream.on('timeout', () => upstream.destroy(Object.assign(new Error('timeout'), { code: 'ETIMEDOUT' })));
    upstream.on('error', () => { if (!response.headersSent) this.send(response, 503, 'Operator service unavailable\n'); else response.destroy(); });
    upstream.end(body);
  }

  async handle(request, response) {
    if (!this.exactHost(request)) { this.send(response, 421, 'Misdirected Request\n'); return; }
    let body;
    try { body = await this.readBody(request); }
    catch (error) { if (!response.headersSent) this.send(response, error.code === 'ETOOBIG' ? 413 : 400, 'Invalid request\n'); return; }
    if (request.method === 'POST' && /^\/_sandcodex\/bootstrap\//.test(request.url || '')) {
      this.consumeBootstrap(request, response, body);
      return;
    }
    const session = this.parseSession(request);
    if (!session) { this.send(response, 401, 'Unauthorized\n'); return; }
    if (request.url === '/_sandcodex/session' && request.method === 'GET') {
      this.send(response, 200, JSON.stringify({ schema: SESSION_SCHEMA, csrf_token: session.csrf, ingress_generation: this.generation }), { 'content-type': 'application/json' });
      return;
    }
    if (!['GET', 'HEAD', 'OPTIONS'].includes(request.method || '') && !this.requireMutationAuthority(request, session)) {
      this.send(response, 403, 'Forbidden\n');
      return;
    }
    this.proxy(request, response, body, session);
  }

  rejectUpgrade(socket, status, message) {
    const body = `${message}\n`;
    socket.end(`HTTP/1.1 ${status} ${message}\r\nConnection: close\r\nContent-Length: ${Buffer.byteLength(body)}\r\nCache-Control: no-store\r\n\r\n${body}`);
  }

  handleUpgrade(request, socket, head) {
    if (!this.exactHost(request)) { this.rejectUpgrade(socket, 421, 'Misdirected Request'); return; }
    const session = this.parseSession(request);
    if (!session || request.headers.origin !== this.origin) { this.rejectUpgrade(socket, 403, 'Forbidden'); return; }
    const protocols = String(request.headers['sec-websocket-protocol'] || '').split(',').map(value => value.trim()).filter(Boolean);
    const reserved = `sandcodex.csrf.${session.csrf}`;
    if (!protocols.includes(reserved)) { this.rejectUpgrade(socket, 403, 'Forbidden'); return; }
    const forwardedProtocols = protocols.filter(value => !value.startsWith('sandcodex.csrf.'));
    if (!this.targetMatches()) { this.rejectUpgrade(socket, 503, 'Service Unavailable'); return; }
    if (this.connections >= this.config.max_connections) { this.rejectUpgrade(socket, 503, 'Busy'); return; }
    this.connections += 1;
    this.writeStatus();
    const upstream = net.createConnection(this.target);
    this.websockets.add(socket);
    this.websockets.add(upstream);
    let released = false;
    const release = () => {
      if (released) return;
      released = true;
      this.websockets.delete(socket);
      this.websockets.delete(upstream);
      this.connections = Math.max(0, this.connections - 1);
      this.writeStatus();
    };
    upstream.setTimeout(this.config.idle_timeout_ms, () => upstream.destroy());
    socket.setTimeout(this.config.idle_timeout_ms, () => socket.destroy());
    upstream.once('connect', () => {
      const headers = this.upstreamHeaders(request, session, true, forwardedProtocols.join(', '));
      const lines = [`${request.method} ${request.url} HTTP/${request.httpVersion}`];
      for (const [key, value] of Object.entries(headers)) {
        if (Array.isArray(value)) for (const item of value) lines.push(`${key}: ${item}`);
        else if (value !== undefined) lines.push(`${key}: ${value}`);
      }
      upstream.write(`${lines.join('\r\n')}\r\n\r\n`);
      if (head.length) upstream.write(head);
      upstream.pipe(socket);
      socket.pipe(upstream);
    });
    upstream.once('error', () => { if (!socket.destroyed) this.rejectUpgrade(socket, 503, 'Service Unavailable'); });
    upstream.once('close', release);
    socket.once('error', () => upstream.destroy());
    socket.once('close', () => { upstream.destroy(); release(); });
  }

  bindControl() {
    try {
      const current = fs.lstatSync(this.controlPath);
      if (current.isDirectory()) throw new Error('control endpoint is a directory');
      fs.unlinkSync(this.controlPath);
    } catch (error) { if (error.code !== 'ENOENT') throw error; }
    this.control = net.createServer(connection => {
      let data = Buffer.alloc(0);
      connection.setTimeout(5000, () => connection.destroy());
      connection.on('data', chunk => {
        data = Buffer.concat([data, chunk]);
        if (data.length > MAX_CONTROL_BYTES) connection.destroy();
        const newline = data.indexOf(10);
        if (newline < 0) return;
        connection.pause();
        let request;
        try { request = JSON.parse(data.subarray(0, newline).toString('utf8')); } catch { request = null; }
        let response;
        if (!request || typeof request !== 'object' || Array.isArray(request)) response = { ok: false, error: 'invalid-request' };
        else if (request.op === 'status') response = { ok: true, status: this.status() };
        else if (request.op === 'bootstrap') {
          try { response = { ok: true, bootstrap_file: this.createBootstrap(request.revoke_existing === true), status: this.status() }; }
          catch { response = { ok: false, error: 'bootstrap-failed' }; }
        } else if (request.op === 'revoke-sessions') {
          this.sessions.clear(); this.writeStatus(); response = { ok: true, status: this.status() };
        } else response = { ok: false, error: 'unsupported-operation' };
        connection.end(`${JSON.stringify(response)}\n`);
      });
      connection.on('error', () => {});
    });
    this.control.listen(this.controlPath, () => fs.chmodSync(this.controlPath, 0o600));
  }

  async start() {
    this.targetIdentity = this.inspectTarget();
    this.listener = http.createServer({ maxHeaderSize: MAX_HEADER_BYTES }, (request, response) => {
      if (this.connections >= this.config.max_connections) { this.send(response, 503, 'Busy\n'); return; }
      this.connections += 1; this.writeStatus();
      response.once('close', () => { this.connections = Math.max(0, this.connections - 1); this.writeStatus(); });
      request.setTimeout(this.config.idle_timeout_ms, () => request.destroy());
      this.handle(request, response).catch(() => { if (!response.headersSent) this.send(response, 500, 'Internal error\n'); else response.destroy(); });
    });
    this.listener.on('upgrade', (request, socket, head) => this.handleUpgrade(request, socket, head));
    this.listener.on('clientError', (_error, socket) => { if (!socket.destroyed) socket.end('HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n'); });
    await new Promise((resolve, reject) => {
      this.listener.once('error', reject);
      this.listener.listen({ host: '127.0.0.1', port: 0, exclusive: true }, () => { this.listener.removeListener('error', reject); resolve(); });
    });
    const address = this.listener.address();
    if (!address || typeof address === 'string' || address.address !== '127.0.0.1') throw new Error('ingress did not bind exact IPv4 loopback');
    this.port = address.port;
    this.origin = `http://127.0.0.1:${this.port}`;
    this.bindControl();
    await new Promise((resolve, reject) => {
      if (this.control.listening) resolve();
      else { this.control.once('listening', resolve); this.control.once('error', reject); }
    });
    this.state = 'listening';
    const bootstrapFile = this.createBootstrap(false);
    this.writeStatus();
    process.stdout.write(`${JSON.stringify({ ready: true, state: this.state, listener: { address: '127.0.0.1', port: this.port, url: this.origin }, bootstrap_file: bootstrapFile, control_socket: this.controlPath, target_identity: this.targetIdentity })}\n`);
  }

  async close() {
    if (this.stopping) return;
    this.stopping = true;
    this.state = 'stopped';
    this.sessions.clear();
    for (const entry of this.bootstraps.values()) { try { fs.unlinkSync(entry.filename); } catch {} }
    this.bootstraps.clear();
    for (const connection of this.websockets) connection.destroy();
    this.websockets.clear();
    await Promise.all([
      this.listener ? new Promise(resolve => this.listener.close(() => resolve())) : Promise.resolve(),
      this.control ? new Promise(resolve => this.control.close(() => resolve())) : Promise.resolve(),
    ]);
    try { fs.unlinkSync(this.controlPath); } catch (error) { if (error.code !== 'ENOENT') throw error; }
    this.writeStatus();
  }
}

if (process.argv.length !== 3) fail('usage: sandcodex-operator-ingress CONFIG.json', 64);
let ingress;
try { ingress = new Ingress(readConfig(process.argv[2])); }
catch (error) { fail(error.message); }
let closing = false;
async function shutdown() {
  if (closing) return;
  closing = true;
  try { await ingress.close(); process.exitCode = 0; }
  catch { process.exitCode = 70; }
}
for (const signal of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(signal, shutdown);
ingress.start().catch(error => { fail(error.message); });
OPERATOR_INGRESS
}

sc_emit_operator_service() {
  cat <<'OPERATOR_SERVICE'
#!/usr/bin/env python3
"""Candidate command-room-lifetime operator service supervisor for Sandcodex.

The launcher must run this inside the same project-confined inner boundary as
the command room, but outside any individual shell-tool invocation. The
supervisor owns the stable Unix listener and passes it to each child. It does
not confer authority beyond the containing boundary.
"""

from __future__ import annotations

import hashlib
import json
import os
import queue
import re
import selectors
import signal
import socket
import stat
import subprocess
import sys
import threading
import time
import uuid
from collections import deque
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


CONFIG_SCHEMA = "sandcodex.operator-service-config.v1"
STATUS_SCHEMA = "sandcodex.operator-service-status.v1"
READY_SCHEMA = "sandcodex.operator-service-ready.v1"
MAX_CONFIG_BYTES = 1024 * 1024
MAX_CONTROL_BYTES = 8192
MAX_CONTROL_CLIENTS = 8
BUILD_ID_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:+@/-]{0,127}$")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def fail(message: str, code: int = 70) -> None:
    print(f"sandcodex-operator-service: {message}", file=sys.stderr)
    raise SystemExit(code)


def private_directory(value: object, label: str) -> Path:
    if not isinstance(value, str) or not os.path.isabs(value) or "\x00" in value:
        raise ValueError(f"{label} is not an absolute path")
    path = Path(value)
    info = path.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o700
        or path.resolve() != path
    ):
        raise ValueError(f"{label} is not one canonical owned mode-0700 directory")
    return path


def private_file(path: Path, label: str) -> os.stat_result:
    info = path.lstat()
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_nlink != 1
    ):
        raise ValueError(f"{label} is not one owned mode-0600 single-link file")
    return info


def canonical_integer(value: object, minimum: int, maximum: int, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        raise ValueError(f"{label} must be an integer from {minimum} through {maximum}")
    return value


def safe_relative_socket(value: object) -> Path:
    if not isinstance(value, str) or not value or len(value) > 96 or "\x00" in value:
        raise ValueError("listen_relative is invalid")
    candidate = Path(value)
    if candidate.is_absolute() or any(part in {"", ".", ".."} for part in candidate.parts):
        raise ValueError("listen_relative escaped its runtime root")
    if any(not all(character.isascii() and (character.isalnum() or character in "._-") for character in part) for part in candidate.parts):
        raise ValueError("listen_relative contains an unsafe component")
    return candidate


def atomic_json(path: Path, value: dict[str, Any]) -> dict[str, Any]:
    """Publish one private JSON file and report post-rename durability evidence."""
    observation_schema = "sandcodex.operator-status-publication.v1"
    parent_fd = os.open(
        path.parent,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
    )
    temporary_name = f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    descriptor: int | None = None
    temporary_created = False
    published = False
    try:
        descriptor = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=parent_fd,
        )
        temporary_created = True
        payload = (json.dumps(value, separators=(",", ":"), sort_keys=True) + "\n").encode()
        remaining = memoryview(payload)
        while remaining:
            written = os.write(descriptor, remaining)
            if written <= 0:
                raise OSError("operator status write made no progress")
            remaining = remaining[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = None
        os.replace(
            temporary_name,
            path.name,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )
        published = True
        try:
            os.fsync(parent_fd)
        except OSError:
            # The target has already been replaced. Do not retry or republish:
            # crash durability is uncertain, but replay could repeat a committed
            # publication. Keep this warning bounded and content-free.
            print(
                "sandcodex-operator-service: status published; "
                "parent-directory sync outcome unknown; inspect before repeating",
                file=sys.stderr,
                flush=True,
            )
            return {
                "schema": observation_schema,
                "published": True,
                "directory_synced": False,
            }
        return {
            "schema": observation_schema,
            "published": True,
            "directory_synced": True,
        }
    except BaseException:
        if descriptor is not None:
            try:
                os.close(descriptor)
            finally:
                descriptor = None
        if temporary_created and not published:
            try:
                os.unlink(temporary_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
            except OSError as cleanup_error:
                raise RuntimeError(
                    "operator status staging cleanup outcome is unknown"
                ) from cleanup_error
        raise
    finally:
        os.close(parent_fd)


def process_start_ticks(pid: int) -> str | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    tail = raw[raw.rfind(") ") + 2 :].split()
    return tail[19] if len(tail) > 19 else None


MAX_PRIOR_STATUS_BYTES = 64 * 1024


def load_prior_supervisor_status(path: Path, expected_name: str) -> dict[str, Any]:
    """Read one private status record without following a replacement link."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except FileNotFoundError as exc:
        raise RuntimeError("operator endpoint exists without prior status evidence") from exc
    try:
        info = os.fstat(descriptor)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
            or info.st_size < 2
            or info.st_size > MAX_PRIOR_STATUS_BYTES
        ):
            raise RuntimeError("prior operator status evidence is not one private bounded file")
        payload = bytearray()
        while len(payload) <= MAX_PRIOR_STATUS_BYTES:
            chunk = os.read(descriptor, min(65536, MAX_PRIOR_STATUS_BYTES + 1 - len(payload)))
            if not chunk:
                break
            payload.extend(chunk)
        if len(payload) > MAX_PRIOR_STATUS_BYTES:
            raise RuntimeError("prior operator status evidence exceeded its byte limit")
    finally:
        os.close(descriptor)
    try:
        record = json.loads(bytes(payload))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise RuntimeError("prior operator status evidence is invalid") from exc
    if (
        not isinstance(record, dict)
        or record.get("schema") != STATUS_SCHEMA
        or record.get("name") != expected_name
    ):
        raise RuntimeError("prior operator status evidence does not identify this service")
    return record


def prior_supervisor_is_dead(record: dict[str, Any]) -> bool:
    """Distinguish a dead/reused birth identity from a still-live supervisor."""
    pid = record.get("supervisor_pid")
    ticks = record.get("supervisor_start_ticks")
    if (
        isinstance(pid, bool)
        or not isinstance(pid, int)
        or pid < 2
        or pid > 2**31 - 1
        or not isinstance(ticks, str)
        or not ticks.isdigit()
    ):
        raise RuntimeError("prior operator owner identity is malformed")
    observed = process_start_ticks(pid)
    if observed == ticks:
        return False
    if observed is not None:
        # The PID exists, but it is a different process birth.
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except PermissionError as exc:
        raise RuntimeError("prior operator owner liveness is ambiguous") from exc
    raise RuntimeError("prior operator owner exists without readable birth evidence")


def recorded_socket_identity(record: dict[str, Any], key: str, label: str) -> tuple[int, int]:
    value = record.get(key)
    if not isinstance(value, dict) or set(value) != {"dev", "ino", "mode"}:
        raise RuntimeError(f"prior {label} identity evidence is unavailable")
    dev = value.get("dev")
    ino = value.get("ino")
    if (
        not isinstance(dev, str)
        or not dev.isdigit()
        or not isinstance(ino, str)
        or not ino.isdigit()
        or value.get("mode") != "0600"
    ):
        raise RuntimeError(f"prior {label} identity evidence is malformed")
    return int(dev), int(ino)


def private_socket_identity(info: os.stat_result, label: str) -> tuple[int, int, int, int, int]:
    if (
        not stat.S_ISSOCK(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) != 0o600
    ):
        raise RuntimeError(f"existing {label} is not one private owned socket")
    return info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_ctime_ns


def unlink_preflighted_socket_at(
    parent_fd: int,
    name: str,
    expected: tuple[int, int, int, int, int] | None,
    label: str,
) -> None:
    """Unlink only the exact socket approved by the earlier dead-owner preflight."""
    if expected is None:
        raise RuntimeError(f"{label} appeared after endpoint preflight")
    current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    observed = private_socket_identity(current, label)
    if observed != expected:
        raise RuntimeError(f"{label} changed after endpoint preflight")
    os.unlink(name, dir_fd=parent_fd)


def stop_group(process: subprocess.Popen[bytes], grace_seconds: float = 5.0) -> None:
    # start_new_session makes the child's birth PID its process-group id. Kill
    # the group even when the direct child has already exited: descendants may
    # still hold the group, listener, or project files.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return
    deadline = time.monotonic() + grace_seconds
    while time.monotonic() < deadline:
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            process.wait()
            return
        time.sleep(0.05)
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + grace_seconds
    while time.monotonic() < deadline:
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            process.wait()
            return
        time.sleep(0.05)
    raise RuntimeError("service process group could not be reaped")


class Supervisor:
    def __init__(self, config: dict[str, Any]) -> None:
        self.config = config
        self.name = config["name"]
        self.run_id = config["run_id"]
        self.runtime_root = private_directory(config["runtime_root"], "runtime root")
        self.control_root = private_directory(config["control_root"], "control root")
        self.status_path = Path(config["status_file"])
        if self.status_path.parent != self.control_root:
            raise ValueError("status file must be directly below the control root")
        self.log_path = Path(config["log_file"])
        if self.log_path.parent != self.control_root:
            raise ValueError("log file must be directly below the control root")
        self.log_max_bytes = canonical_integer(
            config.get("log_max_bytes", 64 * 1024 * 1024), 1024 * 1024, 1024 * 1024 * 1024,
            "application log maximum",
        )
        self.log_bytes = 0
        self.log_dropped_bytes = 0
        self.relative_listener = safe_relative_socket(config["listen_relative"])
        self.listener_path = self.runtime_root / self.relative_listener
        private_directory(str(self.listener_path.parent), "listener parent")
        self.control_path = self.control_root / f"{self.name}.service.sock"
        self.declaration_sha256 = config.get("declaration_sha256")
        if self.declaration_sha256 is None:
            self.declaration_sha256 = "0" * 64
        if not isinstance(self.declaration_sha256, str) or re.fullmatch(r"[0-9a-f]{64}", self.declaration_sha256) is None:
            raise ValueError("declaration_sha256 is invalid")
        self.argv = config["argv"]
        if (
            not isinstance(self.argv, list)
            or not self.argv
            or len(self.argv) > 128
            or any(not isinstance(item, str) or not item or "\x00" in item or len(item) > 4096 for item in self.argv)
        ):
            raise ValueError("argv must be a bounded non-empty string array")
        self.cwd = Path(config["cwd"])
        if not self.cwd.is_absolute() or self.cwd.resolve() != self.cwd or not self.cwd.is_dir():
            raise ValueError("cwd must be an existing canonical absolute directory")
        self.ready_timeout = canonical_integer(config.get("ready_timeout_seconds", 20), 1, 300, "ready timeout")
        restart = config.get("restart")
        if not isinstance(restart, dict) or restart.get("mode") not in {"never", "on-failure"}:
            raise ValueError("restart policy is invalid")
        self.restart_mode = restart["mode"]
        self.restart_limit = canonical_integer(restart.get("limit", 0), 0, 10, "restart limit")
        self.restart_window = canonical_integer(restart.get("window_seconds", 60), 1, 3600, "restart window")
        self.restart_base_delay = canonical_integer(restart.get("base_delay_seconds", 1), 0, 60, "restart delay")
        stop = config.get("stop", {"grace_seconds": 5})
        if not isinstance(stop, dict) or set(stop) != {"grace_seconds"}:
            raise ValueError("stop policy is invalid")
        self.stop_grace_seconds = canonical_integer(stop["grace_seconds"], 1, 900, "stop grace")
        adapter = config.get("adapter", {"mode": "socket-activation", "target_port": None})
        if not isinstance(adapter, dict) or adapter.get("mode") not in {"socket-activation", "tcp-loopback"}:
            raise ValueError("application adapter is invalid")
        target_port = adapter.get("target_port")
        if adapter["mode"] == "socket-activation":
            if target_port is not None:
                raise ValueError("socket-activation adapter cannot have a target port")
        else:
            target_port = canonical_integer(target_port, 1, 65535, "adapter target port")
        self.adapter = {"mode": adapter["mode"], "target_port": target_port}
        self.lock = threading.RLock()
        self.command_lock = threading.Lock()
        self.wake = threading.Event()
        self.shutdown_event = threading.Event()
        self.desired = "running"
        self.state = "starting"
        self.started_at = utc_now()
        self.generation = 0
        self.process: subprocess.Popen[bytes] | None = None
        self.process_start: str | None = None
        self.ready_at: str | None = None
        self.last_exit: int | None = None
        self.last_error: str | None = None
        self.last_ready_application_build_id: str | None = None
        self.restart_times: deque[float] = deque()
        self.listener: socket.socket | None = None
        self.listener_identity: tuple[int, int] | None = None
        self.control: socket.socket | None = None
        self.control_identity: tuple[int, int] | None = None
        self.endpoint_reclaims: dict[str, tuple[int, int, int, int, int]] = {}
        self.control_threads: set[threading.Thread] = set()
        self.control_slots = threading.BoundedSemaphore(MAX_CONTROL_CLIENTS)
        self.monitor: threading.Thread | None = None
        self.spawn_queue: queue.Queue[tuple[threading.Event, list[object]] | None] = queue.Queue()
        self.spawner: threading.Thread | None = None

    def status(self) -> dict[str, Any]:
        with self.lock:
            process = self.process
            return {
                "schema": STATUS_SCHEMA,
                "name": self.name,
                "run_id": self.run_id,
                "supervisor_pid": os.getpid(),
                "supervisor_start_ticks": process_start_ticks(os.getpid()),
                "started_at": self.started_at,
                "desired": self.desired,
                "state": self.state,
                "service_generation": self.generation,
                "service_pid": process.pid if process is not None and process.poll() is None else None,
                "service_start_ticks": self.process_start,
                "ready_at": self.ready_at,
                "last_exit": self.last_exit,
                "last_error_class": self.last_error,
                "last_ready_application_build_id": self.last_ready_application_build_id,
                "restart_count_in_window": len(self.restart_times),
                "stop_grace_seconds": self.stop_grace_seconds,
                "control_active_clients": len(self.control_threads),
                "control_max_clients": MAX_CONTROL_CLIENTS,
                "adapter": self.adapter,
                "application_log_bytes": self.log_bytes,
                "application_log_dropped_bytes": self.log_dropped_bytes,
                "application_log_max_bytes": self.log_max_bytes,
                "listener_identity": (
                    {"dev": str(self.listener_identity[0]), "ino": str(self.listener_identity[1]), "mode": "0600"}
                    if self.listener_identity else None
                ),
                "control_identity": (
                    {"dev": str(self.control_identity[0]), "ino": str(self.control_identity[1]), "mode": "0600"}
                    if self.control_identity else None
                ),
                "argv_sha256": hashlib.sha256("\0".join(self.argv).encode()).hexdigest(),
                "declaration_sha256": self.declaration_sha256,
            }

    def write_status(self) -> None:
        atomic_json(self.status_path, self.status())

    def preflight_endpoint_reclamation(self) -> None:
        # Endpoint reclamation requires one dead, birth-pinned prior supervisor
        # plus exact inode evidence for every path that will be unlinked.
        observed: dict[str, os.stat_result] = {}
        for label, path in (("listener endpoint", self.listener_path), ("control endpoint", self.control_path)):
            try:
                observed[label] = path.lstat()
            except FileNotFoundError:
                pass
        if not observed:
            self.endpoint_reclaims = {}
            return
        record = load_prior_supervisor_status(self.status_path, self.name)
        if not prior_supervisor_is_dead(record):
            raise RuntimeError("prior operator supervisor is still live")
        approved: dict[str, tuple[int, int, int, int, int]] = {}
        for label, info in observed.items():
            key = "listener_identity" if label == "listener endpoint" else "control_identity"
            expected_dev_ino = recorded_socket_identity(record, key, label)
            identity = private_socket_identity(info, label)
            if identity[:2] != expected_dev_ino:
                raise RuntimeError(f"existing {label} does not match prior status evidence")
            approved["listener" if label == "listener endpoint" else "control"] = identity
        self.endpoint_reclaims = approved

    def bind_listener(self) -> None:
        parent_fd = os.open(
            self.listener_path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        try:
            try:
                existing = os.stat(self.listener_path.name, dir_fd=parent_fd, follow_symlinks=False)
            except FileNotFoundError:
                existing = None
            if existing is not None:
                unlink_preflighted_socket_at(
                    parent_fd,
                    self.listener_path.name,
                    self.endpoint_reclaims.pop("listener", None),
                    "listener endpoint",
                )
            listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            listener.bind(str(self.listener_path))
            os.chmod(self.listener_path.name, 0o600, dir_fd=parent_fd, follow_symlinks=False)
            secured = os.stat(self.listener_path.name, dir_fd=parent_fd, follow_symlinks=False)
            if (
                not stat.S_ISSOCK(secured.st_mode)
                or secured.st_uid != os.geteuid()
                or stat.S_IMODE(secured.st_mode) != 0o600
            ):
                raise RuntimeError("listener endpoint is not private")
            listener.listen(32)
            listener.set_inheritable(True)
            self.listener = listener
            self.listener_identity = (secured.st_dev, secured.st_ino)
        finally:
            os.close(parent_fd)

    def bind_control(self) -> None:
        parent_fd = os.open(
            self.control_path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        try:
            try:
                current = os.stat(
                    self.control_path.name, dir_fd=parent_fd, follow_symlinks=False
                )
            except FileNotFoundError:
                current = None
            if current is not None:
                unlink_preflighted_socket_at(
                    parent_fd,
                    self.control_path.name,
                    self.endpoint_reclaims.pop("control", None),
                    "control endpoint",
                )
            control = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            control.bind(str(self.control_path))
            os.chmod(
                self.control_path.name, 0o600, dir_fd=parent_fd, follow_symlinks=False
            )
            secured = os.stat(
                self.control_path.name, dir_fd=parent_fd, follow_symlinks=False
            )
            identity = private_socket_identity(secured, "control endpoint")
            control.listen(8)
            control.settimeout(0.2)
            self.control = control
            self.control_identity = identity[:2]
        finally:
            os.close(parent_fd)

    def wait_ready(self, descriptor: int, generation: int) -> bool:
        selector = selectors.DefaultSelector()
        selector.register(descriptor, selectors.EVENT_READ)
        deadline = time.monotonic() + self.ready_timeout
        payload = bytearray()
        try:
            while time.monotonic() < deadline:
                process = self.process
                if process is None or process.poll() is not None:
                    self.last_error = "exit-before-ready"
                    return False
                events = selector.select(min(0.2, deadline - time.monotonic()))
                if not events:
                    continue
                chunk = os.read(descriptor, 4096)
                if not chunk:
                    self.last_error = "ready-pipe-closed"
                    return False
                payload.extend(chunk)
                if len(payload) > 8192:
                    self.last_error = "ready-record-too-large"
                    return False
                if b"\n" not in payload:
                    continue
                try:
                    record = json.loads(bytes(payload).split(b"\n", 1)[0])
                except (UnicodeError, json.JSONDecodeError):
                    self.last_error = "invalid-ready-record"
                    return False
                if (
                    isinstance(record, dict)
                    and record.get("schema") == READY_SCHEMA
                    and record.get("service_generation") == generation
                ):
                    build_id = record.get("application_build_id")
                    if build_id is not None and (
                        not isinstance(build_id, str) or BUILD_ID_PATTERN.fullmatch(build_id) is None
                    ):
                        self.last_error = "invalid-application-build-id"
                        return False
                    with self.lock:
                        self.last_ready_application_build_id = build_id
                    return True
                self.last_error = "mismatched-ready-record"
                return False
            self.last_error = "ready-timeout"
            return False
        finally:
            selector.close()

    def drain_application_log(self, descriptor: int) -> None:
        log_descriptor: int | None = None
        try:
            try:
                log_descriptor = os.open(
                    self.log_path,
                    os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
                    0o600,
                )
                metadata = os.fstat(log_descriptor)
                if (
                    not stat.S_ISREG(metadata.st_mode)
                    or metadata.st_uid != os.geteuid()
                    or stat.S_IMODE(metadata.st_mode) != 0o600
                    or metadata.st_nlink != 1
                ):
                    os.close(log_descriptor)
                    log_descriptor = None
            except OSError:
                log_descriptor = None
            while True:
                try:
                    chunk = os.read(descriptor, 65536)
                except InterruptedError:
                    continue
                if not chunk:
                    break
                with self.lock:
                    permitted = 0 if log_descriptor is None else min(
                        len(chunk), max(0, self.log_max_bytes - self.log_bytes)
                    )
                    first_drop = self.log_dropped_bytes == 0 and len(chunk) > permitted
                    self.log_bytes += permitted
                    self.log_dropped_bytes += len(chunk) - permitted
                    if first_drop:
                        self.write_status()
                if permitted and log_descriptor is not None:
                    view = memoryview(chunk)[:permitted]
                    while view:
                        try:
                            written = os.write(log_descriptor, view)
                        except InterruptedError:
                            continue
                        except OSError:
                            with self.lock:
                                self.log_bytes -= len(view)
                                self.log_dropped_bytes += len(view)
                            os.close(log_descriptor)
                            log_descriptor = None
                            break
                        view = view[written:]
        finally:
            os.close(descriptor)
            if log_descriptor is not None:
                os.close(log_descriptor)

    def spawn_direct(self) -> bool:
        assert self.listener is not None
        with self.lock:
            self.generation += 1
            generation = self.generation
            self.state = "starting"
            self.ready_at = None
            self.last_error = None
            self.write_status()
        ready_read, ready_write = os.pipe2(os.O_CLOEXEC)
        os.set_inheritable(ready_write, True)
        log_read, log_write = os.pipe2(os.O_CLOEXEC)
        inherited_names = {
            "HOME", "PATH", "SHELL", "USER", "LOGNAME", "LANG", "LC_ALL", "TERM",
            "TMPDIR", "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME",
            "GLASSTTY_HOME", "SANDCODEX_ACTIVE", "SANDCODEX_OUTER_PROJECT", "SANDCODEX_RUN_ID",
            "SANDCODEX_TEMP", "VIRTUAL_ENV", "PYTHONPATH", "SSL_CERT_FILE", "NIX_SSL_CERT_FILE",
            "NODE_USE_ENV_PROXY",
            "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
            "http_proxy", "https_proxy", "all_proxy", "no_proxy",
        }
        environment = {key: value for key, value in os.environ.items() if key in inherited_names}
        environment.update(
            {
                "SANDCODEX_LISTEN_FD": str(self.listener.fileno()),
                "SANDCODEX_READY_FD": str(ready_write),
                "SANDCODEX_OPERATOR_SERVICE_GENERATION": str(generation),
                "SANDCODEX_OPERATOR_SERVICE_NAME": self.name,
            }
        )
        try:
            process = subprocess.Popen(
                self.argv,
                cwd=self.cwd,
                env=environment,
                stdin=subprocess.DEVNULL,
                stdout=log_write,
                stderr=log_write,
                pass_fds=(self.listener.fileno(), ready_write),
                start_new_session=True,
                close_fds=True,
            )
        except OSError:
            os.close(ready_read)
            os.close(ready_write)
            os.close(log_read)
            os.close(log_write)
            with self.lock:
                self.process = None
                self.state = "failed"
                self.last_error = "spawn-failed"
                self.write_status()
            return False
        os.close(ready_write)
        os.close(log_write)
        threading.Thread(
            target=self.drain_application_log,
            args=(log_read,),
            name=f"operator-log-{generation}",
            daemon=True,
        ).start()
        with self.lock:
            self.process = process
            self.process_start = process_start_ticks(process.pid)
            self.write_status()
        ready = self.wait_ready(ready_read, generation)
        os.close(ready_read)
        if not ready:
            stop_group(process, self.stop_grace_seconds)
            with self.lock:
                self.last_exit = process.returncode
                self.process = None
                self.process_start = None
                self.state = "failed"
                self.write_status()
            return False
        with self.lock:
            self.state = "ready"
            self.ready_at = utc_now()
            self.write_status()
        return True

    def spawn_loop(self) -> None:
        # Linux parent-death signaling follows the thread that created the
        # child. Every generation must therefore come from this one durable
        # thread, never from a short-lived control-client thread.
        while True:
            request = self.spawn_queue.get()
            if request is None:
                return
            completed, result = request
            try:
                result.append(self.spawn_direct())
            except BaseException as error:
                result.append(error)
            finally:
                completed.set()

    def spawn(self) -> bool:
        spawner = self.spawner
        if spawner is None or not spawner.is_alive():
            raise RuntimeError("persistent service spawn thread is unavailable")
        completed = threading.Event()
        result: list[object] = []
        self.spawn_queue.put((completed, result))
        while not completed.wait(0.2):
            if not spawner.is_alive():
                raise RuntimeError("persistent service spawn thread stopped")
        outcome = result[0]
        if isinstance(outcome, BaseException):
            raise outcome
        return bool(outcome)

    def stop_child(self, desired: str = "stopped") -> None:
        with self.lock:
            self.desired = desired
            process = self.process
            self.state = "stopping" if process is not None else "stopped"
            self.write_status()
        if process is not None:
            stop_group(process, self.stop_grace_seconds)
        with self.lock:
            self.last_exit = process.returncode if process is not None else self.last_exit
            self.process = None
            self.process_start = None
            self.ready_at = None
            self.state = "stopped"
            self.write_status()

    def restart_allowed(self) -> bool:
        cutoff = time.monotonic() - self.restart_window
        while self.restart_times and self.restart_times[0] < cutoff:
            self.restart_times.popleft()
        return len(self.restart_times) < self.restart_limit

    def monitor_loop(self) -> None:
        while not self.shutdown_event.is_set():
            self.wake.wait(0.2)
            self.wake.clear()
            with self.lock:
                process = self.process
                desired = self.desired
            if process is None:
                continue
            returncode = process.poll()
            if returncode is None:
                continue
            with self.command_lock:
                with self.lock:
                    if self.process is not process:
                        continue
                    desired = self.desired
                teardown_error = None
                try:
                    stop_group(process, self.stop_grace_seconds)
                except RuntimeError:
                    teardown_error = "old-descendants-not-reaped"
                with self.lock:
                    if self.process is not process:
                        continue
                    self.last_exit = returncode
                    self.process = None
                    self.process_start = None
                    self.ready_at = None
                    self.state = "failed" if returncode else "stopped"
                    self.last_error = teardown_error or ("unexpected-exit" if desired == "running" else None)
                    self.write_status()
                    should_restart = (
                        teardown_error is None
                        and desired == "running"
                        and self.restart_mode == "on-failure"
                        and returncode != 0
                        and self.restart_allowed()
                    )
                    if should_restart:
                        self.restart_times.append(time.monotonic())
                        delay = self.restart_base_delay * (2 ** max(0, len(self.restart_times) - 1))
                    else:
                        delay = 0
            if should_restart and not self.shutdown_event.wait(delay):
                with self.command_lock:
                    with self.lock:
                        still_needed = self.desired == "running" and self.process is None
                    if still_needed:
                        self.spawn()

    def control_client(self, connection: socket.socket) -> None:
        try:
            connection.settimeout(5)
            data = bytearray()
            while b"\n" not in data and len(data) <= MAX_CONTROL_BYTES:
                chunk = connection.recv(4096)
                if not chunk:
                    break
                data.extend(chunk)
            if len(data) > MAX_CONTROL_BYTES or b"\n" not in data:
                response = {"ok": False, "error": "invalid-request"}
            else:
                try:
                    request = json.loads(bytes(data).split(b"\n", 1)[0])
                except (UnicodeError, json.JSONDecodeError):
                    request = None
                if not isinstance(request, dict):
                    response = {"ok": False, "error": "invalid-json"}
                elif request.get("op") == "status":
                    response = {"ok": True, "status": self.status()}
                elif request.get("op") in {"stop", "restart"}:
                    expected = request.get("expected_generation")
                    # Generation comparison and mutation must share command_lock.
                    # Otherwise two concurrent clients can both validate the same
                    # generation before either command changes service state.
                    with self.command_lock:
                        with self.lock:
                            current = self.generation
                        if isinstance(expected, bool) or expected != current:
                            response = {"ok": False, "error": "stale-generation", "current_generation": current}
                        elif request["op"] == "stop":
                            self.stop_child()
                            response = {"ok": True, "status": self.status()}
                        else:
                            self.stop_child(desired="restarting")
                            with self.lock:
                                self.desired = "running"
                            started = self.spawn()
                            response = {"ok": started, "status": self.status(), **({} if started else {"error": "restart-failed"})}
                else:
                    response = {"ok": False, "error": "unsupported-operation"}
            connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode())
        except OSError:
            pass
        finally:
            connection.close()

    def control_client_thread(self, connection: socket.socket) -> None:
        try:
            self.control_client(connection)
        finally:
            with self.lock:
                self.control_threads.discard(threading.current_thread())
            self.control_slots.release()

    @staticmethod
    def reject_busy_control(connection: socket.socket) -> None:
        try:
            connection.sendall(b'{"error":"busy","ok":false}\n')
        except OSError:
            pass
        finally:
            connection.close()

    def serve_control(self) -> None:
        assert self.control is not None
        while not self.shutdown_event.is_set():
            try:
                connection, _ = self.control.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            if not self.control_slots.acquire(blocking=False):
                self.reject_busy_control(connection)
                continue
            thread = threading.Thread(
                target=self.control_client_thread,
                args=(connection,),
                name="operator-service-control-client",
                daemon=True,
            )
            with self.lock:
                self.control_threads.add(thread)
            try:
                thread.start()
            except BaseException:
                with self.lock:
                    self.control_threads.discard(thread)
                self.control_slots.release()
                connection.close()
                raise

    def run(self) -> int:
        self.preflight_endpoint_reclamation()
        self.bind_listener()
        self.bind_control()
        self.spawner = threading.Thread(target=self.spawn_loop, name="operator-service-spawner", daemon=True)
        self.spawner.start()
        self.monitor = threading.Thread(target=self.monitor_loop, name="operator-service-monitor", daemon=True)
        self.monitor.start()
        started = self.spawn()
        while (
            not started
            and self.restart_mode == "on-failure"
            and not self.shutdown_event.is_set()
            and self.restart_allowed()
        ):
            self.restart_times.append(time.monotonic())
            delay = self.restart_base_delay * (2 ** max(0, len(self.restart_times) - 1))
            if self.shutdown_event.wait(delay):
                break
            started = self.spawn()
        if not started and self.restart_mode == "never":
            return 70
        print(json.dumps({"ready": self.state == "ready", "status": self.status(), "control_socket": str(self.control_path)}), flush=True)
        self.serve_control()
        return 0

    def close(self) -> None:
        self.shutdown_event.set()
        self.wake.set()
        with self.command_lock:
            self.stop_child()
        self.spawn_queue.put(None)
        if self.spawner is not None:
            self.spawner.join(timeout=2)
        if self.control is not None:
            self.control.close()
        with self.lock:
            control_threads = tuple(self.control_threads)
        for thread in control_threads:
            thread.join(timeout=1)
        if self.monitor is not None:
            self.monitor.join(timeout=1)
        if self.listener is not None:
            self.listener.close()
        try:
            current = self.listener_path.lstat()
            if self.listener_identity == (current.st_dev, current.st_ino) and stat.S_ISSOCK(current.st_mode):
                self.listener_path.unlink()
        except FileNotFoundError:
            pass
        try:
            current = self.control_path.lstat()
            if (
                self.control_identity == (current.st_dev, current.st_ino)
                and stat.S_ISSOCK(current.st_mode)
                and current.st_uid == os.geteuid()
            ):
                self.control_path.unlink()
        except FileNotFoundError:
            pass
        self.write_status()


def load_config(filename: str) -> dict[str, Any]:
    path = Path(filename)
    info = private_file(path, "configuration")
    if info.st_size > MAX_CONFIG_BYTES:
        raise ValueError("configuration is too large")
    value = json.loads(path.read_text())
    if not isinstance(value, dict) or value.get("schema") != CONFIG_SCHEMA:
        raise ValueError("unsupported configuration schema")
    if not isinstance(value.get("name"), str) or not value["name"].replace("-", "").isalnum() or len(value["name"]) > 32:
        raise ValueError("invalid service name")
    if not isinstance(value.get("run_id"), str) or not value["run_id"] or len(value["run_id"]) > 96:
        raise ValueError("invalid run id")
    return value


def main() -> int:
    if len(sys.argv) != 2:
        fail("usage: sandcodex-operator-service CONFIG.json", 64)
    try:
        supervisor = Supervisor(load_config(sys.argv[1]))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        fail(str(error))

    def request_shutdown(_signum: int, _frame: object) -> None:
        supervisor.shutdown_event.set()
        if supervisor.control is not None:
            supervisor.control.close()

    signal.signal(signal.SIGTERM, request_shutdown)
    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGHUP, request_shutdown)
    try:
        return supervisor.run()
    finally:
        supervisor.close()


if __name__ == "__main__":
    raise SystemExit(main())
OPERATOR_SERVICE
}

