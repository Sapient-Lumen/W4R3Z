sc_start_browser_viewer_control() {
  (( SC_BROWSER && ! SC_BARE )) || return 0
  [[ -z "$SC_BROWSER_VIEWER_PID" ]] || return 0
  local server="$SC_RUN_ROOT/browser-launch/browser-viewer-control.cjs" attempt
  sc_atomic "$server" 700 <<'NODE'
#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const net = require('node:net');
const { spawnSync } = require('node:child_process');
const [socketPath, xdotool, display, xauthority, windowId] = process.argv.slice(2);
if (!socketPath?.startsWith('/') || !/^\d*$/.test(windowId || '')) process.exit(64);
try { fs.unlinkSync(socketPath); } catch (error) { if (error.code !== 'ENOENT') throw error; }
let visible = false;
function reply(socket, value) { socket.end(`${JSON.stringify(value)}\n`); }
function setVisibility(action) {
  if (!windowId || !xdotool || !display || !xauthority)
    return { ok:false,schema:'sandcodex.browser-viewer.v1',error:'host-viewer-unavailable',visible:false };
  const command = action === 'show' ? 'windowmap' : 'windowunmap';
  const result = spawnSync(xdotool, [command, '--sync', windowId], {
    env:{ PATH:'/run/current-system/sw/bin:/usr/bin:/bin',DISPLAY:display,XAUTHORITY:xauthority },
    encoding:'utf8',timeout:5000,
  });
  if (result.status !== 0) return {
    ok:false,schema:'sandcodex.browser-viewer.v1',error:'viewer-transition-failed',
    detail:String(result.stderr || '').slice(0,300),visible,
  };
  visible = action === 'show';
  return { ok:true,schema:'sandcodex.browser-viewer.v1',action,visible,
    browser_process_restarted:false,profile_preserved:true };
}
const server = net.createServer(socket => {
  let bytes = Buffer.alloc(0);
  socket.on('data', chunk => {
    bytes = Buffer.concat([bytes, chunk]);
    if (bytes.length > 4096) return socket.destroy();
    const newline = bytes.indexOf(10); if (newline < 0) return;
    let request;
    try { request = JSON.parse(bytes.subarray(0,newline).toString('utf8')); }
    catch { return reply(socket,{ok:false,error:'invalid-json'}); }
    if (!request || Object.keys(request).length !== 1 ||
        !['show','hide','status'].includes(request.action))
      return reply(socket,{ok:false,error:'invalid-viewer-request'});
    if (request.action === 'status') return reply(socket,{
      ok:true,schema:'sandcodex.browser-viewer.v1',available:Boolean(windowId),visible,
      backend:windowId ? 'xephyr' : 'xvfb',browser_process_running:true,
    });
    reply(socket,setVisibility(request.action));
  });
  socket.on('error',()=>{});
});
server.listen(socketPath,()=>fs.chmodSync(socketPath,0o600));
function stop() { server.close(()=>{ try{fs.unlinkSync(socketPath);}catch{} process.exit(0); }); }
process.on('SIGINT',stop); process.on('SIGTERM',stop);
NODE
  (
    sc_close_inherited_fds
    exec env -i PATH="$SC_PATH" "$SC_SETPRIV" --pdeathsig TERM "$(command -v node)" \
      "$server" "$SC_BROWSER_VIEWER_SOCKET" "$SC_XDOTOOL" \
      "$SC_BROWSER_HOST_DISPLAY" "$SC_BROWSER_HOST_XAUTHORITY" "$SC_BROWSER_VIEWER_WINDOW"
  ) >>"$SC_RUN_ROOT/browser-service.log" 2>&1 & SC_BROWSER_VIEWER_PID=$!
  SC_BROWSER_VIEWER_START="$(sc_process_start "$SC_BROWSER_VIEWER_PID" 2>/dev/null || true)"
  [[ "$SC_BROWSER_VIEWER_START" =~ ^[0-9]+$ ]] || return 1
  for (( attempt=0; attempt<100; attempt++ )); do
    [[ -S "$SC_BROWSER_VIEWER_SOCKET" ]] && break
    sc_pid_still_matches "$SC_BROWSER_VIEWER_PID" "$SC_BROWSER_VIEWER_START" || break
    sleep 0.02
  done
  [[ -S "$SC_BROWSER_VIEWER_SOCKET" && ! -L "$SC_BROWSER_VIEWER_SOCKET" &&
    "$(stat -c %u:%a -- "$SC_BROWSER_VIEWER_SOCKET" 2>/dev/null || true)" == "$(id -u):600" ]]
}

sc_start_browser_display() {
  (( SC_BROWSER && ! SC_BARE )) || return 0
  [[ -z "$SC_BROWSER_DISPLAY_PID" ]] || return 0
  local display_file="$SC_RUN_ROOT/browser-display" xauthority="$SC_RUN_ROOT/browser.xauthority"
  local seed="$SC_RUN_ROOT/browser.xauthority.seed" cookie number attempt title
  cookie="$("$SC_MCOOKIE")"
  if [[ ! "$cookie" =~ ^[0-9a-fA-F]{32}$ ]]; then
    sc_log_event error browser_display "could not create a nested-display authentication cookie"
    sc_err "could not create a nested-display authentication cookie"
    return 1
  fi
  : >"$xauthority"; : >"$seed"; chmod 600 "$xauthority" "$seed"
  if ! "$SC_XAUTH" -f "$seed" add :0 . "$cookie" >/dev/null 2>&1; then
    sc_log_event error browser_display "could not seed nested-display authentication"
    sc_err "could not seed nested-display authentication"
    return 1
  fi
  if ! "$SC_XAUTH" -f "$seed" nlist :0 2>/dev/null | sed 's/^..../ffff/' | \
    "$SC_XAUTH" -f "$xauthority" nmerge - >/dev/null 2>&1; then
    sc_log_event error browser_display "could not initialize nested-display authentication"
    sc_err "could not initialize nested-display authentication"
    return 1
  fi
  rm -f -- "$seed" "$display_file"
  title="Sandcodex browser - $(basename -- "$SC_PROJECT")"
  if [[ -n "$SC_BROWSER_HOST_DISPLAY" ]]; then
    sc_note "starting a hidden private browser viewer"
    (
      sc_close_inherited_fds 3
      exec env DISPLAY="$SC_BROWSER_HOST_DISPLAY" XAUTHORITY="$SC_BROWSER_HOST_XAUTHORITY" \
        "$SC_SETPRIV" --pdeathsig TERM "$SC_XEPHYR" \
        -displayfd 3 -auth "$xauthority" -screen 1440x900 -resizeable \
        -title "$title" -nolisten tcp -noreset -no-host-grab
    ) 3>"$display_file" >>"$SC_RUN_ROOT/browser-service.log" 2>&1 &
  else
    sc_note "starting private off-screen browser display"
    (
      sc_close_inherited_fds 3
      exec "$SC_SETPRIV" --pdeathsig TERM "$SC_XVFB" \
        -displayfd 3 -auth "$xauthority" -screen 0 1440x900x24 -nolisten tcp -noreset
    ) 3>"$display_file" >>"$SC_RUN_ROOT/browser-service.log" 2>&1 &
  fi
  SC_BROWSER_DISPLAY_PID=$!
  SC_BROWSER_DISPLAY_START="$(sc_process_start "$SC_BROWSER_DISPLAY_PID" 2>/dev/null || true)"
  if [[ ! "$SC_BROWSER_DISPLAY_START" =~ ^[0-9]+$ ]]; then
    sc_log_event error browser_display "could not identify the private browser display"
    sc_err "could not identify the private browser display"
    return 1
  fi
  for (( attempt=0; attempt<150; attempt++ )); do
    [[ -s "$display_file" ]] && break
    kill -0 "$SC_BROWSER_DISPLAY_PID" 2>/dev/null || break
    sleep 0.1
  done
  if [[ ! -s "$display_file" ]] || ! kill -0 "$SC_BROWSER_DISPLAY_PID" 2>/dev/null; then
    sc_log_event error browser_display "the private browser display could not start"
    sc_err "the private browser display could not start"
    return 1
  fi
  number="$(tr -d '[:space:]' <"$display_file")"
  if [[ ! "$number" =~ ^[0-9]+$ ]]; then
    sc_log_event error browser_display "the private browser display returned an invalid number"
    sc_err "the private browser display returned an invalid number"
    return 1
  fi
  if ! "$SC_XAUTH" -f "$xauthority" add ":$number" . "$cookie" >/dev/null 2>&1; then
    sc_log_event error browser_display "could not authorize Chromium on the private display"
    sc_err "could not authorize Chromium on the private display"
    return 1
  fi
  for (( attempt=0; attempt<100; attempt++ )); do
    [[ -S "/tmp/.X11-unix/X$number" ]] && break
    kill -0 "$SC_BROWSER_DISPLAY_PID" 2>/dev/null || break
    sleep 0.1
  done
  if [[ ! -S "/tmp/.X11-unix/X$number" ]]; then
    sc_log_event error browser_display "the private browser display socket did not appear"
    sc_err "the private browser display socket did not appear"
    return 1
  fi
  SC_BROWSER_DISPLAY=":$number"; SC_BROWSER_XAUTHORITY="$xauthority"
  SC_BROWSER_VIEWER_WINDOW=""
  if [[ -n "$SC_BROWSER_HOST_DISPLAY" ]]; then
    for (( attempt=0; attempt<100; attempt++ )); do
      SC_BROWSER_VIEWER_WINDOW="$(env DISPLAY="$SC_BROWSER_HOST_DISPLAY" \
        XAUTHORITY="$SC_BROWSER_HOST_XAUTHORITY" "$SC_XDOTOOL" search --pid "$SC_BROWSER_DISPLAY_PID" \
        --class Xephyr 2>/dev/null | head -n1 || true)"
      [[ "$SC_BROWSER_VIEWER_WINDOW" =~ ^[1-9][0-9]*$ ]] && break
      sleep 0.02
    done
    [[ "$SC_BROWSER_VIEWER_WINDOW" =~ ^[1-9][0-9]*$ ]] || {
      sc_err "private browser viewer window could not be identified"; return 1;
    }
    env DISPLAY="$SC_BROWSER_HOST_DISPLAY" XAUTHORITY="$SC_BROWSER_HOST_XAUTHORITY" \
      "$SC_XDOTOOL" windowunmap --sync "$SC_BROWSER_VIEWER_WINDOW" >/dev/null 2>&1 || {
        sc_err "private browser viewer could not start hidden"; return 1;
      }
    sc_note "private browser ready off-screen · use sandcodex-browser show when a human should see it"
  fi
  sc_start_browser_viewer_control || {
    sc_err "private browser viewer control could not start"; return 1;
  }
}

sc_start_safe_browser_network() {
  (( SC_BROWSER && ! SC_BARE )) || return 0
  sc_start_browser_display || return $?
  rm -f -- "$SC_BROWSER_PROXY_CONFIG" "$SC_AGENT_SOCKET" "$SC_BROWSER_WEB_SOCKET"
  (
    sc_close_inherited_fds
    exec env -i PATH="$SC_PATH" HOME="$SC_BROWSER_HOME" XDG_CONFIG_HOME="$SC_BROWSER_HOME/.config" \
      XDG_CACHE_HOME="$SC_BROWSER_HOME/cache" XDG_DATA_HOME="$SC_BROWSER_HOME/data" \
      XDG_STATE_HOME="$SC_BROWSER_HOME/state" XDG_RUNTIME_DIR="$SC_BROWSER_HOME/runtime" \
      DISPLAY="$SC_BROWSER_DISPLAY" XAUTHORITY="$SC_BROWSER_XAUTHORITY" \
      LANG="${LANG:-C.UTF-8}" TERM="${TERM:-xterm-256color}" \
      "$SC_SETPRIV" --pdeathsig TERM "$(command -v node)" \
        "$SC_PROXY_TMP/browser-broker.js" "$SC_BROWSER_PROXY_CONFIG" \
        "$SC_AGENT_SOCKET" "$SC_BROWSER_NAMESPACE_PROXY_PORT"
  ) >>"$SC_RUN_ROOT/browser-service.log" 2>&1 &
  SC_BROWSER_BROKER_PID=$!
  SC_BROWSER_BROKER_START="$(sc_process_start "$SC_BROWSER_BROKER_PID" 2>/dev/null || true)"
  if [[ ! "$SC_BROWSER_BROKER_START" =~ ^[0-9]+$ ]]; then
    sc_log_event error browser_broker "could not identify the browser broker"
    sc_err "could not identify the browser broker"
    return 1
  fi
  local attempt proxy_server proxy_port status expected_proxy="http://127.0.0.1:$SC_BROWSER_NAMESPACE_PROXY_PORT"
  for (( attempt=0; attempt<100; attempt++ )); do
    [[ -f "$SC_BROWSER_PROXY_CONFIG" ]] && break
    kill -0 "$SC_BROWSER_BROKER_PID" 2>/dev/null || break
    sleep 0.1
  done
  if [[ ! -f "$SC_BROWSER_PROXY_CONFIG" ]] || \
    ! kill -0 "$SC_BROWSER_BROKER_PID" 2>/dev/null; then
    sc_log_event error browser_broker "the private browser network broker could not start"
    sc_err "the private browser network broker could not start"
    return 1
  fi
  if [[ "$(stat -c %u -- "$SC_BROWSER_PROXY_CONFIG")" != "$(id -u)" || \
    "$(stat -c %a -- "$SC_BROWSER_PROXY_CONFIG")" != 600 || \
    "$(stat -c %h -- "$SC_BROWSER_PROXY_CONFIG")" != 1 ]]; then
    sc_log_event error browser_broker "browser proxy configuration is not private"
    sc_err "browser proxy configuration is not private"
    return 1
  fi
  if ! proxy_server="$(jq -er '.host_server | select(type == "string")' "$SC_BROWSER_PROXY_CONFIG")"; then
    sc_log_event error browser_broker "browser proxy did not publish a valid endpoint"
    sc_err "browser proxy did not publish a valid endpoint"
    return 1
  fi
  if ! jq -e --arg expected "$expected_proxy" '
    type == "object" and
    .server == $expected and
    (.host_server | type == "string" and test("^http://127\\.0\\.0\\.1:[0-9]{1,5}$")) and
    (.username | type == "string" and length >= 20 and length <= 128) and
    (.password | type == "string" and length >= 40 and length <= 128) and
    .bypass == "<-loopback>"
  ' "$SC_BROWSER_PROXY_CONFIG" >/dev/null; then
    sc_log_event error browser_broker "browser proxy published an invalid private configuration"
    sc_err "browser proxy published an invalid private configuration"
    return 1
  fi
  proxy_port="${proxy_server##*:}"
  if [[ ! "$proxy_port" =~ ^[0-9]{1,5}$ ]] || (( proxy_port < 1 || proxy_port > 65535 )); then
    sc_log_event error browser_broker "browser proxy published an invalid host port"
    sc_err "browser proxy published an invalid host port"
    return 1
  fi
  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SOCAT" \
      "UNIX-LISTEN:$SC_BROWSER_WEB_SOCKET,fork,mode=0600" "TCP4:127.0.0.1:$proxy_port"
  ) >>"$SC_RUN_ROOT/browser-service.log" 2>&1 &
  SC_BROWSER_WEB_BRIDGE_PID=$!
  SC_BROWSER_WEB_BRIDGE_START="$(sc_process_start "$SC_BROWSER_WEB_BRIDGE_PID" 2>/dev/null || true)"
  if [[ ! "$SC_BROWSER_WEB_BRIDGE_START" =~ ^[0-9]+$ ]]; then
    sc_log_event error browser_broker "could not identify the browser network bridge"
    sc_err "could not identify the browser network bridge"
    return 1
  fi
  for (( attempt=0; attempt<100; attempt++ )); do
    [[ -S "$SC_BROWSER_WEB_SOCKET" ]] && break
    kill -0 "$SC_BROWSER_WEB_BRIDGE_PID" 2>/dev/null || break
    sleep 0.02
  done
  if [[ ! -S "$SC_BROWSER_WEB_SOCKET" ]] || ! kill -0 "$SC_BROWSER_WEB_BRIDGE_PID" 2>/dev/null || \
    [[ "$(stat -c %u -- "$SC_BROWSER_WEB_SOCKET" 2>/dev/null || true)" != "$(id -u)" || \
      "$(stat -c %a -- "$SC_BROWSER_WEB_SOCKET" 2>/dev/null || true)" != 600 ]]; then
    sc_log_event error browser_broker "the private browser network bridge could not start"
    sc_err "the private browser network bridge could not start"
    return 1
  fi
  status="$(curl --silent --show-error --max-time 5 --noproxy '' --proxy "$proxy_server" \
    --output /dev/null --write-out '%{http_code}' http://sandcodex.invalid/ 2>>"$SC_LOG" || true)"
  if [[ "$status" != 407 ]]; then
    sc_log_event error browser_broker "browser proxy accepted an unauthenticated request" "status=${status:-missing}"
    sc_err "browser proxy accepted an unauthenticated request"
    return 1
  fi
}

sc_start_browser_broker() {
  (( SC_BROWSER )) || return 0
  local mux="$SC_RUN_ROOT/browser-launch/browser-mcp-mux.cjs"
  local supervisor="$SC_RUN_ROOT/browser-launch/browser-mcp-supervisor.cjs"
  local attempt service test_service=""
  sc_start_safe_browser_network || return $?
  rm -f -- "$SC_BROWSER_SOCKET" "$SC_BROWSER_MCP_OWNER_STATUS" \
