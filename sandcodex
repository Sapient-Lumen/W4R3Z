sc_ready_json() {
  local active_room=false worker_available=false provider_name="unknown" model_name="unknown" contract=""
  local browser_available=false desktop_available=false cooldowns provider_mode="$SC_PROVIDER_MODE"
  local environment="${SANDCODEX_ENVIRONMENT:-}" provider_auto=false candidate_models='[]'
  local key_bank profile="$SC_REMOTE_PROFILE" provider_quota_rotation=false
  local provider_account_start_policy=none
  [[ "${SANDCODEX_ACTIVE:-0}" == 1 ]] && active_room=true
  if [[ "$active_room" == true && -n "${SANDCODEX_CAMPAIGN:-}" ]] && command -v sandcodex-worker >/dev/null 2>&1; then
    worker_available=true
  fi
  [[ -n "${SANDCODEX_BROWSER_OUTPUT:-}" ]] && browser_available=true
  [[ -n "${SANDCODEX_DESKTOP_OUTPUT:-}" ]] && desktop_available=true
  if [[ -n "$environment" && -r "$environment" ]] &&
    jq -e '.schema=="sandcodex.agent-environment.v1"' "$environment" >/dev/null 2>&1; then
    provider_mode="$(jq -r '.remote.provider_mode // "native"' "$environment")"
    if [[ "$provider_mode" == gemini ]] && jq -e '.gemini.active==true' "$environment" >/dev/null; then
      provider_name="$(jq -r '.gemini.provider' "$environment")"
      model_name="$(jq -r '.gemini.routing_model' "$environment")"
      provider_auto="$(jq -r '.gemini.auto' "$environment")"
      candidate_models="$(jq -c '.gemini.candidate_models' "$environment")"
      provider_quota_rotation="$(jq -r '.gemini.automatic_switching.quota_key_rotation // false' "$environment")"
      provider_account_start_policy="$(jq -r '.gemini.automatic_switching.account_start_policy // "bank-order-from-first-healthy"' "$environment")"
    elif [[ "$provider_mode" == remote ]] && jq -e '.remote.active==true' "$environment" >/dev/null; then
      provider_name="$(jq -r '.remote.provider' "$environment")"
      model_name="$(jq -r '.remote.requested_model // "unknown"' "$environment")"
      provider_auto="$(jq -r '.remote.remote_auto' "$environment")"
    fi
  elif [[ -r /run/sandcodex/frontend/local-provider-contract.json ]]; then
    contract=/run/sandcodex/frontend/local-provider-contract.json
    provider_name="$(jq -r '.provider // .name // .mode // "remote"' "$contract" 2>/dev/null || printf unknown)"
    model_name="$(jq -r '.model // .requested_model // .runtime_model // .selected_model // "unknown"' "$contract" 2>/dev/null || printf unknown)"
  elif [[ -n "$SC_MODEL" ]]; then
    provider_name="$SC_PROVIDER_MODE"
    model_name="$SC_MODEL"
  fi
  if [[ "$provider_mode" == gemini ]]; then
    key_bank="$(sc_gemini_keybank_path)"
    cooldowns="$(sc_gemini_cooldowns_json 2>/dev/null || printf '{"schema":"sandcodex.gemini-cooldowns.v1","keys":{},"models":{}}')"
    profile=free-only
  else
    key_bank="$(sc_remote_keybank_path)"
    cooldowns="$(sc_remote_cooldowns_json 2>/dev/null || printf '{"schema":"sandcodex.remote-cooldowns.v1","keys":{},"models":{}}')"
  fi
  jq -n -c \
    --arg schema "sandcodex.ready.v1" \
    --arg generated_at "$(sc_now)" \
    --arg project "$SC_PROJECT" \
    --arg project_control "$SC_CONTROL" \
    --arg provider "$provider_name" \
    --arg provider_mode "$provider_mode" \
    --arg model "$model_name" \
    --arg profile "$profile" \
    --arg key_bank "$key_bank" \
    --argjson provider_auto "$provider_auto" \
    --argjson provider_quota_rotation "$provider_quota_rotation" \
    --arg provider_account_start_policy "$provider_account_start_policy" \
    --argjson candidate_models "$candidate_models" \
    --argjson active_room "$active_room" \
    --argjson worker_available "$worker_available" \
    --argjson browser_available "$browser_available" \
    --argjson desktop_available "$desktop_available" \
    --argjson cooldowns "$cooldowns" '
      {
        schema:$schema,
        result:"ready",
        generated_at:$generated_at,
        project:$project,
        project_control:$project_control,
        active_room:$active_room,
        provider_mode:$provider_mode,
        provider:$provider,
        model:$model,
        selection_profile:$profile,
        credential_values_disclosed:false,
        raw_provider_content_disclosed:false,
        prompt_disclosed:false,
        capabilities:{
          worker_available:$worker_available,
          worker_command:(if $worker_available then "sandcodex-worker" else null end),
          browser_available:$browser_available,
          desktop_available:$desktop_available,
          automatic_selection:$provider_auto,
          pre_output_key_failover:($provider_mode=="gemini"),
          pre_output_auth_standby_promotion:($provider_mode=="gemini"),
          quota_key_rotation:($provider_mode=="gemini" and $provider_quota_rotation),
          account_start_policy:(if $provider_mode=="gemini" then $provider_account_start_policy else null end),
          pre_output_model_failover:($provider_mode=="gemini" and $provider_auto),
          pending_tool_auth_standby_promotion:($provider_mode=="gemini"),
          pending_tool_quota_key_rotation:($provider_mode=="gemini" and $provider_quota_rotation),
          pending_tool_model_failover:($provider_mode=="gemini" and $provider_auto),
          exact_cross_model_state_replay:($provider_mode=="gemini"),
          clean_turn_retry:($provider_mode=="gemini"),
          transparent_visible_stream_replay:false,
          transparent_mid_turn_failover:($provider_mode=="remote" and $provider_auto),
          already_running_tui_retarget:false
        },
        candidate_models:$candidate_models,
        cooldowns:$cooldowns,
        commands:({
          ready:"sandcodex ready"
        } + (if $provider_mode=="gemini" then {
          continuity:"sandcodex gemini continuity --key-bank " + ($key_bank|@sh),
          report:"sandcodex gemini report --key-bank " + ($key_bank|@sh),
          fresh_auto:"sandcodex gemini auto --key-bank " + ($key_bank|@sh),
          first_turn:"sandcodex gemini auto --key-bank " + ($key_bank|@sh) + " task --prompt-file PROMPT.md --then-interactive"
        } else {
          continuity:"sandcodex remote continuity --key-bank " + ($key_bank|@sh),
          report:"sandcodex remote report --key-bank " + ($key_bank|@sh),
          fresh_auto:"sandcodex remote auto --key-bank " + ($key_bank|@sh) + " --profile " + ($profile|@sh),
          first_turn:"sandcodex remote auto --key-bank " + ($key_bank|@sh) + " --profile " + ($profile|@sh) + " task --prompt-file PROMPT.md --then-interactive"
        } end) + {
          worker_doctor:(if $worker_available then "sandcodex-worker doctor" else null end),
          worker_start:(if $worker_available then "sandcodex-worker start worker-1 --turns 8 --prompt '\''Task text'\''" else null end),
          worker_events:(if $worker_available then "sandcodex-worker events worker-1 --follow" else null end)
        }),
        notes:([
          "Use this card before inspecting generated internals.",
          "Worker commands appear only when this exact process has campaign authority.",
          "Cooldowns are advisory skip state for fresh selection; they do not disclose credential values.",
          "Live TUI retargeting and replay after visible partial output remain false."
        ] + (if $provider_mode=="gemini" then [
          "Gemini auto can fall through the free-model ladder before any semantic output is exposed.",
          ("Fresh logical request account start: " + $provider_account_start_policy + "."),
          "Native Google Search is deliberately disabled; browser and desktop tools remain Sandcodex-owned."
        ] + (if $provider_quota_rotation then [
          "The five-account Gemini bank is an automatic rotation pool: quota, rate, authentication, or permission pressure moves a buffered request to the next healthy account key on the strongest model.",
          "A pending signed tool call keeps its exact Interactions history while rotating account keys on the origin model, then can fail over across models.",
          "Account-wide cooldowns skip one key across the ladder; account/model cooldowns preserve the remaining usable routes for that account."
        ] else [
          "This resumed conversation uses a historical bound Gemini adapter; account rotation capabilities remain exactly those recorded by that adapter."
        ] end) elif $provider_mode=="remote" then [
          "Remote-auto profile affects fresh auto launches and remote-auto worker starts/restarts.",
          (if $provider_auto then
            "The bound OpenRouter relay can change routes only while a complete response remains private; it never replays visible bytes."
           else
            "A fixed remote route does not gain remote-auto relay failover."
           end)
        ] else [
          "OpenRouter and Gemini routing claims apply only when that provider mode is active."
        ] end))
      }'
}

sc_ready_render() {
  local result=$1
  printf 'sandcodex ready\n'
  jq -r '
    "  project     \(.project)",
    "  room        " + (if .active_room then "active command room" else "host-side inspection" end),
    "  route       \(.provider) · \(.model)",
