    def guarded_touch_stroke(
        self,
        start_x: int,
        start_y: int,
        end_x: int,
        end_y: int,
        steps: int,
        duration_milliseconds: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        """Arm, validate, and atomically dispatch one native wl_touch stroke."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor touch connection is unauthorized")
        for value, label in (
            (start_x, "start_x"), (start_y, "start_y"),
            (end_x, "end_x"), (end_y, "end_y"),
        ):
            if type(value) is not int or not (
                -SWAY_HIT_TEST_MAX_COORDINATE
                <= value
                <= SWAY_HIT_TEST_MAX_COORDINATE
            ):
                raise ToolError(f"compositor touch-stroke {label} coordinate is invalid")
        if type(steps) is not int or not 1 <= steps <= TOUCH_STROKE_MAX_STEPS:
            raise ToolError("compositor touch-stroke steps are outside the supported range")
        if type(duration_milliseconds) is not int or not (
            steps + 1
            <= duration_milliseconds
            <= TOUCH_STROKE_MAX_DURATION_MILLISECONDS
        ):
            raise ToolError(
                "compositor touch-stroke duration must permit strictly increasing "
                "event timestamps and remain within the supported range"
            )
        if not callable(validator):
            raise ToolError("compositor touch-stroke target validator is unavailable")

        action = {
            "duration_milliseconds": duration_milliseconds,
            "end_x": end_x,
            "end_y": end_y,
            "start_x": start_x,
            "start_y": start_y,
            "steps": steps,
        }
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-touch-stroke", **action}),
                    "SANDCODEX_HIT_TEST arm-touch-stroke",
                )
                target, ticket = self._normalize_touch_stroke_arm_reply(
                    arm_reply, start_x, start_y, end_x, end_y, steps,
                    duration_milliseconds,
                )
                ticket_action = {"dispatch_kind": "touch-stroke", **action}
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-touch-stroke-ticket-v1\0"
                    + canonical_json(ticket_action)
                    + b"\0"
                    + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": TOUCH_STROKE_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-recipient-touch-stroke",
                    "dispatch_kind": "touch-stroke",
                    **action,
                    "path_points": steps + 1,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": "view-surface+hit-surface+wl-touch-resource",
                    "dispatch_path": COMPOSITOR_TOUCH_STROKE_DISPATCH_PATH,
                    "dispatch_atomicity": GUARDED_TOUCH_STROKE_DISPATCH_ATOMICITY,
                    "route_scope": COMPOSITOR_TOUCH_ROUTE_SCOPE,
                    "coordinate_scope": COMPOSITOR_TOUCH_COORDINATE_SCOPE,
                    "path_scope": COMPOSITOR_TOUCH_STROKE_PATH_SCOPE,
                    "time_scope": COMPOSITOR_TOUCH_STROKE_TIME_SCOPE,
                    "release_scope": COMPOSITOR_TOUCH_RELEASE_SCOPE,
                    "wall_clock_pacing": False,
                    "pointer_fallback_policy": "deny",
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorTouchStrokeGrant(
                    start_x=start_x,
                    start_y=start_y,
                    end_x=end_x,
                    end_y=end_y,
                    steps=steps,
                    duration_milliseconds=duration_milliseconds,
                    ticket=ticket,
                    target=target,
                    grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_touch_stroke_arms += 1
                self.last_compositor_touch_stroke_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_touch_stroke_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touch stroke could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-touch-stroke",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-touch-stroke",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_touch_stroke_reply(cancel_reply)
                    self.compositor_touch_stroke_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_touch_stroke_dispatch_failures += 1
                    self._set_failure(cancel_error)
                    raise ToolError(
                        "compositor touch-stroke validation failed and its private "
                        "ticket could not be cancelled; the compositor seal is quarantined"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        **action,
                        "op": "dispatch-touch-stroke",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-touch-stroke",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_touch_stroke_reply(
                    dispatch_reply, grant
                )
                self.compositor_touch_stroke_dispatches += 1
                self.last_compositor_touch_stroke_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_touch_stroke_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor touch stroke failed closed: {error}"
                ) from error

