#define BTN_RIGHT_CODE 0x111U
#define BTN_MIDDLE_CODE 0x112U
#define SCROLL_FIXED_UNITS 10

enum command_kind {
    COMMAND_MOTION,
    COMMAND_BUTTON,
    COMMAND_CLICK,
    COMMAND_SCROLL,
    COMMAND_PING,
    COMMAND_QUIT,
};

