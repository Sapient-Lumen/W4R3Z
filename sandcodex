+static void sandcodex_query_hit_test(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length,
+		enum sandcodex_dispatch_kind dispatch_kind) {
+	json_object *x_object = NULL, *y_object = NULL;
+	json_object *delta_x_object = NULL, *delta_y_object = NULL;
+	const char *operation = dispatch_kind == SANDCODEX_DISPATCH_CLICK
+		? "arm-click" : dispatch_kind == SANDCODEX_DISPATCH_SCROLL
+		? "arm-scroll" : "hit-test";
+	bool arm_dispatch = dispatch_kind != SANDCODEX_DISPATCH_NONE;
+	bool scroll_dispatch = dispatch_kind == SANDCODEX_DISPATCH_SCROLL;
+	sandcodex_clear_dispatch_ticket(client);
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == (scroll_dispatch ? 5 : 3) &&
+		sandcodex_request_operation(request, operation) &&
+		json_object_object_get_ex(request, "x", &x_object) &&
+		json_object_object_get_ex(request, "y", &y_object) &&
+		json_object_is_type(x_object, json_type_int) &&
+		json_object_is_type(y_object, json_type_int);
+	if (scroll_dispatch) {
+		valid_shape = valid_shape &&
+			json_object_object_get_ex(request, "delta_x", &delta_x_object) &&
+			json_object_object_get_ex(request, "delta_y", &delta_y_object) &&
+			json_object_is_type(delta_x_object, json_type_int) &&
+			json_object_is_type(delta_y_object, json_type_int);
+	}
+	if (!valid_shape) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+	int64_t x = json_object_get_int64(x_object);
+	int64_t y = json_object_get_int64(y_object);
+	int64_t delta_x_value = scroll_dispatch
+		? json_object_get_int64(delta_x_object) : 0;
+	int64_t delta_y_value = scroll_dispatch
+		? json_object_get_int64(delta_y_object) : 0;
+	if (x < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			x > SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			y < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			y > SANDCODEX_HIT_TEST_COORDINATE_LIMIT) {
+		sandcodex_send_hit_test_failure(client, "coordinate-out-of-range");
+		return;
+	}
+	if (scroll_dispatch && (delta_x_value < -1 || delta_x_value > 1 ||
+			delta_y_value < -1 || delta_y_value > 1 ||
+			(delta_x_value != 0) + (delta_y_value != 0) != 1)) {
+		sandcodex_send_hit_test_failure(client, "scroll-vector-invalid");
+		return;
+	}
+	int32_t delta_x = (int32_t)delta_x_value;
+	int32_t delta_y = (int32_t)delta_y_value;
+	bool canonical = scroll_dispatch
+		? sandcodex_scroll_arm_payload_canonical(payload, payload_length,
+			delta_x, delta_y, x, y)
+		: sandcodex_query_payload_canonical(payload, payload_length, operation, x, y);
+	if (!canonical) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sandcodex_hit_target target = {0};
+	struct sway_view *view = NULL;
+	struct wlr_surface *view_surface = NULL;
+	struct wlr_surface *target_surface = NULL;
+	double hit_x = (double)x;
+	double hit_y = (double)y;
+	struct sway_input_device *device = NULL;
+	if (arm_dispatch) {
+		device = sandcodex_single_virtual_pointer(seat);
+		if (!device || !sandcodex_cursor_near_requested(seat, x, y,
+				&hit_x, &hit_y) || !seat->cursor ||
+				seat->cursor->pressed_button_count != 0) {
+			sandcodex_send_hit_test_failure(client,
+				"dispatch-precondition-failed");
+			return;
+		}
+	}
+	if (!sandcodex_capture_hit_target(seat, hit_x, hit_y, &target, &view,
+			&view_surface, &target_surface)) {
+		sandcodex_send_hit_test_failure(client, "hit-test-failed");
+		return;
+	}
+
+	const char *ticket = NULL;
+	if (arm_dispatch) {
+		struct sandcodex_dispatch_ticket *grant =
+			&client->sandcodex_dispatch_ticket;
+		if (!target.hit || !sandcodex_random_ticket(grant->value)) {
+			sandcodex_clear_dispatch_ticket(client);
+			sandcodex_send_hit_test_failure(client,
+				"dispatch-precondition-failed");
+			return;
+		}
+		grant->armed = true;
+		grant->kind = dispatch_kind;
+		grant->x = x;
+		grant->y = y;
+		grant->delta_x = delta_x;
+		grant->delta_y = delta_y;
+		grant->cursor_x_bits = sandcodex_double_bits(hit_x);
+		grant->cursor_y_bits = sandcodex_double_bits(hit_y);
+		grant->target = target;
+		grant->sway_device_address = (uintptr_t)device;
+		grant->wlr_device_address = (uintptr_t)device->wlr_device;
+		strcpy(grant->device_identifier, device->identifier);
+		if (!sandcodex_bind_dispatch_ticket(client, device->wlr_device,
+				view_surface, target_surface)) {
+			sandcodex_clear_dispatch_ticket(client);
+			sandcodex_send_hit_test_failure(client,
+				"dispatch-lifetime-bind-failed");
+			return;
+		}
+		ticket = grant->value;
+	}
+	sandcodex_send_hit_target(client, operation, x, y, &target, view, ticket,
+		dispatch_kind, delta_x, delta_y, 0, 0, 0, NULL, NULL);
+}
