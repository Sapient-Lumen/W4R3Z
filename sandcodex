        if self.is_wayland:
            try:
                if action_event_receipt is None or action_event_dispatch_sequence is None:
                    raise ToolError("guarded compositor dispatch receipt is incomplete")
                action_event_complete_sequence = self._compositor_action_barrier(
                    action_event_receipt, "dispatch-complete"
                )
                seal = self.compositor_event_seal
                if seal is None:
                    raise ToolError("birth-pinned compositor event seal disappeared after dispatch")
                dispatch_summary = seal.summarize(
                    action_event_dispatch_sequence, action_event_complete_sequence
                )
                self._merge_compositor_action_summary(
                    action_event_receipt, "dispatch", dispatch_summary
                )
                self._reject_compositor_interval(
                    dispatch_summary,
                    "during guarded-action dispatch",
                    reject_transitions=False,
                )
            except Exception as seal_error:
                if deferred_file_copy is not None:
                    deferred_file_copy.discard()
                    deferred_file_copy = None
                if deferred_output_watch is not None:
                    deferred_output_watch.discard()
                    deferred_output_watch = None
                self.journal.append(
                    "guarded-action",
                    action_name,
                    action_arguments,
                    action_event_receipt,
                    error=str(seal_error),
                )
                raise

        if deferred_output_watch is not None:
            if (
                not self.is_wayland
                or output_snapshot_fence is None
                or action_event_receipt is None
            ):
                deferred_output_watch.discard()
                raise ToolError(
                    "OutputWatchSeal capability publication lost its guarded dispatch authority"
                )
            try:
                output_watch_result = self._publish_output_watch_after_dispatch(
                    deferred_output_watch,
                    output_snapshot_fence,
                    action_event_receipt,
                )
            except Exception as publication_error:
                # Publication did not commit. Preserve the original failure if
                # only the best-effort audit append encounters an I/O error.
                try:
                    self.journal.append(
                        "output-watch-publication",
                        action_name,
                        {"kind": "watch"},
                        {
                            "publication_status": "withheld",
                            "watch_token_retained": False,
                            "watch_token_fingerprinted": False,
                            "compositor_action_seal": action_event_receipt,
                        },
                        error=str(publication_error),
                    )
                except OSError:
                    pass
                raise
            finally:
                deferred_output_watch = None

            # The one-use capability is already published. Audit I/O failure
            # makes the audit outcome unknown; it must not be relabeled as a
            # withheld capability or trigger an automatic retry/republication.
            _publication_event, publication_audit = (
                sc_observe_output_watch_publication_audit(
                    lambda: self.journal.append(
                        "output-watch-publication",
                        action_name,
                        {
                            "target_launch_id": observation.launch_id,
                            "kind": "watch",
                        },
                        {
                            "publication_status": "published",
                            "baseline_entry_count": output_watch_result.get(
                                "baseline_entry_count"
                            ),
                            "baseline_file_count": output_watch_result.get(
                                "baseline_file_count"
                            ),
                            "baseline_directory_count": output_watch_result.get(
                                "baseline_directory_count"
                            ),
                            "baseline_total_bytes": output_watch_result.get(
                                "baseline_total_bytes"
                            ),
                            "watch_token_retained": False,
                            "watch_token_fingerprinted": False,
                            "compositor_event_chain_sha256": (
                                output_watch_result.get("publication_seal", {}).get(
                                    "compositor_event_chain_sha256"
                                )
                            ),
                        },
                    ),
                    expected_errors=(OSError,),
                )
            )
            output_watch_result["publication_committed"] = True
            output_watch_result["publication_audit"] = publication_audit
            try:
                result = json_result(output_watch_result)
            except Exception as finalization_error:
                raise ToolError(
                    "OutputWatchSeal capability was published but response finalization failed; "
                    "inspect before repeating"
                ) from finalization_error

        if deferred_file_copy is not None:
            copy_fence = (
                output_snapshot_fence
                if deferred_file_copy.source_mode in {"launch-output", "output-watch"}
                else keyboard_fence
            )
            if not self.is_wayland or copy_fence is None or action_event_receipt is None:
                deferred_file_copy.discard()
                raise ToolError("FileCopySeal publication lost its guarded dispatch authority")
            try:
                file_copy_result = self._publish_file_copy_after_dispatch(
                    deferred_file_copy,
                    copy_fence,
                    action_event_receipt,
                )
            except Exception as publication_error:
                self.journal.append(
                    "file-copy-publication",
                    action_name,
                    {"kind": deferred_file_copy.copy_kind},
                    {
                        "publication_status": "withheld",
                        "compositor_action_seal": action_event_receipt,
                    },
                    error=str(publication_error),
                )
                raise
            finally:
                deferred_file_copy = None
            try:
                result = json_result(file_copy_result)
                self.journal.append(
                    "file-copy-publication",
                    action_name,
                    {
                        "target_launch_id": observation.launch_id,
                        "kind": file_copy_result.get("kind"),
                        "source_mode": file_copy_result.get("source_mode"),
                    },
                    {
                        "file_count": file_copy_result.get("file_count"),
                        "directory_count": file_copy_result.get("directory_count"),
                        "entry_count": file_copy_result.get("entry_count"),
                        "source_bytes": file_copy_result.get("source_bytes"),
                        "uri_list_bytes": file_copy_result.get("uri_list_bytes"),
                        "source_mode": file_copy_result.get("source_mode"),
                        "explicit_source_count": file_copy_result.get("explicit_source_count"),
                        "discovered_source_count": file_copy_result.get("discovered_source_count"),
                        "snapshot_mode": file_copy_result.get("snapshot_mode"),
                        "publication_status": "published",
                        "compositor_event_chain_sha256": (
                            file_copy_result.get("publication_seal", {}).get(
                                "compositor_event_chain_sha256"
                            )
                        ),
                    },
                )
            except Exception as finalization_error:
                raise ToolError(
                    "FileCopySeal artifact was published but response or audit finalization failed; "
                    "the persistent artifact is retained"
                ) from finalization_error

        if result is None:
            raise ToolError("guarded action completed without a result")
        journal_result = result.get("structuredContent") if isinstance(result, dict) else None
        if action_name == "desktop_copy" and isinstance(journal_result, dict):
            journal_result = {
                key: journal_result.get(key)
                for key in (
                    "copied", "kind", "characters", "source_bytes", "bytes",
                    "mime", "width", "height", "canonicalized",
                    "metadata_retained", "frames", "canonical_chunks", "chord",
                    "file_count", "directory_count", "entry_count", "uri_list_bytes", "snapshot_mode",
                    "source_mode", "explicit_source_count", "discovered_source_count",
                    "watching", "baseline_entry_count", "baseline_file_count",
                    "baseline_directory_count", "baseline_total_bytes",
                    "watch_capability_ttl_seconds", "watch_capability_one_attempt",
                    "snapshot_retention", "source_namespace", "selection_payload_retained",
                    "stable_payload_fingerprint_retained", "untrusted", "trust",
                    "publication_committed", "publication_audit",
                )
            }
        elif action_name == "desktop_paste" and isinstance(journal_result, dict):
            journal_result = {
                key: journal_result.get(key)
                for key in (
                    "pasted", "kind", "mime", "characters", "payload_bytes",
                    "width", "height", "canonicalized", "metadata_retained",
                    "frames", "canonical_chunks", "paste_chord",
                )
            }
        elif action_name == "desktop_drop" and isinstance(journal_result, dict):
            journal_result = {
                key: journal_result.get(key)
                for key in (
                    "dropped", "kind", "mime", "characters", "payload_bytes",
                    "width", "height", "canonicalized", "metadata_retained",
                    "frames", "canonical_chunks", "x", "y", "origin_corner",
                    "segments", "action",
                )
            }
        self.journal.append(
            "guarded-action",
            action_name,
            action_arguments,
            {
                "result": journal_result,
                "compositor_action_seal": action_event_receipt,
            },
        )
        settle = as_int(arguments.get("settle_milliseconds", 150), 0, 5000, "settle_milliseconds")
        if settle:
            time.sleep(settle / 1000)
        if self.is_wayland:
            if action_event_receipt is None or action_event_complete_sequence is None:
                raise ToolError("guarded compositor settlement receipt is incomplete")
            action_event_settled_sequence = self._compositor_action_barrier(
                action_event_receipt, "settled"
            )
            seal = self.compositor_event_seal
            if seal is None:
                raise ToolError("birth-pinned compositor event seal disappeared during settlement")
            settlement_summary = seal.summarize(
                action_event_complete_sequence, action_event_settled_sequence
            )
            self._merge_compositor_action_summary(
                action_event_receipt, "settlement", settlement_summary
            )
            self._reject_compositor_interval(
                settlement_summary,
                "while the guarded action was settling",
                reject_transitions=False,
            )

        outcome_seal: dict[str, Any] | None = None
        outcome_anchor: dict[str, Any] | None = None
        outcome_verification_cycles = 0
        if outcome_policy is not None:
            outcome_verification_cycles = 1
            outcome_seal, outcome_anchor = self._wait_for_outcome(
                observation,
                managed,
                outcome_policy,
            )
            if self.is_wayland:
                if action_event_receipt is None or action_event_settled_sequence is None:
                    raise ToolError("guarded compositor outcome receipt is incomplete")
                action_event_outcome_sequence = self._compositor_action_barrier(
                    action_event_receipt, "outcome-complete"
                )
                seal = self.compositor_event_seal
                if seal is None:
                    raise ToolError("birth-pinned compositor event seal disappeared during outcome verification")
                outcome_summary = seal.summarize(
                    action_event_settled_sequence, action_event_outcome_sequence
                )
                self._merge_compositor_action_summary(
                    action_event_receipt, "outcome-wait", outcome_summary
                )
                self._reject_compositor_interval(
                    outcome_summary,
                    "while waiting for the guarded action outcome",
                    reject_transitions=False,
                )

        keyboard_final_transition = bool(
            keyboard_fence is not None and keyboard_fence.get("final_focus_transition")
        )
        pointer_final_transition = bool(
            pointer_fence is not None and pointer_fence.get("final_scene_transition")
        )
        include_fresh_accessibility = as_bool(
            arguments.get(
                "include_accessibility",
                observation.semantic_sha256 is not None
                or (
                    outcome_policy is not None
                    and outcome_policy.get("accessibility") is not None
                ),
            ),
            "include_accessibility",
        )

        def build_fresh_arguments(anchor: dict[str, Any] | None) -> dict[str, Any]:
            """Build a post-action capture from current, never stale, outcome authority.

            A bounded post-observation retry may replace a previously sealed active
            window or may fail to reseal any outcome. Reconstructing the complete
            argument object prevents a prior window_id/crop from surviving that
            authority transition—on both Wayland and compatibility X11.
            """
            fresh_arguments: dict[str, Any] = {
                "include_accessibility": include_fresh_accessibility,
            }
            if outcome_policy is not None:
                scope = outcome_policy["scope"]
                if scope == "reviewed":
                    fresh_arguments.update(observation.capture_arguments)
                elif (
                    scope == "active"
                    and managed is None
                    and observation.scene_id is None
                ):
                    if anchor is not None:
                        active_outcome_window = anchor.get("window_id")
                        if not isinstance(active_outcome_window, int):
                            raise ToolError("active-window outcome lost its final capture identity")
                        fresh_arguments["window_id"] = active_outcome_window
                    else:
                        fresh_arguments.update(
                            self._outcome_capture_arguments(observation, managed, outcome_policy)
                        )
                # Launch-scoped active observations deliberately omit window_id
                # so observe() resolves the currently focused window in that
                # launch. Workstation scope deliberately omits all selectors.
            elif not keyboard_final_transition and not pointer_final_transition:
                fresh_arguments.update(observation.capture_arguments)
            else:
                # The final released unit may intentionally move focus to a new
                # dialog, and a click/drop may open, close, move, or replace the
                # reviewed top-level. Reusing the old window/crop would observe
                # the wrong surface or fail before reporting the transition.
                fresh_scope = (
                    "same-scene-set-private-output"
                    if self._observation_uses_scene_set(observation)
                    else "same-launch-private-output"
                    if self._observation_uses_launch_scene(observation)
                    else (
                        "active-launch-window"
                        if observation.launch_id is not None else "whole-workstation"
                    )
                )
                if keyboard_final_transition and keyboard_fence is not None:
                    keyboard_fence["fresh_observation_retargeted"] = True
                    keyboard_fence["fresh_observation_scope"] = fresh_scope
                if pointer_final_transition and pointer_fence is not None:
                    pointer_fence["fresh_observation_retargeted"] = True
                    pointer_fence["fresh_observation_scope"] = fresh_scope
            if observation.launch_id is not None:
                fresh_arguments["launch_id"] = observation.launch_id
            elif observation.scene_id is not None:
                fresh_arguments["scene_id"] = observation.scene_id
                fresh_arguments["scene_launch_ids"] = list(observation.scene_launch_ids)
            fresh_arguments = self._preserve_launch_scene_capture(
                observation, fresh_arguments
            )
            if (
                outcome_policy is not None
                and isinstance(outcome_policy.get("accessibility"), dict)
            ):
                fresh_arguments["include_accessibility"] = True
                fresh_arguments["accessibility"] = {
                    key: outcome_policy["accessibility"][key]
                    for key in (
                        "max_nodes", "max_depth", "text_limit", "timeout_milliseconds"
                    )
                }
            elif (
                fresh_arguments["include_accessibility"]
                and observation.semantic_options is not None
            ):
                fresh_arguments["accessibility"] = {
                    key: value
                    for key, value in observation.semantic_options.items()
                    if key != "process_ids"
                }
            return fresh_arguments

        fresh_arguments = build_fresh_arguments(outcome_anchor)
        fresh: dict[str, Any] | None = None
        fresh_outcome_binding: dict[str, Any] | None = None
        if self.is_wayland:
            if action_event_receipt is None or action_event_settled_sequence is None:
                raise ToolError("guarded compositor post-observation receipt is incomplete")
            seal = self.compositor_event_seal
            if seal is None:
                raise ToolError("birth-pinned compositor event seal disappeared before post-observation")
            observation_start_sequence = (
                action_event_outcome_sequence
                if action_event_outcome_sequence is not None
                else action_event_settled_sequence
            )
            for attempt in range(1, COMPOSITOR_POST_OBSERVATION_ATTEMPTS + 1):
                if attempt > 1 and outcome_policy is not None and outcome_anchor is not None:
                    outcome_verification_cycles += 1
                    outcome_seal, outcome_anchor = self._wait_for_outcome(
                        observation,
                        managed,
                        outcome_policy,
                    )
                    fresh_arguments = build_fresh_arguments(outcome_anchor)
                phase = "post-observation" if attempt == 1 else f"post-observation-retry-{attempt}"
                try:
                    candidate = self.observe(fresh_arguments)
                except ToolError as capture_error:
                    if not self._retryable_post_observation_capture(capture_error):
                        raise
                    observation_sequence = self._compositor_action_barrier(
                        action_event_receipt, phase
                    )
                    observation_summary = seal.summarize(
                        observation_start_sequence, observation_sequence
                    )
                    self._merge_compositor_action_summary(
                        action_event_receipt,
                        phase,
                        observation_summary,
                    )
                    action_event_receipt["post_observation_attempts"] = attempt
                    action_event_receipt["unstable_post_observation_captures"] = (
                        int(action_event_receipt.get(
                            "unstable_post_observation_captures", 0
                        )) + 1
                    )
                    self._reject_compositor_interval(
                        observation_summary,
                        "while retrying an unstable compulsory post-action capture",
                        reject_transitions=False,
                    )
                    if attempt == COMPOSITOR_POST_OBSERVATION_ATTEMPTS:
                        self._reject_compositor_interval(
                            observation_summary,
                            "while retrying an unstable compulsory post-action capture",
                            reject_transitions=True,
                        )
                        raise ToolError(
                            "compulsory post-action observation did not stabilize after "
                            "bounded read-only capture retries"
                        ) from capture_error
                    time.sleep(COMPOSITOR_POST_OBSERVATION_RETRY_MILLISECONDS / 1000)
                    observation_start_sequence = observation_sequence
                    continue
                try:
                    observation_sequence = self._compositor_action_barrier(
                        action_event_receipt, phase
                    )
                    observation_summary = seal.summarize(
                        observation_start_sequence, observation_sequence
                    )
                    self._merge_compositor_action_summary(
                        action_event_receipt, phase, observation_summary
                    )
                except Exception:
                    self._invalidate_observation_result(candidate)
                    action_event_receipt["invalidated_post_observations"] = (
                        int(action_event_receipt.get("invalidated_post_observations", 0)) + 1
                    )
                    raise
                action_event_receipt["post_observation_attempts"] = attempt
                fatal = int(observation_summary.get("fatal_events", 0))
                transitions = int(observation_summary.get("transition_events", 0))
                anchor_matches = True
                anchor_evidence: dict[str, Any] | None = None
                if not fatal and not transitions and outcome_policy is not None and outcome_anchor is not None:
                    candidate_structured = candidate.get("structuredContent")
                    candidate_identifier = (
                        candidate_structured.get("observation_id")
                        if isinstance(candidate_structured, dict) else None
                    )
                    candidate_observation = (
                        self.observations.get(candidate_identifier)
                        if isinstance(candidate_identifier, str) else None
                    )
                    if candidate_observation is None or candidate_observation.consumed:
                        raise ToolError("fresh outcome observation authority is absent")
                    accessibility_snapshot = (
                        candidate_structured.get("accessibility")
                        if isinstance(candidate_structured, dict) else None
                    )
                    anchor_matches, anchor_evidence = self._fresh_matches_outcome_anchor(
                        candidate_observation,
                        outcome_anchor,
                        outcome_policy,
                        accessibility_snapshot if isinstance(accessibility_snapshot, dict) else None,
                    )
                if not fatal and not transitions and anchor_matches:
                    fresh = candidate
                    fresh_outcome_binding = anchor_evidence
                    break
                self._invalidate_observation_result(candidate)
                action_event_receipt["invalidated_post_observations"] = (
                    int(action_event_receipt.get("invalidated_post_observations", 0)) + 1
                )
                self._reject_compositor_interval(
                    observation_summary,
                    "while constructing the compulsory post-action observation",
                    reject_transitions=False,
                )
                if attempt == COMPOSITOR_POST_OBSERVATION_ATTEMPTS:
                    if not anchor_matches:
                        raise ToolError(
                            "compulsory post-action observation drifted from the sealed outcome"
                        )
                    self._reject_compositor_interval(
                        observation_summary,
                        "while constructing the compulsory post-action observation",
                        reject_transitions=True,
                    )
                time.sleep(COMPOSITOR_POST_OBSERVATION_RETRY_MILLISECONDS / 1000)
                observation_start_sequence = observation_sequence
        else:
            for attempt in range(1, COMPOSITOR_POST_OBSERVATION_ATTEMPTS + 1):
                if attempt > 1 and outcome_policy is not None and outcome_anchor is not None:
                    outcome_verification_cycles += 1
                    outcome_seal, outcome_anchor = self._wait_for_outcome(
                        observation,
                        managed,
                        outcome_policy,
                    )
                    fresh_arguments = build_fresh_arguments(outcome_anchor)
                try:
                    candidate = self.observe(fresh_arguments)
                except ToolError as capture_error:
                    if not self._retryable_post_observation_capture(capture_error):
                        raise
                    if attempt == COMPOSITOR_POST_OBSERVATION_ATTEMPTS:
                        raise ToolError(
                            "compulsory post-action observation did not stabilize after "
                            "bounded read-only capture retries"
                        ) from capture_error
                    time.sleep(COMPOSITOR_POST_OBSERVATION_RETRY_MILLISECONDS / 1000)
                    continue
                anchor_matches = True
                anchor_evidence = None
                if outcome_policy is not None and outcome_anchor is not None:
                    candidate_structured = candidate.get("structuredContent")
                    candidate_identifier = (
                        candidate_structured.get("observation_id")
                        if isinstance(candidate_structured, dict) else None
                    )
                    candidate_observation = (
                        self.observations.get(candidate_identifier)
                        if isinstance(candidate_identifier, str) else None
                    )
                    if candidate_observation is None or candidate_observation.consumed:
                        raise ToolError("fresh outcome observation authority is absent")
                    accessibility_snapshot = (
                        candidate_structured.get("accessibility")
                        if isinstance(candidate_structured, dict) else None
                    )
                    anchor_matches, anchor_evidence = self._fresh_matches_outcome_anchor(
                        candidate_observation,
                        outcome_anchor,
                        outcome_policy,
                        accessibility_snapshot if isinstance(accessibility_snapshot, dict) else None,
                    )
                if anchor_matches:
                    fresh = candidate
                    fresh_outcome_binding = anchor_evidence
                    break
                self._invalidate_observation_result(candidate)
                if attempt == COMPOSITOR_POST_OBSERVATION_ATTEMPTS:
                    raise ToolError("compulsory post-action observation drifted from the sealed outcome")
        if fresh is None:
            raise ToolError("compulsory post-action observation did not stabilize")
        if outcome_seal is not None:
            outcome_seal["verification_cycles"] = outcome_verification_cycles
            outcome_seal["fresh_observation_binding"] = fresh_outcome_binding
            outcome_seal.pop("seal_sha256", None)
            outcome_seal["seal_sha256"] = hashlib.sha256(
                canonical_json(outcome_seal)
            ).hexdigest()
        if self.is_wayland:
            if action_event_receipt is None:
                self._invalidate_observation_result(fresh)
                raise ToolError("guarded compositor action receipt disappeared before completion")
            try:
                fresh_structured = fresh.get("structuredContent")
                fresh_identifier = (
                    fresh_structured.get("observation_id")
                    if isinstance(fresh_structured, dict) else None
                )
                fresh_observation = (
                    self.observations.get(fresh_identifier)
                    if isinstance(fresh_identifier, str) else None
                )
                if fresh_observation is None or fresh_observation.consumed:
                    raise ToolError(
                        "compulsory post-action observation authority is absent before receipt completion"
                    )
                self._bind_compositor_action_outcome(
                    action_event_receipt,
                    outcome_seal,
                )
                self._bind_compositor_post_observation(
                    action_event_receipt,
                    fresh_observation,
                )
                self._finalize_compositor_action_receipt(action_event_receipt)
            except Exception:
                self._invalidate_observation_result(fresh)
                raise
        structured = fresh.get("structuredContent", {})
        structured["action"] = {
            "name": action_name,
            "result": result.get("structuredContent") if isinstance(result, dict) else None,
            "pointer_latch": pointer_latch,
            "pointer_fence": pointer_fence,
            "keyboard_fence": keyboard_fence,
            "output_snapshot_fence": output_snapshot_fence,
            "outcome_seal": outcome_seal,
            "compositor_action_seal": action_event_receipt,
        }
        fresh["structuredContent"] = structured
        if fresh.get("content") and fresh["content"][0].get("type") == "text":
            fresh["content"][0]["text"] = json.dumps(structured, sort_keys=True)
        if copied_image_content is not None:
            content = fresh.setdefault("content", [])
            content.append(dict(copied_image_content))
        if (
            outcome_policy is not None
            and outcome_seal is not None
            and outcome_policy["required"]
            and outcome_seal.get("matched") is not True
        ):
            fresh["isError"] = True
            structured["action"]["verification_error"] = (
                "guarded action completed, but its required postcondition did not stabilize"
            )
            if fresh.get("content") and fresh["content"][0].get("type") == "text":
                fresh["content"][0]["text"] = json.dumps(structured, sort_keys=True)
        self.journal.append(
            "guarded-transaction",
            action_name,
            {
                "observation_id": identifier,
                "launch_id": observation.launch_id,
                "scene_id": observation.scene_id,
                "scene_launch_ids": list(observation.scene_launch_ids),
            },
            {
                "fresh_observation_id": structured.get("observation_id"),
                "compositor_action_seal": action_event_receipt,
            },
        )
        return fresh

    def audit(self, arguments: dict[str, Any]) -> dict[str, Any]:
        limit = as_int(arguments.get("limit", 50), 1, MAX_AUDIT_EVENTS, "limit")
        return json_result(self.journal.recent(limit))

