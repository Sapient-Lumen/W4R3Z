+            sandcodex_stylus.pad.button_count != 1 ||
+            wl_list_length(&sandcodex_stylus.pad.groups) != 1 ||
+            sandcodex_stylus.pad_group.ring_count != 1 ||
+            sandcodex_stylus.pad_group.rings !=
+                sandcodex_stylus.pad_group_rings ||
+            sandcodex_stylus.pad_group_rings[0] !=
+                SANDCODEX_TABLET_PAD_RING_INDEX ||
+            sandcodex_stylus.pad_group.strip_count != 1 ||
+            sandcodex_stylus.pad_group.strips !=
+                sandcodex_stylus.pad_group_strips ||
+            sandcodex_stylus.pad_group_strips[0] !=
+                SANDCODEX_TABLET_PAD_STRIP_INDEX ||
+            sandcodex_stylus.pad_group.button_count != 1 ||
+            sandcodex_stylus.pad_group.buttons !=
+                sandcodex_stylus.pad_group_buttons ||
+            sandcodex_stylus.pad_group_buttons[0] !=
+                SANDCODEX_TABLET_PAD_BUTTON_INDEX ||
+            sandcodex_stylus.pad_group.mode_count !=
+                SANDCODEX_TABLET_PAD_MODE_COUNT ||
+            sandcodex_stylus.pad_v2->wlr_pad != &sandcodex_stylus.pad ||
+            sandcodex_stylus.pad_v2->group_count != 1 ||
+            sandcodex_stylus.pad_v2->groups == NULL ||
+            sandcodex_stylus.pad_v2->groups[SANDCODEX_TABLET_PAD_MODE_GROUP_INDEX] !=
+                mode_index ||
+            sandcodex_stylus.pad_v2->grab !=
+                &sandcodex_stylus.pad_v2->default_grab ||
+            sandcodex_stylus.pad_v2->current_client != NULL) {
+        sway_log(SWAY_ERROR,
+            "Sandcodex tablet-pad idle attestation failed: mode_valid=%d initialized=%d "
+            "tablet=%d pad=%d ring=%zu strip=%zu button=%zu groups=%d "
+            "group_ring=%zu group_strip=%zu group_button=%zu group_modes=%u "
+            "wlr_pad=%d v2_groups=%zu modes=%d mode=%u "
+            "default_grab=%d current_client=%d",
+            sandcodex_tablet_pad_mode_index_valid(mode_index),
+            sandcodex_stylus.initialized, sandcodex_stylus.tablet_v2 != NULL,
+            sandcodex_stylus.pad_v2 != NULL, sandcodex_stylus.pad.ring_count,
+            sandcodex_stylus.pad.strip_count, sandcodex_stylus.pad.button_count,
+            wl_list_length(&sandcodex_stylus.pad.groups),
+            sandcodex_stylus.pad_group.ring_count,
+            sandcodex_stylus.pad_group.strip_count,
+            sandcodex_stylus.pad_group.button_count,
+            sandcodex_stylus.pad_group.mode_count,
+            sandcodex_stylus.pad_v2 && sandcodex_stylus.pad_v2->wlr_pad == &sandcodex_stylus.pad,
+            sandcodex_stylus.pad_v2 ? sandcodex_stylus.pad_v2->group_count : 0,
+            sandcodex_stylus.pad_v2 && sandcodex_stylus.pad_v2->groups != NULL,
+            sandcodex_stylus.pad_v2 && sandcodex_stylus.pad_v2->groups ?
+                sandcodex_stylus.pad_v2->groups[SANDCODEX_TABLET_PAD_MODE_GROUP_INDEX] : 0,
+            sandcodex_stylus.pad_v2 && sandcodex_stylus.pad_v2->grab == &sandcodex_stylus.pad_v2->default_grab,
+            sandcodex_stylus.pad_v2 && sandcodex_stylus.pad_v2->current_client != NULL);
+        return false;
+    }
+    return true;
+}
