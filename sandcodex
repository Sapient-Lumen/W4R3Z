sc_protected_mounts() {
  local -n mounts_ref=$1
  local path
  for path in "$SC_LOCAL/launcher" \
    "$SC_LOCAL/OWNER" "$SC_LOCAL/.gitignore" "$SC_WORK/agent" "$SC_AGENT_BIN"; do
    [[ ! -e "$path" && ! -L "$path" ]] && continue
    [[ ! -L "$path" ]] || sc_die "protected project path may not be a symlink: $path"
    mounts_ref+=(--ro-bind "$path" "$path")
  done
  if (( SC_DESKTOP )); then
    [[ -d "$SC_DESKTOP_OUTPUT" && ! -L "$SC_DESKTOP_OUTPUT" && \
      -d "$SC_DESKTOP_APPS" && ! -L "$SC_DESKTOP_APPS" && \
      -d "$SC_DESKTOP_STAGING" && ! -L "$SC_DESKTOP_STAGING" && \
      -d "$SC_DESKTOP_EXPORTS" && ! -L "$SC_DESKTOP_EXPORTS" ]] || \
      sc_die "desktop artifact vault is unavailable or unsafe"
    # FileCopySeal publication belongs to the credentialless desktop
    # controller. Re-project the complete desktop artifact root read-only over
    # the wider writable project bind so the ordinary Codex process tree can
    # consume screenshots and completed file-copy exports but cannot rename
    # their parent, replace a publication destination, mutate a snapshot, or
    # erase its evidence. Overlay both the launch-private apps tree and the
    # controller's pre-publication staging root with empty read-only tmpfs
    # mounts. Application output is disclosed only through an explicit
    # FileCopySeal publication, and no partial transaction is agent-visible.
    # The desktop controller runs in a distinct boundary and retains its
    # reviewed read-write bind; explicit BARE-METAL posture remains
    # intentionally unconfined.
    mounts_ref+=(
      --ro-bind "$SC_DESKTOP_OUTPUT" "$SC_DESKTOP_OUTPUT"
      --tmpfs "$SC_DESKTOP_APPS"
      --remount-ro "$SC_DESKTOP_APPS"
      --tmpfs "$SC_DESKTOP_STAGING"
      --remount-ro "$SC_DESKTOP_STAGING"
    )
  fi
}

