static int display_roundtrip(struct drop_state *state) {
    if (!state->topology_valid || state->display == NULL ||
            wl_display_roundtrip(state->display) < 0 || !state->topology_valid ||
            state->surface_closed || state->terminal_error) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int dispatch_ready_events(struct drop_state *state, int timeout_milliseconds) {
    if (state->display == NULL || wl_display_dispatch_pending(state->display) < 0 ||
            wl_display_flush(state->display) < 0) {
        return -1;
    }
    struct pollfd item = {
        .fd = wl_display_get_fd(state->display),
        .events = POLLIN,
        .revents = 0,
    };
    int result = 0;
    do {
        result = poll(&item, 1U, timeout_milliseconds);
    } while (result < 0 && errno == EINTR && !stop_requested);
    if (result < 0) {
        return -1;
    }
    if (result == 0) {
        return 0;
    }
    if ((item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
            (item.revents & POLLIN) == 0 || wl_display_dispatch(state->display) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (state->terminal_error || state->surface_closed || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    return 1;
}

static int create_transparent_buffer(struct drop_state *state) {
    const size_t bytes = ORIGIN_BUFFER_BYTES;
    int descriptor = memfd_create("sandcodex-drop-origin",
        MFD_CLOEXEC | MFD_ALLOW_SEALING | MFD_NOEXEC_SEAL);
    if (descriptor < 0 || fchmod(descriptor, 0600) < 0 ||
            ftruncate(descriptor, (off_t)bytes) < 0) {
        const int saved_errno = errno;
        if (descriptor >= 0) {
            (void)close(descriptor);
        }
        errno = saved_errno;
        return -1;
    }
    void *mapping = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED,
        descriptor, 0);
    if (mapping == MAP_FAILED) {
        const int saved_errno = errno;
        (void)close(descriptor);
        errno = saved_errno;
        return -1;
    }
    (void)memset(mapping, 0, bytes);
    if (munmap(mapping, bytes) < 0 ||
            fcntl(descriptor, F_ADD_SEALS,
                F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE |
                F_SEAL_SEAL | F_SEAL_EXEC) < 0) {
        const int saved_errno = errno;
        (void)close(descriptor);
        errno = saved_errno;
        return -1;
    }
    struct wl_shm_pool *pool = wl_shm_create_pool(state->shm, descriptor,
        (int32_t)bytes);
    if (pool == NULL) {
        const int saved_errno = errno;
        (void)close(descriptor);
        errno = saved_errno;
        return -1;
    }
    state->buffer = wl_shm_pool_create_buffer(pool, 0,
        (int32_t)ORIGIN_SIZE, (int32_t)ORIGIN_SIZE,
        (int32_t)(ORIGIN_SIZE * 4U), WL_SHM_FORMAT_ARGB8888);
    wl_shm_pool_destroy(pool);
    const int close_result = close(descriptor);
    if (state->buffer == NULL || close_result < 0) {
        return -1;
    }
    return 0;
}

static uint32_t corner_anchor(enum origin_corner corner) {
    switch (corner) {
        case ORIGIN_TOP_LEFT:
            return ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT;
        case ORIGIN_TOP_RIGHT:
            return ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
                ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT;
        case ORIGIN_BOTTOM_LEFT:
            return ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT;
        case ORIGIN_BOTTOM_RIGHT:
            return ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
                ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT;
    }
    return 0U;
}

static int initialize_wayland(struct drop_state *state) {
    state->display = wl_display_connect(NULL);
    if (state->display == NULL) {
        return -1;
    }
    state->topology_valid = true;
    state->registry = wl_display_get_registry(state->display);
    if (state->registry == NULL ||
            wl_registry_add_listener(state->registry, &registry_listener, state) < 0 ||
            wl_display_roundtrip(state->display) < 0 ||
            state->compositor == NULL || state->shm == NULL ||
            state->seat == NULL || state->manager == NULL ||
            state->layer_shell == NULL || state->compositor_count != 1U ||
            state->shm_count != 1U || state->seat_count != 1U ||
            state->manager_count != 1U || state->layer_shell_count != 1U ||
            state->manager_version < 3U || !state->topology_valid) {
        errno = EPROTO;
        return -1;
    }
    if (wl_seat_add_listener(state->seat, &seat_listener, state) < 0) {
        errno = EPROTO;
        return -1;
    }
    state->device = wl_data_device_manager_get_data_device(state->manager,
        state->seat);
    state->source = wl_data_device_manager_create_data_source(state->manager);
    if (state->device == NULL || state->source == NULL ||
            wl_data_source_add_listener(state->source, &source_listener, state) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (state->profile == PROFILE_PNG) {
        wl_data_source_offer(state->source, MIME_PNG);
    } else if (state->profile == PROFILE_FILES) {
        wl_data_source_offer(state->source, MIME_URI_LIST);
    } else {
        wl_data_source_offer(state->source, MIME_UTF8);
        wl_data_source_offer(state->source, MIME_TEXT);
        wl_data_source_offer(state->source, MIME_UTF8_STRING);
        if (state->payload_ascii) {
            wl_data_source_offer(state->source, MIME_STRING);
        }
    }
    wl_data_source_set_actions(state->source,
        WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);

    state->surface = wl_compositor_create_surface(state->compositor);
    if (state->surface == NULL || create_transparent_buffer(state) < 0) {
        return -1;
    }
    struct wl_region *input_region = wl_compositor_create_region(state->compositor);
    if (input_region == NULL) {
        return -1;
    }
    wl_region_add(input_region, 0, 0, (int32_t)ORIGIN_SIZE,
        (int32_t)ORIGIN_SIZE);
    wl_surface_set_input_region(state->surface, input_region);
    wl_region_destroy(input_region);
    state->layer_surface = zwlr_layer_shell_v1_get_layer_surface(
        state->layer_shell, state->surface, NULL,
        ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY, "sandcodex-drop-origin");
    if (state->layer_surface == NULL ||
            zwlr_layer_surface_v1_add_listener(state->layer_surface,
                &layer_listener, state) < 0) {
        errno = EPROTO;
        return -1;
    }
    zwlr_layer_surface_v1_set_size(state->layer_surface, ORIGIN_SIZE, ORIGIN_SIZE);
    zwlr_layer_surface_v1_set_anchor(state->layer_surface,
        corner_anchor(state->corner));
    zwlr_layer_surface_v1_set_exclusive_zone(state->layer_surface, -1);
    zwlr_layer_surface_v1_set_margin(state->layer_surface, 0, 0, 0, 0);
    zwlr_layer_surface_v1_set_keyboard_interactivity(state->layer_surface,
        ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE);
    wl_surface_commit(state->surface);
    for (unsigned attempt = 0U; attempt < 4U && !state->mapped; attempt++) {
        if (display_roundtrip(state) < 0) {
            return -1;
        }
    }
    if (!state->configured || !state->mapped || display_roundtrip(state) < 0) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int wait_until(struct drop_state *state, uint32_t timeout_milliseconds,
        bool (*predicate)(const struct drop_state *)) {
    const uint64_t deadline = monotonic_milliseconds() +
        (uint64_t)timeout_milliseconds;
    for (;;) {
        if (stop_requested || state->terminal_error || state->surface_closed ||
                !state->topology_valid) {
            errno = EPROTO;
            return -1;
        }
        if (predicate(state)) {
            return 1;
        }
        const uint64_t now = monotonic_milliseconds();
        if (now >= deadline) {
            return 0;
        }
        uint64_t remaining = deadline - now;
        if (remaining > (uint64_t)INT_MAX) {
            remaining = (uint64_t)INT_MAX;
        }
        const int result = dispatch_ready_events(state, (int)remaining);
        if (result < 0) {
            return -1;
        }
    }
}

static bool predicate_origin(const struct drop_state *state) {
    return state->pointer_available && state->pointer_entered;
}

static bool predicate_started(const struct drop_state *state) {
    return state->started;
}

static bool target_valid(const struct drop_state *state) {
    return state->started && state->target_mime[0] != '\0' &&
        state->selected_action == WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY;
}

static bool predicate_target(const struct drop_state *state) {
    return target_valid(state);
}

static int write_payload(struct drop_state *state, int descriptor) {
    unsigned char buffer[TRANSFER_CHUNK_BYTES];
    size_t offset = 0U;
    const uint64_t deadline = monotonic_milliseconds() +
        TRANSFER_TIMEOUT_MILLISECONDS;
    while (offset < state->payload_size && !stop_requested) {
        size_t wanted = state->payload_size - offset;
        if (wanted > sizeof(buffer)) {
            wanted = sizeof(buffer);
        }
        const ssize_t read_count = pread(state->payload_descriptor, buffer,
            wanted, (off_t)offset);
        if (read_count <= 0) {
            errno = EIO;
            return -1;
        }
        size_t written_total = 0U;
        while (written_total < (size_t)read_count && !stop_requested) {
            const ssize_t write_count = write(descriptor,
                buffer + written_total, (size_t)read_count - written_total);
            if (write_count > 0) {
                written_total += (size_t)write_count;
                continue;
            }
            if (write_count < 0 && errno != EAGAIN && errno != EWOULDBLOCK &&
                    errno != EINTR) {
                return -1;
            }
            const uint64_t now = monotonic_milliseconds();
            if (now >= deadline) {
                errno = ETIMEDOUT;
                return -1;
            }
            uint64_t remaining = deadline - now;
            if (remaining > (uint64_t)INT_MAX) {
                remaining = (uint64_t)INT_MAX;
            }
            struct pollfd item = {
                .fd = descriptor,
                .events = POLLOUT,
                .revents = 0,
            };
            int result = 0;
            do {
                result = poll(&item, 1U, (int)remaining);
            } while (result < 0 && errno == EINTR && !stop_requested);
            if (result <= 0 ||
                    (item.revents & (POLLERR | POLLHUP | POLLNVAL)) != 0 ||
                    (item.revents & POLLOUT) == 0) {
                errno = result == 0 ? ETIMEDOUT : EPIPE;
                return -1;
            }
        }
        offset += (size_t)read_count;
    }
    if (stop_requested) {
        errno = EINTR;
        return -1;
    }
    return 0;
}

static int authorize_request(struct drop_state *state, uint32_t request_id,
        uint32_t target_generation) {
    /*
     * Drain a compositor sync roundtrip immediately before any payload byte is
     * released.  This turns target/action withdrawals already queued on the
     * Wayland connection into local state before the generation check below.
     * A destination may request a pipe before drop/acceptance; such descriptors
     * remain empty until this controller-authorized, compositor-fresh point.
     */
    if (display_roundtrip(state) < 0) {
        return -1;
    }
    struct pending_request *request = find_pending(state, request_id);
    if (request == NULL || !request->announced || state->finished ||
            state->cancelled || state->terminal_error || !target_valid(state) ||
            target_generation != request->target_generation ||
            request->target_generation != state->target_generation ||
            state->target_generation != state->target_announced_generation ||
            request->selected_action != WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY ||
            request->selected_action != state->selected_action ||
            strcmp(request->accepted_mime, state->target_mime) != 0) {
        errno = EPROTO;
        return -1;
    }
    const int descriptor = request->descriptor;
    request->descriptor = -1;
    request->announced = false;
    const int result = write_payload(state, descriptor);
    const int saved_errno = errno;
    (void)close(descriptor);
    if (result < 0) {
        state->terminal_error = true;
        errno = saved_errno;
        return -1;
    }
    state->transfers_completed++;
    state->bytes_transferred += (uint64_t)state->payload_size;
    return 0;
}

enum next_kind {
    NEXT_TIMEOUT,
    NEXT_REQUEST,
    NEXT_TARGET,
    NEXT_DROPPED,
    NEXT_FINISHED,
    NEXT_CANCELLED,
};

static enum next_kind next_event(struct drop_state *state,
        uint32_t timeout_milliseconds, struct pending_request **request) {
    *request = NULL;
    const uint64_t deadline = monotonic_milliseconds() +
        (uint64_t)timeout_milliseconds;
    for (;;) {
        if (state->terminal_error || !state->topology_valid ||
                state->surface_closed || stop_requested) {
            errno = EPROTO;
            return NEXT_CANCELLED;
        }
        if (state->cancelled) {
            return NEXT_CANCELLED;
        }
        if (state->target_generation != state->target_announced_generation) {
            state->target_announced_generation = state->target_generation;
            return NEXT_TARGET;
        }
        struct pending_request *candidate = find_unannounced(state);
        if (candidate != NULL) {
            if (!target_valid(state) ||
                    candidate->target_generation != state->target_generation ||
                    candidate->selected_action != state->selected_action ||
                    strcmp(candidate->accepted_mime, state->target_mime) != 0) {
                state->terminal_error = true;
                errno = EPROTO;
                return NEXT_CANCELLED;
            }
            candidate->announced = true;
            *request = candidate;
            return NEXT_REQUEST;
        }
        if (state->drop_performed && !state->drop_announced) {
            state->drop_announced = true;
            return NEXT_DROPPED;
        }
        if (state->finished) {
            return NEXT_FINISHED;
        }
        const uint64_t now = monotonic_milliseconds();
        if (now >= deadline) {
            return NEXT_TIMEOUT;
        }
        uint64_t remaining = deadline - now;
        if (remaining > (uint64_t)INT_MAX) {
            remaining = (uint64_t)INT_MAX;
        }
        if (dispatch_ready_events(state, (int)remaining) < 0) {
            state->terminal_error = true;
            return NEXT_CANCELLED;
        }
    }
}

static void close_pending(struct drop_state *state) {
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        if (state->pending[index].descriptor >= 0) {
            (void)close(state->pending[index].descriptor);
            state->pending[index].descriptor = -1;
            state->pending[index].announced = false;
        }
    }
}

static void cleanup(struct drop_state *state) {
    state->request_gate_open = false;
    close_pending(state);
    if (state->source != NULL) {
        wl_data_source_destroy(state->source);
        state->source = NULL;
    }
    if (state->device != NULL) {
        wl_data_device_release(state->device);
        state->device = NULL;
    }
    if (state->pointer != NULL) {
        wl_pointer_destroy(state->pointer);
        state->pointer = NULL;
    }
    if (state->layer_surface != NULL) {
        zwlr_layer_surface_v1_destroy(state->layer_surface);
        state->layer_surface = NULL;
    }
    if (state->buffer != NULL) {
        wl_buffer_destroy(state->buffer);
        state->buffer = NULL;
    }
    if (state->surface != NULL) {
        wl_surface_destroy(state->surface);
        state->surface = NULL;
    }
    if (state->layer_shell != NULL) {
        /*
         * DropSeal intentionally binds the version-1 layer-shell contract.
         * zwlr_layer_shell_v1 gained a wire destructor only in version 3, so
         * a version-1 client must release its proxy locally rather than send
         * an opcode the bound object does not support.
         */
        wl_proxy_destroy((struct wl_proxy *)state->layer_shell);
        state->layer_shell = NULL;
    }
    if (state->manager != NULL) {
        wl_data_device_manager_destroy(state->manager);
        state->manager = NULL;
    }
    if (state->seat != NULL) {
        wl_seat_destroy(state->seat);
        state->seat = NULL;
    }
    if (state->shm != NULL) {
        wl_shm_destroy(state->shm);
        state->shm = NULL;
    }
    if (state->compositor != NULL) {
        wl_compositor_destroy(state->compositor);
        state->compositor = NULL;
    }
    if (state->registry != NULL) {
        wl_registry_destroy(state->registry);
        state->registry = NULL;
    }
    if (state->display != NULL) {
        wl_display_disconnect(state->display);
        state->display = NULL;
    }
    if (state->payload_descriptor >= 0) {
        (void)close(state->payload_descriptor);
        state->payload_descriptor = -1;
    }
}

static void reply_error(uint64_t sequence, const char *reason,
        const struct drop_state *state) {
    fprintf(stdout,
        "ERR %" PRIu64 " %s STARTED %u TARGET %u ACTION %u REQUESTS %u "
        "TRANSFERS %u PENDING %zu DROPPED %u FINISHED %u CANCELLED %u\n",
        sequence, reason, state->started ? 1U : 0U,
        target_valid(state) ? 1U : 0U, state->selected_action,
        state->requests_seen, state->transfers_completed, pending_count(state),
        state->drop_performed ? 1U : 0U, state->finished ? 1U : 0U,
        state->cancelled ? 1U : 0U);
}

static int run_self_test(void) {
    puts("{\"schema\":\"sandcodex.drop-agent-self-test.v1\","
         "\"protocol\":\"sandcodex.drop-agent.v2\",\"ok\":true,"
         "\"profiles\":[\"text\",\"png\",\"files\"],"
         "\"maximum_text_payload_bytes\":1048576,"
         "\"maximum_png_payload_bytes\":16777216,"
         "\"maximum_uri_list_payload_bytes\":65536,"
         "\"maximum_uri_list_entries\":8,"
         "\"maximum_png_dimension\":8192,\"maximum_png_pixels\":16777216,"
         "\"maximum_requests\":16,\"origin_pixels\":64,"
         "\"origin_surface\":\"transparent-8x8-layer-shell-overlay\","
         "\"drag_serial\":\"wl_pointer-button-implicit-grab-on-exact-origin-surface\","
         "\"action_policy\":\"copy-only\","
         "\"payload_storage\":\"read-only-noexec-sealed-anonymous-memfd\","
         "\"payload_descriptor_authority\":\"one-independent-O_RDONLY-open-file-description\","
         "\"payload_execution_policy\":\"MFD_NOEXEC_SEAL+F_SEAL_EXEC-required\","
         "\"release_policy\":\"controller-authorize-each-wl_data_source-send\","
         "\"request_epoch_policy\":\"preaccept-send-closed-empty+accepted-send-bound-to-controller-observed-target-generation+authorize-after-compositor-roundtrip\","
         "\"registry_cardinality\":\"exactly-one-compositor+shm+seat+data-device-manager+layer-shell\","
         "\"process_custody\":\"parent-death-signal+non-dumpable+no-new-privileges+exact-inherited-descriptor-inventory+three-distinct-directional-pipes+64-descriptor-ceiling+256-byte-noexec-origin-memfd-only-regular-file-output-ceiling\"}");
    return 0;
}

int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc != 7) {
        fputs("usage: wayland-drop-agent PROFILE PAYLOAD_FD PAYLOAD_SIZE CORNER WIDTH HEIGHT\n",
            stderr);
        return 64;
    }
    struct drop_state state = {
        .payload_descriptor = -1,
    };
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        state.pending[index].descriptor = -1;
    }
    uint64_t descriptor_value = 0U;
    uint64_t size_value = 0U;
    uint64_t width_value = 0U;
    uint64_t height_value = 0U;
    if (!parse_profile(argv[1], &state.profile) ||
            !parse_u64(argv[2], 3U, INT_MAX, &descriptor_value) ||
            !parse_u64(argv[3], 0U, MAX_PNG_PAYLOAD_BYTES, &size_value) ||
            !parse_corner(argv[4], &state.corner) ||
            !parse_u64(argv[5], ORIGIN_SIZE * 2U + 1U, 8192U, &width_value) ||
            !parse_u64(argv[6], ORIGIN_SIZE * 2U + 1U, 8192U, &height_value) ||
            (state.profile == PROFILE_PNG && size_value < 57U) ||
            (state.profile == PROFILE_TEXT && size_value > MAX_TEXT_PAYLOAD_BYTES) ||
            (state.profile == PROFILE_FILES &&
                (size_value == 0U || size_value > MAX_URI_LIST_PAYLOAD_BYTES))) {
        fputs("sandcodex-wayland-drop-agent: invalid profile, payload, corner, or output size\n",
            stderr);
        return 64;
    }
    state.payload_descriptor = (int)descriptor_value;
    state.payload_size = (size_t)size_value;
    state.output_width = (uint32_t)width_value;
    state.output_height = (uint32_t)height_value;
    state.origin_x = (state.corner == ORIGIN_TOP_LEFT ||
        state.corner == ORIGIN_BOTTOM_LEFT) ? ORIGIN_SIZE / 2U :
        state.output_width - ORIGIN_SIZE / 2U;
    state.origin_y = (state.corner == ORIGIN_TOP_LEFT ||
        state.corner == ORIGIN_TOP_RIGHT) ? ORIGIN_SIZE / 2U :
        state.output_height - ORIGIN_SIZE / 2U;

    struct sigaction action = {0};
    action.sa_handler = on_signal;
    (void)sigemptyset(&action.sa_mask);
    if (sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0 ||
            sigaction(SIGHUP, &action, NULL) < 0) {
        perror("sandcodex-wayland-drop-agent: sigaction");
        return 70;
    }
    action.sa_handler = SIG_IGN;
    if (sigaction(SIGPIPE, &action, NULL) < 0) {
        perror("sandcodex-wayland-drop-agent: sigaction SIGPIPE");
        return 70;
    }
    if (harden_process(state.payload_descriptor, state.payload_size,
            state.profile, &state.payload_ascii,
            &state.payload_exec_sealed) < 0) {
        perror("sandcodex-wayland-drop-agent: process hardening");
        return 70;
    }
    if (setvbuf(stdout, NULL, _IOLBF, 0U) != 0 ||
            setvbuf(stderr, NULL, _IONBF, 0U) != 0) {
        fputs("sandcodex-wayland-drop-agent: stream buffering failed\n", stderr);
        return 70;
    }
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-drop-agent: Wayland initialization");
        cleanup(&state);
        return 71;
    }
    printf("READY %s MANAGER %u SEATS 1 COMPOSITOR 1 SHM 1 LAYER 1 PROFILE %s "
           "PAYLOAD %zu EXECSEALED %u CORNER %s ORIGIN %u %u SIZE %u\n",
        AGENT_PROTOCOL, state.manager_version, profile_name(state.profile),
        state.payload_size, state.payload_exec_sealed ? 1U : 0U,
        corner_name(state.corner), state.origin_x, state.origin_y, ORIGIN_SIZE);

    uint64_t expected_sequence = 1U;
    int exit_code = 0;
    char line[MAX_LINE_BYTES + 2U];
    while (!stop_requested && fgets(line, sizeof(line), stdin) != NULL) {
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n' ||
                (length == MAX_LINE_BYTES + 1U && line[length - 1U] != '\n')) {
            reply_error(expected_sequence, "malformed-command", &state);
            exit_code = 72;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            reply_error(expected_sequence, "invalid-command", &state);
            exit_code = 72;
            break;
        }
        const uint64_t sequence = expected_sequence++;
        if ((state.terminal_error || !state.topology_valid || state.surface_closed) &&
                command.kind != COMMAND_QUIT) {
            reply_error(sequence, "terminal-state", &state);
            exit_code = 73;
            break;
        }
        if (command.kind == COMMAND_ORIGIN) {
            const int result = wait_until(&state, command.timeout_milliseconds,
                predicate_origin);
            if (result < 0) {
                reply_error(sequence, "origin-failed", &state);
                exit_code = 73;
                break;
            }
            printf("%s %" PRIu64 " POINTER %u ENTERED %u ORIGIN %u %u\n",
                result == 1 ? "ORIGIN" : "TIMEOUT", sequence,
                state.pointer_available ? 1U : 0U,
                state.pointer_entered ? 1U : 0U,
                state.origin_x, state.origin_y);
        } else if (command.kind == COMMAND_ARM) {
            if (!state.pointer_available || !state.pointer_entered ||
                    state.started || state.finished || state.cancelled) {
                reply_error(sequence, "arm-denied", &state);
                exit_code = 73;
                break;
            }
            state.armed = true;
            printf("ARMED %" PRIu64 " ORIGIN %u %u\n", sequence,
                state.origin_x, state.origin_y);
        } else if (command.kind == COMMAND_STARTED) {
            const int result = wait_until(&state, command.timeout_milliseconds,
                predicate_started);
            if (result < 0) {
                reply_error(sequence, "start-failed", &state);
                exit_code = 73;
                break;
            }
            printf("%s %" PRIu64 " STARTED %u SERIAL %u\n",
                result == 1 ? "STARTED" : "TIMEOUT", sequence,
                state.started ? 1U : 0U, state.drag_serial);
        } else if (command.kind == COMMAND_TARGET) {
            const int result = wait_until(&state, command.timeout_milliseconds,
                predicate_target);
            if (result < 0) {
                reply_error(sequence, "target-failed", &state);
                exit_code = 73;
                break;
            }
            if (result == 1) {
                /* The synchronous TARGET receipt consumes this generation. */
                state.target_announced_generation = state.target_generation;
            }
            printf("%s %" PRIu64 " MIME %s ACTION %u GENERATION %u\n",
                result == 1 ? "TARGET" : "TIMEOUT", sequence,
                state.target_mime[0] != '\0' ? state.target_mime : "none",
                state.selected_action, state.target_generation);
        } else if (command.kind == COMMAND_NEXT) {
            struct pending_request *request = NULL;
            const enum next_kind kind = next_event(&state,
                command.timeout_milliseconds, &request);
            if (state.terminal_error && kind == NEXT_CANCELLED) {
                reply_error(sequence, "event-failed", &state);
                exit_code = 73;
                break;
            }
            if (kind == NEXT_REQUEST && request != NULL) {
                printf("REQUEST %" PRIu64 " ID %u MIME %s GENERATION %u PENDING %zu "
                       "TARGET %u ACTION %u\n",
                    sequence, request->id, request->mime,
                    request->target_generation, pending_count(&state),
                    target_valid(&state) ? 1U : 0U, state.selected_action);
            } else if (kind == NEXT_TARGET) {
                printf("TARGET %" PRIu64 " MIME %s ACTION %u GENERATION %u\n", sequence,
                    state.target_mime[0] != '\0' ? state.target_mime : "none",
                    state.selected_action, state.target_generation);
            } else if (kind == NEXT_DROPPED) {
                printf("DROPPED %" PRIu64 " REQUESTS %u TRANSFERS %u PENDING %zu\n",
                    sequence, state.requests_seen, state.transfers_completed,
                    pending_count(&state));
            } else if (kind == NEXT_FINISHED) {
                printf("FINISHED %" PRIu64 " REQUESTS %u TRANSFERS %u BYTES %" PRIu64
                       " PENDING %zu\n",
                    sequence, state.requests_seen, state.transfers_completed,
                    state.bytes_transferred, pending_count(&state));
            } else if (kind == NEXT_CANCELLED) {
                printf("CANCELLED %" PRIu64 " REQUESTS %u TRANSFERS %u PENDING %zu\n",
                    sequence, state.requests_seen, state.transfers_completed,
                    pending_count(&state));
            } else {
                printf("TIMEOUT %" PRIu64 " REQUESTS %u TRANSFERS %u PENDING %zu "
                       "DROPPED %u FINISHED %u CANCELLED %u\n",
                    sequence, state.requests_seen, state.transfers_completed,
                    pending_count(&state), state.drop_performed ? 1U : 0U,
                    state.finished ? 1U : 0U, state.cancelled ? 1U : 0U);
            }
        } else if (command.kind == COMMAND_AUTHORIZE) {
            if (authorize_request(&state, command.request_id,
                    command.target_generation) < 0) {
                reply_error(sequence, "authorization-failed", &state);
                exit_code = 74;
                break;
            }
            printf("AUTHORIZED %" PRIu64 " ID %u GENERATION %u BYTES %zu "
                   "TRANSFERS %u PENDING %zu\n",
                sequence, command.request_id, command.target_generation,
                state.payload_size,
                state.transfers_completed, pending_count(&state));
        } else if (command.kind == COMMAND_PING) {
            if (display_roundtrip(&state) < 0) {
                reply_error(sequence, "ping-failed", &state);
                exit_code = 73;
                break;
            }
            printf("PONG %" PRIu64 " POINTER %u ENTERED %u STARTED %u TARGET %u "
                   "ACTION %u REQUESTS %u TRANSFERS %u PENDING %zu DROPPED %u "
                   "FINISHED %u CANCELLED %u\n",
                sequence, state.pointer_available ? 1U : 0U,
                state.pointer_entered ? 1U : 0U, state.started ? 1U : 0U,
                target_valid(&state) ? 1U : 0U, state.selected_action,
                state.requests_seen, state.transfers_completed,
                pending_count(&state), state.drop_performed ? 1U : 0U,
                state.finished ? 1U : 0U, state.cancelled ? 1U : 0U);
        } else {
            printf("BYE %" PRIu64 " STARTED %u REQUESTS %u TRANSFERS %u BYTES %" PRIu64
                   " PENDING %zu FINISHED %u CANCELLED %u\n",
                sequence, state.started ? 1U : 0U, state.requests_seen,
                state.transfers_completed, state.bytes_transferred,
                pending_count(&state), state.finished ? 1U : 0U,
                state.cancelled ? 1U : 0U);
            break;
        }
    }
    if (ferror(stdin) != 0 && exit_code == 0) {
        exit_code = 75;
    }
    cleanup(&state);
    return exit_code;
}
WAYLAND_DROP_AGENT_C
}

sc_emit_wayland_keyboard_agent_source() {
  cat <<'WAYLAND_KEYBOARD_AGENT_C'
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L

/*
 * Birth-pinned private Wayland virtual-keyboard transport for Sandcodex.
 *
 * The keymap construction follows the public MIT-licensed wtype technique,
 * but this helper does not delegate to wtype or place text in process argv.
 * One pipe-controlled process owns one zwp_virtual_keyboard_v1 object for the
 * complete guarded operation. PLAN commands resolve one prepared key and
 * serialized modifier mask without emitting input, so patched Sway can own a
 * focus-bound complete unit. PLANM serializes a reviewed nonzero modifier
 * mask through that exact sealed keymap and performs one display roundtrip
 * without emitting input; patched Sway owns the later exact-recipient hold and
 * target-independent clear. Legacy complete key units retain bounded release
 * recovery, and ambiguous cleanup causes controller quarantine.
 */

#include <ctype.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <sys/prctl.h>
#include <sys/resource.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

#include <wayland-client.h>
#include <xkbcommon/xkbcommon.h>
#include <xkbcommon/xkbcommon-keysyms.h>
#include "virtual-keyboard-unstable-v1-client-protocol.h"

#define AGENT_PROTOCOL "sandcodex.keyboard-agent.v6"
#ifndef SANDCODEX_LIBXKBCOMMON_VERSION
#define SANDCODEX_LIBXKBCOMMON_VERSION "unattested-build"
#endif
#define MAX_LINE_BYTES 256U
#define MAX_TOKENS 5U
#define MAX_KEY_NAME_BYTES 63U
#define MAX_KEYMAP_ENTRIES 240U
#define MAX_KEYMAP_BYTES 65536U
#define MAX_KEYMAP_GENERATIONS 2U
#define KEY_SETTLE_NANOSECONDS 2000000L

#define MOD_SHIFT UINT32_C(1)
#define MOD_CTRL UINT32_C(4)
#define MOD_ALT UINT32_C(8)
#define MOD_LOGO UINT32_C(64)
#define MOD_ALTGR UINT32_C(128)
#define ALLOWED_MODIFIERS (MOD_SHIFT | MOD_CTRL | MOD_ALT | MOD_LOGO | MOD_ALTGR)

enum command_kind {
