        if type(steps) is not int or not 1 <= steps <= min(RELATIVE_MOTION_MAX_STEPS, major):
            raise ToolError("relative-motion steps cannot create a zero native event")
        if type(duration_milliseconds) is not int or not steps <= duration_milliseconds <= RELATIVE_MOTION_MAX_DURATION_MILLISECONDS:
            raise ToolError("relative-motion duration cannot preserve increasing timestamps")
        if not callable(validator):
            raise ToolError("compositor relative-motion target validator is unavailable")

