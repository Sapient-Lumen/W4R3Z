sc_remote_router_state() {
  local action=$1 path rc=0
  shift
  if [[ "$action" != read ]]; then
    sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  fi
  path="$(sc_remote_cooldowns_path)"
  if [[ -e "$path" || -L "$path" ]]; then
    sc_no_symlink_components "$path" "OpenRouter router state"
    sc_owned_single_file "$path" 600 "OpenRouter router state"
  fi
  python3 -P - "$path" "$action" "$@" <<'PY' || rc=$?
import fcntl
import hashlib
import json
import os
import re
import stat
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

SCHEMA = "sandcodex.openrouter-cooldowns.v1"
SCHEDULER_LIMIT = 32
path = Path(sys.argv[1])
action = sys.argv[2]
now = datetime.now(timezone.utc)

def parse_time(value):
    if not isinstance(value, str):
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        parsed = datetime.fromisoformat(value)
        if parsed.tzinfo is None:
            return None
        return parsed.astimezone(timezone.utc)
    except (TypeError, ValueError, OverflowError):
        return None

def utc(value):
    return value.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)

def read_value():
    if not path.exists():
        return {"schema": SCHEMA, "keys": {}, "models": {}, "pairs": {}, "schedulers": {}}
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        metadata = os.fstat(fd)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077
                or metadata.st_size > 16 * 1024 * 1024):
            raise SystemExit("unsafe OpenRouter router state")
        raw = b""
        while len(raw) <= 16 * 1024 * 1024:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            raw += chunk
        if len(raw) > 16 * 1024 * 1024:
            raise SystemExit("OpenRouter router state exceeds its size limit")
    finally:
        os.close(fd)
    try:
        value = json.loads(raw)
    except (UnicodeError, ValueError) as exc:
        raise SystemExit(f"invalid OpenRouter router state: {exc}") from exc
    if not isinstance(value, dict) or value.get("schema") != SCHEMA:
        raise SystemExit("invalid OpenRouter router state schema")
    for field in ("keys", "models"):
        if not isinstance(value.get(field), dict):
            raise SystemExit(f"invalid OpenRouter router state field: {field}")
    for field in ("pairs", "schedulers"):
        if field in value and not isinstance(value[field], dict):
            raise SystemExit(f"invalid OpenRouter router state field: {field}")
    return value

def normalize(value):
    result = {"schema": SCHEMA}
    for field in ("keys", "models", "pairs"):
        rows = value.get(field)
        if not isinstance(rows, dict):
            rows = {}
        kept = {}
        for ident, row in rows.items():
            if not isinstance(ident, str) or not isinstance(row, dict):
                continue
            until = parse_time(row.get("until"))
            if until is not None and until > now:
                kept[ident] = {
                    "until": utc(until),
                    "reason": str(row.get("reason") or "cooldown")[:240],
                    "recorded_at": str(row.get("recorded_at") or "")[:32] or None,
                }
        result[field] = kept
    schedulers = []
    raw_schedulers = value.get("schedulers")
    if isinstance(raw_schedulers, dict):
        for identity, row in raw_schedulers.items():
            if (not isinstance(identity, str)
                    or re.fullmatch(r"[0-9a-f]{16}", identity) is None
                    or not isinstance(row, dict)):
                continue
            key_ids = row.get("key_ids")
            counts = row.get("assignments_by_key")
            assignments = row.get("assignments")
            updated = parse_time(row.get("updated_at"))
            if (not isinstance(key_ids, list) or not key_ids or len(key_ids) > 64
                    or len(set(key_ids)) != len(key_ids)
                    or any(not isinstance(key_id, str)
                           or re.fullmatch(r"[0-9a-f]{12}", key_id) is None
                           for key_id in key_ids)
                    or not isinstance(counts, dict) or type(assignments) is not int
                    or not 0 <= assignments <= 2**63 - 1 or updated is None):
                continue
            clean_counts = {}
            for key_id in key_ids:
                count = counts.get(key_id, 0)
                if type(count) is not int or not 0 <= count <= 2**63 - 1:
                    break
                clean_counts[key_id] = count
            else:
                schedulers.append((updated, identity, {
                    "key_ids": key_ids,
                    "assignments_by_key": clean_counts,
                    "assignments": assignments,
                    "updated_at": utc(updated),
                    "policy": "least-scheduled-healthy-key-v1",
                }))
    schedulers.sort(key=lambda item: item[0])
    result["schedulers"] = {
        identity: row for _updated, identity, row in schedulers[-SCHEDULER_LIMIT:]
    }
    updated = parse_time(value.get("updated_at"))
    if updated is not None:
        result["updated_at"] = utc(updated)
    result["credential_values_disclosed"] = False
    result["raw_provider_content_disclosed"] = False
    return result

def write_value(value):
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(canonical(value) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass

if action == "read":
    value = normalize(read_value())
    value["observed_at"] = utc(now)
    print(canonical(value))
    raise SystemExit(0)

lock_path = path.with_name(path.name + ".lock")
lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
try:
    metadata = os.fstat(lock_fd)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077):
        raise SystemExit("unsafe OpenRouter router-state lock")
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    loaded = read_value()
    value = normalize(loaded)
    changed = canonical(value) != canonical(loaded)
    output = None
    if action == "record":
        kind, ident, seconds, reason = sys.argv[3], sys.argv[4], int(sys.argv[5]), sys.argv[6]
        if kind not in {"keys", "models", "pairs"} or not ident or not 1 <= seconds <= 86_400 * 30:
            raise SystemExit("invalid OpenRouter cooldown record")
        value[kind][ident] = {
            "until": utc(now + timedelta(seconds=seconds)),
            "reason": reason[:240] or "provider cooldown",
            "recorded_at": utc(now),
        }
        value["updated_at"] = utc(now)
        changed = True
        output = value
    elif action == "schedule":
        rows = []
        seen = set()
        for index, line in enumerate(sys.argv[3].splitlines()):
            fields = line.split("\t")
            if len(fields) != 4 or re.fullmatch(r"[0-9a-f]{12}", fields[0]) is None:
                raise SystemExit("invalid OpenRouter scheduler row")
            if fields[0] in seen:
                continue
            seen.add(fields[0])
            try:
                remaining = int(fields[3])
            except ValueError as exc:
                raise SystemExit("invalid OpenRouter scheduler quota") from exc
            rows.append((fields, line, index, remaining))
        if not rows or len(rows) > 64:
            raise SystemExit("OpenRouter scheduler has no bounded key rows")
        key_ids = [fields[0] for fields, _line, _index, _remaining in rows]
        identity = hashlib.sha256("\0".join(sorted(key_ids)).encode()).hexdigest()[:16]
        scheduler = value["schedulers"].get(identity, {})
        stored = scheduler.get("assignments_by_key", {})
        counts = {
            key_id: int(stored.get(key_id, 0))
            if type(stored.get(key_id, 0)) is int and stored.get(key_id, 0) >= 0 else 0
            for key_id in key_ids
        }
        ordered = sorted(rows, key=lambda row: (counts[row[0][0]], row[2]))
        selected = ordered[0][0][0]
        counts[selected] += 1
        assignments = scheduler.get("assignments", 0)
        assignments = assignments if type(assignments) is int and assignments >= 0 else 0
        value["schedulers"][identity] = {
            "key_ids": key_ids,
            "assignments_by_key": counts,
            "assignments": assignments + 1,
            "updated_at": utc(now),
            "policy": "least-scheduled-healthy-key-v1",
        }
        value["updated_at"] = utc(now)
        changed = True
        output = "\n".join(row[1] for row in ordered)
    elif action == "success":
        key_id, model, observed_text = sys.argv[3], sys.argv[4], sys.argv[5]
        observed_at = parse_time(observed_text)
        if (re.fullmatch(r"[0-9a-f]{12}", key_id) is None or not model
                or observed_at is None):
            raise SystemExit("invalid OpenRouter successful route")
        healed = 0
        retained_newer = 0
        retained_ambiguous = 0
        # Only heal cooldown evidence recorded before this successful attempt
        # began. Another launcher may record a failure while the network probe
        # is running or before this process takes the state lock; that evidence
        # must survive the older attempt.
        for field, identity in (("keys", key_id), ("models", model),
                                ("pairs", f"{key_id}:{model}")):
            row = value[field].get(identity)
            if row is None:
                continue
            recorded_at = parse_time(row.get("recorded_at"))
            if recorded_at is None:
                retained_ambiguous += 1
            elif recorded_at < observed_at:
                value[field].pop(identity, None)
                healed += 1
            else:
                retained_newer += 1
        if healed:
            value["updated_at"] = utc(now)
            changed = True
        output = {
            "healed": healed,
            "retained_newer": retained_newer,
            "retained_ambiguous": retained_ambiguous,
            "successful_attempt_started_at": utc(observed_at),
        }
    else:
        raise SystemExit("invalid OpenRouter router-state operation")
    if changed:
        write_value(value)
    if isinstance(output, str):
        print(output)
    else:
        print(canonical(output))
finally:
    fcntl.flock(lock_fd, fcntl.LOCK_UN)
    os.close(lock_fd)
PY
  (( rc == 0 )) || return "$rc"
}

sc_remote_cooldowns_json() {
  local data rc=0
  data="$(sc_remote_router_state read)" || rc=$?
  (( rc == 0 )) || sc_die "OpenRouter router state could not be read" 69
  printf '%s\n' "$data"
}

sc_remote_cooldown_record() {
  local kind=$1 ident=$2 reason=$3 seconds=$4 rc=0
  [[ "$kind" == keys || "$kind" == models || "$kind" == pairs ]] || return 0
  [[ -n "$ident" && "$seconds" =~ ^[1-9][0-9]{0,8}$ ]] || return 0
  sc_remote_router_state record "$kind" "$ident" "$seconds" "$reason" >/dev/null || rc=$?
  (( rc == 0 )) || sc_warn "could not record OpenRouter cooldown for $kind/$ident"
}

sc_remote_schedule_key_rows() {
  local row_text=$1 scheduled rc=0
  [[ -n "$row_text" ]] || return 0
  scheduled="$(sc_remote_router_state schedule "$row_text")" || rc=$?
  (( rc == 0 )) || sc_die "OpenRouter key scheduler state could not be updated" 69
  printf '%s\n' "$scheduled"
}

sc_remote_cooldown_clear_route() {
  local key_id=$1 model=$2 successful_attempt_started_at=$3 rc=0
  [[ -n "$successful_attempt_started_at" ]] || {
    sc_warn "could not heal OpenRouter cooldowns without a successful-attempt start time"
    return 0
  }
  sc_remote_router_state success "$key_id" "$model" "$successful_attempt_started_at" >/dev/null || rc=$?
  (( rc == 0 )) || sc_warn "could not heal OpenRouter cooldowns for the successful route"
}

sc_remote_filter_key_rows_cooldown() {
  local row_text=$1 cooldowns
  [[ -n "$row_text" ]] || return 0
  cooldowns="$(sc_remote_cooldowns_json)"
  python3 -P - "$cooldowns" "$row_text" <<'PY'
import json, sys
cooldowns = json.loads(sys.argv[1])
rows = sys.argv[2]
blocked = set(cooldowns.get("keys", {}))
for line in rows.splitlines():
    line = line.rstrip("\n")
    if not line:
        continue
    key_id = line.split("\t", 1)[0]
    if key_id not in blocked:
        print(line)
PY
}

sc_remote_apply_cooldowns_to_bank() {
  local bank=$1 cooldowns ranked rc=0
  cooldowns="$(sc_remote_cooldowns_json)"
  ranked="$(jq -c --argjson cooldowns "$cooldowns" '
    .models |= (map(select(.id as $id | ($cooldowns.models[$id] // null) == null)))
    | .model_count = (.models | length)
    | .cooldowns = {
        path:"openrouter-router-cooldowns.json",
        active_key_count:($cooldowns.keys | length),
        active_model_count:($cooldowns.models | length),
        active_pair_count:($cooldowns.pairs | length),
        keys:$cooldowns.keys,
        models:$cooldowns.models,
        pairs:$cooldowns.pairs,
        schedulers:$cooldowns.schedulers
      }
    | .models |= (to_entries | map(.value + {rank:(.key + 1)}))
  ' <<<"$bank")" || rc=$?
  if (( rc != 0 )); then
    sc_warn "OpenRouter cooldown filtering could not be applied; falling back to unfiltered model bank"
    printf '%s\n' "$bank"
    return
  fi
  printf '%s\n' "$ranked"
}

sc_remote_models_render() {
  local bank=$1 saved=${2:-}
  if (( SC_REMOTE_MODELS_JSON )); then
    printf '%s\n' "$bank"
    return
  fi
  printf 'OpenRouter model bank\n'
  printf '  candidates  %s\n' "$(jq -r '.model_count' <<<"$bank")"
  printf '  source      %s\n' "$(jq -r '.source_url' <<<"$bank")"
  printf '  filters     %s\n' "$(jq -r '
    [if .filters.free then "free" else empty end,
     if .filters.text_output then "text output" else empty end,
     if .filters.tools then "tools" else empty end,
     if .filters.agent then "agent-ready" else empty end] |
    if length == 0 then "none" else join(" · ") end' <<<"$bank")"
  printf '  limit       %s\n' "$(jq -r '.filters.limit // "none"' <<<"$bank")"
  [[ -z "$saved" ]] || printf '  saved: %s\n' "$saved"
  printf '  qualified   %s\n' "$(jq -r 'if .qualification_run then "live probes ran" else "metadata only" end' <<<"$bank")"
  printf '\nranked models\n'
  jq -r '.models[] |
    "  \(.rank). \(.id)\n" +
    "     score \((.strength_score // 0)|floor) · context \(.context_tokens // "unknown") · output \(.max_completion_tokens // "unknown")\n" +
    "     features " +
      ([if .agent_candidate then "agent" elif .tools then "tools" else empty end,
        if .structured_outputs then "schema" else empty end,
        if .reasoning_parameter then "reasoning" else empty end] |
       if length == 0 then "none reported" else join(", ") end) +
    " · qualification " + (.qualification.result // "not run")' <<<"$bank"
  printf '\nnext\n'
  printf '  launch       sandcodex remote MODEL --provider openrouter\n'
  printf '  qualify      sandcodex remote models --agent --qualify --force --limit N\n'
}

sc_remote_models_qualify() {
  local bank=$1 credential token_file snapshot_file descriptor cache_root result_file result rc
  local total index model detail status receipt_json qualified failed summary_path summary_json request_count
  local use_keybank=0 staged="" quota="" key_rows="" key_id key_file key_label _key_remaining selected_key_id selected_key_label force_json=false
  local -a force_args=()
  if (( SC_REMOTE_MODELS_QUALIFY_FORCE )); then
    force_args=(--force)
    force_json=true
  fi
  jq -e '[.models[] | select(.free != true)] | length == 0' <<<"$bank" >/dev/null ||
    sc_die "refusing to qualify non-free OpenRouter model candidates from this command" 64
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  sc_ensure_dir "$SC_GLOBAL/remote/qualifications" "remote qualification cache"
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  snapshot_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bank-snapshot.XXXXXX")"
  result_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bank-results.XXXXXX")"
  jq -n '{name:"openrouter",base_url:"https://openrouter.ai/api/v1",env_key:"OPENROUTER_API_KEY",wire_api:"responses"}' |
    sc_atomic "$snapshot_file" 600
  descriptor="$(python3 -P - "$snapshot_file" <<'PY'
import hashlib, json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)
print(hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest())
PY
)"
  cache_root="$SC_GLOBAL/remote/qualifications"
  if [[ -n "$SC_REMOTE_KEYBANK_PATH" || ( -z "${OPENROUTER_API_KEY:-}" && -f "$(sc_remote_keybank_default_path)" ) ]]; then
    use_keybank=1
    staged="$(sc_remote_keybank_stage)"
    quota="$(sc_remote_keybank_quota_json "$staged")"
    key_rows="$(sc_remote_keybank_usable_rows "$staged" "$quota" 2)"
    if [[ -z "$key_rows" ]]; then
      sc_remote_keybank_unstage "$staged"
      sc_die "OpenRouter key bank has no usable keys with reported quota" 69
    fi
  else
    credential="${OPENROUTER_API_KEY:-}"
    [[ -n "$credential" && ${#credential} -le 16384 ]] ||
      sc_die "OPENROUTER_API_KEY is required for live OpenRouter model-bank qualification (or use --key-bank)" 78
    [[ "$credential" != *$'\n'* && "$credential" != *$'\r'* ]] ||
      sc_die "OPENROUTER_API_KEY contains a line break" 78
    token_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-bank-token.XXXXXX")"
    printf '%s' "$credential" | sc_atomic "$token_file" 600
    key_rows=$'env\t'"$token_file"$'\tOPENROUTER_API_KEY\t999999'
  fi
  total="$(jq -r '.model_count' <<<"$bank")"
  index=0; qualified=0; failed=0
  while IFS= read -r model; do
    index=$((index + 1))
    if (( ! SC_REMOTE_MODELS_JSON )); then
      printf 'qualify openrouter free model %s/%s · %s ... ' "$index" "$total" "$model" >&2
    fi
    detail=""; status=failed; receipt_json=null; selected_key_id=""; selected_key_label=""
    while IFS=$'\t' read -r key_id key_file key_label _key_remaining; do
      [[ -n "$key_id" ]] || continue
      rc=0
      result="$(
        sc_emit_remote_qualifier | python3 -P - qualify \
          --snapshot "$snapshot_file" --credential-file "$key_file" \
          --model "$model" --descriptor-sha256 "$descriptor" --root "$cache_root" \
          --timeout "$SC_REMOTE_QUALIFICATION_TIMEOUT" \
          --timestamp "$(sc_now)" "${force_args[@]}" 2>"$SC_GLOBAL/runtime/.openrouter-bank-error.$$"
      )" || rc=$?
      if (( rc == 0 )) && sc_remote_qualification_result_valid "$descriptor" "$model" <<<"$result"; then
        status=qualified
        qualified=$((qualified + 1))
        receipt_json=$result
        request_count="$(jq -r '.network_requests' <<<"$result")"
        if (( request_count > 0 )); then
          selected_key_id=$key_id
          selected_key_label=$key_label
          [[ "$SC_REMOTE_MODELS_JSON" == 1 ]] || printf 'ok · key %s\n' "$key_id" >&2
        else
          selected_key_id=""
          selected_key_label=""
          [[ "$SC_REMOTE_MODELS_JSON" == 1 ]] || printf 'ok · cached receipt · no key request\n' >&2
        fi
        break
      fi
      detail="$(sed -n '1{s/[^[:print:]\t]/?/g;p;}' "$SC_GLOBAL/runtime/.openrouter-bank-error.$$" 2>/dev/null | cut -c1-1000)"
      selected_key_id=$key_id
      selected_key_label=$key_label
      if [[ "$detail" != *"HTTP 429"* && "$detail" != *"HTTP 402"* && "$detail" != *"unavailable for qualification"* ]]; then
        break
      fi
    done <<<"$key_rows"
    if [[ "$status" != qualified ]]; then
      failed=$((failed + 1))
      [[ "$SC_REMOTE_MODELS_JSON" == 1 ]] || printf 'failed%s\n' "$([[ -n "$detail" ]] && printf ': %s' "$detail")" >&2
    fi
    jq -cn --arg model "$model" --arg result "$status" --arg detail "$detail" \
      --arg key_id "$selected_key_id" --arg key_label "$selected_key_label" \
      --argjson qualification "$receipt_json" \
      '{model:$model,result:$result,key_id:(if $key_id=="" then null else $key_id end),
        key_label:(if $key_label=="" then null else $key_label end),
        detail:(if $detail=="" then null else $detail end),qualification:$qualification}' >>"$result_file"
    rm -f -- "$SC_GLOBAL/runtime/.openrouter-bank-error.$$"
    if (( index < total )) && [[ "$SC_REMOTE_MODELS_SLEEP" != 0 ]]; then
      sleep "$SC_REMOTE_MODELS_SLEEP"
    fi
  done < <(jq -r '.models[].id' <<<"$bank")
  summary_path="$SC_GLOBAL/remote/openrouter-model-bank-qualification-$(date -u +%Y%m%dT%H%M%SZ).json"
  summary_json="$(jq -n -c --arg schema "sandcodex.openrouter-model-bank-qualification.v1" \
    --arg created_at "$(sc_now)" --arg source "$SC_REMOTE_MODELS_SOURCE" \
    --arg descriptor "$descriptor" --argjson bank "$bank" --argjson key_bank_consulted "$use_keybank" \
    --argjson force "$force_json" \
    --slurpfile results "$result_file" '
      {schema:$schema,result:"qualified_bank",created_at:$created_at,provider:"openrouter",
       source_url:$source,descriptor_sha256:$descriptor,
       candidate_count:($bank.model_count),qualified_count:([ $results[] | select(.result=="qualified") ]|length),
       failed_count:([ $results[] | select(.result!="qualified") ]|length),
       credential_value_disclosed:false,raw_provider_content_disclosed:false,
       key_bank_consulted:$key_bank_consulted,
       key_bank_live_requests:($results | any(.key_id != null)),
       key_bank_used:($results | any(.key_id != null)),
       force_live_qualification:$force,
       probes:"sequential existing Sandcodex remote Responses qualifier",
       bank:$bank, results:$results}' </dev/null)"
  printf '%s\n' "$summary_json" | sc_atomic "$summary_path" 600
  rm -f -- "${token_file:-}" "$snapshot_file" "$result_file"
  if (( use_keybank )); then
    sc_remote_keybank_unstage "$staged"
  fi
  bank="$(jq -c --arg path "$summary_path" --argjson summary "$summary_json" '
    .qualification_run = true |
    .qualification_summary = {
      path:$path,
      checked_at:$summary.created_at,
      force_live_qualification:$summary.force_live_qualification,
      qualified_count:$summary.qualified_count,
      failed_count:$summary.failed_count
    } |
    .models |= map(
      . as $model |
      (first($summary.results[]? | select(.model == $model.id)) // null) as $result |
      if $result == null then . else . + {
        qualification:{
          result:$result.result,
          checked_at:$summary.created_at,
          force_live:$summary.force_live_qualification,
          detail:($result.detail // null),
          key_id:($result.key_id // null),
          network_requests:($result.qualification.network_requests // null),
          receipt_sha256:($result.qualification.receipt_sha256 // null)
        }
      } end
    )
  ' <<<"$bank")"
  printf '%s\n' "$bank"
}

sc_remote_auto_select_launch() {
  [[ "$SC_RESUME" == fresh ]] ||
    sc_die "remote auto starts fresh rooms only; use a saved remote binding for resume" 64
  local staged quota key_rows bank snapshot_file descriptor cache_root result rc
  local model rank strength bench_points bench_possible bench_passed bench_total metadata_strength
  local key_id key_file key_label _key_remaining detail selected_json failure_json failure_path
  local selected_model="" selected_rank="" selected_strength="" selected_key_id="" selected_key_label=""
  local selected_bench_points="" selected_bench_possible="" selected_bench_passed="" selected_bench_total=""
  local selected_metadata_strength=""
  local selected_receipt="" selected_receipt_sha="" successful_attempt_started_at="" bootstrap="" results_file error_file total index=0

  [[ -z "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" && -z "$SC_REMOTE_BOOTSTRAP_ENV_KEY" ]] ||
    sc_die "remote auto cannot run with an existing remote credential bootstrap bridge" 78
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  sc_ensure_dir "$SC_GLOBAL/remote/qualifications" "remote qualification cache"
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  sc_ensure_dir "$SC_CONTROL" "project control state"

  staged="$(sc_remote_keybank_stage)"
  quota="$(sc_remote_keybank_quota_json "$staged")"
  key_rows="$(sc_remote_keybank_usable_rows "$staged" "$quota" 2)"
  key_rows="$(sc_remote_filter_key_rows_cooldown "$key_rows")"
  if [[ -z "$key_rows" ]]; then
    sc_remote_keybank_unstage "$staged"
    sc_die "OpenRouter key bank has no usable keys with reported quota outside the cooldown ledger for remote auto" 69
  fi
  key_rows="$(sc_remote_schedule_key_rows "$key_rows")"

  local old_free=$SC_REMOTE_MODELS_FREE old_text=$SC_REMOTE_MODELS_TEXT old_tools=$SC_REMOTE_MODELS_TOOLS old_agent=$SC_REMOTE_MODELS_AGENT old_limit=$SC_REMOTE_MODELS_LIMIT
  SC_REMOTE_MODELS_FREE=1
  SC_REMOTE_MODELS_TEXT=1
  SC_REMOTE_MODELS_TOOLS=1
  SC_REMOTE_MODELS_AGENT=1
  SC_REMOTE_MODELS_LIMIT=0
  bank="$(sc_remote_models_bank)" || {
    sc_remote_keybank_unstage "$staged"
    SC_REMOTE_MODELS_FREE=$old_free; SC_REMOTE_MODELS_TEXT=$old_text; SC_REMOTE_MODELS_TOOLS=$old_tools; SC_REMOTE_MODELS_AGENT=$old_agent; SC_REMOTE_MODELS_LIMIT=$old_limit
    return 69
  }
  bank="$(sc_remote_apply_bench_ranking "$bank")"
  bank="$(sc_remote_apply_profile_ranking "$bank")"
  bank="$(sc_remote_apply_cooldowns_to_bank "$bank")"
  SC_REMOTE_MODELS_FREE=$old_free
  SC_REMOTE_MODELS_TEXT=$old_text
  SC_REMOTE_MODELS_TOOLS=$old_tools
  SC_REMOTE_MODELS_AGENT=$old_agent
  SC_REMOTE_MODELS_LIMIT=$old_limit
  total="$(jq -r '.model_count' <<<"$bank")"
  (( total > 0 )) || {
    sc_remote_keybank_unstage "$staged"
    sc_die "OpenRouter free tool-capable model bank is empty after profile/cooldown filtering" 69
  }

  snapshot_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-auto-snapshot.XXXXXX")"
  results_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-auto-results.XXXXXX")"
  error_file="$(mktemp "$SC_GLOBAL/runtime/.openrouter-auto-error.XXXXXX")"
  jq -n '{name:"openrouter",base_url:"https://openrouter.ai/api/v1",env_key:"OPENROUTER_API_KEY",wire_api:"responses"}' |
    sc_atomic "$snapshot_file" 600
  descriptor="$(python3 -P - "$snapshot_file" <<'PY'
import hashlib, json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)
print(hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()).hexdigest())
PY
)"
  cache_root="$SC_GLOBAL/remote/qualifications"
  while IFS=$'\t' read -r model rank strength bench_points bench_possible bench_passed bench_total metadata_strength; do
    [[ -n "$model" ]] || continue
    index=$((index + 1))
    if [[ -n "$bench_points" && -n "$bench_possible" ]]; then
      sc_note "remote auto · testing ${index}/${total} · ${model} · bench ${bench_points}/${bench_possible} · tasks ${bench_passed:-?}/${bench_total:-?} · heuristic ${metadata_strength:-0}"
    else
      sc_note "remote auto · testing ${index}/${total} · ${model} · heuristic ${metadata_strength:-$strength}"
    fi
    while IFS=$'\t' read -r key_id key_file key_label _key_remaining; do
      [[ -n "$key_id" ]] || continue
      if jq -e --arg route "$key_id:$model" \
        '(.cooldowns.pairs[$route] // null) != null' <<<"$bank" >/dev/null; then
        continue
      fi
      rc=0
      successful_attempt_started_at="$(sc_now)"
      result="$(
        sc_emit_remote_qualifier | python3 -P - qualify \
          --snapshot "$snapshot_file" --credential-file "$key_file" \
          --model "$model" --descriptor-sha256 "$descriptor" --root "$cache_root" \
          --timeout "$SC_REMOTE_QUALIFICATION_TIMEOUT" \
          --timestamp "$(sc_now)" --force 2>"$error_file"
      )" || rc=$?
      if (( rc == 0 )) && sc_remote_qualification_result_valid "$descriptor" "$model" <<<"$result"; then
        selected_model=$model
        selected_rank=$rank
        selected_strength=$strength
        selected_key_id=$key_id
        selected_key_label=$key_label
        selected_bench_points=$bench_points
        selected_bench_possible=$bench_possible
        selected_bench_passed=$bench_passed
        selected_bench_total=$bench_total
        selected_metadata_strength=$metadata_strength
        selected_receipt="$(jq -er '.receipt_path' <<<"$result")"
        selected_receipt_sha="$(jq -er '.receipt_sha256' <<<"$result")"
        sc_remote_cooldown_clear_route "$key_id" "$model" "$successful_attempt_started_at"
        break 2
      fi
      detail="$(sed -n '1{s/[^[:print:]\t]/?/g;p;}' "$error_file" 2>/dev/null | cut -c1-1000)"
      jq -cn --arg model "$model" --arg key_id "$key_id" --arg detail "$detail" \
        '{model:$model,key_id:$key_id,result:"failed",detail:(if $detail=="" then null else $detail end)}' >>"$results_file"
      if [[ "$detail" == *"HTTP 402"* || "$detail" == *"insufficient quota"* ]]; then
        sc_remote_cooldown_record keys "$key_id" "$detail" "$SC_REMOTE_KEY_COOLDOWN_SECONDS"
      fi
      if [[ "$detail" == *"HTTP 429"* || "$detail" == *"temporarily rate-limited upstream"* || "$detail" == *"provider returned error"* || "$detail" == *"unavailable for qualification"* ]]; then
        sc_remote_cooldown_record pairs "$key_id:$model" "$detail" "$SC_REMOTE_MODEL_COOLDOWN_SECONDS"
      fi
      if [[ "$detail" != *"HTTP 429"* && "$detail" != *"HTTP 402"* && "$detail" != *"unavailable for qualification"* ]]; then
        break
      fi
    done <<<"$key_rows"
  done < <(jq -r '.models[] |
    [
      .id,
      (.rank|tostring),
      ((.profile_score // .coding_bench_score // .strength_score // 0)|tostring),
      ((.coding_bench_points // "-")|tostring),
      ((.coding_bench_possible_points // "-")|tostring),
      ((.coding_bench_passed_tasks // "-")|tostring),
      ((.coding_bench_total_tasks // "-")|tostring),
      ((.strength_score // "-")|tostring)
    ] | @tsv' <<<"$bank")

  if [[ -z "$selected_model" ]]; then
    failure_path="$SC_CONTROL/openrouter-auto-selection-failed.json"
    failure_json="$(jq -n -c \
      --arg schema "sandcodex.openrouter-auto-selection.v1" \
      --arg failed_at "$(sc_now)" --argjson bank "$bank" \
      --slurpfile results "$results_file" '
      {schema:$schema,result:"failed",failed_at:$failed_at,provider:"openrouter",
         credential_value_disclosed:false, key_bank_used:true,
         source_url:$bank.source_url, candidate_count:$bank.model_count,
         profile:($bank.profile // null),
         cooldowns:($bank.cooldowns // null),
         ranking_source:($bank.ranking_source // "metadata"),
         coding_bench:($bank.coding_bench // null),
         failed_attempts:$results,
         policy:"safe failure receipt only; key ids and sanitized provider errors may be present, credential values are absent"}' </dev/null)"
    printf '%s\n' "$failure_json" | sc_atomic "$failure_path" 600
    sc_remote_keybank_unstage "$staged"
    rm -f -- "$snapshot_file" "$results_file" "$error_file"
    sc_die "remote auto could not qualify any free OpenRouter tool-capable model with the current key bank; failure receipt: $failure_path" 69
  fi

  while IFS=$'\t' read -r key_id key_file key_label _key_remaining; do
    if [[ "$key_id" == "$selected_key_id" ]]; then
      bootstrap="$(mktemp "$SC_GLOBAL/runtime/.openrouter-auto-token.XXXXXX")"
      cat -- "$key_file" | sc_atomic "$bootstrap" 600
      break
    fi
  done <<<"$key_rows"
  [[ -n "$bootstrap" ]] || {
    sc_remote_keybank_unstage "$staged"
    rm -f -- "$snapshot_file" "$results_file" "$error_file"
    sc_die "remote auto selected a key that is no longer staged" 78
  }
  SC_REMOTE_AUTO_KEYBANK_COPY="$SC_CONTROL/openrouter-auto-key-bank.txt"
  sc_owned_single_file "$(jq -er '.path' <<<"$staged")" 600 "OpenRouter key bank"
  cat -- "$(jq -er '.path' <<<"$staged")" | sc_atomic "$SC_REMOTE_AUTO_KEYBANK_COPY" 600
  SC_REMOTE_AUTO_MODEL_BANK_COPY="$SC_CONTROL/openrouter-auto-model-bank.json"
  printf '%s\n' "$bank" | sc_atomic "$SC_REMOTE_AUTO_MODEL_BANK_COPY" 600

  SC_MODEL="$selected_model"
  SC_MODEL_SET=1
  SC_REMOTE_NAME=openrouter
  SC_REMOTE_BOOTSTRAP_TOKEN_FILE=$bootstrap
  SC_REMOTE_BOOTSTRAP_ENV_KEY=OPENROUTER_API_KEY
  SC_REMOTE_AUTO_SELECTION_JSON="$SC_CONTROL/openrouter-auto-selection.json"
  selected_json="$(jq -n -c \
    --arg schema "sandcodex.openrouter-auto-selection.v1" \
    --arg selected_at "$(sc_now)" --arg model "$selected_model" \
    --arg key_id "$selected_key_id" --arg key_label "$selected_key_label" \
    --arg descriptor "$descriptor" --arg receipt "$selected_receipt" \
    --arg receipt_sha256 "$selected_receipt_sha" --argjson bank "$bank" \
    --arg rank "$selected_rank" --arg strength "$selected_strength" \
    --arg bench_points "$selected_bench_points" --arg bench_possible "$selected_bench_possible" \
    --arg bench_passed "$selected_bench_passed" --arg bench_total "$selected_bench_total" \
    --arg metadata_strength "$selected_metadata_strength" \
    --arg profile "$SC_REMOTE_PROFILE" \
    --argjson dry_run "$SC_REMOTE_AUTO_DRY_RUN" \
    --arg model_bank_file "$SC_REMOTE_AUTO_MODEL_BANK_COPY" '
      {schema:$schema,result:"selected",selected_at:$selected_at,provider:"openrouter",
       dry_run:$dry_run,
       model:$model,rank:($rank|tonumber),selection_score:($strength|tonumber),
       key_id:$key_id,key_label:$key_label,descriptor_sha256:$descriptor,
       qualification_receipt:$receipt,qualification_receipt_sha256:$receipt_sha256,
       credential_value_disclosed:false, key_bank_used:true,
       source_url:$bank.source_url, candidate_count:$bank.model_count,
       profile:$profile,
       profile_policy:($bank.profile.policy // null),
       cooldowns:($bank.cooldowns // null),
       ranking_source:($bank.ranking_source // "metadata"),
       coding_bench:($bank.coding_bench // null),
       model_bank_file:$model_bank_file,
       selection:{
         rank:($rank|tonumber),
         score:($strength|tonumber),
         coding_bench_points:(if $bench_points == "" or $bench_points == "-" then null else ($bench_points|tonumber) end),
         coding_bench_possible_points:(if $bench_possible == "" or $bench_possible == "-" then null else ($bench_possible|tonumber) end),
         coding_bench_passed_tasks:(if $bench_passed == "" or $bench_passed == "-" then null else ($bench_passed|tonumber) end),
         coding_bench_total_tasks:(if $bench_total == "" or $bench_total == "-" then null else ($bench_total|tonumber) end),
         metadata_strength_score:(if $metadata_strength == "" or $metadata_strength == "-" then null else ($metadata_strength|tonumber) end)
       },
       policy:"preflight qualification selects the preferred route for this fresh room; the bound local Responses relay may fail over among the sealed free agent-candidate model/key bank only before any downstream bytes become visible, and structurally validates each fallback response while private; existing bound resumes restart the exact relay artifact and banks"}')"
  printf '%s\n' "$selected_json" | sc_atomic "$SC_REMOTE_AUTO_SELECTION_JSON" 600
  sc_remote_keybank_unstage "$staged"
  rm -f -- "$snapshot_file" "$results_file" "$error_file"
  if (( SC_REMOTE_AUTO_DRY_RUN )); then
    rm -f -- "$bootstrap" "$SC_REMOTE_AUTO_KEYBANK_COPY"
    SC_REMOTE_BOOTSTRAP_TOKEN_FILE=""
    sc_remote_auto_dry_run_render "$selected_json"
    exit 0
  fi
  sc_note "remote auto · selected $selected_model · key $selected_key_id · receipt $selected_receipt_sha"
}

