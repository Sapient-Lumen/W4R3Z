+static struct sway_seat_device *sandcodex_single_virtual_keyboard(
+		struct sway_seat *seat) {
+	if (!seat) {
+		return NULL;
+	}
+	struct sway_seat_device *result = NULL;
+	struct sway_seat_device *seat_device = NULL;
+	wl_list_for_each(seat_device, &seat->devices, link) {
+		struct sway_input_device *input = seat_device->input_device;
+		if (!input || !input->wlr_device ||
+				input->wlr_device->type != WLR_INPUT_DEVICE_KEYBOARD) {
+			continue;
+		}
+		struct sway_keyboard *keyboard = seat_device->keyboard;
+		struct wlr_keyboard *wlr = keyboard ? keyboard->wlr : NULL;
+		if (result || !input->is_virtual || !input->identifier ||
+				!input->identifier[0] ||
+				strlen(input->identifier) > SANDCODEX_DEVICE_IDENTIFIER_LIMIT ||
+				!keyboard || keyboard->seat_device != seat_device || !wlr ||
+				wlr_keyboard_from_input_device(input->wlr_device) != wlr ||
+				wlr->group || !wlr->keymap || !wlr->xkb_state) {
+			return NULL;
+		}
+		result = seat_device;
+	}
+	return result;
+}
