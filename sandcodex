            )
            with WaylandSelectionCaptureTransaction(
                self, "controller-initialization", None, maximum_bytes=MAX_TEXT_BYTES
            ) as selection_transaction:
                selection_transaction.ping()
                selection_transaction.arm()
                selection_transaction.clear()
            self.selection_transport_initialization = selection_transaction.evidence()
            self.journal.append(
                "selection-transport",
                "desktop-selection-initialize",
                {
                    "payload_bytes": 0,
                    "input_emitted": False,
                    "probe": "clear-arm-ping-roundtrip-clear-without-capture",
                },
                self.selection_transport_initialization,
            )
        self.file_copy_startup_recovery = sc_recover_file_copy_staging(self)
        self.journal.append(
            "file-copy-recovery",
            "desktop-startup",
            {"automatic": True, "project_lock_required": True},
            self.file_copy_startup_recovery,
        )
        self._custody_stop = threading.Event()
        self._custody_thread = threading.Thread(target=self._custody_loop, name="sandcodex-desktop-custody", daemon=True)
        self._custody_thread.start()

    def close(self) -> None:
        self._custody_stop.set()
        with self.lock:
            self.frame_cursors.clear()
            drop_transaction = getattr(self, "_active_drop_transaction", None)
            if drop_transaction is not None:
                with contextlib.suppress(Exception):
                    drop_transaction.close()
            clipboard_transaction = getattr(self, "_active_clipboard_transaction", None)
            if clipboard_transaction is not None:
                with contextlib.suppress(Exception):
                    clipboard_transaction.close()
            input_method_transaction = getattr(self, "_active_input_method_transaction", None)
            if input_method_transaction is not None:
                with contextlib.suppress(Exception):
                    input_method_transaction.close()
            keyboard_transaction = getattr(self, "_active_keyboard_transaction", None)
            if keyboard_transaction is not None:
                with contextlib.suppress(Exception):
                    keyboard_transaction.close()
            transaction = getattr(self, "_active_pointer_transaction", None)
            if transaction is not None:
                with contextlib.suppress(Exception):
                    transaction.close()
            elif self.pointer_pressed_button is not None and not self.is_wayland:
                with contextlib.suppress(Exception):
                    self._release_pointer_button(self.pointer_pressed_button, quarantine_on_failure=False)
            if self.x11_pressed_modifier_codes and not self.is_wayland:
                with contextlib.suppress(Exception):
                    for code in reversed(self.x11_pressed_modifier_codes):
                        self._fake_keycode(code, False)
                    self._sync()
                    self.x11_pressed_modifier_codes.clear()
            for pid in list(self.processes):
                with contextlib.suppress(ToolError):
                    self._stop_process(pid, signal.SIGTERM, 1.0)
        self._custody_thread.join(timeout=1)
        self.accessibility.close()
        if self.clipboard is not None:
            self.clipboard.close()
        if self.compositor_event_seal is not None:
            self.compositor_event_seal.close()
        if self.display is not None:
            with contextlib.suppress(Exception):
                self.display.close()

    @staticmethod
    def _grim_help_has_foreign_toplevel(value: str) -> bool:
        return re.search(r"(?m)(?:^|[\s,])-T(?:[=\s,]|$)", value) is not None

    @classmethod
    def _attest_capture_stack(cls, commands: dict[str, str]) -> dict[str, Any]:
        grim = commands.get("grim")
        if not isinstance(grim, str) or not grim:
            raise RuntimeError("CaptureSeal has no resolved grim executable")
        try:
            completed = subprocess.run(
                [grim, "-h"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise RuntimeError("CaptureSeal could not inspect grim capabilities") from error
        help_bytes = completed.stdout + completed.stderr
        if len(help_bytes) > 256 * 1024:
            raise RuntimeError("CaptureSeal grim capability output is unbounded")
        help_text = help_bytes.decode("utf-8", "replace")
        if not cls._grim_help_has_foreign_toplevel(help_text):
            raise RuntimeError("CaptureSeal requires grim foreign-toplevel capture support (-T)")
        return {
            "schema": CAPTURE_SEAL_SCHEMA,
            "grim_path": grim,
            "grim_help_sha256": hashlib.sha256(help_bytes).hexdigest(),
            "grim_foreign_toplevel_option": True,
            "sway_tree_identity_field": "foreign_toplevel_identifier",
            "attested_at_startup": True,
        }

    def _attest_capture_output(self) -> dict[str, Any]:
        """Prove the private output has one stable logical pixel coordinate map."""
        try:
            outputs = self._sway_json("get_outputs")
        except ToolError as error:
            raise RuntimeError("CaptureSeal could not inspect the private Sway output") from error
        if not isinstance(outputs, list):
            raise RuntimeError("CaptureSeal received malformed Sway output metadata")
        active = [item for item in outputs if isinstance(item, dict) and item.get("active") is True]
        if len(active) != 1:
            raise RuntimeError("CaptureSeal requires exactly one active private Sway output")
        output = active[0]
        try:
            rectangle = self._validate_capture_rect(output.get("rect"), "private Sway output rectangle")
        except ToolError as error:
            raise RuntimeError("CaptureSeal received invalid private output geometry") from error
        if rectangle != {"x": 0, "y": 0, "width": self.width, "height": self.height}:
            raise RuntimeError("CaptureSeal private output geometry disagrees with the controller contract")
        scale = output.get("scale")
        if (
            isinstance(scale, bool)
            or not isinstance(scale, (int, float))
            or not math.isfinite(float(scale))
            or float(scale) != 1.0
        ):
            raise RuntimeError("CaptureSeal requires private Sway output scale 1")
        transform = output.get("transform")
        if transform != "normal":
            raise RuntimeError("CaptureSeal requires an explicitly untransformed private Sway output")
        name = output.get("name")
        if not isinstance(name, str) or not name or len(name.encode("utf-8", "replace")) > 256:
            raise RuntimeError("CaptureSeal private output identity is invalid")
        return {
            "name_sha256": hashlib.sha256(name.encode("utf-8")).hexdigest(),
            "rectangle": rectangle,
            "scale": 1,
            "transform": "normal",
            "active_output_count": 1,
            "attested_at_startup": True,
        }

