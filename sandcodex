    def release_modifier_arc(self, arc: CompositorModifierArc) -> dict[str, Any]:
        """Consume one private arc token and request target-independent clear."""
        if not isinstance(arc, CompositorModifierArc):
            raise ToolError("compositor modifier-arc release authority is invalid")
        if arc.owner_nonce != self.nonce:
            raise ToolError("compositor modifier arc belongs to another IPC principal")
        with self.command_lock:
            try:
                raw_arc = arc.take_arc()
                release_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        "arc": raw_arc,
                        "modifiers": arc.modifiers,
                        "op": "release-modifier-arc",
                    }),
                    "SANDCODEX_HIT_TEST release-modifier-arc",
                )
                raw_arc = None
                receipt = self._normalize_release_modifier_arc_reply(
                    release_reply, arc
                )
                self.compositor_modifier_arc_releases += 1
                self.last_compositor_modifier_arc_release_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_modifier_arc_failures += 1
                # If send or receive was ambiguous, connection teardown is the
                # authenticated, compositor-owned emergency clear operation.
                self._revoke_command_connection(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor modifier-arc release failed closed: {error}"
                ) from error


