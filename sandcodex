    @classmethod
    def _scene_occlusion_action_authority(
        cls,
        action_name: str,
        arguments: dict[str, Any],
    ) -> tuple[str, tuple[int, int] | None]:
        """Keep overlap-derived authority to one irreversible input unit."""
        modifiers, _mask = WaylandKeyboardTransaction.normalize_modifiers(
            arguments.get("modifiers")
        )
        if modifiers:
            raise ToolError(
                "scene-set occlusion input does not authorize seat-global keyboard modifiers"
            )
        if action_name == "desktop_click":
            if int(arguments.get("count", 1)) != 1:
                raise ToolError("scene-set occlusion pixel activation requires click count 1")
            if as_int(arguments.get("button", 1), 1, 3, "button") != 1:
                raise ToolError("scene-set occlusion pixel activation requires the primary button")
            return "primary-single-click", None
        if action_name == "desktop_scroll":
            unit = cls._scene_occlusion_axis_unit(arguments)
            return "single-cardinal-wheel-detent", unit
        raise ToolError(
            "scene-set occlusion pixels authorize only one primary click or one exact wheel detent, not drag, paste, or data drop"
        )

    def _pointer_route(
        self,
        action_name: str,
        arguments: dict[str, Any],
        windows: list[dict[str, Any]],
        launch_id: str | None,
        launch_scene_authority_sha256: str | None = None,
        scene_set_authority_sha256: str | None = None,
        scene_launch_ids: tuple[str, ...] | None = None,
        scene_id: str | None = None,
        scene_transient_map: dict[str, Any] | None = None,
        scene_occlusion_map: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        if action_name in {
            "desktop_click", "desktop_touch", "desktop_touchpad_swipe",
            "desktop_touchpad_pinch", "desktop_touchpad_hold", "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
            "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
            "desktop_relative_motion", "desktop_scroll", "desktop_drop",
        } or (
            action_name == "desktop_paste"
            and arguments.get("delivery") == "primary-middle-click"
        ):
            points = [(int(arguments["x"]), int(arguments["y"]))]
        elif action_name == "desktop_touch_swipe":
            points = self._touch_stroke_points(arguments)
        elif action_name == "desktop_stylus_hover":
            points = self._stylus_hover_points(arguments)
        elif action_name == "desktop_stylus_stroke":
            points = self._stylus_stroke_points(arguments)
        elif action_name == "desktop_eraser_stroke":
            points = self._eraser_stroke_points(arguments)
        elif action_name == "desktop_touch_gesture":
            first_path, second_path = self._touch_gesture_paths(arguments)
            points = [
                point
                for pair in zip(first_path, second_path)
                for point in pair
            ]
        elif action_name == "desktop_drag":
            points = self._drag_points(arguments)
        else:
            raise ToolError("pointer route requested for a non-pointer action")
        launch_scene = launch_scene_authority_sha256 is not None
        scene_set = scene_set_authority_sha256 is not None
        if launch_scene and scene_set:
            raise ToolError("guarded pointer route cannot mix launch-scene and scene-set authority")
        if launch_scene:
            if launch_id is None:
                raise ToolError("launch-scene pointer route has no launch identity")
            if re.fullmatch(r"[0-9a-f]{64}", launch_scene_authority_sha256 or "") is None:
                raise ToolError("launch-scene pointer route authority is invalid")
        allowed_launch_ids: set[str] | None = None
        normalized_scene: str | None = None
        validated_transient_map: dict[str, Any] | None = None
        validated_occlusion_map: dict[str, Any] | None = None
        if scene_set:
            if launch_id is not None:
                raise ToolError("scene-set pointer route cannot carry a singular launch identity")
            if re.fullmatch(r"[0-9a-f]{64}", scene_set_authority_sha256 or "") is None:
                raise ToolError("scene-set pointer route authority is invalid")
            if scene_launch_ids is None:
                raise ToolError("scene-set pointer route has no exact member identity set")
            normalized_scene = self._scene_id(scene_id, required=True)
            assert normalized_scene is not None
            allowed_launch_ids = set(scene_launch_ids)
            if (
                not 2 <= len(allowed_launch_ids) <= SCENE_SET_MAX_LAUNCHES
                or len(allowed_launch_ids) != len(scene_launch_ids)
            ):
                raise ToolError("scene-set pointer route member identity set is invalid")
            if scene_transient_map is not None and scene_occlusion_map is not None:
                raise ToolError(
                    "scene-set pointer route cannot mix transient and occlusion ownership maps"
                )
            if scene_transient_map is not None:
                validated_transient_map = self._validate_scene_transient_map(
                    scene_transient_map
                )
                if (
                    validated_transient_map["scene_set_authority_sha256"]
                    != scene_set_authority_sha256
                    or validated_transient_map["width"] != self.width
                    or validated_transient_map["height"] != self.height
                ):
                    raise ToolError("scene-set pointer route transient authority is inconsistent")
            if scene_occlusion_map is not None:
                validated_occlusion_map = self._validate_scene_occlusion_map(
                    scene_occlusion_map
                )
                if (
                    validated_occlusion_map["scene_set_authority_sha256"]
                    != scene_set_authority_sha256
                    or validated_occlusion_map["width"] != self.width
                    or validated_occlusion_map["height"] != self.height
                ):
                    raise ToolError("scene-set pointer route occlusion authority is inconsistent")
        elif scene_id is not None:
            raise ToolError("non-scene-set pointer route carries an unexpected scene identity")
        elif scene_transient_map is not None or scene_occlusion_map is not None:
            raise ToolError("non-scene-set pointer route carries ownership authority")
        visible_windows = [window for window in windows if window.get("visible", True)]
        identities = {
            self._pointer_window_identity_sha256(window): self._pointer_window_identity(window)
            for window in visible_windows
        }
        route_points: list[dict[str, Any]] = []
        final_index = len(points) - 1
        for index, (x, y) in enumerate(points):
            covering = self._pointer_covering_identities(visible_windows, x, y)
            transient_owner: dict[str, Any] | None = None
            transient_action: str | None = None
            transient_axis_unit: tuple[int, int] | None = None
            occlusion_owner: dict[str, Any] | None = None
            occlusion_action: str | None = None
            occlusion_axis_unit: tuple[int, int] | None = None
            if len(covering) > 1:
                if allowed_launch_ids is not None and validated_occlusion_map is not None:
                    occlusion_owner = self._scene_occlusion_owner_at(
                        validated_occlusion_map,
                        x,
                        y,
                    )
                    if occlusion_owner is not None:
                        occlusion_action, occlusion_axis_unit = (
                            self._scene_occlusion_action_authority(action_name, arguments)
                        )
                        owner_window = next(
                            (
                                window for window in visible_windows
                                if window.get("id") == occlusion_owner.get("window_id")
                            ),
                            None,
                        )
                        if (
                            owner_window is None
                            or owner_window.get("launch_id") != occlusion_owner.get("launch_id")
                            or owner_window.get("launch_id") not in allowed_launch_ids
                            or owner_window.get("origin_verified") is not True
                            or owner_window.get("capture_identity_sha256")
                            != occlusion_owner.get("capture_identity_sha256")
                            or self._capture_window_authority_sha256(owner_window)
                            != occlusion_owner.get("window_authority_sha256")
                            or self._pointer_window_identity_sha256(owner_window) not in covering
                        ):
                            raise ToolError(
                                "scene-set occlusion pixel owner no longer matches its exact covering top-level"
                            )
                if occlusion_owner is None:
                    raise ToolError(
                        "guarded pointer route is ambiguous beneath overlapping top-level windows; "
                        "obtain a fresh exact OcclusionMeshSeal map"
                    )
            elif allowed_launch_ids is not None and not covering and validated_transient_map is not None:
                transient_owner = self._scene_transient_owner_at(validated_transient_map, x, y)
                if transient_owner is not None:
                    if action_name == "desktop_click":
                        if int(arguments.get("count", 1)) != 1:
                            raise ToolError("scene-set transient pixel activation requires click count 1")
                        if as_int(arguments.get("button", 1), 1, 3, "button") != 1:
                            raise ToolError("scene-set transient pixel activation requires the primary button")
                        transient_action = "primary-single-click"
                    elif action_name == "desktop_scroll":
                        transient_axis_unit = self._scene_transient_axis_unit(arguments)
                        transient_action = "single-cardinal-wheel-detent"
                    else:
                        raise ToolError(
                            "scene-set transient pixels authorize only one primary click or one exact wheel detent, not drag or data drop"
                        )
                    owner_window = next(
                        (
                            window for window in visible_windows
                            if window.get("id") == transient_owner.get("window_id")
                        ),
                        None,
                    )
                    if (
                        owner_window is None
                        or owner_window.get("launch_id") != transient_owner.get("launch_id")
                        or owner_window.get("launch_id") not in allowed_launch_ids
                        or owner_window.get("origin_verified") is not True
                        or owner_window.get("capture_identity_sha256")
                        != transient_owner.get("capture_identity_sha256")
                        or self._capture_window_authority_sha256(owner_window)
                        != transient_owner.get("window_authority_sha256")
                    ):
                        raise ToolError("scene-set transient pixel owner no longer matches its exact top-level")
            endpoint_requires_window = (
                not launch_scene
                and (
                    action_name in {
                        "desktop_click", "desktop_touch", "desktop_touch_swipe",
                        "desktop_touch_gesture", "desktop_touchpad_swipe",
                        "desktop_touchpad_pinch", "desktop_touchpad_hold",
                        "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
                        "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
                        "desktop_relative_motion",
                        "desktop_stylus_hover", "desktop_stylus_stroke", "desktop_eraser_stroke",
                        "desktop_scroll", "desktop_drop", "desktop_paste",
                    }
                    or index in {0, final_index}
                )
            )
            if (
                endpoint_requires_window
                and not covering
                and transient_owner is None
                and occlusion_owner is None
            ):
                raise ToolError("guarded pointer target is outside every visible top-level window")
            if launch_id is not None:
                for digest in covering:
                    identity = identities.get(digest)
                    if (
                        identity is None
                        or identity.get("launch_id") != launch_id
                        or identity.get("origin_verified") is not True
                    ):
                        raise ToolError("guarded pointer route intersects another application trust domain")
            if allowed_launch_ids is not None:
                if not covering and transient_owner is None:
                    raise ToolError(
                        "scene-set pointer input requires an attributed member top-level; "
                        "uncovered transient-surface pixels need a fresh exact PopupMeshSeal map"
                    )
                for digest in covering:
                    identity = identities.get(digest)
                    if (
                        identity is None
                        or identity.get("launch_id") not in allowed_launch_ids
                        or identity.get("origin_verified") is not True
                    ):
                        raise ToolError("guarded pointer route intersects a non-member trust domain")
            expected_window_id: int | None = None
            if occlusion_owner is not None:
                expected_window_id = int(occlusion_owner["window_id"])
            elif transient_owner is not None:
                expected_window_id = int(transient_owner["window_id"])
            elif len(covering) == 1:
                reviewed_identity = identities.get(covering[0])
                if reviewed_identity is not None and isinstance(
                    reviewed_identity.get("window_id"), int
                ):
                    expected_window_id = int(reviewed_identity["window_id"])
            hit_test_seal = self._pointer_hit_test_seal(
                x,
                y,
                visible_windows,
                launch_id=launch_id,
                allowed_launch_ids=allowed_launch_ids,
                expected_window_id=expected_window_id,
            )
            route_point = {
                "point": [x, y],
                **hit_test_seal,
                "covering": list(covering),
                "transient_owner_sha256": (
                    transient_owner.get("owner_sha256") if transient_owner is not None else None
                ),
                "transient_action": transient_action,
                "transient_axis_unit": (
                    list(transient_axis_unit) if transient_axis_unit is not None else None
                ),
            }
            if action_name == "desktop_touch_gesture":
                route_point.update({
                    "touch_contact_id": index % TOUCH_GESTURE_CONTACT_COUNT,
                    "touch_path_index": index // TOUCH_GESTURE_CONTACT_COUNT,
                })
            # Preserve the established route-point schema unless this route
            # actually carries OcclusionMesh authority.  Legacy launch-scene,
            # top-level, and PopupMesh receipts remain byte-stable while the
            # overlap-specific fields are still committed whenever relevant.
            if validated_occlusion_map is not None:
                route_point.update({
                    "occlusion_owner_sha256": (
                        occlusion_owner.get("owner_sha256")
                        if occlusion_owner is not None else None
                    ),
                    "occlusion_action": occlusion_action,
                    "occlusion_axis_unit": (
                        list(occlusion_axis_unit)
                        if occlusion_axis_unit is not None else None
                    ),
                })
            route_points.append(route_point)
        if action_name in {
            "desktop_touch_swipe", "desktop_touch_gesture", "desktop_stylus_hover", "desktop_stylus_stroke",
            "desktop_eraser_stroke", "desktop_touchpad_swipe", "desktop_touchpad_pinch",
            "desktop_touchpad_hold", "desktop_tablet_pad_ring", "desktop_tablet_pad_strip",
            "desktop_tablet_pad_button", "desktop_tablet_pad_mode",
            "desktop_relative_motion",
        }:
            touch_label = {
                "desktop_touch_gesture": "native two-contact gesture",
                "desktop_touchpad_swipe": "native touchpad swipe",
                "desktop_touchpad_pinch": "native touchpad pinch",
                "desktop_touchpad_hold": "native touchpad hold",
                "desktop_tablet_pad_ring": "native tablet-v2 pad ring",
                "desktop_tablet_pad_strip": "native tablet-v2 pad strip",
                "desktop_tablet_pad_button": "native tablet-v2 pad button",
                "desktop_tablet_pad_mode": "native tablet-v2 pad mode transition",
                "desktop_relative_motion": "locked relative motion",
                "desktop_stylus_hover": "native no-contact tablet-v2 stylus hover",
                "desktop_stylus_stroke": "native tablet-v2 stylus stroke",
                "desktop_eraser_stroke": "native tablet-v2 eraser stroke",
                "desktop_touch_swipe": "native touch swipe",
            }[action_name]
            if any(
                point.get("transient_owner_sha256") is not None
                or point.get("occlusion_owner_sha256") is not None
                for point in route_points
            ):
                raise ToolError(
                    f"{touch_label} cannot use inferred popup or occlusion ownership"
                )
            exact_targets = {
                (
                    point.get("hit_test_recipient_identity_sha256"),
                    point.get("hit_test_window_id"),
                    point.get("hit_test_target_kind"),
                    point.get("hit_test_surface_class"),
                )
                for point in route_points
            }
            if len(exact_targets) != 1:
                raise ToolError(
                    f"{touch_label} route crosses an exact compositor recipient boundary"
                )
            exact_target = next(iter(exact_targets))
            if exact_target[2] != "surface":
                raise ToolError(
                    f"{touch_label} requires one exact client surface for its whole route"
                )

        projection = {
            "schema": POINTER_FENCE_TARGET_IDENTITY_SCHEMA,
            "action": action_name,
            "launch_id": launch_id,
            "route_scope": (
                "launch-scene" if launch_scene else "scene-set" if scene_set else "top-level"
            ),
            "launch_scene_authority_sha256": launch_scene_authority_sha256,
            "scene_set_authority_sha256": scene_set_authority_sha256,
            "scene_transient_map_sha256": (
                validated_transient_map.get("map_sha256")
                if validated_transient_map is not None else None
            ),
            "scene_occlusion_map_sha256": (
                validated_occlusion_map.get("map_sha256")
                if validated_occlusion_map is not None else None
            ),
            "scene_id": normalized_scene,
            "scene_member_set_sha256": (
                hashlib.sha256(canonical_json(sorted(scene_launch_ids))).hexdigest()
                if scene_launch_ids is not None else None
            ),
            "scene_sha256": self._pointer_scene_sha256(visible_windows),
            "points": route_points,
        }
        target_window_ids = sorted({
            int(identity["window_id"])
            for point in route_points
            if point.get("occlusion_owner_sha256") is None
            for digest in point["covering"]
            if (identity := identities.get(digest)) is not None
            and isinstance(identity.get("window_id"), int)
        })
        target_window_ids = sorted(set(target_window_ids) | {
            int(point["hit_test_window_id"])
            for point in route_points
            if isinstance(point.get("hit_test_window_id"), int)
        } | {
            int(owner["window_id"])
            for point in route_points
            if point.get("transient_owner_sha256") is not None
            for owner in (validated_transient_map.get("owners", []) if validated_transient_map else [])
            if owner.get("owner_sha256") == point.get("transient_owner_sha256")
        } | {
            int(owner["window_id"])
            for point in route_points
            if point.get("occlusion_owner_sha256") is not None
            for owner in (validated_occlusion_map.get("owners", []) if validated_occlusion_map else [])
            if owner.get("owner_sha256") == point.get("occlusion_owner_sha256")
        })
        return {
            **projection,
            "route_sha256": hashlib.sha256(canonical_json(projection)).hexdigest(),
            "target_window_ids": target_window_ids,
            "identities": identities,
            "scene_launch_ids": tuple(sorted(scene_launch_ids)) if scene_launch_ids is not None else None,
            "scene_transient_map": validated_transient_map,
            "scene_occlusion_map": validated_occlusion_map,
        }

    def _assert_pointer_route(
        self,
        route: dict[str, Any],
        point_index: int,
        *,
        prepared_hit: dict[str, Any] | None = None,
    ) -> None:
        self._require_pointer_healthy()
        points = route.get("points")
        if not isinstance(points, list) or not 0 <= point_index < len(points):
            raise ToolError("guarded pointer route lost its point plan")
        expected = points[point_index]
        if not isinstance(expected, dict):
            raise ToolError("guarded pointer route point is malformed")
        point = expected.get("point")
        if not isinstance(point, list) or len(point) != 2:
            raise ToolError("guarded pointer route point is malformed")
        x, y = int(point[0]), int(point[1])
        windows = self._wayland_windows()
        route_scope = route.get("route_scope", "top-level")
        scene_members: list[ManagedProcess] = []
        if route_scope not in {"top-level", "launch-scene", "scene-set"}:
            raise PointerRouteTransition(
                "pointer gesture route scope became invalid; no further pointer unit was emitted"
            )
        if route_scope == "launch-scene":
            launch_id = route.get("launch_id")
            authority_sha256 = route.get("launch_scene_authority_sha256")
            try:
                managed = self._managed_by_launch_id(launch_id)
                self._assert_launch_scene_authority(managed, authority_sha256, windows)
            except ToolError as error:
                raise PointerRouteTransition(
                    "launch-scene pointer authority changed; no further pointer unit was emitted"
                ) from error
        elif route_scope == "scene-set":
            authority_sha256 = route.get("scene_set_authority_sha256")
            launch_ids = route.get("scene_launch_ids")
            scene_id = route.get("scene_id")
            try:
                if not isinstance(launch_ids, tuple):
                    raise ToolError("scene-set pointer route lost its exact member identities")
                members = self._managed_scene(
                    scene_id,
                    expected_launch_ids=launch_ids,
                )
                self._assert_scene_set_authority(members, authority_sha256, windows)
                scene_members = members
            except ToolError as error:
                raise PointerRouteTransition(
                    "scene-set pointer authority changed; no further pointer unit was emitted"
                ) from error
        scene_sha256 = self._pointer_scene_sha256(windows)
        if scene_sha256 != route.get("scene_sha256"):
            raise PointerRouteTransition(
                "pointer gesture top-level scene changed; no further pointer unit was emitted"
            )
        covering = self._pointer_covering_identities(windows, x, y)
        expected_covering = tuple(expected.get("covering", []))
        if covering != expected_covering:
            raise PointerRouteTransition(
                "pointer gesture route changed at the next checkpoint; no further pointer unit was emitted"
            )
        expected_transient_owner_sha256 = expected.get("transient_owner_sha256")
        expected_occlusion_owner_sha256 = expected.get("occlusion_owner_sha256")
        if (
            expected_transient_owner_sha256 is not None
            and expected_occlusion_owner_sha256 is not None
        ):
            raise PointerRouteTransition(
                "scene-set pointer route mixed incompatible ownership grants; no further pointer unit was emitted"
            )
        if len(covering) > 1 and expected_occlusion_owner_sha256 is None:
            raise PointerRouteTransition(
                "overlapping scene-set top-levels lost exact visible-owner authority; no further pointer unit was emitted"
            )
        if expected_transient_owner_sha256 is not None:
            expected_transient_action = expected.get("transient_action")
            required_transient_action = {
                "desktop_click": "primary-single-click",
                "desktop_scroll": "single-cardinal-wheel-detent",
            }.get(route.get("action"))
            expected_axis_unit = expected.get("transient_axis_unit")
            axis_unit_valid = (
                expected_axis_unit is None
                if route.get("action") == "desktop_click"
                else (
                    isinstance(expected_axis_unit, list)
                    and len(expected_axis_unit) == 2
                    and all(type(value) is int for value in expected_axis_unit)
                    and abs(expected_axis_unit[0]) + abs(expected_axis_unit[1]) == 1
                )
            )
            if (
                route_scope != "scene-set"
                or re.fullmatch(r"[0-9a-f]{64}", str(expected_transient_owner_sha256)) is None
                or covering
                or not scene_members
                or expected_transient_action != required_transient_action
                or not axis_unit_valid
            ):
                raise PointerRouteTransition(
                    "scene-set transient pointer authority became malformed; no further pointer unit was emitted"
                )
            route_map = route.get("scene_transient_map")
            try:
                validated_route_map = self._validate_scene_transient_map(route_map)
                if validated_route_map.get("map_sha256") != route.get("scene_transient_map_sha256"):
                    raise ToolError("route transient map digest changed")
                reviewed_owner = self._scene_transient_owner_at(validated_route_map, x, y)
                if (
                    reviewed_owner is None
                    or reviewed_owner.get("owner_sha256") != expected_transient_owner_sha256
                ):
                    raise ToolError("route transient owner changed")
                live_owner, live_map = self._live_scene_transient_owner(
                    scene_members,
                    windows,
                    str(route.get("scene_set_authority_sha256")),
                    x,
                    y,
                )
                if (
                    live_map.get("map_sha256") != route.get("scene_transient_map_sha256")
                    or live_owner is None
                    or live_owner.get("owner_sha256") != expected_transient_owner_sha256
                ):
                    raise ToolError("live transient pixel ownership changed")
            except ToolError as error:
                raise PointerRouteTransition(
                    "scene-set transient pixel ownership changed; no further pointer unit was emitted"
                ) from error
        if expected_occlusion_owner_sha256 is not None:
            expected_occlusion_action = expected.get("occlusion_action")
            required_occlusion_action = {
                "desktop_click": "primary-single-click",
                "desktop_scroll": "single-cardinal-wheel-detent",
            }.get(route.get("action"))
            expected_axis_unit = expected.get("occlusion_axis_unit")
            axis_unit_valid = (
                expected_axis_unit is None
                if route.get("action") == "desktop_click"
                else (
                    isinstance(expected_axis_unit, list)
                    and len(expected_axis_unit) == 2
                    and all(type(value) is int for value in expected_axis_unit)
                    and abs(expected_axis_unit[0]) + abs(expected_axis_unit[1]) == 1
                )
            )
            if (
                route_scope != "scene-set"
                or re.fullmatch(r"[0-9a-f]{64}", str(expected_occlusion_owner_sha256)) is None
                or len(covering) < SCENE_OCCLUSION_MIN_COVERING_TOPLEVELS
                or not scene_members
                or expected_occlusion_action != required_occlusion_action
                or not axis_unit_valid
            ):
                raise PointerRouteTransition(
                    "scene-set occlusion pointer authority became malformed; no further pointer unit was emitted"
                )
            route_map = route.get("scene_occlusion_map")
            try:
                validated_route_map = self._validate_scene_occlusion_map(route_map)
                if validated_route_map.get("map_sha256") != route.get("scene_occlusion_map_sha256"):
                    raise ToolError("route occlusion map digest changed")
                reviewed_owner = self._scene_occlusion_owner_at(validated_route_map, x, y)
                if (
                    reviewed_owner is None
                    or reviewed_owner.get("owner_sha256") != expected_occlusion_owner_sha256
                ):
                    raise ToolError("route occlusion owner changed")
                owner_window = next(
                    (
                        window for window in windows
                        if window.get("visible", True)
                        and window.get("id") == reviewed_owner.get("window_id")
                    ),
                    None,
                )
                if (
                    owner_window is None
                    or owner_window.get("launch_id") != reviewed_owner.get("launch_id")
                    or owner_window.get("origin_verified") is not True
                    or owner_window.get("capture_identity_sha256")
                    != reviewed_owner.get("capture_identity_sha256")
                    or self._capture_window_authority_sha256(owner_window)
                    != reviewed_owner.get("window_authority_sha256")
                    or self._pointer_window_identity_sha256(owner_window) not in covering
                ):
                    raise ToolError("route occlusion owner no longer matches a covering top-level")
                live_owner, live_map = self._live_scene_occlusion_owner(
                    scene_members,
                    windows,
                    str(route.get("scene_set_authority_sha256")),
                    x,
                    y,
                )
                if (
                    live_map.get("map_sha256") != route.get("scene_occlusion_map_sha256")
                    or live_owner is None
                    or live_owner.get("owner_sha256") != expected_occlusion_owner_sha256
                ):
                    raise ToolError("live occlusion pixel ownership changed")
            except ToolError as error:
                raise PointerRouteTransition(
                    "scene-set occlusion pixel ownership changed; no further pointer unit was emitted"
                ) from error
        launch_id = route.get("launch_id")
        if launch_id is not None:
            identities = {
                self._pointer_window_identity_sha256(window): self._pointer_window_identity(window)
                for window in windows
                if window.get("visible", True)
            }
            for digest in covering:
                identity = identities.get(digest)
                if (
                    identity is None
                    or identity.get("launch_id") != launch_id
                    or identity.get("origin_verified") is not True
                ):
                    raise PointerRouteTransition(
                        "pointer gesture route lost its launch attribution; no further pointer unit was emitted"
                    )
        scene_launch_ids = route.get("scene_launch_ids")
        if scene_launch_ids is not None:
            allowed = set(scene_launch_ids)
            identities = {
                self._pointer_window_identity_sha256(window): self._pointer_window_identity(window)
                for window in windows
                if window.get("visible", True)
            }
            if (
                not covering
                and expected_transient_owner_sha256 is None
                and expected_occlusion_owner_sha256 is None
            ):
                raise PointerRouteTransition(
                    "scene-set pointer route became unattributed; no further pointer unit was emitted"
                )
            for digest in covering:
                identity = identities.get(digest)
                if (
                    identity is None
                    or identity.get("launch_id") not in allowed
                    or identity.get("origin_verified") is not True
                ):
                    raise PointerRouteTransition(
                        "pointer gesture route lost its scene-set attribution; no further pointer unit was emitted"
                    )
            if expected_transient_owner_sha256 is not None:
                route_map = self._validate_scene_transient_map(route.get("scene_transient_map"))
                owner = self._scene_transient_owner_at(route_map, x, y)
                if owner is None or owner.get("launch_id") not in allowed:
                    raise PointerRouteTransition(
                        "scene-set transient pointer owner left the exact member set; no further pointer unit was emitted"
                    )
            if expected_occlusion_owner_sha256 is not None:
                route_map = self._validate_scene_occlusion_map(route.get("scene_occlusion_map"))
                owner = self._scene_occlusion_owner_at(route_map, x, y)
                if owner is None or owner.get("launch_id") not in allowed:
                    raise PointerRouteTransition(
                        "scene-set occlusion pointer owner left the exact member set; no further pointer unit was emitted"
                    )
                owner_window = next(
                    (
                        window for window in windows
                        if window.get("visible", True)
                        and window.get("id") == owner.get("window_id")
                    ),
                    None,
                )
                if (
                    owner_window is None
                    or self._pointer_window_identity_sha256(owner_window) not in covering
                ):
                    raise PointerRouteTransition(
                        "scene-set occlusion pointer owner left the exact overlap set; no further pointer unit was emitted"
                    )

        expected_hit_test = {
            key: expected.get(key)
            for key in (
                "hit_test_schema",
                "hit_test_identity_sha256",
                "hit_test_recipient_identity_sha256",
                "hit_test_context_sha256",
                "hit_test_window_id",
                "hit_test_launch_id",
                "hit_test_target_kind",
                "hit_test_surface_class",
                "hit_test_recipient_process_scope",
                "hit_test_exact_dispatch_target",
                "hit_test_client_input_region",
                "hit_test_dispatch_path",
            )
        }
        try:
            current_hit_test = self._pointer_hit_test_seal(
                x,
                y,
                windows,
                launch_id=route.get("launch_id"),
                allowed_launch_ids=(
                    set(route.get("scene_launch_ids"))
                    if route.get("scene_launch_ids") is not None else None
                ),
                expected_window_id=expected.get("hit_test_window_id"),
                hit_override=prepared_hit,
            )
            if current_hit_test != expected_hit_test:
                raise ToolError("compositor input-region identity changed")
        except (ToolError, RuntimeError) as error:
            raise PointerRouteTransition(
                "compositor input-region ownership changed; no further pointer unit was emitted"
            ) from error

    @staticmethod
    def _assert_modified_pointer_target(
        route: dict[str, Any],
        keyboard_target: dict[str, Any],
    ) -> None:
        """Keep modifier authority on the exact focused pointer target.

        A modifier is seat-global input, while a pointer coordinate is routed by
        the compositor.  Requiring the observed active top-level to be the sole
        routed top-level prevents a Ctrl/Shift/Alt/Super hold from silently
        affecting a different application.  A LaunchSceneSeal may legitimately
        target an xdg_popup which has no independent Sway container; in that
        case the active top-level must still belong to the exact launch.
        """
        target_window = keyboard_target.get("window_id")
        target_ids = route.get("target_window_ids")
        if not isinstance(target_window, int) or not isinstance(target_ids, list):
            raise ToolError("modified pointer gesture target authority is malformed")
        route_scope = route.get("route_scope", "top-level")
        if target_ids:
            if set(target_ids) != {target_window}:
                raise ToolError(
                    "modified pointer input requires the pointer route to remain inside the exact active top-level; "
                    "focus the intended window and obtain a fresh observation first"
                )
        elif route_scope != "launch-scene":
            raise ToolError("modified pointer input has no exact active top-level route")
        if route_scope == "launch-scene" and keyboard_target.get("launch_id") != route.get("launch_id"):
            raise ToolError("modified popup pointer input is not owned by the active launch")
        scene_launch_ids = route.get("scene_launch_ids")
        if scene_launch_ids is not None and keyboard_target.get("launch_id") not in set(scene_launch_ids):
            raise ToolError("modified pointer target is not an active member of the exact scene-set")

    @staticmethod
    def _seat_capability_for(input_type: str) -> int:
        if input_type == "pointer":
            return SWAY_SEAT_POINTER_CAPABILITY
        if input_type == "keyboard":
            return SWAY_SEAT_KEYBOARD_CAPABILITY
        raise ToolError("SeatSeal received an unsupported virtual-input type")

    @staticmethod
    def _assert_seat_baseline(snapshot: dict[str, Any]) -> None:
        if (
            snapshot.get("schema") != SEAT_SEAL_SCHEMA
            or snapshot.get("enforced") is not True
            or snapshot.get("seat_name") != "seat0"
            or snapshot.get("capabilities") != 0
            or snapshot.get("device_count") != 0
            or snapshot.get("device_type_counts") != {}
            or snapshot.get("device_identity_sha256") != []
        ):
            raise ToolError("SeatSeal startup baseline is not an empty one-seat private workstation")
        digest = snapshot.get("inventory_sha256")
        if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
            raise ToolError("SeatSeal startup baseline digest is invalid")

    def _seat_transaction_started(self, input_type: str, purpose: str) -> dict[str, Any]:
        seal = self.compositor_event_seal
        baseline = self.seat_baseline
        if seal is None or baseline is None:
            raise ToolError("SeatSeal is unavailable for a native Wayland input transaction")
        expected_capability = self._seat_capability_for(input_type)
        try:
            snapshot = seal.seat_snapshot()
            identities = snapshot.get("device_identity_sha256")
            if (
                snapshot.get("seat_name") != "seat0"
                or snapshot.get("capabilities") != expected_capability
                or snapshot.get("device_count") != 1
                or snapshot.get("device_type_counts") != {input_type: 1}
                or not isinstance(identities, list)
                or len(identities) != 1
                or not isinstance(identities[0], str)
                or re.fullmatch(r"[0-9a-f]{64}", identities[0]) is None
            ):
                raise ToolError(
                    f"SeatSeal expected exactly one active {input_type} device and no other seat capability"
                )
            receipt = {
                "schema": SEAT_SEAL_SCHEMA,
                "phase": "transaction-start",
                "expected_input_type": input_type,
                "expected_capability": expected_capability,
                "purpose_sha256": hashlib.sha256(purpose.encode("utf-8", "replace")).hexdigest(),
                "baseline_inventory_sha256": baseline.get("inventory_sha256"),
                "active_inventory_sha256": snapshot.get("inventory_sha256"),
                "active_device_identity_sha256": identities[0],
                "cross_checked_views": snapshot.get("cross_checked_views"),
                "peer_authentication": snapshot.get("peer_authentication"),
            }
            self.seat_lifecycle_checks += 1
            self.last_seat_lifecycle_receipt = receipt
            return receipt
        except Exception as error:
            self.seat_lifecycle_failures += 1
            reason = f"SeatSeal rejected virtual-{input_type} activation: {error}"
            if input_type == "pointer":
                self._quarantine_pointer(reason)
            elif input_type == "keyboard":
                self._quarantine_keyboard(reason)
            raise

    def _seat_transaction_stopped(
        self,
        input_type: str,
        purpose: str,
        start_receipt: dict[str, Any] | None,
    ) -> dict[str, Any]:
        seal = self.compositor_event_seal
        baseline = self.seat_baseline
        if seal is None or baseline is None:
            raise ToolError("SeatSeal is unavailable during virtual-input teardown")
        try:
            if (
                not isinstance(start_receipt, dict)
                or start_receipt.get("schema") != SEAT_SEAL_SCHEMA
                or start_receipt.get("phase") != "transaction-start"
                or start_receipt.get("expected_input_type") != input_type
            ):
                raise ToolError("SeatSeal transaction-start receipt is unavailable or inconsistent")
            snapshot = seal.seat_snapshot()
            self._assert_seat_baseline(snapshot)
            baseline_digest = baseline.get("inventory_sha256")
            if not isinstance(baseline_digest, str) or not hmac.compare_digest(
                str(snapshot.get("inventory_sha256")), baseline_digest
            ):
                raise ToolError("SeatSeal did not restore the exact startup device inventory")
            receipt = {
                "schema": SEAT_SEAL_SCHEMA,
                "phase": "transaction-stop",
                "expected_input_type": input_type,
                "purpose_sha256": hashlib.sha256(purpose.encode("utf-8", "replace")).hexdigest(),
                "baseline_inventory_sha256": baseline_digest,
                "restored_inventory_sha256": snapshot.get("inventory_sha256"),
                "removed_device_identity_sha256": start_receipt.get(
                    "active_device_identity_sha256"
                ),
                "device_count": snapshot.get("device_count"),
                "capabilities": snapshot.get("capabilities"),
                "cross_checked_views": snapshot.get("cross_checked_views"),
                "peer_authentication": snapshot.get("peer_authentication"),
            }
            self.seat_lifecycle_checks += 1
            self.last_seat_lifecycle_receipt = receipt
            return receipt
        except Exception:
            self.seat_lifecycle_failures += 1
            raise

    def _seat_transaction_joined(
        self,
        input_type: str,
        purpose: str,
        companion_receipt: dict[str, Any],
    ) -> dict[str, Any]:
        """Prove one second virtual device joined one exact active companion.

        Modified pointer gestures need a virtual keyboard to keep a reviewed
        modifier mask held while a separate virtual pointer emits the gesture.
        SeatSeal permits that overlap only through this set-difference receipt:
        the pre-existing device identity must survive unchanged and exactly one
        device of the requested type may appear.
        """
        seal = self.compositor_event_seal
        baseline = self.seat_baseline
        if seal is None or baseline is None:
            raise ToolError("SeatSeal is unavailable for a compound native Wayland input transaction")
        try:
            if (
                not isinstance(companion_receipt, dict)
                or companion_receipt.get("schema") != SEAT_SEAL_SCHEMA
                or companion_receipt.get("phase") != "transaction-start"
            ):
                raise ToolError("SeatSeal companion transaction receipt is unavailable or inconsistent")
            companion_type = companion_receipt.get("expected_input_type")
            companion_identity = companion_receipt.get("active_device_identity_sha256")
            if (
                companion_type not in {"pointer", "keyboard"}
                or companion_type == input_type
                or not isinstance(companion_identity, str)
                or re.fullmatch(r"[0-9a-f]{64}", companion_identity) is None
            ):
                raise ToolError("SeatSeal companion device identity is invalid")
            expected_capability = self._seat_capability_for(input_type)
            companion_capability = self._seat_capability_for(companion_type)
            snapshot = seal.seat_snapshot()
            identities = snapshot.get("device_identity_sha256")
            expected_counts = {input_type: 1, companion_type: 1}
            if (
                snapshot.get("seat_name") != "seat0"
                or snapshot.get("capabilities") != (expected_capability | companion_capability)
                or snapshot.get("device_count") != 2
                or snapshot.get("device_type_counts") != expected_counts
                or not isinstance(identities, list)
                or len(identities) != 2
                or any(
                    not isinstance(identity, str)
                    or re.fullmatch(r"[0-9a-f]{64}", identity) is None
                    for identity in identities
                )
                or companion_identity not in identities
            ):
                raise ToolError(
                    "SeatSeal expected one exact companion and one newly joined virtual-input device"
                )
            new_identities = [identity for identity in identities if identity != companion_identity]
            if len(new_identities) != 1:
                raise ToolError("SeatSeal could not isolate the newly joined virtual-input identity")
            receipt = {
                "schema": SEAT_SEAL_SCHEMA,
                "phase": "transaction-join",
                "expected_input_type": input_type,
                "expected_capability": expected_capability,
                "companion_input_type": companion_type,
                "companion_capability": companion_capability,
                "purpose_sha256": hashlib.sha256(purpose.encode("utf-8", "replace")).hexdigest(),
                "baseline_inventory_sha256": baseline.get("inventory_sha256"),
                "companion_inventory_sha256": companion_receipt.get("active_inventory_sha256"),
                "active_inventory_sha256": snapshot.get("inventory_sha256"),
                "active_device_identity_sha256": new_identities[0],
                "companion_device_identity_sha256": companion_identity,
                "active_device_identity_set_sha256": hashlib.sha256(
                    canonical_json(sorted(identities))
                ).hexdigest(),
                "cross_checked_views": snapshot.get("cross_checked_views"),
                "peer_authentication": snapshot.get("peer_authentication"),
            }
            self.seat_lifecycle_checks += 1
            self.last_seat_lifecycle_receipt = receipt
            return receipt
        except Exception as error:
            self.seat_lifecycle_failures += 1
            reason = f"SeatSeal rejected compound virtual-{input_type} activation: {error}"
            if input_type == "pointer":
                self._quarantine_pointer(reason)
            else:
                self._quarantine_keyboard(reason)
            raise

    def _seat_transaction_left(
        self,
        input_type: str,
        purpose: str,
        start_receipt: dict[str, Any] | None,
        companion_receipt: dict[str, Any],
    ) -> dict[str, Any]:
        """Prove one compound device left while its exact companion survived."""
        seal = self.compositor_event_seal
        if seal is None:
            raise ToolError("SeatSeal is unavailable during compound virtual-input teardown")
        try:
            if (
                not isinstance(start_receipt, dict)
                or start_receipt.get("schema") != SEAT_SEAL_SCHEMA
                or start_receipt.get("phase") != "transaction-join"
                or start_receipt.get("expected_input_type") != input_type
                or not isinstance(companion_receipt, dict)
                or companion_receipt.get("schema") != SEAT_SEAL_SCHEMA
                or companion_receipt.get("phase") != "transaction-start"
            ):
                raise ToolError("SeatSeal compound transaction receipts are unavailable or inconsistent")
            companion_type = start_receipt.get("companion_input_type")
            companion_identity = start_receipt.get("companion_device_identity_sha256")
            if (
                companion_type != companion_receipt.get("expected_input_type")
                or companion_identity != companion_receipt.get("active_device_identity_sha256")
                or not isinstance(companion_identity, str)
            ):
                raise ToolError("SeatSeal compound companion identity changed during the gesture")
            snapshot = seal.seat_snapshot()
            identities = snapshot.get("device_identity_sha256")
            companion_capability = self._seat_capability_for(str(companion_type))
            if (
                snapshot.get("seat_name") != "seat0"
                or snapshot.get("capabilities") != companion_capability
                or snapshot.get("device_count") != 1
                or snapshot.get("device_type_counts") != {companion_type: 1}
                or identities != [companion_identity]
            ):
                raise ToolError(
                    "SeatSeal did not restore the exact single companion device after compound teardown"
                )
            receipt = {
                "schema": SEAT_SEAL_SCHEMA,
                "phase": "transaction-leave",
                "expected_input_type": input_type,
                "companion_input_type": companion_type,
                "purpose_sha256": hashlib.sha256(purpose.encode("utf-8", "replace")).hexdigest(),
                "compound_inventory_sha256": start_receipt.get("active_inventory_sha256"),
                "restored_companion_inventory_sha256": snapshot.get("inventory_sha256"),
                "removed_device_identity_sha256": start_receipt.get(
                    "active_device_identity_sha256"
                ),
                "surviving_device_identity_sha256": companion_identity,
                "device_count": snapshot.get("device_count"),
                "capabilities": snapshot.get("capabilities"),
                "cross_checked_views": snapshot.get("cross_checked_views"),
                "peer_authentication": snapshot.get("peer_authentication"),
            }
            self.seat_lifecycle_checks += 1
            self.last_seat_lifecycle_receipt = receipt
            return receipt
        except Exception:
            self.seat_lifecycle_failures += 1
            raise

    def _seat_seal_status(self) -> dict[str, Any] | None:
        if not self.is_wayland:
            return None
        baseline = getattr(self, "seat_baseline", None)
        return {
            "schema": SEAT_SEAL_SCHEMA,
            "enforced": baseline is not None,
            "policy": (
                "one-seat+empty-baseline+exact-one-device-start+event-identity-binding+"
                "explicit-destroy-roundtrip+exact-baseline-restore"
            ),
            "inventory_sources": ["Sway GET_SEATS.devices", "Sway GET_INPUTS"],
            "inventory_cross_check": "same-authenticated-command-connection+fail-closed-on-disagreement",
            "lifecycle_event_binding": (
                "guarded-actions-exact-input-added+removed-identity-match"
            ),
            "teardown_proof": "helper-destroy+Wayland-roundtrip+exact-baseline-digest",
            "compound_modifier_gestures": True,
            "compound_maximum_devices": 2,
            "compound_device_order": ["keyboard", "pointer"],
            "compound_teardown_order": ["pointer", "modifier-clear", "keyboard"],
            "compound_policy": (
                "keyboard-first+exact-two-device-overlap+pointer-first-removal+"
                "modifier-clear+keyboard-removal+exact-baseline-restore"
            ),
            "companion_binding": (
                "transaction-start-receipt+exact-surviving-identity+"
                "inventory-set-difference"
            ),
            "failure_policy": "input-controller-quarantine+compositor-seal-fail-closed",
            "baseline_inventory_sha256": (
                baseline.get("inventory_sha256") if isinstance(baseline, dict) else None
            ),
            "baseline_device_count": (
                baseline.get("device_count") if isinstance(baseline, dict) else None
            ),
            "lifecycle_checks": int(getattr(self, "seat_lifecycle_checks", 0)),
            "lifecycle_failures": int(getattr(self, "seat_lifecycle_failures", 0)),
            "last_receipt": getattr(self, "last_seat_lifecycle_receipt", None),
        }

    def _quarantine_pointer(self, reason: str, *, release_failure: bool = False) -> None:
        self.pointer_quarantined = True
        self.pointer_quarantine_reason = reason[:512]
        if release_failure:
            self.pointer_release_failures = int(getattr(self, "pointer_release_failures", 0)) + 1
        journal = getattr(self, "journal", None)
        if journal is not None:
            with contextlib.suppress(Exception):
                journal.append(
                    "pointer-quarantine",
                    "desktop-pointer",
                    {"pressed_button": getattr(self, "pointer_pressed_button", None)},
                    {
                        "quarantined": True,
                        "reason": self.pointer_quarantine_reason,
                        "release_failures": self.pointer_release_failures,
                    },
                )
        with contextlib.suppress(Exception):
            self.write_status("ready", error=f"pointer controller quarantined: {self.pointer_quarantine_reason}")

    def _require_pointer_healthy(self) -> None:
        if getattr(self, "pointer_quarantined", False):
            reason = getattr(self, "pointer_quarantine_reason", None) or "unknown pointer state"
            raise ToolError(
                f"private pointer controller is quarantined until desktop restart: {reason}"
            )

