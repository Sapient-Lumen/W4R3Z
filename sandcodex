class NotificationError(RuntimeError):
    """A bounded caller error safe to return on the launch-private bus."""


@dataclass(frozen=True)
class NotificationSpec:
    sender: str
    app_name: str
    app_icon: str
    summary: str
    body: str
    actions: tuple[tuple[str, str], ...]
    urgency: int
    expire_milliseconds: int | None

    @property
    def default_action(self) -> str | None:
        for key, _label in self.actions:
            if key == "default":
                return key
        return None

    @property
    def visible_actions(self) -> tuple[tuple[str, str], ...]:
        return tuple(item for item in self.actions if item[0] != "default")


def _utf8_text(
    value: Any,
    label: str,
    maximum: int,
    *,
    allow_empty: bool = True,
    multiline: bool = False,
) -> str:
    if not isinstance(value, str):
        raise NotificationError(f"{label} must be a string")
    encoded = value.encode("utf-8", "strict")
    if len(encoded) > maximum:
        raise NotificationError(f"{label} exceeds its byte limit")
    if not allow_empty and not value:
        raise NotificationError(f"{label} must not be empty")
    for character in value:
        if multiline and character in {"\n", "\t"}:
            continue
        # Reject every Unicode control/format/surrogate code point, not just
        # ASCII C0/DEL.  In particular, bidi overrides and isolates must not
        # visually reorder an untrusted action label or summary into a false
        # desktop instruction.
        if unicodedata.category(character) in {"Cc", "Cf", "Cs"}:
            raise NotificationError(f"{label} contains a control character")
    return value


def _parse_actions(value: Any) -> tuple[tuple[str, str], ...]:
    if not isinstance(value, (list, tuple)):
        raise NotificationError("actions must be an array")
    if len(value) % 2:
        raise NotificationError("actions must contain key/label pairs")
    if len(value) // 2 > MAX_ACTIONS:
        raise NotificationError("actions exceed the action-count limit")
    result: list[tuple[str, str]] = []
    seen: set[str] = set()
    for index in range(0, len(value), 2):
        key = _utf8_text(
            value[index],
            f"actions[{index}]",
            MAX_ACTION_KEY_BYTES,
            allow_empty=False,
        )
        if ACTION_KEY_RE.fullmatch(key) is None:
            raise NotificationError(f"actions[{index}] is not a canonical action key")
        if key in seen:
            raise NotificationError("actions contain a duplicate key")
        label = _utf8_text(
            value[index + 1],
            f"actions[{index + 1}]",
            MAX_ACTION_LABEL_BYTES,
            allow_empty=False,
            multiline=False,
        )
        seen.add(key)
        result.append((key, label))
    return tuple(result)


def _parse_hints(value: Any) -> int:
    if not isinstance(value, dict) or len(value) > MAX_HINTS:
        raise NotificationError("hints must be a bounded dictionary")
    urgency = 1
    if "urgency" in value:
        raw = value["urgency"]
        # PyGObject normally recursively unpacks a{sv}, but older bindings can
        # retain the inner byte as one GLib.Variant.  Accept only a scalar
        # integer variant here; every other hint remains ignored and receives
        # no authority.
        variant_type = getattr(raw, "get_type_string", None)
        variant_unpack = getattr(raw, "unpack", None)
        if callable(variant_type) and callable(variant_unpack):
            if variant_type() != "y":
                raise NotificationError("hints.urgency must be one D-Bus byte")
            raw = variant_unpack()
        if isinstance(raw, bool) or not isinstance(raw, int) or raw not in {0, 1, 2}:
            raise NotificationError("hints.urgency must be 0, 1, or 2")
        urgency = raw
    return urgency


def _parse_expire_timeout(value: Any) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int):
        raise NotificationError("expire_timeout must be an integer")
    if value < -1:
        raise NotificationError("expire_timeout is invalid")
    if value == 0:
        return None
    if value == -1:
        return DEFAULT_EXPIRE_MILLISECONDS
    return min(value, MAX_EXPIRE_MILLISECONDS)


def _parse_notification(
    sender: Any,
    app_name: Any,
    app_icon: Any,
    summary: Any,
    body: Any,
    actions: Any,
    hints: Any,
    expire_timeout: Any,
) -> NotificationSpec:
    sender_text = _utf8_text(sender, "sender", 512, allow_empty=False)
    if not sender_text.startswith(":"):
        raise NotificationError("sender must be one private-bus unique name")
    app_name_text = _utf8_text(app_name, "app_name", MAX_APP_NAME_BYTES)
    summary_text = _utf8_text(
        summary,
        "summary",
        MAX_SUMMARY_BYTES,
        multiline=False,
    )
    body_text = _utf8_text(body, "body", MAX_BODY_BYTES, multiline=True)
    if not summary_text and not body_text:
        raise NotificationError("summary and body must not both be empty")
    return NotificationSpec(
        sender=sender_text,
        app_name=app_name_text,
        app_icon=_utf8_text(app_icon, "app_icon", MAX_ICON_NAME_BYTES),
        summary=summary_text,
        body=body_text,
        actions=_parse_actions(actions),
        urgency=_parse_hints(hints),
        expire_milliseconds=_parse_expire_timeout(expire_timeout),
    )


def _select_identifier(
    active_owners: Mapping[int, str],
    replaces_id: Any,
    sender: str,
    allocate: Callable[[], int],
) -> tuple[int, bool]:
    """Resolve Notify replacement semantics without crossing sender custody.

    The Desktop Notifications specification requires a non-zero ``replaces_id``
    to be returned unchanged, even when the referenced notification is no longer
    active.  An active identifier owned by another private-bus sender is the one
    case we reject: one client must never rewrite another client's retained UI.
    The boolean result reports whether an existing same-sender notification must
    be updated in place.
    """
    if isinstance(replaces_id, bool) or not isinstance(replaces_id, int):
        raise NotificationError("replaces_id must be an unsigned integer")
    if not 0 <= replaces_id <= 0xFFFFFFFF:
        raise NotificationError("replaces_id is outside uint32")
    if replaces_id == 0:
        return allocate(), False
    owner = active_owners.get(replaces_id)
    if owner is not None and owner != sender:
        raise NotificationError("notification replacement crossed a sender boundary")
    return replaces_id, owner is not None


def _harden_process() -> None:
    """Apply the same cheap process-hardening used by the private portal."""
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    resource.setrlimit(resource.RLIMIT_NOFILE, (128, 128))
    libc = ctypes.CDLL(None, use_errno=True)
    prctl = libc.prctl
    prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
    prctl.restype = ctypes.c_int
    PR_SET_PDEATHSIG = 1
    PR_SET_DUMPABLE = 4
    PR_SET_NO_NEW_PRIVS = 38
    if prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0) != 0:
        raise RuntimeError("could not bind notification service lifetime to its supervisor")
    if os.getppid() == 1:
        raise RuntimeError("notification service supervisor disappeared during startup")
    if prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) != 0:
        raise RuntimeError("could not disable notification service dumps")
    if prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise RuntimeError("could not enable notification service no-new-privileges")


def _file_fingerprint(info: os.stat_result) -> tuple[int, ...]:
    """Return the descriptor identity/custody fields relevant to secret reads."""
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def _write_ready(
    path: Path,
    launch_id: str,
    application_id: str,
    instance_token: str,
    surface_app_id: str,
) -> None:
    # The helper lives in a private PID namespace, so its namespace-local PID is
    # not equal to the outer bubblewrap PID supervised by the launcher.  Bind
    # readiness with a launch-random bearer value while the launcher separately
    # proves that the exact outer helper process remains live.
    if not INSTANCE_TOKEN_RE.fullmatch(instance_token):
        raise RuntimeError("invalid notification readiness instance token")
    if not LAUNCH_ID_RE.fullmatch(launch_id):
        raise RuntimeError("invalid notification readiness launch identity")
    if not APP_ID_RE.fullmatch(application_id):
        raise RuntimeError("invalid notification readiness application identity")
    if not APP_ID_RE.fullmatch(surface_app_id) or not surface_app_id.startswith(
        WINDOW_APP_ID_PREFIX
    ):
        raise RuntimeError("invalid notification readiness surface identity")
    encoded_path = os.fsencode(path)
    if not encoded_path or len(encoded_path) > MAX_READY_PATH_BYTES:
        raise RuntimeError("notification readiness path is invalid")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        line = (
            f"{PROTOCOL} instance_token={instance_token} launch_id={launch_id} "
            f"application_id={application_id} surface_app_id={surface_app_id} "
            f"bus={BUS_NAME} capabilities={','.join(CAPABILITIES)} "
            f"maximum_active={MAX_ACTIVE_NOTIFICATIONS}\n"
        ).encode("ascii")
        view = memoryview(line)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise RuntimeError("notification readiness write failed")
            view = view[written:]
        os.fsync(descriptor)
        info = os.fstat(descriptor)
        expected = len(line)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
            or info.st_size != expected
        ):
            raise RuntimeError("notification readiness receipt has unsafe custody")
        if _file_fingerprint(info) != _file_fingerprint(os.fstat(descriptor)):
            raise RuntimeError("notification readiness receipt changed during creation")
    finally:
        os.close(descriptor)


def _read_secret_token(
    path: Path,
    *,
    label: str,
    expression: re.Pattern[str],
) -> str:
    encoded_path = os.fsencode(path)
    if not encoded_path or len(encoded_path) > MAX_INSTANCE_TOKEN_PATH_BYTES:
        raise RuntimeError(f"notification {label} path is invalid")
    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            raise RuntimeError(f"notification {label} is not a regular file")
        if (
            before.st_uid != os.getuid()
            or stat.S_IMODE(before.st_mode) != 0o400
            or before.st_nlink != 1
        ):
            raise RuntimeError(f"notification {label} has unsafe custody")
        # The outer launcher always emits one canonical 32-byte lowercase-hex
        # capability plus a final newline.  Requiring the delimiter prevents
        # accepting a valid prefix while another writer is still completing
        # the handoff file.
        if before.st_size != 33:
            raise RuntimeError(f"notification {label} has an invalid size")
        payload = bytearray()
        while len(payload) < 33:
            chunk = os.read(descriptor, 33 - len(payload))
            if not chunk:
                raise RuntimeError(f"notification {label} is truncated")
            payload.extend(chunk)
        if os.read(descriptor, 1):
            raise RuntimeError(f"notification {label} exceeds its bound")
        after = os.fstat(descriptor)
        if _file_fingerprint(before) != _file_fingerprint(after):
            raise RuntimeError(f"notification {label} changed during descriptor read")
    finally:
        os.close(descriptor)
    if payload[-1:] != b"\n":
        raise RuntimeError(f"notification {label} lacks its final delimiter")
    try:
        token = bytes(payload[:-1]).decode("ascii")
    except UnicodeDecodeError as error:
        raise RuntimeError(f"notification {label} is not ASCII") from error
    if expression.fullmatch(token) is None:
        raise RuntimeError(f"invalid notification {label}")
    return token


def _read_instance_token(path: Path) -> str:
    return _read_secret_token(
        path,
        label="instance token",
        expression=INSTANCE_TOKEN_RE,
    )


def _read_surface_token(path: Path) -> str:
    return _read_secret_token(
        path,
        label="surface token",
        expression=SURFACE_TOKEN_RE,
    )


def _surface_app_id(surface_token: str) -> str:
    if SURFACE_TOKEN_RE.fullmatch(surface_token) is None:
        raise RuntimeError("invalid notification surface token")
    app_id = WINDOW_APP_ID_PREFIX + surface_token
    if APP_ID_RE.fullmatch(app_id) is None:
        raise RuntimeError("notification surface identity is not representable")
    return app_id


def _self_test() -> int:
    specimen = _parse_notification(
        ":1.42",
