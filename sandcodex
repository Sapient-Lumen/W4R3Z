    if [[ "$kind" == project ]]; then
      (( project_selected == 0 )) || continue
      project_selected=1; project_manifest="$manifest"; SC_BROWSER_PROJECT_EXTENSION="$canonical"
    elif [[ -n "$SC_BROWSER_BUNDLE_EXTENSION" && "$canonical" == "$SC_BROWSER_BUNDLE_EXTENSION" && \
