class CompositorClickGrant:
    """Private one-shot compositor authority; its raw ticket is never printable.

    Python strings cannot be reliably zeroized. The ticket therefore remains
    reachable only through this short-lived holder, is removed exactly once
    before cancellation or dispatch, and is never placed in routes, evidence,
    status, exceptions, audit records, or object representations.
    """

    __slots__ = (
        "x", "y", "target", "grant_sha256", "ticket_authority_sha256",
        "_ticket", "_consumed",
    )

    def __init__(
        self,
        *,
        x: int,
        y: int,
        ticket: str,
        target: dict[str, Any],
        grant_sha256: str,
        ticket_authority_sha256: str,
    ) -> None:
        self.x = x
        self.y = y
        self.target = dict(target)
        self.grant_sha256 = grant_sha256
        self.ticket_authority_sha256 = ticket_authority_sha256
        self._ticket: str | None = ticket
        self._consumed = False

    def take_ticket(self) -> str:
        if self._consumed or self._ticket is None:
            raise RuntimeError("compositor click grant is already consumed")
        ticket = self._ticket
        self._ticket = None
        self._consumed = True
        return ticket

    @property
    def consumed(self) -> bool:
        return self._consumed

    def __repr__(self) -> str:
        return (
            "CompositorClickGrant("
            f"x={self.x}, y={self.y}, grant_sha256={self.grant_sha256!r}, "
            f"ticket=<redacted>, consumed={self._consumed!r})"
        )


