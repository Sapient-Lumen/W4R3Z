FILE_COPY_STARTUP_RECOVERY_SCHEMA = "sandcodex.file-copy-startup-recovery.v1"

MAX_FILE_COPY_STARTUP_RECLAIMS = 64

_PENDING_COPY = re.compile(r"\.copy-[0-9a-f]{32}\.pending")

def sc_recover_file_copy_staging(controller: Any) -> dict[str, object]:
    """Preflight then remove only exact controller-created pending transactions.

    The caller is expected to hold Sandcodex's exclusive project launch lock.
    Every entry is validated before any deletion begins.  Completed exports are
    outside ``.copy-staging`` and are never inspected or modified here.
    """
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    if not nofollow or not hasattr(os, "O_DIRECTORY"):
        raise RuntimeError("FileCopySeal startup recovery has no descriptor no-follow boundary")
    directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
    output_fd: int | None = None
    staging_fd: int | None = None
    try:
        output_fd = os.open(controller.output, directory_flags)
        output_info = os.fstat(output_fd)
        if (
            not stat.S_ISDIR(output_info.st_mode)
            or output_info.st_uid != os.geteuid()
            or stat.S_IMODE(output_info.st_mode) != 0o700
        ):
            raise RuntimeError("FileCopySeal output root is unsafe during startup recovery")
        output_mount = controller._descriptor_mount_id(
            output_fd, "FileCopySeal startup recovery output"
        )
        try:
            staging_fd = os.open(".copy-staging", directory_flags, dir_fd=output_fd)
        except FileNotFoundError:
            # A first controller start can legitimately precede the launcher's
            # creation of this optional transaction directory.  Absence is the
            # strongest possible clean state; do not create authority here.
            return {
                "schema": FILE_COPY_STARTUP_RECOVERY_SCHEMA,
                "status": "clean",
                "scanned_transactions": 0,
                "reclaimed_transactions": 0,
                "completed_exports_touched": False,
                "source_paths_retained": False,
                "automatic_retry": False,
            }
        except OSError as error:
            raise RuntimeError("FileCopySeal startup staging could not be opened safely") from error
        staging_info = os.fstat(staging_fd)
        staging_mount = controller._descriptor_mount_id(
            staging_fd, "FileCopySeal startup recovery staging"
        )
        if (
            not stat.S_ISDIR(staging_info.st_mode)
            or staging_info.st_uid != os.geteuid()
            or stat.S_IMODE(staging_info.st_mode) != 0o700
            or staging_info.st_dev != output_info.st_dev
            or staging_mount != output_mount
        ):
            raise RuntimeError("FileCopySeal startup staging directory is unsafe")
        try:
            with os.scandir(staging_fd) as iterator:
                names = sorted((entry.name for entry in iterator), key=os.fsencode)
        except OSError as error:
            raise RuntimeError("FileCopySeal startup staging could not be enumerated") from error
        if len(names) > MAX_FILE_COPY_STARTUP_RECLAIMS:
            raise RuntimeError("FileCopySeal startup recovery exceeds its transaction ceiling")
        # Fail before deleting anything when one unexpected or unsafe entry is
        # present.  This avoids partially interpreting a directory whose shape
        # no longer matches the controller-created transaction contract.
        for name in names:
            if _PENDING_COPY.fullmatch(name) is None:
                raise RuntimeError("FileCopySeal startup staging contains an unexpected entry")
            try:
                info = os.stat(name, dir_fd=staging_fd, follow_symlinks=False)
            except OSError as error:
                raise RuntimeError("FileCopySeal startup transaction could not be inspected") from error
            if (
                not stat.S_ISDIR(info.st_mode)
                or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700
                or info.st_dev != staging_info.st_dev
            ):
                raise RuntimeError("FileCopySeal startup transaction is unsafe")
        for name in names:
            controller._remove_file_copy_tree(staging_fd, name)
        if names:
            try:
                os.fsync(staging_fd)
                os.fsync(output_fd)
            except OSError as error:
                raise RuntimeError("FileCopySeal startup recovery could not be synchronized") from error
        return {
            "schema": FILE_COPY_STARTUP_RECOVERY_SCHEMA,
            "status": "reclaimed" if names else "clean",
            "scanned_transactions": len(names),
            "reclaimed_transactions": len(names),
            "completed_exports_touched": False,
            "source_paths_retained": False,
            "automatic_retry": False,
        }
    finally:
        if staging_fd is not None:
            try:
                os.close(staging_fd)
            except OSError:
                pass
        if output_fd is not None:
            try:
                os.close(output_fd)
            except OSError:
                pass


class DesktopController:
