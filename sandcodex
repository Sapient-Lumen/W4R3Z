  sc_ensure_dir "$SC_GLOBAL/browser" "trusted browser state"
  sc_ensure_dir "$SC_GLOBAL/browser/profiles" "persistent browser profiles"
  sc_ensure_dir "$SC_GLOBAL/campaigns" "trusted campaign state"
  sc_ensure_dir "$SC_GLOBAL/campaign-home" "campaign engine home"
  sc_ensure_dir "$SC_GLOBAL/campaign-engines" "versioned campaign engines"
  sc_ensure_dir "$SC_GLOBAL/campaign-launchers" "versioned campaign launchers"
  sc_ensure_dir "$SC_GLOBAL/operator-active" "active operator-service locators"
  sc_ensure_dir "$SC_GLOBAL/publish-active" "active publication locators"
  SC_CAMPAIGN_ENGINE_HOME="$SC_GLOBAL/campaign-home"
  SC_CAMPAIGN_WORKER_GLOBAL="$SC_GLOBAL"
