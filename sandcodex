+static bool sandcodex_stylus_initialize(struct sway_seat *seat) {
+    if (sandcodex_stylus.attempted) {
+        return sandcodex_stylus.initialized && seat && seat->wlr_seat &&
+            sandcodex_stylus.seat == seat->wlr_seat;
+    }
+    sandcodex_stylus.attempted = true;
+    if (!seat || !seat->wlr_seat || !server.tablet_v2) {
+        return false;
+    }
+
+    wlr_tablet_init(&sandcodex_stylus.tablet,
+        &sandcodex_stylus_tablet_impl, "sandcodex-private-stylus");
+    sandcodex_stylus.tablet.usb_vendor_id = 0;
+    sandcodex_stylus.tablet.usb_product_id = 0;
+    sandcodex_stylus.tablet.width_mm = 0;
+    sandcodex_stylus.tablet.height_mm = 0;
+
+    sandcodex_stylus_native_tool_initialize(&sandcodex_stylus.tool,
+        WLR_TABLET_TOOL_TYPE_PEN, UINT64_C(0x53414E44434F4445));
+    sandcodex_stylus_native_tool_initialize(&sandcodex_stylus.eraser_tool,
+        WLR_TABLET_TOOL_TYPE_ERASER, UINT64_C(0x4552415345523031));
+    wlr_tablet_pad_init(&sandcodex_stylus.pad,
+        &sandcodex_stylus_pad_impl, "sandcodex-private-tablet-pad");
+    sandcodex_stylus.pad.button_count = 1;
+    sandcodex_stylus.pad.ring_count = 1;
+    sandcodex_stylus.pad.strip_count = 1;
+    wl_list_init(&sandcodex_stylus.pad_group.link);
+    sandcodex_stylus.pad_group.button_count = 1;
+    sandcodex_stylus.pad_group_buttons[0] = SANDCODEX_TABLET_PAD_BUTTON_INDEX;
+    sandcodex_stylus.pad_group.buttons = sandcodex_stylus.pad_group_buttons;
+    sandcodex_stylus.pad_group.ring_count = 1;
+    sandcodex_stylus.pad_group_rings[0] = SANDCODEX_TABLET_PAD_RING_INDEX;
+    sandcodex_stylus.pad_group.rings = sandcodex_stylus.pad_group_rings;
+    sandcodex_stylus.pad_group.strip_count = 1;
+    sandcodex_stylus.pad_group_strips[0] = SANDCODEX_TABLET_PAD_STRIP_INDEX;
+    sandcodex_stylus.pad_group.strips = sandcodex_stylus.pad_group_strips;
+    sandcodex_stylus.pad_group.mode_count = SANDCODEX_TABLET_PAD_MODE_COUNT;
+    wl_list_insert(&sandcodex_stylus.pad.groups,
+        &sandcodex_stylus.pad_group.link);
+
+    sandcodex_stylus.tablet_v2 = wlr_tablet_create(server.tablet_v2,
+        seat->wlr_seat, &sandcodex_stylus.tablet.base);
+    if (!sandcodex_stylus.tablet_v2) {
+        wlr_tablet_pad_finish(&sandcodex_stylus.pad);
+        wlr_tablet_finish(&sandcodex_stylus.tablet);
+        return false;
+    }
+    sandcodex_stylus.tool_v2 = wlr_tablet_tool_create(server.tablet_v2,
+        seat->wlr_seat, &sandcodex_stylus.tool);
+    if (!sandcodex_stylus.tool_v2) {
+        /* The tablet-v2 object listens to the input-device destroy signal.
+         * Finishing the synthetic tablet therefore tears down the partially
+         * published tablet before this permanent fail-closed path returns. */
+        wlr_tablet_finish(&sandcodex_stylus.tablet);
+        wlr_tablet_pad_finish(&sandcodex_stylus.pad);
+        sandcodex_stylus.tablet_v2 = NULL;
+        return false;
+    }
+    sandcodex_stylus.eraser_tool_v2 = wlr_tablet_tool_create(server.tablet_v2,
+        seat->wlr_seat, &sandcodex_stylus.eraser_tool);
+    if (!sandcodex_stylus.eraser_tool_v2) {
+        /* The published pen is separately destroy-watched by tablet-v2. Revoke
+         * it before the tablet so an incomplete dual-tool cohort can never be
+         * accepted by an already connected client. */
+        wl_signal_emit_mutable(&sandcodex_stylus.tool.events.destroy,
+            &sandcodex_stylus.tool);
+        wlr_tablet_pad_finish(&sandcodex_stylus.pad);
+        wlr_tablet_finish(&sandcodex_stylus.tablet);
+        sandcodex_stylus.tool_v2 = NULL;
+        sandcodex_stylus.tablet_v2 = NULL;
+        return false;
+    }
+    sandcodex_stylus.pad_v2 = wlr_tablet_pad_create(server.tablet_v2,
+        seat->wlr_seat, &sandcodex_stylus.pad.base);
+    if (!sandcodex_stylus.pad_v2) {
+        wl_signal_emit_mutable(&sandcodex_stylus.eraser_tool.events.destroy,
+            &sandcodex_stylus.eraser_tool);
+        wl_signal_emit_mutable(&sandcodex_stylus.tool.events.destroy,
+            &sandcodex_stylus.tool);
+        wlr_tablet_pad_finish(&sandcodex_stylus.pad);
+        wlr_tablet_finish(&sandcodex_stylus.tablet);
+        sandcodex_stylus.eraser_tool_v2 = NULL;
+        sandcodex_stylus.tool_v2 = NULL;
+        sandcodex_stylus.tablet_v2 = NULL;
+        return false;
+    }
+    sandcodex_stylus.seat = seat->wlr_seat;
+    sandcodex_stylus.generation = 1;
+    sandcodex_stylus.initialized = true;
+    return true;
+}
