    "  cooldowns   keys=\((.cooldowns.keys // {})|length) · models=\((.cooldowns.models // {})|length)",
    "  secrets     credential values hidden",
    (if .provider_mode == "gemini" then
      "  failover    pre-output key rotation=" + (if .capabilities.quota_key_rotation then "yes" else "historical binding" end)
      + " · model fallback=" + (if .capabilities.pre_output_model_failover then "yes" else "no" end)
     else
      "  failover    fresh selection=" + (if .capabilities.automatic_selection then "automatic" else "fixed" end)
      + " · live turn switching=no"
     end),
    "",
    "next:",
    (if .commands.worker_doctor then "  workers      \(.commands.worker_doctor)" else empty end),
    "  continuity  \(.commands.continuity)",
    "  report      \(.commands.report)",
    (if .active_room then empty else "  launch      \(.commands.fresh_auto)" end),
    "",
    "limits:",
    "  - An already-running TUI is never silently retargeted.",
    "  - Visible partial output is never retracted or replayed.",
    "  - Use the report or continuity card for the full no-secret handoff."
  ' <<<"$result"
}

sc_ready_dispatch() {
  local result
  result="$(sc_ready_json)"
  jq -e '.schema=="sandcodex.ready.v1" and .credential_values_disclosed==false and
      .raw_provider_content_disclosed==false and
      (.capabilities.already_running_tui_retarget==false) and
      (.capabilities.transparent_visible_stream_replay==false) and
      (if .provider_mode=="gemini" then
        .capabilities.pre_output_key_failover==true and
        .capabilities.pre_output_auth_standby_promotion==true and
        (.capabilities.quota_key_rotation|type)=="boolean" and
        (.capabilities.account_start_policy|type)=="string" and
        (.capabilities.pending_tool_quota_key_rotation==.capabilities.quota_key_rotation) and
        .capabilities.pending_tool_model_failover==true and
        .capabilities.exact_cross_model_state_replay==true and
        .capabilities.transparent_mid_turn_failover==false
       else .capabilities.transparent_mid_turn_failover==false end)' \
    <<<"$result" >/dev/null || sc_die "ready helper produced invalid JSON" 78
  if (( SC_READY_JSON )); then
    printf '%s\n' "$result"
  else
    sc_ready_render "$result"
  fi
}

sc_active_ready_dispatch() {
  [[ "$(uname -s)" == Linux ]] || sc_die "Sandcodex currently supports Linux only"
  [[ "$(id -u)" != 0 ]] || sc_die "do not run as root"
  SC_HOST_PATH="${SANDCODEX_HOST_PATH-${PATH:-}}"
  SC_REAL_HOME="$(sc_find_home)"
  sc_no_line_breaks "$SC_REAL_HOME" "home directory"
  local global_requested="${SANDCODEX_GLOBAL_ROOT:-$SC_REAL_HOME/.sandstuff/sandcodex}"
  [[ "$global_requested" == /* ]] || sc_die "SANDCODEX_GLOBAL_ROOT must be absolute"
  sc_no_line_breaks "$global_requested" "global control root"
  global_requested="$(realpath -ms -- "$global_requested")"
  sc_no_line_breaks "$global_requested" "canonical global control root"
  sc_validate_global_root "$global_requested"
  sc_no_symlink_components "$global_requested" "global control root"
  SC_GLOBAL="$(realpath -m -- "$global_requested")"
  SC_PROJECT="${SANDCODEX_OUTER_PROJECT:-<active>}"
  if [[ "$SC_PROJECT" == /* && -d "$SC_PROJECT" ]]; then
    SC_PROJECT="$(realpath -- "$SC_PROJECT")"
    SC_PROJECT_KEY="$(printf '%s\0' "$SC_PROJECT" | sha256sum | awk '{print $1}')"
    SC_CONTROL="$SC_GLOBAL/projects/$SC_PROJECT_KEY"
  else
    SC_PROJECT='<active>'
    SC_PROJECT_KEY='<active>'
    SC_CONTROL=""
  fi
  SC_OPERATION=ready
  sc_global_state
  sc_ready_dispatch
}

sc_family_select_resume() {
  [[ "$SC_RESUME" == last || "$SC_RESUME" == id || "$SC_RESUME" == list ]] || return 0
  # GPT continuation belongs to Codex. In particular, do not put Sandcodex's
  # alternate-provider routing adapter in front of native multi-gigabyte
  # rollouts or the native interactive picker. Alternate providers must be
  # named explicitly so their immutable provider binding can be restored
  # before Codex starts.
  if [[ "$SC_PROVIDER_MODE" == gpt && -z "$SC_LOCAL_PROVIDER" && "$SC_RESUME" != id ]]; then
    return 0
  fi
  local selected provider mode rc=0 model history_detail picked picker_mode
  local -a args picker_args

  if [[ "$SC_RESUME" == list ]]; then
    # The picker sees only strict selector metadata. Its UUID is not trusted as final:
    # exact project reselection and alternate-provider binding verification follow.
    sc_family_install_session_tools
    picker_args=(--project "$SC_PROJECT")
    if (( SC_PROVIDER_MODE_EXPLICIT )); then
      picker_args+=(--mode "$SC_PROVIDER_MODE")
    elif [[ -n "$SC_LOCAL_PROVIDER" ]]; then
      picker_args+=(--mode local)
    fi
    rc=0
    picked="$(
      python3 -P "$SC_SESSION_SELECTOR_TOOL" \
        --sessions "$SC_CONTROL/codex-home/sessions" --project "$SC_PROJECT" --all |
      python3 -P "$SC_SESSION_PICKER_TOOL" "${picker_args[@]}"
    )" || rc=$?
    (( rc == 0 )) || sc_die "project resume picker did not select a conversation; no new conversation was started" "$rc"
    jq -e --arg project "$SC_PROJECT" '
      .schema=="sandcodex.project-picker-selection.v1" and
      .project==$project and
      (.id|type)=="string" and
      (.mode=="gpt" or .mode=="local" or .mode=="remote" or .mode=="gemini") and
      .verification_required=="exact-reselection-and-provider-binding-before-start"
    ' <<<"$picked" >/dev/null || sc_die "project resume picker returned invalid metadata" 78
    picker_mode=$(jq -er '.mode' <<<"$picked")
    if (( SC_PROVIDER_MODE_EXPLICIT )) && [[ "$picker_mode" != "$SC_PROVIDER_MODE" ]]; then
      sc_die "project resume picker returned a conversation outside the requested provider mode" 78
    fi
    SC_RESUME_ID=$(jq -er '.id' <<<"$picked")
    SC_RESUME=id
  fi

  args=(--sessions "$SC_CONTROL/codex-home/sessions" --project "$SC_PROJECT")
  [[ -z "$SC_RESUME_ID" ]] || args+=(--id "$SC_RESUME_ID")
  # Selection is always latest in THIS project, never machine-global. An explicit
  # namespace/model may constrain continuation, but may not silently pick older history.
  selected="$(sc_emit_session_selector | python3 -P - "${args[@]}")" || rc=$?
  (( rc == 0 )) || sc_die "project resume could not select a conversation; no new conversation was started" "$rc"
  jq -e '.schema=="sandcodex.project-resume.v2" and
         .history.integrity=="validated-identity-prefix" and
         (.history.mode=="legacy" or .history.mode=="paginated") and
         (.history.storage=="plain" or .history.storage=="zstd")' <<<"$selected" >/dev/null ||
    sc_die "project resume selector returned unverified history metadata" 78
  provider=$(jq -er '.provider' <<<"$selected")
  case "$provider" in
    openai) mode=gpt ;;
    ollama) mode=local ;;
    scr_*) [[ "$provider" =~ ^scr_[0-9a-f]{64}$ ]] || sc_die "unknown saved provider descriptor" 78; mode=remote ;;
    scg_*) [[ "$provider" =~ ^scg_[0-9a-f]{64}$ ]] || sc_die "unknown saved Gemini provider descriptor" 78; mode=gemini ;;
    *) sc_die "saved provider is not supported by this adapter; refusing to substitute GPT or cloud" 78 ;;
  esac
  if (( SC_PROVIDER_MODE_EXPLICIT )) && [[ "$SC_PROVIDER_MODE" != "$mode" ]]; then
    sc_die "selected project conversation uses $mode, not the requested $SC_PROVIDER_MODE; use its mode or another explicit session UUID" 64
  fi
  if [[ "$mode" != local && -n "$SC_LOCAL_PROVIDER" ]]; then
    sc_die "saved conversation is not local but a local provider was requested; refusing provider substitution" 64
  fi
  model=$(jq -r '.model // empty' <<<"$selected")
  if (( SC_MODEL_SET )) && [[ -n "$model" && "$SC_MODEL" != "$model" ]]; then
    if [[ "$mode" == local ]]; then
      # A content-addressed local transcript names its digest-derived runtime alias.
      # Preserve the human selector and defer comparison to the immutable binding.
      [[ -n "$SC_LOCAL_REQUESTED_MODEL" ]] || SC_LOCAL_REQUESTED_MODEL=$SC_MODEL
    else
      sc_die "resume model differs from the saved model; refusing silent substitution" 64
    fi
  elif [[ "$mode" == local && $SC_MODEL_SET -eq 1 && -z "$SC_LOCAL_REQUESTED_MODEL" ]]; then
    SC_LOCAL_REQUESTED_MODEL=$SC_MODEL
  fi
  [[ "$mode" == gpt || -n "$model" ]] || sc_die "saved non-GPT model is unknown; refusing to guess" 78
  if [[ -n "$model" ]]; then SC_MODEL=$model; SC_MODEL_SET=1; fi
  SC_PROVIDER_MODE=$mode
  SC_RESUME_ID=$(jq -er '.id' <<<"$selected"); SC_RESUME=id
  if [[ "$mode" == local ]]; then
    [[ -z "$SC_LOCAL_PROVIDER" || "$SC_LOCAL_PROVIDER" == "$provider" ]] || sc_die "resume local provider mismatch" 64
    SC_LOCAL_PROVIDER=$provider; SC_LOCAL_PROVIDER_SOURCE=resume
    if [[ -z "$SC_LOCAL_CONTEXT_TOKENS" ]]; then
      SC_LOCAL_CONTEXT_TOKENS=$(jq -r '.context_tokens // empty' <<<"$selected")
    fi
  elif [[ "$mode" == remote ]]; then
    SC_REMOTE_NATIVE_PROVIDER=$provider
    SC_REMOTE_SNAPSHOT="$SC_CONTROL/remote-providers/${provider#scr_}.json"
  elif [[ "$mode" == gemini ]]; then
    SC_GEMINI_NATIVE_PROVIDER=$provider
    SC_GEMINI_SNAPSHOT="$SC_CONTROL/gemini-providers/${provider#scg_}.json"
  fi
  if [[ "$mode" != gpt ]]; then sc_family_apply_resume_binding "$selected"; fi
  history_detail=$(jq -r '
    .history.storage + " " +
    (if .history.mode=="paginated" then
      "paginated identity prefix"
    else "legacy identity prefix" end)
    + (if .history.torn_tail_ignored then " · unterminated tail ignored" else "" end)' <<<"$selected")
  sc_note "resume · project $SC_PROJECT · session $SC_RESUME_ID · provider $provider · history $history_detail"
}

sc_remote_qualification_result_valid() {
  jq -e --arg descriptor "$1" --arg model "$2" '
    .schema=="sandcodex.remote-qualification-result.v1" and
    .result=="qualified" and
    (.reused|type)=="boolean" and
    (.network_requests==0 or .network_requests==3) and
    ((.reused==true and .network_requests==0) or (.reused==false and .network_requests==3)) and
    (.receipt_path|type)=="string" and (.receipt_path|startswith("/")) and
    (.receipt_sha256|type)=="string" and (.receipt_sha256|test("^[0-9a-f]{64}$")) and
    .descriptor_sha256==$descriptor and .model==$model and
    .probe_version=="responses-instructions-stream-tools-v5-sandideas-result-review" and
    .model_identity_policy=="provider-defined-name-not-content-addressed" and
    .credential_value_disclosed==false and .raw_provider_content_disclosed==false
