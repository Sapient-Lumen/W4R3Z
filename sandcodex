    def guarded_click(
        self,
        x: int,
        y: int,
        button: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        """Arm, validate, and dispatch one compositor-native complete click."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor click connection is unauthorized")
        if type(x) is not int or type(y) is not int:
            raise ToolError("compositor click coordinates must be integers")
        if not (
            -SWAY_HIT_TEST_MAX_COORDINATE <= x <= SWAY_HIT_TEST_MAX_COORDINATE
            and -SWAY_HIT_TEST_MAX_COORDINATE <= y <= SWAY_HIT_TEST_MAX_COORDINATE
        ):
            raise ToolError("compositor click coordinates exceed the patch ceiling")
        if type(button) is not int or not 1 <= button <= 3:
            raise ToolError("compositor click button must be 1, 2, or 3")
        if not callable(validator):
            raise ToolError("compositor click route validator is unavailable")

        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-click", "x": x, "y": y}),
                    "SANDCODEX_HIT_TEST arm-click",
                )
                target, ticket = self._normalize_hit_test_reply(
                    arm_reply,
                    x,
                    y,
                    expected_operation="arm-click",
                )
                if ticket is None:
                    raise RuntimeError("Sway compositor-click arm omitted private authority")
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-click-ticket-v1\0" + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": POINTER_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-complete-click",
                    "x": x,
                    "y": y,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
