+    grant->stylus_tool_grab_address = (uintptr_t)sandcodex_stylus.tool_v2->grab;
+    grant->stylus_tool_default_grab_address =
+        (uintptr_t)&sandcodex_stylus.tool_v2->default_grab;
+    grant->stylus_tool_hardware_serial = sandcodex_stylus.tool.hardware_serial;
+    grant->stylus_peer_tool_address = (uintptr_t)&sandcodex_stylus.eraser_tool;
+    grant->stylus_peer_tool_v2_address = (uintptr_t)sandcodex_stylus.eraser_tool_v2;
+    grant->stylus_peer_tool_grab_address =
+        (uintptr_t)sandcodex_stylus.eraser_tool_v2->grab;
+    grant->stylus_peer_tool_default_grab_address =
+        (uintptr_t)&sandcodex_stylus.eraser_tool_v2->default_grab;
+    grant->stylus_peer_tool_hardware_serial =
+        sandcodex_stylus.eraser_tool.hardware_serial;
