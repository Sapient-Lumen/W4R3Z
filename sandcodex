        definition("team_adopt", "Explicitly adopt a staged worker candidate into a clean primary checkout.", {
            "name": NAME, "strategy": {"type": "string", "enum": ["cherry-pick", "merge"]}}, ["name"]),
        definition("team_grant", "Inspect or narrow/restore live worker start, capacity, remote-auto, browser, or desktop grants.", {
            "action": {"type": "string", "enum": ["status", "allow-starts", "revoke-starts", "capacity", "remote-auto-on", "remote-auto-off", "browser-isolated-on", "browser-isolated-off", "desktop-isolated-on", "desktop-isolated-off"]},
            "maximum": {"type": "integer", "minimum": 0, "maximum": 16}}, ["action"]),
    ]


def text_file(value, suffix):
    if not isinstance(value, str) or not value.strip() or len(value.encode()) > MAX_TEXT or "\0" in value:
        raise ValueError("text is empty or exceeds the 16384-byte limit")
    root = Path(PROJECT) / ".sandcodex" / "work" / "team-mcp"
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    descriptor, path = tempfile.mkstemp(prefix="request-", suffix=suffix, dir=root)
    try:
        os.fchmod(descriptor, 0o600)
        os.write(descriptor, value.encode())
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return path, os.path.relpath(path, PROJECT)


def json_file(value):
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"))
    return text_file(payload, ".json")


def opt(args, flag, value):
    if value is not None:
        args.extend([flag, str(value)])


def command_for(name, values):
    cleanup = []
    if ROLE == "worker":
        if name == "team_reply":
            path, relative = text_file(values["message"], ".message")
            cleanup.append(path)
            args = ["reply", "--message-file", relative]
            opt(args, "--to", values.get("to")); opt(args, "--reply-to", values.get("reply_to"))
            opt(args, "--attachment", values.get("attachment"))
        elif name == "team_complete":
            path, relative = text_file(values["message"], ".message")
            cleanup.append(path)
            args = ["complete", "--message-file", relative]
            opt(args, "--attachment", values.get("attachment"))
        elif name == "team_inbox": args = ["inbox"]
        elif name == "team_ack": args = ["ack", values["message_id"]]
        elif name == "team_identity": args = ["identity"]
        else: raise ValueError("unknown worker team tool")
        return args, cleanup, 60
    if name == "team_start":
        path, relative = text_file(values["prompt"], ".prompt")
        cleanup.append(path)
        args = ["start", values["name"], "--prompt-file", relative, "--turns", str(values.get("turns", DEFAULT_TURNS)), "--json"]
        for dependency in values.get("depends", []): args.extend(["--depends", dependency])
        for provider in values.get("allowed_providers", []): args.extend(["--allow-provider", provider])
        for key, flag in (("provider", "--provider"), ("effort", "--effort"),
                          ("token_budget", "--token-budget"), ("time_budget_seconds", "--time-budget"),
                          ("browser", "--browser"), ("desktop", "--desktop"),
                          ("verifier", "--verifier")):
            opt(args, flag, values.get(key))
        timeout = 240
    elif name == "team_graph":
        path, relative = json_file(values["graph"]); cleanup.append(path)
        args = ["graph", "--file", relative, "--json"]; timeout = 600
    elif name in {"team_list", "team_top"}:
        args = [name.removeprefix("team_"), "--json"]; timeout = 120
    elif name in {"team_status", "team_diff", "team_stage"}:
        args = [name.removeprefix("team_"), values["name"], "--json"]; timeout = 600
    elif name in {"team_events", "team_attach", "team_inspect"}:
        args = [name.removeprefix("team_"), values["name"], "--cursor", str(values.get("cursor", 0)), "--json"]; timeout = 120
    elif name == "team_send":
        path, relative = text_file(values["message"], ".message"); cleanup.append(path)
        args = ["send", values["name"], "--message-file", relative, "--json"]
        opt(args, "--attachment", values.get("attachment")); timeout = 240
    elif name == "team_inbox":
        args = ["inbox", "--json"]; opt(args, "--name", values.get("name")); timeout = 120
    elif name == "team_ack": args = ["ack", "--message-id", values["message_id"], "--json"]; timeout = 120
    elif name in {"team_wait", "team_wait_any"}:
        args = [name.removeprefix("team_")]
        if name == "team_wait": args.append(values["name"])
        args.extend(["--timeout", str(values.get("timeout_seconds", 1800)), "--json"]); timeout = values.get("timeout_seconds", 1800) + 60
    elif name == "team_stop": args = ["stop", values["name"], "--json"]; timeout = 240
    elif name == "team_collect":
        output = values.get("output") or f".sandcodex/work/campaign-artifacts/{values['name']}.bundle"
        args = ["collect", values["name"], "--output", output, "--json"]; timeout = 600
    elif name == "team_test":
        args = ["test", values["name"], "--test-timeout", str(values.get("timeout_seconds", 900)), "--json"]
        if values.get("command"): args.extend(["--", *values["command"]])
        timeout = values.get("timeout_seconds", 900) + 60
    elif name == "team_adopt":
        args = ["adopt", values["name"], "--strategy", values.get("strategy", "cherry-pick"), "--json"]; timeout = 600
    elif name == "team_grant":
        args = ["grant", values["action"], "--json"]
        if values["action"] == "capacity":
            if "maximum" not in values: raise ValueError("capacity requires maximum")
            args.extend(["--max", str(values["maximum"])])
        timeout = 120
    else:
        raise ValueError("unknown foreman team tool")
    return args, cleanup, timeout


def call_tool(name, values):
    args, cleanup, timeout = command_for(name, values)
    failure = None
    try:
        result = subprocess.run([HELPER, *args], cwd=PROJECT, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        failure = f"team tool timed out after {timeout} seconds"
    except OSError as error:
        failure = f"team helper could not start: {error}"
    finally:
        for path in cleanup:
            try: os.unlink(path)
            except FileNotFoundError: pass
    if failure is not None:
        return {"content": [{"type": "text", "text": failure}], "isError": True}
    stdout = result.stdout[:MAX_OUTPUT].decode("utf-8", "replace")
    stderr = result.stderr[:65536].decode("utf-8", "replace")
    if result.returncode:
        detail = stderr.strip() or stdout.strip() or f"team command exited {result.returncode}"
        return {"content": [{"type": "text", "text": detail}], "isError": True}
    return {"content": [{"type": "text", "text": stdout.strip() or "ok"}], "isError": False}


def respond(identifier, result=None, error=None):
    value = {"jsonrpc": "2.0", "id": identifier}
    if error is not None: value["error"] = error
    else: value["result"] = result
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


for line in sys.stdin:
    try:
        request = json.loads(line)
        if not isinstance(request, dict) or request.get("jsonrpc") != "2.0":
            raise ValueError("invalid JSON-RPC request")
        identifier = request.get("id")
        method = request.get("method")
        if identifier is None:
            continue
        if method == "initialize":
            respond(identifier, {"protocolVersion": PROTOCOL, "capabilities": {"tools": {"listChanged": False}},
                                 "serverInfo": {"name": "sandcodex-team", "version": "1"}})
        elif method == "ping": respond(identifier, {})
        elif method == "tools/list": respond(identifier, {"tools": TOOLS})
        elif method == "tools/call":
            parameters = request.get("params") or {}
            tool_name = parameters.get("name")
            arguments = parameters.get("arguments") or {}
            if tool_name not in {tool["name"] for tool in TOOLS} or not isinstance(arguments, dict):
                raise ValueError("unknown team tool or invalid arguments")
            respond(identifier, call_tool(tool_name, arguments))
        else:
            respond(identifier, error={"code": -32601, "message": "method not found"})
    except Exception as error:
        identifier = request.get("id") if isinstance(locals().get("request"), dict) else None
        if identifier is not None:
            respond(identifier, error={"code": -32602, "message": str(error)[:1024]})
PY
  } | sc_atomic "$target" 500
}

sc_write_worker_helper() {
  [[ -n "$SC_AGENT_BIN" ]] || return 0
  sc_write_team_helper
  sc_write_team_mcp_helper
  if (( SC_CAMPAIGN_AVAILABLE )); then
    cat <<'EOF' | sc_atomic "$SC_AGENT_BIN/sandcodex-worker" 500
#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:---help}" in
  -h|--help|help)
    cat <<'HELP'
Sandcodex worker companion

  sandcodex ready
  sandcodex-worker start --name worker-1 --prompt 'Task text'
  sandcodex-worker start review --turns 0 --prompt-file plans/review.md
  sandcodex-worker start bounded --turns 8 --prompt 'Eight-turn ceiling'
  sandcodex-worker doctor
  sandcodex-worker list
  sandcodex-worker status
  sandcodex-worker status --name worker-1
  sandcodex-worker status worker-1
  sandcodex-worker events --name worker-1 --follow
  sandcodex-worker events worker-1 --follow
  sandcodex-worker wait worker-1 --timeout 1800
  sandcodex-worker send --name worker-1 --message 'Steer the worker.'
  sandcodex-worker stop --name worker-1
  sandcodex-worker collect --name worker-1 --output .sandcodex/work/campaign-artifacts/worker-1.bundle
  sandcodex-worker grant status
  sandcodex-worker grant revoke-starts
  sandcodex-worker grant allow-starts
  sandcodex-worker grant capacity --max 1
  sandcodex-worker grant remote-auto-off
  sandcodex-worker grant browser-isolated-on
  sandcodex-worker grant desktop-isolated-on

This is the action-first alias for the authorized SANDCODEX_CAMPAIGN helper.
It starts a concurrent companion in an independent clean Git clone while the
interactive command room remains live. Collected bundles are evidence only and
are never merged automatically.

A worker exists only after `start` returns success. `status` and `events` are
the sole evidence for lifecycle and turn progress. If a command times out or
fails, report the state as unknown; never infer that a worker launched, estimate
its turn count from elapsed time, or claim completion without terminal status.

Grant commands are live broker controls owned by the interactive room. They can
temporarily revoke new worker starts, lower/restore active worker capacity up to
the launch ceiling, disable remote-auto worker model/key selection, or enable
and revoke isolated browser/desktop worker realms when the parent launch has
that facility. GUI grants remain off by default and never share the foreground
realm.

`sandcodex ready` is the low-risk first move when the whole room feels
confusing. `doctor` is the worker-specific follow-up: it prints the companion
inventory, current worker grants, provider readiness card, and provider-router
status without spending model quota or exposing credentials.

If the human asks for another sandperson, worker, looper, delegate, or
companion, run this helper directly. Do not inspect /run, provider contracts, or
capability JSON first unless this command fails.
HELP
    exit 0
    ;;
esac
if [[ "${2:-}" == -h || "${2:-}" == --help || "${2:-}" == help ]]; then
  case "$1" in
    start)
      printf '%s\n' "usage: sandcodex-worker start --name NAME [--turns N] --prompt TEXT"
      printf '%s\n' "       sandcodex-worker start NAME [--turns N] --prompt TEXT"
      printf '%s\n' "       sandcodex-worker start --name NAME [--turns N] --prompt-file RELATIVE_PATH"
      printf '%s\n' "       turns defaults to 0 (unbounded); a positive launch ceiling may require N"
      exit 0 ;;
    doctor|health|overview)
      printf '%s\n' "usage: sandcodex-worker doctor"
      printf '%s\n' "       sandcodex-worker health"
      printf '%s\n' "       sandcodex-worker overview"
      exit 0 ;;
    status)
      printf '%s\n' "usage: sandcodex-worker status"
      printf '%s\n' "usage: sandcodex-worker status NAME"
      printf '%s\n' "       sandcodex-worker status --name NAME [--json]"
      exit 0 ;;
    events)
      printf '%s\n' "usage: sandcodex-worker events NAME [--follow] [--cursor N]"
      printf '%s\n' "       sandcodex-worker events --name NAME [--follow] [--cursor N] [--json]"
      exit 0 ;;
    wait)
      printf '%s\n' "usage: sandcodex-worker wait NAME [--timeout SECONDS] [--poll SECONDS] [--json]"
      printf '%s\n' "       waits for a terminal campaign lifecycle state; default timeout is 1800 seconds"
      printf '%s\n' "       exits 0=completed, 1=failed, 73=storage hold, 75=recovery required, 125=stopped, 124=timeout"
      exit 0 ;;
    send)
      printf '%s\n' "usage: sandcodex-worker send NAME --message TEXT"
      printf '%s\n' "       sandcodex-worker send --name NAME --message-file RELATIVE_PATH"
      exit 0 ;;
    stop)
      printf '%s\n' "usage: sandcodex-worker stop NAME"
      printf '%s\n' "       sandcodex-worker stop --name NAME"
      exit 0 ;;
    restart)
      printf '%s\n' "usage: sandcodex-worker restart NAME"
      printf '%s\n' "       sandcodex-worker restart --name NAME"
      printf '%s\n' "automatic workers reuse their launch-sealed OpenRouter or Gemini routing authority on restart."
      exit 0 ;;
    collect)
      printf '%s\n' "usage: sandcodex-worker collect NAME --output RELATIVE_BUNDLE_PATH"
      printf '%s\n' "       sandcodex-worker collect --name NAME --output RELATIVE_BUNDLE_PATH"
      exit 0 ;;
    grant)
      printf '%s\n' "usage: sandcodex-worker grant status|allow-starts|revoke-starts|capacity|remote-auto-on|remote-auto-off"
      exit 0 ;;
  esac
fi
helper="${SANDCODEX_CAMPAIGN:-}"
if [[ -z "$helper" ]]; then
  printf 'sandcodex-worker: companion campaigns are not authorized in this process\n' >&2
  exit 77
fi
if [[ "${1:-}" == doctor || "${1:-}" == health || "${1:-}" == overview ]]; then
  provider_mode=""
  if [[ -n "${SANDCODEX_ENVIRONMENT:-}" && -r "${SANDCODEX_ENVIRONMENT}" ]]; then
    provider_mode="$(jq -r '.remote.provider_mode // empty' "$SANDCODEX_ENVIRONMENT" 2>/dev/null || true)"
  fi
  printf '%s\n\n' "sandcodex worker doctor"
  if command -v sandcodex >/dev/null 2>&1; then
    printf '%s\n' "room readiness:"
    sandcodex ready 2>&1 || true
    printf '\n'
  fi
  printf '%s\n' "campaign inventory:"
  if ! "$helper" list; then
    printf '%s\n' "sandcodex-worker: campaign broker is unavailable; inventory and progress are unknown" >&2
    exit 75
  fi
  printf '\n%s\n' "worker grants:"
  if ! "$helper" grant status; then
    printf '%s\n' "sandcodex-worker: worker grants are unavailable; restart the command room if retry does not recover" >&2
    exit 75
  fi
  if [[ "$provider_mode" == gemini && -n "${SANDCODEX_ENVIRONMENT:-}" ]]; then
    printf '\n%s\n' "Gemini router:"
    jq -r '
      "  route:      \(.gemini.routing_model)",
      "  free auto:  \(.gemini.auto)",
      "  route wait: \(.gemini.route_wait_seconds)s per buffered request",
      "  ceiling:    \(.gemini.request_ceiling_seconds)s across route attempts and identical transport retries",
      "  candidates: \(.gemini.candidate_models | join(", "))",
      "  failover:   strongest-model-first; automatic account/key rotation; exact signed history retained",
      "  worker:     shared credential-isolating parent adapter; clean-turn quota/transient replay"
    ' "$SANDCODEX_ENVIRONMENT" 2>/dev/null || true
  elif command -v sandcodex >/dev/null 2>&1; then
    printf '\n%s\n' "remote router:"
    sandcodex remote router status 2>&1 || true
  fi
  printf '\n%s\n' "common next steps:"
  printf '%s\n' "  ready:   sandcodex ready"
  printf '%s\n' "  start:   sandcodex-worker start worker-1 --prompt 'Task text'"
  printf '%s\n' "  wait:    sandcodex-worker wait worker-1 --timeout 1800"
  printf '%s\n' "  watch:   sandcodex-worker events worker-1 --follow"
  printf '%s\n' "  steer:   sandcodex-worker send worker-1 --message 'Update text'"
  printf '%s\n' "  collect: sandcodex-worker collect worker-1 --output .sandcodex/work/campaign-artifacts/worker-1.bundle"
  exit 0
fi
if [[ "${1:-}" == status && $# -eq 1 ]]; then
  exec "$helper" list
fi
if [[ "${1:-}" == wait ]]; then
  shift
  name="" timeout=1800 poll=2 json=0
  while (( $# )); do
    case "$1" in
      --name) (( $# > 1 )) || { printf 'sandcodex-worker: --name requires NAME\n' >&2; exit 64; }; name="$2"; shift 2 ;;
      --name=*) name="${1#*=}"; shift ;;
      --timeout) (( $# > 1 )) || { printf 'sandcodex-worker: --timeout requires SECONDS\n' >&2; exit 64; }; timeout="$2"; shift 2 ;;
      --timeout=*) timeout="${1#*=}"; shift ;;
      --poll) (( $# > 1 )) || { printf 'sandcodex-worker: --poll requires SECONDS\n' >&2; exit 64; }; poll="$2"; shift 2 ;;
      --poll=*) poll="${1#*=}"; shift ;;
      --json) json=1; shift ;;
      -*) printf 'sandcodex-worker: unknown wait option: %s\n' "$1" >&2; exit 64 ;;
      *) [[ -z "$name" ]] || { printf 'sandcodex-worker: wait accepts one NAME\n' >&2; exit 64; }; name="$1"; shift ;;
    esac
  done
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || { printf 'sandcodex-worker: wait requires a valid NAME\n' >&2; exit 64; }
  [[ "$timeout" =~ ^[0-9]+$ && ${#timeout} -le 7 ]] || { printf 'sandcodex-worker: invalid wait timeout\n' >&2; exit 64; }
  [[ "$poll" =~ ^[1-9][0-9]*$ && ${#poll} -le 4 ]] || { printf 'sandcodex-worker: invalid wait poll interval\n' >&2; exit 64; }
  deadline=$((SECONDS + timeout))
  while :; do
    result=$("$helper" status --name "$name" --json) || exit $?
    lifecycle=$(jq -r '.lifecycle_state // "failed"' <<<"$result")
    case "$lifecycle" in
      completed)
        if (( json )); then printf '%s\n' "$result"; else "$helper" status --name "$name"; fi
        exit 0
        ;;
      failed)
        if (( json )); then printf '%s\n' "$result"; else "$helper" status --name "$name"; fi
        exit 1
        ;;
      storage_hold)
        if (( json )); then printf '%s\n' "$result"; else "$helper" status --name "$name"; fi
        exit 73
        ;;
      recovery_required)
        if (( json )); then printf '%s\n' "$result"; else "$helper" status --name "$name"; fi
        exit 75
        ;;
      stopped)
        if (( json )); then printf '%s\n' "$result"; else "$helper" status --name "$name"; fi
        exit 125
        ;;
    esac
    if (( timeout > 0 && SECONDS >= deadline )); then
      printf 'sandcodex-worker: timed out waiting for %s after %ss (last lifecycle: %s)\n' "$name" "$timeout" "$lifecycle" >&2
      exit 124
    fi
    sleep "$poll"
  done
fi
case "${1:-}" in
  start|status|events|send|stop|restart|collect)
    action="$1"
    shift
    if [[ "${1:-}" != "" && "${1:-}" != -* ]]; then
      name="$1"
      shift
      set -- "$action" --name "$name" "$@"
    else
      set -- "$action" "$@"
    fi
    ;;
esac
exec "$helper" "$@"
EOF
  elif [[ -e "$SC_AGENT_BIN/sandcodex-worker" || -L "$SC_AGENT_BIN/sandcodex-worker" ]]; then
    sc_owned_single_file "$SC_AGENT_BIN/sandcodex-worker" 500 "agent worker helper"
    rm -f -- "$SC_AGENT_BIN/sandcodex-worker"
  fi
}

sc_git_clean_env() (
  (( $# )) || sc_die "internal Git invocation is incomplete"
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_INDEX_FILE GIT_NAMESPACE GIT_CONFIG_COUNT
  local name
  for name in ${!GIT_CONFIG_KEY_@} ${!GIT_CONFIG_VALUE_@}; do unset "$name"; done
  env GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 "$@"
)

sc_managed_git() {
  (( $# >= 3 )) || sc_die "internal managed Git invocation is incomplete"
  local real_git="$1" managed="$2"
  shift 2
  sc_git_clean_env \
    "$real_git" -C "$SC_PROJECT" --git-dir="$managed" --work-tree="$SC_PROJECT" "$@"
}

sc_emit_agent_environment_helper_body() {
  cat <<'SANDCODEX_AGENT_ENVIRONMENT_HELPER_BODY_SH'
case "${1:---json}" in
  --json) exec cat -- "$environment" ;;
  --path) printf '%s\n' "$environment" ;;
  --briefing|--first-contact) jq -r '
    [
      "Sandcodex briefing",
      "project: \(.project)",
      "mode: \(.mode)",
      "",
      "1. Work in the selected project. Ordinary project files and Git metadata are writable; trusted credentials and Sandcodex internals are protected.",
      "2. Use normal repository commands and canonical tests. Do not hand-patch generated artifacts as a substitute for reproducible builds.",
      "3. Discovery: sandcodex-env --summary, sandcodex-env --capabilities, sandcodex-env --json.",
      (if .remote.active then
        "4. Remote continuity: run sandcodex remote continuity for the paste-back-safe model/key" + (if .campaign.available then "/worker" else "" end) + " handoff card. It does not spend model quota by default."
       elif .gemini.active then
        "4. Gemini continuity: run sandcodex ready for the no-secret route/worker card. The host-side adapter owns credentials, exact signed-history replay, and free-route failover."
       else empty end),
      (if .campaign.available then
        ("5. Workers: when the human gives a concrete task, make sandcodex-worker start --name NAME --turns " + (if .campaign.default_authority.max_turns == 0 then "0" else "N" end) + " --prompt '\''TASK'\'' the first command. Then remain the live foreman: use sandcodex-team top, attach NAME, and inbox for exact progress and reports, discuss and steer with send, and never estimate. Use wait only when the human explicitly asks to await completion; use doctor only after a failed start or when no task was specified.") +
        (if .campaign.delegated_openrouter_workers then " For a bounded OpenRouter task, add --provider openrouter; retain coordination and review in this primary room." else "" end)
       else empty end),
      (if .git.mode == "managed" then
        "6. Git: protected managed Git is active. Normal git add/commit/status is project-bound; use sandcodex-git-standalone --work-tree PATH -- ... only for an intentional independent repo."
       else
        "6. Git: use the project repository normally; preserve unrelated user work."
       end),
      (if .jail.available then
        "7. Less-trusted actions: inspect sandcodex-jail capability-card before delegating a narrower action."
       else
        "7. Inner jail unavailable in this launch; use ordinary command-room tools directly."
       end),
      (if .browser.enabled then
        "8. Browser: Playwright MCP is available; use sandcodex-browser status --json/show/hide for collaboration state."
       else
        "8. Browser: disabled for this launch."
       end),
      (if .desktop.enabled then
        "9. Desktop: native Linux workstation MCP is available; read SANDCODEX_DESKTOP_GUIDE before mutation."
       else
        "9. Desktop: disabled for this launch."
       end),
      "10. Never place secrets or private source in /nix/store; Nix daemon work happens outside this room'\''s proxy/cgroup accounting."
    ][]
  ' "$environment" ;;
  --summary) jq -r '
    "Sandcodex \(.sandcodex_version) | \(.mode)",
    "project   \(.project)",
    "writes    \(if .mode == "bare-metal" then "unrestricted host access" else "full selected-project authority; boundary state and host hidden" end)",
    "sudo     \(if .mode == "bare-metal" then (if .project_authority.bare_metal_sudo_ticket then "launcher-managed ticket" else "not primed by Sandcodex" end) else "not used by safe mode" end)",
    "resources \(if .mode == "bare-metal" then "no Sandcodex outer cgroup" elif .resource_scope.enabled then "systemd cgroup unit: memory \(.resource_scope.memory_max), tasks \(.resource_scope.tasks_max), swap disabled" else "systemd cgroup unit disabled explicitly; no outer memory/task/swap cap" end)",
    "git       \(.git.mode); metadata and hooks writable; launcher state ignored outside .gitignore",
    "nix       \(if .mode == "bare-metal" then "native host Nix" elif .toolchain.nix.daemon_available then "flakes/build/develop/profile; host-daemon broker; isolated profile" else "client tools only; daemon withheld" end)",
    "network   \(.network.mode)",
    "remote    \(if .remote.active then (.remote.provider + " · model " + (.remote.requested_model // "unknown") + (if .remote.remote_auto then " · auto-selected" else "" end)) else "not selected" end)",
    "gemini    \(if .gemini.active then (.gemini.provider + " · route " + (.gemini.routing_model // "unknown") + (if .gemini.auto then " · free auto" else "" end)) else "not selected" end)",
    "publish   \(if .network.publish.enabled then (.network.publish.listeners | map(.bind_address + ":" + (.host_port|tostring) + " -> 127.0.0.1:" + (.target_port|tostring)) | join(", ")) else "disabled" end)",
    "browser   \(if .browser.enabled then "complete Playwright + persistent Chromium" else "disabled" end)",
    "paths     short temp/scratch/downloads/browser-output in .paths",
    "loop      \(if .loop.can_request_from_active_agent then "helper ready; status/send/stop" else "host-only" end)",
    "campaign  \(if .campaign.available then "concurrent staged routes " + (.campaign.default_authority.provider_routes|join("/")) + "; \(.campaign.default_authority.max_concurrent)x\(.campaign.default_authority.max_codex_invocations) Codex invocations" else "not delegated to this process" end)",
    "operator  \(if .operator_service.available then (.operator_service.name + "; durable sibling + authenticated loopback cockpit") else "not selected" end)",
    "jail      \(if .jail.available then (.jail.command + "; build + " + .jail.default.network + " net + " + .jail.default.resources + " resources; storage " + .jail.persistent_storage_health.status) else "unavailable" end)",
    "briefing  sandcodex-env --briefing",
    "details   sandcodex-env --json"
  ' "$environment" ;;
  --capabilities|--llm|--doctor) jq -r '
    "Sandcodex capability map",
    "project: \(.project)",
    "mode: \(.mode)",
    "",
    "Shell",
    "  helper: \(.shell.env_helper) (--briefing, --summary, --json, --capabilities)",
    "  PATH prefix: \(.shell.path_prefix | join(":"))",
    "  temporary: $TMPDIR=\(.shell.private_tmp); /tmp=\(.shell.slash_tmp_scope)",
    "  short temporary root: $SANDCODEX_TEMP=\(.shell.short_temporary_root) (per-launch, project-backed, standalone-Git capable)",
    "  scratch: \(.paths.scratch)",
    "  downloads: \(.paths.downloads)",
    "  browser output: \(.paths.browser_output)",
