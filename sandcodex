+static void sandcodex_modifier_arc_device_destroy(struct wl_listener *listener,
+		void *data) {
+	struct sandcodex_modifier_arc *arc = wl_container_of(listener, arc,
+		device_destroy);
+	struct ipc_client *client = arc->client;
+	(void)data;
+	if (!arc->active) {
+		return;
+	}
+	/* Detach the firing listener and invalidate the destroyed-device identity
+	 * before any release-side rediscovery. This makes the callback safe under
+	 * wl_signal iteration and prevents a dead pointer from participating in an
+	 * exact-device proof. Device loss still cannot revoke the obligation to
+	 * release client-visible logical modifiers, so only this de-escalation path
+	 * deliberately waives the device proof. */
+	if (arc->device_destroy_linked) {
+		wl_list_remove(&arc->device_destroy.link);
+		arc->device_destroy_linked = false;
+	}
+	arc->sway_device_address = 0;
+	arc->wlr_device_address = 0;
+	arc->device_identifier[0] = '\0';
+	bool recipient_alive = false;
+	(void)sandcodex_release_modifier_arc_state(client, false,
+		&recipient_alive);
