    fi
    if ! issue="$(sc_browser_extension_readiness_issue "$manifest")"; then
      if [[ "$kind" == runtime ]]; then
        sc_die "prepared browser extension is incomplete: $manifest · $issue"
      fi
      sc_warn "ignoring incomplete project browser extension: ${manifest#"$SC_PROJECT"/} · $issue"
      continue
