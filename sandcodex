workspace_command() {
  is_nested && die 'recursive jail calls inherit one fixed workspace'
  local action=${1:-} name path cache role=durable-candidate format='' receipt=0 payload result
  shift || true
  case "$action" in
    create)
      name=${1:-}; [[ -n $name ]] || die 'workspace create requires NAME'; shift
      while (( $# )); do
        case "$1" in
          --role) (( $# > 1 )) || die '--role requires a workspace role'; role=$2; shift 2 ;;
          --role=*) role=${1#*=}; shift ;;
          --json) format=--json; shift ;;
          *) die "unknown workspace create option: $1" ;;
        esac
      done
      payload=$($jq_bin -cn --arg name "$name" --arg role "$role" \
        '{schema:"sand-jail.workspace-request.v1",action:"create",name:$name,role:$role}')
      result=$(broker_control "$payload")
      if [[ $format == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -er '.name' >/dev/null
        printf '%s\n' "$(workspace_path "$name")"
      fi
      ;;
    inspect)
      name=${1:-}; [[ -n $name ]] || die 'workspace inspect requires NAME'; shift
      [[ $# == 0 || ( $# == 1 && $1 == --json ) ]] || die 'workspace inspect accepts only optional --json'
      payload=$($jq_bin -cn --arg name "$name" \
        '{schema:"sand-jail.workspace-request.v1",action:"inspect",name:$name}')
      result=$(broker_control "$payload")
      if [[ ${1:-} == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r '
          "workspace  \(.name) · \(.role) · \(.state)",
          "identity   \(.id)",
          "budget     \(.budget.group) · \(.budget.maximum_bytes // "unlimited")",
          "usage      \(.usage.workspace.allocated_bytes + .usage.cache.allocated_bytes) allocated bytes",
          "grants     \(.active_grants)"'
      fi
      ;;
    usage)
      [[ $# == 0 || ( $# == 1 && $1 == --json ) ]] || die 'workspace usage accepts only optional --json'
      payload=$($jq_bin -cn '{schema:"sand-jail.workspace-request.v1",action:"usage"}')
      result=$(broker_control "$payload")
      if [[ ${1:-} == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r '
          "budget     \(.budget_group) · \(.maximum_bytes // "unlimited") · \(.metering)",
          "measured   \(.totals.allocated_bytes) allocated · \(.totals.logical_bytes) logical bytes",
          "headroom   \(.headroom_bytes // "not enforced")",
          "workspaces \(.workspaces | length)"'
      fi
      ;;
    normalize-hardlinks|retire|purge)
      name=${1:-}; [[ -n $name ]] || die "workspace $action requires NAME"; shift
      while (( $# )); do
        case "$1" in
          --receipt) receipt=1 ;;
          --json) format=--json ;;
          *) die "unknown workspace $action option: $1" ;;
        esac
        shift
      done
      (( receipt )) || die "workspace $action requires --receipt"
      payload=$($jq_bin -cn --arg action "$action" --arg name "$name" \
        '{schema:"sand-jail.workspace-request.v1",action:$action,name:$name,receipt:true}')
      result=$(broker_control "$payload")
      if [[ $format == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r \
          '"\(.workspace.name) \(.workspace.state) · receipt \(.receipt.id)"'
      fi
      ;;
    path)
      name=${1:-default}; [[ $# -le 1 ]] || die 'workspace path takes one name'
      path=$(workspace_path "$name"); validate_workspace "$path"; printf '%s\n' "$path"
      ;;
    cache)
      name=${1:-default}; [[ $# -le 1 ]] || die 'workspace cache takes one name'
      cache=$(cache_path "$name"); validate_cache "$cache"; printf '%s\n' "$cache"
      ;;
    list)
      [[ $# == 0 || ( $# == 1 && $1 == --json ) ]] || die 'workspace list accepts only optional --json'
      payload=$($jq_bin -cn '{schema:"sand-jail.workspace-request.v1",action:"list"}')
      result=$(broker_control "$payload")
      if [[ ${1:-} == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r '.workspaces[] | [.name,.role,.state] | @tsv'
      fi
      ;;
    *) die 'workspace command must be create, inspect, usage, normalize-hardlinks, retire, purge, path, cache, or list' ;;
  esac
}

broker_control() (
  is_nested && die 'protected evidence control is unavailable inside a recursive action'
  local payload=$1 request_dir='' request
  cleanup_control() {
    local status=$?
    trap - EXIT INT TERM HUP
    [[ -z $request_dir ]] || "$rm_bin" -rf -- "$request_dir"
    exit "$status"
  }
  trap cleanup_control EXIT INT TERM HUP
  request_dir=$($mktemp_bin -d "${TMPDIR:-/tmp}/.sjc.XXXXXX")
  request="$request_dir/request.json"
  printf '%s\n' "$payload" >"$request"
  "$chmod_bin" 600 -- "$request"
  "$python_bin" -P "$data_root/broker-client.py" "$broker_socket" "$request" --print-result
)

validate_evidence_id() {
  [[ $1 =~ ^[0-9a-f]{64}$ ]] || die 'evidence id must be 64 lowercase hexadecimal characters'
}

seal_command() {
  is_nested && die 'recursive actions may use inherited seals but cannot create or enumerate them'
  local action=${1:-} value=${2:-} format=${3:-} payload result absolute relative manifest
  case "$action" in
    create)
      [[ -n $value && ${4:-} == '' ]] || die 'seal create requires SOURCE and optional --json'
      [[ -z $format || $format == --json ]] || die 'seal create accepts only optional --json'
      absolute=$($realpath_bin -m -- "$value")
      case "$absolute" in
        "$project_root") relative=. ;;
        "$project_root"/*) relative=${absolute#"$project_root"/} ;;
        *) die 'sealed input source must be inside the selected project' ;;
      esac
      payload=$($jq_bin -cn --arg source "$relative" \
        '{schema:"sand-jail.seal-request.v1",action:"create",source:$source}')
      result=$(broker_control "$payload")
      if [[ $format == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -er '.id'
      fi
      ;;
    inspect)
      [[ -n $value && ${4:-} == '' ]] || die 'seal inspect requires ID and optional --json'
      [[ -z $format || $format == --json ]] || die 'seal inspect accepts only optional --json'
      validate_evidence_id "$value"
      payload=$($jq_bin -cn --arg id "$value" \
        '{schema:"sand-jail.seal-request.v1",action:"inspect",id:$id}')
      result=$(broker_control "$payload")
      if [[ $format == --json ]]; then
        manifest="$sealed_root/$value/manifest.json"
        [[ -f $manifest && ! -L $manifest &&
          $($stat_bin -c %u:%a:%h -- "$manifest") == "$EUID:400:1" ]] ||
          die 'sealed-input manifest has an unsafe identity'
        "$jq_bin" . "$manifest"
      else
        printf '%s\n' "$result" | "$jq_bin" -r '
          "sealed input  \(.id)",
          "source        \(.source)",
          "shape         \(.root_type) · \(.file_count) files · \(.total_bytes) bytes",
          "mount         /sealed/\(.id)"'
      fi
      ;;
    list)
      [[ -z $value && -z $format ]] || {
        [[ $value == --json && -z $format ]] || die 'seal list accepts only optional --json'
      }
      payload=$($jq_bin -cn '{schema:"sand-jail.seal-request.v1",action:"list"}')
      result=$(broker_control "$payload")
      if [[ $value == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r \
          '.sealed_inputs[] | [.id,.source,(.file_count|tostring),(.total_bytes|tostring)] | @tsv'
      fi
      ;;
    *) die 'seal command must be create, inspect, or list' ;;
  esac
}

receipt_command() {
  is_nested && die 'protected action receipts are unavailable inside a recursive action'
  local action=${1:-} value=${2:-} format=${3:-} payload result
  case "$action" in
    show)
      [[ -n $value && ${4:-} == '' ]] || die 'receipt show requires ID and optional --json'
      [[ -z $format || $format == --json ]] || die 'receipt show accepts only optional --json'
      validate_evidence_id "$value"
      payload=$($jq_bin -cn --arg id "$value" \
        '{schema:"sand-jail.receipt-request.v1",action:"show",id:$id}')
      result=$(broker_control "$payload")
      if [[ $format == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r '
          if .schema == "sand-jail.workspace-lifecycle-receipt.v1" then
            "workspace receipt \(.id)",
            "operation      \(.operation)",
            "workspace      \(.workspace.name) · \(.workspace.role)",
            "outcome        \(.outcome) · status \(.status)"
          else
            "action receipt \(.id)",
            "action         \(.action_id)",
            "workspace      \(.grant.workspace)",
            "outcome        \(.outcome) · status \(.status) (process \(.process_status))",
            "git            \(.storage_before.git.commit // "none") -> \(.storage_after.git.commit // "none")",
            "results        \(.results | length) valid · \(.result_errors | length) invalid",
            "grant digest   \(.grant_sha256)"
          end'
      fi
      ;;
    list)
      [[ -z $value && -z $format ]] || {
        [[ $value == --json && -z $format ]] || die 'receipt list accepts only optional --json'
      }
      payload=$($jq_bin -cn '{schema:"sand-jail.receipt-request.v1",action:"list"}')
      result=$(broker_control "$payload")
      if [[ $value == --json ]]; then printf '%s\n' "$result" | "$jq_bin" .; else
        printf '%s\n' "$result" | "$jq_bin" -r \
          '.receipts[] | [.id,.workspace,.outcome,(.status|tostring),.finished_at] | @tsv'
      fi
      ;;
    *) die 'receipt command must be show or list' ;;
  esac
}

run_command() {
  local workspace=default profile=build network resources=heavy seconds=null cwd=.
  local cpu=null memory=null swap=null pids=null file_size=null tmp_bytes=null home_bytes=null
  local max_seconds=null max_cpu=null max_memory=null max_swap=null max_pids=null
  local max_file=null max_tmp=null max_home=null parent_profile=build raw
  local request_seals_json='[]' request_results_json='[]' request_report_receipt=false request_receipt_fd=''
  local -a sealed_inputs=() result_paths=()
  narrow_value() {
    local ceiling=$1 preset=$2
    if [[ $ceiling == null ]] || (( ceiling > preset )); then printf '%s\n' "$preset"; else printf '%s\n' "$ceiling"; fi
  }
  select_bounded() {
    seconds=$(narrow_value "$max_seconds" "$bounded_timeout")
    cpu=$(narrow_value "$max_cpu" "$bounded_cpu")
    memory=$(narrow_value "$max_memory" "$bounded_memory")
    swap=$(narrow_value "$max_swap" "$bounded_swap")
    pids=$(narrow_value "$max_pids" "$bounded_pids")
    file_size=$(narrow_value "$max_file" "$bounded_file_size_bytes")
    tmp_bytes=$(narrow_value "$max_tmp" "$bounded_tmp_bytes")
    home_bytes=$(narrow_value "$max_home" "$bounded_home_bytes")
  }
  require_unbounded_ceiling() {
    [[ $max_seconds == null && $max_cpu == null && $max_memory == null && $max_swap == null &&
      $max_pids == null && $max_file == null && $max_tmp == null && $max_home == null ]] ||
      die 'heavy resources exceed a finite launch or parent resource ceiling'
  }
  validate_value() {
    local value=$1 ceiling=$2 label=$3 minimum=$4 maximum=$5
    [[ $value != null ]] || { [[ $ceiling == null ]] || die "$label cannot omit its finite parent ceiling $ceiling"; return; }
    [[ $value =~ ^(0|[1-9][0-9]*)$ && ${#value} -le 13 ]] || die "$label must be a canonical integer"
    (( value >= minimum && value <= maximum )) || die "$label must be an integer from $minimum through $maximum"
    [[ $ceiling == null ]] || (( value <= ceiling )) || die "$label exceeds parent ceiling $ceiling"
  }
  classify_resources() {
    if [[ $seconds == null && $cpu == null && $memory == null && $swap == null && $pids == null &&
      $file_size == null && $tmp_bytes == null && $home_bytes == null ]]; then
      resources=heavy
    elif [[ $seconds == "$bounded_timeout" && $cpu == "$bounded_cpu" && $memory == "$bounded_memory" &&
      $swap == "$bounded_swap" && $pids == "$bounded_pids" && $file_size == "$bounded_file_size_bytes" &&
      $tmp_bytes == "$bounded_tmp_bytes" && $home_bytes == "$bounded_home_bytes" ]]; then
      resources=bounded
    else
      resources=custom
    fi
  }
  if is_nested; then
    workspace=''
    profile=$($jq_bin -er '.profile' /run/sand-jail/grant.json)
    parent_profile=$profile
    network=$($jq_bin -er '.network' /run/sand-jail/grant.json)
    seconds=$($jq_bin -r '.timeout_seconds_max // "null"' /run/sand-jail/grant.json)
    cpu=$($jq_bin -r '.resources.cpu_percent_max // "null"' /run/sand-jail/grant.json)
    memory=$($jq_bin -r '.resources.memory_mib_max // "null"' /run/sand-jail/grant.json)
    swap=$($jq_bin -r '.resources.memory_swap_mib_max // "null"' /run/sand-jail/grant.json)
    pids=$($jq_bin -r '.resources.pids_max // "null"' /run/sand-jail/grant.json)
    file_size=$($jq_bin -r '.resources.file_size_bytes_max // "null"' /run/sand-jail/grant.json)
    tmp_bytes=$($jq_bin -r '.resources.tmp_bytes_max // "null"' /run/sand-jail/grant.json)
    home_bytes=$($jq_bin -r '.resources.home_bytes_max // "null"' /run/sand-jail/grant.json)
    mapfile -t sealed_inputs < <("$jq_bin" -er '.sealed_inputs[]?' /run/sand-jail/grant.json)
    case "$PWD" in /work) cwd=. ;; /work/*) cwd=${PWD#/work/} ;; *) cwd=. ;; esac
  else
    network=$($jq_bin -er '.default.network' "$contract")
    seconds=$($jq_bin -r '.launch_ceiling.deadline_seconds // "null"' "$contract")
    cpu=$($jq_bin -r '.launch_ceiling.cpu_percent // "null"' "$contract")
    memory=$($jq_bin -r '.launch_ceiling.memory_mib // "null"' "$contract")
    swap=$($jq_bin -r '.launch_ceiling.memory_swap_mib // "null"' "$contract")
    pids=$($jq_bin -r '.launch_ceiling.pids // "null"' "$contract")
    file_size=$($jq_bin -r '.launch_ceiling.file_size_bytes // "null"' "$contract")
    tmp_bytes=$($jq_bin -r '.launch_ceiling.tmp_bytes // "null"' "$contract")
    home_bytes=$($jq_bin -r '.launch_ceiling.home_bytes // "null"' "$contract")
  fi
  max_seconds=$seconds; max_cpu=$cpu; max_memory=$memory; max_swap=$swap; max_pids=$pids
  max_file=$file_size; max_tmp=$tmp_bytes; max_home=$home_bytes
  while (( $# )); do
    case "$1" in
      --workspace) (( $# >= 2 )) || die '--workspace requires a name'; is_nested && die 'recursive jail calls inherit one fixed workspace'; workspace=$2; shift 2 ;;
      --tools) (( $# >= 2 )) || die '--tools requires a profile'; profile=$2; shift 2 ;;
      --network) (( $# >= 2 )) || die '--network requires none or delegated'; network=$2; shift 2 ;;
      --resources)
        (( $# >= 2 )) || die '--resources requires heavy or bounded'
        case "$2" in
          heavy) require_unbounded_ceiling; seconds=null; cpu=null; memory=null; swap=null; pids=null; file_size=null; tmp_bytes=null; home_bytes=null ;;
          bounded) select_bounded ;;
          *) die '--resources requires heavy or bounded' ;;
        esac
        shift 2
        ;;
      --heavy|--unlimited) require_unbounded_ceiling; seconds=null; cpu=null; memory=null; swap=null; pids=null; file_size=null; tmp_bytes=null; home_bytes=null; shift ;;
      --bounded) select_bounded; shift ;;
      --timeout) (( $# >= 2 )) || die '--timeout requires seconds'; seconds=$2; shift 2 ;;
      --cpu-percent) (( $# >= 2 )) || die '--cpu-percent requires an integer'; cpu=$2; shift 2 ;;
      --memory-mib) (( $# >= 2 )) || die '--memory-mib requires an integer'; memory=$2; shift 2 ;;
      --swap-mib) (( $# >= 2 )) || die '--swap-mib requires an integer'; swap=$2; shift 2 ;;
      --pids) (( $# >= 2 )) || die '--pids requires an integer'; pids=$2; shift 2 ;;
      --file-size-mib)
        (( $# >= 2 )) || die '--file-size-mib requires an integer'; raw=$2
        [[ $raw =~ ^[1-9][0-9]*$ && ${#raw} -le 7 ]] || die '--file-size-mib requires a canonical positive integer'
        (( raw <= absolute_storage_mib )) || die "file size must not exceed $absolute_storage_mib MiB"
        file_size=$((raw * 1024 * 1024)); shift 2
        ;;
      --tmp-mib)
        (( $# >= 2 )) || die '--tmp-mib requires an integer'; raw=$2
        [[ $raw =~ ^[1-9][0-9]*$ && ${#raw} -le 7 ]] || die '--tmp-mib requires a canonical positive integer'
        (( raw <= absolute_storage_mib )) || die "tmp size must not exceed $absolute_storage_mib MiB"
        tmp_bytes=$((raw * 1024 * 1024)); shift 2
        ;;
      --home-mib)
        (( $# >= 2 )) || die '--home-mib requires an integer'; raw=$2
        [[ $raw =~ ^[1-9][0-9]*$ && ${#raw} -le 7 ]] || die '--home-mib requires a canonical positive integer'
        (( raw <= absolute_storage_mib )) || die "home size must not exceed $absolute_storage_mib MiB"
        home_bytes=$((raw * 1024 * 1024)); shift 2
        ;;
      --seal)
        (( $# >= 2 )) || die '--seal requires a sealed-input id'
        validate_evidence_id "$2"
        sealed_inputs+=("$2")
        shift 2
        ;;
      --drop-seals) sealed_inputs=(); shift ;;
      --result)
        (( $# >= 2 )) || die '--result requires a workspace-relative path'
        [[ -n $2 && $2 != /* && $2 != *$'\n'* && $2 != *$'\r'* ]] ||
          die '--result requires a bounded workspace-relative path'
        case "/$2/" in */../*|*/./*|*//* ) die '--result contains an unsafe path component' ;; esac
        result_paths+=("$2")
        shift 2
        ;;
      --receipt) request_report_receipt=true; shift ;;
      --receipt-fd)
        (( $# >= 2 )) || die '--receipt-fd requires an open descriptor number'
        [[ $2 =~ ^[0-9]{1,4}$ ]] ||
          die '--receipt-fd requires an open descriptor from 3 through 1024'
        (( 10#$2 >= 3 && 10#$2 <= 1024 )) ||
          die '--receipt-fd requires an open descriptor from 3 through 1024'
        [[ -e /proc/"$BASHPID"/fd/"$2" ]] ||
          die '--receipt-fd requires an open descriptor from 3 through 1024'
        request_receipt_fd=$2
        request_report_receipt=true
        shift 2
        ;;
      --cwd) (( $# >= 2 )) || die '--cwd requires a relative directory'; cwd=$2; shift 2 ;;
      --) shift; break ;;
      *) die "unknown run option before --: $1" ;;
    esac
  done
  case "$profile" in minimal|python|node|build) ;; *) die 'tools profile must be minimal, python, node, or build' ;; esac
  if is_nested; then
    case "$parent_profile:$profile" in
      minimal:minimal|python:minimal|python:python|node:minimal|node:node|build:minimal|build:python|build:node|build:build) ;;
      *) die "tools profile exceeds parent ceiling $parent_profile" ;;
    esac
  fi
  case "$network" in none|delegated) ;; *) die 'network must be none or delegated' ;; esac
  validate_value "$seconds" "$max_seconds" timeout 1 "$absolute_timeout"
  validate_value "$cpu" "$max_cpu" 'CPU percent' 1 "$absolute_cpu"
  validate_value "$memory" "$max_memory" 'memory MiB' 32 "$absolute_memory"
  validate_value "$swap" "$max_swap" 'swap MiB' 0 "$absolute_swap"
  validate_value "$pids" "$max_pids" pids 8 "$absolute_pids"
  validate_value "$file_size" "$max_file" 'file size bytes' 1048576 "$((absolute_storage_mib * 1024 * 1024))"
  validate_value "$tmp_bytes" "$max_tmp" 'tmp bytes' 1048576 "$((absolute_storage_mib * 1024 * 1024))"
  validate_value "$home_bytes" "$max_home" 'home bytes' 1048576 "$((absolute_storage_mib * 1024 * 1024))"
  classify_resources
  if ! is_nested && [[ $network == delegated ]]; then
    [[ $($jq_bin -r '.network.delegated_available' "$contract") == true ]] || \
      die 'delegated network was not authorized for this outer launch'
  fi
  (( ${#sealed_inputs[@]} <= seal_max_count )) ||
    die "an action may mount at most $seal_max_count sealed inputs"
  (( ${#result_paths[@]} <= result_max_count )) ||
    die "an action may request at most $result_max_count result hashes"
  if (( ${#sealed_inputs[@]} )); then
    request_seals_json=$(printf '%s\n' "${sealed_inputs[@]}" | "$jq_bin" -Rsc 'split("\n")[:-1]')
  fi
  if (( ${#result_paths[@]} )); then
    request_results_json=$(printf '%s\n' "${result_paths[@]}" | "$jq_bin" -Rsc 'split("\n")[:-1]')
  fi
  request_action "$workspace" "$profile" "$network" "$resources" "$seconds" "$cwd" "$cpu" "$memory" "$swap" \
    "$pids" "$file_size" "$tmp_bytes" "$home_bytes" "$@"
}

depth_probe() {
  is_nested || die 'depth probe is available only inside a recursive grant'
  local depth max output
  depth=$($jq_bin -er '.depth' /run/sand-jail/grant.json)
  max=$($jq_bin -er '.max_depth' /run/sand-jail/grant.json)
  if ((depth < max)); then
    # A successful child is the authenticated, read-only proof for the next
    # depth: the helper is mounted from the broker-owned executable and cannot
    # return zero until its own child (or the exact terminal rejection) passed.
    # Do not relay a sentinel through every transient service. systemd-run
    # --pipe is allowed to close a completed service's stream independently of
    # its status, which made bare-metal self-tests intermittently lose a valid
    # depth-5 sentinel while unwinding. Status is the protocol; only this layer
    # emits the sentinel consumed by its direct parent.
    run_command -- sandcodex-jail __depth-probe >/dev/null
    printf 'depth-max-ok\n'
  else
    if output=$(run_command -- true 2>&1); then die 'recursive jail exceeded its depth budget'; fi
    [[ $output == *"recursive jail depth exhausted at $max"* ]] || die 'depth exhaustion did not fail closed'
    printf 'depth-max-ok\n'
  fi
}

self_test() (
  is_nested && die 'run self-test from the primary Sandcodex layer'
  local json=0
  case "${1:-}" in --json) json=1 ;; '') ;; *) die 'self-test accepts only --json' ;; esac
  local name="selftest-$$" path='' output heavy_output='' abi default_resources
  local ceiling_timeout ceiling_cpu ceiling_memory ceiling_swap ceiling_pids ceiling_file ceiling_tmp ceiling_home
  local test_timeout test_cpu test_memory test_swap test_pids test_file test_tmp test_home test_resources=custom
  local heavy_verified=false
  self_narrow() {
    local ceiling=$1 preset=$2
    if [[ $ceiling == null ]] || (( ceiling > preset )); then printf '%s\n' "$preset"; else printf '%s\n' "$ceiling"; fi
  }
  cleanup_self_test() {
    local status=$?
    trap - EXIT INT TERM HUP
    exec 9<&- 2>/dev/null || true
    if [[ -n $path ]]; then
      workspace_command retire "$name" --receipt >/dev/null 2>&1 || true
      workspace_command purge "$name" --receipt >/dev/null 2>&1 || true
    fi
    exit "$status"
  }
  trap cleanup_self_test EXIT INT TERM HUP
  path=$(workspace_command create "$name" --role diagnostic)
  printf 'input-ok\n' >"$path/input"
  default_resources=$($jq_bin -er '.default.resources' "$contract")
  ceiling_timeout=$($jq_bin -r '.launch_ceiling.deadline_seconds // "null"' "$contract")
  ceiling_cpu=$($jq_bin -r '.launch_ceiling.cpu_percent // "null"' "$contract")
  ceiling_memory=$($jq_bin -r '.launch_ceiling.memory_mib // "null"' "$contract")
  ceiling_swap=$($jq_bin -r '.launch_ceiling.memory_swap_mib // "null"' "$contract")
  ceiling_pids=$($jq_bin -r '.launch_ceiling.pids // "null"' "$contract")
  ceiling_file=$($jq_bin -r '.launch_ceiling.file_size_bytes // "null"' "$contract")
  ceiling_tmp=$($jq_bin -r '.launch_ceiling.tmp_bytes // "null"' "$contract")
  ceiling_home=$($jq_bin -r '.launch_ceiling.home_bytes // "null"' "$contract")
  test_timeout=$(self_narrow "$ceiling_timeout" "$bounded_timeout")
  test_cpu=$(self_narrow "$ceiling_cpu" "$bounded_cpu")
  test_memory=$(self_narrow "$ceiling_memory" "$bounded_memory")
  test_swap=$(self_narrow "$ceiling_swap" "$bounded_swap")
  test_pids=$(self_narrow "$ceiling_pids" "$bounded_pids")
  test_file=$(self_narrow "$ceiling_file" "$bounded_file_size_bytes")
  test_tmp=$(self_narrow "$ceiling_tmp" "$bounded_tmp_bytes")
  test_home=$(self_narrow "$ceiling_home" "$bounded_home_bytes")
  if [[ $test_timeout == "$bounded_timeout" && $test_cpu == "$bounded_cpu" &&
    $test_memory == "$bounded_memory" && $test_swap == "$bounded_swap" &&
    $test_pids == "$bounded_pids" && $test_file == "$bounded_file_size_bytes" &&
    $test_tmp == "$bounded_tmp_bytes" && $test_home == "$bounded_home_bytes" ]]; then
    test_resources=bounded
  fi
  exec 9<"$data_root/landlock-canary"
  output=$(request_action "$name" minimal none "$test_resources" "$test_timeout" . \
    "$test_cpu" "$test_memory" "$test_swap" "$test_pids" \
    "$test_file" "$test_tmp" "$test_home" bash -c '
    set -Eeuo pipefail
    timeout=$1; cpu=$2; memory=$3; swap=$4; pids=$5; file_size=$6; tmp_bytes=$7; home_bytes=$8
    [[ $(<input) == input-ok && $EUID == 65534 ]]
    [[ $HOME == /home/worker && $PATH == /run/sand-jail/bin:/tools/bin && $SAND_JAIL_NETWORK == none ]]
    [[ $SAND_JAIL_DEPTH == 1 && $SAND_JAIL_MAX_DEPTH == 5 ]]
    if cat /run/landlock-canary >/dev/null 2>&1; then exit 80; fi
    [[ ! -e /home/h0p3 && ! -e /root && ! -e /var && ! -e /nix/var ]]
    [[ ! -e /proc/self/fd/9 ]]
    status=$(</proc/self/status)
    [[ $status == *$'"'"'CapEff:\t0000000000000000'"'"'* && $status == *$'"'"'NoNewPrivs:\t1'"'"'* ]]
    [[ $status == *$'"'"'Seccomp:\t2'"'"'* ]]
    jq -e --argjson timeout "$timeout" --argjson cpu "$cpu" --argjson memory "$memory" \
      --argjson swap "$swap" --argjson pids "$pids" --argjson fileSize "$file_size" \
      --argjson tmpBytes "$tmp_bytes" --argjson homeBytes "$home_bytes" \
      '"'"'.enforced == true and .depth == 1 and .deadline_seconds == $timeout and
      .cpu_percent == $cpu and .memory_mib == $memory and .memory_swap_mib == $swap and
      .memory_swap_bytes == ($swap * 1048576) and .pids == $pids and
      .file_size_bytes == $fileSize and .tmp_bytes == $tmpBytes and .home_bytes == $homeBytes'"'"' \
      /run/sand-jail/limits.json >/dev/null
    [[ $(/run/sand-jail/seccomp-exec --self-test) == seccomp-leaf-ok ]]
    [[ $(sandcodex-jail __depth-probe) == depth-max-ok ]]
    if (printf escaped > /root-escape) 2>/dev/null; then exit 81; fi
    if ({ exec 8<>/dev/tcp/1.1.1.1/443; } 2>/dev/null); then exit 82; fi
    if (trap "" XFSZ; truncate -s "$((file_size + 1))" oversized) 2>/dev/null; then exit 83; fi
    [[ ! -e oversized || $(stat -c %s -- oversized) -le file_size ]]
    printf output-ok >output
    printf self-test-ok
  ' sand-jail-self-test "$test_timeout" "$test_cpu" "$test_memory" "$test_swap" \
    "$test_pids" "$test_file" "$test_tmp" "$test_home")
  exec 9<&-
  [[ $output == self-test-ok && $(<"$path/output") == output-ok ]] || die 'inner-jail self-test produced an invalid result'
  if [[ $default_resources == heavy ]]; then
    heavy_output=$(request_action "$name" minimal none heavy null . null null null null null null null bash -c '
      set -Eeuo pipefail
      jq -e '"'"'.resource_profile == "heavy" and .enforced == false and .deadline_seconds == null and
        .cpu_percent == null and .memory_mib == null and .memory_swap_mib == null and
        .memory_swap_bytes == null and .pids == null and .file_size_bytes == null and
        .tmp_bytes == null and .home_bytes == null'"'"' \
        /run/sand-jail/limits.json >/dev/null
      [[ $(ulimit -f) == unlimited && $SAND_JAIL_RESOURCES == heavy ]]
      truncate -s 268435456 heavy-sparse
      [[ $(stat -c %s -- heavy-sparse) == 268435456 ]]
      rm heavy-sparse
      printf heavy-self-test-ok
    ')
    [[ $heavy_output == heavy-self-test-ok ]] || die 'heavy inner-jail self-test produced an invalid result'
    heavy_verified=true
  fi
  abi=$(landlock_abi)
  workspace_command retire "$name" --receipt >/dev/null
  workspace_command purge "$name" --receipt >/dev/null
  path=''
  if ((json)); then
    "$jq_bin" -n --arg schema sand-jail.self-test.v3 --arg product "$product" \
      --arg defaultResources "$default_resources" --arg testResources "$test_resources" \
      --argjson heavyVerified "$heavy_verified" --argjson abi "$abi" --argjson depth "$depth_max" \
      --argjson timeout "$test_timeout" --argjson cpu "$test_cpu" --argjson memory "$test_memory" \
      --argjson swap "$test_swap" --argjson pids "$test_pids" --argjson fileSize "$test_file" \
      --argjson tmpBytes "$test_tmp" --argjson homeBytes "$test_home" \
      '{schema:$schema,product:$product,result:"ok",fresh_root:true,
        workdir_write:true,host_paths_absent:true,inherited_fds_closed:true,environment_cleared:true,
        network:"none",direct_egress_blocked:true,file_size_limit_bytes:$fileSize,
        uid:65534,capabilities:"empty",no_new_privileges:true,further_user_namespaces:"disabled",
        default_resources:$defaultResources,heavy:{verified:$heavyVerified,sandcodex_limits:false,cpu_percent:null,
          memory_mib:null,memory_swap_bytes:null,pids:null,timeout_seconds:null,file_size_bytes:null},
        bounded:{verified:true,effective_profile:$testResources,deadline_seconds:$timeout,
          cpu_percent:$cpu,memory_mib:$memory,memory_swap_mib:$swap,
          memory_swap_bytes:($swap * 1048576),pids:$pids,file_size_bytes:$fileSize,
          tmp_bytes:$tmpBytes,home_bytes:$homeBytes},
        cgroup:{enforced:true,resource_profile:$testResources,cpu_percent:$cpu,memory_mib:$memory,
          memory_swap_bytes:($swap * 1048576),pids:$pids},
        seccomp:{enforced:true,mode:2,unshare_denied:true,keyring_denied:true,bpf_denied:true,
          clone3_namespace_path_denied:true,unix_socketpair_allowed:true},
        recursion:{enforced:true,max_depth:$depth,maximum_passed:true,exhaustion_failed_closed:true},
        landlock:{enforced:true,read_denied:true,write_denied:true,abi:$abi}}'
  else
    printf 'ok - fresh root, work-only writes, closed descriptors, empty ambient environment\n'
    printf 'ok - bounded cgroup/deadline/file limits and heavy max/unlimited posture both verified\n'
    printf 'ok - leaf seccomp, Landlock ABI %s, no-new-privileges, and disabled user namespaces\n' "$abi"
    printf 'ok - recursive grants passed through depth %s and depth exhaustion failed closed\n' "$depth_max"
  fi
)

require_runtime
case "${1:---help}" in
  inspect) shift; inspect_contract "$@" ;;
  capability-card|card) shift; capability_card "$@" ;;
  workspace) shift; workspace_command "$@" ;;
  seal) shift; seal_command "$@" ;;
  receipt) shift; receipt_command "$@" ;;
  run) shift; run_command "$@" ;;
  self-test) shift; self_test "$@" ;;
  __depth-probe) shift; (( $# == 0 )) || die 'invalid depth probe'; depth_probe ;;
  __broker-exec) shift; (( $# == 1 )) || die 'invalid broker executor request'; broker_execute "$1" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $1" ;;
esac
SANDCODEX_INNER_JAIL_HELPER_BODY_SH
}

sc_write_inner_jail_helper() {
  local helper="$SC_AGENT_BIN/sandcodex-jail" tmp bash_bin python_bin
  local chmod_bin find_bin findmnt_bin jq_bin mkdir_bin mktemp_bin realpath_bin rm_bin sleep_bin sort_bin stat_bin
  bash_bin=$(type -P bash)
  python_bin=$(type -P python3)
  chmod_bin=$(type -P chmod)
  find_bin=$(type -P find)
  findmnt_bin=$(type -P findmnt)
  jq_bin=$(type -P jq)
  mkdir_bin=$(type -P mkdir)
  mktemp_bin=$(type -P mktemp)
  realpath_bin=$(type -P realpath)
  rm_bin=$(type -P rm)
  sleep_bin=$(type -P sleep)
  sort_bin=$(type -P sort)
  stat_bin=$(type -P stat)
  tmp=$(mktemp "$SC_AGENT_BIN/.sandcodex-jail.XXXXXX")
  {
    printf '#!%s -p\nset -Eeuo pipefail\nshopt -s inherit_errexit nullglob\numask 077\n' "$bash_bin"
    printf 'readonly product=sandcodex\nreadonly protocol=sand-jail.v3\n'
    printf 'readonly bounded_file_size_bytes=134217728\nreadonly bounded_tmp_bytes=33554432\nreadonly bounded_home_bytes=16777216\n'
    printf 'readonly bounded_cpu=%q\nreadonly bounded_memory=%q\nreadonly bounded_pids=%q\n' \
      "$SC_JAIL_BOUNDED_CPU_PERCENT" "$SC_JAIL_BOUNDED_MEMORY_MIB" "$SC_JAIL_BOUNDED_PIDS"
    printf 'readonly bounded_timeout=%q\nreadonly bounded_swap=%q\nreadonly depth_max=%q\n' \
      "$SC_JAIL_BOUNDED_TIMEOUT" "$SC_JAIL_BOUNDED_SWAP_MIB" "$SC_JAIL_RECURSION_MAX"
    printf 'readonly absolute_timeout=%q\nreadonly absolute_cpu=%q\nreadonly absolute_memory=%q\n' \
      "$SC_JAIL_MAX_TIMEOUT" "$SC_JAIL_MAX_CPU_PERCENT" "$SC_JAIL_MAX_MEMORY_MIB"
    printf 'readonly absolute_swap=%q\nreadonly absolute_pids=%q\nreadonly absolute_storage_mib=%q\n' \
      "$SC_JAIL_MAX_SWAP_MIB" "$SC_JAIL_MAX_PIDS" "$SC_JAIL_MAX_STORAGE_MIB"
    printf 'readonly data_root=%q\nreadonly contract=%q\nreadonly workspace_root=%q\nreadonly cache_root=%q\n' \
      "$SC_JAIL_DATA" "$SC_JAIL_ENV" "$SC_JAIL_WORKSPACES" "$SC_JAIL_CACHES"
    printf 'readonly project_root=%q\nreadonly sealed_root=%q\nreadonly receipt_root=%q\n' \
      "$SC_PROJECT" "$SC_JAIL_SEALED_INPUTS" "$SC_JAIL_RECEIPTS"
    printf 'readonly seal_max_count=%q\nreadonly result_max_count=%q\nreadonly result_max_bytes=%q\n' \
      "$SC_JAIL_SEAL_MAX_COUNT" "$SC_JAIL_RESULT_MAX_COUNT" "$SC_JAIL_RESULT_MAX_BYTES"
    printf 'readonly broker_root=%q\nreadonly broker_socket=%q\nreadonly relay_root=%q\nreadonly helper_host=%q\n' \
      "$SC_JAIL_BROKER_ROOT" "$SC_JAIL_BROKER_SOCKET" "$SC_JAIL_RELAY_ROOT" "$helper"
    printf 'readonly bwrap_bin=%q\nreadonly landrun_bin=%q\nreadonly socat_bin=%q\n' \
      "$SC_BWRAP" "$SC_LANDRUN" "$SC_SOCAT"
    printf 'readonly bash_bin=%q\nreadonly python_bin=%q\n' "$bash_bin" "$python_bin"
    printf 'readonly chmod_bin=%q\n' "$chmod_bin"
    printf 'readonly find_bin=%q\nreadonly findmnt_bin=%q\nreadonly jq_bin=%q\n' \
      "$find_bin" "$findmnt_bin" "$jq_bin"
    printf 'readonly mkdir_bin=%q\nreadonly mktemp_bin=%q\nreadonly realpath_bin=%q\n' \
      "$mkdir_bin" "$mktemp_bin" "$realpath_bin"
    printf 'readonly rm_bin=%q\nreadonly sleep_bin=%q\nreadonly sort_bin=%q\nreadonly stat_bin=%q\n' \
      "$rm_bin" "$sleep_bin" "$sort_bin" "$stat_bin"
    sc_emit_inner_jail_helper_body
  } >"$tmp"
  chmod 500 -- "$tmp"
  "$bash_bin" -n "$tmp" || sc_jail_fatal 'generated inner-jail helper failed its syntax check'
  mv -fT -- "$tmp" "$helper"
}

sc_prepare_jail_storage_budget() {
  [[ "$SC_JAIL_STORAGE_BUDGET_MIB" != null ]] || return 0
  local group_root metadata image_tmp fusermount expected_bytes mounted=0
  group_root="$SC_GLOBAL/jail-storage/$SC_PROJECT_KEY/$SC_JAIL_BUDGET_GROUP"
  SC_JAIL_STORAGE_IMAGE="$group_root/storage.ext4"
  SC_JAIL_STORAGE_MOUNT="$SC_WORK/inner-jail/storage-budget"
  SC_JAIL_STORAGE_REGISTRY="$group_root/registry"
  sc_ensure_dir "$SC_GLOBAL/jail-storage" "jail storage root"
  sc_ensure_dir "$SC_GLOBAL/jail-storage/$SC_PROJECT_KEY" "project jail storage root"
  sc_ensure_dir "$group_root" "jail storage budget group"
  sc_ensure_dir "$SC_WORK/inner-jail" "inner-jail state"
  sc_ensure_dir "$SC_JAIL_STORAGE_MOUNT" "jail storage mountpoint"
  sc_ensure_dir "$SC_JAIL_STORAGE_REGISTRY" "jail workspace registry"
  metadata="$group_root/group.json"
  expected_bytes=$((SC_JAIL_STORAGE_BUDGET_MIB * 1024 * 1024))
  if mountpoint -q -- "$SC_JAIL_STORAGE_MOUNT"; then
    fusermount="$(command -v fusermount3 2>/dev/null || true)"
    [[ -x /run/wrappers/bin/fusermount3 ]] && fusermount=/run/wrappers/bin/fusermount3
    [[ -n "$fusermount" ]] || sc_die "cannot reclaim the previous jail storage mount"
    "$fusermount" -u -- "$SC_JAIL_STORAGE_MOUNT" ||
      sc_die "cannot reclaim the previous jail storage mount: $SC_JAIL_STORAGE_MOUNT"
  fi
  if [[ -e "$SC_JAIL_STORAGE_IMAGE" || -L "$SC_JAIL_STORAGE_IMAGE" ]]; then
    sc_owned_single_file "$SC_JAIL_STORAGE_IMAGE" 600 "jail storage image"
    [[ -f "$metadata" && ! -L "$metadata" ]] ||
      sc_die "jail storage group metadata is missing"
    jq -e --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" --arg group "$SC_JAIL_BUDGET_GROUP" \
      --argjson maximum "$expected_bytes" '
        .schema == $schema and .kind == "jail-storage-budget-group" and
        .project == $project and .project_key == $key and .group == $group and
        .maximum_bytes == $maximum and .metering == "fixed-ext4-filesystem-capacity"
      ' "$metadata" >/dev/null ||
      sc_die "jail storage group does not match this project or requested budget"
  else
    [[ ! -e "$metadata" && ! -L "$metadata" ]] ||
      sc_die "jail storage metadata exists without its image"
    image_tmp="$(mktemp "$group_root/.storage.XXXXXX")"
    chmod 600 -- "$image_tmp"
    truncate -s "$expected_bytes" -- "$image_tmp"
    if ! mkfs.ext4 -F -q -m 0 -O '^has_journal' \
      -E "root_owner=$(id -u):$(id -g)" -- "$image_tmp"; then
      rm -f -- "$image_tmp"
      sc_die "could not initialize the hard jail storage budget"
    fi
    mv -fT -- "$image_tmp" "$SC_JAIL_STORAGE_IMAGE"
    jq -n --arg schema "$SC_SCHEMA" --arg project "$SC_PROJECT" \
      --arg key "$SC_PROJECT_KEY" --arg group "$SC_JAIL_BUDGET_GROUP" \
      --arg created "$(sc_now)" --argjson maximum "$expected_bytes" '{
        schema:$schema,kind:"jail-storage-budget-group",project:$project,
        project_key:$key,group:$group,maximum_bytes:$maximum,
        metering:"fixed-ext4-filesystem-capacity",created_at:$created
      }' | sc_atomic "$metadata" 600
  fi
  ( sc_close_inherited_fds
    exec fuse2fs "$SC_JAIL_STORAGE_IMAGE" "$SC_JAIL_STORAGE_MOUNT" \
      -o fakeroot,default_permissions,noatime
  ) >/dev/null 2>&1 ||
    sc_die "could not mount the hard jail storage budget"
  for _ in {1..100}; do
    if mountpoint -q -- "$SC_JAIL_STORAGE_MOUNT"; then mounted=1; break; fi
    sleep 0.02
  done
  (( mounted )) || sc_die "hard jail storage budget did not become active"
  SC_JAIL_STORAGE_MOUNTED=1
  SC_JAIL_WORKSPACES="$SC_JAIL_STORAGE_MOUNT/workspaces"
  SC_JAIL_CACHES="$SC_JAIL_STORAGE_MOUNT/caches"
  mkdir -p -- "$SC_JAIL_WORKSPACES" "$SC_JAIL_CACHES"
  chmod 700 -- "$SC_JAIL_WORKSPACES" "$SC_JAIL_CACHES"
  sc_note "inner-jail storage · group $SC_JAIL_BUDGET_GROUP · hard limit ${SC_JAIL_STORAGE_BUDGET_MIB} MiB"
}

sc_remove_legacy_jail_storage_guards() {
  local parent guard path existing=0
  local -a paths=()
  for parent in "$SC_JAIL_WORKSPACES" "$SC_JAIL_CACHES"; do
    for guard in .git .agents .codex; do
      path="$parent/$guard"
      if [[ -e "$path" || -L "$path" ]]; then
        paths+=("$path")
        ((existing += 1))
      fi
    done
  done
  (( existing > 0 )) || return 0
  for path in "${paths[@]}"; do
    [[ -d "$path" && ! -L "$path" && "$(sc_owner_uid "$path")" == "$EUID" &&
      "$(sc_mode_octal "$path")" == 555 &&
      -z "$(find "$path" -mindepth 1 -print -quit)" ]] ||
      sc_jail_fatal "persistent storage contains an unsafe legacy guard: $path"
    if findmnt -rn --mountpoint "$path" >/dev/null 2>&1; then
      sc_jail_fatal "persistent storage legacy guard is an active host mount: $path"
    fi
  done
  for path in "${paths[@]}"; do
    chmod 700 -- "$path"
    rmdir -- "$path"
  done
  sc_log_event info inner_jail_storage \
    "removed obsolete persistent-root guards" "count=$existing"
}

