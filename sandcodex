sc_gemini_keybank_mutate() {
  local action=$1 path parent key="" input_path="" result rc=0 selector
  path="$(sc_gemini_keybank_path)"
  sc_no_line_breaks "$path" "Gemini key bank path"
  parent="$(dirname -- "$path")"
  sc_no_symlink_components "$parent" "Gemini key-bank parent"
  if [[ "$parent" == "$SC_GLOBAL/remote" ]]; then
    sc_ensure_dir "$parent" "remote provider state"
  else
    sc_owned_dir "$parent" "Gemini key-bank parent"
    [[ "$(stat -c %a -- "$parent")" == 700 ]] ||
      sc_die "Gemini key-bank parent permissions are not 0700: $parent" 78
  fi
  sc_no_symlink_components "$path" "Gemini key bank"
  if [[ -e "$path" || -L "$path" ]]; then
    sc_owned_single_file "$path" 600 "Gemini key bank"
  fi

  case "$action" in
    add)
      if [[ -n "$SC_GEMINI_KEY_INPUT_FILE" ]]; then
        input_path="$SC_GEMINI_KEY_INPUT_FILE"
        sc_no_line_breaks "$input_path" "Gemini key import path"
        [[ "$input_path" == /* ]] || input_path="$PWD/$input_path"
        input_path="$(realpath -ms -- "$input_path")"
        key="$(sc_gemini_read_key_file "$input_path")"
      elif (( SC_GEMINI_KEY_STDIN )); then
        IFS= read -r key || sc_die "Gemini key input on stdin is empty" 64
      else
        [[ -r /dev/tty && -w /dev/tty ]] ||
          sc_die "Gemini key input needs a terminal, --stdin, or --from-file FILE" 64
        printf 'Gemini API key (input hidden): ' >/dev/tty
        if ! IFS= read -r -s key </dev/tty; then
          printf '\n' >/dev/tty
          sc_die "Gemini key input was cancelled" 64
        fi
        printf '\n' >/dev/tty
      fi
      [[ "$key" =~ ^(AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})$ ]] || {
        key=""
        sc_die "Gemini API key has an unsupported shape" 78
      }
      ;;
    remove)
      selector="$SC_GEMINI_KEY_LABEL"
      [[ -n "$selector" ]] || selector="$SC_GEMINI_KEY_ID"
      sc_confirm_delete "Gemini key $selector from $path"
      ;;
    *) sc_die "internal Gemini key-bank mutation action is invalid" 70 ;;
  esac

  result="$(python3 -P - "$path" "$action" "$SC_GEMINI_KEY_LABEL" "$SC_GEMINI_KEY_ID" 3<<<"$key" <<'PY'
import fcntl
import hashlib
import json
import os
import re
import secrets
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
action, requested_label, requested_id = sys.argv[2:]
uid = os.getuid()
KEY = re.compile(r"^(?:AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})$")
LABEL = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")
KEY_ID = re.compile(r"^[0-9a-f]{12}$")
MAX_BANK = 1024 * 1024

def fail(message):
    print(f"sandcodex: {message}", file=sys.stderr)
    raise SystemExit(78)

def checked_regular(fd, label, mode=0o600):
    meta = os.fstat(fd)
    if not stat.S_ISREG(meta.st_mode) or meta.st_uid != uid or meta.st_nlink != 1:
        fail(f"{label} metadata is unsafe")
    if stat.S_IMODE(meta.st_mode) != mode:
        fail(f"{label} permissions are not 0{mode:o}")
    if meta.st_size > MAX_BANK:
        fail(f"{label} exceeds {MAX_BANK} bytes")
    return meta

parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
lock_fd = -1
try:
    lock_flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    lock_fd = os.open(f".{path.name}.lock", lock_flags, 0o600, dir_fd=parent_fd)
    checked_regular(lock_fd, "Gemini key-bank lock")
    fcntl.flock(lock_fd, fcntl.LOCK_EX)

    try:
        bank_fd = os.open(path.name, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0), dir_fd=parent_fd)
    except FileNotFoundError:
        raw = ""
    else:
        try:
            meta = checked_regular(bank_fd, "Gemini key bank")
            with os.fdopen(bank_fd, "r", encoding="utf-8", closefd=False) as bank_stream:
                raw = bank_stream.read(meta.st_size + 1)
        except UnicodeError:
            fail("Gemini key bank is not UTF-8")
        finally:
            os.close(bank_fd)

    rows = []
    seen_keys = set()
    seen_labels = set()
    for number, source in enumerate(raw.splitlines(), 1):
        line = source.strip()
        if not line or line.startswith("#"):
            continue
        label, key = "", line
        if "=" in line and not line.startswith(("AIza", "AQ.")):
            label, key = (part.strip() for part in line.split("=", 1))
        else:
            parts = line.split()
            if len(parts) == 2 and KEY.fullmatch(parts[1]):
                label, key = parts
        if not KEY.fullmatch(key) or (label and not LABEL.fullmatch(label)):
            fail(f"Gemini key bank has an invalid entry on line {number}")
        digest = hashlib.sha256(key.encode()).hexdigest()
        if digest in seen_keys:
            fail(f"Gemini key bank repeats a credential on line {number}")
        if not label:
            label = f"key-{len(rows) + 1:02d}"
        if label in seen_labels:
            fail(f"Gemini key bank repeats label {label}")
        seen_keys.add(digest)
        seen_labels.add(label)
        rows.append({"label": label, "key": key, "key_id": digest[:12]})

    affected = None
    changed = False
    result_name = "unchanged"
    if action == "add":
        with os.fdopen(3, "r", encoding="utf-8", closefd=False) as secret_stream:
            secret = secret_stream.read(4097).strip()
        if len(secret) > 4096 or not KEY.fullmatch(secret):
            fail("Gemini API key has an unsupported shape")
        digest = hashlib.sha256(secret.encode()).hexdigest()
        duplicate = next((row for row in rows if row["key_id"] == digest[:12] and
                          hashlib.sha256(row["key"].encode()).hexdigest() == digest), None)
        if duplicate is not None:
            if requested_label and requested_label != duplicate["label"]:
                fail(f"Gemini credential already exists as label {duplicate['label']}")
            affected = {"label": duplicate["label"], "key_id": duplicate["key_id"]}
            result_name = "already_present"
        else:
            label = requested_label
            if label:
                if not LABEL.fullmatch(label):
                    fail("Gemini key label is invalid")
                if label in seen_labels:
                    fail(f"Gemini key label already exists: {label}")
            else:
                index = 1
                while f"key-{index:02d}" in seen_labels:
                    index += 1
                label = f"key-{index:02d}"
            rows.append({"label": label, "key": secret, "key_id": digest[:12]})
            affected = {"label": label, "key_id": digest[:12]}
            changed = True
            result_name = "added"
    elif action == "remove":
        if bool(requested_label) == bool(requested_id):
            fail("Gemini key removal requires exactly one label or key ID")
        if requested_label and not LABEL.fullmatch(requested_label):
            fail("Gemini key label is invalid")
        if requested_id and not KEY_ID.fullmatch(requested_id):
            fail("Gemini key ID is invalid")
        matches = [row for row in rows if
                   (requested_label and row["label"] == requested_label) or
                   (requested_id and row["key_id"] == requested_id)]
        if len(matches) != 1:
            fail("Gemini key selector matched no unique credential")
        matched = matches[0]
        rows = [row for row in rows if row is not matched]
        affected = {"label": matched["label"], "key_id": matched["key_id"]}
        changed = True
        result_name = "removed"
    else:
        fail("internal Gemini key-bank mutation action is invalid")

    if changed:
        payload = "".join(f"{row['label']}={row['key']}\n" for row in rows).encode()
        tmp_name = f".{path.name}.tmp.{secrets.token_hex(12)}"
        tmp_fd = -1
        try:
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
            tmp_fd = os.open(tmp_name, flags, 0o600, dir_fd=parent_fd)
            with os.fdopen(tmp_fd, "wb", closefd=False) as stream:
                stream.write(payload)
                stream.flush()
            os.fsync(tmp_fd)
            os.close(tmp_fd)
            tmp_fd = -1
            os.replace(tmp_name, path.name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
            os.fsync(parent_fd)
        finally:
            if tmp_fd >= 0:
                os.close(tmp_fd)
            try:
                os.unlink(tmp_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass

    print(json.dumps({
        "schema": "sandcodex.gemini-key-bank-mutation.v1",
        "result": result_name,
        "action": action,
        "changed": changed,
        "path": str(path),
        "key_count": len(rows),
        "affected": affected,
        "credential_values_disclosed": False,
    }, sort_keys=True, separators=(",", ":")))
finally:
    if lock_fd >= 0:
        os.close(lock_fd)
    os.close(parent_fd)
PY
  )" || rc=$?
  key=""
  (( rc == 0 )) || sc_die "Gemini key-bank $action failed" 78
  [[ "$result" != *AIza* && "$result" != *AQ.* ]] || sc_die "Gemini key-bank helper disclosed a credential" 70
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$result"
  else
    jq -r '"Gemini key bank",
      "  result     " + (.result|ascii_upcase),
      "  account    " + .affected.label + " · id " + .affected.key_id,
      "  accounts   " + (.key_count|tostring),
      "  source     " + .path,
      "",
      "privacy",
      "  Credential values are not printed."' <<<"$result"
  fi
}

sc_gemini_keybank_test() {
  local staged path model result_rows='[]' row key_file key key_id key_label probe passed failed total result
  model="$SC_GEMINI_MODEL"
  if (( ! SC_GEMINI_MODEL_EXPLICIT )); then
    model="$SC_GEMINI_KEY_TEST_MODEL"
  fi
  model="$(sc_gemini_model_slug "$model")"
  sc_gemini_require_free_model "$model"
  staged="$(sc_gemini_keybank_stage)"
  path="$(jq -er '.path' <<<"$staged")"
  total=0; passed=0; failed=0
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    key_label="$(jq -er '.label' <<<"$row")"
    if [[ -n "$SC_GEMINI_KEY_LABEL" && "$key_label" != "$SC_GEMINI_KEY_LABEL" ]]; then
      continue
    fi
    key_file="$(jq -er '.credential_file' <<<"$row")"
    key_id="$(jq -er '.key_id' <<<"$row")"
    key="$(sc_gemini_read_key_file "$key_file")"
    probe="$(sc_gemini_probe_generate_content "$key" "$path" "$key_id" "$key_label" "$model")"
    key=""
    sc_gemini_record_result_cooldowns "$probe"
    total=$((total + 1))
    if [[ "$(jq -r '.ok' <<<"$probe")" == true ]]; then
      passed=$((passed + 1))
    else
      failed=$((failed + 1))
    fi
    result_rows="$(jq -cn --argjson rows "$result_rows" --argjson row "$probe" '$rows + [$row]')"
  done < <(jq -c '.keys[]' <<<"$staged")
  sc_gemini_keybank_unstage "$staged"
  (( total > 0 )) || sc_die "Gemini key selector matched no credential" 78
  result="$(jq -cn \
    --arg schema sandcodex.gemini-key-bank-test.v1 \
    --arg provider google-ai-studio --arg tested_at "$(sc_now)" \
    --arg model "$model" --arg path "$path" \
    --argjson total "$total" --argjson passed "$passed" --argjson failed "$failed" \
    --argjson results "$result_rows" '
      {schema:$schema,result:"tested",provider:$provider,tested_at:$tested_at,
       model:$model,key_source:$path,key_count:$total,passed:$passed,failed:$failed,
       ok:($failed==0),keys:$results,credential_values_disclosed:false,
       raw_provider_content_disclosed:false}')"
  [[ "$result" != *AIza* && "$result" != *AQ.* ]] || sc_die "Gemini bank test disclosed a credential" 70
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$result"
  else
    printf 'Gemini key bank test\n'
    printf '  result     %s\n' "$([[ $failed == 0 ]] && printf PASSED || printf FAILED)"
    printf '  model      %s\n' "$model"
    printf '  accounts   %s tested · %s passed · %s failed\n' "$total" "$passed" "$failed"
    printf '\naccounts\n'
    jq -r '.keys[] | "  " + .key_label + " · id " + .key_id + " · HTTP " + (.http_code|tostring) + " · " + (if .ok then "PASSED" else "FAILED" end)' <<<"$result"
    printf '\nprivacy\n  Credential values and raw provider content are not printed.\n'
  fi
  (( failed == 0 ))
}

