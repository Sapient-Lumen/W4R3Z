    def _authorize_hit_test(self, token: str) -> None:
        if self.hit_test_authorized:
            raise RuntimeError("Sway HitTestSeal command connection is already authorized")
        request = canonical_json({"op": "authorize", "token": token})
        with self.command_lock:
            reply = self._request_object_locked(
                SWAY_IPC_SANDCODEX_HIT_TEST,
                request,
                "SANDCODEX_HIT_TEST authorize",
            )
        self._normalize_hit_test_authorization_reply(reply)
        self.hit_test_authorized = True
        self.hit_test_authorizations += 1

    @staticmethod
    def _hit_test_optional_string(value: Any, label: str) -> str | None:
        if value is None:
            return None
        if not isinstance(value, str) or not value or "\x00" in value:
            raise RuntimeError(f"Sway HitTestSeal {label} is invalid")
        if len(value.encode("utf-8", "strict")) > SWAY_HIT_TEST_MAX_STRING_BYTES:
            raise RuntimeError(f"Sway HitTestSeal {label} exceeds its bounded size")
        return value

    def _normalize_hit_test_reply(
        self,
        value: Any,
        expected_x: int,
        expected_y: int,
        *,
        expected_operation: str,
        expected_delta_x: int | None = None,
        expected_delta_y: int | None = None,
    ) -> tuple[dict[str, Any], str | None]:
        """Validate protocol controls and return a ticket-free target identity."""
        if expected_operation not in {"hit-test", "arm-click", "arm-scroll"}:
            raise RuntimeError("unsupported Sway HitTestSeal operation")
        scroll_arm = expected_operation == "arm-scroll"
        if scroll_arm:
            if (
                type(expected_delta_x) is not int
                or type(expected_delta_y) is not int
                or expected_delta_x not in {-1, 0, 1}
                or expected_delta_y not in {-1, 0, 1}
                or (expected_delta_x == 0 and expected_delta_y == 0)
            ):
                raise RuntimeError("Sway HitTestSeal expected scroll vector is invalid")
        elif expected_delta_x is not None or expected_delta_y is not None:
            raise RuntimeError("non-scroll HitTestSeal operation received a scroll vector")
        if not isinstance(value, dict):
            raise RuntimeError("Sway HitTestSeal reply is not an object")
        if value.get("schema") != SWAY_HIT_TEST_SCHEMA:
            raise RuntimeError("Sway HitTestSeal schema is unsupported")
        if value.get("patch_version") != SWAY_HIT_TEST_PATCH_VERSION:
            raise RuntimeError("Sway HitTestSeal patch version is unsupported")
        if value.get("success") is not True:
            raise RuntimeError("patched Sway rejected the authenticated HitTestSeal query")
        if value.get("operation") != expected_operation:
            raise RuntimeError("Sway HitTestSeal operation changed")
        hit = value.get("hit")
        if type(hit) is not bool:
            raise RuntimeError("Sway HitTestSeal hit flag is invalid")
        for field, expected in (("x", expected_x), ("y", expected_y)):
            number = value.get(field)
            if type(number) is not int or number != expected:
                raise RuntimeError(f"Sway HitTestSeal {field} coordinate changed")
        if scroll_arm:
            for field, expected in (
                ("delta_x", expected_delta_x),
                ("delta_y", expected_delta_y),
            ):
                number = value.get(field)
                if type(number) is not int or number != expected:
                    raise RuntimeError(f"Sway HitTestSeal {field} scroll unit changed")

        dispatch_ticket = value.get("dispatch_ticket")
        if expected_operation == "hit-test":
            if dispatch_ticket is not None:
                raise RuntimeError("ordinary Sway HitTestSeal query returned dispatch authority")
            ticket: str | None = None
        else:
            if (
                not isinstance(dispatch_ticket, str)
                or re.fullmatch(
                    rf"[0-9a-f]{{{SWAY_DISPATCH_TICKET_LENGTH}}}", dispatch_ticket
                ) is None
            ):
                raise RuntimeError("Sway compositor dispatch ticket is invalid")
            ticket = dispatch_ticket

        base_fields = {
            "schema", "patch_version", "success", "operation", "hit", "x", "y",
            "dispatch_ticket",
        }
        if scroll_arm:
            base_fields |= {"delta_x", "delta_y"}
        if not hit:
            if set(value) != base_fields:
                raise RuntimeError("Sway HitTestSeal background reply has unexpected fields")
            if expected_operation in {"arm-click", "arm-scroll"}:
                raise RuntimeError("Sway armed compositor input without a target")
            projection = {
                "schema": HIT_TEST_SEAL_SCHEMA,
                "patch_schema": SWAY_HIT_TEST_SCHEMA,
                "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                "hit": False,
                "x": expected_x,
                "y": expected_y,
            }
        else:
            hit_fields = base_fields | {
                "target_kind", "container_id", "view_pid",
                "surface_resource_id", "surface_client_pid",
                "surface_client_uid", "surface_client_gid", "surface_class",
                "shell", "sandbox_engine", "sandbox_app_id",
                "sandbox_instance_id",
            }
            if set(value) != hit_fields:
                raise RuntimeError("Sway HitTestSeal dispatch-target reply has unexpected fields")

            def integer(field: str, minimum: int, maximum: int) -> int:
                number = value.get(field)
                if type(number) is not int or not minimum <= number <= maximum:
                    raise RuntimeError(f"Sway HitTestSeal {field} is invalid")
                return number

            target_kind = value.get("target_kind")
            if target_kind not in {"surface", "decoration"}:
                raise RuntimeError("Sway HitTestSeal target kind is invalid")
            surface_class = value.get("surface_class")
            surface_fields = (
                "surface_resource_id", "surface_client_pid",
                "surface_client_uid", "surface_client_gid",
            )
            if target_kind == "surface":
                if surface_class not in {"toplevel", "child"}:
                    raise RuntimeError("Sway HitTestSeal surface class is invalid")
                surface_resource_id: int | None = integer(
                    "surface_resource_id", 1, (1 << 32) - 1
                )
                surface_client_pid: int | None = integer(
                    "surface_client_pid", 1, (1 << 31) - 1
                )
                surface_client_uid: int | None = integer(
                    "surface_client_uid", 0, (1 << 32) - 1
                )
                surface_client_gid: int | None = integer(
                    "surface_client_gid", 0, (1 << 32) - 1
                )
            else:
                if surface_class != "decoration":
                    raise RuntimeError("Sway HitTestSeal decoration class is invalid")
                if any(value.get(field) is not None for field in surface_fields):
                    raise RuntimeError(
                        "Sway HitTestSeal decoration reply disclosed surface credentials"
                    )
                surface_resource_id = None
                surface_client_pid = None
                surface_client_uid = None
                surface_client_gid = None

            projection = {
                "schema": HIT_TEST_SEAL_SCHEMA,
                "patch_schema": SWAY_HIT_TEST_SCHEMA,
                "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                "hit": True,
                "x": expected_x,
                "y": expected_y,
                "target_kind": target_kind,
                "container_id": integer("container_id", 1, (1 << 63) - 1),
                "view_pid": integer("view_pid", 1, (1 << 31) - 1),
                "surface_resource_id": surface_resource_id,
                "surface_client_pid": surface_client_pid,
                "surface_client_uid": surface_client_uid,
                "surface_client_gid": surface_client_gid,
                "surface_class": surface_class,
                "shell": self._hit_test_optional_string(value.get("shell"), "shell"),
                "sandbox_engine": self._hit_test_optional_string(
                    value.get("sandbox_engine"), "sandbox engine"
                ),
                "sandbox_app_id": self._hit_test_optional_string(
                    value.get("sandbox_app_id"), "sandbox app id"
                ),
                "sandbox_instance_id": self._hit_test_optional_string(
                    value.get("sandbox_instance_id"), "sandbox instance id"
                ),
            }
        authority = hmac.new(
            self.hit_test_key,
            canonical_json(projection),
            hashlib.sha256,
        ).hexdigest()
        recipient_authority: str | None = None
        if projection.get("hit") is True:
            recipient_projection = {
                key: projection[key]
                for key in (
                    "schema", "patch_schema", "patch_version", "hit",
                    "target_kind", "container_id", "view_pid",
                    "surface_resource_id", "surface_client_pid",
                    "surface_client_uid", "surface_client_gid", "surface_class",
                    "shell", "sandbox_engine", "sandbox_app_id",
                    "sandbox_instance_id",
                )
            }
            recipient_authority = hmac.new(
                self.hit_test_key,
                b"sandcodex-hit-test-recipient-v1\0"
                + canonical_json(recipient_projection),
                hashlib.sha256,
            ).hexdigest()
        return {
            **projection,
            "identity_authority_sha256": authority,
            "recipient_authority_sha256": recipient_authority,
        }, ticket

    def hit_test(self, x: int, y: int) -> dict[str, Any]:
        """Query the patched compositor's exact pointer dispatch target."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway HitTestSeal command connection is unauthorized")
        if type(x) is not int or type(y) is not int:
            raise ToolError("HitTestSeal coordinates must be integers")
        if not (
            -SWAY_HIT_TEST_MAX_COORDINATE <= x <= SWAY_HIT_TEST_MAX_COORDINATE
            and -SWAY_HIT_TEST_MAX_COORDINATE <= y <= SWAY_HIT_TEST_MAX_COORDINATE
        ):
            raise ToolError("HitTestSeal coordinates exceed the compositor query ceiling")
        request = canonical_json({"op": "hit-test", "x": x, "y": y})
        try:
            with self.command_lock:
                reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    request,
                    "SANDCODEX_HIT_TEST",
                )
            normalized, ticket = self._normalize_hit_test_reply(
                reply,
                x,
                y,
                expected_operation="hit-test",
            )
            if ticket is not None:
                raise RuntimeError("ordinary HitTestSeal retained dispatch authority")
            self.hit_test_queries += 1
            self.last_hit_test_identity_sha256 = str(
                normalized["identity_authority_sha256"]
            )
            return normalized
        except Exception as error:
            self._set_failure(error)
            if isinstance(error, ToolError):
                raise
            raise ToolError(f"patched-Sway HitTestSeal failed closed: {error}") from error

