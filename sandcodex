  python3 -P - "$server" <<'PY' || sc_die "generated desktop MCP server does not compile"
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_text(encoding="utf-8")
compile(source, sys.argv[1], "exec")
PY

  context_source="$launch/wayland-security-context.c"
