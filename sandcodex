        "tools": [
            {"type": "namespace", "name": "mcp", "description": "fixture namespace",
             "tools": [{"type": "function", "name": "inspect",
                        "parameters": {"type": "object", "properties": {
                            "path": {"type": "string"}}, "required": ["path"]}}]},
            {"type": "custom", "name": "apply_patch", "description": "patch fixture"},
