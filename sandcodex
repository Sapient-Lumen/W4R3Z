    cleanup_message = (
        "browser bundle extraction failed and hidden staging cleanup could not be proved"
    )
    try:
        shutil.rmtree(temporary)
    except FileNotFoundError:
        return
    except OSError as cleanup_error:
        if not os.path.lexists(temporary):
            return
        raise RuntimeError(cleanup_message) from cleanup_error
    if os.path.lexists(temporary):
        raise RuntimeError(cleanup_message)

def normalized_parts(raw_name: str, *, directory: bool | None = None) -> tuple[str, ...]:
    if not raw_name or "\x00" in raw_name or "\\" in raw_name or raw_name.startswith("/"):
        fail(f"unsafe archive member path: {raw_name!r}")
    name = raw_name[:-1] if raw_name.endswith("/") else raw_name
    segments = name.split("/")
    if not name or any(part in {"", ".", ".."} for part in segments):
        fail(f"archive member traverses or aliases a path: {raw_name!r}")
    if any(any(ord(char) < 32 or ord(char) == 127 for char in part) for part in segments):
        fail(f"archive member contains control characters: {raw_name!r}")
    parts = tuple(segments)
    if any(len(part.encode("utf-8")) > 255 for part in parts) or len(name.encode("utf-8")) > 4096:
        fail(f"archive member path is too long: {raw_name!r}")
    if ":" in parts[0]:
        fail(f"archive member has a drive-like root: {raw_name!r}")
    if directory is False and raw_name.endswith("/"):
        fail(f"file member has a directory name: {raw_name!r}")
    return parts

def relative_parts(value: object, label: str) -> tuple[str, ...]:
    if not isinstance(value, str) or not value or value.endswith("/"):
        fail(f"{label} must be a nonempty relative path")
    return normalized_parts(value, directory=False)

def der_tlv(data: bytes, offset: int) -> tuple[int, int, int, int]:
    if offset >= len(data):
        fail("extension manifest key is truncated DER")
    tag = data[offset]
    offset += 1
    if offset >= len(data):
        fail("extension manifest key is truncated DER")
    first = data[offset]
    offset += 1
    if first < 0x80:
        length = first
    else:
        count = first & 0x7f
        if count == 0 or count > 4 or offset + count > len(data):
            fail("extension manifest key has an invalid DER length")
        encoded = data[offset:offset + count]
        if encoded[0] == 0:
            fail("extension manifest key has a non-minimal DER length")
        length = int.from_bytes(encoded, "big")
        if length < 0x80:
            fail("extension manifest key has a non-minimal DER length")
        offset += count
    end = offset + length
    if end > len(data):
        fail("extension manifest key is truncated DER")
    return tag, offset, end, end

def validate_subject_public_key_info(data: bytes) -> None:
    tag, body, end, after = der_tlv(data, 0)
    if tag != 0x30 or after != len(data):
        fail("extension manifest key is not a DER SubjectPublicKeyInfo")
    algorithm_tag, algorithm_body, algorithm_end, cursor = der_tlv(data, body)
    if algorithm_tag != 0x30:
        fail("extension manifest key lacks a DER AlgorithmIdentifier")
    oid_tag, oid_body, oid_end, algorithm_cursor = der_tlv(data, algorithm_body)
    oid = data[oid_body:oid_end]
    if oid_tag != 0x06 or not oid or oid[-1] & 0x80:
        fail("extension manifest key has an invalid algorithm OID")
    while algorithm_cursor < algorithm_end:
        _tag, _body, _end, algorithm_cursor = der_tlv(data, algorithm_cursor)
    if algorithm_cursor != algorithm_end:
        fail("extension manifest key has an invalid AlgorithmIdentifier")
    key_tag, key_body, key_end, cursor = der_tlv(data, cursor)
    if key_tag != 0x03 or cursor != end or key_end - key_body < 2 or data[key_body] != 0:
        fail("extension manifest key has an invalid subjectPublicKey bit string")

