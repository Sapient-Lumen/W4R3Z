+		sandcodex_secure_clear(first_sy, sizeof(first_sy));
+		sandcodex_secure_clear(second_sx, sizeof(second_sx));
+		sandcodex_secure_clear(second_sy, sizeof(second_sy));
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-touch-gesture-path-changed");
+		return;
+	}
+
+	bool dispatched = sandcodex_dispatch_touch_gesture(seat, target_surface,
+		seat_client, expected_grab_address, expected_default_grab_address,
+		expected_resource_address, expected_resource_id,
+		first_sx, first_sy, second_sx, second_sy, steps, duration_msec);
+	sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+	sandcodex_secure_clear(expected_first_sx_bits,
+		sizeof(expected_first_sx_bits));
+	sandcodex_secure_clear(expected_first_sy_bits,
+		sizeof(expected_first_sy_bits));
+	sandcodex_secure_clear(expected_second_sx_bits,
+		sizeof(expected_second_sx_bits));
+	sandcodex_secure_clear(expected_second_sy_bits,
+		sizeof(expected_second_sy_bits));
+	sandcodex_secure_clear(first_sx, sizeof(first_sx));
+	sandcodex_secure_clear(first_sy, sizeof(first_sy));
+	sandcodex_secure_clear(second_sx, sizeof(second_sx));
+	sandcodex_secure_clear(second_sy, sizeof(second_sy));
+	if (!dispatched) {
+		sandcodex_send_hit_test_failure(client, "dispatch-failed");
+		return;
+	}
+
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(true));
+	json_object_object_add(reply, "operation",
+		json_object_new_string("dispatch-touch-gesture"));
+	json_object_object_add(reply, "dispatched", json_object_new_boolean(true));
+	json_object_object_add(reply, "ticket_consumed", json_object_new_boolean(true));
+	json_object_object_add(reply, "recipient_unchanged", json_object_new_boolean(true));
+	json_object_object_add(reply, "lifetime_revocation_armed",
+		json_object_new_boolean(true));
+	json_object_object_add(reply, "target_scope",
+		json_object_new_string("exact-destroy-watched-hit-surface"));
+	json_object_object_add(reply, "route_scope",
+		json_object_new_string(SANDCODEX_TOUCH_ROUTE_SCOPE));
+	json_object_object_add(reply, "coordinate_scope",
+		json_object_new_string(SANDCODEX_TOUCH_COORDINATE_SCOPE));
