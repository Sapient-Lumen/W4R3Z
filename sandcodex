import os
from pathlib import Path
import signal
import socket
import socketserver
import struct
import sys
from urllib.parse import urlsplit

MAX_HEADER = 65536
MAX_RELAY_BUFFER = 1048576

def split_authority(authority, default_port):
    authority = authority.strip()
    if authority.startswith("["):
        end = authority.find("]")
        if end < 0:
            raise ValueError("invalid IPv6 authority")
        host = authority[1:end]
        port = int(authority[end + 2:]) if authority[end + 1:end + 2] == ":" else default_port
    elif authority.count(":") == 1:
        host, raw_port = authority.rsplit(":", 1)
        port = int(raw_port)
    else:
        host, port = authority, default_port
    if not host or not 1 <= port <= 65535:
        raise ValueError("invalid authority")
    return host, port

def relay(left, right):
    import selectors

    sockets = (left, right)
    peer = {left: right, right: left}
    pending = {left: bytearray(), right: bytearray()}
    read_open = {left: True, right: True}
    shutdown_pending = {left: False, right: False}
    for endpoint in sockets:
        endpoint.setblocking(False)
    with selectors.DefaultSelector() as selector:
        while any(read_open.values()) or any(pending.values()):
            for endpoint in sockets:
                events = 0
                if read_open[endpoint] and len(pending[peer[endpoint]]) < MAX_RELAY_BUFFER:
                    events |= selectors.EVENT_READ
                if pending[endpoint]:
                    events |= selectors.EVENT_WRITE
                try:
                    key = selector.get_key(endpoint)
                except KeyError:
                    if events:
                        selector.register(endpoint, events)
                else:
                    if events:
                        selector.modify(endpoint, events)
                    else:
                        selector.unregister(endpoint)
            if not selector.get_map():
                return
            ready = selector.select()
            for key, events in ready:
                endpoint = key.fileobj
                if events & selectors.EVENT_READ:
                    try:
                        data = endpoint.recv(65536)
                    except (BlockingIOError, InterruptedError):
                        data = None
                    except OSError:
                        return
                    if data:
                        pending[peer[endpoint]].extend(data)
                    elif data == b"":
                        read_open[endpoint] = False
                        target = peer[endpoint]
                        if pending[target]:
                            shutdown_pending[target] = True
                        else:
                            try:
                                target.shutdown(socket.SHUT_WR)
                            except OSError:
                                pass
                if events & selectors.EVENT_WRITE and pending[endpoint]:
                    try:
                        sent = endpoint.send(pending[endpoint])
                    except (BlockingIOError, InterruptedError):
                        sent = 0
                    except OSError:
                        return
                    if sent:
                        del pending[endpoint][:sent]
                        if not pending[endpoint] and shutdown_pending[endpoint]:
                            shutdown_pending[endpoint] = False
                            try:
                                endpoint.shutdown(socket.SHUT_WR)
                            except OSError:
                                pass

class Proxy(socketserver.BaseRequestHandler):
    def read_exact(self, length):
        result = bytearray()
        while len(result) < length:
            chunk = self.request.recv(length - len(result))
            if not chunk:
                raise OSError("truncated proxy request")
            result.extend(chunk)
        return bytes(result)

    def handle_socks(self):
        version, methods = struct.unpack("!BB", self.read_exact(2))
        offered = self.read_exact(methods)
        if version != 5 or 0 not in offered:
            self.request.sendall(b"\x05\xff")
            return
        self.request.sendall(b"\x05\x00")
        version, command, reserved, address_type = struct.unpack("!BBBB", self.read_exact(4))
        if version != 5 or command != 1 or reserved != 0:
            self.request.sendall(b"\x05\x07\x00\x01\x00\x00\x00\x00\x00\x00")
            return
        if address_type == 1:
            host = socket.inet_ntop(socket.AF_INET, self.read_exact(4))
        elif address_type == 3:
            host = self.read_exact(self.read_exact(1)[0]).decode("idna")
        elif address_type == 4:
            host = socket.inet_ntop(socket.AF_INET6, self.read_exact(16))
        else:
            self.request.sendall(b"\x05\x08\x00\x01\x00\x00\x00\x00\x00\x00")
            return
        port = struct.unpack("!H", self.read_exact(2))[0]
        try:
            upstream = socket.create_connection((host, port), timeout=10)
        except OSError:
            self.request.sendall(b"\x05\x05\x00\x01\x00\x00\x00\x00\x00\x00")
            return
        with upstream:
            self.request.sendall(b"\x05\x00\x00\x01\x00\x00\x00\x00\x00\x00")
            relay(self.request, upstream)

    def handle(self):
        first = self.request.recv(1, socket.MSG_PEEK)
        if first == b"\x05":
            self.handle_socks()
            return
        incoming = bytearray()
        while b"\r\n\r\n" not in incoming:
            chunk = self.request.recv(8192)
            if not chunk:
                return
            incoming.extend(chunk)
            if len(incoming) > MAX_HEADER:
                return
        head, body = bytes(incoming).split(b"\r\n\r\n", 1)
        lines = head.split(b"\r\n")
        try:
            method_raw, target_raw, version = lines[0].split(b" ", 2)
            method = method_raw.decode("ascii").upper()
            target = target_raw.decode("ascii")
            headers = []
            host_header = None
            for line in lines[1:]:
                name, value = line.split(b":", 1)
                lower = name.strip().lower()
                if lower == b"host":
                    host_header = value.strip().decode("ascii")
                if lower not in {b"proxy-authorization", b"proxy-connection"}:
                    headers.append((name, value))
            if method == "CONNECT":
                host, port = split_authority(target, 443)
                origin_target = None
            else:
                parsed = urlsplit(target)
                if parsed.scheme not in {"http", "https"} or not parsed.hostname:
                    raise ValueError("absolute HTTP proxy URL required")
                host = parsed.hostname
                port = parsed.port or (443 if parsed.scheme == "https" else 80)
                origin_target = (parsed.path or "/") + (("?" + parsed.query) if parsed.query else "")
                if not host_header:
                    host_header = parsed.netloc
        except (UnicodeError, ValueError, IndexError):
            self.request.sendall(b"HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
            return
        try:
            upstream = socket.create_connection((host, port), timeout=10)
        except OSError:
            self.request.sendall(b"HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\n\r\n")
            return
        with upstream:
            if method == "CONNECT":
                self.request.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                if body:
                    upstream.sendall(body)
            else:
                first = method_raw + b" " + origin_target.encode("ascii") + b" " + version + b"\r\n"
                rebuilt = first + b"\r\n".join(name + b":" + value for name, value in headers)
                upstream.sendall(rebuilt + b"\r\n\r\n" + body)
            relay(self.request, upstream)

class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = False

if len(sys.argv) != 2:
    raise SystemExit("usage: host-proxy.py SOCKET")
path = Path(sys.argv[1])
if path.exists() or path.is_symlink():
    raise SystemExit("proxy socket path already exists")
server = Server(str(path), Proxy)
os.chmod(path, 0o600)
stopping = False
def stop(*_):
    global stopping
    stopping = True
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
server.timeout = 0.2
try:
    while not stopping:
        server.handle_request()
finally:
    server.server_close()
    try:
        path.unlink()
    except FileNotFoundError:
        pass
