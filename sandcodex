    "  helper: \(.operator_service.helper // "none")",
    "  graceful stop: \(.operator_service.stop_grace_seconds // "none") seconds",
    "  command-room controls: \(.operator_service.command_room_controls | join(", "))",
    "  host controls: \(.operator_service.host_controls | join(", "))",
    "  boundary: \(.operator_service.application_boundary // "not active")",
    "  lifecycle: \(.operator_service.lifetime); declaration frozen=\(.operator_service.declaration_frozen)"
    ,"",
    "Inner Jail",
    "  purpose: run a less-trusted action with less authority than this primary agent",
    "  command: \(.jail.command)",
    "  capability card: \(.jail.recipes.capability_card)",
    "  inspect: \(.jail.recipes.inspect)",
    "  self-test: \(.jail.recipes.self_test)",
    "  workspaces: \(.jail.workspaces.root)",
    "  persistent caches: \(.jail.caches.root) (paired by workspace name at /cache)",
    "  persistent storage: group=\(.jail.resource_limits.persistent_storage.budget_group) maximum=\(.jail.resource_limits.persistent_storage.maximum_bytes // "unlimited") metering=\(.jail.resource_limits.persistent_storage.metering)",
    "  storage health: \(.jail.persistent_storage_health.status)\(if .jail.persistent_storage_health.diagnostic then " - " + .jail.persistent_storage_health.diagnostic else "" end)",
    "  storage isolation: inventory degradation never blocks the command room; jail lifecycle mutations remain fail-closed",
    "  lifecycle: workspace inspect/usage/retire/purge; retire and purge are broker-receipted",
    "  sealed verifier inputs: \(.jail.sealed_inputs.recipe)",
    "  authoritative receipts: \(.jail.action_receipts.recipes.run)",
    "  receipt review: \(.jail.action_receipts.recipes.list) | \(.jail.action_receipts.recipes.show)",
    "  profiles: \(.jail.tool_profiles | keys | join(", "))",
    "  default: tools=\(.jail.default.tools) network=\(.jail.default.network) resources=\(.jail.default.resources)",
    "  network: \(.jail.network.modes | join(", ")); ceiling=\(.jail.network.delegated_ceiling)",
    "  resources: heavy adds no Sandcodex action ceilings; bounded=\(.jail.resource_postures.bounded.timeout_seconds)s/\(.jail.resource_postures.bounded.memory_mib)MiB/\(.jail.resource_postures.bounded.pids)pids",
    "  recursion: monotonic grants through depth \(.jail.recursion.max_depth)",
    "  authority: the primary agent chooses workspace/cache/profile/network/resources/seals/result evidence; the action controls argv only",
    "  stage: \(.jail.workspaces.recipe)",
    "  warning: \(.jail.network.confidentiality_warning)",
    "  current limits: \(.jail.limitations | join("; "))"
  ' "$environment" ;;
  -h|--help) printf 'usage: sandcodex-env [--briefing|--summary|--json|--capabilities|--path]\n' ;;
  *) printf 'sandcodex-env: unknown option: %s\n' "$1" >&2; exit 2 ;;
esac
SANDCODEX_AGENT_ENVIRONMENT_HELPER_BODY_SH
}

