sc_reclaim_stale_browser_bundle_manifests() {
  local target="$SC_BROWSER_HOME/.config/google-chrome-for-testing/NativeMessagingHosts"
  local manifest description entrypoint
  [[ -d "$target" && ! -L "$target" ]] || return 0
  for manifest in "$target"/*.json; do
    [[ -f "$manifest" && ! -L "$manifest" && "$(stat -c %u -- "$manifest" 2>/dev/null || true)" == "$(id -u)" ]] || continue
    description="$(jq -r '.description // empty' "$manifest" 2>/dev/null || true)"
    case "$description" in
      'Sandcodex browser bundle: '*|'Sandcodex project browser host: '*) ;;
      *) continue ;;
    esac
    entrypoint="$(jq -r '.path // empty' "$manifest" 2>/dev/null || true)"
    case "$entrypoint" in
      /run/sandcodex-browser/bundle/*|/run/sandcodex-browser/launch/project-native-host) ;;
      *) continue ;;
    esac
    rm -f -- "$manifest"
    sc_note "reclaimed stale browser-bundle native host: $(basename -- "$manifest")"
  done
}

