+static void sandcodex_dispatch_keyboard_unit_request(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	json_object *keycode_object = NULL, *modifiers_object = NULL;
+	json_object *ticket_object = NULL;
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == 4 &&
+		sandcodex_request_operation(request, "dispatch-keyboard-unit") &&
+		json_object_object_get_ex(request, "keycode", &keycode_object) &&
+		json_object_object_get_ex(request, "modifiers", &modifiers_object) &&
+		json_object_object_get_ex(request, "ticket", &ticket_object) &&
+		json_object_is_type(keycode_object, json_type_int) &&
+		json_object_is_type(modifiers_object, json_type_int) &&
+		json_object_is_type(ticket_object, json_type_string);
+	int64_t keycode_value = valid_shape ? json_object_get_int64(keycode_object) : 0;
+	int64_t modifiers_value = valid_shape
+		? json_object_get_int64(modifiers_object) : -1;
+	uint32_t keycode = keycode_value >= 1 &&
+		keycode_value <= SANDCODEX_KEYBOARD_MAX_KEYCODE
+		? (uint32_t)keycode_value : 0;
+	uint32_t modifiers = modifiers_value >= 0 && modifiers_value <= UINT32_MAX
+		? (uint32_t)modifiers_value : 0;
+	const char *ticket = valid_shape ? json_object_get_string(ticket_object) : NULL;
+	bool canonical = valid_shape && keycode != 0 && modifiers_value >= 0 &&
+		modifiers_value <= UINT32_MAX &&
+		sandcodex_is_lower_hex_token(ticket, SANDCODEX_DISPATCH_TICKET_LENGTH) &&
+		sandcodex_keyboard_dispatch_payload_canonical(payload, payload_length,
+			keycode, modifiers, ticket);
+
+	struct sandcodex_dispatch_ticket *grant =
+		&client->sandcodex_dispatch_ticket;
+	struct sandcodex_hit_target expected_target = grant->target;
+	uintptr_t expected_sway_device_address = grant->sway_device_address;
+	uintptr_t expected_wlr_device_address = grant->wlr_device_address;
+	uintptr_t expected_focused_surface_address =
