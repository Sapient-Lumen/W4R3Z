sc_remote_auto_task_dispatch() {
  sc_loop_normalize_turns
  sc_loop_load_prompt
  sc_loop_validate_policy
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  local prompt model rc=0
  local -a loop_cmd resume_cmd
  prompt="$(mktemp "$SC_GLOBAL/runtime/.remote-auto-task-prompt.XXXXXX")"
  printf '%s' "$SC_LOOP_PROMPT" | sc_atomic "$prompt" 600

  loop_cmd=(env "SANDCODEX_GLOBAL_ROOT=$SC_GLOBAL"
    SANDCODEX_INTERNAL_FOREGROUND_TASK=remote-auto-task "$SC_SCRIPT" remote auto)
  [[ -z "$SC_REMOTE_KEYBANK_PATH" ]] || loop_cmd+=(--key-bank "$(sc_remote_keybank_path)")
  loop_cmd+=(--profile "$SC_REMOTE_PROFILE" loop --foreground-task-handoff
    --project "$SC_PROJECT" --turns "$SC_LOOP_TURNS" --prompt-file "$prompt")
  (( SC_LOOP_JSON )) && loop_cmd+=(--json)
  (( SC_LOOP_AUTO_RESUME )) && loop_cmd+=(--auto-resume) || loop_cmd+=(--no-auto-resume)
  loop_cmd+=(--retry-limit "$SC_LOOP_RETRY_LIMIT" --retry-base-seconds "$SC_LOOP_RETRY_BASE_SECONDS"
    --retry-max-seconds "$SC_LOOP_RETRY_MAX_SECONDS" --retry-max-wait-seconds "$SC_LOOP_RETRY_MAX_WAIT_SECONDS"
    --min-free-mib "$SC_LOOP_MIN_FREE_MIB" --max-project-growth-mib "$SC_LOOP_MAX_PROJECT_GROWTH_MIB"
    --max-downloads-mib "$SC_LOOP_MAX_DOWNLOADS_MIB" --max-profile-mib "$SC_LOOP_MAX_PROFILE_MIB")
  sc_remote_task_append_common_options loop_cmd
  (( ${#SC_CODEX_ARGS[@]} == 0 )) || loop_cmd+=(-- "${SC_CODEX_ARGS[@]}")

  "${loop_cmd[@]}" || rc=$?
  rm -f -- "$prompt"
  (( rc == 0 )) || return "$rc"

  model="$(jq -er '.model' "$SC_CONTROL/openrouter-auto-selection.json" 2>/dev/null || true)"
  [[ -n "$model" ]] || model="openrouter/free"
  if (( SC_REMOTE_AUTO_TASK_THEN_INTERACTIVE )); then
    resume_cmd=(env "SANDCODEX_GLOBAL_ROOT=$SC_GLOBAL" "$SC_SCRIPT" remote "$model" --provider openrouter --RESUME --project "$SC_PROJECT")
    sc_remote_task_append_common_options resume_cmd
    (( ${#SC_CODEX_ARGS[@]} == 0 )) || resume_cmd+=(-- "${SC_CODEX_ARGS[@]}")
    exec "${resume_cmd[@]}"
  fi
  sc_ok "remote auto task finished · first turn complete"
  sc_remote_auto_task_resume_command_render "$model"
}

