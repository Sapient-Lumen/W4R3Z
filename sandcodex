            tooltip_text="",
            item_is_menu=False,
            menu_path=None,
            icon=None,
        )
    )
    button: Any = None
    subscriptions: list[int] = field(default_factory=list)
    refresh_source: int = 0
    refresh_failures: int = 0


def _safe_text(
    value: Any,
    label: str,
    maximum: int,
    *,
    allow_empty: bool = True,
    multiline: bool = False,
) -> str:
    if not isinstance(value, str):
        raise StatusNotifierError(f"{label} must be a string")
    encoded = value.encode("utf-8", "strict")
    if len(encoded) > maximum:
        raise StatusNotifierError(f"{label} exceeds its byte limit")
    if not allow_empty and not value:
        raise StatusNotifierError(f"{label} must not be empty")
    for character in value:
        if multiline and character in {"\n", "\t"}:
            continue
        if unicodedata.category(character) in {"Cc", "Cf", "Cs"}:
            raise StatusNotifierError(f"{label} contains a control character")
    return value


def _variant_value(value: Any, *, depth: int = 0) -> Any:
    if depth > 8:
        raise StatusNotifierError("nested D-Bus variant exceeds its depth limit")
    type_string = getattr(value, "get_type_string", None)
    unpack = getattr(value, "unpack", None)
    if callable(type_string) and callable(unpack):
        return _variant_value(unpack(), depth=depth + 1)
    return value


def _canonical_object_path(value: Any, label: str) -> str:
    path = _safe_text(value, label, MAX_REGISTRATION_BYTES, allow_empty=False)
    if OBJECT_PATH_RE.fullmatch(path) is None:
        raise StatusNotifierError(f"{label} is not a canonical D-Bus object path")
    return path


def _canonical_unique_name(value: Any, label: str = "sender") -> str:
    name = _safe_text(value, label, MAX_REGISTRATION_BYTES, allow_empty=False)
    if UNIQUE_BUS_NAME_RE.fullmatch(name) is None:
        raise StatusNotifierError(f"{label} is not one private-bus unique name")
    return name


def _registration_address(
    sender: Any,
    service: Any,
    owner_resolver: Callable[[str], str],
) -> ItemAddress:
    sender_name = _canonical_unique_name(sender)
    requested = _safe_text(
        service,
        "status notifier registration",
        MAX_REGISTRATION_BYTES,
        allow_empty=False,
    )
    if requested.startswith("/"):
        return ItemAddress(
            sender=sender_name,
            service=sender_name,
            object_path=_canonical_object_path(requested, "status notifier object path"),
        )
    if UNIQUE_BUS_NAME_RE.fullmatch(requested):
        if requested != sender_name:
            raise StatusNotifierError("status notifier registration crossed a sender boundary")
        return ItemAddress(sender_name, requested, DEFAULT_ITEM_OBJECT_PATH)
    if WELL_KNOWN_BUS_NAME_RE.fullmatch(requested) is None:
        raise StatusNotifierError("status notifier service name is not canonical")
    try:
        owner = owner_resolver(requested)
    except Exception as error:
        raise StatusNotifierError("status notifier service has no live owner") from error
    if owner != sender_name:
        raise StatusNotifierError("status notifier registration crossed a sender boundary")
    return ItemAddress(sender_name, requested, DEFAULT_ITEM_OBJECT_PATH)


def _bounded_byte_array(value: Any, label: str) -> bytes:
    value = _variant_value(value)
    if isinstance(value, bytes):
        if len(value) > MAX_PIXMAP_BYTES:
            raise StatusNotifierError(f"{label} exceeds its byte limit")
        return value
    if isinstance(value, bytearray):
        if len(value) > MAX_PIXMAP_BYTES:
            raise StatusNotifierError(f"{label} exceeds its byte limit")
        return bytes(value)
    if not isinstance(value, (list, tuple)):
        raise StatusNotifierError(f"{label} is not a byte array")
    if len(value) > MAX_PIXMAP_BYTES:
        raise StatusNotifierError(f"{label} exceeds its byte limit")
    result = bytearray()
    for item in value:
        if isinstance(item, bool) or not isinstance(item, int) or not 0 <= item <= 255:
            raise StatusNotifierError(f"{label} contains a non-byte value")
        result.append(item)
    return bytes(result)


def _argb_to_rgba(payload: bytes) -> bytes:
    if len(payload) % 4:
        raise StatusNotifierError("status notifier pixmap is not whole ARGB32 pixels")
    converted = bytearray(len(payload))
    for index in range(0, len(payload), 4):
        alpha, red, green, blue = payload[index:index + 4]
        converted[index:index + 4] = bytes((red, green, blue, alpha))
    return bytes(converted)


def _select_icon_pixmap(value: Any) -> IconPixmap | None:
    value = _variant_value(value)
    if value in (None, (), []):
        return None
    if not isinstance(value, (list, tuple)) or len(value) > MAX_PIXMAPS:
        raise StatusNotifierError("status notifier pixmaps exceed their count limit")
    candidates: list[IconPixmap] = []
    aggregate = 0
    for index, raw in enumerate(value):
        raw = _variant_value(raw)
        if not isinstance(raw, (list, tuple)) or len(raw) != 3:
            raise StatusNotifierError(f"status notifier pixmap {index} is malformed")
        width, height, data = raw
        if (
            isinstance(width, bool)
            or isinstance(height, bool)
            or not isinstance(width, int)
            or not isinstance(height, int)
            or not 1 <= width <= MAX_PIXMAP_DIMENSION
            or not 1 <= height <= MAX_PIXMAP_DIMENSION
        ):
            raise StatusNotifierError(f"status notifier pixmap {index} has invalid geometry")
        payload = _bounded_byte_array(data, f"status notifier pixmap {index}")
        expected = width * height * 4
        aggregate += len(payload)
        if aggregate > MAX_PIXMAP_BYTES or len(payload) != expected:
            raise StatusNotifierError(f"status notifier pixmap {index} has invalid byte length")
        candidates.append(IconPixmap(width, height, _argb_to_rgba(payload)))
    if not candidates:
        return None
    # Prefer the image nearest 32 logical pixels, then the larger candidate.
    return min(candidates, key=lambda pixmap: (abs(max(pixmap.width, pixmap.height) - 32), -pixmap.width * pixmap.height))


def _tooltip(value: Any) -> tuple[str, str]:
    value = _variant_value(value)
    if value in (None, (), []):
        return ("", "")
    if not isinstance(value, (list, tuple)) or len(value) != 4:
        raise StatusNotifierError("status notifier tooltip is malformed")
    _icon_name, _icon_pixmap, title, text = value
    return (
        _safe_text(title, "status notifier tooltip title", MAX_ITEM_TEXT_BYTES),
        _safe_text(
            text,
            "status notifier tooltip text",
            MAX_TOOLTIP_TEXT_BYTES,
            multiline=True,
        ),
    )


def _parse_item_properties(value: Any) -> StatusItemSpec:
    value = _variant_value(value)
    if not isinstance(value, Mapping) or len(value) > 64:
        raise StatusNotifierError("status notifier properties are not a bounded dictionary")

    def prop(name: str, default: Any) -> Any:
        return _variant_value(value.get(name, default))

    category = _safe_text(prop("Category", "ApplicationStatus"), "Category", 64)
    if category not in ALLOWED_CATEGORIES:
        category = "ApplicationStatus"
    status = _safe_text(prop("Status", "Active"), "Status", 64)
    if status not in ALLOWED_STATUSES:
        status = "Active"
    identifier = _safe_text(prop("Id", ""), "Id", MAX_ITEM_TEXT_BYTES)
    title = _safe_text(prop("Title", ""), "Title", MAX_ITEM_TEXT_BYTES)
    tooltip_title, tooltip_text = _tooltip(prop("ToolTip", ("", [], "", "")))
    item_is_menu = prop("ItemIsMenu", False)
    if not isinstance(item_is_menu, bool):
        raise StatusNotifierError("ItemIsMenu must be boolean")
    raw_menu = prop("Menu", "/")
    menu_path: str | None
    if raw_menu in (None, "", "/"):
        menu_path = None
    else:
        menu_path = _canonical_object_path(raw_menu, "status notifier menu path")
    icon = _select_icon_pixmap(prop("IconPixmap", []))
    # NeedsAttention is the one state for which the specification provides a
    # distinct visual.  Honor its inline pixmap without ever resolving the
    # corresponding icon/movie names or application-selected paths.
    if status == "NeedsAttention":
        attention_icon = _select_icon_pixmap(prop("AttentionIconPixmap", []))
        if attention_icon is not None:
            icon = attention_icon
    return StatusItemSpec(
        category=category,
        identifier=identifier,
        title=title,
        status=status,
        tooltip_title=tooltip_title,
        tooltip_text=tooltip_text,
        item_is_menu=item_is_menu,
        menu_path=menu_path,
        icon=icon,
    )


def _menu_property(properties: Mapping[str, Any], name: str, default: Any) -> Any:
    return _variant_value(properties.get(name, default))


def _parse_menu_layout(value: Any) -> tuple[int, MenuNode]:
    value = _variant_value(value)
    if not isinstance(value, (list, tuple)) or len(value) != 2:
        raise StatusNotifierError("DBusMenu layout reply is malformed")
    revision, raw_root = value
    if isinstance(revision, bool) or not isinstance(revision, int) or not 0 <= revision <= 0xFFFFFFFF:
        raise StatusNotifierError("DBusMenu revision is invalid")
    count = [0]
    identifiers: set[int] = set()

    def parse(raw: Any, depth: int) -> MenuNode:
        raw = _variant_value(raw)
        if depth > MAX_MENU_DEPTH:
            raise StatusNotifierError("DBusMenu layout exceeds its depth limit")
        if not isinstance(raw, (list, tuple)) or len(raw) != 3:
            raise StatusNotifierError("DBusMenu node is malformed")
        identifier, properties, raw_children = raw
        if isinstance(identifier, bool) or not isinstance(identifier, int):
            raise StatusNotifierError("DBusMenu item id is invalid")
        if not -(2**31) <= identifier < 2**31:
            raise StatusNotifierError("DBusMenu item id is outside int32")
        if identifier in identifiers:
            raise StatusNotifierError("DBusMenu contains a duplicate item id")
        identifiers.add(identifier)
        properties = _variant_value(properties)
        if not isinstance(properties, Mapping) or len(properties) > 48:
            raise StatusNotifierError("DBusMenu item properties are malformed")
        raw_children = _variant_value(raw_children)
        if not isinstance(raw_children, (list, tuple)):
            raise StatusNotifierError("DBusMenu children are malformed")
        if len(raw_children) > MAX_MENU_ITEMS:
            raise StatusNotifierError("DBusMenu child vector exceeds its item-count limit")
        count[0] += 1
        if count[0] > MAX_MENU_ITEMS:
            raise StatusNotifierError("DBusMenu exceeds its item-count limit")
        label = _safe_text(
            _menu_property(properties, "label", ""),
            "DBusMenu label",
            MAX_MENU_LABEL_BYTES,
        )
        enabled = _menu_property(properties, "enabled", True)
        visible = _menu_property(properties, "visible", True)
        if not isinstance(enabled, bool) or not isinstance(visible, bool):
            raise StatusNotifierError("DBusMenu enabled/visible state must be boolean")
        kind = _safe_text(_menu_property(properties, "type", ""), "DBusMenu type", 32)
        if kind not in ALLOWED_MENU_TYPES:
            kind = "standard"
        toggle_type = _safe_text(
            _menu_property(properties, "toggle-type", ""),
            "DBusMenu toggle type",
            32,
        )
        if toggle_type not in ALLOWED_TOGGLE_TYPES:
            toggle_type = ""
        toggle_state = _menu_property(properties, "toggle-state", -1)
        if (
            isinstance(toggle_state, bool)
            or not isinstance(toggle_state, int)
            or toggle_state not in {-1, 0, 1}
        ):
            raise StatusNotifierError("DBusMenu toggle state is invalid")
        children = tuple(parse(child, depth + 1) for child in raw_children)
        return MenuNode(
            identifier=identifier,
            label=label,
            enabled=enabled,
            visible=visible,
            kind=kind,
            toggle_type=toggle_type,
            toggle_state=toggle_state,
            children=children,
        )

    return revision, parse(raw_root, 0)


def _harden_process() -> None:
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    resource.setrlimit(resource.RLIMIT_NOFILE, (160, 160))
    libc = ctypes.CDLL(None, use_errno=True)
    prctl = libc.prctl
    prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
    prctl.restype = ctypes.c_int
    PR_SET_PDEATHSIG = 1
    PR_SET_DUMPABLE = 4
    PR_SET_NO_NEW_PRIVS = 38
    if prctl(PR_SET_PDEATHSIG, signal.SIGTERM, 0, 0, 0) != 0:
        raise RuntimeError("could not bind status notifier lifetime to its supervisor")
    if os.getppid() == 1:
        raise RuntimeError("status notifier supervisor disappeared during startup")
    if prctl(PR_SET_DUMPABLE, 0, 0, 0, 0) != 0:
        raise RuntimeError("could not disable status notifier dumps")
    if prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        raise RuntimeError("could not enable status notifier no-new-privileges")


def _file_fingerprint(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def _read_secret_token(path: Path, label: str) -> str:
    encoded_path = os.fsencode(path)
    if not encoded_path or len(encoded_path) > MAX_SECRET_PATH_BYTES:
        raise RuntimeError(f"status notifier {label} path is invalid")
    flags = os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid()
            or stat.S_IMODE(before.st_mode) != 0o400
            or before.st_nlink != 1
            or before.st_size != 33
        ):
            raise RuntimeError(f"status notifier {label} has unsafe custody")
        payload = bytearray()
        while len(payload) < 34:
            chunk = os.read(descriptor, 34 - len(payload))
            if not chunk:
                break
            payload.extend(chunk)
        after = os.fstat(descriptor)
        if _file_fingerprint(before) != _file_fingerprint(after):
            raise RuntimeError(f"status notifier {label} changed while read")
    finally:
        os.close(descriptor)
    if len(payload) != 33 or payload[-1:] != b"\n":
        raise RuntimeError(f"status notifier {label} is not exact canonical bytes")
    try:
        token = bytes(payload[:-1]).decode("ascii")
    except UnicodeDecodeError as error:
        raise RuntimeError(f"status notifier {label} is not ASCII") from error
    if TOKEN_RE.fullmatch(token) is None:
        raise RuntimeError(f"invalid status notifier {label}")
    return token


def _surface_app_id(surface_token: str) -> str:
    if TOKEN_RE.fullmatch(surface_token) is None:
        raise RuntimeError("invalid status notifier surface token")
    app_id = WINDOW_APP_ID_PREFIX + surface_token
    if APP_ID_RE.fullmatch(app_id) is None:
        raise RuntimeError("status notifier surface identity is not representable")
    return app_id


def _write_ready(
    path: Path,
    launch_id: str,
    application_id: str,
    instance_token: str,
    surface_app_id: str,
) -> None:
    if not TOKEN_RE.fullmatch(instance_token):
        raise RuntimeError("invalid status notifier readiness token")
    if not LAUNCH_ID_RE.fullmatch(launch_id):
        raise RuntimeError("invalid status notifier launch identity")
    if not APP_ID_RE.fullmatch(application_id):
        raise RuntimeError("invalid status notifier application identity")
    if not APP_ID_RE.fullmatch(surface_app_id) or not surface_app_id.startswith(WINDOW_APP_ID_PREFIX):
        raise RuntimeError("invalid status notifier surface identity")
    encoded_path = os.fsencode(path)
    if not encoded_path or len(encoded_path) > MAX_READY_PATH_BYTES:
        raise RuntimeError("status notifier readiness path is invalid")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags, 0o600)
    try:
        line = (
            f"{PROTOCOL} instance_token={instance_token} launch_id={launch_id} "
            f"application_id={application_id} surface_app_id={surface_app_id} "
            f"watchers={','.join(WATCHER_BUS_NAMES)} host=launch-private "
            "capabilities=activate,secondary-activate,context-menu,scroll,dbusmenu "
            f"maximum_items={MAX_ITEMS} maximum_menu_nodes={MAX_MENU_NODES}\n"
        ).encode("ascii")
        view = memoryview(line)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise RuntimeError("status notifier readiness write failed")
            view = view[written:]
        os.fsync(descriptor)
        info = os.fstat(descriptor)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_nlink != 1
            or info.st_size != len(line)
            or _file_fingerprint(info) != _file_fingerprint(os.fstat(descriptor))
        ):
            raise RuntimeError("status notifier readiness receipt has unsafe custody")
    finally:
        os.close(descriptor)


