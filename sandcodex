+static void sandcodex_arm_motion(struct ipc_client *client,
+		json_object *request, const char *payload, uint32_t payload_length) {
+	json_object *from_x_object = NULL, *from_y_object = NULL;
+	json_object *x_object = NULL, *y_object = NULL;
+	sandcodex_clear_dispatch_ticket(client);
+	bool valid_shape = client->sandcodex_hit_test_authorized &&
+		json_object_object_length(request) == 5 &&
+		sandcodex_request_operation(request, "arm-motion") &&
+		json_object_object_get_ex(request, "from_x", &from_x_object) &&
+		json_object_object_get_ex(request, "from_y", &from_y_object) &&
+		json_object_object_get_ex(request, "x", &x_object) &&
+		json_object_object_get_ex(request, "y", &y_object) &&
+		json_object_is_type(from_x_object, json_type_int) &&
+		json_object_is_type(from_y_object, json_type_int) &&
+		json_object_is_type(x_object, json_type_int) &&
+		json_object_is_type(y_object, json_type_int);
+	if (!valid_shape) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+	int64_t from_x = json_object_get_int64(from_x_object);
+	int64_t from_y = json_object_get_int64(from_y_object);
+	int64_t x = json_object_get_int64(x_object);
+	int64_t y = json_object_get_int64(y_object);
+	if (from_x < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			from_x > SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			from_y < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			from_y > SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			x < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			x > SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			y < -SANDCODEX_HIT_TEST_COORDINATE_LIMIT ||
+			y > SANDCODEX_HIT_TEST_COORDINATE_LIMIT) {
+		sandcodex_send_hit_test_failure(client, "coordinate-out-of-range");
+		return;
+	}
+	if (!sandcodex_motion_arm_payload_canonical(payload, payload_length,
+			from_x, from_y, x, y)) {
+		sandcodex_send_hit_test_failure(client, "unauthorized-or-malformed");
+		return;
+	}
+
+	struct sway_seat *seat = input_manager_get_default_seat();
+	struct sway_input_device *device = sandcodex_single_virtual_pointer(seat);
+	double actual_x = 0;
+	double actual_y = 0;
+	if (!device || !sandcodex_cursor_near_requested(seat, from_x, from_y,
+			&actual_x, &actual_y) || !seat->cursor ||
+			seat->cursor->pressed_button_count != 0 ||
+			seat->cursor->active_constraint) {
+		sandcodex_send_hit_test_failure(client, "motion-precondition-failed");
+		return;
+	}
+
+	struct sandcodex_hit_target source_target = {0};
+	struct sway_view *source_view = NULL;
+	struct wlr_surface *source_view_surface = NULL;
+	struct wlr_surface *source_target_surface = NULL;
+	if (!sandcodex_capture_hit_target(seat, actual_x, actual_y, &source_target,
+			&source_view, &source_view_surface, &source_target_surface)) {
+		sandcodex_send_hit_test_failure(client, "motion-source-hit-test-failed");
+		return;
+	}
+
+	struct sandcodex_hit_target target = {0};
+	struct sway_view *view = NULL;
+	struct wlr_surface *view_surface = NULL;
+	struct wlr_surface *target_surface = NULL;
+	if (!sandcodex_capture_hit_target(seat, (double)x, (double)y, &target,
+			&view, &view_surface, &target_surface) || !target.hit) {
+		sandcodex_send_hit_test_failure(client, "motion-destination-invalid");
+		return;
+	}
+
+	struct sandcodex_dispatch_ticket *grant =
+		&client->sandcodex_dispatch_ticket;
+	if (!sandcodex_random_ticket(grant->value)) {
+		sandcodex_send_hit_test_failure(client, "motion-ticket-failed");
+		return;
+	}
+	grant->armed = true;
+	grant->kind = SANDCODEX_DISPATCH_MOTION;
+	grant->x = x;
+	grant->y = y;
+	grant->from_x = from_x;
+	grant->from_y = from_y;
+	grant->cursor_x_bits = sandcodex_double_bits(actual_x);
+	grant->cursor_y_bits = sandcodex_double_bits(actual_y);
+	grant->source_target = source_target;
+	grant->target = target;
+	grant->sway_device_address = (uintptr_t)device;
+	grant->wlr_device_address = (uintptr_t)device->wlr_device;
+	strcpy(grant->device_identifier, device->identifier);
+	if (!sandcodex_bind_dispatch_ticket(client, device->wlr_device,
+			view_surface, target_surface) ||
+			!sandcodex_bind_motion_source_ticket(client, source_view_surface,
+				source_target_surface, view_surface, target_surface)) {
+		sandcodex_clear_dispatch_ticket(client);
+		sandcodex_send_hit_test_failure(client,
+			"dispatch-lifetime-bind-failed");
+		return;
+	}
+	sandcodex_send_hit_target(client, "arm-motion", x, y, &target, view,
+		grant->value, SANDCODEX_DISPATCH_MOTION, 0, 0, from_x, from_y, 0,
+		NULL, NULL);
+}
