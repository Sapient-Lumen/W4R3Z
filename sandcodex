+static void sandcodex_secure_clear(void *value, size_t length) {
+	volatile unsigned char *bytes = value;
+	while (length > 0) {
+		*bytes++ = 0;
+		--length;
+	}
+}
+
+static bool sandcodex_erase_environment_value(const char *name) {
+	extern char **environ;
+	size_t name_length = strlen(name);
+	for (char **entry = environ; entry && *entry; ++entry) {
+		if (strncmp(*entry, name, name_length) == 0 &&
+				(*entry)[name_length] == '=') {
+			char *value = *entry + name_length + 1;
+			sandcodex_secure_clear(value, strlen(value));
+		}
+	}
+	return unsetenv(name) == 0 && getenv(name) == NULL;
+}
