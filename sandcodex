+static bool sandcodex_shortcut_state_released(
+		const struct sway_shortcut_state *state) {
+	if (!state || state->npressed != 0 || state->current_key != 0) {
+		return false;
+	}
+	for (size_t i = 0; i < SWAY_KEYBOARD_PRESSED_KEYS_CAP; ++i) {
+		if (state->pressed_keys[i] != 0 || state->pressed_keycodes[i] != 0) {
+			return false;
+		}
+	}
+	return true;
+}
