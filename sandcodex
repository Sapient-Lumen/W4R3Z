    def _assert_clipboard_launch_exclusive(self, launch_id: str) -> None:
        """Require one live managed launch before releasing global selection bytes.

        ext-data-control-v1 intentionally does not identify the requesting client in
        a source ``send`` event.  Launch-scoped PasteSeal therefore treats all
        processes admitted beneath one launch as one trust domain and refuses to
        publish or release while any sibling launch is alive.
        """
        launch_id = as_string(launch_id, "launch_id", maximum=128, allow_empty=False)
        target = self._managed_by_launch_id(launch_id)
        if target.context_failed or not self._context_alive(target):
            raise ToolError("clipboard target launch lost its private Wayland context")
        self._reap_processes()
        live_launches: set[str] = set()
        for managed in self.processes.values():
            if self._refresh_managed(managed) > 0:
                live_launches.add(managed.launch_id)
        if live_launches != {launch_id}:
            raise ToolError(
                "launch-scoped clipboard paste requires the target to be the sole live "
                "managed launch because Wayland data requests do not expose requester identity"
            )

    def _assert_clipboard_scene_exclusive(
        self,
        scene_id: Any,
        launch_ids: tuple[str, ...] | list[str],
    ) -> None:
        """Confine requester-blind selection bytes to one complete explicit scene.

        ext-data-control-v1 reports the requested MIME type and destination file
        descriptor, but not the requesting Wayland principal. Scene-scoped
        PasteSeal therefore treats the operator-selected exact member set as one
        temporary disclosure domain only when it equals *all* live managed
        launches. A sibling launch, late join, member loss, context drift, or
        compositor attribution change revokes publication before the next byte.
        """
        normalized_scene = self._scene_id(scene_id, required=True)
        assert normalized_scene is not None
        expected = tuple(sorted(launch_ids))
        if (
            not 2 <= len(expected) <= SCENE_SET_MAX_LAUNCHES
            or len(set(expected)) != len(expected)
            or any(
                not isinstance(value, str)
                or re.fullmatch(r"launch-[0-9a-f]{24}", value) is None
                for value in expected
            )
        ):
            raise ToolError("scene-scoped clipboard paste has invalid exact membership")
        members = self._managed_scene(
            normalized_scene,
            expected_launch_ids=expected,
        )
        self._assert_scene_set_authority(members)
        self._reap_processes()
        live_launches: set[str] = set()
        for managed in self.processes.values():
            if self._refresh_managed(managed) > 0:
                live_launches.add(managed.launch_id)
        if live_launches != set(expected):
            raise ToolError(
                "scene-scoped clipboard paste requires the exact scene-set to be the complete "
                "live managed trust domain because Wayland data requests do not expose requester identity"
            )

    def _custody_loop(self) -> None:
        while not self._custody_stop.wait(0.05):
            with self.lock:
                for managed in list(self.processes.values()):
                    self._refresh_managed(managed)

    def _build_keyboard_map(self) -> dict[int, tuple[int, bool]]:
        info = self.display.display.info
        minimum = info.min_keycode
        maximum = info.max_keycode
        mapping = self.display.get_keyboard_mapping(minimum, maximum - minimum + 1)
        result: dict[int, tuple[int, bool]] = {}
        for offset, levels in enumerate(mapping):
            keycode = minimum + offset
            for index, keysym in enumerate(levels[:2]):
                if keysym and keysym not in result:
                    result[keysym] = (keycode, index == 1)
        return result

    def _sync(self) -> None:
        self.display.sync()

    def _fake_keycode(self, keycode: int, pressed: bool) -> None:
        if not keycode:
            raise ToolError("requested key is unavailable in the X11 keymap")
        xtest.fake_input(self.display, X.KeyPress if pressed else X.KeyRelease, keycode)

    @contextlib.contextmanager
    def _x11_pointer_modifier_arc(self, arguments: dict[str, Any]) -> Any:
        raw = arguments.get("modifiers", [])
        if not isinstance(raw, list) or not all(isinstance(item, str) for item in raw):
            raise ToolError("modifiers must be an array of canonical modifier names")
        allowed = {"Shift": "SHIFT", "Ctrl": "CTRL", "Alt": "ALT", "Super": "SUPER", "AltGr": "ALTGR"}
        if len(raw) > len(allowed) or len(set(raw)) != len(raw) or any(item not in allowed for item in raw):
            raise ToolError("modifiers must be a unique subset of Shift, Ctrl, Alt, Super, and AltGr")
        if self.is_wayland:
            yield list(raw)
            return
        self._require_keyboard_healthy()
        if self.x11_pressed_modifier_codes:
            self._quarantine_keyboard("an X11 pointer modifier arc began while modifiers were already tracked")
            raise ToolError("private X11 keyboard controller already has held modifiers")
        if not raw:
            yield []
            return
        codes: list[int] = []
        for item in raw:
            code = self.modifier_codes.get(allowed[item], 0)
            if not code:
                raise ToolError(f"pointer modifier is unavailable in the X11 keymap: {item}")
            codes.append(code)
        try:
            for code in codes:
                self._fake_keycode(code, True)
                self.x11_pressed_modifier_codes.append(code)
            self._sync()
            yield list(raw)
        finally:
            if self.x11_pressed_modifier_codes:
                release_error: Exception | None = None
                for code in reversed(self.x11_pressed_modifier_codes):
                    try:
                        self._fake_keycode(code, False)
                    except Exception as error:
                        release_error = error
                try:
                    self._sync()
                except Exception as error:
                    release_error = error
                if release_error is None:
                    self.x11_pressed_modifier_codes.clear()
                else:
                    self._quarantine_keyboard(
                        "X11 pointer modifiers could not be confirmed released",
                        release_failure=True,
                    )
                    raise ToolError(
                        "X11 pointer modifier release could not be confirmed; keyboard input is quarantined"
                    ) from release_error

    def _keysym_for_token(self, token: str) -> int:
        upper = token.upper()
        name = self.named_keys.get(upper, token if len(token) > 1 else token)
        keysym = ord(token) if len(token) == 1 and ord(token) < 256 else XK.string_to_keysym(name)
        if keysym == X.NoSymbol:
            raise ToolError(f"unknown key: {token}")
        return keysym

    def _press_chord(self, chord: str) -> None:
        chord = as_string(chord, "chord", maximum=256, allow_empty=False)
        tokens = [token.strip() for token in chord.split("+") if token.strip()]
        if not tokens:
            raise ToolError("chord is empty")
        if self.is_wayland:
            self._require_keyboard_healthy()
            transaction = getattr(self, "_active_keyboard_transaction", None)
            if transaction is not None:
                transaction.chord(chord)
                return
            with WaylandKeyboardTransaction(self, "desktop_key-direct") as transaction:
                transaction.prepare_chord(chord)
                transaction.chord(chord)
            return
        modifiers: list[int] = []
        key_token: str | None = None
        for token in tokens:
            upper = token.upper()
            if upper in self.modifier_codes:
                code = self.modifier_codes[upper]
                if code not in modifiers:
                    modifiers.append(code)
            elif key_token is None:
                key_token = token
            else:
                raise ToolError("a chord may contain only one non-modifier key")
        if key_token is None:
            raise ToolError("a chord must contain a non-modifier key")
        keysym = self._keysym_for_token(key_token)
        keycode = self.display.keysym_to_keycode(keysym)
        pressed_modifiers: list[int] = []
        key_pressed = False
        try:
            for code in modifiers:
                self._fake_keycode(code, True)
                pressed_modifiers.append(code)
            self._fake_keycode(keycode, True)
            key_pressed = True
            self._fake_keycode(keycode, False)
            key_pressed = False
        finally:
            if key_pressed:
                self._fake_keycode(keycode, False)
            for code in reversed(pressed_modifiers):
                self._fake_keycode(code, False)
            self._sync()

    def _type_keys(self, text: str, interval: float) -> None:
        if self.is_wayland:
            self._require_keyboard_healthy()
            active = getattr(self, "_active_keyboard_transaction", None)
            if active is not None:
                for index, character in enumerate(text):
                    active.character(character)
                    if interval and index + 1 < len(text):
                        time.sleep(interval)
                return
            with WaylandKeyboardTransaction(self, "desktop_type-direct") as transaction:
                transaction.prepare_characters(text)
                for index, character in enumerate(text):
                    transaction.character(character)
                    if interval and index + 1 < len(text):
                        time.sleep(interval)
            return
        for character in text:
            if character == "\n":
                keysym = XK.string_to_keysym("Return")
            elif character == "\t":
                keysym = XK.string_to_keysym("Tab")
            else:
                keysym = ord(character) if ord(character) < 256 else XK.string_to_keysym(character)
            mapping = self._keyboard_map.get(keysym)
            if mapping is None:
                raise ToolError(f"character is not present in the X11 keymap: U+{ord(character):04X}")
            keycode, shifted = mapping
            shift_pressed = False
            key_pressed = False
            try:
                if shifted:
                    self._fake_keycode(self.shift_code, True)
                    shift_pressed = True
                self._fake_keycode(keycode, True)
                key_pressed = True
                self._fake_keycode(keycode, False)
                key_pressed = False
            finally:
                if key_pressed:
                    self._fake_keycode(keycode, False)
                if shift_pressed:
                    self._fake_keycode(self.shift_code, False)
            self.display.flush()
            if interval:
                time.sleep(interval)
        self._sync()

    def _move(self, x: int, y: int) -> None:
        self._require_pointer_healthy()
        if getattr(self, "pointer_pressed_button", None) is not None and not getattr(self, "_pointer_drag_active", False):
            raise ToolError("pointer movement is denied while a button is held outside the guarded drag transaction")
        if self.is_wayland:
            transaction = getattr(self, "_active_pointer_transaction", None)
            if transaction is not None:
                transaction.motion(x, y)
                return
            with WaylandPointerTransaction(self, "desktop_move-direct") as transaction:
                transaction.motion(x, y)
            return
        xtest.fake_input(self.display, X.MotionNotify, x=x, y=y)
        self._sync()

    def _click(self, button: int) -> None:
        self._require_pointer_healthy()
        if getattr(self, "pointer_pressed_button", None) is not None:
            raise ToolError("click is denied while another pointer button is held")
        if self.is_wayland:
            transaction = getattr(self, "_active_pointer_transaction", None)
            if transaction is not None:
                transaction.click(button)
                return
            with WaylandPointerTransaction(self, "desktop_click-direct") as transaction:
                transaction.click(button)
            return
        xtest.fake_input(self.display, X.ButtonPress, button)
        xtest.fake_input(self.display, X.ButtonRelease, button)
        self._sync()

    def _press_pointer_button(self, button: int) -> None:
        self._require_pointer_healthy()
        if getattr(self, "pointer_pressed_button", None) is not None:
            self._quarantine_pointer("a second pointer press was requested while a button was already held")
            raise ToolError("private pointer controller already has a held button")
        if self.is_wayland:
            if button not in {1, 2, 3}:
                raise ToolError("native Wayland drag supports buttons 1, 2, and 3")
            transaction = getattr(self, "_active_pointer_transaction", None)
            if transaction is None:
                raise ToolError("Wayland button press requires one persistent virtual-pointer transaction")
            transaction.button(button, True)
            return
        self.pointer_pressed_button = button
        try:
            xtest.fake_input(self.display, X.ButtonPress, button)
            self.display.flush()
        except Exception:
            # The controller may have accepted the press before reporting a
            # transport error. Keep the held-state marker so the caller must
            # execute verified release cleanup.
            raise

    def _release_pointer_button(self, button: int, *, quarantine_on_failure: bool = True) -> int:
        held = getattr(self, "pointer_pressed_button", None)
        if held is not None and held != button:
            if quarantine_on_failure:
                self._quarantine_pointer(
                    f"release button {button} did not match held button {held}",
                    release_failure=True,
                )
            raise ToolError("pointer release did not match the tracked held button")
        if self.is_wayland and button not in {1, 2, 3}:
            raise ToolError("native Wayland drag supports buttons 1, 2, and 3")
        if self.is_wayland:
            transaction = getattr(self, "_active_pointer_transaction", None)
            if transaction is None:
                if quarantine_on_failure:
                    self._quarantine_pointer(
                        "Wayland button release lost its birth-pinned virtual-pointer transaction",
                        release_failure=True,
                    )
                raise ToolError("Wayland button release requires its persistent virtual-pointer transaction")
            transaction.button(button, False)
            return 1
        attempts = 0
        last_error: Exception | None = None
        for attempts in range(1, 3 if self.is_wayland else 2):
            try:
                xtest.fake_input(self.display, X.ButtonRelease, button)
                self._sync()
                self.pointer_pressed_button = None
                return attempts
            except Exception as error:
                last_error = error
        reason = f"button {button} release could not be confirmed after {attempts} attempt(s)"
        if quarantine_on_failure:
            self._quarantine_pointer(reason, release_failure=True)
        raise ToolError(reason) from last_error

    def _safe_output(self, filename: str) -> Path:
        filename = as_string(filename, "filename", maximum=240, allow_empty=False)
        if filename != Path(filename).name or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,239}", filename):
            raise ToolError("filename must be one safe basename")
        if not filename.lower().endswith(".png"):
            filename += ".png"
        destination = self.output / filename
        if destination.exists() and destination.is_symlink():
            raise ToolError("screenshot destination is a symlink")
        return destination

    @staticmethod
    def _validate_capture_rect(value: Any, label: str) -> dict[str, int] | None:
        if value is None:
            return None
        if not isinstance(value, dict) or set(value) != {"x", "y", "width", "height"}:
            raise ToolError(f"{label} must be one exact rectangle")
        rectangle: dict[str, int] = {}
        for key in ("x", "y", "width", "height"):
            item = value.get(key)
            if isinstance(item, bool) or not isinstance(item, int):
                raise ToolError(f"{label}.{key} must be an integer")
            rectangle[key] = item
        if rectangle["width"] <= 0 or rectangle["height"] <= 0:
            raise ToolError(f"{label} must have positive dimensions")
        return rectangle

    @classmethod
    def _wayland_toplevel_capture_extent(cls, window: dict[str, Any]) -> dict[str, int]:
        """Return the authenticated xdg-toplevel content rectangle.

        Sway's top-level ``rect`` is the compositor container. ``window_rect``
        is the surface-content rectangle relative to that container. The
        foreign-toplevel capture source is a separate wlroots scene rooted at
        that xdg-toplevel; popup and subsurface trees may enlarge its pixel
        extent. This method therefore authenticates the stable content anchor,
        while :meth:`_popup_anchor_capture_extent` proves any larger frame's
        origin against a same-workstation output capture.
        """
        container = cls._validate_capture_rect({
            "x": window.get("x"),
            "y": window.get("y"),
            "width": window.get("width"),
            "height": window.get("height"),
        }, "Sway top-level container rectangle")
        content = cls._validate_capture_rect(
            window.get("window_rect"), "Sway top-level content rectangle"
        )
        if container is None or content is None:
            raise ToolError("Sway top-level capture geometry is absent")
        if content["x"] < 0 or content["y"] < 0:
            raise ToolError("Sway top-level content origin escapes its container")
        if (
            content["x"] + content["width"] > container["width"]
            or content["y"] + content["height"] > container["height"]
        ):
            raise ToolError("Sway top-level content extent escapes its container")
        return {
            "x": container["x"] + content["x"],
            "y": container["y"] + content["y"],
            "width": content["width"],
            "height": content["height"],
        }

    @staticmethod
    def _capture_output_intersection(
        rectangle: dict[str, int], output_width: int, output_height: int,
    ) -> dict[str, int] | None:
        left = max(0, int(rectangle["x"]))
        top = max(0, int(rectangle["y"]))
        right = min(output_width, int(rectangle["x"]) + int(rectangle["width"]))
        bottom = min(output_height, int(rectangle["y"]) + int(rectangle["height"]))
        if right <= left or bottom <= top:
            return None
        return {"x": left, "y": top, "width": right - left, "height": bottom - top}

    @staticmethod
    def _popup_anchor_spread(maximum: int, count: int = 7) -> list[int]:
        if maximum <= 0:
            return [0]
        count = max(2, min(count, maximum + 1))
        return sorted({round(index * maximum / (count - 1)) for index in range(count)})

    @staticmethod
    def _popup_anchor_patch_distinctiveness(payload: bytes) -> bool:
        pixels = [payload[index:index + 3] for index in range(0, len(payload), 3)]
        if not pixels:
            return False
        unique = set(pixels)
        transitions = sum(left != right for left, right in zip(pixels, pixels[1:]))
        return len(unique) >= min(6, max(3, len(pixels) // 8)) and transitions >= min(4, max(2, len(pixels) // 12))

    @classmethod
    def _popup_anchor_patch_matches(
        cls,
        direct_rgb: Image.Image,
        patch: Image.Image,
        *,
        maximum_hits: int = POPUP_ANCHOR_MAX_HITS_PER_PATCH,
    ) -> list[tuple[int, int]] | None:
        """Locate one exact RGB strip, returning ``None`` when it is ambiguous.

        The first patch row is searched with bounded byte-string scans and all
        remaining rows are then verified exactly. A highly repetitive patch is
        rejected instead of allowing attacker-controlled pixels to create an
        unbounded search or a low-confidence coordinate claim.
        """
        patch = patch.convert("RGB")
        direct_rgb = direct_rgb.convert("RGB")
        patch_width, patch_height = patch.size
        direct_width, direct_height = direct_rgb.size
        if patch_width <= 0 or patch_height <= 0 or patch_width > direct_width or patch_height > direct_height:
            return []
        direct_bytes = direct_rgb.tobytes()
        patch_bytes = patch.tobytes()
        direct_stride = direct_width * 3
        patch_stride = patch_width * 3
        needle = patch_bytes[:patch_stride]
        hits: list[tuple[int, int]] = []
        for y in range(direct_height - patch_height + 1):
            row_start = y * direct_stride
            row = direct_bytes[row_start:row_start + direct_stride]
            search_from = 0
            while True:
                offset = row.find(needle, search_from)
                if offset < 0:
                    break
                search_from = offset + 1
                if offset % 3:
                    continue
                x = offset // 3
                if x + patch_width > direct_width:
                    continue
                matched = True
                for patch_y in range(1, patch_height):
                    direct_start = (y + patch_y) * direct_stride + x * 3
                    patch_start = patch_y * patch_stride
                    if direct_bytes[direct_start:direct_start + patch_stride] != patch_bytes[patch_start:patch_start + patch_stride]:
                        matched = False
                        break
                if matched:
                    hits.append((x, y))
                    if len(hits) > maximum_hits:
                        return None
        return hits

    @classmethod
    def _verify_popup_anchor_candidate(
        cls,
        direct_rgba: Image.Image,
        output_anchor: Image.Image,
        anchor_local: tuple[int, int],
        content_offset: tuple[int, int],
    ) -> int | None:
        """Return exact opaque-pixel support for one candidate, or ``None``.

        The synthetic capture output can retain alpha outside application
        surfaces while the workstation output is already composited. Only
        effectively opaque pixels are therefore compared, and every such pixel
        must agree exactly. This is intentionally stricter than perceptual image
        matching: a coordinate authority claim is either corroborated or it is
        withheld.
        """
        anchor_x, anchor_y = anchor_local
        offset_x, offset_y = content_offset
        width, height = output_anchor.size
        left = offset_x + anchor_x
        top = offset_y + anchor_y
        if left < 0 or top < 0 or left + width > direct_rgba.width or top + height > direct_rgba.height:
            return None
        candidate = direct_rgba.crop((left, top, left + width, top + height)).convert("RGBA")
        alpha = candidate.getchannel("A")
        histogram = alpha.histogram()
        opaque_pixels = sum(histogram[250:])
        minimum = min(width * height, max(POPUP_ANCHOR_MIN_OPAQUE_PIXELS, (width * height) // 50))
        if opaque_pixels < minimum:
            return None
        mask = alpha.point(lambda value: 255 if value >= 250 else 0)
        difference = ImageChops.difference(candidate.convert("RGB"), output_anchor.convert("RGB"))
        black = Image.new("RGB", difference.size, (0, 0, 0))
        if Image.composite(difference, black, mask).getbbox() is not None:
            return None
        return opaque_pixels

    @classmethod
    def _popup_anchor_capture_extent(
        cls,
        direct_rgba: Image.Image,
        output_rgb: Image.Image,
        content_rect: dict[str, int],
    ) -> tuple[dict[str, int], dict[str, Any]]:
        """Map one popup-expanded direct frame into private-output coordinates.

        wlroots exposes the direct scene's dimensions but not its extents origin.
        The trusted controller therefore correlates distinctive scale-1 pixel
        strips from the visible authenticated xdg-toplevel content rectangle
        against the popup-inclusive direct frame. Candidate translations are
        bounded, then the complete visible content anchor is verified over every
        opaque direct pixel. Exactly one translation must survive.
        """
        if direct_rgba.width < content_rect["width"] or direct_rgba.height < content_rect["height"]:
            raise ToolError("popup-inclusive direct capture is smaller than its authenticated toplevel content")
        visible = cls._capture_output_intersection(content_rect, output_rgb.width, output_rgb.height)
        if visible is None:
            raise ToolError("popup anchor has no visible authenticated toplevel content")
        anchor_local = (
            visible["x"] - content_rect["x"],
            visible["y"] - content_rect["y"],
        )
        output_anchor = output_rgb.crop((
            visible["x"], visible["y"],
            visible["x"] + visible["width"], visible["y"] + visible["height"],
        )).convert("RGB")
        anchor_width, anchor_height = output_anchor.size
        if anchor_width < 4 or anchor_height < 3:
            raise ToolError("popup anchor has too little visible content for a unique coordinate proof")

        patch_width = min(48, max(4, anchor_width // 8))
        patch_height = min(3, anchor_height)
        x_values = cls._popup_anchor_spread(anchor_width - patch_width)
        y_values = cls._popup_anchor_spread(anchor_height - patch_height)
        direct_rgb = direct_rgba.convert("RGB")
        support: dict[tuple[int, int], set[tuple[int, int]]] = {}
        examined = 0
        distinctive = 0
        for patch_y in y_values:
            for patch_x in x_values:
                if examined >= POPUP_ANCHOR_MAX_PATCHES:
                    break
                examined += 1
                patch = output_anchor.crop((
                    patch_x, patch_y, patch_x + patch_width, patch_y + patch_height,
                ))
                if not cls._popup_anchor_patch_distinctiveness(patch.tobytes()):
                    continue
                distinctive += 1
                hits = cls._popup_anchor_patch_matches(direct_rgb, patch)
                if hits is None:
                    continue
                content_patch_x = anchor_local[0] + patch_x
                content_patch_y = anchor_local[1] + patch_y
                for hit_x, hit_y in hits:
                    candidate = (hit_x - content_patch_x, hit_y - content_patch_y)
                    if (
                        candidate[0] < 0 or candidate[1] < 0
                        or candidate[0] + content_rect["width"] > direct_rgba.width
                        or candidate[1] + content_rect["height"] > direct_rgba.height
                    ):
                        continue
                    support.setdefault(candidate, set()).add((patch_x, patch_y))
                    if len(support) > POPUP_ANCHOR_MAX_CANDIDATES:
                        raise ToolError("popup anchor produced too many coordinate candidates")
            if examined >= POPUP_ANCHOR_MAX_PATCHES:
                break
        eligible = [
            (candidate, patches)
            for candidate, patches in support.items()
            if len(patches) >= POPUP_ANCHOR_MIN_SUPPORT_PATCHES
        ]
        if not eligible:
            raise ToolError("popup anchor could not derive a corroborated coordinate candidate")
        eligible.sort(key=lambda item: (-len(item[1]), item[0]))
        top_support = len(eligible[0][1])
        contenders = [item for item in eligible if len(item[1]) >= max(POPUP_ANCHOR_MIN_SUPPORT_PATCHES, top_support - 1)]
        if len(contenders) > POPUP_ANCHOR_MAX_VERIFICATION_CANDIDATES:
            raise ToolError("popup anchor coordinate candidates remain unbounded or ambiguous")

        verified: list[tuple[tuple[int, int], int, set[tuple[int, int]]]] = []
        for candidate, patches in contenders:
            opaque_pixels = cls._verify_popup_anchor_candidate(
                direct_rgba, output_anchor, anchor_local, candidate,
            )
            if opaque_pixels is None:
                continue
            xs = {value[0] for value in patches}
            ys = {value[1] for value in patches}
            if anchor_width >= 16 and len(xs) < 2:
                continue
            if anchor_height >= 8 and len(ys) < 2:
                continue
            verified.append((candidate, opaque_pixels, patches))
        if len(verified) != 1:
            reason = "ambiguous" if verified else "unverified"
            raise ToolError(f"popup anchor coordinate map is {reason}; scoped activation was withheld")
        (offset_x, offset_y), opaque_pixels, patches = verified[0]
        extent = {
            "x": content_rect["x"] - offset_x,
            "y": content_rect["y"] - offset_y,
            "width": direct_rgba.width,
            "height": direct_rgba.height,
        }
        evidence = {
            "schema": POPUP_ANCHOR_SCHEMA,
            "method": "opaque-exact-content-corroboration",
            "content_offset": {"x": offset_x, "y": offset_y},
            "supporting_patches": len(patches),
            "distinctive_patches": distinctive,
            "candidate_count": len(support),
            "verified_opaque_pixels": opaque_pixels,
            "visible_anchor": visible,
        }
        return extent, evidence

    @classmethod
    def _validate_scene_transient_map(cls, value: Any) -> dict[str, Any]:
        """Validate one controller-private exact popup-pixel ownership map.

        SceneSetSeal intentionally combines visibility from independent launch
        principals.  A popup has no Sway top-level rectangle, so visibility alone
        must never become input authority.  PopupMeshSeal stores only pixels that
        are simultaneously outside every visible top-level, effectively opaque in
        one exact direct-toplevel capture, byte-for-byte equal to the same private-
        output pixel, and supported by a complete same-owner neighborhood after
        cross-owner overlap has been resolved.  Ambiguous pixels are retained only
        as a count and can never be looked up as an owner.
        """
        if not isinstance(value, dict):
            raise ToolError("scene transient map must be an object")
        required = {
            "schema", "width", "height", "scene_set_authority_sha256",
            "output_sha256", "interior_radius", "owners", "spans",
            "attributed_pixels", "ambiguous_pixels", "map_sha256",
        }
        if set(value) != required:
            raise ToolError("scene transient map fields are incomplete")
        if value.get("schema") != SCENE_TRANSIENT_MAP_SCHEMA:
            raise ToolError("scene transient map schema is unsupported")
        width = value.get("width")
        height = value.get("height")
        if (
            isinstance(width, bool) or not isinstance(width, int) or not 1 <= width <= 32768
            or isinstance(height, bool) or not isinstance(height, int) or not 1 <= height <= 32768
            or width * height > 64 * 1024 * 1024
        ):
            raise ToolError("scene transient map dimensions are invalid")
        for key in ("scene_set_authority_sha256", "output_sha256", "map_sha256"):
            digest = value.get(key)
            if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                raise ToolError(f"scene transient map {key} is invalid")
        interior_radius = value.get("interior_radius")
        if (
            isinstance(interior_radius, bool)
            or not isinstance(interior_radius, int)
            or interior_radius != SCENE_TRANSIENT_INTERIOR_RADIUS
        ):
            raise ToolError("scene transient map interior radius is invalid")

        owners = value.get("owners")
        if not isinstance(owners, list) or len(owners) > SCENE_TRANSIENT_MAX_TOPLEVELS:
            raise ToolError("scene transient map owner set is invalid")
        validated_owners: list[dict[str, Any]] = []
        seen_windows: set[int] = set()
        for expected_index, owner in enumerate(owners, 1):
            if not isinstance(owner, dict) or set(owner) != {
                "index", "launch_id", "window_id", "capture_identity_sha256",
                "window_authority_sha256", "content_rect", "full_window_rect",
                "mapping_evidence_sha256", "owner_sha256",
            }:
                raise ToolError("scene transient map owner is malformed")
            if owner.get("index") != expected_index:
                raise ToolError("scene transient map owner indexes are not canonical")
            launch_id = owner.get("launch_id")
            if not isinstance(launch_id, str) or re.fullmatch(r"launch-[0-9a-f]{24}", launch_id) is None:
                raise ToolError("scene transient map owner launch identity is invalid")
            window_id = owner.get("window_id")
            if isinstance(window_id, bool) or not isinstance(window_id, int) or window_id <= 0:
                raise ToolError("scene transient map owner window identity is invalid")
            if window_id in seen_windows:
                raise ToolError("scene transient map repeats one top-level owner")
            seen_windows.add(window_id)
            for key in (
                "capture_identity_sha256", "window_authority_sha256",
                "mapping_evidence_sha256", "owner_sha256",
            ):
                digest = owner.get(key)
                if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                    raise ToolError(f"scene transient map owner {key} is invalid")
            content_rect = cls._validate_capture_rect(
                owner.get("content_rect"), "scene transient owner content rectangle"
            )
            full_window_rect = cls._validate_capture_rect(
                owner.get("full_window_rect"), "scene transient owner full rectangle"
            )
            assert content_rect is not None and full_window_rect is not None
            if (
                content_rect["x"] < full_window_rect["x"]
                or content_rect["y"] < full_window_rect["y"]
                or content_rect["x"] + content_rect["width"]
                > full_window_rect["x"] + full_window_rect["width"]
                or content_rect["y"] + content_rect["height"]
                > full_window_rect["y"] + full_window_rect["height"]
            ):
                raise ToolError("scene transient owner content escapes its exact direct frame")
            owner_projection = {
                "launch_id": launch_id,
                "window_id": window_id,
                "capture_identity_sha256": owner["capture_identity_sha256"],
                "window_authority_sha256": owner["window_authority_sha256"],
                "content_rect": content_rect,
                "full_window_rect": full_window_rect,
                "mapping_evidence_sha256": owner["mapping_evidence_sha256"],
            }
            if not hmac.compare_digest(owner["owner_sha256"], cls._authority_digest(owner_projection)):
                raise ToolError("scene transient map owner digest is inconsistent")
            validated_owners.append({**owner, "content_rect": content_rect, "full_window_rect": full_window_rect})

        spans = value.get("spans")
        if not isinstance(spans, list) or len(spans) > SCENE_TRANSIENT_MAX_SPANS:
            raise ToolError("scene transient map span set is invalid")
        attributed_pixels = value.get("attributed_pixels")
        ambiguous_pixels = value.get("ambiguous_pixels")
        for label, count in (
            ("attributed", attributed_pixels), ("ambiguous", ambiguous_pixels),
        ):
            if (
                isinstance(count, bool) or not isinstance(count, int)
                or count < 0 or count > width * height
            ):
                raise ToolError(f"scene transient map {label} pixel count is invalid")
        normalized_spans: list[list[int]] = []
        counted_pixels = 0
        previous: tuple[int, int] | None = None
        for span in spans:
            if (
                not isinstance(span, list) or len(span) != 4
                or any(isinstance(item, bool) or not isinstance(item, int) for item in span)
            ):
                raise ToolError("scene transient map span is malformed")
            y, left, right, owner_index = span
            if (
                not 0 <= y < height or not 0 <= left < right <= width
                or not 1 <= owner_index <= len(validated_owners)
            ):
                raise ToolError("scene transient map span escapes its sealed output")
            if previous is not None:
                previous_y, previous_right = previous
                if y < previous_y or (y == previous_y and left < previous_right):
                    raise ToolError("scene transient map spans overlap or are not canonical")
            previous = (y, right)
            counted_pixels += right - left
            normalized_spans.append([y, left, right, owner_index])
        if counted_pixels != attributed_pixels:
            raise ToolError("scene transient map attributed pixel count is inconsistent")
        if attributed_pixels + ambiguous_pixels > width * height:
            raise ToolError("scene transient map pixel accounting exceeds its output")
        projection = dict(value)
        projection.pop("map_sha256", None)
        if not hmac.compare_digest(value["map_sha256"], cls._authority_digest(projection)):
            raise ToolError("scene transient map digest is inconsistent")
        return {
            **value,
            "owners": validated_owners,
            "spans": normalized_spans,
        }

    @classmethod
    def _scene_transient_owner_at(
        cls,
        transient_map: dict[str, Any],
        x: int,
        y: int,
    ) -> dict[str, Any] | None:
        value = cls._validate_scene_transient_map(transient_map)
        if not 0 <= x < value["width"] or not 0 <= y < value["height"]:
            return None
        for span_y, left, right, owner_index in value["spans"]:
            if span_y < y:
                continue
            if span_y > y or left > x:
                return None
            if left <= x < right:
                return dict(value["owners"][owner_index - 1])
        return None

    def _scene_transient_direct_capture(
        self,
        window: dict[str, Any],
        output_rgb: Image.Image,
    ) -> tuple[Image.Image, dict[str, int], dict[str, int], dict[str, Any], str, str]:
        """Capture and map one exact member toplevel without disclosing its handle."""
        window_id = parse_window_id(window.get("id"))
        foreign_identifier = window.get("_foreign_toplevel_identifier")
        identifier_sha256 = window.get("capture_identity_sha256")
        if (
            self._foreign_toplevel_identifier(foreign_identifier) is None
            or not isinstance(identifier_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", identifier_sha256) is None
            or hashlib.sha256(foreign_identifier.encode("ascii")).hexdigest() != identifier_sha256
        ):
            raise ToolError("scene transient owner lacks an exact compositor capture identity")
        content_rect = self._wayland_toplevel_capture_extent(window)
        window_authority_sha256 = self._capture_window_authority_sha256(window)
        completed = self._run_controller(
            [self.commands["grim"], "-T", foreign_identifier, "-"],
            timeout=15,
        )
        direct_rgba = self._decode_grim_png(
            completed.stdout,
            mode="RGBA",
            maximum_width=max(self.width * 2, content_rect["width"]),
            maximum_height=max(self.height * 2, content_rect["height"]),
            maximum_pixels=max(
                self.width * self.height * 4,
                content_rect["width"] * content_rect["height"],
            ),
        )
        current = next(
            (item for item in self._wayland_windows() if item.get("id") == window_id),
            None,
        )
        if current is None:
            raise ToolError("scene transient owner disappeared while its direct frame was in flight")
        current_identifier = current.get("_foreign_toplevel_identifier")
        current_identifier_sha256 = current.get("capture_identity_sha256")
        if (
            self._foreign_toplevel_identifier(current_identifier) is None
            or not hmac.compare_digest(foreign_identifier, current_identifier)
            or not isinstance(current_identifier_sha256, str)
            or not hmac.compare_digest(identifier_sha256, current_identifier_sha256)
            or not hmac.compare_digest(
                window_authority_sha256,
                self._capture_window_authority_sha256(current),
            )
        ):
            raise ToolError("scene transient owner authority changed during direct capture")
        expected_size = (content_rect["width"], content_rect["height"])
        if direct_rgba.width < expected_size[0] or direct_rgba.height < expected_size[1]:
            raise ToolError("scene transient direct frame is smaller than its authenticated content")
        if direct_rgba.size == expected_size:
            full_window_rect = dict(content_rect)
            mapping_evidence = {
                "schema": POPUP_ANCHOR_SCHEMA,
                "method": "exact-content-extent-no-external-transient",
                "content_offset": {"x": 0, "y": 0},
                "verified_opaque_pixels": content_rect["width"] * content_rect["height"],
            }
        else:
            full_window_rect, mapping_evidence = self._popup_anchor_capture_extent(
                direct_rgba,
                output_rgb,
                content_rect,
            )
        return (
            direct_rgba,
            content_rect,
            full_window_rect,
            mapping_evidence,
            identifier_sha256,
            window_authority_sha256,
        )

    @staticmethod
    def _erode_scene_transient_candidate(mask: Image.Image) -> Image.Image:
        """Keep only pixels with a complete same-owner visual interior.

        PopupMeshSeal itself does not infer a popup surface's input region.
        HitTestSeal supplies that independent compositor fact only at route and
        dispatch time.  The visual map still refuses edge pixels and thin
        artifacts: every retained coordinate must have a full
        (2r+1)-square neighborhood of exact opaque pixels from the same direct
        capture.  Explicit zero padding ensures image-boundary pixels cannot
        inherit Pillow's edge extension behavior.
        """
        if mask.mode != "L":
            raise ToolError("scene transient candidate mask must be grayscale")
        bounds = mask.getbbox()
        if bounds is None:
            return Image.new("L", mask.size, 0)
        radius = SCENE_TRANSIENT_INTERIOR_RADIUS
        region = mask.crop(bounds)
        padded = Image.new(
            "L",
            (region.width + radius * 2, region.height + radius * 2),
            0,
        )
        padded.paste(region, (radius, radius))
        filtered = padded.filter(ImageFilter.MinFilter(radius * 2 + 1)).crop((
            radius, radius, radius + region.width, radius + region.height,
        ))
        result = Image.new("L", mask.size, 0)
        result.paste(filtered, (bounds[0], bounds[1]))
        return result

    def _erode_scene_transient_ownership(
        self,
        ownership: bytearray,
        owners: list[dict[str, Any]],
    ) -> tuple[bytearray, int]:
        """Require one complete same-owner neighborhood after overlap resolution.

        Per-capture erosion is insufficient: two independently valid direct
        captures can overlap, and a pixel near that ambiguity could otherwise
        retain authority even though its supporting neighborhood is not uniquely
        owned.  Build each owner mask from the resolved ownership map, where zero,
        another owner, and the ambiguity marker are all non-owner pixels, then
        erode that bounded mask before publishing any actionable span.
        """
        if len(ownership) != self.width * self.height:
            raise ToolError("scene transient ownership dimensions are inconsistent")
        ambiguous_pixels = ownership.count(255)
        interior = bytearray(len(ownership))
        for owner in owners:
            owner_index = owner.get("index")
            if (
                isinstance(owner_index, bool)
                or not isinstance(owner_index, int)
                or not 1 <= owner_index < 255
            ):
                raise ToolError("scene transient owner index is invalid during interior sealing")
            bounds = self._capture_output_intersection(
                owner.get("full_window_rect"),
                self.width,
                self.height,
            )
            if bounds is None:
                continue
            left = bounds["x"]
            top = bounds["y"]
            width = bounds["width"]
            height = bounds["height"]
            mask_bytes = bytearray(width * height)
            for local_y in range(height):
                source_offset = (top + local_y) * self.width + left
                target_offset = local_y * width
                source_row = ownership[source_offset:source_offset + width]
                mask_bytes[target_offset:target_offset + width] = bytes(
                    255 if value == owner_index else 0 for value in source_row
                )
            mask = Image.frombytes("L", (width, height), bytes(mask_bytes))
            eroded = self._erode_scene_transient_candidate(mask)
            eroded_bounds = eroded.getbbox()
            if eroded_bounds is None:
                continue
            crop_left, crop_top, crop_right, crop_bottom = eroded_bounds
            payload = eroded.crop(eroded_bounds).tobytes()
            payload_width = crop_right - crop_left
            for local_y in range(crop_bottom - crop_top):
                global_y = top + crop_top + local_y
                row_offset = global_y * self.width
                payload_offset = local_y * payload_width
                for local_x in range(payload_width):
                    if payload[payload_offset + local_x] != 0:
                        interior[row_offset + left + crop_left + local_x] = owner_index
        return interior, ambiguous_pixels

    def _build_scene_transient_map(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        output_rgb: Image.Image,
        authority: dict[str, Any],
    ) -> dict[str, Any]:
        """Derive exact member ownership for uncovered opaque transient pixels."""
        if output_rgb.mode != "RGB" or output_rgb.size != (self.width, self.height):
            raise ToolError("scene transient attribution requires the exact RGB private output")
        validated_authority = self._assert_scene_set_authority(
            members,
            authority.get("authority_sha256"),
            windows,
        )
        if validated_authority != authority:
            raise ToolError("scene transient attribution received inconsistent scene authority")
        visible = sorted(
            (window for window in windows if window.get("visible", True)),
            key=lambda window: parse_window_id(window.get("id")),
        )
        if len(visible) > SCENE_TRANSIENT_MAX_TOPLEVELS:
            raise ToolError(
                "scene transient attribution exceeds its exact direct-capture top-level limit"
            )
        allowed = {member.launch_id for member in members}
        uncovered = Image.new("L", (self.width, self.height), 255)
        draw = ImageDraw.Draw(uncovered)
        for window in visible:
            if window.get("launch_id") not in allowed or window.get("origin_verified") is not True:
                raise ToolError("scene transient attribution encountered a non-member top-level")
            outer = self._capture_output_intersection({
                "x": int(window.get("x")),
                "y": int(window.get("y")),
                "width": int(window.get("width")),
                "height": int(window.get("height")),
            }, self.width, self.height)
            if outer is not None:
                draw.rectangle((
                    outer["x"],
                    outer["y"],
                    outer["x"] + outer["width"] - 1,
                    outer["y"] + outer["height"] - 1,
                ), fill=0)

        ownership = bytearray(self.width * self.height)
        owners: list[dict[str, Any]] = []
        for window in visible:
            (
                direct_rgba, content_rect, full_window_rect, mapping_evidence,
                identifier_sha256, window_authority_sha256,
            ) = self._scene_transient_direct_capture(window, output_rgb)
            # A frame identical to the authenticated content rectangle cannot
            # contribute a pixel outside every visible top-level.
            if full_window_rect == content_rect:
                continue
            intersection = self._capture_output_intersection(
                full_window_rect,
                self.width,
                self.height,
            )
            if intersection is None:
                continue
            local_left = intersection["x"] - full_window_rect["x"]
            local_top = intersection["y"] - full_window_rect["y"]
            local_right = local_left + intersection["width"]
            local_bottom = local_top + intersection["height"]
            direct_visible = direct_rgba.crop((local_left, local_top, local_right, local_bottom))
            output_visible = output_rgb.crop((
                intersection["x"], intersection["y"],
                intersection["x"] + intersection["width"],
                intersection["y"] + intersection["height"],
            ))
            alpha = direct_visible.getchannel("A").point(
                lambda item: 255 if item >= SCENE_TRANSIENT_ALPHA_THRESHOLD else 0
            )
            difference = ImageChops.difference(direct_visible.convert("RGB"), output_visible)
            red, green, blue = difference.split()
            nonzero = ImageChops.lighter(ImageChops.lighter(red, green), blue)
            exact = nonzero.point(lambda item: 255 if item == 0 else 0)
            candidate = ImageChops.multiply(alpha, exact)
            candidate = ImageChops.multiply(
                candidate,
                uncovered.crop((
                    intersection["x"], intersection["y"],
                    intersection["x"] + intersection["width"],
                    intersection["y"] + intersection["height"],
                )),
            )
            bounds = candidate.getbbox()
            if bounds is None:
                continue
            owner_index = len(owners) + 1
            if owner_index >= 255 or owner_index > SCENE_TRANSIENT_MAX_TOPLEVELS:
                raise ToolError("scene transient owner index exceeds its bounded map")
            evidence_sha256 = hashlib.sha256(canonical_json(mapping_evidence)).hexdigest()
            owner_projection = {
                "launch_id": str(window.get("launch_id")),
                "window_id": parse_window_id(window.get("id")),
                "capture_identity_sha256": identifier_sha256,
                "window_authority_sha256": window_authority_sha256,
                "content_rect": dict(content_rect),
                "full_window_rect": dict(full_window_rect),
                "mapping_evidence_sha256": evidence_sha256,
            }
            owners.append({
                "index": owner_index,
                **owner_projection,
                "owner_sha256": self._authority_digest(owner_projection),
            })
            candidate_left, candidate_top, candidate_right, candidate_bottom = bounds
            payload = candidate.crop(bounds).tobytes()
            payload_width = candidate_right - candidate_left
            for local_y in range(candidate_bottom - candidate_top):
                global_y = intersection["y"] + candidate_top + local_y
                row_offset = global_y * self.width
                payload_offset = local_y * payload_width
                for local_x in range(payload_width):
                    if payload[payload_offset + local_x] == 0:
                        continue
                    global_x = intersection["x"] + candidate_left + local_x
                    offset = row_offset + global_x
                    current_owner = ownership[offset]
                    if current_owner == 0:
                        ownership[offset] = owner_index
                    elif current_owner != owner_index:
                        ownership[offset] = 255

        ownership, ambiguous_pixels = self._erode_scene_transient_ownership(
            ownership,
            owners,
        )
        spans: list[list[int]] = []
        attributed_pixels = 0
        for y in range(self.height):
            row_start = y * self.width
            x = 0
            while x < self.width:
                owner_index = ownership[row_start + x]
                if owner_index == 0:
                    x += 1
                    continue
                right = x + 1
                while right < self.width and ownership[row_start + right] == owner_index:
                    right += 1
                spans.append([y, x, right, int(owner_index)])
                if len(spans) > SCENE_TRANSIENT_MAX_SPANS:
                    raise ToolError("scene transient attribution produced too many exact pixel spans")
                attributed_pixels += right - x
                x = right
        projection = {
            "schema": SCENE_TRANSIENT_MAP_SCHEMA,
            "width": self.width,
            "height": self.height,
            "scene_set_authority_sha256": authority["authority_sha256"],
            "output_sha256": self._image_fingerprint(output_rgb),
            "interior_radius": SCENE_TRANSIENT_INTERIOR_RADIUS,
            "owners": owners,
            "spans": spans,
            "attributed_pixels": attributed_pixels,
            "ambiguous_pixels": ambiguous_pixels,
        }
        transient_map = {
            **projection,
            "map_sha256": self._authority_digest(projection),
        }
        return self._validate_scene_transient_map(transient_map)

    def _capture_scene_transient_map(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        output_rgb: Image.Image,
        authority: dict[str, Any],
    ) -> tuple[dict[str, Any], Image.Image]:
        """Build a map and prove the complete output remained byte-identical."""
        transient_map = self._build_scene_transient_map(
            members,
            windows,
            output_rgb,
            authority,
        )
        completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
        final_output = self._decode_grim_png(
            completed.stdout,
            mode="RGB",
            maximum_width=self.width,
            maximum_height=self.height,
            maximum_pixels=self.width * self.height,
        )
        if final_output.size != (self.width, self.height):
            raise ToolError("scene transient verification returned the wrong private-output geometry")
        if not hmac.compare_digest(
            self._image_fingerprint(output_rgb),
            self._image_fingerprint(final_output),
        ):
            raise ToolError("scene transient pixels changed while exact ownership was being derived")
        authority_after = self._scene_set_authority(members)
        if not hmac.compare_digest(
            authority["authority_sha256"],
            authority_after["authority_sha256"],
        ):
            raise ToolError("scene-set authority changed while transient ownership was being derived")
        return transient_map, final_output

    def _live_scene_transient_owner(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        expected_authority_sha256: str,
        x: int,
        y: int,
    ) -> tuple[dict[str, Any] | None, dict[str, Any]]:
        """Re-derive one popup owner immediately before/after a pointer unit."""
        authority = self._assert_scene_set_authority(
            members,
            expected_authority_sha256,
            windows,
        )
        completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
        output_rgb = self._decode_grim_png(
            completed.stdout,
            mode="RGB",
            maximum_width=self.width,
            maximum_height=self.height,
            maximum_pixels=self.width * self.height,
        )
        if output_rgb.size != (self.width, self.height):
            raise ToolError("live scene transient check returned the wrong output geometry")
        transient_map, _final_output = self._capture_scene_transient_map(
            members,
            windows,
            output_rgb,
            authority,
        )
        return self._scene_transient_owner_at(transient_map, x, y), transient_map

    @classmethod
    def _validate_scene_occlusion_map(cls, value: Any) -> dict[str, Any]:
        """Validate one private exact visible-owner map for overlapping top-levels.

        The ordinary Sway tree exposes complete top-level geometry but not the
        accepting ``wl_surface``.  This visual map therefore treats rectangle
        overlap as an ambiguity domain; the independently authenticated patched-
        Sway HitTestSeal later proves the exact recipient before each input unit.
        The map itself
        then retains only an eroded pixel interior that is effectively opaque in
        exactly one direct foreign-toplevel capture and byte-identical to the
        reviewed private-output pixel.  Pixels outside a two-or-more-top-level
        overlap are never represented in this map, and cross-owner matches are
        counted but never actionable.
        """
        if not isinstance(value, dict):
            raise ToolError("scene occlusion map must be an object")
        required = {
            "schema", "width", "height", "scene_set_authority_sha256",
            "output_sha256", "minimum_covering_toplevels", "overlap_pixels",
            "overlap_mask_sha256", "interior_radius", "owners", "spans",
            "attributed_pixels", "ambiguous_pixels", "map_sha256",
        }
        if set(value) != required:
            raise ToolError("scene occlusion map fields are incomplete")
        if value.get("schema") != SCENE_OCCLUSION_MAP_SCHEMA:
            raise ToolError("scene occlusion map schema is unsupported")
        width = value.get("width")
        height = value.get("height")
        if (
            isinstance(width, bool) or not isinstance(width, int) or not 1 <= width <= 32768
            or isinstance(height, bool) or not isinstance(height, int) or not 1 <= height <= 32768
            or width * height > 64 * 1024 * 1024
        ):
            raise ToolError("scene occlusion map dimensions are invalid")
        for key in (
            "scene_set_authority_sha256", "output_sha256",
            "overlap_mask_sha256", "map_sha256",
        ):
            digest = value.get(key)
            if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                raise ToolError(f"scene occlusion map {key} is invalid")
        minimum_covering = value.get("minimum_covering_toplevels")
        if (
            isinstance(minimum_covering, bool)
            or not isinstance(minimum_covering, int)
            or minimum_covering != SCENE_OCCLUSION_MIN_COVERING_TOPLEVELS
        ):
            raise ToolError("scene occlusion map overlap floor is invalid")
        overlap_pixels = value.get("overlap_pixels")
        if (
            isinstance(overlap_pixels, bool)
            or not isinstance(overlap_pixels, int)
            or not 0 <= overlap_pixels <= width * height
        ):
            raise ToolError("scene occlusion map overlap pixel count is invalid")
        interior_radius = value.get("interior_radius")
        if (
            isinstance(interior_radius, bool)
            or not isinstance(interior_radius, int)
            or interior_radius != SCENE_OCCLUSION_INTERIOR_RADIUS
        ):
            raise ToolError("scene occlusion map interior radius is invalid")

        owners = value.get("owners")
        if not isinstance(owners, list) or len(owners) > SCENE_OCCLUSION_MAX_TOPLEVELS:
            raise ToolError("scene occlusion map owner set is invalid")
        validated_owners: list[dict[str, Any]] = []
        seen_windows: set[int] = set()
        for expected_index, owner in enumerate(owners, 1):
            if not isinstance(owner, dict) or set(owner) != {
                "index", "launch_id", "window_id", "capture_identity_sha256",
                "window_authority_sha256", "content_rect", "full_window_rect",
                "mapping_evidence_sha256", "owner_sha256",
            }:
                raise ToolError("scene occlusion map owner is malformed")
            if owner.get("index") != expected_index:
                raise ToolError("scene occlusion map owner indexes are not canonical")
            launch_id = owner.get("launch_id")
            if not isinstance(launch_id, str) or re.fullmatch(r"launch-[0-9a-f]{24}", launch_id) is None:
                raise ToolError("scene occlusion map owner launch identity is invalid")
            window_id = owner.get("window_id")
            if isinstance(window_id, bool) or not isinstance(window_id, int) or window_id <= 0:
                raise ToolError("scene occlusion map owner window identity is invalid")
            if window_id in seen_windows:
                raise ToolError("scene occlusion map repeats one top-level owner")
            seen_windows.add(window_id)
            for key in (
                "capture_identity_sha256", "window_authority_sha256",
                "mapping_evidence_sha256", "owner_sha256",
            ):
                digest = owner.get(key)
                if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                    raise ToolError(f"scene occlusion map owner {key} is invalid")
            content_rect = cls._validate_capture_rect(
                owner.get("content_rect"), "scene occlusion owner content rectangle"
            )
            full_window_rect = cls._validate_capture_rect(
                owner.get("full_window_rect"), "scene occlusion owner full rectangle"
            )
            assert content_rect is not None and full_window_rect is not None
            if (
                content_rect["x"] < full_window_rect["x"]
                or content_rect["y"] < full_window_rect["y"]
                or content_rect["x"] + content_rect["width"]
                > full_window_rect["x"] + full_window_rect["width"]
                or content_rect["y"] + content_rect["height"]
                > full_window_rect["y"] + full_window_rect["height"]
            ):
                raise ToolError("scene occlusion owner content escapes its exact direct frame")
            owner_projection = {
                "launch_id": launch_id,
                "window_id": window_id,
                "capture_identity_sha256": owner["capture_identity_sha256"],
                "window_authority_sha256": owner["window_authority_sha256"],
                "content_rect": content_rect,
                "full_window_rect": full_window_rect,
                "mapping_evidence_sha256": owner["mapping_evidence_sha256"],
            }
            if not hmac.compare_digest(owner["owner_sha256"], cls._authority_digest(owner_projection)):
                raise ToolError("scene occlusion map owner digest is inconsistent")
            validated_owners.append({
                **owner,
                "content_rect": content_rect,
                "full_window_rect": full_window_rect,
            })

        spans = value.get("spans")
        if not isinstance(spans, list) or len(spans) > SCENE_OCCLUSION_MAX_SPANS:
            raise ToolError("scene occlusion map span set is invalid")
        attributed_pixels = value.get("attributed_pixels")
        ambiguous_pixels = value.get("ambiguous_pixels")
        for label, count in (
            ("attributed", attributed_pixels), ("ambiguous", ambiguous_pixels),
        ):
            if (
                isinstance(count, bool) or not isinstance(count, int)
                or count < 0 or count > overlap_pixels
            ):
                raise ToolError(f"scene occlusion map {label} pixel count is invalid")
        normalized_spans: list[list[int]] = []
        counted_pixels = 0
        previous: tuple[int, int] | None = None
        for span in spans:
            if (
                not isinstance(span, list) or len(span) != 4
                or any(isinstance(item, bool) or not isinstance(item, int) for item in span)
            ):
                raise ToolError("scene occlusion map span is malformed")
            y, left, right, owner_index = span
            if (
                not 0 <= y < height or not 0 <= left < right <= width
                or not 1 <= owner_index <= len(validated_owners)
            ):
                raise ToolError("scene occlusion map span escapes its sealed output")
            if previous is not None:
                previous_y, previous_right = previous
                if y < previous_y or (y == previous_y and left < previous_right):
                    raise ToolError("scene occlusion map spans overlap or are not canonical")
            owner_rect = validated_owners[owner_index - 1]["full_window_rect"]
            if (
                y < owner_rect["y"]
                or y >= owner_rect["y"] + owner_rect["height"]
                or left < owner_rect["x"]
                or right > owner_rect["x"] + owner_rect["width"]
            ):
                raise ToolError("scene occlusion map span escapes its exact owner rectangle")
            previous = (y, right)
            counted_pixels += right - left
            normalized_spans.append([y, left, right, owner_index])
        if counted_pixels != attributed_pixels:
            raise ToolError("scene occlusion map attributed pixel count is inconsistent")
        if attributed_pixels + ambiguous_pixels > overlap_pixels:
            raise ToolError("scene occlusion map pixel accounting exceeds its overlap-only domain")
        projection = dict(value)
        projection.pop("map_sha256", None)
        if not hmac.compare_digest(value["map_sha256"], cls._authority_digest(projection)):
            raise ToolError("scene occlusion map digest is inconsistent")
        return {
            **value,
            "owners": validated_owners,
            "spans": normalized_spans,
        }

    @classmethod
    def _scene_occlusion_owner_at(
        cls,
        occlusion_map: dict[str, Any],
        x: int,
        y: int,
    ) -> dict[str, Any] | None:
        value = cls._validate_scene_occlusion_map(occlusion_map)
        if not 0 <= x < value["width"] or not 0 <= y < value["height"]:
            return None
        for span_y, left, right, owner_index in value["spans"]:
            if span_y < y:
                continue
            if span_y > y or left > x:
                return None
            if left <= x < right:
                return dict(value["owners"][owner_index - 1])
        return None

    def _scene_occlusion_overlap_domain(
        self,
        windows: list[dict[str, Any]],
        scene_set_authority_sha256: str,
    ) -> tuple[Image.Image, int, str]:
        """Build the exact union of pairwise visible top-level rectangle overlap."""
        if re.fullmatch(r"[0-9a-f]{64}", scene_set_authority_sha256) is None:
            raise ToolError("scene occlusion overlap domain lacks exact scene authority")
        rectangles: list[dict[str, int]] = []
        for window in windows:
            rectangle = self._validate_capture_rect({
                "x": window.get("x"),
                "y": window.get("y"),
                "width": window.get("width"),
                "height": window.get("height"),
            }, "scene occlusion top-level rectangle")
            assert rectangle is not None
            clipped = self._capture_output_intersection(rectangle, self.width, self.height)
            if clipped is not None:
                rectangles.append(clipped)
        overlap = Image.new("L", (self.width, self.height), 0)
        draw = ImageDraw.Draw(overlap)
        for index, left_rect in enumerate(rectangles):
            for right_rect in rectangles[index + 1:]:
                left = max(left_rect["x"], right_rect["x"])
                top = max(left_rect["y"], right_rect["y"])
                right = min(
                    left_rect["x"] + left_rect["width"],
                    right_rect["x"] + right_rect["width"],
                )
                bottom = min(
                    left_rect["y"] + left_rect["height"],
                    right_rect["y"] + right_rect["height"],
                )
                if left < right and top < bottom:
                    draw.rectangle((left, top, right - 1, bottom - 1), fill=255)
        payload = overlap.tobytes()
        overlap_pixels = payload.count(255)
        raw_mask_sha256 = hashlib.sha256(payload).hexdigest()
        overlap_mask_sha256 = self._authority_digest({
            "schema": SCENE_OCCLUSION_OVERLAP_DOMAIN_SCHEMA,
            "width": self.width,
            "height": self.height,
            "minimum_covering_toplevels": SCENE_OCCLUSION_MIN_COVERING_TOPLEVELS,
            "scene_set_authority_sha256": scene_set_authority_sha256,
            "raw_mask_sha256": raw_mask_sha256,
        })
        return overlap, overlap_pixels, overlap_mask_sha256

    def _erode_scene_occlusion_ownership(
        self,
        ownership: bytearray,
        owners: list[dict[str, Any]],
    ) -> tuple[bytearray, int]:
        """Keep only a complete same-owner visual interior after ambiguity resolution."""
        if len(ownership) != self.width * self.height:
            raise ToolError("scene occlusion ownership dimensions are inconsistent")
        ambiguous_pixels = ownership.count(255)
        interior = bytearray(len(ownership))
        for owner in owners:
            owner_index = owner.get("index")
            if (
                isinstance(owner_index, bool)
                or not isinstance(owner_index, int)
                or not 1 <= owner_index < 255
            ):
                raise ToolError("scene occlusion owner index is invalid during interior sealing")
            bounds = self._capture_output_intersection(
                owner.get("full_window_rect"),
                self.width,
                self.height,
            )
            if bounds is None:
                continue
            left = bounds["x"]
            top = bounds["y"]
            width = bounds["width"]
            height = bounds["height"]
            mask_bytes = bytearray(width * height)
            for local_y in range(height):
                source_offset = (top + local_y) * self.width + left
                target_offset = local_y * width
                source_row = ownership[source_offset:source_offset + width]
                mask_bytes[target_offset:target_offset + width] = bytes(
                    255 if value == owner_index else 0 for value in source_row
                )
            mask = Image.frombytes("L", (width, height), bytes(mask_bytes))
            eroded = self._erode_scene_transient_candidate(mask)
            eroded_bounds = eroded.getbbox()
            if eroded_bounds is None:
                continue
            crop_left, crop_top, crop_right, crop_bottom = eroded_bounds
            payload = eroded.crop(eroded_bounds).tobytes()
            payload_width = crop_right - crop_left
            for local_y in range(crop_bottom - crop_top):
                global_y = top + crop_top + local_y
                row_offset = global_y * self.width
                payload_offset = local_y * payload_width
                for local_x in range(payload_width):
                    if payload[payload_offset + local_x] != 0:
                        interior[row_offset + left + crop_left + local_x] = owner_index
        return interior, ambiguous_pixels

    def _build_scene_occlusion_map(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        output_rgb: Image.Image,
        authority: dict[str, Any],
    ) -> dict[str, Any]:
        """Derive exact visible ownership only inside overlapping top-levels."""
        if output_rgb.mode != "RGB" or output_rgb.size != (self.width, self.height):
            raise ToolError("scene occlusion attribution requires the exact RGB private output")
        validated_authority = self._assert_scene_set_authority(
            members,
            authority.get("authority_sha256"),
            windows,
        )
        if validated_authority != authority:
            raise ToolError("scene occlusion attribution received inconsistent scene authority")
        visible = sorted(
            (window for window in windows if window.get("visible", True)),
            key=lambda window: parse_window_id(window.get("id")),
        )
        if len(visible) > SCENE_OCCLUSION_MAX_TOPLEVELS:
            raise ToolError(
                "scene occlusion attribution exceeds its exact direct-capture top-level limit"
            )
        allowed = {member.launch_id for member in members}
        for window in visible:
            if window.get("launch_id") not in allowed or window.get("origin_verified") is not True:
                raise ToolError("scene occlusion attribution encountered a non-member top-level")
        overlap, overlap_pixels, overlap_mask_sha256 = self._scene_occlusion_overlap_domain(
            visible,
            authority["authority_sha256"],
        )

        ownership = bytearray(self.width * self.height)
        owners: list[dict[str, Any]] = []
        if overlap_pixels:
            for window in visible:
                (
                    direct_rgba, content_rect, full_window_rect, mapping_evidence,
                    identifier_sha256, window_authority_sha256,
                ) = self._scene_transient_direct_capture(window, output_rgb)
                intersection = self._capture_output_intersection(
                    full_window_rect,
                    self.width,
                    self.height,
                )
                if intersection is None:
                    continue
                local_left = intersection["x"] - full_window_rect["x"]
                local_top = intersection["y"] - full_window_rect["y"]
                local_right = local_left + intersection["width"]
                local_bottom = local_top + intersection["height"]
                direct_visible = direct_rgba.crop((
                    local_left, local_top, local_right, local_bottom,
                ))
                output_visible = output_rgb.crop((
                    intersection["x"], intersection["y"],
                    intersection["x"] + intersection["width"],
                    intersection["y"] + intersection["height"],
                ))
                alpha = direct_visible.getchannel("A").point(
                    lambda item: 255 if item >= SCENE_OCCLUSION_ALPHA_THRESHOLD else 0
                )
                difference = ImageChops.difference(
                    direct_visible.convert("RGB"),
                    output_visible,
                )
                red, green, blue = difference.split()
                nonzero = ImageChops.lighter(ImageChops.lighter(red, green), blue)
                exact = nonzero.point(lambda item: 255 if item == 0 else 0)
                candidate = ImageChops.multiply(alpha, exact)
                candidate = ImageChops.multiply(
                    candidate,
                    overlap.crop((
                        intersection["x"], intersection["y"],
                        intersection["x"] + intersection["width"],
                        intersection["y"] + intersection["height"],
                    )),
                )
                bounds = candidate.getbbox()
                if bounds is None:
                    continue
                owner_index = len(owners) + 1
                if owner_index >= 255 or owner_index > SCENE_OCCLUSION_MAX_TOPLEVELS:
                    raise ToolError("scene occlusion owner index exceeds its bounded map")
                evidence_sha256 = hashlib.sha256(canonical_json(mapping_evidence)).hexdigest()
                owner_projection = {
                    "launch_id": str(window.get("launch_id")),
                    "window_id": parse_window_id(window.get("id")),
                    "capture_identity_sha256": identifier_sha256,
                    "window_authority_sha256": window_authority_sha256,
                    "content_rect": dict(content_rect),
                    "full_window_rect": dict(full_window_rect),
                    "mapping_evidence_sha256": evidence_sha256,
                }
                owners.append({
                    "index": owner_index,
                    **owner_projection,
                    "owner_sha256": self._authority_digest(owner_projection),
                })
                candidate_left, candidate_top, candidate_right, candidate_bottom = bounds
                payload = candidate.crop(bounds).tobytes()
                payload_width = candidate_right - candidate_left
                for local_y in range(candidate_bottom - candidate_top):
                    global_y = intersection["y"] + candidate_top + local_y
                    row_offset = global_y * self.width
                    payload_offset = local_y * payload_width
                    for local_x in range(payload_width):
                        if payload[payload_offset + local_x] == 0:
                            continue
                        global_x = intersection["x"] + candidate_left + local_x
                        offset = row_offset + global_x
                        current_owner = ownership[offset]
                        if current_owner == 0:
                            ownership[offset] = owner_index
                        elif current_owner != owner_index:
                            ownership[offset] = 255

        ownership, ambiguous_pixels = self._erode_scene_occlusion_ownership(
            ownership,
            owners,
        )
        spans: list[list[int]] = []
        attributed_pixels = 0
        for y in range(self.height):
            row_start = y * self.width
            x = 0
            while x < self.width:
                owner_index = ownership[row_start + x]
                if owner_index == 0:
                    x += 1
                    continue
                right = x + 1
                while right < self.width and ownership[row_start + right] == owner_index:
                    right += 1
                spans.append([y, x, right, int(owner_index)])
                if len(spans) > SCENE_OCCLUSION_MAX_SPANS:
                    raise ToolError("scene occlusion attribution produced too many exact pixel spans")
                attributed_pixels += right - x
                x = right
        projection = {
            "schema": SCENE_OCCLUSION_MAP_SCHEMA,
            "width": self.width,
            "height": self.height,
            "scene_set_authority_sha256": authority["authority_sha256"],
            "output_sha256": self._image_fingerprint(output_rgb),
            "minimum_covering_toplevels": SCENE_OCCLUSION_MIN_COVERING_TOPLEVELS,
            "overlap_pixels": overlap_pixels,
            "overlap_mask_sha256": overlap_mask_sha256,
            "interior_radius": SCENE_OCCLUSION_INTERIOR_RADIUS,
            "owners": owners,
            "spans": spans,
            "attributed_pixels": attributed_pixels,
            "ambiguous_pixels": ambiguous_pixels,
        }
        occlusion_map = {
            **projection,
            "map_sha256": self._authority_digest(projection),
        }
        return self._validate_scene_occlusion_map(occlusion_map)

    def _capture_scene_occlusion_map(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        output_rgb: Image.Image,
        authority: dict[str, Any],
    ) -> tuple[dict[str, Any], Image.Image]:
        """Build an overlap map and prove the complete output remained exact."""
        occlusion_map = self._build_scene_occlusion_map(
            members,
            windows,
            output_rgb,
            authority,
        )
        completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
        final_output = self._decode_grim_png(
            completed.stdout,
            mode="RGB",
            maximum_width=self.width,
            maximum_height=self.height,
            maximum_pixels=self.width * self.height,
        )
        if final_output.size != (self.width, self.height):
            raise ToolError("scene occlusion verification returned the wrong private-output geometry")
        if not hmac.compare_digest(
            self._image_fingerprint(output_rgb),
            self._image_fingerprint(final_output),
        ):
            raise ToolError("scene occlusion pixels changed while exact ownership was being derived")
        authority_after = self._scene_set_authority(members)
        if not hmac.compare_digest(
            authority["authority_sha256"],
            authority_after["authority_sha256"],
        ):
            raise ToolError("scene-set authority changed while occlusion ownership was being derived")
        return occlusion_map, final_output

    def _live_scene_occlusion_owner(
        self,
        members: list[ManagedProcess],
        windows: list[dict[str, Any]],
        expected_authority_sha256: str,
        x: int,
        y: int,
    ) -> tuple[dict[str, Any] | None, dict[str, Any]]:
        """Re-derive one overlapping visible owner immediately around input."""
        authority = self._assert_scene_set_authority(
            members,
            expected_authority_sha256,
            windows,
        )
        completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
        output_rgb = self._decode_grim_png(
            completed.stdout,
            mode="RGB",
            maximum_width=self.width,
            maximum_height=self.height,
            maximum_pixels=self.width * self.height,
        )
        if output_rgb.size != (self.width, self.height):
            raise ToolError("live scene occlusion check returned the wrong output geometry")
        occlusion_map, _final_output = self._capture_scene_occlusion_map(
            members,
            windows,
            output_rgb,
            authority,
        )
        return self._scene_occlusion_owner_at(occlusion_map, x, y), occlusion_map


    @classmethod
    def _validate_capture_source(cls, value: Any) -> dict[str, Any]:
        if not isinstance(value, dict):
            raise ToolError("capture source proof must be an object")
        required = {
            "schema", "backend", "transport", "scope", "window_id",
            "capture_identity_sha256", "window_authority_sha256", "crop", "width", "height",
            "occlusion_independent", "raw_identifier_disclosed", "descriptor_sha256",
        }
        optional = {
            "full_window_rect", "content_rect", "content_offset",
            "coordinate_mapping", "popup_inclusive",
            "launch_scene_authority_sha256", "launch_id_sha256",
            "scene_set_authority_sha256", "scene_id_sha256",
            "member_set_sha256", "active_launch_id_sha256",
            "scene_member_count",
            "workspace_sha256", "output_authority_sha256",
            "visible_scene_sha256", "active_window_identity_sha256",
            "visible_window_count",
            "scene_transient_attribution", "scene_transient_map_sha256",
            "scene_transient_owner_count", "scene_transient_span_count",
            "scene_transient_pixel_count", "scene_transient_ambiguous_pixel_count",
            "scene_occlusion_attribution", "scene_occlusion_map_sha256",
            "scene_occlusion_owner_count", "scene_occlusion_span_count",
            "scene_occlusion_pixel_count", "scene_occlusion_ambiguous_pixel_count",
            "scene_occlusion_overlap_pixel_count", "scene_occlusion_overlap_mask_sha256",
        }
        if not required <= set(value) or set(value) - required - optional:
            raise ToolError("capture source proof fields are incomplete")
        if value.get("schema") != CAPTURE_SEAL_SCHEMA:
            raise ToolError("capture source proof schema is unsupported")
        backend = value.get("backend")
        transport = value.get("transport")
        scope = value.get("scope")
        if backend not in {"wayland", "x11", "fixture"}:
            raise ToolError("capture source proof backend is invalid")
        if not isinstance(transport, str) or not transport or len(transport) > 96:
            raise ToolError("capture source proof transport is invalid")
        if scope not in {
            "foreign-toplevel", "launch-scene", "scene-set",
            "window-region", "window", "region", "workstation"
        }:
            raise ToolError("capture source proof scope is invalid")
        window_id = value.get("window_id")
        if window_id is not None and (isinstance(window_id, bool) or not isinstance(window_id, int) or window_id <= 0):
            raise ToolError("capture source proof window id is invalid")
        identity = value.get("capture_identity_sha256")
        if identity is not None and (
            not isinstance(identity, str) or re.fullmatch(r"[0-9a-f]{64}", identity) is None
        ):
            raise ToolError("capture source identity digest is invalid")
        window_authority = value.get("window_authority_sha256")
        if window_authority is not None and (
            not isinstance(window_authority, str)
            or re.fullmatch(r"[0-9a-f]{64}", window_authority) is None
        ):
            raise ToolError("capture source window-authority digest is invalid")
        scene_digest_fields = (
            "launch_scene_authority_sha256", "launch_id_sha256", "workspace_sha256",
            "output_authority_sha256", "visible_scene_sha256",
            "active_window_identity_sha256", "scene_set_authority_sha256",
            "scene_id_sha256", "member_set_sha256", "active_launch_id_sha256",
        )
        for key in scene_digest_fields:
            item = value.get(key)
            if item is not None and (
                not isinstance(item, str) or re.fullmatch(r"[0-9a-f]{64}", item) is None
            ):
                raise ToolError(f"capture source {key} is invalid")
        visible_window_count = value.get("visible_window_count")
        if visible_window_count is not None and (
            isinstance(visible_window_count, bool)
            or not isinstance(visible_window_count, int)
            or not 1 <= visible_window_count <= LAUNCH_SCENE_MAX_VISIBLE_TOPLEVELS
        ):
            raise ToolError("capture source visible-window count is invalid")
        scene_member_count = value.get("scene_member_count")
        if scene_member_count is not None and (
            isinstance(scene_member_count, bool)
            or not isinstance(scene_member_count, int)
            or not 2 <= scene_member_count <= SCENE_SET_MAX_LAUNCHES
        ):
            raise ToolError("capture source scene-member count is invalid")
        transient_fields = {
            "scene_transient_attribution", "scene_transient_map_sha256",
            "scene_transient_owner_count", "scene_transient_span_count",
            "scene_transient_pixel_count", "scene_transient_ambiguous_pixel_count",
        }
        occlusion_fields = {
            "scene_occlusion_attribution", "scene_occlusion_map_sha256",
            "scene_occlusion_owner_count", "scene_occlusion_span_count",
            "scene_occlusion_pixel_count", "scene_occlusion_ambiguous_pixel_count",
            "scene_occlusion_overlap_pixel_count", "scene_occlusion_overlap_mask_sha256",
        }
        transient_attribution = value.get("scene_transient_attribution")
        transient_map_sha256 = value.get("scene_transient_map_sha256")
        transient_counts = {
            key: value.get(key)
            for key in (
                "scene_transient_owner_count", "scene_transient_span_count",
                "scene_transient_pixel_count", "scene_transient_ambiguous_pixel_count",
            )
        }
        if transient_map_sha256 is not None and (
            not isinstance(transient_map_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", transient_map_sha256) is None
        ):
            raise ToolError("capture source scene transient map digest is invalid")
        for key, count in transient_counts.items():
            if count is not None and (
                isinstance(count, bool) or not isinstance(count, int) or count < 0
            ):
                raise ToolError(f"capture source {key} is invalid")
        occlusion_attribution = value.get("scene_occlusion_attribution")
        occlusion_map_sha256 = value.get("scene_occlusion_map_sha256")
        occlusion_overlap_mask_sha256 = value.get("scene_occlusion_overlap_mask_sha256")
        for label, digest in (
            ("scene occlusion map", occlusion_map_sha256),
            ("scene occlusion overlap mask", occlusion_overlap_mask_sha256),
        ):
            if digest is not None and (
                not isinstance(digest, str)
                or re.fullmatch(r"[0-9a-f]{64}", digest) is None
            ):
                raise ToolError(f"capture source {label} digest is invalid")
        occlusion_counts = {
            key: value.get(key)
            for key in (
                "scene_occlusion_owner_count", "scene_occlusion_span_count",
                "scene_occlusion_pixel_count", "scene_occlusion_ambiguous_pixel_count",
                "scene_occlusion_overlap_pixel_count",
            )
        }
        for key, count in occlusion_counts.items():
            if count is not None and (
                isinstance(count, bool) or not isinstance(count, int) or count < 0
            ):
                raise ToolError(f"capture source {key} is invalid")
        crop = cls._validate_capture_rect(value.get("crop"), "capture source crop")
        full_window_rect = cls._validate_capture_rect(
            value.get("full_window_rect"), "capture source full-window rectangle"
        ) if "full_window_rect" in value else None
        content_rect = cls._validate_capture_rect(
            value.get("content_rect"), "capture source content rectangle"
        ) if "content_rect" in value else None
        content_offset = value.get("content_offset")
        if content_offset is not None:
            if not isinstance(content_offset, dict) or set(content_offset) != {"x", "y"}:
                raise ToolError("capture source content offset is invalid")
            if any(isinstance(content_offset.get(key), bool) or not isinstance(content_offset.get(key), int) or content_offset[key] < 0 for key in ("x", "y")):
                raise ToolError("capture source content offset is invalid")
            content_offset = {"x": int(content_offset["x"]), "y": int(content_offset["y"])}
        coordinate_mapping = value.get("coordinate_mapping")
        popup_inclusive = value.get("popup_inclusive")
        width = value.get("width")
        height = value.get("height")
        if (
            isinstance(width, bool) or not isinstance(width, int) or width <= 0
            or isinstance(height, bool) or not isinstance(height, int) or height <= 0
        ):
            raise ToolError("capture source image dimensions are invalid")
        if crop is not None and (width != crop["width"] or height != crop["height"]):
            raise ToolError("capture source image dimensions disagree with its crop")
        if not isinstance(value.get("occlusion_independent"), bool):
            raise ToolError("capture source occlusion policy is invalid")
        if value.get("raw_identifier_disclosed") is not False:
            raise ToolError("capture source exposed or ambiguously handled its raw compositor identity")
        digest = value.get("descriptor_sha256")
        projection = dict(value)
        projection.pop("descriptor_sha256", None)
        expected = hashlib.sha256(canonical_json(projection)).hexdigest()
        if not isinstance(digest, str) or not hmac.compare_digest(digest, expected):
            raise ToolError("capture source proof digest is inconsistent")

        scene_values = [value.get(key) for key in scene_digest_fields]
        launch_scene_values = [
            value.get(key)
            for key in (
                "launch_scene_authority_sha256", "launch_id_sha256",
                "workspace_sha256", "output_authority_sha256",
                "visible_scene_sha256", "active_window_identity_sha256",
            )
        ]
        scene_set_values = [
            value.get(key)
            for key in (
                "scene_set_authority_sha256", "scene_id_sha256",
                "workspace_sha256", "member_set_sha256",
                "active_launch_id_sha256", "output_authority_sha256",
                "visible_scene_sha256", "active_window_identity_sha256",
            )
        ]
        if scope == "foreign-toplevel":
            if (
                backend != "wayland"
                or transport != "grim-ext-image-copy-foreign-toplevel"
                or window_id is None
                or identity is None
                or window_authority is None
                or crop is None
                or full_window_rect is None
                or content_rect is None
                or content_offset is None
                or coordinate_mapping not in {"sway-window-rect-v1", "popup-anchor-seal-v1"}
                or not isinstance(popup_inclusive, bool)
                or value.get("occlusion_independent") is not True
                or any(item is not None for item in scene_values)
                or visible_window_count is not None
                or scene_member_count is not None
            ):
                raise ToolError("foreign-toplevel capture source proof is incomplete")
            if (
                content_rect["x"] != full_window_rect["x"] + content_offset["x"]
                or content_rect["y"] != full_window_rect["y"] + content_offset["y"]
                or content_offset["x"] + content_rect["width"] > full_window_rect["width"]
                or content_offset["y"] + content_rect["height"] > full_window_rect["height"]
            ):
                raise ToolError("foreign-toplevel content anchor escapes its authenticated scene extent")
            expanded = (
                content_offset != {"x": 0, "y": 0}
                or content_rect["width"] != full_window_rect["width"]
                or content_rect["height"] != full_window_rect["height"]
            )
            if popup_inclusive != expanded:
                raise ToolError("foreign-toplevel popup policy disagrees with its authenticated scene extent")
            if expanded != (coordinate_mapping == "popup-anchor-seal-v1"):
                raise ToolError("foreign-toplevel coordinate mapping does not match its scene extent")
            local_x = crop["x"] - full_window_rect["x"]
            local_y = crop["y"] - full_window_rect["y"]
            if (
                local_x < 0 or local_y < 0
                or local_x + crop["width"] > full_window_rect["width"]
                or local_y + crop["height"] > full_window_rect["height"]
            ):
                raise ToolError("foreign-toplevel capture crop escapes its authenticated extent")
        elif scope == "launch-scene":
            if (
                backend != "wayland"
                or transport != "grim-output"
                or window_id is not None
                or identity is not None
                or window_authority is not None
                or crop is not None
                or any(item is not None for item in (
                    full_window_rect, content_rect, content_offset, coordinate_mapping, popup_inclusive
                ))
                or value.get("occlusion_independent") is not False
                or any(item is None for item in launch_scene_values)
                or any(value.get(key) is not None for key in (
                    "scene_set_authority_sha256", "scene_id_sha256",
                    "member_set_sha256", "active_launch_id_sha256",
                ))
                or visible_window_count is None
                or scene_member_count is not None
            ):
                raise ToolError("launch-scene capture source proof is incomplete")
        elif scope == "scene-set":
            if (
                backend != "wayland"
                or transport != "grim-output"
                or window_id is not None
                or identity is not None
                or window_authority is not None
                or crop is not None
                or any(item is not None for item in (
                    full_window_rect, content_rect, content_offset,
                    coordinate_mapping, popup_inclusive,
                ))
                or value.get("occlusion_independent") is not False
                or any(item is None for item in scene_set_values)
                or value.get("launch_scene_authority_sha256") is not None
                or value.get("launch_id_sha256") is not None
                or visible_window_count is None
                or scene_member_count is None
                or not transient_fields <= set(value)
                or not occlusion_fields <= set(value)
            ):
                raise ToolError("scene-set capture source proof is incomplete")
            if not isinstance(transient_attribution, bool):
                raise ToolError("scene-set transient attribution policy is invalid")
            if not isinstance(occlusion_attribution, bool):
                raise ToolError("scene-set occlusion attribution policy is invalid")
            if transient_attribution and occlusion_attribution:
                raise ToolError(
                    "scene-set transient and occlusion attribution are mutually exclusive"
                )
            owner_count = transient_counts["scene_transient_owner_count"]
            span_count = transient_counts["scene_transient_span_count"]
            pixel_count = transient_counts["scene_transient_pixel_count"]
            ambiguous_count = transient_counts["scene_transient_ambiguous_pixel_count"]
            if any(item is None for item in (owner_count, span_count, pixel_count, ambiguous_count)):
                raise ToolError("scene-set transient attribution counts are incomplete")
            assert isinstance(owner_count, int)
            assert isinstance(span_count, int)
            assert isinstance(pixel_count, int)
            assert isinstance(ambiguous_count, int)
            if (
                owner_count > SCENE_TRANSIENT_MAX_TOPLEVELS
                or span_count > SCENE_TRANSIENT_MAX_SPANS
                or pixel_count + ambiguous_count > width * height
            ):
                raise ToolError("scene-set transient attribution counts exceed their bounds")
            if transient_attribution:
                if transient_map_sha256 is None:
                    raise ToolError("scene-set transient attribution lacks its private map digest")
            elif (
                transient_map_sha256 is not None
                or owner_count != 0 or span_count != 0
                or pixel_count != 0 or ambiguous_count != 0
            ):
                raise ToolError("disabled scene-set transient attribution carries unexpected authority")

            occlusion_owner_count = occlusion_counts["scene_occlusion_owner_count"]
            occlusion_span_count = occlusion_counts["scene_occlusion_span_count"]
            occlusion_pixel_count = occlusion_counts["scene_occlusion_pixel_count"]
            occlusion_ambiguous_count = occlusion_counts[
                "scene_occlusion_ambiguous_pixel_count"
            ]
            occlusion_overlap_count = occlusion_counts[
                "scene_occlusion_overlap_pixel_count"
            ]
            if any(item is None for item in (
                occlusion_owner_count, occlusion_span_count,
                occlusion_pixel_count, occlusion_ambiguous_count,
                occlusion_overlap_count,
            )):
                raise ToolError("scene-set occlusion attribution counts are incomplete")
            assert isinstance(occlusion_owner_count, int)
            assert isinstance(occlusion_span_count, int)
            assert isinstance(occlusion_pixel_count, int)
            assert isinstance(occlusion_ambiguous_count, int)
            assert isinstance(occlusion_overlap_count, int)
            if (
                occlusion_owner_count > SCENE_OCCLUSION_MAX_TOPLEVELS
                or occlusion_span_count > SCENE_OCCLUSION_MAX_SPANS
                or occlusion_overlap_count > width * height
                or occlusion_pixel_count + occlusion_ambiguous_count
                > occlusion_overlap_count
            ):
                raise ToolError("scene-set occlusion attribution counts exceed their bounds")
            if occlusion_attribution:
                if occlusion_map_sha256 is None or occlusion_overlap_mask_sha256 is None:
                    raise ToolError(
                        "scene-set occlusion attribution lacks its private map authority"
                    )
            elif (
                occlusion_map_sha256 is not None
                or occlusion_overlap_mask_sha256 is not None
                or occlusion_owner_count != 0
                or occlusion_span_count != 0
                or occlusion_pixel_count != 0
                or occlusion_ambiguous_count != 0
                or occlusion_overlap_count != 0
            ):
                raise ToolError("disabled scene-set occlusion attribution carries unexpected authority")
        elif any(item is not None for item in (
            identity, window_authority, full_window_rect, content_rect, content_offset,
            coordinate_mapping, popup_inclusive, *scene_values,
            visible_window_count, scene_member_count,
            transient_attribution, transient_map_sha256, *transient_counts.values(),
            occlusion_attribution, occlusion_map_sha256,
            occlusion_overlap_mask_sha256, *occlusion_counts.values(),
        )):
            raise ToolError("non-authoritative capture source carries unexpected compositor authority")
        if backend == "wayland" and scope != "foreign-toplevel" and transport != "grim-output":
            raise ToolError("Wayland output capture source transport is invalid")
        if backend == "x11" and transport != "xlib-imagegrab":
            raise ToolError("X11 capture source transport is invalid")
        if backend == "fixture" and transport != "synthetic-frame":
            raise ToolError("fixture capture source transport is invalid")
        return dict(value)

    @classmethod
    def _capture_source_descriptor(cls, payload: dict[str, Any]) -> dict[str, Any]:
        descriptor = dict(payload)
        descriptor["schema"] = CAPTURE_SEAL_SCHEMA
        descriptor["descriptor_sha256"] = hashlib.sha256(canonical_json(descriptor)).hexdigest()
        return cls._validate_capture_source(descriptor)

    @classmethod
    def _capture_source_from_frame(
        cls,
        frame: CaptureFrame,
    ) -> dict[str, Any]:
        if isinstance(frame, CaptureFrame):
            image = frame.image
            crop = frame.crop
            window_id = frame.window_id
            source = cls._validate_capture_source(frame.source)
            if (
                source["width"] != image.width
                or source["height"] != image.height
                or source["crop"] != (dict(crop) if crop is not None else None)
                or source["window_id"] != window_id
            ):
                raise ToolError("capture frame disagrees with its sealed source proof")
            if source.get("scope") == "scene-set":
                transient_attribution = source.get("scene_transient_attribution") is True
                occlusion_attribution = source.get("scene_occlusion_attribution") is True
                if transient_attribution:
                    transient_map = cls._validate_scene_transient_map(frame.private)
                    checks = {
                        "map_sha256": transient_map.get("map_sha256")
                        == source.get("scene_transient_map_sha256"),
                        "authority": transient_map.get("scene_set_authority_sha256")
                        == source.get("scene_set_authority_sha256"),
                        "output": transient_map.get("output_sha256")
                        == cls._image_fingerprint(image),
                        "dimensions": (
                            transient_map.get("width") == image.width
                            and transient_map.get("height") == image.height
                        ),
                        "owner_count": len(transient_map.get("owners", []))
                        == source.get("scene_transient_owner_count"),
                        "span_count": len(transient_map.get("spans", []))
                        == source.get("scene_transient_span_count"),
                        "pixel_count": transient_map.get("attributed_pixels")
                        == source.get("scene_transient_pixel_count"),
                        "ambiguous_count": transient_map.get("ambiguous_pixels")
                        == source.get("scene_transient_ambiguous_pixel_count"),
                    }
                    if not all(checks.values()):
                        raise ToolError(
                            "scene-set capture frame disagrees with its private transient map"
                        )
                elif occlusion_attribution:
                    occlusion_map = cls._validate_scene_occlusion_map(frame.private)
                    checks = {
                        "map_sha256": occlusion_map.get("map_sha256")
                        == source.get("scene_occlusion_map_sha256"),
                        "authority": occlusion_map.get("scene_set_authority_sha256")
                        == source.get("scene_set_authority_sha256"),
                        "output": occlusion_map.get("output_sha256")
                        == cls._image_fingerprint(image),
                        "dimensions": (
                            occlusion_map.get("width") == image.width
                            and occlusion_map.get("height") == image.height
                        ),
                        "owner_count": len(occlusion_map.get("owners", []))
                        == source.get("scene_occlusion_owner_count"),
                        "span_count": len(occlusion_map.get("spans", []))
                        == source.get("scene_occlusion_span_count"),
                        "pixel_count": occlusion_map.get("attributed_pixels")
                        == source.get("scene_occlusion_pixel_count"),
                        "ambiguous_count": occlusion_map.get("ambiguous_pixels")
                        == source.get("scene_occlusion_ambiguous_pixel_count"),
                        "overlap_count": occlusion_map.get("overlap_pixels")
                        == source.get("scene_occlusion_overlap_pixel_count"),
                        "overlap_mask": occlusion_map.get("overlap_mask_sha256")
                        == source.get("scene_occlusion_overlap_mask_sha256"),
                    }
                    if not all(checks.values()):
                        raise ToolError(
                            "scene-set capture frame disagrees with its private occlusion map"
                        )
                elif frame.private is not None:
                    raise ToolError(
                        "scene-set capture carries an unrequested private ownership map"
                    )
            elif frame.private is not None:
                raise ToolError("non-scene capture carries unexpected private ownership authority")
            return source
        raise ToolError("capture returned an unsealed frame")

    @classmethod
    def _scene_transient_map_from_frame(
        cls,
        frame: Any,
        source: dict[str, Any],
    ) -> dict[str, Any] | None:
        if source.get("scope") != "scene-set" or source.get("scene_transient_attribution") is not True:
            return None
        if not isinstance(frame, CaptureFrame):
            raise ToolError("fixture capture cannot carry scene transient attribution")
        return cls._validate_scene_transient_map(frame.private)

    @classmethod
    def _scene_occlusion_map_from_frame(
        cls,
        frame: Any,
        source: dict[str, Any],
    ) -> dict[str, Any] | None:
        if source.get("scope") != "scene-set" or source.get("scene_occlusion_attribution") is not True:
            return None
        if not isinstance(frame, CaptureFrame):
            raise ToolError("fixture capture cannot carry scene occlusion attribution")
        return cls._validate_scene_occlusion_map(frame.private)

    def _decode_grim_png(
        self,
        payload: bytes,
        *,
        mode: str = "RGB",
        maximum_width: int | None = None,
        maximum_height: int | None = None,
        maximum_pixels: int | None = None,
    ) -> Image.Image:
        if len(payload) > self.max_output_bytes * 4:
            raise ToolError("raw Wayland screenshot exceeds the configured output limit")
        try:
            with Image.open(io.BytesIO(payload)) as opened:
                width, height = opened.size
                if width <= 0 or height <= 0:
                    raise ToolError("grim returned an empty image")
                if maximum_width is not None and width > maximum_width:
                    raise ToolError("grim returned an over-wide image")
                if maximum_height is not None and height > maximum_height:
                    raise ToolError("grim returned an over-tall image")
                if maximum_pixels is not None and width * height > maximum_pixels:
                    raise ToolError("grim returned an image exceeding the pixel budget")
                image = opened.convert(mode)
                image.load()
        except ToolError:
            raise
        except Exception as error:
            raise ToolError("grim returned an invalid PNG") from error
        return image

    def _capture_region(self, arguments: dict[str, Any]) -> CaptureFrame:
        capture_mode = arguments.get("capture_mode", "window")
        if capture_mode not in {"window", "launch-scene", "scene-set"}:
            raise ToolError("capture_mode must be window, launch-scene, or scene-set")
        include_transient_attribution = as_bool(
            arguments.get("include_transient_attribution", False),
            "include_transient_attribution",
        )
        if include_transient_attribution and capture_mode != "scene-set":
            raise ToolError("include_transient_attribution requires capture_mode=scene-set")
        if capture_mode != "scene-set" and "include_transient_attribution" in arguments:
            raise ToolError("include_transient_attribution requires capture_mode=scene-set")
        include_occlusion_attribution = as_bool(
            arguments.get("include_occlusion_attribution", False),
            "include_occlusion_attribution",
        )
        if include_occlusion_attribution and capture_mode != "scene-set":
            raise ToolError("include_occlusion_attribution requires capture_mode=scene-set")
        if capture_mode != "scene-set" and "include_occlusion_attribution" in arguments:
            raise ToolError("include_occlusion_attribution requires capture_mode=scene-set")
        if include_transient_attribution and include_occlusion_attribution:
            raise ToolError(
                "include_transient_attribution and include_occlusion_attribution are mutually exclusive"
            )
        crop = arguments.get("crop")
        window_value = arguments.get("window_id")
        launch_id_value = arguments.get("launch_id")
        scene_id_value = arguments.get("scene_id")
        if crop is not None and window_value is not None:
            raise ToolError("crop and window_id are mutually exclusive")
        if capture_mode == "launch-scene":
            if not self.is_wayland:
                raise ToolError("launch-scene capture requires the private Wayland backend")
            if crop is not None or window_value is not None:
                raise ToolError("launch-scene capture forbids crop and window_id")
            if launch_id_value is None:
                raise ToolError("launch-scene capture requires launch_id")
            managed = self._managed_by_launch_id(launch_id_value)
            authority_before = self._launch_scene_authority(managed)
            completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
            image = self._decode_grim_png(
                completed.stdout,
                mode="RGB",
                maximum_width=self.width,
                maximum_height=self.height,
                maximum_pixels=self.width * self.height,
            )
            if image.size != (self.width, self.height):
                raise ToolError(
                    "launch-scene capture geometry disagrees with the attested private output "
                    f"(image={image.width}x{image.height}, output={self.width}x{self.height})"
                )
            authority_after = self._launch_scene_authority(managed)
            if not hmac.compare_digest(
                authority_before["authority_sha256"], authority_after["authority_sha256"]
            ):
                raise ToolError(
                    "launch-scene authority changed while the private-output frame was in flight"
                )
            source = self._capture_source_descriptor({
                "backend": "wayland",
                "transport": "grim-output",
                "scope": "launch-scene",
                "window_id": None,
                "capture_identity_sha256": None,
                "window_authority_sha256": None,
                "crop": None,
                "width": image.width,
                "height": image.height,
                "occlusion_independent": False,
                "raw_identifier_disclosed": False,
                "launch_scene_authority_sha256": authority_before["authority_sha256"],
                "launch_id_sha256": authority_before["launch_id_sha256"],
                "workspace_sha256": authority_before["workspace_sha256"],
                "output_authority_sha256": authority_before["output_authority_sha256"],
                "visible_scene_sha256": authority_before["visible_scene_sha256"],
                "active_window_identity_sha256": authority_before["active_window_identity_sha256"],
                "visible_window_count": authority_before["visible_window_count"],
            })
            return CaptureFrame(image, None, None, source)
        if capture_mode == "scene-set":
            if not self.is_wayland:
                raise ToolError("scene-set capture requires the private Wayland backend")
            if crop is not None or window_value is not None or launch_id_value is not None:
                raise ToolError("scene-set capture forbids crop, window_id, and launch_id")
            if scene_id_value is None:
                raise ToolError("scene-set capture requires scene_id")
            expected_launch_ids_value = arguments.get("scene_launch_ids")
            expected_launch_ids: tuple[str, ...] | None = None
            if expected_launch_ids_value is not None:
                if (
                    not isinstance(expected_launch_ids_value, (list, tuple))
                    or not 2 <= len(expected_launch_ids_value) <= SCENE_SET_MAX_LAUNCHES
                ):
                    raise ToolError("scene-set capture member identity list is invalid")
                normalized_ids: list[str] = []
                for index, value in enumerate(expected_launch_ids_value):
                    normalized_ids.append(
                        as_string(
                            value,
                            f"scene_launch_ids[{index}]",
                            maximum=128,
                            allow_empty=False,
                        )
                    )
                expected_launch_ids = tuple(sorted(normalized_ids))
                if len(set(expected_launch_ids)) != len(expected_launch_ids):
                    raise ToolError("scene-set capture member identity list contains duplicates")
            members = self._managed_scene(
                scene_id_value,
                expected_launch_ids=expected_launch_ids,
            )
            include_transient_attribution = as_bool(
                arguments.get("include_transient_attribution", False),
                "include_transient_attribution",
            )
            include_occlusion_attribution = as_bool(
                arguments.get("include_occlusion_attribution", False),
                "include_occlusion_attribution",
            )
            if include_transient_attribution and include_occlusion_attribution:
                raise ToolError(
                    "scene-set transient and occlusion attribution are mutually exclusive"
                )
            windows_before = self._wayland_windows()
            authority_before = (
                self._scene_set_authority(members, windows_before)
                if include_transient_attribution or include_occlusion_attribution
                else self._scene_set_authority(members)
            )
            completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
            image = self._decode_grim_png(
                completed.stdout,
                mode="RGB",
                maximum_width=self.width,
                maximum_height=self.height,
                maximum_pixels=self.width * self.height,
            )
            if image.size != (self.width, self.height):
                raise ToolError(
                    "scene-set capture geometry disagrees with the attested private output "
                    f"(image={image.width}x{image.height}, output={self.width}x{self.height})"
                )
            transient_map: dict[str, Any] | None = None
            occlusion_map: dict[str, Any] | None = None
            if include_transient_attribution:
                transient_map, image = self._capture_scene_transient_map(
                    members,
                    windows_before,
                    image,
                    authority_before,
                )
            elif include_occlusion_attribution:
                occlusion_map, image = self._capture_scene_occlusion_map(
                    members,
                    windows_before,
                    image,
                    authority_before,
                )
            authority_after = self._scene_set_authority(members)
            if not hmac.compare_digest(
                authority_before["authority_sha256"], authority_after["authority_sha256"]
            ):
                raise ToolError("scene-set authority changed while the private-output frame was in flight")
            source = self._capture_source_descriptor({
                "backend": "wayland",
                "transport": "grim-output",
                "scope": "scene-set",
                "window_id": None,
                "capture_identity_sha256": None,
                "window_authority_sha256": None,
                "crop": None,
                "width": image.width,
                "height": image.height,
                "occlusion_independent": False,
                "raw_identifier_disclosed": False,
                "scene_set_authority_sha256": authority_before["authority_sha256"],
                "scene_id_sha256": authority_before["scene_id_sha256"],
                "workspace_sha256": authority_before["workspace_sha256"],
                "member_set_sha256": authority_before["member_set_sha256"],
                "active_launch_id_sha256": authority_before["active_launch_id_sha256"],
                "output_authority_sha256": authority_before["output_authority_sha256"],
                "visible_scene_sha256": authority_before["visible_scene_sha256"],
                "active_window_identity_sha256": authority_before["active_window_identity_sha256"],
                "scene_member_count": authority_before["scene_member_count"],
                "visible_window_count": authority_before["visible_window_count"],
                "scene_transient_attribution": include_transient_attribution,
                "scene_transient_map_sha256": (
                    transient_map["map_sha256"] if transient_map is not None else None
                ),
                "scene_transient_owner_count": (
                    len(transient_map["owners"]) if transient_map is not None else 0
                ),
                "scene_transient_span_count": (
                    len(transient_map["spans"]) if transient_map is not None else 0
                ),
                "scene_transient_pixel_count": (
                    transient_map["attributed_pixels"] if transient_map is not None else 0
                ),
                "scene_transient_ambiguous_pixel_count": (
                    transient_map["ambiguous_pixels"] if transient_map is not None else 0
                ),
                "scene_occlusion_attribution": include_occlusion_attribution,
                "scene_occlusion_map_sha256": (
                    occlusion_map["map_sha256"] if occlusion_map is not None else None
                ),
                "scene_occlusion_owner_count": (
                    len(occlusion_map["owners"]) if occlusion_map is not None else 0
                ),
                "scene_occlusion_span_count": (
                    len(occlusion_map["spans"]) if occlusion_map is not None else 0
                ),
                "scene_occlusion_pixel_count": (
                    occlusion_map["attributed_pixels"] if occlusion_map is not None else 0
                ),
                "scene_occlusion_ambiguous_pixel_count": (
                    occlusion_map["ambiguous_pixels"] if occlusion_map is not None else 0
                ),
                "scene_occlusion_overlap_pixel_count": (
                    occlusion_map["overlap_pixels"] if occlusion_map is not None else 0
                ),
                "scene_occlusion_overlap_mask_sha256": (
                    occlusion_map["overlap_mask_sha256"]
                    if occlusion_map is not None else None
                ),
            })
            return CaptureFrame(
                image,
                None,
                None,
                source,
                transient_map if transient_map is not None else occlusion_map,
            )
        if launch_id_value is not None:
            raise ToolError("launch_id is accepted only with capture_mode=launch-scene")
        if scene_id_value is not None:
            raise ToolError("scene_id is accepted only with capture_mode=scene-set")
        crop_value: dict[str, int] | None = None
        window_id: int | None = None
        wayland_window: dict[str, Any] | None = None
        content_rect: dict[str, int] | None = None
        full_window_rect: dict[str, int] | None = None
        if window_value is not None:
            window_id = parse_window_id(window_value)
            if self.is_wayland:
                wayland_window = next(
                    (item for item in self._wayland_windows() if item["id"] == window_id),
                    None,
                )
                if wayland_window is None:
                    raise ToolError(f"window is absent: {window_id}")
                content_rect = self._wayland_toplevel_capture_extent(wayland_window)
                if self._capture_output_intersection(content_rect, self.width, self.height) is None:
                    raise ToolError("window has no visible screen intersection")
            else:
                window = self._controllable_window(window_id)
                try:
                    geometry = window.get_geometry()
                    translated = self.root.translate_coords(window, 0, 0)
                    x = max(0, int(translated.x))
                    y = max(0, int(translated.y))
                    right = min(self.width, int(translated.x) + int(geometry.width))
                    bottom = min(self.height, int(translated.y) + int(geometry.height))
                except (xerror.BadWindow, xerror.BadDrawable) as error:
                    raise ToolError(f"window cannot be captured: {window_id}") from error
                if right <= x or bottom <= y:
                    raise ToolError("window has no visible screen intersection")
                crop_value = {"x": x, "y": y, "width": right - x, "height": bottom - y}
        elif crop is not None:
            if not isinstance(crop, dict):
                raise ToolError("crop must be an object")
            x = as_int(crop.get("x"), 0, self.width - 1, "crop.x")
            y = as_int(crop.get("y"), 0, self.height - 1, "crop.y")
            width = as_int(crop.get("width"), 1, self.width - x, "crop.width")
            height = as_int(crop.get("height"), 1, self.height - y, "crop.height")
            crop_value = {"x": x, "y": y, "width": width, "height": height}

        if self.is_wayland and wayland_window is not None:
            foreign_identifier = wayland_window.get("_foreign_toplevel_identifier")
            identifier_sha256 = wayland_window.get("capture_identity_sha256")
            if (
                self._foreign_toplevel_identifier(foreign_identifier) is None
                or not isinstance(identifier_sha256, str)
                or re.fullmatch(r"[0-9a-f]{64}", identifier_sha256) is None
                or hashlib.sha256(foreign_identifier.encode("ascii")).hexdigest() != identifier_sha256
            ):
                raise ToolError(
                    "window has no valid compositor-issued foreign-toplevel capture identity"
                )
            if content_rect is None:
                raise ToolError("internal direct-toplevel content geometry is absent")
            capture_authority_sha256 = self._capture_window_authority_sha256(wayland_window)
            completed = self._run_controller(
                [self.commands["grim"], "-T", foreign_identifier, "-"],
                timeout=15,
            )
            direct_rgba = self._decode_grim_png(
                completed.stdout,
                mode="RGBA",
                maximum_width=max(self.width * 2, content_rect["width"]),
                maximum_height=max(self.height * 2, content_rect["height"]),
                maximum_pixels=max(self.width * self.height * 4, content_rect["width"] * content_rect["height"]),
            )
            current_window = next(
                (item for item in self._wayland_windows() if item["id"] == window_id),
                None,
            )
            if current_window is None:
                raise ToolError("window disappeared while its exact toplevel capture was in flight")
            current_identifier = current_window.get("_foreign_toplevel_identifier")
            current_identifier_sha256 = current_window.get("capture_identity_sha256")
            if (
                self._foreign_toplevel_identifier(current_identifier) is None
                or not hmac.compare_digest(foreign_identifier, current_identifier)
                or not isinstance(current_identifier_sha256, str)
                or not hmac.compare_digest(identifier_sha256, current_identifier_sha256)
                or not hmac.compare_digest(
                    capture_authority_sha256,
                    self._capture_window_authority_sha256(current_window),
                )
            ):
                raise ToolError(
                    "window capture authority changed while the exact toplevel frame was in flight"
                )

            expected_size = (content_rect["width"], content_rect["height"])
            popup_inclusive = direct_rgba.size != expected_size
            mapping_evidence: dict[str, Any] | None = None
            if popup_inclusive:
                output_completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
                output_rgb = self._decode_grim_png(
                    output_completed.stdout,
                    mode="RGB",
                    maximum_width=self.width,
                    maximum_height=self.height,
                    maximum_pixels=self.width * self.height,
                )
                if output_rgb.size != (self.width, self.height):
                    raise ToolError(
                        "popup anchor output geometry disagrees with the configured private output "
                        f"(image={output_rgb.width}x{output_rgb.height}, output={self.width}x{self.height})"
                    )
                latest_window = next(
                    (item for item in self._wayland_windows() if item["id"] == window_id),
                    None,
                )
                if latest_window is None or not hmac.compare_digest(
                    capture_authority_sha256,
                    self._capture_window_authority_sha256(latest_window),
                ):
                    raise ToolError("window capture authority changed while popup coordinates were corroborated")
                full_window_rect, mapping_evidence = self._popup_anchor_capture_extent(
                    direct_rgba, output_rgb, content_rect,
                )
                coordinate_mapping = "popup-anchor-seal-v1"
                journal = getattr(self, "journal", None)
                if journal is not None:
                    with contextlib.suppress(Exception):
                        journal.append(
                            "popup-anchor-seal",
                            "desktop-capture",
                            {
                                "window_id": window_id,
                                "direct_size": [direct_rgba.width, direct_rgba.height],
                                "content_rect": content_rect,
                            },
                            mapping_evidence,
                        )
            else:
                full_window_rect = dict(content_rect)
                coordinate_mapping = "sway-window-rect-v1"
            crop_value = self._capture_output_intersection(full_window_rect, self.width, self.height)
            if crop_value is None:
                raise ToolError("direct toplevel scene has no visible private-output intersection")
            local_x = crop_value["x"] - full_window_rect["x"]
            local_y = crop_value["y"] - full_window_rect["y"]
            visible_rgba = direct_rgba.crop((
                local_x,
                local_y,
                local_x + crop_value["width"],
                local_y + crop_value["height"],
            ))
            image = visible_rgba.convert("RGB")
            content_offset = {
                "x": content_rect["x"] - full_window_rect["x"],
                "y": content_rect["y"] - full_window_rect["y"],
            }
            source = self._capture_source_descriptor({
                "backend": "wayland",
                "transport": "grim-ext-image-copy-foreign-toplevel",
                "scope": "foreign-toplevel",
                "window_id": window_id,
                "capture_identity_sha256": identifier_sha256,
                "window_authority_sha256": capture_authority_sha256,
                "crop": dict(crop_value),
                "full_window_rect": dict(full_window_rect),
                "content_rect": dict(content_rect),
                "content_offset": content_offset,
                "coordinate_mapping": coordinate_mapping,
                "popup_inclusive": popup_inclusive,
                "width": image.width,
                "height": image.height,
                "occlusion_independent": True,
                "raw_identifier_disclosed": False,
            })
            return CaptureFrame(image, crop_value, window_id, source)

        if self.is_wayland:
            completed = self._run_controller([self.commands["grim"], "-"], timeout=15)
            image = self._decode_grim_png(
                completed.stdout,
                mode="RGB",
                maximum_width=self.width,
                maximum_height=self.height,
                maximum_pixels=self.width * self.height,
            )
            if image.size != (self.width, self.height):
                raise ToolError(
                    "workstation capture geometry disagrees with the configured private output "
                    f"(image={image.width}x{image.height}, output={self.width}x{self.height})"
                )
            source_transport = "grim-output"
            source_backend = "wayland"
        else:
            image = ImageGrab.grab(xdisplay=self.display_name).convert("RGB")
            source_transport = "xlib-imagegrab"
            source_backend = "x11"
        if crop_value is not None:
            x, y = crop_value["x"], crop_value["y"]
            image = image.crop((x, y, x + crop_value["width"], y + crop_value["height"]))
        source = self._capture_source_descriptor({
            "backend": source_backend,
            "transport": source_transport,
            "scope": "window-region" if window_id is not None else ("region" if crop_value is not None else "workstation"),
            "window_id": window_id,
            "capture_identity_sha256": None,
            "window_authority_sha256": None,
            "crop": dict(crop_value) if crop_value is not None else None,
            "width": image.width,
            "height": image.height,
            "occlusion_independent": False,
            "raw_identifier_disclosed": False,
        })
        return CaptureFrame(image, crop_value, window_id, source)

    @staticmethod
    def _image_fingerprint(image: Image.Image) -> str:
        header = f"{image.width}x{image.height}:RGB:".encode("ascii")
        return hashlib.sha256(header + image.tobytes()).hexdigest()

    @staticmethod
    def _visual_sample(image: Image.Image) -> bytes:
        resampling = getattr(Image, "Resampling", Image).BILINEAR
        reduced = image.convert("L").resize((64, 40), resampling)
        return reduced.tobytes()

    @staticmethod
    def _visual_difference(left: bytes, right: bytes) -> float:
        if len(left) != len(right) or not left:
            return 1.0
        return sum(abs(a - b) for a, b in zip(left, right)) / (255.0 * len(left))

    def _canonical_frame_capture_arguments(
        self,
        value: Mapping[str, Any],
    ) -> dict[str, Any]:
        """Normalize one exact capture request for FramePulse/FrameFence.

        Public capture tools allow omission of the default mode and accept
        integer-like window identifiers. A visual capability cannot safely
        depend on those presentation differences, so this projection resolves
        every scope to one canonical JSON value and freezes scene membership.
        """
        if not isinstance(value, Mapping):
            raise ToolError("frame capture arguments must be an object")
        allowed = {
            "capture_mode", "launch_id", "scene_id", "scene_launch_ids",
            "include_transient_attribution", "include_occlusion_attribution",
            "crop", "window_id",
        }
        unexpected = sorted(set(value) - allowed)
        if unexpected:
            raise ToolError(
                f"frame capture arguments contain unsupported keys: {', '.join(unexpected)}"
            )
        capture_mode = value.get("capture_mode", "window")
        if capture_mode not in {"window", "launch-scene", "scene-set"}:
            raise ToolError("capture_mode must be window, launch-scene, or scene-set")
        normalized: dict[str, Any] = {"capture_mode": capture_mode}
        if capture_mode == "window":
            if any(key in value for key in (
                "launch_id", "scene_id", "scene_launch_ids",
                "include_transient_attribution", "include_occlusion_attribution",
            )):
                raise ToolError(
                    "window frame capture forbids launch, scene, and attribution fields"
                )
            crop = value.get("crop")
            window_value = value.get("window_id")
            if crop is not None and window_value is not None:
                raise ToolError("crop and window_id are mutually exclusive")
            if window_value is not None:
                normalized["window_id"] = parse_window_id(window_value)
            elif crop is not None:
                if not isinstance(crop, Mapping):
                    raise ToolError("crop must be an object")
                x = as_int(crop.get("x"), 0, self.width - 1, "crop.x")
                y = as_int(crop.get("y"), 0, self.height - 1, "crop.y")
                width = as_int(crop.get("width"), 1, self.width - x, "crop.width")
                height = as_int(crop.get("height"), 1, self.height - y, "crop.height")
                normalized["crop"] = {
                    "x": x, "y": y, "width": width, "height": height,
                }
            return normalized
        if capture_mode == "launch-scene":
            if any(key in value for key in (
                "scene_id", "scene_launch_ids", "include_transient_attribution",
                "include_occlusion_attribution", "crop", "window_id",
            )):
                raise ToolError(
                    "launch-scene frame capture forbids scene, attribution, crop, and window fields"
                )
            launch_id = as_string(
                value.get("launch_id"), "launch_id", maximum=128, allow_empty=False,
            )
            managed = self._managed_by_launch_id(launch_id)
            normalized["launch_id"] = managed.launch_id
            return normalized

        if any(key in value for key in ("launch_id", "crop", "window_id")):
            raise ToolError("scene-set frame capture forbids launch_id, crop, and window_id")
        scene_id = self._scene_id(value.get("scene_id"), required=True)
        assert scene_id is not None
        expected_value = value.get("scene_launch_ids")
        expected_launch_ids: tuple[str, ...] | None = None
        if expected_value is not None:
            if (
                not isinstance(expected_value, (list, tuple))
                or not 2 <= len(expected_value) <= SCENE_SET_MAX_LAUNCHES
            ):
                raise ToolError("scene_launch_ids is an invalid exact scene membership vector")
            exact = tuple(sorted(
                as_string(item, "scene_launch_id", maximum=128, allow_empty=False)
                for item in expected_value
            ))
            if len(set(exact)) != len(exact):
                raise ToolError("scene_launch_ids contains duplicate launch identities")
            expected_launch_ids = exact
        members = self._managed_scene(scene_id, expected_launch_ids=expected_launch_ids)
        transient = as_bool(
            value.get("include_transient_attribution", False),
            "include_transient_attribution",
        )
        occlusion = as_bool(
            value.get("include_occlusion_attribution", False),
            "include_occlusion_attribution",
        )
        if transient and occlusion:
            raise ToolError(
                "scene-set transient and occlusion attribution are mutually exclusive"
            )
        normalized.update({
            "scene_id": scene_id,
            "scene_launch_ids": [member.launch_id for member in members],
            "include_transient_attribution": transient,
            "include_occlusion_attribution": occlusion,
        })
        return normalized

    @staticmethod
    def _frame_state_copy(value: Any) -> Any:
        return json.loads(canonical_json(value))

    def _frame_cursor_digest(self, raw: bytes | bytearray) -> str:
        if not isinstance(raw, (bytes, bytearray)) or len(raw) != FRAME_PULSE_CURSOR_BYTES:
            raise ToolError("FramePulse cursor payload is invalid")
        return hmac.new(
            self.frame_cursor_key,
            b"sandcodex-frame-pulse-cursor\x00" + bytes(raw),
            hashlib.sha256,
        ).hexdigest()

    def _prune_frame_cursors(self, now: float | None = None) -> None:
        current = time.monotonic() if now is None else now
        for digest, lease in list(self.frame_cursors.items()):
            expires = lease.get("expires_monotonic")
            if not isinstance(expires, (int, float)) or expires <= current:
                self.frame_cursors.pop(digest, None)
        while len(self.frame_cursors) >= FRAME_PULSE_CURSOR_MAX:
            self.frame_cursors.pop(next(iter(self.frame_cursors)))

    def _issue_frame_cursor(
        self,
        capture_arguments: Mapping[str, Any],
        capture_source: Mapping[str, Any],
        image: Image.Image,
        *,
        mode: str,
        baseline_sha256: str | None,
        difference_threshold: float,
        comparison: str,
        stable_milliseconds: int,
    ) -> tuple[str, dict[str, Any]]:
        normalized_arguments = self._canonical_frame_capture_arguments(capture_arguments)
        normalized_source = self._validate_capture_source(capture_source)
        screen_sha256 = self._image_fingerprint(image)
        visual_sample_sha256 = hashlib.sha256(self._visual_sample(image)).hexdigest()
        arguments_sha256 = hashlib.sha256(canonical_json(normalized_arguments)).hexdigest()
        source_sha256 = hashlib.sha256(canonical_json(normalized_source)).hexdigest()
        now = time.monotonic()
        self._prune_frame_cursors(now)
        for _ in range(16):
            raw = secrets.token_bytes(FRAME_PULSE_CURSOR_BYTES)
            digest = self._frame_cursor_digest(raw)
            if digest not in self.frame_cursors:
                break
        else:
            raise ToolError("could not allocate a FramePulse cursor")
        frontier = {
            "schema": FRAME_FRONTIER_SCHEMA,
            "mode": mode,
            "baseline_sha256": baseline_sha256,
            "difference_threshold": difference_threshold,
            "comparison": comparison,
            "stable_milliseconds": stable_milliseconds,
            "screen_sha256": screen_sha256,
            "capture_arguments_sha256": arguments_sha256,
            "capture_source_sha256": source_sha256,
            "exact_pixels_stable": True,
        }
        self.frame_cursors[digest] = {
            "schema": FRAME_PULSE_CURSOR_SCHEMA,
            "capture_arguments": self._frame_state_copy(normalized_arguments),
            "capture_arguments_sha256": arguments_sha256,
            "capture_source": self._frame_state_copy(normalized_source),
            "capture_source_sha256": source_sha256,
            "screen_sha256": screen_sha256,
            "visual_sample_sha256": visual_sample_sha256,
            "width": image.width,
            "height": image.height,
            "frontier": self._frame_state_copy(frontier),
            "issued_monotonic": now,
            "expires_monotonic": now + FRAME_PULSE_CURSOR_TTL_SECONDS,
        }
        token = base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
        public_frontier = dict(frontier)
        public_frontier.update({
            "cursor_schema": FRAME_PULSE_CURSOR_SCHEMA,
            "cursor_expires_in_milliseconds": FRAME_PULSE_CURSOR_TTL_SECONDS * 1000,
            "cursor_single_observation_attempt": True,
            "raw_cursor_retained_by_controller": False,
        })
        return token, public_frontier

    def _decode_frame_cursor(self, value: Any) -> bytes:
        token = as_string(value, "frame_fence.cursor", maximum=128, allow_empty=False)
        if re.fullmatch(r"[A-Za-z0-9_-]{43}", token) is None:
            raise ToolError("FramePulse cursor encoding is invalid")
        try:
            raw = base64.urlsafe_b64decode(token + "=")
        except (binascii.Error, ValueError) as error:
            raise ToolError("FramePulse cursor encoding is invalid") from error
        if (
            len(raw) != FRAME_PULSE_CURSOR_BYTES
            or base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=") != token
        ):
            raise ToolError("FramePulse cursor encoding is invalid")
        return raw

    def _validate_frame_fence_internal(self, value: Mapping[str, Any]) -> dict[str, Any]:
        if not isinstance(value, Mapping) or value.get("schema") != FRAME_FENCE_SCHEMA:
            raise ToolError("FrameFenceSeal state is invalid")
        required = {
            "schema", "capture_arguments", "capture_arguments_sha256",
            "capture_source", "capture_source_sha256", "screen_sha256",
            "visual_sample_sha256", "width", "height", "frontier",
            "issued_monotonic", "expires_monotonic", "capture_complete",
            "completion_recapture_sha256",
        }
        if set(value) != required:
            raise ToolError("FrameFenceSeal state fields are incomplete")
        capture_arguments_value = value.get("capture_arguments")
        if not isinstance(capture_arguments_value, Mapping):
            raise ToolError("FrameFenceSeal capture arguments are invalid")
        capture_arguments = self._canonical_frame_capture_arguments(capture_arguments_value)
        arguments_sha256 = value.get("capture_arguments_sha256")
        if (
            not isinstance(arguments_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", arguments_sha256) is None
            or not hmac.compare_digest(
                arguments_sha256,
                hashlib.sha256(canonical_json(capture_arguments)).hexdigest(),
            )
        ):
            raise ToolError("FrameFenceSeal capture argument authority is invalid")
        capture_source_value = value.get("capture_source")
        if not isinstance(capture_source_value, Mapping):
            raise ToolError("FrameFenceSeal capture source is invalid")
        capture_source = self._validate_capture_source(capture_source_value)
        source_sha256 = value.get("capture_source_sha256")
        if (
            not isinstance(source_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", source_sha256) is None
            or not hmac.compare_digest(
                source_sha256,
                hashlib.sha256(canonical_json(capture_source)).hexdigest(),
            )
        ):
            raise ToolError("FrameFenceSeal capture source authority is invalid")
        for name in ("screen_sha256", "visual_sample_sha256"):
            digest = value.get(name)
            if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                raise ToolError(f"FrameFenceSeal {name} is invalid")
        width = value.get("width")
        height = value.get("height")
        if any(
            isinstance(dimension, bool) or not isinstance(dimension, int) or dimension <= 0
            for dimension in (width, height)
        ):
            raise ToolError("FrameFenceSeal dimensions are invalid")
        issued = value.get("issued_monotonic")
        expires = value.get("expires_monotonic")
        if (
            isinstance(issued, bool) or not isinstance(issued, (int, float))
            or isinstance(expires, bool) or not isinstance(expires, (int, float))
            or expires <= issued
        ):
            raise ToolError("FrameFenceSeal lifetime is invalid")
        if not isinstance(value.get("capture_complete"), bool):
            raise ToolError("FrameFenceSeal capture state is invalid")
        completion = value.get("completion_recapture_sha256")
        if completion is not None and (
            not isinstance(completion, str) or re.fullmatch(r"[0-9a-f]{64}", completion) is None
        ):
            raise ToolError("FrameFenceSeal completion digest is invalid")
        if value.get("capture_complete") is True:
            if completion != value.get("screen_sha256"):
                raise ToolError("FrameFenceSeal completion does not match its reviewed pixels")
        elif completion is not None:
            raise ToolError("incomplete FrameFenceSeal carries completion evidence")
        frontier = value.get("frontier")
        if not isinstance(frontier, Mapping) or frontier.get("schema") != FRAME_FRONTIER_SCHEMA:
            raise ToolError("FrameFenceSeal visual frontier is invalid")
        frontier_fields = {
            "schema", "mode", "baseline_sha256", "difference_threshold",
            "comparison", "stable_milliseconds", "screen_sha256",
            "capture_arguments_sha256", "capture_source_sha256",
            "exact_pixels_stable",
        }
        if set(frontier) != frontier_fields:
            raise ToolError("FrameFenceSeal visual frontier fields are incomplete")
        if frontier.get("mode") not in {"changed", "stable"}:
            raise ToolError("FrameFenceSeal visual frontier mode is invalid")
        baseline_sha256 = frontier.get("baseline_sha256")
        if baseline_sha256 is not None and (
            not isinstance(baseline_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", baseline_sha256) is None
        ):
            raise ToolError("FrameFenceSeal visual frontier baseline is invalid")
        difference_threshold = frontier.get("difference_threshold")
        if (
            isinstance(difference_threshold, bool)
            or not isinstance(difference_threshold, (int, float))
            or not math.isfinite(float(difference_threshold))
            or not 0.0 <= float(difference_threshold) <= 1.0
        ):
            raise ToolError("FrameFenceSeal visual frontier threshold is invalid")
        if frontier.get("comparison") not in {"exact-hash-only", "perceptual-sample"}:
            raise ToolError("FrameFenceSeal visual frontier comparison is invalid")
        stable_milliseconds = frontier.get("stable_milliseconds")
        if (
            isinstance(stable_milliseconds, bool)
            or not isinstance(stable_milliseconds, int)
            or not FRAME_PULSE_MIN_STABLE_MILLISECONDS
            <= stable_milliseconds
            <= FRAME_PULSE_MAX_STABLE_MILLISECONDS
        ):
            raise ToolError("FrameFenceSeal visual frontier stability interval is invalid")
        if (
            frontier.get("screen_sha256") != value.get("screen_sha256")
            or frontier.get("capture_arguments_sha256") != arguments_sha256
            or frontier.get("capture_source_sha256") != source_sha256
            or frontier.get("exact_pixels_stable") is not True
        ):
            raise ToolError("FrameFenceSeal visual frontier disagrees with its authority")
        normalized = dict(value)
        normalized["capture_arguments"] = capture_arguments
        normalized["capture_source"] = capture_source
        normalized["frontier"] = dict(frontier)
        return normalized

    def _arm_frame_fence(
        self,
        arguments: Mapping[str, Any],
        capture_arguments: Mapping[str, Any],
    ) -> dict[str, Any]:
        if not self.is_wayland:
            raise ToolError("FrameFenceSeal requires the private Wayland backend")
        if not isinstance(arguments, Mapping):
            raise ToolError("frame_fence must be an object")
        unexpected = sorted(set(arguments) - {"cursor", "sha256"})
        if unexpected:
            raise ToolError(f"frame_fence contains unsupported keys: {', '.join(unexpected)}")
        if "cursor" not in arguments:
            raise ToolError("frame_fence requires a FramePulse cursor")
        raw = self._decode_frame_cursor(arguments.get("cursor"))
        now = time.monotonic()
        self._prune_frame_cursors(now)
        # A known cursor grants exactly one observation attempt. Consume it
        # before mutable scope/hash checks so failures cannot be replayed.
        lease = self.frame_cursors.pop(self._frame_cursor_digest(raw), None)
        if lease is None:
            raise ToolError("FramePulse cursor is unknown, expired, or already consumed")
        if lease.get("schema") != FRAME_PULSE_CURSOR_SCHEMA:
            raise ToolError("FramePulse cursor state is invalid")
        expires = lease.get("expires_monotonic")
        if not isinstance(expires, (int, float)) or expires <= now:
            raise ToolError("FramePulse cursor expired before observation")
        normalized_arguments = self._canonical_frame_capture_arguments(capture_arguments)
        expected_arguments = lease.get("capture_arguments")
        expected_arguments_sha256 = lease.get("capture_arguments_sha256")
        current_arguments_sha256 = hashlib.sha256(canonical_json(normalized_arguments)).hexdigest()
        if (
            not isinstance(expected_arguments, Mapping)
            or normalized_arguments != dict(expected_arguments)
            or not isinstance(expected_arguments_sha256, str)
            or not hmac.compare_digest(expected_arguments_sha256, current_arguments_sha256)
        ):
            raise ToolError(
                "FramePulse cursor belongs to another exact capture scope; observation was withheld"
            )
        requested_sha = arguments.get("sha256")
        if requested_sha is not None:
            requested_sha = as_string(
                requested_sha, "frame_fence.sha256", maximum=64, allow_empty=False,
            ).lower()
            if re.fullmatch(r"[0-9a-f]{64}", requested_sha) is None:
                raise ToolError("frame_fence.sha256 must be a SHA-256 digest")
            stored_sha = lease.get("screen_sha256")
            if not isinstance(stored_sha, str) or not hmac.compare_digest(stored_sha, requested_sha):
                raise ToolError(
                    "frame_fence.sha256 does not match the cursor's exact waited pixels"
                )
        state = {
            "schema": FRAME_FENCE_SCHEMA,
            "capture_arguments": self._frame_state_copy(normalized_arguments),
            "capture_arguments_sha256": current_arguments_sha256,
            "capture_source": self._frame_state_copy(lease.get("capture_source")),
            "capture_source_sha256": lease.get("capture_source_sha256"),
            "screen_sha256": lease.get("screen_sha256"),
            "visual_sample_sha256": lease.get("visual_sample_sha256"),
            "width": lease.get("width"),
            "height": lease.get("height"),
            "frontier": self._frame_state_copy(lease.get("frontier")),
            "issued_monotonic": lease.get("issued_monotonic"),
            "expires_monotonic": expires,
            "capture_complete": False,
            "completion_recapture_sha256": None,
        }
        return self._validate_frame_fence_internal(state)

    def _assert_frame_fence_exact(
        self,
        fence: Mapping[str, Any],
        capture_arguments: Mapping[str, Any],
        image: Image.Image,
        capture_source: Mapping[str, Any],
        *,
        context: str,
        require_complete: bool,
    ) -> dict[str, Any]:
        state = self._validate_frame_fence_internal(fence)
        if require_complete and state.get("capture_complete") is not True:
            raise ToolError("FrameFenceSeal was not closed around its guarded observation")
        normalized_arguments = self._canonical_frame_capture_arguments(capture_arguments)
        if normalized_arguments != state["capture_arguments"]:
            raise ToolError(f"FrameFenceSeal capture scope changed {context}")
        source = self._validate_capture_source(capture_source)
        if source != state["capture_source"]:
            raise ToolError(f"FrameFenceSeal capture source changed {context}")
        if image.width != state["width"] or image.height != state["height"]:
            raise ToolError(f"FrameFenceSeal capture geometry changed {context}")
        screen_sha256 = self._image_fingerprint(image)
        if not hmac.compare_digest(screen_sha256, state["screen_sha256"]):
            raise ToolError(f"exact waited pixels changed {context}; guarded authority was withheld")
        sample_sha256 = hashlib.sha256(self._visual_sample(image)).hexdigest()
        if not hmac.compare_digest(sample_sha256, state["visual_sample_sha256"]):
            raise ToolError(f"FrameFenceSeal visual sample changed {context}")
        return state

    def _complete_frame_fence(
        self,
        fence: Mapping[str, Any],
        capture_arguments: Mapping[str, Any],
        image: Image.Image,
        capture_source: Mapping[str, Any],
    ) -> dict[str, Any]:
        state = self._assert_frame_fence_exact(
            fence,
            capture_arguments,
            image,
            capture_source,
            context="during guarded observation capture",
            require_complete=False,
        )
        if state.get("capture_complete") is True:
            raise ToolError("FrameFenceSeal observation capture was already completed")
        # Close the wait->observe interval with a second exact capture. Pixel-
        # only animation or application redraw that evades semantic events then
        # withholds the observation rather than silently moving the frontier.
        final_frame = self._capture_region(state["capture_arguments"])
        final_image = final_frame.image
        final_source = self._capture_source_from_frame(final_frame)
        self._assert_frame_fence_exact(
            state,
            state["capture_arguments"],
            final_image,
            final_source,
            context="before guarded observation completion",
            require_complete=False,
        )
        completed = dict(state)
        completed["capture_complete"] = True
        completed["completion_recapture_sha256"] = state["screen_sha256"]
        return self._validate_frame_fence_internal(completed)

    def _validate_frame_fence_for_step(
        self,
        fence: Mapping[str, Any],
        capture_arguments: Mapping[str, Any],
        image: Image.Image,
        capture_source: Mapping[str, Any],
        *,
        phase: str,
    ) -> dict[str, Any]:
        state = self._assert_frame_fence_exact(
            fence,
            capture_arguments,
            image,
            capture_source,
            context=f"before guarded-action {phase}",
            require_complete=True,
        )
        return self._public_frame_fence(
            state,
            validated_for_dispatch=True,
            validation_phase=phase,
        )

    def _recapture_frame_fence_for_step(
        self,
        fence: Mapping[str, Any],
        capture_arguments: Mapping[str, Any],
        *,
        phase: str,
    ) -> dict[str, Any]:
        frame = self._capture_region(dict(capture_arguments))
        image = frame.image
        capture_source = self._capture_source_from_frame(frame)
        return self._validate_frame_fence_for_step(
            fence,
            capture_arguments,
            image,
            capture_source,
            phase=phase,
        )

    @staticmethod
    def _public_frame_fence(
        fence: Mapping[str, Any] | None,
        *,
        validated_for_dispatch: bool = False,
        validation_phase: str | None = None,
    ) -> dict[str, Any] | None:
        if fence is None:
            return None
        if not isinstance(fence, Mapping) or fence.get("schema") != FRAME_FENCE_SCHEMA:
            raise ToolError("FrameFenceSeal state is invalid")
        frontier = fence.get("frontier")
        if not isinstance(frontier, Mapping) or frontier.get("schema") != FRAME_FRONTIER_SCHEMA:
            raise ToolError("FrameFenceSeal visual frontier is invalid")
        return {
            "schema": FRAME_FENCE_SCHEMA,
            "enforced": True,
            "capture_complete": fence.get("capture_complete") is True,
            "validated_for_dispatch": validated_for_dispatch,
            "validation_phase": validation_phase,
            "pointer_latch_handoff": False,
            "screen_sha256": fence.get("screen_sha256"),
            "capture_arguments_sha256": fence.get("capture_arguments_sha256"),
            "capture_source_sha256": fence.get("capture_source_sha256"),
            "wait_mode": frontier.get("mode"),
            "stable_milliseconds": frontier.get("stable_milliseconds"),
            "exact_pixels_stable": frontier.get("exact_pixels_stable") is True,
            "cursor_single_observation_attempt": True,
            "raw_cursor_retained_by_controller": False,
            "completion_recapture_required": True,
            "policy": (
                "single-observation-use-wait-cursor+exact-capture-scope+exact-source+"
                "exact-pixels-through-observation-and-pre-input-validation"
            ),
        }

    @staticmethod
    def _observation_guard(image: Image.Image) -> tuple[int, int, bytes]:
        """Create a bounded grayscale reference map retained only for token life."""
        width, height = image.size
        scale = min(1.0, OBSERVATION_GUARD_MAX_DIMENSION / max(width, height))
        guard_width = max(1, round(width * scale))
        guard_height = max(1, round(height * scale))
        resampling = getattr(Image, "Resampling", Image).BILINEAR
        guard = image.convert("L").resize((guard_width, guard_height), resampling)
        return guard_width, guard_height, guard.tobytes()

    def _guard_target_sample(
        self,
        guard_width: int,
        guard_height: int,
        guard_pixels: bytes,
        region: dict[str, int],
        x: int,
        y: int,
    ) -> bytes:
        if guard_width <= 0 or guard_height <= 0 or len(guard_pixels) != guard_width * guard_height:
            raise ToolError("guarded observation lost its target-reference map")
        if not self._point_in_rectangle(region, x, y):
            raise ToolError("pointer target is outside the guarded observation reference")
        local_x = x - int(region["x"])
        local_y = y - int(region["y"])
        region_width = max(1, int(region["width"]))
        region_height = max(1, int(region["height"]))
        guard_x = min(
            guard_width - 1,
            max(0, int((local_x + 0.5) * guard_width / region_width)),
        )
        guard_y = min(
            guard_height - 1,
            max(0, int((local_y + 0.5) * guard_height / region_height)),
        )
        radius_x = max(2, round(POINTER_LATCH_TARGET_RADIUS * guard_width / region_width))
        radius_y = max(2, round(POINTER_LATCH_TARGET_RADIUS * guard_height / region_height))
        guard = Image.frombytes("L", (guard_width, guard_height), guard_pixels)
        left = max(0, guard_x - radius_x)
        top = max(0, guard_y - radius_y)
        right = min(guard_width, guard_x + radius_x + 1)
        bottom = min(guard_height, guard_y + radius_y + 1)
        resampling = getattr(Image, "Resampling", Image).BILINEAR
        return guard.crop((left, top, right, bottom)).resize(
            (POINTER_LATCH_TARGET_SAMPLE_SIZE, POINTER_LATCH_TARGET_SAMPLE_SIZE),
            resampling,
        ).tobytes()

    def _observation_target_sample(self, observation: Observation, x: int, y: int) -> bytes:
        return self._guard_target_sample(
            observation.guard_width,
            observation.guard_height,
            observation.guard_pixels,
            self._observation_region(observation),
            x,
            y,
        )

    def _image_target_sample(
        self,
        image: Image.Image,
        crop: dict[str, int] | None,
        x: int,
        y: int,
    ) -> bytes:
        """Create the same bounded target sample used by the original token."""
        guard_width, guard_height, guard_pixels = self._observation_guard(image)
        region = dict(crop) if crop is not None else {
            "x": 0,
            "y": 0,
            "width": image.width,
            "height": image.height,
        }
        return self._guard_target_sample(
            guard_width,
            guard_height,
            guard_pixels,
            region,
            x,
            y,
        )

    def screenshot(self, arguments: dict[str, Any]) -> dict[str, Any]:
        frame = self._capture_region(arguments)
        image = frame.image
        crop_value = frame.crop
        window_id = frame.window_id
        capture_source = self._capture_source_from_frame(frame)
        buffer = io.BytesIO()
        image.save(buffer, format="PNG", optimize=True)
        payload = buffer.getvalue()
        if len(payload) > self.max_output_bytes:
            raise ToolError("screenshot exceeds the configured output limit")
        filename = arguments.get("filename")
        saved: str | None = None
        if filename is not None:
            destination = self._safe_output(filename)
            temporary = destination.with_name(f".{destination.name}.{uuid.uuid4().hex}.tmp")
            descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
            try:
                write_all(descriptor, payload)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.replace(temporary, destination)
            saved = str(destination)
        self.observation_sequence += 1
        metadata = {
            "sequence": self.observation_sequence,
            "captured_at": utc_now(),
            "width": image.width,
            "height": image.height,
            "bytes": len(payload),
            "sha256": self._image_fingerprint(image),
            "crop": crop_value,
            "window_id": window_id,
            "capture_source": capture_source,
            "pointer": self.pointer_position(),
            "saved": saved,
        }
        return {
            "content": [
                {"type": "text", "text": json.dumps(metadata, sort_keys=True)},
                {"type": "image", "data": base64.b64encode(payload).decode("ascii"), "mimeType": "image/png"},
            ],
            "structuredContent": metadata,
        }

    def wait_for_screen(self, arguments: dict[str, Any]) -> dict[str, Any]:
        mode = arguments.get("mode", "changed")
        if mode not in {"changed", "stable"}:
            raise ToolError("mode must be changed or stable")
        timeout_ms = as_int(arguments.get("timeout_milliseconds", 10000), 0, 30000, "timeout_milliseconds")
        poll_ms = as_int(arguments.get("poll_milliseconds", 100), 25, 1000, "poll_milliseconds")
        stable_ms = as_int(arguments.get("stable_milliseconds", 500), 100, 10000, "stable_milliseconds")
        threshold = as_number(arguments.get("difference_threshold", 0.002), 0.0, 1.0, "difference_threshold")
        mint_frame_cursor = as_bool(
            arguments.get("mint_frame_cursor", False),
            "mint_frame_cursor",
        )
        if mint_frame_cursor and not self.is_wayland:
            raise ToolError("FramePulseSeal requires the private Wayland backend")
        if not mint_frame_cursor and "frame_stable_milliseconds" in arguments:
            raise ToolError(
                "frame_stable_milliseconds requires mint_frame_cursor=true"
            )
        frame_stable_ms = as_int(
            arguments.get(
                "frame_stable_milliseconds",
                FRAME_PULSE_DEFAULT_STABLE_MILLISECONDS,
            ),
            FRAME_PULSE_MIN_STABLE_MILLISECONDS,
            FRAME_PULSE_MAX_STABLE_MILLISECONDS,
            "frame_stable_milliseconds",
        )
        baseline_value = arguments.get("baseline_sha256")
        baseline_hash = None
        if baseline_value is not None:
            baseline_hash = as_string(baseline_value, "baseline_sha256", maximum=64, allow_empty=False).lower()
            if re.fullmatch(r"[0-9a-f]{64}", baseline_hash) is None:
                raise ToolError("baseline_sha256 must be a lowercase or uppercase SHA-256 digest")
        capture_arguments = {
            key: arguments[key]
            for key in (
                "capture_mode", "launch_id", "scene_id", "scene_launch_ids",
                "include_transient_attribution", "include_occlusion_attribution",
                "crop", "window_id",
            )
            if key in arguments
        }
        if mint_frame_cursor:
            # Freeze omitted defaults, integer-like IDs, and scene membership
            # before the first pixel enters the visual capability.
            capture_arguments = self._canonical_frame_capture_arguments(capture_arguments)
        started = time.monotonic()
        deadline = started + timeout_ms / 1000
        frame = self._capture_region(capture_arguments)
        image = frame.image
        crop_value = frame.crop
        window_id = frame.window_id
        capture_source = self._capture_source_from_frame(frame)
        initial_capture_source = dict(capture_source)
        initial_hash = self._image_fingerprint(image)
        initial_sample = self._visual_sample(image)
        previous_hash = initial_hash
        previous_sample = initial_sample
        current_sample = initial_sample
        stable_since = started
        polls = 1
        matched = mode == "changed" and baseline_hash is not None and initial_hash != baseline_hash
        difference: float | None = None if matched else 0.0
        comparison = "exact-hash-only" if matched else "perceptual-sample"
        current_hash = initial_hash
        while not matched and time.monotonic() < deadline:
            time.sleep(min(poll_ms / 1000, max(0.0, deadline - time.monotonic())))
            frame = self._capture_region(capture_arguments)
            image = frame.image
            crop_value = frame.crop
            window_id = frame.window_id
            capture_source = self._capture_source_from_frame(frame)
            if capture_source != initial_capture_source:
                raise ToolError("screen wait capture source identity changed before completion")
            current_hash = self._image_fingerprint(image)
            current_sample = self._visual_sample(image)
            polls += 1
            now = time.monotonic()
            if mode == "changed":
                reference_hash = baseline_hash or initial_hash
                difference = self._visual_difference(initial_sample, current_sample)
                matched = current_hash != reference_hash and difference >= threshold
            else:
                difference = self._visual_difference(previous_sample, current_sample)
                if current_hash == previous_hash or difference <= threshold:
                    if (now - stable_since) * 1000 >= stable_ms:
                        matched = True
                else:
                    stable_since = now
                previous_hash = current_hash
                previous_sample = current_sample
        frame_cursor: str | None = None
        frame_frontier: dict[str, Any] | None = None
        if matched and mint_frame_cursor:
            # The ordinary wait condition may be perceptual. A FramePulse
            # cursor is stronger: the exact RGB frame and exact CaptureSeal
            # source must remain unchanged for a second bounded interval.
            exact_hash = current_hash
            exact_sample = current_sample
            exact_stable_since = time.monotonic()
            while (time.monotonic() - exact_stable_since) * 1000 < frame_stable_ms:
                now = time.monotonic()
                if now >= deadline:
                    raise ToolError(
                        "desktop screen matched its wait condition but did not remain exact-pixel "
                        f"stable for {frame_stable_ms} milliseconds before the timeout"
                    )
                time.sleep(min(poll_ms / 1000, max(0.0, deadline - now)))
                frame = self._capture_region(capture_arguments)
                image = frame.image
                crop_value = frame.crop
                window_id = frame.window_id
                capture_source = self._capture_source_from_frame(frame)
                if capture_source != initial_capture_source:
                    raise ToolError(
                        "screen wait capture source identity changed while sealing FramePulse"
                    )
                current_hash = self._image_fingerprint(image)
                current_sample = self._visual_sample(image)
                polls += 1
                if current_hash != exact_hash or current_sample != exact_sample:
                    raise ToolError(
                        "screen pixels changed while sealing FramePulse; no visual cursor was minted"
                    )
            frame_cursor, frame_frontier = self._issue_frame_cursor(
                capture_arguments,
                capture_source,
                image,
                mode=mode,
                baseline_sha256=baseline_hash,
                difference_threshold=threshold,
                comparison=comparison,
                stable_milliseconds=frame_stable_ms,
            )
        elapsed_ms = round((time.monotonic() - started) * 1000)
        result = {
            "matched": matched,
            "wait_condition_matched": matched,
            "mode": mode,
            "elapsed_milliseconds": elapsed_ms,
            "polls": polls,
            "initial_sha256": initial_hash,
            "sha256": current_hash,
            "difference": difference,
            "difference_threshold": threshold,
            "comparison": comparison,
            "baseline_sha256": baseline_hash,
            "crop": crop_value,
            "window_id": window_id,
            "capture_source": capture_source,
            "frame_cursor_minted": frame_cursor is not None,
        }
        if frame_cursor is not None and frame_frontier is not None:
            result.update({
                "frame_cursor": frame_cursor,
                "frame_frontier": frame_frontier,
                "frame_stable_milliseconds": frame_stable_ms,
            })
        if not matched:
            raise ToolError(f"desktop screen did not become {mode} within {timeout_ms} milliseconds; last observation: {json.dumps(result, sort_keys=True)}")
        return json_result(result)

    def pointer_position(self) -> dict[str, Any]:
        if self.is_wayland:
            return {
                "x": self.pointer["x"], "y": self.pointer["y"],
                "same_screen": True, "source": "controller-tracked",
                "state_mask": None, "buttons_down": [], "modifiers_down": [],
            }
        data = self.root.query_pointer()._data
        state_mask = int(data.get("mask", 0))
        buttons_down = [
            button for button, mask in (
                (1, X.Button1Mask), (2, X.Button2Mask), (3, X.Button3Mask),
                (4, X.Button4Mask), (5, X.Button5Mask),
            ) if state_mask & mask
        ]
        modifiers_down = [
            name for name, mask in (
                ("Shift", X.ShiftMask), ("Ctrl", X.ControlMask),
                ("Alt", X.Mod1Mask), ("Super", X.Mod4Mask), ("AltGr", X.Mod5Mask),
            ) if state_mask & mask
        ]
        return {
            "x": int(data["root_x"]), "y": int(data["root_y"]),
            "same_screen": bool(data["same_screen"]), "source": "x11-query-pointer",
            "state_mask": state_mask, "buttons_down": buttons_down,
            "modifiers_down": modifiers_down,
        }

    def move(self, arguments: dict[str, Any]) -> dict[str, Any]:
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        self._move(x, y)
        return json_result({"moved": True, "x": x, "y": y})

