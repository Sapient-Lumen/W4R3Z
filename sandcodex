def validate_inference_authority(inference, label, brokered_openrouter=False):
    inference_base = {"mode", "requested_model", "parent_provider_contract", "parent_provider_contract_sha256"}
    if (
        not isinstance(inference, dict)
        or inference.get("mode") not in {"gpt", "local", "remote", "gemini"}
        or not (set(inference) == inference_base or (inference.get("mode") == "remote" and set(inference) == inference_base | {"auto"}))
    ):
        fail(f"{label} inference authority is invalid")
    if inference["mode"] == "gpt":
        if brokered_openrouter or any(inference.get(field) is not None for field in (
            "requested_model", "parent_provider_contract", "parent_provider_contract_sha256"
        )):
            fail(f"{label} GPT inference authority unexpectedly carries a provider capability")
        return dict(inference)
    if inference["mode"] != "remote" and "auto" in inference:
        fail(f"only remote {label} inference authority may carry auto provider selection")
    model = inference.get("requested_model")
    if not isinstance(model, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}", model):
        fail(f"{label} {inference['mode']} model name is invalid")
    contract = inference.get("parent_provider_contract")
    expected = inference.get("parent_provider_contract_sha256")
    if brokered_openrouter:
        if inference["mode"] != "remote" or contract is not None or expected is not None:
            fail("brokered OpenRouter authority must be remote-auto and carry no parent provider contract")
    else:
        contract = checked_file(
            contract or "", f"parent {inference['mode']}-provider contract", 1024 * 1024,
        )
        if not isinstance(expected, str) or not KEY_RE.fullmatch(expected) or digest_file(contract) != expected:
            fail(f"parent {inference['mode']}-provider contract digest differs from campaign authority")
    if inference["mode"] == "remote":
        auto = inference.get("auto")
        if not isinstance(auto, dict) or set(auto) != {"enabled", "key_bank_file", "key_bank_sha256", "profile"}:
            fail(f"{label} remote auto authority is invalid")
        if not isinstance(auto.get("enabled"), bool):
            fail(f"{label} remote auto flag is invalid")
        if auto.get("profile") not in {"coding", "long-context-reading", "fast-cheap-worker", "tool-reliable", "fallback"}:
            fail(f"{label} remote-auto profile is invalid")
        if brokered_openrouter and not auto["enabled"]:
            fail("brokered OpenRouter authority must select a fresh model and key")
        if auto["enabled"]:
            key_bank = auto.get("key_bank_file")
            key_bank_sha = auto.get("key_bank_sha256")
            if not isinstance(key_bank, str) or not key_bank.startswith("/"):
                fail(f"{label} remote-auto key bank path is invalid")
            if not isinstance(key_bank_sha, str) or not KEY_RE.fullmatch(key_bank_sha):
                fail(f"{label} remote-auto key bank digest is invalid")
            key_bank = checked_file(key_bank, f"{label} remote-auto key bank", 1024 * 1024)
            if digest_file(key_bank) != key_bank_sha:
                fail(f"{label} remote-auto key bank digest differs from authority")
            auto = dict(auto, key_bank_file=key_bank)
            inference = dict(inference, auto=auto)
        elif auto.get("key_bank_file") is not None or auto.get("key_bank_sha256") is not None:
            fail(f"disabled {label} remote-auto authority carries a key bank")
    return dict(inference, parent_provider_contract=contract)


def inference_routes(authority):
    routes = {authority["inference"]["mode"]: authority["inference"]}
    routes.update(authority.get("worker_inferences", {}))
    return routes


def selected_worker_inference(authority, provider):
    if provider == "auto":
        return authority["inference"]["mode"], authority["inference"]
    routes = inference_routes(authority)
    if provider not in routes:
        available = ", ".join(sorted(routes))
        fail(f"team task requested provider {provider!r}, but this room authorizes only: {available}")
    return provider, routes[provider]


def validate_authority(authority, require_live=True):
    authority = validate_context(authority)
    if authority.get("schema") != AUTHORITY_SCHEMA:
        fail("campaign launch authority schema is incompatible")
    if authority.get("status") != "active":
        fail("campaign launch authority is not active")
    if authority.get("source_git") is None:
        fail("campaign launch authority has no sealed source Git identity")
    if require_live and not pid_matches(authority.get("parent_pid"), authority.get("parent_process_start")):
        fail("campaign launch authority belongs to an exited command room")
    if not ID_RE.fullmatch(str(authority.get("run_id", ""))):
        fail("campaign launch authority run identity is invalid")
    authority_path = authority.get("authority_path")
    if authority_path is not None:
        authority_path = checked_file(authority_path, "campaign launch authority path", 256 * 1024)
    for field, maximum in (("max_campaigns", 16), ("max_turns", 999999999)):
        value = authority.get(field)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0 or value > maximum:
            fail(f"campaign launch authority {field} is invalid")
    grants, launch_max = normalize_worker_grants(authority)
    if not isinstance(authority.get("worker_options"), list) or not all(isinstance(item, str) for item in authority["worker_options"]):
        fail("campaign worker options are invalid")
    if not isinstance(authority.get("provider_args"), list) or not all(isinstance(item, str) for item in authority["provider_args"]):
        fail("campaign provider arguments are invalid")
    inference = validate_inference_authority(authority.get("inference"), "campaign")
    worker_inferences = authority.get("worker_inferences")
    if not isinstance(worker_inferences, dict):
        fail("campaign delegated worker inference routes are invalid")
    if "gemini" in worker_inferences:
        fail("delegated Gemini authority is forbidden")
    if set(worker_inferences) - {"openrouter"}:
        fail("campaign delegated worker inference routes are invalid")
    normalized_worker_inferences = {}
    if "openrouter" in worker_inferences:
        normalized_worker_inferences["openrouter"] = validate_inference_authority(
            worker_inferences["openrouter"], "delegated OpenRouter", brokered_openrouter=True,
        )
    authority = dict(
        authority,
        authority_path=authority_path,
        inference=inference,
        worker_inferences=normalized_worker_inferences,
        launch_max_campaigns=launch_max,
        worker_grants=grants,
    )
    return authority


def roots(context):
    trusted = context["campaign_root"]
    workspaces = os.path.join(context["workspace_root"], context["project_key"])
    checked_dir(trusted, "project campaign registry", create=True)
    checked_dir(workspaces, "project campaign workspace registry", create=True)
    return trusted, workspaces


def storage_status(context):
    info = os.statvfs(context["campaign_root"])
    block = info.f_frsize or info.f_bsize
    capacity = info.f_blocks * block
    available = info.f_bavail * block
    maximum = context["storage"]["maximum_bytes"]
    return {
        **context["storage"],
        "filesystem_capacity_bytes": capacity,
        "used_bytes": capacity - available,
        "available_bytes": available,
        "state": "storage_hold" if maximum is not None and available == 0 else "available",
    }


def principal_path(root):
    return os.path.join(root, "principal.json")


def validate_principal_verifier(root, verifier, base_commit, object_format):
    if verifier is None:
        return
    fields = {
        "schema", "source_path", "expected_base", "blob_oid", "input_path",
        "input_sha256", "input_bytes", "interpreter", "sealed_at",
    }
    digest_length = 40 if object_format == "sha1" else 64
    expected_path = os.path.join(root, "verifier", "input.sh")
    if (not isinstance(verifier, dict) or set(verifier) != fields
            or verifier.get("schema") != SEALED_VERIFIER_SCHEMA
            or not relative_path(verifier.get("source_path"))
            or verifier.get("source_path") == ".sandcodex"
            or verifier.get("source_path", "").startswith(".sandcodex/")
            or verifier.get("expected_base") != base_commit
            or not re.fullmatch(rf"[0-9a-f]{{{digest_length}}}", str(verifier.get("blob_oid", "")))
            or verifier.get("input_path") != expected_path
            or not KEY_RE.fullmatch(str(verifier.get("input_sha256", "")))
            or not isinstance(verifier.get("input_bytes"), int)
            or isinstance(verifier.get("input_bytes"), bool)
            or not 1 <= verifier["input_bytes"] <= 1024 * 1024
            or verifier.get("interpreter") != "pinned-nix-bash"
            or not isinstance(verifier.get("sealed_at"), str)):
        fail("campaign principal sealed verifier is invalid")
    checked_sealed_file(expected_path, "sealed campaign verifier", 1024 * 1024)
    if os.path.getsize(expected_path) != verifier["input_bytes"] or digest_file(expected_path) != verifier["input_sha256"]:
        fail("sealed campaign verifier no longer matches its durable principal")


def validate_verification_summary(root, verification, campaign_id, base_commit, object_format):
    if verification is None:
        return
    fields = {
        "schema", "test_id", "receipt_path", "receipt_sha256", "principal_epoch",
        "base_commit", "candidate_commit", "status", "passed", "verified_at",
    }
    digest_length = 40 if object_format == "sha1" else 64
    test_id = verification.get("test_id") if isinstance(verification, dict) else None
    expected_path = os.path.join(root, "test-runs", f"{test_id}.receipt.json")
    if (not isinstance(verification, dict) or set(verification) != fields
            or verification.get("schema") != TEAM_VERIFICATION_SCHEMA
            or not ID_RE.fullmatch(str(test_id or ""))
            or verification.get("receipt_path") != expected_path
            or not KEY_RE.fullmatch(str(verification.get("receipt_sha256", "")))
            or not isinstance(verification.get("principal_epoch"), int)
            or isinstance(verification.get("principal_epoch"), bool)
            or verification["principal_epoch"] < 1
            or verification.get("base_commit") != base_commit
            or not re.fullmatch(rf"[0-9a-f]{{{digest_length}}}", str(verification.get("candidate_commit", "")))
            or verification.get("status") not in {"passed", "failed", "timeout", "output-limit"}
            or not isinstance(verification.get("passed"), bool)
            or verification["passed"] != (verification["status"] == "passed")
            or not isinstance(verification.get("verified_at"), str)):
        fail("campaign principal verification summary is invalid")
    checked_file(expected_path, "sealed verification receipt", 4 * 1024 * 1024)
    if digest_file(expected_path) != verification["receipt_sha256"]:
        fail("sealed verification receipt no longer matches its durable principal")


def load_principal(root, context):
    root = checked_dir(root, "campaign principal root")
    doc = load_json(principal_path(root), "campaign principal", 128 * 1024)
    campaign_id = os.path.basename(root)
    if doc.get("schema") != PRINCIPAL_SCHEMA or doc.get("campaign_id") != campaign_id or \
       not re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}", campaign_id):
        fail("campaign principal identity is invalid")
    if not NAME_RE.fullmatch(str(doc.get("name", ""))) or \
       doc.get("project") != context["project"] or doc.get("project_key") != context["project_key"]:
        fail("campaign principal fields are invalid")
    if not ID_RE.fullmatch(str(doc.get("parent_run_id", ""))) or \
       not isinstance(doc.get("epoch"), int) or isinstance(doc.get("epoch"), bool) or doc["epoch"] < 1 or \
       doc.get("status") not in NONTERMINAL | TERMINAL:
        fail("campaign principal lifecycle fields are invalid")
    if doc.get("inference_mode", "gpt") not in {"gpt", "local", "remote", "gemini"}:
        fail("campaign principal inference mode is invalid")
    if doc.get("provider_route", doc.get("inference_mode", "gpt")) not in {
        "gpt", "local", "remote", "gemini", "openrouter"
    }:
        fail("campaign principal provider route is invalid")
    object_format = doc.get("object_format")
    expected_digest = 40 if object_format == "sha1" else 64 if object_format == "sha256" else 0
    if expected_digest == 0 or not re.fullmatch(f"[0-9a-f]{{{expected_digest}}}", str(doc.get("base_commit", ""))):
        fail("campaign principal Git identity is invalid")
    validate_principal_verifier(root, doc.get("verifier"), doc["base_commit"], object_format)
    validate_verification_summary(
        root, doc.get("verification"), campaign_id, doc["base_commit"], object_format,
    )
    source_worktree = doc.get("source_worktree")
    if source_worktree is not None:
        counts = [
            source_worktree.get("dirty_paths_observed"),
            source_worktree.get("dirty_paths_included"),
            source_worktree.get("dirty_paths_excluded"),
        ] if isinstance(source_worktree, dict) else []
        if (not isinstance(source_worktree, dict)
                or source_worktree.get("mode") not in {"native", "managed"}
                or source_worktree.get("base_policy") not in {
                    "committed-base", "managed-snapshot"}
                or len(counts) != 3
                or any(not isinstance(value, int) or isinstance(value, bool) or value < 0
                       for value in counts)
                or counts[0] != counts[1] + counts[2]
                or (source_worktree["mode"] == "native" and counts[1] != 0)
                or (source_worktree["mode"] == "managed" and counts[2] != 0)
                or (source_worktree["base_policy"] == "managed-snapshot"
                    and source_worktree["mode"] != "managed")):
            fail("campaign principal source-worktree snapshot is invalid")
    turns = doc.get("turn_limit")
    if not isinstance(turns, int) or isinstance(turns, bool) or turns < 0 or turns > 999999999:
        fail("campaign principal turn limit is invalid")
    if doc.get("turn_counter", TURN_COUNTER) != TURN_COUNTER:
        fail("campaign principal turn counter is invalid")
    expected_workspace = os.path.join(
        context["workspace_root"], context["project_key"], campaign_id, "repo"
    )
    if doc.get("workspace") != expected_workspace or canonical(expected_workspace) != expected_workspace:
        fail("campaign principal workspace identity is invalid")
    worker_state = doc.get("worker_state")
    worker_key = project_key(expected_workspace)
    if worker_state is not None:
        expected_state = os.path.join(
            context["worker_global_root"], "projects", worker_key, "loop-state.json"
        )
        if worker_state != expected_state:
            fail("campaign worker state path is invalid")
    worker_unit = doc.get("worker_unit")
    if worker_unit is not None and not re.fullmatch(
        rf"sandcodex-loop-{re.escape(worker_key[:16])}-[A-Za-z0-9][A-Za-z0-9-]*\.service",
        str(worker_unit),
    ):
        fail("campaign worker unit identity is invalid")
    supervisor_id = doc.get("supervisor_id")
    if supervisor_id is not None and not ID_RE.fullmatch(str(supervisor_id)):
        fail("campaign worker supervisor identity is invalid")
    return doc


def save_principal(root, principal):
    principal["updated_at"] = now()
    atomic_json(principal_path(root), principal)


def campaign_roots(context):
    trusted, _ = roots(context)
    result = []
    for entry in sorted(Path(trusted).iterdir()):
        if entry.name == ".lock":
            continue
        if not entry.is_dir() or entry.is_symlink():
            fail(f"campaign registry contains an unsafe entry: {entry.name}")
        result.append((str(entry), load_principal(str(entry), context)))
    return result


def find_campaign(context, name, expected_run=None):
    matches = []
    for root, principal in campaign_roots(context):
        if principal["name"] == name:
            if expected_run is None or principal.get("parent_run_id") == expected_run:
                matches.append((root, principal))
    if not matches:
        fail(f"no companion campaign named {name!r} exists")
    if len(matches) != 1:
        fail(f"campaign name {name!r} is ambiguous")
    return matches[0]


def git_invocation(context, arguments):
    executable = context.get("git")
    if not executable:
        executable = shutil.which("git", path=context.get("host_path", ""))
    executable = canonical(executable or "")
    if not os.path.isfile(executable) or not os.access(executable, os.X_OK):
        fail("trusted Git executable is unavailable")
    environment = dict(
        PATH=context["host_path"],
        HOME=context["engine_home"],
        LC_ALL="C",
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_SYSTEM="/dev/null",
        GIT_CONFIG_GLOBAL="/dev/null",
        GIT_ATTR_NOSYSTEM="1",
        GIT_TERMINAL_PROMPT="0",
        GIT_OPTIONAL_LOCKS="0",
        GIT_NO_REPLACE_OBJECTS="1",
        GIT_PAGER="cat",
    )
    command = [
        executable,
        "-c", "core.hooksPath=/dev/null",
        "-c", "core.fsmonitor=false",
        "-c", "core.attributesFile=/dev/null",
        "-c", "credential.helper=",
        "-c", "protocol.ext.allow=never",
        "-c", "protocol.file.allow=always",
        *arguments,
    ]
    return command, environment


def git(context, arguments, cwd=None, check=True, timeout=120):
    command, environment = git_invocation(context, arguments)
    try:
        completed = subprocess.run(
            command, cwd=cwd, env=environment, text=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=timeout, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"Git command could not complete: {error}")
    if check and completed.returncode:
        detail = completed.stderr.strip().splitlines()
        fail(f"Git command failed ({completed.returncode}): {detail[-1] if detail else arguments[0]}")
    return completed


def source_git(context, arguments, check=True, timeout=120):
    source = context["source_git"]
    return git(
        context,
        [
            f"--git-dir={source['git_dir']}",
            f"--work-tree={source['work_tree']}",
            *arguments,
        ],
        cwd=source["work_tree"],
        check=check,
        timeout=timeout,
    )


def source_blob_bytes(context, object_id, maximum):
    """Read an exact, size-bounded blob from the sealed source object store."""
    if not isinstance(maximum, int) or isinstance(maximum, bool) or maximum < 1:
        fail("campaign verifier blob bound is invalid")
    size_text = source_git(context, ["cat-file", "-s", object_id]).stdout.strip()
    if not size_text.isdigit() or int(size_text) > maximum:
        fail("campaign verifier exceeds its sealed input size bound")
    source = context["source_git"]
    arguments = [
        f"--git-dir={source['git_dir']}",
        f"--work-tree={source['work_tree']}",
        "cat-file", "blob", object_id,
    ]
    command, environment = git_invocation(context, arguments)
    try:
        completed = subprocess.run(
            command, cwd=source["work_tree"], env=environment, text=False,
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=120, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"campaign verifier blob could not be read: {error}")
    if completed.returncode:
        fail("campaign verifier blob could not be read from the sealed base")
    if len(completed.stdout) != int(size_text):
        fail("campaign verifier blob size changed while sealing")
    return completed.stdout


def resolve_campaign_verifier(context, base, source_path, object_format):
    """Resolve a tracked verifier at the exact campaign base without mutation."""
    if source_path is None:
        return None
    if not relative_path(source_path) or source_path == ".sandcodex" or source_path.startswith(".sandcodex/"):
        fail("campaign verifier must be a tracked project-relative path outside .sandcodex")
    listing = source_git(
        context,
        ["--literal-pathspecs", "ls-tree", "-z", "--full-tree", base, "--", source_path],
    ).stdout
    records = [record for record in listing.split("\0") if record]
    if len(records) != 1 or "\t" not in records[0]:
        fail("campaign verifier is not one tracked file at the sealed base")
    metadata, listed_path = records[0].split("\t", 1)
    fields = metadata.split()
    if listed_path != source_path or len(fields) != 3 or fields[1] != "blob" or fields[0] not in {"100644", "100755"}:
        fail("campaign verifier is not a regular tracked file at the sealed base")
    object_id = fields[2]
    digest_length = 40 if object_format == "sha1" else 64
    if not re.fullmatch(rf"[0-9a-f]{{{digest_length}}}", object_id):
        fail("campaign verifier blob identity is invalid")
    payload = source_blob_bytes(context, object_id, 1024 * 1024)
    if not payload or b"\0" in payload:
        fail("campaign verifier must be a nonempty NUL-free shell program")
    try:
        payload.decode("utf-8")
    except UnicodeDecodeError:
        fail("campaign verifier must be UTF-8 shell source")
    return {
        "source_path": source_path,
        "expected_base": base,
        "blob_oid": object_id,
        "input_sha256": hashlib.sha256(payload).hexdigest(),
        "input_bytes": len(payload),
        "payload": payload,
    }


def install_campaign_verifier(root, resolved):
    if resolved is None:
        return None
    verifier_root = os.path.join(root, "verifier")
    os.mkdir(verifier_root, 0o700)
    input_path = os.path.join(verifier_root, "input.sh")
    atomic_bytes(input_path, resolved["payload"], mode=0o400, replace=False)
    descriptor = {
        "schema": SEALED_VERIFIER_SCHEMA,
        "source_path": resolved["source_path"],
        "expected_base": resolved["expected_base"],
        "blob_oid": resolved["blob_oid"],
        "input_path": input_path,
        "input_sha256": resolved["input_sha256"],
        "input_bytes": resolved["input_bytes"],
        "interpreter": "pinned-nix-bash",
        "sealed_at": now(),
    }
    checked_sealed_file(input_path, "sealed campaign verifier", 1024 * 1024)
    return descriptor


def managed_gitlink_count(context):
    if context["source_git"]["mode"] != "managed":
        return 0
    index = source_git(context, ["ls-files", "--stage", "-z"]).stdout
    return sum(record.startswith("160000 ") for record in index.split("\0") if record)


def loop_state(context, principal):
    path = principal.get("worker_state")
    if not path or not os.path.isfile(path) or os.path.islink(path):
        return None
    try:
        doc = load_json(path, "campaign worker state", 64 * 1024)
    except CampaignError:
        return None
    if doc.get("schema") != LOOP_SCHEMA or not ID_RE.fullmatch(str(doc.get("run_id", ""))):
        return None
    return doc


def worker_control_ready(context, principal):
    state = loop_state(context, principal)
    return state is not None and state.get("status") in {
        "running", "waiting_quota", "waiting_transient",
    } and pid_matches(state.get("pid"), state.get("process_start"))


def supervisor_state(context, principal):
    supervisor_id = principal.get("supervisor_id")
    worker_unit = principal.get("worker_unit")
    if not supervisor_id or not worker_unit:
        return None
    if not ID_RE.fullmatch(str(supervisor_id)):
        return None
    worker_key = project_key(principal["workspace"])
    root = os.path.join(context["worker_global_root"], "supervisors", worker_key, supervisor_id)
    spec_path = os.path.join(root, "spec.json")
    if not os.path.isfile(spec_path) or os.path.islink(spec_path):
        return None
    try:
        spec = load_json(spec_path, "campaign worker supervisor", 64 * 1024)
    except CampaignError:
        return None
    if spec.get("schema") != "sandcodex.supervisor.v1" or \
       spec.get("id") != supervisor_id or spec.get("unit") != worker_unit:
        return None
    status = spec.get("status")
    if status not in NONTERMINAL | TERMINAL:
        return None
    return spec


def refresh(context, root, principal):
    harvest_worker_messages(context, root, principal)
    sync_worker_inbox(context, root, principal)
    state = loop_state(context, principal)
    supervisor = supervisor_state(context, principal)
    status = principal.get("status", "queued")
    changed = False
    status_changed = False
    previous_status = status
    retry_event = None
    progress_event = None

    def set_field(name, value):
        nonlocal changed
        if principal.get(name) != value:
            principal[name] = value
            changed = True

    if state and status == "queued" and principal.get("worker_unit") and \
       state.get("supervisor_unit") != principal["worker_unit"]:
        # A recovered supervisor reuses the durable loop-state path. Until its
        # runner publishes the new unit identity, that file belongs to the
        # previous controller epoch and must not overwrite the queued restart.
        state = None
    if state:
        status = state.get("status", status)
        dead_active_worker = status in ACTIVE and not pid_matches(
            state.get("pid"), state.get("process_start")
        )
        supervisor_terminal = supervisor and supervisor.get("status") in TERMINAL
        if dead_active_worker:
            status = supervisor.get("status") if supervisor_terminal else "stale"
        set_field("worker_run_id", state.get("run_id"))
        set_field("worker_unit", state.get("supervisor_unit") or principal.get("worker_unit"))
        set_field("current_turn", state.get("current_turn", 0))
        set_field("remaining", state.get("remaining"))
        set_field("successful_turns", state.get("successful_turns", 0))
        set_field("attempts", state.get("attempts", 0))
        set_field("retry_count", state.get("retry_count", 0))
        state_error = state.get("last_error_class", "none")
        if dead_active_worker and supervisor_terminal and status == "failed" and state_error == "none":
            state_error = "worker-launch"
        set_field("last_error_class", state_error)
        set_field("next_attempt_at", state.get("next_attempt_at"))
        set_field(
            "last_exit",
            supervisor.get("last_exit") if dead_active_worker and supervisor_terminal
            else state.get("last_exit"),
        )
        set_field("worker_model", state.get("model"))
        usage = state.get("usage")
        set_field("worker_usage", usage if isinstance(usage, dict) else None)
        progress = {
            "worker_status": state.get("status"),
            "current_turn": state.get("current_turn", 0),
            "successful_turns": state.get("successful_turns", 0),
            "attempts": state.get("attempts", 0),
            "turn_limit": state.get("turn_limit", principal.get("turn_limit")),
            "remaining": state.get("remaining"),
            "model": state.get("model"),
            "loop_updated_at": state.get("updated_at"),
        }
        progress_signature = json.dumps(progress, sort_keys=True, separators=(",", ":"))
        if principal.get("last_worker_progress_signature") != progress_signature:
            set_field("last_worker_progress_signature", progress_signature)
            progress_event = progress
        if status in {"waiting_quota", "waiting_transient", "retry_exhausted"} or \
           state.get("last_error_class") in {"quota", "transient"}:
            signature = json.dumps(
                {
                    "status": status,
                    "worker_status": state.get("status"),
                    "error": state.get("last_error_class"),
                    "retry": state.get("retry_count", 0),
                    "attempts": state.get("attempts", 0),
                    "next": state.get("next_attempt_at"),
                    "model": state.get("model"),
                },
                sort_keys=True, separators=(",", ":"),
            )
            if principal.get("last_worker_retry_signature") != signature:
                set_field("last_worker_retry_signature", signature)
                retry_event = {
                    "status": status,
                    "worker_status": state.get("status"),
                    "last_error_class": state.get("last_error_class", "none"),
                    "retry_count": state.get("retry_count", 0),
                    "attempts": state.get("attempts", 0),
                    "next_attempt_at": state.get("next_attempt_at"),
                    "model": state.get("model"),
                }
    elif supervisor:
        supervisor_status = supervisor.get("status", status)
        if supervisor_status in TERMINAL or status in {"queued", "preparing"}:
            status = supervisor_status
            set_field("last_error_class", "worker-launch" if status == "failed" else principal.get("last_error_class", "none"))
    if status == "drained" and principal.get("completion_requested") is True:
        status = "completed"
    budgets = principal.get("budgets") if isinstance(principal.get("budgets"), dict) else {}
    token_budget = budgets.get("tokens")
    time_budget = budgets.get("time_seconds")
    usage_total = (principal.get("worker_usage") or {}).get("total_tokens", 0)
    elapsed = budget_elapsed(principal)
    budget_reason = None
    if isinstance(token_budget, int) and usage_total >= token_budget:
        budget_reason = "token"
    elif isinstance(time_budget, int) and elapsed >= time_budget:
        budget_reason = "time"
    if principal.get("budget_stop_requested") and status in ACTIVE:
        # The worker can remain observably alive for a short time after its
        # controller accepts stop.  Do not let that stale active state erase
        # the durable draining transition on the next broker refresh.
        status = "draining"
    elif budget_reason and status in ACTIVE:
        run_control(context, principal, "stop")
        set_field("budget_stop_requested", True)
        set_field("budget_exhausted", budget_reason)
        status = "draining"
        append_event(root, "budget-stop-requested", reason=budget_reason,
                     total_tokens=usage_total, elapsed_seconds=elapsed)
    if status != principal.get("status"):
        previous_status = principal.get("status")
        set_field("status", status)
        status_changed = True
    if changed:
        save_principal(root, principal)
    if status_changed:
        append_event(root, "status", previous=previous_status, status=status)
    if retry_event is not None:
        append_event(root, "worker-retry-state", **retry_event)
    if progress_event is not None:
        append_event(root, "worker-progress", **progress_event)
    return principal, state


def append_team_record(path, value):
    payload = json_bytes(value)
    if len(payload) > 64 * 1024:
        fail("team message record exceeds its size limit")
    append_locked_record(path, payload, "team message ledger")


def iter_team_records(root, filename):
    path = os.path.join(root, filename)
    if not os.path.exists(path):
        return
    checked_file(path, "team message ledger", 64 * 1024 * 1024)
    with open(path, "r", encoding="utf-8") as stream:
        for count, line in enumerate(stream, 1):
            try:
                value = json.loads(line)
            except json.JSONDecodeError:
                fail("team message ledger has a corrupt record")
            if not isinstance(value, dict):
                fail("team message ledger record is invalid")
            if count > 100000:
                fail("team message ledger exceeds its bounded record count")
            yield value


def team_records(root, filename):
    # Keep the list-returning interface for all existing callers.
    return list(iter_team_records(root, filename))


def team_mailbox_summary(root, worker_name):
    # Preserve the baseline messages-then-acknowledgements observation order.
    # Retain identities/recipients plus only the newest worker-to-foreman report;
    # do not keep every message body or attachment in memory.
    messages = []
    last_message_at = None
    last_report = None
    for row in iter_team_records(root, "messages.jsonl"):
        messages.append((row.get("message_id"), row.get("to")))
        last_message_at = row.get("created_at")
        if row.get("from") == worker_name and row.get("to") == "foreman":
            last_report = {
                "message_id": row.get("message_id"),
                "created_at": row.get("created_at"),
                "text": row.get("text"),
            }
    acked = {(row.get("message_id"), row.get("by"))
             for row in iter_team_records(root, "message-acks.jsonl")}
    return {
        "to_foreman_unread": sum(
            1 for message_id, recipient in messages if recipient == "foreman"
            and (message_id, "foreman") not in acked),
        "to_worker_unread": sum(
            1 for message_id, recipient in messages if recipient == worker_name
            and (message_id, worker_name) not in acked),
        "messages": len(messages),
        "last_message_at": last_message_at,
        "last_report": ({
            **last_report,
            "acknowledged": (last_report.get("message_id"), "foreman") in acked,
        } if last_report else None),
    }


def read_workspace_attachment(source, workspace, label):
    source = os.path.abspath(source)
    workspace = os.path.abspath(workspace)
    try:
        relative = os.path.relpath(source, workspace)
    except ValueError:
        fail(f"{label} lies outside its authorized checkout")
    components = relative.split(os.sep)
    if relative in {"", "."} or relative.startswith(".." + os.sep) or \
       any(component in {"", ".", ".."} for component in components):
        fail(f"{label} lies outside its authorized checkout")
    directory_flags = (
        os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) |
        getattr(os, "O_CLOEXEC", 0)
    )
    try:
        descriptor = os.open(workspace, directory_flags)
    except OSError as error:
        fail(f"{label} checkout is unavailable: {error}")
    try:
        for component in components[:-1]:
            try:
                child = os.open(component, directory_flags, dir_fd=descriptor)
            except OSError as error:
                fail(f"{label} parent is unavailable: {error}")
            os.close(descriptor)
            descriptor = child
        try:
            file_descriptor = os.open(
                components[-1],
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
                dir_fd=descriptor,
            )
        except OSError as error:
            fail(f"{label} is unavailable: {error}")
        try:
            info = os.fstat(file_descriptor)
            maximum = 16 * 1024 * 1024
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
               info.st_nlink != 1 or info.st_size > maximum:
                fail(f"{label} metadata or size is invalid")
            payload = bytearray()
            while len(payload) <= maximum:
                chunk = os.read(file_descriptor, min(1024 * 1024, maximum + 1 - len(payload)))
                if not chunk:
                    break
                payload.extend(chunk)
            if len(payload) > maximum:
                fail(f"{label} exceeds its size limit")
            after = os.fstat(file_descriptor)
            if after.st_size != len(payload) or after.st_ino != info.st_ino or after.st_dev != info.st_dev:
                fail(f"{label} changed while it was being read")
            return bytes(payload), os.path.basename(source)
        finally:
            os.close(file_descriptor)
    finally:
        os.close(descriptor)


def read_trusted_attachment(source, label):
    source = checked_file(source, label, 16 * 1024 * 1024)
    parent = checked_dir(os.path.dirname(source), f"{label} parent")
    parent_fd = os.open(
        parent,
        os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) |
        getattr(os, "O_CLOEXEC", 0),
    )
    try:
        descriptor = os.open(
            os.path.basename(source),
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        try:
            info = os.fstat(descriptor)
            maximum = 16 * 1024 * 1024
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
               info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > maximum:
                fail(f"{label} metadata or size is invalid")
            payload = bytearray()
            while len(payload) <= maximum:
                chunk = os.read(descriptor, min(1024 * 1024, maximum + 1 - len(payload)))
                if not chunk:
                    break
                payload.extend(chunk)
            if len(payload) > maximum or os.fstat(descriptor).st_size != len(payload):
                fail(f"{label} changed while it was being read")
            return bytes(payload)
        finally:
            os.close(descriptor)
    finally:
        os.close(parent_fd)


def store_team_attachment(root, source, workspace):
    if source is None:
        return None
    payload, name = read_workspace_attachment(source, workspace, "team attachment")
    digest = hashlib.sha256(payload).hexdigest()
    target_root = checked_dir(os.path.join(root, "attachments"), "team attachment root", create=True)
    target = os.path.join(target_root, digest)
    if not os.path.exists(target):
        atomic_bytes(target, payload, mode=0o600, replace=False)
    elif hashlib.sha256(read_trusted_attachment(target, "team attachment")).hexdigest() != digest:
        fail("team attachment digest conflicts with existing evidence")
    return {"sha256": digest, "bytes": len(payload), "name": name}


def open_owned_directory_at(parent_fd, name, label, create=False):
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        descriptor = os.open(name, flags, dir_fd=parent_fd)
    except FileNotFoundError:
        if not create:
            return None
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        descriptor = os.open(name, flags, dir_fd=parent_fd)
    info = os.fstat(descriptor)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        os.close(descriptor)
        fail(f"{label} metadata is invalid")
    return descriptor


def atomic_bytes_at(parent_fd, name, payload, label):
    if "/" in name or name in {"", ".", ".."}:
        fail(f"{label} name is invalid")
    temporary = ".team-" + secrets.token_hex(12)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    descriptor = os.open(temporary, flags, 0o600, dir_fd=parent_fd)
    try:
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        descriptor = -1
        try:
            os.link(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd, follow_symlinks=False)
            created = True
        except FileExistsError:
            created = False
            existing_fd = os.open(
                name,
                os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
                dir_fd=parent_fd,
            )
            try:
                info = os.fstat(existing_fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or \
                   info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size != len(payload):
                    fail(f"existing {label} metadata conflicts with trusted delivery")
                observed = b""
                while len(observed) <= len(payload):
                    chunk = os.read(existing_fd, min(65536, len(payload) + 1 - len(observed)))
                    if not chunk:
                        break
                    observed += chunk
                if observed != payload:
                    fail(f"existing {label} content conflicts with trusted delivery")
            finally:
                os.close(existing_fd)
        os.fsync(parent_fd)
        return created
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        removed = False
        try:
            os.unlink(temporary, dir_fd=parent_fd)
            removed = True
        except FileNotFoundError:
            pass
        if removed:
            os.fsync(parent_fd)


def retain_team_attachment(root, attachment, source):
    if attachment is None:
        return None
    payload = read_trusted_attachment(source, "trusted team attachment")
    if hashlib.sha256(payload).hexdigest() != attachment.get("sha256") or len(payload) != attachment.get("bytes"):
        fail("trusted team attachment no longer matches its sealed metadata")
    target_root = checked_dir(os.path.join(root, "attachments"), "team attachment root", create=True)
    target = os.path.join(target_root, attachment["sha256"])
    if not os.path.exists(target):
        atomic_bytes(target, payload, mode=0o600, replace=False)
    elif hashlib.sha256(read_trusted_attachment(target, "team attachment")).hexdigest() != attachment["sha256"]:
        fail("team attachment digest conflicts with existing evidence")
    return target


def deliver_worker_inbox(context, principal, message, attachment_source=None):
    expected_inbox = os.path.join(principal["workspace"], ".sandcodex", "work", "team-inbox")
    try:
        inbox_info = os.lstat(expected_inbox)
    except FileNotFoundError:
        return False
    if not stat.S_ISDIR(inbox_info.st_mode) or stat.S_ISLNK(inbox_info.st_mode):
        return False
    workspace = checked_workspace(context, principal)
    workspace_fd = os.open(
        workspace,
        os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
    )
    descriptors = [workspace_fd]
    try:
        for component, label in ((".sandcodex", "worker local state"), ("work", "worker state"),
                                 ("team-inbox", "worker team inbox")):
            child = open_owned_directory_at(descriptors[-1], component, label)
            if child is None:
                return False
            descriptors.append(child)
        inbox_fd = descriptors[-1]
        delivered = dict(message)
        if attachment_source is not None:
            attachment_fd = open_owned_directory_at(inbox_fd, "attachments", "worker attachment inbox", create=True)
            descriptors.append(attachment_fd)
            digest = message["attachment"]["sha256"]
            payload = read_trusted_attachment(attachment_source, "trusted team attachment")
            if hashlib.sha256(payload).hexdigest() != digest:
                fail("trusted team attachment digest changed before delivery")
            atomic_bytes_at(attachment_fd, digest, payload, "worker team attachment")
            worker_path = os.path.join(workspace, ".sandcodex", "work", "team-inbox", "attachments", digest)
            delivered["attachment"] = {**message["attachment"], "worker_path": worker_path}
        atomic_bytes_at(inbox_fd, message["message_id"] + ".json", json_bytes(delivered), "worker team message")
        return True
    finally:
        for descriptor in reversed(descriptors):
            os.close(descriptor)


def sync_worker_inbox(context, root, principal):
    acknowledgements = team_records(root, "message-acks.jsonl")
    acknowledged = {
        row.get("message_id") for row in acknowledgements if row.get("by") == principal["name"]
    }
    for message in team_records(root, "messages.jsonl"):
        if message.get("to") != principal["name"] or message.get("message_id") in acknowledged:
            continue
        attachment = message.get("attachment")
        source = os.path.join(root, "attachments", attachment["sha256"]) if attachment else None
        try:
            if not deliver_worker_inbox(context, principal, message, source):
                return False
        except (CampaignError, OSError):
            return False
    return True


def sc_attempt_message_nudge(send, *, ready, expected_errors=()):
    """Return ``(completed_or_none, content_free_observation)``.

    An exception after invocation gives an UNKNOWN controller outcome. Even a
    local timeout does not establish that a queued command was never accepted.
    ``controller_returned_success`` describes the existing control callback,
    not worker receipt, reading, execution or correctness of resulting work.

    The caller determines readiness under existing authority before calling.
    Only explicitly supplied exception classes are caught. Programming errors,
    cancellation, journal failures and authority checks outside send propagate.
    """
    if type(ready) is not bool:
        raise ValueError("nudge_readiness_must_be_boolean")
    if not callable(send):
        raise ValueError("nudge_send_must_be_callable")
    if not isinstance(expected_errors, tuple) or any(
        not isinstance(kind, type) or not issubclass(kind, Exception)
        or kind in (Exception, BaseException) for kind in expected_errors
    ):
        raise ValueError("nudge_expected_errors_must_be_specific_exception_types")
    observation = {
        "schema": "sandcodex.team-nudge-observation.v1",
        "status": "not_attempted",
        "attempted": False,
        "controller_returned_success": None,
        "worker_read_acknowledged": None,
        "worker_action_observed": None,
        "retry_performed": False,
        "error_category": None,
    }
    if not ready:
        return None, observation
    observation["attempted"] = True
    try:
        completed = send()
    except expected_errors:
        # Do not echo exception text, subprocess args/output, paths, prompts,
        # provider messages or dynamically chosen class names into evidence.
        observation["status"] = "unknown"
        observation["error_category"] = "controller_call_failed_or_timed_out"
        return None, observation
    # The existing run_control callback returns a zero-exit CompletedProcess.
    # Reusers must not turn an unchecked/absent callback result into success.
    returncode = getattr(completed, "returncode", None)
    if type(returncode) is not int or returncode != 0:
        observation["status"] = "unknown"
        observation["error_category"] = "controller_return_not_successful"
        return None, observation
    observation["status"] = "controller_returned_success"
    observation["controller_returned_success"] = True
    return completed, observation


def route_team_message(context, source_root, source_principal, to, text, reply_to=None, attachment_source=None):
    if len(text.encode()) > 16384 or not text.strip() or "\0" in text:
        fail("team message text is invalid")
    message_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + ":" + secrets.token_hex(10)
    attachment = store_team_attachment(source_root, attachment_source, source_principal["workspace"])
    message = {
        "schema": TEAM_MESSAGE_SCHEMA, "message_id": message_id,
        "campaign_id": source_principal["campaign_id"], "from": source_principal["name"],
        "to": to, "text": text, "reply_to": reply_to, "attachment": attachment,
        "created_at": now(),
    }
    append_team_record(os.path.join(source_root, "messages.jsonl"), message)
    if to != "foreman":
        target_root, target = find_campaign(context, to, source_principal.get("parent_run_id"))
        stored = os.path.join(source_root, "attachments", attachment["sha256"]) if attachment else None
        if target["campaign_id"] != source_principal["campaign_id"]:
            retain_team_attachment(target_root, attachment, stored)
            append_team_record(os.path.join(target_root, "messages.jsonl"), message)
        mailbox_delivered = sync_worker_inbox(context, target_root, target)
        control_ready = worker_control_ready(context, target)
        _completed, nudge = sc_attempt_message_nudge(
            lambda: run_control(context, target, "send", (
                f"Team message {message_id} from {source_principal['name']}: {text}\n"
                "Acknowledge or reply with sandcodex-team when useful."
            )), ready=control_ready,
            expected_errors=(CampaignError, OSError, subprocess.TimeoutExpired),
        )
        worker_nudged = nudge["controller_returned_success"] is True
    append_event(
        source_root, "team-message", message_id=message_id,
        sender=source_principal["name"], recipient=to,
        message_sha256=hashlib.sha256(text.encode()).hexdigest(),
        message_bytes=len(text.encode()), attachment_sha256=attachment["sha256"] if attachment else None,
        mailbox_delivered=mailbox_delivered if to != "foreman" else None,
        worker_nudged=worker_nudged if to != "foreman" else None,
        nudge=nudge if to != "foreman" else None,
    )
    return message


def foreman_team_message(context, root, principal, text, attachment_relative=None):
    message_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + ":" + secrets.token_hex(10)
    source = None
    if attachment_relative is not None:
        source = os.path.join(context["project"], attachment_relative)
    attachment = store_team_attachment(root, source, context["project"])
    message = {
        "schema": TEAM_MESSAGE_SCHEMA, "message_id": message_id,
        "campaign_id": principal["campaign_id"], "from": "foreman", "to": principal["name"],
        "text": text, "reply_to": None, "attachment": attachment, "created_at": now(),
    }
    append_team_record(os.path.join(root, "messages.jsonl"), message)
    stored = os.path.join(root, "attachments", attachment["sha256"]) if attachment else None
    mailbox_delivered = sync_worker_inbox(context, root, principal)
    # The journal append above already succeeded. A failed controller nudge
    # must not masquerade as rejection of that durable message or invite resend.
    # Readiness/authority checks stay outside the best-effort invocation boundary.
    control_ready = worker_control_ready(context, principal)
    completed, nudge = sc_attempt_message_nudge(
        lambda: run_control(context, principal, "send", (
            f"Team message {message_id} from foreman: {text}\n"
            "Acknowledge or reply with sandcodex-team when useful."
        )), ready=control_ready,
        expected_errors=(CampaignError, OSError, subprocess.TimeoutExpired),
    )
    worker_nudged = nudge["controller_returned_success"] is True
    delivery = {
        "schema": "sandcodex.team-message-delivery.v1",
        "journal_append_returned_success": True,
        "mailbox_delivery_reported": mailbox_delivered,
        "nudge": nudge,
    }
    append_event(
        root, "team-message", message_id=message_id, sender="foreman", recipient=principal["name"],
        message_sha256=hashlib.sha256(text.encode()).hexdigest(), message_bytes=len(text.encode()),
        attachment_sha256=attachment["sha256"] if attachment else None,
        mailbox_delivered=mailbox_delivered,
        worker_nudged=worker_nudged, nudge=nudge,
    )
    return message, completed, delivery


def harvest_worker_messages(context, root, principal):
    outbox = os.path.join(principal["workspace"], ".sandcodex", "work", "team-outbox")
    if not os.path.isdir(outbox) or os.path.islink(outbox):
        return
    for path in sorted(Path(outbox).glob("*.json"))[:128]:
        claimed = os.path.join(outbox, ".processing-" + path.name)
        try:
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1 or info.st_size > 32768:
                os.unlink(path)
                continue
            os.replace(path, claimed)
            value = load_json(claimed, "worker team message", 32768)
            if value.get("schema") != "sandcodex.team-worker-message.v1" or \
               value.get("campaign_id") != principal["campaign_id"] or \
               value.get("sender") != principal["name"] or \
               not ID_RE.fullmatch(str(value.get("id", ""))):
                fail("worker team message identity is invalid")
            action = value.get("action")
            if action == "ack":
                message_id = value.get("message_id")
                if not ID_RE.fullmatch(str(message_id or "")):
                    fail("worker team acknowledgement is invalid")
                matching = [
                    row for row in team_records(root, "messages.jsonl")
                    if row.get("message_id") == message_id and row.get("to") == principal["name"]
                ]
                if len(matching) != 1:
                    fail("worker team acknowledgement does not identify one delivered message")
                existing = {
                    (row.get("message_id"), row.get("by"))
                    for row in team_records(root, "message-acks.jsonl")
                }
                if (message_id, principal["name"]) not in existing:
                    append_team_record(os.path.join(root, "message-acks.jsonl"), {
                        "schema": TEAM_MESSAGE_SCHEMA, "message_id": message_id,
                        "by": principal["name"], "at": now(),
                    })
                    append_event(root, "team-message-acknowledged", message_id=message_id,
                                 by=principal["name"])
                # G009: mirror an explicitly repeated peer acknowledgement
                # even if its local ledger row already exists. Each destination
                # keeps its own append-once check; there is no automatic retry.
                message = matching[0]
                source_campaign = message.get("campaign_id")
                if message.get("from") != "foreman" and source_campaign != principal["campaign_id"]:
                    sources = [
                        (candidate_root, candidate)
                        for candidate_root, candidate in campaign_roots(context)
                        if candidate.get("parent_run_id") == principal.get("parent_run_id")
                        and candidate.get("campaign_id") == source_campaign
                    ]
                    if len(sources) != 1:
                        fail("worker team acknowledgement source is unavailable or ambiguous")
                    source_root, _source_principal = sources[0]
                    source_existing = {
                        (row.get("message_id"), row.get("by"))
                        for row in team_records(source_root, "message-acks.jsonl")
                    }
                    if (message_id, principal["name"]) not in source_existing:
                        append_team_record(os.path.join(source_root, "message-acks.jsonl"), {
                            "schema": TEAM_MESSAGE_SCHEMA, "message_id": message_id,
                            "by": principal["name"], "at": now(),
                        })
                        append_event(
                            source_root, "team-message-acknowledged",
                            message_id=message_id, by=principal["name"],
                        )
            elif action in {"message", "complete"}:
                to = value.get("to")
                text = value.get("message")
                reply_to = value.get("reply_to")
                attachment = value.get("attachment")
                if to != "foreman" and not NAME_RE.fullmatch(str(to or "")):
                    fail("worker team recipient is invalid")
                if action == "complete" and to != "foreman":
                    fail("worker completion may address only the foreman")
                if reply_to is not None and not ID_RE.fullmatch(str(reply_to)):
                    fail("worker team reply identity is invalid")
                source = None
                if attachment is not None:
                    if not isinstance(attachment, str):
                        fail("worker team attachment is invalid")
                    source = attachment
                message = route_team_message(context, root, principal, to, text, reply_to, source)
                if action == "complete":
                    principal["completion_requested"] = True
                    principal["completion_requested_at"] = message["created_at"]
                    principal["completion_message_id"] = message["message_id"]
                    save_principal(root, principal)
                    append_event(
                        root, "worker-completion-requested",
                        message_id=message["message_id"],
                    )
                    if worker_control_ready(context, principal):
                        try:
                            run_control(context, principal, "stop")
                        except (CampaignError, OSError) as error:
                            append_event(
                                root, "worker-completion-stop-pending",
                                error=type(error).__name__,
                            )
            else:
                fail("worker team outbox action is invalid")
        except (CampaignError, OSError) as error:
            append_event(root, "team-message-rejected", error=type(error).__name__)
        finally:
            try:
                os.unlink(claimed)
            except FileNotFoundError:
                pass


def lifecycle_state(status):
    if status in BLOCKED:
        return "blocked"
    if status in {"requested", "accepted", "queued", "preparing"}:
        return "starting"
    if status in {"running", "waiting_quota", "waiting_transient"}:
        return "running"
    if status == "paused":
        return "paused"
    if status == "draining":
        return "draining"
    if status in {"drained", "interrupted"}:
        return "stopped"
    if status == "completed":
        return "completed"
    if status in {"stale", "guarded"}:
        return "recovery_required"
    if status == "storage_hold":
        return "storage_hold"
    return "failed"


def status_result(context, root, principal):
    principal, state = refresh(context, root, principal)
    head_commit = None
    if os.path.isdir(principal["workspace"]):
        head = git(context, ["rev-parse", "--verify", "HEAD^{commit}"], cwd=principal["workspace"], check=False)
        head_commit = head.stdout.strip() if head.returncode == 0 else None
    mailbox = team_mailbox_summary(root, principal["name"])
    return {
        "schema": CAMPAIGN_SCHEMA,
        "campaign_id": principal["campaign_id"],
        "name": principal["name"],
        "status": principal["status"],
        "lifecycle_state": lifecycle_state(principal["status"]),
        "worker_status": state.get("status") if state else None,
        "base_commit": principal["base_commit"],
        "source_worktree": principal.get("source_worktree", {
            "mode": "legacy", "base_policy": "committed-base",
            "dirty_paths_observed": 0, "dirty_paths_included": 0,
            "dirty_paths_excluded": 0,
        }),
        "head_commit": head_commit,
        "verification": campaign_verification_state(root, principal, head_commit),
