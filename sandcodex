+        int32_t wheel_clicks, uint32_t wheel_step) {
+    struct wlr_tablet_v2_tablet_tool *tool = sandcodex_stylus.tool_v2;
+    if (!sx || !sy || !sandcodex_stylus_hover_shape_valid(0, 0, 0, 0,
+            steps, tilt_x_degrees, tilt_y_degrees, rotation_present,
+            rotation_start_degrees, rotation_delta_degrees, slider_present,
