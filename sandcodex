def fail(message: str) -> None:
    raise SystemExit(f"invalid project browser descriptor: {message}")

def private_regular(path: Path, label: str) -> os.stat_result:
    try:
        opened = path.lstat()
    except OSError as error:
        fail(f"{label} could not be inspected: {error}")
    if (
        not stat.S_ISREG(opened.st_mode)
        or opened.st_uid != os.geteuid()
        or opened.st_nlink != 1
