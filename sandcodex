+static bool sandcodex_stylus_hover_state_exact(struct ipc_client *client,
+        struct sway_seat *seat, struct wlr_surface *surface,
+        struct wl_client *target_client,
+        struct wlr_tablet_v2_tablet_tool *tool,
+        struct wlr_tablet_tool_client_v2 *tool_client,
+        uintptr_t expected_pointer_grab_address,
+        uintptr_t expected_pointer_default_grab_address,
+        uintptr_t expected_pointer_client_address) {
+    return sandcodex_stylus_live_route_exact(client, seat, surface,
+            target_client, tool, tool_client, expected_pointer_grab_address,
+            expected_pointer_default_grab_address,
+            expected_pointer_client_address) &&
+        tool->grab == &tool->default_grab && !tool->is_down &&
+        tool->num_buttons == 0 &&
+        !wlr_tablet_tool_v2_has_implicit_grab(tool) &&
+        sandcodex_stylus_peer_tool_idle(SANDCODEX_STYLUS_TOOL_PEN);
+}
+
+static void sandcodex_stylus_hover_deescalate(
+        struct wlr_tablet_v2_tablet_tool *tool) {
+    if (!tool) {
+        return;
+    }
+    /* Normal hover failure has only proximity state to clear. Avoid creating
+     * a pressure event merely to leave proximity. If unrelated state somehow
+     * escalated during the callback, use the general fail-safe release path. */
+    if (tool->is_down || tool->num_buttons != 0 ||
+            wlr_tablet_tool_v2_has_implicit_grab(tool)) {
+        sandcodex_stylus_deescalate(tool);
+        return;
+    }
+    if (tool->focused_surface || tool->current_client) {
+        wlr_tablet_v2_tablet_tool_notify_proximity_out(tool);
+    }
+}
