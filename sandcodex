  SC_BROWSER_PROJECT_MATCHES_BUNDLE=0
  SC_BROWSER_BUNDLE_EXTENSION="$saved_bundle_extension"
  SC_BROWSER_BUNDLE_EXTENSION_ID="$saved_bundle_id"
