    def _safe_cwd(self, value: Any) -> Path:
        if value is None:
            return self.project
        raw = as_string(value, "cwd", maximum=4096, allow_empty=False)
        candidate = Path(raw)
        if not candidate.is_absolute():
            candidate = self.project / candidate
        try:
            resolved = candidate.resolve(strict=True)
        except OSError as error:
            raise ToolError(f"cwd does not exist: {raw}") from error
        if not resolved.is_dir() or os.path.commonpath((str(self.project), str(resolved))) != str(self.project):
            raise ToolError("cwd must be a directory inside the selected project")
        return resolved

    def _prepare_launch_output(self, launch_id: str) -> tuple[str, Path]:
        """Create one persistent artifact directory that no peer app can mount.

        The desktop controller owns the shared output root. Application capsules
        receive only ``apps/<launch-id>``; the parent and sibling launch trees are
        never projected into their mount namespace.
        """
        relative = f"apps/{launch_id}"
        parent = self.output / "apps"
        target = parent / launch_id
        for path, label in ((parent, "application output root"), (target, "launch output directory")):
            try:
                path.mkdir(mode=0o700)
            except FileExistsError:
                pass
            try:
                info = path.lstat()
            except OSError as error:
                raise ToolError(f"{label} is unavailable") from error
            if (
                not stat.S_ISDIR(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700
            ):
                raise ToolError(f"{label} is unsafe")
        return relative, target

    def _prepare_launch_drop(self, launch_id: str) -> tuple[str, Path]:
        """Create one controller-owned read-only projection root for file DnD.

        The application launcher mounts only this exact launch directory at
        ``/run/sandcodex-app/drop`` and remounts it read-only.  Peer launch
        roots and the controller-side parent never enter the capsule.
        """
        if re.fullmatch(r"launch-[0-9a-f]{24}", launch_id) is None:
            raise ToolError("launch file-drop identity is invalid")
        parent = self.drop_root
        if parent is None:
            raise ToolError("controller-private FileDropSeal storage is unavailable")
        relative = f"drop/{launch_id}"
        target = parent / launch_id
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise ToolError("descriptor-relative no-follow FileDropSeal storage is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        parent_fd = os.open(parent, directory_flags)
        created = False
        try:
            parent_info = os.fstat(parent_fd)
            if (
                not stat.S_ISDIR(parent_info.st_mode)
                or parent_info.st_uid != os.geteuid()
                or stat.S_IMODE(parent_info.st_mode) != 0o700
            ):
                raise ToolError("controller-private FileDropSeal root is unsafe")
            try:
                os.mkdir(launch_id, 0o700, dir_fd=parent_fd)
                created = True
            except FileExistsError as error:
                raise ToolError("launch file-drop root already exists") from error
            launch_fd = os.open(launch_id, directory_flags, dir_fd=parent_fd)
            try:
                launch_info = os.fstat(launch_fd)
                if (
                    not stat.S_ISDIR(launch_info.st_mode)
                    or launch_info.st_uid != os.geteuid()
                    or stat.S_IMODE(launch_info.st_mode) != 0o700
                    or os.listdir(launch_fd)
                ):
                    raise ToolError("launch file-drop root was not freshly empty")
                with contextlib.suppress(OSError):
                    os.fsync(launch_fd)
            finally:
                os.close(launch_fd)
            with contextlib.suppress(OSError):
                os.fsync(parent_fd)
            return relative, target
        except Exception:
            if created:
                with contextlib.suppress(OSError):
                    os.rmdir(launch_id, dir_fd=parent_fd)
            raise
        finally:
            os.close(parent_fd)

    def _cleanup_launch_drop(self, managed: ManagedProcess) -> None:
        relative = managed.drop_subdirectory
        if relative is None:
            return
        expected = f"drop/{managed.launch_id}"
        if relative != expected:
            raise RuntimeError("managed file-drop root identity is inconsistent")
        parent = self.drop_root
        if parent is None:
            raise RuntimeError("controller-private FileDropSeal storage disappeared")
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise RuntimeError("descriptor-relative no-follow FileDropSeal cleanup is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        parent_fd = os.open(parent, directory_flags)
        try:
            parent_info = os.fstat(parent_fd)
            if (
                not stat.S_ISDIR(parent_info.st_mode)
                or parent_info.st_uid != os.geteuid()
                or stat.S_IMODE(parent_info.st_mode) != 0o700
            ):
                raise RuntimeError("controller-private FileDropSeal root became unsafe")
            self._remove_file_drop_tree(
                parent_fd,
                managed.launch_id,
                identity="launch",
            )
        finally:
            os.close(parent_fd)
        # Clear accounting only after the exact private root has been proven
        # absent. A failed cleanup remains visible and retryable instead of
        # silently orphaning retained snapshots.
        managed.drop_subdirectory = None
        managed.drop_snapshot_bytes = 0
        managed.drop_transaction_count = 0

    def launch(self, arguments: dict[str, Any]) -> dict[str, Any]:
        argv = arguments.get("argv")
        if not isinstance(argv, list) or not argv or len(argv) > MAX_ARGV_ITEMS:
            raise ToolError("argv must be a non-empty bounded string array")
        normalized: list[str] = []
        argv_bytes = 0
        for index, item in enumerate(argv):
            value = as_string(item, f"argv[{index}]", maximum=MAX_ARG_BYTES, allow_empty=False)
            normalized.append(value)
            argv_bytes += len(value.encode("utf-8")) + 1
        if argv_bytes > MAX_ARGV_BYTES:
            raise ToolError("argv exceeds the aggregate byte limit")
        self._reap_processes()
        if len(self.processes) >= MAX_MANAGED_PROCESSES:
            raise ToolError("the managed desktop process limit has been reached")
        cwd = self._safe_cwd(arguments.get("cwd"))
        application_id = self._application_id(arguments.get("application_id"), normalized)
        scene_id = self._scene_id(arguments.get("scene_id"))
        if scene_id is not None and self.app_launcher is not None:
            live_scene_members = sum(
                1
                for managed in self.processes.values()
                if managed.scene_id == scene_id and self._refresh_managed(managed) > 0
            )
            if live_scene_members >= SCENE_SET_MAX_LAUNCHES:
                raise ToolError(
                    f"scene_id already owns the maximum of {SCENE_SET_MAX_LAUNCHES} live launches"
                )

        additions = arguments.get("env", {})
        if not isinstance(additions, dict) or len(additions) > MAX_ENV_ITEMS:
            raise ToolError("env must be a bounded string map")
        reserved = {
            "HOME", "PATH", "SHELL", "USER", "LOGNAME", "DISPLAY", "XAUTHORITY",
            "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "AT_SPI_BUS_ADDRESS",
            "NODE_USE_ENV_PROXY",
            "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
            "http_proxy", "https_proxy", "all_proxy", "no_proxy",
            "LD_PRELOAD", "LD_LIBRARY_PATH", "GDK_BACKEND", "QT_QPA_PLATFORM",
            "SDL_VIDEODRIVER", "ELECTRON_OZONE_PLATFORM_HINT", "_JAVA_AWT_WM_NONREPARENTING",
            "GTK_USE_PORTAL", "GIO_USE_PORTALS",
        }
        normalized_additions: dict[str, str] = {}
        environment_bytes = 0
        for key, value in additions.items():
            if not isinstance(key, str) or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,127}", key) is None:
                raise ToolError("env contains an invalid name")
            if key.startswith("SANDCODEX_") or key.startswith("XDG_") or key in reserved:
                raise ToolError(f"env.{key} cannot override the isolated desktop boundary")
            normalized_value = as_string(value, f"env.{key}", maximum=MAX_ARG_BYTES)
            environment_bytes += len(key.encode("utf-8")) + len(normalized_value.encode("utf-8")) + 2
            normalized_additions[key] = normalized_value
        if environment_bytes > MAX_ENV_BYTES:
            raise ToolError("env exceeds the aggregate byte limit")

        environment = {
            key: value
            for key, value in os.environ.items()
            if key in {
                "PATH", "HOME", "USER", "LOGNAME", "SHELL", "TERM", "LANG", "LC_ALL",
                "DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "XDG_CONFIG_HOME", "XDG_CACHE_HOME",
                "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
                "AT_SPI_BUS_ADDRESS", "SANDCODEX_PROJECT", "SANDCODEX_DESKTOP_OUTPUT",
                "SANDCODEX_DESKTOP_BACKEND", "GI_TYPELIB_PATH", "NODE_USE_ENV_PROXY",
                "HTTP_PROXY", "HTTPS_PROXY",
                "ALL_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "all_proxy", "no_proxy",
                "SSL_CERT_FILE", "NIX_SSL_CERT_FILE", "SANDCODEX_APP_BWRAP",
                "SANDCODEX_APP_PROJECT", "SANDCODEX_APP_HOME_ROOT", "SANDCODEX_APP_OUTPUT",
                "SANDCODEX_APP_PATH", "SANDCODEX_APP_DBUS_SOCKET",
                "SANDCODEX_APP_BASH", "SANDCODEX_APP_SOCAT", "SANDCODEX_APP_PROXY_SOCKET",
                "SANDCODEX_APP_DBUS_DAEMON", "SANDCODEX_APP_XWAYLAND_SATELLITE",
                "SANDCODEX_APP_XAUTH", "SANDCODEX_APP_MCOOKIE",
                "SANDCODEX_APP_PYTHON", "SANDCODEX_APP_PORTAL_HELPER",
                "SANDCODEX_APP_NOTIFICATION_HELPER", "SANDCODEX_APP_STATUS_NOTIFIER_HELPER",
            }
        }
        context: AppWaylandContext | None = None
        workspace: str | None = None
        output_subdirectory: str | None = None
        output_directory: Path | None = None
        drop_subdirectory: str | None = None
        drop_directory: Path | None = None
        open_uri_schemes: tuple[str, ...] = ()
        open_uri_policy_transport = ""
        open_uri_handler_sha256: str | None = None
        open_uri_policy_sha256: str | None = None
        open_file_access: str | None = None
        open_file_readonly_maximum_bytes: int | None = None
        open_file_policy_transport = ""
        open_file_handler_sha256: str | None = None
        open_file_policy_sha256: str | None = None
        open_directory_policy_transport = ""
        open_directory_handler_sha256: str | None = None
        open_directory_policy_sha256: str | None = None
        if self.app_launcher is not None:
            project_access = arguments.get("project_access", "readonly")
            network_access = arguments.get("network_access", "none")
            display_access = arguments.get("display_access", "wayland")
            session_bus_access = arguments.get("session_bus_access", "private")
            notification_access = arguments.get("notification_access", "none")
            status_notifier_access = arguments.get("status_notifier_access", "none")
            notification_surface_token: str | None = None
            notification_surface_app_id: str | None = None
            notification_surface_read_fd: int | None = None
            status_surface_token: str | None = None
            status_surface_app_id: str | None = None
            status_surface_read_fd: int | None = None
            open_uri_handler = arguments.get("open_uri_handler")
            open_uri_schemes_value = arguments.get("open_uri_schemes")
            open_file_handler = arguments.get("open_file_handler")
            open_file_access_value = arguments.get("open_file_access")
            open_file_readonly_maximum_bytes_value = arguments.get(
                "open_file_readonly_maximum_bytes"
            )
            open_directory_handler = arguments.get("open_directory_handler")
            default_portal_features: list[str] = []
            if session_bus_access == "private":
                default_portal_features.append("file-chooser")
                if open_uri_handler is not None:
                    default_portal_features.append("open-uri")
                if open_file_handler is not None:
                    default_portal_features.append("open-file")
                if open_directory_handler is not None:
                    default_portal_features.append("open-directory")
            portal_access = arguments.get(
                "portal_access",
                "+".join(default_portal_features) if default_portal_features else "none",
            )
            if project_access not in {"readonly", "readwrite"}:
                raise ToolError("project_access must be readonly or readwrite")
            if network_access not in {"none", "inherit"}:
                raise ToolError("network_access must be none or inherit")
            if display_access not in {"wayland", "wayland+x11"}:
                raise ToolError("display_access must be wayland or wayland+x11")
            if session_bus_access not in {"none", "private", "inherit"}:
                raise ToolError("session_bus_access must be none, private, or inherit")
            if notification_access not in NOTIFICATION_ACCESS_VALUES:
                raise ToolError("notification_access must be none or private")
            if status_notifier_access not in STATUS_NOTIFIER_ACCESS_VALUES:
                raise ToolError("status_notifier_access must be none or private")
            if portal_access not in PORTAL_ACCESS_VALUES:
                raise ToolError(
                    "portal_access must be a canonical combination of file-chooser, open-uri, "
                    "open-file, and open-directory"
                )
            portal_features = set() if portal_access == "none" else set(portal_access.split("+"))
            portal_open_uri = "open-uri" in portal_features
            portal_open_file = "open-file" in portal_features
            portal_open_directory = "open-directory" in portal_features
            if portal_access != "none" and session_bus_access != "private":
                raise ToolError("desktop portal access requires a launch-private session bus")
            if notification_access == "private" and session_bus_access != "private":
                raise ToolError("private notification access requires a launch-private session bus")
            if status_notifier_access == "private" and session_bus_access != "private":
                raise ToolError("private status notifier access requires a launch-private session bus")
            if portal_open_uri:
                if open_uri_handler is None:
                    raise ToolError("OpenURI portal access requires open_uri_handler")
                (
                    open_uri_schemes,
                    open_uri_policy_transport,
                    open_uri_handler_sha256,
                    open_uri_policy_sha256,
                ) = normalize_open_uri_policy(open_uri_handler, open_uri_schemes_value)
            elif open_uri_handler is not None or open_uri_schemes_value is not None:
                raise ToolError(
                    "open_uri_handler and open_uri_schemes require open-uri portal access"
                )
            if portal_open_file:
                if open_file_handler is None:
                    raise ToolError("OpenFile portal access requires open_file_handler")
                (
                    open_file_access,
                    open_file_readonly_maximum_bytes,
                    open_file_policy_transport,
                    open_file_handler_sha256,
                    open_file_policy_sha256,
                ) = normalize_open_file_policy(
                    open_file_handler,
                    open_file_access_value,
                    open_file_readonly_maximum_bytes_value,
                )
            elif (
                open_file_handler is not None
                or open_file_access_value is not None
                or open_file_readonly_maximum_bytes_value is not None
            ):
                raise ToolError(
                    "open_file_handler, open_file_access, and "
                    "open_file_readonly_maximum_bytes require open-file portal access"
                )
            if portal_open_directory:
                if open_directory_handler is None:
                    raise ToolError(
                        "OpenDirectory portal access requires open_directory_handler"
                    )
                (
                    open_directory_policy_transport,
                    open_directory_handler_sha256,
                    open_directory_policy_sha256,
                ) = normalize_open_directory_policy(open_directory_handler)
            elif open_directory_handler is not None:
                raise ToolError(
                    "open_directory_handler requires open-directory portal access"
                )
            if portal_access != "none":
                required_portal_helpers = {
                    "SANDCODEX_APP_PYTHON": "python3",
                    "SANDCODEX_APP_PORTAL_HELPER": "private-file-portal.py",
                }
                for variable, executable in required_portal_helpers.items():
                    value = environment.get(variable, "")
                    if variable == "SANDCODEX_APP_PYTHON":
                        valid = value.startswith("/nix/store/") and value.endswith(f"/bin/{executable}")
                    else:
                        valid = value.startswith("/run/sandcodex-desktop/launch/") and value.endswith(executable)
                    if not valid:
                        raise ToolError(
                            f"desktop portal access was requested but {executable} is unavailable"
                        )
            if notification_access == "private":
                required_notification_helpers = {
                    "SANDCODEX_APP_PYTHON": "python3",
                    "SANDCODEX_APP_NOTIFICATION_HELPER": "private-notification-service.py",
                }
                for variable, executable in required_notification_helpers.items():
                    value = environment.get(variable, "")
                    if variable == "SANDCODEX_APP_PYTHON":
                        valid = value.startswith("/nix/store/") and value.endswith(f"/bin/{executable}")
                    else:
                        valid = value.startswith("/run/sandcodex-desktop/launch/") and value.endswith(executable)
                    if not valid:
                        raise ToolError(
                            f"private notification access was requested but {executable} is unavailable"
                        )
            if status_notifier_access == "private":
                required_status_helpers = {
                    "SANDCODEX_APP_PYTHON": "python3",
                    "SANDCODEX_APP_STATUS_NOTIFIER_HELPER": "private-status-notifier-service.py",
                }
                for variable, executable in required_status_helpers.items():
                    value = environment.get(variable, "")
                    if variable == "SANDCODEX_APP_PYTHON":
                        valid = value.startswith("/nix/store/") and value.endswith(f"/bin/{executable}")
                    else:
                        valid = value.startswith("/run/sandcodex-desktop/launch/") and value.endswith(executable)
                    if not valid:
                        raise ToolError(
                            f"private status notifier access was requested but {executable} is unavailable"
                        )
            if display_access == "wayland+x11":
                required_x11_helpers = {
                    "SANDCODEX_APP_XWAYLAND_SATELLITE": "xwayland-satellite",
                    "SANDCODEX_APP_XAUTH": "xauth",
                    "SANDCODEX_APP_MCOOKIE": "mcookie",
                }
                for variable, executable in required_x11_helpers.items():
                    value = environment.get(variable, "")
                    if not value or not value.startswith("/nix/store/") or not value.endswith(f"/bin/{executable}"):
                        raise ToolError(f"wayland+x11 was requested but {executable} is unavailable")
            context = self._prepare_app_context(application_id)
            launch_id = context.instance_id
            workspace = self._register_launch_workspace(
                application_id,
                launch_id,
                self._scene_workspace_name(scene_id) if scene_id is not None else None,
            )
            output_subdirectory, output_directory = self._prepare_launch_output(launch_id)
            drop_subdirectory, drop_directory = self._prepare_launch_drop(launch_id)
            environment.update({
                "SANDCODEX_APP_WAYLAND_SOCKET": str(context.socket),
                "SANDCODEX_APP_WAYLAND_DISPLAY": "wayland-0",
                "SANDCODEX_APP_ATSPI_SOCKET": str(context.atspi_socket),
                "SANDCODEX_APP_LAUNCH_ID": launch_id,
                "SANDCODEX_APP_APPLICATION_ID": application_id,
                "SANDCODEX_APP_OUTPUT_SCOPE": str(output_directory),
                "SANDCODEX_APP_DROP_ROOT": str(self.drop_root),
                "SANDCODEX_APP_DROP_SCOPE": str(drop_directory),
            })
            if scene_id is not None:
                environment["SANDCODEX_APP_SCENE_ID"] = scene_id
            launch_argv = [
                str(self.app_launcher), "--cwd", str(cwd),
                "--project-access", project_access,
                "--network-access", network_access,
                "--display-access", display_access,
                "--session-bus-access", session_bus_access,
                "--portal-access", portal_access,
                "--notification-access", notification_access,
                "--status-notifier-access", status_notifier_access,
            ]
            if open_uri_policy_transport:
                assert open_uri_policy_sha256 is not None
                launch_argv.extend([
                    "--open-uri-policy", open_uri_policy_transport,
                    "--open-uri-policy-sha256", open_uri_policy_sha256,
                ])
            if open_file_policy_transport:
                assert open_file_policy_sha256 is not None
                launch_argv.extend([
                    "--open-file-policy", open_file_policy_transport,
                    "--open-file-policy-sha256", open_file_policy_sha256,
                ])
            if open_directory_policy_transport:
                assert open_directory_policy_sha256 is not None
                launch_argv.extend([
                    "--open-directory-policy", open_directory_policy_transport,
                    "--open-directory-policy-sha256", open_directory_policy_sha256,
                ])
            for key, value in sorted(normalized_additions.items()):
                launch_argv.extend(["--env", f"{key}={value}"])
            launch_argv.extend(["--", *normalized])
        else:
            explicit_grants = {
                "project_access", "network_access", "display_access",
                "session_bus_access", "portal_access", "notification_access", "status_notifier_access", "open_uri_handler",
                "open_uri_schemes", "open_file_handler", "open_file_access",
                "open_file_readonly_maximum_bytes", "open_directory_handler", "scene_id",
            } & set(arguments)
            if explicit_grants:
                raise ToolError("application capability grants require the private Wayland application boundary")
            project_access = "readwrite"
            network_access = "inherit"
            display_access = "x11"
            session_bus_access = "inherit"
            portal_access = "none"
            notification_access = "none"
            notification_surface_token = None
            notification_surface_app_id = None
            notification_surface_read_fd = None
            status_notifier_access = "none"
            status_surface_token = None
            status_surface_app_id = None
            status_surface_read_fd = None
            launch_id = "legacy-" + secrets.token_hex(12)
            launch_argv = normalized
            # Compatibility/X11 has no trusted nested app launcher, so additions
            # necessarily apply to the launched command environment directly.
            environment.update(normalized_additions)

        process: subprocess.Popen[bytes] | None = None
        try:
            # Mint and stage the private notification surface capability only
            # after every fallible context/workspace/output/drop preparation
            # step has completed. A failed launch must not retain an unread
            # capability pipe in the long-lived controller process.
            if notification_access == "private":
                notification_surface_token = secrets.token_hex(
                    PRIVATE_NOTIFICATION_SURFACE_TOKEN_BYTES
                )
                if (
                    len(notification_surface_token)
                    != PRIVATE_NOTIFICATION_SURFACE_TOKEN_LENGTH
                    or re.fullmatch(r"[0-9a-f]+", notification_surface_token) is None
                ):
                    raise ToolError("private notification surface capability generation failed")
                notification_surface_app_id = (
                    PRIVATE_NOTIFICATION_APP_ID_PREFIX + notification_surface_token
                )
                notification_surface_read_fd, notification_surface_write_fd = os.pipe2(
                    os.O_CLOEXEC
                )
                try:
                    try:
                        payload = memoryview(
                            (notification_surface_token + "\n").encode("ascii")
                        )
                        while payload:
                            written = os.write(notification_surface_write_fd, payload)
                            if written <= 0:
                                raise ToolError(
                                    "private notification surface capability pipe failed"
                                )
                            payload = payload[written:]
                    finally:
                        os.close(notification_surface_write_fd)
                except Exception as error:
                    with contextlib.suppress(OSError):
                        os.close(notification_surface_read_fd)
                    notification_surface_read_fd = None
                    if isinstance(error, OSError):
                        raise ToolError(
                            "private notification surface capability pipe failed"
                        ) from error
                    raise
                environment["SANDCODEX_APP_NOTIFICATION_SURFACE_FD"] = str(
                    notification_surface_read_fd
                )
            if status_notifier_access == "private":
                try:
                    status_surface_token = secrets.token_hex(PRIVATE_STATUS_SURFACE_TOKEN_BYTES)
                    if (
                        len(status_surface_token) != PRIVATE_STATUS_SURFACE_TOKEN_LENGTH
                        or re.fullmatch(r"[0-9a-f]+", status_surface_token) is None
                    ):
                        raise ToolError("private status surface capability generation failed")
                    status_surface_app_id = PRIVATE_STATUS_APP_ID_PREFIX + status_surface_token
                    status_surface_read_fd, status_surface_write_fd = os.pipe2(os.O_CLOEXEC)
                    try:
                        payload = memoryview((status_surface_token + "\n").encode("ascii"))
                        while payload:
                            written = os.write(status_surface_write_fd, payload)
                            if written <= 0:
                                raise ToolError("private status surface capability pipe failed")
                            payload = payload[written:]
                    finally:
                        os.close(status_surface_write_fd)
                    environment["SANDCODEX_APP_STATUS_SURFACE_FD"] = str(status_surface_read_fd)
                except Exception as error:
                    if status_surface_read_fd is not None:
                        with contextlib.suppress(OSError):
                            os.close(status_surface_read_fd)
                        status_surface_read_fd = None
                    if notification_surface_read_fd is not None:
                        with contextlib.suppress(OSError):
                            os.close(notification_surface_read_fd)
                        notification_surface_read_fd = None
                    environment.pop("SANDCODEX_APP_STATUS_SURFACE_FD", None)
                    environment.pop("SANDCODEX_APP_NOTIFICATION_SURFACE_FD", None)
                    if isinstance(error, OSError):
                        raise ToolError(
                            "private status surface capability pipe failed"
                        ) from error
                    raise
            try:
                process = subprocess.Popen(
                    launch_argv,
                    cwd=cwd,
                    env=environment,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                    close_fds=True,
                    pass_fds=tuple(
                        descriptor
                        for descriptor in (
                            notification_surface_read_fd,
                            status_surface_read_fd,
                        )
                        if descriptor is not None
                    ),
                )
            finally:
                environment.pop("SANDCODEX_APP_NOTIFICATION_SURFACE_FD", None)
                environment.pop("SANDCODEX_APP_STATUS_SURFACE_FD", None)
                notification_surface_token = None
                status_surface_token = None
                if notification_surface_read_fd is not None:
                    os.close(notification_surface_read_fd)
                    notification_surface_read_fd = None
                if status_surface_read_fd is not None:
                    os.close(status_surface_read_fd)
                    status_surface_read_fd = None
            identity = None
            for _ in range(80):
                identity = proc_identity(process.pid)
                if identity is not None:
                    break
                if process.poll() is not None:
                    break
                time.sleep(0.0025)
            if identity is None:
                raise ToolError("launched desktop process exited before custody was established")
            managed = ManagedProcess(
                process=process,
                argv=normalized,
                cwd=str(cwd),
                started_at=utc_now(),
                leader_start_ticks=int(identity["start_ticks"]),
                launch_id=launch_id,
                application_id=application_id,
                project_access=project_access,
                network_access=network_access,
                display_access=display_access,
                session_bus_access=session_bus_access,
                portal_access=portal_access,
                notification_access=notification_access,
                notification_surface_app_id=notification_surface_app_id,
                status_notifier_access=status_notifier_access,
                status_surface_app_id=status_surface_app_id,
                open_uri_schemes=open_uri_schemes,
                open_uri_handler_sha256=open_uri_handler_sha256,
                open_uri_policy_sha256=open_uri_policy_sha256,
                open_file_access=open_file_access,
                open_file_readonly_maximum_bytes=open_file_readonly_maximum_bytes,
                open_file_handler_sha256=open_file_handler_sha256,
                open_file_policy_sha256=open_file_policy_sha256,
                open_directory_handler_sha256=open_directory_handler_sha256,
                open_directory_policy_sha256=open_directory_policy_sha256,
                scene_id=scene_id,
                workspace=workspace,
                output_subdirectory=output_subdirectory,
                drop_subdirectory=drop_subdirectory,
                members={process.pid: int(identity["start_ticks"])},
                session_ids={int(identity["session"])},
                security_context=context,
            )
            self.processes[process.pid] = managed
            self._refresh_managed(managed)
            self.write_status("ready")
            return json_result({
                "launched": True,
                "pid": process.pid,
                "launch_id": launch_id,
                "application_id": application_id,
                "scene_id": scene_id,
                "workspace": workspace,
                "output_subdirectory": output_subdirectory,
                "drop_subdirectory": drop_subdirectory,
                "argv": normalized,
                "cwd": str(cwd),
                "application_boundary": self.app_launcher is not None,
                "grants": self._grants(managed),
                "wayland_security_context": {
                    "per_launch": context is not None,
                    "sandbox_engine": SANDBOX_ENGINE if context is not None else None,
                    "sandbox_app_id": context.app_id if context is not None else None,
                    "sandbox_instance_id": context.instance_id if context is not None else None,
                    "capability_probe": context.capability_probe if context is not None else None,
                },
                "accessibility_bus": None if context is None else {
                    "per_launch": True,
                    "filter": "registry-registration-only",
                    "policy_sha256": context.atspi_policy_sha256,
                    "proxy_pid": context.atspi_process.pid,
                    "proxy_start_ticks": context.atspi_start_ticks,
                },
            })
        except Exception:
            if process is not None:
                with contextlib.suppress(ProcessLookupError):
                    process.kill()
                with contextlib.suppress(Exception):
                    process.wait(timeout=1)
            if context is not None:
                self._stop_app_context(context)
            if output_directory is not None:
                with contextlib.suppress(OSError):
                    output_directory.rmdir()
                with contextlib.suppress(OSError):
                    output_directory.parent.rmdir()
            if drop_directory is not None:
                with contextlib.suppress(OSError):
                    drop_directory.rmdir()
            raise

    def _refresh_managed(self, managed: ManagedProcess) -> int:
        """Refresh one launch's exact process tree without trusting one session forever.

        Bubblewrap's ``--new-session`` and ordinary GUI runtimes may call
        ``setsid(2)`` below the launch leader.  A scan keyed only to the
        original SID therefore misses legitimate descendants and can leave a
        daemonized process outside later termination.  Keep every admitted PID
        birth-pinned, discover children by exact parent ancestry, and retain
        each newly-created session as an additional launch-owned principal.
        Session membership remains useful after a parent exits because an
        outside process cannot join an existing session.
        """
        leader_pid = managed.process.pid
        leader = proc_identity(leader_pid)
        leader_alive = (
            leader is not None
            and int(leader["start_ticks"]) == managed.leader_start_ticks
            and leader["state"] != "Z"
        )
        if not leader_alive:
            managed.admitting = False

        identities: dict[int, dict[str, Any]] = {}
        with contextlib.suppress(FileNotFoundError, PermissionError, OSError):
            for entry in Path("/proc").iterdir():
                if not entry.name.isdigit():
                    continue
                identity = proc_identity(int(entry.name))
                if identity is None or identity["state"] == "Z":
                    continue
                identities[int(identity["pid"])] = identity

        # Drop recycled or exited identities before using the member map as an
        # ancestry authority.  This prevents a reused PID from admitting an
        # unrelated child.
        for pid, start_ticks in list(managed.members.items()):
            identity = identities.get(pid)
            if identity is None or int(identity["start_ticks"]) != start_ticks:
                managed.members.pop(pid, None)

        if leader_alive and leader is not None:
            managed.members[leader_pid] = managed.leader_start_ticks

        # Existing members seed their current sessions.  This also upgrades
        # state created by older revisions or deterministic tests which do not
        # populate session_ids explicitly.
        for pid, start_ticks in list(managed.members.items()):
            identity = identities.get(pid)
            if identity is not None and int(identity["start_ticks"]) == start_ticks:
                managed.session_ids.add(int(identity["session"]))

        # Reach a fixed point because /proc enumeration order is unrelated to
        # ancestry.  A newly admitted setsid() child contributes another SID,
        # and all of that session's processes then become discoverable even if
        # their immediate parent exits between custody passes.
        changed = True
        while changed:
            changed = False
            owned_pids = set(managed.members)
            owned_sessions = set(managed.session_ids)
            for pid, identity in identities.items():
                start_ticks = int(identity["start_ticks"])
                if managed.members.get(pid) == start_ticks:
                    continue
                if int(identity["ppid"]) not in owned_pids and int(identity["session"]) not in owned_sessions:
                    continue
                managed.members[pid] = start_ticks
                managed.session_ids.add(int(identity["session"]))
                changed = True

        represented_sessions = {
            int(identities[pid]["session"])
            for pid, start_ticks in managed.members.items()
            if pid in identities and int(identities[pid]["start_ticks"]) == start_ticks
        }
        managed.session_ids.intersection_update(represented_sessions)

        context = managed.security_context
        if context is not None and managed.members and not self._context_alive(managed):
            managed.context_failed = True
            managed.admitting = False
            for pid, start_ticks in list(managed.members.items()):
                signal_exact_process(pid, start_ticks, signal.SIGKILL)
            for pid, start_ticks in list(managed.members.items()):
                if not exact_process_alive(pid, start_ticks):
                    managed.members.pop(pid, None)
            if not managed.members:
                managed.session_ids.clear()
        return len(managed.members)

    def _release_managed_context(self, managed: ManagedProcess) -> None:
        self._revoke_output_watch_leases_for_launch(managed.launch_id)
        # Every FramePulse lease includes an exact CaptureSeal source and exact
        # pixels. Process teardown is a topology transition even when another
        # launch owned the requested crop, so invalidate the complete bounded
        # lease set rather than trying to infer visual non-interference.
        frame_cursors = getattr(self, "frame_cursors", None)
        if isinstance(frame_cursors, dict):
            frame_cursors.clear()
        context = managed.security_context
        managed.security_context = None
        if context is not None:
            self._stop_app_context(context)
        # Revoke semantic history only after the birth-pinned proxy is gone and
        # the managed object no longer advertises it.  This closes the final
        # callback race: no event can be re-attributed between the wipe and
        # context teardown.
        retire_events = getattr(getattr(self, "accessibility", None), "retire_launch", None)
        if callable(retire_events):
            retire_events(managed.launch_id)
        self._cleanup_launch_drop(managed)

    def _reap_processes(self) -> None:
        for pid, managed in list(self.processes.items()):
            managed.process.poll()
            if self._refresh_managed(managed) == 0 and managed.process.poll() is not None:
                self._release_managed_context(managed)
                self.processes.pop(pid, None)

    def processes_list(self, arguments: dict[str, Any]) -> dict[str, Any]:
        self._reap_processes()
        launch_filter = arguments.get("launch_id")
        scene_filter = arguments.get("scene_id")
        if launch_filter is not None and scene_filter is not None:
            raise ToolError("launch_id and scene_id are mutually exclusive process filters")
        if launch_filter is not None:
            launch_filter = as_string(launch_filter, "launch_id", maximum=128, allow_empty=False)
        if scene_filter is not None:
            scene_filter = self._scene_id(scene_filter, required=True)
        values = []
        for pid, managed in sorted(self.processes.items()):
            if launch_filter is not None and managed.launch_id != launch_filter:
                continue
            if scene_filter is not None and managed.scene_id != scene_filter:
                continue
            count = self._refresh_managed(managed)
            context = managed.security_context
            values.append({
                "pid": pid,
                "launch_id": managed.launch_id,
                "application_id": managed.application_id,
                "scene_id": managed.scene_id,
                "workspace": managed.workspace,
                "output_subdirectory": managed.output_subdirectory,
                "drop_subdirectory": managed.drop_subdirectory,
                "drop_snapshot_bytes": managed.drop_snapshot_bytes,
                "drop_transaction_count": managed.drop_transaction_count,
                "drop_quarantined": managed.drop_quarantined,
                "drop_quarantine_reason": managed.drop_quarantine_reason,
                "drop_quarantine_signals": managed.drop_quarantine_signals,
                "leader_start_ticks": managed.leader_start_ticks,
                "argv": managed.argv,
                "cwd": managed.cwd,
                "started_at": managed.started_at,
                "running": count > 0,
                "exit_code": managed.process.poll(),
                "admitting_descendants": managed.admitting,
                "owned_session_ids": sorted(managed.session_ids),
                "context_failed": managed.context_failed,
                "grants": self._grants(managed),
                "semantic_process_ids": self._semantic_process_ids(managed),
                "wayland_security_context": None if context is None else {
                    "pid": context.process.pid,
                    "start_ticks": context.start_ticks,
                    "alive": exact_process_alive(context.process.pid, context.start_ticks),
                    "sandbox_engine": SANDBOX_ENGINE,
                    "sandbox_app_id": context.app_id,
                    "sandbox_instance_id": context.instance_id,
                    "capability_probe": context.capability_probe,
                    "atspi_proxy": {
                        "pid": context.atspi_process.pid,
                        "start_ticks": context.atspi_start_ticks,
                        "alive": exact_process_alive(context.atspi_process.pid, context.atspi_start_ticks),
                        "filter": "registry-registration-only",
                        "policy_sha256": context.atspi_policy_sha256,
                    },
                },
                "members": [{"pid": child, "start_ticks": ticks} for child, ticks in sorted(managed.members.items())],
            })
        return json_result({"processes": values, "count": len(values), "custody": "exact-proc-identity+per-launch-wayland-context"})

    def _stop_process(self, pid: int, sig: signal.Signals, grace: float) -> dict[str, Any]:
        managed = self.processes.get(pid)
        if managed is None:
            raise ToolError("pid is not owned by the desktop MCP server")
        self._refresh_managed(managed)
        managed.admitting = False

        def signal_members(requested: signal.Signals) -> int:
            sent = 0
            # Children first, the session leader last. Exact start ticks prevent
            # signalling a recycled PID after an asynchronous GUI exit.
            for member_pid, start_ticks in sorted(managed.members.items(), key=lambda item: item[0] == pid):
                if signal_exact_process(member_pid, start_ticks, requested):
                    sent += 1
            return sent

        sent = signal_members(sig)
        deadline = time.monotonic() + grace
        while self._refresh_managed(managed) and time.monotonic() < deadline:
            time.sleep(0.025)
        escalated = False
        if managed.members and sig != signal.SIGKILL:
            escalated = True
            signal_members(signal.SIGKILL)
            deadline = time.monotonic() + 1.0
            while self._refresh_managed(managed) and time.monotonic() < deadline:
                time.sleep(0.025)
        with contextlib.suppress(subprocess.TimeoutExpired):
            managed.process.wait(timeout=0.05)
        remaining = [{"pid": child, "start_ticks": ticks} for child, ticks in sorted(managed.members.items())]
        if not remaining:
            self._release_managed_context(managed)
            self.processes.pop(pid, None)
        return {
            "terminated": not remaining,
            "pid": pid,
            "exit_code": managed.process.poll(),
            "signals_sent": sent,
            "escalated": escalated,
            "remaining": remaining,
        }

    def terminate(self, arguments: dict[str, Any]) -> dict[str, Any]:
        pid = as_int(arguments.get("pid"), 1, 2**31 - 1, "pid")
        requested = str(arguments.get("signal", "TERM")).upper()
        if requested not in {"TERM", "KILL", "INT", "HUP"}:
            raise ToolError("signal must be TERM, KILL, INT, or HUP")
        grace = as_number(arguments.get("grace", 2.0), 0.0, 30.0, "grace")
        with self.lock:
            value = self._stop_process(pid, getattr(signal, f"SIG{requested}"), grace)
            self.write_status("ready")
        return json_result(value)

    def wait(self, arguments: dict[str, Any]) -> dict[str, Any]:
        milliseconds = as_int(arguments.get("milliseconds"), 0, 30000, "milliseconds")
        time.sleep(milliseconds / 1000)
        return json_result({"waited_milliseconds": milliseconds})

