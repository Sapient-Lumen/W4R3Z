        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor motion virtual-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor motion dispatch is unavailable")

        def validate(prepared_hit: dict[str, Any]) -> None:
            self._assert_pointer_route(
                route,
                point_index,
                prepared_hit=prepared_hit,
            )

        receipt = seal.guarded_motion(from_x, from_y, x, y, validate)
        self.pointer = {"x": x, "y": y}
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "point_index": point_index,
            "virtual_pointer_identity_sha256": device_identity,
            "controller_route_revalidated_against_destination_arm_target": True,
            "controller_source_coordinate_bound": [from_x, from_y],
        }

    def _run_pointer_unit_fence(
        self,
        action_name: str,
        route: dict[str, Any],
        units: list[Any],
        unit_kind: str,
        interval: float,
        maximum_inflight_units: int,
        dispatch: Callable[[Any], dict[str, Any] | None],
        *,
        modifier_names: tuple[str, ...] = (),
        modifier_target: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        """Dispatch complete pointer units under route and ordered event seals.

        Each click or logical scroll step is a released input unit. TickSeal
        places an authenticated Sway SEND_TICK barrier before and after every
        unit and around every inter-unit gap. A top-level target which changes
        and returns between the ordinary tree checks is therefore retained and
        cannot silently authorize the next unit.
        """
        evidence = self._pointer_fence_evidence(
            action_name,
            route,
            unit_kind,
            len(units),
            maximum_inflight_units,
        )
        compositor_native_click_required = self.is_wayland and unit_kind in {
            "complete-click",
            "primary-middle-click",
        }
        compositor_native_touch_tap_required = (
            self.is_wayland and unit_kind == "complete-touch-tap"
        )
        compositor_native_touch_stroke_required = (
            self.is_wayland and unit_kind == "complete-touch-stroke"
        )
        compositor_native_touch_gesture_required = (
            self.is_wayland and unit_kind == "complete-touch-gesture"
        )
        compositor_native_touchpad_swipe_required = (
            self.is_wayland and unit_kind == "complete-touchpad-swipe"
        )
        compositor_native_touchpad_pinch_required = (
            self.is_wayland and unit_kind == "complete-touchpad-pinch"
        )
        compositor_native_touchpad_hold_required = (
            self.is_wayland and unit_kind == "complete-touchpad-hold"
        )
        compositor_native_relative_motion_required = (
            self.is_wayland and unit_kind == "complete-relative-motion"
        )
        compositor_native_stylus_hover_required = (
            self.is_wayland and unit_kind == "complete-stylus-hover"
        )
        compositor_native_stylus_stroke_required = (
            self.is_wayland and unit_kind == "complete-stylus-stroke"
        )
        compositor_native_tablet_pad_ring_required = (
            self.is_wayland and unit_kind == "complete-tablet-pad-ring"
        )
        compositor_native_tablet_pad_strip_required = (
            self.is_wayland and unit_kind == "complete-tablet-pad-strip"
        )
        compositor_native_tablet_pad_button_required = (
            self.is_wayland and unit_kind == "complete-tablet-pad-button"
        )
        compositor_native_tablet_pad_mode_required = (
            self.is_wayland and unit_kind == "complete-tablet-pad-mode"
        )
        compositor_native_touch_required = (
            compositor_native_touch_tap_required
            or compositor_native_touch_stroke_required
            or compositor_native_touch_gesture_required
        )
        compositor_native_scroll_required = (
            self.is_wayland and unit_kind == "logical-scroll-step"
        )
        compositor_native_dispatch_required = (
            compositor_native_click_required
            or compositor_native_touch_required
            or compositor_native_touchpad_swipe_required
            or compositor_native_touchpad_pinch_required
            or compositor_native_touchpad_hold_required
            or compositor_native_relative_motion_required
            or compositor_native_stylus_hover_required
            or compositor_native_stylus_stroke_required
            or compositor_native_tablet_pad_ring_required
            or compositor_native_tablet_pad_strip_required
            or compositor_native_tablet_pad_button_required
            or compositor_native_tablet_pad_mode_required
            or compositor_native_scroll_required
        )
        expected_compositor_operation_by_unit = {
            "complete-click": "native-complete-click",
            "primary-middle-click": "native-complete-click",
            "complete-touch-tap": "native-exact-recipient-touch-tap",
            "complete-touch-stroke": "native-exact-recipient-touch-stroke",
            "complete-touch-gesture": "native-exact-recipient-two-contact-touch-gesture",
            "complete-touchpad-swipe": "native-exact-recipient-touchpad-swipe",
            "complete-touchpad-pinch": "native-exact-recipient-touchpad-pinch",
            "complete-touchpad-hold": "native-exact-recipient-touchpad-hold",
            "complete-tablet-pad-ring": "native-exact-recipient-tablet-pad-ring",
            "complete-tablet-pad-strip": "native-exact-recipient-tablet-pad-strip",
            "complete-tablet-pad-button": "native-exact-recipient-tablet-pad-button",
            "complete-tablet-pad-mode": "native-exact-recipient-tablet-pad-mode",
            "complete-relative-motion": "native-exact-recipient-locked-relative-motion",
            "complete-stylus-hover": "native-exact-recipient-tablet-v2-stylus-hover",
            "complete-stylus-stroke": "native-exact-recipient-tablet-v2-stylus-stroke",
            "logical-scroll-step": "native-logical-scroll-step",
        }
        expected_compositor_operation = expected_compositor_operation_by_unit.get(
            unit_kind
        )
        evidence["compositor_native_click_required"] = compositor_native_click_required
        evidence["compositor_native_touch_required"] = compositor_native_touch_required
        evidence["compositor_native_touch_tap_required"] = (
            compositor_native_touch_tap_required
        )
        evidence["compositor_native_touch_stroke_required"] = (
            compositor_native_touch_stroke_required
        )
        evidence["compositor_native_touch_gesture_required"] = (
            compositor_native_touch_gesture_required
        )
        evidence["compositor_native_touchpad_swipe_required"] = (
            compositor_native_touchpad_swipe_required
        )
        evidence["compositor_native_touchpad_pinch_required"] = (
            compositor_native_touchpad_pinch_required
        )
        evidence["compositor_native_touchpad_hold_required"] = (
            compositor_native_touchpad_hold_required
        )
        evidence["compositor_native_relative_motion_required"] = (
            compositor_native_relative_motion_required
        )
        evidence["compositor_native_stylus_hover_required"] = (
            compositor_native_stylus_hover_required
        )
        evidence["compositor_native_stylus_stroke_required"] = (
            compositor_native_stylus_stroke_required
        )
        evidence["compositor_native_tablet_pad_ring_required"] = (
            compositor_native_tablet_pad_ring_required
        )
        evidence["compositor_native_tablet_pad_strip_required"] = (
            compositor_native_tablet_pad_strip_required
        )
        evidence["compositor_native_tablet_pad_button_required"] = (
            compositor_native_tablet_pad_button_required
        )
        evidence["compositor_native_tablet_pad_mode_required"] = (
            compositor_native_tablet_pad_mode_required
        )
        evidence["compositor_native_scroll_required"] = compositor_native_scroll_required
        evidence["compositor_native_dispatch_required"] = compositor_native_dispatch_required
        evidence["compositor_native_dispatch_operation"] = expected_compositor_operation
        canonical_modifiers, modifier_mask = WaylandKeyboardTransaction.normalize_modifiers(
            list(modifier_names)
        )
        if bool(canonical_modifiers) != (modifier_target is not None):
            raise ToolError("modified pointer gesture is missing its exact keyboard target authority")
        evidence["modifier_guard"] = {
            "schema": "sandcodex.modified-pointer-guard.v2",
            "enforced": bool(canonical_modifiers),
            "protocol": "ModifierArcSeal",
            "modifier_arc_schema": MODIFIER_ARC_SEAL_SCHEMA,
            "modifiers": list(canonical_modifiers),
            "canonical_modifier_mask": modifier_mask,
            "serialized_modifier_mask": None,
            "keyboard_target_identity_sha256": (
                modifier_target.get("identity_sha256")
                if isinstance(modifier_target, dict)
                else None
            ),
            "device_order": (
                "keyboard-planner-start+exact-recipient-compositor-arc-hold+"
                "pointer-start+pointer-units+pointer-destroy+"
                "target-independent-compositor-arc-clear+keyboard-destroy"
            ),
            "modifier_authority_owner": (
                "authenticated-sway-ipc-connection" if canonical_modifiers else None
            ),
            "modifier_hold_dispatch_path": (
                COMPOSITOR_MODIFIER_ARC_DISPATCH_PATH if canonical_modifiers else None
            ),
            "modifier_hold_atomicity": (
                GUARDED_MODIFIER_ARC_ATOMICITY if canonical_modifiers else None
            ),
            "connection_owned": bool(canonical_modifiers),
            "disconnect_clear": bool(canonical_modifiers),
            "virtual_keyboard_destroy_clear": bool(canonical_modifiers),
            "target_independent_clear": bool(canonical_modifiers),
            "underlying_keyboard_released_throughout": True,
            "helper_key_or_modifier_requests": 0,
            "hold_receipt": None,
            "hold_receipt_sha256": None,
            "release_receipt": None,
            "release_receipt_sha256": None,
            "modifier_hold_confirmed": not canonical_modifiers,
            "modifier_release_confirmed": not canonical_modifiers,
            "keyboard_lifecycle": None,
            "complete": not canonical_modifiers,
        }
        audit_arguments = {
            "route_sha256": route.get("route_sha256"),
            "launch_id": route.get("launch_id"),
            "target_window_ids": route.get("target_window_ids", []),
            "unit_kind": unit_kind,
            "planned_units": len(units),
        }
        seal = getattr(self, "compositor_event_seal", None)
        if self.is_wayland and seal is None:
            raise ToolError("birth-pinned compositor event seal is unavailable; pointer input was withheld")
        ledger = CompositorEventLedger(
            seal,
            f"{action_name}:{str(route.get('route_sha256') or 'unbound')[:24]}",
        )
        evidence["compositor_event_seal"] = ledger.evidence
        started = time.monotonic()
        transaction: WaylandPointerTransaction | None = None
        keyboard_transaction: WaylandKeyboardTransaction | None = None
        modifier_arc: CompositorModifierArc | None = None
        primary_error: Exception | None = None
        previous_end: int | None = None

        def check_targets(point_index: int) -> None:
            self._check_pointer_fence(route, point_index, evidence)
            if modifier_target is not None:
                self._assert_keyboard_target(modifier_target)

        def record_final_transition(
            summary: dict[str, Any],
            tree_transition: PointerRouteTransition | None = None,
            *,
            phase: str,
        ) -> None:
            event_transition = ledger.has_transition(summary)
            if tree_transition is None and not event_transition:
                return
            evidence["route_intact"] = False
            evidence["final_scene_transition"] = True
            evidence["final_transition_phase"] = phase
            evidence["final_scene_transition_detected_by"] = (
                "tree+event-stream"
                if tree_transition is not None and event_transition
                else ("tree" if tree_transition is not None else "event-stream")
            )
            evidence["final_scene_transition_reason"] = (
                str(tree_transition)[:512]
                if tree_transition is not None
                else ledger.reason(
                    summary,
                    f"compositor target changed during final pointer {phase}",
                )
            )

        try:
            if canonical_modifiers:
                self._require_keyboard_healthy()
                assert modifier_target is not None
                modifier_start = ledger.barrier("modifier-keyboard:start")
                if previous_end is not None:
                    modifier_gap = ledger.interval(previous_end, modifier_start, "gap")
                    ledger.reject_fatal(
                        modifier_gap,
                        "compositor environment changed before modifier acquisition",
                    )
                    if ledger.has_transition(modifier_gap):
                        raise PointerRouteTransition(
                            ledger.reason(
                                modifier_gap,
                                "compositor target changed before modifier acquisition",
                            )
                        )
                check_targets(0)
                keyboard_transaction = WaylandKeyboardTransaction(
                    self,
                    f"{action_name}-modified-pointer",
                )
                keyboard_transaction.prepare_characters("")
                prepared_names, serialized_modifier_mask = (
                    keyboard_transaction.prepare_modifier_arc(
                        list(canonical_modifiers)
                    )
                )
                if prepared_names != canonical_modifiers:
                    keyboard_transaction.cancel_modifier_arc_preparation(
                        serialized_modifier_mask
                    )
                    raise ToolError(
                        "keyboard planner canonicalized modifier-arc authority inconsistently"
                    )
                modifier_arc, hold_receipt = (
                    self._dispatch_compositor_guarded_modifier_arc(
                        modifier_target,
                        keyboard_transaction,
                        serialized_modifier_mask,
                    )
                )
                check_targets(0)
                modifier_end = ledger.barrier("modifier-keyboard:end")
                modifier_summary = ledger.interval(
                    modifier_start,
                    modifier_end,
                    "modifier-preparation",
                )
                previous_end = modifier_end
                ledger.reject_fatal(
                    modifier_summary,
                    "compositor environment changed while acquiring pointer modifiers",
                )
                if ledger.has_transition(modifier_summary):
                    raise PointerRouteTransition(
                        ledger.reason(
                            modifier_summary,
                            "compositor target changed while acquiring pointer modifiers",
                        )
                    )
                keyboard_start = keyboard_transaction.seat_start_receipt
                if not isinstance(keyboard_start, dict):
                    raise ToolError(
                        "SeatSeal modified-pointer keyboard activation receipt is unavailable"
                    )
                keyboard_identity = keyboard_start.get("active_device_identity_sha256")
                if not isinstance(keyboard_identity, str):
                    raise ToolError(
                        "SeatSeal modified-pointer keyboard identity is unavailable"
                    )
                keyboard_added = ledger.require_input_lifecycle(
                    modifier_summary,
                    "added",
                    "keyboard",
                    "modified pointer preparation did not prove one exact virtual keyboard",
                    expected_identity_sha256=keyboard_identity,
                )
                modifier_evidence = evidence["modifier_guard"]
                assert isinstance(modifier_evidence, dict)
                modifier_evidence["serialized_modifier_mask"] = serialized_modifier_mask
                modifier_evidence["hold_receipt"] = hold_receipt
                modifier_evidence["hold_receipt_sha256"] = hold_receipt.get(
                    "receipt_sha256"
                )
                modifier_evidence["modifier_hold_confirmed"] = True
                modifier_evidence["keyboard_transport"] = keyboard_transaction.evidence()
                modifier_evidence["keyboard_lifecycle"] = {
                    "schema": SEAT_SEAL_SCHEMA,
                    "input_type": "keyboard",
                    "identity_sha256": keyboard_identity,
                    "added_event": keyboard_added,
                    "removed_event": None,
                    "inventory_start": keyboard_start,
                    "inventory_stop": None,
                    "complete": False,
                }

            preparation_start = ledger.barrier("preparation:start")
            if previous_end is not None:
                preparation_gap = ledger.interval(previous_end, preparation_start, "gap")
                ledger.reject_fatal(
                    preparation_gap,
                    "compositor environment changed before guarded pointer creation",
                )
                if ledger.has_transition(preparation_gap):
                    raise PointerRouteTransition(
                        ledger.reason(
                            preparation_gap,
                            "compositor target changed before guarded pointer creation",
                        )
                    )
            previous_end = preparation_start
            if keyboard_transaction is None:
                transaction = WaylandPointerTransaction(self, action_name)
            else:
                transaction = WaylandPointerTransaction(
                    self,
                    action_name,
                    seat_companion_receipt=keyboard_transaction.seat_start_receipt,
                )
            evidence["pointer_transport"] = transaction.evidence()
            preparation_end = ledger.barrier("preparation:end")
            preparation_summary = ledger.interval(
                preparation_start,
                preparation_end,
                "preparation",
            )
            previous_end = preparation_end
            ledger.reject_fatal(
                preparation_summary,
                "compositor environment changed while preparing the guarded pointer",
            )
            if ledger.has_transition(preparation_summary):
                raise PointerRouteTransition(
                    ledger.reason(
                        preparation_summary,
                        "compositor target changed while preparing the guarded pointer",
                    )
                )
            start_receipt = transaction.seat_start_receipt
            if not isinstance(start_receipt, dict):
                raise ToolError("SeatSeal pointer activation receipt is unavailable")
            active_identity = start_receipt.get("active_device_identity_sha256")
            if not isinstance(active_identity, str):
                raise ToolError("SeatSeal pointer activation identity is unavailable")
            added_event = ledger.require_input_lifecycle(
                preparation_summary,
                "added",
                "pointer",
                "guarded pointer preparation did not prove one exact virtual device",
                expected_identity_sha256=active_identity,
            )
            evidence["virtual_device_lifecycle"] = {
                "schema": SEAT_SEAL_SCHEMA,
                "input_type": "pointer",
                "identity_sha256": active_identity,
                "added_event": added_event,
                "removed_event": None,
                "inventory_start": start_receipt,
                "inventory_stop": None,
                "complete": False,
            }

            for index, unit in enumerate(units):
                self._assert_pointer_fence_deadline(started)
                start_sequence = ledger.barrier(f"unit:{index}:start")
                if previous_end is not None:
                    gap_summary = ledger.interval(previous_end, start_sequence, "gap")
                    ledger.reject_fatal(
                        gap_summary,
                        "compositor environment changed between guarded pointer units",
                    )
                    if ledger.has_transition(gap_summary):
                        raise PointerRouteTransition(
                            ledger.reason(
                                gap_summary,
                                "compositor target changed between pointer units; no further input was emitted",
                            )
                        )

                unit_error: Exception | None = None
                post_transition: ToolError | None = None
                dispatched = False
                try:
                    check_targets(0)
                    dispatch_receipt = dispatch(unit)
                    if dispatch_receipt is not None:
                        if (
                            not isinstance(dispatch_receipt, dict)
                            or dispatch_receipt.get("schema")
                            != evidence.get("compositor_dispatch_seal_schema")
                            or dispatch_receipt.get("ticket_consumed") is not True
                            or dispatch_receipt.get("released") is not True
                            or (
                                expected_compositor_operation is not None
                                and dispatch_receipt.get("operation")
                                != expected_compositor_operation
                            )
                        ):
                            raise ToolError(
                                "compositor-native pointer dispatch returned malformed evidence"
                            )
                        compositor_receipts = evidence.get("compositor_dispatch_seals")
                        if not isinstance(compositor_receipts, list):
                            raise ToolError("compositor-native dispatch evidence disappeared")
                        compositor_receipts.append(dispatch_receipt)
                        evidence["compositor_native_dispatch_units"] = (
                            int(evidence["compositor_native_dispatch_units"]) + 1
                        )
                        if dispatch_receipt.get("operation") == "native-complete-click":
                            evidence["compositor_native_click_units"] = (
                                int(evidence["compositor_native_click_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-touch-tap":
                            evidence["compositor_native_touch_units"] = (
                                int(evidence["compositor_native_touch_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-touch-stroke":
                            evidence["compositor_native_touch_units"] = (
                                int(evidence["compositor_native_touch_units"]) + 1
                            )
                            evidence["compositor_native_touch_stroke_units"] = (
                                int(evidence["compositor_native_touch_stroke_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-two-contact-touch-gesture":
                            evidence["compositor_native_touch_units"] = (
                                int(evidence["compositor_native_touch_units"]) + 1
                            )
                            evidence["compositor_native_touch_gesture_units"] = (
                                int(evidence["compositor_native_touch_gesture_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-touchpad-swipe":
                            evidence["compositor_native_touchpad_swipe_units"] = (
                                int(evidence["compositor_native_touchpad_swipe_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-touchpad-pinch":
                            evidence["compositor_native_touchpad_pinch_units"] = (
                                int(evidence["compositor_native_touchpad_pinch_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-touchpad-hold":
                            evidence["compositor_native_touchpad_hold_units"] = (
                                int(evidence["compositor_native_touchpad_hold_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-pad-ring":
                            evidence["compositor_native_tablet_pad_ring_units"] = (
                                int(evidence["compositor_native_tablet_pad_ring_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-pad-strip":
                            evidence["compositor_native_tablet_pad_strip_units"] = (
                                int(evidence["compositor_native_tablet_pad_strip_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-pad-button":
                            evidence["compositor_native_tablet_pad_button_units"] = (
                                int(evidence["compositor_native_tablet_pad_button_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-pad-mode":
                            evidence["compositor_native_tablet_pad_mode_units"] = (
                                int(evidence["compositor_native_tablet_pad_mode_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-locked-relative-motion":
                            evidence["compositor_native_relative_motion_units"] = (
                                int(evidence["compositor_native_relative_motion_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-v2-stylus-hover":
                            evidence["compositor_native_stylus_hover_units"] = (
                                int(evidence["compositor_native_stylus_hover_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-exact-recipient-tablet-v2-stylus-stroke":
                            evidence["compositor_native_stylus_stroke_units"] = (
                                int(evidence["compositor_native_stylus_stroke_units"]) + 1
                            )
                        elif dispatch_receipt.get("operation") == "native-logical-scroll-step":
                            evidence["compositor_native_scroll_units"] = (
                                int(evidence["compositor_native_scroll_units"]) + 1
                            )
                    dispatched = True
                    evidence["emitted_units"] = int(evidence["emitted_units"]) + 1
                    try:
                        check_targets(0)
                    except (PointerRouteTransition, KeyboardTargetTransition) as error:
                        post_transition = error
                except Exception as error:
                    unit_error = error

                try:
                    end_sequence = ledger.barrier(f"unit:{index}:end")
                    unit_summary = ledger.interval(start_sequence, end_sequence, "unit")
                except Exception as seal_error:
                    if unit_error is not None:
                        raise ToolError(
                            "compositor event seal failed while a pointer unit also failed; pointer state is uncertain"
                        ) from seal_error
                    raise
                previous_end = end_sequence
                ledger.reject_fatal(
                    unit_summary,
                    "compositor environment changed during guarded pointer input",
                )
                if unit_error is not None:
                    raise unit_error
                if not dispatched:
                    raise ToolError("pointer unit was not dispatched")
                evidence["completed_units"] = int(evidence["completed_units"]) + 1

                event_transition = ledger.has_transition(unit_summary)
                if post_transition is not None or event_transition:
                    if index + 1 < len(units):
                        if post_transition is not None:
                            raise post_transition
                        raise PointerRouteTransition(
                            ledger.reason(
                                unit_summary,
                                "compositor target changed during a pointer unit; no further input was emitted",
                            )
                        )
                    # The transaction acknowledgement proves this complete click
                    # or scroll unit ended released. A final transition is safe to
                    # report, but it never authorizes another unit.
                    record_final_transition(unit_summary, post_transition, phase="unit")

                if interval and index + 1 < len(units):
                    remaining = MAX_ACTION_SECONDS - (time.monotonic() - started)
                    if remaining <= 0 or interval > remaining:
                        raise ToolError("guarded pointer gesture exceeded the action runtime limit")
                    time.sleep(interval)

            transaction.close()
            evidence["pointer_transport"] = transaction.evidence()
            cleanup_end = ledger.barrier("cleanup:end")
            if previous_end is not None:
                cleanup_summary = ledger.interval(previous_end, cleanup_end, "cleanup")
                ledger.reject_fatal(
                    cleanup_summary,
                    "compositor environment changed while closing the guarded pointer transport",
                )
                lifecycle_evidence = evidence.get("virtual_device_lifecycle")
                if not isinstance(lifecycle_evidence, dict):
                    raise ToolError("SeatSeal pointer lifecycle evidence is unavailable during cleanup")
                removed_event = ledger.require_input_lifecycle(
                    cleanup_summary,
                    "removed",
                    "pointer",
                    "guarded pointer cleanup did not prove exact virtual-device removal",
                    expected_identity_sha256=str(lifecycle_evidence.get("identity_sha256")),
                )
                lifecycle_evidence["removed_event"] = removed_event
                lifecycle_evidence["inventory_stop"] = transaction.seat_stop_receipt
                lifecycle_evidence["complete"] = True
                if ledger.has_transition(cleanup_summary):
                    if int(evidence["completed_units"]) != len(units):
                        raise PointerRouteTransition(
                            ledger.reason(
                                cleanup_summary,
                                "compositor target changed before all pointer units completed",
                            )
                        )
                    record_final_transition(cleanup_summary, phase="cleanup")
            previous_end = cleanup_end
            if keyboard_transaction is not None:
                modifier_evidence = evidence.get("modifier_guard")
                if not isinstance(modifier_evidence, dict):
                    raise ToolError(
                        "modified pointer guard evidence disappeared during cleanup"
                    )
                if modifier_arc is None:
                    raise ToolError(
                        "modified pointer lost its compositor modifier-arc authority"
                    )
                release_receipt = self._release_compositor_guarded_modifier_arc(
                    modifier_arc,
                    keyboard_transaction,
                )
                modifier_arc = None
                modifier_evidence["release_receipt"] = release_receipt
                modifier_evidence["release_receipt_sha256"] = release_receipt.get(
                    "receipt_sha256"
                )
                modifier_evidence["modifier_release_confirmed"] = True
                keyboard_transaction.close()
                modifier_evidence["keyboard_transport"] = keyboard_transaction.evidence()
                modifier_cleanup_end = ledger.barrier("modifier-keyboard-cleanup:end")
                modifier_cleanup_summary = ledger.interval(
                    previous_end,
                    modifier_cleanup_end,
                    "modifier-cleanup",
                )
                ledger.reject_fatal(
                    modifier_cleanup_summary,
                    "compositor environment changed while clearing pointer modifiers",
                )
                keyboard_lifecycle = modifier_evidence.get("keyboard_lifecycle")
                if not isinstance(keyboard_lifecycle, dict):
                    raise ToolError(
                        "SeatSeal keyboard lifecycle evidence is unavailable during modifier cleanup"
                    )
                keyboard_removed = ledger.require_input_lifecycle(
                    modifier_cleanup_summary,
                    "removed",
                    "keyboard",
                    "modified pointer cleanup did not prove exact virtual-keyboard removal",
                    expected_identity_sha256=str(keyboard_lifecycle.get("identity_sha256")),
                )
                keyboard_lifecycle["removed_event"] = keyboard_removed
                keyboard_lifecycle["inventory_stop"] = keyboard_transaction.seat_stop_receipt
                keyboard_lifecycle["complete"] = True
                modifier_evidence["complete"] = True
                if ledger.has_transition(modifier_cleanup_summary):
                    if int(evidence["completed_units"]) != len(units):
                        raise PointerRouteTransition(
                            ledger.reason(
                                modifier_cleanup_summary,
                                "compositor target changed before modified pointer cleanup completed",
                            )
                        )
                    record_final_transition(
                        modifier_cleanup_summary,
                        phase="modifier-cleanup",
                    )
                previous_end = modifier_cleanup_end
        except Exception as error:
            primary_error = error
        finally:
            if transaction is not None and not transaction.closed:
                try:
                    transaction.close()
                except Exception as close_error:
                    if primary_error is None:
                        primary_error = close_error
                    else:
                        primary_error = ToolError(
                            f"{primary_error}; private pointer transport cleanup also failed: {close_error}"
                        )
                evidence["pointer_transport"] = transaction.evidence()
            if keyboard_transaction is not None and not keyboard_transaction.closed:
                keyboard_cleanup_error: Exception | None = None
                modifier_evidence = evidence.get("modifier_guard")
                if modifier_arc is not None and not modifier_arc.release_requested:
                    try:
                        release_receipt = self._release_compositor_guarded_modifier_arc(
                            modifier_arc,
                            keyboard_transaction,
                        )
                        modifier_arc = None
                        if isinstance(modifier_evidence, dict):
                            modifier_evidence["release_receipt"] = release_receipt
                            modifier_evidence["release_receipt_sha256"] = release_receipt.get(
                                "receipt_sha256"
                            )
                            modifier_evidence["modifier_release_confirmed"] = True
                    except Exception as release_error:
                        keyboard_cleanup_error = release_error
                try:
                    keyboard_transaction.close()
                except Exception as close_error:
                    if keyboard_cleanup_error is None:
                        keyboard_cleanup_error = close_error
                    else:
                        keyboard_cleanup_error = ToolError(
                            f"{keyboard_cleanup_error}; private modifier keyboard shutdown also failed: {close_error}"
                        )
                if isinstance(modifier_evidence, dict):
                    modifier_evidence["keyboard_transport"] = keyboard_transaction.evidence()
                    modifier_evidence["modifier_release_confirmed"] = (
                        keyboard_transaction.modifier_arc_releases_confirmed == 1
                    )
                    modifier_evidence["release_forced_by_connection_revocation"] = (
                        keyboard_transaction.modifier_arc_revocation_forced
                    )
                if keyboard_cleanup_error is not None:
                    if primary_error is None:
                        primary_error = keyboard_cleanup_error
                    else:
                        primary_error = ToolError(
                            f"{primary_error}; modified-pointer modifier-arc cleanup also failed: {keyboard_cleanup_error}"
                        )
            # Even on a dispatch failure, drain the event stream through transport
            # teardown. This interval is evidence only when an earlier error has
            # already denied success; otherwise its fatal/transition policy is
            # enforced above on the normal path.
            if primary_error is not None and previous_end is not None:
                try:
                    failure_cleanup_end = ledger.barrier("failure-cleanup:end")
                    ledger.interval(previous_end, failure_cleanup_end, "cleanup")
                    previous_end = failure_cleanup_end
                except Exception as seal_error:
                    primary_error = ToolError(
                        f"{primary_error}; compositor event sealing also failed during cleanup: {seal_error}"
                    )

        evidence["compositor_event_seal"] = ledger.finalize()
        evidence["pointer_controller_quarantined"] = bool(getattr(self, "pointer_quarantined", False))
        evidence["elapsed_milliseconds"] = round((time.monotonic() - started) * 1000, 3)
        if (
            primary_error is None
            and compositor_native_dispatch_required
            and int(evidence["compositor_native_dispatch_units"]) != len(units)
        ):
            primary_error = ToolError(
                "guarded Wayland pointer input completed without one exact compositor-native dispatch seal per unit"
            )
        if primary_error is not None:
            evidence["route_intact"] = False
            self.journal.append(
                "pointer-fence",
                action_name,
                audit_arguments,
                evidence,
                error=str(primary_error),
            )
            raise primary_error
        self.journal.append("pointer-fence", action_name, audit_arguments, evidence)
        return evidence


    def _fenced_touch(
        self,
        arguments: dict[str, Any],
        route: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        self._require_pointer_healthy()
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        if self.pointer != {"x": x, "y": y}:
            raise ToolError("guarded touch target is not the post-hover latched route point")
        evidence = self._run_pointer_unit_fence(
            "desktop_touch",
            route,
            [0],
            "complete-touch-tap",
            0.0,
            TOUCH_FENCE_MAX_INFLIGHT_TAPS,
            lambda _unit: self._dispatch_compositor_guarded_touch(route, 0),
        )
        return {
            "touched": True,
            "native_protocol": "wl_touch",
            "touch_id": 0,
            "touch_events": 2,
            "touch_frames": 2,
            "released": True,
            "mouse_fallback_used": False,
            **self.pointer_position(),
        }, evidence

