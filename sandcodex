  xwayland_log=/run/sandcodex-app/xwayland-satellite.log
  rm -f -- "$xauthority" "$xwayland_log"
  cookie="$("$mcookie")"
  [[ "$cookie" =~ ^[0-9a-fA-F]{32}$ ]] || {
    printf "sandcodex desktop app launcher: private X11 cookie generation failed\n" >&2; exit 77;
  }
  : >"$xauthority"; chmod 600 -- "$xauthority"
  "$xauth" -f "$xauthority" add "$x11_display" MIT-MAGIC-COOKIE-1 "$cookie" >/dev/null 2>&1 || {
    printf "sandcodex desktop app launcher: private X11 authority generation failed\n" >&2; exit 77;
  }
  [[ -f "$xauthority" && ! -L "$xauthority" && -s "$xauthority" &&
    "$(stat -c %u:%a -- "$xauthority")" == "$(id -u):600" ]] || {
    printf "sandcodex desktop app launcher: private X11 authority is unsafe\n" >&2; exit 77;
  }
  : >"$xwayland_log"; chmod 600 -- "$xwayland_log"
  RUST_LOG=warn "$xwayland_satellite" "$x11_display" -auth "$xauthority" \
    -nolisten tcp -glamor none -audit 1 -verbose 0 >"$xwayland_log" 2>&1 &
  xwayland=$!
  x_socket="/tmp/.X11-unix/X${x11_display#:}"
  ready=0
  for _ in {1..240}; do
    kill -0 "$xwayland" 2>/dev/null || break
    if [[ -S "$x_socket" && ! -L "$x_socket" &&
        "$(stat -c %u -- "$x_socket" 2>/dev/null || true)" == "$(id -u)" ]]; then
      ready=1
      break
    fi
    sleep 0.025
  done
  (( ready )) || {
    sed -n "1,120p" "$xwayland_log" >&2 2>/dev/null || true
    printf "sandcodex desktop app launcher: private X11 realm failed\n" >&2
    exit 77
  }
fi
(
  for pair in "${user_env[@]}"; do
    export "$pair"
  done
  exec "$@"
) &
app=$!
wait_pids=("$app")
[[ -z "$bridge" ]] || wait_pids+=("$bridge")
[[ -z "$bus" ]] || wait_pids+=("$bus")
[[ -z "$portal" ]] || wait_pids+=("$portal")
[[ -z "$notification" ]] || wait_pids+=("$notification")
[[ -z "$status_notifier" ]] || wait_pids+=("$status_notifier")
[[ -z "$xwayland" ]] || wait_pids+=("$xwayland")
exited=
set +e
wait -n -p exited "${wait_pids[@]}"
rc=$?
set -e
if [[ "$exited" == "$app" ]]; then
  app=
  exit "$rc"
fi
helper=unknown
if [[ -n "$bridge" && "$exited" == "$bridge" ]]; then helper=network-proxy; bridge=; fi
if [[ -n "$bus" && "$exited" == "$bus" ]]; then helper=session-bus; bus=; fi
if [[ -n "$portal" && "$exited" == "$portal" ]]; then helper=private-desktop-portal; portal=; fi
if [[ -n "$notification" && "$exited" == "$notification" ]]; then helper=private-notification-service; notification=; fi
if [[ -n "$status_notifier" && "$exited" == "$status_notifier" ]]; then helper=private-status-notifier-service; status_notifier=; fi
if [[ -n "$xwayland" && "$exited" == "$xwayland" ]]; then helper=xwayland-satellite; xwayland=; fi
printf "sandcodex desktop app launcher: trusted %s helper exited while the application was active\n" "$helper" >&2
terminate_child "$app"
wait "$app" 2>/dev/null || true
app=
exit 78
' sandcodex-app-supervisor "$network_enabled" "$private_bus" "$x11_enabled" "$portal_enabled" "$notification_enabled" "$status_notifier_enabled" \
    "${SANDCODEX_APP_SOCAT:-}" "$SANDCODEX_APP_BASH" "${SANDCODEX_APP_DBUS_DAEMON:-}" \
    "${SANDCODEX_APP_PYTHON:-}" /run/sandcodex-app-launch/private-file-portal.py \
    "$portal_access" "$open_uri_policy" "$open_uri_policy_sha256" \
    "$open_file_policy" "$open_file_policy_sha256" \
    "$open_directory_policy" "$open_directory_policy_sha256" \
    /run/sandcodex-app-launch/private-notification-service.py "$notification_access" \
    "$([[ $notification_enabled == 1 ]] && printf /run/sandcodex-app/notification-surface-token)" \
    /run/sandcodex-app-launch/private-status-notifier-service.py "$status_notifier_access" \
    "$([[ $status_notifier_enabled == 1 ]] && printf /run/sandcodex-app/status-surface-token)" \
    "${SANDCODEX_APP_XWAYLAND_SATELLITE:-}" "${SANDCODEX_APP_XAUTH:-}" \
    "${SANDCODEX_APP_MCOOKIE:-}" "$x11_display" "$SANDCODEX_APP_BWRAP" \
    "$env_count" "${env_pairs[@]}" "$@"
else
  "$SANDCODEX_APP_BWRAP" "${args[@]}" -- "$@"
fi
rc=$?
if [[ -n "$notification_surface_fd" ]]; then
  exec {notification_surface_fd}<&-
fi
if [[ -n "$status_surface_fd" ]]; then
  exec {status_surface_fd}<&-
fi
set -e
exit "$rc"
SANDCODEX_DESKTOP_APP_LAUNCHER
}

