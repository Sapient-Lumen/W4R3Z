+    struct wl_client *target_client = wl_resource_get_client(
+        target_surface->resource);
+    if (!target_client || pointer->focused_surface != target_surface ||
+            !pointer->focused_client ||
+            pointer->focused_client->seat != seat->wlr_seat ||
+            pointer->focused_client->client != target_client ||
+            !sandcodex_stylus_route_quiet(client, seat, target_surface,
+                expected_pointer_grab_address,
+                expected_pointer_default_grab_address,
+                expected_pointer_client_address)) {
+        return false;
+    }
+    if (target_surface_out) {
+        *target_surface_out = target_surface;
+    }
+    if (pointer_client_out) {
+        *pointer_client_out = pointer->focused_client;
+    }
+    if (target_client_out) {
+        *target_client_out = target_client;
+    }
