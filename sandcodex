+static bool sandcodex_capture_touch_target(struct sway_seat *seat,
+		double x, double y, struct sandcodex_hit_target *target,
+		struct sway_view **view_out, struct wlr_surface **view_surface_out,
+		struct wlr_surface **target_surface_out,
+		struct wlr_seat_client **seat_client_out,
+		double *sx_out, double *sy_out) {
+	if (seat_client_out) {
+		*seat_client_out = NULL;
+	}
+	if (!seat || !seat->wlr_seat || seat->focused_layer ||
+			seat->has_exclusive_layer || server.session_lock.lock ||
+			!sandcodex_touch_default_route(seat, 0, 0)) {
+		return false;
+	}
+	struct wlr_surface *target_surface = NULL;
+	double sx = 0, sy = 0;
+	if (!sandcodex_capture_hit_target_with_coords(seat, x, y, target,
+			view_out, view_surface_out, &target_surface, &sx, &sy) ||
+			!target->hit || !target->surface_hit || !target_surface ||
+			!target_surface->resource ||
+			!seat_is_input_allowed(seat, target_surface) ||
+			!wlr_surface_accepts_touch(target_surface, seat->wlr_seat)) {
+		return false;
+	}
+	struct wl_client *wl_client =
+		wl_resource_get_client(target_surface->resource);
+	struct wlr_seat_client *seat_client = wl_client
+		? wlr_seat_client_for_wl_client(seat->wlr_seat, wl_client) : NULL;
+	if (!seat_client || seat_client->seat != seat->wlr_seat ||
+			seat_client->client != wl_client) {
+		return false;
+	}
+	if (target_surface_out) {
+		*target_surface_out = target_surface;
+	}
+	if (seat_client_out) {
+		*seat_client_out = seat_client;
+	}
+	if (sx_out) {
+		*sx_out = sx;
+	}
+	if (sy_out) {
+		*sy_out = sy;
+	}
+	return true;
+}
