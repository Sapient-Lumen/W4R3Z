          .probes.exact_model_step_replay==true and
          .probes.semantic_pair_validation==true and
          .probes.cross_model_exact_state_replay==true and
          .probes.pending_tool_model_failover==true and
          .probes.offline_protocol_matrix==true and
          .probes.route_wait_scheduler==true and
          .probes.credential_standby_scheduler==true and
          .probes.quota_key_rotation_scheduler==true and
          .probes.bounded_request_retry_budget==true and
          .probes.quota_scope_classifier==true and
          .probes.branch_local_schema_normalization==true and
          .probes.structured_output==true and
          .probes.multimodal_image_audio==true and
          .probes.parallel_function_calls==true and
          .probes.custom_tool_projection==true and
          .probes.namespaced_tool_projection==true and
          .probes.deferred_tool_search_projection==true and
          .probes.deferred_tool_materialization==true) or
        ((.qualification_probe_revision=="gemini-responses-qualification-v10" or
          .qualification_probe_revision=="gemini-responses-qualification-v11" or
          .qualification_probe_revision=="gemini-responses-qualification-v12") and
          .codex_version==$codex and (.network_requests|type)=="number" and
          .network_requests>=5 and .network_requests<=160 and
          .probes.exact_model_step_replay==true and
          .probes.semantic_pair_validation==true and
          .probes.cross_model_exact_state_replay==true and
          .probes.pending_tool_model_failover==true and
          .probes.offline_protocol_matrix==true and
          .probes.route_wait_scheduler==true and
          .probes.credential_standby_scheduler==true and
          .probes.quota_key_rotation_scheduler==true and
          .probes.bounded_request_retry_budget==true and
          .probes.quota_scope_classifier==true and
          .probes.branch_local_schema_normalization==true and
          .probes.structured_output==true and
          .probes.multimodal_image_audio==true and
          .probes.parallel_function_calls==true and
          .probes.custom_tool_projection==true and
          .probes.namespaced_tool_projection==true and
          .probes.deferred_tool_search_projection==true and
          .probes.deferred_tool_materialization==true and
          .scheduler.policy=="strongest-model-first-account-key-rotation" and
          .scheduler.account_start_policy=="per-logical-request-round-robin" and
          .scheduler.quota_key_rotation==true and
          .scheduler.rotation_target_accounts==5 and
          (if .qualification_probe_revision=="gemini-responses-qualification-v12" then
             .probes.shared_account_scheduler==true and
             .probes.success_cooldown_healing==true and
             .probes.causal_success_cooldown_healing==true and
             .scheduler.coordination_scope=="cross-process-shared-ledger" and
             .scheduler.balancing_policy=="least-scheduled-healthy-account-v1"
           else true end))
      )
    ' "$receipt" >/dev/null
}

sc_gemini_adapter_qualify() {
  local cache_root cache receipt token tmp headers health_response text_body text_response tool1 tool1_response tool2 tool2_response
  local structured structured_response parallel parallel_response qualification_health qualification_scheduler_summary
  local qualification_network_requests
  local code actual_model key_id result sha project_receipt error_code
  cache_root="$SC_GLOBAL/remote/gemini-adapter-qualifications"
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  sc_ensure_dir "$cache_root" "Gemini adapter qualification cache"
  cache="$cache_root/$SC_GEMINI_SNAPSHOT_SHA256.json"
  if (( SC_GEMINI_BOUND_QUALIFICATION )); then
    [[ -n "$SC_GEMINI_QUALIFICATION" && -n "$SC_GEMINI_QUALIFICATION_SHA256" ]] ||
      sc_die "bound Gemini qualification metadata is incomplete" 78
    sc_owned_single_file "$SC_GEMINI_QUALIFICATION" 600 "bound Gemini qualification receipt"
    [[ "$(sha256sum -- "$SC_GEMINI_QUALIFICATION" | awk '{print $1}')" == "$SC_GEMINI_QUALIFICATION_SHA256" ]] ||
      sc_die "bound Gemini qualification receipt changed" 78
    sc_gemini_adapter_bound_qualification_valid "$SC_GEMINI_QUALIFICATION" ||
      sc_die "bound Gemini qualification receipt is invalid" 78
    receipt=$SC_GEMINI_QUALIFICATION
    SC_GEMINI_QUALIFICATION_REUSED=1
    sc_note "gemini · bound adapter multimodal/schema/tool/state qualification verified · no probe request"
  elif (( ! SC_GEMINI_FORCE )) && [[ -f "$cache" && ! -L "$cache" ]] && sc_gemini_adapter_qualification_valid "$cache"; then
    receipt=$cache
    SC_GEMINI_QUALIFICATION_REUSED=1
    sc_note "gemini · cached adapter multimodal/schema/tool/state qualification reused · no probe request"
  else
    SC_GEMINI_QUALIFICATION_REUSED=0
    tmp="$(mktemp -d "$SC_GLOBAL/runtime/.gemini-adapter-qualify.XXXXXX")"
    chmod 700 -- "$tmp"
    token="$(<"$SC_GEMINI_ADAPTER_TOKEN_FILE")"
    health_response="$tmp/health.json"
    code="$(curl -sS --max-time 10 -o "$health_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" \
      "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/health")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter health qualification transport failed" 78;
    }
    if [[ "$code" != 200 ]] || ! jq -e --arg route "$SC_MODEL" --argjson wait "$SC_GEMINI_ROUTE_WAIT_SECONDS" '
        .schema=="sandcodex.gemini-responses-adapter.v1" and .status=="ready" and
        .route_wait_seconds==$wait and .waiting_requests==0 and
        .routing_model==$route and .credential_values_disclosed==false and
        .raw_provider_content_disclosed==false' "$health_response" >/dev/null; then
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter health qualification failed" 78;
    fi
    headers="$tmp/headers"
    text_body="$tmp/text.json"; text_response="$tmp/text-response.sse"
    jq -n --arg model "$SC_MODEL" '{model:$model,store:false,stream:true,
      input:[{type:"message",role:"user",content:[{type:"input_text",text:"Reply with exactly: sandcodex gemini adapter ok"}]}],
      reasoning:{effort:"low",summary:"auto"}}' >"$text_body"
    code="$(curl -sS --max-time 240 -D "$headers" -o "$text_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' -H 'Accept: text/event-stream' \
      --data-binary "@$text_body" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1/responses")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter text qualification transport failed" 78;
    }
    if [[ "$code" != 200 ]]; then
      error_code="$(jq -r '.error.code // "unclassified"' "$text_response" 2>/dev/null || printf unclassified)"
      token=""; rm -rf -- "$tmp"
      sc_die "Gemini adapter text qualification failed (HTTP $code · $error_code)" 78
    fi
    sed -n '/^data: \[DONE\]$/d; s/^data: //p' "$text_response" | jq -se '
      any(.[]; .type=="response.created") and
      any(.[]; .type=="response.output_text.delta") and
      any(.[]; .type=="response.completed") and
      ([.[] | select(.type=="response.output_text.delta") | .delta] | join("") |
       contains("sandcodex gemini adapter ok"))' >/dev/null || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter text-stream qualification returned unexpected semantics" 78;
    }
    actual_model="$(sed -n 's/^x-sandcodex-gemini-model: *//Ip' "$headers" | tr -d '\r' | tail -n1)"
    key_id="$(sed -n 's/^x-sandcodex-gemini-key-id: *//Ip' "$headers" | tr -d '\r' | tail -n1)"
    [[ "$actual_model" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$ && "$key_id" =~ ^[0-9a-f]{12}$ ]] || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter qualification omitted route identity" 78;
    }

    tool1="$tmp/tool1.json"; tool1_response="$tmp/tool1-response.json"
    jq -n --arg model "$SC_MODEL" '{model:$model,store:false,stream:false,
      input:[{type:"message",role:"user",content:[{type:"input_text",text:"Call sandcodex_probe_sum with a=19 and b=23. Do not answer without the tool."}]}],
      tools:[{type:"function",name:"sandcodex_probe_sum",description:"Add two integers.",strict:true,
        parameters:{type:"object",properties:{a:{type:"integer"},b:{type:"integer"},
          optional_payload:{type:"object",oneOf:[
            {required:["kind","text"],properties:{kind:{const:"text"}}},
            {required:["kind","path"],properties:{kind:{const:"file"}}}],
            properties:{kind:{enum:["text","file"]},text:{type:"string"},path:{type:"string"}},
            additionalProperties:false}},required:["a","b"],additionalProperties:false}}],
      tool_choice:{type:"function",name:"sandcodex_probe_sum"},reasoning:{effort:"low",summary:"auto"}}' >"$tool1"
    code="$(curl -sS --max-time 240 -o "$tool1_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data-binary "@$tool1" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1/responses")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter function qualification transport failed" 78;
    }
    if [[ "$code" != 200 ]]; then
      error_code="$(jq -r '.error.code // "unclassified"' "$tool1_response" 2>/dev/null || printf unclassified)"
      token=""; rm -rf -- "$tmp"
      sc_die "Gemini adapter function qualification failed (HTTP $code · $error_code)" 78
    fi
    jq -e 'any(.output[]?; .type=="function_call" and .name=="sandcodex_probe_sum" and (.call_id|type)=="string") and
      any(.output[]?; .type=="reasoning" and (.encrypted_content|startswith("scg1.")))' "$tool1_response" >/dev/null || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter did not preserve its tool/reasoning state" 78;
    }
    tool2="$tmp/tool2.json"; tool2_response="$tmp/tool2-response.json"
    jq -n --arg model "$SC_MODEL" --slurpfile prior "$tool1_response" --slurpfile request "$tool1" '
      ($prior[0].output | map(select(.type=="reasoning" or .type=="function_call" or .type=="message"))) as $out |
      ($out | map(select(.type=="function_call"))[0].call_id) as $call |
      {model:$model,store:false,stream:false,
       input:($request[0].input + $out + [{type:"function_call_output",call_id:$call,name:"sandcodex_probe_sum",output:"{\"sum\":42}"}]),
       tools:$request[0].tools,reasoning:{effort:"low",summary:"auto"}}' >"$tool2"
    code="$(curl -sS --max-time 240 -o "$tool2_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data-binary "@$tool2" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1/responses")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter function-result qualification transport failed" 78;
    }
    if [[ "$code" != 200 ]]; then
      error_code="$(jq -r '.error.code // "unclassified"' "$tool2_response" 2>/dev/null || printf unclassified)"
      token=""
      rm -rf -- "$tmp"
      sc_die "Gemini adapter function-result qualification failed (HTTP $code · $error_code)" 78
    fi
    jq -e 'any(.output[]?; .type=="message" and any(.content[]?; .type=="output_text" and (.text|type)=="string"))' \
      "$tool2_response" >/dev/null || { rm -rf -- "$tmp"; sc_die "Gemini adapter function-result continuation produced no model output" 78; }

    structured="$tmp/structured.json"; structured_response="$tmp/structured-response.json"
    jq -n --arg model "$SC_MODEL" \
      --arg image 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9Wl2ZJkAAAAASUVORK5CYII=' \
      --arg audio 'data:audio/wav;base64,UklGRnQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YVAAAACAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgA==' \
      '{model:$model,store:false,stream:false,
        input:[{type:"message",role:"user",content:[
          {type:"input_text",text:"These are tiny transport fixtures: one image and one silent WAV. Return JSON with accepted set to true."},
          {type:"input_image",image_url:$image},{type:"input_audio",audio_url:$audio}]}],
        text:{format:{type:"json_schema",name:"sandcodex_multimodal_probe",strict:true,
          schema:{type:"object",properties:{accepted:{type:"boolean"}},required:["accepted"],additionalProperties:false}}},
        reasoning:{effort:"low",summary:"none"}}' >"$structured"
    code="$(curl -sS --max-time 240 -o "$structured_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data-binary "@$structured" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1/responses")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter multimodal structured-output qualification transport failed" 78;
    }
    if [[ "$code" != 200 ]]; then
      error_code="$(jq -r '.error.code // "unclassified"' "$structured_response" 2>/dev/null || printf unclassified)"
      token=""; rm -rf -- "$tmp"
      sc_die "Gemini adapter multimodal structured-output qualification failed (HTTP $code · $error_code)" 78
    fi
    jq -e '([.output[]? | select(.type=="message") | .content[]? |
      select(.type=="output_text") | .text] | join("")) as $text |
      try (($text | fromjson) | .accepted == true) catch false' "$structured_response" >/dev/null || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter structured-output qualification returned unexpected semantics" 78;
    }

    parallel="$tmp/parallel.json"; parallel_response="$tmp/parallel-response.json"
    jq -n --arg model "$SC_MODEL" '{model:$model,store:false,stream:false,
      input:[{type:"message",role:"user",content:[{type:"input_text",
        text:"Make exactly two independent calls in this response: call sandcodex_probe_left once with value=17 and sandcodex_probe_right once with value=25. Do not answer in text."}]}],
      tools:[
        {type:"function",name:"sandcodex_probe_left",description:"Record the left integer.",strict:true,
          parameters:{type:"object",properties:{value:{type:"integer"}},required:["value"],additionalProperties:false}},
        {type:"function",name:"sandcodex_probe_right",description:"Record the right integer.",strict:true,
          parameters:{type:"object",properties:{value:{type:"integer"}},required:["value"],additionalProperties:false}}],
      tool_choice:"required",reasoning:{effort:"low",summary:"auto"}}' >"$parallel"
    code="$(curl -sS --max-time 240 -o "$parallel_response" -w '%{http_code}' \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data-binary "@$parallel" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1/responses")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter parallel-function qualification transport failed" 78;
    }
    token=""
    if [[ "$code" != 200 ]]; then
      error_code="$(jq -r '.error.code // "unclassified"' "$parallel_response" 2>/dev/null || printf unclassified)"
      rm -rf -- "$tmp"
      sc_die "Gemini adapter parallel-function qualification failed (HTTP $code · $error_code)" 78
    fi
    jq -e '
      ([.output[]? | select(.type=="function_call") | .name] | sort) ==
        ["sandcodex_probe_left","sandcodex_probe_right"] and
      any(.output[]?; .type=="function_call" and .name=="sandcodex_probe_left" and
        (try ((.arguments|fromjson).value == 17) catch false)) and
      any(.output[]?; .type=="function_call" and .name=="sandcodex_probe_right" and
        (try ((.arguments|fromjson).value == 25) catch false))' "$parallel_response" >/dev/null || {
      rm -rf -- "$tmp"; sc_die "Gemini adapter did not produce the required parallel function calls" 78;
    }
    qualification_health="$tmp/health-final.json"
    token="$(<"$SC_GEMINI_ADAPTER_TOKEN_FILE")"
    code="$(curl -sS --max-time 10 -o "$qualification_health" -w '%{http_code}' \
      -H "Authorization: Bearer $token" \
      "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/health")" || {
      token=""; rm -rf -- "$tmp"; sc_die "Gemini adapter scheduler qualification transport failed" 78;
    }
    token=""
    qualification_scheduler_summary="$(jq -c '{requests,successes,failovers,
      scheduler:{policy:.scheduler.policy,
        account_start_policy:.scheduler.account_start_policy,
        coordination_scope:.scheduler.coordination_scope,
        balancing_policy:.scheduler.balancing_policy,
        account_cursor_assignments:.scheduler.account_cursor_assignments,
        shared_account_assignments:.scheduler.shared_account_assignments,
        continuation_policy:.scheduler.continuation_policy,
        quota_scope:.scheduler.quota_scope,
        quota_key_rotation:.scheduler.quota_key_rotation,
        rotation_target_accounts:.scheduler.rotation_target_accounts,
        keys:[.scheduler.keys[]|{key_id,schedule_starts,attempts,successes,failures}],
        models:[.scheduler.models[]|{model,rank,attempts,successes,failures}]}}' \
      "$qualification_health" 2>/dev/null || printf '{"status":"unreadable"}')"
    if [[ "$code" != 200 ]] || ! jq -e '
        .schema=="sandcodex.gemini-responses-adapter.v1" and
        .requests==5 and .successes==5 and
        .scheduler.policy=="strongest-model-first-account-key-rotation" and
        .scheduler.account_start_policy=="per-logical-request-round-robin" and
        .scheduler.coordination_scope=="cross-process-shared-ledger" and
        .scheduler.balancing_policy=="least-scheduled-healthy-account-v1" and
        .scheduler.account_cursor_assignments==5 and
        .scheduler.continuation_policy=="origin-first-then-ranked-model-failover" and
        .scheduler.quota_scope=="account-key-or-account-model-route" and
        .scheduler.quota_key_rotation==true and
        .scheduler.rotation_target_accounts==5 and
        (.scheduler.keys|type)=="array" and (.scheduler.keys|length)>=1 and
        ([.scheduler.keys[].schedule_starts]|add)>=5 and
        ([.scheduler.keys[].schedule_starts]|add)<=([.scheduler.keys[].attempts]|add) and
        ([.scheduler.keys[].attempts]|add)>=5 and
        ([.scheduler.keys[].attempts]|add)<=160 and
        ([.scheduler.keys[].successes]|add)==5 and
        .credential_values_disclosed==false and .raw_provider_content_disclosed==false
      ' "$qualification_health" >/dev/null; then
      rm -rf -- "$tmp"
      sc_die "Gemini adapter account-rotation scheduler qualification failed: $qualification_scheduler_summary" 78
    fi
    qualification_network_requests="$(jq -r '[.scheduler.keys[].attempts]|add' "$qualification_health")"
    result="$(jq -cn \
      --arg schema sandcodex.gemini-adapter-qualification.v1 \
      --arg descriptor "$SC_GEMINI_SNAPSHOT_SHA256" --arg adapter "$SC_GEMINI_ADAPTER_SHA256" \
      --arg qualified_at "$(sc_now)" --arg model "$actual_model" --arg key_id "$key_id" \
      --arg codex "$SC_CODEX_VERSION" --arg revision "$SC_GEMINI_QUALIFICATION_REVISION" \
      --argjson network_requests "$qualification_network_requests" \
      --slurpfile health "$qualification_health" '
      {schema:$schema,result:"qualified",descriptor_sha256:$descriptor,adapter_sha256:$adapter,
       codex_version:$codex,api_version:"v1",wire_api:"responses",qualified_at:$qualified_at,
       qualification_probe_revision:$revision,
       sampled_route:{model:$model,key_id:$key_id},network_requests:$network_requests,
       probes:{offline_self_test:true,health:true,text_stream:true,function_call:true,
               stateless_function_result:true,reasoning_state:true,
               exact_model_step_replay:true,semantic_pair_validation:true,
               cross_model_exact_state_replay:true,
               pending_tool_model_failover:true,
               offline_protocol_matrix:true,route_wait_scheduler:true,
               credential_standby_scheduler:true,
               quota_key_rotation_scheduler:true,
               shared_account_scheduler:true,
               success_cooldown_healing:true,
               causal_success_cooldown_healing:true,
               bounded_request_retry_budget:true,
               quota_scope_classifier:true,
               branch_local_schema_normalization:true,
               structured_output:true,
               multimodal_image_audio:true,parallel_function_calls:true,
               custom_tool_projection:true,namespaced_tool_projection:true,
               deferred_tool_search_projection:true,
               deferred_tool_materialization:true},
       scheduler:$health[0].scheduler,
       credential_values_disclosed:false,raw_provider_content_disclosed:false,prompt_disclosed:false}')"
    printf '%s\n' "$result" | sc_atomic "$cache" 600
    receipt=$cache
    rm -rf -- "$tmp"
    sc_note "gemini · Responses text, multimodal schema, parallel tools, and stateless continuity qualified · 5 bounded requests"
  fi
  sha="$(sha256sum -- "$receipt" | awk '{print $1}')"
  sc_ensure_dir "$SC_CONTROL/gemini-qualifications" "project Gemini qualification receipts"
  project_receipt="$SC_CONTROL/gemini-qualifications/$sha.json"
  if [[ -e "$project_receipt" || -L "$project_receipt" ]]; then
    sc_owned_single_file "$project_receipt" 600 "project Gemini qualification receipt"
    cmp -s -- "$receipt" "$project_receipt" || sc_die "project Gemini qualification receipt conflicts" 78
  else
    sc_atomic "$project_receipt" 600 <"$receipt"
  fi
  if (( SC_GEMINI_BOUND_QUALIFICATION )); then
    sc_gemini_adapter_bound_qualification_valid "$project_receipt" ||
      sc_die "bound Gemini adapter qualification receipt is invalid" 78
  else
    sc_gemini_adapter_qualification_valid "$project_receipt" ||
      sc_die "Gemini adapter qualification receipt is invalid" 78
  fi
  SC_GEMINI_QUALIFICATION=$project_receipt
  SC_GEMINI_QUALIFICATION_SHA256=$sha
}

sc_family_prepare_gemini() {
  if [[ -n "${SANDCODEX_GEMINI_PARENT_CONTRACT:-}" ]]; then
    sc_family_prepare_inherited_gemini
    return
  fi
  sc_gemini_adapter_prepare_snapshot
  sc_gemini_adapter_start
  sc_gemini_adapter_qualify
  sc_gemini_adapter_configure_codex
}

sc_gemini_key_default_path() {
  printf '%s\n' "$SC_GLOBAL/remote/$SC_GEMINI_KEY_FILE_NAME"
}

sc_gemini_keybank_default_path() {
  printf '%s\n' "$SC_GLOBAL/remote/$SC_GEMINI_KEY_BANK_FILE_NAME"
}

sc_gemini_key_path() {
  local path="${SC_GEMINI_KEY_PATH:-}"
  [[ -n "$path" ]] || path="$(sc_gemini_key_default_path)"
  if [[ "$path" != /* ]]; then
    path="$(realpath -m -- "$path")"
  fi
  printf '%s\n' "$path"
}

sc_gemini_keybank_path() {
  local path="${SC_GEMINI_KEYBANK_PATH:-}"
  [[ -n "$path" ]] || path="$(sc_gemini_keybank_default_path)"
  if [[ "$path" != /* ]]; then
    path="$(realpath -m -- "$path")"
  fi
  printf '%s\n' "$path"
}

sc_gemini_model_slug() {
  local model="${1:-$SC_GEMINI_MODEL}"
  model="${model#models/}"
  [[ "$model" =~ ^[A-Za-z0-9._:-]+$ ]] || sc_die "Gemini model contains unsupported characters" 64
  printf '%s\n' "$model"
}

sc_gemini_model_resource() {
  printf 'models/%s\n' "$(sc_gemini_model_slug "${1:-$SC_GEMINI_MODEL}")"
}

sc_gemini_free_models() {
  printf '%s\n' \
    gemini-3.8-flash \
    gemini-3.7-flash \
    gemini-3.6-flash \
    gemini-3.5-flash \
    gemini-3.5-flash-lite \
    gemini-3.1-flash-lite \
    gemini-3.1-flash-lite-preview \
    gemini-3-flash-preview
}

sc_gemini_free_models_json() {
  sc_gemini_free_models | jq -Rsc 'split("\n") | map(select(length > 0))'
}

sc_gemini_free_model_allowed() {
  local model candidate
  model="$(sc_gemini_model_slug "$1")"
  while IFS= read -r candidate; do
    [[ "$candidate" == "$model" ]] && return 0
  done < <(sc_gemini_free_models)
  return 1
}

sc_gemini_require_free_model() {
  local model
  model="$(sc_gemini_model_slug "$1")"
  if (( SC_GEMINI_FREE_ONLY )) && ! sc_gemini_free_model_allowed "$model"; then
    sc_die "Gemini model $model is not in Sandcodex's free-tier-model-only allowlist" 78
  fi
}

sc_gemini_candidate_models() {
  if (( SC_GEMINI_MODEL_EXPLICIT )); then
    sc_gemini_model_slug "$SC_GEMINI_MODEL"
    return
  fi
  printf '%s\n' \
    gemini-3.8-flash \
    gemini-3.7-flash \
    gemini-3.6-flash \
    gemini-3.5-flash \
    gemini-3.5-flash-lite \
    gemini-3.1-flash-lite
}

sc_gemini_read_key_file() {
  local path=$1 key
  sc_no_symlink_components "$path" "Gemini API key"
  sc_owned_single_file "$path" 600 "Gemini API key"
  key="$(python3 -P - "$path" <<'PY'
import sys
from pathlib import Path

print(Path(sys.argv[1]).read_text(encoding="utf-8").strip())
PY
)"
  [[ "$key" =~ ^(AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})$ ]] ||
    sc_die "Gemini API key has an unsupported shape" 78
  printf '%s\n' "$key"
}

sc_gemini_keybank_stage() {
  local path single_path source stage metadata rc=0
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  if [[ -n "$SC_GEMINI_KEY_PATH" ]]; then
    single_path="$(sc_gemini_key_path)"
    [[ -f "$single_path" ]] || sc_die "Gemini API key file is missing: $single_path" 78
    path="$single_path"
    source="single-key-file"
  else
    path="$(sc_gemini_keybank_path)"
    if [[ -n "$SC_GEMINI_KEYBANK_PATH" || -f "$path" ]]; then
      [[ -f "$path" ]] || sc_die "Gemini key bank is missing: $path" 78
      source="key-bank"
    else
      single_path="$(sc_gemini_key_path)"
      [[ -f "$single_path" ]] || sc_die "Gemini key bank is missing: $path; fallback key file is missing: $single_path" 78
      path="$single_path"
      source="single-key-file"
    fi
  fi
  sc_no_symlink_components "$path" "Gemini key material"
  sc_owned_single_file "$path" 600 "Gemini key material"
  stage="$(mktemp -d "$SC_GLOBAL/runtime/.gemini-keybank.XXXXXX")"
  chmod 700 -- "$stage"
  metadata="$(python3 -P - "$path" "$stage" "$source" <<'PY'
import hashlib
import json
import os
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
stage = Path(sys.argv[2])
source = sys.argv[3]
key_re = re.compile(r"^(?:AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})$")
label_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")
rows = []
seen = set()
if source == "single-key-file":
    lines = [(1, path.read_text(encoding="utf-8").strip())]
else:
    lines = list(enumerate(path.read_text(encoding="utf-8").splitlines(), 1))
for number, raw in lines:
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    label = ""
    key = line
    if "=" in line and not line.startswith(("AIza", "AQ.")):
        maybe_label, maybe_key = line.split("=", 1)
        label = maybe_label.strip()
        key = maybe_key.strip()
    else:
        parts = line.split()
        if len(parts) == 2 and key_re.fullmatch(parts[1]):
            label, key = parts[0], parts[1]
    if not key_re.fullmatch(key):
        raise SystemExit(f"invalid Gemini API key on line {number}")
    if label and not label_re.fullmatch(label):
        raise SystemExit(f"invalid Gemini key label on line {number}")
    digest = hashlib.sha256(key.encode()).hexdigest()
    if digest in seen:
        continue
    seen.add(digest)
    index = len(rows) + 1
    if not label:
        label = f"key-{index:02d}"
    key_file = stage / f"key-{index:03d}"
    fd = os.open(key_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, key.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    rows.append({
        "index": index,
        "label": label,
        "key_sha256": digest,
        "key_id": digest[:12],
        "credential_file": str(key_file),
        "source_line": number,
    })
if not rows:
    raise SystemExit("Gemini key bank contains no keys")
print(json.dumps({
    "schema": "sandcodex.gemini-key-bank.v1",
    "result": "staged",
    "provider": "google-ai-studio",
    "path": str(path),
    "source": source,
    "stage": str(stage),
    "key_count": len(rows),
    "keys": rows,
    "credential_values_disclosed": False,
}, sort_keys=True, separators=(",", ":")))
PY
  )" || rc=$?
  if (( rc != 0 )); then
    [[ -z "${stage:-}" ]] || rm -rf -- "$stage" 2>/dev/null || true
    sc_die "Gemini key material could not be staged" 78
  fi
  jq -e '.schema=="sandcodex.gemini-key-bank.v1" and (.keys|type)=="array" and .key_count == (.keys|length)' \
    <<<"$metadata" >/dev/null || sc_die "Gemini key-bank helper returned invalid metadata" 78
  printf '%s\n' "$metadata"
}

sc_gemini_keybank_unstage() {
  local staged=$1 stage
  stage="$(jq -r '.stage // empty' <<<"$staged" 2>/dev/null || true)"
  case "$stage" in
    "$SC_GLOBAL"/runtime/.gemini-keybank.*)
      find "$stage" -maxdepth 1 -type f -name 'key-[0-9][0-9][0-9]' -exec rm -f -- {} + 2>/dev/null || true
      rmdir -- "$stage" 2>/dev/null || true
      ;;
  esac
}

sc_gemini_cooldowns_path() {
  printf '%s\n' "$SC_GLOBAL/remote/gemini-cooldowns.json"
}

sc_gemini_cooldowns_json() {
  local path data rc=0
  path="$(sc_gemini_cooldowns_path)"
  if [[ -e "$path" || -L "$path" ]]; then
    sc_no_symlink_components "$path" "Gemini cooldown ledger"
    sc_owned_single_file "$path" 600 "Gemini cooldown ledger"
  fi
  data="$(python3 -P - "$path" <<'PY'
import json, re, sys
from datetime import datetime, timezone
from pathlib import Path

SCHEMA = "sandcodex.gemini-cooldowns.v1"
LEGACY_MODEL_QUOTA_REASONS = {"quota", "rate-limit", "daily-quota"}
EVENT_LIMIT = 64
SCHEDULER_LIMIT = 32
path = Path(sys.argv[1])
now = datetime.now(timezone.utc)

def parse_time(value):
    if not isinstance(value, str):
        return None
    try:
        if value.endswith("Z"):
            value = value[:-1] + "+00:00"
        parsed = datetime.fromisoformat(value)
        if parsed.tzinfo is None:
            return None
        return parsed.astimezone(timezone.utc)
    except (TypeError, ValueError, OverflowError):
        return None

def utc(value):
    return value.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

source = {"schema": SCHEMA, "keys": {}, "models": {}, "pairs": {}, "schedulers": {}}
if path.exists():
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"invalid Gemini cooldown ledger: {exc}")
    if not isinstance(loaded, dict) or loaded.get("schema") != SCHEMA:
        raise SystemExit("invalid Gemini cooldown ledger schema")
    source = loaded
value = {"schema": SCHEMA, "keys": {}, "models": {}, "pairs": {}, "schedulers": {}}
legacy_model_quota = []
for field in ("keys", "models", "pairs"):
    rows = source.get(field)
    if not isinstance(rows, dict):
        raise SystemExit(f"invalid Gemini cooldown ledger field: {field}")
    kept = {}
    for ident, row in rows.items():
        if not isinstance(ident, str) or not isinstance(row, dict):
            continue
        until = parse_time(row.get("until"))
        if until is not None and until > now:
            normalized = {
                "until": utc(until),
                "reason": str(row.get("reason") or "cooldown")[:240],
                "recorded_at": str(row.get("recorded_at") or "")[:32] or None,
            }
            if field == "models" and normalized["reason"] in LEGACY_MODEL_QUOTA_REASONS:
                legacy_model_quota.append({"model": ident, **normalized})
                continue
            kept[ident] = normalized
    value[field] = kept
schedulers = []
raw_schedulers = source.get("schedulers", {})
if not isinstance(raw_schedulers, dict):
    raise SystemExit("invalid Gemini cooldown scheduler state")
for identity, row in raw_schedulers.items():
    if (not isinstance(identity, str)
            or re.fullmatch(r"[0-9a-f]{16}", identity) is None
            or not isinstance(row, dict)):
        continue
    key_ids = row.get("key_ids")
    counts = row.get("assignments_by_key")
    assignments = row.get("assignments")
    updated = parse_time(row.get("updated_at"))
    if (not isinstance(key_ids, list) or not key_ids or len(key_ids) > 64
            or len(set(key_ids)) != len(key_ids)
            or any(not isinstance(key_id, str)
                   or re.fullmatch(r"[0-9a-f]{12}", key_id) is None
                   for key_id in key_ids)
            or not isinstance(counts, dict) or type(assignments) is not int
            or not 0 <= assignments <= 2**63 - 1 or updated is None):
        continue
    clean_counts = {}
    for key_id in key_ids:
        count = counts.get(key_id, 0)
        if type(count) is not int or not 0 <= count <= 2**63 - 1:
            break
        clean_counts[key_id] = count
    else:
        schedulers.append((updated, identity, {
            "key_ids": key_ids,
            "assignments_by_key": clean_counts,
            "assignments": assignments,
            "updated_at": utc(updated),
            "policy": "least-scheduled-healthy-account-v1",
        }))
schedulers.sort(key=lambda item: item[0])
value["schedulers"] = {
    identity: row for _updated, identity, row in schedulers[-SCHEDULER_LIMIT:]
}
route_events = []
for event in source.get("route_events", []):
    if not isinstance(event, dict):
        continue
    at = parse_time(event.get("at"))
    kind = event.get("event")
    if at is None or kind not in {"route-success", "route-failure", "cooldown-repair"}:
        continue
    row = {"at": utc(at), "event": kind}
    for field in ("model", "key_id", "category", "scope"):
        item = event.get(field)
        if isinstance(item, str) and item:
            row[field] = item[:192]
    route_events.append(row)
value["route_events"] = route_events[-EVENT_LIMIT:]
updated = parse_time(source.get("updated_at"))
if updated is not None:
    value["updated_at"] = utc(updated)
value["normalization"] = {
    "policy": "ignore-legacy-global-model-quota-v1",
    "legacy_model_quota_ignored": legacy_model_quota,
    "legacy_model_quota_ignored_count": len(legacy_model_quota),
    "read_only": True,
}
value["observed_at"] = utc(now)
value["credential_values_disclosed"] = False
value["raw_provider_content_disclosed"] = False
print(json.dumps(value, sort_keys=True, separators=(",", ":")))
PY
  )" || rc=$?
  (( rc == 0 )) || sc_die "Gemini cooldown ledger could not be read" 69
  printf '%s\n' "$data"
}
sc_gemini_cooldown_record() {
  local kind=$1 ident=$2 reason=$3 seconds=$4 path rc=0
  [[ "$kind" == keys || "$kind" == models || "$kind" == pairs ]] || return 0
  [[ -n "$ident" && "$seconds" =~ ^[1-9][0-9]{0,8}$ ]] || return 0
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  path="$(sc_gemini_cooldowns_path)"
  sc_gemini_cooldowns_json >/dev/null
  python3 -P - "$path" "$kind" "$ident" "$seconds" "$reason" <<'PY' || rc=$?
import fcntl, json, os, stat, sys, tempfile
from datetime import datetime, timezone, timedelta
from pathlib import Path

path = Path(sys.argv[1])
kind, ident, seconds, reason = sys.argv[2], sys.argv[3], int(sys.argv[4]), sys.argv[5]
now = datetime.now(timezone.utc)
until = now + timedelta(seconds=seconds)
lock_path = path.with_name(path.name + ".lock")
lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
try:
    metadata = os.fstat(lock_fd)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077):
        raise SystemExit("unsafe Gemini cooldown lock")
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    if path.exists():
        value = json.loads(path.read_text(encoding="utf-8"))
    else:
        value = {"schema": "sandcodex.gemini-cooldowns.v1", "keys": {}, "models": {}, "pairs": {}, "schedulers": {}}
    if value.get("schema") != "sandcodex.gemini-cooldowns.v1":
        raise SystemExit("invalid Gemini cooldown ledger schema")
    value.setdefault(kind, {})[ident] = {
        "until": until.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "reason": reason[:240] or "provider cooldown",
        "recorded_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    value["updated_at"] = now.strftime("%Y-%m-%dT%H:%M:%SZ")
    value.pop("observed_at", None)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(value, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
finally:
    fcntl.flock(lock_fd, fcntl.LOCK_UN)
    os.close(lock_fd)
PY
  (( rc == 0 )) || sc_warn "could not record Gemini cooldown for $kind/$ident"
}

sc_gemini_cooldown_clear_route() {
  local key_id=$1 model=$2 path rc=0
  [[ "$key_id" =~ ^[0-9a-f]{12}$ && -n "$model" ]] || return 0
  path="$(sc_gemini_cooldowns_path)"
  [[ -e "$path" || -L "$path" ]] || return 0
  sc_no_symlink_components "$path" "Gemini cooldown ledger"
  sc_owned_single_file "$path" 600 "Gemini cooldown ledger"
  python3 -P - "$path" "$key_id" "$model" <<'PY' || rc=$?
import fcntl, json, os, stat, sys, tempfile
from datetime import datetime, timezone
from pathlib import Path

path = Path(sys.argv[1])
key_id, model = sys.argv[2], sys.argv[3]
lock_path = path.with_name(path.name + ".lock")
lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
try:
    metadata = os.fstat(lock_fd)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
            or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077):
        raise SystemExit("unsafe Gemini cooldown lock")
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("schema") != "sandcodex.gemini-cooldowns.v1":
        raise SystemExit("invalid Gemini cooldown ledger schema")
    healed = 0
    for field, identity in (("keys", key_id), ("models", model),
                            ("pairs", f"{key_id}:{model}")):
        rows = value.setdefault(field, {})
        if isinstance(rows, dict) and rows.pop(identity, None) is not None:
            healed += 1
    if healed:
        now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        events = value.setdefault("route_events", [])
        if not isinstance(events, list):
            events = []
            value["route_events"] = events
        events.append({
            "at": now, "event": "route-success", "model": model,
            "key_id": key_id, "category": "healthy",
            "scope": f"cleared-{healed}-cooldowns",
        })
        del events[:-64]
        value["updated_at"] = now
        fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as stream:
                os.fchmod(stream.fileno(), 0o600)
                json.dump(value, stream, sort_keys=True, separators=(",", ":"))
                stream.write("\n")
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, path)
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass
finally:
    fcntl.flock(lock_fd, fcntl.LOCK_UN)
    os.close(lock_fd)
PY
  (( rc == 0 )) || sc_warn "could not heal Gemini cooldowns for the successful route"
}

sc_gemini_keybank_pick() {
  local staged=$1 cooldowns
  cooldowns="$(sc_gemini_cooldowns_json)"
  jq -c --arg label "$SC_GEMINI_KEY_LABEL" --argjson cooldowns "$cooldowns" --argjson ignore "$SC_GEMINI_IGNORE_COOLDOWNS" '
    [ .keys[]
      | select(($label == "") or (.label == $label))
      | select(($ignore == 1) or (($cooldowns.keys[.key_id] // null) == null))
    ] as $keys
    | if ($keys|length) == 0 then empty else $keys[0] end
  ' <<<"$staged"
}

sc_gemini_error_class() {
  local result=$1
  jq -r '
    (.http_code // 0) as $h |
    (.error.status // .error.code // "" | ascii_downcase) as $s |
    if $h == 429 or ($s|test("resource_exhausted|quota|rate")) then "quota"
    elif $h == 503 or ($s|test("unavailable|overload|demand")) then "transient"
    elif $h == 404 then "model-unavailable"
    elif $h == 401 or $h == 403 then "auth"
    elif $h >= 500 then "transient"
    elif $h >= 400 then "request"
    else "none" end
  ' <<<"$result"
}

sc_gemini_record_result_cooldowns() {
  local result=$1 class key_id model reason
  class="$(sc_gemini_error_class "$result")"
  key_id="$(jq -r '.key_id // empty' <<<"$result")"
  model="$(jq -r '.model // empty' <<<"$result")"
  if [[ "$class" == none ]]; then
    [[ -z "$key_id" || -z "$model" ]] || sc_gemini_cooldown_clear_route "$key_id" "$model"
    return 0
  fi
  reason="$(jq -r '"HTTP \(.http_code // "unknown") " + ((.error.status // .error.code // .stage // "provider-failure")|tostring)' <<<"$result")"
  case "$class" in
    quota)
      [[ -z "$key_id" || -z "$model" ]] ||
        sc_gemini_cooldown_record pairs "$key_id:$model" "$reason" "$SC_GEMINI_COOLDOWN_SECONDS"
      ;;
    transient)
      [[ -z "$key_id" || -z "$model" ]] ||
        sc_gemini_cooldown_record pairs "$key_id:$model" "$reason" "$SC_GEMINI_COOLDOWN_SECONDS"
      ;;
    model-unavailable)
      [[ -z "$model" ]] || sc_gemini_cooldown_record models "$model" "$reason" "$SC_GEMINI_MODEL_UNAVAILABLE_COOLDOWN_SECONDS"
      ;;
    auth)
      [[ -z "$key_id" ]] || sc_gemini_cooldown_record keys "$key_id" "$reason" "$SC_GEMINI_MODEL_UNAVAILABLE_COOLDOWN_SECONDS"
      ;;
  esac
}

sc_gemini_current_qualification_json() {
  local adapter_sha snapshot descriptor receipt qualified=false receipt_public=null
  if (( SC_GEMINI_MODEL_EXPLICIT )); then
    SC_GEMINI_AUTO=0
    SC_GEMINI_MODEL="$(sc_gemini_model_slug "$SC_GEMINI_MODEL")"
    sc_gemini_require_free_model "$SC_GEMINI_MODEL"
    SC_MODEL="$SC_GEMINI_MODEL"
  else
    SC_GEMINI_AUTO=1
    SC_MODEL="$SC_GEMINI_AUTO_MODEL"
  fi
  SC_MODEL_SET=1
  adapter_sha="$(sc_emit_gemini_responses_adapter | sha256sum | awk '{print $1}')"
  [[ "$adapter_sha" =~ ^[0-9a-f]{64}$ ]] || sc_die "could not derive the embedded Gemini adapter identity" 78
  snapshot="$(sc_gemini_adapter_snapshot_json "$adapter_sha")"
  descriptor="$(printf '%s\n' "$snapshot" | sha256sum | awk '{print $1}')"
  receipt="$SC_GLOBAL/remote/gemini-adapter-qualifications/$descriptor.json"
  SC_GEMINI_SNAPSHOT_SHA256=$descriptor
  SC_GEMINI_ADAPTER_SHA256=$adapter_sha
  if [[ -e "$receipt" || -L "$receipt" ]]; then
    sc_owned_single_file "$receipt" 600 "Gemini adapter qualification cache"
    if sc_gemini_adapter_qualification_valid "$receipt"; then
      qualified=true
      receipt_public="$(jq -c '{qualified_at,qualification_probe_revision,sampled_route,network_requests,probes,
        scheduler:{policy:.scheduler.policy,
          account_start_policy:.scheduler.account_start_policy,
          account_cursor_assignments:.scheduler.account_cursor_assignments,
          quota_key_rotation:.scheduler.quota_key_rotation,
          rotation_target_accounts:.scheduler.rotation_target_accounts,
          configured_accounts:.scheduler.configured_accounts,
          keys:[.scheduler.keys[]|{key_id,schedule_starts,attempts,successes,failures}],
          models:[.scheduler.models[]|{model,rank,attempts,successes,failures}]},
        credential_values_disclosed,raw_provider_content_disclosed,prompt_disclosed}' "$receipt")"
    fi
  fi
  jq -cn \
    --arg adapter_sha "$adapter_sha" --arg descriptor "$descriptor" --arg receipt "$receipt" \
    --argjson route_wait "$SC_GEMINI_ROUTE_WAIT_SECONDS" \
    --argjson snapshot "$snapshot" --argjson qualified "$qualified" --argjson receipt_public "$receipt_public" '
      {adapter_sha256:$adapter_sha,provider_descriptor_sha256:$descriptor,
       routing_model:$snapshot.routing_model,auto:$snapshot.auto,free_only:$snapshot.free_only,
       route_wait_seconds:$route_wait,
       request_ceiling_seconds:([$route_wait,120]|max),
       candidate_models:$snapshot.candidate_models,capabilities:$snapshot.capabilities,
       adapter:$snapshot.adapter,
       qualification:{current:$qualified,receipt_path:$receipt,
         receipt:(if $qualified then $receipt_public else null end)}}'
}

sc_gemini_status_json() {
  local key_path keybank_path active_path status base routing cooldowns free_models credential_arg qpath rc=0
  key_path="$(sc_gemini_key_path)"
  keybank_path="$(sc_gemini_keybank_path)"
  if [[ -n "$SC_GEMINI_KEY_PATH" ]]; then
    active_path="$key_path"
  elif [[ -n "$SC_GEMINI_KEYBANK_PATH" || -e "$keybank_path" || -L "$keybank_path" ]]; then
    active_path="$keybank_path"
  else
    active_path="$key_path"
  fi
  sc_no_symlink_components "$active_path" "Gemini key material"
  status="$(python3 -P - "$key_path" "$keybank_path" "${SC_GEMINI_KEY_PATH:+explicit-key}" "${SC_GEMINI_KEYBANK_PATH:+explicit-bank}" <<'PY'
import hashlib, json, os, re, stat, sys
from pathlib import Path

key_path = Path(sys.argv[1])
bank_path = Path(sys.argv[2])
explicit_key = bool(sys.argv[3])
explicit_bank = bool(sys.argv[4])
uid = os.getuid()
key_re = re.compile(r"^(?:AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})$")
label_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")

def file_status(path):
    row = {"path": str(path), "exists": path.exists() or path.is_symlink(), "usable": False,
           "reason": "missing", "mode": None, "bytes": None, "sha256_prefix": None}
    if path.exists() and not path.is_symlink() and path.is_file():
        st = path.stat()
        row.update({"mode": oct(stat.S_IMODE(st.st_mode))[2:].zfill(4), "bytes": st.st_size})
        try:
            data = path.read_text(encoding="utf-8")
            row["sha256_prefix"] = hashlib.sha256(data.encode()).hexdigest()[:16]
        except Exception:
            data = ""
        if st.st_uid != uid:
            row["reason"] = "owned-by-another-uid"
        elif st.st_nlink != 1:
            row["reason"] = "multiple-hardlinks"
        elif row["mode"] != "0600":
            row["reason"] = "mode-not-0600"
        else:
            row["reason"] = "ok"
            row["usable"] = True
    elif path.exists() or path.is_symlink():
        row["reason"] = "not-a-regular-nonsymlink-file"
    return row

def count_bank(path):
    rows, seen = [], set()
    status = file_status(path)
    if not status["usable"]:
        return status | {"key_count": 0, "keys": []}
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        label, key = "", line
        if "=" in line and not line.startswith(("AIza", "AQ.")):
            label, key = [p.strip() for p in line.split("=", 1)]
        else:
            parts = line.split()
            if len(parts) == 2 and key_re.fullmatch(parts[1]):
                label, key = parts[0], parts[1]
        if not key_re.fullmatch(key) or (label and not label_re.fullmatch(label)):
            status["usable"] = False
            status["reason"] = f"invalid-entry-line-{number}"
            return status | {"key_count": 0, "keys": []}
        digest = hashlib.sha256(key.encode()).hexdigest()
        if digest in seen:
            continue
        seen.add(digest)
        if not label:
            label = f"key-{len(rows)+1:02d}"
        rows.append({"index": len(rows)+1, "label": label, "key_id": digest[:12], "source_line": number})
    if not rows:
        status["usable"] = False
        status["reason"] = "no-keys"
    return status | {"key_count": len(rows), "keys": rows}

def single_key(path):
    status = file_status(path)
    key_id = None
    if status["usable"]:
        key = path.read_text(encoding="utf-8").strip()
        if key_re.fullmatch(key):
            key_id = hashlib.sha256(key.encode()).hexdigest()[:12]
        else:
            status["usable"] = False
            status["reason"] = "unsupported-key-shape"
    return status | {"key_count": 1 if status["usable"] else 0, "keys": ([{"index": 1, "label": "key-01", "key_id": key_id, "source_line": 1}] if key_id else [])}

if explicit_key:
    active = single_key(key_path) | {"source": "single-key-file"}
elif explicit_bank or bank_path.exists():
    active = count_bank(bank_path) | {"source": "key-bank"}
else:
    active = single_key(key_path) | {"source": "single-key-file"}

print(json.dumps({
    "schema": "sandcodex.gemini-status.v1",
    "result": "status",
    "provider": "google-ai-studio",
    "active": active,
    "key_file": str(key_path),
    "key_bank": str(bank_path),
    "key_available": bool(active.get("usable")),
    "key_reason": active.get("reason"),
    "key_count": active.get("key_count", 0),
    "free_only_default": True,
    "free_model_only_default": True,
    "free_model_allowlist": [],
    "credential_value_disclosed": False,
    "install_hint": "install -m 600 /path/to/gemini-keys.txt " + str(bank_path),
}, sort_keys=True, separators=(",", ":")))
PY
  )" || rc=$?
  (( rc == 0 )) || sc_die "Gemini status inspection failed" 78
  base=$status
  routing="$(sc_gemini_current_qualification_json)"
  cooldowns="$(sc_gemini_cooldowns_json)"
  free_models="$(sc_gemini_free_models_json)"
  qpath="$(jq -r '.active.path' <<<"$base")"
  if [[ "$(jq -r '.active.source' <<<"$base")" == key-bank ]]; then
    printf -v credential_arg ' --key-bank %q' "$qpath"
  else
    printf -v credential_arg ' --key-file %q' "$qpath"
  fi
  status="$(jq -cn \
    --argjson base "$base" --argjson routing "$routing" --argjson cooldowns "$cooldowns" \
    --argjson free_models "$free_models" --arg credential_arg "$credential_arg" \
    --argjson rotation_target "$SC_GEMINI_ROTATION_TARGET_ACCOUNTS" '
      def key_cooling($key): (($cooldowns.keys[$key] // null) != null);
      def route_cooling($key; $model):
        (($cooldowns.models[$model] // null) != null) or
        (($cooldowns.pairs[($key + ":" + $model)] // null) != null);
      [$base.active.keys[]? | select(key_cooling(.key_id) | not)] as $credentials |
      ($credentials[0] // null) as $primary |
      [$routing.candidate_models[]? as $model |
        $credentials[]? as $credential |
        select(route_cooling($credential.key_id; $model) | not) |
        {key_id:$credential.key_id,key_label:$credential.label,
         credential_role:(if $credential.index == 1 then "primary" else "rotation" end),
         model:$model}] as $available |
      ([$available[].model] | unique) as $usable_models |
      ([$available[].key_id] | unique) as $usable_key_ids |
      ([($cooldowns.keys // {}),($cooldowns.models // {}),($cooldowns.pairs // {})]
        | map(to_entries[]?.value.until) | sort | .[0] // null) as $next |
      $base + {
        free_model_allowlist:$free_models,
        routing:$routing,
        cooldowns:$cooldowns,
        route_availability:{
          total_models:($routing.candidate_models|length),
          usable_models:($usable_models|length),
