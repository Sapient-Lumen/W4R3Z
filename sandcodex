+static struct sway_input_device *sandcodex_single_virtual_pointer(
+		struct sway_seat *seat) {
+	if (!seat) {
+		return NULL;
+	}
+	struct sway_input_device *result = NULL;
+	struct sway_seat_device *seat_device = NULL;
+	wl_list_for_each(seat_device, &seat->devices, link) {
+		struct sway_input_device *input = seat_device->input_device;
+		if (!input || !input->wlr_device ||
+				input->wlr_device->type != WLR_INPUT_DEVICE_POINTER) {
+			continue;
+		}
+		if (result || !input->is_virtual || !input->identifier ||
+				!input->identifier[0] ||
+				strlen(input->identifier) > SANDCODEX_DEVICE_IDENTIFIER_LIMIT) {
+			return NULL;
+		}
+		result = input;
+	}
+	return result;
+}
