+	if (!ticket_matches) {
+		sandcodex_secure_clear(&expected_target, sizeof(expected_target));
+		sandcodex_secure_clear(expected_sx_bits, sizeof(expected_sx_bits));
+		sandcodex_secure_clear(expected_sy_bits, sizeof(expected_sy_bits));
