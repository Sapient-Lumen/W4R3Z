+		json_object_new_string(SANDCODEX_TOUCH_STROKE_TIME_SCOPE));
+	json_object_object_add(reply, "event_loop_scope",
+		json_object_new_string("one-sway-ipc-callback"));
+	json_object_object_add(reply, "start_x", json_object_new_int64(start_x));
+	json_object_object_add(reply, "start_y", json_object_new_int64(start_y));
+	json_object_object_add(reply, "end_x", json_object_new_int64(end_x));
+	json_object_object_add(reply, "end_y", json_object_new_int64(end_y));
