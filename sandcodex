int main(int argc, char **argv) {
    if (argc == 2 && strcmp(argv[1], "--version") == 0) {
        puts(AGENT_PROTOCOL);
        return 0;
    }
    if (argc == 2 && strcmp(argv[1], "--self-test") == 0) {
        return run_self_test();
    }
    if (argc != 5) {
        fputs("usage: wayland-clipboard-agent SELECTION PROFILE PAYLOAD_FD PAYLOAD_SIZE\n", stderr);
        return 64;
    }
    enum selection_target selection = SELECTION_CLIPBOARD;
    enum payload_profile profile = PROFILE_TEXT;
    uint64_t descriptor_value = 0U;
    uint64_t payload_value = 0U;
    if (!parse_selection(argv[1], &selection) ||
            !parse_profile(argv[2], &profile) ||
            (selection == SELECTION_PRIMARY && profile != PROFILE_TEXT) ||
            !parse_u64(argv[3], 3U, INT_MAX, &descriptor_value) ||
            !parse_u64(argv[4], 0U,
                profile == PROFILE_PNG ? MAX_PNG_PAYLOAD_BYTES :
                    (profile == PROFILE_FILES ? MAX_URI_LIST_PAYLOAD_BYTES :
                        MAX_TEXT_PAYLOAD_BYTES),
                &payload_value) ||
            (profile == PROFILE_PNG && payload_value < 57U) ||
            (profile == PROFILE_FILES && payload_value == 0U)) {
        fputs("sandcodex-wayland-clipboard-agent: invalid selection, profile, payload descriptor, or size\n", stderr);
        return 64;
    }
    const int payload_descriptor = (int)descriptor_value;
    const size_t payload_size = (size_t)payload_value;
    struct sigaction action = {0};
    action.sa_handler = on_signal;
    if (sigemptyset(&action.sa_mask) < 0 ||
            sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0) {
        perror("sandcodex-wayland-clipboard-agent: sigaction");
        return 70;
    }
    struct sigaction ignore = {0};
    ignore.sa_handler = SIG_IGN;
    if (sigemptyset(&ignore.sa_mask) < 0 || sigaction(SIGPIPE, &ignore, NULL) < 0) {
        perror("sandcodex-wayland-clipboard-agent: sigaction SIGPIPE");
        return 70;
    }
    bool payload_ascii = false;
    bool payload_exec_sealed = false;
    if (harden_process(payload_descriptor, payload_size, profile,
            &payload_ascii, &payload_exec_sealed) < 0) {
        perror("sandcodex-wayland-clipboard-agent: process hardening");
        return 70;
    }
    if (setvbuf(stdout, NULL, _IOLBF, 0U) != 0) {
        fputs("sandcodex-wayland-clipboard-agent: stdout buffering failed\n", stderr);
        return 70;
    }

    struct clipboard_state state = {
        .payload_descriptor = payload_descriptor,
        .payload_size = payload_size,
        .profile = profile,
        .selection = selection,
        .payload_ascii = payload_ascii,
        .payload_exec_sealed = payload_exec_sealed,
        .next_request_id = 0U,
    };
    for (size_t index = 0U; index < MAX_REQUESTS; index++) {
        state.pending[index].descriptor = -1;
    }
    if (initialize_wayland(&state) < 0) {
        perror("sandcodex-wayland-clipboard-agent: Wayland initialization");
        cleanup(&state);
        return 71;
    }
    printf("READY %s MANAGER %u SEATS %u SELECTION %s PROFILE %s PAYLOAD %zu EXECSEALED %u\n",
        AGENT_PROTOCOL, state.manager_version, state.seat_count,
        selection_name(state.selection),
        profile_name(state.profile), state.payload_size,
        state.payload_exec_sealed ? 1U : 0U);

    char line[MAX_LINE_BYTES + 2U];
    uint64_t expected_sequence = 1U;
    int exit_code = 0;
    while (!stop_requested && fgets(line, sizeof(line), stdin) != NULL) {
        const size_t length = strlen(line);
        if (length == 0U || line[length - 1U] != '\n' ||
                (length == MAX_LINE_BYTES + 1U && line[length - 1U] != '\n')) {
            reply_error(expected_sequence, "malformed-command", &state);
            exit_code = 72;
            break;
        }
        struct command command = {0};
        if (!parse_command(line, expected_sequence, &command)) {
            reply_error(expected_sequence, "invalid-command", &state);
            exit_code = 72;
            break;
        }
        if (command.kind == COMMAND_NEXT) {
            struct pending_request *request = NULL;
            bool quiet_complete = false;
            if (next_request(&state, command.timeout_milliseconds,
                    command.quiet_milliseconds, &request, &quiet_complete) < 0) {
                reply_error(command.sequence,
                    errno == ETIMEDOUT ? "request-timeout" : "wayland-request-failed", &state);
                exit_code = 73;
                break;
            }
            if (quiet_complete) {
                fprintf(stdout,
                    "QUIET %" PRIu64 " REQUESTS %u TRANSFERS %u BYTES %" PRIu64 "\n",
                    command.sequence, state.requests_seen, state.transfers_completed,
                    state.bytes_transferred);
            } else if (request != NULL) {
                fprintf(stdout,
                    "REQUEST %" PRIu64 " ID %u MIME %s PENDING %zu\n",
                    command.sequence, request->id, request->mime, pending_count(&state));
            } else {
                reply_error(command.sequence, "request-state-invalid", &state);
                exit_code = 73;
                break;
            }
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_AUTHORIZE) {
            if (authorize_request(&state, command.request_id) < 0) {
                reply_error(command.sequence, "authorization-failed", &state);
                exit_code = 74;
                break;
            }
            fprintf(stdout,
                "AUTHORIZED %" PRIu64 " ID %u BYTES %zu TRANSFERS %u PENDING %zu\n",
                command.sequence, command.request_id, state.payload_size,
                state.transfers_completed, pending_count(&state));
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_CLEAR) {
            if (clear_selection(&state) < 0) {
                reply_error(command.sequence, "clear-unconfirmed", &state);
                exit_code = 75;
                break;
            }
            fprintf(stdout,
                "CLEARED %" PRIu64 " REQUESTS %u TRANSFERS %u BYTES %" PRIu64
                " CANCELLED %u\n",
                command.sequence, state.requests_seen, state.transfers_completed,
                state.bytes_transferred, state.unexpected_cancel ? 1U : 0U);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_PING) {
            if (display_roundtrip(&state) < 0) {
                reply_error(command.sequence, "wayland-ping-failed", &state);
                exit_code = 76;
                break;
            }
            fprintf(stdout, "PONG %" PRIu64 "\n", command.sequence);
            (void)fflush(stdout);
        } else if (command.kind == COMMAND_QUIT) {
            if (!state.clear_confirmed && clear_selection(&state) < 0) {
                reply_error(command.sequence, "quit-clear-unconfirmed", &state);
                exit_code = 75;
                break;
            }
            fprintf(stdout,
                "BYE %" PRIu64 " REQUESTS %u TRANSFERS %u BYTES %" PRIu64 " CLEARED 1\n",
                command.sequence, state.requests_seen, state.transfers_completed,
                state.bytes_transferred);
            (void)fflush(stdout);
            expected_sequence++;
            break;
        }
        expected_sequence++;
        if (expected_sequence == 0U) {
            exit_code = 72;
            break;
        }
    }
    if (!stop_requested && ferror(stdin)) {
        exit_code = 77;
    }
    cleanup(&state);
    return exit_code;
}
WAYLAND_CLIPBOARD_AGENT_C
}

