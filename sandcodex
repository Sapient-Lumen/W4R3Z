#include <wayland-client.h>
#include "wlr-layer-shell-unstable-v1-client-protocol.h"

#define AGENT_PROTOCOL "sandcodex.drop-agent.v2"
#define MAX_LINE_BYTES 256U
#define MAX_TOKENS 5U
#define MAX_TEXT_PAYLOAD_BYTES (1024U * 1024U)
#define MAX_PNG_PAYLOAD_BYTES (16U * 1024U * 1024U)
