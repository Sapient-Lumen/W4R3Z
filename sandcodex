from __future__ import annotations

import errno
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import socket
import stat
import struct
import sys

locator_path, project, project_key, action, json_output, uid_text = sys.argv[1:]
uid = int(uid_text)
as_json = json_output == "1"


def fail(message: str, code: int = 74) -> "NoReturn":
    print(f"sandcodex: {message}", file=sys.stderr)
    raise SystemExit(code)


def process_start(pid: int) -> str | None:
    try:
        value = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except (FileNotFoundError, ProcessLookupError, PermissionError, OSError):
        return None
    end = value.rfind(") ")
    if end < 0:
        return None
    fields = value[end + 2 :].split()
    if len(fields) < 20 or fields[0] in {"Z", "X", "x"}:
        return None
    return fields[19]


def private_file(path: Path, mode: int, label: str) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError as error:
        fail(f"{label} is unavailable: {error}")
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != uid
        or stat.S_IMODE(metadata.st_mode) != mode
        or metadata.st_nlink != 1
    ):
        fail(f"{label} is not one owned mode-0{mode:o} single-link file")
    return metadata


def integer(value: object, minimum: int, maximum: int, label: str) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
        fail(f"active publication locator has an invalid {label}")
    return value


def text(value: object, pattern: str, label: str) -> str:
    if not isinstance(value, str) or re.fullmatch(pattern, value) is None:
        fail(f"active publication locator has an invalid {label}")
    return value


def host_ipv4_candidates() -> list[dict[str, str]]:
    """Return observable Linux interface addresses without invoking host tools."""
    candidates: set[tuple[str, str]] = set()
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        try:
            interfaces = socket.if_nameindex()
        except OSError:
            interfaces = []
        for _index, interface in interfaces:
            encoded = interface.encode("utf-8", "surrogateescape")
            if not encoded or len(encoded) > 15:
                continue
            request = struct.pack("256s", encoded)
            try:
                response = fcntl.ioctl(probe.fileno(), 0x8915, request)  # Linux SIOCGIFADDR
                address = socket.inet_ntoa(response[20:24])
                parsed = ipaddress.ip_address(address)
            except (OSError, ValueError):
                continue
            if parsed.is_loopback or parsed.is_unspecified or parsed.is_link_local or parsed.is_multicast:
                continue
            candidates.add((interface, address))
    finally:
        probe.close()
    return [
        {"interface": interface, "address": address}
        for interface, address in sorted(
            candidates, key=lambda item: (int(ipaddress.ip_address(item[1])), item[0])
        )
    ]


HOST_IPV4_CANDIDATES = host_ipv4_candidates()


def listener_candidates(bind: str, port: int) -> list[dict[str, str]]:
    if bind == "0.0.0.0":
        observed = HOST_IPV4_CANDIDATES
    elif bind == "127.0.0.1":
        observed = [{"interface": "loopback", "address": bind}]
    else:
        matches = [item for item in HOST_IPV4_CANDIDATES if item["address"] == bind]
        observed = matches or [{"interface": "exact-bind", "address": bind}]
    return [
        {**item, "endpoint": f"tcp://{item['address']}:{port}"}
        for item in observed
    ]


def relay_observation(path_text: object, index: int) -> str:
    path = text(path_text, r"/.{1,4094}", f"listener {index} relay path")
    expected = re.fullmatch(
        rf"(?:/tmp|/run/user/{uid})/(scx\.[A-Za-z0-9]{{6}})/agent/publish-({index})\.sock",
        path,
    )
    if expected is None or os.path.realpath(path) != path:
        fail(f"active publication locator listener {index} relay path is outside its private runtime")
    root = Path(path).parent.parent
    agent = Path(path).parent
    try:
        root_meta = root.lstat()
        agent_meta = agent.lstat()
    except OSError:
        return "absent"
    for metadata, label in ((root_meta, "runtime"), (agent_meta, "relay directory")):
        if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != uid or stat.S_IMODE(metadata.st_mode) != 0o700:
            fail(f"publication {label} metadata is invalid")
    try:
        metadata = Path(path).lstat()
    except FileNotFoundError:
        return "absent"
    except OSError:
        return "unavailable"
    if (
        stat.S_ISSOCK(metadata.st_mode)
        and metadata.st_uid == uid
        and stat.S_IMODE(metadata.st_mode) == 0o600
    ):
        return "socket-present"
    return "unsafe-entry"


def render(result: dict[str, object]) -> None:
    if as_json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
        return
    print("sandcodex publish")
    print(f"  project       {result['project']}")
    print(f"  room          {result['state']}")
    if not result["listeners"]:
        print("  listeners     none")
        print("  conclusion    no active publication is recorded for this project")
        return
    print(f"  run           {result['run_id']}")
    for listener in result["listeners"]:
        assert isinstance(listener, dict)
        endpoint = f"{listener['bind_address']}:{listener['host_port']}"
        target = f"127.0.0.1:{listener['target_port']}"
        print(f"  listener {listener['index']:<2}  {endpoint} -> {target}")
        probe_address = listener.get("host_probe_address")
        probe_label = listener["host_probe"] if probe_address is None else f"{listener['host_probe']}@{probe_address}"
        print(
            "                 "
            f"publisher={listener['publisher_state']}  "
            f"relay={listener['relay_state']}  "
            f"host-probe={probe_label}"
        )
        if listener["bind_address"] == "127.0.0.1":
            candidate = listener["client_candidates"][0]
            print(f"                 local candidate: {candidate['endpoint']}")
            print(
                "                 "
                f"SSH: ssh -N -L {listener['host_port']}:127.0.0.1:{listener['host_port']} USER@HOST"
            )
        elif listener["bind_address"] == "0.0.0.0":
            candidates = listener["client_candidates"]
            if candidates:
                for candidate in candidates:
                    print(
                        "                 "
                        f"client candidate: {candidate['endpoint']} ({candidate['interface']})"
                    )
            else:
                print(f"                 client candidate: tcp://HOST-IP:{listener['host_port']} (none discovered)")
        else:
            candidate = listener["client_candidates"][0]
            print(f"                 client candidate: {candidate['endpoint']} ({candidate['interface']})")
    print("  application   unproven; use its real protocol")
    print("  external LAN  unproven; test from the intended client")
    print(f"  conclusion    {result['conclusion']}")


path = Path(locator_path)
if not path.exists() and not path.is_symlink():
    result = {
        "schema": "sandcodex.publish-status.v1",
        "project": project,
        "active": False,
        "state": "inactive",
        "run_id": None,
        "listeners": [],
        "host_ipv4_candidates": HOST_IPV4_CANDIDATES,
        "application_readiness": "unproven",
        "external_reachability": "unproven",
        "conclusion": "inactive",
    }
    render(result)
    raise SystemExit(1 if action == "doctor" else 0)

private_file(path, 0o600, "active publication locator")
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    fail(f"active publication locator is malformed: {error}")
if not isinstance(data, dict) or data.get("schema") != "sandcodex.publish-active.v1":
    fail("active publication locator schema is invalid")
if data.get("project") != project or data.get("project_key") != project_key:
    fail("active publication locator belongs to another project")
run_id = text(data.get("run_id"), r"[A-Za-z0-9._:-]{1,96}", "run id")
launcher = data.get("launcher")
if not isinstance(launcher, dict):
    fail("active publication locator has no launcher identity")
launcher_pid = integer(launcher.get("pid"), 1, 2**31 - 1, "launcher pid")
launcher_start = text(launcher.get("start_ticks"), r"[0-9]+", "launcher start time")
room_alive = process_start(launcher_pid) == launcher_start
listeners_data = data.get("listeners")
if not isinstance(listeners_data, list) or not 1 <= len(listeners_data) <= 16:
    fail("active publication locator listener set is invalid")

listeners: list[dict[str, object]] = []
for index, item in enumerate(listeners_data):
    if not isinstance(item, dict) or item.get("transport") != "tcp":
        fail(f"active publication locator listener {index} is invalid")
    bind = text(item.get("bind_address"), r"[0-9.]{7,15}", f"listener {index} bind address")
    try:
        parsed_bind = ipaddress.IPv4Address(bind)
    except ipaddress.AddressValueError:
        fail(f"active publication locator listener {index} bind address is invalid")
    host_port = integer(item.get("host_port"), 1, 65535, f"listener {index} host port")
    target_port = integer(item.get("target_port"), 1, 65535, f"listener {index} target port")
    if item.get("target_address") != "127.0.0.1" or item.get("authentication") != "none":
        fail(f"active publication locator listener {index} authority changed")
    publisher = item.get("publisher")
    if not isinstance(publisher, dict):
        fail(f"active publication locator listener {index} has no publisher identity")
    publisher_pid = integer(publisher.get("pid"), 1, 2**31 - 1, f"listener {index} publisher pid")
    publisher_start = text(
        publisher.get("start_ticks"), r"[0-9]+", f"listener {index} publisher start time"
    )
    publisher_alive = process_start(publisher_pid) == publisher_start
    relay_state = relay_observation(item.get("relay_socket"), index) if room_alive else "unobserved"
    probe = "not-run"
    probe_address = None
    probe_errno: int | None = None
    if action == "doctor":
        probe_address = "127.0.0.1" if bind == "0.0.0.0" else bind
        client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            client.settimeout(0.5)
            probe_errno = client.connect_ex((probe_address, host_port))
            probe = "accepted" if probe_errno == 0 else errno.errorcode.get(probe_errno, f"errno-{probe_errno}").lower()
        except OSError as error:
            probe_errno = error.errno
            probe = error.__class__.__name__.lower()
        finally:
            client.close()
    listeners.append(
        {
            "index": index,
            "bind_address": bind,
            "host_port": host_port,
            "target_address": "127.0.0.1",
            "target_port": target_port,
            "authentication": "none",
            "publisher_pid": publisher_pid,
            "publisher_state": "alive" if publisher_alive else "lost",
            "relay_state": relay_state,
            "host_probe": probe,
            "host_probe_address": probe_address,
            "host_probe_errno": probe_errno,
            "client_candidates": listener_candidates(bind, host_port),
            "application_readiness": "unproven",
            "external_reachability": "unproven",
        }
    )

publisher_ok = all(item["publisher_state"] == "alive" for item in listeners)
relay_ok = all(item["relay_state"] == "socket-present" for item in listeners)
probe_ok = action != "doctor" or all(item["host_probe"] == "accepted" for item in listeners)
healthy = room_alive and publisher_ok and relay_ok and probe_ok
state = "healthy" if healthy else ("degraded" if room_alive else "stale")
result = {
    "schema": "sandcodex.publish-status.v1",
    "project": project,
    "active": room_alive,
    "state": state,
    "run_id": run_id,
    "launcher": {
        "pid": launcher_pid,
        "start_ticks": launcher_start,
        "state": "alive" if room_alive else "lost",
    },
    "listeners": listeners,
    "host_ipv4_candidates": HOST_IPV4_CANDIDATES,
    "application_readiness": "unproven",
    "external_reachability": "unproven",
    "conclusion": (
        "publication chain observed; application and external client still require protocol tests"
        if healthy
        else "publication chain is incomplete or no longer active"
    ),
}
render(result)
raise SystemExit(0 if action == "status" or healthy else 1)
PY
}

sc_stop_publishers() {
  local index pid started
  for index in "${!SC_PUBLISH_PIDS[@]}"; do
    pid="${SC_PUBLISH_PIDS[$index]}"; started="${SC_PUBLISH_STARTS[$index]:-}"
    [[ -n "$pid" ]] || continue
    if [[ -n "$started" ]]; then
      sc_stop_tracked_pid "$pid" "$started" TERM 40
    else
      kill -TERM "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  done
  SC_PUBLISH_PIDS=(); SC_PUBLISH_STARTS=()
}

sc_start_publishers() {
  (( ${#SC_PUBLISH_SPECS[@]} > 0 )) || return 0
  local index bind host_port target_port socket pid started probe ready diagnostic exposure
  SC_PUBLISH_PIDS=(); SC_PUBLISH_STARTS=()
  for index in "${!SC_PUBLISH_SPECS[@]}"; do
    bind="${SC_PUBLISH_BINDS[$index]}"; host_port="${SC_PUBLISH_HOST_PORTS[$index]}"
    target_port="${SC_PUBLISH_TARGET_PORTS[$index]}"; socket="${SC_PUBLISH_SOCKETS[$index]}"
    diagnostic="$SC_RUN_ROOT/publish-$index.stderr"
    : >"$diagnostic"; chmod 600 -- "$diagnostic"
    (
      sc_close_inherited_fds
      exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SOCAT" \
        "TCP4-LISTEN:$host_port,bind=$bind,reuseaddr,fork,max-children=128" \
        "UNIX-CONNECT:$socket"
    ) >>"$diagnostic" 2>&1 & pid=$!
    started="$(sc_process_start "$pid" 2>/dev/null || true)"
    SC_PUBLISH_PIDS+=("$pid"); SC_PUBLISH_STARTS+=("$started")
    [[ "$started" =~ ^[0-9]+$ ]] || {
      sc_err "could not birth-pin publisher $bind:$host_port"
      return 1
    }
    probe="$bind"; [[ "$probe" != 0.0.0.0 ]] || probe=127.0.0.1
    ready=0
    for _ in {1..60}; do
      sc_pid_still_matches "$pid" "$started" || break
      if sc_publish_tcp_ready "$probe" "$host_port"; then
        sleep 0.02
        if sc_pid_still_matches "$pid" "$started"; then ready=1; break; fi
      fi
      sleep 0.03
    done
    if (( ! ready )); then
      sed -n '1,40p' "$diagnostic" >&2
      sc_err "could not publish host $bind:$host_port to agent 127.0.0.1:$target_port"
      return 1
    fi
    exposure="host-loopback"
    [[ "$bind" == 127.0.0.1 ]] || exposure="host-network"
    sc_log_event info publish_ready "agent TCP publisher is ready" \
      "bind=$bind" "host_port=$host_port" "target=127.0.0.1:$target_port" \
      "exposure=$exposure" "authentication=none" "pid=$pid" "process_start=$started"
    if [[ "$bind" == 127.0.0.1 ]]; then
      sc_ok "publish · tcp://127.0.0.1:$host_port → agent 127.0.0.1:$target_port · host only · no added authentication"
    else
      sc_warn "publish · tcp://$bind:$host_port → agent 127.0.0.1:$target_port · HOST/LAN EXPOSED if firewall permits · no authentication"
    fi
  done
  sc_publish_write_locator
}

sc_write_browser_download_hook() {
  local hook="$SC_RUN_ROOT/browser-launch/downloads.cjs" tmp
  tmp="$(mktemp "$SC_RUN_ROOT/browser-launch/.downloads.XXXXXX")"
  cat >"$tmp" <<'NODE'
const crypto = require('node:crypto');
const fs = require('node:fs/promises');
const path = require('node:path');

const downloadDirectory = process.env.SANDCODEX_DOWNLOADS;
if (!downloadDirectory || !path.isAbsolute(downloadDirectory))
  throw new Error('SANDCODEX_DOWNLOADS must name an absolute directory');
function safeName(suggested) {
  let value = path.basename(String(suggested || 'download'))
    .replace(/[\u0000-\u001f\u007f/\\]/g, '_')
    .replace(/^\.+$/, 'download');
  if (!value) value = 'download';
  while (Buffer.byteLength(value, 'utf8') > 220) value = value.slice(0, -1);
  return value || 'download';
}
function collisionName(name, index) {
  if (!index) return name;
  const parsed = path.parse(name);
  return `${parsed.name} (${index})${parsed.ext}`;
}
async function publishDownload(download) {
  const filename = safeName(download.suggestedFilename());
  const partial = path.join(downloadDirectory, `.sandcodex-download-${process.pid}-${crypto.randomUUID()}.part`);
  try {
    await download.saveAs(partial);
    const details = await fs.lstat(partial);
    if (!details.isFile() || details.isSymbolicLink())
      throw new Error('browser download did not produce a regular file');
    for (let index = 0; index < 10000; index += 1) {
      const destination = path.join(downloadDirectory, collisionName(filename, index));
      try {
        await fs.link(partial, destination);
        await fs.unlink(partial);
        process.stderr.write(`sandcodex: completed browser download: ${destination}\n`);
        return;
      } catch (error) {
        if (error && error.code === 'EEXIST') continue;
        throw error;
      }
    }
    throw new Error(`could not allocate a final name for ${filename}`);
  } catch (error) {
    await fs.unlink(partial).catch(() => {});
    const reason = error instanceof Error ? error.message : String(error);
    process.stderr.write(`sandcodex: durable browser download failed: ${reason}\n`);
  }
}
module.exports.default = async ({ page }) => {
  page.on('download', download => { void publishDownload(download); });
};
NODE
  chmod 600 "$tmp"; mv -fT -- "$tmp" "$hook"
  printf '%s\n' "$hook"
}

sc_write_browser_relay_preflight_client() {
  SC_BROWSER_PREFLIGHT_CLIENT=""
  (( SC_BROWSER_RELAY_REQUIRED )) || return 0
  local client="$SC_RUN_ROOT/browser-launch/relay-preflight-client.cjs"
  sc_atomic "$client" 700 <<'NODE'
const fs = require('node:fs');
const net = require('node:net');

const [socketPath, readyPath, activationUrl, expectedNativeSocket] = process.argv.slice(2);
if (
  !socketPath ||
  !readyPath ||
  !/^chrome-extension:\/\/[a-p]{32}\/[^?#]+$/.test(activationUrl || '') ||
  typeof expectedNativeSocket !== 'string' ||
  !expectedNativeSocket.startsWith('/') ||
  Buffer.byteLength(expectedNativeSocket) >= 108 ||
  /[\r\n\0]/.test(expectedNativeSocket)
) throw new Error('relay preflight client needs validated Playwright, extension, and native socket paths');
const activationCode = `async (page) => {
  const context = page.context();
  const pagesBefore = context.pages();
  const urlsBefore = pagesBefore.map(candidate => candidate.url());
  const probe = await context.newPage();
  let readiness;
  try {
    await probe.goto(${JSON.stringify(activationUrl)}, { waitUntil: 'load' });
    readiness = await probe.evaluate(async ({ expectedSocket }) => {
    if (!globalThis.chrome?.runtime?.sendMessage) {
      throw new Error('GlassTTY extension runtime messaging is unavailable');
    }
    const startedAt = Date.now();
    const deadline = startedAt + 15000;
    let last = {
      responseType: null,
      connected: false,
      healthFresh: false,
      healthOk: false,
      extensionIdentityMatches: false,
      brokerRole: null,
      socketMatches: false,
      hostSocketMatches: false,
      socketExists: false,
    };
    while (Date.now() < deadline) {
      const requestId = crypto.randomUUID();
      try {
        const response = await Promise.race([
          chrome.runtime.sendMessage({
            version: '0.1',
            request_id: requestId,
            type: 'bridge.status',
            timestamp: new Date().toISOString(),
            payload: {
              privacy_minimized: true,
              sandcodex_activation: true,
              expected_socket: expectedSocket,
            },
          }),
          new Promise((_, reject) => setTimeout(
            () => reject(new Error('extension-local bridge.status timed out')),
            3000,
          )),
        ]);
        const connection = response?.payload?.nativeConnection;
        const broker = connection?.persistentBroker;
        const healthPongAt = Date.parse(connection?.lastHealthPongAt ?? '');
        last = {
          responseType: response?.type ?? null,
          connected: connection?.connected === true,
          healthFresh: Number.isFinite(healthPongAt) && healthPongAt >= startedAt,
          healthOk: connection?.lastHealthOk === true,
          extensionIdentityMatches: connection?.lastHealthExtensionIdentityMatches === true,
          brokerRole: broker?.role ?? null,
          socketMatches: broker?.socket_path === expectedSocket,
          hostSocketMatches: connection?.socketPath === expectedSocket,
          socketExists: broker?.socket_exists === true,
        };
        if (
          response?.request_id === requestId &&
          response?.type === 'bridge.status' &&
          last.connected &&
          last.healthFresh &&
          last.healthOk &&
          last.extensionIdentityMatches &&
          last.brokerRole === 'owner' &&
          last.socketMatches &&
          last.hostSocketMatches &&
          last.socketExists
        ) {
          return { persistentNative: true, brokerRole: last.brokerRole };
        }
      } catch {
        // The worker/native lane can still be coming up; the fixed outer
        // deadline, not individual retries, owns this readiness decision.
      }
      await new Promise(resolve => setTimeout(resolve, 100));
    }
    throw new Error('GlassTTY persistent native lane did not become the expected broker owner: ' + JSON.stringify(last));
    }, { expectedSocket: ${JSON.stringify(expectedNativeSocket)} });
  } finally {
    await probe.close().catch(() => {});
  }
  const pagesAfter = context.pages();
  if (pagesAfter.length !== pagesBefore.length ||
      pagesAfter.some((candidate, index) => candidate !== pagesBefore[index]) ||
      pagesAfter.some((candidate, index) => candidate.url() !== urlsBefore[index]))
    throw new Error('browser routes changed during relay activation');
  return { activated:true,activation_page_closed:true,tab_routes_unchanged:true,...readiness };
}`;

let buffer = '';
let phase = 'connecting';
let stopping = false;
let stopTimer;
const socket = net.createConnection(socketPath);

function send(message) {
  socket.write(`${JSON.stringify(message)}\n`);
}

function fail(message) {
  process.stderr.write(`sandcodex: browser relay activation failed: ${message}\n`);
  socket.destroy();
  process.exitCode = 1;
}

function beginStop() {
  if (stopping) return;
  stopping = true;
  stopTimer = setTimeout(() => socket.destroy(), 10000);
  socket.end();
}

socket.setEncoding('utf8');
socket.once('connect', () => {
  phase = 'initialize';
  send({
    jsonrpc: '2.0',
    id: 1,
    method: 'initialize',
    params: {
      protocolVersion: '2025-06-18',
      capabilities: {},
      clientInfo: { name: 'sandcodex-relay-preflight', version: '1' },
    },
  });
});
socket.on('data', chunk => {
  buffer += chunk;
  for (;;) {
    const newline = buffer.indexOf('\n');
    if (newline < 0) break;
    const line = buffer.slice(0, newline);
    buffer = buffer.slice(newline + 1);
    if (!line) continue;
    let message;
    try {
      message = JSON.parse(line);
    } catch {
      fail('Playwright MCP emitted invalid JSON');
      return;
    }
    if (message.id === 1) {
      if (message.error || message.result?.serverInfo?.name !== 'Playwright') {
        fail('Playwright MCP initialization returned an unexpected server');
        return;
      }
      send({ jsonrpc: '2.0', method: 'notifications/initialized' });
      phase = 'tools';
      send({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} });
      continue;
    }
    if (message.id === 2) {
      const tools = message.result?.tools;
      if (
        message.error ||
        !Array.isArray(tools) ||
        !tools.some(tool => tool?.name === 'browser_run_code_unsafe')
      ) {
        fail('Playwright MCP does not expose browser_run_code_unsafe');
        return;
      }
      phase = 'launch';
      send({
        jsonrpc: '2.0',
        id: 3,
        method: 'tools/call',
        params: { name: 'browser_run_code_unsafe', arguments: { code: activationCode } },
      });
      continue;
    }
    if (message.id === 3) {
      if (message.error || message.result?.isError) {
        fail('extension native-host activation page failed');
        return;
      }
      try {
        fs.writeFileSync(readyPath, 'ready\n', { encoding: 'utf8', mode: 0o600, flag: 'wx' });
      } catch (error) {
        fail(`could not publish activation readiness: ${error.message}`);
        return;
      }
      phase = 'ready';
      if (stopping) beginStop();
      continue;
    }
  }
});
socket.once('error', error => {
  if (!stopping) fail(error.message);
});
socket.once('close', () => {
  clearTimeout(stopTimer);
  if (!stopping && phase !== 'connecting') {
    process.stderr.write('sandcodex: browser relay activation closed unexpectedly\n');
    process.exitCode = 1;
  }
});
process.on('SIGINT', beginStop);
process.on('SIGTERM', beginStop);
setTimeout(() => {
  if (phase !== 'ready') fail('Playwright MCP activation timed out');
}, 60000).unref();
NODE
  SC_BROWSER_PREFLIGHT_CLIENT="$client"
}

sc_start_browser_relay_preflight_client() {
  (( SC_BROWSER_RELAY_REQUIRED )) || return 0
  [[ -x "$SC_BROWSER_PREFLIGHT_CLIENT" && -S "$SC_BROWSER_SOCKET" ]] || return 1
  local ready="$SC_RUN_ROOT/browser-relay-preflight.ready"
  local diagnostic="$SC_RUN_ROOT/browser-relay-preflight.stderr"
  local attempt
  rm -f -- "$ready"
  : >"$diagnostic"; chmod 600 -- "$diagnostic"
  (
    sc_close_inherited_fds
    exec env -i PATH="$SC_PATH" HOME="$SC_BROWSER_HOME" LANG="${LANG:-C.UTF-8}" \
      "$SC_SETPRIV" --pdeathsig TERM "$(command -v node)" \
      "$SC_BROWSER_PREFLIGHT_CLIENT" "$SC_BROWSER_SOCKET" "$ready" \
      "$SC_BROWSER_RELAY_ACTIVATION_URL" \
      "$SC_GLASSTTY_RUNTIME_HOME/run/daemon.sock"
  ) >>"$SC_RUN_ROOT/browser-service.log" 2>>"$diagnostic" &
  SC_BROWSER_PREFLIGHT_PID=$!
  SC_BROWSER_PREFLIGHT_START="$(sc_process_start "$SC_BROWSER_PREFLIGHT_PID" 2>/dev/null || true)"
  if [[ ! "$SC_BROWSER_PREFLIGHT_START" =~ ^[0-9]+$ ]]; then
    kill "$SC_BROWSER_PREFLIGHT_PID" 2>/dev/null || true
    wait "$SC_BROWSER_PREFLIGHT_PID" 2>/dev/null || true
    SC_BROWSER_PREFLIGHT_PID=""; SC_BROWSER_PREFLIGHT_START=""
    return 1
  fi
  for (( attempt=0; attempt<600; attempt++ )); do
    [[ -f "$ready" && ! -L "$ready" && "$(<"$ready")" == ready ]] && return 0
    sc_pid_still_matches "$SC_BROWSER_PREFLIGHT_PID" "$SC_BROWSER_PREFLIGHT_START" || break
    sleep 0.1
  done
  sed -n '1,80p' "$diagnostic" >&2
  sc_stop_tracked_pid "$SC_BROWSER_PREFLIGHT_PID" "$SC_BROWSER_PREFLIGHT_START" TERM
  wait "$SC_BROWSER_PREFLIGHT_PID" 2>/dev/null || true
  SC_BROWSER_PREFLIGHT_PID=""; SC_BROWSER_PREFLIGHT_START=""
  rm -f -- "$ready"
  return 1
}

sc_stop_browser_relay_preflight_client() {
  (( SC_BROWSER_RELAY_REQUIRED )) || return 0
  local rc=0
  if [[ -n "$SC_BROWSER_PREFLIGHT_PID" ]]; then
    sc_stop_tracked_pid "$SC_BROWSER_PREFLIGHT_PID" "$SC_BROWSER_PREFLIGHT_START" TERM
    wait "$SC_BROWSER_PREFLIGHT_PID" || rc=$?
  fi
  SC_BROWSER_PREFLIGHT_PID=""; SC_BROWSER_PREFLIGHT_START=""
  rm -f -- "$SC_RUN_ROOT/browser-relay-preflight.ready"
  return "$rc"
}

