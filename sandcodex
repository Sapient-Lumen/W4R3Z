    def _touch_gesture_paths(
        self, arguments: dict[str, Any]
    ) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
        """Build both exact bounded integer paths for one native gesture."""
        first_start_x = as_int(
            arguments.get("first_start_x"), 0, self.width - 1, "first_start_x"
        )
        first_start_y = as_int(
            arguments.get("first_start_y"), 0, self.height - 1, "first_start_y"
        )
        first_end_x = as_int(
            arguments.get("first_end_x"), 0, self.width - 1, "first_end_x"
        )
        first_end_y = as_int(
            arguments.get("first_end_y"), 0, self.height - 1, "first_end_y"
        )
        second_start_x = as_int(
            arguments.get("second_start_x"), 0, self.width - 1, "second_start_x"
        )
        second_start_y = as_int(
            arguments.get("second_start_y"), 0, self.height - 1, "second_start_y"
        )
        second_end_x = as_int(
            arguments.get("second_end_x"), 0, self.width - 1, "second_end_x"
        )
        second_end_y = as_int(
            arguments.get("second_end_y"), 0, self.height - 1, "second_end_y"
        )
        requested_steps = as_int(
            arguments.get("steps", TOUCH_GESTURE_DEFAULT_STEPS),
            1,
            TOUCH_GESTURE_MAX_STEPS,
            "steps",
        )
        maximum_axis_delta = max(
            abs(first_end_x - first_start_x),
            abs(first_end_y - first_start_y),
            abs(second_end_x - second_start_x),
            abs(second_end_y - second_start_y),
        )
        if maximum_axis_delta == 0:
            raise ToolError("native two-contact gesture must move at least one contact")
        # The compositor intentionally rejects duplicate consecutive paired
        # motion frames.  A linear integer path is guaranteed to advance on
        # every frame when at least one axis spans at least `steps` pixels, so
        # narrow gestures transparently reduce their sampling count instead of
        # failing only because the public default requested too many samples.
        steps = min(requested_steps, maximum_axis_delta)
        duration_milliseconds = as_int(
            arguments.get(
                "duration_milliseconds",
                TOUCH_GESTURE_DEFAULT_DURATION_MILLISECONDS,
            ),
            steps + 1,
            TOUCH_GESTURE_MAX_DURATION_MILLISECONDS,
            "duration_milliseconds",
        )
        arguments["steps"] = steps
        arguments["duration_milliseconds"] = duration_milliseconds

        def coordinate(start: int, end: int, index: int) -> int:
            if index == 0 or start == end:
                return start
            if index >= steps:
                return end
            delta = end - start
            magnitude = (abs(delta) * index) // steps
            return start + (-magnitude if delta < 0 else magnitude)

        first_path = [
            (
                coordinate(first_start_x, first_end_x, index),
                coordinate(first_start_y, first_end_y, index),
            )
            for index in range(steps + 1)
        ]
        second_path = [
            (
                coordinate(second_start_x, second_end_x, index),
                coordinate(second_start_y, second_end_y, index),
            )
            for index in range(steps + 1)
        ]
        if (
            first_path[0] != (first_start_x, first_start_y)
            or first_path[-1] != (first_end_x, first_end_y)
            or second_path[0] != (second_start_x, second_start_y)
            or second_path[-1] != (second_end_x, second_end_y)
        ):
            raise ToolError("internal native touch-gesture endpoint construction failed")
        previous_pair: tuple[tuple[int, int], tuple[int, int]] | None = None
        for index, (first, second) in enumerate(zip(first_path, second_path)):
            pair = (first, second)
            if first == second:
                raise ToolError(
                    f"native two-contact gesture contacts collide at path point {index}"
                )
            if previous_pair == pair:
                raise ToolError(
                    f"native two-contact gesture pair does not advance at path point {index}"
                )
            previous_pair = pair
        return first_path, second_path

    def _touchpad_swipe_parameters(
        self, arguments: dict[str, Any]
    ) -> dict[str, int]:
        """Normalize one exact bounded native pointer-gesture swipe."""
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        delta_x = as_int(
            arguments.get("delta_x"),
            -TOUCHPAD_SWIPE_MAX_DELTA,
            TOUCHPAD_SWIPE_MAX_DELTA,
            "delta_x",
        )
        delta_y = as_int(
            arguments.get("delta_y"),
            -TOUCHPAD_SWIPE_MAX_DELTA,
            TOUCHPAD_SWIPE_MAX_DELTA,
            "delta_y",
        )
        if delta_x == 0 and delta_y == 0:
            raise ToolError("native touchpad swipe requires a nonzero relative vector")
        fingers = as_int(
            arguments.get("fingers", TOUCHPAD_SWIPE_DEFAULT_FINGERS),
            TOUCHPAD_SWIPE_MIN_FINGERS,
            TOUCHPAD_SWIPE_MAX_FINGERS,
            "fingers",
        )
        requested_steps = as_int(
            arguments.get("steps", TOUCHPAD_SWIPE_DEFAULT_STEPS),
            1,
            TOUCHPAD_SWIPE_MAX_STEPS,
            "steps",
        )
        maximum_axis_delta = max(abs(delta_x), abs(delta_y))
        steps = min(requested_steps, maximum_axis_delta)
        duration_milliseconds = as_int(
            arguments.get(
                "duration_milliseconds",
                TOUCHPAD_SWIPE_DEFAULT_DURATION_MILLISECONDS,
            ),
            steps + 1,
            TOUCHPAD_SWIPE_MAX_DURATION_MILLISECONDS,
            "duration_milliseconds",
        )

        def cumulative(total: int, index: int) -> int:
            if index <= 0 or total == 0:
                return 0
            if index >= steps:
                return total
            magnitude = (abs(total) * index) // steps
            return -magnitude if total < 0 else magnitude

        previous_x = 0
        previous_y = 0
        sum_x = 0
        sum_y = 0
        for index in range(1, steps + 1):
            current_x = cumulative(delta_x, index)
            current_y = cumulative(delta_y, index)
            relative_x = current_x - previous_x
            relative_y = current_y - previous_y
            if relative_x == 0 and relative_y == 0:
                raise ToolError(
                    f"native touchpad swipe would emit a zero update at step {index}"
                )
            sum_x += relative_x
            sum_y += relative_y
            previous_x = current_x
            previous_y = current_y
        if (sum_x, sum_y) != (delta_x, delta_y):
            raise ToolError("internal native touchpad-swipe delta construction failed")

        normalized = {
            "x": x,
            "y": y,
            "delta_x": delta_x,
            "delta_y": delta_y,
            "fingers": fingers,
            "steps": steps,
            "duration_milliseconds": duration_milliseconds,
        }
        arguments.update(normalized)
        return normalized

    def _touchpad_pinch_parameters(
        self, arguments: dict[str, Any]
    ) -> dict[str, int]:
        """Normalize one exact bounded native 24.8-grid pointer pinch."""
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        delta_x = as_int(
            arguments.get("delta_x", 0),
            -TOUCHPAD_PINCH_MAX_DELTA,
            TOUCHPAD_PINCH_MAX_DELTA,
            "delta_x",
        )
        delta_y = as_int(
            arguments.get("delta_y", 0),
            -TOUCHPAD_PINCH_MAX_DELTA,
            TOUCHPAD_PINCH_MAX_DELTA,
            "delta_y",
        )
        scale_256 = as_int(
            arguments.get("scale_256", TOUCHPAD_PINCH_SCALE_UNITY_256),
            TOUCHPAD_PINCH_MIN_SCALE_256,
            TOUCHPAD_PINCH_MAX_SCALE_256,
            "scale_256",
        )
        rotation_degrees = as_int(
            arguments.get("rotation_degrees", 0),
            -TOUCHPAD_PINCH_MAX_ROTATION_DEGREES,
            TOUCHPAD_PINCH_MAX_ROTATION_DEGREES,
            "rotation_degrees",
        )
        total_x_raw = delta_x * 256
        total_y_raw = delta_y * 256
        total_scale_delta_raw = scale_256 - TOUCHPAD_PINCH_SCALE_UNITY_256
        total_rotation_raw = rotation_degrees * 256
        maximum_raw_magnitude = max(
            abs(total_x_raw),
            abs(total_y_raw),
            abs(total_scale_delta_raw),
            abs(total_rotation_raw),
        )
        if maximum_raw_magnitude == 0:
            raise ToolError("native touchpad pinch requires pan, scale, or rotation")
        fingers = as_int(
            arguments.get("fingers", TOUCHPAD_PINCH_DEFAULT_FINGERS),
            TOUCHPAD_PINCH_MIN_FINGERS,
            TOUCHPAD_PINCH_MAX_FINGERS,
            "fingers",
        )
        requested_steps = as_int(
            arguments.get("steps", TOUCHPAD_PINCH_DEFAULT_STEPS),
            1,
            TOUCHPAD_PINCH_MAX_STEPS,
            "steps",
        )
        # Reducing the requested count to the greatest exact 24.8 quantum makes
        # every update semantically nonzero without changing the final gesture.
        steps = min(requested_steps, maximum_raw_magnitude)
        duration_milliseconds = as_int(
            arguments.get(
                "duration_milliseconds",
                TOUCHPAD_PINCH_DEFAULT_DURATION_MILLISECONDS,
            ),
            steps + 1,
            TOUCHPAD_PINCH_MAX_DURATION_MILLISECONDS,
            "duration_milliseconds",
        )

        def cumulative(total: int, index: int) -> int:
            if index <= 0 or total == 0:
                return 0
            if index >= steps:
                return total
            magnitude = (abs(total) * index) // steps
            return -magnitude if total < 0 else magnitude

        previous_x_raw = 0
        previous_y_raw = 0
        previous_scale_delta_raw = 0
        previous_rotation_raw = 0
        sum_x_raw = 0
        sum_y_raw = 0
        sum_rotation_raw = 0
        final_scale_256 = TOUCHPAD_PINCH_SCALE_UNITY_256
        for index in range(1, steps + 1):
            current_x_raw = cumulative(total_x_raw, index)
            current_y_raw = cumulative(total_y_raw, index)
            current_scale_delta_raw = cumulative(total_scale_delta_raw, index)
            current_rotation_raw = cumulative(total_rotation_raw, index)
            relative_x_raw = current_x_raw - previous_x_raw
            relative_y_raw = current_y_raw - previous_y_raw
            relative_rotation_raw = current_rotation_raw - previous_rotation_raw
            final_scale_256 = (
                TOUCHPAD_PINCH_SCALE_UNITY_256 + current_scale_delta_raw
            )
            if (
                relative_x_raw == 0
                and relative_y_raw == 0
                and current_scale_delta_raw == previous_scale_delta_raw
                and relative_rotation_raw == 0
            ):
                raise ToolError(
                    f"native touchpad pinch would emit a neutral update at step {index}"
                )
            if not (
                TOUCHPAD_PINCH_MIN_SCALE_256
                <= final_scale_256
                <= TOUCHPAD_PINCH_MAX_SCALE_256
            ):
                raise ToolError("internal native touchpad-pinch scale left its bound")
            sum_x_raw += relative_x_raw
            sum_y_raw += relative_y_raw
            sum_rotation_raw += relative_rotation_raw
            previous_x_raw = current_x_raw
            previous_y_raw = current_y_raw
            previous_scale_delta_raw = current_scale_delta_raw
            previous_rotation_raw = current_rotation_raw
        if (sum_x_raw, sum_y_raw) != (total_x_raw, total_y_raw):
            raise ToolError("internal native touchpad-pinch pan construction failed")
        if final_scale_256 != scale_256:
            raise ToolError("internal native touchpad-pinch scale construction failed")
        if sum_rotation_raw != total_rotation_raw:
            raise ToolError("internal native touchpad-pinch rotation construction failed")

        normalized = {
            "x": x,
            "y": y,
            "delta_x": delta_x,
            "delta_y": delta_y,
            "scale_256": scale_256,
            "rotation_degrees": rotation_degrees,
            "fingers": fingers,
            "steps": steps,
            "duration_milliseconds": duration_milliseconds,
        }
        arguments.update(normalized)
        return normalized

    @staticmethod
    def _scroll_units(delta_x: int, delta_y: int) -> list[tuple[int, int]]:
        """Serialize a wheel vector into balanced cardinal detents.

        Each unit carries exactly one axis and is independently armed,
        recipient-checked, dispatched, framed, and acknowledged. This avoids a
        first axis synchronously changing Sway state before a second axis in the
        same callback. Opposing axis totals are merged by ideal event-center
        time, with vertical units winning exact ties for deterministic ordering.
        """
        total_x = abs(delta_x)
        total_y = abs(delta_y)
        steps = total_x + total_y
        if steps <= 0:
            return []
        if steps > POINTER_FENCE_MAX_SCROLL_STEPS:
            raise ToolError("scroll exceeds the guarded cardinal-axis-unit limit")
        sign_x = 1 if delta_x > 0 else -1
        sign_y = 1 if delta_y > 0 else -1
        emitted_x = 0
        emitted_y = 0
        units: list[tuple[int, int]] = []
        while emitted_x < total_x or emitted_y < total_y:
            if emitted_x >= total_x:
                choose_y = True
            elif emitted_y >= total_y:
                choose_y = False
            else:
                # Compare the centers of the next X and Y events without
                # floating point: (2*i+1)/(2*total). Vertical wins ties.
                next_y = (2 * emitted_y + 1) * total_x
                next_x = (2 * emitted_x + 1) * total_y
                choose_y = next_y <= next_x
            if choose_y:
                units.append((0, sign_y))
                emitted_y += 1
            else:
                units.append((sign_x, 0))
                emitted_x += 1
        if (
            any(abs(unit_x) + abs(unit_y) != 1 for unit_x, unit_y in units)
            or sum(unit[0] for unit in units) != delta_x
            or sum(unit[1] for unit in units) != delta_y
        ):
            raise ToolError("internal guarded cardinal scroll decomposition failed")
        return units

    @classmethod
    def _scene_transient_axis_unit(cls, arguments: dict[str, Any]) -> tuple[int, int]:
        """Admit one unmodified cardinal wheel detent over PopupMeshInterior.

        Popup ownership in the image map remains conservative visual attribution.
        HitTestSeal independently identifies the exact compositor recipient at
        every checkpoint; keep the map's axis authority
        deliberately narrower than ordinary top-level scrolling: one released
        wheel unit, one axis, no modifier keyboard, and no continuation under
        the pre-scroll map.  A changed popup may be reported as the final scene
        transition, but it can authorize no second unit without a fresh
        observation and a newly derived map.
        """
        delta_y = as_int(arguments.get("delta_y", 0), -100, 100, "delta_y")
        delta_x = as_int(arguments.get("delta_x", 0), -100, 100, "delta_x")
        units = cls._scroll_units(delta_x, delta_y)
        if len(units) != SCENE_TRANSIENT_AXIS_MAX_LOGICAL_STEPS:
            raise ToolError(
                "scene-set transient scrolling requires exactly one logical wheel detent"
            )
        unit_x, unit_y = units[0]
        if (unit_x == 0) == (unit_y == 0) or abs(unit_x) + abs(unit_y) != 1:
            raise ToolError(
                "scene-set transient scrolling requires one cardinal horizontal or vertical wheel detent"
            )
        modifiers, _mask = WaylandKeyboardTransaction.normalize_modifiers(
            arguments.get("modifiers")
        )
        if modifiers:
            raise ToolError(
                "scene-set transient scrolling does not authorize seat-global keyboard modifiers"
            )
        return unit_x, unit_y

