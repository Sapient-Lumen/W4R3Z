  --setenv SANDCODEX_LISTEN_FD "$SANDCODEX_LISTEN_FD"
  --setenv SANDCODEX_READY_FD "$SANDCODEX_READY_FD"
)
WRAPPER
    if jq -e '.capabilities | index("glasstty-broker") != null' <<<"$SC_OPERATOR_DECLARATION_JSON" >/dev/null; then
      printf 'args+=(--setenv GLASSTTY_HOME %q)\n' "$SC_GLASSTTY_RUNTIME_HOME"
    fi
    if jq -e '.capabilities | index("jail-actions") != null' <<<"$SC_OPERATOR_DECLARATION_JSON" >/dev/null; then
      printf 'args+=(--setenv SANDCODEX_JAIL_RUNTIME %q)\n' "$SC_JAIL_RELAY_ROOT"
    fi
    if jq -e '.capabilities | index("campaign-control") != null' <<<"$SC_OPERATOR_DECLARATION_JSON" >/dev/null; then
      printf 'args+=(--setenv SANDCODEX_CAMPAIGN %q)\n' "$SC_LOCAL/launcher/sandcodex-campaign"
    fi
    cat <<'WRAPPER'
exec python3 -P - "$adapter_mode" "$adapter_target" "$bwrap" "$stop_grace" "${args[@]}" --chdir "$app_cwd" -- "${app[@]}" <<'PY'
import fcntl
import os
import signal
import subprocess
import sys

adapter_mode, adapter_target, boundary_binary, stop_grace, *command = sys.argv[1:]
try:
    delimiter = command.index("--")
except ValueError as error:
    raise SystemExit("sandcodex operator: malformed application boundary") from error

signal_read, signal_write = os.pipe2(os.O_CLOEXEC)
fcntl.fcntl(signal_write, fcntl.F_SETFL, fcntl.fcntl(signal_write, fcntl.F_GETFL) | os.O_NONBLOCK)
command[delimiter + 1:delimiter + 1] = [
    "/run/sandcodex-operator/venv/bin/python3",
    "-P",
    "/run/sandcodex-operator/application-signal-relay.py",
    str(signal_read),
    stop_grace,
    adapter_mode,
    adapter_target,
    "--",
]
pass_fds = (
    signal_read,
    int(os.environ["SANDCODEX_LISTEN_FD"]),
    int(os.environ["SANDCODEX_READY_FD"]),
)


def forward(signum, _frame):
    try:
        os.write(signal_write, bytes((signum,)))
    except (BlockingIOError, BrokenPipeError):
        pass


for forwarded in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(forwarded, forward)

try:
    boundary = subprocess.Popen(
        [boundary_binary, *command],
        close_fds=True,
        pass_fds=pass_fds,
        start_new_session=True,
    )
    os.close(signal_read)
except BaseException:
    os.close(signal_read)
    os.close(signal_write)
    raise
try:
    returncode = boundary.wait()
finally:
    os.close(signal_write)
raise SystemExit(returncode)
PY
WRAPPER
  } | sc_atomic "$wrapper" 500
}

sc_write_operator_programs() {
  (( SC_OPERATOR_ENABLED )) || return 0
  local frozen="$SC_OPERATOR_CONTROL/declaration.json" service_program="$SC_OPERATOR_CONTROL/service.py"
  local ingress_program="$SC_OPERATOR_CONTROL/ingress.cjs" wrapper="$SC_OPERATOR_CONTROL/application-wrapper"
  local cwd_visible
  cwd_visible="$SC_PROJECT/$(jq -r '.cwd' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  printf '%s\n' "$SC_OPERATOR_DECLARATION_JSON" | sc_atomic "$frozen" 600
  [[ "$(sha256sum -- "$SC_OPERATOR_DECLARATION_PATH" | awk '{print $1}')" == "$SC_OPERATOR_DECLARATION_SHA256" ]] ||
    sc_die "operator declaration changed while it was being frozen"
  sc_emit_operator_service | sc_atomic "$service_program" 500
  sc_emit_operator_ingress | sc_atomic "$ingress_program" 500
  sc_write_operator_app_wrapper
  jq -n \
    --arg name "$SC_OPERATOR_NAME" --arg run "$SC_RUN_ID" \
    --arg runtime "$SC_OPERATOR_LISTENER_ROOT" --arg control "$SC_OPERATOR_CONTROL" \
    --arg status "$SC_OPERATOR_SERVICE_STATUS" --arg log "$SC_OPERATOR_CONTROL/application.log" \
    --arg listen "$SC_OPERATOR_LISTEN" --arg cwd "$SC_PROJECT" --arg wrapper "$wrapper" \
    --arg declaration "$SC_OPERATOR_DECLARATION_SHA256" \
    --argjson ready "$(jq '.ready_timeout_seconds' <<<"$SC_OPERATOR_DECLARATION_JSON")" \
    --argjson restart "$(jq '.restart' <<<"$SC_OPERATOR_DECLARATION_JSON")" \
    --argjson adapter "$(jq '.adapter // {mode:"socket-activation",target_port:null}' <<<"$SC_OPERATOR_DECLARATION_JSON")" \
    --argjson stopGrace "$SC_OPERATOR_STOP_GRACE_SECONDS" \
    --argjson logMax "$SC_OPERATOR_LOG_MAX_BYTES" '
      {schema:"sandcodex.operator-service-config.v1",name:$name,run_id:$run,
       runtime_root:$runtime,control_root:$control,status_file:$status,log_file:$log,
       log_max_bytes:$logMax,
       listen_relative:$listen,cwd:$cwd,argv:[$wrapper],ready_timeout_seconds:$ready,
       restart:$restart,stop:{grace_seconds:$stopGrace},adapter:$adapter,
       declaration_sha256:$declaration}
    ' | sc_atomic "$SC_OPERATOR_SERVICE_CONFIG" 600
  SC_OPERATOR_HELPER="$SC_AGENT_BIN/sandcodex-operator-service"
  {
    printf '#!/usr/bin/env bash\nset -Eeuo pipefail\numask 077\n'
    printf 'socket=%q\nrun_id=%q\n' "/run/sandcodex/operator-control/$SC_OPERATOR_NAME.service.sock" "$SC_RUN_ID"
    cat <<'HELPER'
[[ ${SANDCODEX_ACTIVE:-0} == 1 && ${SANDCODEX_RUN_ID:-} == "$run_id" ]] || {
  printf 'sandcodex-operator-service: unavailable outside its authorized command room\n' >&2; exit 77;
}
usage() { printf 'usage: sandcodex-operator-service status | restart --expected-generation N | stop --expected-generation N\n' >&2; exit 64; }
action=${1:-}; shift || true
case "$action" in
  status) (( $# == 0 )) || usage; request='{"op":"status"}' ;;
  restart|stop)
    [[ ${1:-} == --expected-generation && ${2:-} =~ ^[1-9][0-9]{0,8}$ && $# == 2 ]] || usage
    request=$(printf '{"op":"%s","expected_generation":%s}' "$action" "$2") ;;
  *) usage ;;
esac
python3 -P - "$socket" "$request" <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(10); s.connect(sys.argv[1])
s.sendall((sys.argv[2] + "\n").encode()); data = bytearray()
while b"\n" not in data and len(data) <= 1024 * 1024:
    chunk = s.recv(65536)
    if not chunk: break
    data.extend(chunk)
s.close()
if b"\n" not in data: raise SystemExit("operator supervisor returned no result")
value = json.loads(bytes(data).split(b"\n", 1)[0]); print(json.dumps(value, indent=2, sort_keys=True))
raise SystemExit(0 if value.get("ok") else 1)
PY
HELPER
  } | sc_atomic "$SC_OPERATOR_HELPER" 500
  sc_log_event info operator_declaration_frozen "operator declaration validated and frozen" \
    "name=$SC_OPERATOR_NAME" "sha256=$SC_OPERATOR_DECLARATION_SHA256" "cwd=$cwd_visible"
}

sc_start_operator_service() {
  (( SC_OPERATOR_ENABLED )) || return 0
  SC_OPERATOR_SERVICE_READY="$SC_OPERATOR_CONTROL/service-ready.json"
  : >"$SC_OPERATOR_SERVICE_READY"; chmod 600 -- "$SC_OPERATOR_SERVICE_READY"
  sc_note "starting project operator service · $SC_OPERATOR_NAME"
  env -i PATH="$SC_PATH" LANG="${LANG:-C.UTF-8}" PYTHONSAFEPATH=1 \
    python3 -P "$SC_OPERATOR_CONTROL/service.py" "$SC_OPERATOR_SERVICE_CONFIG" \
    >"$SC_OPERATOR_SERVICE_READY" 2>>"$SC_RUN_ROOT/operator-service.log" &
  SC_OPERATOR_SERVICE_PID=$!
  SC_OPERATOR_SERVICE_START="$(sc_process_start "$SC_OPERATOR_SERVICE_PID" 2>/dev/null || true)"
  [[ "$SC_OPERATOR_SERVICE_START" =~ ^[0-9]+$ ]] || return 1
  local attempt ready="" ready_seconds restart_limit restart_delay wait_tenths
  ready_seconds="$(jq -r '.ready_timeout_seconds' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  restart_limit="$(jq -r '.restart.limit' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  restart_delay="$(jq -r '.restart.base_delay_seconds' <<<"$SC_OPERATOR_DECLARATION_JSON")"
  wait_tenths=$(( (ready_seconds * (restart_limit + 1) + restart_delay * restart_limit + 5) * 10 ))
  for (( attempt=0; attempt<wait_tenths; attempt++ )); do
    if [[ -s "$SC_OPERATOR_SERVICE_READY" ]]; then ready="$(head -n 1 "$SC_OPERATOR_SERVICE_READY")"; break; fi
    sc_pid_still_matches "$SC_OPERATOR_SERVICE_PID" "$SC_OPERATOR_SERVICE_START" || break
    sleep 0.1
  done
  if ! jq -e --arg name "$SC_OPERATOR_NAME" --arg run "$SC_RUN_ID" --arg declaration "$SC_OPERATOR_DECLARATION_SHA256" '
    .ready == true and .status.name == $name and .status.run_id == $run and
    .status.state == "ready" and .status.service_generation == 1 and
    .status.declaration_sha256 == $declaration
  ' <<<"$ready" >/dev/null 2>&1; then
    local detail
    detail="$(tail -n 40 "$SC_RUN_ROOT/operator-service.log" "$SC_OPERATOR_CONTROL/application.log" 2>/dev/null || true)"
    sc_log_event error operator_service_readiness "operator service failed readiness" "detail=$detail"
    [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
    return 1
  fi
  if [[ ! -S "$SC_OPERATOR_LISTENER_ROOT/$SC_OPERATOR_LISTEN" || -L "$SC_OPERATOR_LISTENER_ROOT/$SC_OPERATOR_LISTEN" ]]; then
    sc_log_event error operator_service_listener "operator service readiness omitted its stable private listener"
    return 1
  fi
  sc_ok "operator service ready · generation 1 · stable private listener"
}

sc_start_operator_ingress() {
  (( SC_OPERATOR_ENABLED )) || return 0
  local service_identity
  service_identity="$(stat -c '%d:%i' -- "$SC_OPERATOR_LISTENER_ROOT/$SC_OPERATOR_LISTEN")"
  jq -n \
    --arg name "$SC_OPERATOR_NAME" --arg run "$SC_RUN_ID" --arg runtime "$SC_OPERATOR_LISTENER_ROOT" \
    --arg target "$SC_OPERATOR_LISTEN" --arg control "$SC_OPERATOR_CONTROL" \
    --arg bootstrap "$SC_OPERATOR_BOOTSTRAP_ROOT" --arg status "$SC_OPERATOR_INGRESS_STATUS" \
    --argjson requestMax "$(jq '.ingress.request_max_bytes' <<<"$SC_OPERATOR_DECLARATION_JSON")" \
    --argjson responseMax "$(jq '.ingress.response_max_bytes' <<<"$SC_OPERATOR_DECLARATION_JSON")" \
    --argjson connections "$SC_OPERATOR_MAX_CONNECTIONS" '
      {schema:"sandcodex.operator-ingress-config.v1",name:$name,run_id:$run,generation:1,
       runtime_root:$runtime,target_relative:$target,control_root:$control,
       bootstrap_root:$bootstrap,status_file:$status,request_max_bytes:$requestMax,
       response_max_bytes:$responseMax,max_connections:$connections,idle_timeout_ms:30000}
    ' | sc_atomic "$SC_OPERATOR_INGRESS_CONFIG" 600
  SC_OPERATOR_INGRESS_READY="$SC_OPERATOR_CONTROL/ingress-ready.json"
  : >"$SC_OPERATOR_INGRESS_READY"; chmod 600 -- "$SC_OPERATOR_INGRESS_READY"
  env -i PATH="$SC_PATH" LANG="${LANG:-C.UTF-8}" \
    node "$SC_OPERATOR_CONTROL/ingress.cjs" "$SC_OPERATOR_INGRESS_CONFIG" \
    >"$SC_OPERATOR_INGRESS_READY" 2>>"$SC_RUN_ROOT/operator-ingress.log" &
  SC_OPERATOR_INGRESS_PID=$!
  SC_OPERATOR_INGRESS_START="$(sc_process_start "$SC_OPERATOR_INGRESS_PID" 2>/dev/null || true)"
  [[ "$SC_OPERATOR_INGRESS_START" =~ ^[0-9]+$ ]] || return 1
  local attempt ready=""
  for (( attempt=0; attempt<100; attempt++ )); do
    if [[ -s "$SC_OPERATOR_INGRESS_READY" ]]; then ready="$(head -n 1 "$SC_OPERATOR_INGRESS_READY")"; break; fi
    sc_pid_still_matches "$SC_OPERATOR_INGRESS_PID" "$SC_OPERATOR_INGRESS_START" || break
    sleep 0.1
  done
  if ! jq -e --arg identity "$service_identity" '
    .ready == true and .state == "listening" and .listener.address == "127.0.0.1" and
    ((.target_identity.dev + ":" + .target_identity.ino) == $identity) and
    (.bootstrap_file | type == "string") and (.control_socket | type == "string")
  ' <<<"$ready" >/dev/null 2>&1; then
    local detail
    detail="$(tail -n 40 "$SC_RUN_ROOT/operator-ingress.log" 2>/dev/null || true)"
    sc_log_event error operator_ingress_readiness "operator ingress failed readiness" "detail=$detail"
    [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
    return 1
  fi
  sc_ok "operator cockpit ready · authenticated host loopback · $(jq -r '.listener.url' <<<"$ready")"
}

sc_operator_write_locator() {
  (( SC_OPERATOR_ENABLED )) || return 0
  local service_identity ingress_identity service_generation ingress_generation
  service_identity="$(stat -c '%d:%i' -- "$SC_OPERATOR_SERVICE_SOCKET")"
  ingress_identity="$(stat -c '%d:%i' -- "$SC_OPERATOR_INGRESS_SOCKET")"
  service_generation="$(jq -r '.service_generation' "$SC_OPERATOR_SERVICE_STATUS")"
  ingress_generation="$(jq -r '.ingress_generation' "$SC_OPERATOR_INGRESS_STATUS")"
  jq -n \
    --arg project "$SC_PROJECT" --arg key "$SC_PROJECT_KEY" --arg run "$SC_RUN_ID" \
    --argjson launcherPid "$$" --arg launcherStart "$SC_PROCESS_START" \
    --argjson servicePid "$SC_OPERATOR_SERVICE_PID" --arg serviceStart "$SC_OPERATOR_SERVICE_START" \
    --argjson ingressPid "$SC_OPERATOR_INGRESS_PID" --arg ingressStart "$SC_OPERATOR_INGRESS_START" \
    --arg serviceSocket "$SC_OPERATOR_SERVICE_SOCKET" --arg serviceIdentity "$service_identity" \
    --arg ingressSocket "$SC_OPERATOR_INGRESS_SOCKET" --arg ingressIdentity "$ingress_identity" \
    --arg serviceStatus "$SC_OPERATOR_SERVICE_STATUS" --arg ingressStatus "$SC_OPERATOR_INGRESS_STATUS" \
    --arg declaration "$SC_OPERATOR_DECLARATION_SHA256" \
    --argjson serviceGeneration "$service_generation" --argjson ingressGeneration "$ingress_generation" '
      {schema:"sandcodex.operator-active.v1",project:$project,project_key:$key,run_id:$run,
       launcher:{pid:$launcherPid,start_ticks:$launcherStart},
       service:{pid:$servicePid,start_ticks:$serviceStart,control_socket:$serviceSocket,
         control_identity:$serviceIdentity,status_file:$serviceStatus,generation:$serviceGeneration},
       ingress:{pid:$ingressPid,start_ticks:$ingressStart,control_socket:$ingressSocket,
         control_identity:$ingressIdentity,status_file:$ingressStatus,generation:$ingressGeneration},
       declaration_sha256:$declaration}
    ' | sc_atomic "$SC_OPERATOR_LOCATOR" 600
  SC_OPERATOR_LOCATOR_IDENTITY="$(stat -c '%d:%i' -- "$SC_OPERATOR_LOCATOR")"
}

sc_open_operator_bootstrap() {
  local filename="$1" opener
  [[ -f "$filename" && ! -L "$filename" && "$(stat -c %u -- "$filename")" == "$(id -u)" && \
    "$(stat -c %a -- "$filename")" == 600 && "$(stat -c %h -- "$filename")" == 1 ]] ||
    sc_die "operator bootstrap file is invalid"
  opener="$(command -v xdg-open 2>/dev/null || true)"
  [[ -n "$opener" ]] || sc_die "opening the operator cockpit requires xdg-open"
  "$opener" "file://$filename" >/dev/null 2>&1 &
  disown "$!" 2>/dev/null || true
  sc_note "operator cockpit bootstrap opened in the desktop browser"
}

sc_start_operator_stack() {
  (( SC_OPERATOR_ENABLED )) || return 0
  sc_write_operator_programs
  sc_start_operator_service || sc_die "operator service failed its exact readiness check"
  sc_start_operator_ingress || sc_die "operator cockpit ingress failed its exact readiness check"
  sc_operator_write_locator
  if (( SC_OPERATOR_OPEN )); then
    sc_open_operator_bootstrap "$(jq -er '.bootstrap_file' "$SC_OPERATOR_INGRESS_READY")"
  fi
}

sc_operator_validate_control_endpoint() {
  local socket_path="$1" identity="$2" label="$3" root parent observed
  [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] || sc_die "$label identity is invalid"
  [[ -S "$socket_path" && ! -L "$socket_path" ]] || sc_die "$label is unavailable"
  [[ "$(stat -c '%u:%a:%h' -- "$socket_path")" == "$(id -u):600:1" ]] || sc_die "$label is not private"
  observed="$(stat -c '%d:%i' -- "$socket_path")"
  [[ "$observed" == "$identity" ]] || sc_die "$label changed identity"
  root="$(dirname -- "$socket_path")"; parent="$(dirname -- "$root")"
  sc_owned_dir "$root" "$label root"
  [[ "$(stat -c %a -- "$root")" == 700 ]] || sc_die "$label root is not private"
  case "$parent" in
    /run/user/"$(id -u)"/scx.??????|/tmp/scx.??????) ;;
    *) sc_die "$label is outside a recognized short runtime" ;;
  esac
}

sc_operator_validate_status_file() {
  local path="$1" control_socket="$2" label="$3"
  sc_owned_single_file "$path" 600 "$label"
  [[ "$(dirname -- "$path")" == "$(dirname -- "$control_socket")" ]] ||
    sc_die "$label is outside its control transit"
}

sc_operator_load_locator() {
  SC_OPERATOR_LOCATOR="$SC_GLOBAL/operator-active/$SC_PROJECT_KEY.json"
  [[ -f "$SC_OPERATOR_LOCATOR" && ! -L "$SC_OPERATOR_LOCATOR" ]] ||
    sc_die "no active Sandcodex operator service exists for this project" 69
  sc_owned_single_file "$SC_OPERATOR_LOCATOR" 600 "active operator locator"
  SC_OPERATOR_LOCATOR_JSON="$(jq -ce \
    --arg project "$SC_PROJECT" --arg key "$SC_PROJECT_KEY" '
      select(type == "object" and .schema == "sandcodex.operator-active.v1" and
        .project == $project and .project_key == $key and
        (.run_id | type == "string" and test("^[A-Za-z0-9._:-]{1,96}$")) and
        (.launcher.pid | type == "number") and (.launcher.start_ticks | test("^[0-9]+$")) and
        (.service.pid | type == "number") and (.service.start_ticks | test("^[0-9]+$")) and
        (.ingress.pid | type == "number") and (.ingress.start_ticks | test("^[0-9]+$")) and
        (.service.control_socket | type == "string") and (.service.control_identity | test("^[0-9]+:[0-9]+$")) and
        (.service.status_file | type == "string") and (.service.generation | type == "number" and . >= 1 and floor == .) and
        (.ingress.control_socket | type == "string") and (.ingress.control_identity | test("^[0-9]+:[0-9]+$")) and
        (.ingress.status_file | type == "string") and (.ingress.generation | type == "number" and . >= 1 and floor == .) and
        (.declaration_sha256 | test("^[0-9a-f]{64}$")))
    ' "$SC_OPERATOR_LOCATOR" 2>/dev/null)" || sc_die "active operator locator is invalid"
  local launcher_pid launcher_start service_pid service_start ingress_pid ingress_start
  launcher_pid="$(jq -r '.launcher.pid' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  launcher_start="$(jq -r '.launcher.start_ticks' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  service_pid="$(jq -r '.service.pid' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  service_start="$(jq -r '.service.start_ticks' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  ingress_pid="$(jq -r '.ingress.pid' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  ingress_start="$(jq -r '.ingress.start_ticks' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  sc_pid_still_matches "$launcher_pid" "$launcher_start" || sc_die "operator command room is no longer active" 69
  sc_pid_still_matches "$service_pid" "$service_start" || sc_die "operator service supervisor is no longer active" 69
  sc_pid_still_matches "$ingress_pid" "$ingress_start" || sc_die "operator ingress is no longer active" 69
  SC_OPERATOR_SERVICE_SOCKET="$(jq -r '.service.control_socket' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  SC_OPERATOR_INGRESS_SOCKET="$(jq -r '.ingress.control_socket' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  sc_operator_validate_control_endpoint "$SC_OPERATOR_SERVICE_SOCKET" \
    "$(jq -r '.service.control_identity' <<<"$SC_OPERATOR_LOCATOR_JSON")" "operator service control"
  sc_operator_validate_control_endpoint "$SC_OPERATOR_INGRESS_SOCKET" \
    "$(jq -r '.ingress.control_identity' <<<"$SC_OPERATOR_LOCATOR_JSON")" "operator ingress control"
  local service_status ingress_status run_id service_generation ingress_generation
  service_status="$(jq -r '.service.status_file' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  ingress_status="$(jq -r '.ingress.status_file' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  run_id="$(jq -r '.run_id' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  service_generation="$(jq -r '.service.generation' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  ingress_generation="$(jq -r '.ingress.generation' <<<"$SC_OPERATOR_LOCATOR_JSON")"
  sc_operator_validate_status_file "$service_status" "$SC_OPERATOR_SERVICE_SOCKET" "operator service status"
  sc_operator_validate_status_file "$ingress_status" "$SC_OPERATOR_INGRESS_SOCKET" "operator ingress status"
  jq -e --arg run "$run_id" --argjson pid "$service_pid" --arg start "$service_start" \
    --arg declaration "$(jq -r '.declaration_sha256' <<<"$SC_OPERATOR_LOCATOR_JSON")" \
    --argjson generation "$service_generation" '
      .schema == "sandcodex.operator-service-status.v1" and .run_id == $run and
      .supervisor_pid == $pid and .supervisor_start_ticks == $start and
      .declaration_sha256 == $declaration and .service_generation >= $generation
    ' "$service_status" >/dev/null || sc_die "operator service status binding is invalid"
  jq -e --arg run "$run_id" --argjson pid "$ingress_pid" --arg start "$ingress_start" \
    --argjson generation "$ingress_generation" '
      .schema == "sandcodex.operator-ingress-status.v1" and .run_id == $run and
      .ingress_pid == $pid and .ingress_start_ticks == $start and
      .ingress_generation == $generation
    ' "$ingress_status" >/dev/null || sc_die "operator ingress status binding is invalid"
}

sc_operator_render_status() {
  local service="$1" ingress="$2" combined
  combined="$(jq -cn --argjson service "$service" --argjson ingress "$ingress" \
    --arg project "$SC_PROJECT" --arg run "$(jq -r '.run_id' <<<"$SC_OPERATOR_LOCATOR_JSON")" '
      {schema:"sandcodex.operator-status.v1",project:$project,run_id:$run,
       service:$service.status,ingress:$ingress.status,
       url:$ingress.status.listener.url}
    ')"
  if (( SC_OPERATOR_JSON )); then
    printf '%s\n' "$combined"
  else
    jq -r '
      "Sandcodex operator service\n"
      + "  result      " + (if .service.state == "running" and .ingress.state == "running" then "READY" else "CHECK REQUIRED" end) + "\n"
      + "  project     \(.project)\n"
      + "  run         \(.run_id)\n"
      + "  service     \(.service.state) (generation \(.service.service_generation))\n"
      + "  adapter     \(.service.adapter.mode)\(if .service.adapter.target_port then " -> 127.0.0.1:" + (.service.adapter.target_port|tostring) else "" end)\n"
      + "  app log     \(.service.application_log_bytes)/\(.service.application_log_max_bytes) bytes\(if .service.application_log_dropped_bytes > 0 then "; " + (.service.application_log_dropped_bytes|tostring) + " discarded" else "" end)\n"
      + "  build       \(.service.last_ready_application_build_id // "unreported")\n"
      + "  stop grace  \(.service.stop_grace_seconds)s\n"
      + "  ingress     \(.ingress.state) (generation \(.ingress.ingress_generation))\n"
      + "  sessions    \(.ingress.active_sessions)\n"
      + "  URL         \(.url)\n"
      + "\nnext\n"
      + "  open        sandcodex operator open\n"
      + "  restart     sandcodex operator restart-service --expected-generation \(.service.service_generation)\n"
      + "  revoke      sandcodex operator revoke-sessions"
    ' <<<"$combined"
  fi
}

sc_operator_host_dispatch() {
  SC_OPERATION="operator-$SC_OPERATOR_ACTION"
  sc_operator_load_locator
  local request response service ingress bootstrap revoke
  case "$SC_OPERATOR_ACTION" in
    status)
      service="$(sc_operator_control_request "$SC_OPERATOR_SERVICE_SOCKET" '{"op":"status"}')"
      ingress="$(sc_operator_control_request "$SC_OPERATOR_INGRESS_SOCKET" '{"op":"status"}')"
      if ! jq -e '.ok == true' <<<"$service" >/dev/null ||
