+static void sandcodex_stylus_deescalate(
+        struct wlr_tablet_v2_tablet_tool *tool) {
+    if (!tool) {
+        return;
+    }
+    if (tool->is_down) {
+        wlr_tablet_v2_tablet_tool_notify_up(tool);
+    }
+    if (wlr_tablet_tool_v2_has_implicit_grab(tool)) {
+        wlr_tablet_tool_v2_end_grab(tool);
+    }
+    size_t release_budget = tool->num_buttons < WLR_TABLET_V2_TOOL_BUTTONS_CAP ?
+        tool->num_buttons : WLR_TABLET_V2_TOOL_BUTTONS_CAP;
+    while (tool->num_buttons > 0 && release_budget-- > 0) {
+        size_t before = tool->num_buttons;
+        uint32_t button = tool->pressed_buttons[before - 1];
+        wlr_tablet_v2_tablet_tool_notify_button(tool, button,
+            ZWP_TABLET_PAD_V2_BUTTON_STATE_RELEASED);
+        if (tool->num_buttons >= before) {
+            break;
+        }
+    }
+    wlr_tablet_v2_tablet_tool_notify_pressure(tool, 0.0);
+    if (tool->focused_surface || tool->current_client) {
+        wlr_tablet_v2_tablet_tool_notify_proximity_out(tool);
+    }
+}
