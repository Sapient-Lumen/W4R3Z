sc_emit_gemini_responses_adapter() {
  cat <<'SANDCODEX_GEMINI_RESPONSES_ADAPTER_PY'
#!/usr/bin/env python3
"""Sandcodex-owned OpenAI Responses to Gemini Interactions v1 adapter.

The adapter is intentionally credential-isolating.  Codex authenticates with a
random launch token; Google credentials remain in private host-side files.  A
request is completely buffered before any semantic response bytes are emitted,
which permits bounded model fallback and authentication recovery without
replaying a visible tool call.
Provider response bodies, prompts, tool arguments, and credential values are
never written to this process's diagnostics.
"""
from __future__ import annotations

import argparse
import base64
import contextlib
import datetime as dt
import email.utils
import fcntl
import hashlib
import hmac
from http import HTTPStatus
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import math
import os
from pathlib import Path
import re
import select
import signal
import socket
import stat
import sys
import tempfile
import threading
import time
from typing import Any, Callable, Iterable, NoReturn, Sequence
from urllib.parse import urlsplit
import uuid
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

ADAPTER_SCHEMA = "sandcodex.gemini-responses-adapter.v1"
CONFIG_SCHEMA = "sandcodex.gemini-adapter-config.v1"
READY_SCHEMA = "sandcodex.gemini-adapter-ready.v1"
STATE_SCHEMA = "sandcodex.gemini-reasoning-state.v1"
COOLDOWN_SCHEMA = "sandcodex.gemini-cooldowns.v1"
STATE_PREFIX = "scg1."
MAX_REQUEST_BYTES = 64 * 1024 * 1024
MAX_UPSTREAM_BYTES = 64 * 1024 * 1024
MAX_STATE_BYTES = 2 * 1024 * 1024
MAX_TOOLS = 256
MAX_OUTPUT_ITEMS = 4096
MAX_ATTEMPTS = 32
MAX_MODEL_FAILURES_PER_REQUEST = 2
MAX_ROUTE_FAILURES_PER_REQUEST = 2
MAX_SCHEMA_DEPTH = 64
MAX_SCHEMA_NODES = 100_000
MAX_REQUEST_WINDOWS = 2048
REQUEST_WINDOW_RESET_SECONDS = 300
ROUTE_EVENT_LIMIT = 64
ROUTE_EVENT_RETENTION_DAYS = 7
SCHEDULER_LIMIT = 32
LEGACY_MODEL_QUOTA_REASONS = {"quota", "rate-limit", "daily-quota"}
MODEL_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,191}\Z")
TOOL_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}\Z")
KEY_RE = re.compile(r"(?:AIza[0-9A-Za-z_-]{20,}|AQ\.[0-9A-Za-z_-]{30,})\Z")
# Interactions v1 stateless continuation requires every model-generated step,
# including opaque signatures and fields unknown to this adapter, to be replayed
# exactly.  Codex understands the semantic projections (message/tool/search
# items) but does not have a native container for the original Gemini object,
# so Sandcodex emits a paired opaque reasoning item for each such step.
EXACT_GEMINI_STEPS = {
    "thought", "function_call", "model_output",
    "google_search_call", "google_search_result",
}
PAIRED_SEMANTIC_STEPS = {"function_call", "model_output", "google_search_call"}


class AdapterError(Exception):
    def __init__(self, message: str, *, status: int = 400, code: str = "invalid_request",
                 retry_after: int | None = None) -> None:
        super().__init__(message)
        self.status = status
        self.code = code
        self.retry_after = retry_after


class UpstreamError(Exception):
    def __init__(self, status: int, category: str, retry_after: int | None = None,
                 quota_scope: str | None = None, detail_code: str | None = None) -> None:
        super().__init__(category)
        self.status = status
        self.category = category
        self.retry_after = retry_after
        self.quota_scope = quota_scope
        self.detail_code = detail_code


def canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                      allow_nan=False).encode("utf-8")


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(value: object) -> dt.datetime | None:
    if not isinstance(value, str):
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(dt.timezone.utc)
    except (ValueError, OverflowError):
        return None


def private_regular(path: Path, label: str, *, max_bytes: int = 16 * 1024 * 1024) -> bytes:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        raise AdapterError(f"{label} is unavailable", status=78, code="unsafe_state") from exc
    try:
        metadata = os.fstat(fd)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077):
            raise AdapterError(f"{label} metadata is unsafe", status=78, code="unsafe_state")
        if metadata.st_size > max_bytes:
            raise AdapterError(f"{label} exceeds its size limit", status=78, code="unsafe_state")
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(fd, min(remaining, 1024 * 1024))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        if len(raw) > max_bytes:
            raise AdapterError(f"{label} exceeds its size limit", status=78, code="unsafe_state")
        return raw
    finally:
        os.close(fd)


def private_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(private_regular(path, label))
    except (ValueError, UnicodeError) as exc:
        raise AdapterError(f"{label} is not valid JSON", status=78, code="unsafe_state") from exc
    if not isinstance(value, dict):
        raise AdapterError(f"{label} root is not an object", status=78, code="unsafe_state")
    return value


def atomic_private_json(path: Path, value: dict[str, Any]) -> None:
    parent = path.parent
    metadata = parent.lstat()
    if (not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid()
            or stat.S_IMODE(metadata.st_mode) & 0o077):
        raise AdapterError("state directory is unsafe", status=78, code="unsafe_state")
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), 0o600)
            stream.write(canonical(value) + b"\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)


def text_part(text: str) -> dict[str, Any]:
    return {"type": "text", "text": text}


def content_text(value: object) -> str:
    if isinstance(value, str):
        return value
    if value is None:
        return ""
    if isinstance(value, (dict, list, bool, int, float)):
        return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                          allow_nan=False)
    raise AdapterError("tool output has an unsupported value type")


def encode_state(step: dict[str, Any], model: str) -> str:
    raw = canonical({"schema": STATE_SCHEMA, "model": model, "step": step})
    if len(raw) > MAX_STATE_BYTES:
        raise AdapterError("Gemini reasoning state exceeds the adapter limit", status=502,
                           code="upstream_protocol")
    return STATE_PREFIX + base64.urlsafe_b64encode(raw).rstrip(b"=").decode("ascii")


def decode_state(value: object) -> tuple[str, dict[str, Any]]:
    if not isinstance(value, str) or not value.startswith(STATE_PREFIX):
        raise AdapterError("conversation contains reasoning state not issued by this Gemini adapter",
                           status=409, code="provider_state_mismatch")
    token = value[len(STATE_PREFIX):]
    if not token or len(token) > (MAX_STATE_BYTES * 2):
        raise AdapterError("Gemini reasoning state is malformed", status=409,
                           code="provider_state_mismatch")
    try:
        raw = base64.urlsafe_b64decode(token + "=" * (-len(token) % 4))
        state = json.loads(raw)
    except (ValueError, UnicodeError) as exc:
        raise AdapterError("Gemini reasoning state is malformed", status=409,
                           code="provider_state_mismatch") from exc
    if (not isinstance(state, dict) or state.get("schema") != STATE_SCHEMA
            or not isinstance(state.get("model"), str)
            or not isinstance(state.get("step"), dict)
            or state["step"].get("type") not in EXACT_GEMINI_STEPS):
        raise AdapterError("Gemini reasoning state has an invalid schema", status=409,
                           code="provider_state_mismatch")
    return state["model"], state["step"]


def media_part(item: dict[str, Any]) -> dict[str, Any]:
    item_type = item.get("type")
    if item_type == "input_image":
        source = item.get("image_url")
        media_type = "image"
    elif item_type == "input_audio":
        source = item.get("audio_url") or item.get("data")
        media_type = "audio"
    elif item_type == "input_file":
        source = item.get("file_url") or item.get("file_data")
        media_type = "document"
    else:
        raise AdapterError("unsupported media content type")
    if not isinstance(source, str) or not source:
        raise AdapterError(f"{item_type} has no usable source")
    if source.startswith("data:"):
        header, separator, data = source.partition(",")
        if not separator or ";base64" not in header:
            raise AdapterError("media data URI must use base64")
        mime = header[5:].split(";", 1)[0]
        if not mime or len(mime) > 127:
            raise AdapterError("media data URI has an invalid MIME type")
        try:
            base64.b64decode(data, validate=True)
        except ValueError as exc:
            raise AdapterError("media data URI has invalid base64") from exc
        return {"type": media_type, "data": data, "mime_type": mime}
    parsed = urlsplit(source)
    if parsed.scheme not in {"http", "https", "gs"}:
        raise AdapterError("media URI scheme is not supported")
    return {"type": media_type, "uri": source}


def message_parts(content: object, *, output: bool = False) -> list[dict[str, Any]]:
    if isinstance(content, str):
        return [text_part(content)]
    if not isinstance(content, list):
        raise AdapterError("message content must be a string or array")
    parts: list[dict[str, Any]] = []
    for item in content:
        if isinstance(item, str):
            parts.append(text_part(item))
            continue
        if not isinstance(item, dict):
            raise AdapterError("message content item must be an object")
        item_type = item.get("type")
        if item_type in {"input_text", "output_text", "text"}:
            text = item.get("text")
            if not isinstance(text, str):
                raise AdapterError("text content has no string text")
            parts.append(text_part(text))
        elif not output and item_type in {"input_image", "input_audio", "input_file"}:
            parts.append(media_part(item))
        elif item_type == "refusal":
            refusal = item.get("refusal")
            if not isinstance(refusal, str):
                raise AdapterError("refusal content is malformed")
            parts.append(text_part(refusal))
        else:
            raise AdapterError(f"unsupported message content type: {item_type!r}")
    if not parts:
        parts.append(text_part(""))
    return parts


def tool_result_parts(output: object) -> list[dict[str, Any]]:
    if isinstance(output, list):
        parts: list[dict[str, Any]] = []
        for item in output:
            if isinstance(item, dict) and item.get("type") in {
                    "input_text", "output_text", "text", "input_image", "input_audio", "input_file"}:
                if item.get("type") in {"input_text", "output_text", "text"}:
                    parts.append(text_part(content_text(item.get("text"))))
                else:
                    parts.append(media_part(item))
            else:
                parts.append(text_part(content_text(item)))
        return parts or [text_part("")]
    return [text_part(content_text(output))]


def gemini_tool_alias(kind: str, name: str, namespace: str | None = None) -> str:
    """Return a stable Gemini-safe name while preserving Codex identity separately."""
    # Native Responses tool_search has no name on the wire.  Give it a private
    # alias so an ordinary client function named ``tool_search`` can never
    # collide with the deferred-tool protocol.
    if (kind != "tool_search" and namespace is None
            and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,63}", name)):
        return name
    identity = f"{kind}\0{namespace or ''}\0{name}".encode()
    digest = hashlib.sha256(identity).hexdigest()[:12]
    stem = re.sub(r"[^A-Za-z0-9_]", "_", name).strip("_") or "tool"
    return f"sc_{digest}_{stem}"[:64]


def deferred_tool_inventory(request: dict[str, Any]) -> list[dict[str, Any]]:
    """Return the union of tools Codex revealed through tool_search history.

    OpenAI's Responses implementation treats ``tool_search_output`` as a
    dynamic declaration: a model may call one of the returned tools on the
    next request even though Codex deliberately does not inject that tool into
    the ordinary ``tools`` array. Gemini Interactions has no equivalent wire
    primitive, so the adapter must materialize the discovered declarations.
    Repeated searches commonly return overlapping namespace fragments; merge
    identical fragments and fail closed if one identity changes underneath an
    existing conversation.
    """
    value = request.get("input", [])
    if isinstance(value, str):
        return []
    if not isinstance(value, list):
        raise AdapterError("input must be a string or array")
    namespaces: dict[str, dict[str, Any]] = {}
    standalone: dict[tuple[str, str], dict[str, Any]] = {}
    discovered_count = 0

    def add_standalone(tool: dict[str, Any]) -> None:
        nonlocal discovered_count
        tool_type, name = tool.get("type"), tool.get("name")
        if tool_type not in {"function", "custom"} or not isinstance(name, str):
            raise AdapterError("tool-search result contains an unsupported declaration")
        identity = (tool_type, name)
        previous = standalone.get(identity)
        if previous is not None:
            if canonical(previous) != canonical(tool):
                raise AdapterError("tool-search result changed a discovered tool declaration",
                                   status=409, code="provider_state_mismatch")
            return
        standalone[identity] = tool
        discovered_count += 1
        if discovered_count > MAX_TOOLS:
            raise AdapterError("discovered tool declarations exceed the adapter limit")

    for item in value:
        if not isinstance(item, dict) or item.get("type") != "tool_search_output":
            continue
        tools = item.get("tools")
        if not isinstance(tools, list):
            raise AdapterError("tool-search result is malformed")
        for tool in tools:
            if not isinstance(tool, dict):
                raise AdapterError("tool-search result contains a malformed declaration")
            if tool.get("type") != "namespace":
                add_standalone(tool)
                continue
            namespace, description, children = (
                tool.get("name"), tool.get("description"), tool.get("tools"))
            if (not isinstance(namespace, str) or TOOL_RE.fullmatch(namespace) is None
                    or description is not None and not isinstance(description, str)
                    or not isinstance(children, list) or not children):
                raise AdapterError("tool-search result contains a malformed namespace")
            row = namespaces.get(namespace)
            if row is None:
                row = {"type": "namespace", "name": namespace,
                       "description": description or "", "tools": {}, "order": []}
                namespaces[namespace] = row
            elif description and row["description"] and description != row["description"]:
                raise AdapterError("tool-search result changed namespace instructions",
                                   status=409, code="provider_state_mismatch")
            elif description and not row["description"]:
                row["description"] = description
            for child in children:
                if not isinstance(child, dict):
                    raise AdapterError("tool-search namespace contains a malformed declaration")
                child_type, child_name = child.get("type"), child.get("name")
                if child_type not in {"function", "custom"} or not isinstance(child_name, str):
                    raise AdapterError("tool-search namespace contains an unsupported declaration")
                identity = (child_type, child_name)
                previous = row["tools"].get(identity)
                if previous is not None:
                    if canonical(previous) != canonical(child):
                        raise AdapterError("tool-search result changed a discovered tool declaration",
                                           status=409, code="provider_state_mismatch")
                    continue
                row["tools"][identity] = child
                row["order"].append(identity)
                discovered_count += 1
                if discovered_count > MAX_TOOLS:
                    raise AdapterError("discovered tool declarations exceed the adapter limit")

    result = list(standalone.values())
    for namespace, row in namespaces.items():
        result.append({
            "type": "namespace",
            "name": namespace,
            "description": row["description"],
            "tools": [row["tools"][identity] for identity in row["order"]],
        })
    return result


def sc_normalize_schema_literals(schema, *, maximum_nodes=20000, maximum_depth=64):
    """Copy a schema, interpreting only known schema-bearing positions.

    ``const``, ``enum``, ``default``, ``examples`` and unknown extension values
    are literal JSON, even when their object keys look like schema keywords.
    Copies are bounded by visited values (including copied inherited schemas)
    and depth. Input is never mutated. Unknown custom vocabularies are NOT
    interpreted; providers remain responsible for accepting/rejecting them.

    Raises ValueError with a fixed, content-free message on an invalid root,
    non-JSON Python value or resource limit. Does not resolve any reference.
    """
    import math

    if type(maximum_nodes) is not int or maximum_nodes < 1:
        raise ValueError("schema_invalid_node_limit")
    if type(maximum_depth) is not int or maximum_depth < 0:
        raise ValueError("schema_invalid_depth_limit")
    if not isinstance(schema, dict):
        raise ValueError("schema_root_must_be_object")
    nodes = 0

    def visit(value, depth):
        nonlocal nodes
        nodes += 1
        if nodes > maximum_nodes or depth > maximum_depth:
            raise ValueError("schema_complexity_limit")
        if value is None or type(value) in (str, bool, int):
            return
        if type(value) is float:
            if not math.isfinite(value):
                raise ValueError("schema_nonfinite_number")
            return
        if type(value) is list:
            return
        if type(value) is dict and all(type(key) is str for key in value):
            return
        raise ValueError("schema_non_json_value")

    def literal(value, depth):
        visit(value, depth)
        if isinstance(value, list):
            return [literal(item, depth + 1) for item in value]
        if isinstance(value, dict):
            return {key: literal(item, depth + 1) for key, item in value.items()}
        return value

    def walk(value, inherited, depth):
        visit(value, depth)
        if not isinstance(value, dict):
            # A boolean is a schema in current JSON Schema dialects. Other
            # malformed schema values are preserved for the upstream validator.
            if isinstance(value, list):
                return [literal(item, depth + 1) for item in value]
            return value
        own = value.get("properties")
        own = own if isinstance(own, dict) else {}
        scope = dict(inherited or {})
        scope.update(own)
        result = {}
        for keyword, child in value.items():
            if keyword == "properties" and isinstance(child, dict):
                visit(child, depth + 1)
                result[keyword] = {name: walk(item, None, depth + 2)
                                   for name, item in child.items()}
            elif keyword in {"oneOf", "anyOf", "allOf"} and isinstance(child, list):
                visit(child, depth + 1)
                result[keyword] = [walk(item, scope, depth + 2) for item in child]
            elif keyword in {"not", "if", "then", "else"} and isinstance(child, dict):
                result[keyword] = walk(child, scope, depth + 1)
            elif keyword == "dependentSchemas" and isinstance(child, dict):
                visit(child, depth + 1)
                result[keyword] = {name: walk(item, scope, depth + 2)
                                   for name, item in child.items()}
            elif keyword in {"items", "contains", "additionalProperties", "propertyNames",
                             "additionalItems", "unevaluatedProperties", "unevaluatedItems",
                             "contentSchema"} and isinstance(child, dict):
                result[keyword] = walk(child, None, depth + 1)
            elif keyword in {"prefixItems", "items"} and isinstance(child, list):
                # ``items`` arrays are the tuple form in older drafts. Whether
                # Gemini accepts that dialect is a separate qualification.
                visit(child, depth + 1)
                result[keyword] = [walk(item, None, depth + 2) for item in child]
            elif keyword in {"$defs", "definitions", "patternProperties"} and isinstance(child, dict):
                visit(child, depth + 1)
                result[keyword] = {name: walk(item, None, depth + 2)
                                   for name, item in child.items()}
            elif keyword == "dependencies" and isinstance(child, dict):
                # Legacy schema dependencies apply at the same instance;
                # property-dependency arrays remain literal string arrays.
                visit(child, depth + 1)
                result[keyword] = {
                    name: walk(item, scope, depth + 2) if isinstance(item, dict)
                    else literal(item, depth + 2) for name, item in child.items()
                }
            else:
                # Crucial distinction: JSON data is NOT another schema.
                result[keyword] = literal(child, depth + 1)

        required = result.get("required")
        local = result.get("properties")
        if isinstance(required, list):
            if local is None:
                local = {}
            if isinstance(local, dict):
                additions = {
                    name: walk(scope[name], None, depth + 2)
                    for name in required
                    if isinstance(name, str) and name not in local and name in scope
                }
                if additions:
                    result["properties"] = {**additions, **local}
        return result

    return walk(schema, None, 0)


def sc_schema_inheritance_audit(original, normalized, *, maximum_nodes=20000,
                                maximum_depth=64):
    """Inspect paired input/output from sc_normalize_schema_literals.

    Preconditions: ``normalized`` is the output of the reviewed H014 normalizer
    for ``original``. This checks its known inherited-property additions, not
    arbitrary transformations. No mutation or I/O. Limits cover this independent
    input scan; the H014 pass separately bounds its output construction.

    Reject additions into locally restrictive additionalProperties positions;
    refuse reference/identifier/custom-vocabulary or unevaluated-property schemas
    when ANY addition is planned. These latter document-wide guards deliberately
    over-reject some harmless combinations; exact scope resolution is not done.
    An empty diagnostic is NOT proof of provider support or semantic equivalence.
    """
    import math
    if type(maximum_nodes) is not int or maximum_nodes < 1:
        raise ValueError('schema_invalid_node_limit')
    if type(maximum_depth) is not int or not 0 <= maximum_depth <= 128:
        raise ValueError('schema_invalid_depth_limit')
    if type(original) is not dict or type(normalized) is not dict:
        raise ValueError('schema_root_must_be_object')
    nodes = 0
    schema_nodes = 0
    additions = 0
    sites = 0
    closed_sites = 0
    markers = set()
    # These are vocabulary positions, NOT arbitrary occurrences inside data.
    ref_keys = {'$ref', '$dynamicRef', '$recursiveRef'}
    id_keys = {'$id', 'id', '$anchor', '$dynamicAnchor', '$recursiveAnchor'}
    maps = {'properties', '$defs', 'definitions', 'patternProperties',
            'dependentSchemas', 'dependencies'}
    arrays = {'allOf', 'anyOf', 'oneOf', 'prefixItems'}
    singles = {'if', 'then', 'else', 'not', 'items', 'contains',
               'additionalProperties', 'propertyNames', 'additionalItems',
               'unevaluatedProperties', 'unevaluatedItems', 'contentSchema'}
    known_dialects = {
        'https://json-schema.org/draft/2020-12/schema',
        'https://json-schema.org/draft/2019-09/schema',
        'http://json-schema.org/draft-07/schema#',
        'http://json-schema.org/draft-06/schema#',
        'http://json-schema.org/draft-04/schema#',
    }

    def visit(value, depth):
        nonlocal nodes
        nodes += 1
        if nodes > maximum_nodes or depth > maximum_depth:
            raise ValueError('schema_complexity_limit')
        if value is None or type(value) in (str, bool, int):
            return
        if type(value) is float and math.isfinite(value):
            return
        if type(value) is list:
            return
        if type(value) is dict and all(type(key) is str for key in value):
            return
        raise ValueError('schema_non_json_value')

    def literal(value, depth):
        visit(value, depth)
        if type(value) is dict:
            for child in value.values():
                literal(child, depth + 1)
        elif type(value) is list:
            for child in value:
                literal(child, depth + 1)

    def walk(before, after, depth):
        nonlocal schema_nodes, additions, sites, closed_sites
        visit(before, depth)
        if type(before) is not dict:
            if type(before) is list:
                for child in before:
                    literal(child, depth + 1)
            return
        if type(after) is not dict:
            raise ValueError('schema_normalizer_pair_invalid')
        schema_nodes += 1
        if ref_keys.intersection(before):
            markers.add('reference_scope_not_qualified')
        if id_keys.intersection(before):
            markers.add('identifier_scope_not_qualified')
        if '$vocabulary' in before:
            markers.add('custom_vocabulary_not_qualified')
        if '$schema' in before and (type(before['$schema']) is not str or
                                    before['$schema'] not in known_dialects):
            markers.add('declared_dialect_not_qualified')
        if 'unevaluatedProperties' in before:
            markers.add('unevaluated_property_annotations_not_qualified')
        old_properties = before.get('properties', {})
        new_properties = after.get('properties', {})
        if type(old_properties) is dict and type(new_properties) is dict:
            added = set(new_properties) - set(old_properties)
            if added:
                additions += len(added)
                sites += 1
                extra = before.get('additionalProperties', True)
                if extra is not True and not (type(extra) is dict and not extra):
                    closed_sites += 1
        for key, value in before.items():
            if key not in after:
                raise ValueError('schema_normalizer_pair_invalid')
            other = after[key]
            if key in maps and type(value) is dict:
                visit(value, depth + 1)
                if type(other) is not dict:
                    raise ValueError('schema_normalizer_pair_invalid')
                for name, child in value.items():
                    if name not in other:
                        raise ValueError('schema_normalizer_pair_invalid')
                    if key == 'dependencies' and type(child) is not dict:
                        literal(child, depth + 2)
                    else:
                        walk(child, other[name], depth + 2)
            elif (key in arrays or key == 'items') and type(value) is list:
                visit(value, depth + 1)
                if type(other) is not list or len(other) != len(value):
                    raise ValueError('schema_normalizer_pair_invalid')
                for child, transformed in zip(value, other):
                    walk(child, transformed, depth + 2)
            elif key in singles and type(value) is dict:
                walk(value, other, depth + 1)
            else:
                literal(value, depth + 1)

    walk(original, normalized, 0)
    reasons = set(markers) if additions else set()
    if closed_sites:
        reasons.add('inherited_property_changes_additional_properties_scope')
    return {
        'schema': 'sandcodex-ideas.schema-inheritance-audit.v1',
        'assessment': ('requires_review_before_normalization' if reasons
                       else 'no_listed_hazard_not_a_certificate'),
        'inherited_property_additions': additions,
        'injection_sites': sites,
        'restrictive_additional_properties_sites': closed_sites,
        'schema_positions_inspected': schema_nodes,
        'input_values_inspected': nodes,
        'reasons': sorted(reasons),
        'scope_markers_present': sorted(markers),
        'input_and_normalized_pair_assumed': True,
        'provider_acceptance_tested': False,
        'semantic_equivalence_proved': False,
        'references_resolved': False,
    }


def normalize_gemini_schema(schema: dict[str, Any]) -> dict[str, Any]:
    """Keep literal JSON and refuse listed unsafe inherited-property rewrites.

    This is a conservative compatibility gate, not a complete schema validator
    or equivalence proof. Do not drop tools/constraints or retry another model
    to suppress a refusal. Review the declared schema under its actual dialect.
    """
    try:
        normalized = sc_normalize_schema_literals(
            schema, maximum_nodes=MAX_SCHEMA_NODES, maximum_depth=MAX_SCHEMA_DEPTH,
        )
        audit = sc_schema_inheritance_audit(
            schema, normalized, maximum_nodes=MAX_SCHEMA_NODES,
            maximum_depth=MAX_SCHEMA_DEPTH,
        )
    except ValueError as exc:
        raise AdapterError("Gemini schema normalization rejected invalid or over-limit input") from exc
    if audit["reasons"]:
        raise AdapterError(
            "Gemini inherited-property normalization requires schema review; declaration not sent",
            code="schema_normalization_requires_review",
        )
    return normalized


def translate_tools(tools: object, *, allow_native_search: bool = False
                    ) -> tuple[list[dict[str, Any]], dict[str, dict[str, Any]], list[str]]:
    if tools in (None, []):
        return [], {}, []
    if not isinstance(tools, list) or len(tools) > MAX_TOOLS:
        raise AdapterError("tools must be a bounded array")
    translated: list[dict[str, Any]] = []
    bridge: dict[str, dict[str, Any]] = {}
    namespace_guidance: list[str] = []
    names: set[str] = set()

    def add_client_tool(tool: dict[str, Any], *, kind: str,
                        namespace: str | None = None) -> None:
        name = tool.get("name")
        if not isinstance(name, str) or TOOL_RE.fullmatch(name) is None:
            raise AdapterError(f"{kind} tool name is missing or malformed")
        gemini_name = gemini_tool_alias(kind, name, namespace)
        if gemini_name in bridge:
            raise AdapterError("tool declarations collide after Gemini normalization")
        description = tool.get("description")
        if description is not None and not isinstance(description, str):
            raise AdapterError("tool description must be a string")
        if kind == "custom":
            parameters = {
                "type": "object",
                "properties": {"input": {"type": "string", "description": "Raw custom-tool input"}},
                "required": ["input"],
                "additionalProperties": False,
            }
        else:
            parameters = tool.get("parameters") or {"type": "object", "properties": {}}
            if not isinstance(parameters, dict):
                raise AdapterError("function parameters must be a JSON Schema object")
            parameters = normalize_gemini_schema(parameters)
        explanation = description or ""
        if kind == "custom" and name == "apply_patch":
            patch_contract = (
                "Codex apply_patch grammar (not GNU diff): input must begin with "
                "'*** Begin Patch' and end with '*** End Patch'. Between them use "
                "'*** Add File: PATH', '*** Update File: PATH', or "
                "'*** Delete File: PATH'; added file-content lines begin with '+'. "
                "For updates, use a bare '@@' line followed by exact unchanged "
                "context lines and +/- replacement lines; do not put line numbers "
                "in the @@ header. Example: '*** Begin Patch\\n*** Update File: "
                "README.md\\n@@\\n old line\\n+new line\\n*** End Patch'. Do not use "
                "---/+++, /dev/null, or *************** headers."
            )
            explanation = f"{explanation} {patch_contract}".strip()
        if namespace is not None:
            prefix = f"Codex namespace {namespace!r}; original tool name {name!r}."
            explanation = f"{prefix} {explanation}".strip()
        if kind == "tool_search":
            explanation = (
                f"{explanation} Search only when the needed tool is not already available. "
                "The result will declare matching Gemini functions and provide each exact "
                "callable_name. After a match, call that declared function by its exact "
                "callable_name instead of searching for the same capability again."
            ).strip()
        row: dict[str, Any] = {
            "type": "function", "name": gemini_name, "parameters": parameters,
        }
        if explanation:
            row["description"] = explanation
        translated.append(row)
        bridge[gemini_name] = {"kind": kind, "name": name, "namespace": namespace}

    for index, tool in enumerate(tools):
        if not isinstance(tool, dict):
            raise AdapterError(f"tool declaration {index} must be an object")
        tool_type = tool.get("type")
        if tool_type in {"function", "custom"}:
            name = tool.get("name")
            if not isinstance(name, str) or name in names:
                raise AdapterError(
                    f"tool declaration {index} ({tool_type!r}) has a missing or duplicated name")
            names.add(name)
            add_client_tool(tool, kind=tool_type)
        elif tool_type == "namespace":
            namespace = tool.get("name")
            description = tool.get("description")
            children = tool.get("tools")
            if (not isinstance(namespace, str) or TOOL_RE.fullmatch(namespace) is None
                    or namespace in names or not isinstance(children, list) or not children):
                raise AdapterError(f"namespace tool declaration {index} is malformed")
            if description is not None and not isinstance(description, str):
                raise AdapterError("namespace description must be a string")
            names.add(namespace)
            if description:
                namespace_guidance.append(
                    f"Codex tool namespace {namespace!r} instructions (apply to every "
                    f"function from this namespace):\n{description}")
            child_names: set[str] = set()
            for child in children:
                if not isinstance(child, dict) or child.get("type") not in {"function", "custom"}:
                    raise AdapterError("namespace contains an unsupported tool declaration")
                child_name = child.get("name")
                if not isinstance(child_name, str) or child_name in child_names:
                    raise AdapterError("namespace contains a missing or duplicated tool name")
                child_names.add(child_name)
                add_client_tool(child, kind=child["type"], namespace=namespace)
        elif tool_type == "tool_search":
            synthetic = dict(tool)
            synthetic["name"] = "tool_search"
            add_client_tool(synthetic, kind="tool_search")
        elif tool_type == "web_search":
            if not allow_native_search:
                raise AdapterError(
                    "provider-native Google Search is disabled by the free-tier-model-only route; "
                    "use Sandcodex browser tooling")
            search_types = ["web_search"]
            content_types = tool.get("search_content_types")
            if isinstance(content_types, list) and "image" in content_types:
                search_types.append("image_search")
            translated.append({"type": "google_search", "search_types": search_types})
        else:
            raise AdapterError(f"unsupported Responses tool type: {tool_type!r}")
        if len(translated) > MAX_TOOLS:
            raise AdapterError("flattened tool declarations exceed the adapter limit")
    return translated, bridge, namespace_guidance


def translate_tool_choice(choice: object, bridge: dict[str, dict[str, Any]]) -> dict[str, Any] | None:
    if choice in (None, "auto"):
        return None
    if choice == "none":
        return {"allowed_tools": {"mode": "none", "tools": []}}
    if choice == "required":
        return {"allowed_tools": {"mode": "any", "tools": sorted(bridge)}}
    if isinstance(choice, dict):
        name = choice.get("name")
        namespace = choice.get("namespace")
        if choice.get("type") in {"function", "custom"} and isinstance(name, str):
            matches = [alias for alias, metadata in bridge.items()
                       if metadata["name"] == name and metadata["namespace"] == namespace]
            if len(matches) == 1:
                return {"allowed_tools": {"mode": "any", "tools": matches}}
    raise AdapterError("tool_choice is not supported by the Gemini adapter")


def reasoning_config(reasoning: object) -> dict[str, Any]:
    if reasoning in (None, {}):
        return {}
    if not isinstance(reasoning, dict):
        raise AdapterError("reasoning must be an object")
    effort = reasoning.get("effort")
    result: dict[str, Any] = {}
    if effort is not None:
        if effort not in {"none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"}:
            raise AdapterError("reasoning effort is unsupported")
        result["thinking_level"] = {
            # Gemini 3.8 Flash rejects `minimal`; low is the smallest level
            # shared by every model in the free auto route.
            "none": "low", "minimal": "low", "low": "low", "medium": "medium",
            "high": "high", "xhigh": "high", "max": "high", "ultra": "high",
        }[effort]
    summary = reasoning.get("summary")
    if summary not in (None, "none"):
        result["thinking_summaries"] = "auto"
    return result


def response_format(text: object) -> dict[str, Any] | None:
    if not isinstance(text, dict):
        return None
    fmt = text.get("format")
    if not isinstance(fmt, dict):
        return None
    fmt_type = fmt.get("type")
    if fmt_type in (None, "text"):
        return None
    if fmt_type in {"json_schema", "json_object"}:
        schema = fmt.get("schema")
        if fmt_type == "json_object" and schema is None:
            schema = {"type": "object"}
        if not isinstance(schema, dict):
            raise AdapterError("structured output schema is missing")
        return {"type": "text", "mime_type": "application/json",
                "schema": normalize_gemini_schema(schema)}
    raise AdapterError("text.format type is unsupported")


def gemini_tool_search_result(item: dict[str, Any],
                              bridge: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """Describe Codex discoveries using the exact names Gemini can invoke."""
    tools = item.get("tools")
    if not isinstance(tools, list):
        raise AdapterError("tool-search result is malformed")
    available: list[dict[str, str]] = []
    seen: set[str] = set()

    def append_tool(tool: dict[str, Any], namespace: str | None) -> None:
        kind, name = tool.get("type"), tool.get("name")
        if kind not in {"function", "custom"} or not isinstance(name, str):
            raise AdapterError("tool-search result contains an unsupported declaration")
        matches = [alias for alias, metadata in bridge.items()
                   if metadata == {"kind": kind, "name": name, "namespace": namespace}]
        if len(matches) != 1:
            raise AdapterError("discovered tool is missing from the Gemini declaration bridge",
                               status=500, code="adapter_internal")
        alias = matches[0]
        if alias in seen:
            return
        seen.add(alias)
        row = {"callable_name": alias, "codex_name": name, "kind": kind}
        if namespace is not None:
            row["codex_namespace"] = namespace
        available.append(row)

    for tool in tools:
        if not isinstance(tool, dict):
            raise AdapterError("tool-search result contains a malformed declaration")
        if tool.get("type") == "namespace":
            namespace, children = tool.get("name"), tool.get("tools")
            if not isinstance(namespace, str) or not isinstance(children, list):
                raise AdapterError("tool-search result contains a malformed namespace")
            for child in children:
                if not isinstance(child, dict):
                    raise AdapterError("tool-search namespace contains a malformed declaration")
                append_tool(child, namespace)
        else:
            append_tool(tool, None)
    return {
        "status": item.get("status"),
        "execution": item.get("execution"),
        "instruction": (
            "These matches are now declared as Gemini functions. Call the needed function "
            "using its exact callable_name. Do not call an original Codex name and do not "
            "repeat tool_search for a capability already listed here."
            if available else
            "No matching function was found. Refine tool_search only if the task still needs one."
        ),
        "available_functions": available,
    }


def translate_input(request: dict[str, Any], selected_model: str,
                    bridge: dict[str, dict[str, Any]]) -> tuple[list[dict[str, Any]], str, int]:
    value = request.get("input", [])
    if isinstance(value, str):
        value = [{"type": "message", "role": "user", "content": value}]
    if not isinstance(value, list):
        raise AdapterError("input must be a string or array")
    steps: list[dict[str, Any]] = []
    system: list[str] = []
    call_names: dict[str, str] = {}
    dropped_states = 0
    pending_exact: dict[str, Any] | None = None
    instructions = request.get("instructions")
    if instructions is not None:
        if not isinstance(instructions, str):
            raise AdapterError("instructions must be a string")
        system.append(instructions)
    # Interactions v1 explicitly supports switching models within a stateless
    # session when every previous model step (including opaque thought
    # signatures) is resent exactly.  Preserve the complete chronological
    # provider lineage across A -> B and A -> B -> A migrations.  The paired
    # Responses projection is validated below but suppressed from the upstream
    # history so it cannot duplicate the exact Gemini step.
    decoded_states: dict[int, tuple[str, dict[str, Any]]] = {}
    for index, item in enumerate(value):
        if isinstance(item, dict) and item.get("type") == "reasoning":
            state = decode_state(item.get("encrypted_content"))
            decoded_states[index] = state

    for index, item in enumerate(value):
        if not isinstance(item, dict):
            raise AdapterError("input item must be an object")
        item_type = item.get("type")
        if pending_exact is not None:
            expected = {
                "function_call": {"function_call", "custom_tool_call", "tool_search_call"},
                "model_output": {"message"},
                "google_search_call": {"web_search_call"},
            }[pending_exact["type"]]
            if item_type not in expected:
                raise AdapterError(
                    "conversation reordered a Gemini exact-state semantic pair",
                    status=409, code="provider_state_mismatch")
        if item_type == "message":
            role = item.get("role")
            if role in {"system", "developer"}:
                system.extend(part["text"] for part in message_parts(item.get("content"), output=True))
            elif role == "assistant":
                parts = message_parts(item.get("content"), output=True)
                if pending_exact is not None:
                    expected_text = model_output_content(pending_exact)["text"]
                    actual_text = "".join(part["text"] for part in parts)
                    if actual_text != expected_text:
                        raise AdapterError(
                            "conversation changed a Gemini model-output semantic pair",
                            status=409, code="provider_state_mismatch")
                    pending_exact = None
                else:
                    steps.append({"type": "model_output", "content": parts})
            elif role == "user":
                steps.append({"type": "user_input", "content": message_parts(item.get("content"))})
            else:
                raise AdapterError(f"unsupported message role: {role!r}")
        elif item_type == "reasoning":
            _state_model, step = decoded_states[index]
            steps.append(step)
            if step["type"] in PAIRED_SEMANTIC_STEPS:
                pending_exact = step
        elif item_type in {"function_call", "custom_tool_call"}:
            name = item.get("name")
            namespace = item.get("namespace")
            call_id = item.get("call_id") or item.get("id")
            if (not isinstance(name, str) or TOOL_RE.fullmatch(name) is None
                    or namespace is not None and not isinstance(namespace, str)
                    or not isinstance(call_id, str)):
                raise AdapterError("historical tool call is malformed")
            if item_type == "custom_tool_call":
                arguments: Any = {"input": content_text(item.get("input"))}
                kind = "custom"
            else:
                raw_arguments = item.get("arguments", "{}")
                if isinstance(raw_arguments, str):
                    try:
                        arguments = json.loads(raw_arguments)
                    except ValueError as exc:
                        raise AdapterError("historical function arguments are invalid JSON") from exc
                elif isinstance(raw_arguments, dict):
                    arguments = raw_arguments
                else:
                    raise AdapterError("historical function arguments are malformed")
                kind = "function"
            alias = gemini_tool_alias(kind, name, namespace)
            if call_id in call_names and call_names[call_id] != alias:
                raise AdapterError("historical tool call_id was reused with a different tool")
            call_names[call_id] = alias
            if pending_exact is not None:
                exact_id = pending_exact.get("id") or pending_exact.get("call_id")
                exact_arguments = pending_exact.get("arguments", pending_exact.get("args"))
                if (pending_exact.get("type") != "function_call"
                        or exact_id != call_id or pending_exact.get("name") != alias
                        or exact_arguments != arguments):
                    raise AdapterError(
                        "conversation changed a Gemini function-call semantic pair",
                        status=409, code="provider_state_mismatch")
                pending_exact = None
            else:
                steps.append({"type": "function_call", "id": call_id,
                              "name": alias,
                              "arguments": arguments})
        elif item_type in {"function_call_output", "custom_tool_call_output"}:
            call_id = item.get("call_id")
            name = item.get("name")
            namespace = item.get("namespace")
            if not isinstance(call_id, str):
                raise AdapterError("tool result has no call_id")
            row: dict[str, Any] = {"type": "function_result", "call_id": call_id,
                                   "result": tool_result_parts(item.get("output"))}
            if isinstance(name, str) and name:
                kind = "custom" if item_type == "custom_tool_call_output" else "function"
                alias = gemini_tool_alias(kind, name,
                                          namespace if isinstance(namespace, str) else None)
                if call_id in call_names and call_names[call_id] != alias:
                    raise AdapterError("tool result name does not match its historical call")
                row["name"] = alias
            elif call_id in call_names:
                row["name"] = call_names[call_id]
            else:
                raise AdapterError("tool result cannot be matched to a historical tool call")
            steps.append(row)
        elif item_type == "tool_search_call":
            call_id = item.get("call_id") or item.get("id")
            arguments = item.get("arguments")
            if not isinstance(call_id, str) or not isinstance(arguments, dict):
                raise AdapterError("historical tool-search call is malformed")
            alias = gemini_tool_alias("tool_search", "tool_search")
            if call_id in call_names and call_names[call_id] != alias:
                raise AdapterError("historical tool-search call_id was reused")
            call_names[call_id] = alias
            if pending_exact is not None:
                exact_id = pending_exact.get("id") or pending_exact.get("call_id")
                exact_arguments = pending_exact.get("arguments", pending_exact.get("args"))
                if (pending_exact.get("type") != "function_call"
                        or exact_id != call_id or pending_exact.get("name") != alias
                        or exact_arguments != arguments):
                    raise AdapterError(
                        "conversation changed a Gemini tool-search semantic pair",
                        status=409, code="provider_state_mismatch")
                pending_exact = None
            else:
                steps.append({"type": "function_call", "id": call_id, "name": alias,
                              "arguments": arguments})
        elif item_type == "tool_search_output":
            call_id = item.get("call_id")
            tools = item.get("tools")
            if not isinstance(call_id, str) or not isinstance(tools, list):
                raise AdapterError("tool-search result is malformed")
            alias = gemini_tool_alias("tool_search", "tool_search")
            if call_names.get(call_id) != alias:
                raise AdapterError("tool-search result cannot be matched to its historical call")
            steps.append({"type": "function_result", "call_id": call_id, "name": alias,
                          "result": [text_part(content_text(
                              gemini_tool_search_result(item, bridge)))]})
        elif item_type == "web_search_call":
            # Each Gemini search step is carried in a paired, signed Sandcodex
            # reasoning item.  The Responses item exists for Codex UI/history,
            # but replaying it as a second search step would duplicate context.
            if pending_exact is None or pending_exact.get("type") != "google_search_call":
                raise AdapterError(
                    "web-search history has no paired Gemini exact state",
                    status=409, code="provider_state_mismatch")
            pending_exact = None
        else:
            raise AdapterError(f"unsupported Responses input item: {item_type!r}")
    if pending_exact is not None:
        raise AdapterError("conversation ended inside a Gemini exact-state semantic pair",
                           status=409, code="provider_state_mismatch")
    if not steps:
        steps = [{"type": "user_input", "content": [text_part("")]}]
    return steps, "\n\n".join(part for part in system if part), dropped_states


def sc_effective_tool_choice(request):
    """Preserve the requested choice, except explicit compaction must use none.

    Codex rust-v0.154.0 serializes its core-owned turn payload as a JSON string
    in client_metadata['x-codex-turn-metadata']. A malformed present envelope is
    rejected rather than silently treated as an ordinary tool-enabled request.
    This adapter shim does not handle headers-only clients; capture a real
    pinned-client request before adopting it for any other version or transport.
    """
    import json

    if not isinstance(request, dict):
        raise ValueError("request must be an object")
    choice = request.get("tool_choice")
    metadata = request.get("client_metadata")
    if metadata is None:
        return choice
    if not isinstance(metadata, dict):
        raise ValueError("client_metadata must be an object")
    raw = metadata.get("x-codex-turn-metadata")
    if raw is None:
        return choice
    if not isinstance(raw, str) or len(raw.encode("utf-8")) > 1024 * 1024:
        raise ValueError("Codex turn metadata must be a bounded JSON string")

    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate key in Codex turn metadata")
            result[key] = value
        return result

    try:
        parsed = json.loads(raw, object_pairs_hook=unique_object)
    except (ValueError, RecursionError) as exc:
        raise ValueError("invalid Codex turn metadata JSON") from exc
    if not isinstance(parsed, dict):
        raise ValueError("Codex turn metadata must decode to an object")
    kind = parsed.get("request_kind")
    if kind is not None and not isinstance(kind, str):
        raise ValueError("Codex request_kind must be a string")
    if kind != "compaction":
        return choice
    if choice not in (None, "auto", "none"):
        raise ValueError("compaction conflicts with a required tool choice")
    return "none"


def build_interaction(request: dict[str, Any], selected_model: str, *,
                      allow_native_search: bool = False) -> tuple[dict[str, Any], dict[str, dict[str, Any]], int]:
    tools, bridge, namespace_guidance = translate_tools(
        request.get("tools"), allow_native_search=allow_native_search)
    discovered = deferred_tool_inventory(request)
    if discovered:
        extra_tools, extra_bridge, extra_guidance = translate_tools(
            discovered, allow_native_search=allow_native_search)
        collisions = set(bridge).intersection(extra_bridge)
        if collisions:
            raise AdapterError("discovered tools collide with an active Gemini declaration",
                               status=409, code="provider_state_mismatch")
        tools.extend(extra_tools)
        bridge.update(extra_bridge)
        namespace_guidance.extend(extra_guidance)
        if len(tools) > MAX_TOOLS:
            raise AdapterError("combined tool declarations exceed the adapter limit")
    steps, system, dropped = translate_input(request, selected_model, bridge)
    generation = reasoning_config(request.get("reasoning"))
    try:
        effective_choice = sc_effective_tool_choice(request)
    except ValueError as exc:
        raise AdapterError(str(exc), code="invalid_compaction_contract") from exc
    choice = translate_tool_choice(effective_choice, bridge)
    if choice is not None:
        generation["tool_choice"] = choice
    if isinstance(request.get("temperature"), (int, float)):
        generation["temperature"] = request["temperature"]
    if isinstance(request.get("max_output_tokens"), int):
        generation["max_output_tokens"] = request["max_output_tokens"]
    body: dict[str, Any] = {"model": selected_model, "input": steps, "store": False}
    complete_system = "\n\n".join(part for part in [system, *namespace_guidance] if part)
    if complete_system:
        body["system_instruction"] = complete_system
    if tools:
        body["tools"] = tools
    if generation:
        body["generation_config"] = generation
    fmt = response_format(request.get("text"))
    if fmt is not None:
        body["response_format"] = fmt
    return body, bridge, dropped


def continuation_model(request: dict[str, Any]) -> str | None:
    """Return the preferred origin model for a pending signed tool result.

    The exact call and thought signature must remain in the stateless history.
    Interactions v1 permits the next request to use another model and manages
    signature compatibility, so this identity determines first preference and
    migration telemetry rather than pinning the request to one cooling model.
    Older completed tool chains do not prefer a model because their newest
    exact provider step is a model_output.
    """
    value = request.get("input", [])
    if not isinstance(value, list):
        return None
    last: tuple[int, str, dict[str, Any]] | None = None
    for index, item in enumerate(value):
        if isinstance(item, dict) and item.get("type") == "reasoning":
            state_model, step = decode_state(item.get("encrypted_content"))
            last = (index, state_model, step)
    if last is None or last[2].get("type") != "function_call":
        return None
    call_id = last[2].get("id") or last[2].get("call_id")
    if not isinstance(call_id, str):
        raise AdapterError("Gemini continuation call identity is malformed",
                           status=409, code="provider_state_mismatch")
    for item in value[last[0] + 1:]:
        if (isinstance(item, dict)
                and item.get("type") in {"function_call_output", "custom_tool_call_output",
                                         "tool_search_output"}
                and item.get("call_id") == call_id):
            return last[1]
    return None


def upstream_category(status: int, payload: object) -> str:
    provider_status = ""
    provider_code = ""
    provider_message = ""
    if isinstance(payload, dict) and isinstance(payload.get("error"), dict):
        provider_status = str(payload["error"].get("status") or "").upper()
        provider_code = str(payload["error"].get("code") or "").lower()
        provider_message = str(payload["error"].get("message") or "").lower()
    if status in {401, 403} or provider_status in {"UNAUTHENTICATED", "PERMISSION_DENIED"} \
            or provider_code in {"unauthenticated", "permission_denied"}:
        return "auth"
    daily_markers = (
        "per day", "requests/day", "requests per day", "daily quota", "daily limit",
        "generate_requests_per_model_per_day", "per_day",
    )
    if (status == 429 or provider_status in {"RESOURCE_EXHAUSTED", "QUOTA_EXCEEDED"}
            or provider_code in {"rate_limit_exceeded", "quota_exceeded", "too_many_requests"}):
        structured_period = upstream_quota_period(payload)
        if structured_period is not None:
            return structured_period
        if provider_code == "quota_exceeded" or any(
                marker in provider_message for marker in daily_markers):
            return "daily-quota"
        if provider_code in {"rate_limit_exceeded", "too_many_requests"}:
            return "rate-limit"
        return "quota"
    if status == 404 or provider_status == "NOT_FOUND" or provider_code == "not_found":
        return "model-unavailable"
    if status in {408, 425, 500, 502, 503, 504} or provider_status in {
            "ABORTED", "DEADLINE_EXCEEDED", "INTERNAL", "UNAVAILABLE"}:
        return "transient"
    if status == 400:
        # Never reflect the provider's free-form body into Codex, the terminal,
        # or logs.  Narrow categories still make protocol failures actionable.
        if provider_code == "missing_thought_signature" \
                or "signature" in provider_message or "thought" in provider_message:
            return "request-state-signature"
        if provider_code in {
                "malformed_function_call", "malformed_tool_call",
                "unexpected_tool_call", "too_many_tool_calls"}:
            return "generation-" + provider_code.replace("_", "-")
        if ("function_result" in provider_message or "function result" in provider_message
                or "function call" in provider_message):
            return "request-function-history"
        if "tool" in provider_message or "schema" in provider_message:
            return "request-tool-schema"
        if "input" in provider_message or "history" in provider_message:
            return "request-input-history"
        return "request"
    if 400 <= status < 500:
        return "request"
    return "provider"


def upstream_quota_period(payload: object) -> str | None:
    """Classify a documented quota window from structured Google metadata."""
    error = payload.get("error") if isinstance(payload, dict) else None
    details = error.get("details") if isinstance(error, dict) else None
    if not isinstance(details, list):
        return None
    saw_rate = False
    for detail in details:
        if (not isinstance(detail, dict)
                or not str(detail.get("@type", "")).endswith("google.rpc.QuotaFailure")):
            continue
        violations = detail.get("violations")
        if not isinstance(violations, list):
            continue
        for violation in violations:
            if not isinstance(violation, dict):
                continue
            identity = " ".join(str(violation.get(field) or "").lower()
                                for field in ("quotaId", "quotaMetric", "quota_id", "quota_metric"))
            compact = re.sub(r"[^a-z0-9]", "", identity)
            if any(marker in compact for marker in ("perday", "daily", "requestsday")):
                return "daily-quota"
            if any(marker in compact for marker in (
                    "perminute", "persecond", "requestsminute", "requestssecond",
                    "tokensminute", "tokenssecond")):
                saw_rate = True
    return "rate-limit" if saw_rate else None


def upstream_quota_scope(payload: object) -> str | None:
    """Classify only structured Google quota metadata, never free-form text.

    Project-scoped failures cool the account key across the model ladder.
    Model-dimensional failures cool only that account/model pair.  Either
    classification leaves the remaining banked accounts eligible, which is
    what makes quota-driven account rotation possible without parsing provider
    prose.
    """
    error = payload.get("error") if isinstance(payload, dict) else None
    details = error.get("details") if isinstance(error, dict) else None
    if not isinstance(details, list):
        return None
    saw_quota_failure = False
    saw_model = False
    saw_project = False
    for detail in details:
        if (not isinstance(detail, dict)
                or not str(detail.get("@type", "")).endswith("google.rpc.QuotaFailure")):
            continue
        saw_quota_failure = True
        violations = detail.get("violations")
        if not isinstance(violations, list):
            continue
        for violation in violations:
            if not isinstance(violation, dict):
                continue
            dimensions = violation.get("quotaDimensions")
            if not isinstance(dimensions, dict):
                dimensions = violation.get("quota_dimensions")
            dimension_names = {
                str(name).lower() for name in dimensions
            } if isinstance(dimensions, dict) else set()
            identity = " ".join(str(violation.get(field) or "").lower()
                                for field in ("quotaId", "quotaMetric", "quota_id", "quota_metric"))
            if "model" in dimension_names or "permodel" in identity or "per_model" in identity:
                saw_model = True
            else:
                saw_project = True
    if saw_project:
        return "project"
    if saw_model:
        return "model"
    return "project" if saw_quota_failure else None


def bounded_retry_seconds(value: float | int | None) -> int | None:
    if value is None or not math.isfinite(float(value)) or float(value) < 0:
        return None
    return max(1, min(math.ceil(float(value)), 86_400))


def seconds_until_pacific_midnight() -> int:
    """Bound a daily free-tier cooldown to Google's documented reset."""
    try:
        pacific = ZoneInfo("America/Los_Angeles")
    except ZoneInfoNotFoundError:
        return 86_400
    now = dt.datetime.now(dt.timezone.utc).astimezone(pacific)
    tomorrow = now.date() + dt.timedelta(days=1)
    reset = dt.datetime.combine(tomorrow, dt.time.min, tzinfo=pacific)
    return bounded_retry_seconds((reset - now).total_seconds()) or 86_400


def retry_after(headers: dict[str, str], payload: object | None = None) -> int | None:
    value = headers.get("retry-after")
    if value:
        stripped = value.strip()
        try:
            numeric = float(stripped)
        except ValueError:
            try:
                parsed = email.utils.parsedate_to_datetime(stripped)
                if parsed.tzinfo is None:
                    parsed = parsed.replace(tzinfo=dt.timezone.utc)
                seconds = (parsed.astimezone(dt.timezone.utc) - dt.datetime.now(dt.timezone.utc)).total_seconds()
                bounded = bounded_retry_seconds(seconds)
                if bounded is not None:
                    return bounded
            except (TypeError, ValueError, OverflowError):
                pass
        else:
            bounded = bounded_retry_seconds(numeric)
            if bounded is not None:
                return bounded
    error = payload.get("error") if isinstance(payload, dict) else None
    details = error.get("details") if isinstance(error, dict) else None
    if isinstance(details, list):
        for detail in details:
            if not isinstance(detail, dict) or not str(detail.get("@type", "")).endswith("google.rpc.RetryInfo"):
                continue
            delay = detail.get("retryDelay")
            seconds: float | None = None
            if isinstance(delay, str):
                match = re.fullmatch(r"([0-9]+)(?:\.([0-9]{1,9}))?s", delay)
                if match:
                    seconds = float(match.group(1))
                    if match.group(2):
                        seconds += int(match.group(2)) / (10 ** len(match.group(2)))
            elif isinstance(delay, dict):
                whole, nanos = delay.get("seconds", 0), delay.get("nanos", 0)
                try:
                    seconds = float(whole) + float(nanos) / 1_000_000_000
                except (TypeError, ValueError, OverflowError):
                    seconds = None
            bounded = bounded_retry_seconds(seconds)
            if bounded is not None:
                return bounded
    return None


def google_request(api_base: str, key: str, body: dict[str, Any], timeout: float) -> dict[str, Any]:
    parsed = urlsplit(api_base)
    if parsed.scheme != "https" or parsed.hostname != "generativelanguage.googleapis.com" or parsed.path != "/v1":
        raise AdapterError("Gemini API base escaped the reviewed stable v1 endpoint", status=78,
                           code="unsafe_configuration")
    connection = http.client.HTTPSConnection(parsed.hostname, parsed.port or 443, timeout=timeout)
    try:
        connection.request("POST", parsed.path + "/interactions", body=canonical(body), headers={
            "content-type": "application/json",
            "accept": "application/json",
            "x-goog-api-key": key,
            "user-agent": "sandcodex-gemini-adapter/1",
        })
        response = connection.getresponse()
        raw = response.read(MAX_UPSTREAM_BYTES + 1)
        if len(raw) > MAX_UPSTREAM_BYTES:
            raise AdapterError("Gemini response exceeded the adapter limit", status=502,
                               code="upstream_protocol")
        headers = {name.lower(): value for name, value in response.getheaders()}
        try:
            payload = json.loads(raw) if raw else {}
        except (ValueError, UnicodeError) as exc:
            raise UpstreamError(response.status, "invalid-json", retry_after(headers)) from exc
        if response.status != 200:
            raise UpstreamError(response.status, upstream_category(response.status, payload),
                                retry_after(headers, payload), upstream_quota_scope(payload))
        if not isinstance(payload, dict):
            raise UpstreamError(502, "invalid-json")
        return payload
    except (TimeoutError, OSError, http.client.HTTPException) as exc:
        raise UpstreamError(503, "transport") from exc
    finally:
        connection.close()


def request_profile(request: dict[str, Any], body: dict[str, Any]) -> dict[str, Any]:
    """Return content-free request-shape evidence for operator diagnostics."""
    declared = request.get("tools")
    declared = declared if isinstance(declared, list) else []
    counts = {name: 0 for name in (
        "function", "custom", "namespace", "tool_search", "web_search", "other")}
    for tool in declared:
        tool_type = tool.get("type") if isinstance(tool, dict) else None
        counts[tool_type if tool_type in counts else "other"] += 1
    input_value = request.get("input")
    input_items = len(input_value) if isinstance(input_value, list) else (1 if input_value is not None else 0)
    translated = body.get("tools")
    translated_count = len(translated) if isinstance(translated, list) else 0
    discovered = deferred_tool_inventory(request)
    discovered_namespaces = sum(
        1 for tool in discovered if tool.get("type") == "namespace")
    discovered_tools = sum(
        len(tool.get("tools", [])) if tool.get("type") == "namespace" else 1
        for tool in discovered)
    tool_search_outputs = sum(
        1 for item in input_value
        if isinstance(input_value, list) and isinstance(item, dict)
        and item.get("type") == "tool_search_output") if isinstance(input_value, list) else 0
    return {
        "request_bytes": len(canonical(request)),
        "upstream_bytes": len(canonical(body)),
        "input_items": input_items,
        "declared_tools": len(declared),
        "declared_tool_types": counts,
        "translated_tools": translated_count,
        "deferred_mcp_discovery": counts["tool_search"] > 0,
        "tool_search_outputs": tool_search_outputs,
        "discovered_namespaces": discovered_namespaces,
        "discovered_tools_materialized": discovered_tools,
        "content_disclosed": False,
    }


class Cooldowns:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.lock_path = path.with_name(path.name + ".lock")
        self.legacy_model_quota_repairs = 0
        self.last_legacy_model_quota_repair: dict[str, str] | None = None

    @staticmethod
    def append_event(value: dict[str, Any], event: dict[str, str]) -> None:
        events = value.setdefault("route_events", [])
        if not isinstance(events, list):
            events = []
            value["route_events"] = events
        events.append(event)
        del events[:-ROUTE_EVENT_LIMIT]

    @contextlib.contextmanager
    def locked(self) -> Iterable[dict[str, Any]]:
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        parent_metadata = self.path.parent.lstat()
        if (not stat.S_ISDIR(parent_metadata.st_mode)
                or parent_metadata.st_uid != os.getuid()
                or stat.S_IMODE(parent_metadata.st_mode) & 0o077):
            raise AdapterError("Gemini cooldown directory is unsafe", status=78,
                               code="unsafe_state")
        lock_fd = os.open(self.lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            metadata = os.fstat(lock_fd)
            if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                    or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) & 0o077):
                raise AdapterError("Gemini cooldown lock is unsafe", status=78, code="unsafe_state")
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            value: dict[str, Any] = {
                "schema": COOLDOWN_SCHEMA, "keys": {}, "models": {}, "pairs": {},
                "schedulers": {},
            }
            if self.path.exists():
                loaded = private_json(self.path, "Gemini cooldown ledger")
                if loaded.get("schema") != COOLDOWN_SCHEMA:
                    raise AdapterError("Gemini cooldown ledger schema is invalid", status=78,
                                       code="unsafe_state")
                if any(not isinstance(loaded.get(field), dict)
                       for field in ("keys", "models", "pairs")):
                    raise AdapterError("Gemini cooldown ledger fields are invalid", status=78,
                                       code="unsafe_state")
                value = loaded
            baseline = canonical(value)
            now = dt.datetime.now(dt.timezone.utc)
            for field in ("keys", "models", "pairs"):
                rows = value.get(field)
                if not isinstance(rows, dict):
                    rows = {}
                value[field] = {
                    str(identity): row for identity, row in rows.items()
                    if isinstance(row, dict) and (until := parse_time(row.get("until"))) is not None and until > now
                }
            # Adapter revisions before account-key rotation stored quota and
            # rate failures under ``models``. Such rows suppress every account
            # for that model, but they contain no originating key from which a
            # safe pair cooldown could be reconstructed. Current revisions
            # never write those categories at model scope, so discard only
            # this finite legacy shape and leave real model-unavailable or
            # projection cooldowns intact.
            for model, row in list(value["models"].items()):
                reason = str(row.get("reason") or "")
                if reason not in LEGACY_MODEL_QUOTA_REASONS:
                    continue
                del value["models"][model]
                self.legacy_model_quota_repairs += 1
                self.last_legacy_model_quota_repair = {
                    "model": model, "reason": reason, "at": utc_now(),
                }
                self.append_event(value, {
                    "at": utc_now(), "event": "cooldown-repair", "model": model,
                    "category": reason, "scope": "legacy-global-model",
                })
            schedulers = value.get("schedulers")
            if not isinstance(schedulers, dict):
                schedulers = {}
            normalized_schedulers: list[tuple[dt.datetime, str, dict[str, Any]]] = []
            for identity, row in schedulers.items():
                if (not isinstance(identity, str)
                        or re.fullmatch(r"[0-9a-f]{16}", identity) is None
                        or not isinstance(row, dict)):
                    continue
                key_ids = row.get("key_ids")
                counts = row.get("assignments_by_key")
                updated = parse_time(row.get("updated_at"))
                total = row.get("assignments")
                if (not isinstance(key_ids, list) or not key_ids or len(key_ids) > 64
                        or len(set(key_ids)) != len(key_ids)
                        or any(not isinstance(key_id, str)
                               or re.fullmatch(r"[0-9a-f]{12}", key_id) is None
                               for key_id in key_ids)
                        or not isinstance(counts, dict) or updated is None
                        or type(total) is not int or not 0 <= total <= 2**63 - 1):
                    continue
                clean_counts: dict[str, int] = {}
                valid = True
                for key_id in key_ids:
                    count = counts.get(key_id, 0)
                    if type(count) is not int or not 0 <= count <= 2**63 - 1:
                        valid = False
                        break
                    clean_counts[key_id] = count
                if not valid:
                    continue
                normalized_schedulers.append((updated, identity, {
                    "key_ids": key_ids,
                    "assignments_by_key": clean_counts,
                    "assignments": total,
                    "updated_at": updated.strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "policy": "least-scheduled-healthy-account-v1",
                }))
            normalized_schedulers.sort(key=lambda item: item[0])
            value["schedulers"] = {
                identity: row
                for _updated, identity, row in normalized_schedulers[-SCHEDULER_LIMIT:]
            }
            retained_events: list[dict[str, str]] = []
            oldest = now - dt.timedelta(days=ROUTE_EVENT_RETENTION_DAYS)
            for event in value.get("route_events", []):
                if not isinstance(event, dict):
                    continue
                at = parse_time(event.get("at"))
                kind = event.get("event")
                model = event.get("model")
                key_id = event.get("key_id")
                if (at is None or not oldest <= at <= now + dt.timedelta(minutes=5)
                        or kind not in {"route-success", "route-failure", "cooldown-repair"}
                        or model is not None and (
                            not isinstance(model, str) or MODEL_RE.fullmatch(model) is None)
                        or key_id is not None and (
                            not isinstance(key_id, str)
                            or re.fullmatch(r"[0-9a-f]{12}", key_id) is None)):
                    continue
                clean = {"at": at.strftime("%Y-%m-%dT%H:%M:%SZ"), "event": str(kind)}
                for field in ("model", "key_id", "category", "scope"):
                    item = event.get(field)
                    if isinstance(item, str) and item:
                        clean[field] = item[:192]
                retained_events.append(clean)
            value["route_events"] = retained_events[-ROUTE_EVENT_LIMIT:]
            normalized = canonical(value)
            yield value
            # Availability checks are read-mostly and used once per candidate
            # route. Avoid rewriting and fsyncing trusted state unless pruning,
            # legacy repair, or an explicit record operation changed it.
            if normalized != baseline or canonical(value) != normalized:
                value["schema"] = COOLDOWN_SCHEMA
                value["updated_at"] = utc_now()
                value["credential_values_disclosed"] = False
                value["raw_provider_content_disclosed"] = False
                atomic_private_json(self.path, value)
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)

    def available(self, key_id: str, model: str, *, ignore: bool) -> bool:
        if ignore:
            return True
        with self.locked() as value:
            return (key_id not in value["keys"] and model not in value["models"]
                    and f"{key_id}:{model}" not in value["pairs"])

    def available_routes(self, key_ids: Sequence[str], models: Sequence[str], *,
                         ignore: bool) -> set[tuple[str, str]]:
        if ignore:
            return {(key_id, model) for model in models for key_id in key_ids}
        with self.locked() as value:
            return {
                (key_id, model) for model in models for key_id in key_ids
                if key_id not in value["keys"] and model not in value["models"]
                and f"{key_id}:{model}" not in value["pairs"]
            }

    def next_delay(self, key_ids: Sequence[str], models: Sequence[str], *, ignore: bool) -> int | None:
        """Return the earliest whole-second delay until any requested route is usable."""
        if ignore:
            return 0
        with self.locked() as value:
            now = dt.datetime.now(dt.timezone.utc)
            earliest: float | None = None
            for model in models:
                for key_id in key_ids:
                    blocked_until: list[dt.datetime] = []
                    for field, identity in (
                            ("keys", key_id), ("models", model),
                            ("pairs", f"{key_id}:{model}")):
                        row = value[field].get(identity)
                        until = parse_time(row.get("until")) if isinstance(row, dict) else None
                        if until is not None:
                            blocked_until.append(until)
                    if not blocked_until:
                        return 0
                    delay = max(0.0, (max(blocked_until) - now).total_seconds())
                    earliest = delay if earliest is None else min(earliest, delay)
            return bounded_retry_seconds(earliest)

    def record(self, field: str, identity: str, seconds: int, reason: str) -> None:
        seconds = max(1, min(seconds, 86_400 * 30))
        with self.locked() as value:
            now = dt.datetime.now(dt.timezone.utc)
            value[field][identity] = {
                "until": (now + dt.timedelta(seconds=seconds)).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "reason": reason[:120],
                # Preserve subsecond ordering so a concurrent failure that is
                # recorded after an attempt begins cannot look older merely
                # because both events happened in the same wall-clock second.
                "recorded_at": dt.datetime.now(dt.timezone.utc).isoformat(
                    timespec="microseconds").replace("+00:00", "Z"),
            }

    @staticmethod
    def scheduler_identity(key_ids: Sequence[str]) -> str:
        return hashlib.sha256("\0".join(sorted(key_ids)).encode()).hexdigest()[:16]

    @staticmethod
    def healthy_scheduler_keys(value: dict[str, Any], key_ids: Sequence[str],
                               models: Sequence[str], *, ignore: bool) -> list[str]:
        if ignore or not models:
            return list(key_ids)
        healthy = [
            key_id for key_id in key_ids
            if key_id not in value["keys"] and any(
                model not in value["models"]
                and f"{key_id}:{model}" not in value["pairs"]
                for model in models)
        ]
        return healthy or list(key_ids)

    def assign_start_key(self, key_ids: Sequence[str], models: Sequence[str] = (), *,
                         ignore: bool = False) -> str:
        ordered = list(key_ids)
        if (not ordered or len(ordered) > 64 or len(set(ordered)) != len(ordered)
                or any(re.fullmatch(r"[0-9a-f]{12}", key_id) is None
                       for key_id in ordered)):
            raise AdapterError("Gemini scheduler key identities are invalid", status=78,
                               code="unsafe_state")
        identity = self.scheduler_identity(ordered)
        with self.locked() as value:
            eligible = self.healthy_scheduler_keys(
                value, ordered, models, ignore=ignore)
            scheduler = value["schedulers"].get(identity, {})
            counts = scheduler.get("assignments_by_key", {})
            counts = {
                key_id: int(counts.get(key_id, 0))
                if type(counts.get(key_id, 0)) is int and counts.get(key_id, 0) >= 0 else 0
                for key_id in ordered
            }
            selected = min(
                ((ordered.index(key_id), key_id) for key_id in eligible),
                key=lambda item: (counts[item[1]], item[0]))[1]
            counts[selected] += 1
            assignments = scheduler.get("assignments", 0)
            assignments = assignments if type(assignments) is int and assignments >= 0 else 0
            value["schedulers"][identity] = {
                "key_ids": ordered,
                "assignments_by_key": counts,
                "assignments": assignments + 1,
                "updated_at": utc_now(),
                "policy": "least-scheduled-healthy-account-v1",
            }
            return selected

    def scheduler_status(self, key_ids: Sequence[str], models: Sequence[str] = (), *,
                         ignore: bool = False) -> dict[str, Any]:
        ordered = list(key_ids)
        identity = self.scheduler_identity(ordered)
        with self.locked() as value:
            eligible = self.healthy_scheduler_keys(
                value, ordered, models, ignore=ignore)
            scheduler = value["schedulers"].get(identity)
            if not isinstance(scheduler, dict):
                counts = {key_id: 0 for key_id in ordered}
                assignments = 0
            else:
                stored = scheduler.get("assignments_by_key", {})
                counts = {key_id: int(stored.get(key_id, 0)) for key_id in ordered}
                assignments = int(scheduler.get("assignments", 0))
            next_key = min(
                ((ordered.index(key_id), key_id) for key_id in eligible),
                key=lambda item: (counts[item[1]], item[0]))[1]
            return {
                "ledger_id": identity,
                "policy": "least-scheduled-healthy-account-v1",
                "assignments": assignments,
                "assignments_by_key": counts,
                "next_key_id": next_key,
                "eligible_key_ids": eligible,
            }

    def record_success(self, model: str, key_id: str,
                       successful_attempt_started_at: dt.datetime | None = None) -> int:
        cutoff = successful_attempt_started_at or dt.datetime.now(dt.timezone.utc)
        if cutoff.tzinfo is None:
            raise AdapterError("Gemini success cutoff is invalid", status=500,
                               code="adapter_internal")
        cutoff = cutoff.astimezone(dt.timezone.utc)
        with self.locked() as value:
            healed = 0
            retained = 0
            for field, identity in (
                    ("keys", key_id), ("models", model),
                    ("pairs", f"{key_id}:{model}")):
                row = value[field].get(identity)
                if row is None:
                    continue
                recorded_at = parse_time(row.get("recorded_at"))
                # The request proves only that the route worked after its own
                # start. Preserve ambiguous, equal, or newer evidence written
                # by another concurrent request or adapter process.
                if recorded_at is None or recorded_at >= cutoff:
                    retained += 1
                    continue
                if value[field].pop(identity, None) is not None:
                    healed += 1
            self.append_event(value, {
                "at": utc_now(), "event": "route-success", "model": model,
                "key_id": key_id, "category": "healthy",
                "scope": f"cleared-{healed}-retained-{retained}-cooldowns",
            })
            return healed

    def record_route_event(self, event: str, model: str, key_id: str, *,
                           category: str | None = None,
                           scope: str | None = None) -> None:
        if event not in {"route-success", "route-failure"}:
            raise AdapterError("Gemini route event is invalid", status=500,
                               code="adapter_internal")
        with self.locked() as value:
            row = {"at": utc_now(), "event": event, "model": model, "key_id": key_id}
            if category:
                row["category"] = category[:192]
            if scope:
                row["scope"] = scope[:192]
            self.append_event(value, row)


REQUEST_SCOPE_HEADER = "X-Sandcodex-Request-Scope"

REQUEST_SCOPE_PATTERN = re.compile(r"[0-9a-f]{32}")

REQUEST_EVIDENCE_SCHEMA = "sandcodex.gemini-request-boundary-event.v2"

REQUEST_EVIDENCE_LIMIT = 4 * 1024 * 1024

REQUEST_EVIDENCE_OUTCOMES = frozenset({
    "completed",
    "adapter-busy",
    "adapter-rejected",
    "client-disconnected",
    "downstream-disconnected",
    "adapter-internal",
    "upstream-request-rejected",
    "upstream-retryable",
    "upstream-unavailable",
    "projection-rejected",
})

def sc_request_scope(values: object) -> str | None:
    """Validate zero or one content-free launch-scope HTTP header value."""
    if values is None:
        return None
    if isinstance(values, str):
        candidates = [values]
    elif isinstance(values, (list, tuple)):
        candidates = list(values)
    else:
        raise AdapterError(
            "Gemini request scope header is invalid",
            status=400,
            code="invalid_request_scope",
        )
    if not candidates:
        return None
    if (
        len(candidates) != 1
        or not isinstance(candidates[0], str)
        or REQUEST_SCOPE_PATTERN.fullmatch(candidates[0]) is None
    ):
        raise AdapterError(
            "Gemini request scope header is invalid",
            status=400,
            code="invalid_request_scope",
        )
    return candidates[0]

class GeminiRequestEvidence:
    """Append bounded lifecycle evidence with an optional opaque launch scope.

    The sink catches ordinary diagnostic I/O/validation failures and exposes
    counters through health.  Cancellation and process-exit signals still
    propagate because BaseException is deliberately not caught.
    """

    def __init__(self, raw_path: object, *, maximum_bytes: int = REQUEST_EVIDENCE_LIMIT) -> None:
        self._lock = threading.Lock()
        self._path: Path | None = None
        self._maximum_bytes = maximum_bytes
        self._instance_ref = uuid.uuid4().hex[:16]
        self._request_sequence = 0
        self._attempt_sequence = 0
        self._request_scopes: dict[str, str | None] = {}
        self._events_written = 0
        self._events_dropped = 0
        self._write_failures = 0
        self._current_bytes = 0
        if raw_path in (None, ""):
            return
        if not isinstance(raw_path, str) or "\x00" in raw_path:
            raise AdapterError(
                "Gemini request-evidence path is invalid",
                status=78,
                code="unsafe_configuration",
            )
        path = Path(raw_path)
        if not path.is_absolute() or path.parent.resolve() != path.parent:
            raise AdapterError(
                "Gemini request-evidence path is not below a canonical absolute parent",
                status=78,
                code="unsafe_configuration",
            )
        try:
            parent = path.parent.lstat()
        except OSError as exc:
            raise AdapterError(
                "Gemini request-evidence parent is unavailable",
                status=78,
                code="unsafe_configuration",
            ) from exc
        if (
            not stat.S_ISDIR(parent.st_mode)
            or stat.S_ISLNK(parent.st_mode)
            or parent.st_uid != os.geteuid()
            or stat.S_IMODE(parent.st_mode) != 0o700
        ):
            raise AdapterError(
                "Gemini request-evidence parent is not one owned mode-0700 directory",
                status=78,
                code="unsafe_configuration",
            )
        try:
            existing = path.lstat()
        except FileNotFoundError:
            existing = None
        except OSError as exc:
            raise AdapterError(
                "Gemini request-evidence file cannot be inspected",
                status=78,
                code="unsafe_configuration",
            ) from exc
        if existing is not None:
            if (
                not stat.S_ISREG(existing.st_mode)
                or stat.S_ISLNK(existing.st_mode)
                or existing.st_uid != os.geteuid()
                or stat.S_IMODE(existing.st_mode) != 0o600
                or existing.st_nlink != 1
                or existing.st_size > maximum_bytes
            ):
                raise AdapterError(
                    "Gemini request-evidence file is unsafe or already over its bound",
                    status=78,
                    code="unsafe_configuration",
                )
            self._current_bytes = existing.st_size
        self._path = path

    @staticmethod
    def upstream_outcome(category: object) -> str:
        if not isinstance(category, str):
            return "upstream-unavailable"
        if category.startswith("request"):
            return "upstream-request-rejected"
        if category in {"quota", "rate-limit", "auth", "transient", "timeout"}:
            return "upstream-retryable"
        return "upstream-unavailable"

    def begin_request(self, scope_ref: str | None = None) -> str | None:
        if scope_ref is not None and REQUEST_SCOPE_PATTERN.fullmatch(scope_ref) is None:
            raise ValueError("invalid Gemini request-evidence scope")
        with self._lock:
            self._request_sequence += 1
            request_ref = f"r{self._request_sequence}"
            self._request_scopes[request_ref] = scope_ref
        self._emit("logical-request-start", request_ref=request_ref, scope_ref=scope_ref)
        return request_ref

    def _scope_for(self, request_ref: str) -> str | None:
        with self._lock:
            return self._request_scopes.get(request_ref)

    def begin_attempt(self, request_ref: str | None) -> str | None:
        if request_ref is None:
            return None
        with self._lock:
            self._attempt_sequence += 1
            attempt_ref = f"a{self._attempt_sequence}"
            scope_ref = self._request_scopes.get(request_ref)
        self._emit(
            "upstream-attempt-start",
            request_ref=request_ref,
            attempt_ref=attempt_ref,
            scope_ref=scope_ref,
        )
        return attempt_ref

    def finish_attempt(
        self, request_ref: str | None, attempt_ref: str | None, outcome: str
    ) -> None:
        if request_ref is None or attempt_ref is None:
            return
        self._emit(
            "upstream-attempt-end",
            request_ref=request_ref,
            attempt_ref=attempt_ref,
            outcome=outcome,
            scope_ref=self._scope_for(request_ref),
        )

    def finish_request(self, request_ref: str | None, outcome: str) -> None:
        if request_ref is None:
            return
        scope_ref = self._scope_for(request_ref)
        try:
            self._emit(
                "logical-request-end",
                request_ref=request_ref,
                outcome=outcome,
                scope_ref=scope_ref,
            )
        finally:
            with self._lock:
                self._request_scopes.pop(request_ref, None)

    def health(self) -> dict[str, object]:
        with self._lock:
            return {
                "enabled": self._path is not None,
                "schema": REQUEST_EVIDENCE_SCHEMA,
                "events_written": self._events_written,
                "events_dropped": self._events_dropped,
                "write_failures": self._write_failures,
                "current_bytes": self._current_bytes,
                "maximum_bytes": self._maximum_bytes,
                "active_request_scopes": len(self._request_scopes),
                "content_retained": False,
                "model_identity_retained": False,
                "credential_identity_retained": False,
                "opaque_launch_scope_retained": True,
            }

    def _emit(
        self,
        event: str,
        *,
        request_ref: str,
        attempt_ref: str | None = None,
        outcome: str | None = None,
        scope_ref: str | None = None,
    ) -> None:
        if event not in {
            "logical-request-start",
            "logical-request-end",
            "upstream-attempt-start",
            "upstream-attempt-end",
        }:
            raise ValueError("unknown Gemini request-evidence event")
        if outcome is not None and outcome not in REQUEST_EVIDENCE_OUTCOMES:
            raise ValueError("unknown Gemini request-evidence outcome")
        if scope_ref is not None and REQUEST_SCOPE_PATTERN.fullmatch(scope_ref) is None:
            raise ValueError("invalid Gemini request-evidence scope")
        row: dict[str, object] = {
            "schema": REQUEST_EVIDENCE_SCHEMA,
            "instance_ref": self._instance_ref,
            "event": event,
            "request_ref": request_ref,
        }
        if scope_ref is not None:
            row["scope_ref"] = scope_ref
        if attempt_ref is not None:
            row["attempt_ref"] = attempt_ref
        if outcome is not None:
            row["outcome"] = outcome
        payload = (json.dumps(
            row,
            ensure_ascii=True,
            allow_nan=False,
            separators=(",", ":"),
            sort_keys=True,
        ) + "\n").encode("ascii")
        path = self._path
        if path is None:
            return
        try:
            with self._lock:
                if self._current_bytes + len(payload) > self._maximum_bytes:
                    self._events_dropped += 1
                    return
                flags = os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC
                flags |= getattr(os, "O_NOFOLLOW", 0)
                descriptor = os.open(path, flags, 0o600)
                try:
                    metadata = os.fstat(descriptor)
                    if (
                        not stat.S_ISREG(metadata.st_mode)
                        or metadata.st_uid != os.geteuid()
                        or stat.S_IMODE(metadata.st_mode) != 0o600
                        or metadata.st_nlink != 1
                        or metadata.st_size != self._current_bytes
                    ):
                        raise OSError("request-evidence identity or size changed")
                    written = os.write(descriptor, payload)
                    if written != len(payload):
                        raise OSError("short request-evidence write")
                    self._current_bytes += written
                    self._events_written += 1
                finally:
                    os.close(descriptor)
        except Exception:
            with self._lock:
                self._write_failures += 1


class Runtime:
    def __init__(self, config_path: Path, token_path: Path) -> None:
        config = private_json(config_path, "Gemini adapter configuration")
        if config.get("schema") != CONFIG_SCHEMA:
            raise AdapterError("Gemini adapter configuration schema is invalid", status=78,
                               code="unsafe_configuration")
        self.config = config
        self.api_base = config.get("api_base")
        if self.api_base != "https://generativelanguage.googleapis.com/v1":
            raise AdapterError("Gemini adapter API base is not stable v1", status=78,
                               code="unsafe_configuration")
        self.routing_model = config.get("routing_model")
        candidates = config.get("candidate_models")
        if (not isinstance(self.routing_model, str) or MODEL_RE.fullmatch(self.routing_model) is None
                or not isinstance(candidates, list) or not candidates or len(candidates) > 16
                or any(not isinstance(model, str) or MODEL_RE.fullmatch(model) is None for model in candidates)
                or len(set(candidates)) != len(candidates)):
            raise AdapterError("Gemini routing model configuration is invalid", status=78,
                               code="unsafe_configuration")
        self.candidates: list[str] = candidates
        self.auto = bool(config.get("auto"))
        if not self.auto and len(self.candidates) != 1:
            raise AdapterError("explicit Gemini route has multiple models", status=78,
                               code="unsafe_configuration")
        if config.get("free_only") is not True:
            raise AdapterError("Gemini adapter configuration is not free-tier-model-only", status=78,
                               code="unsafe_configuration")
        # Search grounding is currently unavailable on the Developer API free
        # tier.  The reviewed route deliberately uses Sandcodex browser/MCP
        # tools for web access instead of a provider-native billable tool.
        self.allow_native_search = False
        self.ignore_cooldowns = bool(config.get("ignore_cooldowns"))
        self.timeout = float(config.get("upstream_timeout_seconds", 120))
        if not 1 <= self.timeout <= 600:
            raise AdapterError("Gemini timeout is invalid", status=78, code="unsafe_configuration")
        route_wait = config.get("route_wait_seconds", 240)
        if type(route_wait) is not int or not 0 <= route_wait <= 3600:
            raise AdapterError("Gemini route-wait ceiling is invalid", status=78,
                               code="unsafe_configuration")
        self.route_wait_seconds = route_wait
        self.token = private_regular(token_path, "Gemini adapter bearer token", max_bytes=4096).decode().strip()
        if len(self.token) < 32 or "\n" in self.token or "\r" in self.token:
            raise AdapterError("Gemini adapter bearer token is malformed", status=78,
                               code="unsafe_configuration")
        bank = config.get("key_bank")
        rows = bank.get("keys") if isinstance(bank, dict) else None
        if not isinstance(rows, list) or not rows or len(rows) > 64:
            raise AdapterError("Gemini key bank metadata is invalid", status=78,
                               code="unsafe_configuration")
        self.keys: list[tuple[str, str, str]] = []
        for row in rows:
            if not isinstance(row, dict):
                raise AdapterError("Gemini key metadata row is invalid", status=78,
                                   code="unsafe_configuration")
            key_id, label, raw_path = row.get("key_id"), row.get("label"), row.get("credential_file")
            if (not isinstance(key_id, str) or re.fullmatch(r"[0-9a-f]{12}", key_id) is None
                    or not isinstance(label, str) or not isinstance(raw_path, str)):
                raise AdapterError("Gemini key metadata identity is invalid", status=78,
                                   code="unsafe_configuration")
            key = private_regular(Path(raw_path), "Gemini credential", max_bytes=4096).decode().strip()
            if KEY_RE.fullmatch(key) is None or hashlib.sha256(key.encode()).hexdigest()[:12] != key_id:
                raise AdapterError("Gemini credential identity is invalid", status=78,
                                   code="unsafe_configuration")
            self.keys.append((key_id, label, key))
        rotation_target = config.get("rotation_target_accounts", 5)
        if type(rotation_target) is not int or not 1 <= rotation_target <= 64:
            raise AdapterError("Gemini account-rotation target is invalid", status=78,
                               code="unsafe_configuration")
        self.rotation_target_accounts = rotation_target
        cooldown_path = config.get("cooldown_path")
        if not isinstance(cooldown_path, str) or not Path(cooldown_path).is_absolute():
            raise AdapterError("Gemini cooldown path is invalid", status=78, code="unsafe_configuration")
        self.cooldowns = Cooldowns(Path(cooldown_path))
        # This bounded sink records lifecycle shape only; it has no API
        # for prompts, outputs, tool data, credentials, or model names.
        self.request_evidence = GeminiRequestEvidence(
            config.get("request_evidence_path")
        )
        self.started_at = utc_now()
        self.lock = threading.Lock()
        self.request_count = 0
        self.success_count = 0
        self.failover_count = 0
        self.wait_count = 0
        self.waiting_requests = 0
        self.waited_seconds = 0.0
        # Codex may retry the same buffered Responses request after a 429.  A
        # fresh route-wait allowance for every transport retry would multiply
        # the advertised wait ceiling and make a free-tier turn appear hung.
        # Keep only an opaque request digest and monotonic deadlines: provider
        # content is never retained, while automatic retries share one bounded
        # request window.  A later human retry receives a fresh window after a
        # short suppression interval.
        self.request_windows: dict[str, dict[str, Any]] = {}
        self.request_window_reuses = 0
        self.retry_budget_exhaustions = 0
        self.project_scope_cooldowns = 0
        self.model_scope_cooldowns = 0
        self.key_rotation_count = 0
        self.quota_key_rotation_count = 0
        self.last_key_rotation: dict[str, str] | None = None
        self.cross_model_continuations = 0
        self.last_continuation_migration: dict[str, str] | None = None
        self.last_model: str | None = None
        self.last_key_id: str | None = None
        self.last_error_class: str | None = None
        self.last_error_scope: str | None = None
        self.last_error_code: str | None = None
        self.projection_failures = 0
        self.last_request_profile: dict[str, Any] | None = None
        self.route_event_write_failures = 0
        self.cooldown_heals = 0
        self.account_cursor = 0
        self.account_cursor_assignments = 0
        self.window_creation_lock = threading.Lock()
        self.key_schedule_starts = {key_id: 0 for key_id, _label, _key in self.keys}
        self.key_attempts = {key_id: 0 for key_id, _label, _key in self.keys}
        self.key_successes = {key_id: 0 for key_id, _label, _key in self.keys}
        self.key_failures = {key_id: 0 for key_id, _label, _key in self.keys}
        self.model_attempts = {model: 0 for model in self.candidates}
        self.model_successes = {model: 0 for model in self.candidates}
        self.model_failures = {model: 0 for model in self.candidates}
        maximum = config.get("max_concurrency", 8)
        if type(maximum) is not int or not 1 <= maximum <= 64:
            raise AdapterError("Gemini concurrency limit is invalid", status=78,
                               code="unsafe_configuration")
        self.semaphore = threading.BoundedSemaphore(maximum)

    def authorized(self, authorization: str | None) -> bool:
        prefix = "Bearer "
        return bool(authorization and authorization.startswith(prefix)
                    and hmac.compare_digest(authorization[len(prefix):], self.token))

    def record_route_event(self, event: str, model: str, key_id: str, *,
                           category: str | None = None,
                           scope: str | None = None,
                           successful_attempt_started_at: dt.datetime | None = None) -> None:
        healer = getattr(self.cooldowns, "record_success", None)
        recorder = getattr(self.cooldowns, "record_route_event", None)
        if event == "route-success" and callable(healer):
            try:
                healed = healer(model, key_id, successful_attempt_started_at)
                with self.lock:
                    self.cooldown_heals += healed
                return
            except (AdapterError, OSError):
                with self.lock:
                    self.route_event_write_failures += 1
                return
        if callable(recorder):
            try:
                recorder(event, model, key_id, category=category, scope=scope)
            except (AdapterError, OSError):
                # Route history is diagnostic evidence, not part of the
                # provider response transaction. Never turn an already
                # completed buffered generation into a replay merely because
                # this optional content-free receipt could not be persisted.
                with self.lock:
                    self.route_event_write_failures += 1

    def health(self) -> dict[str, Any]:
        key_ids = [key_id for key_id, _label, _key in self.keys]
        scheduler_reader = getattr(self.cooldowns, "scheduler_status", None)
        shared_scheduler = scheduler_reader(
            key_ids, self.candidates, ignore=self.ignore_cooldowns,
        ) if callable(scheduler_reader) else None
        with self.lock:
            primary_key = self.keys[0][0]
            return {
                "schema": ADAPTER_SCHEMA,
                "status": "ready",
                "started_at": self.started_at,
                "routing_model": self.routing_model,
                "auto": self.auto,
                "candidate_models": list(self.candidates),
                "key_count": len(self.keys),
                "requests": self.request_count,
                "successes": self.success_count,
                "failovers": self.failover_count,
                "route_wait_seconds": self.route_wait_seconds,
                "waits": self.wait_count,
                "waiting_requests": self.waiting_requests,
                "waited_seconds": round(self.waited_seconds, 3),
                "request_ceiling_seconds": max(self.timeout, self.route_wait_seconds),
                "request_window_reuses": self.request_window_reuses,
                "request_windows": len(self.request_windows),
                "retry_budget_exhaustions": self.retry_budget_exhaustions,
                "project_scope_cooldowns": self.project_scope_cooldowns,
                "model_scope_cooldowns": self.model_scope_cooldowns,
                "key_rotations": self.key_rotation_count,
                "quota_key_rotations": self.quota_key_rotation_count,
                "last_key_rotation": self.last_key_rotation,
                "cross_model_continuations": self.cross_model_continuations,
                "last_continuation_migration": self.last_continuation_migration,
                "last_model": self.last_model,
                "last_key_id": self.last_key_id,
                "last_error_class": self.last_error_class,
                "last_error_scope": self.last_error_scope,
                "last_error_code": self.last_error_code,
                "projection_failures": self.projection_failures,
                "route_event_write_failures": self.route_event_write_failures,
                "request_evidence": self.request_evidence.health(),
                "cooldown_heals": self.cooldown_heals,
                "cooldown_repairs": {
                    "legacy_global_model_quota": getattr(
                        self.cooldowns, "legacy_model_quota_repairs", 0),
                    "last": getattr(
                        self.cooldowns, "last_legacy_model_quota_repair", None),
                },
                "last_request_profile": self.last_request_profile,
                "scheduler": {
                    "policy": "strongest-model-first-account-key-rotation",
                    "continuation_policy": "origin-first-then-ranked-model-failover",
                    "quota_scope": "account-key-or-account-model-route",
                    "quota_key_rotation": True,
                    "account_start_policy": "per-logical-request-round-robin",
                    "coordination_scope": (
                        "cross-process-shared-ledger" if shared_scheduler is not None
                        else "adapter-process-local"),
                    "balancing_policy": (
                        shared_scheduler["policy"] if shared_scheduler is not None
                        else "round-robin-v1"),
                    "account_cursor_assignments": self.account_cursor_assignments,
                    "shared_account_assignments": (
                        shared_scheduler["assignments"] if shared_scheduler is not None else None),
                    "shared_assignments_by_key": (
                        shared_scheduler["assignments_by_key"]
                        if shared_scheduler is not None else None),
                    "eligible_account_key_ids": (
                        shared_scheduler["eligible_key_ids"]
                        if shared_scheduler is not None else None),
                    "next_account_key_id": (
                        shared_scheduler["next_key_id"] if shared_scheduler is not None
                        else self.keys[self.account_cursor % len(self.keys)][0]),
                    "rotation_target_accounts": self.rotation_target_accounts,
                    "configured_accounts": len(self.keys),
                    "max_model_failures_per_request": MAX_MODEL_FAILURES_PER_REQUEST,
                    "max_route_failures_per_request": MAX_ROUTE_FAILURES_PER_REQUEST,
                    "max_upstream_attempts_per_request": MAX_ATTEMPTS,
                    "primary_key_id": primary_key,
                    "keys": [{
                        "key_id": key_id,
                        "label": label,
                        "schedule_starts": self.key_schedule_starts[key_id],
                        "attempts": self.key_attempts[key_id],
                        "successes": self.key_successes[key_id],
                        "failures": self.key_failures[key_id],
                    } for key_id, label, _key in self.keys],
                    "models": [{
                        "model": model,
                        "rank": index + 1,
                        "attempts": self.model_attempts[model],
                        "successes": self.model_successes[model],
                        "failures": self.model_failures[model],
                    } for index, model in enumerate(self.candidates)],
                },
                "credential_values_disclosed": False,
                "raw_provider_content_disclosed": False,
            }

    def request_window(self, request: dict[str, Any], fingerprint: str | None
                       ) -> tuple[str, float, float]:
        if fingerprint is None:
            fingerprint = hashlib.sha256(canonical(request)).hexdigest()
        if re.fullmatch(r"[0-9a-f]{64}", fingerprint) is None:
            raise AdapterError("Gemini request fingerprint is invalid", status=500,
                               code="adapter_internal")
        with self.window_creation_lock:
            now = time.monotonic()
            with self.lock:
                row = self.request_windows.get(fingerprint)
                if row is not None and now <= float(row["reset_after"]):
                    self.request_window_reuses += 1
                    return fingerprint, float(row["route_deadline"]), float(row["request_deadline"])
            key_ids = [key_id for key_id, _label, _key in self.keys]
            assigner = getattr(self.cooldowns, "assign_start_key", None)
            if callable(assigner):
                preferred_model = continuation_model(request)
                start_key_id = assigner(
                    key_ids, self.ordered_models(preferred_model),
                    ignore=self.ignore_cooldowns)
                start_key_index = key_ids.index(start_key_id)
            else:
                start_key_index = self.account_cursor % len(self.keys)
            now = time.monotonic()
            route_deadline = now + self.route_wait_seconds
            request_deadline = now + max(self.timeout, float(self.route_wait_seconds))
            reset_after = request_deadline + REQUEST_WINDOW_RESET_SECONDS
            with self.lock:
                self.request_windows[fingerprint] = {
                    "route_deadline": route_deadline,
                    "request_deadline": request_deadline,
                    "reset_after": reset_after,
                    "upstream_attempts": 0,
                    "model_failures": {},
                    "route_failures": {},
                    "rejected_keys": [],
                    "schedule_started_keys": [],
                    "last_attempt_key_id": None,
                    "last_failure_category": None,
                    "last_failure_status": None,
                    "last_failure_code": None,
                    "start_key_index": start_key_index,
                }
                self.account_cursor = (start_key_index + 1) % len(self.keys)
                self.account_cursor_assignments += 1
                # Dicts retain insertion order. Bound even a malicious stream
                # of unique requests without retaining any request bytes.
                while len(self.request_windows) > MAX_REQUEST_WINDOWS:
                    self.request_windows.pop(next(iter(self.request_windows)))
                return fingerprint, route_deadline, request_deadline

    def complete_request_window(self, fingerprint: str) -> None:
        with self.lock:
            self.request_windows.pop(fingerprint, None)

    def ordered_models(self, preferred_model: str | None = None) -> list[str]:
        if preferred_model is None:
            return list(self.candidates)
        return [preferred_model, *(
            model for model in self.candidates if model != preferred_model)]

    def attempts(self, preferred_model: str | None = None, *, record_start: bool = True,
                 fingerprint: str | None = None) -> list[tuple[str, str, str]]:
        """Return usable routes ordered by model strength, then account key.

        Sandcodex is designed to consume the available free capacity of the
        operator's banked accounts without interrupting the Codex turn.  It
        therefore keeps the strongest model selected while rotating through
        healthy account keys, and moves to the next model only after every
        usable key for the stronger model is cooling or exhausted.
        """
        # A pending signed tool result prefers its origin model, but Google
        # Interactions v1 supports carrying the exact signed history to another
        # model.  This preserves strength when possible and continuity when the
        # origin is cooling or unavailable.
        models = self.ordered_models(preferred_model)
        rejected: set[str] = set()
        model_failures: dict[str, int] = {}
        route_failures: dict[str, int] = {}
        start_key_index = self.account_cursor % len(self.keys)
        remaining = MAX_ATTEMPTS
        if fingerprint is not None:
            with self.lock:
                window = self.request_windows.get(fingerprint)
                if window is None:
                    return []
                rejected = set(str(value) for value in window["rejected_keys"])
                model_failures = {str(name): int(count)
                                  for name, count in dict(window["model_failures"]).items()}
                route_failures = {str(name): int(count)
                                  for name, count in dict(window["route_failures"]).items()}
                start_key_index = int(window.get("start_key_index", 0)) % len(self.keys)
                remaining = MAX_ATTEMPTS - int(window["upstream_attempts"])
        models = [model for model in models
                  if model_failures.get(model, 0) < MAX_MODEL_FAILURES_PER_REQUEST]
        if remaining <= 0 or not models:
            return []
        ordered_keys = self.keys[start_key_index:] + self.keys[:start_key_index]
        route_checker = getattr(self.cooldowns, "available_routes", None)
        if callable(route_checker):
            available_routes = route_checker(
                [key_id for key_id, _label, _key in ordered_keys], models,
                ignore=self.ignore_cooldowns)
        else:
            available_routes = {
                (key_id, model) for model in models
                for key_id, _label, _key in ordered_keys
                if self.cooldowns.available(
                    key_id, model, ignore=self.ignore_cooldowns)
            }
        rows: list[tuple[str, str, str]] = []
        for model in models:
            for key_id, _label, key in ordered_keys:
                if key_id in rejected:
                    continue
                if route_failures.get(f"{key_id}:{model}", 0) >= MAX_ROUTE_FAILURES_PER_REQUEST:
                    continue
                if (key_id, model) not in available_routes:
                    continue
                rows.append((model, key_id, key))
        rows = rows[:remaining]
        if rows and record_start and fingerprint is None:
            with self.lock:
                self.key_schedule_starts[rows[0][1]] += 1
        return rows

    def reserve_attempt(self, fingerprint: str, model: str, key_id: str) -> bool:
        with self.lock:
            window = self.request_windows.get(fingerprint)
            if window is None or int(window["upstream_attempts"]) >= MAX_ATTEMPTS:
                return False
            if key_id in window["rejected_keys"]:
                return False
            model_failures = dict(window["model_failures"])
            route_failures = dict(window["route_failures"])
            if int(model_failures.get(model, 0)) >= MAX_MODEL_FAILURES_PER_REQUEST:
                return False
            if int(route_failures.get(f"{key_id}:{model}", 0)) >= MAX_ROUTE_FAILURES_PER_REQUEST:
                return False
            started_keys = window["schedule_started_keys"]
            if key_id not in started_keys:
                started_keys.append(key_id)
                self.key_schedule_starts[key_id] += 1
            previous_key = window.get("last_attempt_key_id")
            if isinstance(previous_key, str) and previous_key != key_id:
                reason = str(window.get("last_failure_category") or "route-failover")
                self.key_rotation_count += 1
                if reason in {"quota", "rate-limit", "daily-quota"}:
                    self.quota_key_rotation_count += 1
                self.last_key_rotation = {
                    "from": previous_key, "to": key_id, "reason": reason,
                }
            window["last_attempt_key_id"] = key_id
            window["upstream_attempts"] = int(window["upstream_attempts"]) + 1
            return True

    def request_budget_exhausted(self, fingerprint: str,
                                 preferred_model: str | None) -> bool:
        models = self.ordered_models(preferred_model)
        with self.lock:
            window = self.request_windows.get(fingerprint)
            if window is None:
                return True
            if int(window["upstream_attempts"]) >= MAX_ATTEMPTS:
                return True
            rejected = set(window["rejected_keys"])
            model_failures = dict(window["model_failures"])
            route_failures = dict(window["route_failures"])
            usable_keys = [key_id for key_id, _label, _key in self.keys
                           if key_id not in rejected]
            return all(
                int(model_failures.get(model, 0)) >= MAX_MODEL_FAILURES_PER_REQUEST
                or not usable_keys
                or all(int(route_failures.get(f"{key_id}:{model}", 0))
                       >= MAX_ROUTE_FAILURES_PER_REQUEST for key_id in usable_keys)
                for model in models)

    def request_exhaustion_error(self, fingerprint: str,
                                 preferred_model: str | None) -> AdapterError:
        with self.lock:
            window = self.request_windows.get(fingerprint) or {}
            category = str(window.get("last_failure_category") or "unavailable")
            raw_status = window.get("last_failure_status")
            status = int(raw_status) if type(raw_status) is int else 503
            detail = window.get("last_failure_code")
        retry_after = self.next_route_delay(preferred_model, fingerprint)
        if category in {"quota", "rate-limit", "daily-quota"}:
            return AdapterError(
                "the bounded Gemini retry budget was exhausted for this logical request",
                status=429, code="request_retry_budget_exhausted", retry_after=retry_after)
        if category.startswith("generation-") or category in {
                "upstream-protocol", "upstream-incomplete", "invalid-json"}:
            code = str(detail) if isinstance(detail, str) and detail else f"gemini_{category}"
            return AdapterError(
                f"Gemini returned output the adapter could not project ({code})",
                status=502, code=code)
        if not 500 <= status <= 599:
            status = 503
        return AdapterError(
            f"no Gemini route completed the request ({category})",
            status=status, code=f"gemini_{category}", retry_after=retry_after)

    def record_failure(self, fingerprint: str, model: str, key_id: str,
                       error: UpstreamError) -> bool:
        affected_models: list[str] = []
        blocked_key = False
        failed_route = False
        error_scope = error.quota_scope
        if error.category == "auth":
            seconds = error.retry_after or 86_400
            self.cooldowns.record("keys", key_id, max(seconds, 86_400), "authentication")
            blocked_key = True
            error_scope = "credential"
            retry = True
        elif error.category in {"quota", "rate-limit", "daily-quota"}:
            if error.category == "daily-quota":
                # Google documents RPD reset at midnight Pacific. A generic
                # RetryInfo can still point at the next minute boundary on a
                # response whose structured quota ID is per-day; taking the
                # shorter hint would hammer a route that cannot heal yet.
                seconds = max(error.retry_after or 0,
                              seconds_until_pacific_midnight())
            elif error.category == "rate-limit":
                seconds = error.retry_after or 60
            else:
                seconds = error.retry_after or 900
            # A key identifies the banked account/project route. Project-wide
            # pressure cools that key across the ladder; model-dimensional or
            # unstructured pressure cools only this key/model pair. In both
            # cases the next healthy account remains eligible for the same
            # strongest model.
            error_scope = error_scope or "model"
            if error_scope == "project":
                self.cooldowns.record("keys", key_id, seconds, error.category)
                blocked_key = True
            else:
                self.cooldowns.record("pairs", f"{key_id}:{model}", seconds, error.category)
                failed_route = True
            retry = True
        elif error.category == "model-unavailable":
            seconds = error.retry_after or 86_400
            self.cooldowns.record("models", model, max(seconds, 86_400), "model-unavailable")
            affected_models = [model]
            error_scope = "model"
            retry = self.auto
        elif error.category.startswith("generation-"):
            seconds = error.retry_after or 60
            self.cooldowns.record("models", model, min(seconds, 900), error.category)
            affected_models = [model]
            error_scope = "model"
            retry = self.auto
        elif error.category in {
                "transient", "transport", "invalid-json",
                "upstream-protocol", "upstream-incomplete"}:
            seconds = error.retry_after or 5
            self.cooldowns.record("models", model, min(seconds, 300), error.category)
            affected_models = [model]
            error_scope = "model"
            retry = True
        else:
            retry = False
        with self.lock:
            window = self.request_windows.get(fingerprint)
            if window is not None:
                if blocked_key and key_id not in window["rejected_keys"]:
                    window["rejected_keys"].append(key_id)
                if affected_models:
                    failures = window["model_failures"]
                    for affected_model in affected_models:
                        failures[affected_model] = int(failures.get(affected_model, 0)) + 1
                if failed_route:
                    routes = window["route_failures"]
                    identity = f"{key_id}:{model}"
                    routes[identity] = int(routes.get(identity, 0)) + 1
            self.key_failures[key_id] += 1
            self.model_failures[model] += 1
            self.last_error_class = error.category
            self.last_error_scope = error_scope
            self.last_error_code = error.detail_code
            if error.category.startswith("generation-"):
                self.projection_failures += 1
            if window is not None:
                window["last_failure_category"] = error.category
                window["last_failure_status"] = error.status
                window["last_failure_code"] = error.detail_code
            if error.category in {"quota", "rate-limit", "daily-quota"}:
                if error_scope == "project":
                    self.project_scope_cooldowns += 1
                else:
                    self.model_scope_cooldowns += 1
            if retry:
                self.failover_count += 1
        self.record_route_event(
            "route-failure", model, key_id,
            category=error.category, scope=error_scope)
        return retry

    def next_route_delay(self, preferred_model: str | None,
                         fingerprint: str | None = None) -> int | None:
        models = self.ordered_models(preferred_model)
        key_ids = [key_id for key_id, _label, _key in self.keys]
        if fingerprint is not None:
            with self.lock:
                window = self.request_windows.get(fingerprint)
                if window is not None:
                    rejected = set(window["rejected_keys"])
                    failures = dict(window["model_failures"])
                    key_ids = [key_id for key_id in key_ids if key_id not in rejected]
                    models = [model for model in models if int(failures.get(model, 0))
                              < MAX_MODEL_FAILURES_PER_REQUEST]
        return self.cooldowns.next_delay(
            key_ids, models,
            ignore=self.ignore_cooldowns)

    def wait_for_route(self, preferred_model: str | None, deadline: float,
                       cancelled: Callable[[], bool] | None,
                       fingerprint: str | None = None) -> tuple[bool, int | None]:
        delay = self.next_route_delay(preferred_model, fingerprint)
        remaining = max(0.0, deadline - time.monotonic())
        if delay is None or delay > remaining or remaining <= 0:
            return False, delay
        duration = min(float(delay), remaining)
        with self.lock:
            self.wait_count += 1
            self.waiting_requests += 1
        started = time.monotonic()
        try:
            until = started + duration
            while True:
                if cancelled is not None and cancelled():
                    raise AdapterError("Gemini request client disconnected", status=499,
                                       code="client_disconnected")
                left = until - time.monotonic()
                if left <= 0:
                    break
                time.sleep(min(left, 0.25))
        finally:
            elapsed = max(0.0, time.monotonic() - started)
            with self.lock:
                self.waiting_requests -= 1
                self.waited_seconds += elapsed
        return True, None

    def run(self, request: dict[str, Any],
            fingerprint: str | None = None,
            cancelled: Callable[[], bool] | None = None,
            evidence_ref: str | None = None) -> tuple[dict[str, Any], dict[str, dict[str, Any]], str, str, int]:
        model = request.get("model")
        if model != self.routing_model:
            raise AdapterError("request model differs from the bound Gemini route", status=409,
                               code="model_identity_mismatch")
        if request.get("store") not in (None, False):
            raise AdapterError("Gemini adapter requires store=false")
        if request.get("previous_response_id") not in (None, ""):
            raise AdapterError("Gemini adapter requires full stateless Responses history")
        preferred_model = continuation_model(request)
        if preferred_model is not None and preferred_model not in self.candidates:
            raise AdapterError("Gemini tool continuation model is outside the bound route",
                               status=409, code="provider_state_mismatch")
        with self.lock:
            self.request_count += 1
        fingerprint, route_deadline, request_deadline = self.request_window(request, fingerprint)
        last: UpstreamError | None = None
        retryable = True
        while retryable:
            if time.monotonic() >= request_deadline:
                raise AdapterError(
                    "the bounded Gemini request window was exhausted; retry as a new turn",
                    status=429, code="request_window_exhausted")
            attempts = self.attempts(preferred_model, fingerprint=fingerprint)
            if not attempts:
                if self.request_budget_exhausted(fingerprint, preferred_model):
                    with self.lock:
                        self.retry_budget_exhaustions += 1
                    raise self.request_exhaustion_error(fingerprint, preferred_model)
                if self.ignore_cooldowns:
                    break
                waited, retry_delay = self.wait_for_route(
                    preferred_model, min(route_deadline, request_deadline), cancelled,
                    fingerprint)
                if waited:
                    continue
                raise AdapterError("all Gemini models are cooling down", status=429,
                                   code="all_routes_cooling_down",
                                   retry_after=retry_delay)
            retryable = False
            rebuild_schedule = False
            for selected_model, key_id, key in attempts:
                # Earlier rows in this same attempt pass may have cooled an
                # entire credential or model. Recheck the shared ledger so an
                # invalid primary is not redundantly tried against every model
                # and a cooled model is not retried within this request.
                if not self.cooldowns.available(
                        key_id, selected_model, ignore=self.ignore_cooldowns):
                    continue
                remaining = request_deadline - time.monotonic()
                if remaining <= 0:
                    retryable = True
                    break
                if cancelled is not None and cancelled():
                    raise AdapterError("Gemini request client disconnected", status=499,
                                       code="client_disconnected")
                if not self.reserve_attempt(fingerprint, selected_model, key_id):
                    continue
                body, bridge, dropped = build_interaction(
                    request, selected_model, allow_native_search=self.allow_native_search)
                with self.lock:
                    self.key_attempts[key_id] += 1
                    self.model_attempts[selected_model] += 1
                    self.last_request_profile = request_profile(request, body)
                evidence_attempt = self.request_evidence.begin_attempt(evidence_ref)
                successful_attempt_started_at = dt.datetime.now(dt.timezone.utc)
                try:
                    # One stalled route must not multiply the request ceiling
                    # by the number of models in the ladder.
                    result = google_request(
                        self.api_base, key, body, min(self.timeout, max(0.25, remaining)))
                    validate_interaction(result)
                    # Validate the complete Responses projection before a single
                    # semantic byte becomes visible.  A model that emits an
                    # unsupported or malformed step is therefore just another
                    # failed route in auto mode, not a half-delivered turn.
                    responses_payload(result, bridge, self.routing_model, selected_model, dropped)
                except UpstreamError as error:
                    self.request_evidence.finish_attempt(
                        evidence_ref,
                        evidence_attempt,
                        self.request_evidence.upstream_outcome(error.category),
                    )
                    last = error
                    should_retry = self.record_failure(
                        fingerprint, selected_model, key_id, error)
                    if error.category.startswith("request"):
                        self.complete_request_window(fingerprint)
                        explanations = {
                            "request-tool-schema": (
                                "Gemini rejected a translated tool schema; this is a "
                                "Sandcodex compatibility failure, not a key or quota failure"),
                            "request-state-signature": (
                                "Gemini rejected the retained reasoning signature for this continuation"),
                            "request-function-history": (
                                "Gemini rejected the stateless function-call continuation history"),
                            "request-input-history": (
                                "Gemini rejected the translated stateless conversation history"),
                        }
                        raise AdapterError(
                            explanations.get(error.category,
                                             "Gemini rejected the translated request"),
                            status=400, code=f"gemini_{error.category}")
                    if should_retry:
                        retryable = True
                        if error.category == "auth":
                            # Rebuild the schedule immediately so the next
                            # credential is selected once for every model.
                            rebuild_schedule = True
                            break
                        continue
                    retryable = False
                    break
                except AdapterError as error:
                    self.request_evidence.finish_attempt(
                        evidence_ref,
                        evidence_attempt,
                        "adapter-internal" if error.code == "adapter_internal" else "projection-rejected",
                    )
                    if error.code == "adapter_internal":
                        raise
                    last = UpstreamError(502, "generation-protocol", detail_code=error.code)
                    if self.record_failure(
                            fingerprint, selected_model, key_id, last):
                        retryable = True
                        continue
                    retryable = False
                    break
                except Exception:
                    self.request_evidence.finish_attempt(
                        evidence_ref, evidence_attempt, "adapter-internal"
                    )
                    raise
                self.request_evidence.finish_attempt(
                    evidence_ref, evidence_attempt, "completed"
                )
                with self.lock:
                    self.success_count += 1
                    self.key_successes[key_id] += 1
                    self.model_successes[selected_model] += 1
                    self.last_model = selected_model
                    self.last_key_id = key_id
                    self.last_error_class = None
                    self.last_error_scope = None
                    self.last_error_code = None
                    if preferred_model is not None and selected_model != preferred_model:
                        self.cross_model_continuations += 1
                        self.last_continuation_migration = {
                            "from": preferred_model, "to": selected_model,
                        }
                self.record_route_event(
                    "route-success", selected_model, key_id,
                    successful_attempt_started_at=successful_attempt_started_at)
                self.complete_request_window(fingerprint)
                return result, bridge, selected_model, key_id, dropped
            if rebuild_schedule:
                continue
            if retryable and self.request_budget_exhausted(fingerprint, preferred_model):
                with self.lock:
                    self.retry_budget_exhaustions += 1
                raise self.request_exhaustion_error(fingerprint, preferred_model)
            if retryable and not self.ignore_cooldowns:
                waited, _retry_delay = self.wait_for_route(
                    preferred_model, min(route_deadline, request_deadline), cancelled,
                    fingerprint)
                if waited:
                    continue
            break
        category = last.category if last else "unavailable"
        status = last.status if last and 400 <= last.status <= 599 else 503
        if status in {401, 403, 404}:
            status = 503
        retry_delay = self.next_route_delay(preferred_model, fingerprint) if retryable else None
        raise AdapterError(f"no Gemini route completed the request ({category})", status=status,
                           code=f"gemini_{category}", retry_after=retry_delay)


def validate_interaction(value: dict[str, Any]) -> None:
    if value.get("status") not in {"completed", "requires_action"}:
        raise UpstreamError(502, "upstream-incomplete")
    steps = value.get("steps")
    if not isinstance(steps, list) or not steps or len(steps) > MAX_OUTPUT_ITEMS:
        raise UpstreamError(502, "upstream-protocol")
    allowed = EXACT_GEMINI_STEPS
    if any(not isinstance(step, dict) or step.get("type") not in allowed for step in steps):
        raise UpstreamError(502, "upstream-protocol")


def summary_items(step: dict[str, Any]) -> list[dict[str, str]]:
    value = step.get("summary")
    if not isinstance(value, list):
        return []
    result: list[dict[str, str]] = []
    for item in value:
        if isinstance(item, dict) and item.get("type") in {"text", "summary_text"} and isinstance(item.get("text"), str):
            result.append({"type": "summary_text", "text": item["text"]})
    return result


def model_output_content(step: dict[str, Any]) -> dict[str, Any]:
    content = step.get("content")
    if isinstance(content, str):
        return {"type": "output_text", "text": content, "annotations": []}
    if not isinstance(content, list):
        raise AdapterError("Gemini model_output content is malformed", status=502,
                           code="upstream_protocol")
    parts: list[str] = []
    annotations: list[dict[str, Any]] = []
    for item in content:
        if isinstance(item, dict) and item.get("type") in {"text", "output_text"} and isinstance(item.get("text"), str):
            offset = sum(len(part) for part in parts)
            parts.append(item["text"])
            raw_annotations = item.get("annotations", [])
            if not isinstance(raw_annotations, list):
                raise AdapterError("Gemini output annotations are malformed", status=502,
                                   code="upstream_protocol")
            for annotation in raw_annotations:
                if not isinstance(annotation, dict) or annotation.get("type") != "url_citation":
                    raise AdapterError("Gemini emitted an unsupported output annotation", status=502,
                                       code="upstream_protocol")
                url = annotation.get("url")
                title = annotation.get("title")
                start = annotation.get("start_index")
                end = annotation.get("end_index")
                if (not isinstance(url, str) or not url.startswith(("http://", "https://"))
                        or title is not None and not isinstance(title, str)
                        or type(start) is not int or type(end) is not int
                        or not 0 <= start <= end <= len(item["text"])):
                    raise AdapterError("Gemini URL citation is malformed", status=502,
                                       code="upstream_protocol")
                row: dict[str, Any] = {
                    "type": "url_citation", "url": url,
                    "start_index": offset + start, "end_index": offset + end,
                }
                if title:
                    row["title"] = title
                annotations.append(row)
        else:
            raise AdapterError("Gemini emitted unsupported model_output content", status=502,
                               code="upstream_protocol")
    return {"type": "output_text", "text": "".join(parts), "annotations": annotations}


def web_search_item(step: dict[str, Any], item_id: str) -> dict[str, Any]:
    arguments = step.get("arguments")
    queries = step.get("queries")
    if isinstance(arguments, dict) and queries is None:
        queries = arguments.get("queries")
    if not isinstance(queries, list) or any(not isinstance(query, str) for query in queries):
        queries = []
    action: dict[str, Any] = {"type": "search"}
    if queries:
        action["query"] = queries[0]
        action["queries"] = queries
    return {"type": "web_search_call", "id": "ws_" + item_id,
            "status": "completed", "action": action}


def usage_object(value: object) -> dict[str, Any]:
    usage = value if isinstance(value, dict) else {}
    def number(*names: str) -> int:
        for name in names:
            candidate = usage.get(name)
            if type(candidate) is int and candidate >= 0:
                return candidate
        return 0
    input_tokens = number("total_input_tokens", "input_tokens", "prompt_token_count", "promptTokenCount")
    visible_output_tokens = number(
        "total_output_tokens", "output_tokens", "candidates_token_count", "candidatesTokenCount")
    reasoning_tokens = number(
        "total_thought_tokens", "thoughts_tokens", "thoughts_token_count", "thoughtsTokenCount")
    output_tokens = visible_output_tokens + reasoning_tokens
    total_tokens = number("total_tokens", "total_token_count", "totalTokenCount")
    if total_tokens == 0:
        total_tokens = input_tokens + output_tokens
    return {
        "input_tokens": input_tokens,
        "input_tokens_details": {"cached_tokens": number(
            "total_cached_tokens", "cached_input_tokens", "cachedContentTokenCount")},
        "output_tokens": output_tokens,
        "output_tokens_details": {"reasoning_tokens": reasoning_tokens},
        "total_tokens": total_tokens,
    }


def responses_payload(interaction: dict[str, Any], bridge: dict[str, dict[str, Any]], routing_model: str,
                      selected_model: str, dropped: int) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    response_id = "resp_scg_" + uuid.uuid4().hex
    output: list[dict[str, Any]] = []
    for ordinal, step in enumerate(interaction["steps"]):
        step_type = step["type"]
        item_id = f"scg_{ordinal}_{uuid.uuid4().hex}"
        semantic_id = f"scgo_{ordinal}_{uuid.uuid4().hex}"
        if step_type in EXACT_GEMINI_STEPS:
            output.append({
                "type": "reasoning",
                "id": item_id,
                "summary": summary_items(step) if step_type == "thought" else [],
                "encrypted_content": encode_state(step, selected_model),
            })
        if step_type == "google_search_call":
            output.append(web_search_item(step, semantic_id))
        elif step_type == "model_output":
            content = model_output_content(step)
            output.append({
                "type": "message", "id": semantic_id, "role": "assistant", "status": "completed",
                "content": [content],
            })
        elif step_type == "function_call":
            name = step.get("name")
            call_id = step.get("id") or step.get("call_id")
            arguments = step.get("arguments", step.get("args"))
            if not isinstance(name, str) or not isinstance(call_id, str) or not isinstance(arguments, dict):
                raise AdapterError("Gemini function_call is malformed", status=502,
                                   code="gemini_malformed_function_call")
            metadata = bridge.get(name)
            if metadata is None:
                raise AdapterError("Gemini called a function not declared by Codex", status=502,
                                   code="gemini_undeclared_function_call")
            kind = metadata["kind"]
            original_name = metadata["name"]
            namespace = metadata["namespace"]
            if kind == "custom":
                raw_input = arguments.get("input")
                if not isinstance(raw_input, str):
                    raise AdapterError("Gemini custom-tool call has malformed input", status=502,
                                       code="gemini_malformed_custom_tool_call")
                row = {"type": "custom_tool_call", "id": semantic_id, "call_id": call_id,
                       "name": original_name, "input": raw_input}
                if namespace is not None:
                    row["namespace"] = namespace
                output.append(row)
            elif kind == "tool_search":
                output.append({"type": "tool_search_call", "id": semantic_id, "call_id": call_id,
                               "execution": "client", "arguments": arguments})
            else:
                row = {"type": "function_call", "id": semantic_id, "call_id": call_id,
                       "name": original_name, "arguments": canonical(arguments).decode(),
                       "status": "completed"}
                if namespace is not None:
                    row["namespace"] = namespace
                output.append(row)
    usage = usage_object(interaction.get("usage"))
    response = {
        "id": response_id,
        "object": "response",
        "created_at": int(time.time()),
        "status": "completed",
        "model": routing_model,
        "output": output,
        "usage": usage,
        "metadata": {
            "sandcodex_actual_model": selected_model,
            "sandcodex_reasoning_states_dropped_on_model_switch": dropped,
        },
    }
    return response, output


def sse_added_item(item: dict[str, Any]) -> dict[str, Any]:
    """Return the incomplete item announced before its streamed payload.

    Codex seeds visible state from response.output_item.added.  Announcing the
    completed item there and then emitting deltas displays the same content
    twice.  Keep identity and routing fields, but make every streamable field
    empty until its delta/done events arrive.
    """
    kind = item["type"]
    common = {key: item[key] for key in ("type", "id") if key in item}
    if kind == "message":
        return {**common, "role": item["role"], "status": "in_progress", "content": []}
    if kind == "reasoning":
        return {**common, "summary": [], "encrypted_content": None}
    if kind == "function_call":
        return {
            **common, "call_id": item["call_id"], "name": item["name"],
            **({"namespace": item["namespace"]} if "namespace" in item else {}),
            "arguments": "", "status": "in_progress",
        }
    if kind == "custom_tool_call":
        return {
            **common, "call_id": item["call_id"], "name": item["name"],
            **({"namespace": item["namespace"]} if "namespace" in item else {}),
            "input": "", "status": "in_progress",
        }
    if kind == "tool_search_call":
        return {
            **common, "call_id": item.get("call_id"),
            "execution": item["execution"], "arguments": {}, "status": "in_progress",
        }
    if kind == "web_search_call":
        return {**common, "status": "in_progress", "action": None}
    raise AdapterError(f"cannot stream unsupported Responses item {kind!r}", status=500,
                       code="adapter_internal")


def sse_events(response: dict[str, Any], output: list[dict[str, Any]]) -> Iterable[tuple[str, dict[str, Any]]]:
    stub = {key: response[key] for key in ("id", "object", "created_at", "status", "model")}
    # A buffered upstream completion is still only the beginning of this
    # downstream SSE lifecycle. Do not announce it as already completed.
    stub["status"] = "in_progress"
    stub["output"] = []
    yield "response.created", {"type": "response.created", "response": stub}
    yield "response.in_progress", {"type": "response.in_progress", "response": stub}
    for index, item in enumerate(output):
        yield "response.output_item.added", {
            "type": "response.output_item.added", "output_index": index,
            "item": sse_added_item(item),
        }
        if item["type"] == "message":
            text = item["content"][0]["text"]
            if text:
                yield "response.output_text.delta", {
                    "type": "response.output_text.delta", "item_id": item["id"],
                    "output_index": index, "content_index": 0, "delta": text,
                }
            yield "response.output_text.done", {
                "type": "response.output_text.done", "item_id": item["id"],
                "output_index": index, "content_index": 0, "text": text,
            }
        elif item["type"] == "reasoning":
            for summary_index, summary in enumerate(item["summary"]):
                text = summary["text"]
                empty_part = {"type": "summary_text", "text": ""}
                completed_part = {"type": "summary_text", "text": text}
                yield "response.reasoning_summary_part.added", {
                    "type": "response.reasoning_summary_part.added", "item_id": item["id"],
                    "output_index": index, "summary_index": summary_index,
                    "part": empty_part,
                }
                if text:
                    yield "response.reasoning_summary_text.delta", {
                        "type": "response.reasoning_summary_text.delta", "item_id": item["id"],
                        "output_index": index, "summary_index": summary_index, "delta": text,
                    }
                yield "response.reasoning_summary_text.done", {
                    "type": "response.reasoning_summary_text.done", "item_id": item["id"],
                    "output_index": index, "summary_index": summary_index, "text": text,
                }
                yield "response.reasoning_summary_part.done", {
                    "type": "response.reasoning_summary_part.done", "item_id": item["id"],
                    "output_index": index, "summary_index": summary_index,
                    "part": completed_part,
                }
        elif item["type"] == "function_call":
            arguments = item["arguments"]
            if arguments:
                yield "response.function_call_arguments.delta", {
                    "type": "response.function_call_arguments.delta", "item_id": item["id"],
                    "output_index": index, "delta": arguments,
                }
            yield "response.function_call_arguments.done", {
                "type": "response.function_call_arguments.done", "item_id": item["id"],
                "output_index": index, "arguments": arguments,
            }
        elif item["type"] == "custom_tool_call":
            tool_input = item["input"]
            if tool_input:
                yield "response.custom_tool_call_input.delta", {
                    "type": "response.custom_tool_call_input.delta", "item_id": item["id"],
                    "call_id": item["call_id"], "output_index": index, "delta": tool_input,
                }
            yield "response.custom_tool_call_input.done", {
                "type": "response.custom_tool_call_input.done", "item_id": item["id"],
                "call_id": item["call_id"], "output_index": index, "input": tool_input,
            }
        yield "response.output_item.done", {
            "type": "response.output_item.done", "output_index": index, "item": item,
        }
    yield "response.completed", {"type": "response.completed", "response": response}


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = False
    request_queue_size = 64

    def __init__(self, address: tuple[str, int], runtime: Runtime) -> None:
        self.runtime = runtime
        super().__init__(address, Handler)


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "sandcodex-gemini-adapter"
    sys_version = ""

    @property
    def runtime(self) -> Runtime:
        return self.server.runtime  # type: ignore[attr-defined,no-any-return]

    def log_message(self, _format: str, *_args: object) -> None:
        return

    def send_json(self, status: int, value: dict[str, Any], *, headers: dict[str, str] | None = None) -> None:
        raw = canonical(value)
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(raw)))
        self.send_header("cache-control", "no-store")
        self.send_header("connection", "close")
        for name, content in (headers or {}).items():
            self.send_header(name, content)
        self.end_headers()
        self.wfile.write(raw)
        self.close_connection = True

    def send_error_json(self, error: AdapterError) -> None:
        status = error.status if 400 <= error.status <= 599 else 500
        headers = ({"retry-after": str(error.retry_after)}
                   if error.retry_after is not None and error.retry_after > 0 else None)
        self.send_json(status, {"error": {"message": str(error), "type": "sandcodex_gemini_error",
                                          "code": error.code}}, headers=headers)

    def client_disconnected(self) -> bool:
        try:
            readable, _writable, _exceptional = select.select([self.connection], [], [], 0)
            if not readable:
                return False
            return self.connection.recv(1, socket.MSG_PEEK | socket.MSG_DONTWAIT) == b""
        except BlockingIOError:
            return False
        except OSError:
            return True

    def authenticated(self) -> bool:
        if self.runtime.authorized(self.headers.get("authorization")):
            return True
        self.send_error_json(AdapterError("adapter authentication failed", status=401,
                                          code="invalid_adapter_token"))
        return False

    def do_GET(self) -> None:
        if not self.authenticated():
            return
        if self.path == "/health":
            self.send_json(200, self.runtime.health())
        elif self.path in {"/v1/models", "/models"}:
            self.send_json(200, {"object": "list", "data": [{
                "id": self.runtime.routing_model,
                "object": "model",
                "owned_by": "sandcodex-gemini-adapter",
            }]})
        else:
            self.send_error_json(AdapterError("endpoint not found", status=404, code="not_found"))

    def do_POST(self) -> None:
        if not self.authenticated():
            return
        if self.path not in {"/v1/responses", "/responses"}:
            self.send_error_json(AdapterError("endpoint not found", status=404, code="not_found"))
            return
        length_text = self.headers.get("content-length")
        if not length_text or not length_text.isdigit():
            self.send_error_json(AdapterError("content-length is required", status=411,
                                              code="length_required"))
            return
        length = int(length_text)
        if not 0 < length <= MAX_REQUEST_BYTES:
            self.send_error_json(AdapterError("request body exceeds the adapter limit", status=413,
                                              code="request_too_large"))
            return
        raw = self.rfile.read(length)
        try:
            request = json.loads(raw)
        except (ValueError, UnicodeError):
            self.send_error_json(AdapterError("request body is not valid JSON"))
            return
        if not isinstance(request, dict):
            self.send_error_json(AdapterError("request JSON root must be an object"))
            return
        try:
            fingerprint = hashlib.sha256(canonical(request)).hexdigest()
        except (TypeError, ValueError):
            self.send_error_json(AdapterError("request JSON contains a non-canonical value"))
            return
        request_scope = sc_request_scope(
            self.headers.get_all(REQUEST_SCOPE_HEADER, [])
        )
        evidence_ref = self.runtime.request_evidence.begin_request(request_scope)
        if not self.runtime.semaphore.acquire(blocking=False):
            self.runtime.request_evidence.finish_request(evidence_ref, "adapter-busy")
            self.send_error_json(AdapterError("Gemini adapter concurrency limit reached", status=429,
                                              code="adapter_busy"))
            return
        logical_outcome = "adapter-internal"
        try:
            interaction, bridge, selected, key_id, dropped = self.runtime.run(
                request, fingerprint, self.client_disconnected, evidence_ref)
            response, output = responses_payload(interaction, bridge, self.runtime.routing_model,
                                                 selected, dropped)
            # `openai-model` makes Codex interpret an ordinary Gemini auto-route
            # selection as an OpenAI safety reroute and print an inapplicable
            # account warning.  Keep the real model in Sandcodex-private
            # metadata and in the response body metadata instead.
            headers = {"x-sandcodex-gemini-model": selected,
                       "x-sandcodex-gemini-key-id": key_id}
            if request.get("stream") is True:
                self.send_response(200)
                self.send_header("content-type", "text/event-stream")
                self.send_header("cache-control", "no-store")
                self.send_header("connection", "close")
                for name, content in headers.items():
                    self.send_header(name, content)
                self.end_headers()
                for event, value in sse_events(response, output):
                    self.wfile.write(f"event: {event}\ndata: ".encode() + canonical(value) + b"\n\n")
                self.wfile.write(b"data: [DONE]\n\n")
                self.wfile.flush()
                self.close_connection = True
            else:
                self.send_json(200, response, headers=headers)
            logical_outcome = "completed"
        except AdapterError as error:
            logical_outcome = (
                "client-disconnected"
                if error.code == "client_disconnected"
                else "adapter-rejected"
            )
            with contextlib.suppress(BrokenPipeError, ConnectionResetError):
                self.send_error_json(error)
        except (BrokenPipeError, ConnectionResetError):
            logical_outcome = "downstream-disconnected"
            return
        except Exception:
            logical_outcome = "adapter-internal"
            with contextlib.suppress(BrokenPipeError, ConnectionResetError):
                self.send_error_json(AdapterError("Gemini adapter internal failure", status=500,
                                                  code="adapter_internal"))
        finally:
            self.runtime.request_evidence.finish_request(evidence_ref, logical_outcome)
            self.runtime.semaphore.release()


def write_ready(path: Path, server: Server, config_path: Path) -> None:
    value = {
        "schema": READY_SCHEMA,
        "status": "ready",
        "pid": os.getpid(),
        "port": server.server_address[1],
        "host": "127.0.0.1",
        "started_at": utc_now(),
        "config_sha256": hashlib.sha256(private_regular(config_path, "Gemini adapter configuration")).hexdigest(),
        "credential_values_disclosed": False,
    }
    atomic_private_json(path, value)


def self_test() -> int:
    conditional_schema = {
        "type": "object",
        "required": ["kind"],
        "oneOf": [
            {"required": ["kind", "text"], "properties": {"kind": {"const": "text"}}},
            {"required": ["kind", "path"], "properties": {"kind": {"const": "file"}}},
        ],
        "properties": {
            "kind": {"enum": ["text", "file"]},
            "text": {"type": "string"},
            "path": {"type": "string"},
        },
        "additionalProperties": False,
    }
    normalized_schema = normalize_gemini_schema(conditional_schema)
    assert normalized_schema["oneOf"][0]["properties"]["text"] == {"type": "string"}
    assert normalized_schema["oneOf"][1]["properties"]["path"] == {"type": "string"}
    assert normalized_schema["oneOf"][0]["properties"]["kind"] == {"const": "text"}
    assert conditional_schema["oneOf"][0]["properties"] == {"kind": {"const": "text"}}
    thought = {"type": "thought", "signature": "opaque", "summary": [{"type": "text", "text": "s"}]}
    encoded = encode_state(thought, "gemini-test")
    model, decoded = decode_state(encoded)
    assert model == "gemini-test" and decoded == thought
    request = {
        "model": "route", "store": False,
        "input": [
            {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "hi"}]},
            {"type": "reasoning", "encrypted_content": encoded, "summary": []},
            {"type": "function_call", "call_id": "c1", "name": "tool", "arguments": "{\"x\":1}"},
            {"type": "function_call_output", "call_id": "c1", "output": "ok"},
        ],
        "tools": [{"type": "function", "name": "tool", "parameters": {"type": "object"}}],
        "reasoning": {"effort": "xhigh", "summary": "auto"},
    }
    body, bridge, dropped = build_interaction(request, "gemini-test")
    assert body["input"][1] == thought and bridge["tool"]["name"] == "tool" and dropped == 0
    interaction = {"status": "completed", "steps": [thought, {
        "type": "function_call", "id": "c2", "name": "tool", "arguments": {"x": 2}}, {
        "type": "model_output", "content": [{"type": "text", "text": "done"}]}
    ], "usage": {"total_input_tokens": 3, "total_output_tokens": 4,
                   "total_thought_tokens": 2, "total_tokens": 9}}
    validate_interaction(interaction)
    response, output = responses_payload(interaction, bridge, "route", "gemini-test", 0)
    assert response["usage"] == {
        "input_tokens": 3,
        "input_tokens_details": {"cached_tokens": 0},
        "output_tokens": 6,
        "output_tokens_details": {"reasoning_tokens": 2},
        "total_tokens": 9,
    }
    assert [item["type"] for item in output] == [
        "reasoning", "reasoning", "function_call", "reasoning", "message"]
    replay = dict(request)
    replay["input"] = request["input"][:1] + output + [{
        "type": "function_call_output", "call_id": "c2", "output": "ok",
    }]
    replay_body, _, replay_dropped = build_interaction(replay, "gemini-test")
    assert replay_dropped == 0
    assert replay_body["input"][1:4] == interaction["steps"]
    assert replay_body["input"][4]["type"] == "function_result"

    # Interactions v1 permits a stateless conversation to switch models when
    # every prior model step is replayed exactly.  Prove the adapter retains a
    # complete mixed-model A -> B -> A lineage rather than reconstructing or
    # dropping another model's signed steps.
    mixed_call = {
        "type": "function_call", "id": "mixed-call", "name": "tool",
        "arguments": {"x": 7}, "signature": "opaque-a",
    }
    mixed_output = {
        "type": "model_output", "content": [{"type": "text", "text": "leg-b"}],
        "signature": "opaque-b",
    }
    mixed_request = {
        "model": "route", "store": False,
        "tools": request["tools"],
        "input": [
            request["input"][0],
            {"type": "reasoning", "encrypted_content": encode_state(mixed_call, "model-a")},
            {"type": "function_call", "call_id": "mixed-call", "name": "tool",
             "arguments": "{\"x\":7}"},
            {"type": "function_call_output", "call_id": "mixed-call", "output": "ok"},
            {"type": "reasoning", "encrypted_content": encode_state(mixed_output, "model-b")},
            {"type": "message", "role": "assistant", "content": "leg-b"},
            {"type": "message", "role": "user", "content": "continue"},
        ],
    }
    mixed_body, _, mixed_dropped = build_interaction(mixed_request, "model-a")
    assert mixed_dropped == 0
    assert mixed_body["input"][1] == mixed_call
    assert mixed_body["input"][2]["type"] == "function_result"
    assert mixed_body["input"][3] == mixed_output
    assert mixed_body["input"][4]["type"] == "user_input"
    events = list(sse_events(response, output))
    assert events[0][0] == "response.created" and events[-1][0] == "response.completed"
    added = [value["item"] for name, value in events if name == "response.output_item.added"]
    assert all(not item.get("content") for item in added if item["type"] == "message")
    assert all(not item.get("summary") for item in added if item["type"] == "reasoning")
    assert all(not item.get("arguments") for item in added if item["type"] == "function_call")
    assert any(name == "response.reasoning_summary_text.delta" for name, _ in events)
    assert any(name == "response.function_call_arguments.done" for name, _ in events)

    # Codex deliberately leaves dynamically discovered tools out of the next
    # request's top-level tools array. Prove that the adapter materializes an
    # overlapping series of tool_search results for Gemini, gives the model an
    # exact callable alias, and still projects the call back to the original
    # Codex namespace identity.
    navigate = {
        "type": "function", "name": "browser_navigate",
        "description": "Navigate the private browser.",
        "defer_loading": True,
        "parameters": {"type": "object", "properties": {
            "url": {"type": "string"}}, "required": ["url"],
            "additionalProperties": False},
    }
    snapshot = {
        "type": "function", "name": "browser_snapshot",
        "description": "Inspect the current browser page.",
        "defer_loading": True,
        "parameters": {"type": "object", "properties": {},
                       "additionalProperties": False},
    }
    search_tool = {
        "type": "tool_search", "execution": "client", "description": "discover tools",
        "parameters": {"type": "object", "properties": {
            "query": {"type": "string"}}, "required": ["query"],
            "additionalProperties": False},
    }
    search_request = {
        "model": "route", "store": False,
        "tools": [search_tool],
        "input": [
            {"type": "message", "role": "user", "content": "open a page"},
            {"type": "tool_search_call", "call_id": "search-1",
             "arguments": {"query": "navigate"}},
            {"type": "tool_search_output", "call_id": "search-1", "status": "completed",
             "execution": "client", "tools": [{
                 "type": "namespace", "name": "mcp__playwright",
                 "description": "Playwright browser tools.", "tools": [navigate]}]},
            {"type": "tool_search_call", "call_id": "search-2",
             "arguments": {"query": "snapshot"}},
            {"type": "tool_search_output", "call_id": "search-2", "status": "completed",
             "execution": "client", "tools": [{
                 "type": "namespace", "name": "mcp__playwright",
                 "description": "Playwright browser tools.", "tools": [navigate, snapshot]}]},
        ],
    }
    search_body, search_bridge, _ = build_interaction(search_request, "gemini-test")
    navigate_alias = next(
        alias for alias, metadata in search_bridge.items()
        if metadata == {"kind": "function", "name": "browser_navigate",
                        "namespace": "mcp__playwright"})
    assert len(search_body["tools"]) == 3
    assert search_body["system_instruction"].count("Playwright browser tools.") == 1
    search_result = json.loads(search_body["input"][2]["result"][0]["text"])
    assert search_result["available_functions"] == [{
        "callable_name": navigate_alias,
        "codex_name": "browser_navigate",
        "kind": "function",
        "codex_namespace": "mcp__playwright",
    }]
    assert "exact callable_name" in search_result["instruction"]
    _, discovered_output = responses_payload({
        "status": "requires_action", "steps": [{
            "type": "function_call", "id": "navigate-1", "name": navigate_alias,
            "arguments": {"url": "https://example.com"}}], "usage": {},
    }, search_bridge, "route", "gemini-test", 0)
    assert discovered_output[-1]["type"] == "function_call"
    assert discovered_output[-1]["name"] == "browser_navigate"
    assert discovered_output[-1]["namespace"] == "mcp__playwright"
    assert retry_after({"retry-after": "1.2"}) == 2
    retry_payload = {"error": {"details": [{
        "@type": "type.googleapis.com/google.rpc.RetryInfo", "retryDelay": "2.25s",
    }]}}
    assert retry_after({}, retry_payload) == 3
    assert upstream_category(429, {"error": {
        "code": "too_many_requests", "message": "20 requests per day Free Tier",
    }}) == "daily-quota"
    assert upstream_category(429, {"error": {
        "code": "rate_limit_exceeded", "message": "request rate exceeded",
    }}) == "rate-limit"
    model_quota = {"error": {"details": [{
        "@type": "type.googleapis.com/google.rpc.QuotaFailure",
        "violations": [{"quotaId": "GenerateRequestsPerModelPerMinute",
                         "quotaDimensions": {"model": "gemini-test"}}],
    }]}}
    project_quota = {"error": {"details": [{
        "@type": "type.googleapis.com/google.rpc.QuotaFailure",
        "violations": [{"quotaId": "GenerateRequestsPerProjectPerMinute",
                         "quotaDimensions": {"location": "global"}}],
    }]}}
    assert upstream_quota_scope(model_quota) == "model"
    assert upstream_quota_scope(project_quota) == "project"
    assert upstream_quota_scope({"error": {"code": "rate_limit_exceeded"}}) is None
    assert upstream_quota_period(model_quota) == "rate-limit"
    assert upstream_category(429, {"error": {
        "status": "RESOURCE_EXHAUSTED",
        "message": "daily-looking fallback text",
        "details": model_quota["error"]["details"],
    }}) == "rate-limit"
    daily_quota = {"error": {"details": [{
        "@type": "type.googleapis.com/google.rpc.QuotaFailure",
        "violations": [{"quotaId": "GenerateRequestsPerModelPerDay",
                         "quotaDimensions": {"model": "gemini-test"}}],
    }]}}
    assert upstream_quota_period(daily_quota) == "daily-quota"
    assert 1 <= seconds_until_pacific_midnight() <= 86_400
    with tempfile.TemporaryDirectory(prefix="sandcodex-gemini-cooldown-") as directory:
        ledger = Cooldowns(Path(directory, "cooldowns.json"))
        ledger.record("pairs", "0123456789ab:gemini-test", 2, "fixture")
        assert not ledger.available("0123456789ab", "gemini-test", ignore=False)
        delay = ledger.next_delay(["0123456789ab"], ["gemini-test"], ignore=False)
        assert delay is not None and 1 <= delay <= 2
        assert ledger.next_delay(["fedcba987654"], ["gemini-test"], ignore=False) == 0

        # Independent adapter processes share one least-scheduled account
        # ledger. Five simultaneous rooms therefore do not all begin on the
        # first credential merely because each process has a fresh memory
        # cursor.
        scheduler_keys = [
            "000000000001", "000000000002", "000000000003",
            "000000000004", "000000000005",
        ]
        second_process = Cooldowns(Path(directory, "cooldowns.json"))
        assigned = [
            (ledger if index % 2 == 0 else second_process).assign_start_key(scheduler_keys)
            for index in range(6)
        ]
        assert assigned == [*scheduler_keys, scheduler_keys[0]]
        shared_status = second_process.scheduler_status(scheduler_keys)
        assert shared_status["assignments"] == 6
        assert shared_status["next_key_id"] == scheduler_keys[1]
        assert shared_status["assignments_by_key"] == {
            scheduler_keys[0]: 2,
            scheduler_keys[1]: 1,
            scheduler_keys[2]: 1,
            scheduler_keys[3]: 1,
            scheduler_keys[4]: 1,
        }
        ledger.record("keys", scheduler_keys[1], 60, "fixture-cooling")
        assert ledger.assign_start_key(
            scheduler_keys, ["gemini-test"], ignore=False) == scheduler_keys[2]
        ledger.record_success("gemini-test", scheduler_keys[1])

        # A successful forced probe or --ignore-cooldowns request is positive
        # health evidence. Clear only the proven key, model, and exact pair so
        # recovered routes rejoin service without erasing unrelated pressure.
        healed_key = scheduler_keys[0]
        ledger.record("keys", healed_key, 60, "fixture-auth")
        ledger.record("models", "gemini-healed", 60, "fixture-model")
        ledger.record("pairs", f"{healed_key}:gemini-healed", 60, "fixture-pair")
        assert ledger.record_success("gemini-healed", healed_key) == 3
        assert ledger.available(healed_key, "gemini-healed", ignore=False)
        assert not ledger.available("0123456789ab", "gemini-test", ignore=False)

        # A successful request may overlap another request or adapter process
        # that records newer pressure for the same route. The older success
        # must not erase that causally newer evidence.
        concurrent_key = "000000000005"
        concurrent_model = "gemini-concurrent"
        attempt_started = dt.datetime.now(dt.timezone.utc)
        ledger.record(
            "pairs", f"{concurrent_key}:{concurrent_model}", 60,
            "fixture-concurrent-failure")
        assert ledger.record_success(
            concurrent_model, concurrent_key, attempt_started) == 0
        assert not ledger.available(
            concurrent_key, concurrent_model, ignore=False)

        # Trusted router state fails closed. A corrupt schema cannot silently
        # become an empty cooldown map, and a hardlinked coordination lock
        # cannot split independent writers across aliases.
        corrupt_path = Path(directory, "corrupt-cooldowns.json")
        corrupt_path.write_text('{"schema":"unexpected"}\n', encoding="utf-8")
        corrupt_path.chmod(0o600)
        try:
            Cooldowns(corrupt_path).available(healed_key, "gemini-test", ignore=False)
        except AdapterError as error:
            assert error.code == "unsafe_state"
        else:
            raise AssertionError("corrupt Gemini cooldown schema did not fail closed")
        hardlink_path = Path(directory, "hardlink-cooldowns.json")
        hardlink_lock = hardlink_path.with_name(hardlink_path.name + ".lock")
        hardlink_alias = Path(directory, "hardlink-lock-alias")
        hardlink_lock.touch(mode=0o600)
        os.link(hardlink_lock, hardlink_alias)
        try:
            Cooldowns(hardlink_path).assign_start_key(scheduler_keys)
        except AdapterError as error:
            assert error.code == "unsafe_state"
        else:
            raise AssertionError("hardlinked Gemini cooldown lock was accepted")
        hardlink_alias.unlink()

        # v8 and earlier stored quota failures as global model cooldowns,
        # which would mask healthy routes on every newly rotating account.
        # Current readers ignore that finite legacy shape, the adapter repairs
        # it on its first locked read, and genuine model failures survive.
        legacy_path = Path(directory, "legacy-cooldowns.json")
        future = (dt.datetime.now(dt.timezone.utc) + dt.timedelta(hours=1)).strftime(
            "%Y-%m-%dT%H:%M:%SZ")
        atomic_private_json(legacy_path, {
            "schema": COOLDOWN_SCHEMA, "keys": {}, "pairs": {},
            "models": {
                "gemini-legacy-quota": {
                    "until": future, "reason": "daily-quota",
                    "recorded_at": utc_now(),
                },
                "gemini-genuinely-unavailable": {
                    "until": future, "reason": "model-unavailable",
                    "recorded_at": utc_now(),
                },
            },
        })
        legacy = Cooldowns(legacy_path)
        assert legacy.available("0123456789ab", "gemini-legacy-quota", ignore=False)
        assert not legacy.available(
            "0123456789ab", "gemini-genuinely-unavailable", ignore=False)
        repaired = json.loads(legacy_path.read_text(encoding="utf-8"))
        assert "gemini-legacy-quota" not in repaired["models"]
        assert "gemini-genuinely-unavailable" in repaired["models"]
        assert legacy.legacy_model_quota_repairs == 1
        assert repaired["route_events"][-1]["event"] == "cooldown-repair"
        repaired_mtime = legacy_path.stat().st_mtime_ns
        assert legacy.available("fedcba987654", "gemini-legacy-quota", ignore=False)
        assert legacy_path.stat().st_mtime_ns == repaired_mtime

    # Prove the in-request scheduler retries a fully buffered interaction after
    # a route cooldown without sleeping during startup self-tests.
    with tempfile.TemporaryDirectory(prefix="sandcodex-gemini-runtime-") as directory:
        root = Path(directory)
        fake_key = "AIza" + "A" * 32
        fake_key_id = hashlib.sha256(fake_key.encode()).hexdigest()[:12]
        credential = root / "credential"
        token_file = root / "token"
        config_file = root / "config.json"
        credential.write_text(fake_key, encoding="utf-8")
        token_file.write_text("t" * 64, encoding="utf-8")
        config_file.write_text(json.dumps({
            "schema": CONFIG_SCHEMA,
            "api_base": "https://generativelanguage.googleapis.com/v1",
            "routing_model": "route",
            "auto": True,
            "free_only": True,
            "allow_native_search": False,
            "ignore_cooldowns": False,
