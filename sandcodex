+static bool sandcodex_keyboard_recipient_exact(
+		struct wlr_seat_client *client, uintptr_t expected_resource_address,
+		uint32_t expected_resource_id, uintptr_t *resource_address_out,
+		uint32_t *resource_id_out) {
+	if (resource_address_out) {
+		*resource_address_out = 0;
+	}
+	if (resource_id_out) {
+		*resource_id_out = 0;
+	}
+	if (!client || !client->client ||
+			(expected_resource_address == 0) != (expected_resource_id == 0)) {
+		return false;
+	}
+
+	struct wl_resource *resource = NULL;
+	struct wl_resource *recipient = NULL;
+	uint32_t recipient_id = 0;
+	size_t live_count = 0;
+	wl_resource_for_each(resource, &client->keyboards) {
+		void *owner = wl_resource_get_user_data(resource);
+		if (!owner) {
+			continue;
+		}
+		uint32_t id = wl_resource_get_id(resource);
+		if (owner != client || wl_resource_get_client(resource) != client->client ||
+				id == 0 || ++live_count != 1) {
+			return false;
+		}
+		recipient = resource;
+		recipient_id = id;
+	}
+	if (live_count != 1 || !recipient ||
+			(expected_resource_address != 0 &&
+				(uintptr_t)recipient != expected_resource_address) ||
+			(expected_resource_id != 0 && recipient_id != expected_resource_id)) {
+		return false;
+	}
+	if (resource_address_out) {
+		*resource_address_out = (uintptr_t)recipient;
+	}
+	if (resource_id_out) {
+		*resource_id_out = recipient_id;
+	}
+	return true;
+}
