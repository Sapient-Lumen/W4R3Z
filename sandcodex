sc_prepare_jail_profile() {
  local data_root=$1 name=$2
  shift 2
  local profile="$data_root/profiles/$name" command path target root cert literal_rest literal_root
  local closure_sha commands_sha command_links_sha closure_count
  local -a roots=()
  local -A seen_roots=()
  mkdir -p -- "$profile/bin"
  chmod 700 -- "$profile" "$profile/bin"
  for command in "$@"; do
    path=$(type -P "$command" 2>/dev/null || true)
    [[ -n $path && -x $path ]] || sc_jail_fatal "inner-jail $name profile is missing $command"
    target=$(readlink -f -- "$path")
    [[ -x $target ]] || sc_jail_fatal "inner-jail $name command is invalid: $command"
    ln -s -- "$path" "$profile/bin/$command"
    case "$path" in
      /nix/store/*)
        literal_rest=${path#/nix/store/}
        literal_root="/nix/store/${literal_rest%%/*}"
        if [[ -z ${seen_roots[$literal_root]:-} ]]; then
          seen_roots[$literal_root]=1
          roots+=("$literal_root")
        fi
        ;;
    esac
    root=$(sc_jail_store_root "$path")
    if [[ -n $root && -z ${seen_roots[$root]:-} ]]; then
      seen_roots[$root]=1
      roots+=("$root")
    fi
  done
  for path in "$SC_LANDRUN" "$SC_SOCAT" "$(type -P bash)" "$(type -P python3)" "$data_root/seccomp-exec"; do
    root=$(sc_jail_store_root "$path")
    if [[ -n $root && -z ${seen_roots[$root]:-} ]]; then
      seen_roots[$root]=1
      roots+=("$root")
    fi
  done
  while IFS= read -r path; do
    root=$(sc_jail_store_root "$path")
    if [[ -n $root && -z ${seen_roots[$root]:-} ]]; then
      seen_roots[$root]=1
      roots+=("$root")
    fi
  done < <(ldd "$data_root/seccomp-exec" 2>/dev/null | sed -n 's/.*=> \(\/nix\/store\/[^ ]*\).*/\1/p; s/^[[:space:]]*\(\/nix\/store\/[^ ]*\).*/\1/p')
  cert=$(readlink -f -- "${NIX_SSL_CERT_FILE:-${SSL_CERT_FILE:-/etc/ssl/certs/ca-bundle.crt}}" 2>/dev/null || true)
  [[ -f $cert ]] || sc_jail_fatal 'inner-jail certificate bundle is unavailable'
  root=$(sc_jail_store_root "$cert")
  if [[ -n $root && -z ${seen_roots[$root]:-} ]]; then
    seen_roots[$root]=1
    roots+=("$root")
  fi
  printf '%s\n' "$cert" >"$data_root/certificate-path"
  printf '%s\n' "$@" | jq -Rsc 'split("\n")[:-1]' >"$profile/commands.json"
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && "${SANDCODEX_NO_NIX:-0}" == 1 ]]; then
    printf '%s\n' "${roots[@]}" | sed '/^$/d' | sort -u >"$profile/closure"
  else
    (( ${#roots[@]} )) || sc_jail_fatal "inner-jail $name profile has no Nix store roots"
    nix-store --query --requisites "${roots[@]}" | sort -u >"$profile/closure"
    [[ -s $profile/closure ]] || sc_jail_fatal "inner-jail $name closure is empty"
  fi
  closure_sha=$(sha256sum "$profile/closure"); closure_sha=${closure_sha%% *}
  commands_sha=$(sha256sum "$profile/commands.json"); commands_sha=${commands_sha%% *}
  command_links_sha=$(
    for command in "$@"; do
      printf '%s\t%s\n' "$command" "$(readlink -- "$profile/bin/$command")"
    done | sha256sum
  )
  command_links_sha=${command_links_sha%% *}
  closure_count=$(wc -l <"$profile/closure")
  jq -n --arg schema sand-jail.tool-profile-identity.v1 --arg profile "$name" \
    --arg closureSha "$closure_sha" --arg commandsSha "$commands_sha" \
    --arg linksSha "$command_links_sha" --argjson closureCount "$closure_count" \
    --argjson commandCount "$#" '{
      schema:$schema,profile:$profile,closure_sha256:$closureSha,
      commands_sha256:$commandsSha,command_links_sha256:$linksSha,
      closure_store_path_count:$closureCount,command_count:$commandCount
    }' >"$profile/identity.json"
  chmod 600 -- "$profile/commands.json" "$profile/closure" "$profile/identity.json"
}

