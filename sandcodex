    def call(self, name: str, arguments: dict[str, Any]) -> dict[str, Any]:
        handler = self._handlers().get(name)
        if handler is None:
            raise ToolError(f"unknown desktop tool: {name}")
        if not isinstance(arguments, dict):
            raise ToolError("tool arguments must be an object")
        non_mutating = {
            "desktop_state", "desktop_screenshot", "desktop_wait_for_screen", "desktop_observe",
            "desktop_audit", "desktop_accessibility", "desktop_accessibility_events", "desktop_accessibility_find",
            "desktop_accessibility_wait", "desktop_accessibility_at_point", "desktop_pointer",
            "desktop_windows", "desktop_processes", "desktop_wait", "desktop_clipboard_read",
        }
        if name == "desktop_accessibility_events":
            # This handler acquires the controller lock only around exact scope
            # validation and revalidation.  Its bounded condition-variable wait
            # must not monopolize all private-workstation control.
            return handler(arguments)
        if name == "desktop_state":
            # AT-SPI callbacks resolve launch origins under the controller
            # lock. Snapshot AT-SPI first to preserve a single lock order.
            accessibility = getattr(self, "accessibility", None)
            if accessibility is None:
                with self.lock:
                    return handler(arguments)
            accessibility_status = accessibility.status()
            compositor_event_status = (
                self.compositor_event_seal.status()
                if getattr(self, "compositor_event_seal", None) is not None
                else None
            )
            # This informational snapshot is not action authority. Its component
            # readers perform their own checks, while avoiding lock inversion
            # with AT-SPI origin callbacks and the Sway event reader.
            return handler({
                "_accessibility_status": accessibility_status,
                "_compositor_event_status": compositor_event_status,
            })
        with self.lock:
            if self.is_wayland and name not in non_mutating and name != "desktop_step":
                error = "private Wayland mutations require desktop_observe followed by desktop_step"
                self.journal.append("policy-denial", name, arguments, error=error)
                raise ToolError(error)
            try:
                result = handler(arguments)
            except Exception as error:
                if name not in non_mutating and name != "desktop_step":
                    self.journal.append("action", name, arguments, error=str(error))
                raise
            if name not in non_mutating and name != "desktop_step":
                self.journal.append("action", name, arguments, result)
            return result


