sc_gemini_models_dispatch() {
  local staged row path key_file key key_id key_label tmp response code result rc=0
  staged="$(sc_gemini_keybank_stage)"
  row="$(sc_gemini_keybank_pick "$staged")"
  [[ -n "$row" ]] || {
    sc_gemini_keybank_unstage "$staged"
    sc_die "Gemini key bank has no usable keys outside the cooldown ledger" 69
  }
  path="$(jq -r '.path' <<<"$staged")"
  key_file="$(jq -r '.credential_file' <<<"$row")"
  key_id="$(jq -r '.key_id' <<<"$row")"
  key_label="$(jq -r '.label' <<<"$row")"
  key="$(sc_gemini_read_key_file "$key_file")"
  tmp="$(mktemp -d "$SC_GLOBAL/runtime/.gemini.XXXXXX")"
  chmod 700 -- "$tmp"
  response="$tmp/models.json"
  code="$(sc_gemini_http GET "$SC_GEMINI_API_BASE/models" "" "$response" "$key" "$tmp")" || rc=$?
  if (( rc != 0 )); then
    rm -rf -- "$tmp"
    sc_gemini_keybank_unstage "$staged"
    sc_die "Gemini models request failed before HTTP response" 78
  fi
  result="$(jq -c \
    --arg schema sandcodex.gemini-models.v1 \
    --arg provider google-ai-studio \
    --arg key_source "$path" \
    --arg key_file "$path" \
    --arg key_id "$key_id" \
    --arg key_label "$key_label" \
    --arg http_code "$code" \
    --argjson free_models "$(sc_gemini_free_models_json)" \
    --argjson limit "$SC_GEMINI_LIMIT" \
    'if ($http_code == "200" and (.models|type)=="array") then
       (.models // []) as $all |
       (if $limit == 0 then $all else $all[:$limit] end) as $shown |
       {schema:$schema,result:"models",provider:$provider,key_file:$key_file,
        http_code:($http_code|tonumber),ok:true,count:($all|length),
        limit:(if $limit == 0 then null else $limit end),
        key_source:$key_source,key_id:$key_id,key_label:$key_label,
        credential_value_disclosed:false,
        raw_provider_content_disclosed:false,
        models:[$shown[] | {name:(.name|sub("^models/";"")),
          supported_generation_methods:(.supportedGenerationMethods // []),
          input_token_limit:.inputTokenLimit,
          output_token_limit:.outputTokenLimit,
          sandcodex_free_only_allowed:((.name|sub("^models/";"")) as $n |
            $free_models | index($n) != null)}]}
     else
       {schema:$schema,result:"models",provider:$provider,key_file:$key_file,
        http_code:($http_code|tonumber),ok:false,
        key_source:$key_source,key_id:$key_id,key_label:$key_label,
        credential_value_disclosed:false,raw_provider_content_disclosed:false,
        error:{code:(.error.code // null),status:(.error.status // "provider-error")}}
     end' "$response")" || {
    rm -rf -- "$tmp"
    sc_gemini_keybank_unstage "$staged"
    sc_die "Gemini models response was not valid JSON" 78
  }
  rm -rf -- "$tmp"
  sc_gemini_record_result_cooldowns "$result"
  sc_gemini_keybank_unstage "$staged"
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$result"
    [[ "$(jq -r '.ok' <<<"$result")" == true ]] || return 78
    return
  fi
  if [[ "$(jq -r '.ok' <<<"$result")" != true ]]; then
    printf 'gemini models: failed (HTTP %s)\n' "$(jq -r '.http_code' <<<"$result")"
    jq -r '.error | "  provider error class: " + ((.status // "unknown")|tostring) +
      (if .code == null then "" else " · code " + (.code|tostring) end)' <<<"$result"
    printf '  credential value: not disclosed · raw provider content: not printed\n'
    return 78
  fi
  printf 'Gemini models\n'
  printf '  result      READY · %s models available\n' "$(jq -r '.count' <<<"$result")"
  printf '  account     key %s\n' "$key_id"
  printf '  source      %s\n' "$path"
  printf '\nmodels\n'
  jq -r '.models[] |
    "  " + .name,
    "    methods     " + ((.supported_generation_methods // [])|join(", ")),
    "    free route  " + (if .sandcodex_free_only_allowed then "eligible" else "not eligible" end),
    "    tokens      " + ((.input_token_limit // "unknown")|tostring) + " input · " +
      ((.output_token_limit // "unknown")|tostring) + " output"' <<<"$result"
  printf '\nprivacy\n  Credential values and raw provider content are not printed.\n'
}

sc_gemini_probe_generate_content() {
  local key=$1 key_source=$2 key_id=$3 key_label=$4 model_slug=$5 tmp body response code result rc=0
  local model
  model="$(sc_gemini_model_resource "$model_slug")"
  tmp="$(mktemp -d "$SC_GLOBAL/runtime/.gemini.XXXXXX")"
  chmod 700 -- "$tmp"
  body="$tmp/probe.json"
  response="$tmp/probe-response.json"
  jq -n \
    --arg text 'Return exactly this line and no other text: sandcodex gemini ok' \
    '{contents:[{role:"user",parts:[{text:$text}]}],
      generationConfig:{temperature:0,maxOutputTokens:128}}' >"$body"
  code="$(sc_gemini_http POST "$SC_GEMINI_API_BASE/$model:generateContent" "$body" "$response" "$key" "$tmp")" || rc=$?
  if (( rc != 0 )); then
    rm -rf -- "$tmp"
    jq -cn \
      --arg schema sandcodex.gemini-probe.v1 \
      --arg provider google-ai-studio \
      --arg key_source "$key_source" \
      --arg key_id "$key_id" \
      --arg key_label "$key_label" \
      --arg model "$model_slug" \
      --argjson transport_exit "$rc" \
      '{schema:$schema,result:"probe",provider:$provider,probe_kind:"generate-content-text",
        key_source:$key_source,key_id:$key_id,key_label:$key_label,model:$model,
        http_code:0,ok:false,expected_text_observed:false,credential_value_disclosed:false,
        raw_provider_content_disclosed:false,error:{status:"transport",transport_exit:$transport_exit}}'
    return
  fi
  result="$(jq -c \
    --arg schema sandcodex.gemini-probe.v1 \
    --arg provider google-ai-studio \
    --arg key_source "$key_source" \
    --arg key_id "$key_id" \
    --arg key_label "$key_label" \
    --arg model "$model" \
    --arg http_code "$code" \
    'if ($http_code == "200") then
       ([.candidates[]?.content.parts[]?.text] | join("\n")) as $text |
       {schema:$schema,result:"probe",provider:$provider,probe_kind:"generate-content-text",
        key_source:$key_source,key_id:$key_id,key_label:$key_label,
        model:($model|sub("^models/";"")),
        http_code:($http_code|tonumber),
        ok:($text == "sandcodex gemini ok"),
        expected_text_observed:($text == "sandcodex gemini ok"),
        credential_value_disclosed:false,
        raw_provider_content_disclosed:false,
        usage_metadata:(.usageMetadata // null),
        finish_reasons:[.candidates[]?.finishReason]}
     else
       {schema:$schema,result:"probe",provider:$provider,probe_kind:"generate-content-text",
        key_source:$key_source,key_id:$key_id,key_label:$key_label,
        model:($model|sub("^models/";"")),
        http_code:($http_code|tonumber),ok:false,expected_text_observed:false,
        credential_value_disclosed:false,raw_provider_content_disclosed:false,
        error:{code:(.error.code // null),status:(.error.status // "provider-error")}}
     end' "$response")" || {
    rm -rf -- "$tmp"
    jq -cn \
      --arg schema sandcodex.gemini-probe.v1 \
      --arg provider google-ai-studio \
      --arg key_source "$key_source" \
      --arg key_id "$key_id" \
      --arg key_label "$key_label" \
      --arg model "$model_slug" \
      '{schema:$schema,result:"probe",provider:$provider,probe_kind:"generate-content-text",
        key_source:$key_source,key_id:$key_id,key_label:$key_label,model:$model,
        http_code:0,ok:false,credential_value_disclosed:false,
        raw_provider_content_disclosed:false,error:{status:"invalid-response"}}'
    return
  }
  rm -rf -- "$tmp"
  printf '%s\n' "$result"
}

sc_gemini_probe_dispatch() {
  local staged row path key_file key key_id key_label model_slug result
  model_slug="$(sc_gemini_model_slug "$SC_GEMINI_MODEL")"
  sc_gemini_require_free_model "$model_slug"
  staged="$(sc_gemini_keybank_stage)"
  row="$(sc_gemini_keybank_pick "$staged")"
  [[ -n "$row" ]] || {
    sc_gemini_keybank_unstage "$staged"
    sc_die "Gemini key bank has no usable keys outside the cooldown ledger" 69
  }
  path="$(jq -r '.path' <<<"$staged")"
  key_file="$(jq -r '.credential_file' <<<"$row")"
  key_id="$(jq -r '.key_id' <<<"$row")"
  key_label="$(jq -r '.label' <<<"$row")"
  key="$(sc_gemini_read_key_file "$key_file")"
  result="$(sc_gemini_probe_generate_content "$key" "$path" "$key_id" "$key_label" "$model_slug")"
  sc_gemini_record_result_cooldowns "$result"
  sc_gemini_keybank_unstage "$staged"
  if (( SC_GEMINI_JSON )); then
    printf '%s\n' "$result"
    [[ "$(jq -r '.ok' <<<"$result")" == true ]] || return 78
    return
  fi
  if [[ "$(jq -r '.ok' <<<"$result")" != true ]]; then
    printf 'gemini probe: failed · model %s · HTTP %s\n' \
      "$(jq -r '.model' <<<"$result")" "$(jq -r '.http_code' <<<"$result")"
    if jq -e '.error' <<<"$result" >/dev/null; then
      jq -r '.error | "  provider error class: " + ((.status // "unknown")|tostring) +
        (if .code == null then "" else " · code " + (.code|tostring) end) +
        (if .transport_exit == null then "" else " · transport exit " + (.transport_exit|tostring) end)' <<<"$result"
    else
      printf '  expected probe text was not observed\n'
      jq -r '.finish_reasons[]? | "  finish: " + .' <<<"$result"
    fi
    printf '  credential value: not disclosed · raw provider content: not printed\n'
    return 78
  fi
  printf 'gemini probe: passed\n'
  printf '  model: %s · HTTP %s\n' "$(jq -r '.model' <<<"$result")" "$(jq -r '.http_code' <<<"$result")"
  jq -r '.usage_metadata as $u |
    if $u then
      "  tokens: prompt=" + (($u.promptTokenCount // "unknown")|tostring) +
      " · output=" + (($u.candidatesTokenCount // "unknown")|tostring) +
      " · thoughts=" + (($u.thoughtsTokenCount // 0)|tostring) +
      " · total=" + (($u.totalTokenCount // "unknown")|tostring)
    else "  tokens: unavailable" end' <<<"$result"
  printf '  expected text observed: yes\n'
  printf '  credential value: not disclosed · raw provider content: not printed\n'
}

