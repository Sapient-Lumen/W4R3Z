sc_start_desktop_proxy_bridge() {
  (( SC_DESKTOP )) || return 0
  if [[ "${SANDCODEX_TESTING:-0}" == 1 && -n "${SANDCODEX_TEST_DESKTOP_OWNER_SERVICE:-}" ]]; then
    return 0
  fi
  [[ -S "$SC_PROXY_SOCKET" && ! -L "$SC_PROXY_SOCKET" ]] || return 1
  rm -f -- "$SC_DESKTOP_PROXY_SOCKET"
  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SOCAT" \
      "UNIX-LISTEN:$SC_DESKTOP_PROXY_SOCKET,fork,mode=0600" "UNIX-CONNECT:$SC_PROXY_SOCKET"
  ) >>"$SC_RUN_ROOT/desktop-proxy.log" 2>&1 & SC_DESKTOP_PROXY_PID=$!
  SC_DESKTOP_PROXY_START="$(sc_process_start "$SC_DESKTOP_PROXY_PID")" || return 1
  local ready=0
  for _ in {1..100}; do
    sc_pid_still_matches "$SC_DESKTOP_PROXY_PID" "$SC_DESKTOP_PROXY_START" || break
    if [[ -S "$SC_DESKTOP_PROXY_SOCKET" && ! -L "$SC_DESKTOP_PROXY_SOCKET" && \
      "$(stat -c %u:%a -- "$SC_DESKTOP_PROXY_SOCKET" 2>/dev/null || true)" == "$(id -u):600" ]]; then
      ready=1; break
    fi
    sleep 0.02
  done
  (( ready )) || return 1
}

sc_start_desktop_outer_x11_display() {
  (( SC_DESKTOP )) && [[ "$SC_DESKTOP_DISPLAY_BACKEND" == xvfb ]] || return 0
  [[ -z "$SC_DESKTOP_DISPLAY_PID" ]] || return 0
  local launch="$SC_RUN_ROOT/desktop-launch" relay="$SC_JAIL_RELAY_ROOT/desktop-display"
  local display_file="$SC_RUN_ROOT/desktop-launch/display-number" cookie number attempt seed title
  local xauthority="$SC_RUN_ROOT/desktop-launch/nested.xauthority"
  mkdir -p -- "$relay"
  chmod 700 -- "$relay"
  [[ -d "$relay" && ! -L "$relay" && \
    "$(stat -c %u:%a -- "$relay" 2>/dev/null || true)" == "$(id -u):700" ]] || return 1
  [[ -z "$(find "$relay" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]] || return 1
  [[ ! -e "$xauthority" && ! -L "$xauthority" && ! -e "$display_file" && ! -L "$display_file" ]] || return 1
  cookie="$("$SC_MCOOKIE")"
  [[ "$cookie" =~ ^[0-9a-fA-F]{32}$ ]] || return 1
  seed="$(mktemp "$launch/.nested-xauthority.XXXXXX")" || return 1
  chmod 600 -- "$seed"
  if ! ln -- "$seed" "$xauthority" 2>/dev/null; then rm -f -- "$seed"; return 1; fi
  rm -f -- "$seed"
  [[ -f "$xauthority" && ! -L "$xauthority" && \
    "$(stat -c %u:%a:%h -- "$xauthority" 2>/dev/null || true)" == "$(id -u):600:1" ]] || return 1
  "$SC_XAUTH" -f "$xauthority" add :99 . "$cookie" >/dev/null 2>&1 || return 1
  seed="$(mktemp "$launch/.display-number.XXXXXX")" || return 1
  chmod 600 -- "$seed"
  if ! ln -- "$seed" "$display_file" 2>/dev/null; then rm -f -- "$seed"; return 1; fi
  rm -f -- "$seed"
  [[ -f "$display_file" && ! -L "$display_file" && \
    "$(stat -c %u:%a:%h -- "$display_file" 2>/dev/null || true)" == "$(id -u):600:1" ]] || return 1
  if (( SC_HEADFUL )); then
    [[ -n "$SC_BROWSER_HOST_DISPLAY" && -n "$SC_BROWSER_HOST_XAUTHORITY" ]] || {
      sc_err "--headful requires a usable local X11/Xwayland display and Xauthority file"
      return 1
    }
    title="Sandcodex shared desktop · HUMAN + AGENT INPUT LIVE · $(basename -- "$SC_PROJECT")"
    sc_note "opening shared Sandcodex desktop · human and agent input are both live"
    (
      sc_close_inherited_fds 3
      exec env -i PATH="$SC_PATH" DISPLAY="$SC_BROWSER_HOST_DISPLAY" \
        XAUTHORITY="$SC_BROWSER_HOST_XAUTHORITY" \
        "$SC_SETPRIV" --pdeathsig TERM "$SC_XEPHYR" -displayfd 3 \
        -auth "$xauthority" -screen "${SC_DESKTOP_WIDTH}x${SC_DESKTOP_HEIGHT}" \
        -title "$title" -nolisten tcp -noreset -no-host-grab
    ) 3>"$display_file" >>"$SC_RUN_ROOT/desktop-display.log" 2>&1 & SC_DESKTOP_DISPLAY_PID=$!
  else
    (
      sc_close_inherited_fds 3
      exec "$SC_SETPRIV" --pdeathsig TERM "$SC_XVFB" -displayfd 3 \
        -auth "$xauthority" -screen 0 "${SC_DESKTOP_WIDTH}x${SC_DESKTOP_HEIGHT}x24" \
        -nolisten tcp -noreset
    ) 3>"$display_file" >>"$SC_RUN_ROOT/desktop-display.log" 2>&1 & SC_DESKTOP_DISPLAY_PID=$!
  fi
  SC_DESKTOP_DISPLAY_START="$(sc_process_start "$SC_DESKTOP_DISPLAY_PID" 2>/dev/null || true)"
  if [[ ! "$SC_DESKTOP_DISPLAY_START" =~ ^[0-9]+$ ]]; then
    sed -n '1,80p' "$SC_RUN_ROOT/desktop-display.log" >&2 2>/dev/null || true
    return 1
  fi
  for (( attempt=0; attempt<150; attempt++ )); do
    [[ -s "$display_file" ]] && break
    sc_pid_still_matches "$SC_DESKTOP_DISPLAY_PID" "$SC_DESKTOP_DISPLAY_START" || break
    sleep 0.02
  done
  number="$(tr -d '[:space:]' <"$display_file" 2>/dev/null || true)"
  if [[ ! "$number" =~ ^[0-9]+$ || ! -S "/tmp/.X11-unix/X$number" || \
    -L "/tmp/.X11-unix/X$number" || \
    "$(stat -c %u:%h -- "/tmp/.X11-unix/X$number" 2>/dev/null || true)" != "$(id -u):1" ]]; then
    sed -n '1,80p' "$SC_RUN_ROOT/desktop-display.log" >&2 2>/dev/null || true
    return 1
  fi
  "$SC_XAUTH" -f "$xauthority" add ":$number" . "$cookie" >/dev/null 2>&1 || {
    sc_err "could not authorize the outer-owned desktop display"; return 1;
  }
  (
    sc_close_inherited_fds
    exec "$SC_SETPRIV" --pdeathsig TERM "$SC_SOCAT" \
      "UNIX-LISTEN:$relay/X99,fork,mode=0600" "UNIX-CONNECT:/tmp/.X11-unix/X$number"
  ) >>"$SC_RUN_ROOT/desktop-display.log" 2>&1 & SC_DESKTOP_DISPLAY_RELAY_PID=$!
  SC_DESKTOP_DISPLAY_RELAY_START="$(sc_process_start "$SC_DESKTOP_DISPLAY_RELAY_PID" 2>/dev/null || true)"
  [[ "$SC_DESKTOP_DISPLAY_RELAY_START" =~ ^[0-9]+$ ]] || {
    sed -n '1,80p' "$SC_RUN_ROOT/desktop-display.log" >&2 2>/dev/null || true; return 1;
  }
  for (( attempt=0; attempt<100; attempt++ )); do
    [[ -S "$relay/X99" ]] && break
    sc_pid_still_matches "$SC_DESKTOP_DISPLAY_RELAY_PID" "$SC_DESKTOP_DISPLAY_RELAY_START" || break
    sleep 0.02
  done
  if [[ ! -S "$relay/X99" || -L "$relay/X99" || \
    "$(stat -c %u:%a:%h -- "$relay/X99" 2>/dev/null || true)" != "$(id -u):600:1" ]]; then
