+static bool sandcodex_capture_tablet_pad_strip_target(
+        struct ipc_client *client, struct sway_seat *seat, double x, double y,
+        struct sandcodex_hit_target *target, struct sway_view **view_out,
+        struct wlr_surface **view_surface_out,
+        struct wlr_surface **target_surface_out,
+        struct wlr_seat_client **pointer_client_out,
+        struct wl_client **target_client_out,
+        uintptr_t expected_pointer_grab_address,
+        uintptr_t expected_pointer_default_grab_address,
+        uintptr_t expected_pointer_client_address) {
+    return sandcodex_tablet_pad_idle() &&
+        sandcodex_capture_stylus_target(client, seat, x, y, target, view_out,
+            view_surface_out, target_surface_out, pointer_client_out,
+            target_client_out, NULL, NULL, expected_pointer_grab_address,
+            expected_pointer_default_grab_address,
+            expected_pointer_client_address);
