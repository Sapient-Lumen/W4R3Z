#include <sys/stat.h>
#include <sys/un.h>
#include <unistd.h>

#include <wayland-client.h>
#include "security-context-v1-client-protocol.h"

static volatile sig_atomic_t stopped = 0;
static struct wp_security_context_manager_v1 *manager = NULL;

static void on_signal(int signo) {
    (void)signo;
    stopped = 1;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    (void)data;
    (void)version;
    if (strcmp(interface, wp_security_context_manager_v1_interface.name) == 0) {
        manager = wl_registry_bind(registry, name,
            &wp_security_context_manager_v1_interface, 1);
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    (void)data;
    (void)registry;
    (void)name;
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

static int fail(const char *message) {
    fprintf(stderr, "sandcodex-wayland-context: %s: %s\n", message, strerror(errno));
    return 1;
}

static int write_ready(const char *path) {
    char temporary[4096];
    int length = snprintf(temporary, sizeof(temporary), "%s.%ld.tmp", path, (long)getpid());
    if (length < 0 || (size_t)length >= sizeof(temporary)) {
        errno = ENAMETOOLONG;
        return -1;
    }
    int fd = open(temporary, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
    if (fd < 0) {
        return -1;
    }
    const char payload[] = "ready\n";
    ssize_t written = write(fd, payload, sizeof(payload) - 1);
    int saved = 0;
    if (written != (ssize_t)(sizeof(payload) - 1)) {
        saved = written < 0 ? errno : EIO;
    } else if (fsync(fd) < 0) {
        saved = errno;
    }
    if (close(fd) < 0 && saved == 0) {
        saved = errno;
    }
    if (saved != 0) {
        unlink(temporary);
        errno = saved;
        return -1;
    }
    if (rename(temporary, path) < 0) {
        saved = errno;
        unlink(temporary);
        errno = saved;
        return -1;
    }
    return 0;
}

int main(int argc, char **argv) {
    if (argc != 5) {
        fprintf(stderr, "usage: %s SOCKET READY APP_ID INSTANCE_ID\n", argv[0]);
        return 64;
    }
    const char *socket_path = argv[1];
    const char *ready_path = argv[2];
    const char *app_id = argv[3];
    const char *instance_id = argv[4];
    if (strlen(socket_path) >= sizeof(((struct sockaddr_un *)0)->sun_path)) {
        errno = ENAMETOOLONG;
        return fail("socket path is too long");
    }

    struct sigaction action = {0};
    action.sa_handler = on_signal;
    sigemptyset(&action.sa_mask);
    if (sigaction(SIGTERM, &action, NULL) < 0 ||
            sigaction(SIGINT, &action, NULL) < 0 ||
            sigaction(SIGHUP, &action, NULL) < 0) {
        return fail("could not install signal handlers");
    }

    unlink(socket_path);
    unlink(ready_path);
    int listener = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
    if (listener < 0) {
        return fail("could not create listener");
    }
    struct sockaddr_un address = {0};
    address.sun_family = AF_UNIX;
    memcpy(address.sun_path, socket_path, strlen(socket_path) + 1);
    if (bind(listener, (struct sockaddr *)&address, sizeof(address)) < 0 ||
            chmod(socket_path, 0600) < 0 || listen(listener, 64) < 0) {
        int result = fail("could not prepare listener");
        close(listener);
        unlink(socket_path);
        return result;
    }

    int close_pipe[2];
    if (pipe2(close_pipe, O_CLOEXEC) < 0) {
        int result = fail("could not create close pipe");
        close(listener);
        unlink(socket_path);
        return result;
    }
    struct wl_display *display = wl_display_connect(NULL);
    if (display == NULL) {
        int result = fail("could not connect to controller Wayland display");
        close(close_pipe[0]); close(close_pipe[1]); close(listener); unlink(socket_path);
        return result;
    }
    struct wl_registry *registry = wl_display_get_registry(display);
    if (registry == NULL || wl_registry_add_listener(registry, &registry_listener, NULL) < 0 ||
            wl_display_roundtrip(display) < 0 || manager == NULL) {
        errno = EPROTO;
        int result = fail("security-context-v1 is unavailable");
        if (registry != NULL) wl_registry_destroy(registry);
        wl_display_disconnect(display);
        close(close_pipe[0]); close(close_pipe[1]); close(listener); unlink(socket_path);
        return result;
    }

    struct wp_security_context_v1 *context =
        wp_security_context_manager_v1_create_listener(manager, listener, close_pipe[0]);
    if (context == NULL) {
        errno = EPROTO;
        int result = fail("could not create security context");
        wp_security_context_manager_v1_destroy(manager);
        wl_registry_destroy(registry);
        wl_display_disconnect(display);
        close(close_pipe[0]); close(close_pipe[1]); close(listener); unlink(socket_path);
        return result;
    }
    wp_security_context_v1_set_sandbox_engine(context, "org.openai.sandcodex");
    wp_security_context_v1_set_app_id(context, app_id);
    wp_security_context_v1_set_instance_id(context, instance_id);
    wp_security_context_v1_commit(context);
    if (wl_display_roundtrip(display) < 0) {
        errno = EPROTO;
        int result = fail("compositor rejected security context");
        wp_security_context_v1_destroy(context);
        wp_security_context_manager_v1_destroy(manager);
        wl_registry_destroy(registry);
        wl_display_disconnect(display);
        close(close_pipe[0]); close(close_pipe[1]); close(listener); unlink(socket_path);
        return result;
    }
    close(listener);
    close(close_pipe[0]);
    if (write_ready(ready_path) < 0) {
        int result = fail("could not publish readiness");
        close(close_pipe[1]);
        wp_security_context_v1_destroy(context);
        wp_security_context_manager_v1_destroy(manager);
        wl_registry_destroy(registry);
        wl_display_disconnect(display);
        unlink(socket_path);
        return result;
    }

    while (!stopped) {
        pause();
    }
    unlink(ready_path);
    close(close_pipe[1]);
    wp_security_context_v1_destroy(context);
    wp_security_context_manager_v1_destroy(manager);
    wl_registry_destroy(registry);
    wl_display_disconnect(display);
    unlink(socket_path);
    return 0;
}
SANDCODEX_WAYLAND_CONTEXT_C
}

sc_emit_private_notification_service() {
  cat <<'SANDCODEX_PRIVATE_NOTIFICATION_SERVICE'
#!/usr/bin/env python3
"""Launch-private Freedesktop notification service for Sandcodex GUI capsules.

The service owns ``org.freedesktop.Notifications`` only on one launch-private
session bus.  It renders bounded plain-text notifications and action buttons in
one native GTK window connected through the exact launch's restricted Wayland
principal.  Its compositor app-id includes a controller-generated 128-bit
capability delivered through a helper-only exact-byte startup file; the application never
receives that identifier.  It never reaches the host notification daemon, host session bus,
host compositor, host icon theme paths, audio service, or desktop shell.

Notification text and action labels are untrusted application output.  The
service deliberately advertises only ``actions`` and ``body``: icons, markup,
hyperlinks, images, sound, persistence claims, activation tokens, and host-side
application activation are absent.  Signals are directed to the exact private
D-Bus sender that created the notification, replacement is same-sender only,
and owner loss synchronously destroys that sender's retained notifications.
"""
from __future__ import annotations

import argparse
import ctypes
import json
import os
import re
import resource
import signal
import stat
import sys
import unicodedata
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, Iterable, Mapping


PROTOCOL = "sandcodex.private-notification-service.v1"
SELF_TEST_SCHEMA = "sandcodex.private-notification-service-self-test.v1"
BUS_NAME = "org.freedesktop.Notifications"
