        self.context_root = context_root
        self.atspi_proxy = atspi_proxy
        self.atspi_address = atspi_address
        self.pointer_agent = pointer_agent
        self.keyboard_agent = keyboard_agent
        self.input_method_agent = input_method_agent
        self.clipboard_agent = clipboard_agent
        self.selection_agent = selection_agent
        self.drop_agent = drop_agent
        self.drop_root = drop_root.resolve(strict=True) if drop_root is not None else None
