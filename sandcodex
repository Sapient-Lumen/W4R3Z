        if max(0, count - 1) * interval > MAX_ACTION_SECONDS:
            raise ToolError("guarded click sequence exceeds the action runtime limit")
        evidence = self._run_pointer_unit_fence(
            "desktop_click",
            route,
            list(range(count)),
