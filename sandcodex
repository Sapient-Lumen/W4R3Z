    def _controller_environment(
        self,
        environment_overrides: dict[str, str] | None = None,
    ) -> dict[str, str]:
        environment = {
            key: value for key, value in os.environ.items()
            if key in {"PATH", "HOME", "LANG", "LC_ALL", "XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "SWAYSOCK", "DISPLAY", "XAUTHORITY"}
        }
        if environment_overrides:
            for key, value in environment_overrides.items():
                if key not in {"WAYLAND_DISPLAY", "DISPLAY", "XAUTHORITY"} or not isinstance(value, str) or "\x00" in value:
                    raise ToolError("invalid private controller environment override")
                environment[key] = value
        return environment

    def _run_controller(
        self,
        argv: list[str],
        *,
        input_bytes: bytes | None = None,
        timeout: float = 10.0,
        text: bool = False,
        environment_overrides: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[Any]:
        environment = self._controller_environment(environment_overrides)
        try:
            completed = subprocess.run(
                argv,
                input=input_bytes,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
                check=False,
                env=environment,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ToolError(f"private desktop controller command failed: {error}") from error
        if completed.returncode != 0:
            diagnostic = completed.stderr.decode("utf-8", "replace")[:2048]
            raise ToolError(f"private desktop controller command exited {completed.returncode}: {diagnostic}")
        if text:
            completed.stdout = completed.stdout.decode("utf-8", "replace")  # type: ignore[assignment]
            completed.stderr = completed.stderr.decode("utf-8", "replace")  # type: ignore[assignment]
        return completed

    def _sway_json(self, message_type: str) -> Any:
        completed = self._run_controller([self.commands["swaymsg"], "-r", "-t", message_type], timeout=5)
        try:
            return json.loads(completed.stdout)
        except json.JSONDecodeError as error:
            raise ToolError(f"Sway returned invalid {message_type} JSON") from error

    def _sway_command(self, command: str) -> None:
        completed = self._run_controller([self.commands["swaymsg"], "-r", "--", command], timeout=5)
        try:
            replies = json.loads(completed.stdout)
        except json.JSONDecodeError as error:
            raise ToolError("Sway returned an invalid command reply") from error
        if not isinstance(replies, list) or not replies or any(not isinstance(item, dict) or item.get("success") is not True for item in replies):
            raise ToolError(f"Sway rejected desktop command: {replies!r}")

    @staticmethod
    def _launch_workspace_name(launch_id: str) -> str:
        if re.fullmatch(r"launch-[0-9a-f]{24}", launch_id) is None:
            raise ToolError("launch_id cannot be represented as a private compositor workspace")
        return LAUNCH_WORKSPACE_PREFIX + launch_id.removeprefix("launch-")

    @staticmethod
    def _scene_id(value: Any, *, required: bool = False) -> str | None:
        if value is None:
            if required:
                raise ToolError("scene_id is required")
            return None
        scene_id = as_string(
            value, "scene_id", maximum=MAX_SCENE_ID_BYTES, allow_empty=False
        )
        if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", scene_id) is None:
            raise ToolError(
                "scene_id must be a bounded alphanumeric name using only dot, underscore, or hyphen"
            )
        return scene_id

    @staticmethod
    def _scene_workspace_name(scene_id: str) -> str:
        normalized = DesktopController._scene_id(scene_id, required=True)
        assert normalized is not None
        digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:24]
        return SCENE_WORKSPACE_PREFIX + digest

    @staticmethod
    def _launch_sway_criteria(application_id: str, launch_id: str) -> str:
        # application_id is already restricted to a bounded reverse-DNS-style
        # alphabet and launch_id is generated from lowercase hexadecimal. Sway
        # criteria values are PCRE2 expressions, so quote every metacharacter and
        # anchor each field to prevent prefix/substring authority confusion.
        engine = re.escape(SANDBOX_ENGINE)
        app = re.escape(application_id)
        instance = re.escape(launch_id)
        return (
            f'[sandbox_engine="^{engine}$" '
            f'sandbox_app_id="^{app}$" '
            f'sandbox_instance_id="^{instance}$"]'
        )

    def _register_launch_workspace(
        self,
        application_id: str,
        launch_id: str,
        workspace: str | None = None,
    ) -> str:
        workspace = workspace or self._launch_workspace_name(launch_id)
        if re.fullmatch(r"sc-(?:launch|scene)-[0-9a-f]{24}", workspace) is None:
            raise ToolError("private compositor workspace identity is invalid")
        criteria = self._launch_sway_criteria(application_id, launch_id)
        # Runtime assignments apply to future matching native Wayland windows.
        # no_focus prevents a background application from stealing the active
        # workstation workspace before an explicit launch-scoped observation.
        self._sway_command(f"assign {criteria} workspace {workspace}")
        self._sway_command(f"no_focus {criteria}")
        return workspace

    @staticmethod
    def _application_id(value: Any, argv: list[str]) -> str:
        if value is None:
            digest = hashlib.sha256(argv[0].encode("utf-8", "replace")).hexdigest()[:24]
            return f"org.openai.sandcodex.launch.{digest}"
        app_id = as_string(value, "application_id", maximum=MAX_APP_ID_BYTES, allow_empty=False)
        if re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9._-]{0,253}[A-Za-z0-9])?", app_id) is None:
            raise ToolError("application_id must be a bounded reverse-DNS-style identifier")
        return app_id

    def _probe_application_wayland(self, display_name: str) -> dict[str, Any]:
        completed = self._run_controller(
            [self.commands["wayland-info"]],
            timeout=15,
            environment_overrides={"WAYLAND_DISPLAY": display_name},
        )
        output = completed.stdout.decode("utf-8", "replace")
        interfaces = set(re.findall(r"interface:\s*['\"]?([A-Za-z0-9_]+)", output))
        missing = sorted(REQUIRED_APP_WAYLAND_GLOBALS - interfaces)
        leaked = sorted(PRIVILEGED_APP_WAYLAND_GLOBALS & interfaces)
        if missing:
            raise ToolError(f"per-launch Wayland context omitted required interfaces: {missing}")
        if leaked:
            raise ToolError(f"per-launch Wayland context exposed controller interfaces: {leaked}")
        return {
            "required_present": sorted(REQUIRED_APP_WAYLAND_GLOBALS),
            "privileged_absent": sorted(PRIVILEGED_APP_WAYLAND_GLOBALS),
            "interface_count": len(interfaces),
        }

    @staticmethod
    def _stop_context_process(process: subprocess.Popen[bytes], start_ticks: int) -> None:
        if exact_process_alive(process.pid, start_ticks):
            signal_exact_process(process.pid, start_ticks, signal.SIGTERM)
            deadline = time.monotonic() + APP_CONTEXT_STOP_TIMEOUT_SECONDS
            while exact_process_alive(process.pid, start_ticks) and time.monotonic() < deadline:
                time.sleep(0.01)
            if exact_process_alive(process.pid, start_ticks):
                signal_exact_process(process.pid, start_ticks, signal.SIGKILL)
        with contextlib.suppress(subprocess.TimeoutExpired, ProcessLookupError):
            process.wait(timeout=APP_CONTEXT_STOP_TIMEOUT_SECONDS)

    @staticmethod
    def _context_process_identity(process: subprocess.Popen[bytes], label: str, deadline: float) -> int:
        while time.monotonic() < deadline:
            identity = proc_identity(process.pid)
            if identity is not None:
                return int(identity["start_ticks"])
            if process.poll() is not None:
                break
            time.sleep(0.005)
        raise ToolError(f"{label} exited before custody")

    @staticmethod
    def _remove_context_paths(root: Path, *paths: Path) -> None:
        for path in paths:
            with contextlib.suppress(FileNotFoundError):
                path.unlink()
        with contextlib.suppress(FileNotFoundError, OSError):
            root.rmdir()

    def _stop_app_context(self, context: AppWaylandContext) -> None:
        # xdg-dbus-proxy treats the sync descriptor as both its readiness
        # acknowledgement and lifetime tether. Closing our peer asks it to
        # stop before exact-PID termination is used as the bounded fallback.
        if context.atspi_sync is not None:
            with contextlib.suppress(OSError):
                context.atspi_sync.shutdown(socket.SHUT_RDWR)
            with contextlib.suppress(OSError):
                context.atspi_sync.close()
            context.atspi_sync = None
        self._stop_context_process(context.atspi_process, context.atspi_start_ticks)
        self._stop_context_process(context.process, context.start_ticks)
        self._remove_context_paths(context.root, context.atspi_socket, context.ready, context.socket)

    def _prepare_app_context(self, app_id: str) -> AppWaylandContext:
        if (
            not self.is_wayland
            or self.context_helper is None
            or self.context_root is None
            or self.atspi_proxy is None
            or self.atspi_address is None
        ):
            raise ToolError("per-launch Wayland and filtered AT-SPI contexts are unavailable")
        token = secrets.token_hex(12)
        root = self.context_root / token
        socket_path = root / "wayland"
        ready_path = root / "wayland.ready"
        atspi_socket = root / "at-spi-bus"
        runtime_root = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
        helper_process: subprocess.Popen[bytes] | None = None
        helper_start = 0
        atspi_process: subprocess.Popen[bytes] | None = None
        atspi_start = 0
        atspi_sync: socket.socket | None = None
        atspi_child_sync: socket.socket | None = None
        try:
            root.mkdir(mode=0o700)
            root_info = root.lstat()
            if (
                not stat.S_ISDIR(root_info.st_mode)
                or stat.S_ISLNK(root_info.st_mode)
                or root_info.st_uid != os.geteuid()
                or stat.S_IMODE(root_info.st_mode) != 0o700
            ):
                raise ToolError("per-launch context capsule is unsafe")
            try:
                display_name = os.fspath(socket_path.relative_to(runtime_root))
            except (ValueError, OSError):
                raise ToolError("per-launch context capsule escaped XDG_RUNTIME_DIR")
            if len(os.fsencode(socket_path)) >= 104 or len(os.fsencode(atspi_socket)) >= 104:
                raise ToolError("per-launch context endpoint exceeds the Unix-domain limit")
            instance_id = f"launch-{token}"
            environment = {
                key: value for key, value in os.environ.items()
                if key in {"PATH", "HOME", "LANG", "LC_ALL", "XDG_RUNTIME_DIR", "WAYLAND_DISPLAY"}
            }
            deadline = time.monotonic() + APP_CONTEXT_START_TIMEOUT_SECONDS
            helper_process = subprocess.Popen(
                [str(self.context_helper), str(socket_path), str(ready_path), app_id, instance_id],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
                env=environment,
            )
            helper_start = self._context_process_identity(helper_process, "per-launch Wayland context helper", deadline)
            ready = False
            while time.monotonic() < deadline:
                if not exact_process_alive(helper_process.pid, helper_start):
                    break
                try:
                    socket_info = socket_path.lstat()
                    ready_info = ready_path.lstat()
                except FileNotFoundError:
                    time.sleep(0.01)
                    continue
                if (
                    stat.S_ISSOCK(socket_info.st_mode)
                    and not stat.S_ISLNK(socket_info.st_mode)
                    and socket_info.st_uid == os.geteuid()
                    and stat.S_IMODE(socket_info.st_mode) == 0o600
                    and stat.S_ISREG(ready_info.st_mode)
                    and not stat.S_ISLNK(ready_info.st_mode)
                    and ready_info.st_uid == os.geteuid()
                    and ready_info.st_nlink == 1
                    and stat.S_IMODE(ready_info.st_mode) == 0o600
                ):
                    ready = True
                    break
                raise ToolError("per-launch Wayland context published unsafe endpoints")
            if not ready:
                raise ToolError("per-launch Wayland context did not become ready")
            capability_probe = self._probe_application_wayland(display_name)

            # Each app receives a separate filtered view of the private AT-SPI
            # bus. The policy is the narrow registration surface used by
            # Flatpak rather than direct access to every other application's
            # semantic/control objects.
            proxy_environment = {
                key: value for key, value in os.environ.items()
                if key in {"PATH", "HOME", "LANG", "LC_ALL"}
            }
            atspi_sync, atspi_child_sync = socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM)
            atspi_sync.setblocking(False)
            child_fd = atspi_child_sync.fileno()
            atspi_process = subprocess.Popen(
                [
                    str(self.atspi_proxy), f"--fd={child_fd}",
                    self.atspi_address, str(atspi_socket), *ATSPI_PROXY_POLICY,
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
                close_fds=True,
                pass_fds=(child_fd,),
                env=proxy_environment,
            )
            atspi_child_sync.close()
            atspi_child_sync = None
            atspi_deadline = time.monotonic() + APP_CONTEXT_START_TIMEOUT_SECONDS
            atspi_start = self._context_process_identity(
                atspi_process, "per-launch AT-SPI filtering proxy", atspi_deadline
            )
            remaining = max(0.0, atspi_deadline - time.monotonic())
            readable, _, _ = select.select([atspi_sync], [], [], remaining)
            if not readable:
                raise ToolError("per-launch AT-SPI filtering proxy did not acknowledge readiness")
            try:
                ready_byte = atspi_sync.recv(1)
            except BlockingIOError as error:
                raise ToolError("per-launch AT-SPI filtering proxy readiness raced") from error
            if ready_byte != b"x" or not exact_process_alive(atspi_process.pid, atspi_start):
                raise ToolError("per-launch AT-SPI filtering proxy failed during readiness")
            try:
                atspi_info = atspi_socket.lstat()
            except FileNotFoundError as error:
                raise ToolError("per-launch AT-SPI proxy omitted its endpoint") from error
            if not stat.S_ISSOCK(atspi_info.st_mode) or stat.S_ISLNK(atspi_info.st_mode) or atspi_info.st_uid != os.geteuid():
                raise ToolError("per-launch AT-SPI proxy published an unsafe endpoint")
            os.chmod(atspi_socket, 0o600, follow_symlinks=False)
            atspi_info = atspi_socket.lstat()
            if stat.S_IMODE(atspi_info.st_mode) != 0o600:
                raise ToolError("per-launch AT-SPI proxy endpoint is not private")
            return AppWaylandContext(
                root=root,
                process=helper_process,
                start_ticks=helper_start,
                socket=socket_path,
                ready=ready_path,
                display_name=display_name,
                app_id=app_id,
                instance_id=instance_id,
                capability_probe=capability_probe,
                atspi_process=atspi_process,
                atspi_start_ticks=atspi_start,
                atspi_socket=atspi_socket,
                atspi_policy_sha256=ATSPI_PROXY_POLICY_SHA256,
                atspi_sync=atspi_sync,
            )
        except Exception:
            if atspi_child_sync is not None:
                with contextlib.suppress(OSError):
                    atspi_child_sync.close()
            if atspi_sync is not None:
                with contextlib.suppress(OSError):
                    atspi_sync.close()
            if atspi_process is not None and atspi_start:
                self._stop_context_process(atspi_process, atspi_start)
            elif atspi_process is not None:
                with contextlib.suppress(ProcessLookupError):
                    atspi_process.kill()
                with contextlib.suppress(Exception):
                    atspi_process.wait(timeout=1)
            if helper_process is not None and helper_start:
                self._stop_context_process(helper_process, helper_start)
            elif helper_process is not None:
                with contextlib.suppress(ProcessLookupError):
                    helper_process.kill()
                with contextlib.suppress(Exception):
                    helper_process.wait(timeout=1)
            self._remove_context_paths(root, atspi_socket, ready_path, socket_path)
            raise

    @staticmethod
    def _foreign_toplevel_identifier(value: Any) -> str | None:
        """Return one protocol-valid ext-foreign-toplevel identifier.

        wayland-protocols limits identifiers to 32 printable ASCII bytes and
        requires compositor-wide uniqueness for the lifetime of the mapped
        toplevel. Treat malformed or absent identifiers as unavailable rather
        than guessing from title, app-id, PID, or container geometry.
        """
        if not isinstance(value, str):
            return None
        try:
            encoded = value.encode("ascii")
        except UnicodeEncodeError:
            return None
        if not 1 <= len(encoded) <= CAPTURE_IDENTIFIER_MAX_BYTES:
            return None
        if any(byte < 0x20 or byte > 0x7E for byte in encoded):
            return None
        return value

    @classmethod
    def _walk_sway_tree(cls, node: Any) -> list[dict[str, Any]]:
        values: list[dict[str, Any]] = []
        stack: list[tuple[Any, str | None]] = [(node, None)]
        while stack:
            current, workspace = stack.pop()
            if not isinstance(current, dict):
                continue
            node_type = current.get("type")
            if node_type == "workspace":
                workspace = str(current.get("name") or "")[:128] or None
            floating = current.get("floating_nodes", []) if isinstance(current.get("floating_nodes"), list) else []
            children = current.get("nodes", []) if isinstance(current.get("nodes"), list) else []
            stack.extend((child, workspace) for child in reversed(floating))
            stack.extend((child, workspace) for child in reversed(children))
            if node_type not in {"con", "floating_con"}:
                continue
            if current.get("app_id") is None and current.get("window") is None and not current.get("window_properties"):
                continue
            rect = current.get("rect") if isinstance(current.get("rect"), dict) else {}
            window_rect = current.get("window_rect") if isinstance(current.get("window_rect"), dict) else {}
            deco_rect = current.get("deco_rect") if isinstance(current.get("deco_rect"), dict) else {}
            properties = current.get("window_properties") if isinstance(current.get("window_properties"), dict) else {}
            identifier = current.get("id")
            if not isinstance(identifier, int) or identifier <= 0:
                continue
            foreign_identifier = cls._foreign_toplevel_identifier(
                current.get("foreign_toplevel_identifier")
            )
            foreign_identifier_sha256 = (
                hashlib.sha256(foreign_identifier.encode("ascii")).hexdigest()
                if foreign_identifier is not None else None
            )
            values.append({
                "id": identifier,
                "title": str(current.get("name") or properties.get("title") or "")[:TITLE_LIMIT],
                "app_id": str(current.get("app_id") or properties.get("class") or "")[:1024] or None,
                "class": str(properties.get("class") or "")[:1024] or None,
                "instance": str(properties.get("instance") or "")[:1024] or None,
                "pid": current.get("pid") if isinstance(current.get("pid"), int) else None,
                "x": int(rect.get("x", 0)),
                "y": int(rect.get("y", 0)),
                "width": int(rect.get("width", 0)),
                "height": int(rect.get("height", 0)),
                "window_rect": {
                    "x": int(window_rect.get("x", 0)),
                    "y": int(window_rect.get("y", 0)),
                    "width": int(window_rect.get("width", 0)),
                    "height": int(window_rect.get("height", 0)),
                },
                "deco_rect": {
                    "x": int(deco_rect.get("x", 0)),
                    "y": int(deco_rect.get("y", 0)),
                    "width": int(deco_rect.get("width", 0)),
                    "height": int(deco_rect.get("height", 0)),
                },
                "focused": bool(current.get("focused")),
                "visible": bool(current.get("visible", True)),
                "workspace": workspace,
                "fullscreen": bool(current.get("fullscreen_mode", 0)),
                "floating": (
                    str(current.get("floating"))
                    if current.get("floating") in {"auto_off", "auto_on", "user_off", "user_on"}
                    else None
                ),
                "scratchpad_state": (
                    str(current.get("scratchpad_state"))
                    if current.get("scratchpad_state") in {"none", "fresh"}
                    else "none"
                ),
                "urgent": bool(current.get("urgent")),
                "shell": str(current.get("shell") or ("xwayland" if current.get("window") is not None else "xdg-shell")),
                "sandbox_engine": str(current.get("sandbox_engine") or "")[:256] or None,
                "sandbox_app_id": str(current.get("sandbox_app_id") or "")[:MAX_APP_ID_BYTES] or None,
                "sandbox_instance_id": str(current.get("sandbox_instance_id") or "")[:MAX_APP_ID_BYTES] or None,
                "capture_identity_available": foreign_identifier is not None,
                "capture_identity_sha256": foreign_identifier_sha256,
                "_foreign_toplevel_identifier": foreign_identifier,
            })
        return values

    def _context_alive(self, managed: ManagedProcess) -> bool:
        context = managed.security_context
        return (
            context is not None
            and exact_process_alive(context.process.pid, context.start_ticks)
            and exact_process_alive(context.atspi_process.pid, context.atspi_start_ticks)
        )

    def _managed_by_launch_id(self, value: Any, *, require_live_context: bool = True) -> ManagedProcess:
        launch_id = as_string(value, "launch_id", maximum=128, allow_empty=False)
        self._reap_processes()
        managed = next((item for item in self.processes.values() if item.launch_id == launch_id), None)
        if managed is None:
            raise ToolError("launch_id is not owned by the desktop MCP server")
        self._refresh_managed(managed)
        if require_live_context and self.is_wayland and (
            managed.context_failed or not self._context_alive(managed)
        ):
            raise ToolError("launch Wayland security context failed or is no longer live")
        return managed

    def _managed_scene(
        self,
        value: Any,
        *,
        require_multiple: bool = True,
        expected_launch_ids: tuple[str, ...] | list[str] | None = None,
    ) -> list[ManagedProcess]:
        scene_id = self._scene_id(value, required=True)
        assert scene_id is not None
        self._reap_processes()
        members = sorted(
            (managed for managed in self.processes.values() if managed.scene_id == scene_id),
            key=lambda managed: managed.launch_id,
        )
        minimum = 2 if require_multiple else 1
        if not minimum <= len(members) <= SCENE_SET_MAX_LAUNCHES:
            if require_multiple:
                raise ToolError(
                    f"scene_id must own from 2 through {SCENE_SET_MAX_LAUNCHES} live managed launches"
                )
            raise ToolError(
                f"scene_id must own from 1 through {SCENE_SET_MAX_LAUNCHES} live managed launches"
            )
        expected_workspace = self._scene_workspace_name(scene_id)
        for managed in members:
            self._refresh_managed(managed)
            if managed.workspace != expected_workspace:
                raise ToolError("scene member lost its shared private compositor workspace")
            if self.is_wayland and (
                managed.context_failed or not self._context_alive(managed)
            ):
                raise ToolError("scene member lost its Wayland security context")
        launch_ids = tuple(managed.launch_id for managed in members)
        if expected_launch_ids is not None:
            expected = tuple(sorted(expected_launch_ids))
            if launch_ids != expected:
                raise ToolError("scene launch membership changed after observation")
        return members

    def _accessibility_event_origin(self, pid: int) -> dict[str, Any] | None:
        """Resolve one AT-SPI source without blocking on the controller lock.

        The AT-SPI callback runs on its own event loop and may fire while an MCP
        request holds ``self.lock`` inside a synchronous accessibility call.
        Taking that lock here could deadlock the event loop against the caller.
        Instead, use only a best-effort immutable process snapshot plus exact
        PID birth identity.  Concurrent churn fails closed by dropping the
        event; it never widens attribution.
        """
        if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
            return None
        identity = proc_identity(pid)
        if identity is None or identity.get("state") == "Z":
            return None
        start_ticks = identity.get("start_ticks")
        if isinstance(start_ticks, bool) or not isinstance(start_ticks, int) or start_ticks <= 0:
            return None
        try:
            managed_values = tuple(self.processes.values())
        except RuntimeError:
            return None
        for managed in managed_values:
            attributed = managed.members.get(pid) == start_ticks
            context = managed.security_context
            if not attributed and context is not None:
                attributed = (
                    context.atspi_process.pid == pid
                    and context.atspi_start_ticks == start_ticks
                    and exact_process_alive(pid, start_ticks)
                )
            if not attributed:
                continue
            return {
                "launch_id": managed.launch_id,
                "application_id": managed.application_id,
                "scene_id": managed.scene_id,
                "start_ticks": start_ticks,
            }
        return None

