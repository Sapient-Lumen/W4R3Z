def redact_private_notification_surface_ids(value: str) -> str:
    """Remove controller-only helper-surface capabilities from public text.

    Notification and StatusNotifierHost app IDs are independent 128-bit origin
    capabilities, not descriptive metadata.  Public MCP results, status, errors,
    and audit text must never become an oracle that lets the model relay either
    value into an untrusted application capsule.

    The function covers every launch-private helper surface even though its
    original name mentions notifications specifically.
    """
    redacted = PRIVATE_NOTIFICATION_APP_ID_RE.sub(
        PRIVATE_NOTIFICATION_PUBLIC_APP_ID, value
    )
    return PRIVATE_STATUS_APP_ID_RE.sub(PRIVATE_STATUS_PUBLIC_APP_ID, redacted)


def redact_for_audit(value: Any, key: str = "") -> Any:
    """Return bounded metadata without persisting user text, credentials, or argv."""
    sensitive = {
        "text", "clipboard", "data", "password", "token", "secret", "authorization",
        "cookie", "api_key", "openai_api_key", "argv", "env", "environment", "prompt",
        "observation_id", "open_uri_handler", "open_file_handler", "open_directory_handler",
    }
    # Payload-bearing fields are deliberately non-correlatable in the audit
    # journal. Length metadata is sufficient to prove bounded handling; a
    # deterministic digest would itself become a stable fingerprint for typed,
    # pasted, dropped, or selected private content and for one-time restore
    # capabilities.
    no_fingerprint_secrets = {
        "restore_token", "output_watch_token", "watch_token",
        "source_path", "source_paths", "text", "cursor", "event_cursor", "frame_cursor",
    }
    lowered = key.casefold()
    if isinstance(value, dict):
        result: dict[str, Any] = {}
        for child_key, child in list(value.items())[:128]:
            name = str(child_key)[:128]
            child_lowered = name.casefold()
            if child_lowered in no_fingerprint_secrets:
                encoded = canonical_json(child)
                result[name] = {"redacted": True, "bytes": len(encoded)}
            elif lowered in sensitive or any(part in child_lowered for part in sensitive):
                encoded = canonical_json(child)
                result[name] = {"redacted": True, "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest()}
            else:
                result[name] = redact_for_audit(child, name)
        return result
    if isinstance(value, list):
        if lowered in sensitive:
            encoded = canonical_json(value)
            return {"redacted": True, "items": len(value), "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest()}
        return [redact_for_audit(item, lowered) for item in value[:128]]
    if isinstance(value, str):
        value = redact_private_notification_surface_ids(value)
        encoded = value.encode("utf-8", "replace")
        if lowered in sensitive or len(encoded) > 256:
            return {"redacted": True, "bytes": len(encoded), "sha256": hashlib.sha256(encoded).hexdigest()}
        return value
    if value is None or isinstance(value, (bool, int, float)):
        return value
    return repr(value)[:256]


def _output_watch_token_digest(payload: bytes | bytearray) -> str:
    """Derive a controller-private lookup identity for one opaque watch token."""
    if not isinstance(payload, (bytes, bytearray)) or len(payload) != OUTPUT_WATCH_TOKEN_BYTES:
        raise ToolError("OutputWatchSeal token payload is invalid")
    return hmac.new(
        _COMPOSITOR_ACTION_AUTHORITY_KEY,
        b"sandcodex-output-watch-token\x00" + bytes(payload),
        hashlib.sha256,
    ).hexdigest()


class ActionJournal:
    """Mode-0600 bounded hash-chained JSONL action journal."""

    def __init__(self, path: Path, max_bytes: int = MAX_AUDIT_BYTES) -> None:
        self.path = path
        self.max_bytes = max_bytes
        self.lock = threading.RLock()
        self.previous = "0" * 64
        self.sequence = 0
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(self.path.parent, 0o700)
        if self.path.exists() or self.path.is_symlink():
            info = self.path.lstat()
            if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
                raise RuntimeError("desktop audit path is unsafe")
            os.chmod(self.path, 0o600)
            self._recover_tail()

    def _recover_tail(self) -> None:
        try:
            lines = self.path.read_text(encoding="utf-8", errors="replace").splitlines()[-MAX_AUDIT_EVENTS:]
        except OSError:
            return
        for line in lines:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(event, dict) and isinstance(event.get("hash"), str):
                self.previous = event["hash"]
                sequence = event.get("sequence")
                if isinstance(sequence, int):
                    self.sequence = max(self.sequence, sequence)

    def _rotate_if_needed(self, incoming: int) -> None:
        try:
            size = self.path.stat().st_size
        except FileNotFoundError:
            size = 0
        if size + incoming <= self.max_bytes:
            return
        rotated = self.path.with_suffix(self.path.suffix + ".1")
        with contextlib.suppress(FileNotFoundError):
            rotated.unlink()
        if self.path.exists():
            os.replace(self.path, rotated)
            os.chmod(rotated, 0o600)
        self.previous = hashlib.sha256(("rotation:" + self.previous).encode()).hexdigest()

    def append(self, kind: str, tool: str, arguments: dict[str, Any], result: Any = None, *, error: str | None = None) -> dict[str, Any]:
        with self.lock:
            self.sequence += 1
            body = {
                "schema": "sandcodex.desktop-audit.v1",
                "sequence": self.sequence,
                "time": utc_now(),
                "kind": kind[:64],
                "tool": tool[:128],
                "arguments": redact_for_audit(arguments),
                "result": redact_for_audit(result) if result is not None else None,
                "error": (
                    redact_private_notification_surface_ids(error)[:1024]
                    if isinstance(error, str)
                    else None
                ),
                "previous_hash": self.previous,
            }
            digest = hashlib.sha256(self.previous.encode("ascii") + canonical_json(body)).hexdigest()
            event = {**body, "hash": digest}
            payload = canonical_json(event) + b"\n"
            self._rotate_if_needed(len(payload))
            descriptor = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
            try:
                write_all(descriptor, payload)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            self.previous = digest
            return event

    def recent(self, limit: int) -> dict[str, Any]:
        limit = max(1, min(MAX_AUDIT_EVENTS, limit))
        with self.lock:
            try:
                lines = self.path.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]
            except FileNotFoundError:
                lines = []
            events: list[dict[str, Any]] = []
            valid = True
            previous: str | None = None
            for line in lines:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    valid = False
                    continue
                if not isinstance(event, dict):
                    valid = False
                    continue
                body = {key: value for key, value in event.items() if key != "hash"}
                expected = hashlib.sha256(str(body.get("previous_hash", "")).encode("ascii") + canonical_json(body)).hexdigest()
                if event.get("hash") != expected:
                    valid = False
                if previous is not None and body.get("previous_hash") != previous:
                    valid = False
                previous = event.get("hash") if isinstance(event.get("hash"), str) else previous
                events.append(event)
            return {"events": events, "count": len(events), "tail_hash": self.previous, "chain_valid_for_returned_window": valid}


