    def seat_snapshot(self) -> dict[str, Any]:
        """Return a text-free, authenticated inventory of Sway's one private seat.

        GET_SEATS and GET_INPUTS travel over the same SO_PEERCRED-authenticated,
        birth-pinned command connection as TickSeal.  Both views must describe
        one identical device inventory; disagreement means Sway state changed
        while the controller was trying to prove virtual-input custody.
        """
        try:
            with self.command_lock:
                seats = self._request_array_locked(SWAY_IPC_GET_SEATS, "GET_SEATS")
                inputs = self._request_array_locked(SWAY_IPC_GET_INPUTS, "GET_INPUTS")
                if len(seats) != 1 or not isinstance(seats[0], dict):
                    raise RuntimeError("SeatSeal requires exactly one private Sway seat")
                seat = seats[0]
                seat_name = self._bounded_identity_string(seat.get("name"), "seat name", maximum=128)
                if seat_name != "seat0":
                    raise RuntimeError("SeatSeal requires the sole private seat to be seat0")
                capabilities = seat.get("capabilities")
                focus = seat.get("focus")
                if (
                    not isinstance(capabilities, int)
                    or isinstance(capabilities, bool)
                    or capabilities < 0
                    or capabilities & ~SWAY_SEAT_KNOWN_CAPABILITIES
                ):
                    raise RuntimeError("Sway IPC seat capabilities are invalid")
                # The authenticated compositor permanently advertises wl_touch
                # for its controller-owned native TouchDispatchSeal path. It is
                # not an input device and is therefore outside SeatSeal's
                # transient virtual pointer/keyboard inventory.
                capabilities &= ~SWAY_SEAT_TOUCH_CAPABILITY
                if not isinstance(focus, int) or isinstance(focus, bool) or focus < 0:
                    raise RuntimeError("Sway IPC seat focus is invalid")
                seat_devices = seat.get("devices")
                if not isinstance(seat_devices, list):
                    raise RuntimeError("Sway IPC seat device inventory is invalid")
                if len(seat_devices) > 8 or len(inputs) > 8:
                    raise RuntimeError("SeatSeal device inventory exceeds its private-workstation ceiling")
                normalized_seat = [
                    self._normalize_input_device(device, f"seat device {index}")
                    for index, device in enumerate(seat_devices)
                ]
                normalized_inputs = [
                    self._normalize_input_device(device, f"input device {index}")
                    for index, device in enumerate(inputs)
                ]
                normalized_seat.sort(key=lambda item: str(item["identity_sha256"]))
                normalized_inputs.sort(key=lambda item: str(item["identity_sha256"]))
                if normalized_seat != normalized_inputs:
                    raise RuntimeError("GET_SEATS and GET_INPUTS returned different device inventories")
                identities = [str(item["identity_sha256"]) for item in normalized_inputs]
                if len(set(identities)) != len(identities):
                    raise RuntimeError("SeatSeal observed duplicate virtual-input identities")
                type_counts: dict[str, int] = {}
                for device in normalized_inputs:
                    input_type = str(device["type"])
                    type_counts[input_type] = type_counts.get(input_type, 0) + 1
                inventory_projection = {
                    "seat_name": seat_name,
                    "capabilities": capabilities,
                    "devices": normalized_inputs,
                }
                inventory_sha256 = hashlib.sha256(canonical_json(inventory_projection)).hexdigest()
                self.inventory_queries += 1
                self.last_inventory_sha256 = inventory_sha256
                return {
                    "schema": SEAT_SEAL_SCHEMA,
                    "enforced": True,
                    "seat_name": seat_name,
                    "seat_name_sha256": hashlib.sha256(seat_name.encode("utf-8")).hexdigest(),
                    "capabilities": capabilities,
                    "focus": focus,
                    "device_count": len(normalized_inputs),
                    "device_type_counts": dict(sorted(type_counts.items())),
                    "device_identity_sha256": identities,
                    "devices": normalized_inputs,
                    "inventory_sha256": inventory_sha256,
                    "cross_checked_views": ["GET_SEATS.devices", "GET_INPUTS"],
                    "peer_authentication": "SO_PEERCRED+proc-start-ticks",
                }
        except Exception as error:
            self._set_failure(error)
            if isinstance(error, ToolError):
                raise
            raise ToolError(f"SeatSeal inventory proof failed closed: {error}") from error

    def _subscribe(self) -> None:
        connection = self.event_socket
        if connection is None:
            raise RuntimeError("Sway IPC event connection is unavailable during subscription")
        payload = canonical_json(list(self.SUBSCRIPTIONS))
        self._send_frame(connection, SWAY_IPC_SUBSCRIBE, payload)
        # Sway's wire contract queues the successful SUBSCRIBE reply before it
        # emits the compulsory first tick on this same connection.  Accepting
        # an event before that reply would let a lookalike peer manufacture an
        # apparently ordered stream without proving that the requested event
        # set was accepted.  Pin the exact reply-first order and fail closed on
        # every other frame type; the reader starts only after this proof.
        message_type, response = self._recv_frame(connection)
        if message_type in self.EVENT_NAMES:
            raise RuntimeError("Sway IPC emitted an event before the subscription reply")
        if message_type != SWAY_IPC_SUBSCRIBE:
            raise RuntimeError("unexpected Sway IPC reply while subscribing to compositor events")
        reply = self._decode_object(response, "subscription")
        if reply.get("success") is not True:
            raise RuntimeError("Sway rejected the compositor event subscription")

    @staticmethod
    def _bounded_change(value: Any) -> str:
        if not isinstance(value, str) or not value or len(value.encode("utf-8", "replace")) > 128:
            return "unknown"
        return value

    @staticmethod
    def _integer(value: Any) -> int | None:
        return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None

    def _normalize_event(self, message_type: int, payload: bytes) -> dict[str, Any]:
        event_name = self.EVENT_NAMES.get(message_type)
        if event_name is None:
            raise RuntimeError(f"unrecognized subscribed Sway event type: {message_type}")
        value = self._decode_object(payload, f"{event_name} event")
        if event_name == "tick":
            first = value.get("first")
            tick_payload = value.get("payload")
            if not isinstance(first, bool):
                raise RuntimeError("Sway tick event has a non-boolean first flag")
            if not isinstance(tick_payload, str) or "\x00" in tick_payload:
                raise RuntimeError("Sway tick event has an invalid payload")
            encoded = tick_payload.encode("utf-8", "replace")
            if len(encoded) > SWAY_IPC_TICK_MAX_PAYLOAD_BYTES:
                raise RuntimeError("Sway tick event exceeds the bounded payload limit")
            if first and tick_payload:
                raise RuntimeError("Sway subscription tick unexpectedly carried a payload")
            return {
                "event": "tick",
                "change": "subscription" if first else "barrier",
                "classification": "barrier",
                # Retain the raw payload only until _record_frame acquires the
                # condition lock. That makes pending-token membership and tick
                # publication one synchronized operation; the token is never
                # stored in the bounded event ring or exposed in a receipt.
                "_tick_first": first,
                "_tick_payload": tick_payload,
                "payload_sha256": hashlib.sha256(encoded).hexdigest(),
                "payload_bytes": len(encoded),
            }

        change = self._bounded_change(value.get("change"))
        normalized: dict[str, Any] = {
            "event": event_name,
            "change": change,
            "classification": "fatal",
        }
        if event_name == "window":
            container = value.get("container") if isinstance(value.get("container"), dict) else {}
            normalized["container_id"] = self._integer(container.get("id"))
            if change in {"title", "urgent", "mark"}:
                normalized["classification"] = "metadata"
            elif change in {"new", "close", "focus", "fullscreen_mode", "move", "floating"}:
                normalized["classification"] = "transition"
        elif event_name == "workspace":
            current = value.get("current") if isinstance(value.get("current"), dict) else {}
            old = value.get("old") if isinstance(value.get("old"), dict) else {}
            normalized["workspace_id"] = self._integer(current.get("id"))
            normalized["old_workspace_id"] = self._integer(old.get("id"))
            if change == "urgent":
                normalized["classification"] = "metadata"
            elif change in {"init", "empty", "focus", "move", "rename"}:
                normalized["classification"] = "transition"
            elif change == "reload":
                normalized["classification"] = "fatal"
        elif event_name == "mode":
            # This private Sway config defines no binding modes. A mode change
            # can alter how the next injected key is interpreted and is never
            # an expected side effect of an application action.
            normalized["classification"] = "fatal"
        elif event_name == "binding":
            binding = value.get("binding") if isinstance(value.get("binding"), dict) else {}
            normalized["input_type"] = self._bounded_change(binding.get("input_type"))
            # No compositor bindings are configured. Seeing one means input
            # escaped the reviewed application path or compositor policy changed.
            normalized["classification"] = "fatal"
        elif event_name == "input":
            # The short-lived controller virtual keyboard/pointer is not ambient
            # metadata: SeatSeal binds exactly one add and one remove event to the
            # authenticated GET_SEATS/GET_INPUTS inventory for each transaction.
            # Unknown devices, policy changes, and malformed identities remain fatal.
            device = self._normalize_input_device(value.get("input"), "input event device")
            normalized.update(device)
            normalized["input_type"] = device["type"]
            if change in {"added", "removed"} and normalized["input_type"] in {"keyboard", "pointer"}:
                normalized["classification"] = "metadata"
            else:
                normalized["classification"] = "fatal"
        elif event_name in {"output", "shutdown"}:
            normalized["classification"] = "fatal"
        return normalized

    def _record_frame(self, message_type: int, payload: bytes) -> None:
        event = self._normalize_event(message_type, payload)
        with self.condition:
            self.sequence += 1
            event["sequence"] = self.sequence
            # Barrier ticks can outnumber actual compositor changes by tens of
            # thousands during long fenced typing sessions. They establish
            # sequence boundaries but are not retained in the bounded event
            # ring, so an idle desktop cannot manufacture a false overrun.
            if event.get("event") != "tick":
                if len(self.events) >= self.maximum_events:
                    dropped = self.events.popleft()
                    self.dropped_through = max(self.dropped_through, int(dropped["sequence"]))
                self.events.append(event)
            tick_first = event.pop("_tick_first", None)
            raw_tick_payload = event.pop("_tick_payload", None)
            token = None
            if event.get("event") == "tick":
                if tick_first is True:
                    if self.subscription_tick_seen:
                        raise RuntimeError("Sway IPC emitted more than one first subscription tick")
                    self.subscription_tick_seen = True
                    self.subscription_tick_sequence = self.sequence
                elif tick_first is False:
                    if not self.subscription_tick_seen:
                        raise RuntimeError(
                            "Sway IPC emitted a non-first tick before the compulsory subscription tick"
                        )
                    if (
                        not isinstance(raw_tick_payload, str)
                        or raw_tick_payload not in self.pending_tokens
                    ):
                        # The private workstation exposes no Sway IPC command
                        # socket to an application or to the model-facing
                        # namespace.  Every legitimate non-first tick must
                        # therefore be the one exact, currently pending token
                        # published by barrier().  Ignoring any other tick
                        # would allow a second IPC client—or a duplicated
                        # compositor event—to create an unaccounted ordering
                        # boundary while the public receipt still appeared
                        # complete.
                        raise RuntimeError(
                            "Sway IPC emitted an unsolicited or duplicate non-first tick"
                        )
                    token = raw_tick_payload
                    # Consume publication at the event edge rather than after
                    # the waiting command thread wakes.  A duplicate copy of
                    # this token is consequently impossible to mistake for a
                    # second successful barrier, even inside that scheduling
                    # window.
                    self.pending_tokens.remove(token)
                else:
                    raise RuntimeError("normalized Sway tick event lost its first-event classification")
            if isinstance(token, str):
                self.tick_sequences[token] = self.sequence
                self.tick_order.append(token)
                while len(self.tick_order) > 256:
                    old = self.tick_order.popleft()
                    self.tick_sequences.pop(old, None)
            self.condition.notify_all()

    def _set_failure(self, error: BaseException | str) -> None:
        message = str(error)[:1024]
        with self.condition:
            if self.failure is None:
                self.failure = message or type(error).__name__
            self.condition.notify_all()

    def _revoke_command_connection(self, error: BaseException | str) -> None:
        """Quarantine IPC and force Sway connection-owned de-escalation."""
        self._set_failure(error)
        connection = self.command_socket
        self.command_socket = None
        if connection is not None:
            with contextlib.suppress(OSError):
                connection.shutdown(socket.SHUT_RDWR)
            with contextlib.suppress(OSError):
                connection.close()

    def _reader_loop(self) -> None:
        connection = self.event_socket
        if connection is None:
            self._set_failure("Sway IPC event connection disappeared before reader startup")
            return
        while not self.stop_event.is_set():
            try:
                message_type, payload = self._recv_frame(connection)
                if message_type not in self.EVENT_NAMES:
                    raise RuntimeError(f"unexpected message type {message_type} on Sway event stream")
                self._record_frame(message_type, payload)
            except socket.timeout:
                continue
            except Exception as error:
                if not self.stop_event.is_set():
                    self._set_failure(error)
                return

    def _raise_if_unhealthy_locked(self) -> None:
        if self.failure is not None:
            raise ToolError(f"compositor event seal failed closed: {self.failure}")
        if self.stop_event.is_set():
            raise ToolError("compositor event seal is closed")
        identity = proc_identity(self.expected_pid)
        if identity is None or identity.get("start_ticks") != self.expected_start_ticks:
            raise ToolError("birth-pinned Sway process identity changed during compositor event sealing")

    def barrier(self, label: str) -> int:
        label_digest = hashlib.sha256(label.encode("utf-8", "replace")).hexdigest()[:16]
        with self.command_lock:
            with self.condition:
                self._raise_if_unhealthy_locked()
                self.barrier_counter += 1
                token_base = f"sandcodex:{self.nonce}:{self.barrier_counter}:{label_digest}"

            def issue_tick(suffix: str) -> int:
                token = f"{token_base}:{suffix}"
                with self.condition:
                    self._raise_if_unhealthy_locked()
                    if token in self.pending_tokens or token in self.tick_sequences:
                        raise RuntimeError("generated Sway IPC barrier token was reused")
                    self.pending_tokens.add(token)
                try:
                    connection = self.command_socket
                    if connection is None:
                        raise RuntimeError("Sway IPC barrier connection is unavailable")
                    payload = token.encode("utf-8")
                    if len(payload) > SWAY_IPC_TICK_MAX_PAYLOAD_BYTES:
                        raise RuntimeError("generated Sway IPC barrier token exceeds the bounded payload limit")
                    self._send_frame(connection, SWAY_IPC_SEND_TICK, payload)
                    message_type, response = self._recv_frame(connection)
                    if message_type != SWAY_IPC_SEND_TICK:
                        raise RuntimeError("Sway returned the wrong reply type for SEND_TICK")
                    reply = self._decode_object(response, "SEND_TICK")
                    if reply.get("success") is not True:
                        raise RuntimeError("Sway rejected the compositor event barrier")
                    deadline = time.monotonic() + self.barrier_timeout
                    with self.condition:
                        while token not in self.tick_sequences:
                            self._raise_if_unhealthy_locked()
                            remaining = deadline - time.monotonic()
                            if remaining <= 0:
                                raise TimeoutError(
                                    "matching Sway tick event was not received before the barrier deadline"
                                )
                            self.condition.wait(remaining)
                        # The matching event and a terminal stream error can be
                        # published back-to-back before this waiter is scheduled.
                        # Do not return a superficially successful marker when a
                        # duplicate tick or malformed following frame has already
                        # poisoned the authenticated stream.
                        self._raise_if_unhealthy_locked()
                        sequence = self.tick_sequences.pop(token)
                        with contextlib.suppress(ValueError):
                            self.tick_order.remove(token)
                        return sequence
                finally:
                    with self.condition:
                        self.pending_tokens.discard(token)

            try:
                # A logical boundary is committed by two ordered private
                # markers. The first establishes the requested event edge; the
                # second proves the reader consumed everything Sway emitted
                # immediately after that edge before input may proceed. Because
                # both use one serialized command connection and one ordered
                # subscription stream, an immediate replay/duplicate of the
                # edge token is encountered before the commit token and fails
                # closed instead of racing the command waiter.
                edge_sequence = issue_tick("edge")
                commit_sequence = issue_tick("commit")
                if commit_sequence <= edge_sequence:
                    raise RuntimeError("Sway IPC barrier commit did not advance the event stream")
                return commit_sequence
            except Exception as error:
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(f"compositor event barrier failed closed: {error}") from error

    @staticmethod
    def _public_event(event: dict[str, Any]) -> dict[str, Any]:
        return {
            key: event.get(key)
            for key in (
                "sequence", "event", "change", "classification", "container_id",
                "workspace_id", "old_workspace_id", "input_type", "identity_sha256",
                "identifier_sha256", "name_sha256", "vendor", "product",
            )
            if event.get(key) is not None
        }

    def summarize(self, start_sequence: int, end_sequence: int) -> dict[str, Any]:
        if not isinstance(start_sequence, int) or not isinstance(end_sequence, int) or start_sequence < 0 or end_sequence < start_sequence:
            raise ToolError("invalid compositor event seal sequence range")
        with self.condition:
            self._raise_if_unhealthy_locked()
            # The interval is open on its left edge: (start, end]. An event
            # dropped exactly at start was outside the requested interval and
            # must not create a false denial. Any later dropped event destroys
            # completeness and remains fail-closed.
            if start_sequence < self.dropped_through:
                raise ToolError("compositor event seal buffer overran the guarded action interval")
            if end_sequence > self.sequence:
                raise ToolError("compositor event seal end barrier has not been observed")
            selected = [
                dict(event) for event in self.events
                if start_sequence < int(event["sequence"]) <= end_sequence and event.get("event") != "tick"
            ]
        public = [self._public_event(event) for event in selected]
        classifications = [str(event.get("classification")) for event in selected]
        event_types = sorted({str(event.get("event")) for event in selected})
        changes = sorted({f"{event.get('event')}:{event.get('change')}" for event in selected})
        metadata_changes = sorted({
            f"{event.get('event')}:{event.get('change')}"
            for event in selected if event.get("classification") == "metadata"
        })
        transition_changes = sorted({
            f"{event.get('event')}:{event.get('change')}"
            for event in selected if event.get("classification") == "transition"
        })
        fatal_changes = sorted({
            f"{event.get('event')}:{event.get('change')}"
            for event in selected if event.get("classification") == "fatal"
        })
        input_lifecycle = [
            self._public_event(event)
            for event in selected
            if event.get("event") == "input" and event.get("change") in {"added", "removed"}
        ]
        input_lifecycle_counts: dict[str, int] = {}
        for event in input_lifecycle:
            key = f"{event.get('change')}:{event.get('input_type')}"
            input_lifecycle_counts[key] = input_lifecycle_counts.get(key, 0) + 1
        input_device_digests = sorted({
            str(event.get("identity_sha256"))
            for event in input_lifecycle
            if isinstance(event.get("identity_sha256"), str)
        })
        return {
            "schema": COMPOSITOR_EVENT_SEAL_SCHEMA,
            "enforced": True,
            "start_sequence": start_sequence,
            "end_sequence": end_sequence,
            "events": len(selected),
            "metadata_events": classifications.count("metadata"),
            "transition_events": classifications.count("transition"),
            "fatal_events": classifications.count("fatal"),
            "event_types": event_types,
            "changes": changes,
            "metadata_changes": metadata_changes,
            "transition_changes": transition_changes,
            "fatal_changes": fatal_changes,
            "input_lifecycle": input_lifecycle,
            "input_lifecycle_counts": dict(sorted(input_lifecycle_counts.items())),
            "input_device_digests": input_device_digests,
            "event_sha256": hashlib.sha256(canonical_json(public)).hexdigest(),
            "samples": public[:COMPOSITOR_EVENT_MAX_SAMPLES],
        }

    def status(self) -> dict[str, Any]:
        identity = proc_identity(self.expected_pid)
        process_identity_intact = (
            identity is not None and identity.get("start_ticks") == self.expected_start_ticks
        )
        with self.condition:
            subscription_order_intact = (
                self.subscription_tick_seen
                and 0 < self.subscription_tick_sequence < self.startup_sequence
            )
            return {
                "schema": COMPOSITOR_EVENT_SEAL_SCHEMA,
                "enforced": True,
                "healthy": (
                    self.failure is None
                    and not self.stop_event.is_set()
                    and process_identity_intact
                    and subscription_order_intact
                    and (not self.hit_test_required or self.hit_test_authorized)
