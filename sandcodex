        finally:
            globals()["google_request"] = original_google_request
        assert cross_models == ["gemini-origin", "gemini-fallback"]
        assert cross_result[2] == "gemini-fallback"
        assert cross_bodies[1]["input"][1] == cross_call
        assert cross_bodies[1]["input"][2]["type"] == "function_result"
        assert runtime.cross_model_continuations == 1
        assert runtime.last_continuation_migration == {
            "from": "gemini-origin", "to": "gemini-fallback"}

        # Every clean logical request advances the starting account while
        # keeping model strength as the primary ordering. Within that request
        # it walks the complete bank before downgrading the model. This both
        # spreads ordinary traffic and preserves immediate quota failover.
        class AllAvailable:
            def available(self, _key_id: str, _model: str, *, ignore: bool) -> bool:
                return True

            def record(self, _field: str, _identity: str, _seconds: int,
                       _reason: str) -> None:
                return

            def next_delay(self, _key_ids: Sequence[str], _models: Sequence[str],
                           *, ignore: bool) -> int | None:
