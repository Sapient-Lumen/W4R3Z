    def copy_text(self, arguments: dict[str, Any]) -> dict[str, Any]:
        """Compatibility-X11 copy; native Wayland must use guarded RichCopySeal."""
        chord = self._normalize_copy_chord(arguments.get("chord", "CTRL+C"))
        if self.is_wayland:
            raise ToolError(
                "native Wayland copy requires desktop_step so RichCopySeal can bind focus, scope, and TickSeal"
            )
        quiet_milliseconds = as_int(
            arguments.get("quiet_milliseconds", 150), 1, 1000, "quiet_milliseconds"
        )
        maximum_bytes = as_int(
            arguments.get("maximum_bytes", MAX_TEXT_BYTES),
            1,
            MAX_TEXT_BYTES,
            "maximum_bytes",
        )
        self._press_chord(chord)
        time.sleep(quiet_milliseconds / 1000.0)
        result = self.read_clipboard({})
        structured = result.get("structuredContent") if isinstance(result, dict) else None
        if not isinstance(structured, dict):
            raise ToolError("compatibility clipboard read returned an invalid result")
        text = as_string(structured.get("text"), "clipboard text")
        payload = text.encode("utf-8")
        if len(payload) > maximum_bytes:
            raise ToolError("copied selection exceeds maximum_bytes")
        return json_result({
            "copied": True,
            "text": text,
            "characters": len(text),
            "bytes": len(payload),
            "sha256": hashlib.sha256(payload).hexdigest(),
            "chord": chord,
            "untrusted": True,
            "trust": "controlled-application-output",
            "transport": "private-x11-selection",
        })

    def set_clipboard(self, arguments: dict[str, Any]) -> dict[str, Any]:
        text = as_string(arguments.get("text"), "text")
        if self.is_wayland:
            self._run_controller([self.commands["wl-copy"], "--type", "text/plain;charset=utf-8"], input_bytes=text.encode("utf-8"), timeout=5)
        else:
            assert self.clipboard is not None
            self.clipboard.set_text(text)
        return json_result({"clipboard_set": True, "characters": len(text), "bytes": len(text.encode("utf-8"))})

    def read_clipboard(self, _arguments: dict[str, Any]) -> dict[str, Any]:
        if self.is_wayland:
            completed = self._run_controller([self.commands["wl-paste"], "--no-newline", "--type", "text"], timeout=5)
            if len(completed.stdout) > MAX_TEXT_BYTES:
                raise ToolError("clipboard content is too large")
            text = completed.stdout.decode("utf-8", "replace")
            return json_result({"text": text, "characters": len(text), "bytes": len(completed.stdout)})
        assert self.clipboard is not None
        owned = self.clipboard.owned_text()
        if owned is not None:
            return json_result({"text": owned, "characters": len(owned), "bytes": len(owned.encode("utf-8"))})
        connection = xdisplay.Display(self.display_name)
        window = None
        try:
            clipboard = connection.intern_atom("CLIPBOARD")
            utf8 = connection.intern_atom("UTF8_STRING")
            property_atom = connection.intern_atom("SANDCODEX_CLIPBOARD_RESULT")
            screen = connection.screen()
            window = screen.root.create_window(-10, -10, 1, 1, 0, screen.root_depth)
            window.convert_selection(clipboard, utf8, property_atom, X.CurrentTime)
            connection.flush()
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline:
                readable, _, _ = select.select([connection.fileno()], [], [], max(0.0, deadline - time.monotonic()))
                if not readable:
                    break
                while connection.pending_events():
                    event = connection.next_event()
                    if event.type != X.SelectionNotify:
                        continue
                    if event.property == X.NONE:
                        raise ToolError("the clipboard owner does not provide UTF-8 text")
                    value = window.get_full_property(property_atom, X.AnyPropertyType)
                    if value is None:
                        text = ""
                    elif isinstance(value.value, str):
                        text = value.value
                    elif isinstance(value.value, bytes):
                        text = value.value.decode("utf-8", "replace")
                    elif hasattr(value.value, "tobytes"):
                        text = value.value.tobytes().decode("utf-8", "replace")
                    else:
                        text = bytes(value.value).decode("utf-8", "replace")
                    if len(text.encode("utf-8")) > MAX_TEXT_BYTES:
                        raise ToolError("clipboard content is too large")
                    return json_result({"text": text, "characters": len(text), "bytes": len(text.encode("utf-8"))})
            raise ToolError("clipboard read timed out")
        finally:
            if window is not None:
                with contextlib.suppress(Exception):
                    window.destroy()
            connection.close()

    def key(self, arguments: dict[str, Any]) -> dict[str, Any]:
        value = arguments.get("chord")
        if isinstance(value, str):
            chords = [value]
        elif isinstance(value, list) and value and all(isinstance(item, str) for item in value):
            chords = value
        else:
            raise ToolError("chord must be a string or non-empty string array")
        if len(chords) > 128:
            raise ToolError("too many chords")
        interval = as_number(arguments.get("interval", 0.05), 0.0, 2.0, "interval")
        repeat = as_int(arguments.get("repeat", 1), 1, 100, "repeat")
        actions = len(chords) * repeat
        if actions > 1024 or max(0, actions - 1) * interval > MAX_ACTION_SECONDS:
            raise ToolError("key sequence exceeds the count or action-duration limit")
        for iteration in range(repeat):
            for index, chord in enumerate(chords):
                self._press_chord(chord)
                if interval and (iteration + 1 < repeat or index + 1 < len(chords)):
                    time.sleep(interval)
        return json_result({"pressed": chords, "repeat": repeat})

    def _window_title(self, window: Any) -> str:
        for atom_name in ("_NET_WM_NAME", "WM_NAME"):
            try:
                atom = self.display.intern_atom(atom_name)
                prop = window.get_full_property(atom, X.AnyPropertyType)
                if prop is not None:
                    value = prop.value
                    if isinstance(value, bytes):
                        return value.decode("utf-8", "replace")[:TITLE_LIMIT]
                    if hasattr(value, "tobytes"):
                        return value.tobytes().decode("utf-8", "replace").rstrip("\x00")[:TITLE_LIMIT]
                    return str(value)[:TITLE_LIMIT]
            except (xerror.BadWindow, xerror.BadAtom, UnicodeError):
                pass
        return ""

    def _client_windows(self) -> list[Any]:
        for atom_name in ("_NET_CLIENT_LIST_STACKING", "_NET_CLIENT_LIST"):
            try:
                atom = self.display.intern_atom(atom_name)
                prop = self.root.get_full_property(atom, Xatom.WINDOW)
                if prop is not None:
                    return [self.display.create_resource_object("window", int(value)) for value in prop.value]
            except (xerror.BadWindow, xerror.BadAtom):
                pass
        try:
            return list(self.root.query_tree().children)
        except xerror.BadWindow:
            return []

    def _controllable_window(self, identifier: int) -> Any:
        for window in self._client_windows():
            if window.id == identifier:
                return window
        raise ToolError(f"window is not a listed desktop client: {identifier}")

    def windows(self, arguments: dict[str, Any]) -> dict[str, Any]:
        include_unmapped = as_bool(arguments.get("include_unmapped", False), "include_unmapped")
        launch_id_value = arguments.get("launch_id")
        scene_id_value = arguments.get("scene_id")
        if launch_id_value is not None and scene_id_value is not None:
            raise ToolError("launch_id and scene_id are mutually exclusive window filters")
        launch_id = None
        if launch_id_value is not None:
            launch_id = self._managed_by_launch_id(launch_id_value).launch_id
        scene_id = None
        if scene_id_value is not None:
            scene_id = self._scene_id(scene_id_value, required=True)
            assert scene_id is not None
            self._managed_scene(scene_id, require_multiple=False)
        title_contains_value = arguments.get("title_contains")
        title_contains = None
        if title_contains_value is not None:
            title_contains = as_string(title_contains_value, "title_contains", maximum=1024).casefold()
        if self.is_wayland:
            values = self._wayland_windows()
            if not include_unmapped:
                values = [item for item in values if item.get("visible", True)]
            if launch_id is not None:
                values = [item for item in values if item.get("launch_id") == launch_id]
            if scene_id is not None:
                values = [item for item in values if item.get("scene_id") == scene_id]
            if title_contains is not None:
                values = [item for item in values if title_contains in str(item.get("title", "")).casefold()]
            active = next((int(item["id"]) for item in values if item.get("focused")), None)
            public_values = self._public_wayland_windows(values)
            return json_result({
                "windows": public_values,
                "active_window": active,
                "count": len(public_values),
                "backend": "wayland",
            })

        if launch_id is not None or scene_id is not None:
            raise ToolError("launch- and scene-scoped windows require the private Wayland backend")
        values: list[dict[str, Any]] = []
        seen: set[int] = set()
        for window in self._client_windows():
            if window.id in seen:
                continue
            seen.add(window.id)
            try:
                attrs = window.get_attributes()
                mapped = attrs.map_state == X.IsViewable
                if not mapped and not include_unmapped:
                    continue
                geometry = window.get_geometry()
                translated = self.root.translate_coords(window, 0, 0)
                wm_class = window.get_wm_class()
                title = self._window_title(window)
                if title_contains is not None and title_contains not in title.casefold():
                    continue
                values.append(
                    {
                        "id": window.id,
                        "id_hex": f"0x{window.id:x}",
                        "title": title,
                        "class": list(wm_class) if wm_class else None,
                        "x": int(translated.x),
                        "y": int(translated.y),
                        "width": int(geometry.width),
                        "height": int(geometry.height),
                        "mapped": mapped,
                        "shell": "x11",
                    }
                )
            except (xerror.BadWindow, xerror.BadDrawable):
                continue
        active: int | None = None
        try:
            focused = self.display.get_input_focus().focus
            for _ in range(32):
                if not hasattr(focused, "id"):
                    break
                focused_id = int(focused.id)
                if focused_id in seen:
                    active = focused_id
                    break
                if focused_id == int(self.root.id):
                    break
                focused = focused.query_tree().parent
        except (xerror.BadWindow, xerror.BadAtom, AttributeError, TypeError, ValueError):
            pass
        if active is None:
            try:
                atom = self.display.intern_atom("_NET_ACTIVE_WINDOW")
                prop = self.root.get_full_property(atom, Xatom.WINDOW)
                if prop is not None and len(prop.value):
                    active = int(prop.value[0])
            except (xerror.BadWindow, xerror.BadAtom):
                pass
        for item in values:
            item["focused"] = item["id"] == active
        return json_result({"windows": values, "active_window": active, "count": len(values), "backend": "x11"})

    def focus(self, arguments: dict[str, Any]) -> dict[str, Any]:
        identifier = parse_window_id(arguments.get("window_id"))
        if self.is_wayland:
            if not any(item["id"] == identifier for item in self._wayland_windows()):
                raise ToolError(f"window is not a listed desktop client: {identifier}")
            self._sway_command(f'[con_id="{identifier}"] focus')
            return json_result({"focused": True, "window_id": identifier, "backend": "wayland"})

        window = self._controllable_window(identifier)
        try:
            window.map()
            window.configure(stack_mode=X.Above)
            window.set_input_focus(X.RevertToParent, X.CurrentTime)
            atom = self.display.intern_atom("_NET_ACTIVE_WINDOW")
            event = protocol.event.ClientMessage(
                window=identifier,
                client_type=atom,
                data=(32, [2, X.CurrentTime, 0, 0, 0]),
            )
            self.root.send_event(event, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            self._sync()
        except xerror.BadWindow as error:
            raise ToolError(f"window does not exist: {identifier}") from error
        return json_result({"focused": True, "window_id": identifier, "backend": "x11"})

    def move_resize(self, arguments: dict[str, Any]) -> dict[str, Any]:
        identifier = parse_window_id(arguments.get("window_id"))
        x = as_int(arguments.get("x"), 0 if self.is_wayland else -32768, self.width - 1 if self.is_wayland else 32767, "x")
        y = as_int(arguments.get("y"), 0 if self.is_wayland else -32768, self.height - 1 if self.is_wayland else 32767, "y")
        width = as_int(arguments.get("width"), 1, self.width if self.is_wayland else 32767, "width")
        height = as_int(arguments.get("height"), 1, self.height if self.is_wayland else 32767, "height")
        if self.is_wayland:
            if not any(item["id"] == identifier for item in self._wayland_windows()):
                raise ToolError(f"window is not a listed desktop client: {identifier}")
            selector = f'[con_id="{identifier}"]'
            self._sway_command(
                f'{selector} floating enable, {selector} move absolute position {x} px {y} px, '
                f'{selector} resize set width {width} px height {height} px'
            )
            return json_result({"moved_resized": True, "window_id": identifier, "x": x, "y": y, "width": width, "height": height, "backend": "wayland"})

        window = self._controllable_window(identifier)
        try:
            window.configure(x=x, y=y, width=width, height=height, stack_mode=X.Above)
            self._sync()
        except (xerror.BadWindow, xerror.BadMatch) as error:
            raise ToolError(f"window cannot be moved or resized: {identifier}") from error
        return json_result({"moved_resized": True, "window_id": identifier, "x": x, "y": y, "width": width, "height": height, "backend": "x11"})

    def window_state(self, arguments: dict[str, Any]) -> dict[str, Any]:
        """Apply one explicit, idempotent private-compositor window state.

        Minimize is a Sway scratchpad transition, not an ambient desktop
        convention. Restore requires the opaque one-time token returned by that
        exact minimize. The raw token is never retained or journaled; only its
        SHA-256 lookup key remains in controller memory. The current schema also
        binds the lease to the exact immutable workstation-window inventory at
        minimize time, so a sibling join, loss, or replacement invalidates it.
        Restore authenticates the latent windowed layout before any final
        fullscreen transition because fullscreen geometry is output-sized.
        """
        if not self.is_wayland:
            raise ToolError(
                "WindowStateSeal requires the native private Wayland backend; "
                "launch-private X11 applications remain controllable through their exported Wayland toplevel"
            )
        if not isinstance(arguments, dict):
            raise ToolError("desktop_window_state arguments must be an object")
        unexpected = sorted(set(arguments) - {"window_id", "state", "restore_token"})
        if unexpected:
            raise ToolError(
                "desktop_window_state received unsupported arguments: "
                + ", ".join(unexpected)
            )
        identifier = parse_window_id(arguments.get("window_id"))
        state = self._window_state_name(arguments.get("state"))
        if state == "restored":
            if "restore_token" not in arguments:
                raise ToolError("restored state requires restore_token")
        elif arguments.get("restore_token") is not None:
            raise ToolError("restore_token is accepted only for restored state")
        windows_before = self._wayland_windows()
        inventory_before = self._window_state_inventory(windows_before)
        inventory_before_sha256 = self._window_state_inventory_sha256(inventory_before)

        if state == "restored":
            token = as_string(
                arguments.get("restore_token"),
                "restore_token",
                maximum=WINDOW_RESTORE_TOKEN_LENGTH,
                allow_empty=False,
            )
            if (
                len(token) != WINDOW_RESTORE_TOKEN_LENGTH
                or re.fullmatch(r"[A-Za-z0-9_-]{43}", token) is None
            ):
                raise ToolError("restore_token is not a valid WindowStateSeal capability")
            token_sha256 = hashlib.sha256(token.encode("ascii")).hexdigest()
            store = self._window_restore_lease_store()
            # A restore capability authorizes one attempt. Consume before live
            # identity checks or compositor dispatch so it cannot be replayed
            # against a later replacement or partially restored state.
            lease = store.pop(token_sha256, None)
            if not isinstance(lease, dict):
                raise ToolError("restore_token is absent, stale, or already consumed")
            if lease.get("schema") != WINDOW_RESTORE_LEASE_SCHEMA:
                raise ToolError("restore_token resolved to an invalid controller lease")
            created = lease.get("created_monotonic")
            now = time.monotonic()
            if (
                not isinstance(created, (int, float))
                or created > now
                or now - float(created) > WINDOW_RESTORE_LEASE_TTL_SECONDS
            ):
                raise ToolError("restore_token expired before use")
            if lease.get("window_id") != identifier:
                raise ToolError("restore_token is bound to a different window container")
            lease_inventory = self._window_restore_inventory_from_lease(lease)
            minimized_inventory_sha256 = self._window_state_inventory_sha256(lease_inventory)
            if inventory_before != lease_inventory:
                raise ToolError(
                    "restore target's immutable workstation window inventory changed since minimize"
                )
            window = next((item for item in windows_before if item.get("id") == identifier), None)
            if window is None:
                raise ToolError("restore target disappeared before capability use")
            identity_sha256 = self._window_state_identity_sha256(window)
            if not hmac.compare_digest(
                identity_sha256, str(lease.get("identity_sha256") or "")
            ):
                raise ToolError("restore target identity no longer matches its one-time capability")
            if window.get("origin_verified") is not True:
                raise ToolError("restore target lost its managed Wayland security-context origin")
            if window.get("scratchpad_state") != "fresh" or window.get("visible") is True:
                raise ToolError(
                    "restore target is not the hidden scratchpad container bound to the capability"
                )
            launch_id = lease.get("launch_id")
            if not isinstance(launch_id, str) or window.get("launch_id") != launch_id:
                raise ToolError("restore target lost its launch attribution")
            if lease.get("scene_id") != window.get("scene_id"):
                raise ToolError("restore target lost its scene attribution")
            managed = self._managed_by_launch_id(launch_id)
            workspace = lease.get("workspace")
            if (
                not isinstance(workspace, str)
                or re.fullmatch(r"sc-(?:launch|scene)-[0-9a-f]{24}", workspace) is None
                or managed.workspace != workspace
            ):
                raise ToolError("restore target's private workspace lease is no longer valid")
            floating_enabled = lease.get("floating_enabled") is True
            original_fullscreen = lease.get("fullscreen") is True
            geometry = lease.get("geometry")
            if not isinstance(geometry, dict):
                raise ToolError("restore capability lost its bounded geometry record")
            x = as_int(geometry.get("x"), 0, self.width - 1, "restore geometry x")
            y = as_int(geometry.get("y"), 0, self.height - 1, "restore geometry y")
            width = as_int(geometry.get("width"), 1, self.width, "restore geometry width")
            height = as_int(geometry.get("height"), 1, self.height, "restore geometry height")
            selector = f'[con_id="{identifier}"]'
            try:
                self._sway_command(f"workspace --no-auto-back-and-forth {workspace}")
                self._sway_command(f"{selector} scratchpad show")
                self._sway_command(f"{selector} move container to workspace {workspace}")
                # Reconstruct and prove the latent windowed layout before optional
                # fullscreen. Public Sway IPC reports output geometry while a node
                # is fullscreen, so geometry cannot be authenticated afterwards.
                self._sway_command(f"{selector} fullscreen disable")
                if floating_enabled:
                    self._sway_command(
                        f"{selector} floating enable, "
                        f"{selector} move absolute position {x} px {y} px, "
                        f"{selector} resize set width {width} px height {height} px"
                    )
                else:
                    # Public Sway IPC cannot reconstruct an arbitrary historical
                    # split-tree slot. Restore the exact tiled class and let the
                    # private compositor insert it deterministically in the live tree.
                    self._sway_command(f"{selector} floating disable")

                _layout_windows, layout_window = self._wait_for_window_state(
                    identifier,
                    identity_sha256,
                    lease_inventory,
                    lambda candidate: (
                        candidate.get("visible") is True
                        and candidate.get("scratchpad_state") == "none"
                        and candidate.get("workspace") == workspace
                        and candidate.get("fullscreen") is False
                        and self._window_layout_matches(
                            candidate,
                            floating_enabled=floating_enabled,
                            geometry={"x": x, "y": y, "width": width, "height": height},
                        )
                    ),
                    "restored to its sealed windowed layout checkpoint",
                )
                layout_checkpoint = {
                    "phase": "windowed-before-final-fullscreen",
                    "verified": True,
                    "floating": floating_enabled,
                    "geometry": (
                        {"x": x, "y": y, "width": width, "height": height}
                        if floating_enabled else None
                    ),
                    "observed_geometry": (
                        self._window_geometry(layout_window) if floating_enabled else None
                    ),
                }
                layout_checkpoint["checkpoint_sha256"] = hashlib.sha256(
                    canonical_json(layout_checkpoint)
                ).hexdigest()

                if original_fullscreen:
                    self._sway_command(f"{selector} fullscreen enable")
                self._sway_command(f"{selector} focus")

                _windows_after, window_after = self._wait_for_window_state(
                    identifier,
                    identity_sha256,
                    lease_inventory,
                    lambda candidate: (
                        candidate.get("visible") is True
                        and candidate.get("scratchpad_state") == "none"
                        and candidate.get("workspace") == workspace
                        and self._window_floating_enabled(candidate) == floating_enabled
                        and bool(candidate.get("fullscreen")) == original_fullscreen
                        and (
                            original_fullscreen
                            or self._window_layout_matches(
                                candidate,
                                floating_enabled=floating_enabled,
                                geometry={"x": x, "y": y, "width": width, "height": height},
                            )
                        )
                        and candidate.get("focused") is True
                    ),
                    "restored on its original private workspace",
                )
                layout_restore = (
                    "exact-floating-geometry" if floating_enabled else "tiled-class-only"
                )
                seal = self._window_state_seal(
                    requested_state=state,
                    before=window,
                    after=window_after,
                    inventory=lease_inventory,
                    changed=True,
                    restore_capability_consumed=True,
                    restore_inventory_verified=True,
                    layout_restore=layout_restore,
                    minimized_inventory_sha256=minimized_inventory_sha256,
                    layout_checkpoint=layout_checkpoint,
                )
                result = json_result({
                    "window_id": identifier,
                    "state": state,
                    "changed": True,
                    "backend": "wayland",
                    "window_state_seal": seal,
                })
            except Exception as restore_error:
                # The capability is intentionally one-attempt and has already
                # been consumed. If compositor dispatch or result publication
                # fails after valid admission, never leave its exact window in
                # the scratchpad merely because no retry token remains. Recover
                # and prove the sealed visible layout from either the untouched
                # hidden member or a partially restored visible origin, then
                # surface the original failure. Inventory or identity drift
                # prevents recovery and is reported as an explicit uncertain
                # state rather than broadening authority.
                try:
                    self._rollback_failed_minimize(
                        identifier=identifier,
                        identity_sha256=identity_sha256,
                        inventory=lease_inventory,
                        workspace=workspace,
                        original_fullscreen=original_fullscreen,
                        floating_enabled=floating_enabled,
                        geometry={"x": x, "y": y, "width": width, "height": height},
                        focus_window_id=identifier,
                    )
                except Exception as recovery_error:
                    raise ToolError(
                        "restore failed after consuming its one-time capability and exact "
                        "visible-state recovery could not be proved"
                    ) from recovery_error
                raise restore_error
            return result

        window = next((item for item in windows_before if item.get("id") == identifier), None)
        if window is None:
            raise ToolError(f"window is not a listed desktop client: {identifier}")
        if window.get("visible") is not True or window.get("scratchpad_state") != "none":
            raise ToolError("window state mutation requires a visible non-scratchpad target")
        identity_sha256 = self._window_state_identity_sha256(window)
        selector = f'[con_id="{identifier}"]'

        if state in {"fullscreen", "windowed"}:
            desired = state == "fullscreen"
            if bool(window.get("fullscreen")) == desired:
                seal = self._window_state_seal(
                    requested_state=state,
                    before=window,
                    after=window,
                    inventory=inventory_before,
                    changed=False,
                )
                return json_result({
                    "window_id": identifier,
                    "state": state,
                    "changed": False,
                    "backend": "wayland",
                    "window_state_seal": seal,
                })
            self._sway_command(f"{selector} fullscreen {'enable' if desired else 'disable'}")
            _windows_after, window_after = self._wait_for_window_state(
                identifier,
                identity_sha256,
                inventory_before,
                lambda candidate: (
                    candidate.get("visible") is True
                    and candidate.get("scratchpad_state") == "none"
                    and bool(candidate.get("fullscreen")) == desired
                ),
                state,
            )
            seal = self._window_state_seal(
                requested_state=state,
                before=window,
                after=window_after,
                inventory=inventory_before,
                changed=True,
            )
            return json_result({
                "window_id": identifier,
                "state": state,
                "changed": True,
                "backend": "wayland",
                "window_state_seal": seal,
            })

        if state in {"floating", "tiled"}:
            desired_floating = state == "floating"
            if self._window_floating_enabled(window) == desired_floating:
                seal = self._window_state_seal(
                    requested_state=state,
                    before=window,
                    after=window,
                    inventory=inventory_before,
                    changed=False,
                )
                return json_result({
                    "window_id": identifier,
                    "state": state,
                    "changed": False,
                    "backend": "wayland",
                    "window_state_seal": seal,
                })
            self._sway_command(
                f"{selector} floating {'enable' if desired_floating else 'disable'}"
            )
            _windows_after, window_after = self._wait_for_window_state(
                identifier,
                identity_sha256,
                inventory_before,
                lambda candidate: (
                    candidate.get("visible") is True
                    and candidate.get("scratchpad_state") == "none"
                    and self._window_floating_enabled(candidate) == desired_floating
                ),
                state,
            )
            seal = self._window_state_seal(
                requested_state=state,
                before=window,
                after=window_after,
                inventory=inventory_before,
                changed=True,
            )
            return json_result({
                "window_id": identifier,
                "state": state,
                "changed": True,
                "backend": "wayland",
                "window_state_seal": seal,
            })

        # Minimize is restricted to a birth-pinned managed launch. The hidden
        # container is no longer visually reviewable, so its only route back is
        # the unforgeable one-time capability returned below.
        if window.get("origin_verified") is not True:
            raise ToolError("minimize requires a managed Wayland security-context origin")
        launch_id = window.get("launch_id")
        if not isinstance(launch_id, str):
            raise ToolError("minimize target has no managed launch attribution")
        managed = self._managed_by_launch_id(launch_id)
        workspace = window.get("workspace")
        if (
            not isinstance(workspace, str)
            or managed.workspace != workspace
            or re.fullmatch(r"sc-(?:launch|scene)-[0-9a-f]{24}", workspace) is None
        ):
            raise ToolError("minimize target is outside its exact private workspace lease")
        focused_before = [
            item for item in windows_before if item.get("focused") is True
        ]
        if len(focused_before) != 1:
            raise ToolError(
                "minimize requires exactly one visible top-level focus identity for rollback"
            )
        rollback_focus_window = focused_before[0]
        rollback_focus_window_id = parse_window_id(rollback_focus_window.get("id"))
        if (
            rollback_focus_window.get("visible") is not True
            or rollback_focus_window.get("scratchpad_state") != "none"
        ):
            raise ToolError(
                "minimize cannot preserve a focus identity outside the visible workstation"
            )
        self._prune_window_restore_leases(windows_before)
        store = self._window_restore_lease_store()
        if any(lease.get("window_id") == identifier for lease in store.values()):
            raise ToolError("window already has an outstanding restore capability")
        if len(store) >= MAX_WINDOW_RESTORE_LEASES:
            raise ToolError("controller restore-capability budget is exhausted")
        original_fullscreen = bool(window.get("fullscreen"))

        def prepare_layout_and_capability(
            layout_window: dict[str, Any],
        ) -> tuple[bool, dict[str, int], str, str]:
            # A fullscreen node's published rect is the output-sized fullscreen
            # rectangle, not the floating rectangle that will reappear after
            # fullscreen is removed. Seal layout only after a windowed-state proof.
            floating = self._window_floating_enabled(layout_window)
            sealed_geometry = {
                "x": as_int(layout_window.get("x"), 0, self.width - 1, "window x"),
                "y": as_int(layout_window.get("y"), 0, self.height - 1, "window y"),
                "width": as_int(layout_window.get("width"), 1, self.width, "window width"),
                "height": as_int(layout_window.get("height"), 1, self.height, "window height"),
            }
            # Mint and validate the caller-held capability before hiding the
            # reviewed window. If fullscreen had to be removed to discover this
            # layout, the caller below restores it on every preparation failure.
            token = secrets.token_urlsafe(WINDOW_RESTORE_TOKEN_BYTES)
            if (
                len(token) != WINDOW_RESTORE_TOKEN_LENGTH
                or re.fullmatch(r"[A-Za-z0-9_-]{43}", token) is None
            ):
                raise ToolError("controller could not mint a canonical restore capability")
            digest = hashlib.sha256(token.encode("ascii")).hexdigest()
            if digest in store:
                raise ToolError("controller restore-capability collision")
            return floating, sealed_geometry, token, digest

        if original_fullscreen:
            try:
                self._sway_command(f"{selector} fullscreen disable")
                _windowed_inventory, layout_window = self._wait_for_window_state(
                    identifier,
                    identity_sha256,
                    inventory_before,
                    lambda candidate: (
                        candidate.get("visible") is True
                        and candidate.get("scratchpad_state") == "none"
                        and candidate.get("workspace") == workspace
                        and candidate.get("fullscreen") is False
                    ),
                    "windowed before private-scratchpad admission",
                )
                floating_enabled, geometry, restore_token, token_sha256 = (
                    prepare_layout_and_capability(layout_window)
                )
            except Exception as preparation_error:
                try:
                    self._rollback_failed_minimize_preparation(
                        identifier=identifier,
                        identity_sha256=identity_sha256,
                        inventory=inventory_before,
                        workspace=workspace,
                        focus_window_id=rollback_focus_window_id,
                    )
                except Exception as rollback_error:
                    raise ToolError(
                        "minimize preparation failed after leaving fullscreen and the exact "
                        "fullscreen/focus rollback could not be proved"
                    ) from rollback_error
                raise preparation_error
        else:
            floating_enabled, geometry, restore_token, token_sha256 = (
                prepare_layout_and_capability(window)
            )
        try:
            self._sway_command(f"{selector} move container to scratchpad")
            _windows_after, window_after = self._wait_for_window_state(
                identifier,
                identity_sha256,
                inventory_before,
                lambda candidate: (
                    candidate.get("visible") is False
                    and candidate.get("scratchpad_state") == "fresh"
                    and candidate.get("fullscreen") is False
                ),
                "minimized in the private scratchpad",
            )
        except Exception as error:
            # Admission can succeed before the bounded waiter sees it. Never
            # strand a hidden container without the capability that is issued
            # only after a proven minimize. Reconstruct and prove the exact
            # reviewed visible state from either safe starting point.
            try:
                self._rollback_failed_minimize(
                    identifier=identifier,
                    identity_sha256=identity_sha256,
                    inventory=inventory_before,
                    workspace=workspace,
                    original_fullscreen=original_fullscreen,
                    floating_enabled=floating_enabled,
                    geometry=geometry,
                    focus_window_id=rollback_focus_window_id,
                )
            except Exception as rollback_error:
                raise ToolError(
                    "minimize failed and exact visible-state rollback could not be proved"
                ) from rollback_error
            raise error
        # Hidden state and capability publication form one transaction.  Build
        # every fallible response artifact before retaining the digest-keyed
        # lease, then make that insertion the final operation before return. If
        # seal/result construction or lease insertion fails, erase any partial
        # lease and prove the exact pre-minimize visible state before surfacing
        # the original error. This closes the post-admission gap in which a
        # hidden window could otherwise exist without a token known to the
        # caller.
        try:
            restore_lease = {
                "schema": WINDOW_RESTORE_LEASE_SCHEMA,
                "window_id": identifier,
                "identity_sha256": identity_sha256,
                "inventory": dict(inventory_before),
                "inventory_sha256": inventory_before_sha256,
                "launch_id": launch_id,
                "scene_id": window.get("scene_id"),
                "workspace": workspace,
                "fullscreen": original_fullscreen,
                "floating_enabled": floating_enabled,
                "geometry": geometry,
                "created_monotonic": time.monotonic(),
            }
            seal = self._window_state_seal(
                requested_state=state,
                before=window,
                after=window_after,
                inventory=inventory_before,
                changed=True,
                restore_capability_issued=True,
                layout_restore=(
                    "exact-floating-geometry" if floating_enabled else "tiled-class-only"
                ),
                minimized_inventory_sha256=inventory_before_sha256,
            )
            result = json_result({
                "window_id": identifier,
                "state": state,
                "changed": True,
                "backend": "wayland",
                "restore_token": restore_token,
                "restore_token_policy": (
                    "one-time+controller-memory-only+exact-window-origin-bound+"
                    "exact-window-inventory-bound+"
                    f"expires-after-{int(WINDOW_RESTORE_LEASE_TTL_SECONDS)}-seconds"
                ),
                "window_state_seal": seal,
            })
            store[token_sha256] = restore_lease
        except Exception as publication_error:
            store.pop(token_sha256, None)
            try:
                self._rollback_failed_minimize(
                    identifier=identifier,
                    identity_sha256=identity_sha256,
                    inventory=inventory_before,
                    workspace=workspace,
                    original_fullscreen=original_fullscreen,
                    floating_enabled=floating_enabled,
                    geometry=geometry,
                    focus_window_id=rollback_focus_window_id,
                )
            except Exception as rollback_error:
                raise ToolError(
                    "minimize admission was proved but capability publication failed "
                    "and exact visible-state rollback could not be proved"
                ) from rollback_error
            raise publication_error
        return result

    def close_window(self, arguments: dict[str, Any]) -> dict[str, Any]:
        identifier = parse_window_id(arguments.get("window_id"))
        force = as_bool(arguments.get("force", False), "force")
        if self.is_wayland:
            if not any(item["id"] == identifier for item in self._wayland_windows()):
                raise ToolError(f"window is not a listed desktop client: {identifier}")
            # Sway's kill command asks Wayland clients to close and disconnects an
            # unresponsive client. It remains confined to this private compositor.
            self._sway_command(f'[con_id="{identifier}"] kill')
            return json_result({"close_requested": True, "window_id": identifier, "force": force, "backend": "wayland"})

        window = self._controllable_window(identifier)
        try:
            if force:
                window.kill_client()
            else:
                wm_protocols = self.display.intern_atom("WM_PROTOCOLS")
                wm_delete = self.display.intern_atom("WM_DELETE_WINDOW")
                protocols = window.get_wm_protocols() or []
                if wm_delete in protocols:
                    event = protocol.event.ClientMessage(
                        window=identifier,
                        client_type=wm_protocols,
                        data=(32, [wm_delete, X.CurrentTime, 0, 0, 0]),
                    )
                    window.send_event(event, propagate=False)
                else:
                    close_atom = self.display.intern_atom("_NET_CLOSE_WINDOW")
                    event = protocol.event.ClientMessage(
                        window=identifier,
                        client_type=close_atom,
                        data=(32, [X.CurrentTime, 2, 0, 0, 0]),
                    )
                    self.root.send_event(event, event_mask=X.SubstructureRedirectMask | X.SubstructureNotifyMask)
            self._sync()
        except (xerror.BadWindow, xerror.BadAtom) as error:
            raise ToolError(f"window does not exist: {identifier}") from error
        return json_result({"close_requested": True, "window_id": identifier, "force": force, "backend": "x11"})

    def accessibility_snapshot(self, arguments: dict[str, Any]) -> dict[str, Any]:
        return json_result(self.accessibility.snapshot(arguments))

    def accessibility_events(self, arguments: dict[str, Any]) -> dict[str, Any]:
        """Read a launch- or scene-scoped EventPulseSeal stream.

        Scope acquisition and post-wait revalidation use the controller lock,
        but the bounded long-poll itself does not.  This keeps a 30-second
        semantic wait from freezing screenshots, process custody, or another
        exact launch's interaction.
        """
        launch_present = arguments.get("launch_id") is not None
        scene_present = arguments.get("scene_id") is not None
        if launch_present == scene_present:
            raise ToolError("provide exactly one of launch_id or scene_id")
        expected_scene: tuple[str, ...] | None = None
        with self.lock:
            if launch_present:
                if arguments.get("scene_launch_ids") is not None:
                    raise ToolError("scene_launch_ids may be used only with scene_id")
                managed = self._managed_by_launch_id(arguments.get("launch_id"))
                scope = {
                    "kind": "launch",
                    "launch_ids": [managed.launch_id],
                    "scene_id": None,
                }
            else:
                launch_ids_value = arguments.get("scene_launch_ids")
                if (
                    not isinstance(launch_ids_value, list)
                    or not 2 <= len(launch_ids_value) <= SCENE_SET_MAX_LAUNCHES
                ):
                    raise ToolError(
                        f"scene_launch_ids must contain from 2 through {SCENE_SET_MAX_LAUNCHES} launch IDs"
                    )
                normalized = [
                    as_string(
                        value,
                        f"scene_launch_ids[{index}]",
                        maximum=128,
                        allow_empty=False,
                    )
                    for index, value in enumerate(launch_ids_value)
                ]
                if len(set(normalized)) != len(normalized):
                    raise ToolError("scene_launch_ids must be unique")
                expected_scene = tuple(sorted(normalized))
                members = self._managed_scene(
                    arguments.get("scene_id"),
                    expected_launch_ids=expected_scene,
                )
                scope = {
                    "kind": "scene",
                    "launch_ids": [managed.launch_id for managed in members],
                    "scene_id": members[0].scene_id,
                }
        result = self.accessibility.events(arguments, scope)
        with self.lock:
            if scope["kind"] == "launch":
                self._managed_by_launch_id(scope["launch_ids"][0])
            else:
                assert expected_scene is not None
                self._managed_scene(scope["scene_id"], expected_launch_ids=expected_scene)
        return json_result(result)

    def accessibility_action(self, arguments: dict[str, Any]) -> dict[str, Any]:
        return json_result(self.accessibility.action(arguments))

    def accessibility_focus(self, arguments: dict[str, Any]) -> dict[str, Any]:
        result = self.accessibility.focus(arguments)
        if as_bool(arguments.get("move_pointer", False), "move_pointer"):
            bounds = result.get("bounds")
            if isinstance(bounds, dict) and bounds.get("width", 0) > 0 and bounds.get("height", 0) > 0:
                x = max(0, min(self.width - 1, bounds["x"] + bounds["width"] // 2))
                y = max(0, min(self.height - 1, bounds["y"] + bounds["height"] // 2))
                self._move(x, y)
                result["pointer"] = {"x": x, "y": y}
        return json_result(result)

