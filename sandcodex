+	uint64_t expected_second_sy_bits[SANDCODEX_TOUCH_GESTURE_MAX_POINTS] = {0};
+	if (grant->touch_stroke_steps <= SANDCODEX_TOUCH_GESTURE_MAX_STEPS) {
+		size_t bytes = (grant->touch_stroke_steps + 1) * sizeof(uint64_t);
+		memcpy(expected_first_sx_bits, grant->touch_gesture_first_sx_bits, bytes);
+		memcpy(expected_first_sy_bits, grant->touch_gesture_first_sy_bits, bytes);
+		memcpy(expected_second_sx_bits, grant->touch_gesture_second_sx_bits, bytes);
+		memcpy(expected_second_sy_bits, grant->touch_gesture_second_sy_bits, bytes);
