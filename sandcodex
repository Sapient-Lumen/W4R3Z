sc_write_gemini_parent_provider_contract() {
  [[ "$SC_PROVIDER_MODE" == gemini ]] || return 0
  [[ -n "$SC_GEMINI_SNAPSHOT" && -n "$SC_GEMINI_ADAPTER_SCRIPT" &&
     -n "$SC_GEMINI_ADAPTER_TOKEN_FILE" && -n "$SC_GEMINI_QUALIFICATION" ]] ||
    sc_die "Gemini companion authority requires a prepared and qualified adapter" 78
  [[ "$SC_GEMINI_ADAPTER_PID" =~ ^[1-9][0-9]*$ && "$SC_GEMINI_ADAPTER_START" =~ ^[1-9][0-9]*$ ]] ||
    sc_die "Gemini companion authority cannot identify its adapter process" 78
  sc_pid_still_matches "$SC_GEMINI_ADAPTER_PID" "$SC_GEMINI_ADAPTER_START" ||
    sc_die "Gemini companion authority adapter is no longer live" 78
  local descriptor snapshot_sha adapter_sha token_sha qualification_sha source candidates failover_policy
  local account_start_policy
  descriptor=${SC_GEMINI_NATIVE_PROVIDER#scg_}
  [[ "$descriptor" =~ ^[0-9a-f]{64}$ ]] || sc_die "Gemini companion authority has no descriptor identity" 78
  for source in "$SC_GEMINI_SNAPSHOT" "$SC_GEMINI_ADAPTER_SCRIPT" \
    "$SC_GEMINI_ADAPTER_TOKEN_FILE" "$SC_GEMINI_QUALIFICATION"; do
    [[ "$source" == /* ]] || sc_die "Gemini companion authority path is not absolute" 78
    sc_no_symlink_components "$source" "Gemini companion authority input"
  done
  sc_owned_single_file "$SC_GEMINI_SNAPSHOT" 600 "Gemini companion provider snapshot"
  sc_owned_single_file "$SC_GEMINI_ADAPTER_SCRIPT" 500 "Gemini companion adapter"
  sc_owned_single_file "$SC_GEMINI_ADAPTER_TOKEN_FILE" 600 "Gemini companion adapter token"
  sc_owned_single_file "$SC_GEMINI_QUALIFICATION" 600 "Gemini companion qualification receipt"
  snapshot_sha=$(sha256sum -- "$SC_GEMINI_SNAPSHOT" | awk '{print $1}')
  adapter_sha=$(sha256sum -- "$SC_GEMINI_ADAPTER_SCRIPT" | awk '{print $1}')
  token_sha=$(sha256sum -- "$SC_GEMINI_ADAPTER_TOKEN_FILE" | awk '{print $1}')
  qualification_sha=$(sha256sum -- "$SC_GEMINI_QUALIFICATION" | awk '{print $1}')
  [[ "$snapshot_sha" == "$descriptor" && "$adapter_sha" == "$SC_GEMINI_ADAPTER_SHA256" &&
     "$qualification_sha" == "$SC_GEMINI_QUALIFICATION_SHA256" ]] ||
    sc_die "Gemini companion authority evidence digest changed" 78
  candidates=$(jq -c '.candidate_models' "$SC_GEMINI_SNAPSHOT")
  failover_policy=$(jq -er '.adapter.failover' "$SC_GEMINI_SNAPSHOT")
  account_start_policy=$(jq -er \
    '.capabilities.account_start_policy // "bank-order-from-first-healthy"' \
    "$SC_GEMINI_SNAPSHOT")
  case "$failover_policy" in
    origin-first-signed-continuation-then-strongest-model-account-key-rotation-before-visible-output|origin-first-signed-continuation-then-ranked-model-primary-credential-auth-standby-before-visible-output) ;;
    *) sc_die "Gemini companion authority has an unknown adapter failover contract" 78 ;;
  esac
  case "$account_start_policy" in
    per-logical-request-round-robin|bank-order-from-first-healthy) ;;
    *) sc_die "Gemini companion authority has an unknown account-start policy" 78 ;;
  esac
  SC_CAMPAIGN_PROVIDER_CONTRACT="$SC_CONTROL/campaign-gemini-provider.json"
  jq -n \
    --arg schema "$SC_GEMINI_PARENT_PROVIDER_SCHEMA" --arg created_at "$(sc_now)" \
    --arg artifact_sha256 "$(sc_artifact_sha256)" --arg run_id "$SC_RUN_ID" \
    --argjson parent_pid "$$" --arg parent_process_start "$SC_PROCESS_START" \
    --argjson adapter_pid "$SC_GEMINI_ADAPTER_PID" --arg adapter_process_start "$SC_GEMINI_ADAPTER_START" \
    --argjson adapter_port "$SC_GEMINI_ADAPTER_HOST_PORT" --arg adapter_path "$SC_GEMINI_ADAPTER_SCRIPT" \
    --arg adapter_sha "$adapter_sha" --arg token_path "$SC_GEMINI_ADAPTER_TOKEN_FILE" --arg token_sha "$token_sha" \
    --arg native_provider "$SC_GEMINI_NATIVE_PROVIDER" --arg descriptor "$descriptor" \
    --arg routing_model "$SC_MODEL" --argjson auto "$SC_GEMINI_AUTO" --argjson candidates "$candidates" \
    --argjson route_wait "$SC_GEMINI_ROUTE_WAIT_SECONDS" \
    --arg failover_policy "$failover_policy" \
    --arg account_start_policy "$account_start_policy" \
    --arg state_schema "$SC_GEMINI_ADAPTER_STATE_SCHEMA" --arg snapshot "$SC_GEMINI_SNAPSHOT" \
    --arg snapshot_sha "$snapshot_sha" --arg qualification "$SC_GEMINI_QUALIFICATION" \
    --arg qualification_sha "$qualification_sha" '
      {schema:$schema,created_at:$created_at,artifact_sha256:$artifact_sha256,
       parent:{run_id:$run_id,pid:$parent_pid,process_start:$parent_process_start},
       provider:{native:$native_provider,descriptor_sha256:$descriptor,
                 upstream:"google-ai-studio",upstream_api:"gemini-interactions-v1",
                 wire_api:"responses"},
       adapter:{pid:$adapter_pid,process_start:$adapter_process_start,host:"127.0.0.1",
                port:$adapter_port,path:$adapter_path,sha256:$adapter_sha,
                token_file:$token_path,token_sha256:$token_sha},
       route:{routing_model:$routing_model,auto:($auto==1),free_only:true,
              candidate_models:$candidates,state_schema:$state_schema,
              failover_policy:$failover_policy,
              account_start_policy:$account_start_policy,
              route_wait_seconds:$route_wait},
       runtime:{snapshot:$snapshot,snapshot_sha256:$snapshot_sha,
                qualification_receipt:$qualification,
                qualification_receipt_sha256:$qualification_sha},
       sharing:{inference_processes:"concurrent",adapter_max_concurrency:8,
                raw_google_credentials_delegated:false,
                queue_policy:"shared credential-isolating parent adapter"}}' |
    sc_atomic "$SC_CAMPAIGN_PROVIDER_CONTRACT" 600
}

sc_family_prepare_inherited_gemini() {
  local contract=${SANDCODEX_GEMINI_PARENT_CONTRACT:-} expected_contract=${SANDCODEX_GEMINI_PARENT_CONTRACT_SHA256:-}
  [[ -n "$contract" ]] || return 1
  [[ "$SC_COMMAND" == loop && "${SANDCODEX_SUPERVISED:-0}" == 1 ]] ||
    sc_die "a parent Gemini-provider capability is valid only for a supervised companion loop" 77
  sc_no_line_breaks "$contract" "parent Gemini-provider contract"
  [[ "$contract" == /* ]] || sc_die "parent Gemini-provider contract must be absolute" 77
  contract=$(readlink -f -- "$contract" 2>/dev/null || true)
  [[ -n "$contract" ]] || sc_die "parent Gemini-provider contract is unavailable" 77
  sc_no_symlink_components "$contract" "parent Gemini-provider contract"
  sc_owned_single_file "$contract" 600 "parent Gemini-provider contract"
  [[ "$expected_contract" =~ ^[0-9a-f]{64}$ && "$(sha256sum -- "$contract" | awk '{print $1}')" == "$expected_contract" ]] ||
    sc_die "parent Gemini-provider contract digest differs from delegated authority" 78
  jq -e --arg schema "$SC_GEMINI_PARENT_PROVIDER_SCHEMA" --arg state "$SC_GEMINI_ADAPTER_STATE_SCHEMA" '
      type=="object" and .schema==$schema and
      (.artifact_sha256|test("^[0-9a-f]{64}$")) and
      (.parent.run_id|type)=="string" and (.parent.pid|type)=="number" and
      (.parent.process_start|test("^[1-9][0-9]*$")) and
      (.provider.native|test("^scg_[0-9a-f]{64}$")) and
      (.provider.descriptor_sha256|test("^[0-9a-f]{64}$")) and
      .provider.upstream=="google-ai-studio" and
      .provider.upstream_api=="gemini-interactions-v1" and .provider.wire_api=="responses" and
      (.adapter.pid|type)=="number" and (.adapter.process_start|test("^[1-9][0-9]*$")) and
      .adapter.host=="127.0.0.1" and (.adapter.port|type)=="number" and
      .adapter.port>=1 and .adapter.port<=65535 and
      (.adapter.path|type)=="string" and (.adapter.sha256|test("^[0-9a-f]{64}$")) and
      (.adapter.token_file|type)=="string" and (.adapter.token_sha256|test("^[0-9a-f]{64}$")) and
      (.route.routing_model|type)=="string" and (.route.auto|type)=="boolean" and
      .route.free_only==true and (.route.candidate_models|type)=="array" and
      (.route.candidate_models|length)>0 and .route.state_schema==$state and
      (.route.failover_policy=="origin-first-signed-continuation-then-strongest-model-account-key-rotation-before-visible-output" or
       .route.failover_policy=="origin-first-signed-continuation-then-ranked-model-primary-credential-auth-standby-before-visible-output") and
      (.route.account_start_policy=="per-logical-request-round-robin" or
       .route.account_start_policy=="bank-order-from-first-healthy") and
      (.route.route_wait_seconds|type)=="number" and .route.route_wait_seconds>=0 and
      .route.route_wait_seconds<=3600 and (.route.route_wait_seconds|floor)==.route.route_wait_seconds and
      (.runtime.snapshot|type)=="string" and (.runtime.snapshot_sha256|test("^[0-9a-f]{64}$")) and
      (.runtime.qualification_receipt|type)=="string" and
      (.runtime.qualification_receipt_sha256|test("^[0-9a-f]{64}$")) and
      .sharing.raw_google_credentials_delegated==false and .sharing.adapter_max_concurrency==8
    ' "$contract" >/dev/null || sc_die "parent Gemini-provider contract is malformed" 78
  [[ "$(jq -er '.artifact_sha256' "$contract")" == "$(sc_artifact_sha256)" ]] ||
    sc_die "parent Gemini-provider contract names different launcher bytes" 78
  local parent_pid parent_start adapter_pid adapter_start descriptor routing auto route_wait snapshot snapshot_sha
  local adapter adapter_sha token token_sha qualification qualification_sha source health code token_value
  parent_pid=$(jq -er '.parent.pid' "$contract"); parent_start=$(jq -er '.parent.process_start' "$contract")
  adapter_pid=$(jq -er '.adapter.pid' "$contract"); adapter_start=$(jq -er '.adapter.process_start' "$contract")
  sc_pid_still_matches "$parent_pid" "$parent_start" || sc_die "parent command room no longer owns the Gemini capability" 77
  sc_pid_still_matches "$adapter_pid" "$adapter_start" || sc_die "delegated Gemini adapter is no longer live" 78
  descriptor=$(jq -er '.provider.descriptor_sha256' "$contract")
  [[ "$(jq -er '.provider.native' "$contract")" == "scg_$descriptor" ]] ||
    sc_die "parent Gemini native provider conflicts with its descriptor" 78
  routing=$(jq -er '.route.routing_model' "$contract")
  auto=$(jq -r 'if .route.auto then 1 else 0 end' "$contract")
  route_wait=$(jq -er '.route.route_wait_seconds' "$contract")
  snapshot=$(jq -er '.runtime.snapshot' "$contract"); snapshot_sha=$(jq -er '.runtime.snapshot_sha256' "$contract")
  adapter=$(jq -er '.adapter.path' "$contract"); adapter_sha=$(jq -er '.adapter.sha256' "$contract")
  token=$(jq -er '.adapter.token_file' "$contract"); token_sha=$(jq -er '.adapter.token_sha256' "$contract")
  qualification=$(jq -er '.runtime.qualification_receipt' "$contract")
  qualification_sha=$(jq -er '.runtime.qualification_receipt_sha256' "$contract")
  for source in "$snapshot" "$adapter" "$token" "$qualification"; do
    [[ "$source" == /* ]] || sc_die "parent Gemini evidence path is not absolute" 78
    sc_no_symlink_components "$source" "parent Gemini evidence"
  done
  sc_owned_single_file "$snapshot" 600 "parent Gemini snapshot"
  sc_owned_single_file "$adapter" 500 "parent Gemini adapter"
  sc_owned_single_file "$token" 600 "parent Gemini adapter token"
  sc_owned_single_file "$qualification" 600 "parent Gemini qualification"
  [[ "$(sha256sum -- "$snapshot" | awk '{print $1}')" == "$snapshot_sha" &&
     "$(sha256sum -- "$adapter" | awk '{print $1}')" == "$adapter_sha" &&
     "$(sha256sum -- "$token" | awk '{print $1}')" == "$token_sha" &&
     "$(sha256sum -- "$qualification" | awk '{print $1}')" == "$qualification_sha" ]] ||
    sc_die "parent Gemini evidence bytes changed" 78
  [[ "$snapshot_sha" == "$descriptor" ]] || sc_die "parent Gemini snapshot digest conflicts with its descriptor" 78

  sc_ensure_dir "$SC_CONTROL/gemini-adapters" "project Gemini adapter store"
  SC_GEMINI_ADAPTER_SCRIPT="$SC_CONTROL/gemini-adapters/$adapter_sha.py"
  if [[ -e "$SC_GEMINI_ADAPTER_SCRIPT" || -L "$SC_GEMINI_ADAPTER_SCRIPT" ]]; then
    sc_owned_single_file "$SC_GEMINI_ADAPTER_SCRIPT" 500 "inherited Gemini adapter"
    cmp -s -- "$adapter" "$SC_GEMINI_ADAPTER_SCRIPT" || sc_die "inherited Gemini adapter conflicts" 78
  else
    sc_atomic "$SC_GEMINI_ADAPTER_SCRIPT" 500 <"$adapter"
  fi
  SC_GEMINI_ADAPTER_SHA256=$adapter_sha
  python3 -P "$SC_GEMINI_ADAPTER_SCRIPT" self-test >/dev/null ||
    sc_die "inherited Gemini adapter failed its offline self-test" 78
  sc_ensure_dir "$SC_CONTROL/gemini-providers" "project Gemini provider snapshots"
  SC_GEMINI_SNAPSHOT="$SC_CONTROL/gemini-providers/$descriptor.json"
  if [[ -e "$SC_GEMINI_SNAPSHOT" || -L "$SC_GEMINI_SNAPSHOT" ]]; then
    sc_owned_single_file "$SC_GEMINI_SNAPSHOT" 600 "inherited Gemini snapshot"
    cmp -s -- "$snapshot" "$SC_GEMINI_SNAPSHOT" || sc_die "inherited Gemini snapshot conflicts" 78
  else
    sc_atomic "$SC_GEMINI_SNAPSHOT" 600 <"$snapshot"
  fi
  sc_ensure_dir "$SC_CONTROL/gemini-qualifications" "project Gemini qualification receipts"
  SC_GEMINI_QUALIFICATION="$SC_CONTROL/gemini-qualifications/$qualification_sha.json"
  if [[ -e "$SC_GEMINI_QUALIFICATION" || -L "$SC_GEMINI_QUALIFICATION" ]]; then
    sc_owned_single_file "$SC_GEMINI_QUALIFICATION" 600 "inherited Gemini qualification"
    cmp -s -- "$qualification" "$SC_GEMINI_QUALIFICATION" || sc_die "inherited Gemini qualification conflicts" 78
  else
    sc_atomic "$SC_GEMINI_QUALIFICATION" 600 <"$qualification"
  fi
  sc_ensure_dir "$SC_CONTROL/codex-home" "project Codex home"
  SC_GEMINI_ADAPTER_TOKEN_FILE="$SC_CONTROL/codex-home/gemini-adapter-token"
  sc_atomic "$SC_GEMINI_ADAPTER_TOKEN_FILE" 600 <"$token"
  SC_GEMINI_NATIVE_PROVIDER="scg_$descriptor"
  SC_GEMINI_SNAPSHOT_SHA256=$descriptor
  SC_GEMINI_QUALIFICATION_SHA256=$qualification_sha
  SC_GEMINI_BOUND_QUALIFICATION=1
  SC_GEMINI_AUTO=$auto
  SC_GEMINI_ROUTE_WAIT_SECONDS=$route_wait
  SC_MODEL=$routing; SC_MODEL_SET=1
  SC_GEMINI_ADAPTER_HOST_PORT=$(jq -er '.adapter.port' "$contract")
  SC_PROVIDER_BRIDGE_HOST_PORT=$SC_GEMINI_ADAPTER_HOST_PORT
  sc_gemini_runtime_prepare
  health="$SC_GEMINI_RUNTIME_ROOT/inherited-gemini-health.json"
  token_value=$(<"$SC_GEMINI_ADAPTER_TOKEN_FILE")
  code=$(curl -sS --max-time 10 -o "$health" -w '%{http_code}' \
    -H "Authorization: Bearer $token_value" "http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/health") || {
    token_value=""; sc_die "inherited Gemini adapter health check failed" 78;
  }
  token_value=""
  if [[ "$code" != 200 ]] || ! jq -e --arg schema "$SC_GEMINI_ADAPTER_SCHEMA" --arg route "$routing" \
      --argjson route_wait "$route_wait" \
      '.schema==$schema and .status=="ready" and .routing_model==$route and
       (.route_wait_seconds // 0)==$route_wait and .credential_values_disclosed==false' \
      "$health" >/dev/null; then
    sc_die "inherited Gemini adapter health identity differs" 78
  fi
  sc_gemini_adapter_load_snapshot "$SC_GEMINI_SNAPSHOT"
  sc_gemini_adapter_bound_qualification_valid "$SC_GEMINI_QUALIFICATION" ||
    sc_die "inherited Gemini qualification receipt is invalid" 78
  sc_gemini_adapter_configure_codex
  sc_note "Gemini companion · inherited parent adapter · descriptor $descriptor · raw Google keys not delegated"
  return 0
}

sc_remote_configure_codex_from_snapshot() {
  local config host visible descriptor
  [[ -n "$SC_REMOTE_SNAPSHOT" && -n "$SC_REMOTE_TOKEN_FILE" && -n "$SC_REMOTE_NATIVE_PROVIDER" ]] ||
    sc_die "remote provider configuration is incomplete" 78
  sc_owned_single_file "$SC_REMOTE_SNAPSHOT" 600 "remote provider snapshot"
  sc_owned_single_file "$SC_REMOTE_TOKEN_FILE" 600 "remote provider token"
  config=$(jq -c . "$SC_REMOTE_SNAPSHOT")
  host=$(python3 -P - "$(jq -r '.base_url' <<<"$config")" <<'PY'
from urllib.parse import urlsplit
import sys
url = urlsplit(sys.argv[1])
print(url.hostname or "")
PY
)
  descriptor=${SC_REMOTE_NATIVE_PROVIDER#scr_}
  visible="$SC_SANDBOX_CONTROL/codex-home/remote-api-token"
  (( ! SC_BARE )) || visible=$SC_REMOTE_TOKEN_FILE
  printf -v SC_REMOTE_TOP_CONFIG 'model_provider = "%s"\n' "$SC_REMOTE_NATIVE_PROVIDER"
  printf -v SC_REMOTE_PROVIDER_CONFIG '\n[model_providers.%s]\nname = %s\nbase_url = %s\nwire_api = "responses"\nrequires_openai_auth = false\n[model_providers.%s.auth]\ncommand = %s\nargs = [%s]\n' \
    "$SC_REMOTE_NATIVE_PROVIDER" "$(sc_toml "$(jq -r '.name' <<<"$config")")" \
    "$(sc_toml "$(jq -r '.base_url' <<<"$config")")" "$SC_REMOTE_NATIVE_PROVIDER" \
    "$(sc_toml "$(command -v cat)")" "$(sc_toml "$visible")"
  case "$host" in ""|127.0.0.1|localhost|::1) ;; *) SC_DOMAINS+=("$host") ;; esac
  sc_note "remote · $(jq -r '.name' <<<"$config") · model $SC_MODEL · endpoint snapshot $descriptor"
}

sc_family_prepare_inherited_remote() {
  local contract=${SANDCODEX_REMOTE_PARENT_CONTRACT:-} expected_contract=${SANDCODEX_REMOTE_PARENT_CONTRACT_SHA256:-}
  [[ -n "$contract" ]] || return 1
  [[ "$SC_COMMAND" == loop && "${SANDCODEX_SUPERVISED:-0}" == 1 ]] ||
    sc_die "a parent remote-provider capability is valid only for a supervised companion loop" 77
  sc_no_line_breaks "$contract" "parent remote-provider contract"
  [[ "$contract" == /* ]] || sc_die "parent remote-provider contract must be absolute" 77
  contract=$(readlink -f -- "$contract" 2>/dev/null || true)
  [[ -n "$contract" ]] || sc_die "parent remote-provider contract is unavailable" 77
  sc_no_symlink_components "$contract" "parent remote-provider contract"
  sc_owned_single_file "$contract" 600 "parent remote-provider contract"
  [[ "$expected_contract" =~ ^[0-9a-f]{64}$ && "$(sha256sum -- "$contract" | awk '{print $1}')" == "$expected_contract" ]] ||
    sc_die "parent remote-provider contract digest differs from delegated authority" 78
  jq -e --arg schema "$SC_REMOTE_PARENT_PROVIDER_SCHEMA" '
      type=="object" and .schema==$schema and
      (.artifact_sha256|type)=="string" and (.artifact_sha256|test("^[0-9a-f]{64}$")) and
      (.parent.run_id|type)=="string" and (.parent.pid|type)=="number" and
      (.parent.process_start|type)=="string" and (.parent.process_start|test("^[1-9][0-9]*$")) and
      (.provider.native|type)=="string" and (.provider.native|test("^scr_[0-9a-f]{64}$")) and
      (.provider.name|type)=="string" and (.provider.descriptor_sha256|type)=="string" and
      (.provider.descriptor_sha256|test("^[0-9a-f]{64}$")) and
      (.provider.base_url|type)=="string" and .provider.wire_api=="responses" and
      (.provider.env_key|type)=="string" and
      (.model.requested|type)=="string" and
      (.model.identity_policy|type)=="string" and
      (.runtime.snapshot|type)=="string" and (.runtime.snapshot_sha256|test("^[0-9a-f]{64}$")) and
      (.runtime.credential_file|type)=="string" and
      (.runtime.qualification_receipt|type)=="string" and
      (.runtime.qualification_receipt_sha256|test("^[0-9a-f]{64}$")) and
      (.runtime.qualification_probe_version|type)=="string"
    ' "$contract" >/dev/null || sc_die "parent remote-provider contract is malformed" 78
  [[ "$(jq -er '.artifact_sha256' "$contract")" == "$(sc_artifact_sha256)" ]] ||
    sc_die "parent remote-provider contract names different launcher bytes" 78
  local parent_pid parent_start descriptor requested snapshot snapshot_sha token qualification qualification_sha probe model_policy source
  parent_pid=$(jq -er '.parent.pid' "$contract"); parent_start=$(jq -er '.parent.process_start' "$contract")
  sc_pid_still_matches "$parent_pid" "$parent_start" || sc_die "parent command room no longer owns the remote-provider capability" 77
  descriptor=$(jq -er '.provider.descriptor_sha256' "$contract")
  requested=$(jq -er '.model.requested' "$contract")
  [[ "$SC_MODEL" == "$requested" ]] || sc_die "companion requested a model different from its parent remote-provider capability" 64
  snapshot=$(jq -er '.runtime.snapshot' "$contract"); snapshot_sha=$(jq -er '.runtime.snapshot_sha256' "$contract")
  token=$(jq -er '.runtime.credential_file' "$contract")
  qualification=$(jq -er '.runtime.qualification_receipt' "$contract")
  qualification_sha=$(jq -er '.runtime.qualification_receipt_sha256' "$contract")
  probe=$(jq -er '.runtime.qualification_probe_version' "$contract")
  model_policy=$(jq -er '.model.identity_policy' "$contract")
  for source in "$snapshot" "$token" "$qualification"; do
    [[ "$source" == /* ]] || sc_die "parent remote-provider evidence path is not absolute" 78
    sc_no_symlink_components "$source" "parent remote-provider evidence"
    sc_owned_single_file "$source" 600 "parent remote-provider evidence"
  done
  [[ "$(sha256sum -- "$snapshot" | awk '{print $1}')" == "$snapshot_sha" &&
      "$(sha256sum -- "$qualification" | awk '{print $1}')" == "$qualification_sha" ]] ||
    sc_die "parent remote-provider evidence bytes changed" 78
  SC_REMOTE_NATIVE_PROVIDER="scr_$descriptor"
  sc_ensure_dir "$SC_CONTROL/remote-providers" "project provider snapshots"
  SC_REMOTE_SNAPSHOT="$SC_CONTROL/remote-providers/$descriptor.json"
  if [[ -e "$SC_REMOTE_SNAPSHOT" || -L "$SC_REMOTE_SNAPSHOT" ]]; then
    sc_owned_single_file "$SC_REMOTE_SNAPSHOT" 600 "inherited remote provider snapshot"
    [[ "$(jq -cS . "$SC_REMOTE_SNAPSHOT")" == "$(jq -cS . "$snapshot")" ]] ||
      sc_die "inherited remote provider snapshot changed" 78
  else
    sc_atomic "$SC_REMOTE_SNAPSHOT" 600 <"$snapshot"
  fi
  sc_ensure_dir "$SC_CONTROL/remote-qualifications" "project remote qualification receipts"
  SC_REMOTE_QUALIFICATION="$SC_CONTROL/remote-qualifications/$qualification_sha.json"
  if [[ -e "$SC_REMOTE_QUALIFICATION" || -L "$SC_REMOTE_QUALIFICATION" ]]; then
    sc_owned_single_file "$SC_REMOTE_QUALIFICATION" 600 "inherited remote qualification receipt"
    [[ "$(sha256sum -- "$SC_REMOTE_QUALIFICATION" | awk '{print $1}')" == "$qualification_sha" ]] ||
      sc_die "inherited remote qualification receipt changed" 78
  else
    sc_atomic "$SC_REMOTE_QUALIFICATION" 600 <"$qualification"
  fi
  SC_REMOTE_QUALIFICATION_SHA256=$qualification_sha
  SC_REMOTE_QUALIFICATION_PROBE_VERSION=$probe
  SC_REMOTE_QUALIFICATION_MODEL_POLICY=$model_policy
  sc_ensure_dir "$SC_CONTROL/codex-home" "project Codex home"
  SC_REMOTE_TOKEN_FILE="$SC_CONTROL/codex-home/remote-api-token"
  sc_atomic "$SC_REMOTE_TOKEN_FILE" 600 <"$token"
  SC_REMOTE_BOUND_QUALIFICATION=1
  sc_remote_qualify_launch "$descriptor"
  sc_remote_configure_codex_from_snapshot
  sc_note "remote companion · inherited parent provider · descriptor $descriptor"
  return 0
}

