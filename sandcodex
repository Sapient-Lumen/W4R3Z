        }, evidence

    def _dispatch_compositor_guarded_drag_press(
        self,
        route: dict[str, Any],
        point_index: int,
        button: int,
    ) -> dict[str, Any] | None:
        """Press one drag button inside the exact private-Sway recipient callback."""
        points = route.get("points")
        if not isinstance(points, list) or not 0 <= point_index < len(points):
            raise ToolError("compositor drag-press route point is unavailable")
        record = points[point_index]
        point = record.get("point") if isinstance(record, dict) else None
        if (
            not isinstance(point, list)
            or len(point) != 2
            or any(type(value) is not int for value in point)
        ):
            raise ToolError("compositor drag-press route point is malformed")
        x, y = point
        actual = self.pointer_position()
        if actual.get("x") != x or actual.get("y") != y:
            raise ToolError("compositor drag-press cursor changed from its reviewed route")
        if not self.is_wayland:
            self._press_pointer_button(button)
            return None
        transaction = getattr(self, "_active_pointer_transaction", None)
        if transaction is None or transaction.closed:
            raise ToolError("compositor drag-press lost its birth-pinned virtual pointer")
        if transaction.held_button is not None or transaction.compositor_held_button is not None:
            raise ToolError("compositor drag-press found pre-existing button authority")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor drag-press has no SeatSeal virtual-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor drag-press virtual-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor drag-press dispatch is unavailable")
        self._assert_pointer_route(route, point_index)

        marked_pending = False
        def validate(prepared_target: dict[str, Any]) -> None:
            nonlocal marked_pending
            self._assert_pointer_route(
                route, point_index, prepared_hit=prepared_target
            )
            transaction.mark_compositor_press_pending(button)
            marked_pending = True

        try:
            receipt = seal.guarded_drag_press(x, y, button, validate)
            transaction.confirm_compositor_press(button)
        except Exception as error:
            if marked_pending or transaction.compositor_held_button is not None:
                transaction._quarantine_release(
                    "compositor-native drag press outcome could not be confirmed"
                )
                raise ToolError(
                    "compositor-native drag press outcome is ambiguous; pointer input is quarantined"
                ) from error
            raise
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "point_index": point_index,
            "virtual_pointer_identity_sha256": device_identity,
            "controller_route_revalidated_against_arm_target": True,
            "controller_button_state_marked_before_dispatch": True,
            "controller_button_state_confirmed_after_receipt": True,
            "controller_helper_button_commands": 0,
        }

    def _dispatch_compositor_guarded_drag_abort_release(
        self,
        button: int,
    ) -> dict[str, Any]:
        """Deescalate one held drag through a target-independent Sway ticket."""
        if not self.is_wayland:
            attempts = self._release_pointer_button(button)
            return {
                "operation": "legacy-drag-abort-release",
                "release_attempts": attempts,
                "emergency_release": True,
            }
        transaction = getattr(self, "_active_pointer_transaction", None)
        if (
            transaction is None
            or transaction.closed
            or transaction.held_button is not None
            or transaction.compositor_held_button != button
            or self.pointer_pressed_button != button
        ):
            raise ToolError(
                "compositor drag abort-release lost its exact held-button authority"
            )
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError(
                "compositor drag abort-release has no SeatSeal virtual-pointer receipt"
            )
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError(
                "compositor drag abort-release virtual-pointer identity is malformed"
            )
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError(
                "patched-Sway compositor drag abort-release dispatch is unavailable"
            )
        try:
            receipt = seal.guarded_drag_abort_release(button)
            transaction.confirm_compositor_release(button)
        except Exception as error:
            transaction._quarantine_release(
                "target-independent compositor drag abort-release could not be confirmed"
            )
            raise ToolError(
                "target-independent compositor drag abort-release is ambiguous; "
                "pointer input is quarantined"
            ) from error
        return {
            **receipt,
            "virtual_pointer_identity_sha256": device_identity,
            "controller_target_independent_deescalation": True,
            "controller_route_revalidation_required": False,
            "controller_button_state_confirmed_released_after_receipt": True,
            "controller_helper_button_commands": 0,
            "emergency_release": True,
        }

    def _dispatch_compositor_guarded_drag_release(
        self,
        route: dict[str, Any],
        point_index: int,
        button: int,
        *,
        emergency: bool = False,
    ) -> dict[str, Any] | None:
        """Release the active exact grab in one private-Sway callback."""
        if emergency:
            receipt = self._dispatch_compositor_guarded_drag_abort_release(button)
            return {
                **receipt,
                "route_sha256": route.get("route_sha256"),
                "point_index": point_index,
            }
        points = route.get("points")
        if not isinstance(points, list) or not 0 <= point_index < len(points):
            raise ToolError("compositor drag-release route point is unavailable")
        record = points[point_index]
        point = record.get("point") if isinstance(record, dict) else None
        if (
            not isinstance(point, list)
            or len(point) != 2
            or any(type(value) is not int for value in point)
        ):
            raise ToolError("compositor drag-release route point is malformed")
        x, y = point
        actual = self.pointer_position()
        if actual != {"x": x, "y": y}:
            raise ToolError("compositor drag-release cursor changed from its reviewed route")
        if not self.is_wayland:
            attempts = self._release_pointer_button(button)
            return {
                "operation": "legacy-drag-release",
                "release_attempts": attempts,
                "emergency_release": emergency,
            }
        transaction = getattr(self, "_active_pointer_transaction", None)
        if (
            transaction is None
            or transaction.closed
            or transaction.held_button is not None
            or transaction.compositor_held_button != button
            or self.pointer_pressed_button != button
        ):
            raise ToolError("compositor drag-release lost its exact held-button authority")
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor drag-release has no SeatSeal virtual-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor drag-release virtual-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor drag-release dispatch is unavailable")
        self._assert_pointer_route(route, point_index)

        def validate(prepared_target: dict[str, Any]) -> None:
            self._assert_pointer_route(
                route, point_index, prepared_hit=prepared_target
            )

        try:
            receipt = seal.guarded_drag_release(x, y, button, validate)
            transaction.confirm_compositor_release(button)
        except Exception as error:
            transaction._quarantine_release(
                "compositor-native drag release outcome could not be confirmed"
            )
            raise ToolError(
                "compositor-native drag release outcome is ambiguous; pointer input is quarantined"
            ) from error
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "point_index": point_index,
            "virtual_pointer_identity_sha256": device_identity,
            "controller_route_revalidated_against_arm_target": True,
            "controller_current_target_accepted_for_deescalation": False,
            "controller_button_state_confirmed_released_after_receipt": True,
            "controller_helper_button_commands": 0,
            "emergency_release": emergency,
        }

    def _dispatch_compositor_guarded_drag_motion(
        self,
        route: dict[str, Any],
        from_index: int,
        to_index: int,
    ) -> dict[str, Any] | None:
        """Move one held drag segment in one authenticated Sway callback."""
        points = route.get("points")
        if (
            not isinstance(points, list)
            or not 0 <= from_index < len(points)
            or not 0 <= to_index < len(points)
            or to_index != from_index + 1
        ):
            raise ToolError("compositor drag-motion route lost its consecutive segment")
        source_record = points[from_index]
        destination_record = points[to_index]
        source_point = (
            source_record.get("point") if isinstance(source_record, dict) else None
        )
        destination_point = (
            destination_record.get("point")
            if isinstance(destination_record, dict) else None
        )
        if (
            not isinstance(source_point, list)
            or len(source_point) != 2
            or not isinstance(destination_point, list)
            or len(destination_point) != 2
            or any(type(value) is not int for value in source_point + destination_point)
        ):
            raise ToolError("compositor drag-motion route segment is malformed")
        from_x, from_y = source_point
        x, y = destination_point
        actual_source = self.pointer_position()
        if (
            actual_source.get("x") != from_x
            or actual_source.get("y") != from_y
        ):
            raise ToolError("compositor drag-motion source changed from its reviewed route")
        if not self.is_wayland:
            self._move(x, y)
            return None
        held_button = self.pointer_pressed_button
        if type(held_button) is not int or not self._pointer_drag_active:
            raise ToolError("HeldMotionSeal requires one active guarded drag button")
        transaction = getattr(self, "_active_pointer_transaction", None)
        if (
            transaction is None
            or transaction.closed
            or transaction.held_button is not None
            or transaction.compositor_held_button != held_button
        ):
            raise ToolError(
                "compositor drag-motion lost its held birth-pinned virtual pointer"
            )
        start_receipt = transaction.seat_start_receipt
        if not isinstance(start_receipt, dict):
            raise ToolError("compositor drag-motion has no SeatSeal virtual-pointer receipt")
        device_identity = start_receipt.get("active_device_identity_sha256")
        if not isinstance(device_identity, str) or re.fullmatch(
            r"[0-9a-f]{64}", device_identity
        ) is None:
            raise ToolError("compositor drag-motion virtual-pointer identity is malformed")
        seal = getattr(self, "compositor_event_seal", None)
        if seal is None or seal.hit_test_authorized is not True:
            raise ToolError("patched-Sway compositor drag-motion dispatch is unavailable")

        # The source was the immediately preceding reviewed route point and is
        # still protected by the held interval ledger. Patched Sway captures and
        # destroy-watches that exact source recipient, while the callback target
        # is checked against the reviewed destination before ticket dispatch.
        self._assert_pointer_route(route, from_index)

        def validate(
            prepared_source: dict[str, Any],
            prepared_destination: dict[str, Any],
        ) -> None:
            self._assert_pointer_route(
                route,
                from_index,
                prepared_hit=prepared_source,
            )
            self._assert_pointer_route(
                route,
                to_index,
                prepared_hit=prepared_destination,
            )

        receipt = seal.guarded_drag_motion(
            from_x,
            from_y,
            x,
            y,
            held_button,
            validate,
        )
        self.pointer = {"x": x, "y": y}
        return {
            **receipt,
            "route_sha256": route.get("route_sha256"),
            "from_point_index": from_index,
            "point_index": to_index,
            "virtual_pointer_identity_sha256": device_identity,
            "controller_source_route_revalidated_against_arm_target": True,
            "controller_route_revalidated_against_destination_arm_target": True,
            "controller_source_route_revalidated_before_arm": True,
            "controller_source_coordinate_bound": [from_x, from_y],
            "controller_held_button_bound": held_button,
        }

    def _fenced_scroll(
        self,
        arguments: dict[str, Any],
        route: dict[str, Any],
        *,
        modifier_target: dict[str, Any] | None = None,
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        self._require_pointer_healthy()
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        if self.pointer != {"x": x, "y": y}:
            raise ToolError("guarded scroll target is not the post-hover latched pointer position")
        delta_y = as_int(arguments.get("delta_y", 0), -100, 100, "delta_y")
        delta_x = as_int(arguments.get("delta_x", 0), -100, 100, "delta_x")
        if delta_x == 0 and delta_y == 0:
            raise ToolError("at least one scroll delta must be non-zero")
        interval = as_number(arguments.get("interval", 0.02), 0.0, 1.0, "interval")
        units = self._scroll_units(delta_x, delta_y)
        transient_points = [
            point
            for point in route.get("points", [])
            if isinstance(point, dict) and point.get("transient_owner_sha256") is not None
        ]
        if transient_points:
            if len(transient_points) != 1 or len(route.get("points", [])) != 1:
                raise ToolError("PopupAxisSeal requires one exact transient target point")
            admitted_unit = self._scene_transient_axis_unit(arguments)
            if units != [admitted_unit]:
                raise ToolError("PopupAxisSeal logical wheel decomposition changed before dispatch")
            if transient_points[0].get("transient_axis_unit") != list(admitted_unit):
                raise ToolError("PopupAxisSeal route no longer matches its admitted wheel unit")
        if max(0, len(units) - 1) * interval > MAX_ACTION_SECONDS:
            raise ToolError("guarded scroll sequence exceeds the action runtime limit")

        def dispatch(unit: tuple[int, int]) -> dict[str, Any] | None:
            unit_x, unit_y = unit
            return self._dispatch_compositor_guarded_scroll(
                route,
                0,
                unit_x,
                unit_y,
                modifier_target=modifier_target,
            )

        evidence = self._run_pointer_unit_fence(
            "desktop_scroll",
            route,
            units,
            "logical-scroll-step",
            interval,
            POINTER_FENCE_MAX_INFLIGHT_SCROLL_STEPS,
            dispatch,
            modifier_names=tuple(arguments.get("modifiers", [])),
            modifier_target=modifier_target,
        )
        evidence["delta_decomposition"] = {
            "delta_x": delta_x,
            "delta_y": delta_y,
            "logical_steps": len(units),
            "cardinal_only": True,
            "serialization": "balanced-ideal-event-centers+vertical-tie-break",
        }
        return {
            "scrolled": True,
            "delta_x": delta_x,
            "delta_y": delta_y,
            "modifiers": list(arguments.get("modifiers", [])),
            **self.pointer_position(),
        }, evidence

    def _abort_fenced_drag(
        self,
        button: int,
        route: dict[str, Any],
        last_verified_index: int,
    ) -> dict[str, Any]:
        """Release immediately after a held-route failure; never move while blind."""
        cleanup: dict[str, Any] = {
            "attempted": True,
            "last_verified_index": last_verified_index,
            "retreat_attempted": False,
            "release_attempts": 0,
            "release_succeeded": False,
            "controller_quarantined": bool(getattr(self, "pointer_quarantined", False)),
        }
        try:
            if self.is_wayland:
                receipt = self._dispatch_compositor_guarded_drag_release(
                    route,
                    last_verified_index,
                    button,
                    emergency=True,
                )
                cleanup["release_attempts"] = 1
                cleanup["compositor_release_receipt"] = receipt
            else:
                cleanup["release_attempts"] = self._release_pointer_button(button)
            cleanup["release_succeeded"] = True
        except Exception as error:
            cleanup["release_error"] = type(error).__name__
            cleanup["controller_quarantined"] = bool(getattr(self, "pointer_quarantined", False))
        self.journal.append(
            "pointer-drag-abort",
            "desktop_drag",
            {
                "route_sha256": route.get("route_sha256"),
                "launch_id": route.get("launch_id"),
            },
            cleanup,
        )
        return cleanup

    def _fenced_drag(
        self,
        arguments: dict[str, Any],
        route: dict[str, Any],
        *,
        modifier_target: dict[str, Any] | None = None,
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        """Run one held-button drag under spatial, temporal, and event seals.

        The button never migrates between virtual devices. Every held segment is
        bounded by authenticated Sway event barriers as well as tree route
        checks. Any top-level excursion while the button is held stops movement
        and triggers an immediate verified release; only a transition observed
        after the release acknowledgement may be reported as a successful final
        scene transition.
        """
        self._require_pointer_healthy()
        canonical_modifiers, modifier_mask = WaylandKeyboardTransaction.normalize_modifiers(
            arguments.get("modifiers")
        )
        if bool(canonical_modifiers) != (modifier_target is not None):
            raise ToolError("modified drag is missing its exact keyboard target authority")
        start_x = as_int(arguments.get("start_x"), 0, self.width - 1, "start_x")
        start_y = as_int(arguments.get("start_y"), 0, self.height - 1, "start_y")
        end_x = as_int(arguments.get("end_x"), 0, self.width - 1, "end_x")
        end_y = as_int(arguments.get("end_y"), 0, self.height - 1, "end_y")
        button = as_int(arguments.get("button", 1), 1, 3, "button")
        duration = as_number(arguments.get("duration", 0.4), 0.0, 10.0, "duration")
        points = route.get("points")
        if not isinstance(points, list) or len(points) < 2:
            raise ToolError("guarded drag route has no held-button checkpoint units")
        if points[0].get("point") != [start_x, start_y] or points[-1].get("point") != [end_x, end_y]:
            raise ToolError("guarded drag route does not match the requested endpoints")
        if self.pointer != {"x": start_x, "y": start_y}:
            raise ToolError("guarded drag start is not the post-hover latched pointer position")

        seal = getattr(self, "compositor_event_seal", None)
        if self.is_wayland and seal is None:
            raise ToolError("birth-pinned compositor event seal is unavailable; drag input was withheld")
        ledger = CompositorEventLedger(
            seal,
            f"desktop_drag:{str(route.get('route_sha256') or 'unbound')[:24]}",
        )
        evidence = self._pointer_fence_evidence(
            "desktop_drag",
            route,
            "bounded-held-button-segment",
            len(points) - 1,
            POINTER_FENCE_MAX_INFLIGHT_DRAG_SEGMENTS,
        )
        evidence.update({
            "compositor_native_drag_motion_required": self.is_wayland,
            "compositor_native_dispatch_required": self.is_wayland,
            "compositor_native_dispatch_operation": (
                "native-exact-drag-press+native-exact-held-motion+"
                "native-exact-drag-release" if self.is_wayland else None
            ),
            "compositor_native_drag_press_units": 0,
            "compositor_native_drag_release_units": 0,
            "helper_button_commands_required": False if self.is_wayland else None,
            "button_press_completed": False,
            "button_release_attempted": False,
            "button_release_completed": False,
            "button_release_attempts": 0,
            "abort_cleanup": None,
            "maximum_segment_pixels": POINTER_FENCE_MAX_SEGMENT_PIXELS,
            "maximum_segment_milliseconds": POINTER_FENCE_MAX_SEGMENT_MILLISECONDS,
            "waypoint_count": len(arguments.get("waypoints", []) or []),
            "modifiers": list(arguments.get("modifiers", [])),
            "pointer_transport": None,
            "compositor_event_seal": ledger.evidence,
            "modifier_guard": {
                "schema": "sandcodex.modified-pointer-guard.v2",
                "enforced": bool(canonical_modifiers),
                "protocol": "ModifierArcSeal",
                "modifier_arc_schema": MODIFIER_ARC_SEAL_SCHEMA,
                "modifiers": list(canonical_modifiers),
                "canonical_modifier_mask": modifier_mask,
                "serialized_modifier_mask": None,
                "keyboard_target_identity_sha256": (
                    modifier_target.get("identity_sha256")
                    if isinstance(modifier_target, dict)
                    else None
                ),
                "device_order": (
                    "keyboard-planner-start+exact-recipient-compositor-arc-hold+"
                    "pointer-start+drag-press+held-motion+drag-release+"
                    "pointer-destroy+target-independent-compositor-arc-clear+"
                    "keyboard-destroy"
                ),
                "modifier_authority_owner": (
                    "authenticated-sway-ipc-connection" if canonical_modifiers else None
                ),
                "modifier_hold_dispatch_path": (
                    COMPOSITOR_MODIFIER_ARC_DISPATCH_PATH if canonical_modifiers else None
                ),
                "modifier_hold_atomicity": (
                    GUARDED_MODIFIER_ARC_ATOMICITY if canonical_modifiers else None
                ),
                "connection_owned": bool(canonical_modifiers),
                "disconnect_clear": bool(canonical_modifiers),
                "virtual_keyboard_destroy_clear": bool(canonical_modifiers),
                "target_independent_clear": bool(canonical_modifiers),
                "underlying_keyboard_released_throughout": True,
                "helper_key_or_modifier_requests": 0,
                "hold_receipt": None,
                "hold_receipt_sha256": None,
                "release_receipt": None,
                "release_receipt_sha256": None,
                "modifier_hold_confirmed": not canonical_modifiers,
                "modifier_release_confirmed": not canonical_modifiers,
                "keyboard_lifecycle": None,
                "complete": not canonical_modifiers,
            },
        })
        audit_arguments = {
            "route_sha256": route.get("route_sha256"),
            "launch_id": route.get("launch_id"),
            "target_window_ids": route.get("target_window_ids", []),
            "planned_units": len(points) - 1,
            "button": button,
        }
        started = time.monotonic()
        per_segment_delay = duration / max(1, len(points) - 1)
        if per_segment_delay * 1000 > POINTER_FENCE_MAX_SEGMENT_MILLISECONDS + 0.001:
            raise ToolError("guarded drag temporal segmentation exceeded its checkpoint ceiling")
        last_verified_index = 0
        primary_error: Exception | None = None
        transaction: WaylandPointerTransaction | None = None
        keyboard_transaction: WaylandKeyboardTransaction | None = None
        modifier_arc: CompositorModifierArc | None = None
        previous_end: int | None = None

        def check_targets(point_index: int) -> None:
            self._check_pointer_fence(route, point_index, evidence)
            if modifier_target is not None:
                self._assert_keyboard_target(modifier_target)

        def transition_error(summary: dict[str, Any], context: str) -> PointerRouteTransition:
            return PointerRouteTransition(ledger.reason(summary, context))

        def reject_held_interval(summary: dict[str, Any], context: str) -> None:
            ledger.reject_fatal(summary, context)
            if ledger.has_transition(summary):
                raise transition_error(summary, context)

        def record_final_transition(
            summary: dict[str, Any],
            tree_transition: ToolError | None = None,
            *,
            phase: str,
        ) -> None:
            event_transition = ledger.has_transition(summary)
            if tree_transition is None and not event_transition:
                return
            evidence["route_intact"] = False
            evidence["final_scene_transition"] = True
            evidence["final_transition_phase"] = phase
            evidence["final_scene_transition_detected_by"] = (
                "tree+event-stream"
                if tree_transition is not None and event_transition
                else ("tree" if tree_transition is not None else "event-stream")
            )
            evidence["final_scene_transition_reason"] = (
                str(tree_transition)[:512]
                if tree_transition is not None
                else ledger.reason(
                    summary,
                    f"compositor target changed after verified drag {phase}",
                )
            )

        try:
            if canonical_modifiers:
                self._require_keyboard_healthy()
                assert modifier_target is not None
                modifier_start = ledger.barrier("modifier-keyboard:start")
                check_targets(0)
                keyboard_transaction = WaylandKeyboardTransaction(
                    self,
                    "desktop_drag-modified-pointer",
                )
                keyboard_transaction.prepare_characters("")
                prepared_names, serialized_modifier_mask = (
                    keyboard_transaction.prepare_modifier_arc(
                        list(canonical_modifiers)
                    )
                )
                if prepared_names != canonical_modifiers:
                    keyboard_transaction.cancel_modifier_arc_preparation(
                        serialized_modifier_mask
                    )
                    raise ToolError(
                        "keyboard planner canonicalized drag modifier-arc authority inconsistently"
                    )
                modifier_arc, hold_receipt = (
                    self._dispatch_compositor_guarded_modifier_arc(
                        modifier_target,
                        keyboard_transaction,
                        serialized_modifier_mask,
                    )
                )
                check_targets(0)
                modifier_end = ledger.barrier("modifier-keyboard:end")
                modifier_summary = ledger.interval(
                    modifier_start,
                    modifier_end,
                    "modifier-preparation",
                )
                previous_end = modifier_end
                reject_held_interval(
                    modifier_summary,
                    "compositor target changed while acquiring drag modifiers",
                )
                keyboard_start = keyboard_transaction.seat_start_receipt
                if not isinstance(keyboard_start, dict):
                    raise ToolError(
                        "SeatSeal modified-drag keyboard activation receipt is unavailable"
                    )
                keyboard_identity = keyboard_start.get("active_device_identity_sha256")
                if not isinstance(keyboard_identity, str):
                    raise ToolError(
                        "SeatSeal modified-drag keyboard identity is unavailable"
                    )
                keyboard_added = ledger.require_input_lifecycle(
                    modifier_summary,
                    "added",
                    "keyboard",
                    "modified drag preparation did not prove one exact virtual keyboard",
                    expected_identity_sha256=keyboard_identity,
                )
                modifier_evidence = evidence["modifier_guard"]
                assert isinstance(modifier_evidence, dict)
                modifier_evidence["serialized_modifier_mask"] = serialized_modifier_mask
                modifier_evidence["hold_receipt"] = hold_receipt
                modifier_evidence["hold_receipt_sha256"] = hold_receipt.get(
                    "receipt_sha256"
                )
                modifier_evidence["modifier_hold_confirmed"] = True
                modifier_evidence["keyboard_transport"] = keyboard_transaction.evidence()
                modifier_evidence["keyboard_lifecycle"] = {
                    "schema": SEAT_SEAL_SCHEMA,
                    "input_type": "keyboard",
                    "identity_sha256": keyboard_identity,
                    "added_event": keyboard_added,
                    "removed_event": None,
                    "inventory_start": keyboard_start,
                    "inventory_stop": None,
                    "complete": False,
                }

            preparation_start = ledger.barrier("preparation:start")
            if previous_end is not None:
                preparation_gap = ledger.interval(previous_end, preparation_start, "gap")
                reject_held_interval(
                    preparation_gap,
                    "compositor target changed before guarded drag pointer creation",
                )
            previous_end = preparation_start
            if keyboard_transaction is None:
                transaction = WaylandPointerTransaction(self, "desktop_drag")
            else:
                transaction = WaylandPointerTransaction(
                    self,
                    "desktop_drag",
                    seat_companion_receipt=keyboard_transaction.seat_start_receipt,
                )
            evidence["pointer_transport"] = transaction.evidence()
            preparation_end = ledger.barrier("preparation:end")
            preparation_summary = ledger.interval(
                preparation_start,
                preparation_end,
                "preparation",
            )
            previous_end = preparation_end
            reject_held_interval(
                preparation_summary,
                "compositor target changed while preparing the guarded drag",
            )
            start_receipt = transaction.seat_start_receipt
            if not isinstance(start_receipt, dict):
                raise ToolError("SeatSeal drag pointer activation receipt is unavailable")
            active_identity = start_receipt.get("active_device_identity_sha256")
            if not isinstance(active_identity, str):
                raise ToolError("SeatSeal drag pointer activation identity is unavailable")
            added_event = ledger.require_input_lifecycle(
                preparation_summary,
                "added",
                "pointer",
                "guarded drag preparation did not prove one exact virtual pointer",
                expected_identity_sha256=active_identity,
            )
            evidence["virtual_device_lifecycle"] = {
                "schema": SEAT_SEAL_SCHEMA,
                "input_type": "pointer",
                "identity_sha256": active_identity,
                "added_event": added_event,
                "removed_event": None,
                "inventory_start": start_receipt,
                "inventory_stop": None,
                "complete": False,
            }

            press_start = ledger.barrier("press:start")
            if previous_end is not None:
                gap_summary = ledger.interval(previous_end, press_start, "gap")
                reject_held_interval(
                    gap_summary,
                    "compositor target changed before guarded drag button press",
                )

            press_error: Exception | None = None
            press_transition: ToolError | None = None
            try:
                check_targets(0)
                press_dispatch = self._dispatch_compositor_guarded_drag_press(
                    route, 0, button
                )
                evidence["button_press_completed"] = True
                if press_dispatch is not None:
                    dispatches = evidence.get("compositor_dispatch_seals")
                    if not isinstance(dispatches, list):
                        raise ToolError("pointer fence compositor receipt ledger is malformed")
                    dispatches.append(press_dispatch)
                    evidence["compositor_native_dispatch_units"] = (
                        int(evidence["compositor_native_dispatch_units"]) + 1
                    )
                    evidence["compositor_native_drag_press_units"] = 1
                try:
                    check_targets(0)
                except (PointerRouteTransition, KeyboardTargetTransition) as error:
                    press_transition = error
            except Exception as error:
                press_error = error
            try:
                press_end = ledger.barrier("press:end")
                press_summary = ledger.interval(press_start, press_end, "unit")
            except Exception as seal_error:
                if press_error is not None:
                    raise ToolError(
                        "compositor event seal failed while drag button press also failed; held state is uncertain"
                    ) from seal_error
                raise
            previous_end = press_end
            ledger.reject_fatal(
                press_summary,
                "compositor environment changed during guarded drag button press",
            )
            if press_error is not None:
                raise press_error
            if press_transition is not None:
                raise press_transition
            if ledger.has_transition(press_summary):
                raise transition_error(
                    press_summary,
                    "compositor target changed while the drag button became held",
                )

            self._pointer_drag_active = True
            for index in range(1, len(points)):
                self._assert_pointer_fence_deadline(started)
                point = points[index].get("point")
                if not isinstance(point, list) or len(point) != 2:
                    raise ToolError("guarded drag route point is malformed")

                segment_start = ledger.barrier(f"segment:{index}:start")
                if previous_end is not None:
                    held_gap_summary = ledger.interval(previous_end, segment_start, "gap")
                    reject_held_interval(
                        held_gap_summary,
                        "compositor target changed between held drag segments; movement stopped",
                    )

                segment_error: Exception | None = None
                segment_transition: ToolError | None = None
                moved = False
                try:
                    check_targets(index - 1)
                    dispatch_seal = self._dispatch_compositor_guarded_drag_motion(
                        route,
                        index - 1,
                        index,
                    )
                    moved = True
                    evidence["emitted_units"] = int(evidence["emitted_units"]) + 1
                    if dispatch_seal is not None:
                        dispatches = evidence.get("compositor_dispatch_seals")
                        if not isinstance(dispatches, list):
                            raise ToolError("pointer fence compositor receipt ledger is malformed")
                        dispatches.append(dispatch_seal)
                        evidence["compositor_native_dispatch_units"] = (
                            int(evidence["compositor_native_dispatch_units"]) + 1
                        )
                        evidence["compositor_native_drag_motion_units"] = (
                            int(evidence["compositor_native_drag_motion_units"]) + 1
                        )
                    try:
                        check_targets(index)
                    except (PointerRouteTransition, KeyboardTargetTransition) as error:
                        segment_transition = error
                except Exception as error:
                    segment_error = error

                try:
                    segment_end = ledger.barrier(f"segment:{index}:end")
                    segment_summary = ledger.interval(segment_start, segment_end, "held")
                except Exception as seal_error:
                    if segment_error is not None:
                        raise ToolError(
                            "compositor event seal failed while a held drag segment also failed; input stopped"
                        ) from seal_error
                    raise
                previous_end = segment_end
                ledger.reject_fatal(
                    segment_summary,
                    "compositor environment changed during a held drag segment",
                )
                if segment_error is not None:
                    raise segment_error
                if not moved:
                    raise ToolError("held drag segment was not dispatched")
                if segment_transition is not None:
                    raise segment_transition
                if ledger.has_transition(segment_summary):
                    raise transition_error(
                        segment_summary,
                        "compositor target changed during a held drag segment; movement stopped",
                    )
                evidence["completed_units"] = int(evidence["completed_units"]) + 1
                last_verified_index = index

                if per_segment_delay:
                    remaining = MAX_ACTION_SECONDS - (time.monotonic() - started)
                    if remaining <= 0 or per_segment_delay > remaining:
                        raise ToolError("guarded pointer gesture exceeded the action runtime limit")
                    time.sleep(per_segment_delay)

            # Drain every event which happened after the last segment/delay before
            # allowing release. A transition here still occurred while the button
            # was held and therefore denies success, even though cleanup releases.
            self._assert_pointer_fence_deadline(started)
            release_start = ledger.barrier("release:start")
            if previous_end is not None:
                held_gap_summary = ledger.interval(previous_end, release_start, "gap")
                reject_held_interval(
                    held_gap_summary,
                    "compositor target changed while the drag button remained held before release",
                )

            release_error: Exception | None = None
            release_transition: ToolError | None = None
            try:
                check_targets(len(points) - 1)
                evidence["button_release_attempted"] = True
                release_dispatch = self._dispatch_compositor_guarded_drag_release(
                    route, len(points) - 1, button
                )
                evidence["button_release_attempts"] = 1
                evidence["button_release_completed"] = True
                if release_dispatch is not None:
                    dispatches = evidence.get("compositor_dispatch_seals")
                    if not isinstance(dispatches, list):
                        raise ToolError("pointer fence compositor receipt ledger is malformed")
                    dispatches.append(release_dispatch)
                    evidence["compositor_native_dispatch_units"] = (
                        int(evidence["compositor_native_dispatch_units"]) + 1
                    )
                    evidence["compositor_native_drag_release_units"] = 1
                try:
                    check_targets(len(points) - 1)
                except (PointerRouteTransition, KeyboardTargetTransition) as error:
                    release_transition = error
            except Exception as error:
                release_error = error

            try:
                release_end = ledger.barrier("release:end")
                release_summary = ledger.interval(release_start, release_end, "release")
            except Exception as seal_error:
                if release_error is not None:
                    raise ToolError(
                        "compositor event seal failed while drag release also failed; release state is uncertain"
                    ) from seal_error
                raise
            previous_end = release_end
            ledger.reject_fatal(
                release_summary,
                "compositor environment changed during guarded drag release",
            )
            if release_error is not None:
                raise release_error
            # Sway proved the exact active grab released and both Sway/wlroots
            # button sets returned to zero before this point. A drop may now
            # legitimately open, close, move, or replace a top-level. Report it
            # and retarget the compulsory fresh observation; emit no more input.
            record_final_transition(release_summary, release_transition, phase="release")
        except Exception as error:
            primary_error = error
        finally:
            self._pointer_drag_active = False
            if getattr(self, "pointer_pressed_button", None) is not None:
                if getattr(self, "pointer_quarantined", False):
                    evidence["abort_cleanup"] = {
                        "attempted": False,
                        "release_succeeded": False,
                        "controller_quarantined": True,
                        "reason": "release had already failed and quarantined the controller",
                    }
                else:
                    # Release first: once the route is invalid, minimizing held
                    # time is more important than waiting for another barrier.
                    evidence["abort_cleanup"] = self._abort_fenced_drag(
                        button,
                        route,
                        last_verified_index,
                    )
                if previous_end is not None:
                    try:
                        abort_release_end = ledger.barrier("abort-release:end")
                        ledger.interval(previous_end, abort_release_end, "release")
                        previous_end = abort_release_end
                    except Exception as seal_error:
                        if primary_error is None:
                            primary_error = seal_error
                        else:
                            primary_error = ToolError(
                                f"{primary_error}; compositor event sealing also failed after emergency release: {seal_error}"
                            )

            if transaction is not None and not transaction.closed:
                try:
                    transaction.close()
                except Exception as close_error:
                    if primary_error is None:
                        primary_error = close_error
                    else:
                        primary_error = ToolError(
                            f"{primary_error}; private drag transport cleanup also failed: {close_error}"
                        )
                evidence["pointer_transport"] = transaction.evidence()

            if previous_end is not None:
                try:
                    cleanup_end = ledger.barrier("cleanup:end")
                    cleanup_summary = ledger.interval(previous_end, cleanup_end, "cleanup")
                    previous_end = cleanup_end
                    if primary_error is None:
                        ledger.reject_fatal(
                            cleanup_summary,
                            "compositor environment changed while closing the guarded drag transport",
                        )
                        lifecycle_evidence = evidence.get("virtual_device_lifecycle")
                        if not isinstance(lifecycle_evidence, dict):
                            raise ToolError("SeatSeal drag pointer lifecycle evidence is unavailable during cleanup")
                        removed_event = ledger.require_input_lifecycle(
                            cleanup_summary,
                            "removed",
                            "pointer",
                            "guarded drag cleanup did not prove exact virtual-pointer removal",
                            expected_identity_sha256=str(lifecycle_evidence.get("identity_sha256")),
                        )
                        lifecycle_evidence["removed_event"] = removed_event
                        lifecycle_evidence["inventory_stop"] = (
                            transaction.seat_stop_receipt if transaction is not None else None
                        )
                        lifecycle_evidence["complete"] = True
                        if ledger.has_transition(cleanup_summary):
                            if evidence.get("button_release_completed") is not True:
                                raise PointerRouteTransition(
                                    ledger.reason(
                                        cleanup_summary,
                                        "compositor target changed before verified drag release",
                                    )
                                )
                            record_final_transition(cleanup_summary, phase="cleanup")
                except Exception as seal_error:
                    if primary_error is None:
                        primary_error = seal_error
                    else:
                        primary_error = ToolError(
                            f"{primary_error}; compositor event sealing also failed during drag cleanup: {seal_error}"
                        )

            if keyboard_transaction is not None and not keyboard_transaction.closed:
                keyboard_cleanup_error: Exception | None = None
                modifier_evidence = evidence.get("modifier_guard")
                # Pointer button release and pointer teardown always precede this
                # de-escalation-only clear.  No focus or target reauthorization is
                # needed to remove logical modifier state from the origin recipient.
                if modifier_arc is not None and not modifier_arc.release_requested:
                    try:
                        release_receipt = self._release_compositor_guarded_modifier_arc(
                            modifier_arc,
                            keyboard_transaction,
                        )
                        modifier_arc = None
                        if isinstance(modifier_evidence, dict):
                            modifier_evidence["release_receipt"] = release_receipt
                            modifier_evidence["release_receipt_sha256"] = release_receipt.get(
                                "receipt_sha256"
                            )
                            modifier_evidence["modifier_release_confirmed"] = True
                    except Exception as release_error:
                        keyboard_cleanup_error = release_error
                try:
                    keyboard_transaction.close()
                except Exception as close_error:
                    if keyboard_cleanup_error is None:
                        keyboard_cleanup_error = close_error
                    else:
                        keyboard_cleanup_error = ToolError(
                            f"{keyboard_cleanup_error}; private drag modifier keyboard shutdown also failed: {close_error}"
                        )
                if isinstance(modifier_evidence, dict):
                    modifier_evidence["keyboard_transport"] = keyboard_transaction.evidence()
                    modifier_evidence["modifier_release_confirmed"] = (
                        keyboard_transaction.modifier_arc_releases_confirmed == 1
                    )
                    modifier_evidence["release_forced_by_connection_revocation"] = (
                        keyboard_transaction.modifier_arc_revocation_forced
                    )
                if keyboard_cleanup_error is not None:
                    if primary_error is None:
                        primary_error = keyboard_cleanup_error
                    else:
                        primary_error = ToolError(
                            f"{primary_error}; modified-drag modifier-arc cleanup also failed: {keyboard_cleanup_error}"
                        )

                if previous_end is not None:
                    try:
                        modifier_cleanup_end = ledger.barrier(
                            "modifier-keyboard-cleanup:end"
                        )
                        modifier_cleanup_summary = ledger.interval(
                            previous_end,
                            modifier_cleanup_end,
                            "modifier-cleanup",
                        )
                        previous_end = modifier_cleanup_end
                        if primary_error is None:
                            ledger.reject_fatal(
                                modifier_cleanup_summary,
                                "compositor environment changed while clearing drag modifiers",
                            )
                            if not isinstance(modifier_evidence, dict):
                                raise ToolError(
                                    "modified drag guard evidence disappeared during cleanup"
                                )
                            keyboard_lifecycle = modifier_evidence.get(
                                "keyboard_lifecycle"
                            )
                            if not isinstance(keyboard_lifecycle, dict):
                                raise ToolError(
                                    "SeatSeal drag keyboard lifecycle evidence is unavailable during modifier cleanup"
                                )
                            keyboard_removed = ledger.require_input_lifecycle(
                                modifier_cleanup_summary,
                                "removed",
                                "keyboard",
                                "modified drag cleanup did not prove exact virtual-keyboard removal",
                                expected_identity_sha256=str(
                                    keyboard_lifecycle.get("identity_sha256")
                                ),
                            )
                            keyboard_lifecycle["removed_event"] = keyboard_removed
                            keyboard_lifecycle["inventory_stop"] = (
                                keyboard_transaction.seat_stop_receipt
                            )
                            keyboard_lifecycle["complete"] = True
                            modifier_evidence["complete"] = True
                            if ledger.has_transition(modifier_cleanup_summary):
                                if evidence.get("button_release_completed") is not True:
                                    raise PointerRouteTransition(
                                        ledger.reason(
                                            modifier_cleanup_summary,
                                            "compositor target changed before modified drag release completed",
                                        )
                                    )
                                record_final_transition(
                                    modifier_cleanup_summary,
                                    phase="modifier-cleanup",
                                )
                    except Exception as seal_error:
                        if primary_error is None:
                            primary_error = seal_error
                        else:
                            primary_error = ToolError(
                                f"{primary_error}; compositor event sealing also failed during modifier cleanup: {seal_error}"
                            )

        evidence["compositor_event_seal"] = ledger.finalize()
        evidence["pointer_controller_quarantined"] = bool(getattr(self, "pointer_quarantined", False))
        evidence["elapsed_milliseconds"] = round((time.monotonic() - started) * 1000, 3)
        if (
            primary_error is None
            and self.is_wayland
            and (
                int(evidence["compositor_native_drag_press_units"]) != 1
                or int(evidence["compositor_native_drag_motion_units"]) != len(points) - 1
                or int(evidence["compositor_native_drag_release_units"]) != 1
                or int(evidence["compositor_native_dispatch_units"]) != len(points) + 1
            )
        ):
            primary_error = ToolError(
                "guarded Wayland drag completed without one compositor-native "
                "press, one HeldMotionSeal dispatch per reviewed segment, and "
                "one grab-bound compositor-native release"
            )
        if primary_error is not None:
            evidence["route_intact"] = False
            cleanup = evidence.get("abort_cleanup")
            cleanup_failed = (
                isinstance(cleanup, dict)
                and cleanup.get("release_succeeded") is not True
                and getattr(self, "pointer_pressed_button", None) is not None
            )
            self.journal.append(
                "pointer-fence",
                "desktop_drag",
                audit_arguments,
                evidence,
                error=str(primary_error),
            )
            if cleanup_failed or getattr(self, "pointer_quarantined", False):
                raise ToolError(
                    "guarded drag failed and button release could not be confirmed; pointer input is quarantined until desktop restart"
                ) from primary_error
            raise primary_error
        self.journal.append("pointer-fence", "desktop_drag", audit_arguments, evidence)
        return {
            "dragged": True,
            "start": [start_x, start_y],
            "end": [end_x, end_y],
            "button": button,
            "segments": len(points) - 1,
            "waypoints": len(arguments.get("waypoints", []) or []),
            "modifiers": list(arguments.get("modifiers", [])),
        }, evidence

    def type_text(self, arguments: dict[str, Any]) -> dict[str, Any]:
        text = as_string(arguments.get("text"), "text")
        interval = as_number(arguments.get("interval", 0.01), 0.0, 2.0, "interval")
        method = arguments.get("method", "auto")
        if method not in {"auto", "keys", "input-method", "clipboard"}:
            raise ToolError("method must be auto, keys, input-method, or clipboard")
        if method == "input-method":
            raise ToolError("native input-method delivery requires a guarded desktop_step observation")
        key_budget_ok = (
            len(text) <= MAX_SYNTHETIC_CHARACTERS
            and max(0, len(text) - 1) * interval <= MAX_ACTION_SECONDS
            and (not self.is_wayland or WaylandKeyboardTransaction.can_prepare_characters(text))
        )
        if method == "keys" and not key_budget_ok:
            raise ToolError("synthetic keyboard input exceeds the character or action-duration limit")
        if method == "keys" or (method == "auto" and key_budget_ok):
            try:
                self._type_keys(text, interval)
                return json_result({"typed": True, "method": "keys", "characters": len(text)})
            except ToolError:
                if method == "keys":
                    raise
        self.set_clipboard({"text": text})
        chord = self._normalize_paste_chord(arguments.get("paste_chord", "CTRL+V"))
        self._press_chord(chord)
        return json_result({"typed": True, "method": "clipboard", "characters": len(text), "paste_chord": chord})

    def paste_payload(self, _arguments: dict[str, Any]) -> dict[str, Any]:
        raise ToolError(
            "desktop_paste requires desktop_observe followed by desktop_step on guarded Wayland"
        )

    def drop_payload(self, _arguments: dict[str, Any]) -> dict[str, Any]:
        raise ToolError(
            "desktop_drop requires desktop_observe followed by desktop_step on guarded Wayland"
        )

    def _run_keyboard_fence(
        self,
        target: dict[str, Any],
        action_name: str,
        method: str,
        unit_kind: str,
        planned_units: int,
        interval: float,
        transaction_purpose: str,
        prepare: Callable[[Any], None],
        dispatch: Callable[
            [Any, int, Callable[[str], None]],
            None,
        ],
        *,
        transaction_factory: Callable[[Any, str], Any] | None = None,
        preparation_ready: Callable[[Any], bool] | None = None,
        preparation_evidence_key: str = "keymap_sealed_before_focus_checks",
        transport_evidence_key: str = "keyboard_transport",
        virtual_device_lifecycle: bool = True,
        journal_kind: str = "keyboard-fence",
    ) -> dict[str, Any]:
        """Dispatch released keyboard units under tree and ordered event seals.

        KeySeal keeps one birth-pinned virtual keyboard for the complete
        operation. For ordinary key units the helper only plans against its
        sealed keymap; patched Sway atomically rechecks the exact focused
        client, default keyboard grab, and released state before delivering
        modifiers, press, release, and modifier clear in one IPC callback. TickSeal places Sway
        SEND_TICK barriers around preparation, every unit, every idle gap, and
        transport cleanup. A focus/window/workspace excursion that changes and
        returns between tree snapshots is therefore retained before another
        code point or chord can inherit the route.
        """
        maximum_inflight = (
            KEYBOARD_FENCE_MAX_INFLIGHT_CODEPOINTS
            if unit_kind in {"unicode-codepoint", "utf8-commit-chunk"}
            else KEYBOARD_FENCE_MAX_INFLIGHT_CHORDS
        )
        if transaction_factory is None:
            # Resolve the default at call time. Besides keeping tests injectable,
            # this prevents a stale class object from surviving a controlled
            # server reload while all explicit transports remain immutable.
            transaction_factory = WaylandKeyboardTransaction
        if preparation_ready is None:
            preparation_ready = lambda value: bool(
                getattr(value, "preparation_completed", False)
                and getattr(value, "keymap_sealed", False)
            )
        if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", preparation_evidence_key):
            raise ToolError("keyboard fence preparation evidence key is invalid")
        if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", transport_evidence_key):
            raise ToolError("keyboard fence transport evidence key is invalid")
        seal = getattr(self, "compositor_event_seal", None)
        if self.is_wayland and seal is None:
            raise ToolError("birth-pinned compositor event seal is unavailable; keyboard input was withheld")
        event_evidence: dict[str, Any] = {
            "schema": COMPOSITOR_EVENT_SEAL_SCHEMA,
            "enforced": seal is not None,
            "barrier_protocol": "Sway-SEND_TICK-dual-marker-edge+commit",
            "ticks_per_logical_barrier": COMPOSITOR_TICKS_PER_LOGICAL_BARRIER,
            "barriers": 0,
            "sway_ticks": 0,
            "sealed_preparation_intervals": 0,
            "sealed_unit_intervals": 0,
            "sealed_authorization_intervals": 0,
            "sealed_gap_intervals": 0,
            "sealed_cleanup_intervals": 0,
            "events": 0,
            "metadata_events": 0,
            "transition_events": 0,
            "fatal_events": 0,
            "event_types": [],
            "changes": [],
            "metadata_changes": [],
            "transition_changes": [],
            "fatal_changes": [],
            "input_lifecycle_counts": {},
            "input_device_digests": [],
            "samples": [],
            "event_chain_sha256": "0" * 64,
        }
        evidence: dict[str, Any] = {
            "enforced": True,
            "target_window_id": target.get("window_id"),
            "target_launch_id": target.get("launch_id"),
            "target_origin": target.get("origin"),
            "target_identity_sha256": target.get("identity_sha256"),
            "method": method,
            "unit_kind": unit_kind,
            "planned_units": planned_units,
            "completed_units": 0,
            "focus_check_attempts": 0,
            "focus_checks": 0,
            "maximum_inflight_units": maximum_inflight,
            "focus_intact": False,
            "final_focus_transition": False,
            preparation_evidence_key: False,
            transport_evidence_key: None,
            "compositor_event_seal": event_evidence,
        }
        started = time.monotonic()
        deadline = started + MAX_ACTION_SECONDS
        transaction: WaylandKeyboardTransaction | None = None
        event_types: set[str] = set()
        event_changes: set[str] = set()
        metadata_changes: set[str] = set()
        transition_changes: set[str] = set()
        fatal_changes: set[str] = set()
        input_lifecycle_counts: dict[str, int] = {}
        input_device_digests: set[str] = set()
        event_samples: list[dict[str, Any]] = []
        event_chain = "0" * 64

        def check_target() -> None:
            evidence["focus_check_attempts"] = int(evidence["focus_check_attempts"]) + 1
            self._assert_keyboard_target(target)
            evidence["focus_checks"] = int(evidence["focus_checks"]) + 1

        def barrier(label: str) -> int:
            if seal is None:
                return 0
            sequence = seal.barrier(label)
            event_evidence["barriers"] = int(event_evidence["barriers"]) + 1
            event_evidence["sway_ticks"] = (
                int(event_evidence["sway_ticks"]) + COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
            )
            event_evidence.setdefault("first_barrier_sequence", sequence)
            event_evidence["last_barrier_sequence"] = sequence
            return sequence

        def merge_summary(summary: dict[str, Any], interval_kind: str) -> None:
            nonlocal event_chain
            if summary.get("schema") != COMPOSITOR_EVENT_SEAL_SCHEMA or summary.get("enforced") is not True:
                raise ToolError("compositor event seal returned an invalid keyboard interval receipt")
            counters = {
                "preparation": "sealed_preparation_intervals",
                "unit": "sealed_unit_intervals",
                "authorization": "sealed_authorization_intervals",
                "gap": "sealed_gap_intervals",
                "cleanup": "sealed_cleanup_intervals",
            }
            counter = counters.get(interval_kind)
            if counter is None:
                raise ToolError("unknown keyboard compositor interval kind")
            event_evidence[counter] = int(event_evidence[counter]) + 1
            for key in ("events", "metadata_events", "transition_events", "fatal_events"):
                event_evidence[key] = int(event_evidence[key]) + int(summary.get(key, 0))
            for value in summary.get("event_types", []):
                if isinstance(value, str):
                    event_types.add(value)
            for value in summary.get("changes", []):
                if isinstance(value, str):
                    event_changes.add(value)
            for value in summary.get("metadata_changes", []):
                if isinstance(value, str):
                    metadata_changes.add(value)
            for value in summary.get("transition_changes", []):
                if isinstance(value, str):
                    transition_changes.add(value)
            for value in summary.get("fatal_changes", []):
                if isinstance(value, str):
                    fatal_changes.add(value)
            lifecycle_counts = summary.get("input_lifecycle_counts")
            if not isinstance(lifecycle_counts, dict):
                raise ToolError("compositor event seal returned invalid keyboard input lifecycle accounting")
            for key, count in lifecycle_counts.items():
                if (
                    not isinstance(key, str)
                    or not isinstance(count, int)
                    or isinstance(count, bool)
                    or count < 0
                ):
                    raise ToolError("compositor event seal returned malformed keyboard lifecycle accounting")
                input_lifecycle_counts[key] = input_lifecycle_counts.get(key, 0) + count
            for digest in summary.get("input_device_digests", []):
                if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
                    raise ToolError("compositor event seal returned a malformed keyboard device digest")
                input_device_digests.add(digest)
            for sample in summary.get("samples", []):
                if isinstance(sample, dict) and len(event_samples) < COMPOSITOR_EVENT_MAX_SAMPLES:
                    event_samples.append(dict(sample))
            projection = {
                "start_sequence": summary.get("start_sequence"),
                "end_sequence": summary.get("end_sequence"),
                "events": summary.get("events"),
                "metadata_events": summary.get("metadata_events"),
                "transition_events": summary.get("transition_events"),
                "fatal_events": summary.get("fatal_events"),
                "input_lifecycle_counts": summary.get("input_lifecycle_counts"),
                "input_device_digests": summary.get("input_device_digests"),
                "event_sha256": summary.get("event_sha256"),
                "interval_kind": interval_kind,
            }
            event_chain = hashlib.sha256(event_chain.encode("ascii") + canonical_json(projection)).hexdigest()

        def finalize_event_evidence() -> None:
            event_evidence["event_types"] = sorted(event_types)
            event_evidence["changes"] = sorted(event_changes)
            event_evidence["metadata_changes"] = sorted(metadata_changes)
            event_evidence["transition_changes"] = sorted(transition_changes)
            event_evidence["fatal_changes"] = sorted(fatal_changes)
            event_evidence["input_lifecycle_counts"] = dict(sorted(input_lifecycle_counts.items()))
            event_evidence["input_device_digests"] = sorted(input_device_digests)
            event_evidence["samples"] = event_samples
            event_evidence["event_chain_sha256"] = event_chain
            barriers = event_evidence.get("barriers")
            sway_ticks = event_evidence.get("sway_ticks")
            if (
                not isinstance(barriers, int)
                or isinstance(barriers, bool)
                or barriers < 0
                or not isinstance(sway_ticks, int)
                or isinstance(sway_ticks, bool)
                or sway_ticks != barriers * COMPOSITOR_TICKS_PER_LOGICAL_BARRIER
            ):
                raise ToolError("keyboard compositor physical tick accounting is inconsistent")
            first = event_evidence.get("first_barrier_sequence")
            last = event_evidence.get("last_barrier_sequence")
            if isinstance(first, int) and isinstance(last, int):
                event_evidence["barrier_sequence_span"] = max(0, last - first)

        @staticmethod
        def transition_reason(summary: dict[str, Any], prefix: str) -> str:
            changes = summary.get("changes")
            detail = ",".join(str(value) for value in changes[:8]) if isinstance(changes, list) else "unknown"
            return f"{prefix}: {detail}"[:512]

        def reject_interval(
            summary: dict[str, Any],
            prefix: str,
            *,
            reject_transitions: bool = True,
            allow_input_lifecycle: bool = False,
        ) -> None:
            fatal = int(summary.get("fatal_events", 0))
            if fatal:
                raise ToolError(transition_reason(summary, prefix))
            if not allow_input_lifecycle:
                CompositorEventLedger.reject_input_lifecycle(summary, prefix)
            if reject_transitions and int(summary.get("transition_events", 0)):
                raise KeyboardTargetTransition(transition_reason(summary, prefix))

        def record_final_transition(
            summary: dict[str, Any],
            tree_transition: KeyboardTargetTransition | None = None,
            *,
            phase: str,
        ) -> None:
            event_transition = int(summary.get("transition_events", 0)) > 0
            if tree_transition is None and not event_transition:
                return
            evidence["final_focus_transition"] = True
            if tree_transition is not None:
                reason = str(tree_transition)[:512]
            else:
                reason = transition_reason(summary, f"compositor target changed during final keyboard {phase}")
            evidence["final_focus_transition_reason"] = reason
            evidence["final_transition_phase"] = phase
            evidence["final_transition_detected_by"] = (
                "tree+event-stream" if tree_transition is not None and event_transition
                else ("tree" if tree_transition is not None else "event-stream")
            )

        previous_end: int | None = None
        try:
            preparation_start = barrier(f"{action_name}:preparation:start")
            with transaction_factory(self, transaction_purpose) as transaction:
                prepare(transaction)
                if not preparation_ready(transaction):
                    raise ToolError("keyboard operation transport was not prepared before focus validation")
                evidence[preparation_evidence_key] = True
                preparation_end = barrier(f"{action_name}:preparation:end")
                previous_end = preparation_end
                if seal is not None:
                    preparation_summary = seal.summarize(preparation_start, preparation_end)
                    merge_summary(preparation_summary, "preparation")
                    reject_interval(
                        preparation_summary,
                        "compositor environment changed while preparing the guarded keyboard",
                        allow_input_lifecycle=virtual_device_lifecycle,
                    )
                    if virtual_device_lifecycle:
                        start_receipt = transaction.seat_start_receipt
                        if not isinstance(start_receipt, dict):
                            raise ToolError("SeatSeal keyboard activation receipt is unavailable")
                        active_identity = start_receipt.get("active_device_identity_sha256")
                        if not isinstance(active_identity, str):
                            raise ToolError("SeatSeal keyboard activation identity is unavailable")
                        added_event = CompositorEventLedger.require_input_lifecycle(
                            preparation_summary,
                            "added",
                            "keyboard",
                            "guarded keyboard preparation did not prove one exact virtual device",
                            expected_identity_sha256=active_identity,
                        )
                        evidence["virtual_device_lifecycle"] = {
                            "schema": SEAT_SEAL_SCHEMA,
                            "input_type": "keyboard",
                            "identity_sha256": active_identity,
                            "added_event": added_event,
                            "removed_event": None,
                            "inventory_start": start_receipt,
                            "inventory_stop": None,
                            "complete": False,
                        }

                if planned_units == 0:
                    empty_start = barrier(f"{action_name}:empty:start")
                    if seal is not None and previous_end is not None:
                        gap_summary = seal.summarize(previous_end, empty_start)
                        merge_summary(gap_summary, "gap")
                        reject_interval(
                            gap_summary,
                            "compositor target changed before the empty keyboard transaction",
                        )
                    check_target()
                    empty_end = barrier(f"{action_name}:empty:end")
                    if seal is not None:
                        empty_summary = seal.summarize(empty_start, empty_end)
                        merge_summary(empty_summary, "unit")
                        reject_interval(
                            empty_summary,
                            "compositor target changed during the empty keyboard transaction",
                        )
                    previous_end = empty_end

                for index in range(planned_units):
                    if time.monotonic() >= deadline:
                        raise ToolError(
                            "keyboard focus fence reached the action-duration limit; no further input was emitted"
                        )
                    start_sequence = barrier(f"{action_name}:{index}:start")
                    if seal is not None and previous_end is not None:
                        gap_summary = seal.summarize(previous_end, start_sequence)
                        merge_summary(gap_summary, "gap")
                        reject_interval(
                            gap_summary,
                            "compositor target changed between keyboard units; no further input was emitted",
                        )

                    unit_error: Exception | None = None
                    post_transition: KeyboardTargetTransition | None = None
                    dispatched = False
                    unit_checkpoint_sequence = start_sequence

                    def authorization_checkpoint(label: str) -> None:
                        """Seal and revalidate immediately before a deferred release.

                        Most keyboard units emit their complete consequence in one
                        helper command.  PasteSeal is different: the paste chord first
                        causes the compositor to request clipboard data, and the
                        controller releases bytes only later.  This callback closes
                        the event interval since the previous checkpoint, rejects any
                        focus/topology excursion, and checks the exact target on both
                        sides of the authenticated Sway barrier before the caller may
                        authorize that deferred transfer.
                        """
                        nonlocal unit_checkpoint_sequence
                        safe_label = re.sub(r"[^A-Za-z0-9_.:-]+", "-", label)[:96]
                        if not safe_label:
                            raise ToolError("keyboard authorization checkpoint label is empty")
                        check_target()
                        checkpoint_sequence = barrier(
                            f"{action_name}:{index}:authorization:{safe_label}"
                        )
                        if seal is not None:
                            authorization_summary = seal.summarize(
                                unit_checkpoint_sequence,
                                checkpoint_sequence,
                            )
                            merge_summary(authorization_summary, "authorization")
                            reject_interval(
                                authorization_summary,
                                "compositor target changed before deferred keyboard consequence release",
                            )
                        check_target()
                        unit_checkpoint_sequence = checkpoint_sequence

                    try:
                        check_target()
                        dispatch(transaction, index, authorization_checkpoint)
                        dispatched = True
                        evidence["completed_units"] = index + 1
                        try:
                            check_target()
                        except KeyboardTargetTransition as error:
                            post_transition = error
                    except Exception as error:
                        unit_error = error

                    try:
                        end_sequence = barrier(f"{action_name}:{index}:end")
                        if seal is not None:
                            unit_summary = seal.summarize(unit_checkpoint_sequence, end_sequence)
                            merge_summary(unit_summary, "unit")
                        else:
                            unit_summary = {
                                "fatal_events": 0,
                                "transition_events": 0,
                                "changes": [],
                            }
                    except Exception as seal_error:
                        if unit_error is not None:
                            raise ToolError(
                                "compositor event seal failed while a keyboard unit also failed; input stopped"
                            ) from seal_error
                        raise
                    previous_end = end_sequence
                    reject_interval(
                        unit_summary,
                        "compositor environment changed during guarded keyboard input",
                        reject_transitions=False,
                    )
                    if unit_error is not None:
                        raise unit_error
                    if not dispatched:
                        raise ToolError("keyboard unit was not dispatched")

                    event_transition = int(unit_summary.get("transition_events", 0)) > 0
                    if post_transition is not None or event_transition:
                        if index + 1 < planned_units:
                            if post_transition is not None:
                                raise post_transition
                            raise KeyboardTargetTransition(
                                transition_reason(
                                    unit_summary,
                                    "compositor target changed during a keyboard unit; no further input was emitted",
                                )
                            )
                        record_final_transition(
                            unit_summary,
                            post_transition,
                            phase="unit",
                        )

                    if interval and index + 1 < planned_units:
                        remaining = deadline - time.monotonic()
                        if remaining <= 0 or interval > remaining:
                            raise ToolError(
                                "keyboard focus fence reached the action-duration limit; no further input was emitted"
                            )
                        time.sleep(interval)

            evidence[transport_evidence_key] = transaction.evidence()
            cleanup_end = barrier(f"{action_name}:cleanup:end")
            if seal is not None and previous_end is not None:
                cleanup_summary = seal.summarize(previous_end, cleanup_end)
                merge_summary(cleanup_summary, "cleanup")
                reject_interval(
                    cleanup_summary,
                    "compositor environment changed while closing the guarded keyboard transport",
                    reject_transitions=False,
                    allow_input_lifecycle=virtual_device_lifecycle,
                )
                if virtual_device_lifecycle:
                    lifecycle_evidence = evidence.get("virtual_device_lifecycle")
                    if not isinstance(lifecycle_evidence, dict):
                        raise ToolError("SeatSeal keyboard lifecycle evidence is unavailable during cleanup")
                    removed_event = CompositorEventLedger.require_input_lifecycle(
                        cleanup_summary,
                        "removed",
                        "keyboard",
                        "guarded keyboard cleanup did not prove exact virtual-device removal",
                        expected_identity_sha256=str(lifecycle_evidence.get("identity_sha256")),
                    )
                    lifecycle_evidence["removed_event"] = removed_event
                    lifecycle_evidence["inventory_stop"] = transaction.seat_stop_receipt
                    lifecycle_evidence["complete"] = True
                if int(cleanup_summary.get("transition_events", 0)):
                    if planned_units == 0:
                        raise KeyboardTargetTransition(
                            transition_reason(
                                cleanup_summary,
                                "compositor target changed during an empty keyboard transaction",
                            )
                        )
                    record_final_transition(cleanup_summary, phase="cleanup")
            evidence["focus_intact"] = not bool(evidence["final_focus_transition"])
            evidence["elapsed_milliseconds"] = round((time.monotonic() - started) * 1000, 3)
            finalize_event_evidence()
            self.journal.append(
                journal_kind,
                action_name,
                {
                    "target_window_id": target.get("window_id"),
                    "target_launch_id": target.get("launch_id"),
                    "method": method,
                    "unit_kind": unit_kind,
                    "planned_units": planned_units,
                },
                evidence,
            )
            return evidence
        except Exception as error:
            primary_error: Exception = error
            if transaction is not None:
                evidence[transport_evidence_key] = transaction.evidence()
            # The context manager has already driven the birth-pinned keyboard to
            # a released state (or quarantined it) before control reaches this
            # handler. Drain the authenticated compositor stream through that
            # teardown as evidence, even though the earlier error has already
            # denied success. This mirrors the pointer failure-cleanup seal and
            # prevents a failed action from leaving an unaccounted event tail.
            if seal is not None and previous_end is not None:
                try:
                    failure_cleanup_end = barrier(f"{action_name}:failure-cleanup:end")
                    failure_cleanup_summary = seal.summarize(previous_end, failure_cleanup_end)
                    merge_summary(failure_cleanup_summary, "cleanup")
                    previous_end = failure_cleanup_end
                except Exception as seal_error:
                    primary_error = ToolError(
                        f"{error}; compositor event sealing also failed during keyboard cleanup: {seal_error}"
                    )
            evidence["elapsed_milliseconds"] = round((time.monotonic() - started) * 1000, 3)
            evidence["focus_intact"] = False
            finalize_event_evidence()
            self.journal.append(
                journal_kind,
                action_name,
                {
                    "target_window_id": target.get("window_id"),
                    "target_launch_id": target.get("launch_id"),
                    "method": method,
                    "unit_kind": unit_kind,
                    "planned_units": planned_units,
                },
                evidence,
                error=str(primary_error),
            )
            raise primary_error

    @staticmethod
    def _normalize_paste_chord(value: Any) -> str:
        chord = as_string(value, "paste_chord", maximum=64, allow_empty=False)
        raw_tokens = chord.split("+")
        if any(not token.strip() for token in raw_tokens):
            raise ToolError("paste chord contains an empty token")
        aliases = {"CONTROL": "CTRL", "CTL": "CTRL"}
        tokens = [aliases.get(token.strip().upper(), token.strip().upper()) for token in raw_tokens]
        if len(tokens) != len(set(tokens)):
            raise ToolError("paste chord contains a duplicate key or modifier")
        token_set = frozenset(tokens)
        if token_set == frozenset({"CTRL", "V"}) and len(tokens) == 2:
            canonical = "CTRL+V"
        elif token_set == frozenset({"SHIFT", "INSERT"}) and len(tokens) == 2:
            canonical = "SHIFT+INSERT"
        elif token_set == frozenset({"CTRL", "SHIFT", "V"}) and len(tokens) == 3:
            canonical = "CTRL+SHIFT+V"
        else:
            raise ToolError(
                "paste_chord must be CTRL+V, SHIFT+INSERT, or CTRL+SHIFT+V"
            )
        if canonical not in RICH_PASTE_CHORDS:
            raise ToolError("paste chord is outside the RichPasteSeal allowlist")
        return canonical

    @staticmethod
    def _canonical_project_relative_path(value: Any, label: str) -> str:
        raw = as_string(value, label, maximum=4096, allow_empty=False)
        candidate = Path(raw)
        parts = candidate.parts
        if (
            "\x00" in raw
            or "\\" in raw
            or any(ord(character) < 32 or ord(character) == 127 for character in raw)
            or candidate.is_absolute()
            or not parts
            or candidate.as_posix() != raw
            or len(parts) > 256
            or any(part in {"", ".", ".."} for part in parts)
        ):
            raise ToolError(
                f"{label} must be one canonical relative POSIX path inside the selected project"
            )
        return raw

    def _read_project_file_snapshot(
        self,
        value: Any,
        *,
        maximum_bytes: int,
        label: str,
        minimum_bytes: int = 1,
    ) -> tuple[bytes, dict[str, int]]:
        """Read one race-checked project file through retained directory FDs.

        O_NOFOLLOW is applied to every component. Exact Linux mount identity,
        ownership, type, link count, size, and mutable timestamps are checked
        before and after the bounded read. The final file is opened O_NONBLOCK
        so a hostile FIFO/device cannot stall the controller before fstat rejects
        it. No source descriptor is inherited by the clipboard helper.
        """
        raw = self._canonical_project_relative_path(value, label)
        candidate = Path(raw)
        parts = candidate.parts
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise ToolError("descriptor-relative no-follow project admission is unavailable")

        def descriptor_mount_id(descriptor: int) -> int:
            fdinfo_path = f"/proc/self/fdinfo/{descriptor}"
            fdinfo_descriptor: int | None = None
            try:
                fdinfo_descriptor = os.open(
                    fdinfo_path, os.O_RDONLY | os.O_CLOEXEC | nofollow
                )
                data = bytearray()
                while len(data) < 16384:
                    chunk = os.read(fdinfo_descriptor, 4096)
                    if not chunk:
                        break
                    data.extend(chunk)
                if len(data) >= 16384 and os.read(fdinfo_descriptor, 1):
                    raise ToolError(f"{label} mount identity record is oversized")
            except ToolError:
                raise
            except OSError as error:
                raise ToolError(f"{label} mount identity could not be verified") from error
            finally:
                if fdinfo_descriptor is not None:
                    with contextlib.suppress(OSError):
                        os.close(fdinfo_descriptor)
            for line in bytes(data).splitlines():
                if line.startswith(b"mnt_id:"):
                    try:
                        mnt_id = int(line.partition(b":")[2].strip(), 10)
                    except ValueError as error:
                        raise ToolError(f"{label} mount identity record is malformed") from error
                    if mnt_id <= 0:
                        raise ToolError(f"{label} mount identity record is invalid")
                    return mnt_id
            raise ToolError(f"{label} mount identity record is unavailable")

        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow
        descriptors: list[int] = []
        try:
            root_descriptor = os.open(self.project, directory_flags)
            descriptors.append(root_descriptor)
            root_metadata = os.fstat(root_descriptor)
            root_mnt_id = descriptor_mount_id(root_descriptor)
            if not stat.S_ISDIR(root_metadata.st_mode) or root_metadata.st_uid != os.geteuid():
                raise ToolError("selected project root lost its trusted directory identity")
            parent_descriptor = root_descriptor
            for index, part in enumerate(parts):
                final = index == len(parts) - 1
                flags = file_flags if final else directory_flags
                try:
                    descriptor = os.open(part, flags, dir_fd=parent_descriptor)
                except OSError as error:
                    raise ToolError(
                        f"{label} could not be opened without following symlinks"
                    ) from error
                descriptors.append(descriptor)
                metadata = os.fstat(descriptor)
                mnt_id = descriptor_mount_id(descriptor)
                if (
                    metadata.st_dev != root_metadata.st_dev
                    or metadata.st_uid != os.geteuid()
                    or mnt_id != root_mnt_id
                ):
                    raise ToolError(
                        f"{label} crosses an untrusted project filesystem, mount, or owner boundary"
                    )
                if final:
                    if not stat.S_ISREG(metadata.st_mode):
                        raise ToolError(f"{label} must name a regular file")
                    if metadata.st_nlink != 1:
                        raise ToolError(f"{label} must be a single-link project file")
                elif not stat.S_ISDIR(metadata.st_mode):
                    raise ToolError(f"{label} contains a non-directory path component")
                parent_descriptor = descriptor
            descriptor = descriptors[-1]
            before = os.fstat(descriptor)
            if (
                minimum_bytes < 0
                or minimum_bytes > maximum_bytes
                or before.st_size < minimum_bytes
                or before.st_size > maximum_bytes
            ):
                raise ToolError(f"{label} exceeds its bounded snapshot size")
            chunks = bytearray()
            while len(chunks) < before.st_size:
                chunk = os.read(
                    descriptor,
                    min(1024 * 1024, before.st_size - len(chunks)),
                )
                if not chunk:
                    raise ToolError(f"{label} was truncated while being snapshotted")
                chunks.extend(chunk)
            if os.read(descriptor, 1):
                raise ToolError(f"{label} grew while being snapshotted")
            after = os.fstat(descriptor)
            stable_fields = (
                "st_dev", "st_ino", "st_uid", "st_mode", "st_nlink", "st_size",
                "st_mtime_ns", "st_ctime_ns",
            )
            if (
                any(getattr(before, field) != getattr(after, field) for field in stable_fields)
                or descriptor_mount_id(descriptor) != root_mnt_id
            ):
                raise ToolError(f"{label} changed while being snapshotted")
            return bytes(chunks), {
                "source_bytes": len(chunks),
                "source_mode": stat.S_IMODE(after.st_mode),
                "source_links": after.st_nlink,
            }
        finally:
            for descriptor in reversed(descriptors):
                with contextlib.suppress(OSError):
                    os.close(descriptor)

    @staticmethod
    def _descriptor_mount_id(descriptor: int, label: str) -> int:
        """Return Linux mount identity for one retained descriptor.

        Device numbers alone do not distinguish bind mounts. FileCopySeal uses
        ``mnt_id`` from ``/proc/self/fdinfo`` to keep every selected path on the
        exact launch-output mount admitted by the controller.
        """
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow:
            raise ToolError(f"{label} mount identity cannot be checked without O_NOFOLLOW")
        fdinfo_descriptor: int | None = None
        data = bytearray()
        try:
            fdinfo_descriptor = os.open(
                f"/proc/self/fdinfo/{descriptor}",
                os.O_RDONLY | os.O_CLOEXEC | nofollow,
            )
            while len(data) < 16384:
                chunk = os.read(fdinfo_descriptor, 4096)
                if not chunk:
                    break
                data.extend(chunk)
            if len(data) >= 16384 and os.read(fdinfo_descriptor, 1):
                raise ToolError(f"{label} mount identity record is oversized")
        except ToolError:
            raise
        except OSError as error:
            raise ToolError(f"{label} mount identity could not be verified") from error
        finally:
            if fdinfo_descriptor is not None:
                with contextlib.suppress(OSError):
                    os.close(fdinfo_descriptor)
        for line in bytes(data).splitlines():
            if not line.startswith(b"mnt_id:"):
                continue
            try:
                value = int(line.partition(b":")[2].strip(), 10)
            except ValueError as error:
                raise ToolError(f"{label} mount identity record is malformed") from error
            if value <= 0:
                raise ToolError(f"{label} mount identity record is invalid")
            return value
        raise ToolError(f"{label} mount identity record is unavailable")

    @staticmethod
    def _decode_file_copy_uri_component(raw: str, label: str) -> str:
        if not raw or len(raw) > 1024 or "\\" in raw:
            raise ToolError(f"{label} contains an invalid URI path component")
        encoded = bytearray()
        index = 0
        while index < len(raw):
            character = raw[index]
            value = ord(character)
            if character == "%":
                if index + 2 >= len(raw) or re.fullmatch(
                    r"[0-9A-Fa-f]{2}", raw[index + 1 : index + 3]
                ) is None:
                    raise ToolError(f"{label} contains a malformed percent escape")
                encoded.append(int(raw[index + 1 : index + 3], 16))
                index += 3
                continue
            if value < 0x21 or value > 0x7E or character in {"/", "?", "#"}:
                raise ToolError(f"{label} contains a noncanonical URI byte")
            encoded.append(value)
            index += 1
        try:
            decoded = bytes(encoded).decode("utf-8", "strict")
        except UnicodeDecodeError as error:
            raise ToolError(f"{label} is not a strict UTF-8 file name") from error
        if (
            decoded in {"", ".", ".."}
            or "/" in decoded
            or "\\" in decoded
            or "\x00" in decoded
            or len(encoded) > 255
            or any(ord(character) < 32 or ord(character) == 127 for character in decoded)
            or not all(character.isprintable() for character in decoded)
        ):
            raise ToolError(f"{label} decodes to an unsafe file name")
        return decoded

    @classmethod
    def _parse_file_copy_uri_list(cls, payload: bytes | bytearray) -> list[tuple[str, ...]]:
        """Parse one source-blind clipboard offer into launch-output paths.

        Comments and both RFC-style CRLF and common LF framing are accepted for
        toolkit compatibility. Every effective record must still be an
        authority-free local file URI below the fixed app-visible output mount.
        Percent decoding occurs one component at a time so encoded separators,
        traversal, controls, and malformed UTF-8 cannot alter path structure.
        """
        if not 1 <= len(payload) <= MAX_FILE_COPY_URI_LIST_BYTES:
            raise ToolError("FileCopySeal URI list exceeds its bounded payload limit")
        try:
            text = payload.decode("ascii", "strict")
        except UnicodeDecodeError as error:
            raise ToolError("FileCopySeal URI list must contain ASCII URI syntax") from error
        if "\x00" in text or re.search(r"\r(?!\n)", text):
            raise ToolError("FileCopySeal URI list has forbidden control framing")
        if any(
            ord(character) < 32 and character not in {"\r", "\n"}
            or ord(character) == 127
            for character in text
        ):
            raise ToolError("FileCopySeal URI list contains forbidden control bytes")

        prefix = f"file://{FILE_COPY_MOUNT}/"
        paths: list[tuple[str, ...]] = []
        seen: set[tuple[str, ...]] = set()
        for record_number, record in enumerate(re.split(r"\r?\n", text), start=1):
            if not record or record.startswith("#"):
                continue
            if len(record) > 8192 or not record.startswith(prefix):
                raise ToolError(
                    "FileCopySeal accepts only local file URIs from the exact launch output mount"
                )
            if "?" in record or "#" in record:
                raise ToolError("FileCopySeal file URIs cannot contain a query or fragment")
            relative_raw = record[len(prefix) :]
            raw_parts = relative_raw.split("/")
            if (
                not relative_raw
                or len(raw_parts) > 256
                or any(part == "" for part in raw_parts)
            ):
                raise ToolError("FileCopySeal file URI has an invalid relative path")
            decoded = tuple(
                cls._decode_file_copy_uri_component(
                    part,
                    f"FileCopySeal URI record {record_number} component {index}",
                )
                for index, part in enumerate(raw_parts, start=1)
            )
            if decoded in seen:
                raise ToolError("FileCopySeal URI list contains a duplicate path")
            seen.add(decoded)
            paths.append(decoded)
            if len(paths) > MAX_FILE_COPY_FILES:
                raise ToolError("FileCopySeal URI list contains too many files")
        if not paths:
            raise ToolError("FileCopySeal URI list contains no file records")
        return paths

    @classmethod
    def _normalize_launch_output_relative_path(
        cls,
        value: Any,
        label: str,
    ) -> tuple[str, ...]:
        """Normalize one explicit path below the fixed launch-output root.

        OutputSnapshotSeal deliberately accepts no host path and performs no
        path expansion. The caller supplies one strict NFC UTF-8 slash-separated
        relative path. Dot segments, empty components, aliases, controls,
        overlong names, and backslashes are rejected before any filesystem
        descriptor is opened. The later FileCopySeal walk remains authoritative
        for type, owner, device, mount, link, identity, and stability checks.
        """
        path = as_string(
            value,
            label,
            maximum=MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES,
            allow_empty=False,
        )
        if (
            path.startswith("/")
            or path.endswith("/")
            or "//" in path
            or "\\" in path
            or unicodedata.normalize("NFC", path) != path
        ):
            raise ToolError(f"{label} must be one canonical launch-output-relative path")
        raw_parts = path.split("/")
        if not raw_parts or len(raw_parts) > 256:
            raise ToolError(f"{label} has an invalid component count")
        parts = tuple(
            cls._directory_copy_name(
                part,
                f"{label} component {index}",
            )
            for index, part in enumerate(raw_parts, start=1)
        )
        encoded = b"/".join(os.fsencode(part) for part in parts)
        if len(encoded) > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES:
            raise ToolError(f"{label} exceeds its launch-output-relative byte ceiling")
        return parts

    @classmethod
    def _launch_output_uri_payload(
        cls,
        paths: tuple[tuple[str, ...], ...] | list[tuple[str, ...]],
    ) -> bytes:
        """Encode controller-normalized launch-output paths as canonical URIs."""
        if not 1 <= len(paths) <= MAX_FILE_COPY_FILES:
            raise ToolError("OutputSnapshotSeal requires from one through eight source paths")
        records: list[str] = []
        seen: set[tuple[str, ...]] = set()
        for index, parts in enumerate(paths, start=1):
            if not parts or parts in seen:
                raise ToolError("OutputSnapshotSeal source paths must be unique and non-empty")
            seen.add(parts)
            encoded = "/".join(
                urllib.parse.quote_from_bytes(os.fsencode(part), safe="")
                for part in parts
            )
            record = f"file://{FILE_COPY_MOUNT}/{encoded}"
            if len(record) > 8192:
                raise ToolError(f"OutputSnapshotSeal source path {index} is too long")
            records.append(record)
        payload = ("\r\n".join(records) + "\r\n").encode("ascii")
        if len(payload) > MAX_FILE_COPY_URI_LIST_BYTES:
            raise ToolError("OutputSnapshotSeal canonical path envelope exceeds its byte ceiling")
        # Make the shared parser prove that controller construction and
        # application-originated URI admission agree exactly.
        if cls._parse_file_copy_uri_list(payload) != list(paths):
            raise ToolError("OutputSnapshotSeal canonical path envelope is inconsistent")
        return payload

    def _launch_output_root(
        self, launch_id: str
    ) -> tuple[ManagedProcess, Path, os.stat_result]:
        """Resolve one exact app-visible output root without following aliases."""
        managed = self._managed_by_launch_id(launch_id)
        expected = f"apps/{managed.launch_id}"
        if managed.output_subdirectory != expected:
            raise ToolError("launch has no valid FileCopySeal output root")
        parent = self.output / "apps"
        root = parent / managed.launch_id
        root_identity: os.stat_result | None = None
        for path, label in (
            (self.output, "desktop output root"),
            (parent, "application output root"),
            (root, "launch output root"),
        ):
            try:
                info = path.lstat()
            except OSError as error:
                raise ToolError(f"{label} is unavailable") from error
            if (
                not stat.S_ISDIR(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700
            ):
                raise ToolError(f"{label} is unsafe")
            if path == root:
                root_identity = info
        if root_identity is None:
            raise ToolError("launch output root identity is unavailable")
        return managed, root, root_identity

    def _assert_file_copy_source_custody(
        self,
        launch_id: str,
        source_mode: str,
    ) -> ManagedProcess:
        """Re-prove the authority appropriate to one bounded tree snapshot.

        Clipboard selection lacks a producer identity, so selection-backed
        copy still requires the launch to be the sole live managed principal.
        Explicit launch-output paths are already bound to one per-launch mount;
        they instead revalidate exact launch and live security-context custody,
        allowing safe export while other private workstation apps remain live.
        Project-directory transfer is destination-bound instead: every recursive
        checkpoint proves that the exact launch still owns its private drop root
        and that a previous uncertain cleanup has not quarantined that authority.
        """
        if source_mode == "selection":
            self._assert_clipboard_launch_exclusive(launch_id)
        elif source_mode not in {"launch-output", "output-watch", "project-transfer"}:
            raise ToolError("FileCopySeal source mode is invalid")
        managed = self._managed_by_launch_id(launch_id)
        if source_mode == "project-transfer":
            if (
                managed.launch_id != launch_id
                or getattr(managed, "drop_subdirectory", None) != f"drop/{launch_id}"
                or bool(getattr(managed, "drop_quarantined", False))
            ):
                raise ToolError(
                    "project directory transfer lost its exact launch-private destination custody"
                )
            return managed
        if (
            managed.launch_id != launch_id
            or managed.output_subdirectory != f"apps/{launch_id}"
        ):
            raise ToolError("launch-output snapshot lost its exact managed output custody")
        return managed

    def _output_watch_lease_store(self) -> dict[str, dict[str, Any]]:
        store = getattr(self, "output_watch_leases", None)
        if not isinstance(store, dict):
            store = {}
            self.output_watch_leases = store
        return store

    @staticmethod
    def _decode_output_watch_token(value: Any) -> tuple[bytearray, str]:
        token = as_string(
            value,
            "watch_token",
            maximum=OUTPUT_WATCH_TOKEN_LENGTH,
            allow_empty=False,
        )
        if (
            len(token) != OUTPUT_WATCH_TOKEN_LENGTH
            or re.fullmatch(r"[A-Za-z0-9_-]{43}", token) is None
        ):
            raise ToolError("OutputWatchSeal capability has an invalid encoding")
        try:
            raw = bytearray(base64.urlsafe_b64decode(token + "="))
        except (ValueError, binascii.Error) as error:
            raise ToolError("OutputWatchSeal capability has an invalid encoding") from error
        if (
            len(raw) != OUTPUT_WATCH_TOKEN_BYTES
            or base64.urlsafe_b64encode(bytes(raw)).decode("ascii").rstrip("=") != token
        ):
            raw[:] = b"\x00" * len(raw)
            raw.clear()
            raise ToolError("OutputWatchSeal capability is not canonical")
        return raw, token

    @staticmethod
    def _output_watch_manifest_groups(
        manifest: dict[str, Any],
    ) -> dict[str, tuple[tuple[str, tuple[str, ...], tuple[int, ...]], ...]]:
        entries = manifest.get("entries")
        if not isinstance(entries, tuple):
            raise ToolError("OutputWatchSeal manifest entries are invalid")
        grouped: dict[
            str, list[tuple[str, tuple[str, ...], tuple[int, ...]]]
        ] = {}
        for record in entries:
            if (
                not isinstance(record, tuple)
                or len(record) != 3
                or record[0] not in {"file", "directory"}
                or not isinstance(record[1], tuple)
                or not record[1]
                or not isinstance(record[2], tuple)
            ):
                raise ToolError("OutputWatchSeal manifest record is invalid")
            kind = str(record[0])
            parts = record[1]
            identity = record[2]
            if any(not isinstance(part, str) for part in parts) or any(
                not isinstance(field, int) for field in identity
            ):
                raise ToolError("OutputWatchSeal manifest record fields are invalid")
            grouped.setdefault(parts[0], []).append((kind, parts, identity))
        return {
            name: tuple(records)
            for name, records in sorted(grouped.items(), key=lambda item: os.fsencode(item[0]))
        }

    def _output_watch_manifest_seal(
        self,
        *,
        token_digest: str,
        launch_id: str,
        manifest: dict[str, Any],
        limits: dict[str, int],
        action_authority_sha256: str,
    ) -> str:
        if re.fullmatch(r"[0-9a-f]{64}", token_digest) is None:
            raise ToolError("OutputWatchSeal token digest is invalid")
        if re.fullmatch(r"[0-9a-f]{64}", action_authority_sha256) is None:
            raise ToolError("OutputWatchSeal arm action authority is invalid")
        return self._authority_digest({
            "schema": OUTPUT_WATCH_LEASE_SCHEMA,
            "token_digest": token_digest,
            "launch_id": launch_id,
            "manifest": manifest,
            "limits": limits,
            "action_authority_sha256": action_authority_sha256,
        })

    @staticmethod
    def _clear_output_watch_lease_record(lease: dict[str, Any]) -> None:
        """Release path-bearing watch state as soon as its authority ends."""
        manifest = lease.get("manifest")
        limits = lease.get("limits")
        if isinstance(manifest, dict):
            manifest.clear()
        if isinstance(limits, dict):
            limits.clear()
        lease.clear()

    def _prune_output_watch_leases(self) -> int:
        store = self._output_watch_lease_store()
        if not store:
            return 0
        now = time.monotonic()
        removed = 0
        for digest, lease in list(store.items()):
            created = lease.get("created_monotonic") if isinstance(lease, dict) else None
            launch_id = lease.get("launch_id") if isinstance(lease, dict) else None
            manifest = lease.get("manifest") if isinstance(lease, dict) else None
            limits = lease.get("limits") if isinstance(lease, dict) else None
            action_authority = (
                lease.get("action_authority_sha256")
                if isinstance(lease, dict)
                else None
            )
            expected_seal = lease.get("baseline_seal") if isinstance(lease, dict) else None
            invalid = (
                re.fullmatch(r"[0-9a-f]{64}", digest) is None
                or not isinstance(created, (int, float))
                or created > now
                or now - float(created) > OUTPUT_WATCH_LEASE_TTL_SECONDS
                or not isinstance(launch_id, str)
                or not isinstance(manifest, dict)
                or not isinstance(limits, dict)
                or not isinstance(action_authority, str)
                or re.fullmatch(r"[0-9a-f]{64}", action_authority) is None
                or not isinstance(expected_seal, str)
            )
            if not invalid:
                try:
                    actual_seal = self._output_watch_manifest_seal(
                        token_digest=digest,
                        launch_id=launch_id,
                        manifest=manifest,
                        limits=limits,
                        action_authority_sha256=action_authority,
                    )
                    self._assert_file_copy_source_custody(launch_id, "output-watch")
                    self._launch_output_root(launch_id)
                    invalid = not hmac.compare_digest(actual_seal, expected_seal)
                except (ToolError, OSError, TypeError, ValueError):
                    invalid = True
            if invalid:
                retained = store.pop(digest, None)
                if isinstance(retained, dict):
                    self._clear_output_watch_lease_record(retained)
                removed += 1
        return removed

    def _revoke_output_watch_leases_for_launch(self, launch_id: str) -> int:
        """Drop every unspent OutputWatchSeal capability for one dead launch.

        OutputWatchSeal is an exact launch-lifetime authority.  Expiry and
        consumption already remove leases, but waiting for a later operation to
        prune a capability after its application exits leaves unnecessary
        controller-memory state behind.  Teardown therefore revokes matching
        leases synchronously before removing the launch's private filesystem
        and Wayland context.
        """
        store = self._output_watch_lease_store()
        removed = 0
        for digest, lease in list(store.items()):
            if not isinstance(lease, dict) or lease.get("launch_id") != launch_id:
                continue
            retained = store.pop(digest, None)
            if isinstance(retained, dict):
                self._clear_output_watch_lease_record(retained)
            removed += 1
        return removed

    def _output_watch_scan_manifest(
        self,
        launch_id: str,
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        maximum_entries: int,
        maximum_directories: int,
        maximum_depth: int,
        deadline: float,
    ) -> dict[str, Any]:
        """Build one descriptor-relative identity manifest of an exact output root.

        This intentionally reads metadata only.  Names never leave controller
        memory, content is never hashed, and every child is opened with
        O_NOFOLLOW on the exact launch-output mount.  Concurrent mutations are
        classified separately so the bounded quiescence loop may retry without
        weakening rejection of aliases, hard links, special nodes, or mount
        crossings.
        """
        maximum_file_bytes = as_int(
            maximum_file_bytes, 0, MAX_FILE_COPY_FILE_BYTES, "maximum_file_bytes"
        )
        maximum_total_bytes = as_int(
            maximum_total_bytes,
            0,
            min(MAX_FILE_COPY_TOTAL_BYTES, self.max_output_bytes),
            "maximum_total_bytes",
        )
        maximum_entries = as_int(
            maximum_entries, 0, MAX_DIRECTORY_COPY_ENTRIES, "maximum_entries"
        )
        maximum_directories = as_int(
            maximum_directories,
            1,
            MAX_DIRECTORY_COPY_DIRECTORIES,
            "maximum_directories",
        )
        maximum_depth = as_int(
            maximum_depth, 0, MAX_DIRECTORY_COPY_DEPTH, "maximum_depth"
        )
        if maximum_file_bytes > maximum_total_bytes:
            raise ToolError("maximum_file_bytes cannot exceed maximum_total_bytes")
        if not isinstance(deadline, (int, float)) or not math.isfinite(deadline):
            raise ToolError("OutputWatchSeal deadline is invalid")

        managed, source_root, source_path_identity = self._launch_output_root(launch_id)
        self._assert_file_copy_source_custody(managed.launch_id, "output-watch")
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if (
            not nofollow
            or not hasattr(os, "O_DIRECTORY")
            or os.scandir not in os.supports_fd
        ):
            raise ToolError("OutputWatchSeal descriptor no-follow boundary is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow
        root_fd: int | None = None
        state: dict[str, Any] = {
            "entries": [],
            "seen_inodes": set(),
            "entry_count": 0,
            "directory_count": 1,
            "file_count": 0,
            "total_bytes": 0,
        }

        def checkpoint() -> None:
            if time.monotonic() > float(deadline):
                raise ToolError("OutputWatchSeal exceeded its bounded scan time")
            self._assert_file_copy_source_custody(managed.launch_id, "output-watch")

        def validate_descriptor(
            info: os.stat_result,
            descriptor: int,
            *,
            root_info: os.stat_result,
            root_mount: int,
            label: str,
        ) -> None:
            if (
                info.st_dev != root_info.st_dev
                or info.st_uid != os.geteuid()
                or self._descriptor_mount_id(descriptor, label) != root_mount
            ):
                raise ToolError(
                    "OutputWatchSeal source crosses its launch-output owner, device, or mount boundary"
                )

        def walk(
            descriptor: int,
            *,
            root_info: os.stat_result,
            root_mount: int,
            relative_parts: tuple[str, ...],
            depth: int,
        ) -> None:
            checkpoint()
            before = os.fstat(descriptor)
            validate_descriptor(
                before,
                descriptor,
                root_info=root_info,
                root_mount=root_mount,
                label="OutputWatchSeal retained directory",
            )
            if not stat.S_ISDIR(before.st_mode):
                raise ToolError("OutputWatchSeal retained source is not a directory")
            names = self._directory_copy_names(
                descriptor,
                maximum=max(0, maximum_entries - state["entry_count"]),
                label="OutputWatchSeal source directory",
            )
            for entry_index, name in enumerate(names, start=1):
                checkpoint()
                child_depth = depth + 1
                if child_depth > maximum_depth:
                    raise ToolError("OutputWatchSeal exceeds maximum_depth")
                child_parts = (*relative_parts, name)
                if (
                    len(b"/".join(os.fsencode(part) for part in child_parts))
                    > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES
                ):
                    raise ToolError("OutputWatchSeal relative path exceeds its byte ceiling")
                state["entry_count"] += 1
                if state["entry_count"] > maximum_entries:
                    raise ToolError("OutputWatchSeal exceeds maximum_entries")
                child_fd: int | None = None
                try:
                    try:
                        pre = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
                    except FileNotFoundError as error:
                        raise OutputWatchUnstable(
                            "OutputWatchSeal source changed during bounded scan"
                        ) from error
                    if pre.st_dev != root_info.st_dev or pre.st_uid != os.geteuid():
                        raise ToolError(
                            "OutputWatchSeal source crosses its launch-output owner or device boundary"
                        )
                    if stat.S_ISLNK(pre.st_mode):
                        raise ToolError("OutputWatchSeal rejects symbolic links")
                    flags = directory_flags if stat.S_ISDIR(pre.st_mode) else file_flags
                    try:
                        child_fd = os.open(name, flags, dir_fd=descriptor)
                    except FileNotFoundError as error:
                        raise OutputWatchUnstable(
                            "OutputWatchSeal source changed during bounded scan"
                        ) from error
                    opened = os.fstat(child_fd)
                    validate_descriptor(
                        opened,
                        child_fd,
                        root_info=root_info,
                        root_mount=root_mount,
                        label=f"OutputWatchSeal entry {entry_index}",
                    )
                    if self._directory_copy_identity(opened) != self._directory_copy_identity(pre):
                        raise OutputWatchUnstable(
                            "OutputWatchSeal source changed during bounded scan"
                        )
                    inode = (opened.st_dev, opened.st_ino)
                    if inode in state["seen_inodes"]:
                        raise ToolError("OutputWatchSeal source tree contains a repeated inode")
                    state["seen_inodes"].add(inode)
                    if stat.S_ISDIR(opened.st_mode):
                        state["directory_count"] += 1
                        if state["directory_count"] > maximum_directories:
                            raise ToolError("OutputWatchSeal exceeds maximum_directories")
                        state["entries"].append(
                            ("directory", child_parts, self._directory_copy_identity(opened))
                        )
                        walk(
                            child_fd,
                            root_info=root_info,
                            root_mount=root_mount,
                            relative_parts=child_parts,
                            depth=child_depth,
                        )
                    elif stat.S_ISREG(opened.st_mode):
                        if opened.st_nlink != 1:
                            raise ToolError(
                                "OutputWatchSeal accepts only regular single-link files"
                            )
                        if opened.st_size < 0 or opened.st_size > maximum_file_bytes:
                            raise ToolError("OutputWatchSeal file exceeds maximum_file_bytes")
                        if state["total_bytes"] + opened.st_size > maximum_total_bytes:
                            raise ToolError("OutputWatchSeal tree exceeds maximum_total_bytes")
                        after = os.fstat(child_fd)
                        if self._directory_copy_identity(after) != self._directory_copy_identity(opened):
                            raise OutputWatchUnstable(
                                "OutputWatchSeal source changed during bounded scan"
                            )
                        state["file_count"] += 1
                        state["total_bytes"] += opened.st_size
                        state["entries"].append(
                            ("file", child_parts, self._directory_copy_identity(after))
                        )
                    else:
                        raise ToolError(
                            "OutputWatchSeal rejects non-regular, non-directory source entries"
                        )

                    verify_fd: int | None = None
                    try:
                        verify_fd = os.open(name, flags, dir_fd=descriptor)
                        verified = os.fstat(verify_fd)
                        if (
                            self._directory_copy_identity(verified)
                            != self._directory_copy_identity(os.fstat(child_fd))
                            or self._descriptor_mount_id(
                                verify_fd,
                                f"OutputWatchSeal entry {entry_index} revalidation",
                            ) != root_mount
                        ):
                            raise OutputWatchUnstable(
                                "OutputWatchSeal source changed during bounded scan"
                            )
                    except FileNotFoundError as error:
                        raise OutputWatchUnstable(
                            "OutputWatchSeal source changed during bounded scan"
                        ) from error
                    finally:
                        if verify_fd is not None:
                            os.close(verify_fd)
                except (ToolError, OutputWatchUnstable):
                    raise
                except OSError as error:
                    raise ToolError(
                        "OutputWatchSeal source entry could not be inspected safely "
                        f"(errno={error.errno if error.errno is not None else 'unknown'})"
                    ) from error
                finally:
                    if child_fd is not None:
                        with contextlib.suppress(OSError):
                            os.close(child_fd)
            checkpoint()
            names_after = self._directory_copy_names(
                descriptor,
                maximum=len(names),
                label="OutputWatchSeal source directory completion",
            )
            after = os.fstat(descriptor)
            if (
                names_after != names
                or self._directory_copy_identity(after)
                != self._directory_copy_identity(before)
                or self._descriptor_mount_id(
                    descriptor, "OutputWatchSeal source directory completion"
                ) != root_mount
            ):
                raise OutputWatchUnstable(
                    "OutputWatchSeal source changed during bounded scan"
                )

        try:
            root_fd = os.open(source_root, directory_flags)
            root_info = os.fstat(root_fd)
            root_mount = self._descriptor_mount_id(
                root_fd, "OutputWatchSeal launch output root"
            )
            if (
                not stat.S_ISDIR(root_info.st_mode)
                or root_info.st_uid != os.geteuid()
                or stat.S_IMODE(root_info.st_mode) != 0o700
                or root_info.st_dev != source_path_identity.st_dev
                or root_info.st_ino != source_path_identity.st_ino
            ):
                raise ToolError("OutputWatchSeal launch output root lost its trusted identity")
            state["seen_inodes"].add((root_info.st_dev, root_info.st_ino))
            walk(
                root_fd,
                root_info=root_info,
                root_mount=root_mount,
                relative_parts=(),
                depth=0,
            )
            checkpoint()
            try:
                path_after = source_root.lstat()
            except OSError as error:
                raise OutputWatchUnstable(
                    "OutputWatchSeal source root changed during bounded scan"
                ) from error
            root_after = os.fstat(root_fd)
            if (
                self._directory_copy_identity(root_after)
                != self._directory_copy_identity(root_info)
                or self._directory_copy_identity(path_after)
                != self._directory_copy_identity(root_info)
                or self._descriptor_mount_id(
                    root_fd, "OutputWatchSeal launch output root completion"
                ) != root_mount
            ):
                raise OutputWatchUnstable(
                    "OutputWatchSeal source root changed during bounded scan"
                )
            self._assert_file_copy_source_custody(managed.launch_id, "output-watch")
            return {
                "root_identity": self._directory_copy_identity(root_after),
                "root_principal": self._directory_copy_identity(root_after)[:5],
                "root_mount": root_mount,
                "entries": tuple(state["entries"]),
                "entry_count": state["entry_count"],
                "directory_count": state["directory_count"],
                "file_count": state["file_count"],
                "total_bytes": state["total_bytes"],
            }
        finally:
            if root_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(root_fd)

    def _wait_for_output_watch_manifest(
        self,
        launch_id: str,
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        maximum_entries: int,
        maximum_directories: int,
        maximum_depth: int,
        quiet_milliseconds: int,
        timeout_milliseconds: int,
        baseline: dict[str, Any] | None = None,
    ) -> dict[str, Any]:
        quiet_milliseconds = as_int(
            quiet_milliseconds,
            1,
            OUTPUT_WATCH_MAX_QUIET_MILLISECONDS,
            "quiet_milliseconds",
        )
        timeout_milliseconds = as_int(
            timeout_milliseconds,
            100,
            OUTPUT_WATCH_MAX_TIMEOUT_MILLISECONDS,
            "timeout_milliseconds",
        )
        if quiet_milliseconds >= timeout_milliseconds:
            raise ToolError("quiet_milliseconds must be smaller than timeout_milliseconds")
        deadline = time.monotonic() + timeout_milliseconds / 1000.0
        candidate: dict[str, Any] | None = None
        candidate_since = 0.0
        saw_change = baseline is None
        while True:
            now = time.monotonic()
            if now >= deadline:
                if baseline is None:
                    raise ToolError("OutputWatchSeal output root did not become quiescent")
                if not saw_change:
                    raise ToolError("OutputWatchSeal observed no post-baseline output change")
                raise ToolError("OutputWatchSeal changed output did not become quiescent")
            try:
                current = self._output_watch_scan_manifest(
                    launch_id,
                    maximum_file_bytes=maximum_file_bytes,
                    maximum_total_bytes=maximum_total_bytes,
                    maximum_entries=maximum_entries,
                    maximum_directories=maximum_directories,
                    maximum_depth=maximum_depth,
                    deadline=deadline,
                )
            except OutputWatchUnstable:
                candidate = None
                candidate_since = 0.0
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    continue
                time.sleep(min(OUTPUT_WATCH_POLL_MILLISECONDS / 1000.0, remaining))
                continue
            if baseline is not None and current == baseline:
                candidate = None
                candidate_since = 0.0
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    continue
                time.sleep(min(OUTPUT_WATCH_POLL_MILLISECONDS / 1000.0, remaining))
                continue
            if baseline is not None:
                saw_change = True
            now = time.monotonic()
            if candidate != current:
                candidate = current
                candidate_since = now
            elif (now - candidate_since) * 1000.0 >= quiet_milliseconds:
                return current
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                continue
            needed = max(
                0.001,
                quiet_milliseconds / 1000.0 - (time.monotonic() - candidate_since),
            )
            time.sleep(
                min(
                    OUTPUT_WATCH_POLL_MILLISECONDS / 1000.0,
                    needed,
                    remaining,
                )
            )

    def _store_output_watch_lease(
        self,
        *,
        token_digest: str,
        launch_id: str,
        manifest: dict[str, Any],
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        maximum_entries: int,
        maximum_directories: int,
        maximum_depth: int,
        action_authority_sha256: str,
    ) -> dict[str, Any]:
        self._prune_output_watch_leases()
        store = self._output_watch_lease_store()
        if len(store) >= MAX_OUTPUT_WATCH_LEASES:
            raise ToolError("OutputWatchSeal capability capacity is exhausted")
        if token_digest in store:
            raise ToolError("OutputWatchSeal capability identity collided")
        limits = {
            "maximum_file_bytes": maximum_file_bytes,
            "maximum_total_bytes": maximum_total_bytes,
            "maximum_entries": maximum_entries,
            "maximum_directories": maximum_directories,
            "maximum_depth": maximum_depth,
        }
        # Re-scan after the outer dispatch-complete TickSeal.  A baseline is
        # published only when the exact metadata identity still matches the
        # quiescent pre-dispatch capture; no stale capability can be minted.
        current = self._output_watch_scan_manifest(
            launch_id,
            **limits,
            deadline=time.monotonic() + min(5.0, MAX_DIRECTORY_COPY_SECONDS),
        )
        if current != manifest:
            raise ToolError(
                "OutputWatchSeal baseline changed before capability publication"
            )
        created = time.monotonic()
        baseline_seal = self._output_watch_manifest_seal(
            token_digest=token_digest,
            launch_id=launch_id,
            manifest=manifest,
            limits=limits,
            action_authority_sha256=action_authority_sha256,
        )
        lease = {
            "schema": OUTPUT_WATCH_LEASE_SCHEMA,
            "launch_id": launch_id,
            "created_monotonic": created,
            "manifest": manifest,
            "limits": limits,
            "baseline_seal": baseline_seal,
            "action_authority_sha256": action_authority_sha256,
        }
        store[token_digest] = lease
        return {
            "watching": True,
            "kind": "watch",
            "source_mode": "output-watch",
            "target_launch_id": launch_id,
            "baseline_entry_count": manifest["entry_count"],
            "baseline_file_count": manifest["file_count"],
            "baseline_directory_count": manifest["directory_count"],
            "baseline_total_bytes": manifest["total_bytes"],
            "watch_capability_ttl_seconds": int(OUTPUT_WATCH_LEASE_TTL_SECONDS),
            "watch_capability_one_attempt": True,
            "baseline_paths_exposed": False,
            "baseline_paths_persisted": False,
            "baseline_manifest_custody": "controller-memory-only",
            "stable_content_fingerprint_retained": False,
            "untrusted": True,
            "trust": "controlled-application-output-watch",
        }

    def _consume_output_watch_lease(
        self,
        *,
        watch_token: Any,
        launch_id: str,
        limits: dict[str, int],
    ) -> dict[str, Any]:
        raw, _canonical = self._decode_output_watch_token(watch_token)
        try:
            token_digest = _output_watch_token_digest(raw)
        finally:
            raw[:] = b"\x00" * len(raw)
            raw.clear()
        self._prune_output_watch_leases()
        store = self._output_watch_lease_store()
        # One attempt means consume before every live, scope, limit, or
        # filesystem check.  A failed post-consumption validation is not
        # retryable against a subtly different output tree.
        lease = store.pop(token_digest, None)
        if not isinstance(lease, dict):
            raise ToolError("OutputWatchSeal capability is absent, expired, or already consumed")
        try:
            created = lease.get("created_monotonic")
            sealed_launch = lease.get("launch_id")
            manifest = lease.get("manifest")
            sealed_limits = lease.get("limits")
            sealed_action_authority = lease.get("action_authority_sha256")
            baseline_seal = lease.get("baseline_seal")
            now = time.monotonic()
            if (
                lease.get("schema") != OUTPUT_WATCH_LEASE_SCHEMA
                or not isinstance(created, (int, float))
                or created > now
                or now - float(created) > OUTPUT_WATCH_LEASE_TTL_SECONDS
                or sealed_launch != launch_id
                or not isinstance(manifest, dict)
                or not isinstance(sealed_limits, dict)
                or not isinstance(sealed_action_authority, str)
                or re.fullmatch(r"[0-9a-f]{64}", sealed_action_authority) is None
                or not isinstance(baseline_seal, str)
            ):
                raise ToolError("OutputWatchSeal capability lost its immutable launch binding")
            expected_seal = self._output_watch_manifest_seal(
                token_digest=token_digest,
                launch_id=launch_id,
                manifest=manifest,
                limits=sealed_limits,
                action_authority_sha256=sealed_action_authority,
            )
            if not hmac.compare_digest(expected_seal, baseline_seal):
                raise ToolError("OutputWatchSeal capability baseline seal is invalid")
            for name, requested in limits.items():
                sealed = sealed_limits.get(name)
                if (
                    not isinstance(requested, int)
                    or isinstance(requested, bool)
                    or not isinstance(sealed, int)
                    or isinstance(sealed, bool)
                    or requested > sealed
                ):
                    raise ToolError(
                        "OutputWatchSeal change export may preserve or narrow, but not widen, its baseline limits"
                    )
            self._assert_file_copy_source_custody(launch_id, "output-watch")
            self._launch_output_root(launch_id)
        except Exception:
            self._clear_output_watch_lease_record(lease)
            raise
        return lease

    def _output_watch_changed_paths(
        self,
        baseline: dict[str, Any],
        current: dict[str, Any],
    ) -> dict[str, Any]:
        if (
            baseline.get("root_principal") != current.get("root_principal")
            or baseline.get("root_mount") != current.get("root_mount")
        ):
            raise ToolError("OutputWatchSeal launch-output root identity changed")
        before = self._output_watch_manifest_groups(baseline)
        after = self._output_watch_manifest_groups(current)
        deleted = sorted(set(before) - set(after), key=os.fsencode)
        changed = [
            name
            for name in sorted(after, key=os.fsencode)
            if before.get(name) != after[name]
        ]
        if not changed:
            if deleted:
                raise ToolError(
                    "OutputWatchSeal observed only deletions; no post-baseline artifact remains to export"
                )
            raise ToolError("OutputWatchSeal observed no post-baseline output change")
        file_paths: list[tuple[str, ...]] = []
        directory_paths: list[tuple[str, ...]] = []
        for name in changed:
            roots = [record for record in after[name] if len(record[1]) == 1]
            if len(roots) != 1:
                raise ToolError("OutputWatchSeal top-level manifest is inconsistent")
            if roots[0][0] == "file":
                file_paths.append((name,))
            elif roots[0][0] == "directory":
                directory_paths.append((name,))
            else:
                raise ToolError("OutputWatchSeal top-level output type is invalid")
        if directory_paths:
            if file_paths or len(directory_paths) != 1:
                raise ToolError(
                    "OutputWatchSeal changed set must be at most eight files or exactly one directory"
                )
            copy_kind = "directory"
            paths = tuple(directory_paths)
        else:
            if len(file_paths) > MAX_FILE_COPY_FILES:
                raise ToolError(
                    "OutputWatchSeal discovered more than eight changed top-level files"
                )
            copy_kind = "files"
            paths = tuple(file_paths)
        return {
            "copy_kind": copy_kind,
            "paths": paths,
            "changed_top_level_count": len(changed),
            "deleted_top_level_count": len(deleted),
        }

    def _remove_file_copy_tree(self, exports_fd: int, name: str) -> None:
        """Remove one controller-created transaction without following aliases.

        DirectoryCopySeal deliberately publishes mode-0500 directory trees.
        ``shutil.rmtree`` cannot remove those as an ordinary owner without
        first restoring directory write permission, and weakening the tree on
        a pathname basis would reopen symlink races.  Cleanup therefore walks
        retained directory descriptors, opens every directory with
        ``O_NOFOLLOW``, rejects mount crossings, widens only the retained
        controller-created directory to 0700, and unlinks children relative to
        that descriptor before removing the exact birth-pinned transaction.
        """
        if re.fullmatch(r"(?:\.copy-[0-9a-f]{32}\.pending|copy-[0-9a-f]{32})", name) is None:
            raise RuntimeError("FileCopySeal transaction identity is invalid")
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise RuntimeError("FileCopySeal cleanup has no descriptor no-follow boundary")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        try:
            info = os.stat(name, dir_fd=exports_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        parent_info = os.fstat(exports_fd)
        try:
            parent_mount = self._descriptor_mount_id(
                exports_fd, "FileCopySeal cleanup parent"
            )
        except ToolError as error:
            raise RuntimeError("FileCopySeal cleanup parent mount is untrusted") from error
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o700
            or info.st_dev != parent_info.st_dev
        ):
            raise RuntimeError("FileCopySeal transaction cleanup target is unsafe")

        root_fd: int | None = None
        seen: set[tuple[int, int]] = set()
        removed_entries = 0

        def remove_contents(descriptor: int) -> None:
            nonlocal removed_entries
            metadata = os.fstat(descriptor)
            identity = (metadata.st_dev, metadata.st_ino)
            if identity in seen:
                raise RuntimeError("FileCopySeal cleanup encountered a repeated directory inode")
            seen.add(identity)
            if metadata.st_uid != os.geteuid() or metadata.st_dev != parent_info.st_dev:
                raise RuntimeError("FileCopySeal cleanup directory escaped its owner or device")
            try:
                mount_id = self._descriptor_mount_id(
                    descriptor, "FileCopySeal cleanup directory"
                )
            except ToolError as error:
                raise RuntimeError("FileCopySeal cleanup directory mount is untrusted") from error
            if mount_id != parent_mount:
                raise RuntimeError("FileCopySeal cleanup directory crossed a mount boundary")
            try:
                os.fchmod(descriptor, 0o700)
            except OSError as error:
                raise RuntimeError("FileCopySeal cleanup directory could not be made removable") from error
            names: list[str] = []
            try:
                with os.scandir(descriptor) as iterator:
                    for entry in iterator:
                        names.append(entry.name)
                        if len(names) + removed_entries > MAX_FILE_COPY_CLEANUP_ENTRIES:
                            raise RuntimeError("FileCopySeal cleanup tree exceeds its hard ceiling")
            except RuntimeError:
                raise
            except OSError as error:
                raise RuntimeError("FileCopySeal cleanup directory could not be enumerated") from error
            names.sort(key=os.fsencode)
            for child_name in names:
                removed_entries += 1
                if removed_entries > MAX_FILE_COPY_CLEANUP_ENTRIES:
                    raise RuntimeError("FileCopySeal cleanup tree exceeds its hard ceiling")
                try:
                    child = os.stat(
                        child_name, dir_fd=descriptor, follow_symlinks=False
                    )
                except OSError as error:
                    raise RuntimeError("FileCopySeal cleanup child identity is unavailable") from error
                if stat.S_ISDIR(child.st_mode):
                    child_fd: int | None = None
                    try:
                        child_fd = os.open(child_name, directory_flags, dir_fd=descriptor)
                        opened = os.fstat(child_fd)
                        if (
                            opened.st_dev != child.st_dev
                            or opened.st_ino != child.st_ino
                            or opened.st_uid != child.st_uid
                            or opened.st_mode != child.st_mode
                        ):
                            raise RuntimeError(
                                "FileCopySeal cleanup directory changed before traversal"
                            )
                        remove_contents(child_fd)
                    except RuntimeError:
                        raise
                    except OSError as error:
                        raise RuntimeError(
                            "FileCopySeal cleanup directory could not be opened safely"
                        ) from error
                    finally:
                        if child_fd is not None:
                            with contextlib.suppress(OSError):
                                os.close(child_fd)
                    try:
                        os.rmdir(child_name, dir_fd=descriptor)
                    except OSError as error:
                        raise RuntimeError(
                            "FileCopySeal cleanup directory could not be removed"
                        ) from error
                else:
                    # unlinkat does not follow symbolic links.  Removing any
                    # non-directory inode is therefore confined to this exact
                    # retained transaction directory even after tampering.
                    try:
                        os.unlink(child_name, dir_fd=descriptor)
                    except OSError as error:
                        raise RuntimeError(
                            "FileCopySeal cleanup non-directory could not be removed"
                        ) from error
            try:
                os.fsync(descriptor)
            except OSError as error:
                raise RuntimeError(
                    "FileCopySeal cleanup directory could not be synchronized"
                ) from error

        try:
            root_fd = os.open(name, directory_flags, dir_fd=exports_fd)
            opened_root = os.fstat(root_fd)
            if (
                opened_root.st_dev != info.st_dev
                or opened_root.st_ino != info.st_ino
                or opened_root.st_uid != info.st_uid
                or opened_root.st_mode != info.st_mode
            ):
                raise RuntimeError("FileCopySeal cleanup target changed before traversal")
            remove_contents(root_fd)
            verified_fd = os.open(name, directory_flags, dir_fd=exports_fd)
            try:
                verified = os.fstat(verified_fd)
                if verified.st_dev != opened_root.st_dev or verified.st_ino != opened_root.st_ino:
                    raise RuntimeError("FileCopySeal cleanup target changed before removal")
            finally:
                os.close(verified_fd)
            os.rmdir(name, dir_fd=exports_fd)
        except FileNotFoundError as error:
            raise RuntimeError(
                "FileCopySeal transaction cleanup target disappeared during traversal"
            ) from error
        except RuntimeError:
            raise
        except OSError as error:
            raise RuntimeError("FileCopySeal transaction cleanup failed") from error
        finally:
            if root_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(root_fd)
        try:
            os.fsync(exports_fd)
        except OSError as error:
            raise RuntimeError(
                "FileCopySeal transaction cleanup directory could not be synchronized"
            ) from error
        try:
            os.stat(name, dir_fd=exports_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise RuntimeError("FileCopySeal transaction cleanup was not proved")

    @staticmethod
    def _fsync_file_copy_descriptor(descriptor: int, label: str) -> None:
        """Synchronize one FileCopySeal file or directory without weakening errors."""
        try:
            os.fsync(descriptor)
        except OSError as error:
            raise ToolError(
                f"{label} could not be synchronized (errno="
                f"{error.errno if error.errno is not None else 'unknown'})"
            ) from error

    @staticmethod
    def _rename_file_copy_noreplace(
        source_fd: int,
        source: str,
        destination_fd: int,
        destination: str,
    ) -> None:
        """Atomically publish one transaction without replacing any path.

        ``os.rename`` may replace an existing directory.  Safe launches expose
        the complete desktop artifact root read-only to the coding agent, but the
        controller's own publication view remains writable and bare-metal
        posture is intentionally unconfined.  FileCopySeal therefore still
        uses Linux ``renameat2(RENAME_NOREPLACE)`` and fails closed when that
        primitive is unavailable instead of trusting a pathname pre-check.
        """
        if (
            re.fullmatch(r"\.copy-[0-9a-f]{32}\.pending", source) is None
            or re.fullmatch(r"copy-[0-9a-f]{32}", destination) is None
        ):
            raise ToolError("FileCopySeal publication identity is invalid")
        libc = ctypes.CDLL(None, use_errno=True)
        source_bytes = os.fsencode(source)
        destination_bytes = os.fsencode(destination)
        renameat2 = getattr(libc, "renameat2", None)
        if renameat2 is not None:
            renameat2.argtypes = [
                ctypes.c_int,
                ctypes.c_char_p,
                ctypes.c_int,
                ctypes.c_char_p,
                ctypes.c_uint,
            ]
            renameat2.restype = ctypes.c_int
            result = renameat2(
                source_fd,
                source_bytes,
                destination_fd,
                destination_bytes,
                1,  # RENAME_NOREPLACE
            )
        else:
            syscall_number = {
                "x86_64": 316,
                "aarch64": 276,
            }.get(os.uname().machine)
            if syscall_number is None:
                raise ToolError("FileCopySeal has no renameat2 syscall policy for this architecture")
            syscall = libc.syscall
            syscall.restype = ctypes.c_long
            result = syscall(
                ctypes.c_long(syscall_number),
                ctypes.c_int(source_fd),
                ctypes.c_char_p(source_bytes),
                ctypes.c_int(destination_fd),
                ctypes.c_char_p(destination_bytes),
                ctypes.c_uint(1),
            )
        if result != 0:
            error_number = ctypes.get_errno()
            if error_number in {errno.EEXIST, errno.ENOTEMPTY}:
                raise ToolError("FileCopySeal publication destination already exists")
            if error_number in {errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP}:
                raise ToolError("FileCopySeal requires Linux renameat2 no-replace publication")
            raise ToolError(
                f"FileCopySeal atomic publication failed: {os.strerror(error_number)}"
            )

    @staticmethod
    def _directory_copy_identity(info: os.stat_result) -> tuple[int, ...]:
        """Return fields that an unprivileged source cannot restore after mutation."""
        return (
            info.st_dev,
            info.st_ino,
            info.st_uid,
            info.st_gid,
            info.st_mode,
            info.st_nlink,
            info.st_size,
            info.st_mtime_ns,
            info.st_ctime_ns,
        )

    @staticmethod
    def _directory_copy_name(value: Any, label: str) -> str:
        """Admit one portable, JSON-safe Linux directory-entry name."""
        if not isinstance(value, str):
            raise ToolError(f"{label} is not a text filename")
        encoded = os.fsencode(value)
        try:
            decoded = encoded.decode("utf-8", "strict")
        except UnicodeDecodeError as error:
            raise ToolError(f"{label} is not strict UTF-8") from error
        if (
            decoded != value
            or decoded in {"", ".", ".."}
            or len(encoded) > MAX_DIRECTORY_COPY_NAME_BYTES
            or "/" in decoded
            or "\\" in decoded
            or "\x00" in decoded
            or any(ord(character) < 32 or ord(character) == 127 for character in decoded)
            or not all(character.isprintable() for character in decoded)
            or unicodedata.normalize("NFC", decoded) != decoded
            or any(unicodedata.category(character).startswith("C") for character in decoded)
        ):
            raise ToolError(f"{label} is outside the bounded directory-name profile")
        return decoded

    def _directory_copy_names(
        self,
        descriptor: int,
        *,
        maximum: int,
        label: str,
    ) -> list[str]:
        """Read at most ``maximum`` names from one retained directory FD."""
        names: list[str] = []
        try:
            with os.scandir(descriptor) as iterator:
                for entry in iterator:
                    names.append(
                        self._directory_copy_name(
                            entry.name,
                            f"{label} entry {len(names) + 1}",
                        )
                    )
                    if len(names) > maximum:
                        raise ToolError(f"{label} exceeds its bounded entry ceiling")
        except ToolError:
            raise
        except OSError as error:
            raise ToolError(f"{label} could not be enumerated safely") from error
        names.sort(key=os.fsencode)
        return names

    def _copy_directory_tree(
        self,
        *,
        launch_id: str,
        source_mode: str,
        source_fd: int,
        destination_fd: int,
        source_root_info: os.stat_result,
        source_mount: int,
        output_info: os.stat_result,
        output_mount: int,
        directory_flags: int,
        file_flags: int,
        nofollow: int,
        depth: int,
        relative_parts: tuple[str, ...],
        state: dict[str, Any],
    ) -> None:
        """Snapshot one retained source directory into one private destination.

        Names come only from ``scandir(fd)``. Every child is then opened with
        ``O_NOFOLLOW`` relative to that same retained descriptor, checked for
        owner/device/mount/type/link identity, copied, and re-opened before the
        directory membership and timestamps are checked again. The destination
        is controller-private while writable and becomes mode 0500 only after
        all children and its directory entry have been synchronized.
        """

        def check_budget() -> None:
            if time.monotonic() > state["deadline"]:
                raise ToolError("DirectoryCopySeal exceeded its bounded snapshot time")
            self._assert_file_copy_source_custody(launch_id, source_mode)

        def validate_source(info: os.stat_result, descriptor: int, label: str) -> None:
            if (
                info.st_dev != source_root_info.st_dev
                or info.st_uid != os.geteuid()
                or self._descriptor_mount_id(descriptor, label) != source_mount
            ):
                raise ToolError(
                    "DirectoryCopySeal source crosses its launch-output owner, device, or mount boundary"
                )

        check_budget()
        before = os.fstat(source_fd)
        validate_source(before, source_fd, "DirectoryCopySeal retained directory")
        if not stat.S_ISDIR(before.st_mode):
            raise ToolError("DirectoryCopySeal retained source is not a directory")
        inode_key = (before.st_dev, before.st_ino)
        if inode_key in state["seen_inodes"]:
            raise ToolError("DirectoryCopySeal source tree contains a repeated inode")
        state["seen_inodes"].add(inode_key)
        state["directory_count"] += 1
        if state["directory_count"] > state["maximum_directories"]:
            raise ToolError("DirectoryCopySeal exceeds maximum_directories")
        state["manifest"].append(
            ("directory", relative_parts, self._directory_copy_identity(before))
        )

        remaining = state["maximum_entries"] - state["entry_count"]
        names = self._directory_copy_names(
            source_fd,
            maximum=max(0, remaining),
            label="DirectoryCopySeal source directory",
        )
        for entry_index, name in enumerate(names, start=1):
            check_budget()
            child_depth = depth + 1
            if child_depth > state["maximum_depth"]:
                raise ToolError("DirectoryCopySeal exceeds maximum_depth")
            child_parts = (*relative_parts, name)
            if len(b"/".join(os.fsencode(part) for part in child_parts)) > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES:
                raise ToolError("DirectoryCopySeal relative path exceeds its byte ceiling")
            state["entry_count"] += 1
            if state["entry_count"] > state["maximum_entries"]:
                raise ToolError("DirectoryCopySeal exceeds maximum_entries")

            source_child_fd: int | None = None
            destination_child_fd: int | None = None
            try:
                pre = os.stat(name, dir_fd=source_fd, follow_symlinks=False)
                if pre.st_dev != source_root_info.st_dev or pre.st_uid != os.geteuid():
                    raise ToolError(
                        "DirectoryCopySeal source crosses its launch-output owner or device boundary"
                    )
                if stat.S_ISLNK(pre.st_mode):
                    raise ToolError("DirectoryCopySeal rejects symbolic links")

                if stat.S_ISDIR(pre.st_mode):
                    source_child_fd = os.open(name, directory_flags, dir_fd=source_fd)
                    opened = os.fstat(source_child_fd)
                    validate_source(
                        opened,
                        source_child_fd,
                        f"DirectoryCopySeal directory entry {entry_index}",
                    )
                    if (
                        not stat.S_ISDIR(opened.st_mode)
                        or self._directory_copy_identity(opened)
                        != self._directory_copy_identity(pre)
                    ):
                        raise ToolError("DirectoryCopySeal directory identity changed before traversal")
                    os.mkdir(name, 0o700, dir_fd=destination_fd)
                    destination_child_fd = os.open(
                        name,
                        directory_flags,
                        dir_fd=destination_fd,
                    )
                    destination_before = os.fstat(destination_child_fd)
                    if (
                        not stat.S_ISDIR(destination_before.st_mode)
                        or destination_before.st_uid != os.geteuid()
                        or stat.S_IMODE(destination_before.st_mode) != 0o700
                        or destination_before.st_dev != output_info.st_dev
                        or self._descriptor_mount_id(
                            destination_child_fd,
                            f"DirectoryCopySeal destination directory {entry_index}",
                        ) != output_mount
                    ):
                        raise ToolError("DirectoryCopySeal destination directory is unsafe")
                    self._copy_directory_tree(
                        launch_id=launch_id,
                        source_mode=source_mode,
                        source_fd=source_child_fd,
                        destination_fd=destination_child_fd,
                        source_root_info=source_root_info,
                        source_mount=source_mount,
                        output_info=output_info,
                        output_mount=output_mount,
                        directory_flags=directory_flags,
                        file_flags=file_flags,
                        nofollow=nofollow,
                        depth=child_depth,
                        relative_parts=child_parts,
                        state=state,
                    )
                elif stat.S_ISREG(pre.st_mode):
                    if pre.st_nlink != 1:
                        raise ToolError(
                            "DirectoryCopySeal accepts only regular single-link files"
                        )
                    source_child_fd = os.open(name, file_flags, dir_fd=source_fd)
                    opened = os.fstat(source_child_fd)
                    validate_source(
                        opened,
                        source_child_fd,
                        f"DirectoryCopySeal file entry {entry_index}",
                    )
                    if (
                        not stat.S_ISREG(opened.st_mode)
                        or opened.st_nlink != 1
                        or self._directory_copy_identity(opened)
                        != self._directory_copy_identity(pre)
                    ):
                        raise ToolError("DirectoryCopySeal file identity changed before snapshot")
                    if opened.st_size < 0 or opened.st_size > state["maximum_file_bytes"]:
                        raise ToolError("DirectoryCopySeal file exceeds maximum_file_bytes")
                    if state["total_bytes"] + opened.st_size > state["maximum_total_bytes"]:
                        raise ToolError("DirectoryCopySeal tree exceeds maximum_total_bytes")
                    file_inode = (opened.st_dev, opened.st_ino)
                    if file_inode in state["seen_inodes"]:
                        raise ToolError("DirectoryCopySeal source tree contains a repeated inode")
                    state["seen_inodes"].add(file_inode)
                    destination_child_fd = os.open(
                        name,
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | nofollow,
                        0o400,
                        dir_fd=destination_fd,
                    )
                    copied = 0
                    while copied < opened.st_size:
                        check_budget()
                        chunk = os.read(
                            source_child_fd,
                            min(1024 * 1024, opened.st_size - copied),
                        )
                        if not chunk:
                            raise ToolError(
                                "DirectoryCopySeal file was truncated while being snapshotted"
                            )
                        self._write_all_descriptor(destination_child_fd, chunk)
                        copied += len(chunk)
                    if os.read(source_child_fd, 1):
                        raise ToolError("DirectoryCopySeal file grew while being snapshotted")
                    os.fchmod(destination_child_fd, 0o400)
                    self._fsync_file_copy_descriptor(
                        destination_child_fd,
                        "DirectoryCopySeal artifact file",
                    )
                    after = os.fstat(source_child_fd)
                    if (
                        self._directory_copy_identity(after)
                        != self._directory_copy_identity(opened)
                        or self._descriptor_mount_id(
                            source_child_fd,
                            f"DirectoryCopySeal file entry {entry_index} completion",
                        ) != source_mount
                    ):
                        raise ToolError("DirectoryCopySeal file changed while being snapshotted")
                    destination_info = os.fstat(destination_child_fd)
                    if (
                        not stat.S_ISREG(destination_info.st_mode)
                        or destination_info.st_uid != os.geteuid()
                        or destination_info.st_nlink != 1
                        or stat.S_IMODE(destination_info.st_mode) != 0o400
                        or destination_info.st_size != copied
                        or destination_info.st_dev != output_info.st_dev
                        or self._descriptor_mount_id(
                            destination_child_fd,
                            f"DirectoryCopySeal artifact file {entry_index}",
                        ) != output_mount
                    ):
                        raise ToolError("DirectoryCopySeal artifact file is inconsistent")
                    state["file_count"] += 1
                    state["total_bytes"] += copied
                    state["manifest"].append(
                        ("file", child_parts, self._directory_copy_identity(after))
                    )
                else:
                    raise ToolError(
                        "DirectoryCopySeal rejects non-regular, non-directory source entries"
                    )

                # The retained descriptor proves safe content. Re-opening the
                # parent-relative name proves the application did not unlink or
                # replace that name before the directory checkpoint.
                verify_flags = directory_flags if stat.S_ISDIR(pre.st_mode) else file_flags
                verified_fd = os.open(name, verify_flags, dir_fd=source_fd)
                try:
                    verified = os.fstat(verified_fd)
                    final_identity = (
                        os.fstat(source_child_fd)
                        if source_child_fd is not None
                        else pre
                    )
                    if (
                        self._directory_copy_identity(verified)
                        != self._directory_copy_identity(final_identity)
                        or self._descriptor_mount_id(
                            verified_fd,
                            f"DirectoryCopySeal entry {entry_index} revalidation",
                        ) != source_mount
                    ):
                        raise ToolError("DirectoryCopySeal source entry changed before publication")
                finally:
                    os.close(verified_fd)
            except ToolError:
                raise
            except OSError as error:
                raise ToolError(
                    "DirectoryCopySeal source entry could not be opened or snapshotted safely "
                    f"(errno={error.errno if error.errno is not None else 'unknown'})"
                ) from error
            finally:
                if destination_child_fd is not None:
                    with contextlib.suppress(OSError):
                        os.close(destination_child_fd)
                if source_child_fd is not None:
                    with contextlib.suppress(OSError):
                        os.close(source_child_fd)

        check_budget()
        names_after = self._directory_copy_names(
            source_fd,
            maximum=len(names),
            label="DirectoryCopySeal source directory revalidation",
        )
        after = os.fstat(source_fd)
        if (
            names_after != names
            or self._directory_copy_identity(after) != self._directory_copy_identity(before)
            or self._descriptor_mount_id(
                source_fd,
                "DirectoryCopySeal retained directory completion",
            ) != source_mount
        ):
            raise ToolError("DirectoryCopySeal directory changed while being snapshotted")
        os.fchmod(destination_fd, 0o500)
        self._fsync_file_copy_descriptor(
            destination_fd,
            "DirectoryCopySeal artifact directory",
        )
        destination_after = os.fstat(destination_fd)
        if (
            not stat.S_ISDIR(destination_after.st_mode)
            or destination_after.st_uid != os.geteuid()
            or stat.S_IMODE(destination_after.st_mode) != 0o500
            or destination_after.st_dev != output_info.st_dev
            or self._descriptor_mount_id(
                destination_fd,
                "DirectoryCopySeal artifact directory completion",
            ) != output_mount
        ):
            raise ToolError("DirectoryCopySeal artifact directory is inconsistent")

    def _verify_directory_copy_manifest(
        self,
        *,
        launch_id: str,
        source_mode: str,
        source_fd: int,
        source_root_info: os.stat_result,
        source_mount: int,
        directory_flags: int,
        file_flags: int,
        depth: int,
        relative_parts: tuple[str, ...],
        state: dict[str, Any],
    ) -> None:
        """Rebuild one bounded source-tree manifest immediately before publish.

        The first pass copies bytes and records unforgeable metadata identities.
        This second descriptor-relative pass performs no writes and compares the
        complete ordered tree—names, types, inode identities, sizes, links,
        timestamps, owner/device/mount custody, and aggregate accounting.  It is
        deliberately placed after destination fsync and immediately before the
        no-replace rename so a mutation in an already-copied nested branch cannot
        hide behind an unchanged selected-root directory timestamp.
        """

        def check_budget() -> None:
            if time.monotonic() > state["deadline"]:
                raise ToolError("DirectoryCopySeal exceeded its bounded snapshot time")
            self._assert_file_copy_source_custody(launch_id, source_mode)

        def validate_source(info: os.stat_result, descriptor: int, label: str) -> None:
            if (
                info.st_dev != source_root_info.st_dev
                or info.st_uid != os.geteuid()
                or self._descriptor_mount_id(descriptor, label) != source_mount
            ):
                raise ToolError(
                    "DirectoryCopySeal source crosses its launch-output owner, device, or mount boundary"
                )

        check_budget()
        before = os.fstat(source_fd)
        validate_source(before, source_fd, "DirectoryCopySeal manifest directory")
        if not stat.S_ISDIR(before.st_mode):
            raise ToolError("DirectoryCopySeal manifest source is not a directory")
        inode_key = (before.st_dev, before.st_ino)
        if inode_key in state["seen_inodes"]:
            raise ToolError("DirectoryCopySeal manifest contains a repeated inode")
        state["seen_inodes"].add(inode_key)
        state["directory_count"] += 1
        if state["directory_count"] > state["maximum_directories"]:
            raise ToolError("DirectoryCopySeal exceeds maximum_directories during revalidation")
        state["manifest"].append(
            ("directory", relative_parts, self._directory_copy_identity(before))
        )

        remaining = state["maximum_entries"] - state["entry_count"]
        names = self._directory_copy_names(
            source_fd,
            maximum=max(0, remaining),
            label="DirectoryCopySeal manifest directory",
        )
        for entry_index, name in enumerate(names, start=1):
            check_budget()
            child_depth = depth + 1
            if child_depth > state["maximum_depth"]:
                raise ToolError("DirectoryCopySeal exceeds maximum_depth during revalidation")
            child_parts = (*relative_parts, name)
            if (
                len(b"/".join(os.fsencode(part) for part in child_parts))
                > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES
            ):
                raise ToolError("DirectoryCopySeal relative path exceeds its byte ceiling")
            state["entry_count"] += 1
            if state["entry_count"] > state["maximum_entries"]:
                raise ToolError("DirectoryCopySeal exceeds maximum_entries during revalidation")

            child_fd: int | None = None
            try:
                pre = os.stat(name, dir_fd=source_fd, follow_symlinks=False)
                if pre.st_dev != source_root_info.st_dev or pre.st_uid != os.geteuid():
                    raise ToolError(
                        "DirectoryCopySeal manifest crosses its launch-output owner or device boundary"
                    )
                if stat.S_ISLNK(pre.st_mode):
                    raise ToolError("DirectoryCopySeal rejects symbolic links during revalidation")
                flags = directory_flags if stat.S_ISDIR(pre.st_mode) else file_flags
                child_fd = os.open(name, flags, dir_fd=source_fd)
                opened = os.fstat(child_fd)
                validate_source(
                    opened,
                    child_fd,
                    f"DirectoryCopySeal manifest entry {entry_index}",
                )
                if self._directory_copy_identity(opened) != self._directory_copy_identity(pre):
                    raise ToolError("DirectoryCopySeal source entry changed before manifest verification")

                if stat.S_ISDIR(opened.st_mode):
                    self._verify_directory_copy_manifest(
                        launch_id=launch_id,
                        source_mode=source_mode,
                        source_fd=child_fd,
                        source_root_info=source_root_info,
                        source_mount=source_mount,
                        directory_flags=directory_flags,
                        file_flags=file_flags,
                        depth=child_depth,
                        relative_parts=child_parts,
                        state=state,
                    )
                elif stat.S_ISREG(opened.st_mode):
                    if opened.st_nlink != 1:
                        raise ToolError(
                            "DirectoryCopySeal accepts only regular single-link files"
                        )
                    if opened.st_size < 0 or opened.st_size > state["maximum_file_bytes"]:
                        raise ToolError("DirectoryCopySeal file exceeds maximum_file_bytes")
                    if state["total_bytes"] + opened.st_size > state["maximum_total_bytes"]:
                        raise ToolError("DirectoryCopySeal tree exceeds maximum_total_bytes")
                    file_inode = (opened.st_dev, opened.st_ino)
                    if file_inode in state["seen_inodes"]:
                        raise ToolError("DirectoryCopySeal manifest contains a repeated inode")
                    state["seen_inodes"].add(file_inode)
                    after = os.fstat(child_fd)
                    if self._directory_copy_identity(after) != self._directory_copy_identity(opened):
                        raise ToolError("DirectoryCopySeal file changed during manifest verification")
                    state["file_count"] += 1
                    state["total_bytes"] += opened.st_size
                    state["manifest"].append(
                        ("file", child_parts, self._directory_copy_identity(after))
                    )
                else:
                    raise ToolError(
                        "DirectoryCopySeal rejects non-regular, non-directory source entries"
                    )

                verified_fd = os.open(name, flags, dir_fd=source_fd)
                try:
                    verified = os.fstat(verified_fd)
                    if (
                        self._directory_copy_identity(verified)
                        != self._directory_copy_identity(os.fstat(child_fd))
                        or self._descriptor_mount_id(
                            verified_fd,
                            f"DirectoryCopySeal manifest entry {entry_index} revalidation",
                        ) != source_mount
                    ):
                        raise ToolError(
                            "DirectoryCopySeal source entry changed during manifest verification"
                        )
                finally:
                    os.close(verified_fd)
            except ToolError:
                raise
            except OSError as error:
                raise ToolError(
                    "DirectoryCopySeal source entry could not be revalidated safely "
                    f"(errno={error.errno if error.errno is not None else 'unknown'})"
                ) from error
            finally:
                if child_fd is not None:
                    with contextlib.suppress(OSError):
                        os.close(child_fd)

        check_budget()
        names_after = self._directory_copy_names(
            source_fd,
            maximum=len(names),
            label="DirectoryCopySeal manifest directory completion",
        )
        after = os.fstat(source_fd)
        if (
            names_after != names
            or self._directory_copy_identity(after) != self._directory_copy_identity(before)
            or self._descriptor_mount_id(
                source_fd,
                "DirectoryCopySeal manifest directory completion",
            ) != source_mount
        ):
            raise ToolError("DirectoryCopySeal directory changed during manifest verification")

    def _snapshot_copied_directory(
        self,
        launch_id: str,
        uri_payload: bytes | bytearray,
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        maximum_entries: int,
        maximum_directories: int,
        maximum_depth: int,
        source_mode: str = "selection",
    ) -> dict[str, Any]:
        """Snapshot exactly one copied launch-output directory tree."""
        maximum_file_bytes = as_int(
            maximum_file_bytes,
            0,
            MAX_FILE_COPY_FILE_BYTES,
            "maximum_file_bytes",
        )
        maximum_total_bytes = as_int(
            maximum_total_bytes,
            0,
            min(MAX_FILE_COPY_TOTAL_BYTES, self.max_output_bytes),
            "maximum_total_bytes",
        )
        maximum_entries = as_int(
            maximum_entries,
            0,
            MAX_DIRECTORY_COPY_ENTRIES,
            "maximum_entries",
        )
        maximum_directories = as_int(
            maximum_directories,
            1,
            MAX_DIRECTORY_COPY_DIRECTORIES,
            "maximum_directories",
        )
        maximum_depth = as_int(
            maximum_depth,
            0,
            MAX_DIRECTORY_COPY_DEPTH,
            "maximum_depth",
        )
        if maximum_file_bytes > maximum_total_bytes:
            raise ToolError("maximum_file_bytes cannot exceed maximum_total_bytes")
        if source_mode not in {"selection", "launch-output", "output-watch"}:
            raise ToolError("DirectoryCopySeal source mode is invalid")
        paths = self._parse_file_copy_uri_list(uri_payload)
        if len(paths) != 1:
            raise ToolError("DirectoryCopySeal requires exactly one selected directory URI")
        selected_parts = tuple(
            self._directory_copy_name(
                part, f"DirectoryCopySeal selected path component {index}"
            )
            for index, part in enumerate(paths[0], start=1)
        )
        if len(b"/".join(os.fsencode(part) for part in selected_parts)) > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES:
            raise ToolError("DirectoryCopySeal selected path exceeds its byte ceiling")

        managed, source_root, source_path_identity = self._launch_output_root(launch_id)
        self._assert_file_copy_source_custody(managed.launch_id, source_mode)
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY") or os.scandir not in os.supports_fd:
            raise ToolError("descriptor-relative directory FileCopySeal is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow

        root_fd: int | None = None
        selected_fd: int | None = None
        output_fd: int | None = None
        exports_fd: int | None = None
        staging_fd: int | None = None
        pending_fd: int | None = None
        directories_fd: int | None = None
        slot_fd: int | None = None
        destination_root_fd: int | None = None
        opened: list[int] = []
        pending_name = ""
        final_name = ""
        published = False
        renamed = False
        try:
            root_fd = os.open(source_root, directory_flags)
            root_info = os.fstat(root_fd)
            root_mount = self._descriptor_mount_id(
                root_fd,
                "DirectoryCopySeal launch output root",
            )
            if (
                not stat.S_ISDIR(root_info.st_mode)
                or root_info.st_uid != os.geteuid()
                or stat.S_IMODE(root_info.st_mode) != 0o700
                or root_info.st_dev != source_path_identity.st_dev
                or root_info.st_ino != source_path_identity.st_ino
            ):
                raise ToolError("DirectoryCopySeal launch output root lost its trusted identity")

            parent_fd = root_fd
            for component_index, component in enumerate(selected_parts, start=1):
                descriptor = os.open(component, directory_flags, dir_fd=parent_fd)
                opened.append(descriptor)
                info = os.fstat(descriptor)
                if (
                    not stat.S_ISDIR(info.st_mode)
                    or info.st_dev != root_info.st_dev
                    or info.st_uid != os.geteuid()
                    or self._descriptor_mount_id(
                        descriptor,
                        f"DirectoryCopySeal selected path component {component_index}",
                    ) != root_mount
                ):
                    raise ToolError(
                        "DirectoryCopySeal selected path crosses its launch-output boundary"
                    )
                parent_fd = descriptor
            selected_fd = opened[-1]
            selected_before = os.fstat(selected_fd)

            output_path_identity = self.output.lstat()
            output_fd = os.open(self.output, directory_flags)
            output_info = os.fstat(output_fd)
            output_mount = self._descriptor_mount_id(output_fd, "desktop output root")
            if (
                not stat.S_ISDIR(output_info.st_mode)
                or output_info.st_uid != os.geteuid()
                or stat.S_IMODE(output_info.st_mode) != 0o700
                or output_info.st_dev != output_path_identity.st_dev
                or output_info.st_ino != output_path_identity.st_ino
                or root_info.st_dev != output_info.st_dev
                or root_mount != output_mount
            ):
                raise ToolError("desktop output root lost its trusted identity")
            for directory_name in (
                FILE_COPY_STAGING_DIRECTORY,
                FILE_COPY_EXPORT_DIRECTORY,
            ):
                try:
                    os.mkdir(directory_name, 0o700, dir_fd=output_fd)
                except FileExistsError:
                    pass
            staging_fd = os.open(FILE_COPY_STAGING_DIRECTORY, directory_flags, dir_fd=output_fd)
            staging_info = os.fstat(staging_fd)
            if (
                not stat.S_ISDIR(staging_info.st_mode)
                or staging_info.st_uid != os.geteuid()
                or stat.S_IMODE(staging_info.st_mode) != 0o700
                or staging_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(
                    staging_fd,
                    "DirectoryCopySeal controller staging root",
                ) != output_mount
            ):
                raise ToolError("DirectoryCopySeal controller staging root is unsafe")
            exports_fd = os.open(FILE_COPY_EXPORT_DIRECTORY, directory_flags, dir_fd=output_fd)
            exports_info = os.fstat(exports_fd)
            if (
                not stat.S_ISDIR(exports_info.st_mode)
                or exports_info.st_uid != os.geteuid()
                or stat.S_IMODE(exports_info.st_mode) != 0o700
                or exports_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(
                    exports_fd,
                    "DirectoryCopySeal export root",
                ) != output_mount
            ):
                raise ToolError("DirectoryCopySeal export root is unsafe")

            for _ in range(32):
                token = secrets.token_hex(16)
                candidate_pending = f".copy-{token}.pending"
                candidate_final = f"copy-{token}"
                try:
                    os.stat(candidate_final, dir_fd=exports_fd, follow_symlinks=False)
                except FileNotFoundError:
                    pass
                else:
                    continue
                try:
                    os.mkdir(candidate_pending, 0o700, dir_fd=staging_fd)
                except FileExistsError:
                    continue
                pending_name = candidate_pending
                final_name = candidate_final
                break
            if not pending_name or not final_name:
                raise ToolError("DirectoryCopySeal could not allocate a publication transaction")
            pending_fd = os.open(pending_name, directory_flags, dir_fd=staging_fd)
            pending_info = os.fstat(pending_fd)
            if (
                not stat.S_ISDIR(pending_info.st_mode)
                or pending_info.st_uid != os.geteuid()
                or stat.S_IMODE(pending_info.st_mode) != 0o700
                or pending_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(
                    pending_fd,
                    "DirectoryCopySeal pending transaction",
                ) != output_mount
            ):
                raise ToolError("DirectoryCopySeal pending transaction is unsafe")
            os.mkdir("directories", 0o700, dir_fd=pending_fd)
            directories_fd = os.open("directories", directory_flags, dir_fd=pending_fd)
            os.mkdir("item-01", 0o700, dir_fd=directories_fd)
            slot_fd = os.open("item-01", directory_flags, dir_fd=directories_fd)
            basename = selected_parts[-1]
            os.mkdir(basename, 0o700, dir_fd=slot_fd)
            destination_root_fd = os.open(basename, directory_flags, dir_fd=slot_fd)
            for descriptor, label in (
                (directories_fd, "DirectoryCopySeal directories transaction"),
                (slot_fd, "DirectoryCopySeal artifact slot"),
                (destination_root_fd, "DirectoryCopySeal artifact root"),
            ):
                info = os.fstat(descriptor)
                if (
                    not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != os.geteuid()
                    or stat.S_IMODE(info.st_mode) != 0o700
                    or info.st_dev != output_info.st_dev
                    or self._descriptor_mount_id(descriptor, label) != output_mount
                ):
                    raise ToolError(f"{label} is unsafe")

            state: dict[str, Any] = {
                "maximum_file_bytes": maximum_file_bytes,
                "maximum_total_bytes": maximum_total_bytes,
                "maximum_entries": maximum_entries,
                "maximum_directories": maximum_directories,
                "maximum_depth": maximum_depth,
                "entry_count": 0,
                "directory_count": 0,
                "file_count": 0,
                "total_bytes": 0,
                "seen_inodes": set(),
                "manifest": [],
                "deadline": time.monotonic() + MAX_DIRECTORY_COPY_SECONDS,
            }
            self._copy_directory_tree(
                launch_id=managed.launch_id,
                source_mode=source_mode,
                source_fd=selected_fd,
                destination_fd=destination_root_fd,
                source_root_info=root_info,
                source_mount=root_mount,
                output_info=output_info,
                output_mount=output_mount,
                directory_flags=directory_flags,
                file_flags=file_flags,
                nofollow=nofollow,
                depth=0,
                relative_parts=(basename,),
                state=state,
            )
            self._assert_file_copy_source_custody(managed.launch_id, source_mode)

            verify_parent = root_fd
            verify_descriptors: list[int] = []
            try:
                for component in selected_parts:
                    verified = os.open(component, directory_flags, dir_fd=verify_parent)
                    verify_descriptors.append(verified)
                    verify_parent = verified
                selected_after = os.fstat(verify_descriptors[-1])
                if (
                    self._directory_copy_identity(selected_after)
                    != self._directory_copy_identity(os.fstat(selected_fd))
                    or self._directory_copy_identity(selected_after)
                    != self._directory_copy_identity(selected_before)
                    or self._descriptor_mount_id(
                        verify_descriptors[-1],
                        "DirectoryCopySeal selected root revalidation",
                    ) != root_mount
                ):
                    raise ToolError("DirectoryCopySeal selected directory changed before publication")
            finally:
                for descriptor in reversed(verify_descriptors):
                    with contextlib.suppress(OSError):
                        os.close(descriptor)

            current_source_identity = source_root.lstat()
            if (
                current_source_identity.st_dev != root_info.st_dev
                or current_source_identity.st_ino != root_info.st_ino
                or current_source_identity.st_uid != root_info.st_uid
                or current_source_identity.st_mode != root_info.st_mode
            ):
                raise ToolError("DirectoryCopySeal launch output root changed before publication")
            for descriptor, label in (
                (destination_root_fd, "DirectoryCopySeal artifact root"),
                (slot_fd, "DirectoryCopySeal artifact slot"),
                (directories_fd, "DirectoryCopySeal directories transaction"),
                (pending_fd, "DirectoryCopySeal pending transaction"),
                (staging_fd, "DirectoryCopySeal controller staging root"),
                (exports_fd, "DirectoryCopySeal export root"),
                (output_fd, "desktop output root"),
            ):
                self._fsync_file_copy_descriptor(descriptor, label)

            verification_state: dict[str, Any] = {
                "maximum_file_bytes": maximum_file_bytes,
                "maximum_total_bytes": maximum_total_bytes,
                "maximum_entries": maximum_entries,
                "maximum_directories": maximum_directories,
                "maximum_depth": maximum_depth,
                "entry_count": 0,
                "directory_count": 0,
                "file_count": 0,
                "total_bytes": 0,
                "seen_inodes": set(),
                "manifest": [],
                "deadline": state["deadline"],
            }
            self._verify_directory_copy_manifest(
                launch_id=managed.launch_id,
                source_mode=source_mode,
                source_fd=selected_fd,
                source_root_info=root_info,
                source_mount=root_mount,
                directory_flags=directory_flags,
                file_flags=file_flags,
                depth=0,
                relative_parts=(basename,),
                state=verification_state,
            )
            if (
                verification_state["manifest"] != state["manifest"]
                or verification_state["entry_count"] != state["entry_count"]
                or verification_state["directory_count"] != state["directory_count"]
                or verification_state["file_count"] != state["file_count"]
                or verification_state["total_bytes"] != state["total_bytes"]
            ):
                raise ToolError(
                    "DirectoryCopySeal complete source-tree manifest changed before publication"
                )
            self._assert_file_copy_source_custody(managed.launch_id, source_mode)
            self._rename_file_copy_noreplace(
                staging_fd,
                pending_name,
                exports_fd,
                final_name,
            )
            renamed = True
            pending_name = ""
            final_info = os.stat(final_name, dir_fd=exports_fd, follow_symlinks=False)
            if (
                not stat.S_ISDIR(final_info.st_mode)
                or final_info.st_dev != pending_info.st_dev
                or final_info.st_ino != pending_info.st_ino
                or final_info.st_uid != os.geteuid()
                or stat.S_IMODE(final_info.st_mode) != 0o700
                or self._descriptor_mount_id(
                    pending_fd,
                    "DirectoryCopySeal published transaction",
                ) != output_mount
            ):
                raise ToolError("DirectoryCopySeal publication identity is inconsistent")
            self._fsync_file_copy_descriptor(
                staging_fd,
                "DirectoryCopySeal controller staging root",
            )
            self._fsync_file_copy_descriptor(exports_fd, "DirectoryCopySeal export root")
            self._fsync_file_copy_descriptor(output_fd, "desktop output root")
            published = True
            output_path = (
                f"{FILE_COPY_EXPORT_DIRECTORY}/{final_name}/directories/item-01/{basename}"
            )
            return {
                "copied": True,
                "kind": "directory",
                "mime": FILE_DROP_MIME,
                "file_count": state["file_count"],
                "directory_count": state["directory_count"],
                "entry_count": state["entry_count"],
                "source_bytes": state["total_bytes"],
                "bytes": state["total_bytes"],
                "uri_list_bytes": len(uri_payload),
                "directory": {
                    "output_path": output_path,
                    "basename": basename,
                    "bytes": state["total_bytes"],
                    "file_count": state["file_count"],
                    "directory_count": state["directory_count"],
                    "entry_count": state["entry_count"],
                    "mode": "0500",
                },
                "export_directory": f"{FILE_COPY_EXPORT_DIRECTORY}/{final_name}",
                "source_paths_retained": False,
                "source_basenames_exposed": True,
                "descendant_names_exposed": True,
                "canonicalized": True,
                "snapshot_mode": "0500-directories+0400-regular-single-link-files",
                "snapshot_layout": "opaque-indexed-directory+preserved-bounded-tree",
                "snapshot_retention": "persistent-controller-artifact-until-operator-removal",
                "source_namespace": "exact-launch-private-output-only",
                "selection_payload_retained": False,
                "stable_payload_fingerprint_retained": False,
                "complete_source_tree_revalidated_before_publication": True,
                "source_tree_manifest_retained": False,
                "tree_limits": {
                    "maximum_entries": maximum_entries,
                    "maximum_directories": maximum_directories,
                    "maximum_depth": maximum_depth,
                    "maximum_file_bytes": maximum_file_bytes,
                    "maximum_total_bytes": maximum_total_bytes,
                },
                "untrusted": True,
                "trust": "controlled-application-output-directory-tree",
            }
        except Exception as snapshot_error:
            public_error: Exception = snapshot_error
            if isinstance(snapshot_error, OSError):
                public_error = ToolError(
                    "DirectoryCopySeal transaction failed at a filesystem boundary "
                    f"(errno={snapshot_error.errno if snapshot_error.errno is not None else 'unknown'})"
                )
            cleanup_error: Exception | None = None
            cleanup_name = final_name if renamed else pending_name
            cleanup_parent_fd = exports_fd if renamed else staging_fd
            if cleanup_name and cleanup_parent_fd is not None and not published:
                try:
                    self._remove_file_copy_tree(cleanup_parent_fd, cleanup_name)
                except Exception as error:
                    cleanup_error = error
            if cleanup_error is not None:
                raise ToolError(
                    "DirectoryCopySeal failed and hidden partial cleanup could not be proved"
                ) from cleanup_error
            if public_error is snapshot_error:
                raise snapshot_error
            raise public_error from snapshot_error
        finally:
            for descriptor in (
                destination_root_fd,
                slot_fd,
                directories_fd,
                pending_fd,
                staging_fd,
                exports_fd,
                output_fd,
            ):
                if descriptor is not None:
                    with contextlib.suppress(OSError):
                        os.close(descriptor)
            for descriptor in reversed(opened):
                with contextlib.suppress(OSError):
                    os.close(descriptor)
            if root_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(root_fd)

    def _snapshot_copied_files(
        self,
        launch_id: str,
        uri_payload: bytes | bytearray,
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        copy_kind: str = "files",
        maximum_entries: int = MAX_DIRECTORY_COPY_ENTRIES,
        maximum_directories: int = MAX_DIRECTORY_COPY_DIRECTORIES,
        maximum_depth: int = MAX_DIRECTORY_COPY_DEPTH,
        source_mode: str = "selection",
    ) -> dict[str, Any]:
        """Snapshot copied app-output files into persistent controller artifacts.

        Source paths are interpreted only after the workstation selection was
        cleared. Every component is opened with O_NOFOLLOW under the exact
        launch-private output root; device, mount, owner, type, link count,
        size, timestamps, and a second path resolution are checked around a
        direct descriptor-to-descriptor copy. The app cannot see ``exports/``.
        A controller-only pending tree outside the agent-visible export root is
        atomically published only after all files and directories have been
        fsynced and revalidated.
        """
        if copy_kind not in {"files", "directory"}:
            raise ToolError("FileCopySeal copy kind is invalid")
        if source_mode not in {"selection", "launch-output", "output-watch"}:
            raise ToolError("FileCopySeal source mode is invalid")
        if copy_kind == "directory":
            return self._snapshot_copied_directory(
                launch_id,
                uri_payload,
                maximum_file_bytes=maximum_file_bytes,
                maximum_total_bytes=maximum_total_bytes,
                maximum_entries=maximum_entries,
                maximum_directories=maximum_directories,
                maximum_depth=maximum_depth,
                source_mode=source_mode,
            )
        maximum_file_bytes = as_int(
            maximum_file_bytes,
            0,
            MAX_FILE_COPY_FILE_BYTES,
            "maximum_file_bytes",
        )
        maximum_total_bytes = as_int(
            maximum_total_bytes,
            0,
            min(MAX_FILE_COPY_TOTAL_BYTES, self.max_output_bytes),
            "maximum_total_bytes",
        )
        if maximum_file_bytes > maximum_total_bytes:
            raise ToolError("maximum_file_bytes cannot exceed maximum_total_bytes")
        paths = self._parse_file_copy_uri_list(uri_payload)
        managed, source_root, source_path_identity = self._launch_output_root(launch_id)
        self._assert_file_copy_source_custody(managed.launch_id, source_mode)

        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise ToolError("descriptor-relative no-follow FileCopySeal is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow
        root_fd: int | None = None
        output_fd: int | None = None
        exports_fd: int | None = None
        staging_fd: int | None = None
        pending_fd: int | None = None
        files_fd: int | None = None
        pending_name = ""
        final_name = ""
        total_bytes = 0
        results: list[dict[str, Any]] = []
        published = False
        renamed = False
        try:
            root_fd = os.open(source_root, directory_flags)
            root_info = os.fstat(root_fd)
            root_mount = self._descriptor_mount_id(root_fd, "FileCopySeal launch output root")
            if (
                not stat.S_ISDIR(root_info.st_mode)
                or root_info.st_uid != os.geteuid()
                or stat.S_IMODE(root_info.st_mode) != 0o700
                or root_info.st_dev != source_path_identity.st_dev
                or root_info.st_ino != source_path_identity.st_ino
            ):
                raise ToolError("FileCopySeal launch output root lost its trusted identity")

            output_path_identity = self.output.lstat()
            output_fd = os.open(self.output, directory_flags)
            output_info = os.fstat(output_fd)
            output_mount = self._descriptor_mount_id(output_fd, "desktop output root")
            if (
                not stat.S_ISDIR(output_info.st_mode)
                or output_info.st_uid != os.geteuid()
                or stat.S_IMODE(output_info.st_mode) != 0o700
                or output_info.st_dev != output_path_identity.st_dev
                or output_info.st_ino != output_path_identity.st_ino
                or root_info.st_dev != output_info.st_dev
                or root_mount != output_mount
            ):
                raise ToolError("desktop output root lost its trusted identity")
            for directory_name in (
                FILE_COPY_STAGING_DIRECTORY,
                FILE_COPY_EXPORT_DIRECTORY,
            ):
                try:
                    os.mkdir(directory_name, 0o700, dir_fd=output_fd)
                except FileExistsError:
                    pass
            staging_fd = os.open(FILE_COPY_STAGING_DIRECTORY, directory_flags, dir_fd=output_fd)
            staging_info = os.fstat(staging_fd)
            if (
                not stat.S_ISDIR(staging_info.st_mode)
                or staging_info.st_uid != os.geteuid()
                or stat.S_IMODE(staging_info.st_mode) != 0o700
                or staging_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(
                    staging_fd, "FileCopySeal controller staging root"
                ) != output_mount
            ):
                raise ToolError("FileCopySeal controller staging root is unsafe")
            exports_fd = os.open(FILE_COPY_EXPORT_DIRECTORY, directory_flags, dir_fd=output_fd)
            exports_info = os.fstat(exports_fd)
            if (
                not stat.S_ISDIR(exports_info.st_mode)
                or exports_info.st_uid != os.geteuid()
                or stat.S_IMODE(exports_info.st_mode) != 0o700
                or exports_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(exports_fd, "FileCopySeal export root") != output_mount
            ):
                raise ToolError("FileCopySeal export root is unsafe")

            for _ in range(32):
                token = secrets.token_hex(16)
                candidate_pending = f".copy-{token}.pending"
                candidate_final = f"copy-{token}"
                try:
                    os.stat(candidate_final, dir_fd=exports_fd, follow_symlinks=False)
                except FileNotFoundError:
                    pass
                else:
                    continue
                try:
                    os.mkdir(candidate_pending, 0o700, dir_fd=staging_fd)
                except FileExistsError:
                    continue
                pending_name = candidate_pending
                final_name = candidate_final
                break
            if not pending_name or not final_name:
                raise ToolError("FileCopySeal could not allocate a unique publication transaction")
            pending_fd = os.open(pending_name, directory_flags, dir_fd=staging_fd)
            pending_info = os.fstat(pending_fd)
            if (
                not stat.S_ISDIR(pending_info.st_mode)
                or pending_info.st_uid != os.geteuid()
                or stat.S_IMODE(pending_info.st_mode) != 0o700
                or pending_info.st_dev != exports_info.st_dev
                or self._descriptor_mount_id(
                    pending_fd, "FileCopySeal pending transaction"
                ) != output_mount
            ):
                raise ToolError("FileCopySeal pending transaction is unsafe")
            os.mkdir("files", 0o700, dir_fd=pending_fd)
            files_fd = os.open("files", directory_flags, dir_fd=pending_fd)
            files_info = os.fstat(files_fd)
            if (
                not stat.S_ISDIR(files_info.st_mode)
                or files_info.st_uid != os.geteuid()
                or stat.S_IMODE(files_info.st_mode) != 0o700
                or files_info.st_dev != pending_info.st_dev
                or self._descriptor_mount_id(files_fd, "FileCopySeal files transaction")
                != output_mount
            ):
                raise ToolError("FileCopySeal files transaction is unsafe")

            for file_index, parts in enumerate(paths, start=1):
                self._assert_file_copy_source_custody(managed.launch_id, source_mode)
                opened: list[int] = []
                destination_parent: int | None = None
                destination_fd: int | None = None
                try:
                    parent_fd = root_fd
                    for component_index, component in enumerate(parts):
                        final = component_index == len(parts) - 1
                        descriptor = os.open(
                            component,
                            file_flags if final else directory_flags,
                            dir_fd=parent_fd,
                        )
                        opened.append(descriptor)
                        info = os.fstat(descriptor)
                        if (
                            info.st_dev != root_info.st_dev
                            or info.st_uid != os.geteuid()
                            or self._descriptor_mount_id(
                                descriptor, f"FileCopySeal source_paths[{file_index - 1}]"
                            ) != root_mount
                        ):
                            raise ToolError(
                                "FileCopySeal source crosses its launch-output owner, device, or mount boundary"
                            )
                        if final:
                            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
                                raise ToolError(
                                    "FileCopySeal source must be a regular single-link launch-output file"
                                )
                        elif not stat.S_ISDIR(info.st_mode):
                            raise ToolError("FileCopySeal source contains a non-directory component")
                        parent_fd = descriptor

                    source_fd = opened[-1]
                    before = os.fstat(source_fd)
                    if before.st_size < 0 or before.st_size > maximum_file_bytes:
                        raise ToolError("FileCopySeal source exceeds maximum_file_bytes")
                    if total_bytes + before.st_size > maximum_total_bytes:
                        raise ToolError("FileCopySeal sources exceed maximum_total_bytes")

                    slot = f"item-{file_index:02d}"
                    basename = parts[-1]
                    os.mkdir(slot, 0o700, dir_fd=files_fd)
                    destination_parent = os.open(slot, directory_flags, dir_fd=files_fd)
                    destination_parent_info = os.fstat(destination_parent)
                    if (
                        not stat.S_ISDIR(destination_parent_info.st_mode)
                        or destination_parent_info.st_uid != os.geteuid()
                        or stat.S_IMODE(destination_parent_info.st_mode) != 0o700
                        or destination_parent_info.st_dev != output_info.st_dev
                        or self._descriptor_mount_id(
                            destination_parent,
                            f"FileCopySeal artifact slot {file_index}",
                        ) != output_mount
                    ):
                        raise ToolError("FileCopySeal artifact slot is unsafe")
                    destination_fd = os.open(
                        basename,
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | nofollow,
                        0o400,
                        dir_fd=destination_parent,
                    )
                    copied = 0
                    while copied < before.st_size:
                        chunk = os.read(source_fd, min(1024 * 1024, before.st_size - copied))
                        if not chunk:
                            raise ToolError("FileCopySeal source was truncated while being snapshotted")
                        self._write_all_descriptor(destination_fd, chunk)
                        copied += len(chunk)
                    if os.read(source_fd, 1):
                        raise ToolError("FileCopySeal source grew while being snapshotted")
                    os.fchmod(destination_fd, 0o400)
                    os.fsync(destination_fd)
                    after = os.fstat(source_fd)
                    stable_fields = (
                        "st_dev", "st_ino", "st_uid", "st_mode", "st_nlink", "st_size",
                        "st_mtime_ns", "st_ctime_ns",
                    )
                    if (
                        any(getattr(before, field) != getattr(after, field) for field in stable_fields)
                        or self._descriptor_mount_id(
                            source_fd, f"FileCopySeal source_paths[{file_index - 1}]"
                        ) != root_mount
                    ):
                        raise ToolError("FileCopySeal source changed while being snapshotted")
                    destination_info = os.fstat(destination_fd)
                    if (
                        not stat.S_ISREG(destination_info.st_mode)
                        or destination_info.st_uid != os.geteuid()
                        or destination_info.st_nlink != 1
                        or stat.S_IMODE(destination_info.st_mode) != 0o400
                        or destination_info.st_size != copied
                        or destination_info.st_dev != output_info.st_dev
                        or self._descriptor_mount_id(
                            destination_fd,
                            f"FileCopySeal artifact file {file_index}",
                        ) != output_mount
                    ):
                        raise ToolError("FileCopySeal artifact failed its immutable snapshot checks")

                    # Re-resolve the selected path after the complete read. This
                    # rejects unlink/replacement races even though the retained
                    # original descriptor itself remained safe.
                    verify_parent = root_fd
                    verify_descriptors: list[int] = []
                    try:
                        for component_index, component in enumerate(parts):
                            final = component_index == len(parts) - 1
                            verified = os.open(
                                component,
                                file_flags if final else directory_flags,
                                dir_fd=verify_parent,
                            )
                            verify_descriptors.append(verified)
                            verify_parent = verified
                        verified_info = os.fstat(verify_descriptors[-1])
                        if (
                            verified_info.st_dev != after.st_dev
                            or verified_info.st_ino != after.st_ino
                            or verified_info.st_uid != after.st_uid
                            or verified_info.st_mode != after.st_mode
                            or verified_info.st_nlink != after.st_nlink
                            or verified_info.st_size != after.st_size
                            or verified_info.st_mtime_ns != after.st_mtime_ns
                            or verified_info.st_ctime_ns != after.st_ctime_ns
                            or self._descriptor_mount_id(
                                verify_descriptors[-1],
                                f"FileCopySeal source_paths[{file_index - 1}] revalidation",
                            ) != root_mount
                        ):
                            raise ToolError("FileCopySeal source path changed before publication")
                    finally:
                        for descriptor in reversed(verify_descriptors):
                            with contextlib.suppress(OSError):
                                os.close(descriptor)

                    self._fsync_file_copy_descriptor(
                        destination_parent,
                        f"FileCopySeal artifact slot {file_index}",
                    )
                    total_bytes += copied
                    results.append({
                        "output_path": (
                            f"{FILE_COPY_EXPORT_DIRECTORY}/{final_name}/files/{slot}/{basename}"
                        ),
                        "basename": basename,
                        "bytes": copied,
                        "mode": "0400",
                    })
                except OSError as error:
                    raise ToolError(
                        "FileCopySeal source could not be opened or snapshotted safely "
                        f"(errno={error.errno if error.errno is not None else 'unknown'})"
                    ) from error
                finally:
                    if destination_fd is not None:
                        with contextlib.suppress(OSError):
                            os.close(destination_fd)
                    if destination_parent is not None:
                        with contextlib.suppress(OSError):
                            os.close(destination_parent)
                    for descriptor in reversed(opened):
                        with contextlib.suppress(OSError):
                            os.close(descriptor)

            self._assert_file_copy_source_custody(managed.launch_id, source_mode)
            current_source_identity = source_root.lstat()
            if (
                current_source_identity.st_dev != root_info.st_dev
                or current_source_identity.st_ino != root_info.st_ino
                or current_source_identity.st_uid != root_info.st_uid
                or current_source_identity.st_mode != root_info.st_mode
            ):
                raise ToolError("FileCopySeal launch output root changed before publication")
            current_staging_identity = os.stat(
                FILE_COPY_STAGING_DIRECTORY,
                dir_fd=output_fd,
                follow_symlinks=False,
            )
            if (
                current_staging_identity.st_dev != staging_info.st_dev
                or current_staging_identity.st_ino != staging_info.st_ino
                or current_staging_identity.st_uid != staging_info.st_uid
                or current_staging_identity.st_mode != staging_info.st_mode
            ):
                raise ToolError("FileCopySeal controller staging root changed before publication")
            current_exports_identity = os.stat(
                FILE_COPY_EXPORT_DIRECTORY,
                dir_fd=output_fd,
                follow_symlinks=False,
            )
            if (
                current_exports_identity.st_dev != exports_info.st_dev
                or current_exports_identity.st_ino != exports_info.st_ino
                or current_exports_identity.st_uid != exports_info.st_uid
                or current_exports_identity.st_mode != exports_info.st_mode
            ):
                raise ToolError("FileCopySeal export root changed before publication")
            current_pending_identity = os.stat(
                pending_name,
                dir_fd=staging_fd,
                follow_symlinks=False,
            )
            if (
                current_pending_identity.st_dev != pending_info.st_dev
                or current_pending_identity.st_ino != pending_info.st_ino
                or current_pending_identity.st_uid != pending_info.st_uid
                or current_pending_identity.st_mode != pending_info.st_mode
            ):
                raise ToolError("FileCopySeal pending transaction changed before publication")
            for descriptor, label in (
                (files_fd, "FileCopySeal files transaction"),
                (pending_fd, "FileCopySeal pending transaction"),
                (staging_fd, "FileCopySeal controller staging root"),
                (exports_fd, "FileCopySeal export root"),
                (output_fd, "desktop output root"),
            ):
                self._fsync_file_copy_descriptor(descriptor, label)
            self._rename_file_copy_noreplace(
                staging_fd,
                pending_name,
                exports_fd,
                final_name,
            )
            renamed = True
            pending_name = ""
            final_info = os.stat(final_name, dir_fd=exports_fd, follow_symlinks=False)
            if (
                not stat.S_ISDIR(final_info.st_mode)
                or final_info.st_dev != pending_info.st_dev
                or final_info.st_ino != pending_info.st_ino
                or final_info.st_uid != os.geteuid()
                or stat.S_IMODE(final_info.st_mode) != 0o700
                or final_info.st_dev != output_info.st_dev
                or self._descriptor_mount_id(
                    pending_fd, "FileCopySeal published transaction"
                ) != output_mount
            ):
                raise ToolError("FileCopySeal publication identity is inconsistent")
            self._fsync_file_copy_descriptor(
                staging_fd, "FileCopySeal controller staging root"
            )
            self._fsync_file_copy_descriptor(exports_fd, "FileCopySeal export root")
            self._fsync_file_copy_descriptor(output_fd, "desktop output root")
            published = True
            return {
                "copied": True,
                "kind": "files",
                "mime": FILE_DROP_MIME,
                "file_count": len(results),
                "source_bytes": total_bytes,
                "bytes": total_bytes,
                "uri_list_bytes": len(uri_payload),
                "files": results,
                "export_directory": f"{FILE_COPY_EXPORT_DIRECTORY}/{final_name}",
                "source_paths_retained": False,
                "source_basenames_exposed": True,
                "canonicalized": True,
                "snapshot_mode": "0400-regular-single-link",
                "snapshot_layout": "opaque-indexed-directory+original-basename",
                "snapshot_retention": "persistent-controller-artifact-until-operator-removal",
                "source_namespace": "exact-launch-private-output-only",
                "selection_payload_retained": False,
                "stable_payload_fingerprint_retained": False,
                "untrusted": True,
                "trust": "controlled-application-output",
            }
        except Exception as snapshot_error:
            public_error: Exception = snapshot_error
            if isinstance(snapshot_error, OSError):
                public_error = ToolError(
                    "FileCopySeal transaction failed at a filesystem boundary "
                    f"(errno={snapshot_error.errno if snapshot_error.errno is not None else 'unknown'})"
                )
            cleanup_error: Exception | None = None
            cleanup_name = final_name if renamed else pending_name
            cleanup_parent_fd = exports_fd if renamed else staging_fd
            if cleanup_name and cleanup_parent_fd is not None and not published:
                try:
                    self._remove_file_copy_tree(cleanup_parent_fd, cleanup_name)
                except Exception as error:
                    cleanup_error = error
            if cleanup_error is not None:
                raise ToolError(
                    "FileCopySeal failed and its hidden partial artifact cleanup could not be proved"
                ) from cleanup_error
            if public_error is snapshot_error:
                raise snapshot_error
            raise public_error from snapshot_error
        finally:
            for descriptor in (
                files_fd,
                pending_fd,
                staging_fd,
                exports_fd,
                output_fd,
                root_fd,
            ):
                if descriptor is not None:
                    with contextlib.suppress(OSError):
                        os.close(descriptor)

    @staticmethod
    def _inspect_canonical_rich_paste_png(payload: bytes) -> dict[str, int]:
        """Verify the exact metadata-free PNG grammar emitted by the controller."""
        signature = b"\x89PNG\r\n\x1a\n"
        if not payload.startswith(signature):
            raise ToolError("canonical rich paste PNG has an invalid signature")
        offset = len(signature)
        chunk_count = 0
        saw_header = False
        saw_data = False
        saw_end = False
        width = height = color_type = 0
        while offset < len(payload):
            chunk_count += 1
            if chunk_count > 4096 or len(payload) - offset < 12:
                raise ToolError("canonical rich paste PNG has malformed chunk framing")
            length = struct.unpack(">I", payload[offset : offset + 4])[0]
            if length > 0x7FFFFFFF or length > len(payload) - offset - 12:
                raise ToolError("canonical rich paste PNG has an invalid chunk length")
            chunk_type = payload[offset + 4 : offset + 8]
            data_start = offset + 8
            data_end = data_start + length
            data = payload[data_start:data_end]
            expected_crc = struct.unpack(">I", payload[data_end : data_end + 4])[0]
            if zlib.crc32(chunk_type + data) & 0xFFFFFFFF != expected_crc:
                raise ToolError("canonical rich paste PNG has an invalid chunk checksum")
            if chunk_type == b"IHDR":
                if chunk_count != 1 or saw_header or length != 13:
                    raise ToolError("canonical rich paste PNG has an invalid header")
                width, height = struct.unpack(">II", data[:8])
                bit_depth, color_type, compression, filtering, interlace = data[8:13]
                if (
                    width <= 0
                    or height <= 0
                    or width > MAX_RICH_PASTE_DIMENSION
                    or height > MAX_RICH_PASTE_DIMENSION
                    or width * height > MAX_RICH_PASTE_PIXELS
                    or bit_depth != 8
                    or color_type not in {2, 6}
                    or compression != 0
                    or filtering != 0
                    or interlace != 0
                ):
                    raise ToolError("canonical rich paste PNG header exceeds its exact profile")
                saw_header = True
            elif chunk_type == b"IDAT":
                if not saw_header or saw_end or length == 0:
                    raise ToolError("canonical rich paste PNG has invalid image-data ordering")
                saw_data = True
            elif chunk_type == b"IEND":
                if (
                    not saw_header
                    or not saw_data
                    or saw_end
                    or length != 0
                    or data_end + 4 != len(payload)
                ):
                    raise ToolError("canonical rich paste PNG has an invalid end marker")
                saw_end = True
            else:
                raise ToolError("canonical rich paste PNG retained a non-image chunk")
            offset = data_end + 4
            if saw_end:
                break
        if not (saw_header and saw_data and saw_end and offset == len(payload)):
            raise ToolError("canonical rich paste PNG is incomplete")
        return {
            "width": width,
            "height": height,
            "color_type": color_type,
            "chunks": chunk_count,
        }

    @staticmethod
    def _sanitize_png_for_rich_paste(source: bytes) -> tuple[bytes, dict[str, Any]]:
        if not source.startswith(b"\x89PNG\r\n\x1a\n"):
            raise ToolError("rich paste source is not a PNG image")

        class BoundedOutput(io.BytesIO):
            def write(self, value: bytes) -> int:
                end = self.tell() + len(value)
                if end > MAX_RICH_PASTE_PNG_BYTES:
                    raise ToolError("canonical rich paste PNG exceeds the private payload limit")
                return super().write(value)

            def truncate(self, size: int | None = None) -> int:
                target = self.tell() if size is None else size
                if target > MAX_RICH_PASTE_PNG_BYTES:
                    raise ToolError("canonical rich paste PNG exceeds the private payload limit")
                return super().truncate(size)

        canonical: Image.Image | None = None
        output = BoundedOutput()
        width = height = 0
        alpha = False
        try:
            with warnings.catch_warnings():
                warnings.simplefilter("error", Image.DecompressionBombWarning)
                with Image.open(io.BytesIO(source)) as probe:
                    if probe.format != "PNG":
                        raise ToolError("rich paste source is not decoded as PNG")
                    width, height = probe.size
                    frames = int(getattr(probe, "n_frames", 1))
                    if frames != 1:
                        raise ToolError("rich paste accepts one still PNG frame only")
                    if (
                        width <= 0
                        or height <= 0
                        or width > MAX_RICH_PASTE_DIMENSION
                        or height > MAX_RICH_PASTE_DIMENSION
                        or width * height > MAX_RICH_PASTE_PIXELS
                    ):
                        raise ToolError("rich paste PNG dimensions exceed the bounded pixel budget")
                    probe.verify()
                with Image.open(io.BytesIO(source)) as decoded:
                    decoded.seek(0)
                    decoded.load()
                    alpha = "A" in decoded.getbands() or "transparency" in decoded.info
                    canonical = decoded.convert("RGBA" if alpha else "RGB")
                    canonical.info.clear()
                    canonical.save(
                        output,
                        format="PNG",
                        optimize=False,
                        compress_level=6,
                        pnginfo=None,
                    )
        except ToolError:
            raise
        except (Image.DecompressionBombError, Image.DecompressionBombWarning) as error:
            raise ToolError("rich paste PNG exceeds the safe decode budget") from error
        except Exception as error:
            raise ToolError("rich paste PNG could not be fully decoded and canonicalized") from error
        finally:
            if canonical is not None:
                canonical.close()
        payload = output.getvalue()
        if not 8 <= len(payload) <= MAX_RICH_PASTE_PNG_BYTES:
            raise ToolError("canonical rich paste PNG exceeds the private payload limit")
        receipt = DesktopController._inspect_canonical_rich_paste_png(payload)
        expected_color_type = 6 if alpha else 2
        if (
            receipt["width"] != width
            or receipt["height"] != height
            or receipt["color_type"] != expected_color_type
        ):
            raise ToolError("canonical rich paste PNG changed its decoded image contract")
        return payload, {
            "kind": "png",
            "mime": "image/png",
            "width": width,
            "height": height,
            "source_bytes": len(source),
            "payload_bytes": len(payload),
            "canonicalized": True,
            "metadata_retained": False,
            "canonical_chunks": receipt["chunks"],
            "frames": 1,
        }

    @staticmethod
    def _sanitize_png_for_copy(source: bytes) -> tuple[bytes, dict[str, Any]]:
        try:
            payload, metadata = DesktopController._sanitize_png_for_rich_paste(source)
        except ToolError as error:
            message = str(error).replace("rich paste", "copied").replace("Rich paste", "Copied")
            raise ToolError(message) from error
        metadata = dict(metadata)
        metadata["bytes"] = metadata.pop("payload_bytes")
        metadata["transport"] = "MCP-image-content-after-selection-clear"
        metadata["source_payload_retained"] = False
        metadata["stable_payload_fingerprint_retained"] = False
        return payload, metadata

    def _normalize_rich_paste_payload(
        self,
        arguments: dict[str, Any],
    ) -> tuple[bytes, str, dict[str, Any]]:
        kind = arguments.get("kind")
        if kind not in {"text", "png"}:
            raise ToolError("kind must be text or png")
        if kind == "text":
            if "source_path" in arguments and arguments.get("source_path") is not None:
                raise ToolError("text rich paste cannot also name a source_path")
            text = as_string(arguments.get("text"), "text")
            payload = text.encode("utf-8")
            if len(payload) > MAX_TEXT_BYTES:
                raise ToolError("rich paste text exceeds the UTF-8 payload limit")
            return payload, "text", {
                "kind": "text",
                "mime": "text/plain;charset=utf-8",
                "characters": len(text),
                "payload_bytes": len(payload),
                "canonicalized": False,
            }
        if "text" in arguments and arguments.get("text") is not None:
            raise ToolError("PNG rich paste cannot also contain text")
        source, snapshot = self._read_project_file_snapshot(
            arguments.get("source_path"),
            maximum_bytes=MAX_RICH_PASTE_PNG_BYTES,
            label="source_path",
        )
        payload, metadata = self._sanitize_png_for_rich_paste(source)
        metadata["source_mode"] = snapshot["source_mode"]
        metadata["source_links"] = snapshot["source_links"]
        return payload, "png", metadata

    def _launch_file_drop_root(self, launch_id: str) -> tuple[ManagedProcess, Path]:
        """Resolve one exact launch-private staging root without following aliases."""
        managed = self._managed_by_launch_id(launch_id)
        if managed.drop_quarantined:
            raise ToolError(
                "launch FileDropSeal storage is quarantined after an unproved cleanup; "
                "terminate and relaunch the exact application"
            )
        expected = f"drop/{managed.launch_id}"
        if managed.drop_subdirectory != expected:
            raise ToolError("launch has no valid FileDropSeal staging root")
        parent = self.drop_root
        if parent is None:
            raise ToolError("controller-private FileDropSeal storage is unavailable")
        root = parent / managed.launch_id
        for path, label in ((parent, "file-drop root"), (root, "launch file-drop root")):
            try:
                info = path.lstat()
            except OSError as error:
                raise ToolError(f"{label} is unavailable") from error
            if (
                not stat.S_ISDIR(info.st_mode)
                or stat.S_ISLNK(info.st_mode)
                or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700
            ):
                raise ToolError(f"{label} is unsafe")
        return managed, root

    def _quarantine_file_drop_launch(self, managed: ManagedProcess, reason: str) -> int:
        """Revoke one launch after controller-private snapshot cleanup is uncertain.

        The launch capsule has a read-only projection of its private snapshot
        root. If controller-side deletion cannot be proved, retaining the
        application would leave a possible disclosure window. Stop descendant
        admission, mark the security context failed, and kill only exact
        birth-pinned member identities. Accounting and the private root remain
        intact for launch teardown to retry.
        """
        if reason not in {
            "staging-transaction-cleanup-unproved",
            "failed-drop-transaction-cleanup-unproved",
            "failed-paste-transaction-cleanup-unproved",
        }:
            raise RuntimeError("invalid FileDropSeal quarantine reason")
        # Refresh custody immediately before revocation so descendants created
        # during the failed transfer are included in the exact birth-pinned
        # kill set. Lightweight deterministic fixtures intentionally do not
        # model /proc; a failed refresh cannot weaken their retained inventory.
        with contextlib.suppress(Exception):
            self._refresh_managed(managed)
        managed.admitting = False
        managed.context_failed = True
        managed.drop_quarantined = True
        managed.drop_quarantine_reason = reason
        signals = 0
        for pid, start_ticks in sorted(managed.members.items()):
            if signal_exact_process(pid, start_ticks, signal.SIGKILL):
                signals += 1
        managed.drop_quarantine_signals += signals
        return signals

    @staticmethod
    def _write_all_descriptor(descriptor: int, payload: bytes) -> None:
        offset = 0
        while offset < len(payload):
            written = os.write(descriptor, payload[offset:])
            if written <= 0:
                raise ToolError("descriptor write made no progress")
            offset += written

    def _remove_file_drop_tree(
        self,
        parent_fd: int,
        name: str,
        *,
        identity: str,
    ) -> None:
        """Remove one private drop tree through retained directory descriptors.

        DirectoryTransferSeal deliberately freezes nested directories to mode
        0500. ``shutil.rmtree`` cannot unlink children through those directories
        as an ordinary owner, and pathname-based chmod would reopen alias races.
        This walker follows no links, rejects owner/device/mount crossings and
        repeated directory inodes, widens only retained controller-created
        directory descriptors to 0700, and proves the exact root absent before
        returning. It also safely removes a tampered symlink as a leaf rather
        than traversing it.
        """
        patterns = {
            "transaction": r"(?:dnd|clip)-[0-9a-f]{32}",
            "launch": r"launch-[0-9a-f]{24}",
        }
        pattern = patterns.get(identity)
        if pattern is None or re.fullmatch(pattern, name) is None:
            raise RuntimeError("FileTransferSeal private-tree identity is invalid")
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if (
            not nofollow
            or not hasattr(os, "O_DIRECTORY")
            or os.scandir not in os.supports_fd
        ):
            raise RuntimeError(
                "FileTransferSeal cleanup has no descriptor-relative no-follow boundary"
            )
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        try:
            root_info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        parent_info = os.fstat(parent_fd)
        try:
            parent_mount = self._descriptor_mount_id(
                parent_fd, "FileTransferSeal cleanup parent"
            )
        except ToolError as error:
            raise RuntimeError(
                "FileTransferSeal cleanup parent mount is untrusted"
            ) from error
        if (
            not stat.S_ISDIR(root_info.st_mode)
            or stat.S_ISLNK(root_info.st_mode)
            or root_info.st_uid != os.geteuid()
            or stat.S_IMODE(root_info.st_mode) != 0o700
            or root_info.st_dev != parent_info.st_dev
        ):
            raise RuntimeError("FileTransferSeal private cleanup target is unsafe")

        root_fd: int | None = None
        seen: set[tuple[int, int]] = set()
        removed_entries = 0

        def remove_contents(descriptor: int) -> None:
            nonlocal removed_entries
            metadata = os.fstat(descriptor)
            inode = (metadata.st_dev, metadata.st_ino)
            if inode in seen:
                raise RuntimeError(
                    "FileTransferSeal cleanup encountered a repeated directory inode"
                )
            seen.add(inode)
            if metadata.st_uid != os.geteuid() or metadata.st_dev != parent_info.st_dev:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory escaped its owner or device"
                )
            try:
                mount_id = self._descriptor_mount_id(
                    descriptor, "FileTransferSeal cleanup directory"
                )
            except ToolError as error:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory mount is untrusted"
                ) from error
            if mount_id != parent_mount:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory crossed a mount boundary"
                )
            try:
                os.fchmod(descriptor, 0o700)
            except OSError as error:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory could not be made removable"
                ) from error

            names: list[str] = []
            try:
                with os.scandir(descriptor) as iterator:
                    for entry in iterator:
                        names.append(entry.name)
                        if len(names) + removed_entries > MAX_FILE_DROP_CLEANUP_ENTRIES:
                            raise RuntimeError(
                                "FileTransferSeal cleanup tree exceeds its hard ceiling"
                            )
            except RuntimeError:
                raise
            except OSError as error:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory could not be enumerated"
                ) from error
            names.sort(key=os.fsencode)

            for child_name in names:
                removed_entries += 1
                if removed_entries > MAX_FILE_DROP_CLEANUP_ENTRIES:
                    raise RuntimeError(
                        "FileTransferSeal cleanup tree exceeds its hard ceiling"
                    )
                try:
                    child = os.stat(
                        child_name, dir_fd=descriptor, follow_symlinks=False
                    )
                except OSError as error:
                    raise RuntimeError(
                        "FileTransferSeal cleanup child identity is unavailable"
                    ) from error
                if stat.S_ISDIR(child.st_mode):
                    child_fd: int | None = None
                    try:
                        child_fd = os.open(
                            child_name, directory_flags, dir_fd=descriptor
                        )
                        opened = os.fstat(child_fd)
                        if (
                            opened.st_dev != child.st_dev
                            or opened.st_ino != child.st_ino
                            or opened.st_uid != child.st_uid
                            or opened.st_mode != child.st_mode
                        ):
                            raise RuntimeError(
                                "FileTransferSeal cleanup directory changed before traversal"
                            )
                        remove_contents(child_fd)
                    except RuntimeError:
                        raise
                    except OSError as error:
                        raise RuntimeError(
                            "FileTransferSeal cleanup directory could not be opened safely"
                        ) from error
                    finally:
                        if child_fd is not None:
                            with contextlib.suppress(OSError):
                                os.close(child_fd)
                    try:
                        os.rmdir(child_name, dir_fd=descriptor)
                    except OSError as error:
                        raise RuntimeError(
                            "FileTransferSeal cleanup directory could not be removed"
                        ) from error
                else:
                    try:
                        os.unlink(child_name, dir_fd=descriptor)
                    except OSError as error:
                        raise RuntimeError(
                            "FileTransferSeal cleanup leaf could not be removed"
                        ) from error
            try:
                os.fsync(descriptor)
            except OSError as error:
                raise RuntimeError(
                    "FileTransferSeal cleanup directory could not be synchronized"
                ) from error

        try:
            root_fd = os.open(name, directory_flags, dir_fd=parent_fd)
            opened_root = os.fstat(root_fd)
            if (
                opened_root.st_dev != root_info.st_dev
                or opened_root.st_ino != root_info.st_ino
                or opened_root.st_uid != root_info.st_uid
                or opened_root.st_mode != root_info.st_mode
            ):
                raise RuntimeError(
                    "FileTransferSeal cleanup target changed before traversal"
                )
            remove_contents(root_fd)
            verified_fd = os.open(name, directory_flags, dir_fd=parent_fd)
            try:
                verified = os.fstat(verified_fd)
                if (
                    verified.st_dev != opened_root.st_dev
                    or verified.st_ino != opened_root.st_ino
                ):
                    raise RuntimeError(
                        "FileTransferSeal cleanup target changed before removal"
                    )
            finally:
                os.close(verified_fd)
            os.rmdir(name, dir_fd=parent_fd)
        except FileNotFoundError as error:
            raise RuntimeError(
                "FileTransferSeal cleanup target disappeared during traversal"
            ) from error
        except RuntimeError:
            raise
        except OSError as error:
            raise RuntimeError("FileTransferSeal private-tree cleanup failed") from error
        finally:
            if root_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(root_fd)
        try:
            os.fsync(parent_fd)
        except OSError as error:
            raise RuntimeError(
                "FileTransferSeal cleanup parent could not be synchronized"
            ) from error
        try:
            os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise RuntimeError("FileTransferSeal private-tree cleanup was not proved")

    def _remove_file_drop_transaction(self, launch_id: str, transaction_name: str) -> None:
        """Remove only one controller-minted direct child of a launch drop root."""
        if re.fullmatch(r"launch-[0-9a-f]{24}", launch_id) is None:
            raise RuntimeError("FileDropSeal launch identity is invalid")
        if re.fullmatch(r"(?:dnd|clip)-[0-9a-f]{32}", transaction_name) is None:
            raise RuntimeError("FileTransferSeal transaction identity is invalid")
        parent = self.drop_root
        if parent is None:
            raise RuntimeError("controller-private FileDropSeal storage disappeared")
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise RuntimeError("descriptor-relative no-follow FileDropSeal cleanup is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        parent_fd = os.open(parent, directory_flags)
        try:
            parent_info = os.fstat(parent_fd)
            if (
                not stat.S_ISDIR(parent_info.st_mode)
                or parent_info.st_uid != os.geteuid()
                or stat.S_IMODE(parent_info.st_mode) != 0o700
            ):
                raise RuntimeError("controller-private FileDropSeal root became unsafe")
            try:
                launch_info = os.stat(launch_id, dir_fd=parent_fd, follow_symlinks=False)
            except FileNotFoundError:
                # Whole-launch teardown already proved the parent absent, which
                # also proves this transaction absent.
                return
            if (
                not stat.S_ISDIR(launch_info.st_mode)
                or stat.S_ISLNK(launch_info.st_mode)
                or launch_info.st_uid != os.geteuid()
                or stat.S_IMODE(launch_info.st_mode) != 0o700
            ):
                raise RuntimeError("managed FileDropSeal launch root became unsafe")
            launch_fd = os.open(launch_id, directory_flags, dir_fd=parent_fd)
            try:
                opened_launch = os.fstat(launch_fd)
                if (
                    opened_launch.st_dev != launch_info.st_dev
                    or opened_launch.st_ino != launch_info.st_ino
                    or not stat.S_ISDIR(opened_launch.st_mode)
                    or opened_launch.st_uid != os.geteuid()
                    or stat.S_IMODE(opened_launch.st_mode) != 0o700
                ):
                    raise RuntimeError("managed FileDropSeal launch root identity changed")
                self._remove_file_drop_tree(
                    launch_fd,
                    transaction_name,
                    identity="transaction",
                )
            finally:
                os.close(launch_fd)
        finally:
            os.close(parent_fd)

    def _prepare_file_drop_payload(
        self,
        arguments: dict[str, Any],
        launch_id: str,
        *,
        transaction_prefix: str = "dnd",
    ) -> tuple[bytes, str, dict[str, Any], str]:
        """Snapshot project files into one launch-private read-only URI namespace.

        Source lookup is descriptor-relative and no-follow. The target never sees
        a host project pathname: it receives only local ``file:`` URIs below the
        launch capsule's fixed read-only ``/run/sandcodex-app/drop`` mount.
        Successful transactions remain available for the target's deferred URI
        reads until that exact launch exits; failed drops are removed immediately.
        """
        if transaction_prefix not in {"dnd", "clip"}:
            raise RuntimeError("FileTransferSeal transaction prefix is invalid")
        source_paths = arguments.get("source_paths")
        if (
            not isinstance(source_paths, list)
            or not 1 <= len(source_paths) <= MAX_FILE_DROP_FILES
        ):
            raise ToolError(
                f"source_paths must contain from 1 through {MAX_FILE_DROP_FILES} project files"
            )
        normalized: list[str] = []
        for index, value in enumerate(source_paths):
            normalized.append(
                self._canonical_project_relative_path(value, f"source_paths[{index}]")
            )
        if len(set(normalized)) != len(normalized):
            raise ToolError("source_paths contains a duplicate project file")

        # Resolve launch custody and deny quarantined/exhausted destinations
        # before reading any project bytes. A launch whose prior private
        # snapshot cleanup is uncertain must not trigger additional source
        # disclosure or staging work merely to discover that its authority was
        # already revoked.
        managed, root = self._launch_file_drop_root(launch_id)
        if managed.drop_transaction_count >= MAX_FILE_DROP_LAUNCH_TRANSACTIONS:
            raise ToolError(
                "FileDropSeal launch reached its retained transaction limit; "
                "restart the exact application before staging more files"
            )

        snapshots: list[tuple[str, bytes]] = []
        total_bytes = 0
        for index, relative in enumerate(normalized):
            payload, _receipt = self._read_project_file_snapshot(
                relative,
                maximum_bytes=MAX_FILE_DROP_FILE_BYTES,
                label=f"source_paths[{index}]",
                minimum_bytes=0,
            )
            total_bytes += len(payload)
            if total_bytes > MAX_FILE_DROP_TOTAL_BYTES:
                raise ToolError("FileDropSeal project snapshots exceed the aggregate byte limit")
            snapshots.append((relative, payload))

        # Reacquire the launch after source reads. This closes the interval in
        # which the target could exit, lose its security context, or become
        # quarantined while a bounded snapshot was being constructed.
        managed, root = self._launch_file_drop_root(launch_id)
        if managed.drop_transaction_count >= MAX_FILE_DROP_LAUNCH_TRANSACTIONS:
            raise ToolError(
                "FileDropSeal launch reached its retained transaction limit; "
                "restart the exact application before staging more files"
            )
        if managed.drop_snapshot_bytes + total_bytes > MAX_FILE_DROP_LAUNCH_BYTES:
            raise ToolError(
                "FileDropSeal launch reached its retained snapshot byte budget; "
                "restart the exact application before staging more files"
            )
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if not nofollow or not hasattr(os, "O_DIRECTORY"):
            raise ToolError("descriptor-relative no-follow FileDropSeal staging is unavailable")
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        transaction_name = ""
        root_fd: int | None = None
        transaction_fd: int | None = None
        files_fd: int | None = None
        reservation_active = False
        try:
            root_fd = os.open(root, directory_flags)
            managed.drop_transaction_count += 1
            managed.drop_snapshot_bytes += total_bytes
            reservation_active = True
            for _ in range(16):
                candidate = f"{transaction_prefix}-{secrets.token_hex(16)}"
                try:
                    os.mkdir(candidate, 0o700, dir_fd=root_fd)
                except FileExistsError:
                    continue
                transaction_name = candidate
                break
            if not transaction_name:
                raise ToolError("FileDropSeal could not allocate a unique staging transaction")
            transaction_fd = os.open(transaction_name, directory_flags, dir_fd=root_fd)
            transaction_info = os.fstat(transaction_fd)
            if (
                not stat.S_ISDIR(transaction_info.st_mode)
                or transaction_info.st_uid != os.geteuid()
                or stat.S_IMODE(transaction_info.st_mode) != 0o700
            ):
                raise ToolError("FileDropSeal transaction directory is unsafe")
            os.mkdir("files", 0o700, dir_fd=transaction_fd)
            files_fd = os.open("files", directory_flags, dir_fd=transaction_fd)

            uri_lines: list[str] = []
            for index, (relative, source) in enumerate(snapshots, start=1):
                # Preserve only the filename required by ordinary file-drop
                # semantics. The project-relative parent path is never retained
                # in the app-visible snapshot namespace. An opaque indexed
                # directory also permits two distinct sources with the same
                # basename without silently renaming either file.
                basename = Path(relative).name
                slot = f"item-{index:02d}"
                os.mkdir(slot, 0o700, dir_fd=files_fd)
                parent_fd = os.open(slot, directory_flags, dir_fd=files_fd)
                try:
                    file_fd = os.open(
                        basename,
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | nofollow,
                        0o400,
                        dir_fd=parent_fd,
                    )
                    try:
                        self._write_all_descriptor(file_fd, source)
                        os.fchmod(file_fd, 0o400)
                        os.fsync(file_fd)
                        info = os.fstat(file_fd)
                        if (
                            not stat.S_ISREG(info.st_mode)
                            or info.st_uid != os.geteuid()
                            or info.st_nlink != 1
                            or stat.S_IMODE(info.st_mode) != 0o400
                            or info.st_size != len(source)
                        ):
                            raise ToolError("FileDropSeal staged file failed its immutable snapshot checks")
                    finally:
                        os.close(file_fd)
                    with contextlib.suppress(OSError):
                        os.fsync(parent_fd)
                finally:
                    os.close(parent_fd)

                capsule_path = (
                    f"{FILE_DROP_MOUNT}/{transaction_name}/files/{slot}/{basename}"
                )
                quoted_path = urllib.parse.quote(capsule_path, safe="/-._~", encoding="utf-8", errors="strict")
                uri = f"file://{quoted_path}"
                if not uri.startswith(f"file://{FILE_DROP_MOUNT}/{transaction_name}/files/"):
                    raise ToolError("FileDropSeal URI escaped its launch-private mount")
                uri_lines.append(uri)

            uri_payload = ("\r\n".join(uri_lines) + "\r\n").encode("ascii", "strict")
            if not 1 <= len(uri_payload) <= MAX_FILE_DROP_URI_LIST_BYTES:
                raise ToolError("FileDropSeal URI list exceeds its bounded payload limit")
            for descriptor in (files_fd, transaction_fd, root_fd):
                with contextlib.suppress(OSError):
                    os.fsync(descriptor)
            return uri_payload, "files", {
                "kind": "files",
                "mime": FILE_DROP_MIME,
                "file_count": len(snapshots),
                "source_bytes": total_bytes,
                "payload_bytes": len(uri_payload),
                "canonicalized": True,
                "source_paths_retained": False,
                "source_basenames_exposed": True,
                "stable_payload_fingerprint_retained": False,
                "snapshot_storage": (
                    "controller-private-control-plane-outside-project-and-artifact-output+"
                    "0400-single-link-regular-files+read-only-exact-capsule-bind"
                ),
                "snapshot_model_namespace": "opaque-empty-overlay",
                "snapshot_mode": "0400-regular-single-link",
                "snapshot_layout": "opaque-indexed-directory+original-basename",
                "snapshot_retention": "exact-launch-lifetime-after-success",
                "transfer_transport": (
                    "native-wayland-drag-and-drop"
                    if transaction_prefix == "dnd"
                    else "request-gated-wayland-clipboard-file-paste"
                ),
                "capsule_mount": FILE_DROP_MOUNT,
                "launch_retained_bytes": managed.drop_snapshot_bytes,
                "launch_retained_transactions": managed.drop_transaction_count,
                "launch_byte_budget": MAX_FILE_DROP_LAUNCH_BYTES,
                "launch_transaction_budget": MAX_FILE_DROP_LAUNCH_TRANSACTIONS,
            }, transaction_name
        except Exception as staging_error:
            cleanup_error: Exception | None = None
            if transaction_name:
                try:
                    self._remove_file_drop_transaction(launch_id, transaction_name)
                except Exception as error:
                    cleanup_error = error
            if reservation_active and cleanup_error is None:
                managed.drop_transaction_count -= 1
                managed.drop_snapshot_bytes -= total_bytes
            if cleanup_error is not None:
                self._quarantine_file_drop_launch(
                    managed,
                    "staging-transaction-cleanup-unproved",
                )
                raise ToolError(
                    "FileDropSeal staging failed and private snapshot cleanup could not be "
                    "proved; the exact launch was quarantined and killed while retained "
                    "accounting awaits launch teardown"
                ) from cleanup_error
            raise staging_error
        finally:
            if files_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(files_fd)
            if transaction_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(transaction_fd)
            if root_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(root_fd)

    def _prepare_directory_drop_payload(
        self,
        arguments: dict[str, Any],
        launch_id: str,
        *,
        transaction_prefix: str = "dnd",
    ) -> tuple[bytes, str, dict[str, Any], str]:
        """Snapshot one bounded project directory for native paste or drop.

        The source tree is never bind-mounted into the application. Every path
        component is opened relative to retained project descriptors with
        ``O_NOFOLLOW`` and exact owner/device/mount checks. A full immutable
        source manifest is measured before reservation, the tree is copied into
        one launch-private opaque slot, and the complete source manifest is
        revalidated twice before a single capsule-local directory URI is
        released. Successful snapshots remain only for that launch lifetime.
        """
        if transaction_prefix not in {"dnd", "clip"}:
            raise RuntimeError("DirectoryTransferSeal transaction prefix is invalid")
        relative = self._canonical_project_relative_path(
            arguments.get("source_path"), "source_path"
        )
        selected_parts = tuple(
            self._directory_copy_name(
                part, f"DirectoryTransferSeal source path component {index}"
            )
            for index, part in enumerate(Path(relative).parts, start=1)
        )
        encoded_relative = b"/".join(os.fsencode(part) for part in selected_parts)
        if len(encoded_relative) > MAX_DIRECTORY_COPY_RELATIVE_PATH_BYTES:
            raise ToolError("DirectoryTransferSeal source path exceeds its byte ceiling")
        basename = selected_parts[-1]

        managed, drop_root = self._launch_file_drop_root(launch_id)
        if managed.drop_transaction_count >= MAX_FILE_DROP_LAUNCH_TRANSACTIONS:
            raise ToolError(
                "DirectoryTransferSeal launch reached its retained transaction limit; "
                "restart the exact application before staging another directory"
            )
        nofollow = getattr(os, "O_NOFOLLOW", 0)
        if (
            not nofollow
            or not hasattr(os, "O_DIRECTORY")
            or os.scandir not in os.supports_fd
        ):
            raise ToolError(
                "descriptor-relative no-follow DirectoryTransferSeal is unavailable"
            )
        directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | nofollow
        file_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | nofollow
        deadline = time.monotonic() + MAX_DIRECTORY_COPY_SECONDS

        project_fd: int | None = None
        source_opened: list[int] = []
        selected_fd: int | None = None
        drop_fd: int | None = None
        transaction_fd: int | None = None
        files_fd: int | None = None
        slot_fd: int | None = None
        destination_fd: int | None = None
        transaction_name = ""
        reservation_active = False
        total_bytes = 0
        try:
            try:
                project_path_identity = self.project.lstat()
                project_fd = os.open(self.project, directory_flags)
            except OSError as error:
                raise ToolError(
                    "DirectoryTransferSeal selected project root is unavailable"
                ) from error
            project_info = os.fstat(project_fd)
            project_mount = self._descriptor_mount_id(
                project_fd, "DirectoryTransferSeal selected project root"
            )
            if (
                not stat.S_ISDIR(project_path_identity.st_mode)
                or stat.S_ISLNK(project_path_identity.st_mode)
                or not stat.S_ISDIR(project_info.st_mode)
                or project_info.st_uid != os.geteuid()
                or project_info.st_dev != project_path_identity.st_dev
                or project_info.st_ino != project_path_identity.st_ino
                or project_info.st_mode != project_path_identity.st_mode
            ):
                raise ToolError(
                    "DirectoryTransferSeal selected project root lost its trusted identity"
                )

            parent_fd = project_fd
            for component_index, component in enumerate(selected_parts, start=1):
                try:
                    descriptor = os.open(component, directory_flags, dir_fd=parent_fd)
                except OSError as error:
                    raise ToolError(
                        "DirectoryTransferSeal source path could not be opened without "
                        "following aliases"
                    ) from error
                source_opened.append(descriptor)
                info = os.fstat(descriptor)
                if (
                    not stat.S_ISDIR(info.st_mode)
                    or info.st_dev != project_info.st_dev
                    or info.st_uid != os.geteuid()
                    or self._descriptor_mount_id(
                        descriptor,
                        f"DirectoryTransferSeal source path component {component_index}",
                    ) != project_mount
                ):
                    raise ToolError(
                        "DirectoryTransferSeal source path crosses its project owner, "
                        "device, or mount boundary"
                    )
                parent_fd = descriptor
            selected_fd = source_opened[-1]
            selected_before = os.fstat(selected_fd)

            preflight_state: dict[str, Any] = {
                "maximum_file_bytes": MAX_FILE_DROP_FILE_BYTES,
                "maximum_total_bytes": MAX_FILE_DROP_TOTAL_BYTES,
                "maximum_entries": MAX_DIRECTORY_COPY_ENTRIES,
                "maximum_directories": MAX_DIRECTORY_COPY_DIRECTORIES,
                "maximum_depth": MAX_DIRECTORY_COPY_DEPTH,
                "entry_count": 0,
                "directory_count": 0,
                "file_count": 0,
                "total_bytes": 0,
                "seen_inodes": set(),
                "manifest": [],
                "deadline": deadline,
            }
            self._verify_directory_copy_manifest(
                launch_id=managed.launch_id,
                source_mode="project-transfer",
                source_fd=selected_fd,
                source_root_info=project_info,
                source_mount=project_mount,
                directory_flags=directory_flags,
                file_flags=file_flags,
                depth=0,
                relative_parts=(basename,),
                state=preflight_state,
            )
            total_bytes = int(preflight_state["total_bytes"])

            # Reacquire exact destination custody after the complete source
            # preflight. No project byte is staged for an exited, quarantined,
            # or budget-exhausted launch.
            managed, drop_root = self._launch_file_drop_root(launch_id)
            if managed.drop_transaction_count >= MAX_FILE_DROP_LAUNCH_TRANSACTIONS:
                raise ToolError(
                    "DirectoryTransferSeal launch reached its retained transaction limit; "
                    "restart the exact application before staging another directory"
                )
            if managed.drop_snapshot_bytes + total_bytes > MAX_FILE_DROP_LAUNCH_BYTES:
                raise ToolError(
                    "DirectoryTransferSeal launch reached its retained snapshot byte budget; "
                    "restart the exact application before staging another directory"
                )

            try:
                drop_path_identity = drop_root.lstat()
                drop_fd = os.open(drop_root, directory_flags)
            except OSError as error:
                raise ToolError(
                    "DirectoryTransferSeal launch-private destination is unavailable"
                ) from error
            drop_info = os.fstat(drop_fd)
            drop_mount = self._descriptor_mount_id(
                drop_fd, "DirectoryTransferSeal launch-private destination"
            )
            if (
                not stat.S_ISDIR(drop_path_identity.st_mode)
                or stat.S_ISLNK(drop_path_identity.st_mode)
                or not stat.S_ISDIR(drop_info.st_mode)
                or drop_info.st_uid != os.geteuid()
                or stat.S_IMODE(drop_info.st_mode) != 0o700
                or drop_info.st_dev != drop_path_identity.st_dev
                or drop_info.st_ino != drop_path_identity.st_ino
                or drop_info.st_mode != drop_path_identity.st_mode
            ):
                raise ToolError(
                    "DirectoryTransferSeal launch-private destination lost its trusted identity"
                )

            managed.drop_transaction_count += 1
            managed.drop_snapshot_bytes += total_bytes
            reservation_active = True
            for _ in range(16):
                candidate = f"{transaction_prefix}-{secrets.token_hex(16)}"
                try:
                    os.mkdir(candidate, 0o700, dir_fd=drop_fd)
                except FileExistsError:
                    continue
                transaction_name = candidate
                break
            if not transaction_name:
                raise ToolError(
                    "DirectoryTransferSeal could not allocate a unique staging transaction"
                )
            transaction_fd = os.open(transaction_name, directory_flags, dir_fd=drop_fd)
            transaction_info = os.fstat(transaction_fd)
            if (
                not stat.S_ISDIR(transaction_info.st_mode)
                or transaction_info.st_uid != os.geteuid()
                or stat.S_IMODE(transaction_info.st_mode) != 0o700
                or transaction_info.st_dev != drop_info.st_dev
                or self._descriptor_mount_id(
                    transaction_fd, "DirectoryTransferSeal staging transaction"
                ) != drop_mount
            ):
                raise ToolError("DirectoryTransferSeal staging transaction is unsafe")
            os.mkdir("files", 0o700, dir_fd=transaction_fd)
            files_fd = os.open("files", directory_flags, dir_fd=transaction_fd)
            os.mkdir("item-01", 0o700, dir_fd=files_fd)
            slot_fd = os.open("item-01", directory_flags, dir_fd=files_fd)
            os.mkdir(basename, 0o700, dir_fd=slot_fd)
            destination_fd = os.open(basename, directory_flags, dir_fd=slot_fd)
            for descriptor, label in (
                (files_fd, "DirectoryTransferSeal URI namespace"),
                (slot_fd, "DirectoryTransferSeal opaque item slot"),
                (destination_fd, "DirectoryTransferSeal directory snapshot root"),
            ):
                info = os.fstat(descriptor)
                if (
                    not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != os.geteuid()
                    or stat.S_IMODE(info.st_mode) != 0o700
                    or info.st_dev != drop_info.st_dev
                    or self._descriptor_mount_id(descriptor, label) != drop_mount
                ):
                    raise ToolError(f"{label} is unsafe")

            copy_state: dict[str, Any] = {
                "maximum_file_bytes": MAX_FILE_DROP_FILE_BYTES,
                "maximum_total_bytes": MAX_FILE_DROP_TOTAL_BYTES,
                "maximum_entries": MAX_DIRECTORY_COPY_ENTRIES,
                "maximum_directories": MAX_DIRECTORY_COPY_DIRECTORIES,
                "maximum_depth": MAX_DIRECTORY_COPY_DEPTH,
                "entry_count": 0,
                "directory_count": 0,
                "file_count": 0,
                "total_bytes": 0,
                "seen_inodes": set(),
                "manifest": [],
                "deadline": deadline,
            }
            self._copy_directory_tree(
                launch_id=managed.launch_id,
                source_mode="project-transfer",
                source_fd=selected_fd,
                destination_fd=destination_fd,
                source_root_info=project_info,
                source_mount=project_mount,
                output_info=drop_info,
                output_mount=drop_mount,
                directory_flags=directory_flags,
                file_flags=file_flags,
                nofollow=nofollow,
                depth=0,
                relative_parts=(basename,),
                state=copy_state,
            )
            if (
                copy_state["manifest"] != preflight_state["manifest"]
                or copy_state["entry_count"] != preflight_state["entry_count"]
                or copy_state["directory_count"] != preflight_state["directory_count"]
                or copy_state["file_count"] != preflight_state["file_count"]
                or copy_state["total_bytes"] != preflight_state["total_bytes"]
            ):
                raise ToolError(
                    "DirectoryTransferSeal source-tree manifest changed between "
                    "preflight and snapshot"
                )
            self._assert_file_copy_source_custody(
                managed.launch_id, "project-transfer"
            )

            verify_parent = project_fd
            verify_descriptors: list[int] = []
            try:
                for component in selected_parts:
                    verified = os.open(component, directory_flags, dir_fd=verify_parent)
                    verify_descriptors.append(verified)
                    verify_parent = verified
                selected_after = os.fstat(verify_descriptors[-1])
                if (
                    self._directory_copy_identity(selected_after)
                    != self._directory_copy_identity(os.fstat(selected_fd))
                    or self._directory_copy_identity(selected_after)
                    != self._directory_copy_identity(selected_before)
                    or self._descriptor_mount_id(
                        verify_descriptors[-1],
                        "DirectoryTransferSeal selected root revalidation",
                    ) != project_mount
                ):
                    raise ToolError(
                        "DirectoryTransferSeal selected directory changed before release"
                    )
            finally:
                for descriptor in reversed(verify_descriptors):
                    with contextlib.suppress(OSError):
                        os.close(descriptor)

            current_project_identity = self.project.lstat()
            if (
                current_project_identity.st_dev != project_info.st_dev
                or current_project_identity.st_ino != project_info.st_ino
                or current_project_identity.st_uid != project_info.st_uid
                or current_project_identity.st_mode != project_info.st_mode
            ):
                raise ToolError(
                    "DirectoryTransferSeal selected project root changed before release"
                )

            verification_state: dict[str, Any] = {
                "maximum_file_bytes": MAX_FILE_DROP_FILE_BYTES,
                "maximum_total_bytes": MAX_FILE_DROP_TOTAL_BYTES,
                "maximum_entries": MAX_DIRECTORY_COPY_ENTRIES,
                "maximum_directories": MAX_DIRECTORY_COPY_DIRECTORIES,
                "maximum_depth": MAX_DIRECTORY_COPY_DEPTH,
                "entry_count": 0,
                "directory_count": 0,
                "file_count": 0,
                "total_bytes": 0,
                "seen_inodes": set(),
                "manifest": [],
                "deadline": deadline,
            }
            self._verify_directory_copy_manifest(
                launch_id=managed.launch_id,
                source_mode="project-transfer",
                source_fd=selected_fd,
                source_root_info=project_info,
                source_mount=project_mount,
                directory_flags=directory_flags,
                file_flags=file_flags,
                depth=0,
                relative_parts=(basename,),
                state=verification_state,
            )
            if (
                verification_state["manifest"] != copy_state["manifest"]
                or verification_state["entry_count"] != copy_state["entry_count"]
                or verification_state["directory_count"] != copy_state["directory_count"]
                or verification_state["file_count"] != copy_state["file_count"]
                or verification_state["total_bytes"] != copy_state["total_bytes"]
            ):
                raise ToolError(
                    "DirectoryTransferSeal complete source-tree manifest changed before release"
                )
            self._assert_file_copy_source_custody(
                managed.launch_id, "project-transfer"
            )

            for descriptor, label in (
                (destination_fd, "DirectoryTransferSeal directory snapshot root"),
                (slot_fd, "DirectoryTransferSeal opaque item slot"),
                (files_fd, "DirectoryTransferSeal URI namespace"),
                (transaction_fd, "DirectoryTransferSeal staging transaction"),
                (drop_fd, "DirectoryTransferSeal launch-private destination"),
            ):
                self._fsync_file_copy_descriptor(descriptor, label)

            capsule_path = (
                f"{FILE_DROP_MOUNT}/{transaction_name}/files/item-01/{basename}"
            )
            quoted_path = urllib.parse.quote(
                capsule_path,
                safe="/-._~",
                encoding="utf-8",
                errors="strict",
            )
            uri = f"file://{quoted_path}"
            expected_prefix = (
                f"file://{FILE_DROP_MOUNT}/{transaction_name}/files/item-01/"
            )
            if not uri.startswith(expected_prefix):
                raise ToolError(
                    "DirectoryTransferSeal URI escaped its launch-private mount"
                )
            uri_payload = f"{uri}\r\n".encode("ascii", "strict")
            if not 1 <= len(uri_payload) <= MAX_FILE_DROP_URI_LIST_BYTES:
                raise ToolError(
                    "DirectoryTransferSeal URI list exceeds its bounded payload limit"
                )
            return uri_payload, "files", {
                "kind": "directory",
                "mime": FILE_DROP_MIME,
                "uri_entry_count": 1,
                "file_count": copy_state["file_count"],
                "directory_count": copy_state["directory_count"],
                "entry_count": copy_state["entry_count"],
                "source_bytes": copy_state["total_bytes"],
                "payload_bytes": len(uri_payload),
                "canonicalized": True,
                "source_paths_retained": False,
                "source_basenames_exposed": True,
                "descendant_names_exposed": True,
                "stable_payload_fingerprint_retained": False,
                "complete_source_tree_revalidated_before_release": True,
                "source_tree_manifest_retained": False,
                "snapshot_storage": (
                    "controller-private-control-plane-outside-project-and-artifact-output+"
                    "0500-directories+0400-single-link-regular-files+"
                    "read-only-exact-capsule-bind"
                ),
                "snapshot_model_namespace": "opaque-empty-overlay",
                "snapshot_mode": "0500-directories+0400-regular-single-link-files",
                "snapshot_layout": (
                    "opaque-indexed-directory+original-basename+preserved-bounded-tree"
                ),
                "snapshot_retention": "exact-launch-lifetime-after-success",
                "source_namespace": "selected-project-directory-only",
                "transfer_transport": (
                    "native-wayland-directory-drag-and-drop"
                    if transaction_prefix == "dnd"
                    else "request-gated-wayland-clipboard-directory-paste"
                ),
                "capsule_mount": FILE_DROP_MOUNT,
                "tree_limits": {
                    "maximum_entries": MAX_DIRECTORY_COPY_ENTRIES,
                    "maximum_directories": MAX_DIRECTORY_COPY_DIRECTORIES,
                    "maximum_depth": MAX_DIRECTORY_COPY_DEPTH,
                    "maximum_file_bytes": MAX_FILE_DROP_FILE_BYTES,
                    "maximum_total_bytes": MAX_FILE_DROP_TOTAL_BYTES,
                    "maximum_snapshot_seconds": MAX_DIRECTORY_COPY_SECONDS,
                },
                "launch_retained_bytes": managed.drop_snapshot_bytes,
                "launch_retained_transactions": managed.drop_transaction_count,
                "launch_byte_budget": MAX_FILE_DROP_LAUNCH_BYTES,
                "launch_transaction_budget": MAX_FILE_DROP_LAUNCH_TRANSACTIONS,
            }, transaction_name
        except Exception as staging_error:
            public_error: Exception = staging_error
            if isinstance(staging_error, OSError):
                public_error = ToolError(
                    "DirectoryTransferSeal transaction failed at a filesystem boundary "
                    f"(errno={staging_error.errno if staging_error.errno is not None else 'unknown'})"
                )
            cleanup_error: Exception | None = None
            if transaction_name:
                try:
                    self._remove_file_drop_transaction(launch_id, transaction_name)
                except Exception as error:
                    cleanup_error = error
            if reservation_active and cleanup_error is None:
                if managed.drop_subdirectory is None:
                    if (
                        managed.drop_transaction_count != 0
                        or managed.drop_snapshot_bytes != 0
                    ):
                        cleanup_error = RuntimeError(
                            "DirectoryTransferSeal launch teardown left inconsistent accounting"
                        )
                elif (
                    managed.drop_transaction_count < 1
                    or managed.drop_snapshot_bytes < total_bytes
                ):
                    cleanup_error = RuntimeError(
                        "DirectoryTransferSeal retained-budget accounting regressed"
                    )
                else:
                    managed.drop_transaction_count -= 1
                    managed.drop_snapshot_bytes -= total_bytes
            if cleanup_error is not None:
                self._quarantine_file_drop_launch(
                    managed,
                    "staging-transaction-cleanup-unproved",
                )
                raise ToolError(
                    "DirectoryTransferSeal staging failed and private snapshot cleanup "
                    "could not be proved; the exact launch was quarantined and killed "
                    "while retained accounting awaits launch teardown"
                ) from cleanup_error
            if public_error is staging_error:
                raise staging_error
            raise public_error from staging_error
        finally:
            for descriptor in (
                destination_fd,
                slot_fd,
                files_fd,
                transaction_fd,
                drop_fd,
            ):
                if descriptor is not None:
                    with contextlib.suppress(OSError):
                        os.close(descriptor)
            for descriptor in reversed(source_opened):
                with contextlib.suppress(OSError):
                    os.close(descriptor)
            if project_fd is not None:
                with contextlib.suppress(OSError):
                    os.close(project_fd)

    def _cleanup_failed_file_transfer(
        self,
        managed: ManagedProcess,
        launch_id: str,
        transaction_name: str,
        retained_bytes: int,
        evidence: dict[str, Any],
        *,
        quarantine_reason: str,
        failure_label: str,
    ) -> ToolError | None:
        """Prove one failed transfer snapshot absent or revoke its exact launch.

        The caller retains the original ManagedProcess object before staging.
        That matters when the launch exits during transfer: ordinary liveness
        lookup may correctly stop returning the launch even though teardown has
        already removed the private root and zeroed its accounting.  We accept
        that exact teardown receipt instead of reacquiring through a liveness
        gate, while any other cleanup ambiguity kills and quarantines only the
        birth-pinned destination launch.
        """
        cleanup_error: Exception | None = None
        try:
            self._remove_file_drop_transaction(launch_id, transaction_name)
        except Exception as error:
            cleanup_error = error

        teardown_reclaimed = managed.drop_subdirectory is None
        if teardown_reclaimed:
            if managed.drop_transaction_count != 0 or managed.drop_snapshot_bytes != 0:
                cleanup_error = cleanup_error or RuntimeError(
                    "FileTransferSeal launch teardown left nonzero retained accounting"
                )
            else:
                evidence["file_snapshot_removed_after_failure"] = True
                evidence["file_snapshot_reclaimed_by_launch_teardown"] = True
                return None

        if cleanup_error is None:
            if (
                managed.drop_transaction_count < 1
                or retained_bytes < 0
                or managed.drop_snapshot_bytes < retained_bytes
            ):
                cleanup_error = RuntimeError(
                    "FileTransferSeal retained-budget accounting regressed"
                )
            else:
                managed.drop_transaction_count -= 1
                managed.drop_snapshot_bytes -= retained_bytes
                evidence["file_snapshot_removed_after_failure"] = True
                evidence["file_snapshot_reclaimed_by_launch_teardown"] = False
                return None

        evidence["file_snapshot_removed_after_failure"] = False
        evidence["file_snapshot_reclaimed_by_launch_teardown"] = False
        evidence["file_snapshot_cleanup_error"] = (
            f"{type(cleanup_error).__name__}: {cleanup_error}"[:512]
        )
        evidence["file_snapshot_quarantine_signals"] = self._quarantine_file_drop_launch(
            managed,
            quarantine_reason,
        )
        evidence["file_snapshot_launch_quarantined"] = True
        return ToolError(
            f"{failure_label} failed and its private staging cleanup could not be proved; "
            "the exact launch was quarantined and killed while retained accounting "
            "awaits launch teardown"
        )

    def _fenced_clipboard_payload(
        self,
        payload: bytes,
        profile: str,
        target: dict[str, Any],
        *,
        action_name: str,
        purpose: str,
        paste_chord: Any,
        result_metadata: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        chord = self._normalize_paste_chord(paste_chord)
        clipboard_evidence: dict[str, Any] | None = None

        def paste(
            transaction: WaylandKeyboardTransaction,
            _index: int,
            checkpoint: Callable[[str], None],
        ) -> None:
            nonlocal clipboard_evidence
            scene_launch_ids_value = target.get("scene_launch_ids")
            scene_launch_ids = (
                tuple(scene_launch_ids_value)
                if isinstance(scene_launch_ids_value, tuple) and scene_launch_ids_value
                else ()
            )
            scene_id_value = target.get("scene_id") if scene_launch_ids else None
            scene_id = str(scene_id_value) if isinstance(scene_id_value, str) else None
            launch_id = target.get("launch_id")
            launch_id_value = (
                str(launch_id)
                if isinstance(launch_id, str) and not scene_launch_ids
                else None
            )

            def assert_clipboard_scope() -> None:
                if scene_launch_ids:
                    self._assert_clipboard_scene_exclusive(scene_id, scene_launch_ids)
                elif launch_id_value is not None:
                    self._assert_clipboard_launch_exclusive(launch_id_value)

            escrow_error: Exception | None = None
            escrow: WaylandClipboardTransaction | None = None
            try:
                with WaylandClipboardTransaction(
                    self,
                    payload,
                    purpose,
                    launch_id_value,
                    profile=profile,
                    scene_id=scene_id,
                    scene_launch_ids=scene_launch_ids,
                ) as escrow:
                    checkpoint("selection-published")
                    assert_clipboard_scope()
                    keycode, modifiers = transaction.plan_chord(chord)
                    self._dispatch_compositor_guarded_keyboard_unit(
                        target, transaction, keycode, modifiers
                    )
                    while True:
                        request = escrow.next_request()
                        if request.get("kind") == "quiet":
                            break
                        request_id = request.get("request_id")
                        if not isinstance(request_id, int) or isinstance(request_id, bool):
                            raise ToolError("clipboard escrow returned an invalid request identifier")
                        assert_clipboard_scope()
                        checkpoint(f"clipboard-request-{request_id}")
                        assert_clipboard_scope()
                        escrow.authorization_checkpoints += 1
                        escrow.authorize(request_id)
                        assert_clipboard_scope()
                        checkpoint(f"clipboard-transfer-{request_id}-complete")
                        assert_clipboard_scope()
                        escrow.post_transfer_checkpoints += 1
                    if (
                        escrow.transfers_completed < 1
                        or not escrow.quiet_confirmed
                        or escrow.requests_seen != escrow.requests_announced
                        or escrow.requests_seen != escrow.requests_authorized
                        or escrow.requests_authorized != escrow.transfers_completed
                        or escrow.post_transfer_checkpoints != escrow.transfers_completed
                    ):
                        raise ToolError(
                            "clipboard paste did not complete a fully checkpointed bounded request burst"
                        )
                    escrow.clear()
            except Exception as error:
                escrow_error = error
                raise
            finally:
                if escrow is not None:
                    clipboard_evidence = escrow.evidence()
                    with contextlib.suppress(Exception):
                        self.journal.append(
                            "rich-paste-escrow" if action_name == "desktop_paste" else "clipboard-escrow",
                            action_name,
                            {
                                "target_window_id": target.get("window_id"),
                                "target_launch_id": target.get("launch_id"),
                                "target_scene_member_count": (
                                    len(scene_launch_ids) if scene_launch_ids else None
                                ),
                                "payload_profile": profile,
                                "payload_bytes": len(payload),
                            },
                            clipboard_evidence,
                            error=str(escrow_error) if escrow_error is not None else None,
                        )

        evidence = self._run_keyboard_fence(
            target,
            action_name,
            "clipboard",
            "paste-chord",
            1,
            0.0,
            purpose,
            lambda transaction: transaction.prepare_chord(chord),
            paste,
        )
        if clipboard_evidence is None:
            raise ToolError("clipboard paste completed without an escrow custody receipt")
        evidence["clipboard_escrow"] = clipboard_evidence
        evidence["clipboard_scope"] = "private-workstation-global"
        evidence["clipboard_release"] = "request-gated-bounded-paste-transaction"
        evidence["clipboard_retention"] = "cleared-and-roundtrip-confirmed-before-success"
        evidence["clipboard_payload_profile"] = profile
        evidence["clipboard_payload_storage"] = "read-only-noexec-sealed-anonymous-memfd"
        evidence["clipboard_requester_identity"] = "not-exposed-by-ext-data-control-v1"
        if target.get("scene_launch_ids"):
            evidence["clipboard_launch_mitigation"] = (
                "exact-scene-set-equals-complete-live-managed-domain-before-publication-and-each-transfer"
            )
        elif target.get("launch_id") is not None:
            evidence["clipboard_launch_mitigation"] = (
                "sole-live-managed-launch-before-publication-and-each-transfer"
            )
        else:
            evidence["clipboard_launch_mitigation"] = "private-workstation-trust-domain"
        result = dict(result_metadata)
        result["paste_chord"] = chord
        return result, evidence

    def _fenced_primary_paste(
        self,
        arguments: dict[str, Any],
        target: dict[str, Any],
        route: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        """Paste UTF-8 through Linux PRIMARY selection and one sealed middle click.

        PRIMARY selection is workstation-global and ext-data-control does not
        identify the requesting client. The same launch/scene exclusivity used
        by RichPasteSeal therefore remains mandatory. Unlike a keyboard paste,
        the consequential input is routed by the compositor at an exact pixel:
        FrameLatch and PointerRoute prove the hovered top-level, one complete
        button-2 click is emitted under SeatSeal/TickSeal, and every pending
        data request remains empty until scope, active focus, pointer route, and
        a fresh compositor interval are revalidated. The exact PRIMARY target
        is cleared through a Wayland round trip before success.
        """
        self._require_pointer_healthy()
        self._require_clipboard_healthy()
        if arguments.get("delivery") != "primary-middle-click":
            raise ToolError("PrimaryPasteSeal requires delivery=primary-middle-click")
        if arguments.get("kind") != "text":
            raise ToolError("PrimaryPasteSeal accepts UTF-8 text only")
        payload, profile, metadata = self._normalize_rich_paste_payload(arguments)
        if profile != "text":
            raise ToolError("PrimaryPasteSeal payload profile changed after admission")
        x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        if self.pointer != {"x": x, "y": y}:
            raise ToolError("PrimaryPasteSeal target is not the post-hover latched pointer position")
        self._assert_modified_pointer_target(route, target)

        scene_launch_ids_value = target.get("scene_launch_ids")
        scene_launch_ids = (
            tuple(scene_launch_ids_value)
            if isinstance(scene_launch_ids_value, tuple) and scene_launch_ids_value
            else ()
        )
        scene_id_value = target.get("scene_id") if scene_launch_ids else None
        scene_id = str(scene_id_value) if isinstance(scene_id_value, str) else None
        launch_id_value = target.get("launch_id")
        launch_id = (
            str(launch_id_value)
            if isinstance(launch_id_value, str) and not scene_launch_ids
            else None
        )

        def assert_authority() -> None:
            if scene_launch_ids:
                self._assert_clipboard_scene_exclusive(scene_id, scene_launch_ids)
            elif launch_id is not None:
                self._assert_clipboard_launch_exclusive(launch_id)
            self._assert_keyboard_target(target)
            self._assert_pointer_route(route, 0)

        seal = getattr(self, "compositor_event_seal", None)
        if self.is_wayland and seal is None:
            raise ToolError(
                "birth-pinned compositor event seal is unavailable; PRIMARY paste was withheld"
            )
        ledger = CompositorEventLedger(
            seal,
            f"desktop_paste:primary-release:{str(route.get('route_sha256') or 'unbound')[:20]}",
        )
        pointer_evidence: dict[str, Any] | None = None
        escrow: WaylandClipboardTransaction | None = None
        escrow_error: Exception | None = None
        release_error: Exception | None = None
        previous_sequence: int | None = None

        def seal_interval(
            start_sequence: int,
            end_sequence: int,
            kind: str,
            context: str,
        ) -> None:
            summary = ledger.interval(start_sequence, end_sequence, kind)
            ledger.reject_fatal(summary, context)
            if ledger.has_transition(summary):
                raise PointerRouteTransition(ledger.reason(summary, context))

        try:
            assert_authority()
            with WaylandClipboardTransaction(
                self,
                payload,
                "desktop_paste-primary-paste-seal",
                launch_id,
                profile="text",
                selection="primary",
                scene_id=scene_id,
                scene_launch_ids=scene_launch_ids,
            ) as escrow:
                assert_authority()
                pointer_evidence = self._run_pointer_unit_fence(
                    "desktop_paste",
                    route,
                    [0],
                    "primary-middle-click",
                    0.0,
                    1,
                    lambda _unit: self._dispatch_compositor_guarded_click(
                        route,
                        0,
                        2,
                    ),
                )
                if pointer_evidence.get("final_scene_transition"):
                    raise PointerRouteTransition(
                        "PrimaryPasteSeal target changed during the middle-click; "
                        "selection bytes were not released"
                    )
                assert_authority()
                previous_sequence = ledger.barrier("middle-click-complete")
                while True:
                    request = escrow.next_request()
                    request_sequence = ledger.barrier(
                        "request-quiet" if request.get("kind") == "quiet" else "request-ready"
                    )
                    if previous_sequence is None:
                        raise ToolError(
                            "PrimaryPasteSeal lost its compositor checkpoint before request admission"
                        )
                    seal_interval(
                        previous_sequence,
                        request_sequence,
                        "gap",
                        "compositor target changed while waiting for a PRIMARY selection request",
                    )
                    previous_sequence = request_sequence
                    assert_authority()
                    if request.get("kind") == "quiet":
                        break
                    request_id = request.get("request_id")
                    if not isinstance(request_id, int) or isinstance(request_id, bool):
                        raise ToolError("PRIMARY selection escrow returned an invalid request identifier")
                    escrow.authorization_checkpoints += 1
                    escrow.authorize(request_id)
                    transfer_sequence = ledger.barrier(f"request-{request_id}-transferred")
                    seal_interval(
                        previous_sequence,
                        transfer_sequence,
                        "unit",
                        "compositor target changed while releasing PRIMARY selection bytes",
                    )
                    previous_sequence = transfer_sequence
                    assert_authority()
                    escrow.post_transfer_checkpoints += 1
                if (
                    escrow.transfers_completed < 1
                    or not escrow.quiet_confirmed
                    or escrow.requests_seen != escrow.requests_announced
                    or escrow.requests_seen != escrow.requests_authorized
                    or escrow.requests_authorized != escrow.transfers_completed
                    or escrow.authorization_checkpoints != escrow.transfers_completed
                    or escrow.post_transfer_checkpoints != escrow.transfers_completed
                ):
                    raise ToolError(
                        "PrimaryPasteSeal did not complete a fully checkpointed bounded request burst"
                    )
                if previous_sequence is None:
                    raise ToolError(
                        "PrimaryPasteSeal lost its compositor checkpoint before selection clear"
                    )
                escrow.clear()
                clear_sequence = ledger.barrier("primary-cleared")
                seal_interval(
                    previous_sequence,
                    clear_sequence,
                    "unit",
                    "compositor target changed before PRIMARY selection clear completed",
                )
                previous_sequence = clear_sequence
                assert_authority()
        except Exception as error:
            escrow_error = error
            raise
        finally:
            try:
                release_evidence = ledger.finalize()
            except Exception as error:
                release_error = error
                release_evidence = dict(ledger.evidence)
            escrow_evidence = escrow.evidence() if escrow is not None else None
            combined_evidence = {
                "schema": "sandcodex.primary-paste-seal.v1",
                "enforced": True,
                "delivery": "primary-middle-click",
                "selection": "primary",
                "pointer_route_sha256": route.get("route_sha256"),
                "target_window_id": target.get("window_id"),
                "target_launch_id": target.get("launch_id"),
                "scene_member_count": len(scene_launch_ids) if scene_launch_ids else None,
                "payload_profile": "text",
                "payload_bytes": len(payload),
                "pointer_fence": pointer_evidence,
                "primary_escrow": escrow_evidence,
                "request_release_event_seal": release_evidence,
                "requester_identity": "not-exposed-by-ext-data-control-v1",
                "requester_mitigation": (
                    "exact-scene-set-equals-complete-live-managed-domain"
                    if scene_launch_ids
                    else "sole-live-managed-launch"
                    if launch_id is not None
                    else "private-workstation-trust-domain"
                ),
                "selection_retention": "cleared-and-roundtrip-confirmed-before-success",
                "payload_logged": False,
                "payload_fingerprinted": False,
            }
            with contextlib.suppress(Exception):
                self.journal.append(
                    "primary-paste-seal",
                    "desktop_paste",
                    {
                        "target_window_id": target.get("window_id"),
                        "target_launch_id": target.get("launch_id"),
                        "x": x,
                        "y": y,
                        "payload_bytes": len(payload),
                    },
                    combined_evidence,
                    error=str(escrow_error or release_error) if (escrow_error or release_error) else None,
                )
            if release_error is not None and escrow_error is None:
                raise release_error

        if escrow is None or pointer_evidence is None:
            raise ToolError("PrimaryPasteSeal completed without custody evidence")
        evidence = {
            "schema": "sandcodex.primary-paste-seal.v1",
            "enforced": True,
            "delivery": "primary-middle-click",
            "selection": "primary",
            "pointer_route_sha256": route.get("route_sha256"),
            "target_window_id": target.get("window_id"),
            "target_launch_id": target.get("launch_id"),
            "payload_profile": "text",
            "payload_bytes": len(payload),
            "pointer_fence": pointer_evidence,
            "primary_escrow": escrow.evidence(),
            "request_release_event_seal": ledger.evidence,
            "requester_identity": "not-exposed-by-ext-data-control-v1",
            "selection_retention": "cleared-and-roundtrip-confirmed-before-success",
            "payload_logged": False,
            "payload_fingerprinted": False,
        }
        return {
            "pasted": True,
            **metadata,
            "delivery": "primary-middle-click",
            "button": 2,
            "x": x,
            "y": y,
        }, evidence

    def _fenced_rich_paste(
        self,
        arguments: dict[str, Any],
        target: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        if arguments.get("delivery", "clipboard-chord") != "clipboard-chord":
            raise ToolError("RichPasteSeal keyboard path requires delivery=clipboard-chord")
        transfer_kind = arguments.get("kind")
        if transfer_kind not in {"files", "directory"}:
            payload, profile, metadata = self._normalize_rich_paste_payload(arguments)
            return self._fenced_clipboard_payload(
                payload,
                profile,
                target,
                action_name="desktop_paste",
                purpose="desktop_paste-rich-paste-seal",
                paste_chord=arguments.get("paste_chord", "CTRL+V"),
                result_metadata={
                    "pasted": True,
                    **metadata,
                    "delivery": "clipboard-chord",
                },
            )

        scene_launch_ids_value = target.get("scene_launch_ids")
        scene_launch_ids = (
            tuple(scene_launch_ids_value)
            if isinstance(scene_launch_ids_value, tuple) and scene_launch_ids_value
            else ()
        )
        launch_id_value = target.get("launch_id")
        if scene_launch_ids or not isinstance(launch_id_value, str):
            raise ToolError(
                "file and directory paste require one exact launch-scoped observation; "
                "workstation and scene-set destinations are intentionally denied"
            )
        launch_id = launch_id_value
        retained_managed = self._managed_by_launch_id(launch_id)
        self._assert_clipboard_launch_exclusive(launch_id)
        transaction_name: str | None = None
        metadata: dict[str, Any] = {}
        directory_transfer = transfer_kind == "directory"
        evidence: dict[str, Any] = {
            "schema": (
                "sandcodex.directory-paste-seal.v1"
                if directory_transfer
                else "sandcodex.file-paste-seal.v1"
            ),
            "file_snapshot_removed_after_failure": None,
            "file_snapshot_reclaimed_by_launch_teardown": False,
            "file_snapshot_launch_quarantined": False,
            "file_snapshot_quarantine_signals": 0,
        }
        try:
            if directory_transfer:
                payload, profile, metadata, transaction_name = (
                    self._prepare_directory_drop_payload(
                        arguments,
                        launch_id,
                        transaction_prefix="clip",
                    )
                )
            else:
                payload, profile, metadata, transaction_name = self._prepare_file_drop_payload(
                    arguments,
                    launch_id,
                    transaction_prefix="clip",
                )
            self._assert_clipboard_launch_exclusive(launch_id)
            result, clipboard_evidence = self._fenced_clipboard_payload(
                payload,
                profile,
                target,
                action_name="desktop_paste",
                purpose=(
                    "desktop_paste-directory-paste-seal"
                    if directory_transfer
                    else "desktop_paste-file-paste-seal"
                ),
                paste_chord=arguments.get("paste_chord", "CTRL+V"),
                result_metadata={
                    "pasted": True,
                    **metadata,
                    "delivery": "clipboard-chord",
                },
            )
            evidence.update(clipboard_evidence)
            evidence.update({
                (
                    "directory_paste_seal"
                    if directory_transfer
                    else "file_paste_seal"
                ): (
                    "launch-private-recursive-request-gated-directory-uri-v1"
                    if directory_transfer
                    else "launch-private-request-gated-text-uri-list-v1"
                ),
                "file_snapshot_staged": True,
                "file_snapshot_storage": metadata.get("snapshot_storage"),
                "file_snapshot_retention": "exact-launch-lifetime-after-success",
                "file_snapshot_retained_until_launch_exit": True,
                "file_snapshot_transaction_kind": "clipboard-paste",
                "source_paths_logged": False,
                "payload_logged": False,
                "payload_fingerprinted": False,
            })
            result["file_snapshot_retained_until_launch_exit"] = True
            return result, evidence
        except Exception as primary_error:
            if transaction_name is not None:
                cleanup_failure = self._cleanup_failed_file_transfer(
                    retained_managed,
                    launch_id,
                    transaction_name,
                    int(metadata.get("source_bytes", 0)),
                    evidence,
                    quarantine_reason="failed-paste-transaction-cleanup-unproved",
                    failure_label=(
                        "DirectoryPasteSeal" if directory_transfer else "FilePasteSeal"
                    ),
                )
                with contextlib.suppress(Exception):
                    self.journal.append(
                        (
                            "directory-paste-seal-cleanup"
                            if directory_transfer
                            else "file-paste-seal-cleanup"
                        ),
                        "desktop_paste",
                        {
                            "launch_id": launch_id,
                            "file_count": metadata.get("file_count"),
                            "directory_count": metadata.get("directory_count"),
                            "entry_count": metadata.get("entry_count"),
                            "source_bytes": metadata.get("source_bytes"),
                        },
                        evidence,
                        error=str(cleanup_failure or primary_error),
                    )
                if cleanup_failure is not None:
                    raise cleanup_failure from primary_error
            raise

    def _fenced_drop(
        self,
        arguments: dict[str, Any],
        route: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        """Perform one genuine compositor-mediated copy drag under DropSeal."""
        self._require_pointer_healthy()
        self._require_clipboard_healthy()
        target_x = as_int(arguments.get("x"), 0, self.width - 1, "x")
        target_y = as_int(arguments.get("y"), 0, self.height - 1, "y")
        duration = as_number(arguments.get("duration", 0.5), 0.0, 10.0, "duration")
        corners = {
            "tl": (DROP_AGENT_ORIGIN_SIZE // 2, DROP_AGENT_ORIGIN_SIZE // 2),
            "tr": (self.width - DROP_AGENT_ORIGIN_SIZE // 2, DROP_AGENT_ORIGIN_SIZE // 2),
            "bl": (DROP_AGENT_ORIGIN_SIZE // 2, self.height - DROP_AGENT_ORIGIN_SIZE // 2),
            "br": (
                self.width - DROP_AGENT_ORIGIN_SIZE // 2,
                self.height - DROP_AGENT_ORIGIN_SIZE // 2,
            ),
        }
        corner = max(
            sorted(corners),
            key=lambda value: (
                (corners[value][0] - target_x) ** 2 + (corners[value][1] - target_y) ** 2,
                value,
            ),
        )
        origin_x, origin_y = corners[corner]
        drag_arguments = {
            "start_x": origin_x,
            "start_y": origin_y,
            "end_x": target_x,
            "end_y": target_y,
            "duration": duration,
            "waypoints": arguments.get("waypoints", []),
        }
        points = self._drag_points(drag_arguments)
        if len(points) < 2:
            raise ToolError("DropSeal origin and target require a non-empty drag path")

        scene_launch_ids_value = route.get("scene_launch_ids")
        scene_launch_ids = (
            tuple(scene_launch_ids_value)
            if isinstance(scene_launch_ids_value, tuple) and scene_launch_ids_value
            else ()
        )
        scene_id_value = route.get("scene_id") if scene_launch_ids else None
        scene_id = str(scene_id_value) if isinstance(scene_id_value, str) else None
        launch_id_value = route.get("launch_id")
        launch_id = (
            str(launch_id_value)
            if isinstance(launch_id_value, str) and not scene_launch_ids
            else None
        )

        def assert_scope() -> None:
            if scene_launch_ids:
                self._assert_clipboard_scene_exclusive(scene_id, scene_launch_ids)
            elif launch_id is not None:
                self._assert_clipboard_launch_exclusive(launch_id)

        seal = getattr(self, "compositor_event_seal", None)
        if seal is None:
            raise ToolError("birth-pinned compositor event seal is unavailable; DropSeal was withheld")
        ledger = CompositorEventLedger(
            seal, f"desktop_drop:{str(route.get('route_sha256') or 'unbound')[:24]}"
        )
        previous = ledger.barrier("preparation:begin")

        file_drop_transaction: str | None = None
        file_drop_managed: ManagedProcess | None = None
        assert_scope()
        transfer_kind = arguments.get("kind")
        if transfer_kind in {"files", "directory"}:
            if launch_id is None or scene_launch_ids:
                raise ToolError(
                    "native file or directory DropSeal requires one exact launch-scoped observation; "
                    "workstation and scene-set destinations are intentionally denied"
                )
            file_drop_managed = self._managed_by_launch_id(launch_id)
            if transfer_kind == "directory":
                payload, profile, metadata, file_drop_transaction = (
                    self._prepare_directory_drop_payload(
                        arguments, launch_id, transaction_prefix="dnd"
                    )
                )
            else:
                payload, profile, metadata, file_drop_transaction = self._prepare_file_drop_payload(
                    arguments, launch_id, transaction_prefix="dnd"
                )
        else:
            payload, profile, metadata = self._normalize_rich_paste_payload(arguments)

        evidence: dict[str, Any] = {
            "schema": "sandcodex.drop-seal.v3",
            "route_sha256": route.get("route_sha256"),
            "target": [target_x, target_y],
            "origin_corner": corner,
            "origin": [origin_x, origin_y],
            "segments": len(points) - 1,
            "maximum_segment_pixels": POINTER_FENCE_MAX_SEGMENT_PIXELS,
            "copy_action_only": True,
            "payload_kind": profile,
            "payload_bytes": len(payload),
            "payload_logged": False,
            "payload_fingerprinted": False,
            "file_snapshot_staged": file_drop_transaction is not None,
            "file_snapshot_storage": (
                metadata.get("snapshot_storage")
                if file_drop_transaction is not None
                else None
            ),
            "file_snapshot_retention": (
                "exact-launch-lifetime-after-success" if file_drop_transaction is not None else None
            ),
            "file_snapshot_removed_after_failure": None,
            "file_snapshot_launch_quarantined": False,
            "file_snapshot_quarantine_signals": 0,
            "drop_performed": False,
            "transfer_finished": False,
            "pointer_transport": None,
            "drop_transport": None,
            "compositor_event_seal": ledger.evidence,
        }
        audit_arguments = {
            "kind": profile,
            "payload_bytes": len(payload),
            "x": target_x,
            "y": target_y,
            "duration": duration,
            "waypoints": len(arguments.get("waypoints", []) or []),
            "route_sha256": route.get("route_sha256"),
            "launch_id": launch_id,
            "scene_member_count": len(scene_launch_ids) if scene_launch_ids else None,
            "file_count": metadata.get("file_count"),
            "directory_count": metadata.get("directory_count"),
            "entry_count": metadata.get("entry_count"),
            "source_bytes": metadata.get("source_bytes") if profile == "files" else None,
        }
        started = time.monotonic()
        drop: WaylandDropTransaction | None = None
        pointer_transaction: WaylandPointerTransaction | None = None
        primary_error: Exception | None = None
        try:
            self._assert_pointer_route(route, 0)
            assert_scope()
            with WaylandDropTransaction(
                self,
                payload,
                "desktop_drop",
                launch_id,
                profile=profile,
                corner=corner,
                scene_id=scene_id,
                scene_launch_ids=scene_launch_ids,
            ) as drop:
                if drop.origin != (origin_x, origin_y):
                    raise ToolError("DropSeal helper origin does not match the controller plan")
                with WaylandPointerTransaction(self, "desktop_drop") as pointer_transaction:
                    pointer_transaction.motion(origin_x, origin_y)
                    drop.wait_origin()
                    drop.arm()
                    current = ledger.barrier("preparation:end")
                    preparation = ledger.interval(previous, current, "preparation")
                    ledger.reject_fatal(
                        preparation,
                        "compositor environment changed while preparing DropSeal",
                    )
                    previous = current

                    self._assert_pointer_route(route, 0)
                    assert_scope()
                    pointer_transaction.button(1, True)
                    drop.wait_started()
                    current = ledger.barrier("drag-start")
                    start_interval = ledger.interval(previous, current, "held")
                    ledger.reject_fatal(
                        start_interval,
                        "compositor target changed while acquiring the DropSeal drag serial",
                    )
                    previous = current

                    segment_delay = duration / max(1, len(points) - 1)
                    for index, (point_x, point_y) in enumerate(points[1:], start=1):
                        self._assert_pointer_route(route, 0)
                        assert_scope()
                        pointer_transaction.motion(point_x, point_y)
                        drop.ping()
                        current = ledger.barrier(f"held-segment-{index}")
                        interval = ledger.interval(previous, current, "held")
                        ledger.reject_fatal(
                            interval,
                            "compositor target changed during the sealed native drag path",
                        )
                        previous = current
                        if segment_delay > 0 and index < len(points) - 1:
                            time.sleep(min(segment_delay, POINTER_FENCE_MAX_SEGMENT_MILLISECONDS / 1000))

                    if self.pointer != {"x": target_x, "y": target_y}:
                        raise ToolError("DropSeal did not arrive at its exact target coordinate")
                    self._assert_pointer_route(route, 0)
                    assert_scope()
                    drop.wait_target(
                        as_int(
                            arguments.get("timeout_milliseconds", DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS),
                            100,
                            10000,
                            "timeout_milliseconds",
                        )
                    )
                    current = ledger.barrier("target-accepted")
                    target_interval = ledger.interval(previous, current, "held")
                    ledger.reject_fatal(
                        target_interval,
                        "compositor target changed before DropSeal release",
                    )
                    previous = current

                    self._assert_pointer_route(route, 0)
                    assert_scope()
                    pointer_transaction.button(1, False)
                    current = ledger.barrier("button-release")
                    ledger.interval(previous, current, "release")
                    previous = current

                    event_timeout = as_int(
                        arguments.get("timeout_milliseconds", DROP_AGENT_EVENT_TIMEOUT_MILLISECONDS),
                        100,
                        10000,
                        "timeout_milliseconds",
                    )
                    while not drop.finished:
                        event = drop.next_event(event_timeout)
                        kind = event.get("kind")
                        if kind == "request":
                            request_id = event.get("request_id")
                            if not isinstance(request_id, int) or isinstance(request_id, bool):
                                raise ToolError("DropSeal returned a malformed request identifier")
                            self._assert_pointer_route(route, 0)
                            assert_scope()
                            before = ledger.barrier(f"request-{request_id}:authorize")
                            pre_release = ledger.interval(previous, before, "unit")
                            ledger.reject_fatal(
                                pre_release,
                                "compositor scope changed before DropSeal payload authorization",
                            )
                            drop.authorization_checkpoints += 1
                            # The helper itself performs a compositor roundtrip before
                            # checking the target generation and writing any byte.
                            drop.authorize(request_id)
                            after = ledger.barrier(f"request-{request_id}:complete")
                            transfer = ledger.interval(before, after, "unit")
                            ledger.reject_fatal(
                                transfer,
                                "compositor scope changed during DropSeal payload release",
                            )
                            self._assert_pointer_route(route, 0)
                            assert_scope()
                            drop.post_transfer_checkpoints += 1
                            previous = after
                        elif kind == "target":
                            if event.get("valid") is not True:
                                raise ToolError("DropSeal target withdrew MIME or copy-action acceptance")
                            self._assert_pointer_route(route, 0)
                            assert_scope()
                            current = ledger.barrier("target-generation:revalidated")
                            target_update = ledger.interval(previous, current, "unit")
                            ledger.reject_fatal(
                                target_update,
                                "compositor scope changed while revalidating DropSeal target generation",
                            )
                            drop.target_revalidation_checkpoints += 1
                            previous = current
                        elif kind == "dropped":
                            evidence["drop_performed"] = True
                        elif kind == "finished":
                            break
                        elif kind == "cancelled":
                            raise ToolError("native Wayland target cancelled DropSeal")
                        elif kind == "timeout":
                            raise ToolError("native Wayland target did not finish DropSeal in time")
                        else:
                            raise ToolError("DropSeal returned an unknown terminal event")
                    if (
                        not drop.finished
                        or drop.requests_authorized < 1
                        or drop.authorization_checkpoints != drop.requests_authorized
                        or drop.post_transfer_checkpoints != drop.transfers_completed
                    ):
                        raise ToolError("DropSeal did not finish one fully checkpointed transfer burst")
                    evidence["transfer_finished"] = True
                evidence["pointer_transport"] = pointer_transaction.evidence()
                evidence["drop_transport"] = drop.evidence()
        except Exception as error:
            primary_error = error
        finally:
            if pointer_transaction is not None and evidence.get("pointer_transport") is None:
                evidence["pointer_transport"] = pointer_transaction.evidence()
            if drop is not None and evidence.get("drop_transport") is None:
                evidence["drop_transport"] = drop.evidence()
            if (
                file_drop_transaction is not None
                and file_drop_managed is not None
                and primary_error is not None
                and launch_id is not None
            ):
                cleanup_failure = self._cleanup_failed_file_transfer(
                    file_drop_managed,
                    launch_id,
                    file_drop_transaction,
                    int(metadata.get("source_bytes", 0)),
                    evidence,
                    quarantine_reason="failed-drop-transaction-cleanup-unproved",
                    failure_label=(
                        "DirectoryDropSeal"
                        if transfer_kind == "directory"
                        else "FileDropSeal"
                    ),
                )
                if cleanup_failure is not None:
                    primary_error = cleanup_failure
            with contextlib.suppress(Exception):
                current = ledger.barrier("cleanup:end")
                ledger.interval(previous, current, "cleanup")
            evidence["compositor_event_seal"] = ledger.finalize()
            evidence["elapsed_milliseconds"] = round((time.monotonic() - started) * 1000, 3)
            evidence["pointer_controller_quarantined"] = bool(self.pointer_quarantined)
            self.journal.append(
                "drop-seal",
                "desktop_drop",
                audit_arguments,
                evidence,
                error=str(primary_error) if primary_error is not None else None,
            )
        if primary_error is not None:
            raise primary_error
        return {
            "dropped": True,
            **metadata,
            "x": target_x,
            "y": target_y,
            "origin_corner": corner,
            "segments": len(points) - 1,
            "action": "copy",
            "mime": evidence.get("drop_transport", {}).get("target_mime"),
            "file_snapshot_retained_until_launch_exit": profile == "files",
        }, evidence

    def _fenced_type_text(
        self,
        arguments: dict[str, Any],
        target: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        text = as_string(arguments.get("text"), "text")
        interval = as_number(arguments.get("interval", 0.01), 0.0, 2.0, "interval")
        method = arguments.get("method", "auto")
        if method not in {"auto", "keys", "input-method", "clipboard"}:
            raise ToolError("method must be auto, keys, input-method, or clipboard")
        key_budget_ok = (
            len(text) <= MAX_SYNTHETIC_CHARACTERS
            and max(0, len(text) - 1) * interval <= MAX_ACTION_SECONDS
            and WaylandKeyboardTransaction.can_prepare_characters(text)
        )
        if method == "keys" and not key_budget_ok:
            raise ToolError("synthetic keyboard input exceeds the character or action-duration limit")

        def run_keys() -> tuple[dict[str, Any], dict[str, Any]]:
            def dispatch(
                transaction: WaylandKeyboardTransaction,
                index: int,
                _checkpoint: Callable[[str], None],
            ) -> None:
                keycode, modifiers = transaction.plan_character(text[index])
                self._dispatch_compositor_guarded_keyboard_unit(
                    target, transaction, keycode, modifiers
                )

            evidence = self._run_keyboard_fence(
                target,
                "desktop_type",
                "keys",
                "unicode-codepoint",
                len(text),
                interval,
                "desktop_type-keys",
                lambda transaction: transaction.prepare_characters(text),
                dispatch,
            )
            return {
                "typed": True,
                "method": "keys",
                "characters": len(text),
            }, evidence

        def run_input_method() -> tuple[dict[str, Any], dict[str, Any]]:
            payload = text.encode("utf-8")
            if "\x00" in text:
                raise ToolError("native input-method text cannot contain NUL")
            chunk_ranges = WaylandInputMethodTransaction._build_chunk_ranges(payload)
            if len(chunk_ranges) > INPUT_METHOD_AGENT_MAX_COMMITS:
                raise ToolError("native input-method payload exceeds the bounded commit count")

            def prepare(transaction: WaylandInputMethodTransaction) -> None:
                transaction.wait_active()

            def dispatch(
                transaction: WaylandInputMethodTransaction,
                index: int,
                _checkpoint: Callable[[str], None],
            ) -> None:
                transaction.commit_chunk(index)

            evidence = self._run_keyboard_fence(
                target,
                "desktop_type",
                "input-method",
                "utf8-commit-chunk",
                len(chunk_ranges),
                0.0,
                "desktop_type-input-method",
                prepare,
                dispatch,
                transaction_factory=(
                    lambda controller, purpose: WaylandInputMethodTransaction(
                        controller, text, purpose
                    )
                ),
                preparation_ready=lambda transaction: bool(
                    transaction.preparation_completed and transaction.active
                ),
                preparation_evidence_key="input_method_active_before_focus_checks",
                transport_evidence_key="input_method_transport",
                virtual_device_lifecycle=False,
                journal_kind="input-method-fence",
            )
            evidence["text_delivery"] = "zwp_input_method_v2.commit_string"
            evidence["activation_gate"] = "application-text-input-activate+done"
            evidence["serial_gate"] = "exact-number-of-done-events"
            evidence["clipboard_touched"] = False
            evidence["synthetic_keymap_used"] = False
            evidence["fallback_after_commit"] = False
            return {
                "typed": True,
                "method": "input-method",
                "characters": len(text),
                "bytes": len(payload),
                "commit_chunks": len(chunk_ranges),
            }, evidence

        if method == "keys":
            return run_keys()
        if method == "input-method":
            return run_input_method()
        if method == "auto" and text:
            try:
                return run_input_method()
            except InputMethodUnavailable:
                # WAIT_ACTIVE is completed before the first commit unit.  This
                # is therefore the only safe automatic fallback point: no text
                # has been submitted and no ambiguous commit can be replayed.
                pass
        if method == "auto" and key_budget_ok:
            return run_keys()
        # Explicit clipboard, or automatic fallback after a proven inactive
        # text-input context and an unavailable bounded synthetic-key path.
        payload = text.encode("utf-8")
        return self._fenced_clipboard_payload(
            payload,
            "text",
            target,
            action_name="desktop_type",
            purpose="desktop_type-clipboard",
            paste_chord=arguments.get("paste_chord", "CTRL+V"),
            result_metadata={
                "typed": True,
                "method": "clipboard",
                "characters": len(text),
            },
        )

    def _fenced_key(
        self,
        arguments: dict[str, Any],
        target: dict[str, Any],
    ) -> tuple[dict[str, Any], dict[str, Any]]:
        value = arguments.get("chord")
        if isinstance(value, str):
            chords = [value]
        elif isinstance(value, list) and value and all(isinstance(item, str) for item in value):
            chords = value
        else:
            raise ToolError("chord must be a string or non-empty string array")
        if len(chords) > 128:
            raise ToolError("too many chords")
        interval = as_number(arguments.get("interval", 0.05), 0.0, 2.0, "interval")
        repeat = as_int(arguments.get("repeat", 1), 1, 100, "repeat")
        actions = len(chords) * repeat
        if actions > 1024 or max(0, actions - 1) * interval > MAX_ACTION_SECONDS:
            raise ToolError("key sequence exceeds the count or action-duration limit")

        def dispatch(
            transaction: WaylandKeyboardTransaction,
            index: int,
            _checkpoint: Callable[[str], None],
        ) -> None:
            keycode, modifiers = transaction.plan_chord(
                chords[index % len(chords)]
            )
            self._dispatch_compositor_guarded_keyboard_unit(
                target, transaction, keycode, modifiers
            )

        evidence = self._run_keyboard_fence(
            target,
            "desktop_key",
            "keys",
            "chord",
            actions,
            interval,
            "desktop_key",
            lambda transaction: transaction.prepare_chords(chords),
            dispatch,
        )
        return {"pressed": chords, "repeat": repeat}, evidence

    @staticmethod
    def _normalize_copy_chord(value: Any) -> str:
        chord = as_string(value, "chord", maximum=64, allow_empty=False)
        tokens = [token.strip().upper() for token in chord.split("+") if token.strip()]
        if not tokens:
            raise ToolError("copy chord is empty")
        modifiers: set[str] = set()
        key: str | None = None
        for token in tokens:
            if token == "CONTROL":
                token = "CTRL"
            if token in {"CTRL", "SHIFT"}:
                if token in modifiers:
                    raise ToolError("copy chord contains a duplicate modifier")
                modifiers.add(token)
            elif key is None:
                key = token
            else:
                raise ToolError("copy chord may contain only one non-modifier key")
        if key is None:
            raise ToolError("copy chord requires a non-modifier key")
        if modifiers == {"CTRL"} and key == "C":
            canonical = "CTRL+C"
        elif modifiers == {"CTRL"} and key == "INSERT":
            canonical = "CTRL+INSERT"
        elif modifiers == {"CTRL", "SHIFT"} and key == "C":
            canonical = "CTRL+SHIFT+C"
        else:
            raise ToolError(
                "copy chord must be CTRL+C, CTRL+INSERT, or CTRL+SHIFT+C"
            )
        if canonical not in SELECTION_AGENT_COPY_CHORDS:
            raise ToolError("copy chord is outside the RichCopySeal allowlist")
        return canonical

    def _normalize_copy_spec(self, arguments: dict[str, Any]) -> dict[str, Any]:
        kind = arguments.get("kind", "text")
        if kind not in {"text", "png", "files", "directory", "watch", "changes"}:
            raise ToolError(
                "copy kind must be text, png, files, directory, watch, or changes"
            )
        source = arguments.get("source", "selection")
        if source not in {"selection", "launch-output"}:
            raise ToolError("copy source must be selection or launch-output")
        if source == "selection" and kind in {"watch", "changes"}:
            raise ToolError("watch and changes require source=launch-output")
        if source == "launch-output" and kind not in {
            "files", "directory", "watch", "changes"
        }:
            raise ToolError(
                "launch-output source is valid only for files, directory, watch, or changes"
            )
        normalized: dict[str, Any] = {"kind": kind, "source": source}
        if source == "selection":
            if (
                arguments.get("source_path") is not None
                or arguments.get("source_paths") is not None
                or arguments.get("watch_token") is not None
            ):
                raise ToolError(
                    "source_path, source_paths, and watch_token require source=launch-output"
                )
            maximum_limit = (
                MAX_TEXT_BYTES if kind == "text"
                else MAX_PNG_PAYLOAD_BYTES if kind == "png"
                else MAX_FILE_COPY_URI_LIST_BYTES
            )
            minimum = MIN_PNG_PAYLOAD_BYTES if kind == "png" else 1
            normalized.update({
                "chord": self._normalize_copy_chord(arguments.get("chord", "CTRL+C")),
                "maximum_bytes": as_int(
                    arguments.get("maximum_bytes", maximum_limit),
                    minimum,
                    maximum_limit,
                    "maximum_bytes",
                ),
                "timeout_milliseconds": as_int(
                    arguments.get(
                        "timeout_milliseconds",
                        SELECTION_AGENT_CAPTURE_TIMEOUT_MILLISECONDS,
                    ),
                    100,
                    10000,
                    "timeout_milliseconds",
                ),
                "quiet_milliseconds": as_int(
                    arguments.get(
                        "quiet_milliseconds",
                        SELECTION_AGENT_QUIET_MILLISECONDS,
                    ),
                    1,
                    1000,
                    "quiet_milliseconds",
                ),
            })
        else:
            if arguments.get("chord") is not None or arguments.get("maximum_bytes") is not None:
                raise ToolError(
                    "launch-output source cannot request a copy chord or selection payload limit"
                )
            if kind in {"files", "directory"}:
                if (
                    arguments.get("watch_token") is not None
                    or arguments.get("timeout_milliseconds") is not None
                    or arguments.get("quiet_milliseconds") is not None
                ):
                    raise ToolError(
                        "explicit launch-output export cannot request watch capability or quiescence options"
                    )
            if kind == "files":
                if arguments.get("source_path") is not None:
                    raise ToolError("kind=files launch-output source requires source_paths")
                values = arguments.get("source_paths")
                if (
                    not isinstance(values, list)
                    or not 1 <= len(values) <= MAX_FILE_COPY_FILES
                ):
                    raise ToolError(
                        "source_paths must contain from one through eight launch-output-relative paths"
                    )
                normalized_paths = [
                    "/".join(
                        self._normalize_launch_output_relative_path(
                            value,
                            f"source_paths[{index}]",
                        )
                    )
                    for index, value in enumerate(values)
                ]
                if len(set(normalized_paths)) != len(normalized_paths):
                    raise ToolError("source_paths contains a duplicate launch-output path")
                normalized["source_paths"] = normalized_paths
            elif kind == "directory":
                if arguments.get("source_paths") is not None:
                    raise ToolError("kind=directory launch-output source requires source_path")
                normalized["source_path"] = "/".join(
                    self._normalize_launch_output_relative_path(
                        arguments.get("source_path"),
                        "source_path",
                    )
                )
            elif kind == "watch":
                if (
                    arguments.get("source_path") is not None
                    or arguments.get("source_paths") is not None
                    or arguments.get("watch_token") is not None
                ):
                    raise ToolError(
                        "kind=watch takes no source path or pre-existing watch capability"
                    )
            elif kind == "changes":
                if (
                    arguments.get("source_path") is not None
                    or arguments.get("source_paths") is not None
                ):
                    raise ToolError(
                        "kind=changes discovers its source set from the watch baseline"
                    )
                raw, canonical = self._decode_output_watch_token(
                    arguments.get("watch_token")
                )
                raw[:] = b"\x00" * len(raw)
                raw.clear()
                normalized["watch_token"] = canonical
            if kind in {"watch", "changes"}:
                normalized["timeout_milliseconds"] = as_int(
                    arguments.get(
                        "timeout_milliseconds",
                        OUTPUT_WATCH_DEFAULT_TIMEOUT_MILLISECONDS,
                    ),
                    100,
                    OUTPUT_WATCH_MAX_TIMEOUT_MILLISECONDS,
                    "timeout_milliseconds",
                )
                normalized["quiet_milliseconds"] = as_int(
                    arguments.get(
                        "quiet_milliseconds",
                        OUTPUT_WATCH_DEFAULT_QUIET_MILLISECONDS,
                    ),
                    1,
                    OUTPUT_WATCH_MAX_QUIET_MILLISECONDS,
                    "quiet_milliseconds",
                )
                if (
                    normalized["quiet_milliseconds"]
                    >= normalized["timeout_milliseconds"]
                ):
                    raise ToolError(
                        "quiet_milliseconds must be smaller than timeout_milliseconds"
                    )

        file_limit_values = (
            arguments.get("maximum_file_bytes"),
            arguments.get("maximum_total_bytes"),
        )
        directory_limit_values = (
            arguments.get("maximum_entries"),
            arguments.get("maximum_directories"),
            arguments.get("maximum_depth"),
        )
        copy_tree_kinds = {"files", "directory", "watch", "changes"}
        if kind not in copy_tree_kinds and any(
            value is not None for value in (*file_limit_values, *directory_limit_values)
        ):
            raise ToolError(
                "file and directory limits are valid only for files, directory, watch, or changes"
            )
        if kind == "files" and any(value is not None for value in directory_limit_values):
            raise ToolError(
                "maximum_entries, maximum_directories, and maximum_depth are not valid for kind=files"
            )
        if kind in copy_tree_kinds:
            total_limit = min(MAX_FILE_COPY_TOTAL_BYTES, self.max_output_bytes)
            normalized["maximum_file_bytes"] = as_int(
                arguments.get(
                    "maximum_file_bytes",
                    min(MAX_FILE_COPY_FILE_BYTES, total_limit),
                ),
                0,
                min(MAX_FILE_COPY_FILE_BYTES, total_limit),
                "maximum_file_bytes",
            )
            normalized["maximum_total_bytes"] = as_int(
                arguments.get("maximum_total_bytes", total_limit),
                0,
                total_limit,
                "maximum_total_bytes",
            )
            if normalized["maximum_file_bytes"] > normalized["maximum_total_bytes"]:
                raise ToolError("maximum_file_bytes cannot exceed maximum_total_bytes")
        if kind in {"directory", "watch", "changes"}:
            normalized["maximum_entries"] = as_int(
                arguments.get("maximum_entries", MAX_DIRECTORY_COPY_ENTRIES),
                0,
                MAX_DIRECTORY_COPY_ENTRIES,
                "maximum_entries",
            )
            normalized["maximum_directories"] = as_int(
                arguments.get("maximum_directories", MAX_DIRECTORY_COPY_DIRECTORIES),
                1,
                MAX_DIRECTORY_COPY_DIRECTORIES,
                "maximum_directories",
            )
            normalized["maximum_depth"] = as_int(
                arguments.get("maximum_depth", MAX_DIRECTORY_COPY_DEPTH),
                0,
                MAX_DIRECTORY_COPY_DEPTH,
                "maximum_depth",
            )
        return normalized

    def _defer_launch_output_snapshot(
        self,
        arguments: dict[str, Any],
        launch_id: str,
    ) -> tuple[dict[str, Any], DeferredFileCopy]:
        """Prepare one explicit launch-output export without a GUI copy chord.

        The caller's path is already inside the exact per-launch output mount;
        no ambient host path is accepted. This method performs only canonical
        argument/path admission and creates a wipe-on-resolution deferred
        envelope. Descriptor traversal and persistent publication remain behind
        the outer dispatch-complete TickSeal in
        ``_publish_file_copy_after_dispatch``.
        """
        spec = self._normalize_copy_spec(arguments)
        if spec.get("source") != "launch-output":
            raise ToolError("OutputSnapshotSeal requires source=launch-output")
        copy_kind = str(spec["kind"])
        if copy_kind == "files":
            values = spec.get("source_paths")
            if not isinstance(values, list):
                raise ToolError("OutputSnapshotSeal lost its normalized source_paths")
            paths = tuple(
                self._normalize_launch_output_relative_path(
                    value,
                    f"source_paths[{index}]",
                )
                for index, value in enumerate(values)
            )
        elif copy_kind == "directory":
            paths = (
                self._normalize_launch_output_relative_path(
                    spec.get("source_path"),
                    "source_path",
                ),
            )
        else:
            raise ToolError("OutputSnapshotSeal supports only files or directory")
        payload = self._launch_output_uri_payload(paths)
        managed, _source_root, _source_identity = self._launch_output_root(launch_id)
        self._assert_file_copy_source_custody(managed.launch_id, "launch-output")
        action_authority_sha256 = self._authority_digest({
            "name": "desktop_copy",
            "arguments": spec,
        })
        deferred = DeferredFileCopy(
            managed.launch_id,
            payload,
            maximum_file_bytes=int(spec["maximum_file_bytes"]),
            maximum_total_bytes=int(spec["maximum_total_bytes"]),
            chord=None,
            copy_kind=copy_kind,
            maximum_entries=int(spec.get("maximum_entries", MAX_DIRECTORY_COPY_ENTRIES)),
            maximum_directories=int(
                spec.get("maximum_directories", MAX_DIRECTORY_COPY_DIRECTORIES)
            ),
            maximum_depth=int(spec.get("maximum_depth", MAX_DIRECTORY_COPY_DEPTH)),
            source_mode="launch-output",
            source_count=len(paths),
            action_authority_sha256=action_authority_sha256,
        )
        evidence = {
            "schema": "sandcodex.output-snapshot-seal.v1",
            "enforced": True,
            "method": "output-snapshot-seal",
            "target_launch_id": managed.launch_id,
            "unit_kind": f"snapshot-{copy_kind}",
            "planned_units": 1,
            "completed_units": 1,
            "keyboard_injection": False,
            "clipboard_selection_used": False,
            "source_path_count": len(paths),
            "source_paths_retained": False,
            "stable_payload_fingerprint_retained": False,
            "output_snapshot_seal": {
                "publication_status": "deferred-until-outer-dispatch-complete",
                "publication_order": "after-action-authority+outer-TickSeal",
                "source_namespace": "exact-launch-private-output-only",
                "source_mode": "launch-output",
                "copy_kind": copy_kind,
                "canonical_path_envelope_bytes": deferred.uri_list_bytes,
                "source_path_count": len(paths),
                "source_paths_retained": False,
                "stable_payload_fingerprint_retained": False,
            },
        }
        return evidence, deferred

