  sc_assert_no_mounts_at_or_below "$venv" 1 "moved Python virtual environment"
  rm -f -- "$marker"
  sc_log_event info moved_venv_invalidated \
    "marked a non-relocatable Python virtual environment for rebuilding"
}

sc_rebind_moved_browser_profile() {
  local old_project="$1" old_key="$2" old_profile old_marker new_profile new_marker singleton socket_target=""
  old_profile="$SC_GLOBAL/browser/profiles/${old_key:0:32}"
  old_marker="$old_profile.owner"
  new_profile="$SC_GLOBAL/browser/profiles/${SC_PROJECT_KEY:0:32}"
  new_marker="$new_profile.owner"
  [[ ! -e "$new_profile" && ! -L "$new_profile" && ! -e "$new_marker" && ! -L "$new_marker" ]] || return 0
  [[ -e "$old_marker" || -L "$old_marker" ]] || return 0
  sc_owned_single_file "$old_marker" 600 "prior browser profile marker"
  grep -Fx "project=$old_project" "$old_marker" >/dev/null || return 0
  grep -Fx "uid=$(id -u)" "$old_marker" >/dev/null || return 0
  if [[ -e "$old_profile" || -L "$old_profile" ]]; then
    sc_no_symlink_components "$old_profile" "prior browser profile"
    sc_owned_dir "$old_profile" "prior browser profile"
    sc_assert_no_mounts_at_or_below "$old_profile" 1 "prior browser profile"
    singleton="$old_profile/SingletonSocket"
    [[ ! -L "$singleton" ]] || socket_target="$(readlink -- "$singleton" 2>/dev/null || true)"
    [[ ! -S "$singleton" && ( "$socket_target" != /* || ! -S "$socket_target" ) ]] || \
      sc_die "the prior project browser profile is still in use"
    rm -f -- "$old_profile/SingletonLock" "$old_profile/SingletonSocket" "$old_profile/SingletonCookie"
    mv -T -- "$old_profile" "$new_profile"
  fi
  printf 'project=%s\nuid=%s\n' "$SC_PROJECT" "$(id -u)" | sc_atomic "$new_marker" 600
  rm -f -- "$old_marker"
}

sc_maybe_rebind_moved_project_state() {
  local marker="$SC_LOCAL/OWNER" old_project old_key expected_key old_control old_lock
  local source_attached=0 lifecycle_fd old_lock_fd
  sc_project_work_marker_matches "$marker" "$SC_PROJECT" "$SC_PROJECT_KEY" && return 0

  [[ "$(sc_marker "$marker" schema)" == "$SC_SCHEMA" && \
    "$(sc_marker "$marker" kind)" == project-work && \
    "$(sc_marker "$marker" uid)" == "$(id -u)" ]] || return 0
  old_project="$(sc_marker "$marker" project)"
  old_key="$(sc_marker "$marker" project_key)"
  [[ "$old_project" == /* && "$old_project" != *$'\n'* && "$old_project" != *$'\r'* && \
    "$old_key" =~ ^[0-9a-f]{64}$ ]] || return 0
  expected_key="$(printf '%s\0' "$old_project" | sha256sum | awk '{print $1}')"
  [[ "$old_key" == "$expected_key" && "$old_project" != "$SC_PROJECT" ]] || return 0

  exec {lifecycle_fd}<"$SC_PROJECT" || sc_die "could not lock the moved project for state recovery"
  "$SC_FLOCK" --exclusive --nonblock "$lifecycle_fd" || \
    sc_die "the moved project is still in use; retry after the active sandbox exits" 75

  old_lock="$SC_GLOBAL/locks/$old_key.lock"
  if [[ -e "$old_lock" || -L "$old_lock" ]]; then
    sc_owned_single_file "$old_lock" "" "prior project operation lock"
    exec {old_lock_fd}<"$old_lock" || sc_die "could not inspect the prior project operation lock"
    "$SC_FLOCK" --exclusive --nonblock "$old_lock_fd" || \
      sc_die "the prior Sandcodex project path still has an active operation; retry after it exits" 75
  fi

  sc_old_project_still_owns_state "$old_project" "$old_key" && source_attached=1
  old_control="$SC_GLOBAL/projects/$old_key"
  if [[ ! -e "$SC_CONTROL" && ! -L "$SC_CONTROL" && \
    -e "$old_control" && ! -L "$old_control" ]] && \
    sc_project_control_marker_matches "$old_control" "$old_project" "$old_key"; then
    sc_no_symlink_components "$old_control" "prior project control state"
    sc_owned_dir "$old_control" "prior project control state"
    sc_assert_no_mounts_at_or_below "$old_control" 1 "prior project control state"
    if (( source_attached )); then
      sc_ensure_dir "$SC_CONTROL" "copied project control state"
      sc_atomic "$SC_CONTROL/OWNER" 600 <<EOF
schema=$SC_SCHEMA
kind=project-control
uid=$(id -u)
project=$SC_PROJECT
project_key=$SC_PROJECT_KEY
EOF
      sc_ensure_dir "$SC_CONTROL/codex-home" "copied project Codex home"
      sc_ensure_dir "$SC_CONTROL/codex-home/sessions" "copied project sessions"
      sc_relocate_codex_sessions "$old_control/codex-home/sessions" \
        "$SC_CONTROL/codex-home/sessions" "$old_project" || true
    else
      mv -T -- "$old_control" "$SC_CONTROL"
      sc_atomic "$SC_CONTROL/OWNER" 600 <<EOF
schema=$SC_SCHEMA
kind=project-control
uid=$(id -u)
project=$SC_PROJECT
project_key=$SC_PROJECT_KEY
EOF
      sc_relocate_codex_sessions "$SC_CONTROL/codex-home/sessions" \
        "$SC_CONTROL/codex-home/sessions" "$old_project" || true
    fi
  elif sc_project_control_marker_matches "$SC_CONTROL" "$old_project" "$old_key"; then
    sc_atomic "$SC_CONTROL/OWNER" 600 <<EOF
schema=$SC_SCHEMA
kind=project-control
uid=$(id -u)
project=$SC_PROJECT
project_key=$SC_PROJECT_KEY
EOF
    sc_relocate_codex_sessions "$SC_CONTROL/codex-home/sessions" \
      "$SC_CONTROL/codex-home/sessions" "$old_project" || true
  elif sc_project_control_marker_matches "$SC_CONTROL" "$SC_PROJECT" "$SC_PROJECT_KEY"; then
    if (( source_attached )); then
      sc_sessions_exist || sc_relocate_codex_sessions "$old_control/codex-home/sessions" \
        "$SC_CONTROL/codex-home/sessions" "$old_project" || true
    else
      sc_relocate_codex_sessions "$SC_CONTROL/codex-home/sessions" \
        "$SC_CONTROL/codex-home/sessions" "$old_project" || true
    fi
  fi

  (( source_attached )) || sc_rebind_moved_browser_profile "$old_project" "$old_key"
  sc_rebind_managed_git_state "$old_project"
  sc_rebind_state_manifest "$SC_LOCAL/STATE-MANIFEST.json" "$old_project"
  sc_rebind_state_manifest "$SC_CONTROL/STATE-MANIFEST.json" "$old_project"
  sc_invalidate_moved_python_venv
  sc_atomic "$marker" 600 <<EOF
schema=$SC_SCHEMA
kind=project-work
uid=$(id -u)
project=$SC_PROJECT
project_key=$SC_PROJECT_KEY
EOF
  sc_log_event info project_state_rebound "re-anchored inactive Sandcodex project state" \
    "old_project=$old_project" "project=$SC_PROJECT" \
    "continuity=$([[ $source_attached == 1 ]] && printf copied || printf moved)"
  sc_note "re-anchored inactive Sandcodex state from $old_project"

  if [[ -n "${old_lock_fd:-}" ]]; then
    "$SC_FLOCK" --unlock "$old_lock_fd"
    exec {old_lock_fd}<&-
  fi
  "$SC_FLOCK" --unlock "$lifecycle_fd"
  exec {lifecycle_fd}<&-
}

sc_prepare_existing_project_state_for_audit() {
  local marker="$SC_LOCAL/OWNER"
  [[ -e "$SC_LOCAL" || -L "$SC_LOCAL" ]] || return 0
  if [[ -L "$SC_LOCAL" || ! -d "$SC_LOCAL" ]]; then
    sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
      "not a real directory"
    return 0
  fi
  sc_no_symlink_components "$SC_LOCAL" "project-local state"
  sc_owned_dir "$SC_LOCAL" "project-local state"
  sc_assert_no_mounts_at_or_below "$SC_LOCAL" 1 "project-local state"
  [[ "$(stat -c %a -- "$SC_LOCAL")" == 700 ]] || sc_private_dir "$SC_LOCAL" "project-local state"
  if [[ ! -f "$marker" || -L "$marker" || \
    "$(stat -c %u -- "$marker" 2>/dev/null || true)" != "$(id -u)" || \
    "$(stat -c %h -- "$marker" 2>/dev/null || true)" != 1 ]]; then
    sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
      "missing or invalid ownership marker"
    return 0
  fi
  [[ "$(stat -c %a -- "$marker")" == 600 ]] || chmod 600 -- "$marker"
  sc_maybe_rebind_moved_project_state
  if ! sc_project_work_marker_matches "$marker" "$SC_PROJECT" "$SC_PROJECT_KEY"; then
    sc_quarantine_project_local_path "$SC_LOCAL" "project-local state" \
      "ownership marker does not match this project"
    return 0
  fi
  sc_validate_project_work_state
}

sc_reclaim_stale_project_scratch_sockets() {
  local root="$SC_WORK/scratch" socket scan identity observed scan_error="" removed=0
  [[ -e "$root" || -L "$root" ]] || return 0
  sc_no_symlink_components "$root" "project scratch"
  sc_owned_dir "$root" "project scratch"
  sc_assert_no_mounts_at_or_below "$root" 1 "project scratch"

  scan="$(mktemp "$SC_GLOBAL/runtime/.scratch-sockets.XXXXXX")"
  if ! find -P "$root" -xdev -type s -print0 >"$scan"; then
    rm -f -- "$scan"
    sc_die "could not inspect Unix sockets in Sandcodex scratch"
  fi
  while IFS= read -r -d '' socket; do
    identity="$(stat -c '%d:%i:%u:%h' -- "$socket" 2>/dev/null || true)"
    if [[ "$identity" != *:"$(id -u)":1 ]]; then
      scan_error="Sandcodex scratch socket is not a single-link user-owned node: $socket"
      break
    fi
    if sc_unix_socket_path_active "$socket"; then
      scan_error="Sandcodex scratch contains an active Unix socket: $socket"
      break
    fi
    observed="$(stat -c '%d:%i:%u:%h' -- "$socket" 2>/dev/null || true)"
    if [[ "$observed" != "$identity" || ! -S "$socket" ]]; then
      scan_error="Sandcodex scratch socket changed during stale-state reclamation: $socket"
      break
    fi
    if ! rm -f -- "$socket"; then
      scan_error="could not reclaim stale Sandcodex scratch socket: $socket"
      break
    fi
    (( removed += 1 ))
    sc_log_event info stale_socket_reclaimed "removed an unreferenced Sandcodex scratch socket" "path=$socket"
  done <"$scan"
  rm -f -- "$scan"
  [[ -z "$scan_error" ]] || sc_die "$scan_error"
  (( removed == 0 )) || sc_note "reclaimed $removed stale Sandcodex scratch socket(s)"
}

sc_project_hygiene() {
  local path metadata key links scan scan_error="" identity observed kind active removed=0

  sc_assert_no_mounts_at_or_below "$SC_PROJECT" 0 project
  if [[ -L "$SC_PROJECT/.git" || ( -e "$SC_PROJECT/.git" && ! -d "$SC_PROJECT/.git" ) ]]; then
    sc_die "safe mode requires project .git metadata to be a real directory inside the selected project"
  fi

  scan="$(mktemp "$SC_GLOBAL/runtime/.project-special.XXXXXX")"
  if ! find -P "$SC_PROJECT" -xdev \
      \( -type b -o -type c -o -type p -o -type s \) -print0 >"$scan"; then
    rm -f -- "$scan"
    sc_die "project special-file scan failed"
  fi
  while IFS= read -r -d '' path; do
    identity="$(stat -c '%d:%i:%u:%h' -- "$path" 2>/dev/null || true)"
    [[ -n "$identity" ]] || continue
    if [[ "$identity" == *:"$(id -u)":1 && ( -S "$path" || -p "$path" ) ]]; then
      active=1
      if [[ -S "$path" ]]; then
        kind=socket
        sc_unix_socket_path_active "$path" || active=0
      else
        kind=FIFO
        sc_fifo_path_active "$path" || active=0
      fi
      if (( active == 0 )); then
        observed="$(stat -c '%d:%i:%u:%h' -- "$path" 2>/dev/null || true)"
        if [[ "$observed" == "$identity" &&
          ( ( "$kind" == socket && -S "$path" ) || ( "$kind" == FIFO && -p "$path" ) ) ]] &&
          rm -f -- "$path"; then
          (( removed += 1 ))
          sc_log_event info stale_project_ipc_reclaimed \
            "removed an inactive ordinary-project IPC pathname" "kind=$kind" "path=$path"
          continue
        fi
        [[ -e "$path" || -L "$path" ]] || continue
        [[ -S "$path" || -p "$path" || -b "$path" || -c "$path" ]] || continue
      fi
    fi
    scan_error="project contains an active or unsafe device, FIFO, or socket: $path (stop its owner or select a project tree that excludes live runtime sockets)"
    break
  done <"$scan"
  rm -f -- "$scan"
  SC_RECLAIMED_PROJECT_IPC=$removed
  (( removed == 0 )) || sc_note "reclaimed $removed stale project IPC node(s)"
  [[ -z "$scan_error" ]] || sc_die "$scan_error"

  scan="$(mktemp "$SC_GLOBAL/runtime/.project-hardlinks.XXXXXX")"
  if ! find -P "$SC_PROJECT" -xdev \
      \( -type f -links +1 -print0 \) >"$scan"; then
    rm -f -- "$scan"
    sc_die "project hardlink scan failed"
  fi
  local -A seen=() expected=() writable=() protected=() sample=()
  while IFS= read -r -d '' path; do
    if ! metadata="$(stat -c '%d:%i %h' -- "$path")"; then
      scan_error="project changed during hardlink scan: $path"
      break
    fi
    key="${metadata%% *}"; links="${metadata##* }"
    if [[ -n "${expected[$key]:-}" && "${expected[$key]}" != "$links" ]]; then
      scan_error="project changed during hardlink scan: $path"
      break
    fi
    expected[$key]="$links"
    (( seen[$key] = ${seen[$key]:-0} + 1 ))
    sample[$key]="$path"
    if sc_project_path_protected "$path"; then
      (( protected[$key] = ${protected[$key]:-0} + 1 ))
    else
      (( writable[$key] = ${writable[$key]:-0} + 1 ))
    fi
  done <"$scan"
  rm -f -- "$scan"
  [[ -z "$scan_error" ]] || sc_die "$scan_error"

  for key in "${!seen[@]}"; do
    (( ${writable[$key]:-0} > 0 )) || continue
    if (( seen[$key] < expected[$key] )); then
      sc_die "project contains a writable hardlink to an outside file: ${sample[$key]}"
    fi
    if (( ${protected[$key]:-0} > 0 )); then
      sc_die "project hardlink bypasses a protected path: ${sample[$key]}"
    fi
  done
  sc_debug "project hygiene verified: stale IPC was reclaimed; ordinary paths contain no active or unsafe special files, nested mounts, or escaping hardlinks"
}

sc_reclaim_stale_project_browser_sockets() {
  local root socket observed
  local glasstty_socket="$SC_LOCAL/work/browser-home/.local/share/glasstty/run/daemon.sock"
  local glasstty_runtime_socket="/run/scg-${SC_PROJECT_KEY:0:32}/run/daemon.sock"
  local -a roots=(
    "$SC_LOCAL/work/browser-home/runtime"
    "$SC_LOCAL/work/browser-home/.local/share/glasstty/run"
  )
  for root in "${roots[@]}"; do
    [[ -e "$root" || -L "$root" ]] || continue
    sc_no_symlink_components "$root" "controlled browser runtime"
    sc_owned_dir "$root" "controlled browser runtime"
    while IFS= read -r -d '' socket; do
      [[ "$(stat -c %u -- "$socket")" == "$(id -u)" ]] || \
        sc_die "controlled browser socket is owned by another uid: $socket"
      observed="$socket"
      [[ "$socket" != "$glasstty_socket" ]] || observed="$glasstty_runtime_socket"
      if awk -v path="$socket" -v alias="$observed" \
        '$NF == path || $NF == alias {found=1} END {exit !found}' /proc/net/unix; then
        sc_die "a prior browser or GlassTTY broker is still active for this project: $socket"
      fi
      rm -f -- "$socket"
      sc_log_event info stale_socket_reclaimed "removed an unreferenced controlled browser socket" "path=$socket"
    done < <(find -P "$root" -xdev -type s -print0)
  done
}

sc_atomic() {
  local target="$1" mode="$2" tmp parent stage_mode
  parent="$(dirname -- "$target")"
  sc_owned_dir "$parent" "atomic-write parent"
  tmp="$(mktemp "$parent/.tmp.$(basename -- "$target").XXXXXX")"
  printf -v stage_mode '%o' "$((8#$mode | 8#200))"
  if ! cat >"$tmp" || ! chmod "$stage_mode" "$tmp" || ! mv -fT -- "$tmp" "$target"; then
    rm -f -- "$tmp"
    return 1
  fi
  if ! chmod "$mode" "$target"; then
    rm -f -- "$target"
    return 1
  fi
}

sc_loop_set_project_paths() {
  local requested="$1" cwd
  [[ "$requested" == /* && -d "$requested" ]] || sc_die "active loop project is invalid" 77
  SC_PROJECT="$(realpath -- "$requested")"
  [[ "$SC_PROJECT" == "$requested" ]] || sc_die "active loop project is not canonical" 77
  cwd="$(pwd -P)"
  [[ "$cwd" == "$SC_PROJECT" || "$cwd" == "$SC_PROJECT"/* ]] || sc_die "loop control must run inside the active project" 77
  SC_LOCAL="$SC_PROJECT/.sandcodex"
  SC_WORK="$SC_LOCAL/work"
  SC_LOOP_ROOT="$SC_WORK/loop"
}

sc_loop_dir_valid() {
  local path="$1" label="$2"
  sc_owned_dir "$path" "$label"
  [[ "$(stat -c %a -- "$path")" == 700 ]] || sc_die "$label permissions must be 0700"
}

sc_loop_dirs_valid() {
  local marker="$SC_LOCAL/OWNER"
  sc_loop_dir_valid "$SC_LOCAL" "project-local state"
  [[ -f "$marker" && ! -L "$marker" && "$(stat -c %u -- "$marker")" == "$(id -u)" && \
    "$(stat -c %a -- "$marker")" == 600 && "$(sc_marker "$marker" schema)" == "$SC_SCHEMA" && \
    "$(sc_marker "$marker" project)" == "$SC_PROJECT" ]] || sc_die "project loop ownership marker is invalid"
  sc_loop_dir_valid "$SC_WORK" "project worker state"
  sc_loop_dir_valid "$SC_LOOP_ROOT" "project loop state"
  sc_loop_dir_valid "$SC_LOOP_ROOT/inbox" "project loop inbox"
  sc_loop_dir_valid "$SC_LOOP_ROOT/acks" "project loop acknowledgements"
}

sc_loop_normalize_turns() {
  [[ "$SC_LOOP_TURNS" =~ ^[0-9]+$ ]] || sc_usage_error "loop turns must be a non-negative integer"
  while [[ ${#SC_LOOP_TURNS} -gt 1 && "$SC_LOOP_TURNS" == 0* ]]; do SC_LOOP_TURNS="${SC_LOOP_TURNS#0}"; done
  [[ ${#SC_LOOP_TURNS} -le 9 ]] || sc_usage_error "loop turns are too large"
}

sc_loop_load_prompt() {
  local bytes path
  if [[ -n "$SC_LOOP_PROMPT_FILE" ]]; then
    sc_no_line_breaks "$SC_LOOP_PROMPT_FILE" "loop prompt file path"
    path="$(realpath -- "$SC_LOOP_PROMPT_FILE" 2>/dev/null || true)"
    [[ -z "$path" ]] || sc_no_line_breaks "$path" "canonical loop prompt file path"
    [[ -n "$path" && -f "$path" && ! -L "$SC_LOOP_PROMPT_FILE" ]] || sc_die "loop prompt file must be a non-symlink regular file"
    [[ "$(stat -c %u -- "$path")" == "$(id -u)" ]] || sc_die "loop prompt file is owned by another uid"
    bytes="$(stat -c %s -- "$path")"
    (( bytes <= SC_LOOP_MESSAGE_MAX )) || sc_die "loop prompt must be $SC_LOOP_MESSAGE_MAX bytes or less" 64
    jq -eRs 'index("\u0000") == null' "$path" >/dev/null || sc_die "loop prompt must not contain NUL bytes" 64
    SC_LOOP_PROMPT="$(<"$path")"
  fi
  if (( ! SC_LOOP_PROMPT_SET )); then SC_LOOP_PROMPT="$SC_LOOP_DEFAULT_PROMPT"; fi
  [[ "$SC_LOOP_PROMPT" =~ [^[:space:]] ]] || sc_die "loop prompt must not be empty" 64
  bytes="$(LC_ALL=C printf '%s' "$SC_LOOP_PROMPT" | wc -c)"
  (( bytes <= SC_LOOP_MESSAGE_MAX )) || sc_die "loop prompt must be $SC_LOOP_MESSAGE_MAX bytes or less" 64
}

sc_loop_state_path() {
  if [[ "${SANDCODEX_ACTIVE:-0}" == 1 ]]; then
    printf '%s/status.json\n' "$SC_LOOP_ROOT"
  else
    printf '%s/loop-state.json\n' "$SC_CONTROL"
  fi
}

sc_loop_read_state() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" ]] || sc_die "no Sandcodex loop state exists for this project"
  [[ "$(stat -c %u -- "$path")" == "$(id -u)" && "$(stat -c %a -- "$path")" == 600 && \
    "$(stat -c %s -- "$path")" -le 8192 ]] || sc_die "loop state is invalid"
  jq -ce --arg schema "$SC_LOOP_SCHEMA" '
    select(type == "object" and .schema == $schema)
    | select((.run_id | type) == "string" and (.run_id | test("^[A-Za-z0-9._:-]{1,160}$")))
    | select((.status | type) == "string")
    | select((.pid | type) == "number" and .pid > 0 and (.pid | floor) == .pid)
    | select(.process_start == null or
        ((.process_start | type) == "string" and (.process_start | test("^[0-9]+$"))))
  ' "$path" 2>/dev/null || sc_die "loop state is invalid"
}

sc_loop_state_process_is_live() {
  local state="$1" pid started current
  pid="$(jq -r '.pid' <<<"$state")"
  started="$(jq -r '.process_start // empty' <<<"$state")"
  [[ "$pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || return 1
  current="$(sc_process_start "$pid" 2>/dev/null || true)"
  [[ -n "$current" && "$current" == "$started" ]]
}

sc_loop_show_status() {
  local state path status
  path="$(sc_loop_state_path)"
  state="$(sc_loop_read_state "$path")"
  if [[ "${SANDCODEX_ACTIVE:-0}" != 1 ]]; then
    status="$(jq -r '.status' <<<"$state")"
    if [[ "$status" == running || "$status" == interactive || "$status" == waiting_quota || \
      "$status" == waiting_transient ]] && ! sc_loop_state_process_is_live "$state"; then
      state="$(jq -c '.status = "stale"' <<<"$state")"
    fi
  fi
  if (( SC_LOOP_JSON )); then
    printf '%s\n' "$state"
  else
    jq -r '
      "sandcodex loop\n"
      + "  status     \(.status)\n"
      + "  posture    \(.posture)\n"
      + "  mode       \(.mode)\n"
      + "  run        \(.run_id)\n"
      + "  turn       \(.current_turn) / \(if .turn_limit == 0 then "unbounded" else (.turn_limit|tostring) end)\n"
      + "  successful \(.successful_turns // 0)\n"
      + "  attempts   \(.attempts // 0) (\(.retry_count // 0) retries)\n"
      + "  error      \(.last_error_class // "none")\n"
      + (if (.next_attempt_at // "") != "" then "  retry at   \(.next_attempt_at)\n" else "" end)
      + "  usage      \((.usage.total_tokens // 0)) tokens\n"
      + "  delegated  \(if .delegated_remaining == -1 then "unbounded" else (.delegated_remaining|tostring) end)\n"
      + "  updated    \(.updated_at)\n"
      + "  next       "
      + (if .status == "running" or .status == "interactive" then
           "sandcodex loop send --message '\''Steering note'\'' · or: sandcodex loop stop"
         elif .status == "waiting_quota" or .status == "waiting_transient" then
           "sandcodex loop status · retry is supervised"
         elif .status == "stale" then
           "sandcodex loop recover"
         else
           "sandcodex --RESUME"
         end)
    ' <<<"$state"
  fi
}

sc_loop_request_target() {
  if [[ "${SANDCODEX_ACTIVE:-0}" == 1 ]]; then
    [[ -n "${SANDCODEX_RUN_ID:-}" && "$SANDCODEX_RUN_ID" =~ ^[A-Za-z0-9._:-]{1,160}$ ]] || sc_die "active loop run identity is missing" 77
    printf '%s\n' "$SANDCODEX_RUN_ID"
    return
  fi
  local state status
  state="$(sc_loop_read_state "$SC_CONTROL/loop-state.json")"
  status="$(jq -r '.status' <<<"$state")"
  [[ "$status" == running || "$status" == interactive || "$status" == waiting_quota || \
    "$status" == waiting_transient ]] || sc_die "the latest Sandcodex run is not accepting loop control"
  if ! sc_loop_state_process_is_live "$state"; then
    sc_die "the recorded Sandcodex loop is no longer running"
  fi
  jq -r '.run_id' <<<"$state"
}

sc_loop_queue_request() {
  local action="$1" target id tmp bytes posture=safe count
  sc_loop_dirs_valid
  sc_loop_normalize_turns
  if [[ "${SANDCODEX_ACTIVE:-0}" == 1 && $SC_BARE -eq 1 && "${SANDCODEX_BARE_METAL:-0}" != 1 ]]; then
    sc_die "an active safe sandbox cannot promote loop control to BARE-METAL" 77
  fi
  if [[ "$action" == continue || "$action" == send ]]; then
    sc_loop_load_prompt
  elif (( SC_LOOP_PROMPT_SET )); then
    sc_usage_error "loop $action does not accept a prompt"
  fi
  if [[ "$action" == send ]]; then
    SC_LOOP_TURNS=0
  elif [[ "$action" == stop ]]; then
    SC_LOOP_TURNS=0; SC_LOOP_PROMPT=""
  fi
  [[ "${SANDCODEX_BARE_METAL:-0}" != 1 ]] || posture=bare-metal
  target="$(sc_loop_request_target)"
  count="$(find "$SC_LOOP_ROOT/inbox" -mindepth 1 -maxdepth 1 -type f -printf '.\n' | wc -l)"
  (( count < 64 )) || sc_die "loop control inbox is full"
  id="${target}:$(date -u +%Y%m%dT%H%M%S):$$:$(printf '%06x' "$(( RANDOM * RANDOM % 16777216 ))")"
  bytes="$(LC_ALL=C printf '%s' "$SC_LOOP_PROMPT" | wc -c)"
  tmp="$(mktemp "$SC_LOOP_ROOT/inbox/.request.XXXXXX")"
  jq -cn \
    --arg schema "$SC_LOOP_REQUEST_SCHEMA" --arg id "$id" --arg target_run_id "$target" \
    --arg action "$action" --arg message "$SC_LOOP_PROMPT" --arg posture "$posture" \
    --arg created_at "$(sc_now)" --argjson turns "$SC_LOOP_TURNS" --argjson message_bytes "$bytes" \
    '{schema:$schema,id:$id,target_run_id:$target_run_id,action:$action,turns:$turns,
      message:(if $action == "stop" then null else $message end),message_bytes:$message_bytes,
      requested_from_posture:$posture,created_at:$created_at}' >"$tmp"
  chmod 600 "$tmp"
  mv -fT -- "$tmp" "$SC_LOOP_ROOT/inbox/$id.json"
  if (( SC_LOOP_JSON )); then
    jq -cn --arg schema "$SC_LOOP_REQUEST_SCHEMA" --arg id "$id" --arg action "$action" \
      --arg target_run_id "$target" --argjson turns "$SC_LOOP_TURNS" \
      '{schema:$schema,status:"queued",id:$id,action:$action,target_run_id:$target_run_id,turns:$turns}'
  else
    sc_ok "loop $action queued · turns $SC_LOOP_TURNS · request $id"
  fi
}

sc_loop_control_dispatch() {
  if (( SC_NETWORK_EXPLICIT || SC_BROWSER_EXPLICIT || SC_TRUST_PROJECT || SC_MODEL_SET || SC_EFFORT_SET || \
    SC_LOOP_AUTO_RESUME_EXPLICIT || SC_LOOP_DETACH || SC_LOOP_RECOVER_ON_BOOT || SC_AGENT_POLICY_EXPLICIT || \
    SC_LOOP_RETRY_LIMIT != SC_LOOP_RETRY_LIMIT_DEFAULT || SC_LOOP_RETRY_BASE_SECONDS != SC_LOOP_RETRY_BASE_SECONDS_DEFAULT || \
    SC_LOOP_RETRY_MAX_SECONDS != SC_LOOP_RETRY_MAX_SECONDS_DEFAULT || SC_LOOP_RETRY_MAX_WAIT_SECONDS != SC_LOOP_RETRY_MAX_WAIT_SECONDS_DEFAULT || \
    SC_LOOP_MIN_FREE_MIB != SC_LOOP_MIN_FREE_MIB_DEFAULT || SC_LOOP_MAX_PROJECT_GROWTH_MIB != SC_LOOP_MAX_PROJECT_GROWTH_MIB_DEFAULT || \
    SC_LOOP_MAX_DOWNLOADS_MIB != SC_LOOP_MAX_DOWNLOADS_MIB_DEFAULT || SC_LOOP_MAX_PROFILE_MIB != SC_LOOP_MAX_PROFILE_MIB_DEFAULT || \
    ${#SC_DOMAINS[@]} || ${#SC_CODEX_ARGS[@]} )) || [[ "$SC_RESUME" != fresh ]]; then
    sc_die "loop control requests cannot change provider or sandbox options" 64
  fi
  case "$SC_LOOP_ACTION" in
    status) [[ "${SANDCODEX_ACTIVE:-0}" != 1 ]] || sc_loop_dirs_valid; sc_loop_show_status ;;
    stop) sc_loop_queue_request stop ;;
    send) (( SC_LOOP_PROMPT_SET )) || sc_usage_error "loop send requires --message or --message-file"; sc_loop_queue_request send ;;
    run) sc_loop_queue_request continue ;;
    recover) sc_die "loop recovery is a host-only supervisor action" 77 ;;
    *) sc_die "internal loop control action error" ;;
  esac
}

sc_loop_remove_entry() {
  local path="$1"
  if [[ -d "$path" && ! -L "$path" ]]; then
    rmdir -- "$path" 2>/dev/null || sc_die "refusing to traverse a nonempty loop control directory"
  else
    rm -f -- "$path" 2>/dev/null || sc_die "refusing to remove a mounted loop control entry"
  fi
}

sc_loop_reset_requests() {
  local path
  sc_loop_dirs_valid
  while IFS= read -r -d '' path; do sc_loop_remove_entry "$path"; done \
    < <(find "$SC_LOOP_ROOT/inbox" "$SC_LOOP_ROOT/acks" -mindepth 1 -maxdepth 1 -print0)
}

sc_loop_write_state() {
  local state posture=safe public="$SC_LOOP_ROOT/status.json" supervisor_unit="${SANDCODEX_SUPERVISOR_UNIT:-}"
  local supervisor_id="${SANDCODEX_SUPERVISOR_ID:-}"
  (( ! SC_BARE )) || posture=bare-metal
  state="$(jq -cn \
    --arg schema "$SC_LOOP_SCHEMA" --arg run_id "$SC_RUN_ID" --arg status "$SC_LOOP_STATUS" \
    --arg posture "$posture" --arg mode "$SC_LOOP_MODE" --arg started_at "$SC_LOOP_STARTED_AT" \
    --arg updated_at "$(sc_now)" --arg process_start "$SC_PROCESS_START" \
    --arg last_error_class "$SC_LOOP_LAST_ERROR_CLASS" --arg next_attempt_at "$SC_LOOP_NEXT_ATTEMPT_AT" \
    --arg session_id "$SC_LOOP_SESSION_ID" --arg supervisor_unit "$supervisor_unit" \
    --arg supervisor_id "$supervisor_id" --arg model "$SC_MODEL" \
    --argjson pid "$$" --argjson current_turn "$SC_LOOP_CURRENT_TURN" \
    --argjson turn_limit "$SC_LOOP_TURN_LIMIT" --argjson remaining "$SC_LOOP_REMAINING" \
    --argjson delegated_remaining "$SC_LOOP_DELEGATED_REMAINING" --argjson last_exit "$SC_LOOP_LAST_EXIT" \
    --argjson successful_turns "$SC_LOOP_SUCCESSFUL_TURNS" --argjson attempts "$SC_LOOP_ATTEMPTS" \
    --argjson retry_count "$SC_LOOP_RETRY_COUNT" --argjson duration "$SC_LOOP_TOTAL_DURATION_SECONDS" \
    --argjson input_tokens "$SC_LOOP_INPUT_TOKENS" --argjson cached_input_tokens "$SC_LOOP_CACHED_INPUT_TOKENS" \
    --argjson output_tokens "$SC_LOOP_OUTPUT_TOKENS" --argjson usage_reported "$SC_LOOP_USAGE_REPORTED" \
    '{schema:$schema,run_id:$run_id,pid:$pid,process_start:$process_start,
      status:$status,posture:$posture,mode:$mode,
      current_turn:$current_turn,turn_limit:$turn_limit,remaining:$remaining,
      delegated_remaining:$delegated_remaining,last_exit:$last_exit,
      successful_turns:$successful_turns,attempts:$attempts,retry_count:$retry_count,
      last_error_class:$last_error_class,next_attempt_at:(if $next_attempt_at == "" then null else $next_attempt_at end),
      total_duration_seconds:$duration,model:(if $model == "" then null else $model end),
      session_id:(if $session_id == "" then null else $session_id end),
      supervisor_unit:(if $supervisor_unit == "" then null else $supervisor_unit end),
      supervisor_id:(if $supervisor_id == "" then null else $supervisor_id end),
      usage:{reported:($usage_reported == 1),input_tokens:$input_tokens,
        cached_input_tokens:$cached_input_tokens,output_tokens:$output_tokens,
        total_tokens:($input_tokens + $output_tokens)},
      started_at:$started_at,updated_at:$updated_at}')"
  printf '%s\n' "$state" | sc_atomic "$SC_CONTROL/loop-state.json" 600
  [[ ! -e "$public" && ! -L "$public" ]] || sc_loop_remove_entry "$public"
  printf '%s\n' "$state" | sc_atomic "$public" 600
}

sc_loop_ack() {
  local request="$1" id="$2" status="$3" detail="$4" tmp
  rm -f -- "$request"
  tmp="$(mktemp "$SC_LOOP_ROOT/acks/.ack.XXXXXX")"
  jq -cn --arg schema "$SC_LOOP_SCHEMA" --arg id "$id" --arg status "$status" \
    --arg detail "$detail" --arg acknowledged_at "$(sc_now)" \
    '{schema:$schema,id:$id,status:$status,detail:$detail,acknowledged_at:$acknowledged_at}' >"$tmp"
  chmod 600 "$tmp"
  [[ ! -e "$SC_LOOP_ROOT/acks/$id.json" && ! -L "$SC_LOOP_ROOT/acks/$id.json" ]] || \
    sc_loop_remove_entry "$SC_LOOP_ROOT/acks/$id.json"
  mv -fT -- "$tmp" "$SC_LOOP_ROOT/acks/$id.json"
}

sc_loop_reject_request() {
  local request="$1" detail="$2"
  sc_loop_remove_entry "$request"
  sc_log_event warn loop_request_rejected "rejected project-local loop request" "reason=$detail"
}

sc_loop_add_control_prompt() {
  local message="$1"
  SC_LOOP_CONTROL_PROMPT+=$'\n\n## Sandcodex turn-boundary message\n'
  SC_LOOP_CONTROL_PROMPT+="$message"
}

sc_loop_consume_requests() {
  local request doc id target action turns message grant detail owner mode links size
  sc_loop_dirs_valid
  for request in "$SC_LOOP_ROOT/inbox"/*.json; do
    [[ -e "$request" || -L "$request" ]] || continue
    if [[ ! -f "$request" || -L "$request" ]]; then sc_loop_reject_request "$request" not-regular; continue; fi
    owner="$(stat -c %u -- "$request")"; mode="$(stat -c %a -- "$request")"
    links="$(stat -c %h -- "$request")"; size="$(stat -c %s -- "$request")"
    if [[ "$owner" != "$(id -u)" || "$mode" != 600 || "$links" != 1 || "$size" -gt 20000 ]]; then sc_loop_reject_request "$request" invalid-metadata; continue; fi
    doc="$(jq -ce --arg schema "$SC_LOOP_REQUEST_SCHEMA" '
      select(type == "object" and .schema == $schema)
      | select((.id | type) == "string" and (.id | test("^[A-Za-z0-9._:-]{1,240}$")))
      | select((.target_run_id | type) == "string" and (.target_run_id | test("^[A-Za-z0-9._:-]{1,160}$")))
      | select(.action == "continue" or .action == "send" or .action == "stop")
      | select((.turns | type) == "number" and .turns >= 0 and .turns <= 999999999 and (.turns | floor) == .turns)
      | select(if .action == "stop" then .message == null else ((.message | type) == "string" and (.message | length) > 0 and (.message | utf8bytelength) <= 16384 and (.message | index("\u0000")) == null) end)
    ' "$request" 2>/dev/null)" || { sc_loop_reject_request "$request" invalid-json; continue; }
    id="$(jq -r '.id' <<<"$doc")"; target="$(jq -r '.target_run_id' <<<"$doc")"
    [[ "$(basename -- "$request")" == "$id.json" ]] || { sc_loop_reject_request "$request" id-mismatch; continue; }
    if [[ "$target" != "$SC_RUN_ID" ]]; then sc_loop_ack "$request" "$id" expired wrong-run; continue; fi
    action="$(jq -r '.action' <<<"$doc")"; turns="$(jq -r '.turns' <<<"$doc")"; message="$(jq -r '.message // ""' <<<"$doc")"
    case "$action" in
      stop)
        SC_LOOP_STOP=1; sc_loop_ack "$request" "$id" accepted drain-after-current-turn
        ;;
      send)
        if (( SC_LOOP_REMAINING == 0 )) && [[ "$SC_LOOP_STATUS" != waiting_quota && \
          "$SC_LOOP_STATUS" != waiting_transient ]]; then
          sc_loop_ack "$request" "$id" rejected no-next-turn
        else
          sc_loop_add_control_prompt "$message"; sc_loop_ack "$request" "$id" accepted next-turn
        fi
        ;;
      continue)
        grant=0
        if (( SC_LOOP_DELEGATED_REMAINING == -1 )); then
          if (( turns == 0 )); then SC_LOOP_REMAINING=-1; grant=-1; else grant=$turns; fi
        elif (( SC_LOOP_DELEGATED_REMAINING > 0 && turns > 0 )); then
          grant=$turns
          (( grant <= SC_LOOP_DELEGATED_REMAINING )) || grant=$SC_LOOP_DELEGATED_REMAINING
          (( SC_LOOP_DELEGATED_REMAINING -= grant ))
        fi
        if (( grant == -1 )); then
          SC_LOOP_REPEAT_PROMPT="$message"; SC_LOOP_TURN_LIMIT=0; detail=granted-unbounded
          sc_loop_ack "$request" "$id" accepted "$detail"
        elif (( grant > 0 )); then
          (( SC_LOOP_REMAINING == -1 )) || (( SC_LOOP_REMAINING += grant ))
          (( SC_LOOP_TURN_LIMIT == 0 )) || (( SC_LOOP_TURN_LIMIT += grant ))
          SC_LOOP_REPEAT_PROMPT="$message"; detail="granted-$grant"
          sc_loop_ack "$request" "$id" accepted "$detail"
        elif (( SC_LOOP_REMAINING != 0 )); then
          sc_loop_add_control_prompt "$message"
          sc_loop_ack "$request" "$id" accepted existing-budget-message
        else
          sc_loop_ack "$request" "$id" rejected delegated-budget-exhausted
        fi
        ;;
    esac
  done
}

sc_campaign_set_project_paths() {
  local requested="$1" cwd
  [[ "$requested" == /* && -d "$requested" ]] || sc_die "active campaign project is invalid" 77
  SC_PROJECT="$(realpath -- "$requested")"
  [[ "$SC_PROJECT" == "$requested" ]] || sc_die "active campaign project is not canonical" 77
  cwd="$(pwd -P)"
  [[ "$cwd" == "$SC_PROJECT" || "$cwd" == "$SC_PROJECT"/* ]] || \
    sc_die "campaign control must run inside the active project" 77
  SC_LOCAL="$SC_PROJECT/.sandcodex"
  SC_WORK="$SC_LOCAL/work"
  SC_LOOP_ROOT="$SC_WORK/loop"
  SC_CAMPAIGN_LOCAL_ROOT="$SC_WORK/campaign"
}

sc_campaign_dirs_valid() {
  local marker="$SC_LOCAL/OWNER"
  sc_loop_dir_valid "$SC_LOCAL" "project-local state"
  [[ -f "$marker" && ! -L "$marker" && "$(stat -c %u -- "$marker")" == "$(id -u)" && \
    "$(stat -c %a -- "$marker")" == 600 && "$(sc_marker "$marker" schema)" == "$SC_SCHEMA" && \
    "$(sc_marker "$marker" project)" == "$SC_PROJECT" ]] || \
    sc_die "project campaign ownership marker is invalid"
  sc_loop_dir_valid "$SC_WORK" "project worker state"
  if [[ ! -e "$SC_CAMPAIGN_LOCAL_ROOT" && ! -L "$SC_CAMPAIGN_LOCAL_ROOT" ]]; then
    sc_die "project campaign control was removed; exit and restart the command room (managed Git refuses git clean so a new room cannot repeat this accident)"
  fi
  sc_loop_dir_valid "$SC_CAMPAIGN_LOCAL_ROOT" "project campaign control"
  sc_loop_dir_valid "$SC_CAMPAIGN_LOCAL_ROOT/inbox" "project campaign inbox"
  sc_loop_dir_valid "$SC_CAMPAIGN_LOCAL_ROOT/acks" "project campaign acknowledgements"
}

sc_campaign_relative_path() {
  local value="$1" label="$2" component
  local -a components=()
  sc_no_line_breaks "$value" "$label"
  [[ -n "$value" && "$value" != /* && ${#value} -le 1024 ]] || \
    sc_usage_error "$label must be a nonempty project-relative path"
  IFS=/ read -r -a components <<<"$value"
  for component in "${components[@]}"; do
    [[ -n "$component" && "$component" != . && "$component" != .. ]] || \
      sc_usage_error "$label contains an unsafe path component"
  done
}

sc_campaign_validate_request() {
  case "$SC_CAMPAIGN_ACTION" in
    list|grant|top|wait-any|ack|graph)
      [[ -z "$SC_CAMPAIGN_NAME" ]] || sc_usage_error "campaign $SC_CAMPAIGN_ACTION does not accept --name"
      ;;
    inbox)
      [[ -z "$SC_CAMPAIGN_NAME" || "$SC_CAMPAIGN_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
        sc_usage_error "team inbox --name must be a valid worker name"
      ;;
    start|status|events|send|stop|restart|collect|remove|wait|attach|inspect|diff|test|stage|adopt)
      [[ "$SC_CAMPAIGN_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
        sc_usage_error "campaign --name must be 1-64 letters, digits, dots, underscores, or hyphens"
      ;;
  esac
  [[ "$SC_CAMPAIGN_BROWSER" == none || ( $SC_TEAM_MODE -eq 1 && "$SC_CAMPAIGN_BROWSER" == isolated ) ]] || \
    sc_usage_error "team --browser must be none or isolated"
  [[ "$SC_CAMPAIGN_DESKTOP" == none || ( $SC_TEAM_MODE -eq 1 && "$SC_CAMPAIGN_DESKTOP" == isolated ) ]] || \
    sc_usage_error "team --desktop must be none or isolated"
  [[ "$SC_CAMPAIGN_CURSOR" =~ ^(0|[1-9][0-9]*)$ && ${#SC_CAMPAIGN_CURSOR} -le 9 ]] || \
    sc_usage_error "campaign event cursor must be a non-negative integer"
  case "$SC_CAMPAIGN_ACTION" in
    start)
      [[ "$SC_CAMPAIGN_TURNS" =~ ^(0|[1-9][0-9]*)$ && ${#SC_CAMPAIGN_TURNS} -le 9 && \
        "$SC_CAMPAIGN_TURNS" -le "$SC_CAMPAIGN_MAX_TURNS_LIMIT" ]] || \
        sc_usage_error "campaign turns must be 0 (unbounded) or an integer through $SC_CAMPAIGN_MAX_TURNS_LIMIT"
      sc_no_line_breaks "$SC_CAMPAIGN_BASE" "campaign base revision"
      [[ -n "$SC_CAMPAIGN_BASE" && ${#SC_CAMPAIGN_BASE} -le 128 && \
        "$SC_CAMPAIGN_BASE" =~ ^[A-Za-z0-9._^~:/+-]+$ ]] || \
        sc_usage_error "campaign base revision is invalid"
      ;;
    send)
      (( SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "campaign send requires --message or --message-file"
      [[ "$SC_TEAM_TO" == foreman ]] || \
        sc_usage_error "--to is worker-only; the foreman selects its recipient with send NAME"
      [[ -z "$SC_TEAM_ATTACHMENT" ]] || sc_campaign_relative_path "$SC_TEAM_ATTACHMENT" "team attachment"
      ;;
    collect)
      [[ -n "$SC_CAMPAIGN_OUTPUT" ]] || sc_usage_error "campaign collect requires --output"
      sc_campaign_relative_path "$SC_CAMPAIGN_OUTPUT" "campaign output"
      ;;
    grant)
      case "$SC_CAMPAIGN_GRANT_ACTION" in
        status|allow-starts|revoke-starts|remote-auto-on|remote-auto-off|browser-isolated-on|browser-isolated-off|desktop-isolated-on|desktop-isolated-off) ;;
        capacity)
          [[ "$SC_CAMPAIGN_GRANT_MAX" =~ ^(0|[1-9][0-9]*)$ && ${#SC_CAMPAIGN_GRANT_MAX} -le 2 && \
            "$SC_CAMPAIGN_GRANT_MAX" -le 16 ]] || \
            sc_usage_error "campaign grant capacity requires --max 0..16"
          ;;
        *) sc_usage_error "unknown campaign grant action: $SC_CAMPAIGN_GRANT_ACTION" ;;
      esac
      if [[ "$SC_CAMPAIGN_GRANT_ACTION" != capacity && -n "$SC_CAMPAIGN_GRANT_MAX" ]]; then
        sc_usage_error "--max is available only with campaign grant capacity"
      fi
      ;;
    ack)
      [[ "$SC_TEAM_MESSAGE_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$ ]] || \
        sc_usage_error "team ack requires --message-id ID"
      ;;
    graph)
      [[ -n "$SC_TEAM_GRAPH_FILE" ]] || sc_usage_error "team graph requires --file PATH"
      sc_campaign_relative_path "$SC_TEAM_GRAPH_FILE" "team graph file"
      ;;
    test) ;;
  esac
  [[ "$SC_TEAM_PROVIDER" =~ ^(auto|gpt|gemini|remote|local|openrouter)$ ]] || sc_usage_error "team provider constraint is invalid"
  [[ -z "$SC_TEAM_EFFORT" || "$SC_TEAM_EFFORT" =~ ^(minimal|low|medium|high|xhigh|max|ultra)$ ]] || \
    sc_usage_error "team effort is invalid"
  [[ "$SC_TEAM_TOKEN_BUDGET" == null || ( "$SC_TEAM_TOKEN_BUDGET" =~ ^[1-9][0-9]*$ && ${#SC_TEAM_TOKEN_BUDGET} -le 12 ) ]] || \
    sc_usage_error "team token budget must be a positive integer"
  [[ "$SC_TEAM_TIME_BUDGET" == null || ( "$SC_TEAM_TIME_BUDGET" =~ ^[1-9][0-9]*$ && ${#SC_TEAM_TIME_BUDGET} -le 9 ) ]] || \
    sc_usage_error "team time budget must be positive seconds"
  [[ "$SC_TEAM_TIMEOUT" =~ ^(0|[1-9][0-9]*)$ && ${#SC_TEAM_TIMEOUT} -le 9 ]] || sc_usage_error "team timeout is invalid"
  [[ "$SC_TEAM_POLL" =~ ^[1-9][0-9]*$ && ${#SC_TEAM_POLL} -le 5 ]] || sc_usage_error "team poll interval is invalid"
  [[ "$SC_TEAM_TEST_TIMEOUT" =~ ^[1-9][0-9]*$ && ${#SC_TEAM_TEST_TIMEOUT} -le 6 ]] || sc_usage_error "team test timeout is invalid"
  [[ "$SC_TEAM_ADOPT_STRATEGY" == cherry-pick || "$SC_TEAM_ADOPT_STRATEGY" == merge ]] || \
    sc_usage_error "team adoption strategy must be cherry-pick or merge"
  local dependency provider
  for dependency in "${SC_TEAM_DEPENDS[@]}"; do
    [[ "$dependency" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || sc_usage_error "team dependency name is invalid"
    [[ "$dependency" != "$SC_CAMPAIGN_NAME" ]] || sc_usage_error "a team task cannot depend on itself"
  done
  for provider in "${SC_TEAM_ALLOWED_PROVIDERS[@]}"; do
    [[ "$provider" =~ ^(gpt|gemini|remote|local|openrouter)$ ]] || sc_usage_error "team allowed-provider value is invalid"
  done
  if [[ -n "$SC_TEAM_VERIFIER" ]]; then
    [[ "$SC_CAMPAIGN_ACTION" == start ]] || sc_usage_error "--verifier is available only with team start"
    sc_campaign_relative_path "$SC_TEAM_VERIFIER" "team verifier"
    [[ "$SC_TEAM_VERIFIER" != .sandcodex && "$SC_TEAM_VERIFIER" != .sandcodex/* ]] || \
      sc_usage_error "team verifier must be outside project-local .sandcodex state"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" != start ]]; then
    [[ "$SC_TEAM_PROVIDER" == auto && ${#SC_TEAM_ALLOWED_PROVIDERS[@]} -eq 0 && \
      -z "$SC_TEAM_EFFORT" && "$SC_TEAM_TOKEN_BUDGET" == null && \
      "$SC_TEAM_TIME_BUDGET" == null ]] || \
      sc_usage_error "provider, effort, and task budgets are available only with team start"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" != adopt && "$SC_TEAM_ADOPT_STRATEGY" != cherry-pick ]]; then
    sc_usage_error "--strategy is available only with team adopt"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" != start && "$SC_CAMPAIGN_ACTION" != send ]]; then
    (( ! SC_CAMPAIGN_PROMPT_SET )) || sc_usage_error "campaign $SC_CAMPAIGN_ACTION does not accept --prompt/--message"
  fi
  if [[ -n "$SC_CAMPAIGN_PROMPT_FILE" ]]; then
    sc_campaign_relative_path "$SC_CAMPAIGN_PROMPT_FILE" "campaign prompt file"
  fi
  (( ! SC_CAMPAIGN_FOLLOW )) || [[ "$SC_CAMPAIGN_ACTION" == events || "$SC_CAMPAIGN_ACTION" == attach || \
    "$SC_CAMPAIGN_ACTION" == inspect ]] || sc_usage_error "--follow is available only for team attach/inspect or campaign events"
  (( ! SC_CAMPAIGN_DRY_RUN )) || [[ "$SC_CAMPAIGN_ACTION" == remove ]] || \
    sc_usage_error "--dry-run is available only for campaign remove"
}

sc_campaign_load_prompt() {
  local path bytes
  if [[ -n "$SC_CAMPAIGN_PROMPT_FILE" ]]; then
    path="$(realpath -- "$SC_PROJECT/$SC_CAMPAIGN_PROMPT_FILE" 2>/dev/null || true)"
    [[ -n "$path" && ( "$path" == "$SC_PROJECT" || "$path" == "$SC_PROJECT"/* ) && \
      -f "$path" && ! -L "$SC_PROJECT/$SC_CAMPAIGN_PROMPT_FILE" ]] || \
      sc_die "campaign prompt file must be a non-symlink regular file inside the project" 64
    [[ "$(stat -c %u -- "$path")" == "$(id -u)" && "$(stat -c %h -- "$path")" == 1 ]] || \
      sc_die "campaign prompt file metadata is unsafe" 64
    bytes="$(stat -c %s -- "$path")"
    (( bytes <= SC_LOOP_MESSAGE_MAX )) || \
      sc_die "campaign prompt must be $SC_LOOP_MESSAGE_MAX bytes or less" 64
    jq -eRs 'index("\u0000") == null' "$path" >/dev/null || \
      sc_die "campaign prompt must not contain NUL bytes" 64
    SC_CAMPAIGN_PROMPT="$(<"$path")"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" == start && $SC_CAMPAIGN_PROMPT_SET -eq 0 ]]; then
    SC_CAMPAIGN_PROMPT="$SC_LOOP_DEFAULT_PROMPT"
  fi
  if [[ "$SC_CAMPAIGN_ACTION" == start || "$SC_CAMPAIGN_ACTION" == send ]]; then
    [[ "$SC_CAMPAIGN_PROMPT" =~ [^[:space:]] ]] || sc_die "campaign prompt must not be empty" 64
    bytes="$(LC_ALL=C printf '%s' "$SC_CAMPAIGN_PROMPT" | wc -c)"
    (( bytes <= SC_LOOP_MESSAGE_MAX )) || \
      sc_die "campaign prompt must be $SC_LOOP_MESSAGE_MAX bytes or less" 64
  fi
  if [[ "$SC_CAMPAIGN_ACTION" == graph ]]; then
    path="$(realpath -- "$SC_PROJECT/$SC_TEAM_GRAPH_FILE" 2>/dev/null || true)"
    [[ -n "$path" && "$path" == "$SC_PROJECT"/* && -f "$path" && ! -L "$SC_PROJECT/$SC_TEAM_GRAPH_FILE" ]] || \
      sc_die "team graph must be a non-symlink regular file inside the project" 64
    [[ "$(stat -c %u -- "$path")" == "$(id -u)" && "$(stat -c %h -- "$path")" == 1 && \
      "$(stat -c %s -- "$path")" -le 1048576 ]] || sc_die "team graph file metadata or size is unsafe" 64
    SC_TEAM_GRAPH_JSON="$(jq -ce . "$path" 2>/dev/null)" || sc_die "team graph file is not valid JSON" 64
  fi
}

sc_campaign_target_run() {
  if [[ "${SANDCODEX_ACTIVE:-0}" == 1 ]]; then
    [[ -n "${SANDCODEX_RUN_ID:-}" && "$SANDCODEX_RUN_ID" =~ ^[A-Za-z0-9._:-]{1,160}$ ]] || \
      sc_die "active campaign run identity is missing" 77
    printf '%s\n' "$SANDCODEX_RUN_ID"
    return
  fi
  local state
  state="$(sc_loop_read_state "$SC_CONTROL/loop-state.json")"
  [[ "$(jq -r '.mode' <<<"$state")" == interactive && \
    "$(jq -r '.status' <<<"$state")" == running ]] || \
    sc_die "new companion campaigns require a live interactive command room"
  sc_loop_state_process_is_live "$state" || sc_die "the interactive command room is no longer running"
  jq -r '.run_id' <<<"$state"
}

sc_campaign_render_response() {
  local response="$1" status message result error_code
  status="$(jq -r '.status // "error"' <<<"$response")"
  message="$(jq -r '.message // "campaign request failed"' <<<"$response")"
  if [[ "$status" != ok ]]; then
    error_code="$(jq -r '.error_code // empty' <<<"$response")"
    [[ -z "$error_code" ]] || message+=" [$error_code]"
    sc_err "$message"
    if (( SC_TEAM_MODE )); then
      printf 'Next: sandcodex-team top\n' >&2
      printf 'If the broker is unavailable: sandcodex-worker doctor\n' >&2
    else
      printf 'Next: sandcodex campaign list --project %q\n' "$SC_PROJECT" >&2
    fi
    return 1
  fi
  result="$(jq -c '.result // {}' <<<"$response")"
  if (( SC_CAMPAIGN_JSON )); then
    printf '%s\n' "$result"
    return
  fi
  case "$SC_CAMPAIGN_ACTION" in
    list)
      jq -r 'if (.campaigns | length) == 0 then
          "No Sandcodex companion workers.\nStart one inside an authorized room with: sandcodex-worker start --name worker-1 --prompt '\''Task text'\''"
        else "Sandcodex companions · \(.campaigns | length)\n"
          + (.campaigns | map(
              "\n  \(.name)\n"
              + "    state      \(.lifecycle_state // .status)\n"
              + "    progress   current=\(.current_turn // 0) · successful=\(.successful_turns // 0)/\(if .turn_limit == 0 then "unbounded" else (.turn_limit|tostring) end) · attempts=\(.attempts // 0)\n"
              + "    route      \(.provider_route // .inference_mode // "gpt") · \(.worker_model // "pending")\n"
              + "    updated    \(.updated_at)\n"
              + "    campaign   \(.campaign_id)"
            ) | join("\n"))
        end' <<<"$result"
      ;;
    status|wait)
      jq -r '"sandcodex team worker\n"
        + "  name       \(.name)\n"
        + "  status     \(.status)\n"
        + (if .lifecycle_state and .lifecycle_state != .status then "  lifecycle  \(.lifecycle_state)\n" else "" end)
        + "  campaign   \(.campaign_id)\n"
        + "  run        \(.worker_run_id // (if .status == "failed" and (.last_error_class // "none") == "worker-launch" then "not-started" else "pending" end))\n"
        + "  inference  \(.inference_mode // "gpt")\n"
        + "  route      \(.provider_route // .inference_mode // "gpt")\n"
        + (if .worker_model then "  model      \(.worker_model)\n" else "" end)
        + (if .remote_auto_worker and .remote_auto_retry_policy then "  auto       retry-limit=\(.remote_auto_retry_policy.retry_limit) max-wait=\(.remote_auto_retry_policy.retry_max_wait_seconds)s then bounded broker replay\n" else "" end)
        + (if .automatic_recovery then "  recovery   attempts=\(.automatic_recovery.attempts)/\(.automatic_recovery.attempt_limit) launch-failures=\(.automatic_recovery.launch_failures) next=\(.automatic_recovery.next_attempt_at // "none")\n" else "" end)
        + "  base       \(.base_commit)\n"
        + (if (.source_worktree.dirty_paths_excluded // 0) > 0 then
            "  snapshot   committed base · \(.source_worktree.dirty_paths_excluded) uncommitted primary path(s) excluded\n"
          elif (.source_worktree.dirty_paths_included // 0) > 0 then
            "  snapshot   managed · \(.source_worktree.dirty_paths_included) path(s) sealed\n"
          else "" end)
        + "  head       \(.head_commit // .base_commit)\n"
        + "  verify     \(.verification.state // "unconfigured") · adoption=\(if .verification.adoption_eligible then "eligible" else "blocked" end)\n"
        + "  Codex      \(.successful_turns // 0) / \(if .turn_limit == 0 then "unbounded" else (.turn_limit|tostring) end) successful · current=\(.current_turn // 0) · attempts=\(.attempts // 0)\n"
        + (if .worker_status and .worker_status != .status then "  worker     \(.worker_status)\n" else "" end)
        + (if (.retry_count // 0) > 0 or (.last_error_class // "none") != "none" then "  retry      count=\(.retry_count // 0) error=\(.last_error_class // "none") exit=\(.last_exit // "n/a") next=\(.next_attempt_at // "none")\n" else "" end)
        + "  browser    \(.browser // "none")\n"
        + "  desktop    \(.desktop // "none")\n"
        + (if (.dependencies | length) > 0 then "  depends    \(.dependencies | join(","))\n" else "" end)
        + (if .budgets.tokens or .budgets.time_seconds then
            "  budget     tokens=\(.budgets.tokens // "unbounded") time=\(.budgets.time_seconds // "unbounded")s elapsed=\(.budget_elapsed_seconds // 0)s exhausted=\(.budget_exhausted // "no")\n"
          else "" end)
        + (if .completion.requested then "  completion requested · \(.completion.message_id // "pending")\n" else "" end)
        + "  mailbox    foreman-unread=\(.mailbox.to_foreman_unread // 0) worker-unread=\(.mailbox.to_worker_unread // 0)\n"
        + (if .worker_grants then "  grants     starts=\(if .worker_grants.starts_enabled then "enabled" else "revoked" end) capacity=\(.worker_grants.max_campaigns) remote-auto=\(if .worker_grants.remote_auto_enabled then "enabled" else "revoked" end)\n" else "" end)
        + "  updated    \(.updated_at)\n"
        + "  next       "
        + (if .status == "completed" then "sandcodex-team diff \(.name)"
           elif .status == "failed" or .status == "stale" or .status == "recovery_required" then "sandcodex-team inspect \(.name)"
           elif .status == "storage_hold" then "sandcodex-team inspect \(.name) · review storage before restart"
           elif .status == "stopped" or .status == "interrupted" then "sandcodex-team restart \(.name)"
           else "sandcodex-team events \(.name) --follow" end)' <<<"$result"
      ;;
    events)
      jq -r '
        def clean:
          gsub("[\\r\\n\\t]+"; " ")
          | if length > 320 then .[0:317] + "..." else . end;
        if (.events | length) == 0 then
          "No new worker events · cursor \(.next_cursor)"
        else
          "Sandcodex worker events · next cursor \(.next_cursor)\n"
          + (.events | map(
              . as $event
              | ($event | del(.schema, .at, .event)) as $details
              | "  \($event.at // "unknown")  \($event.event // "unknown")"
                + (if ($details | length) == 0 then "" else
                    " · " + ($details | to_entries
                      | map("\(.key)=\(.value | @json)") | join(" ") | clean)
                  end)
            ) | join("\n"))
        end' <<<"$result"
      ;;
    grant)
      jq -r '"Sandcodex worker grants\n"
        + "  starts       \(if .grants.starts_enabled then "enabled" else "revoked" end)\n"
        + "  capacity     \(.grants.max_campaigns) / \(.launch_max_campaigns)\n"
        + "  remote-auto  \(if .grants.remote_auto_enabled then "enabled" else "revoked" end)\n"
        + "  browser      \(.grants.browser_modes | join(","))\n"
        + "  desktop      \(.grants.desktop_modes | join(","))\n"
        + "  updated      \(.grants.updated_at // "launch-default")"
        + (if .receipt then "\n  receipt      \(.receipt)" else "" end)
        + "\n\nnext\n"
        + "  inspect team  sandcodex-team top\n"
        + "  stop starts   sandcodex-team grant revoke-starts\n"
        + "  allow starts  sandcodex-team grant allow-starts"' <<<"$result"
      ;;
    top)
      jq -r '"Sandcodex team\n"
        + "  workers    \(.totals.workers) total · \(.totals.active) active · \(.totals.blocked) blocked · \(.totals.terminal) terminal\n"
        + "  inbox      \(.totals.unread_messages) unread\n"
        + "  usage      \(.totals.usage.total_tokens) tokens\n"
        + (if (.campaigns | length) == 0 then "No team workers."
           else (.campaigns | map(
             "\n  \(.name) · \(.status)\n"
             + "    route      \(.provider_route // .inference_mode)/\(.worker_model // "pending")\n"
             + "    progress   current=\(.current_turn // 0) · successful=\(.successful_turns // 0)/\(if .turn_limit == 0 then "unbounded" else (.turn_limit|tostring) end)\n"
             + "    verify     \(.verification.state // "unconfigured") · adoption=\(if .verification.adoption_eligible then "eligible" else "blocked" end)\n"
             + "    usage      \(.worker_usage.total_tokens // 0) tokens · inbox \(.mailbox.to_foreman_unread // 0) unread\n"
             + "    report     \((.mailbox.last_report.text // "-") | gsub("[\\r\\n\\t]+"; " ") | .[0:200])"
           ) | join("\n")) end)' <<<"$result"
      ;;
    inbox)
      jq -r '
        def clean: gsub("[\\r\\n\\t]+"; " ") | if length > 500 then .[0:497] + "..." else . end;
        if (.messages | length) == 0 then
          "Sandcodex team inbox\n"
          + "  result     EMPTY · no worker messages\n"
          + "\nnext\n  inspect team  sandcodex-team top"
        else
          "Sandcodex team inbox\n  unread     \(.unread)\n"
          + (.messages | map(
              "\n  " + (if .acknowledged then "READ" else "NEW" end) + " · \(.from) · \(.created_at)\n"
              + "    id         \(.message_id)\n"
              + "    message    \(.text | clean)"
              + (if .attachment then "\n    attachment \(.attachment.name) · \(.attachment.sha256)" else "" end)
            ) | join("\n"))
          + "\n\nnext\n  acknowledge  sandcodex-team ack --message-id ID"
        end' <<<"$result"
      ;;
    ack)
      jq -r '"message \(.message_id) " + (if .changed then "acknowledged" else "was already acknowledged" end)' <<<"$result"
      ;;
    wait-any)
      jq -r 'if (.ready | length) == 0 then "No team worker is terminal yet."
        else "Sandcodex terminal workers\n" + (.ready | map(
          "\n  \(.name) · \(.status)\n"
          + "    model      \(.worker_model // "pending")\n"
          + "    progress   \(.successful_turns // 0)/\(if .turn_limit == 0 then "unbounded" else (.turn_limit|tostring) end) successful"
          + "\n    next       " +
            (if .status == "completed" then "sandcodex-team diff \(.name)"
             else "sandcodex-team inspect \(.name)" end)
        ) | join("\n")) end' <<<"$result"
      ;;
    attach|inspect)
      jq -r '
        def clean: gsub("[\\r\\n\\t]+"; " ") | if length > 500 then .[0:497] + "..." else . end;
        "Sandcodex worker inspection\n"
        + "  name       \(.status.name)\n"
        + "  status     \(.status.status)\n"
        + "  progress   current=\(.status.current_turn // 0) · successful=\(.status.successful_turns // 0)/\(if .status.turn_limit == 0 then "unbounded" else (.status.turn_limit|tostring) end)\n"
        + (if (.events | length) > 0 then "\nevents\n" + (.events | map("  \(.at) · \(.event)" + (if .status then " → \(.status)" else "" end)) | join("\n")) + "\n" else "" end)
        + (if (.messages | length) > 0 then "\nmessages\n" + (.messages | map("  \(.created_at) · \(.from) → \(.to)\n    \(.text | clean)" ) | join("\n")) + "\n" else "" end)
        + "\nnext\n"
        + (if .status.status == "completed" then "  review      sandcodex-team diff \(.status.name)"
           elif .status.status == "failed" then "  diagnose    sandcodex-team events \(.status.name)"
           else "  follow      sandcodex-team events \(.status.name) --follow" end)' <<<"$result"
      ;;
    diff)
      jq -r '"candidate \(.name) · \(.base_commit) → \(.candidate_commit) · \(.commits | length) commit(s)\n"
        + .stat + (if .patch == "" then "" else "\n" + .patch end)
        + (if .patch_truncated then "\n[patch preview truncated at 512 KiB]" else "" end)' <<<"$result"
      ;;
    test)
      jq -r 'if .verification_mode == "sealed" then
          "sealed verification \(.status) · adoption=\(if .adoption_eligible then "eligible" else "blocked" end) · \(.duration_seconds)s\n"
          + "candidate: \(.candidate_commit)\n"
          + "verifier:  \(.verifier.source_path) · \(.verifier.input_sha256)\n"
          + "result:    \(.result.state) · declared-pass=\(.result.passed)\n"
          + "output:    content not retained · stdout=\(.output.stdout.bytes)B stderr=\(.output.stderr.bytes)B\n"
          + "receipt:   \(.receipt)"
        else
          "diagnostic test \(.status) · not adoption evidence · exit=\(.exit_code) · \(.duration_seconds)s · \(.candidate_commit)\n"
          + (if (.stdout // "") == "" then "" else "stdout:\n" + .stdout + "\n" end)
          + (if (.stderr // "") == "" then "" else "stderr:\n" + .stderr + "\n" end)
          + "receipt: \(.receipt)"
        end' <<<"$result"
      ;;
    stage)
      jq -r '"staged \(.name) at \(.candidate_commit)\nstage: \(.stage_id)\nsha256: \(.artifact.sha256)\nverification: \(.verification.state) · adoption=\(if .verification.adoption_eligible then "eligible" else "blocked" end)\nreceipt: \(.receipt)\nprimary checkout: unchanged"' <<<"$result"
      ;;
    adopt)
      jq -r '"adopted \(.name) with \(.strategy)\nbefore: \(.before_commit)\ncandidate: \(.candidate_commit)\nafter: \(.after_commit)"
        + "\nverification: \(.verification.state) · \(.verification.receipt_sha256 // "no-change")"
        + (if .publication_observation.receipt.status == "recorded"
           then "\nreceipt: \(.receipt)"
           else "\nreceipt outcome: unknown; candidate path: \(.receipt_candidate)"
           end)
        + (if .publication_observation.event.status == "recorded"
           then "\nevent ledger: recorded"
           elif .publication_observation.event.status == "not-attempted"
           then "\nevent ledger: not attempted because receipt outcome is unknown"
           else "\nevent ledger: outcome unknown"
           end)
        + (if .publication_observation.inspect_before_repeat
           then "\nadoption is already committed; inspect before repeating"
           else ""
           end)' <<<"$result"
      ;;
    graph)
      jq -r '"team graph \(.graph_id) accepted\n" + (.tasks | map("  \(.name): \(.status)") | join("\n"))' <<<"$result"
      ;;
    send)
      if jq -e '.message.message_id? != null' <<<"$result" >/dev/null 2>&1; then
        jq -r '"team message queued: \(.message.message_id) → \(.message.to)"' <<<"$result"
      else
        sc_ok "$message"
      fi
      ;;
    *)
      sc_ok "$message"
      [[ "$SC_CAMPAIGN_ACTION" != collect ]] || \
        jq -r '"artifact: \(.artifact)\nreceipt: \(.receipt)\nsha256: \(.artifact_sha256)"
          + (if .event_observation.status == "recorded"
             then "\nevent ledger: recorded"
             else "\nevent ledger: outcome unknown; collection is already committed; inspect before repeating"
             end)' <<<"$result"
      ;;
  esac
}

sc_campaign_queue_request() {
  local render="${1:-1}"
  local target id tmp request ack count attempt owner mode links size depends_json providers_json test_json
  sc_campaign_dirs_valid
  sc_campaign_validate_request
  sc_campaign_load_prompt
  target="$(sc_campaign_target_run)"
  count="$(find "$SC_CAMPAIGN_LOCAL_ROOT/inbox" -mindepth 1 -maxdepth 1 -type f -printf '.\n' | wc -l)"
  (( count < 64 )) || sc_die "campaign control inbox is full"
  id="${target}:$(date -u +%Y%m%dT%H%M%S):$$:$(printf '%06x' "$(( RANDOM * RANDOM % 16777216 ))")"
  tmp="$(mktemp "$SC_CAMPAIGN_LOCAL_ROOT/inbox/.request.XXXXXX")"
  depends_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_DEPENDS[@]}")"
  providers_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_ALLOWED_PROVIDERS[@]}")"
  test_json="$(jq -cn --args '$ARGS.positional' -- "${SC_TEAM_TEST_ARGS[@]}")"
  jq -cn \
    --arg schema "$SC_CAMPAIGN_REQUEST_SCHEMA" --arg id "$id" --arg target_run_id "$target" \
    --arg action "$SC_CAMPAIGN_ACTION" --arg name "$SC_CAMPAIGN_NAME" \
    --arg prompt "$SC_CAMPAIGN_PROMPT" --arg base "$SC_CAMPAIGN_BASE" \
    --arg browser "$SC_CAMPAIGN_BROWSER" --arg output "$SC_CAMPAIGN_OUTPUT" \
    --arg desktop "$SC_CAMPAIGN_DESKTOP" --arg to "$SC_TEAM_TO" \
    --arg interface "$([[ $SC_TEAM_MODE == 1 ]] && printf team || printf campaign)" \
    --arg message_id "$SC_TEAM_MESSAGE_ID" --arg attachment "$SC_TEAM_ATTACHMENT" \
    --arg provider "$SC_TEAM_PROVIDER" --arg effort "$SC_TEAM_EFFORT" \
    --arg strategy "$SC_TEAM_ADOPT_STRATEGY" \
    --arg verifier "$SC_TEAM_VERIFIER" \
    --arg grant_action "$SC_CAMPAIGN_GRANT_ACTION" \
    --arg created_at "$(sc_now)" --argjson turns "$SC_CAMPAIGN_TURNS" \
    --argjson cursor "$SC_CAMPAIGN_CURSOR" --argjson dry_run "$SC_CAMPAIGN_DRY_RUN" \
    --argjson grant_max "$([[ -z "$SC_CAMPAIGN_GRANT_MAX" ]] && printf null || printf '%s' "$SC_CAMPAIGN_GRANT_MAX")" \
    --argjson depends "$depends_json" --argjson allowed_providers "$providers_json" \
    --argjson token_budget "$SC_TEAM_TOKEN_BUDGET" --argjson time_budget "$SC_TEAM_TIME_BUDGET" \
    --argjson timeout "$SC_TEAM_TIMEOUT" --argjson poll "$SC_TEAM_POLL" \
    --argjson test_timeout "$SC_TEAM_TEST_TIMEOUT" --argjson test_argv "$test_json" \
    --argjson graph "$SC_TEAM_GRAPH_JSON" \
    '{schema:$schema,id:$id,target_run_id:$target_run_id,action:$action,
      name:(if $name == "" then null else $name end),turns:$turns,base:$base,browser:$browser,
      prompt:(if ($action == "start" or $action == "send") then $prompt else null end),
      output:(if $output == "" then null else $output end),cursor:$cursor,
      dry_run:($dry_run == 1),
      grant:(if $action == "grant" then {action:$grant_action,max_campaigns:$grant_max} else null end),
      team:{interface:$interface,desktop:$desktop,to:$to,message_id:(if $message_id=="" then null else $message_id end),
        attachment:(if $attachment=="" then null else $attachment end),depends:$depends,
        provider:$provider,allowed_providers:$allowed_providers,
        effort:(if $effort=="" then null else $effort end),token_budget:$token_budget,
        time_budget_seconds:$time_budget,timeout_seconds:$timeout,poll_seconds:$poll,
        test_timeout_seconds:$test_timeout,test_argv:$test_argv,strategy:$strategy,
        verifier:(if $verifier=="" then null else $verifier end),graph:$graph},
      created_at:$created_at}' >"$tmp"
  chmod 600 -- "$tmp"
  request="$SC_CAMPAIGN_LOCAL_ROOT/inbox/$id.json"
  ack="$SC_CAMPAIGN_LOCAL_ROOT/acks/$id.json"
  mv -fT -- "$tmp" "$request"
  for (( attempt=0; attempt<SC_CAMPAIGN_WAIT_SECONDS * 10; attempt++ )); do
    if [[ -f "$ack" && ! -L "$ack" ]]; then
      owner="$(stat -c %u -- "$ack")"; mode="$(stat -c %a -- "$ack")"
      links="$(stat -c %h -- "$ack")"; size="$(stat -c %s -- "$ack")"
      [[ "$owner" == "$(id -u)" && "$mode" == 600 && "$links" == 1 && \
        "$size" -le "$SC_CAMPAIGN_ACK_MAX_BYTES" ]] || sc_die "campaign acknowledgement metadata is invalid"
      SC_CAMPAIGN_RESPONSE="$(jq -ce --arg schema "$SC_CAMPAIGN_REQUEST_SCHEMA" --arg id "$id" \
        'select(type == "object" and .schema == $schema and .id == $id and
          (.status == "ok" or .status == "error") and (.message | type) == "string")' \
        "$ack" 2>/dev/null)" || sc_die "campaign acknowledgement is invalid"
      rm -f -- "$ack"
      (( ! render )) || sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE"
      return
    fi
    sleep 0.1
  done
  if [[ -e "$request" && ! -L "$request" ]]; then
    rm -f -- "$request"
    sc_die "campaign broker did not acknowledge the request within ${SC_CAMPAIGN_WAIT_SECONDS}s"
  fi
  sc_die "campaign request outcome is unknown; inspect campaign list and events before retrying"
}

sc_team_wait_exit() {
  case "$1" in
    completed) return 0 ;;
    failed) return 1 ;;
    storage_hold) return 73 ;;
    recovery_required) return 75 ;;
    stopped) return 125 ;;
    *) return 126 ;;
  esac
}

sc_campaign_client_wait() {
  local deadline=$((SECONDS + SC_TEAM_TIMEOUT)) lifecycle rc
  while :; do
    sc_campaign_queue_request 0
    if [[ "$SC_CAMPAIGN_ACTION" == wait-any ]]; then
      if [[ "$(jq -r '.result.ready | length' <<<"$SC_CAMPAIGN_RESPONSE")" -gt 0 ]]; then
        sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE"
        lifecycle="$(jq -r '.result.ready[0].lifecycle_state' <<<"$SC_CAMPAIGN_RESPONSE")"
        if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
        (( rc != 126 )) && return "$rc"
      fi
    else
      lifecycle="$(jq -r '.result.lifecycle_state // "failed"' <<<"$SC_CAMPAIGN_RESPONSE")"
      if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
      if (( rc != 126 )); then
        sc_campaign_render_response "$SC_CAMPAIGN_RESPONSE"
        return "$rc"
      fi
    fi
    if (( SC_TEAM_TIMEOUT > 0 && SECONDS >= deadline )); then
      sc_die "team $SC_CAMPAIGN_ACTION timed out after ${SC_TEAM_TIMEOUT}s" 124
    fi
    sleep "$SC_TEAM_POLL"
  done
}

sc_campaign_client_dispatch() {
  local lifecycle rc
  [[ "$SC_CAMPAIGN_ACTION" != remove ]] || \
    sc_die "campaign removal is operator-only; run sandcodex campaign remove from the host terminal" 77
  if [[ "$SC_CAMPAIGN_ACTION" == wait || "$SC_CAMPAIGN_ACTION" == wait-any ]]; then
    sc_campaign_client_wait
    return
  fi
  if (( SC_CAMPAIGN_FOLLOW )); then
    while :; do
      sc_campaign_queue_request
      SC_CAMPAIGN_CURSOR="$(jq -r '.result.next_cursor // 0' <<<"$SC_CAMPAIGN_RESPONSE")"
      if [[ "$SC_CAMPAIGN_ACTION" == attach || "$SC_CAMPAIGN_ACTION" == inspect ]]; then
        lifecycle="$(jq -r '.result.status.lifecycle_state // "failed"' <<<"$SC_CAMPAIGN_RESPONSE")"
        if sc_team_wait_exit "$lifecycle"; then rc=0; else rc=$?; fi
        (( rc == 126 )) || return "$rc"
      fi
      sleep "$SC_TEAM_POLL"
    done
  fi
  sc_campaign_queue_request
}

sc_emit_campaign_engine() {
  cat <<'SANDCODEX_CAMPAIGN_ENGINE_PY'
