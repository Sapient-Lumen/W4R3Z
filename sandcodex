    def _validate_socket_path(self) -> None:
        path = self.socket_path
        if not path.is_absolute() or "\x00" in os.fspath(path):
            raise RuntimeError("Sway IPC socket path is invalid")
        try:
            info = path.lstat()
            parent = path.parent.lstat()
        except OSError as error:
            raise RuntimeError("Sway IPC socket path is unavailable") from error
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISSOCK(info.st_mode):
            raise RuntimeError("Sway IPC endpoint is not a direct UNIX socket")
        if info.st_uid != os.geteuid() or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) & 0o077:
            raise RuntimeError("Sway IPC socket ownership or mode is unsafe")
        if stat.S_ISLNK(parent.st_mode) or not stat.S_ISDIR(parent.st_mode):
            raise RuntimeError("Sway IPC socket parent is unsafe")
        if parent.st_uid != os.geteuid() or stat.S_IMODE(parent.st_mode) & 0o077:
            raise RuntimeError("Sway IPC socket parent is not private to the controller")

    def _connect(self) -> socket.socket:
        flags = socket.SOCK_STREAM | getattr(socket, "SOCK_CLOEXEC", 0)
        connection = socket.socket(socket.AF_UNIX, flags)
        connection.settimeout(self.barrier_timeout)
        try:
            connection.connect(os.fspath(self.socket_path))
        except Exception:
            connection.close()
            raise
        return connection

    @staticmethod
    def _peer_credentials(connection: socket.socket) -> tuple[int, int, int]:
        option = getattr(socket, "SO_PEERCRED", None)
        if option is None:
            raise RuntimeError("Linux SO_PEERCRED is unavailable for Sway IPC authentication")
        size = struct.calcsize("=3i")
        raw = connection.getsockopt(socket.SOL_SOCKET, option, size)
        if len(raw) != size:
            raise RuntimeError("kernel returned malformed Sway IPC peer credentials")
        pid, uid, gid = struct.unpack("=3i", raw)
        if pid <= 0 or uid < 0 or gid < 0:
            raise RuntimeError("kernel returned invalid Sway IPC peer credentials")
        return pid, uid, gid

    @staticmethod
    def _recv_exact(connection: socket.socket, size: int) -> bytes:
        payload = bytearray()
        while len(payload) < size:
            chunk = connection.recv(size - len(payload))
            if not chunk:
                raise EOFError("Sway IPC connection closed")
            payload.extend(chunk)
        return bytes(payload)

    @classmethod
    def _recv_frame(cls, connection: socket.socket) -> tuple[int, bytes]:
        header = cls._recv_exact(connection, SWAY_IPC_HEADER.size)
        magic, payload_length, message_type = SWAY_IPC_HEADER.unpack(header)
        if magic != SWAY_IPC_MAGIC:
            raise RuntimeError("Sway IPC frame has invalid magic")
        if payload_length > SWAY_IPC_MAX_PAYLOAD_BYTES:
            raise RuntimeError("Sway IPC frame exceeds the bounded payload limit")
        return message_type, cls._recv_exact(connection, payload_length)

    @staticmethod
    def _send_frame(connection: socket.socket, message_type: int, payload: bytes) -> None:
        if len(payload) > SWAY_IPC_MAX_PAYLOAD_BYTES:
            raise RuntimeError("Sway IPC request exceeds the bounded payload limit")
        connection.sendall(SWAY_IPC_HEADER.pack(SWAY_IPC_MAGIC, len(payload), message_type) + payload)

    @staticmethod
    def _decode_object(payload: bytes, label: str) -> dict[str, Any]:
        try:
            value = json.loads(payload.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RuntimeError(f"Sway IPC returned invalid {label} JSON") from error
        if not isinstance(value, dict):
            raise RuntimeError(f"Sway IPC returned non-object {label} JSON")
        return value

    @staticmethod
    def _decode_array(payload: bytes, label: str) -> list[Any]:
        try:
            value = json.loads(payload.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RuntimeError(f"Sway IPC returned invalid {label} JSON") from error
        if not isinstance(value, list):
            raise RuntimeError(f"Sway IPC returned non-array {label} JSON")
        return value

    @staticmethod
    def _bounded_identity_string(value: Any, label: str, *, maximum: int = 4096) -> str:
        if not isinstance(value, str) or not value or "\x00" in value:
            raise RuntimeError(f"Sway IPC {label} is invalid")
        encoded = value.encode("utf-8", "strict")
        if len(encoded) > maximum:
            raise RuntimeError(f"Sway IPC {label} exceeds its bounded size")
        return value

    @classmethod
    def _normalize_input_device(cls, value: Any, label: str) -> dict[str, Any]:
        if not isinstance(value, dict):
            raise RuntimeError(f"Sway IPC {label} is not an object")
        identifier = cls._bounded_identity_string(value.get("identifier"), f"{label} identifier")
        name = cls._bounded_identity_string(value.get("name"), f"{label} name")
        input_type = cls._bounded_identity_string(value.get("type"), f"{label} type", maximum=64)
        if input_type not in {"keyboard", "pointer", "touch", "tablet_tool", "tablet_pad", "switch"}:
            raise RuntimeError(f"Sway IPC {label} has an unknown input type")

        def optional_identity_number(field: str) -> int | None:
            number = value.get(field)
            if number is None:
                return None
            if not isinstance(number, int) or isinstance(number, bool) or not 0 <= number <= 0xFFFFFFFF:
                raise RuntimeError(f"Sway IPC {label} {field} is invalid")
            return number

        projection = {
            "type": input_type,
            "identifier_sha256": hashlib.sha256(identifier.encode("utf-8")).hexdigest(),
            "name_sha256": hashlib.sha256(name.encode("utf-8")).hexdigest(),
            "vendor": optional_identity_number("vendor"),
            "product": optional_identity_number("product"),
        }
        projection["identity_sha256"] = hashlib.sha256(canonical_json(projection)).hexdigest()
        return projection

    def _request_array_locked(self, message_type: int, label: str) -> list[Any]:
        with self.condition:
            self._raise_if_unhealthy_locked()
        connection = self.command_socket
        if connection is None:
            raise RuntimeError("Sway IPC command connection is unavailable")
        self._send_frame(connection, message_type, b"")
        reply_type, payload = self._recv_frame(connection)
        if reply_type != message_type:
            raise RuntimeError(f"Sway returned the wrong reply type for {label}")
        with self.condition:
            self._raise_if_unhealthy_locked()
        return self._decode_array(payload, label)

    def _request_object_locked(
        self,
        message_type: int,
        payload: bytes,
        label: str,
    ) -> dict[str, Any]:
        with self.condition:
            self._raise_if_unhealthy_locked()
        connection = self.command_socket
        if connection is None:
            raise RuntimeError("Sway IPC command connection is unavailable")
        self._send_frame(connection, message_type, payload)
        reply_type, response = self._recv_frame(connection)
        if reply_type != message_type:
            raise RuntimeError(f"Sway returned the wrong reply type for {label}")
        with self.condition:
            self._raise_if_unhealthy_locked()
        return self._decode_object(response, label)

