sc_write_team_helper() {
  [[ -n "$SC_AGENT_BIN" ]] || return 0
  local helper="$SC_AGENT_BIN/sandcodex-team"
  if [[ -n "$SC_TEAM_MEMBER_NAME" || -n "$SC_TEAM_MEMBER_CAMPAIGN_ID" ]]; then
    [[ "$SC_TEAM_MEMBER_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && \
      "$SC_TEAM_MEMBER_CAMPAIGN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$ ]] || \
      sc_die "worker team identity is incomplete or invalid"
    local outbox="$SC_WORK/team-outbox" inbox="$SC_WORK/team-inbox"
    sc_ensure_dir "$outbox" "worker team outbox"
    sc_ensure_dir "$inbox" "worker team inbox"
    {
      printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
      printf 'outbox=%q\ninbox=%q\nsender=%q\ncampaign=%q\nproject=%q\n' \
        "$outbox" "$inbox" "$SC_TEAM_MEMBER_NAME" "$SC_TEAM_MEMBER_CAMPAIGN_ID" "$SC_PROJECT"
      cat <<'EOF'
die() { printf 'sandcodex-team: %s\n' "$*" >&2; exit 64; }
inside_project_file() {
  local source="$1" resolved uid links size
  resolved="$(realpath -- "$source" 2>/dev/null || true)"
  [[ -n "$resolved" && "$resolved" == "$project"/* && -f "$resolved" && ! -L "$source" ]] || return 1
  uid="$(stat -c %u -- "$resolved")"; links="$(stat -c %h -- "$resolved")"; size="$(stat -c %s -- "$resolved")"
  [[ "$uid" == "$(id -u)" && "$links" == 1 && "$size" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$resolved"
}
message_id() {
  printf '%s:%s:%06x\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$(( RANDOM * RANDOM % 16777216 ))"
}
action="${1:-help}"
(( $# == 0 )) || shift
case "$action" in
  reply|send|complete)
    to=foreman message= message_file= attachment= reply_to= completion=false
    [[ "$action" != complete ]] || completion=true
    while (( $# )); do
      case "$1" in
        --to) (( $# > 1 )) || die '--to requires NAME'; to="$2"; shift 2 ;;
        --to=*) to="${1#*=}"; shift ;;
        --message) (( $# > 1 )) || die '--message requires TEXT'; message="$2"; shift 2 ;;
        --message=*) message="${1#*=}"; shift ;;
        --message-file) (( $# > 1 )) || die '--message-file requires PATH'; message_file="$2"; shift 2 ;;
        --message-file=*) message_file="${1#*=}"; shift ;;
        --attachment) (( $# > 1 )) || die '--attachment requires PATH'; attachment="$2"; shift 2 ;;
        --attachment=*) attachment="${1#*=}"; shift ;;
        --reply-to) (( $# > 1 )) || die '--reply-to requires ID'; reply_to="$2"; shift 2 ;;
        --reply-to=*) reply_to="${1#*=}"; shift ;;
        *) die "unknown $action option: $1" ;;
      esac
    done
    [[ "$action" != complete || "$to" == foreman ]] || die 'complete reports may address only the foreman'
    [[ "$to" == foreman || "$to" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die 'invalid recipient'
    [[ -z "$reply_to" || "$reply_to" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$ ]] || die 'invalid reply identity'
    if [[ -n "$message_file" ]]; then
      message_file="$(inside_project_file "$message_file")" || die 'message file must be a single-link regular file in this worker checkout'
      (( $(stat -c %s -- "$message_file") <= 16384 )) || die 'message file exceeds 16384 bytes'
      message="$(<"$message_file")"
    fi
    [[ "$message" =~ [^[:space:]] ]] || die 'message must not be empty'
    (( $(LC_ALL=C printf %s "$message" | wc -c) <= 16384 )) || die 'message exceeds 16384 bytes'
    attachment_path=
    if [[ -n "$attachment" ]]; then
      attachment_path="$(inside_project_file "$attachment")" || die 'attachment must be a single-link regular file in this worker checkout'
      (( $(stat -c %s -- "$attachment_path") <= 16777216 )) || die 'attachment exceeds 16 MiB'
    fi
    id="$(message_id)"
    tmp="$(mktemp "$outbox/.message.XXXXXX")"
    jq -cn --arg id "$id" --arg campaign_id "$campaign" --arg sender "$sender" --arg to "$to" \
      --arg message "$message" --arg attachment "$attachment_path" --arg reply_to "$reply_to" \
      --arg action "$action" \
      --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:"sandcodex.team-worker-message.v1",action:(if $action=="complete" then "complete" else "message" end),id:$id,campaign_id:$campaign_id,
        sender:$sender,to:$to,message:$message,attachment:(if $attachment=="" then null else $attachment end),
        reply_to:(if $reply_to=="" then null else $reply_to end),created_at:$created_at}' >"$tmp"
    chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$outbox/$id.json"
    loop_control=not-requested
    if [[ "$completion" == true ]]; then
      loop_control=broker-pending
      if [[ -n "${SANDCODEX_LOOPER:-}" ]] && "$SANDCODEX_LOOPER" loop stop --json >/dev/null 2>&1; then
        loop_control=drain-after-current-turn
      fi
    fi
    jq -cn --arg id "$id" --arg to "$to" --arg action "$action" --arg loop_control "$loop_control" \
      '{schema:"sandcodex.team-worker-submit.v1",status:(if $action=="complete" then "completion-requested" else "queued" end),message_id:$id,to:$to,loop_control:$loop_control}'
    ;;
  inbox)
    (( $# == 0 )) || die 'inbox takes no arguments'
    shopt -s nullglob
    files=("$inbox"/*.json)
    if (( ${#files[@]} == 0 )); then
      printf '%s\n' '{"schema":"sandcodex.team-worker-inbox.v1","messages":[]}'
    else
      jq -s '{schema:"sandcodex.team-worker-inbox.v1",messages:.}' "${files[@]}"
    fi
    ;;
  ack)
    (( $# == 1 )) || die 'ack requires MESSAGE_ID'
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$ ]] || die 'ack requires a valid MESSAGE_ID'
    id="$(message_id)"; tmp="$(mktemp "$outbox/.ack.XXXXXX")"
    jq -cn --arg id "$id" --arg message_id "$1" --arg campaign_id "$campaign" --arg sender "$sender" \
      '{schema:"sandcodex.team-worker-message.v1",action:"ack",id:$id,campaign_id:$campaign_id,
        sender:$sender,to:"foreman",message_id:$message_id}' >"$tmp"
    chmod 600 -- "$tmp"; mv -fT -- "$tmp" "$outbox/$id.json"
    rm -f -- "$inbox/$1.json"
    jq -cn --arg id "$1" '{schema:"sandcodex.team-worker-submit.v1",status:"queued",acknowledged_message_id:$id}'
    ;;
  identity)
    (( $# == 0 )) || die 'identity takes no arguments'
    jq -cn --arg name "$sender" --arg campaign_id "$campaign" \
      '{schema:"sandcodex.team-member.v1",role:"worker",name:$name,campaign_id:$campaign_id}'
    ;;
  help|-h|--help)
    printf '%s\n' \
      'sandcodex-team reply --message TEXT [--to foreman|WORKER] [--reply-to ID] [--attachment PATH]' \
      'sandcodex-team complete --message FINAL_REPORT [--attachment PATH]' \
      'sandcodex-team inbox' 'sandcodex-team ack MESSAGE_ID' 'sandcodex-team identity'
    ;;
  *) die 'workers may use reply, send, complete, inbox, ack, identity, or help only' ;;
esac
EOF
    } | sc_atomic "$helper" 500
  elif (( SC_CAMPAIGN_AVAILABLE )); then
    {
      printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
      printf 'exec %q team "$@"\n' "$SC_LOCAL/launcher/sandcodex"
    } | sc_atomic "$helper" 500
  elif [[ -e "$helper" || -L "$helper" ]]; then
    sc_owned_single_file "$helper" 500 "agent team helper"
    rm -f -- "$helper"
  fi
}

