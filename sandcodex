static int expect_errno(long result, int expected, const char *name) {
  if (result != -1 || errno != expected) {
    fprintf(stderr, "sand-jail-seccomp: %s was not denied as expected (result=%ld errno=%d)\n",
            name, result, errno);
    return 0;
  }
  return 1;
}

static int self_test(void) {
  int ok = 1;
#ifdef SYS_unshare
  errno = 0; ok &= expect_errno(syscall(SYS_unshare, 0), EPERM, "unshare");
#endif
#ifdef SYS_keyctl
  errno = 0; ok &= expect_errno(syscall(SYS_keyctl, -1, 0, 0, 0, 0), EPERM, "keyctl");
#endif
#ifdef SYS_bpf
  errno = 0; ok &= expect_errno(syscall(SYS_bpf, -1, 0, 0), EPERM, "bpf");
#endif
#ifdef SYS_clone3
  errno = 0; ok &= expect_errno(syscall(SYS_clone3, 0, 0), ENOSYS, "clone3");
#endif
#ifdef SYS_socketpair
