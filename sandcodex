sc_gemini_adapter_install_current() {
  local generated store
  sc_gemini_runtime_prepare
  sc_ensure_dir "$SC_CONTROL/gemini-adapters" "project Gemini adapter store"
  generated="$SC_GEMINI_RUNTIME_ROOT/gemini-responses-adapter.py"
  sc_emit_gemini_responses_adapter | sc_atomic "$generated" 500
  SC_GEMINI_ADAPTER_SHA256="$(sha256sum -- "$generated" | awk '{print $1}')"
  store="$SC_CONTROL/gemini-adapters/$SC_GEMINI_ADAPTER_SHA256.py"
  if [[ -e "$store" || -L "$store" ]]; then
    sc_owned_single_file "$store" 500 "project Gemini adapter"
    cmp -s -- "$generated" "$store" || sc_die "stored Gemini adapter conflicts with its digest" 78
  else
    sc_atomic "$store" 500 <"$generated"
  fi
  SC_GEMINI_ADAPTER_SCRIPT=$store
  python3 -P "$SC_GEMINI_ADAPTER_SCRIPT" self-test >/dev/null ||
    sc_die "embedded Gemini Responses adapter failed its offline self-test" 78
}

sc_gemini_adapter_load_snapshot() {
  local snapshot=$1 expected descriptor adapter_sha adapter_path
  sc_owned_single_file "$snapshot" 600 "Gemini provider snapshot"
  jq -e --arg schema "$SC_GEMINI_ADAPTER_SCHEMA" --arg state "$SC_GEMINI_ADAPTER_STATE_SCHEMA" \
    --arg codex "$SC_CODEX_VERSION" '
      type=="object" and .schema=="sandcodex.gemini-provider-snapshot.v1" and
      .provider=="google-ai-studio" and .wire_api=="responses" and
      .upstream_api=="gemini-interactions" and .upstream_api_version=="v1" and
      .api_base=="https://generativelanguage.googleapis.com/v1" and
      .adapter.schema==$schema and .adapter.state_schema==$state and
      .adapter.protocol_revision=="responses-interactions-stateless-v1" and
      .adapter.codex_version==$codex and
      (.adapter.sha256|test("^[0-9a-f]{64}$")) and
      (.routing_model|type)=="string" and (.auto|type)=="boolean" and
      (.candidate_models|type)=="array" and (.candidate_models|length)>0 and
      all(.candidate_models[]; type=="string" and test("^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$")) and
      .free_only==true and .capabilities.native_search==false and
      .capabilities.web_access=="sandcodex-browser" and
      .credential_values_disclosed==false
    ' "$snapshot" >/dev/null || sc_die "Gemini provider snapshot is malformed" 78
  descriptor="$(sha256sum -- "$snapshot" | awk '{print $1}')"
  [[ "${snapshot##*/}" == "$descriptor.json" ]] || sc_die "Gemini snapshot filename does not match its digest" 78
  adapter_sha="$(jq -er '.adapter.sha256' "$snapshot")"
  adapter_path="$SC_CONTROL/gemini-adapters/$adapter_sha.py"
  sc_owned_single_file "$adapter_path" 500 "bound Gemini adapter"
  [[ "$(sha256sum -- "$adapter_path" | awk '{print $1}')" == "$adapter_sha" ]] ||
    sc_die "bound Gemini adapter changed" 78
  python3 -P "$adapter_path" self-test >/dev/null || sc_die "bound Gemini adapter failed its offline self-test" 78
  SC_GEMINI_SNAPSHOT=$snapshot
  SC_GEMINI_SNAPSHOT_SHA256=$descriptor
  SC_GEMINI_NATIVE_PROVIDER="scg_$descriptor"
  SC_GEMINI_ADAPTER_SHA256=$adapter_sha
  SC_GEMINI_ADAPTER_SCRIPT=$adapter_path
  SC_GEMINI_AUTO="$(jq -r 'if .auto then 1 else 0 end' "$snapshot")"
  SC_MODEL="$(jq -er '.routing_model' "$snapshot")"; SC_MODEL_SET=1
  if (( SC_GEMINI_AUTO )); then
    SC_GEMINI_MODEL="$SC_GEMINI_DEFAULT_MODEL"; SC_GEMINI_MODEL_EXPLICIT=0
  else
    SC_GEMINI_MODEL="$(jq -er '.candidate_models[0]' "$snapshot")"; SC_GEMINI_MODEL_EXPLICIT=1
  fi
}

sc_gemini_adapter_prepare_snapshot() {
  local snapshot descriptor
  if [[ -n "$SC_GEMINI_SNAPSHOT" ]]; then
    sc_gemini_adapter_load_snapshot "$SC_GEMINI_SNAPSHOT"
    return
  fi
  sc_gemini_adapter_install_current
  snapshot="$(sc_gemini_adapter_snapshot_json "$SC_GEMINI_ADAPTER_SHA256")"
  descriptor="$(printf '%s\n' "$snapshot" | sha256sum | awk '{print $1}')"
  sc_ensure_dir "$SC_CONTROL/gemini-providers" "project Gemini provider snapshots"
  SC_GEMINI_SNAPSHOT="$SC_CONTROL/gemini-providers/$descriptor.json"
  if [[ -e "$SC_GEMINI_SNAPSHOT" || -L "$SC_GEMINI_SNAPSHOT" ]]; then
    sc_owned_single_file "$SC_GEMINI_SNAPSHOT" 600 "Gemini provider snapshot"
    [[ "$(jq -cS . "$SC_GEMINI_SNAPSHOT")" == "$snapshot" ]] ||
      sc_die "Gemini provider snapshot conflicts with its descriptor" 78
  else
    printf '%s\n' "$snapshot" | sc_atomic "$SC_GEMINI_SNAPSHOT" 600
  fi
  SC_GEMINI_SNAPSHOT_SHA256=$descriptor
  SC_GEMINI_NATIVE_PROVIDER="scg_$descriptor"
}

sc_gemini_adapter_start() {
  local staged candidates token config_log attempt pid_in_ready python_bin request_evidence
  sc_gemini_runtime_prepare
  [[ -n "$SC_GEMINI_ADAPTER_SCRIPT" && -n "$SC_GEMINI_SNAPSHOT" ]] ||
    sc_die "Gemini adapter snapshot was not prepared" 78
  staged="$(sc_gemini_keybank_stage)"
  if [[ -n "$SC_GEMINI_KEY_LABEL" ]]; then
    jq -e --arg label "$SC_GEMINI_KEY_LABEL" 'any(.keys[]; .label==$label)' <<<"$staged" >/dev/null || {
      sc_gemini_keybank_unstage "$staged"
      sc_die "Gemini key label is not present in the trusted bank" 78
    }
    staged="$(jq -c --arg label "$SC_GEMINI_KEY_LABEL" '.keys |= map(select(.label==$label)) | .key_count=(.keys|length)' <<<"$staged")"
  fi
  SC_GEMINI_ADAPTER_STAGE_JSON=$staged
  candidates="$(jq -c '.candidate_models' "$SC_GEMINI_SNAPSHOT")"
  SC_GEMINI_ADAPTER_TOKEN_FILE="$SC_CONTROL/codex-home/gemini-adapter-token"
  token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  [[ "$token" =~ ^[0-9a-f]{64}$ ]] || sc_die "could not generate Gemini adapter token" 70
  printf '%s' "$token" | sc_atomic "$SC_GEMINI_ADAPTER_TOKEN_FILE" 600
  token=""
  SC_GEMINI_ADAPTER_CONFIG="$SC_GEMINI_RUNTIME_ROOT/gemini-adapter-config.json"
  request_evidence="$SC_CONTROL/gemini-request-evidence-$SC_RUN_ID.jsonl"
  [[ ! -e "$request_evidence" && ! -L "$request_evidence" ]] ||
    sc_die "Gemini request-evidence destination already exists" 78
  jq -n \
    --arg schema sandcodex.gemini-adapter-config.v1 \
    --arg api_base "$SC_GEMINI_API_BASE" \
    --arg routing_model "$SC_MODEL" \
    --arg cooldown_path "$(sc_gemini_cooldowns_path)" \
    --arg adapter_sha "$SC_GEMINI_ADAPTER_SHA256" \
    --arg request_evidence_path "$request_evidence" \
    --argjson auto "$SC_GEMINI_AUTO" \
    --argjson ignore "$SC_GEMINI_IGNORE_COOLDOWNS" \
    --argjson rotation_target "$SC_GEMINI_ROTATION_TARGET_ACCOUNTS" \
    --argjson route_wait "$SC_GEMINI_ROUTE_WAIT_SECONDS" \
    --argjson candidates "$candidates" \
    --argjson key_bank "$staged" '
      {schema:$schema,api_base:$api_base,routing_model:$routing_model,
       auto:($auto==1),free_only:true,allow_native_search:false,
       ignore_cooldowns:($ignore==1),candidate_models:$candidates,
       rotation_target_accounts:$rotation_target,
       key_bank:$key_bank,cooldown_path:$cooldown_path,adapter_sha256:$adapter_sha,
       request_evidence_path:$request_evidence_path,
       upstream_timeout_seconds:120,route_wait_seconds:$route_wait,max_concurrency:8,
       credential_values_disclosed:false}' |
    sc_atomic "$SC_GEMINI_ADAPTER_CONFIG" 600
  SC_GEMINI_ADAPTER_READY="$SC_GEMINI_RUNTIME_ROOT/gemini-adapter-ready.json"
  config_log="$SC_GEMINI_RUNTIME_ROOT/gemini-adapter.stderr"
  : >"$config_log"; chmod 600 -- "$config_log"
  python_bin="$(command -v python3)"
  [[ "$python_bin" == /* && -x "$python_bin" ]] || sc_die "pinned Python is unavailable for the Gemini adapter" 70
  # The long-lived credential-bearing adapter needs no ambient user session.
  # Give it only its interpreter path and private runtime home so unrelated
  # tokens, shell hooks, and inherited secrets never become reachable state.
  env -i PATH="${python_bin%/*}" HOME="$SC_GEMINI_RUNTIME_ROOT" \
    TMPDIR="$SC_GEMINI_RUNTIME_ROOT" LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    "$python_bin" -P "$SC_GEMINI_ADAPTER_SCRIPT" serve \
    --config "$SC_GEMINI_ADAPTER_CONFIG" \
    --token-file "$SC_GEMINI_ADAPTER_TOKEN_FILE" \
    --ready-file "$SC_GEMINI_ADAPTER_READY" --host 127.0.0.1 --port 0 \
    </dev/null > /dev/null 2>"$config_log" &
  SC_GEMINI_ADAPTER_PID=$!
  SC_GEMINI_ADAPTER_START="$(sc_process_start "$SC_GEMINI_ADAPTER_PID" 2>/dev/null || true)"
  [[ "$SC_GEMINI_ADAPTER_START" =~ ^[0-9]+$ ]] || sc_die "Gemini adapter did not start safely" 70
  for attempt in {1..250}; do
    sc_pid_still_matches "$SC_GEMINI_ADAPTER_PID" "$SC_GEMINI_ADAPTER_START" || break
    if [[ -f "$SC_GEMINI_ADAPTER_READY" && ! -L "$SC_GEMINI_ADAPTER_READY" ]]; then
      if jq -e --argjson pid "$SC_GEMINI_ADAPTER_PID" '
          .schema=="sandcodex.gemini-adapter-ready.v1" and .status=="ready" and
          .pid==$pid and (.port|type)=="number" and .port>=1 and .port<=65535 and
          .host=="127.0.0.1" and .credential_values_disclosed==false
        ' "$SC_GEMINI_ADAPTER_READY" >/dev/null 2>&1; then
        break
      fi
    fi
    sleep 0.02
  done
  sc_owned_single_file "$SC_GEMINI_ADAPTER_READY" 600 "Gemini adapter readiness receipt"
  pid_in_ready="$(jq -er '.pid' "$SC_GEMINI_ADAPTER_READY")"
  [[ "$pid_in_ready" == "$SC_GEMINI_ADAPTER_PID" ]] || sc_die "Gemini adapter readiness PID mismatch" 78
  SC_GEMINI_ADAPTER_HOST_PORT="$(jq -er '.port' "$SC_GEMINI_ADAPTER_READY")"
  [[ "$SC_GEMINI_ADAPTER_HOST_PORT" =~ ^[1-9][0-9]{0,4}$ && "$SC_GEMINI_ADAPTER_HOST_PORT" -le 65535 ]] ||
    sc_die "Gemini adapter readiness port is invalid" 78
  SC_PROVIDER_BRIDGE_HOST_PORT=$SC_GEMINI_ADAPTER_HOST_PORT
}

sc_gemini_adapter_configure_codex() {
  local base visible stream_idle_ms request_scope
  [[ -n "$SC_GEMINI_NATIVE_PROVIDER" && -n "$SC_GEMINI_ADAPTER_TOKEN_FILE" && -n "$SC_GEMINI_ADAPTER_HOST_PORT" ]] ||
    sc_die "Gemini provider configuration is incomplete" 78
  request_scope=$SC_PROVIDER_REQUEST_SCOPE
  [[ "$request_scope" =~ ^[0-9a-f]{32}$ ]] ||
    sc_die "Gemini provider request scope is invalid" 78
  if (( SC_BARE )); then
    base="http://127.0.0.1:$SC_GEMINI_ADAPTER_HOST_PORT/v1"
    visible=$SC_GEMINI_ADAPTER_TOKEN_FILE
  else
    base="http://127.0.0.1:$SC_GEMINI_ADAPTER_NAMESPACE_PORT/v1"
    visible="$SC_SANDBOX_CONTROL/codex-home/gemini-adapter-token"
  fi
  # Google Search grounding is not available on the Developer API free tier.
  # Keep Codex's provider-hosted tool off; normal Sandcodex browser/MCP tools
  # remain available according to the launch's browser grant.
  printf -v SC_GEMINI_TOP_CONFIG 'model_provider = "%s"\nweb_search = "disabled"\n' "$SC_GEMINI_NATIVE_PROVIDER"
  stream_idle_ms=$(( (SC_GEMINI_ROUTE_WAIT_SECONDS + 180) * 1000 ))
  printf -v SC_GEMINI_PROVIDER_CONFIG '\n[model_providers.%s]\nname = "Sandcodex Gemini Interactions adapter"\nbase_url = %s\nwire_api = "responses"\nrequires_openai_auth = false\nsupports_websockets = false\nstream_idle_timeout_ms = %s\nhttp_headers = { "X-Sandcodex-Request-Scope" = %s }\n[model_providers.%s.auth]\ncommand = %s\nargs = [%s]\n' \
    "$SC_GEMINI_NATIVE_PROVIDER" "$(sc_toml "$base")" "$stream_idle_ms" "$(sc_toml "$request_scope")" \
    "$SC_GEMINI_NATIVE_PROVIDER" "$(sc_toml "$(command -v cat)")" "$(sc_toml "$visible")"
  sc_log_event info provider_request_scope "Gemini request scope prepared" \
    "scope_ref=$request_scope" "content_retained=false"
  sc_note "gemini · Interactions v1 through owned Responses adapter · route $SC_MODEL · $(jq -r '.key_count' <<<"$SC_GEMINI_ADAPTER_STAGE_JSON") protected account key(s) · automatic quota rotation · route wait ${SC_GEMINI_ROUTE_WAIT_SECONDS}s"
}

