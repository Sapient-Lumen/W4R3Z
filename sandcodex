    int pair[2];
    if (socketpair(AF_UNIX, SOCK_STREAM, 0, pair) != 0) {
      perror("socketpair");
      ok = 0;
    } else {
      close(pair[0]);
      close(pair[1]);
    }
  }
#endif
  if (!ok) return 126;
  puts("seccomp-leaf-ok");
  return 0;
}

int main(int argc, char **argv) {
  if (argc < 2) {
    fputs("usage: seccomp-exec COMMAND [ARG...]\n", stderr);
    return 64;
  }
