+static bool sandcodex_capture_touchpad_swipe_target(struct sway_seat *seat,
+        int64_t x, int64_t y, struct sandcodex_hit_target *target,
+        struct sway_view **view_out, struct wlr_surface **view_surface_out,
+        struct wlr_surface **target_surface_out,
+        struct wlr_seat_client **focused_client_out,
+        struct wl_resource **swipe_resource_out) {
+    if (focused_client_out) {
+        *focused_client_out = NULL;
+    }
+    if (swipe_resource_out) {
+        *swipe_resource_out = NULL;
+    }
+    if (!sandcodex_pointer_default_route(seat, 0, 0, 0, 0)) {
+        return false;
+    }
+    struct wlr_surface *target_surface = NULL;
+    if (!sandcodex_capture_hit_target(seat, (double)x, (double)y, target,
+            view_out, view_surface_out, &target_surface) || !target->hit ||
+            !target->surface_hit || !target_surface || !target_surface->resource ||
+            !seat_is_input_allowed(seat, target_surface)) {
+        return false;
+    }
+    struct wlr_seat_pointer_state *state = &seat->wlr_seat->pointer_state;
+    if (state->focused_surface != target_surface || !state->focused_client ||
+            state->focused_client->seat != seat->wlr_seat ||
+            wl_resource_get_client(target_surface->resource) !=
+                state->focused_client->client) {
+        return false;
+    }
+    uintptr_t resource_address = 0;
+    uint32_t resource_id = 0;
+    if (!sandcodex_pointer_swipe_recipient_exact(seat, state->focused_client,
+            0, 0, &resource_address, &resource_id) || resource_address == 0 ||
+            resource_id == 0) {
+        return false;
+    }
+    if (target_surface_out) {
+        *target_surface_out = target_surface;
+    }
+    if (focused_client_out) {
+        *focused_client_out = state->focused_client;
+    }
+    if (swipe_resource_out) {
+        *swipe_resource_out = (struct wl_resource *)resource_address;
+    }
+    return true;
+}
