static uint32_t monotonic_milliseconds(void) {
    struct timespec value = {0};
    if (clock_gettime(CLOCK_MONOTONIC, &value) < 0) {
        return 0U;
    }
    const uint64_t milliseconds =
        (uint64_t)value.tv_sec * UINT64_C(1000) + (uint64_t)value.tv_nsec / UINT64_C(1000000);
    return (uint32_t)(milliseconds & UINT32_MAX);
}

static uint32_t protocol_button(int button) {
    switch (button) {
    case 1:
        return BTN_LEFT_CODE;
    case 2:
        return BTN_MIDDLE_CODE;
    case 3:
        return BTN_RIGHT_CODE;
    default:
        return 0U;
    }
}

static bool parse_u64(const char *text, uint64_t minimum, uint64_t maximum, uint64_t *output) {
    if (text == NULL || *text == '\0' || *text == '-' || *text == '+') {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' || value < minimum || value > maximum) {
        return false;
    }
    *output = (uint64_t)value;
    return true;
}

static bool parse_i32(const char *text, int32_t minimum, int32_t maximum, int32_t *output) {
    if (text == NULL || *text == '\0' || (text[0] == '+' && text[1] == '\0')) {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const intmax_t value = strtoimax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' || value < minimum || value > maximum) {
        return false;
    }
    *output = (int32_t)value;
    return true;
}

static size_t tokenize(char *line, char **tokens) {
    size_t count = 0U;
    char *save = NULL;
    for (char *token = strtok_r(line, " \t\r\n", &save);
         token != NULL;
         token = strtok_r(NULL, " \t\r\n", &save)) {
        if (count == MAX_TOKENS) {
            return MAX_TOKENS + 1U;
        }
        tokens[count++] = token;
    }
    return count;
}

static bool parse_command(char *line, uint64_t expected_sequence, struct command *command) {
    char *tokens[MAX_TOKENS] = {0};
    const size_t count = tokenize(line, tokens);
    uint64_t sequence = 0U;
    if (count < 2U || count > MAX_TOKENS ||
            !parse_u64(tokens[0], 1U, UINT64_MAX, &sequence) || sequence != expected_sequence) {
        return false;
    }
    command->sequence = sequence;

    if (strcmp(tokens[1], "MOTION") == 0) {
        if (count != 6U ||
                !parse_i32(tokens[2], 0, (int32_t)MAX_EXTENT - 1, &command->values[0]) ||
                !parse_i32(tokens[3], 0, (int32_t)MAX_EXTENT - 1, &command->values[1]) ||
                !parse_i32(tokens[4], (int32_t)MIN_EXTENT, (int32_t)MAX_EXTENT, &command->values[2]) ||
                !parse_i32(tokens[5], (int32_t)MIN_EXTENT, (int32_t)MAX_EXTENT, &command->values[3]) ||
                command->values[0] >= command->values[2] || command->values[1] >= command->values[3]) {
            return false;
        }
        command->kind = COMMAND_MOTION;
        return true;
    }
    if (strcmp(tokens[1], "BUTTON") == 0) {
        if (count != 4U ||
                !parse_i32(tokens[2], 1, 3, &command->values[0]) ||
                !parse_i32(tokens[3], 0, 1, &command->values[1])) {
            return false;
        }
        command->kind = COMMAND_BUTTON;
        return true;
    }
    if (strcmp(tokens[1], "CLICK") == 0) {
        if (count != 3U || !parse_i32(tokens[2], 1, 3, &command->values[0])) {
            return false;
        }
        command->kind = COMMAND_CLICK;
        return true;
    }
    if (strcmp(tokens[1], "SCROLL") == 0) {
        if (count != 4U ||
                !parse_i32(tokens[2], -1, 1, &command->values[0]) ||
                !parse_i32(tokens[3], -1, 1, &command->values[1]) ||
                (command->values[0] == 0 && command->values[1] == 0)) {
            return false;
        }
        command->kind = COMMAND_SCROLL;
        return true;
    }
    if (strcmp(tokens[1], "PING") == 0 && count == 2U) {
        command->kind = COMMAND_PING;
        return true;
    }
    if (strcmp(tokens[1], "QUIT") == 0 && count == 2U) {
        command->kind = COMMAND_QUIT;
        return true;
    }
    return false;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct wayland_state *state = data;
    if (strcmp(interface, zwlr_virtual_pointer_manager_v1_interface.name) == 0) {
        state->manager_count++;
        if (state->manager == NULL) {
            state->manager_version = version < 2U ? version : 2U;
            state->manager = wl_registry_bind(registry, name,
                &zwlr_virtual_pointer_manager_v1_interface, state->manager_version);
        }
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        if (state->seat == NULL) {
            state->seat = wl_registry_bind(registry, name, &wl_seat_interface, version < 1U ? version : 1U);
        }
    } else if (strcmp(interface, wl_output_interface.name) == 0) {
        state->output_count++;
        if (state->output == NULL) {
            state->output = wl_registry_bind(registry, name, &wl_output_interface, version < 1U ? version : 1U);
        }
    }
}

