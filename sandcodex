+static void sandcodex_send_hit_target(struct ipc_client *client,
+		const char *operation, int64_t x, int64_t y,
+		const struct sandcodex_hit_target *target, struct sway_view *view,
+		const char *dispatch_ticket, enum sandcodex_dispatch_kind dispatch_kind,
+		int32_t delta_x, int32_t delta_y, int64_t from_x, int64_t from_y,
+		uint32_t button, const struct sandcodex_hit_target *source_target,
+		struct sway_view *source_view) {
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(true));
+	json_object_object_add(reply, "operation", json_object_new_string(operation));
+	json_object_object_add(reply, "x", json_object_new_int64(x));
+	json_object_object_add(reply, "y", json_object_new_int64(y));
+	json_object_object_add(reply, "dispatch_ticket", dispatch_ticket
+		? json_object_new_string(dispatch_ticket) : NULL);
+	if (dispatch_kind == SANDCODEX_DISPATCH_SCROLL) {
+		json_object_object_add(reply, "delta_x", json_object_new_int(delta_x));
+		json_object_object_add(reply, "delta_y", json_object_new_int(delta_y));
+	}
+	if (dispatch_kind == SANDCODEX_DISPATCH_MOTION ||
+			dispatch_kind == SANDCODEX_DISPATCH_DRAG_MOTION) {
+		json_object_object_add(reply, "from_x", json_object_new_int64(from_x));
+		json_object_object_add(reply, "from_y", json_object_new_int64(from_y));
+	}
+	if (dispatch_kind == SANDCODEX_DISPATCH_DRAG_PRESS ||
+			dispatch_kind == SANDCODEX_DISPATCH_DRAG_MOTION ||
+			dispatch_kind == SANDCODEX_DISPATCH_DRAG_RELEASE) {
+		json_object_object_add(reply, "button", json_object_new_int(button));
+	}
+	if (dispatch_kind == SANDCODEX_DISPATCH_DRAG_MOTION) {
+		json_object *source_reply = json_object_new_object();
+		sandcodex_json_add_hit_target(source_reply, source_target, source_view);
+		json_object_object_add(reply, "source_target", source_reply);
+	}
+	sandcodex_json_add_hit_target(reply, target, view);
+	const char *json_string = json_object_to_json_string_ext(reply,
+		JSON_C_TO_STRING_PLAIN);
+	ipc_send_reply(client, IPC_SANDCODEX_HIT_TEST, json_string,
+		(uint32_t)strlen(json_string));
+	json_object_put(reply);
+}
