    def guarded_eraser_stroke(
        self,
        start_x: int,
        start_y: int,
        end_x: int,
        end_y: int,
        steps: int,
        pressure_start_65535: int,
        pressure_end_65535: int,
        tilt_x_degrees: int,
        tilt_y_degrees: int,
        rotation_present: bool,
        rotation_start_degrees: int,
        rotation_delta_degrees: int,
        slider_present: bool,
        slider_start_65535: int,
        slider_end_65535: int,
        distance_present: bool,
        distance_start_65535: int,
        distance_end_65535: int,
        wheel_present: bool,
        wheel_delta_degrees_256: int,
        wheel_clicks: int,
        wheel_step: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> dict[str, Any]:
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor eraser-stroke authority is unavailable")
        for label, coordinate in (
            ("start_x", start_x), ("start_y", start_y),
            ("end_x", end_x), ("end_y", end_y),
        ):
            if type(coordinate) is not int or not 0 <= coordinate <= SWAY_HIT_TEST_MAX_COORDINATE:
                raise ToolError(f"compositor eraser-stroke {label} exceeds the sealed range")
        if type(steps) is not int or not 1 <= steps <= STYLUS_STROKE_MAX_STEPS:
            raise ToolError("compositor eraser-stroke steps are outside the sealed range")
        for label, pressure in (
            ("pressure_start_65535", pressure_start_65535),
            ("pressure_end_65535", pressure_end_65535),
        ):
            if type(pressure) is not int or not STYLUS_PRESSURE_MIN_65535 <= pressure <= STYLUS_PRESSURE_MAX_65535:
                raise ToolError(f"compositor eraser-stroke {label} is outside the sealed range")
        for label, tilt in (
            ("tilt_x_degrees", tilt_x_degrees),
            ("tilt_y_degrees", tilt_y_degrees),
        ):
            if type(tilt) is not int or not STYLUS_TILT_MIN_DEGREES <= tilt <= STYLUS_TILT_MAX_DEGREES:
                raise ToolError(f"compositor eraser-stroke {label} is outside the sealed range")
        if type(rotation_present) is not bool:
            raise ToolError("compositor eraser-stroke rotation presence is invalid")
        if rotation_present:
            if type(rotation_start_degrees) is not int or not (
                STYLUS_ROTATION_START_MIN_DEGREES
                <= rotation_start_degrees
                <= STYLUS_ROTATION_START_MAX_DEGREES
            ):
                raise ToolError("compositor eraser-stroke rotation start is outside the sealed range")
            if type(rotation_delta_degrees) is not int or not (
                STYLUS_ROTATION_DELTA_MIN_DEGREES
                <= rotation_delta_degrees
                <= STYLUS_ROTATION_DELTA_MAX_DEGREES
            ):
                raise ToolError("compositor eraser-stroke rotation delta is outside the sealed range")
        elif rotation_start_degrees != 0 or rotation_delta_degrees != 0:
            raise ToolError("compositor eraser-stroke omitted rotation must use canonical zero fields")
        if type(slider_present) is not bool:
            raise ToolError("compositor eraser-stroke slider presence is invalid")
        if slider_present:
            for slider_label, slider in (
                ("slider_start_65535", slider_start_65535),
                ("slider_end_65535", slider_end_65535),
            ):
                if type(slider) is not int or not (
                    STYLUS_SLIDER_MIN_65535 <= slider <= STYLUS_SLIDER_MAX_65535
                ):
                    raise ToolError(
                        f"compositor eraser-stroke {slider_label} is outside the sealed range"
                    )
        elif slider_start_65535 != 0 or slider_end_65535 != 0:
            raise ToolError(
                "compositor eraser-stroke omitted slider must use canonical zero fields"
            )
        if type(distance_present) is not bool:
            raise ToolError("compositor eraser-stroke distance presence is invalid")
        if distance_present:
            for distance_label, distance in (
                ("distance_start_65535", distance_start_65535),
                ("distance_end_65535", distance_end_65535),
            ):
                if type(distance) is not int or not (
                    STYLUS_DISTANCE_MIN_65535 <= distance <= STYLUS_DISTANCE_MAX_65535
                ):
                    raise ToolError(
                        f"compositor eraser-stroke {distance_label} is outside the sealed range"
                    )
        elif distance_start_65535 != 0 or distance_end_65535 != 0:
            raise ToolError(
                "compositor eraser-stroke omitted distance must use canonical zero fields"
            )
        if type(wheel_present) is not bool:
            raise ToolError("compositor eraser-stroke wheel presence is invalid")
        if wheel_present:
            if type(wheel_delta_degrees_256) is not int or not (
                STYLUS_WHEEL_DELTA_MIN_DEGREES_256
                <= wheel_delta_degrees_256
                <= STYLUS_WHEEL_DELTA_MAX_DEGREES_256
            ):
                raise ToolError(
                    "compositor eraser-stroke wheel degree delta is outside the sealed range"
                )
            if type(wheel_clicks) is not int or not (
                STYLUS_WHEEL_CLICKS_MIN <= wheel_clicks <= STYLUS_WHEEL_CLICKS_MAX
            ):
                raise ToolError(
                    "compositor eraser-stroke wheel clicks are outside the sealed range"
                )
            if type(wheel_step) is not int or not 0 <= wheel_step <= steps:
                raise ToolError(
                    "compositor eraser-stroke wheel step is outside the sealed path"
                )
            if wheel_delta_degrees_256 == 0 and wheel_clicks == 0:
                raise ToolError(
                    "compositor eraser-stroke wheel pulse cannot be a zero-degree zero-click event"
                )
            if (
                wheel_delta_degrees_256 != 0
                and wheel_clicks != 0
                and (wheel_delta_degrees_256 < 0) != (wheel_clicks < 0)
            ):
                raise ToolError(
                    "compositor eraser-stroke wheel channels have conflicting directions"
                )
        elif (
            wheel_delta_degrees_256 != 0 or wheel_clicks != 0 or wheel_step != 0
        ):
            raise ToolError(
                "compositor eraser-stroke omitted wheel must use canonical zero fields"
            )
        if not callable(validator):
            raise ToolError("compositor eraser-stroke target validator is unavailable")

        action = {
            "end_x": end_x,
            "end_y": end_y,
            "pressure_end_65535": pressure_end_65535,
            "pressure_start_65535": pressure_start_65535,
            "rotation_delta_degrees": rotation_delta_degrees,
            "rotation_present": rotation_present,
            "rotation_start_degrees": rotation_start_degrees,
            "slider_end_65535": slider_end_65535,
            "slider_present": slider_present,
            "slider_start_65535": slider_start_65535,
            "distance_end_65535": distance_end_65535,
            "distance_present": distance_present,
            "distance_start_65535": distance_start_65535,
            "start_x": start_x,
            "start_y": start_y,
            "steps": steps,
            "tilt_x_degrees": tilt_x_degrees,
            "tilt_y_degrees": tilt_y_degrees,
            "wheel_clicks": wheel_clicks,
            "wheel_delta_degrees_256": wheel_delta_degrees_256,
            "wheel_present": wheel_present,
            "wheel_step": wheel_step,
        }
        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({"op": "arm-eraser-stroke", **action}),
                    "SANDCODEX_HIT_TEST arm-eraser-stroke",
                )
                target, ticket = self._normalize_eraser_stroke_arm_reply(
                    arm_reply, start_x, start_y, end_x, end_y, steps,
                    pressure_start_65535, pressure_end_65535,
                    tilt_x_degrees, tilt_y_degrees, rotation_present,
                    rotation_start_degrees, rotation_delta_degrees,
                    slider_present, slider_start_65535, slider_end_65535,
                    distance_present, distance_start_65535, distance_end_65535,
                    wheel_present, wheel_delta_degrees_256, wheel_clicks, wheel_step,
                )
                ticket_action = {"dispatch_kind": "eraser-stroke", **action}
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-eraser-stroke-ticket-v5\0"
                    + canonical_json(ticket_action) + b"\0" + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": ERASER_STROKE_DISPATCH_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-native-exact-recipient-tablet-v2-eraser-stroke",
                    "dispatch_kind": "eraser-stroke",
                    **action,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "lifetime_revocation": "view-surface+exact-hit-surface",
                    "dispatch_path": COMPOSITOR_ERASER_STROKE_DISPATCH_PATH,
                    "dispatch_atomicity": GUARDED_ERASER_STROKE_DISPATCH_ATOMICITY,
                    "route_scope": COMPOSITOR_ERASER_STROKE_ROUTE_SCOPE,
                    "path_scope": COMPOSITOR_ERASER_STROKE_PATH_SCOPE,
                    "axis_scope": COMPOSITOR_ERASER_STROKE_AXIS_SCOPE,
                    "rotation_scope": COMPOSITOR_STYLUS_ROTATION_SCOPE,
                    "slider_scope": COMPOSITOR_STYLUS_SLIDER_SCOPE,
                    "distance_scope": COMPOSITOR_STYLUS_DISTANCE_SCOPE,
                    "wheel_scope": COMPOSITOR_STYLUS_WHEEL_SCOPE,
                    "lifecycle_scope": COMPOSITOR_ERASER_STROKE_LIFECYCLE_SCOPE,
                    "native_protocol": "zwp_tablet_tool_v2",
                    "tool_type": "eraser",
                    "peer_tool_type": "pen",
                    "synthetic_tablet_tool_count": 2,
                    "tool_cohort_ready": True,
                    "selected_tool_exact": True,
                    "peer_tool_idle": True,
                    "tool_cohort_scope": COMPOSITOR_STYLUS_TOOL_COHORT_SCOPE,
                    "synthetic_tablet_initialization": "authorization-time",
                    "synthetic_tablet_lifetime": "sway-process",
                    "pointer_fallback_policy": "deny",
                    "touch_fallback_policy": "deny",
                    "key_fallback_policy": "deny",
                    "click_fallback_policy": "deny",
                    "scroll_fallback_policy": "deny",
                    "browser_fallback_policy": "deny",
                    "host_desktop_policy": "absent",
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorEraserStrokeGrant(
                    start_x=start_x, start_y=start_y, end_x=end_x, end_y=end_y,
                    steps=steps, pressure_start_65535=pressure_start_65535,
                    pressure_end_65535=pressure_end_65535,
                    tilt_x_degrees=tilt_x_degrees, tilt_y_degrees=tilt_y_degrees,
                    rotation_present=rotation_present,
                    rotation_start_degrees=rotation_start_degrees,
                    rotation_delta_degrees=rotation_delta_degrees,
                    rotation_final_degrees=(
                        stylus_rotation_degrees(
                            rotation_start_degrees, rotation_delta_degrees,
                            steps, steps,
                        ) if rotation_present else 0
                    ),
                    slider_present=slider_present,
                    slider_start_65535=slider_start_65535,
                    slider_end_65535=slider_end_65535,
                    slider_final_65535=(
                        stylus_slider_65535(
                            slider_start_65535, slider_end_65535, steps, steps,
                        ) if slider_present else 0
                    ),
                    distance_present=distance_present,
                    distance_start_65535=distance_start_65535,
                    distance_end_65535=distance_end_65535,
                    distance_final_65535=(
                        stylus_distance_65535(
                            distance_start_65535, distance_end_65535, steps, steps,
                        ) if distance_present else 0
                    ),
                    wheel_present=wheel_present,
                    wheel_delta_degrees_256=wheel_delta_degrees_256,
                    wheel_clicks=wheel_clicks,
                    wheel_step=wheel_step,
                    ticket=ticket, target=target, grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_eraser_stroke_arms += 1
                self.last_compositor_eraser_stroke_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_eraser_stroke_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor eraser stroke could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-eraser-stroke",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-eraser-stroke",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_eraser_stroke_reply(cancel_reply)
                    self.compositor_eraser_stroke_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_eraser_stroke_dispatch_failures += 1
                    self._set_failure(cancel_error)
                    raise ToolError(
                        "compositor eraser-stroke validation failed and its private "
                        "ticket could not be cancelled; the compositor seal is quarantined"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        **action,
                        "op": "dispatch-eraser-stroke",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-eraser-stroke",
                )
                dispatch_ticket = None
                receipt = self._normalize_dispatch_eraser_stroke_reply(
                    dispatch_reply, grant
                )
                self.compositor_eraser_stroke_dispatches += 1
                self.last_compositor_eraser_stroke_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return receipt
            except Exception as error:
                self.compositor_eraser_stroke_dispatch_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor eraser stroke failed closed: {error}"
                ) from error

    def _normalize_motion_arm_reply(
        self,
        value: Any,
        from_x: int,
        from_y: int,
        x: int,
        y: int,
    ) -> tuple[dict[str, Any], str]:
        if not isinstance(value, dict):
            raise RuntimeError("Sway compositor-motion arm reply is not an object")
        if value.get("operation") != "arm-motion":
            raise RuntimeError("Sway compositor-motion arm operation changed")
        for field, expected in (("from_x", from_x), ("from_y", from_y)):
            number = value.get(field)
            if type(number) is not int or number != expected:
                raise RuntimeError(f"Sway compositor-motion {field} coordinate changed")
        adapted = dict(value)
        adapted.pop("from_x", None)
        adapted.pop("from_y", None)
        adapted["operation"] = "arm-click"
        target, ticket = self._normalize_hit_test_reply(
            adapted,
            x,
            y,
