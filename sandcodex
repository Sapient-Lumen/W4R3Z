}

sc_remote_router_stop() {
  if [[ -n "${SC_REMOTE_ROUTER_PID:-}" ]]; then
    if [[ -n "$SC_REMOTE_ROUTER_START" ]]; then
      sc_stop_tracked_pid "$SC_REMOTE_ROUTER_PID" "$SC_REMOTE_ROUTER_START" TERM 20 || true
    else
      kill -TERM "$SC_REMOTE_ROUTER_PID" 2>/dev/null || true
    fi
    wait "$SC_REMOTE_ROUTER_PID" 2>/dev/null || true
    SC_REMOTE_ROUTER_PID=""; SC_REMOTE_ROUTER_START=""
  fi
  [[ -z "${SC_REMOTE_ROUTER_READY:-}" ]] || rm -f -- "$SC_REMOTE_ROUTER_READY" 2>/dev/null || true
  [[ -z "${SC_REMOTE_ROUTER_TOKEN_FILE:-}" ]] || rm -f -- "$SC_REMOTE_ROUTER_TOKEN_FILE" 2>/dev/null || true
}

sc_remote_router_snapshot_is_router() {
  [[ -n "${SC_REMOTE_SNAPSHOT:-}" && -f "$SC_REMOTE_SNAPSHOT" ]] || return 1
  jq -e '.name=="sandcodex_openrouter_router" and .base_url=="http://127.0.0.1:11435/v1" and .env_key=="SANDCODEX_REMOTE_ROUTER_TOKEN" and .wire_api=="responses"' \
    "$SC_REMOTE_SNAPSHOT" >/dev/null 2>&1
}

sc_remote_router_install_current() {
  local generated store
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  sc_ensure_dir "$SC_CONTROL/openrouter-routers" "project OpenRouter router store"
  [[ -n "$SC_REMOTE_ROUTER_RUNTIME_ROOT" ]] || {
    SC_REMOTE_ROUTER_RUNTIME_ROOT=$(mktemp -d "$SC_GLOBAL/runtime/.openrouter-router.XXXXXXXXXXXX")
    chmod 700 -- "$SC_REMOTE_ROUTER_RUNTIME_ROOT"
  }
  generated="$SC_REMOTE_ROUTER_RUNTIME_ROOT/openrouter-responses-router.py"
  sc_emit_openrouter_responses_router | sc_atomic "$generated" 500
  SC_REMOTE_ROUTER_SHA256=$(sha256sum -- "$generated" | awk '{print $1}')
  [[ "$SC_REMOTE_ROUTER_SHA256" =~ ^[0-9a-f]{64}$ ]] ||
    sc_die "embedded OpenRouter router digest is invalid" 78
  store="$SC_CONTROL/openrouter-routers/$SC_REMOTE_ROUTER_SHA256.py"
  if [[ -e "$store" || -L "$store" ]]; then
    sc_owned_single_file "$store" 500 "project OpenRouter router"
    cmp -s -- "$generated" "$store" || sc_die "stored OpenRouter router conflicts with its digest" 78
  else
    sc_atomic "$store" 500 <"$generated"
  fi
  SC_REMOTE_ROUTER_SCRIPT=$store
  python3 -P - "$SC_REMOTE_ROUTER_SCRIPT" <<'PY' ||
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_bytes()
compile(source, sys.argv[1], "exec")
PY
    sc_die "embedded OpenRouter Responses router failed its offline compile check" 78
}

sc_remote_router_snapshot_validate() {
  local snapshot=$1
  jq -e '
    type=="object" and .name=="sandcodex_openrouter_router" and
    .base_url=="http://127.0.0.1:11435/v1" and
    .env_key=="SANDCODEX_REMOTE_ROUTER_TOKEN" and .wire_api=="responses" and
    .router.schema=="sandcodex.openrouter-router-binding.v1" and
    (.router.artifact_sha256|test("^[0-9a-f]{64}$")) and
    (.router.artifact_path|type)=="string" and
    (.router.key_bank_path|type)=="string" and
    (.router.key_bank_sha256|test("^[0-9a-f]{64}$")) and
    (.router.model_bank_path|type)=="string" and
    (.router.model_bank_sha256|test("^[0-9a-f]{64}$")) and
    (.router.preferred_model|type)=="string" and
    (.router.preferred_key_id|test("^[0-9a-f]{12}$")) and
    (.router.candidate_models|type)=="array" and (.router.candidate_models|length)>0 and
    (.router.candidate_models|length)<=256 and
    all(.router.candidate_models[]; type=="string" and test("^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,191}$")) and
    .router.upstream=="https://openrouter.ai/api/v1/responses" and
    .router.commit_policy=="buffer-complete-response-before-downstream-bytes" and
    .router.tool_identity_policy=="exact-request-scoped-reverse-map" and
    .router.maximum_route_attempts==12 and .router.request_ceiling_seconds==240 and
    .router.visible_replay==false and .router.credential_values_disclosed==false
  ' "$snapshot" >/dev/null
}

sc_remote_router_verify_bound_files() {
  local source observed
  sc_remote_router_snapshot_validate "$SC_REMOTE_SNAPSHOT" ||
    sc_die "bound OpenRouter router snapshot is malformed" 78
  SC_REMOTE_ROUTER_SHA256=$(jq -er '.router.artifact_sha256' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_SCRIPT=$(jq -er '.router.artifact_path' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_KEY_BANK=$(jq -er '.router.key_bank_path' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_KEY_BANK_SHA256=$(jq -er '.router.key_bank_sha256' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_MODEL_BANK=$(jq -er '.router.model_bank_path' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_MODEL_BANK_SHA256=$(jq -er '.router.model_bank_sha256' "$SC_REMOTE_SNAPSHOT")
  SC_REMOTE_ROUTER_PREFERRED_KEY_ID=$(jq -er '.router.preferred_key_id' "$SC_REMOTE_SNAPSHOT")
  [[ "$SC_REMOTE_ROUTER_SCRIPT" == "$SC_CONTROL/openrouter-routers/$SC_REMOTE_ROUTER_SHA256.py" ]] ||
    sc_die "bound OpenRouter router artifact lies outside its project store" 78
  [[ "$SC_REMOTE_ROUTER_KEY_BANK" == "$SC_CONTROL/openrouter-auto-key-bank.txt" ]] ||
    sc_die "bound OpenRouter key bank lies outside its project store" 78
  [[ "$SC_REMOTE_ROUTER_MODEL_BANK" == "$SC_CONTROL/openrouter-auto-model-bank.json" ]] ||
    sc_die "bound OpenRouter model bank lies outside its project store" 78
  for source in "$SC_REMOTE_ROUTER_SCRIPT" "$SC_REMOTE_ROUTER_KEY_BANK" "$SC_REMOTE_ROUTER_MODEL_BANK"; do
    sc_no_symlink_components "$source" "bound OpenRouter router input"
  done
  sc_owned_single_file "$SC_REMOTE_ROUTER_SCRIPT" 500 "bound OpenRouter router artifact"
  sc_owned_single_file "$SC_REMOTE_ROUTER_KEY_BANK" 600 "bound OpenRouter router key bank"
  sc_owned_single_file "$SC_REMOTE_ROUTER_MODEL_BANK" 600 "bound OpenRouter router model bank"
  observed=$(sha256sum -- "$SC_REMOTE_ROUTER_SCRIPT" | awk '{print $1}')
  [[ "$observed" == "$SC_REMOTE_ROUTER_SHA256" ]] || sc_die "bound OpenRouter router artifact changed" 78
  observed=$(sha256sum -- "$SC_REMOTE_ROUTER_KEY_BANK" | awk '{print $1}')
  [[ "$observed" == "$SC_REMOTE_ROUTER_KEY_BANK_SHA256" ]] || sc_die "bound OpenRouter router key bank changed" 78
  observed=$(sha256sum -- "$SC_REMOTE_ROUTER_MODEL_BANK" | awk '{print $1}')
  [[ "$observed" == "$SC_REMOTE_ROUTER_MODEL_BANK_SHA256" ]] || sc_die "bound OpenRouter router model bank changed" 78
  [[ "$SC_MODEL" == "$(jq -er '.router.preferred_model' "$SC_REMOTE_SNAPSHOT")" ]] ||
    sc_die "bound OpenRouter router preferred model differs from the conversation model" 78
  python3 -P - "$SC_REMOTE_ROUTER_SCRIPT" <<'PY' ||
from pathlib import Path
import sys
source = Path(sys.argv[1]).read_bytes()
compile(source, sys.argv[1], "exec")
PY
    sc_die "bound OpenRouter router artifact no longer compiles" 78
}

sc_remote_router_create_snapshot() {
  local snapshot descriptor candidates preferred_key_id
  [[ -n "$SC_REMOTE_ROUTER_SCRIPT" && -n "$SC_REMOTE_ROUTER_KEY_BANK" &&
     -n "$SC_REMOTE_ROUTER_MODEL_BANK" ]] ||
    sc_die "OpenRouter router inputs are incomplete before snapshot creation" 78
  candidates=$(jq -c '[.models[] | select(.free==true and .agent_candidate==true) | .id]' \
    "$SC_REMOTE_ROUTER_MODEL_BANK") || sc_die "OpenRouter router candidate bank is invalid" 78
  jq -e --arg model "$SC_MODEL" 'type=="array" and length>0 and length<=256 and index($model)!=null' \
    <<<"$candidates" >/dev/null || sc_die "selected OpenRouter model is absent from the router candidate bank" 78
  preferred_key_id=$(jq -er '.key_id | select(test("^[0-9a-f]{12}$"))' "$SC_REMOTE_AUTO_SELECTION_JSON") ||
    sc_die "selected OpenRouter key identity is absent before router snapshot creation" 78
  SC_REMOTE_ROUTER_PREFERRED_KEY_ID=$preferred_key_id
  snapshot=$(jq -cnS \
    --arg artifact "$SC_REMOTE_ROUTER_SCRIPT" --arg artifact_sha "$SC_REMOTE_ROUTER_SHA256" \
    --arg key_bank "$SC_REMOTE_ROUTER_KEY_BANK" --arg key_bank_sha "$SC_REMOTE_ROUTER_KEY_BANK_SHA256" \
    --arg model_bank "$SC_REMOTE_ROUTER_MODEL_BANK" --arg model_bank_sha "$SC_REMOTE_ROUTER_MODEL_BANK_SHA256" \
    --arg preferred "$SC_MODEL" --arg preferred_key "$preferred_key_id" --argjson candidates "$candidates" '
      {name:"sandcodex_openrouter_router",base_url:"http://127.0.0.1:11435/v1",
       env_key:"SANDCODEX_REMOTE_ROUTER_TOKEN",wire_api:"responses",
       router:{schema:"sandcodex.openrouter-router-binding.v1",
         artifact_path:$artifact,artifact_sha256:$artifact_sha,
         key_bank_path:$key_bank,key_bank_sha256:$key_bank_sha,
         model_bank_path:$model_bank,model_bank_sha256:$model_bank_sha,
         preferred_model:$preferred,preferred_key_id:$preferred_key,candidate_models:$candidates,
         upstream:"https://openrouter.ai/api/v1/responses",
         commit_policy:"buffer-complete-response-before-downstream-bytes",
         tool_identity_policy:"exact-request-scoped-reverse-map",
         maximum_route_attempts:12,request_ceiling_seconds:240,
         visible_replay:false,credential_values_disclosed:false}}')
  descriptor=$(printf '%s\n' "$snapshot" | sha256sum | awk '{print $1}')
  SC_REMOTE_SNAPSHOT="$SC_CONTROL/remote-providers/$descriptor.json"
  if [[ -e "$SC_REMOTE_SNAPSHOT" || -L "$SC_REMOTE_SNAPSHOT" ]]; then
    sc_owned_single_file "$SC_REMOTE_SNAPSHOT" 600 "OpenRouter router snapshot"
    [[ "$(jq -cS . "$SC_REMOTE_SNAPSHOT")" == "$snapshot" ]] ||
      sc_die "OpenRouter router snapshot conflicts with its descriptor" 78
  else
    printf '%s\n' "$snapshot" | sc_atomic "$SC_REMOTE_SNAPSHOT" 600
  fi
  SC_REMOTE_NATIVE_PROVIDER="scr_$descriptor"
}

sc_remote_router_start() {
  local token python_bin log attempt pid_in_ready
  [[ -n "$SC_REMOTE_ROUTER_SCRIPT" && -n "$SC_REMOTE_ROUTER_KEY_BANK" &&
     -n "$SC_REMOTE_ROUTER_MODEL_BANK" && "$SC_REMOTE_ROUTER_PREFERRED_KEY_ID" =~ ^[0-9a-f]{12}$ ]] ||
    sc_die "OpenRouter router inputs are incomplete" 78
  [[ -n "$SC_REMOTE_ROUTER_RUNTIME_ROOT" ]] || {
    sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
    SC_REMOTE_ROUTER_RUNTIME_ROOT=$(mktemp -d "$SC_GLOBAL/runtime/.openrouter-router.XXXXXXXXXXXX")
    chmod 700 -- "$SC_REMOTE_ROUTER_RUNTIME_ROOT"
  }
  SC_REMOTE_ROUTER_TOKEN_FILE="$SC_CONTROL/codex-home/remote-api-token"
  token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  [[ "$token" =~ ^[0-9a-f]{64}$ ]] || sc_die "could not generate OpenRouter router token" 70
  printf '%s' "$token" | sc_atomic "$SC_REMOTE_ROUTER_TOKEN_FILE" 600
  token=""
  SC_REMOTE_TOKEN_FILE=$SC_REMOTE_ROUTER_TOKEN_FILE
  SC_REMOTE_ROUTER_READY="$SC_REMOTE_ROUTER_RUNTIME_ROOT/ready.json"
  SC_REMOTE_ROUTER_STATE="$SC_CONTROL/openrouter-router-state.json"
  log="$SC_REMOTE_ROUTER_RUNTIME_ROOT/router.stderr"
  : >"$log"; chmod 600 -- "$log"
  python_bin=$(command -v python3)
  [[ "$python_bin" == /* && -x "$python_bin" ]] || sc_die "pinned Python is unavailable for the OpenRouter router" 70
  env -i PATH="${python_bin%/*}" HOME="$SC_REMOTE_ROUTER_RUNTIME_ROOT" \
    TMPDIR="$SC_REMOTE_ROUTER_RUNTIME_ROOT" LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    "$python_bin" -P "$SC_REMOTE_ROUTER_SCRIPT" \
      --key-bank "$SC_REMOTE_ROUTER_KEY_BANK" --model-bank "$SC_REMOTE_ROUTER_MODEL_BANK" \
      --preferred-model "$SC_MODEL" --preferred-key-id "$SC_REMOTE_ROUTER_PREFERRED_KEY_ID" \
      --client-token-file "$SC_REMOTE_ROUTER_TOKEN_FILE" \
      --state "$SC_REMOTE_ROUTER_STATE" --ready "$SC_REMOTE_ROUTER_READY" \
      --artifact-sha256 "$SC_REMOTE_ROUTER_SHA256" \
      --max-attempts 12 --request-ceiling 240 \
      --upstream https://openrouter.ai/api/v1/responses --bind 127.0.0.1 --port 0 \
    </dev/null >/dev/null 2>"$log" &
  SC_REMOTE_ROUTER_PID=$!
  SC_REMOTE_ROUTER_START=$(sc_process_start "$SC_REMOTE_ROUTER_PID" 2>/dev/null || true)
  [[ "$SC_REMOTE_ROUTER_START" =~ ^[0-9]+$ ]] || sc_die "OpenRouter router did not start safely" 70
  for attempt in {1..250}; do
    sc_pid_still_matches "$SC_REMOTE_ROUTER_PID" "$SC_REMOTE_ROUTER_START" || break
    if [[ -f "$SC_REMOTE_ROUTER_READY" && ! -L "$SC_REMOTE_ROUTER_READY" ]] &&
      jq -e --argjson pid "$SC_REMOTE_ROUTER_PID" --arg artifact "$SC_REMOTE_ROUTER_SHA256" \
        --arg preferred_key "$SC_REMOTE_ROUTER_PREFERRED_KEY_ID" '
        .schema=="sandcodex.openrouter-responses-router-ready.v1" and .pid==$pid and
        .host=="127.0.0.1" and (.port|type)=="number" and .port>=1 and .port<=65535 and
        .artifact_sha256==$artifact and .upstream_path=="/api/v1/responses" and
        .request_ceiling_seconds==240 and
        .preferred_key_id==$preferred_key and
        .commit_policy=="buffer-complete-response-before-downstream-bytes" and
        .credential_values_disclosed==false and .raw_provider_content_disclosed==false
      ' "$SC_REMOTE_ROUTER_READY" >/dev/null 2>&1; then
      break
    fi
    sleep 0.02
  done
  sc_owned_single_file "$SC_REMOTE_ROUTER_READY" 600 "OpenRouter router readiness receipt"
  pid_in_ready=$(jq -er '.pid' "$SC_REMOTE_ROUTER_READY")
  [[ "$pid_in_ready" == "$SC_REMOTE_ROUTER_PID" ]] || sc_die "OpenRouter router readiness PID mismatch" 78
  SC_REMOTE_ROUTER_HOST_PORT=$(jq -er '.port' "$SC_REMOTE_ROUTER_READY")
  [[ "$SC_REMOTE_ROUTER_HOST_PORT" =~ ^[1-9][0-9]{0,4}$ && "$SC_REMOTE_ROUTER_HOST_PORT" -le 65535 ]] ||
    sc_die "OpenRouter router readiness port is invalid" 78
  SC_PROVIDER_BRIDGE_HOST_PORT=$SC_REMOTE_ROUTER_HOST_PORT
}

sc_remote_router_configure_codex() {
  local base visible
  [[ -n "$SC_REMOTE_ROUTER_HOST_PORT" && -n "$SC_REMOTE_ROUTER_TOKEN_FILE" ]] ||
    sc_die "OpenRouter router configuration is incomplete" 78
  if (( SC_BARE )); then
    base="http://127.0.0.1:$SC_REMOTE_ROUTER_HOST_PORT/v1"
    visible=$SC_REMOTE_ROUTER_TOKEN_FILE
  else
    base="http://127.0.0.1:$SC_REMOTE_ROUTER_NAMESPACE_PORT/v1"
    visible="$SC_SANDBOX_CONTROL/codex-home/remote-api-token"
  fi
  # Codex defaults hosted search to cached mode.  OpenRouter's server-side
  # search is a distinct execution and billing authority, so the free auto
  # lane removes that provider-hosted tool. Sandcodex browser/MCP grants stay
  # available independently.
  printf -v SC_REMOTE_TOP_CONFIG 'model_provider = "%s"\nweb_search = "disabled"\n' "$SC_REMOTE_NATIVE_PROVIDER"
  printf -v SC_REMOTE_PROVIDER_CONFIG '\n[model_providers.%s]\nname = "Sandcodex OpenRouter Responses router"\nbase_url = %s\nwire_api = "responses"\nrequires_openai_auth = false\nstream_idle_timeout_ms = 240000\n[model_providers.%s.auth]\ncommand = %s\nargs = [%s]\n' \
    "$SC_REMOTE_NATIVE_PROVIDER" "$(sc_toml "$base")" "$SC_REMOTE_NATIVE_PROVIDER" \
    "$(sc_toml "$(command -v cat)")" "$(sc_toml "$visible")"
  sc_note "remote auto · owned in-flight Responses router · $(jq -r '.router.candidate_models|length' "$SC_REMOTE_SNAPSHOT") model(s) · buffered pre-visible failover across protected accounts"
}

sc_remote_router_prepare_fresh() {
  sc_remote_router_install_current
  SC_REMOTE_ROUTER_KEY_BANK=$SC_REMOTE_AUTO_KEYBANK_COPY
  SC_REMOTE_ROUTER_MODEL_BANK=$SC_REMOTE_AUTO_MODEL_BANK_COPY
  sc_owned_single_file "$SC_REMOTE_ROUTER_KEY_BANK" 600 "OpenRouter router key bank"
  sc_owned_single_file "$SC_REMOTE_ROUTER_MODEL_BANK" 600 "OpenRouter router model bank"
  SC_REMOTE_ROUTER_KEY_BANK_SHA256=$(sha256sum -- "$SC_REMOTE_ROUTER_KEY_BANK" | awk '{print $1}')
  SC_REMOTE_ROUTER_MODEL_BANK_SHA256=$(sha256sum -- "$SC_REMOTE_ROUTER_MODEL_BANK" | awk '{print $1}')
  sc_remote_router_create_snapshot
  sc_remote_router_start
  sc_remote_router_configure_codex
}

sc_remote_router_prepare_bound() {
  sc_remote_router_verify_bound_files
  sc_remote_router_start
  sc_remote_router_configure_codex
}

sc_remote_qualify_launch() {
  local descriptor=$1 result verify_result rc=0 receipt receipt_sha project_dir project_receipt
  local cache_root="$SC_GLOBAL/remote/qualifications" reused network_requests
  [[ "$descriptor" =~ ^[0-9a-f]{64}$ ]] || sc_die "invalid remote descriptor before qualification" 78
  [[ -n "$SC_MODEL" && -n "$SC_REMOTE_SNAPSHOT" && -n "$SC_REMOTE_TOKEN_FILE" ]] ||
    sc_die "remote qualification lacks model, snapshot, or protected credential file" 78
  sc_ensure_dir "$SC_GLOBAL/remote" "remote provider state"
  sc_ensure_dir "$cache_root" "remote qualification cache"

  if (( SC_REMOTE_BOUND_QUALIFICATION )); then
    [[ -n "$SC_REMOTE_QUALIFICATION" && -n "$SC_REMOTE_QUALIFICATION_SHA256" ]] ||
      sc_die "bound remote qualification metadata is incomplete" 78
    sc_owned_single_file "$SC_REMOTE_QUALIFICATION" 600 "bound remote qualification receipt"
    [[ "$(sha256sum -- "$SC_REMOTE_QUALIFICATION" | awk '{print $1}')" == "$SC_REMOTE_QUALIFICATION_SHA256" ]] ||
      sc_die "bound remote qualification receipt changed" 78
    result="$(sc_emit_remote_qualifier | python3 -P - verify \
      --snapshot "$SC_REMOTE_SNAPSHOT" --receipt "$SC_REMOTE_QUALIFICATION" \
      --model "$SC_MODEL" --descriptor-sha256 "$descriptor")" || rc=$?
  else
    result="$(sc_emit_remote_qualifier | python3 -P - qualify \
      --snapshot "$SC_REMOTE_SNAPSHOT" --credential-file "$SC_REMOTE_TOKEN_FILE" \
      --model "$SC_MODEL" --descriptor-sha256 "$descriptor" --root "$cache_root" \
      --timeout "$SC_REMOTE_QUALIFICATION_TIMEOUT" \
      --timestamp "$(sc_now)")" || rc=$?
  fi
  (( rc == 0 )) || sc_die "remote provider qualification failed before Codex launch" "$rc"
  sc_remote_qualification_result_valid "$descriptor" "$SC_MODEL" <<<"$result" ||
    sc_die "remote provider qualifier returned invalid evidence" 78
  receipt=$(jq -er '.receipt_path' <<<"$result")
  receipt_sha=$(jq -er '.receipt_sha256' <<<"$result")
  reused=$(jq -er '.reused' <<<"$result")
  network_requests=$(jq -er '.network_requests' <<<"$result")
  sc_owned_single_file "$receipt" 600 "remote qualification receipt"
  [[ "$(sha256sum -- "$receipt" | awk '{print $1}')" == "$receipt_sha" ]] ||
    sc_die "remote qualification receipt digest changed" 78

  if (( SC_REMOTE_BOUND_QUALIFICATION )); then
    [[ "$receipt" == "$SC_REMOTE_QUALIFICATION" && "$receipt_sha" == "$SC_REMOTE_QUALIFICATION_SHA256" ]] ||
      sc_die "bound remote qualification result points elsewhere" 78
  else
    project_dir="$SC_CONTROL/remote-qualifications"
    sc_ensure_dir "$project_dir" "project remote qualification receipts"
    project_receipt="$project_dir/$receipt_sha.json"
    if [[ -e "$project_receipt" || -L "$project_receipt" ]]; then
      sc_owned_single_file "$project_receipt" 600 "project remote qualification receipt"
      cmp -s -- "$receipt" "$project_receipt" || sc_die "project remote qualification receipt conflicts" 78
    else
      cat -- "$receipt" | sc_atomic "$project_receipt" 600
    fi
    verify_result="$(sc_emit_remote_qualifier | python3 -P - verify \
      --snapshot "$SC_REMOTE_SNAPSHOT" --receipt "$project_receipt" \
      --model "$SC_MODEL" --descriptor-sha256 "$descriptor")" || rc=$?
    (( rc == 0 )) || sc_die "project remote qualification receipt failed verification" "$rc"
    sc_remote_qualification_result_valid "$descriptor" "$SC_MODEL" <<<"$verify_result" ||
      sc_die "project remote qualification verification returned invalid evidence" 78
    [[ "$(jq -er '.receipt_sha256' <<<"$verify_result")" == "$receipt_sha" ]] ||
      sc_die "project remote qualification receipt digest differs" 78
    SC_REMOTE_QUALIFICATION=$project_receipt
    SC_REMOTE_QUALIFICATION_SHA256=$receipt_sha
  fi
  SC_REMOTE_QUALIFICATION_PROBE_VERSION=$(jq -er '.probe_version' <<<"$result")
  SC_REMOTE_QUALIFICATION_MODEL_POLICY=$(jq -er '.model_identity_policy' <<<"$result")
  [[ "$reused" == true ]] && SC_REMOTE_QUALIFICATION_REUSED=1 || SC_REMOTE_QUALIFICATION_REUSED=0
  if (( SC_REMOTE_BOUND_QUALIFICATION )); then
    sc_note "remote · bound Responses qualification $receipt_sha verified · no probe request"
  elif (( SC_REMOTE_QUALIFICATION_REUSED )); then
    sc_note "remote · cached Responses qualification $receipt_sha reused · no probe request"
  else
    sc_note "remote · Responses streaming, strict tool calls, and exact tool-result continuation qualified · $network_requests bounded requests"
  fi
}

sc_family_prepare_remote() {
  if [[ -n "${SANDCODEX_REMOTE_PARENT_CONTRACT:-}" ]]; then
    sc_family_prepare_inherited_remote
    return
  fi
  local result digest key config token_path credential rc=0
  local -a args=()
  if [[ -n "$SC_REMOTE_SNAPSHOT" ]] && sc_remote_router_snapshot_is_router; then
    (( SC_REMOTE_BOUND_QUALIFICATION )) ||
      sc_die "an OpenRouter router snapshot is valid only through an immutable bound conversation" 64
    sc_remote_router_prepare_bound
    return
  fi
  if (( SC_REMOTE_AUTO )); then
    sc_remote_auto_select_launch
  fi
  if [[ -n "$SC_REMOTE_SNAPSHOT" ]]; then
    args+=(--snapshot "$SC_REMOTE_SNAPSHOT")
  else
    args+=(--file "$SC_GLOBAL/remote/providers.json")
    [[ -z "$SC_REMOTE_NAME" ]] || args+=(--provider "$SC_REMOTE_NAME")
  fi
  result="$(sc_emit_remote_config | python3 -P - "${args[@]}")" || rc=$?
  (( rc == 0 )) || sc_die "remote provider configuration failed validation" "$rc"
  config=$(jq -c '.config' <<<"$result")
  digest=$(jq -er '.sha256' <<<"$result"); host=$(jq -er '.host' <<<"$result")
  key=$(jq -er '.config.env_key' <<<"$result")
  [[ "$key" =~ ^[A-Z][A-Z0-9_]{0,79}(_API_KEY|_TOKEN|_SECRET)$ ]] ||
    sc_die "credential variable must end in _API_KEY, _TOKEN, or _SECRET" 78
  credential="${!key:-}"
  if [[ -z "$credential" && -n "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" ]]; then
    [[ "$SC_REMOTE_BOOTSTRAP_ENV_KEY" == "$key" ]] ||
      sc_die "remote credential bootstrap bridge names a different provider key" 78
    sc_no_symlink_components "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" "remote credential bootstrap bridge"
    sc_owned_single_file "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE" 600 "remote credential bootstrap bridge"
    credential="$(cat -- "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE")"
    rm -f -- "$SC_REMOTE_BOOTSTRAP_TOKEN_FILE"
    SC_REMOTE_BOOTSTRAP_TOKEN_FILE=""
    SC_REMOTE_BOOTSTRAP_ENV_KEY=""
  fi
  [[ -n "$credential" && ${#credential} -le 16384 ]] || sc_die "remote credential is missing or too large; export $key in the launching shell" 78
  [[ "$credential" != *$'\n'* && "$credential" != *$'\r'* ]] || sc_die "remote credential contains a line break" 78
  if [[ -n "$SC_REMOTE_NAME" && "$SC_REMOTE_NAME" != "$(jq -r '.config.name' <<<"$result")" ]]; then
    sc_die "requested remote provider differs from the saved provider snapshot" 64
  fi
  sc_ensure_dir "$SC_CONTROL/remote-providers" "project provider snapshots"
  SC_REMOTE_NATIVE_PROVIDER="scr_$digest"
  SC_REMOTE_SNAPSHOT="$SC_CONTROL/remote-providers/$digest.json"
  if [[ -e "$SC_REMOTE_SNAPSHOT" || -L "$SC_REMOTE_SNAPSHOT" ]]; then
    sc_owned_single_file "$SC_REMOTE_SNAPSHOT" "" "provider snapshot"
    [[ "$(jq -cS . "$SC_REMOTE_SNAPSHOT")" == "$(jq -cS . <<<"$config")" ]] || sc_die "provider snapshot changed" 78
  else
    printf '%s\n' "$config" | sc_atomic "$SC_REMOTE_SNAPSHOT" 600
  fi
  token_path="$SC_CONTROL/codex-home/remote-api-token"
  # Never pass credential values in argv, receipts, provider catalog, or tool environment.
  printf '%s' "$credential" | sc_atomic "$token_path" 600
  SC_REMOTE_TOKEN_FILE=$token_path
  unset "$key"
  credential=""
  sc_remote_qualify_launch "$digest"
  if (( SC_REMOTE_AUTO )); then
    sc_remote_router_prepare_fresh
    return
  fi
  sc_remote_configure_codex_from_snapshot
}

sc_family_stop_local() {
  # Invoked by the core's existing EXIT trap; never installs a competing trap.
  if [[ -n "${SCL_STARTED_UNIT:-}" ]]; then
    systemctl --user stop "${SCL_STARTED_UNIT}.service" >/dev/null 2>&1 || true
    SCL_STARTED_UNIT=""
  elif [[ -n "${SCL_STARTED_PID:-}" ]]; then
    sc_stop_tracked_pid "$SCL_STARTED_PID" "${SCL_STARTED_START:-${SC_LOCAL_PROCESS_START:-}}" TERM 40 || true
    wait "$SCL_STARTED_PID" 2>/dev/null || true
    SCL_STARTED_PID=""
  fi
}

# Managed-local startup uses the core project lock and EXIT cleanup, never a
# second Sandcodex harness. Runtime maintenance is serialized separately;
# qualified model aliases and conversation bindings are content-addressed.

sc_local_startup_available_mib() {
  awk '/^MemAvailable:/ {printf "%d", $2/1024}' /proc/meminfo
}

sc_local_startup_total_mib() {
  awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo
}

sc_local_memory_budget_mib() {
  local available_mib=$1 total_mib memory_mib
  [[ "$available_mib" =~ ^[0-9]+$ && "$available_mib" -ge 2048 ]] ||
    sc_die "less than 2 GiB host memory available for a managed local launch" 69
  if (( SC_LOCAL_MEMORY_EXPLICIT )); then
    total_mib=$(sc_local_startup_total_mib)
    [[ "$total_mib" =~ ^[0-9]+$ && "$total_mib" -ge 2048 ]] ||
      sc_die "host memory inventory is unavailable; cannot honor --local-memory-mib" 69
    memory_mib=$(( 10#$SC_LOCAL_MEMORY_MIB ))
    if (( memory_mib > total_mib )); then
      sc_note "local · managed runtime memory envelope ${memory_mib}MiB explicit · above MemTotal ${total_mib}MiB; provider load remains authoritative"
    else
      sc_note "local · managed runtime memory envelope ${memory_mib}MiB explicit · MemAvailable ${available_mib}MiB"
    fi
  else
    memory_mib=$(( available_mib / 2 ))
  fi
  (( memory_mib >= 1024 )) || sc_die "managed local memory budget is below 1 GiB" 69
  printf '%s\n' "$memory_mib"
}

sc_local_startup_check() {
  local phase=$1 output=$2 rc=0
  local -a args=(--phase "$phase" --endpoint "$SC_LOCAL_PROVIDER_ENDPOINT"
    --model "$SC_MODEL" --context-tokens "$SC_LOCAL_CONTEXT_TOKENS"
    --backend "$SCL_BACKEND" --memory-max-bytes "$SC_LOCAL_MEMORY_MAX_BYTES"
    --timeout 120 --output "$output")
  [[ -z "$SC_LOCAL_MODEL_DIGEST" ]] || args+=(--expected-digest "$SC_LOCAL_MODEL_DIGEST")
  # HTTP timeouts bound individual operations; timeout bounds the whole process,
  # including a peer that keeps a slow response alive indefinitely.
  timeout --signal=TERM --kill-after=5s 420s python3 -P "$SC_CONTROL/local-preflight.py" "${args[@]}" || rc=$?
  if (( rc == 75 )); then
    # A status code alone is never authority to change the runtime.
    jq -e '.schema=="sandcodex.local-startup-check.v1" and .phase=="load" and
      .backend=="cuda" and .result=="fail" and .retry_cpu==true and
      (.failure.code=="cuda_load" or .failure.code=="cuda_no_residency")' "$output" >/dev/null || return 78
  fi
  return "$rc"
}

sc_local_runtime_record() {
  local binary_path=$1 binary_digest=$2 backend=$3 context=$4 provider_version=$5 output=$6
  local store_output="" gc_root="" nar_hash="" closure_hash="" rooted=false override=false unit=false
  [[ -z "${SANDCODEX_LOCAL_OLLAMA_BIN:-}" ]] || override=true
  [[ -z "${SCL_STARTED_UNIT:-}" ]] || unit=true
  case "$binary_path" in
    /nix/store/*/bin/*)
      store_output=${binary_path%/bin/*}
      [[ "$store_output" =~ ^/nix/store/[A-Za-z0-9][A-Za-z0-9+._?=-]*$ && -d "$store_output" ]] ||
        sc_die "managed local runtime has an unsafe Nix store output path" 78
      command -v nix-store >/dev/null || sc_die "nix-store is required to preserve the selected local runtime closure" 69
      local gc_root_dir="${SC_LOCAL_RUNTIME_GC_ROOT_DIRECTORY:-$SC_CONTROL/local-runtime-roots}"
      sc_ensure_dir "$gc_root_dir" "local runtime GC roots"
      gc_root="$gc_root_dir/$binary_digest"
      if [[ -e "$gc_root" || -L "$gc_root" ]]; then
        [[ -L "$gc_root" && "$(stat -c %u -- "$gc_root")" == "$EUID" ]] ||
          sc_die "local runtime GC root is unsafe: $gc_root" 78
        [[ "$(readlink -f -- "$gc_root" 2>/dev/null || true)" == "$store_output" ]] ||
          sc_die "local runtime GC root points to different bytes" 78
      else
        nix-store --add-root "$gc_root" --realise "$store_output" >/dev/null ||
          sc_die "could not create a user GC root for the selected local runtime" 69
      fi
      nar_hash=$(nix-store -q --hash "$store_output") || sc_die "could not query the selected runtime NAR hash" 69
      closure_hash=$(LC_ALL=C nix-store -qR "$store_output" | LC_ALL=C sort -u | sha256sum | awk '{print $1}') ||
        sc_die "could not hash the selected runtime closure paths" 69
      [[ "$closure_hash" =~ ^[0-9a-f]{64}$ ]] || sc_die "runtime closure digest is malformed" 78
      rooted=true
      ;;
  esac
  jq -n --arg backend "$backend" --arg path "$binary_path" --arg sha256 "$binary_digest" \
    --arg nixpkgs "$SCL_PROVIDER_NIXPKGS_REV" --arg provider_version "$provider_version" \
    --arg store_output "$store_output" --arg gc_root "$gc_root" --arg nar_hash "$nar_hash" \
    --arg closure_hash "$closure_hash" --argjson override "$override" --argjson unit "$unit" \
    --arg threads "$SC_LOCAL_THREADS" --argjson context "$context" --argjson rooted "$rooted" \
    --arg keep_alive "$SC_LOCAL_KEEP_ALIVE" --argjson max_loaded "$SC_LOCAL_MAX_LOADED_MODELS" \
    --argjson parallel "$SC_LOCAL_NUM_PARALLEL" --argjson max_queue "$SC_LOCAL_MAX_QUEUE" \
    --argjson flash "$SC_LOCAL_FLASH_ATTENTION" --arg kv_cache "$SC_LOCAL_KV_CACHE_TYPE" '
      {backend:$backend, executable:$path, executable_sha256:$sha256,
       provider_nixpkgs_rev:$nixpkgs, provider_version:$provider_version,
       binary_override:$override, memory_cgroup_enforced:$unit, context_tokens:$context,
       model_profile_num_thread:(if $threads=="" then null else ($threads|tonumber) end),
       server_policy:{keep_alive:$keep_alive,max_loaded_models:$max_loaded,
         num_parallel:$parallel,max_queue:$max_queue,flash_attention:$flash,
         kv_cache_type:$kv_cache,operator_overrides_allowed:false},
       store_output:(if $store_output=="" then null else $store_output end),
       store_output_nar_hash:(if $nar_hash=="" then null else $nar_hash end),
       closure_paths_sha256:(if $closure_hash=="" then null else $closure_hash end),
       gc_root:(if $gc_root=="" then null else $gc_root end),
       full_runtime_closure_rooted:$rooted}' | sc_atomic "$output" 600
}

sc_local_verify_bound_runtime_binary() {
  (( SC_LOCAL_RESUME_BOUND )) || return 0
  local binary_path=$1 binary_digest=$2 expected backend pin store_output gc_root observed closure policy
  expected=$(jq -er '.local.runtime.executable' "$SC_RESUME_BINDING_VERIFIED")
  [[ "$binary_path" == "$expected" ]] || sc_die "bound local runtime resolved to a different executable" 78
  [[ "$binary_digest" == "$(jq -er '.local.runtime.executable_sha256' "$SC_RESUME_BINDING_VERIFIED")" ]] ||
    sc_die "bound local runtime executable bytes changed" 78
  backend=$(jq -er '.local.runtime.backend' "$SC_RESUME_BINDING_VERIFIED")
  [[ "$SCL_BACKEND" == "$backend" ]] || sc_die "bound local runtime backend changed" 78
  pin=$(jq -er '.local.runtime.provider_nixpkgs_rev' "$SC_RESUME_BINDING_VERIFIED")
  [[ "$SCL_PROVIDER_NIXPKGS_REV" == "$pin" ]] || sc_die "bound local runtime nixpkgs pin changed" 78
  policy=$(jq -c '.local.runtime.server_policy // null' "$SC_RESUME_BINDING_VERIFIED")
  if [[ "$policy" == null ]]; then
    sc_note "resume · legacy binding has no server scheduling policy; applying current pinned policy before requalification"
  else
    jq -e --arg keep_alive "$SC_LOCAL_KEEP_ALIVE" \
      --argjson max_loaded "$SC_LOCAL_MAX_LOADED_MODELS" --argjson parallel "$SC_LOCAL_NUM_PARALLEL" \
      --argjson max_queue "$SC_LOCAL_MAX_QUEUE" --argjson flash "$SC_LOCAL_FLASH_ATTENTION" \
      --arg kv_cache "$SC_LOCAL_KV_CACHE_TYPE" '
        .local.runtime.server_policy == {
          keep_alive:$keep_alive,max_loaded_models:$max_loaded,num_parallel:$parallel,
          max_queue:$max_queue,flash_attention:$flash,kv_cache_type:$kv_cache,
          operator_overrides_allowed:false
        }' "$SC_RESUME_BINDING_VERIFIED" >/dev/null ||
      sc_die "bound local runtime server policy differs from this launcher" 78
  fi
  store_output=$(jq -r '.local.runtime.store_output // empty' "$SC_RESUME_BINDING_VERIFIED")
  [[ -n "$store_output" ]] || return 0
  command -v nix-store >/dev/null || sc_die "nix-store is required to verify the bound local runtime closure" 69
  gc_root=$(jq -er '.local.runtime.gc_root' "$SC_RESUME_BINDING_VERIFIED")
  [[ -L "$gc_root" && "$(readlink -f -- "$gc_root" 2>/dev/null || true)" == "$store_output" ]] ||
    sc_die "bound local runtime GC root is missing or changed" 78
  observed=$(nix-store -q --hash "$store_output") || sc_die "could not verify the bound runtime NAR hash" 69
  [[ "$observed" == "$(jq -er '.local.runtime.store_output_nar_hash' "$SC_RESUME_BINDING_VERIFIED")" ]] ||
    sc_die "bound local runtime NAR hash changed" 78
  closure=$(LC_ALL=C nix-store -qR "$store_output" | LC_ALL=C sort -u | sha256sum | awk '{print $1}') ||
    sc_die "could not verify the bound runtime closure paths" 69
  [[ "$closure" == "$(jq -er '.local.runtime.closure_paths_sha256' "$SC_RESUME_BINDING_VERIFIED")" ]] ||
    sc_die "bound local runtime closure paths changed" 78
}

sc_local_verify_bound_provider_version() {
  (( SC_LOCAL_RESUME_BOUND )) || return 0
  local inventory_file=$1 observed expected
  observed=$(jq -er '.model.provider_version' "$inventory_file")
  expected=$(jq -er '.local.runtime.provider_version' "$SC_RESUME_BINDING_VERIFIED")
  [[ "$observed" == "$expected" ]] || sc_die "bound local provider version changed; resume requires review or migration" 78
}

sc_local_stop_owned_runtime_required() {
  # Unlike best-effort EXIT cleanup, a transition may not proceed while the old
  # owned runtime could still be serving requests. Never touch a reused service
  # or an untracked process.
  local purpose=${1:-runtime transition}
  if [[ -n "${SCL_STARTED_UNIT:-}" ]]; then
    systemctl --user stop "${SCL_STARTED_UNIT}.service" || sc_die "could not stop the owned runtime; $purpose cancelled" 70
    if systemctl --user is-active --quiet "${SCL_STARTED_UNIT}.service"; then
      sc_die "owned runtime remains active; $purpose cancelled" 70
    fi
    SCL_STARTED_UNIT=""
  elif [[ -n "${SCL_STARTED_PID:-}" ]]; then
    local pid=$SCL_STARTED_PID started=${SCL_STARTED_START:-${SC_LOCAL_PROCESS_START:-}}
    [[ "$started" =~ ^[0-9]+$ ]] || sc_die "runtime process ownership is unknown; $purpose cancelled" 70
    sc_stop_tracked_pid "$pid" "$started" TERM 40 || sc_die "could not stop the owned runtime; $purpose cancelled" 70
    # Reap our child before checking /proc, so zombies are not mistaken for live workers.
    wait "$pid" 2>/dev/null || true
    sc_pid_still_matches "$pid" "$started" && sc_die "owned runtime remains present; $purpose cancelled" 70
    SCL_STARTED_PID=""; SCL_STARTED_START=""; SC_LOCAL_PROCESS_START=""
  else
    sc_die "runtime ownership was not recorded; $purpose cancelled" 70
  fi
}

sc_local_startup_stop_for_retry() {
  sc_local_stop_owned_runtime_required "CPU retry"
}

