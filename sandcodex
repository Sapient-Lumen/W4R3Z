from __future__ import annotations
import base64, json, re, socket, sys, time
from pathlib import Path

socket_path, proof_path, screenshot, backend, expected_xkb_version = sys.argv[1:]
if backend == "wayland" and re.fullmatch(r"[0-9]+(?:\.[0-9]+){1,3}", expected_xkb_version) is None:
    raise RuntimeError("desktop behavior preflight expected libxkbcommon version attestation is invalid")
connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
connection.settimeout(20)
connection.connect(socket_path)
stream = connection.makefile("rwb", buffering=0)
sequence = 0

def request(method: str, params: dict[str, object]) -> dict[str, object]:
    global sequence
    sequence += 1
    stream.write((json.dumps({"jsonrpc":"2.0","id":sequence,"method":method,"params":params}, separators=(",", ":")) + "\n").encode())
    response = json.loads(stream.readline())
    result = response.get("result")
    if not isinstance(result, dict) or result.get("isError"):
        raise RuntimeError(f"desktop MCP request failed: {response}")
    return result

def tool(name: str, arguments: dict[str, object]) -> dict[str, object]:
    return request("tools/call", {"name": name, "arguments": arguments})

request("initialize", {"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"sandcodex-doctor","version":"1"}})

def guarded(observation: dict[str, object], name: str, arguments: dict[str, object], settle: int = 50) -> dict[str, object]:
    result = tool("desktop_step", {
        "observation_id": observation["observation_id"],
        "action": {"name": name, "arguments": arguments},
        "settle_milliseconds": settle,
    })
    structured = result.get("structuredContent")
    action = structured.get("action") if isinstance(structured, dict) else None
    if not isinstance(action, dict) or action.get("name") != name:
        raise RuntimeError(f"guarded desktop action did not return a fresh observation: {name}")
    return structured

