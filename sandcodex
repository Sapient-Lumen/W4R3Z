  printf '  task       %s\n  score      %s/%s\n  result     %s\n' \
    "$(jq -r '.case_id' <<<"$grade")" "$(jq -r '.points_awarded' <<<"$grade")" \
    "$(jq -r '.possible_points' <<<"$grade")" "$(jq -r '.classification' <<<"$grade")"
  printf '\nchecks\n'
  jq -r '.checks | to_entries[] |
    "  " + (if .value then "PASS" else "FAIL" end) + "  " + (.key | gsub("_"; " "))' <<<"$grade"
}

sc_agent_benchmark_prepare_dispatch() {
  local output parent result
  sc_no_line_breaks "$SC_BENCHMARK_OUTPUT" "benchmark output directory"
  output="$(realpath -ms -- "$SC_BENCHMARK_OUTPUT")"
  [[ "$output" == /* && "$output" != / ]] || sc_die "benchmark --output must resolve to a non-root absolute path" 64
  [[ ! -L "$SC_BENCHMARK_OUTPUT" ]] || sc_die "benchmark output directory cannot be a symbolic link" 64
  parent="$(dirname -- "$output")"
  [[ -d "$parent" && ! -L "$parent" ]] || sc_die "benchmark output parent must already exist" 66
  sc_no_symlink_components "$parent" "benchmark output parent"
  sc_owned_dir "$parent" "benchmark output parent"
  result="$(sc_agent_benchmark_prepare_project "$SC_BENCHMARK_TARGET" "$output")"
  if (( SC_BENCHMARK_JSON )); then
    printf '%s\n' "$result"
  else
    printf 'benchmark fixture prepared · %s\n' "$SC_BENCHMARK_TARGET"
    printf '  project: %s\n' "$output"
    printf '  prompt:  %s/TASK.md\n' "$output"
    printf '  grade:   sandcodex benchmark grade %q --project %q\n' "$SC_BENCHMARK_TARGET" "$output"
  fi
}

sc_agent_benchmark_grade_dispatch() {
  local project grade
  project="$(sc_agent_benchmark_canonical_project "$SC_BENCHMARK_PROJECT" "benchmark candidate")"
  grade="$(sc_agent_benchmark_grade_project "$SC_BENCHMARK_TARGET" "$project")"
  if (( SC_BENCHMARK_JSON )); then printf '%s\n' "$grade"; else sc_agent_benchmark_render_grade "$grade"; fi
  jq -e '.accepted == true' <<<"$grade" >/dev/null
}

sc_agent_benchmark_child_command() {
  local output_name=$1 project=$2 prompt=$3
  local -n output_ref=$output_name
  case "$SC_BENCHMARK_ROUTE" in
    gpt)
      output_ref=("$SC_SCRIPT" loop)
      [[ -z "$SC_BENCHMARK_MODEL" ]] || output_ref+=(--model "$SC_BENCHMARK_MODEL")
      ;;
    gemini-auto) output_ref=("$SC_SCRIPT" gemini auto loop) ;;
    gemini) output_ref=("$SC_SCRIPT" gemini "$SC_BENCHMARK_MODEL" loop) ;;
    openrouter-auto)
      output_ref=("$SC_SCRIPT" remote auto loop)
      [[ -z "$SC_REMOTE_KEYBANK_PATH" ]] || output_ref+=(--key-bank "$SC_REMOTE_KEYBANK_PATH")
      ;;
    openrouter) output_ref=("$SC_SCRIPT" remote "$SC_BENCHMARK_MODEL" --provider openrouter loop) ;;
    local) output_ref=("$SC_SCRIPT" local "$SC_BENCHMARK_MODEL" --backend "$SC_BENCHMARK_LOCAL_BACKEND" loop) ;;
    *) sc_die "unsupported internal benchmark route" 70 ;;
  esac
  output_ref+=(--project "$project" --turns "$SC_BENCHMARK_TURNS" --prompt-file "$prompt"
    --auto-resume --retry-limit 2 --retry-base-seconds 2 --retry-max-seconds 30
    --retry-max-wait-seconds 120 --max-project-growth-mib 32 --max-downloads-mib 1
    --max-profile-mib 64 --restricted-network --no-nix-daemon --no-browser --no-desktop
    --no-subagents --no-companion-campaigns)
}

sc_agent_benchmark_loop_evidence() {
  local project=$1 key control state selection selected_model=""
  key="$(printf '%s\0' "$project" | sha256sum | awk '{print $1}')"
  control="$SC_GLOBAL/projects/$key"
  state="$control/loop-state.json"
  if [[ -f "$state" && ! -L "$state" ]]; then
    sc_owned_single_file "$state" 600 "benchmark loop state"
    jq -c '
      if .schema != "sandcodex.loop.v1" then error("schema") else
      {status,last_exit,last_error_class,current_turn,turn_limit,successful_turns,
       attempts,retry_count,total_duration_seconds,model,
       usage:{reported:(.usage.reported // false),input_tokens:(.usage.input_tokens // 0),
         cached_input_tokens:(.usage.cached_input_tokens // 0),output_tokens:(.usage.output_tokens // 0),
         total_tokens:(.usage.total_tokens // 0)}} end
    ' "$state" 2>/dev/null || sc_die "benchmark loop state is invalid" 78
    return
  fi
  selection="$control/openrouter-auto-selection.json"
  if [[ -f "$selection" && ! -L "$selection" ]]; then
    selected_model="$(jq -er '.model // empty' "$selection" 2>/dev/null || true)"
  fi
  jq -cn --arg model "$selected_model" '{status:"missing",last_exit:null,last_error_class:"boundary",
    current_turn:0,turn_limit:0,successful_turns:0,attempts:0,retry_count:0,total_duration_seconds:0,
    model:(if $model == "" then null else $model end),
    usage:{reported:false,input_tokens:0,cached_input_tokens:0,output_tokens:0,total_tokens:0}}'
}

sc_agent_benchmark_render_report() {
  local report=$1
  printf 'Sandcodex agent benchmark · %s · %s\n' \
    "$(jq -r '.run_id' <<<"$report")" "$(jq -r '.status' <<<"$report")"
  printf '  route: %s%s · course: %s · turns/task: %s\n' \
    "$(jq -r '.condition.route' <<<"$report")" \
    "$(jq -r 'if .condition.model == null then "" else " · " + .condition.model end' <<<"$report")" \
    "$(jq -r '.target' <<<"$report")" "$(jq -r '.condition.turns_per_task' <<<"$report")"
  printf '  quality: %s/%s points · %s/%s accepted · infrastructure failures: %s\n' \
    "$(jq -r '.score.quality_points' <<<"$report")" "$(jq -r '.score.quality_possible_points' <<<"$report")" \
    "$(jq -r '.score.accepted_tasks' <<<"$report")" "$(jq -r '.score.scored_tasks' <<<"$report")" \
    "$(jq -r '.score.infrastructure_failures' <<<"$report")"
  if jq -e '.ladder.ordered == true' <<<"$report" >/dev/null; then
    printf '  observed contiguous pass rung: %s / %s\n' \
      "$(jq -r '.ladder.observed_contiguous_pass_rung' <<<"$report")" \
      "$(jq -r '.tasks | map(.rung) | max' <<<"$report")"
  fi
  jq -r '.tasks[] | (if .rung == null then "  " else "  rung " + (.rung|tostring) + " · " end) + .case_id + ": " + .outcome +
    (if .scored then " · " + (.grade.points_awarded|tostring) + "/10" else " · unscored" end) +
    " · attempts=" + (.loop.attempts|tostring) + " retries=" + (.loop.retry_count|tostring)' <<<"$report"
  printf '  receipt: %s\n' "$(jq -r '.receipt_path' <<<"$report")"
}

sc_agent_benchmark_run_dispatch() {
  local catalog cases_json artifact started_at finished_at run_id run_root workspace_root workspace_run task_rows report case_id
  local task_root project preparation grade loop_evidence task_meta outcome selected_model rc started_epoch duration
  local openrouter_stage="" openrouter_quota="" openrouter_rows="" openrouter_key_id="" openrouter_key_file=""
  local openrouter_credential=""
  local -a cases=() child=()
  catalog="$(sc_agent_benchmark_catalog_json)"
  cases_json="$(jq -ce --arg target "$SC_BENCHMARK_TARGET" '
    if .courses[$target] != null then .courses[$target]
    elif any(.tasks[]; .case_id == $target) then [$target]
    else error("unknown course or case") end
  ' <<<"$catalog" 2>/dev/null)" || sc_die "unknown benchmark course or case: $SC_BENCHMARK_TARGET" 64
  mapfile -t cases < <(jq -r '.[]' <<<"$cases_json")
  (( ${#cases[@]} > 0 )) || sc_die "benchmark target contains no cases" 78
  sc_ensure_dir "$SC_GLOBAL/benchmarks" "benchmark state"
  sc_ensure_dir "$SC_GLOBAL/benchmarks/runs" "benchmark run state"
  if [[ "$SC_BENCHMARK_ROUTE" == openrouter &&
    ( -n "$SC_REMOTE_KEYBANK_PATH" || ( -z "${OPENROUTER_API_KEY:-}" && -f "$(sc_remote_keybank_default_path)" ) ) ]]; then
    openrouter_stage="$(sc_remote_keybank_stage)"
    openrouter_quota="$(sc_remote_keybank_quota_json "$openrouter_stage")"
    openrouter_rows="$(sc_remote_keybank_usable_rows "$openrouter_stage" "$openrouter_quota" 2)"
    IFS=$'\t' read -r openrouter_key_id openrouter_key_file _ _ \
      <<<"$openrouter_rows"
    [[ "$openrouter_key_id" =~ ^[0-9a-f]{12}$ && -n "$openrouter_key_file" ]] || {
      sc_remote_keybank_unstage "$openrouter_stage"
      sc_die "OpenRouter benchmark key bank has no usable key with reported quota" 69
    }
  fi
  # A benchmark project must remain an ordinary untrusted project. Keeping it
  # below SC_GLOBAL would either weaken the trusted-state boundary or (as
  # intended) make the normal launcher reject it. Use a private sibling tree,
  # while content-minimized receipts stay in trusted state.
  workspace_root="${SC_GLOBAL}-benchmarks"
  [[ "$workspace_root" != "$SC_GLOBAL" && "$workspace_root" != "$SC_GLOBAL"/* ]] ||
    sc_die "benchmark workspace root overlaps trusted state" 70
  sc_no_symlink_components "$workspace_root" "benchmark workspace root"
  sc_ensure_dir "$workspace_root" "benchmark workspace root"
  printf -v run_id '%s-%s-%08x' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$(( (RANDOM << 16) ^ RANDOM ))"
  SC_BENCHMARK_RUN_ID=$run_id
  run_root="$SC_GLOBAL/benchmarks/runs/$run_id"
  workspace_run="$workspace_root/$run_id"
  [[ ! -e "$run_root" && ! -L "$run_root" ]] || sc_die "benchmark run identity collision" 70
  [[ ! -e "$workspace_run" && ! -L "$workspace_run" ]] || sc_die "benchmark workspace identity collision" 70
  mkdir -m 700 -- "$run_root" "$workspace_run"
  task_rows="$run_root/tasks.jsonl"
  : >"$task_rows"; chmod 600 -- "$task_rows"
  artifact="$(sc_artifact_sha256)"; started_at="$(sc_now)"
  sc_note "benchmark · $SC_BENCHMARK_TARGET · ${#cases[@]} task(s) · route $SC_BENCHMARK_ROUTE"
  for case_id in "${cases[@]}"; do
    task_meta="$(jq -ce --arg case_id "$case_id" '.tasks[] | select(.case_id == $case_id)' <<<"$catalog")" ||
      sc_die "benchmark task metadata is missing: $case_id" 78
    task_root="$workspace_run/$case_id"; project="$task_root/project"
    mkdir -m 700 -- "$task_root"
    preparation="$(sc_agent_benchmark_prepare_project "$case_id" "$project")"
    sc_note "benchmark task · $case_id · one fresh synthetic repository"
    sc_agent_benchmark_child_command child "$project" "$project/TASK.md"
    started_epoch="$(date +%s)"; rc=0
    if [[ -n "$openrouter_key_file" ]]; then
      openrouter_credential="$(<"$openrouter_key_file")"
      if OPENROUTER_API_KEY="$openrouter_credential" env SANDCODEX_GLOBAL_ROOT="$SC_GLOBAL" \
        "${child[@]}" 1>&2; then rc=0; else rc=$?; fi
      openrouter_credential=""
    else
      if env SANDCODEX_GLOBAL_ROOT="$SC_GLOBAL" "${child[@]}" 1>&2; then rc=0; else rc=$?; fi
    fi
    duration=$(( $(date +%s) - started_epoch )); (( duration >= 0 )) || duration=0
    grade="$(sc_agent_benchmark_grade_project "$case_id" "$project")"
    loop_evidence="$(sc_agent_benchmark_loop_evidence "$project")"
    if (( rc == 0 )) && jq -e '.status == "completed"' <<<"$loop_evidence" >/dev/null; then
      if jq -e '.accepted == true' <<<"$grade" >/dev/null; then outcome=passed; else outcome=incorrect; fi
    else
      outcome=infrastructure_error
    fi
    selected_model="$(jq -r '.model // empty' <<<"$loop_evidence")"
    if [[ "$SC_BENCHMARK_ROUTE" == openrouter-auto ]]; then
      local project_key selection_path
      project_key="$(printf '%s\0' "$project" | sha256sum | awk '{print $1}')"
      selection_path="$SC_GLOBAL/projects/$project_key/openrouter-auto-selection.json"
      if [[ -f "$selection_path" && ! -L "$selection_path" ]]; then
        selected_model="$(jq -er '.model // empty' "$selection_path" 2>/dev/null || printf '%s' "$selected_model")"
      fi
    fi
    jq -cn --arg case_id "$case_id" --arg outcome "$outcome" --argjson exit_code "$rc" \
      --argjson wall_seconds "$duration" --arg selected_model "$selected_model" \
      --argjson rung "$(jq -r '.rung' <<<"$task_meta")" --arg difficulty "$(jq -r '.difficulty' <<<"$task_meta")" \
      --arg project "$project" --arg baseline_commit "$(jq -r '.baseline_commit' <<<"$preparation")" \
      --argjson preparation "$preparation" --argjson grade "$grade" --argjson loop "$loop_evidence" '
      {case_id:$case_id,rung:$rung,difficulty:$difficulty,
       outcome:$outcome,scored:($outcome != "infrastructure_error"),
       execution:{exit_code:$exit_code,wall_seconds:$wall_seconds},
       selected_model:(if $selected_model == "" then null else $selected_model end),
       project:$project,baseline_commit:$baseline_commit,
       task_digest_sha256:$preparation.task_digest_sha256,grade:$grade,loop:$loop}
    ' >>"$task_rows"
  done
  if [[ -n "$openrouter_stage" ]]; then
    sc_remote_keybank_unstage "$openrouter_stage"
    openrouter_stage=""
  fi
  finished_at="$(sc_now)"
  report="$(jq -sc --arg run_id "$run_id" --arg target "$SC_BENCHMARK_TARGET" \
    --arg route "$SC_BENCHMARK_ROUTE" --arg model "$SC_BENCHMARK_MODEL" \
    --arg local_backend "$SC_BENCHMARK_LOCAL_BACKEND" \
    --arg started_at "$started_at" --arg finished_at "$finished_at" \
    --arg artifact "$artifact" --arg receipt "$run_root/report.json" \
    --arg bench_version "$(jq -r '.bench_version' <<<"$catalog")" \
    --arg bench_digest "$(jq -r '.bench_version_sha256' <<<"$catalog")" \
    --argjson turns "$SC_BENCHMARK_TURNS" '
    . as $tasks |
    {schema:"sandcodex.agent-benchmark-run.v1",run_id:$run_id,status:
      (if any($tasks[]; .outcome == "infrastructure_error") then "incomplete" else "completed" end),
     target:$target,bench_version:$bench_version,bench_version_sha256:$bench_digest,
     launcher_artifact_sha256:$artifact,started_at:$started_at,finished_at:$finished_at,
     receipt_path:$receipt,
     condition:{route:$route,model:(if $model == "" then null else $model end),
       provider:(if ($route == "openrouter-auto" or $route == "openrouter") then "openrouter"
         elif ($route == "gemini-auto" or $route == "gemini") then "gemini"
         elif $route == "gpt" then "openai" elif $route == "local" then "ollama" else null end),
       local_backend:(if $route == "local" then $local_backend else null end),turns_per_task:$turns,
       network:"provider-only",browser:false,desktop:false,subagents:false},
     score:{nominal_possible_points:($tasks|map(.grade.possible_points)|add // 0),
       quality_points:($tasks|map(select(.scored)|.grade.points_awarded)|add // 0),
       quality_possible_points:($tasks|map(select(.scored)|.grade.possible_points)|add // 0),
       accepted_tasks:($tasks|map(select(.scored and .grade.accepted))|length),
       scored_tasks:($tasks|map(select(.scored))|length),total_tasks:($tasks|length),
       infrastructure_failures:($tasks|map(select(.outcome == "infrastructure_error"))|length)},
     ladder:{ordered:($target == "ladder"),
       passed_rungs:($tasks|map(select(.outcome == "passed")|.rung)|sort),
       observed_contiguous_pass_rung:(if $target == "ladder" then
         (reduce ($tasks|sort_by(.rung)[]) as $task
           ({ceiling:0,open:true};
            if (.open and $task.rung == (.ceiling + 1) and $task.outcome == "passed")
            then .ceiling += 1
            elif .open then .open = false else . end) | .ceiling)
         else null end)},
     tasks:$tasks,
     retention:{raw_prompt:false,raw_provider_output:false,credentials:false,candidate_projects:true,
       note:"Candidate projects contain synthetic benchmark data and remain available for audit."},
     limitations:["A small synthetic course is a regression signal, not a broad intelligence ranking.",
       "Auto routes evaluate the complete routing policy; use an exact-model route when model attribution is required.",
       "Passing hidden checks does not establish security or production fitness."]}
  ' "$task_rows")" || sc_die "could not construct benchmark receipt" 78
  printf '%s\n' "$report" | sc_atomic "$run_root/report.json" 600
  printf '%s\n' "$report" | sc_atomic "$SC_GLOBAL/benchmarks/latest.json" 600
  if (( SC_BENCHMARK_JSON )); then printf '%s\n' "$report"; else sc_agent_benchmark_render_report "$report"; fi
  jq -e '.status == "completed" and .score.accepted_tasks == .score.total_tasks' <<<"$report" >/dev/null
}

sc_agent_benchmark_report_dispatch() {
  local path report
  if [[ -n "$SC_BENCHMARK_RUN_ID" ]]; then
    path="$SC_GLOBAL/benchmarks/runs/$SC_BENCHMARK_RUN_ID/report.json"
  else
    path="$SC_GLOBAL/benchmarks/latest.json"
  fi
  [[ -f "$path" && ! -L "$path" ]] || sc_die "no matching benchmark report exists" 66
  sc_owned_single_file "$path" 600 "benchmark report"
  report="$(jq -ce '
    if (.schema == "sandcodex.agent-benchmark-run.v1" and
        (.run_id | type == "string") and (.tasks | type == "array"))
    then . else error("schema") end
  ' "$path" 2>/dev/null)" ||
    sc_die "benchmark report is invalid" 78
  if (( SC_BENCHMARK_JSON )); then printf '%s\n' "$report"; else sc_agent_benchmark_render_report "$report"; fi
}

sc_agent_benchmark_render_comparison() {
  local comparison=$1
  printf 'OpenRouter agent ladder comparison · %s run(s) · %s model(s)\n' \
    "$(jq -r '.run_count' <<<"$comparison")" "$(jq -r '.model_count' <<<"$comparison")"
  printf '  course: %s · turns/task: %s · benchmark: %s\n' \
    "$(jq -r '.condition.target' <<<"$comparison")" \
    "$(jq -r '.condition.turns_per_task' <<<"$comparison")" \
    "$(jq -r '.condition.bench_version_sha256[0:12]' <<<"$comparison")"
  jq -r '.models[] |
    "  #\(.rank) \(.model) · trials=\(.trials)" +
    " · operational=\(.operational_role) (rung \(.operational_floor_rung))" +
    " · quality=\(.quality_role) (rung \(.quality_floor_rung))" +
    " · full=\(.full_course_passes)/\(.trials)" +
    " · points=\(.quality_points)/\(.quality_possible_points)" +
    " · infra=\(.infrastructure_failures)" +
    (if .provisional then " · PROVISIONAL" else "" end)' <<<"$comparison"
  printf '  comparison receipt: %s\n' "$(jq -r '.receipt_path' <<<"$comparison")"
  printf '  interpretation: operational includes transport reliability; quality excludes infrastructure failures\n'
}

sc_agent_benchmark_compare_dispatch() {
  local run_id path comparison comparison_sha receipt
  local -a arguments=()
  for run_id in "${SC_BENCHMARK_RUN_IDS[@]}"; do
    path="$SC_GLOBAL/benchmarks/runs/$run_id/report.json"
    [[ -f "$path" && ! -L "$path" ]] || sc_die "benchmark report does not exist: $run_id" 66
    sc_owned_single_file "$path" 600 "benchmark comparison report"
    arguments+=(--report "$path")
  done
  comparison="$(sc_emit_agent_benchmark | python3 -P - compare "${arguments[@]}")" ||
    sc_die "OpenRouter benchmark comparison failed" 78
  jq -e '. as $comparison | .schema == "sandcodex.agent-benchmark-comparison.v1" and
    (.comparison_sha256 | test("^[0-9a-f]{64}$")) and
    (.run_count | type == "number" and . >= 2) and
    (.model_count | type == "number" and . >= 1) and
    (.models | type == "array" and length == $comparison.model_count)' <<<"$comparison" >/dev/null ||
    sc_die "OpenRouter benchmark comparison returned invalid evidence" 78
  comparison_sha="$(jq -er '.comparison_sha256' <<<"$comparison")"
  sc_ensure_dir "$SC_GLOBAL/benchmarks/comparisons" "benchmark comparison state"
  receipt="$SC_GLOBAL/benchmarks/comparisons/$comparison_sha.json"
  comparison="$(jq -c --arg receipt "$receipt" '. + {receipt_path:$receipt}' <<<"$comparison")"
  printf '%s\n' "$comparison" | sc_atomic "$receipt" 600
  if (( SC_BENCHMARK_JSON )); then
    printf '%s\n' "$comparison"
  else
    sc_agent_benchmark_render_comparison "$comparison"
  fi
}

sc_agent_benchmark_dispatch() {
  local catalog
  case "$SC_BENCHMARK_ACTION" in
    list)
      catalog="$(sc_agent_benchmark_catalog_json)"
      if (( SC_BENCHMARK_JSON )); then printf '%s\n' "$catalog"; else sc_agent_benchmark_render_catalog "$catalog"; fi
      ;;
    prepare) sc_agent_benchmark_prepare_dispatch ;;
    grade) sc_agent_benchmark_grade_dispatch ;;
    run) sc_agent_benchmark_run_dispatch ;;
    report) sc_agent_benchmark_report_dispatch ;;
    compare) sc_agent_benchmark_compare_dispatch ;;
    *) sc_die "internal benchmark action error" 70 ;;
  esac
}

sc_gemini_adapter_stop() {
  if [[ -n "${SC_GEMINI_ADAPTER_PID:-}" ]]; then
    if [[ -n "$SC_GEMINI_ADAPTER_START" ]]; then
      sc_stop_tracked_pid "$SC_GEMINI_ADAPTER_PID" "$SC_GEMINI_ADAPTER_START" TERM 40 || true
    else
      kill -TERM "$SC_GEMINI_ADAPTER_PID" 2>/dev/null || true
    fi
    wait "$SC_GEMINI_ADAPTER_PID" 2>/dev/null || true
    SC_GEMINI_ADAPTER_PID=""; SC_GEMINI_ADAPTER_START=""
  fi
  [[ -z "${SC_GEMINI_ADAPTER_READY:-}" ]] || rm -f -- "$SC_GEMINI_ADAPTER_READY" 2>/dev/null || true
  [[ -z "${SC_GEMINI_ADAPTER_TOKEN_FILE:-}" ]] || rm -f -- "$SC_GEMINI_ADAPTER_TOKEN_FILE" 2>/dev/null || true
  if [[ -n "${SC_GEMINI_ADAPTER_STAGE_JSON:-}" ]]; then
    sc_gemini_keybank_unstage "$SC_GEMINI_ADAPTER_STAGE_JSON"
    SC_GEMINI_ADAPTER_STAGE_JSON=""
  fi
}

sc_gemini_runtime_prepare() {
  [[ -z "$SC_GEMINI_RUNTIME_ROOT" ]] || return 0
  sc_ensure_dir "$SC_GLOBAL/runtime" "runtime state"
  SC_GEMINI_RUNTIME_ROOT=$(mktemp -d "$SC_GLOBAL/runtime/.gemini-adapter.XXXXXXXXXXXX")
  chmod 700 -- "$SC_GEMINI_RUNTIME_ROOT"
}

sc_gemini_adapter_candidates_json() {
  local model result='[]'
  if (( SC_GEMINI_AUTO )); then
    while IFS= read -r model; do
      [[ -n "$model" ]] || continue
      result="$(jq -cn --argjson current "$result" --arg model "$model" '$current + [$model]')"
    done < <(sc_gemini_candidate_models)
  else
    model="$(sc_gemini_model_slug "$SC_GEMINI_MODEL")"
    sc_gemini_require_free_model "$model"
    result="$(jq -cn --arg model "$model" '[$model]')"
  fi
  jq -e 'type=="array" and length>0 and length<=16 and all(.[]; type=="string")' <<<"$result" >/dev/null ||
    sc_die "Gemini candidate model policy produced invalid metadata" 78
  printf '%s\n' "$result"
}

sc_gemini_snapshot_quota_rotation() {
  local snapshot=${1:-} result
  [[ -n "$snapshot" && -r "$snapshot" ]] ||
    sc_die "Gemini snapshot is unavailable while deriving quota-rotation capability" 78
  # `jq -e` treats the valid JSON boolean false as a process failure. Use
  # ordinary output status here and let the explicit type check reject only
  # malformed capability values.
  result="$(jq -r '
    (.capabilities.quota_key_rotation // false) |
    if type=="boolean" then . else error("invalid quota rotation capability") end
  ' "$snapshot")" || sc_die "Gemini snapshot has an invalid quota-rotation capability" 78
  printf '%s\n' "$result"
}

sc_gemini_adapter_snapshot_json() {
  local adapter_sha=$1 candidates
  [[ "$adapter_sha" =~ ^[0-9a-f]{64}$ ]] || sc_die "Gemini adapter digest is invalid" 78
  candidates="$(sc_gemini_adapter_candidates_json)"
  jq -cnS \
    --arg schema sandcodex.gemini-provider-snapshot.v1 \
    --arg provider google-ai-studio \
    --arg api_base "$SC_GEMINI_API_BASE" \
    --arg routing_model "$SC_MODEL" \
