class PortalError(RuntimeError):
    """A bounded caller error that is safe to expose over the private bus."""


def _canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")


def _denied_external_handler_executable(value: str) -> bool:
    """Mirror the controller's ambient-launcher/interpreter family policy."""
    basename = os.path.basename(value).casefold()
    return (
        basename in DENIED_URI_HANDLER_BASENAMES
        or VERSIONED_HANDLER_INTERPRETER_RE.fullmatch(basename) is not None
    )


@dataclass(frozen=True)
class OpenUriPolicy:
    """Exact launch-authorized URI handler policy.

    The transport is canonical, unpadded base64url JSON so the controller and
    this helper can bind one stable SHA-256 receipt without a writable policy
    file. The URI is never interpolated; it becomes one final argv element.
    """

    handler: tuple[str, ...]
    schemes: tuple[str, ...]
    canonical: bytes
    digest: str

    @classmethod
    def decode(cls, encoded: str) -> "OpenUriPolicy":
        if (
            not isinstance(encoded, str)
            or not encoded
            or len(encoded) > MAX_OPEN_URI_POLICY_BYTES
            or BASE64URL_RE.fullmatch(encoded) is None
        ):
            raise PortalError("OpenURI policy transport is not canonical base64url")
        try:
            padding = "=" * ((4 - len(encoded) % 4) % 4)
            raw = base64.b64decode(encoded + padding, altchars=b"-_", validate=True)
        except (ValueError, binascii.Error) as error:
            raise PortalError("OpenURI policy transport is invalid") from error
        if len(raw) > MAX_OPEN_URI_POLICY_BYTES:
            raise PortalError("OpenURI policy exceeds its byte ceiling")
        try:
            value = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PortalError("OpenURI policy is not canonical UTF-8 JSON") from error
        canonical = _canonical_json(value)
        canonical_encoded = base64.urlsafe_b64encode(canonical).decode("ascii").rstrip("=")
        if canonical != raw or canonical_encoded != encoded:
            raise PortalError("OpenURI policy transport is not canonical")
        if not isinstance(value, dict) or set(value) != {"schema", "handler", "schemes"}:
            raise PortalError("OpenURI policy has an invalid shape")
        if value.get("schema") != OPEN_URI_POLICY_SCHEMA:
            raise PortalError("OpenURI policy schema is unsupported")

        raw_handler = value.get("handler")
        if not isinstance(raw_handler, list) or not raw_handler or len(raw_handler) > MAX_URI_HANDLER_ARGS:
            raise PortalError("OpenURI handler must be a bounded non-empty argv array")
        handler: list[str] = []
        aggregate = 0
        for index, item in enumerate(raw_handler):
            text = _bounded_text(
                item,
                f"OpenURI handler[{index}]",
                MAX_URI_HANDLER_ARG_BYTES,
                allow_empty=False,
            )
            if any(ord(character) < 0x20 or ord(character) == 0x7F for character in text):
                raise PortalError(f"OpenURI handler[{index}] contains control characters")
            aggregate += len(text.encode("utf-8")) + 1
            if aggregate > MAX_URI_HANDLER_BYTES:
                raise PortalError("OpenURI handler exceeds its aggregate byte ceiling")
            handler.append(text)
        executable = handler[0]
        if not os.path.isabs(executable) or os.path.normpath(executable) != executable:
            raise PortalError("OpenURI handler executable must be one canonical absolute path")
        if not executable.startswith("/nix/store/"):
            raise PortalError("OpenURI handler executable must be in the immutable Nix store")
        if _denied_external_handler_executable(executable):
            raise PortalError("OpenURI handler may not be an ambient dispatcher or programmable interpreter")

        raw_schemes = value.get("schemes")
        if not isinstance(raw_schemes, list) or not raw_schemes or len(raw_schemes) > MAX_URI_SCHEMES:
            raise PortalError("OpenURI schemes must be a bounded non-empty array")
        schemes: list[str] = []
        for index, item in enumerate(raw_schemes):
            scheme = _bounded_text(
                item,
                f"OpenURI schemes[{index}]",
                MAX_URI_SCHEME_BYTES,
                allow_empty=False,
            ).casefold()
            if URI_SCHEME_RE.fullmatch(scheme) is None:
                raise PortalError(f"OpenURI schemes[{index}] is invalid")
            if scheme in DENIED_URI_SCHEMES:
                raise PortalError(f"OpenURI scheme is permanently denied: {scheme}")
            if scheme in schemes:
                raise PortalError(f"OpenURI schemes[{index}] duplicates {scheme}")
            schemes.append(scheme)
        if schemes != sorted(schemes):
            raise PortalError("OpenURI schemes are not in canonical sorted order")
        return cls(tuple(handler), tuple(schemes), canonical, hashlib.sha256(canonical).hexdigest())

    def normalize_uri(self, value: Any) -> str:
        uri = _bounded_text(value, "uri", MAX_URI_BYTES, allow_empty=False)
        if any(ord(character) <= 0x20 or ord(character) == 0x7F for character in uri):
            raise PortalError("uri contains whitespace or control characters")
        if "\\" in uri:
            raise PortalError("uri contains a non-RFC3986 path separator")
        try:
            parsed = urllib.parse.urlsplit(uri)
        except ValueError as error:
            raise PortalError("uri is malformed") from error
        scheme = parsed.scheme.casefold()
        if not scheme or URI_SCHEME_RE.fullmatch(scheme) is None:
            raise PortalError("uri has no valid scheme")
        if scheme in DENIED_URI_SCHEMES or scheme not in self.schemes:
            raise PortalError(f"uri scheme is not launch-authorized: {scheme}")
        if parsed.username is not None or parsed.password is not None:
            raise PortalError("uri userinfo is not permitted")
        if scheme in {"http", "https"} and not parsed.hostname:
            raise PortalError(f"{scheme} uri requires a host")
        try:
            _ = parsed.port
        except ValueError as error:
            raise PortalError("uri has an invalid port") from error
        return uri

    def argv(self, uri: Any) -> list[str]:
        return [*self.handler, self.normalize_uri(uri)]


@dataclass(frozen=True)
class OpenFilePolicy:
    """Exact launch-authorized descriptor handler policy.

    ``OpenFile`` never resolves a caller pathname. A writable request retains
    the exact O_RDWR open file description with ``F_DUPFD_CLOEXEC``. A
    read-only request is copied into a size-bounded non-executable sealed memfd,
    then exposed through an O_RDONLY descriptor; reopening ``/proc/self/fd/N``
    cannot turn that snapshot into write or execute authority. The child receives the resulting
    descriptor through ``pass_fds``; its exact descriptor number and
    ``/proc/self/fd/N`` reference are exported in fixed Sandcodex variables,
    and the same reference is the final argv element for ordinary GUI apps.
    """

    handler: tuple[str, ...]
    access: str
    kinds: tuple[str, ...]
    readonly_transfer: str
    readonly_maximum_bytes: int
    canonical: bytes
    digest: str

    @classmethod
    def decode(cls, encoded: str) -> "OpenFilePolicy":
        if (
            not isinstance(encoded, str)
            or not encoded
            or len(encoded) > MAX_OPEN_FILE_POLICY_BYTES
            or BASE64URL_RE.fullmatch(encoded) is None
        ):
            raise PortalError("OpenFile policy transport is not canonical base64url")
        try:
            padding = "=" * ((4 - len(encoded) % 4) % 4)
            raw = base64.b64decode(encoded + padding, altchars=b"-_", validate=True)
        except (ValueError, binascii.Error) as error:
            raise PortalError("OpenFile policy transport is invalid") from error
        if len(raw) > MAX_OPEN_FILE_POLICY_BYTES:
            raise PortalError("OpenFile policy exceeds its byte ceiling")
        try:
            value = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PortalError("OpenFile policy is not canonical UTF-8 JSON") from error
        canonical = _canonical_json(value)
        canonical_encoded = base64.urlsafe_b64encode(canonical).decode("ascii").rstrip("=")
        if canonical != raw or canonical_encoded != encoded:
            raise PortalError("OpenFile policy transport is not canonical")
        if not isinstance(value, dict) or set(value) != {
            "schema", "handler", "access", "kinds",
            "readonly_transfer", "readonly_maximum_bytes",
        }:
            raise PortalError("OpenFile policy has an invalid shape")
        if value.get("schema") != OPEN_FILE_POLICY_SCHEMA:
            raise PortalError("OpenFile policy schema is unsupported")

        raw_handler = value.get("handler")
        if not isinstance(raw_handler, list) or not raw_handler or len(raw_handler) > MAX_URI_HANDLER_ARGS:
            raise PortalError("OpenFile handler must be a bounded non-empty argv array")
        handler: list[str] = []
        aggregate = 0
        for index, item in enumerate(raw_handler):
            text = _bounded_text(
                item,
                f"OpenFile handler[{index}]",
                MAX_URI_HANDLER_ARG_BYTES,
                allow_empty=False,
            )
            if any(ord(character) < 0x20 or ord(character) == 0x7F for character in text):
                raise PortalError(f"OpenFile handler[{index}] contains control characters")
            aggregate += len(text.encode("utf-8")) + 1
            if aggregate > MAX_URI_HANDLER_BYTES:
                raise PortalError("OpenFile handler exceeds its aggregate byte ceiling")
            handler.append(text)
        executable = handler[0]
        if not os.path.isabs(executable) or os.path.normpath(executable) != executable:
            raise PortalError("OpenFile handler executable must be one canonical absolute path")
        if not executable.startswith("/nix/store/"):
            raise PortalError("OpenFile handler executable must be in the immutable Nix store")
        if _denied_external_handler_executable(executable):
            raise PortalError("OpenFile handler may not be an ambient dispatcher or programmable interpreter")

        access = value.get("access")
        if access not in {"readonly", "readwrite"}:
            raise PortalError("OpenFile policy access must be readonly or readwrite")
        kinds = value.get("kinds")
        if kinds != ["regular"]:
            raise PortalError("OpenFile policy kinds must be exactly ['regular']")
        readonly_transfer = value.get("readonly_transfer")
        if readonly_transfer != "sealed-memfd-snapshot":
            raise PortalError("OpenFile readonly transfer must be sealed-memfd-snapshot")
        readonly_maximum_bytes = value.get("readonly_maximum_bytes")
        if (
            not isinstance(readonly_maximum_bytes, int)
            or isinstance(readonly_maximum_bytes, bool)
            or not 1 <= readonly_maximum_bytes <= MAX_OPEN_FILE_SNAPSHOT_BYTES
        ):
            raise PortalError("OpenFile readonly snapshot byte ceiling is invalid")
        return cls(
            tuple(handler),
            access,
            ("regular",),
            readonly_transfer,
            readonly_maximum_bytes,
            canonical,
            hashlib.sha256(canonical).hexdigest(),
        )

    def requested_access(self, writable: bool) -> str:
        if writable and self.access != "readwrite":
            raise PortalError("writable OpenFile request exceeds launch authority")
        return "readwrite" if writable else "readonly"

    def argv(self, descriptor: int) -> list[str]:
        if not isinstance(descriptor, int) or descriptor < 0:
            raise PortalError("OpenFile descriptor is invalid")
        return [*self.handler, f"/proc/self/fd/{descriptor}"]


@dataclass(frozen=True)
class OpenDirectoryPolicy:
    """Exact launch-authorized private file-manager handler policy.

    The caller contributes exactly one descriptor for a regular file or
    directory. The portal retains that object, resolves it only inside the
    capsule-visible roots, then independently opens and pins the containing
    directory. The child receives both descriptors through ``pass_fds``. Only
    the directory reference is appended to argv; the selected object's exact
    descriptor and bounded basename are exported in dedicated Sandcodex
    variables for descriptor-aware adapters.
    """

    handler: tuple[str, ...]
    kinds: tuple[str, ...]
    transfer: str
    canonical: bytes
    digest: str

    @classmethod
    def decode(cls, encoded: str) -> "OpenDirectoryPolicy":
        if (
            not isinstance(encoded, str)
            or not encoded
            or len(encoded) > MAX_OPEN_DIRECTORY_POLICY_BYTES
            or BASE64URL_RE.fullmatch(encoded) is None
        ):
            raise PortalError("OpenDirectory policy transport is not canonical base64url")
        try:
            padding = "=" * ((4 - len(encoded) % 4) % 4)
            raw = base64.b64decode(encoded + padding, altchars=b"-_", validate=True)
        except (ValueError, binascii.Error) as error:
            raise PortalError("OpenDirectory policy transport is invalid") from error
        if len(raw) > MAX_OPEN_DIRECTORY_POLICY_BYTES:
            raise PortalError("OpenDirectory policy exceeds its byte ceiling")
        try:
            value = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PortalError("OpenDirectory policy is not canonical UTF-8 JSON") from error
        canonical = _canonical_json(value)
        canonical_encoded = base64.urlsafe_b64encode(canonical).decode("ascii").rstrip("=")
        if canonical != raw or canonical_encoded != encoded:
            raise PortalError("OpenDirectory policy transport is not canonical")
        if not isinstance(value, dict) or set(value) != {"schema", "handler", "kinds", "transfer"}:
            raise PortalError("OpenDirectory policy has an invalid shape")
        if value.get("schema") != OPEN_DIRECTORY_POLICY_SCHEMA:
            raise PortalError("OpenDirectory policy schema is unsupported")

        raw_handler = value.get("handler")
        if not isinstance(raw_handler, list) or not raw_handler or len(raw_handler) > MAX_URI_HANDLER_ARGS:
            raise PortalError("OpenDirectory handler must be a bounded non-empty argv array")
        handler: list[str] = []
        aggregate = 0
        for index, item in enumerate(raw_handler):
            text = _bounded_text(
                item,
                f"OpenDirectory handler[{index}]",
                MAX_URI_HANDLER_ARG_BYTES,
                allow_empty=False,
            )
            if any(ord(character) < 0x20 or ord(character) == 0x7F for character in text):
                raise PortalError(f"OpenDirectory handler[{index}] contains control characters")
            aggregate += len(text.encode("utf-8")) + 1
            if aggregate > MAX_URI_HANDLER_BYTES:
                raise PortalError("OpenDirectory handler exceeds its aggregate byte ceiling")
            handler.append(text)
        executable = handler[0]
        if not os.path.isabs(executable) or os.path.normpath(executable) != executable:
            raise PortalError("OpenDirectory handler executable must be one canonical absolute path")
        if not executable.startswith("/nix/store/"):
            raise PortalError("OpenDirectory handler executable must be in the immutable Nix store")
        if _denied_external_handler_executable(executable):
            raise PortalError(
                "OpenDirectory handler may not be an ambient dispatcher or programmable interpreter"
            )
        if value.get("kinds") != ["regular", "directory"]:
            raise PortalError("OpenDirectory policy kinds must be exactly ['regular', 'directory']")
        transfer = value.get("transfer")
        if transfer != "retained-object-fd+verified-directory-fd":
            raise PortalError("OpenDirectory transfer policy is unsupported")
        return cls(
            tuple(handler),
            ("regular", "directory"),
            transfer,
            canonical,
            hashlib.sha256(canonical).hexdigest(),
        )

    def argv(self, directory_descriptor: int) -> list[str]:
        if not isinstance(directory_descriptor, int) or directory_descriptor < 0:
            raise PortalError("OpenDirectory directory descriptor is invalid")
        return [*self.handler, f"/proc/self/fd/{directory_descriptor}"]


