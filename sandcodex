      --no-companion-campaigns) SC_CAMPAIGN_MAX_COUNT=0; shift ;;
      --foreground-task-handoff)
        case "$SC_PROVIDER_MODE:${SANDCODEX_INTERNAL_FOREGROUND_TASK:-}" in
          remote:remote-auto-task|gemini:gemini-auto-task) ;;
          *) sc_usage_error "--foreground-task-handoff is private to a Sandcodex task child" ;;
        esac
        SC_LOOP_FOREGROUND_TASK=1
        shift
        ;;
      --trust-project-config) SC_TRUST_PROJECT=1; shift ;;
      --json) SC_LOOP_JSON=1; SC_QUIET=1; shift ;;
      --auto-resume) SC_LOOP_AUTO_RESUME=1; SC_LOOP_AUTO_RESUME_EXPLICIT=1; shift ;;
      --no-auto-resume) SC_LOOP_AUTO_RESUME=0; SC_LOOP_AUTO_RESUME_EXPLICIT=1; shift ;;
      --detach) SC_LOOP_DETACH=1; shift ;;
      --recover-on-boot) SC_LOOP_DETACH=1; SC_LOOP_RECOVER_ON_BOOT=1; shift ;;
      --retry-limit) (( $# > 1 )) || sc_usage_error "--retry-limit requires N"; SC_LOOP_RETRY_LIMIT="$2"; shift 2 ;;
      --retry-limit=*) SC_LOOP_RETRY_LIMIT="${1#*=}"; shift ;;
      --retry-base-seconds) (( $# > 1 )) || sc_usage_error "--retry-base-seconds requires N"; SC_LOOP_RETRY_BASE_SECONDS="$2"; shift 2 ;;
      --retry-base-seconds=*) SC_LOOP_RETRY_BASE_SECONDS="${1#*=}"; shift ;;
      --retry-max-seconds) (( $# > 1 )) || sc_usage_error "--retry-max-seconds requires N"; SC_LOOP_RETRY_MAX_SECONDS="$2"; shift 2 ;;
      --retry-max-seconds=*) SC_LOOP_RETRY_MAX_SECONDS="${1#*=}"; shift ;;
      --retry-max-wait-seconds) (( $# > 1 )) || sc_usage_error "--retry-max-wait-seconds requires N"; SC_LOOP_RETRY_MAX_WAIT_SECONDS="$2"; shift 2 ;;
      --retry-max-wait-seconds=*) SC_LOOP_RETRY_MAX_WAIT_SECONDS="${1#*=}"; shift ;;
      --min-free-mib) (( $# > 1 )) || sc_usage_error "--min-free-mib requires N"; SC_LOOP_MIN_FREE_MIB="$2"; shift 2 ;;
      --min-free-mib=*) SC_LOOP_MIN_FREE_MIB="${1#*=}"; shift ;;
      --max-project-growth-mib) (( $# > 1 )) || sc_usage_error "--max-project-growth-mib requires N"; SC_LOOP_MAX_PROJECT_GROWTH_MIB="$2"; shift 2 ;;
      --max-project-growth-mib=*) SC_LOOP_MAX_PROJECT_GROWTH_MIB="${1#*=}"; shift ;;
      --max-downloads-mib) (( $# > 1 )) || sc_usage_error "--max-downloads-mib requires N"; SC_LOOP_MAX_DOWNLOADS_MIB="$2"; shift 2 ;;
      --max-downloads-mib=*) SC_LOOP_MAX_DOWNLOADS_MIB="${1#*=}"; shift ;;
      --max-profile-mib) (( $# > 1 )) || sc_usage_error "--max-profile-mib requires N"; SC_LOOP_MAX_PROFILE_MIB="$2"; shift 2 ;;
      --max-profile-mib=*) SC_LOOP_MAX_PROFILE_MIB="${1#*=}"; shift ;;
      -v|--verbose) (( SC_VERBOSE += 1 )); shift ;;
      -q|--quiet) SC_QUIET=1; shift ;;
      -h|--help) sc_help_topic loop; exit 0 ;;
      *) sc_usage_error "unknown loop option: $1" ;;
    esac
  done
  if (( SC_LOOP_FOREGROUND_TASK )) && \
    [[ -n "${SANDCODEX_INTERNAL_FOREGROUND_TASK:-}" ]]; then
    # The child can cross two launcher boundaries: first the pinned-Nix re-exec,
    # then the externally owned resource scope/service. Preserve the one-use
    # marker until the last required boundary has authenticated it, but erase it
    # before provider or tool processes are created. Test mode without Nix or a
    # requested resource scope is already at that final boundary.
    if [[ "${SANDCODEX_NIX_READY:-0}" == 1 || \
      "${SANDCODEX_TESTING:-0}:${SANDCODEX_NO_NIX:-0}" == 1:1 ]]; then
      if (( SC_BARE || ! SC_RESOURCE_SCOPE )) || \
        [[ -n "${SANDCODEX_RESOURCE_SCOPE:-}" ]] || \
        [[ "${SANDCODEX_TESTING:-0}:${SANDCODEX_TEST_RESOURCE_SCOPE:-0}" == 1:0 ]]; then
        unset SANDCODEX_INTERNAL_FOREGROUND_TASK
      fi
    fi
  fi
  if (( ! SC_LOOP_FOREGROUND_TASK )); then
    SC_CAMPAIGN_MAX_COUNT=0
  fi
}

sc_parse_remote_auto_task() {
  local -a task_args=()
  SC_LOOP_TURNS=1
  SC_LOOP_AUTO_RESUME=1
  while (( $# )); do
    case "$1" in
      --then-interactive) SC_REMOTE_AUTO_TASK_THEN_INTERACTIVE=1; shift ;;
      --no-then-interactive) SC_REMOTE_AUTO_TASK_THEN_INTERACTIVE=0; shift ;;
      --detach|--recover-on-boot)
        sc_usage_error "remote auto task is a foreground first-turn lane; use remote auto loop for detached loops" ;;
      --RESUME|--RESUME=*)
        sc_usage_error "remote auto task starts a fresh bound conversation; use --then-interactive to resume after the first turn" ;;
      --profile)
        (( $# > 1 )) || sc_usage_error "--profile requires NAME"
        sc_remote_profile_valid "$2" || sc_usage_error "$(sc_remote_profile_usage)"
        SC_REMOTE_PROFILE=$2; shift 2 ;;
      --profile=*)
        sc_remote_profile_valid "${1#*=}" || sc_usage_error "$(sc_remote_profile_usage)"
        SC_REMOTE_PROFILE=${1#*=}; shift ;;
      --turns)
        (( $# > 1 )) || sc_usage_error "--turns requires N"
        task_args+=("$1" "$2"); shift 2 ;;
      --turns=*) task_args+=("$1"); shift ;;
      *) task_args+=("$1"); shift ;;
    esac
  done
  SC_COMMAND="remote-auto-task"
  SC_LOOP_FOREGROUND_TASK=1
  sc_parse_loop "${task_args[@]}"
  [[ "$SC_LOOP_ACTION" == run ]] || sc_usage_error "remote auto task accepts only run-style loop options"
  (( SC_LOOP_PROMPT_SET )) || sc_usage_error "remote auto task requires --prompt-file PATH or --prompt TEXT"
  [[ "$SC_RESUME" == fresh ]] || sc_usage_error "remote auto task starts fresh rooms only"
  (( ! SC_LOOP_DETACH )) || sc_usage_error "remote auto task cannot detach"
}

