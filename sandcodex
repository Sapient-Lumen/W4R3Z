+static bool sandcodex_touch_pair_active_route(struct sway_seat *seat,
+		struct wlr_surface *expected_surface,
+		struct wlr_seat_client *expected_client,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		double expected_first_sx, double expected_first_sy,
+		double expected_second_sx, double expected_second_sy) {
+	if (!seat || !seat->wlr_seat || !expected_surface || !expected_client ||
+			seat->focused_layer || seat->has_exclusive_layer ||
+			server.session_lock.lock ||
+			!seat_is_input_allowed(seat, expected_surface) ||
+			!wlr_surface_accepts_touch(expected_surface, seat->wlr_seat)) {
+		return false;
+	}
+	struct wlr_seat_touch_state *state = &seat->wlr_seat->touch_state;
+	struct wlr_touch_point *first = wlr_seat_touch_get_point(seat->wlr_seat,
+		SANDCODEX_TOUCH_ID);
+	struct wlr_touch_point *second = wlr_seat_touch_get_point(seat->wlr_seat,
+		SANDCODEX_TOUCH_SECOND_ID);
+	return state->grab && state->default_grab &&
+		state->grab == state->default_grab &&
+		(uintptr_t)state->grab == expected_grab_address &&
+		(uintptr_t)state->default_grab == expected_default_grab_address &&
+		first && second && first != second &&
+		first->touch_id == SANDCODEX_TOUCH_ID &&
+		second->touch_id == SANDCODEX_TOUCH_SECOND_ID &&
+		first->surface == expected_surface && second->surface == expected_surface &&
+		first->client == expected_client && second->client == expected_client &&
+		first->focus_surface == expected_surface &&
+		second->focus_surface == expected_surface &&
+		first->focus_client == expected_client &&
+		second->focus_client == expected_client &&
+		sandcodex_double_bits(first->sx) ==
+			sandcodex_double_bits(expected_first_sx) &&
+		sandcodex_double_bits(first->sy) ==
+			sandcodex_double_bits(expected_first_sy) &&
+		sandcodex_double_bits(second->sx) ==
+			sandcodex_double_bits(expected_second_sx) &&
+		sandcodex_double_bits(second->sy) ==
+			sandcodex_double_bits(expected_second_sy) &&
+		wlr_seat_touch_num_points(seat->wlr_seat) == 2 &&
+		sandcodex_touch_recipient_route_exact(seat, expected_surface,
+			expected_client, expected_resource_address, expected_resource_id);
+}
+
+static bool sandcodex_touch_release_pair(struct sway_seat *seat,
+		struct wlr_surface *expected_surface,
+		struct wlr_seat_client *expected_client,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		uint32_t time_msec, bool *grab_bypass_used) {
+	if (grab_bypass_used) {
+		*grab_bypass_used = false;
+	}
+	if (!grab_bypass_used || !seat || !seat->wlr_seat || !expected_surface ||
+			!expected_client || expected_grab_address == 0 ||
+			expected_grab_address != expected_default_grab_address) {
+		return false;
+	}
+	struct wlr_seat *wlr_seat = seat->wlr_seat;
+	struct wlr_touch_point *first = wlr_seat_touch_get_point(wlr_seat,
+		SANDCODEX_TOUCH_ID);
+	struct wlr_touch_point *second = wlr_seat_touch_get_point(wlr_seat,
+		SANDCODEX_TOUCH_SECOND_ID);
+	size_t expected_points = (first ? 1 : 0) + (second ? 1 : 0);
+	if (expected_points == 0 || first == second ||
+			(size_t)wlr_seat_touch_num_points(wlr_seat) != expected_points ||
+			(first && (first->touch_id != SANDCODEX_TOUCH_ID ||
+				first->surface != expected_surface ||
+				first->client != expected_client ||
+				first->focus_surface != expected_surface ||
+				first->focus_client != expected_client)) ||
+			(second && (second->touch_id != SANDCODEX_TOUCH_SECOND_ID ||
+				second->surface != expected_surface ||
+				second->client != expected_client ||
+				second->focus_surface != expected_surface ||
+				second->focus_client != expected_client))) {
+		return false;
+	}
+
+	struct wlr_seat_touch_state *state = &wlr_seat->touch_state;
+	bool exact_default_grab = state->grab && state->default_grab &&
+		state->grab == state->default_grab &&
+		(uintptr_t)state->grab == expected_grab_address &&
+		(uintptr_t)state->default_grab == expected_default_grab_address;
+	bool exact_recipient = sandcodex_touch_recipient_route_exact(seat,
+		expected_surface, expected_client, expected_resource_address,
+		expected_resource_id);
+	bool sent_normal = false;
+	bool normal_frame_safe = exact_default_grab && exact_recipient;
+	if (normal_frame_safe && first) {
+		wlr_seat_touch_notify_up(wlr_seat, time_msec, SANDCODEX_TOUCH_ID);
+		sent_normal = true;
+	}
+
+	/* Inter-contact phase latch: a synchronous first-contact up callback may
+	 * replace the grab, retain the first point, or change recipient authority.
+	 * The second normal up is admitted only after re-proving one exact remaining
+	 * contact, its focus/origin, the original default grab, and the same sole
+	 * wl_touch resource. No second event is routed through changed authority. */
+	first = wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_ID);
+	second = wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_SECOND_ID);
+	state = &wlr_seat->touch_state;
+	exact_default_grab = state->grab && state->default_grab &&
+		state->grab == state->default_grab &&
+		(uintptr_t)state->grab == expected_grab_address &&
+		(uintptr_t)state->default_grab == expected_default_grab_address;
+	exact_recipient = sandcodex_touch_recipient_route_exact(seat,
+		expected_surface, expected_client, expected_resource_address,
+		expected_resource_id);
+	bool second_phase_exact = !first && second &&
+		second->touch_id == SANDCODEX_TOUCH_SECOND_ID &&
+		second->surface == expected_surface &&
+		second->client == expected_client &&
+		second->focus_surface == expected_surface &&
+		second->focus_client == expected_client &&
+		wlr_seat_touch_num_points(wlr_seat) == 1 &&
+		exact_default_grab && exact_recipient;
+	if (second_phase_exact) {
+		wlr_seat_touch_notify_up(wlr_seat, time_msec,
+			SANDCODEX_TOUCH_SECOND_ID);
+		sent_normal = true;
+	}
+
+	/* A second-contact up callback may also replace the grab. Route the normal
+	 * frame only after a final phase proof. If that proof fails, direct
+	 * exact-origin cleanup below owns the frame and forces overall failure. */
+	state = &wlr_seat->touch_state;
+	exact_default_grab = state->grab && state->default_grab &&
+		state->grab == state->default_grab &&
+		(uintptr_t)state->grab == expected_grab_address &&
+		(uintptr_t)state->default_grab == expected_default_grab_address;
+	exact_recipient = sandcodex_touch_recipient_route_exact(seat,
+		expected_surface, expected_client, expected_resource_address,
+		expected_resource_id);
+	bool normal_frame_sent = false;
+	if (sent_normal && exact_default_grab && exact_recipient) {
+		wlr_seat_touch_notify_frame(wlr_seat);
+		normal_frame_sent = true;
+	}
+
+	bool sent_cleanup = false;
+	first = wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_ID);
+	if (first) {
+		if (first->touch_id != SANDCODEX_TOUCH_ID ||
+				first->surface != expected_surface || first->client != expected_client) {
+			return false;
+		}
+		*grab_bypass_used = true;
+		sent_cleanup = true;
+		wlr_seat_touch_send_up(wlr_seat, time_msec, SANDCODEX_TOUCH_ID);
+	}
+	second = wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_SECOND_ID);
+	if (second) {
+		if (second->touch_id != SANDCODEX_TOUCH_SECOND_ID ||
+				second->surface != expected_surface || second->client != expected_client) {
+			return false;
+		}
+		*grab_bypass_used = true;
+		sent_cleanup = true;
+		wlr_seat_touch_send_up(wlr_seat, time_msec,
+			SANDCODEX_TOUCH_SECOND_ID);
+	}
+	if (sent_cleanup || (sent_normal && !normal_frame_sent)) {
+		/* Cleanup only: bypassing the grab or framing after a phase-latch
+		 * failure always forces action failure. */
+		*grab_bypass_used = true;
+		wlr_seat_touch_send_frame(wlr_seat);
+	}
+	return wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_ID) == NULL &&
+		wlr_seat_touch_get_point(wlr_seat, SANDCODEX_TOUCH_SECOND_ID) == NULL &&
+		wlr_seat_touch_num_points(wlr_seat) == 0;
+}
+
+static bool sandcodex_dispatch_touch_gesture(struct sway_seat *seat,
+		struct wlr_surface *expected_surface,
+		struct wlr_seat_client *expected_client,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		const double *first_sx, const double *first_sy,
+		const double *second_sx, const double *second_sy,
+		uint32_t steps, uint32_t duration_msec) {
+	if (!first_sx || !first_sy || !second_sx || !second_sy ||
+			steps == 0 || steps > SANDCODEX_TOUCH_GESTURE_MAX_STEPS ||
+			duration_msec < steps + 1 ||
+			duration_msec > SANDCODEX_TOUCH_GESTURE_MAX_DURATION_MSEC ||
+			!seat || !seat->wlr_seat || !expected_surface ||
+			!expected_surface->resource || !expected_client ||
+			seat->focused_layer || seat->has_exclusive_layer ||
+			server.session_lock.lock ||
+			!seat_is_input_allowed(seat, expected_surface) ||
+			!wlr_surface_accepts_touch(expected_surface, seat->wlr_seat) ||
+			!sandcodex_touch_default_route(seat, expected_grab_address,
+				expected_default_grab_address) ||
+			!sandcodex_touch_recipient_route_exact(seat, expected_surface,
+				expected_client, expected_resource_address,
+				expected_resource_id)) {
+		return false;
+	}
+
+	uint32_t base_time = get_current_time_in_msec();
+	uint32_t first_serial = wlr_seat_touch_notify_down(seat->wlr_seat,
+		expected_surface, base_time, SANDCODEX_TOUCH_ID,
+		first_sx[0], first_sy[0]);
+	bool first_created = wlr_seat_touch_get_point(seat->wlr_seat,
+		SANDCODEX_TOUCH_ID) != NULL;
+	bool first_phase_route_exact = first_created &&
+		sandcodex_touch_active_route(seat, expected_surface, expected_client,
+			expected_grab_address, expected_default_grab_address,
+			expected_resource_address, expected_resource_id,
+			first_sx[0], first_sy[0]);
+	bool first_phase_exact = first_serial != 0 && first_phase_route_exact;
+
+	/* Inter-contact phase latch: contact two is not emitted until contact one's
+	 * synchronous down path has re-proved the birth-pinned default grab, exact
+	 * point origin/focus, sole wl_touch resource, and one-point seat state. */
+	uint32_t second_serial = 0;
+	if (first_phase_exact) {
+		second_serial = wlr_seat_touch_notify_down(seat->wlr_seat,
+			expected_surface, base_time, SANDCODEX_TOUCH_SECOND_ID,
+			second_sx[0], second_sy[0]);
+	}
+	bool second_created = wlr_seat_touch_get_point(seat->wlr_seat,
+		SANDCODEX_TOUCH_SECOND_ID) != NULL;
+	bool pair_phase_route_exact = first_created && second_created &&
+		sandcodex_touch_pair_active_route(seat, expected_surface,
+			expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[0], first_sy[0],
+			second_sx[0], second_sy[0]);
+	bool exact = first_phase_exact && second_serial != 0 &&
+		pair_phase_route_exact;
+	/* A client-visible pair frame requires both nonzero down serials as well as
+	 * the exact paired route. A zero serial is never upgraded into published
+	 * authority merely because wlroots happened to retain a point. */
+	if (exact) {
+		wlr_seat_touch_notify_frame(seat->wlr_seat);
+		exact = sandcodex_touch_pair_active_route(seat,
+			expected_surface, expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[0], first_sy[0],
+			second_sx[0], second_sy[0]);
+	} else if (first_phase_exact && first_created && !second_created) {
+		/* A failed or refused second down may still leave one exact first
+		 * contact whose own serial was proven. Frame it only through the
+		 * re-proved original route; release remains cleanup and the action cannot
+		 * succeed. An unproven first serial never reaches this path. */
+		first_phase_route_exact = sandcodex_touch_active_route(seat,
+			expected_surface, expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[0], first_sy[0]);
+		if (first_phase_route_exact) {
+			wlr_seat_touch_notify_frame(seat->wlr_seat);
+		}
+		exact = false;
+	} else {
+		exact = false;
+	}
+
+	uint32_t previous_offset = 0;
+	for (uint32_t index = 1; exact && index <= steps; ++index) {
+		uint32_t offset = (uint32_t)(((uint64_t)duration_msec * index) /
+			(uint64_t)(steps + 1));
+		if (offset <= previous_offset || offset >= duration_msec) {
+			exact = false;
+			break;
+		}
+		previous_offset = offset;
+		wlr_seat_touch_notify_motion(seat->wlr_seat, base_time + offset,
+			SANDCODEX_TOUCH_ID, first_sx[index], first_sy[index]);
+
+		/* Paired-motion phase latch: contact two may advance only after contact
+		 * one's synchronous motion leaves both contacts on the exact original
+		 * route, with contact one at the new coordinate and contact two still at
+		 * its previous coordinate. */
+		bool first_motion_phase_exact = sandcodex_touch_pair_active_route(seat,
+			expected_surface, expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[index], first_sy[index],
+			second_sx[index - 1], second_sy[index - 1]);
+		if (!first_motion_phase_exact) {
+			exact = false;
+			break;
+		}
+		wlr_seat_touch_notify_motion(seat->wlr_seat, base_time + offset,
+			SANDCODEX_TOUCH_SECOND_ID, second_sx[index], second_sy[index]);
+
+		/* The paired frame is also authority-bearing. Re-prove the complete
+		 * pair before routing it, then re-prove once more after the callback. */
+		bool pair_frame_phase_exact = sandcodex_touch_pair_active_route(seat,
+			expected_surface, expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[index], first_sy[index],
+			second_sx[index], second_sy[index]);
+		if (!pair_frame_phase_exact) {
+			exact = false;
+			break;
+		}
+		wlr_seat_touch_notify_frame(seat->wlr_seat);
+		exact = sandcodex_touch_pair_active_route(seat, expected_surface,
+			expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, first_sx[index], first_sy[index],
+			second_sx[index], second_sy[index]);
+	}
+
+	bool grab_bypass_release_used = false;
+	bool released = false;
+	if (first_created || second_created) {
+		released = sandcodex_touch_release_pair(seat, expected_surface,
+			expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, base_time + duration_msec,
+			&grab_bypass_release_used);
+	}
+	return exact && first_created && second_created && released &&
+		!grab_bypass_release_used &&
+		sandcodex_touch_default_route(seat, expected_grab_address,
+			expected_default_grab_address) &&
+		sandcodex_touch_recipient_route_exact(seat, expected_surface,
+			expected_client, expected_resource_address, expected_resource_id);
+}
+
+static bool sandcodex_dispatch_touch_tap(struct sway_seat *seat,
+		struct wlr_surface *expected_surface,
+		struct wlr_seat_client *expected_client,
+		uintptr_t expected_grab_address,
+		uintptr_t expected_default_grab_address,
+		uintptr_t expected_resource_address, uint32_t expected_resource_id,
+		double sx, double sy) {
+	if (!seat || !seat->wlr_seat || !expected_surface ||
+			!expected_surface->resource || !expected_client ||
+			seat->focused_layer || seat->has_exclusive_layer ||
+			server.session_lock.lock ||
+			!seat_is_input_allowed(seat, expected_surface) ||
+			!wlr_surface_accepts_touch(expected_surface, seat->wlr_seat) ||
+			!sandcodex_touch_default_route(seat, expected_grab_address,
+				expected_default_grab_address) ||
+			!sandcodex_touch_recipient_route_exact(seat, expected_surface,
+				expected_client, expected_resource_address,
+				expected_resource_id)) {
+		return false;
+	}
+
+	uint32_t time_msec = get_current_time_in_msec();
+	uint32_t down_serial = wlr_seat_touch_notify_down(seat->wlr_seat,
+		expected_surface, time_msec, SANDCODEX_TOUCH_ID, sx, sy);
+	bool point_created = wlr_seat_touch_get_point(seat->wlr_seat,
+		SANDCODEX_TOUCH_ID) != NULL;
+	bool down_exact = point_created && down_serial != 0 &&
+		sandcodex_touch_active_route(seat, expected_surface, expected_client,
+			expected_grab_address, expected_default_grab_address,
+			expected_resource_address, expected_resource_id, sx, sy);
+	if (down_exact) {
+		wlr_seat_touch_notify_frame(seat->wlr_seat);
+		down_exact = sandcodex_touch_active_route(seat, expected_surface,
+			expected_client, expected_grab_address,
+			expected_default_grab_address, expected_resource_address,
+			expected_resource_id, sx, sy);
+	}
+	bool grab_bypass_release_used = false;
+	bool released = point_created && sandcodex_touch_release_point(seat,
+		expected_surface, expected_client, expected_grab_address,
+		expected_default_grab_address, time_msec, &grab_bypass_release_used);
+	return down_exact && point_created && released && !grab_bypass_release_used &&
+		sandcodex_touch_default_route(seat, expected_grab_address,
+			expected_default_grab_address) &&
+		sandcodex_touch_recipient_route_exact(seat, expected_surface,
+			expected_client, expected_resource_address, expected_resource_id);
+}
