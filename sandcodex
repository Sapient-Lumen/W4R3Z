+static json_object *sandcodex_parse_hit_test_request(const char *payload,
+		uint32_t payload_length) {
+	if (payload_length == 0 || payload_length > SANDCODEX_HIT_TEST_MAX_PAYLOAD ||
+			memchr(payload, '\0', payload_length) != NULL) {
+		return NULL;
+	}
+	struct json_tokener *tokener = json_tokener_new();
+	if (!tokener) {
+		return NULL;
+	}
+	json_object *request = json_tokener_parse_ex(tokener, payload,
+		(int)payload_length);
+	bool valid = json_tokener_get_error(tokener) == json_tokener_success &&
+		json_tokener_get_parse_end(tokener) == (size_t)payload_length && request &&
+		json_object_is_type(request, json_type_object);
+	json_tokener_free(tokener);
+	if (!valid) {
+		if (request) {
+			json_object_put(request);
+		}
+		return NULL;
+	}
+	return request;
+}
+
+static void sandcodex_json_add_optional_string(json_object *reply,
+		const char *name, const char *value) {
+	json_object_object_add(reply, name,
+		value ? json_object_new_string(value) : NULL);
+}
+
+static void sandcodex_send_hit_test_failure(struct ipc_client *client,
+		const char *error) {
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(false));
+	json_object_object_add(reply, "error", json_object_new_string(error));
+	const char *json_string = json_object_to_json_string_ext(reply,
+		JSON_C_TO_STRING_PLAIN);
+	ipc_send_reply(client, IPC_SANDCODEX_HIT_TEST, json_string,
+		(uint32_t)strlen(json_string));
+	json_object_put(reply);
+}
