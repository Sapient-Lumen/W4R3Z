def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser()
    sub = value.add_subparsers(dest="command", required=True)
    serve = sub.add_parser("serve")
    serve.add_argument("--config", type=Path, required=True)
    serve.add_argument("--token-file", type=Path, required=True)
    serve.add_argument("--ready-file", type=Path, required=True)
    serve.add_argument("--host", default="127.0.0.1")
    serve.add_argument("--port", type=int, default=0)
    sub.add_parser("self-test")
    return value


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.command == "self-test":
        return self_test()
    if args.host != "127.0.0.1" or not 0 <= args.port <= 65535:
        raise AdapterError("adapter may bind only IPv4 loopback", status=78,
                           code="unsafe_configuration")
    runtime = Runtime(args.config, args.token_file)
    server = Server((args.host, args.port), runtime)
    write_ready(args.ready_file, server, args.config)

