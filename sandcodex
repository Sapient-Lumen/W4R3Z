    "schema": "sandcodex.project-browser-native.v1",
    "descriptor": os.fspath(descriptor),
    "extension": os.fspath(selected_extension),
    "native_name": name,
    "native_description": description,
    "native_entrypoint": os.fspath(entrypoint),
    "native_source_root": os.fspath(source_root),
