+        (slider_present &&
+            slider_start_65535 >= SANDCODEX_STYLUS_SLIDER_MIN_65535 &&
+            slider_start_65535 <= SANDCODEX_STYLUS_SLIDER_MAX_65535 &&
+            slider_end_65535 >= SANDCODEX_STYLUS_SLIDER_MIN_65535 &&
+            slider_end_65535 <= SANDCODEX_STYLUS_SLIDER_MAX_65535)) &&
