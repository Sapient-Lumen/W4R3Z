+		grant->from_x == start_x && grant->from_y == start_y &&
+		grant->x == end_x && grant->y == end_y &&
+		grant->touch_stroke_steps == steps &&
+		grant->touch_stroke_duration_msec == duration_msec &&
+		expected_target.surface_hit && expected_target.target_surface_address != 0 &&
+		expected_grab_address != 0 &&
+		expected_grab_address == expected_default_grab_address &&
+		expected_seat_client_address != 0 && expected_resource_address != 0 &&
+		expected_resource_id != 0 &&
+		sandcodex_constant_time_equal(ticket, grant->value,
+			SANDCODEX_DISPATCH_TICKET_LENGTH);
