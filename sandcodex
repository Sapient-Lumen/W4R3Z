  sc_ensure_dir "$viewer_home" "desktop viewer private home"
  sc_atomic "$viewer" 700 <<'PY'
#!/usr/bin/env python3
from __future__ import annotations
import base64, json, os, socket, stat, struct, sys, threading, time
from pathlib import Path

control_path, mcp_path, display, xauthority, wayland_display, runtime_dir, width_raw, height_raw, title = sys.argv[1:]
width, height = int(width_raw), int(height_raw)
state = {"visible": False, "frames": 0, "rendered_frames": 0, "coalesced_frames": 0,
         "last_frame_at": None, "capture_fps": 0.0, "render_fps": 0.0, "error": None}
lock = threading.Lock()
transition_lock = threading.Lock()
render_lock = threading.Lock()
host_display_backend = "wayland" if wayland_display and runtime_dir else "x11" if display and xauthority else None
gtk_ready = host_display_backend is not None
Gtk = GLib = GdkPixbuf = window = image = None
latest_frame = None
render_pending = False
MAX_CONTROL_BYTES = 4096
MAX_MCP_RESPONSE_BYTES = 64 * 1024 * 1024
MAX_VIEWER_CLIENTS = 8
TARGET_FRAME_RATE = 30
FRAME_INTERVAL = 1.0 / TARGET_FRAME_RATE

if gtk_ready:
    if host_display_backend == "wayland":
        os.environ["WAYLAND_DISPLAY"] = wayland_display
        os.environ["XDG_RUNTIME_DIR"] = runtime_dir
        os.environ["GDK_BACKEND"] = "wayland"
    else:
        os.environ["DISPLAY"] = display
        os.environ["XAUTHORITY"] = xauthority
        os.environ["GDK_BACKEND"] = "x11"
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf, GLib, Gtk
        window = Gtk.Window(title=title)
        window.set_default_size(min(width, 1280), min(height, 800))
        image = Gtk.Image()
        window.add(image)
        window.connect("delete-event", lambda *_: (set_visible(False), True)[1])
    except Exception as error:
        gtk_ready = False
        state["error"] = f"gtk-unavailable:{type(error).__name__}:{str(error)[:160]}"

def set_visible(value: bool) -> None:
    with lock:
        state["visible"] = value
    if not gtk_ready:
        return
    if value:
        window.show_all()
        window.present()
    else:
        window.hide()

def response(action: str) -> dict[str, object]:
    if action in {"show", "hide"}:
        if not gtk_ready:
            return {"ok": False, "schema": "sandcodex.desktop-viewer.v1", "error": "host-viewer-unavailable", "available": False, "visible": False, "backend": "read-only-mcp-png-mirror", "read_only": True, "host_display_backend": None}
        completed = threading.Event()
        desired = action == "show"
        def transition() -> bool:
            set_visible(desired)
            completed.set()
            return False
        with transition_lock:
            GLib.idle_add(transition)
            if not completed.wait(2):
                return {"ok": False, "schema": "sandcodex.desktop-viewer.v1", "error": "viewer-transition-timeout", "available": True, "visible": False, "backend": "read-only-mcp-png-mirror", "read_only": True, "host_display_backend": host_display_backend}
    with lock:
        result = dict(state)
    try:
        desktop_socket_available = stat.S_ISSOCK(os.stat(mcp_path, follow_symlinks=False).st_mode)
    except OSError:
        desktop_socket_available = False
    return {"ok": True, "schema": "sandcodex.desktop-viewer.v1", "action": action,
            "available": gtk_ready, "visible": result["visible"],
            "backend": "read-only-mcp-png-mirror", "read_only": True,
            "host_display_backend": host_display_backend,
            "frame_sequence": result["frames"], "last_frame_at": result["last_frame_at"],
            "target_frame_rate": TARGET_FRAME_RATE,
            "capture_fps": result["capture_fps"], "render_fps": result["render_fps"],
            "rendered_frame_sequence": result["rendered_frames"],
            "coalesced_frames": result["coalesced_frames"],
            "desktop_socket_available": desktop_socket_available,
            "desktop_process_running": None, "error": result["error"]}

client_slots = threading.BoundedSemaphore(MAX_VIEWER_CLIENTS)

def handle_client(client: socket.socket) -> None:
    try:
        client.settimeout(1)
        data = b""
        while b"\n" not in data and len(data) <= MAX_CONTROL_BYTES:
            chunk = client.recv(min(4096, MAX_CONTROL_BYTES + 1 - len(data)))
            if not chunk: break
            data += chunk
        if b"\n" not in data or len(data) > MAX_CONTROL_BYTES:
            raise ValueError("invalid request framing")
        request = json.loads(data.split(b"\n", 1)[0])
        if not isinstance(request, dict) or set(request) != {"action"} or request["action"] not in {"show", "hide", "status"}:
            raise ValueError("invalid request")
        payload = response(request["action"])
    except Exception:
        payload = {"ok": False, "schema": "sandcodex.desktop-viewer.v1", "error": "invalid-viewer-request"}
    try:
        client.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode())
    except OSError:
        pass
    finally:
        client.close()
        client_slots.release()

def control_server() -> None:
    path = Path(control_path)
    try: path.unlink()
    except FileNotFoundError: pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(control_path); os.chmod(control_path, 0o600); server.listen(8)
    while True:
        client, _ = server.accept()
        if not client_slots.acquire(blocking=False):
            client.close()
            continue
        try:
            threading.Thread(target=handle_client, args=(client,), daemon=True).start()
        except Exception:
            client.close()
            client_slots.release()

def read_response(stream, expected_id: int) -> dict[str, object]:
    line = stream.readline(MAX_MCP_RESPONSE_BYTES + 1)
    if not line or len(line) > MAX_MCP_RESPONSE_BYTES or not line.endswith(b"\n"):
        raise RuntimeError("invalid-mcp-response-frame")
    response = json.loads(line)
    if (not isinstance(response, dict) or response.get("jsonrpc") != "2.0" or
            response.get("id") != expected_id or "error" in response or
            not isinstance(response.get("result"), dict)):
        raise RuntimeError("invalid-mcp-response-envelope")
    return response["result"]

def queue_render(frame) -> None:
    global latest_frame, render_pending
    coalesced = False
    with render_lock:
        latest_frame = frame
        if render_pending:
            coalesced = True
        else:
            render_pending = True
    if coalesced:
        with lock:
            state["coalesced_frames"] += 1
        return

    def render() -> bool:
        global latest_frame, render_pending
        with render_lock:
            current = latest_frame
            latest_frame = None
        if current is not None and window.get_visible():
            allocation = window.get_allocation()
            if allocation.width == current.get_width() and allocation.height == current.get_height():
                displayed = current
            else:
                ratio = min(allocation.width / current.get_width(), allocation.height / current.get_height())
                displayed = current.scale_simple(
                    max(1, round(current.get_width() * ratio)),
                    max(1, round(current.get_height() * ratio)),
                    GdkPixbuf.InterpType.BILINEAR,
                )
            image.set_from_pixbuf(displayed)
            now = time.monotonic()
            with lock:
                state["rendered_frames"] += 1
                prior = state.get("last_render_monotonic")
                if isinstance(prior, float) and now > prior:
                    state["render_fps"] = round(1.0 / (now - prior), 1)
                state["last_render_monotonic"] = now
        with render_lock:
            if latest_frame is not None:
                GLib.idle_add(render)
            else:
                render_pending = False
        return False

    GLib.idle_add(render)

def capture_loop() -> None:
    sequence = 0
    connection = None
    stream = None
    while True:
        with lock: visible = state["visible"]
        if not gtk_ready or not visible:
            time.sleep(0.1); continue
        frame_started = time.monotonic()
        try:
            if connection is None:
                connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                connection.settimeout(10); connection.connect(mcp_path)
                stream = connection.makefile("rwb", buffering=0)
                sequence += 1
                stream.write((json.dumps({"jsonrpc":"2.0","id":sequence,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"sandcodex-desktop-viewer","version":"1"}}})+"\n").encode())
                initialized = read_response(stream, sequence)
                if initialized.get("protocolVersion") != "2025-06-18":
                    raise RuntimeError("invalid-mcp-protocol-version")
            sequence += 1
            stream.write((json.dumps({"jsonrpc":"2.0","id":sequence,"method":"tools/call","params":{"name":"desktop_screenshot","arguments":{}}})+"\n").encode())
            result = read_response(stream, sequence)
            block = next(item for item in result.get("content", []) if item.get("type") == "image")
            if (block.get("mimeType") != "image/png" or
                    not isinstance(block.get("data"), str) or
                    len(block["data"]) > MAX_MCP_RESPONSE_BYTES):
                raise RuntimeError("invalid-image-payload")
            payload = base64.b64decode(block["data"], validate=True)
            if (len(payload) < 24 or payload[:8] != b"\x89PNG\r\n\x1a\n" or
                    payload[12:16] != b"IHDR"):
                raise RuntimeError("invalid-png-header")
            frame_width, frame_height = struct.unpack(">II", payload[16:24])
            if not (0 < frame_width <= width and 0 < frame_height <= height):
                raise RuntimeError("invalid-png-dimensions")
            loader = GdkPixbuf.PixbufLoader.new_with_type("png")
            loader.write(payload); loader.close(); pixbuf = loader.get_pixbuf()
            queue_render(pixbuf)
            captured = time.monotonic()
            with lock:
                state["frames"] += 1
                state["last_frame_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
                prior = state.get("last_capture_monotonic")
                if isinstance(prior, float) and captured > prior:
                    state["capture_fps"] = round(1.0 / (captured - prior), 1)
                state["last_capture_monotonic"] = captured
                state["error"] = None
            time.sleep(max(0.0, FRAME_INTERVAL - (time.monotonic() - frame_started)))
        except Exception as error:
            with lock: state["error"] = f"capture:{type(error).__name__}"
            try: stream.close()
            except Exception: pass
            try: connection.close()
            except Exception: pass
            connection = stream = None
            time.sleep(0.5)

threading.Thread(target=control_server, daemon=True).start()
threading.Thread(target=capture_loop, daemon=True).start()
if gtk_ready:
    Gtk.main()
else:
    while True: time.sleep(60)
PY
  (
    sc_close_inherited_fds
    exec env -i PATH="$SC_PATH" HOME="$viewer_home" XDG_CONFIG_HOME="$viewer_home/.config" \
      XDG_CACHE_HOME="$viewer_home/.cache" GI_TYPELIB_PATH="$SC_GI_TYPELIB_PATH" PYTHONSAFEPATH=1 \
      NO_AT_BRIDGE=1 GTK_MODULES= \
      "$SC_SETPRIV" --pdeathsig TERM "$(command -v python3)" -P "$viewer" \
      "$SC_DESKTOP_VIEWER_SOCKET" "$SC_DESKTOP_SOCKET" "$SC_BROWSER_HOST_DISPLAY" \
      "$SC_BROWSER_HOST_XAUTHORITY" "$SC_DESKTOP_HOST_WAYLAND_DISPLAY" \
      "$SC_DESKTOP_HOST_RUNTIME_DIR" "$SC_DESKTOP_WIDTH" "$SC_DESKTOP_HEIGHT" \
      "Sandcodex desktop - $(basename -- "$SC_PROJECT")"
  ) >>"$SC_RUN_ROOT/desktop-viewer.log" 2>&1 & SC_DESKTOP_VIEWER_PID=$!
  SC_DESKTOP_VIEWER_START="$(sc_process_start "$SC_DESKTOP_VIEWER_PID" 2>/dev/null || true)"
  [[ "$SC_DESKTOP_VIEWER_START" =~ ^[0-9]+$ ]] || return 1
  for (( attempt=0; attempt<150; attempt++ )); do
    [[ -S "$SC_DESKTOP_VIEWER_SOCKET" ]] && break
    sc_pid_still_matches "$SC_DESKTOP_VIEWER_PID" "$SC_DESKTOP_VIEWER_START" || break
    sleep 0.02
  done
  [[ -S "$SC_DESKTOP_VIEWER_SOCKET" && ! -L "$SC_DESKTOP_VIEWER_SOCKET" &&
    "$(stat -c %u:%a -- "$SC_DESKTOP_VIEWER_SOCKET" 2>/dev/null || true)" == "$(id -u):600" ]]
}

sc_start_desktop_broker() {
