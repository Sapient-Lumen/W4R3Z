    def guarded_modifier_arc(
        self,
        modifiers: int,
        validator: Callable[[dict[str, Any]], None],
    ) -> tuple[CompositorModifierArc, dict[str, Any]]:
        """Establish one exact-recipient, connection-owned modifier arc."""
        if not self.hit_test_authorized:
            raise ToolError("patched-Sway compositor modifier-arc connection is unauthorized")
        if type(modifiers) is not int or not 1 <= modifiers <= 0xFFFFFFFF:
            raise ToolError("compositor modifier arc requires a nonzero modifier mask")
        if modifiers & ~KEYBOARD_AGENT_ALLOWED_MODIFIERS:
            raise ToolError("compositor modifier arc contains a non-allowlisted modifier")
        if not callable(validator):
            raise ToolError("compositor modifier-arc target validator is unavailable")

        with self.command_lock:
            try:
                arm_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        "modifiers": modifiers,
                        "op": "arm-modifier-arc",
                    }),
                    "SANDCODEX_HIT_TEST arm-modifier-arc",
                )
                target, ticket = self._normalize_modifier_arc_arm_reply(
                    arm_reply, modifiers
                )
                ticket_action = {
                    "dispatch_kind": "modifier-arc",
                    "modifiers": modifiers,
                }
                ticket_authority_sha256 = hmac.new(
                    self.hit_test_key,
                    b"sandcodex-compositor-modifier-arc-ticket-v1\0"
                    + canonical_json(ticket_action)
                    + b"\0"
                    + ticket.encode("ascii"),
                    hashlib.sha256,
                ).hexdigest()
                grant_projection = {
                    "schema": MODIFIER_ARC_SEAL_SCHEMA,
                    "patch_schema": SWAY_HIT_TEST_SCHEMA,
                    "patch_version": SWAY_HIT_TEST_PATCH_VERSION,
                    "operation": "arm-compositor-modifier-arc",
                    "dispatch_kind": "modifier-arc",
                    "modifiers": modifiers,
                    "target_identity_sha256": target["identity_authority_sha256"],
                    "ticket_authority_sha256": ticket_authority_sha256,
                    "ticket_scope": "single-use+this-ipc-connection",
                    "arc_scope": COMPOSITOR_MODIFIER_ARC_SCOPE,
                    "dispatch_atomicity": GUARDED_MODIFIER_ARC_ATOMICITY,
                    "route_scope": COMPOSITOR_KEYBOARD_ROUTE_SCOPE,
                    "binding_scope": COMPOSITOR_KEYBOARD_BINDING_SCOPE,
                }
                grant_sha256 = hmac.new(
                    self.hit_test_key, canonical_json(grant_projection), hashlib.sha256
                ).hexdigest()
                grant = CompositorModifierArcGrant(
                    modifiers=modifiers,
                    ticket=ticket,
                    target=target,
                    grant_sha256=grant_sha256,
                    ticket_authority_sha256=ticket_authority_sha256,
                )
                ticket = None
                self.compositor_modifier_arc_arms += 1
                self.last_compositor_modifier_arc_grant_sha256 = grant_sha256
                self.last_hit_test_identity_sha256 = str(
                    target["identity_authority_sha256"]
                )
            except Exception as error:
                self.compositor_modifier_arc_failures += 1
                self._set_failure(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor modifier arc could not be armed: {error}"
                ) from error

            try:
                validator(dict(grant.target))
            except Exception as validation_error:
                try:
                    cancel_ticket = grant.take_ticket()
                    cancel_reply = self._request_object_locked(
                        SWAY_IPC_SANDCODEX_HIT_TEST,
                        canonical_json({
                            "op": "cancel-modifier-arc",
                            "ticket": cancel_ticket,
                        }),
                        "SANDCODEX_HIT_TEST cancel-modifier-arc",
                    )
                    cancel_ticket = None
                    self._normalize_cancel_modifier_arc_reply(cancel_reply)
                    self.compositor_modifier_arc_cancellations += 1
                except Exception as cancel_error:
                    self.compositor_modifier_arc_failures += 1
                    self._revoke_command_connection(cancel_error)
                    raise ToolError(
                        "modifier-arc target validation failed and its private ticket "
                        "could not be cancelled; Sway IPC was revoked to force clear"
                    ) from validation_error
                raise

            try:
                dispatch_ticket = grant.take_ticket()
                dispatch_reply = self._request_object_locked(
                    SWAY_IPC_SANDCODEX_HIT_TEST,
                    canonical_json({
                        "modifiers": modifiers,
                        "op": "dispatch-modifier-arc",
                        "ticket": dispatch_ticket,
                    }),
                    "SANDCODEX_HIT_TEST dispatch-modifier-arc",
                )
                dispatch_ticket = None
                arc, receipt = self._normalize_dispatch_modifier_arc_reply(
                    dispatch_reply, grant
                )
                self.compositor_modifier_arc_holds += 1
                self.last_compositor_modifier_arc_hold_receipt_sha256 = str(
                    receipt["receipt_sha256"]
                )
                return arc, receipt
            except Exception as error:
                self.compositor_modifier_arc_failures += 1
                # The request may have reached Sway before the response failed.
                # Revoking the authenticated connection triggers its connection-owned
                # de-escalation-only clear even when this process cannot classify outcome.
                self._revoke_command_connection(error)
                if isinstance(error, ToolError):
                    raise
                raise ToolError(
                    f"patched-Sway compositor modifier arc failed closed: {error}"
                ) from error

