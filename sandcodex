+        wlr_tablet_v2_tablet_tool_notify_tilt(tool,
+            (double)tilt_x_degrees, (double)tilt_y_degrees);
+        if (rotation_present) {
+            wlr_tablet_v2_tablet_tool_notify_rotation(tool,
+                (double)sandcodex_stylus_rotation_degrees(
+                    rotation_start_degrees, rotation_delta_degrees, 0, steps));
+        }
+        if (slider_present) {
+            wlr_tablet_v2_tablet_tool_notify_slider(tool,
+                (double)sandcodex_stylus_slider_65535(slider_start_65535,
+                    slider_end_65535, 0, steps) /
