        # escaped, so the caller sees one ordinary successful response.
        runtime.cooldowns = AllAvailable()  # type: ignore[assignment]
        runtime.account_cursor = 0
        runtime.key_attempts = {key_id: 0 for key_id, _label, _key in runtime.keys}
        runtime.key_successes = {key_id: 0 for key_id, _label, _key in runtime.keys}
        runtime.key_failures = {key_id: 0 for key_id, _label, _key in runtime.keys}
        runtime.model_attempts = {model: 0 for model in runtime.candidates}
        runtime.model_successes = {model: 0 for model in runtime.candidates}
        runtime.model_failures = {model: 0 for model in runtime.candidates}
        quota_accounts: list[str] = []
        quota_models: list[str] = []

        def quota_rotation_google_request(_base: str, candidate_key: str,
                                          body: dict[str, Any],
                                          _timeout: float) -> dict[str, Any]:
            quota_accounts.append(candidate_key)
            quota_models.append(body["model"])
            if candidate_key == "secret-one":
                raise UpstreamError(429, "daily-quota", 60, "model")
            return {"status": "completed", "steps": [
                {"type": "model_output", "content": "rotated"}], "usage": {}}

        rotation_request = dict(scheduler_request)
        rotation_request["input"] = [{
            "type": "message", "role": "user",
            "content": [{"type": "input_text", "text": "rotate-account"}],
