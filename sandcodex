class DeferredFileCopy:
    """One redacted in-memory file export deferred to outer TickSeal.

    Selection-backed ``text/uri-list`` is application-controlled. Explicit
    launch-output paths are controller-normalized into the same bounded URI
    envelope. Both may contain sensitive launch-private names, so the bytes
    remain in a mutable controller-only buffer, have no payload-bearing
    representation, and are destroyed exactly once by either ``publish`` or
    ``discard``. Publication is deliberately impossible from this object
    alone: DesktopController first proves the outer guarded-action dispatch
    interval and matching HMAC-bound action authority, then calls ``publish``.
    """

    __slots__ = (
        "launch_id",
        "copy_kind",
        "maximum_file_bytes",
        "maximum_total_bytes",
        "maximum_entries",
        "maximum_directories",
        "maximum_depth",
        "source_mode",
        "source_count",
        "action_authority_sha256",
        "chord",
        "_uri_payload",
        "_resolved",
    )

    def __init__(
        self,
        launch_id: str,
        uri_payload: bytes | bytearray,
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        chord: str | None,
        copy_kind: str = "files",
        maximum_entries: int = MAX_DIRECTORY_COPY_ENTRIES,
        maximum_directories: int = MAX_DIRECTORY_COPY_DIRECTORIES,
        maximum_depth: int = MAX_DIRECTORY_COPY_DEPTH,
        source_mode: str = "selection",
        source_count: int = 1,
        action_authority_sha256: str,
    ) -> None:
        if not isinstance(launch_id, str) or not launch_id or len(launch_id) > 128:
            raise ToolError("FileCopySeal deferred launch identity is invalid")
        if not isinstance(uri_payload, (bytes, bytearray)) or not uri_payload:
            raise ToolError("FileCopySeal deferred URI-list payload is invalid")
        if copy_kind not in {"files", "directory"}:
            raise ToolError("FileCopySeal deferred copy kind is invalid")
        if source_mode not in {"selection", "launch-output", "output-watch"}:
            raise ToolError("FileCopySeal deferred source mode is invalid")
        if source_mode == "selection" and not isinstance(chord, str):
            raise ToolError("selection-backed FileCopySeal requires one copy chord")
        if source_mode in {"launch-output", "output-watch"} and chord is not None:
            raise ToolError("saved-output FileCopySeal cannot retain a copy chord")
        if (
            not isinstance(source_count, int)
            or isinstance(source_count, bool)
            or not 1 <= source_count <= MAX_FILE_COPY_FILES
        ):
            raise ToolError("FileCopySeal deferred source count is invalid")
        if (
            not isinstance(action_authority_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", action_authority_sha256) is None
        ):
            raise ToolError("FileCopySeal deferred action authority is invalid")
        self.launch_id = launch_id
        self.copy_kind = copy_kind
        self.maximum_file_bytes = maximum_file_bytes
        self.maximum_total_bytes = maximum_total_bytes
        self.maximum_entries = maximum_entries
        self.maximum_directories = maximum_directories
        self.maximum_depth = maximum_depth
        self.source_mode = source_mode
        self.source_count = source_count
        self.action_authority_sha256 = action_authority_sha256
        self.chord = chord
        self._uri_payload = bytearray(uri_payload)
        self._resolved = False

    def __repr__(self) -> str:
        return (
            "<DeferredFileCopy payload=redacted "
            f"kind={self.copy_kind} source={self.source_mode} "
            f"bytes={len(self._uri_payload)} resolved={self._resolved}>"
        )

    @property
    def uri_list_bytes(self) -> int:
        return len(self._uri_payload)

    def _wipe(self) -> None:
        if self._uri_payload:
            self._uri_payload[:] = b"\x00" * len(self._uri_payload)
            self._uri_payload.clear()

    def discard(self) -> None:
        """Irrevocably cancel an unpublished capture without path parsing."""
        if self._resolved:
            return
        self._resolved = True
        self._wipe()

    def publish(self, controller: Any) -> dict[str, Any]:
        """Snapshot and publish once; always destroy the URI-list buffer."""
        if self._resolved:
            raise ToolError("FileCopySeal deferred publication was already resolved")
        self._resolved = True
        try:
            result = controller._snapshot_copied_files(
                self.launch_id,
                self._uri_payload,
                maximum_file_bytes=self.maximum_file_bytes,
                maximum_total_bytes=self.maximum_total_bytes,
                copy_kind=self.copy_kind,
                maximum_entries=self.maximum_entries,
                maximum_directories=self.maximum_directories,
                maximum_depth=self.maximum_depth,
                source_mode=self.source_mode,
            )
        finally:
            self._wipe()
        result = dict(result)
        result["source_mode"] = self.source_mode
        result["explicit_source_count"] = (
            self.source_count if self.source_mode == "launch-output" else None
        )
        result["discovered_source_count"] = (
            self.source_count if self.source_mode == "output-watch" else None
        )
        if self.chord is not None:
            result["chord"] = self.chord
        return result

    def __del__(self) -> None:
        # CPython normally releases this local at step exit.  The explicit
        # discard/publish paths remain authoritative; this is only defense in
        # depth for an unexpected interpreter-level unwind.
        with contextlib.suppress(Exception):
            self.discard()


def sc_observe_output_watch_publication_audit(append_audit, *, expected_errors=()):
    """Call ``append_audit`` once and return ``(row_or_none, observation)``."""
    if not callable(append_audit):
        raise ValueError("output_watch_audit_callback_must_be_callable")
    if not isinstance(expected_errors, tuple) or any(
        not isinstance(kind, type)
        or not issubclass(kind, Exception)
        or kind in (Exception, BaseException)
        for kind in expected_errors
    ):
        raise ValueError("output_watch_audit_expected_errors_must_be_specific")
    observation = {
        "schema": "sandcodex.output-watch-publication-audit.v1",
        "publication_committed": True,
        "status": "unknown",
        "append_attempted": True,
        "append_returned_success": None,
        "retry_performed": False,
        "error_category": None,
    }
    try:
        row = append_audit()
    except expected_errors:
        observation["error_category"] = "audit_append_failed"
        return None, observation
    observation["status"] = "recorded"
    observation["append_returned_success"] = True
    return row, observation


class DeferredOutputWatch:
    """One redacted, launch-bound saved-output baseline awaiting TickSeal.

    The baseline may contain sensitive private filenames.  It stays only in
    controller memory and is transferred into a digest-keyed one-attempt lease
    only after the exact desktop_copy action authority and outer
    dispatch-complete TickSeal have been proved.  The raw 256-bit capability is
    returned once, never retained, and wiped from the mutable staging buffer.
    """

    __slots__ = (
        "launch_id",
        "maximum_file_bytes",
        "maximum_total_bytes",
        "maximum_entries",
        "maximum_directories",
        "maximum_depth",
        "action_authority_sha256",
        "_manifest",
        "_token",
        "_token_digest",
        "_resolved",
    )

    def __init__(
        self,
        launch_id: str,
        manifest: dict[str, Any],
        *,
        maximum_file_bytes: int,
        maximum_total_bytes: int,
        maximum_entries: int,
        maximum_directories: int,
        maximum_depth: int,
        action_authority_sha256: str,
    ) -> None:
        if not isinstance(launch_id, str) or not launch_id or len(launch_id) > 128:
            raise ToolError("OutputWatchSeal deferred launch identity is invalid")
        if not isinstance(manifest, dict) or not isinstance(manifest.get("entries"), tuple):
            raise ToolError("OutputWatchSeal deferred baseline is invalid")
        if (
            not isinstance(action_authority_sha256, str)
            or re.fullmatch(r"[0-9a-f]{64}", action_authority_sha256) is None
        ):
            raise ToolError("OutputWatchSeal deferred action authority is invalid")
        token = secrets.token_bytes(OUTPUT_WATCH_TOKEN_BYTES)
        self.launch_id = launch_id
        self.maximum_file_bytes = maximum_file_bytes
        self.maximum_total_bytes = maximum_total_bytes
        self.maximum_entries = maximum_entries
        self.maximum_directories = maximum_directories
        self.maximum_depth = maximum_depth
        self.action_authority_sha256 = action_authority_sha256
        self._manifest: dict[str, Any] | None = manifest
        self._token = bytearray(token)
        self._token_digest = _output_watch_token_digest(token)
        self._resolved = False

    def __repr__(self) -> str:
        manifest = self._manifest
        count = manifest.get("entry_count") if isinstance(manifest, dict) else None
        return (
            "<DeferredOutputWatch token=redacted baseline_paths=redacted "
            f"entries={count} resolved={self._resolved}>"
        )

    def _wipe_token(self) -> None:
        if self._token:
            self._token[:] = b"\x00" * len(self._token)
            self._token.clear()

    def discard(self) -> None:
        if self._resolved:
            return
        self._resolved = True
        self._manifest = None
        self._wipe_token()

    def publish(self, controller: Any) -> dict[str, Any]:
        if self._resolved:
            raise ToolError("OutputWatchSeal deferred publication was already resolved")
        manifest = self._manifest
        if not isinstance(manifest, dict):
            self.discard()
            raise ToolError("OutputWatchSeal deferred baseline disappeared")
        self._resolved = True
        try:
            token = base64.urlsafe_b64encode(bytes(self._token)).decode("ascii").rstrip("=")
            if len(token) != OUTPUT_WATCH_TOKEN_LENGTH:
                raise ToolError("OutputWatchSeal capability encoding is inconsistent")
            result = controller._store_output_watch_lease(
                token_digest=self._token_digest,
                launch_id=self.launch_id,
                manifest=manifest,
                maximum_file_bytes=self.maximum_file_bytes,
                maximum_total_bytes=self.maximum_total_bytes,
                maximum_entries=self.maximum_entries,
                maximum_directories=self.maximum_directories,
                maximum_depth=self.maximum_depth,
                action_authority_sha256=self.action_authority_sha256,
            )
            self._manifest = None
            result = dict(result)
            result["watch_token"] = token
            return result
        finally:
            self._wipe_token()
            if self._manifest is not None:
                self._manifest = None

    def __del__(self) -> None:
        with contextlib.suppress(Exception):
            self.discard()


