+static bool sandcodex_touchpad_pinch_shape_valid(int64_t x, int64_t y,
+        int32_t delta_x, int32_t delta_y, uint32_t fingers,
+        int32_t scale_256, int32_t rotation_degrees, uint32_t steps,
+        uint32_t duration_msec) {
+    int64_t delta_x_raw = (int64_t)delta_x * 256;
+    int64_t delta_y_raw = (int64_t)delta_y * 256;
+    int64_t scale_delta_raw =
+        (int64_t)scale_256 - SANDCODEX_TOUCHPAD_PINCH_SCALE_UNITY_256;
+    int64_t rotation_raw = (int64_t)rotation_degrees * 256;
+    int64_t maximum_magnitude = llabs(delta_x_raw);
+    if (llabs(delta_y_raw) > maximum_magnitude) {
+        maximum_magnitude = llabs(delta_y_raw);
+    }
+    if (llabs(scale_delta_raw) > maximum_magnitude) {
+        maximum_magnitude = llabs(scale_delta_raw);
+    }
+    if (llabs(rotation_raw) > maximum_magnitude) {
+        maximum_magnitude = llabs(rotation_raw);
+    }
+    return x >= 0 && x <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+        y >= 0 && y <= SANDCODEX_HIT_TEST_COORDINATE_LIMIT &&
+        delta_x >= -SANDCODEX_TOUCHPAD_PINCH_MAX_DELTA &&
+        delta_x <= SANDCODEX_TOUCHPAD_PINCH_MAX_DELTA &&
+        delta_y >= -SANDCODEX_TOUCHPAD_PINCH_MAX_DELTA &&
+        delta_y <= SANDCODEX_TOUCHPAD_PINCH_MAX_DELTA &&
+        fingers >= SANDCODEX_TOUCHPAD_PINCH_MIN_FINGERS &&
+        fingers <= SANDCODEX_TOUCHPAD_PINCH_MAX_FINGERS &&
+        scale_256 >= SANDCODEX_TOUCHPAD_PINCH_MIN_SCALE_256 &&
+        scale_256 <= SANDCODEX_TOUCHPAD_PINCH_MAX_SCALE_256 &&
+        rotation_degrees >= -SANDCODEX_TOUCHPAD_PINCH_MAX_ROTATION_DEGREES &&
+        rotation_degrees <= SANDCODEX_TOUCHPAD_PINCH_MAX_ROTATION_DEGREES &&
+        maximum_magnitude > 0 && steps >= 1 &&
+        steps <= SANDCODEX_TOUCHPAD_PINCH_MAX_STEPS &&
+        (int64_t)steps <= maximum_magnitude &&
+        duration_msec >= steps + 1 &&
+        duration_msec <= SANDCODEX_TOUCHPAD_PINCH_MAX_DURATION_MSEC;
+}
