sc_discover_browser_host_display() {
  [[ ( "$SC_BROWSER" == 1 || "$SC_DESKTOP" == 1 ) && \
    ( "$SC_COMMAND" != doctor || "$SC_HEADFUL" == 1 ) ]] || return 0
  local display="${DISPLAY:-}" xauthority="${XAUTHORITY:-}" candidate session active remote
  local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" wayland="${WAYLAND_DISPLAY:-}"
  if (( SC_DESKTOP )) && [[ "$wayland" =~ ^wayland-[0-9]+$ ]]; then
    candidate="$(realpath -- "$runtime" 2>/dev/null || true)"
    if [[ -n "$candidate" && "$candidate" == "$runtime" && -d "$candidate" && ! -L "$runtime" && \
      "$(stat -c %u:%a -- "$candidate" 2>/dev/null || true)" == "$(id -u):700" && \
      -S "$candidate/$wayland" && ! -L "$candidate/$wayland" && \
      "$(stat -c %u:%h -- "$candidate/$wayland" 2>/dev/null || true)" == "$(id -u):1" ]]; then
      SC_DESKTOP_HOST_RUNTIME_DIR="$candidate"
      SC_DESKTOP_HOST_WAYLAND_DISPLAY="$wayland"
      sc_debug "private desktop viewer can use the operator Wayland display $wayland"
    fi
  fi
  if [[ ! "$display" =~ ^:[0-9]+(\.[0-9]+)?$ ]] && command -v loginctl >/dev/null 2>&1; then
    display=""
    while IFS= read -r session; do
      [[ "$session" =~ ^[0-9]+$ ]] || continue
      active="$(loginctl show-session "$session" -p Active --value 2>/dev/null || true)"
      remote="$(loginctl show-session "$session" -p Remote --value 2>/dev/null || true)"
      candidate="$(loginctl show-session "$session" -p Display --value 2>/dev/null || true)"
      if [[ "$active" == yes && "$remote" == no && "$candidate" =~ ^:[0-9]+(\.[0-9]+)?$ ]]; then
        display="$candidate"; break
      fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null | awk -v uid="$(id -u)" '$2 == uid {print $1}')
  fi
  [[ "$display" =~ ^:([0-9]+)(\.[0-9]+)?$ ]] || return 0
  [[ -S "/tmp/.X11-unix/X${BASH_REMATCH[1]}" ]] || return 0
  [[ -n "$xauthority" ]] || xauthority="$SC_REAL_HOME/.Xauthority"
  candidate="$(realpath -- "$xauthority" 2>/dev/null || true)"
  [[ -n "$candidate" && -f "$candidate" && ! -L "$xauthority" && \
    "$(stat -c %u -- "$candidate" 2>/dev/null || true)" == "$(id -u)" && \
    "$(stat -c %h -- "$candidate" 2>/dev/null || true)" == 1 ]] || return 0
  SC_BROWSER_HOST_DISPLAY="$display"
  SC_BROWSER_HOST_XAUTHORITY="$candidate"
  sc_debug "private browser/desktop viewers can use the operator display on $display"
}

sc_browser_profile_process_alive() {
  local profile="$1" identity process visible command
  [[ -d "$profile" && ! -L "$profile" ]] || return 1
  identity="$(stat -c '%d:%i' -- "$profile" 2>/dev/null || true)"
  [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] || return 1
  for process in /proc/[0-9]*; do
    [[ "$(stat -c %u -- "$process" 2>/dev/null || true)" == "$(id -u)" ]] || continue
    visible="$process/root$SC_BROWSER_PROFILE_MOUNT"
    [[ -d "$visible" && "$(stat -c '%d:%i' -- "$visible" 2>/dev/null || true)" == "$identity" ]] || continue
    command="$(tr '\0' ' ' <"$process/cmdline" 2>/dev/null || true)"
    [[ "$command" == *chromium* || "$command" == *chrome* ]] && return 0
  done
  return 1
}

sc_prepare_browser_profile() {
  (( SC_BROWSER )) || return 0
  local key marker tmp singleton socket_target="" product native_parent native_link
  key="$(printf '%s\0' "$SC_PROJECT" | sha256sum | awk '{print substr($1,1,32)}')"
  SC_BROWSER_PROFILE="$SC_GLOBAL/browser/profiles/$key"
  marker="$SC_GLOBAL/browser/profiles/$key.owner"
  if [[ -e "$marker" || -L "$marker" ]]; then
    [[ -f "$marker" && ! -L "$marker" && "$(stat -c %u -- "$marker")" == "$(id -u)" && \
      "$(stat -c %a -- "$marker")" == 600 && "$(stat -c %h -- "$marker")" == 1 ]] || \
      sc_die "browser profile marker is invalid: $marker"
    grep -Fx "project=$SC_PROJECT" "$marker" >/dev/null || sc_die "browser profile marker belongs to another project"
    grep -Fx "uid=$(id -u)" "$marker" >/dev/null || sc_die "browser profile marker belongs to another user"
  else
    tmp="$(mktemp "$SC_GLOBAL/browser/profiles/.profile.XXXXXX")"
    printf 'project=%s\nuid=%s\n' "$SC_PROJECT" "$(id -u)" >"$tmp"
    chmod 600 "$tmp"; mv -fT -- "$tmp" "$marker"
  fi
  sc_ensure_dir "$SC_BROWSER_PROFILE" "persistent browser profile"
  singleton="$SC_BROWSER_PROFILE/SingletonSocket"
  if [[ -L "$singleton" ]]; then socket_target="$(readlink -- "$singleton" 2>/dev/null || true)"; fi
  if [[ -S "$singleton" || ( "$socket_target" == /* && -S "$socket_target" ) ]] ||
    sc_browser_profile_process_alive "$SC_BROWSER_PROFILE"; then
    sc_die "the persistent browser profile is already in use"
  fi
  rm -f -- "$SC_BROWSER_PROFILE/SingletonLock" "$SC_BROWSER_PROFILE/SingletonSocket" \
    "$SC_BROWSER_PROFILE/SingletonCookie"

  sc_ensure_dir "$SC_BROWSER_HOME/.config" "browser configuration"
  sc_ensure_dir "$SC_BROWSER_HOME/.config/google-chrome-for-testing" "browser product configuration"
  local native_target="$SC_BROWSER_HOME/.config/google-chrome-for-testing/NativeMessagingHosts"
  sc_ensure_dir "$native_target" "browser native messaging hosts"
  for product in google-chrome chromium; do
    native_parent="$SC_BROWSER_HOME/.config/$product"
    sc_ensure_dir "$native_parent" "browser product configuration"
    native_link="$native_parent/NativeMessagingHosts"
    if [[ ! -e "$native_link" && ! -L "$native_link" ]]; then
      ln -s ../google-chrome-for-testing/NativeMessagingHosts "$native_link"
    elif [[ -L "$native_link" ]]; then
      [[ "$(realpath -- "$native_link" 2>/dev/null || true)" == "$native_target" ]] || \
        sc_die "browser native-host alias escaped its isolated home: $native_link"
    else
      sc_die "browser native-host alias has an invalid type: $native_link"
    fi
  done
  local profile_native="$SC_BROWSER_PROFILE/NativeMessagingHosts"
  if [[ -L "$profile_native" ]]; then
    rm -f -- "$profile_native"
  elif [[ -e "$profile_native" && ! -d "$profile_native" ]]; then
    sc_die "persistent browser native-host path has an invalid type"
  fi
  sc_ensure_dir "$profile_native" "profile native messaging mountpoint"
}

