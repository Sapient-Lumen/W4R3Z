                break
            if process.poll() is not None:
                break
            time.sleep(0.002)
        if identity is None:
            diagnostic = self._diagnostic()
            with contextlib.suppress(Exception):
                process.kill()
            with contextlib.suppress(Exception):
                process.wait(timeout=1)
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland keyboard transaction exited before custody was established{suffix}")
        self.start_ticks = int(identity["start_ticks"])
        try:
            ready = self._read_line(KEYBOARD_AGENT_READY_TIMEOUT_SECONDS)
            expected = f"READY {KEYBOARD_AGENT_PROTOCOL} {process.pid}"
            if ready != expected or not self._exact_alive():
                raise ToolError("private Wayland keyboard transaction readiness identity is invalid")
        except Exception:
            self._terminate()
            raise
        try:
            self.seat_start_receipt = self.controller._seat_transaction_started(
                "keyboard", self.purpose
            )
        except Exception:
            self._terminate()
            raise
        self.ready = True
        self.controller._active_keyboard_transaction = self

    def _exchange(
        self,
        command: str,
        *,
        expected: str = "OK",
        expected_held: int = 0,
        expected_modifiers: int = 0,
    ) -> tuple[int, int, int, int, int]:
        try:
            return self._exchange_checked(
                command,
                expected=expected,
                expected_held=expected_held,
                expected_modifiers=expected_modifiers,
            )
        except Exception:
            # Once any command/reply exchange becomes ambiguous, never issue a
            # follow-up command to the same helper.  A later QUIT could otherwise
            # turn a transport failure into a second, unaudited state transition.
            self.terminal_error = True
            raise

    def _exchange_checked(
        self,
        command: str,
        *,
        expected: str = "OK",
        expected_held: int = 0,
        expected_modifiers: int = 0,
    ) -> tuple[int, int, int, int, int]:
        if self.closed or not self.ready or not self._exact_alive():
            raise ToolError("private Wayland keyboard transaction lost its birth-pinned helper")
        sequence = self.sequence
        is_prepare = command.startswith("PREPU ") or command.startswith("PREPK ")
        is_key_plan = command.startswith("PLANU ") or command.startswith("PLANK ")
        is_modifier_plan = command.startswith("PLANM ")
        is_plan = is_key_plan or is_modifier_plan
        is_dispatch = (
            command.startswith("TYPE ")
            or command.startswith("CHORDU ")
            or command.startswith("CHORDK ")
        )
        previous_entries = self.keymap_entries if self.state_receipts else 1
        previous_generation = self.keymap_generation if self.state_receipts else 1
        previous_locked = self.preparation_locked if self.state_receipts else False
        self._write_line(f"{sequence} {command}\n")
        reply = self._read_line(KEYBOARD_AGENT_COMMAND_TIMEOUT_SECONDS)
        match = re.fullmatch(
            r"(OK|BYE) ([1-9][0-9]*) PLAN ([01]) KEY ([0-9]{1,3}) "
            r"SMODS ([0-9]{1,10}) HELD ([01]) MODS ([0-9]{1,3}) "
            r"MAP ([1-9][0-9]{0,2}) GEN ([1-9][0-9]{0,2}) LOCKED ([01])",
            reply,
        )
        error_match = re.fullmatch(
            r"ERR ([1-9][0-9]*) ([a-z][a-z0-9-]{0,63}) PLAN ([01]) "
            r"KEY ([0-9]{1,3}) SMODS ([0-9]{1,10}) HELD ([01]) "
            r"MODS ([0-9]{1,3}) MAP ([1-9][0-9]{0,2}) "
            r"GEN ([1-9][0-9]{0,2}) LOCKED ([01])",
            reply,
        )

        def accept_state(
            held: int,
            modifiers: int,
            keymap_entries: int,
            generation: int,
            locked: int,
            *,
            successful: bool,
        ) -> None:
            if (
                keymap_entries > KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES
                or generation > KEYBOARD_AGENT_MAX_KEYMAP_GENERATIONS
                or modifiers & ~KEYBOARD_AGENT_ALLOWED_MODIFIERS
            ):
                raise ToolError(
                    "private Wayland keyboard transaction reported invalid state "
                    f"(modifiers={modifiers}, keymap-entries={keymap_entries}, "
                    f"generation={generation}, locked={locked})"
                )
            reported_locked = locked == 1
            # HELD/MODS are independently useful release evidence even when the
            # helper's keymap authority receipt is inconsistent.  Preserve them
            # before terminating the protocol, so a released key does not cause a
            # false permanent quarantine.
            self.held_key = held
            self.modifier_mask = modifiers
            self.release_confirmed = held == 0 and modifiers == 0

            expected_entries = previous_entries
            expected_generation = previous_generation
            expected_locked = previous_locked
            if successful and is_prepare:
                if previous_locked or previous_generation != 1:
                    raise ToolError(
                        "private Wayland keyboard preparation crossed its one-way seal boundary"
                    )
                expected_entries += 1
            elif successful and command == "SEAL":
                if previous_locked:
                    raise ToolError("private Wayland keyboard preparation was sealed more than once")
                expected_generation += 1 if self._pending_keymap_upload else 0
                expected_locked = True

            if (is_dispatch or is_plan) and (
                not previous_locked
                or self.sealed_keymap_generation is None
                or self.sealed_keymap_entries is None
            ):
                action = "plan" if is_plan else "dispatch"
                raise ToolError(
                    f"private Wayland keyboard {action} occurred without a sealed operation map"
                )

            if (
                keymap_entries != expected_entries
                or generation != expected_generation
                or reported_locked != expected_locked
            ):
                self.keymap_entries = keymap_entries
                self.keymap_generation = generation
                self.preparation_locked = reported_locked
                self.keymap_sealed = reported_locked
                self.state_transition_failures += 1
                if previous_locked or self.preparation_completed:
                    self.runtime_keymap_mutations += 1
                raise ToolError(
                    "private Wayland keyboard violated its exact keymap authority transition "
                    f"for {command.split(maxsplit=1)[0]} "
                    f"(expected-map={expected_entries}, reported-map={keymap_entries}, "
                    f"expected-generation={expected_generation}, reported-generation={generation}, "
                    f"expected-locked={int(expected_locked)}, reported-locked={locked})"
                )

            self.keymap_entries = keymap_entries
            self.keymap_generation = generation
            self.preparation_locked = reported_locked
            self.keymap_sealed = reported_locked
            self.state_receipts += 1
            if successful and is_prepare:
                self._pending_keymap_upload = True
            elif successful and command == "SEAL":
                self._pending_keymap_upload = False
                self.sealed_keymap_generation = generation
                self.sealed_keymap_entries = keymap_entries

        if error_match is not None:
            reply_sequence = int(error_match.group(1))
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            if reply_sequence != sequence:
                raise ToolError(
                    f"private Wayland keyboard transaction returned an error for unexpected sequence "
                    f"{reply_sequence} while awaiting {sequence}{suffix}"
                )
            if any(int(error_match.group(index)) != 0 for index in (3, 4, 5)):
                raise ToolError("private Wayland keyboard error reply disclosed an invalid native plan")
            accept_state(
                int(error_match.group(6)),
                int(error_match.group(7)),
                int(error_match.group(8)),
                int(error_match.group(9)),
                int(error_match.group(10)),
                successful=False,
            )
            self.release_recovery_confirmed = (
                self.release_confirmed
                and error_match.group(2) == "wayland-dispatch-failed-release-confirmed"
            )
            self.terminal_error = True
            raise ToolError(
                f"private Wayland keyboard transaction rejected sequence {sequence}: "
                f"{error_match.group(2)} (helper-held={self.held_key}, "
                f"helper-modifiers={self.modifier_mask}, keymap-entries={self.keymap_entries}, "
                f"keymap-generation={self.keymap_generation}, "
                f"preparation-locked={self.preparation_locked}){suffix}"
            )
        if match is None or match.group(1) != expected or int(match.group(2)) != sequence:
            diagnostic = self._diagnostic()
            suffix = f": {diagnostic}" if diagnostic else ""
            raise ToolError(f"private Wayland keyboard transaction rejected sequence {sequence}: {reply}{suffix}")
        plan_valid = int(match.group(3))
        planned_key = int(match.group(4))
        planned_modifiers = int(match.group(5))
        held = int(match.group(6))
        modifiers = int(match.group(7))
        keymap_entries = int(match.group(8))
        generation = int(match.group(9))
        locked = int(match.group(10))
        if plan_valid:
            key_plan_valid = (
                is_key_plan
                and 1 <= planned_key <= KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES
                and 0 <= planned_modifiers <= 0xFFFFFFFF
            )
            modifier_plan_valid = (
                is_modifier_plan
                and planned_key == 0
                and 1 <= planned_modifiers <= 0xFFFFFFFF
            )
            if not (key_plan_valid or modifier_plan_valid):
                raise ToolError("private Wayland keyboard returned an invalid native plan")
        elif planned_key != 0 or planned_modifiers != 0 or is_plan:
            raise ToolError("private Wayland keyboard omitted or leaked a native plan")
        accept_state(
            held,
            modifiers,
            keymap_entries,
            generation,
            locked,
            successful=True,
        )
        if held != expected_held or modifiers != expected_modifiers:
            raise ToolError(
                "private Wayland keyboard transaction did not acknowledge the exact requested state "
                f"(expected-held={expected_held}, held={held}, "
                f"expected-modifiers={expected_modifiers}, modifiers={modifiers}, "
                f"keymap-entries={keymap_entries}, "
                f"generation={generation}, locked={locked})"
            )
        self.release_confirmed = held == 0 and modifiers == 0
        self.release_recovery_confirmed = False
        self.sequence += 1
        self.commands_completed += 1
        if expected != "BYE" and not self._exact_alive():
            raise ToolError("private Wayland keyboard transaction helper changed identity after dispatch")
        if is_key_plan:
            self.native_plans_completed += 1
        elif is_modifier_plan:
            self.modifier_arc_plans_completed += 1
        return held, modifiers, keymap_entries, planned_key, planned_modifiers

    def _quarantine_release(self, reason: str) -> None:
        self.controller._quarantine_keyboard(
            reason,
            release_failure=not self.release_failure_recorded,
        )
        self.release_failure_recorded = True

    def _run_atomic(self, command: str, *, modifiers: int = 0) -> None:
        # The compositor may consume the press before the reply transport fails.
        # Mark the state ambiguous before dispatch and clear it only on a strict
        # HELD=0 MODS=0 acknowledgement from the same helper identity.
        self.held_key = 1
        self.modifier_mask = modifiers
        self.release_confirmed = False
        self.input_dispatch_attempts += 1
        try:
            self._exchange(command)
            self.input_dispatches_confirmed += 1
        except Exception as error:
            if not self.release_confirmed:
                self._quarantine_release(
                    "keyboard key-up or modifier-clear could not be confirmed on its birth-pinned virtual keyboard"
                )
                raise ToolError(
                    "keyboard release could not be confirmed on its birth-pinned virtual keyboard"
                ) from error
            raise

    @classmethod
    def normalize_modifiers(cls, value: Any) -> tuple[tuple[str, ...], int]:
        if value is None:
            return (), 0
        if not isinstance(value, list) or len(value) > len(cls._modifier_canonical):
            raise ToolError(
                f"modifiers must be an array containing at most {len(cls._modifier_canonical)} names"
            )
        mask = 0
        for index, raw in enumerate(value):
            if not isinstance(raw, str) or not raw.strip() or len(raw) > 32:
                raise ToolError(f"modifiers[{index}] must be a short modifier name")
            token = raw.strip().replace("-", "").replace("_", "").upper()
            bit = cls._modifier_masks.get(token)
            if bit is None:
                raise ToolError(
                    f"modifiers[{index}] must be Shift, Ctrl, Alt, Super, or AltGr"
                )
            if mask & bit:
                raise ToolError(f"modifiers[{index}] duplicates an already requested modifier")
            mask |= bit
        ordered = tuple(
            name for bit, name in cls._modifier_canonical.items() if mask & bit
        )
        return ordered, mask


    def prepare_modifier_arc(self, modifiers: Any) -> tuple[tuple[str, ...], int]:
        """Serialize one nonzero mask without asking the helper to emit input."""
        canonical, abstract_mask = self.normalize_modifiers(modifiers)
        if abstract_mask == 0:
            raise ToolError("modifier arc requires at least one modifier")
        if not self.preparation_completed or not self.keymap_sealed:
            raise ToolError("modifier arc requires a presealed operation keymap")
        if self.closed or self.terminal_error or not self.release_confirmed:
            raise ToolError("modifier arc lost its sealed released helper state")
        if self.held_key != 0 or self.modifier_mask != 0:
            raise ToolError("modifier arc requires physically released helper state")
        if self._pending_native_plan is not None or self._native_dispatch_inflight is not None:
            raise ToolError("modifier arc cannot overlap a keyboard-unit plan")
        if (
            self._modifier_arc_pending_mask is not None
            or self._modifier_arc_active_mask is not None
            or self._modifier_arc_release_inflight is not None
        ):
            raise ToolError("one modifier arc is already pending or active")
        _held, _mods, _entries, planned_key, serialized_mask = self._exchange(
            f"PLANM {abstract_mask}"
        )
        if planned_key != 0 or serialized_mask == 0:
            self.terminal_error = True
            raise ToolError("modifier planner did not return one serialized modifier-only plan")
        self._modifier_arc_pending_mask = serialized_mask
        self.last_modifier_arc_serialized_mask = serialized_mask
        self.modifier_arc_hold_attempts += 1
        return canonical, serialized_mask

    def cancel_modifier_arc_preparation(self, modifiers: int) -> None:
        if self._modifier_arc_pending_mask != modifiers:
            raise ToolError("modifier-arc cancellation does not match its pending mask")
        self._modifier_arc_pending_mask = None
        self.modifier_arc_cancellations += 1

    def fail_modifier_arc_hold(self, modifiers: int) -> None:
        if self._modifier_arc_pending_mask != modifiers:
            raise ToolError("modifier-arc hold failure has no exact pending mask")
        self._modifier_arc_pending_mask = None
        self.modifier_arc_failures += 1
        self.modifier_arc_revocation_forced = True
        self.terminal_error = True

    def abort_modifier_arc_hold_completion(
        self,
        modifiers: int,
        *,
        clear_attempted: bool,
        clear_confirmed: bool,
    ) -> None:
        """Converge a post-dispatch hold failure to a released terminal state.

        Once Sway has returned a private arc token, cancellation is no longer a
        valid interpretation: modifiers may already be down.  The controller
        therefore attempts the target-independent compositor clear first, then
        calls this method even when receipt confirmation itself failed.  State
        is consumed monotonically; a failed clear means the authenticated Sway
        connection was revoked and its disconnect handler owns de-escalation.
        """
        if type(clear_attempted) is not bool or type(clear_confirmed) is not bool:
            raise ToolError("modifier-arc emergency-clear state must be boolean")
        if clear_confirmed and not clear_attempted:
            raise ToolError("modifier-arc clear cannot be confirmed without an attempt")
        for value, label in (
            (self._modifier_arc_pending_mask, "pending"),
            (self._modifier_arc_active_mask, "active"),
            (self._modifier_arc_release_inflight, "release"),
        ):
            if value not in (None, modifiers):
                raise ToolError(
                    f"modifier-arc hold abort found a different {label} mask"
                )
        failure_already_recorded = (
            self.terminal_error
            and self._modifier_arc_pending_mask is None
            and self._modifier_arc_active_mask is None
            and self._modifier_arc_release_inflight is None
        )
        self._modifier_arc_pending_mask = None
        self._modifier_arc_active_mask = None
        self._modifier_arc_release_inflight = None
        if not failure_already_recorded:
            self.modifier_arc_failures += 1
        self.modifier_arc_hold_completion_aborts += 1
        if clear_attempted:
            self.modifier_arc_emergency_clear_attempts += 1
        if clear_confirmed:
            self.modifier_arc_emergency_clears_confirmed += 1
        else:
            self.modifier_arc_revocation_forced = True
        self.terminal_error = True

    def confirm_modifier_arc_hold(self, receipt: dict[str, Any]) -> None:
        modifiers = self._modifier_arc_pending_mask
        if modifiers is None:
            raise ToolError("compositor modifier-arc hold has no pending mask")
        if (
            not isinstance(receipt, dict)
            or receipt.get("schema") != MODIFIER_ARC_SEAL_SCHEMA
            or receipt.get("operation") != "compositor-modifier-arc-hold"
            or receipt.get("modifiers") != modifiers
            or type(receipt.get("modifiers")) is not int
            or receipt.get("released") is not False
            or receipt.get("underlying_keyboard_released") is not True
            or receipt.get("target_independent_clear") is not True
            or receipt.get("connection_owned") is not True
            or receipt.get("helper_key_or_modifier_requests") != 0
        ):
            self._modifier_arc_pending_mask = None
            self.modifier_arc_failures += 1
            self.terminal_error = True
            raise ToolError("compositor modifier-arc hold receipt is invalid")
        digest = receipt.get("receipt_sha256")
        if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
            self._modifier_arc_pending_mask = None
            self.modifier_arc_failures += 1
            self.terminal_error = True
            raise ToolError("compositor modifier-arc hold receipt digest is malformed")
        self._modifier_arc_pending_mask = None
        self._modifier_arc_active_mask = modifiers
        self.modifier_arc_holds_confirmed += 1
        self.last_modifier_arc_hold_receipt_sha256 = digest

    def begin_modifier_arc_release(self, modifiers: int) -> None:
        if self._modifier_arc_active_mask != modifiers:
            raise ToolError("modifier-arc release does not match its active mask")
        if self._modifier_arc_release_inflight is not None:
            raise ToolError("modifier-arc release is already in flight")
        self._modifier_arc_release_inflight = modifiers
        self.modifier_arc_release_attempts += 1

    def fail_modifier_arc_release(self, modifiers: int) -> None:
        if (
            self._modifier_arc_active_mask != modifiers
            or self._modifier_arc_release_inflight != modifiers
        ):
            raise ToolError("modifier-arc release failure has no exact in-flight mask")
        # CompositorEventSeal revokes the authenticated IPC connection before
        # returning this failure. Sway owns the emergency de-escalation; the
        # helper remained physically released throughout.
        self._modifier_arc_release_inflight = None
        self._modifier_arc_active_mask = None
        self.modifier_arc_failures += 1
        self.modifier_arc_revocation_forced = True
        self.terminal_error = True

    def abort_modifier_arc_release_confirmation(self, modifiers: int) -> None:
        """Consume local arc state after Sway already confirmed the clear.

        CompositorEventSeal validates the release response before returning it.
        If the transaction-level evidence check still fails, the modifier is
        nevertheless already clear.  Retaining an active local mask would turn
        a receipt fault into a false stranded-input report, so consume it and
        terminate the transaction without replaying the clear token.
        """
        for value, label in (
            (self._modifier_arc_active_mask, "active"),
            (self._modifier_arc_release_inflight, "release"),
        ):
            if value not in (None, modifiers):
                raise ToolError(
                    f"modifier-arc release abort found a different {label} mask"
                )
        failure_already_recorded = (
            self.terminal_error
            and self._modifier_arc_active_mask is None
            and self._modifier_arc_release_inflight is None
        )
        self._modifier_arc_active_mask = None
        self._modifier_arc_release_inflight = None
        if not failure_already_recorded:
            self.modifier_arc_failures += 1
        self.modifier_arc_release_confirmation_aborts += 1
        self.terminal_error = True

    def confirm_modifier_arc_release(self, receipt: dict[str, Any]) -> None:
        modifiers = self._modifier_arc_release_inflight
        if modifiers is None or self._modifier_arc_active_mask != modifiers:
            raise ToolError("compositor modifier-arc release has no exact active mask")
        if (
            not isinstance(receipt, dict)
            or receipt.get("schema") != MODIFIER_ARC_SEAL_SCHEMA
            or receipt.get("operation") != "compositor-modifier-arc-release"
            or receipt.get("modifiers") != modifiers
            or type(receipt.get("modifiers")) is not int
            or receipt.get("released") is not True
            or receipt.get("underlying_keyboard_released") is not True
            or receipt.get("target_recheck_required") is not False
            or receipt.get("target_independent_deescalation") is not True
            or receipt.get("arc_consumed") is not True
            or receipt.get("helper_key_or_modifier_requests") != 0
        ):
            self.modifier_arc_failures += 1
            self.terminal_error = True
            raise ToolError("compositor modifier-arc release receipt is invalid")
        digest = receipt.get("receipt_sha256")
        if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
            self.modifier_arc_failures += 1
            self.terminal_error = True
            raise ToolError("compositor modifier-arc release receipt digest is malformed")
        self._modifier_arc_release_inflight = None
        self._modifier_arc_active_mask = None
        self.modifier_arc_releases_confirmed += 1
        self.last_modifier_arc_release_receipt_sha256 = digest

    @staticmethod
    def _character_identity(character: str) -> tuple[str, int | str]:
        if not isinstance(character, str) or len(character) != 1:
            raise ToolError("one virtual-keyboard character unit must contain exactly one Unicode scalar")
        codepoint = ord(character)
        if codepoint == 0 or 0xD800 <= codepoint <= 0xDFFF:
            raise ToolError("NUL and surrogate code points are not valid virtual-keyboard input")
        controls = {
            0x08: "BackSpace",
            0x09: "Tab",
            0x0A: "Return",
            0x0D: "Return",
            0x1B: "Escape",
            0x7F: "Delete",
        }
        if codepoint in controls:
            return ("named", controls[codepoint])
        return ("unicode", codepoint)

    @classmethod
    def required_character_keysyms(cls, text: str) -> int:
        if not isinstance(text, str):
            raise ToolError("text must be a string")
        identities = {cls._character_identity(character) for character in text}
        # The helper's initial sealed map already contains U+0020.
        identities.discard(("unicode", 0x20))
        return 1 + len(identities)

    @classmethod
    def can_prepare_characters(cls, text: str) -> bool:
        return cls.required_character_keysyms(text) <= KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES

    def _prepare_identity(self, identity: tuple[str, int | str]) -> None:
        kind, value = identity
        if kind == "unicode":
            self._exchange(f"PREPU {int(value):X}")
        elif kind == "named":
            name = str(value)
            if re.fullmatch(r"[A-Za-z0-9_]{1,63}", name) is None:
                raise ToolError("unsafe named keysym in keyboard preparation")
            self._exchange(f"PREPK {name}")
        else:
            raise ToolError("invalid keyboard preparation identity")
        self.preparation_commands += 1
        self.keymap_sealed = False

    def _seal_preparation(self) -> None:
        self._exchange("SEAL")
        self.preparation_commands += 1
        if (
            not self.preparation_locked
            or self.sealed_keymap_generation is None
            or self.sealed_keymap_entries is None
        ):
            raise ToolError("private Wayland keyboard helper did not prove its sealed operation map")
        self.keymap_sealed = True
        self.preparation_completed = True
        self.prepared_keysyms = self.keymap_entries

    def prepare_characters(self, text: str) -> None:
        if self.preparation_completed:
            raise ToolError("private Wayland keyboard transaction preparation is already sealed")
        required = self.required_character_keysyms(text)
        if required > KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES:
            raise ToolError(
                "synthetic keyboard text requires more distinct keysyms than the sealed operation map allows"
            )
        identities: list[tuple[str, int | str]] = []
        seen: set[tuple[str, int | str]] = set()
        requested: set[tuple[str, int | str]] = set()
        for character in text:
            identity = self._character_identity(character)
            requested.add(identity)
            if identity in seen or identity == ("unicode", 0x20):
                continue
            seen.add(identity)
            identities.append(identity)
        for identity in identities:
            self._prepare_identity(identity)
        self._seal_preparation()
        self._prepared_character_ids = requested

    @staticmethod
    def _preparation_for_chord_command(command: str) -> tuple[str, tuple[str, int | str]]:
        fields = command.split()
        if len(fields) == 3 and fields[0] == "CHORDU":
            codepoint = int(fields[2], 16)
            return f"PREPU {codepoint:X}", ("unicode", codepoint)
        if len(fields) == 3 and fields[0] == "CHORDK":
            return f"PREPK {fields[2]}", ("named", fields[2])
        raise ToolError("invalid private Wayland chord command")

    def prepare_chords(self, chords: list[str]) -> None:
        if self.preparation_completed:
            raise ToolError("private Wayland keyboard transaction preparation is already sealed")
        if not isinstance(chords, list) or not chords:
            raise ToolError("keyboard preparation requires at least one chord")
        prepared: set[tuple[str, int | str]] = set()
        commands: set[str] = set()
        preparation_commands: list[str] = []
        for chord in chords:
            command, _modifiers = self._chord_command(chord)
            preparation, identity = self._preparation_for_chord_command(command)
            commands.add(command)
            if identity == ("named", "space"):
                identity = ("unicode", 0x20)
            if identity in prepared or identity == ("unicode", 0x20):
                continue
            prepared.add(identity)
            preparation_commands.append(preparation)
        if 1 + len(prepared) > KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES:
            raise ToolError("keyboard chord set exceeds the sealed operation keymap capacity")
        for preparation in preparation_commands:
            fields = preparation.split(maxsplit=1)
            if len(fields) != 2:
                raise ToolError("invalid keyboard preparation command")
            if fields[0] == "PREPU":
                self._prepare_identity(("unicode", int(fields[1], 16)))
            elif fields[0] == "PREPK":
                self._prepare_identity(("named", fields[1]))
            else:
                raise ToolError("invalid keyboard preparation command")
        self._seal_preparation()
        self._prepared_chord_commands = commands

    def prepare_chord(self, chord: str) -> None:
        self.prepare_chords([chord])

    def _require_native_plan_slot(self) -> None:
        if self._pending_native_plan is not None:
            raise ToolError(
                "private Wayland keyboard already has one undispatched sealed plan"
            )
        if self._native_dispatch_inflight is not None:
            raise ToolError(
                "private Wayland keyboard already has one unreceipted native dispatch"
            )

    def _record_native_plan(self, keycode: int, modifiers: int) -> tuple[int, int]:
        if type(keycode) is not int or not 1 <= keycode <= KEYBOARD_AGENT_MAX_KEYMAP_ENTRIES:
            raise ToolError("private Wayland keyboard planned keycode is outside its sealed map")
        if (
            type(modifiers) is not int
            or not 0 <= modifiers <= 0xFFFFFFFF
            or modifiers & ~KEYBOARD_AGENT_ALLOWED_MODIFIERS
        ):
            raise ToolError("private Wayland keyboard planned modifier mask is not allowlisted")
        plan_index = self.native_plans_completed
        if plan_index <= 0:
            raise ToolError("private Wayland keyboard plan counter did not advance")
        self._pending_native_plan = (plan_index, keycode, modifiers)
        self.native_plan_chain_sha256 = hashlib.sha256(
            self.native_plan_chain_sha256.encode("ascii")
            + canonical_json({
                "index": plan_index,
                "keycode": keycode,
                "modifiers": modifiers,
                "keymap_generation": self.keymap_generation,
                "keymap_entries": self.keymap_entries,
            })
        ).hexdigest()
        return keycode, modifiers

    def plan_character(self, character: str) -> tuple[int, int]:
        self._require_native_plan_slot()
        identity = self._character_identity(character)
        if (
            not self.preparation_completed
            or not self.keymap_sealed
            or identity not in self._prepared_character_ids
        ):
            raise ToolError("virtual-keyboard character was not present in the presealed operation keymap")
        codepoint = ord(character)
        _held, _modifiers, _entries, keycode, serialized = self._exchange(
            f"PLANU 0 {codepoint:X}"
        )
        return self._record_native_plan(keycode, serialized)

    def plan_chord(self, chord: str) -> tuple[int, int]:
        self._require_native_plan_slot()
        command, _semantic_modifiers = self._chord_command(chord)
        if (
            not self.preparation_completed
            or not self.keymap_sealed
            or command not in self._prepared_chord_commands
        ):
            raise ToolError("virtual-keyboard chord was not present in the presealed operation keymap")
        fields = command.split()
        if len(fields) != 3 or fields[0] not in {"CHORDU", "CHORDK"}:
            raise ToolError("private Wayland keyboard chord plan is malformed")
        _held, _modifiers, _entries, keycode, serialized = self._exchange(
            f"{'PLANU' if fields[0] == 'CHORDU' else 'PLANK'} {fields[1]} {fields[2]}"
        )
        return self._record_native_plan(keycode, serialized)

    def begin_native_dispatch(self, keycode: int, modifiers: int) -> None:
        if (
            self.closed
            or self.terminal_error
            or not self.preparation_completed
            or not self.keymap_sealed
            or not self.release_confirmed
        ):
            raise ToolError("virtual-keyboard native dispatch lost its sealed released state")
        if self._native_dispatch_inflight is not None:
            raise ToolError("virtual-keyboard native dispatch already awaits its exact receipt")
        plan = self._pending_native_plan
        if plan is None:
            raise ToolError("virtual-keyboard native dispatch has no one-use sealed plan")
        plan_index, planned_keycode, planned_modifiers = plan
        if (
            type(keycode) is not int
            or type(modifiers) is not int
            or keycode != planned_keycode
            or modifiers != planned_modifiers
        ):
            raise ToolError("virtual-keyboard native dispatch tuple differs from its sealed plan")
        self._pending_native_plan = None
        self._native_dispatch_inflight = (plan_index, keycode, modifiers)
        self.native_plans_consumed += 1
        self.input_dispatch_attempts += 1

    def fail_native_dispatch(self) -> None:
        if self._native_dispatch_inflight is None:
            raise ToolError("virtual-keyboard native dispatch failure has no in-flight plan")
        self._native_dispatch_inflight = None
        self.native_dispatch_failures += 1
        # The helper emitted no key/modifier request.  Prevent any further unit
        # in this transaction because the compositor outcome is unreceipted,
        # while retaining the already-proved helper-side released state.
        self.terminal_error = True

    def confirm_native_dispatch(self, receipt: dict[str, Any]) -> None:
        plan = self._native_dispatch_inflight
        if plan is None:
            raise ToolError("compositor-native keyboard receipt has no in-flight sealed plan")
        plan_index, keycode, modifiers = plan
        if (
            not isinstance(receipt, dict)
            or receipt.get("schema") != KEYBOARD_DISPATCH_SEAL_SCHEMA
            or receipt.get("operation") != "native-exact-focused-keyboard-unit"
            or receipt.get("released") is not True
            or receipt.get("helper_key_or_modifier_requests") != 0
            or type(receipt.get("keycode")) is not int
            or type(receipt.get("modifiers")) is not int
            or receipt.get("keycode") != keycode
            or receipt.get("modifiers") != modifiers
        ):
            self.terminal_error = True
            self.native_dispatch_failures += 1
            self._native_dispatch_inflight = None
            raise ToolError("compositor-native keyboard receipt does not bind its exact sealed plan")
        digest = receipt.get("receipt_sha256")
        if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
            self.terminal_error = True
            self.native_dispatch_failures += 1
            self._native_dispatch_inflight = None
            raise ToolError("compositor-native keyboard receipt digest is malformed")
        self._native_dispatch_inflight = None
        self.input_dispatches_confirmed += 1
        self.release_confirmed = True
        self.last_native_dispatch_receipt_sha256 = digest
        self.native_dispatch_receipt_chain_sha256 = hashlib.sha256(
            self.native_dispatch_receipt_chain_sha256.encode("ascii")
            + canonical_json({
                "index": self.input_dispatches_confirmed,
                "plan_index": plan_index,
                "keycode": keycode,
                "modifiers": modifiers,
                "receipt_sha256": digest,
            })
        ).hexdigest()
        if len(self.native_dispatch_receipt_samples) < COMPOSITOR_EVENT_MAX_SAMPLES:
            self.native_dispatch_receipt_samples.append({
                "index": self.input_dispatches_confirmed,
                "plan_index": plan_index,
                "keycode": keycode,
                "modifiers": modifiers,
                "receipt_sha256": digest,
            })

    def character(self, character: str) -> None:
        identity = self._character_identity(character)
        if (
            not self.preparation_completed
            or not self.keymap_sealed
            or identity not in self._prepared_character_ids
        ):
            raise ToolError("virtual-keyboard character was not present in the presealed operation keymap")
        codepoint = ord(character)
        self._require_native_plan_slot()
        self._run_atomic(f"TYPE {codepoint:X}")

    def _chord_command(self, chord: str) -> tuple[str, int]:
        value = as_string(chord, "chord", maximum=256, allow_empty=False)
        tokens = [token.strip() for token in value.split("+") if token.strip()]
        if not tokens:
            raise ToolError("chord is empty")
        modifiers = 0
        key_token: str | None = None
        for token in tokens:
            upper = token.upper()
            if upper in self._modifier_masks:
                modifiers |= self._modifier_masks[upper]
            elif key_token is None:
                key_token = token
            else:
                raise ToolError("a chord may contain only one non-modifier key")
        if key_token is None:
            raise ToolError("a chord must contain a non-modifier key")
        key_name = self.controller.named_keys.get(key_token.upper())
        if key_name is None and len(key_token) == 1:
            key_name = key_token
        if key_name is None:
            raise ToolError(f"unknown or disallowed Wayland key name: {key_token}")
        if len(key_name) == 1:
            codepoint = ord(key_name)
            if codepoint == 0 or 0xD800 <= codepoint <= 0xDFFF:
                raise ToolError("NUL and surrogate code points are not valid virtual-keyboard input")
            return f"CHORDU {modifiers} {codepoint:X}", modifiers
        if re.fullmatch(r"[A-Za-z0-9_]{1,63}", key_name) is None:
            raise ToolError(f"unknown or unsafe Wayland keysym name: {key_token}")
        return f"CHORDK {modifiers} {key_name}", modifiers

    def chord(self, chord: str) -> None:
        command, modifiers = self._chord_command(chord)
        if (
            not self.preparation_completed
            or not self.keymap_sealed
            or command not in self._prepared_chord_commands
        ):
            raise ToolError("virtual-keyboard chord was not present in the presealed operation keymap")
        self._require_native_plan_slot()
        self._run_atomic(command, modifiers=modifiers)

    def ping(self) -> None:
        self._exchange("PING", expected_held=self.held_key, expected_modifiers=self.modifier_mask)

