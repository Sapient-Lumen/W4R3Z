      response="$(sc_operator_control_request "$SC_OPERATOR_INGRESS_SOCKET" "$request")"
      jq -e '.ok == true and (.bootstrap_file | type == "string")' <<<"$response" >/dev/null ||
        sc_die "operator bootstrap request failed"
