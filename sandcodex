    -I"$launch" "${wayland_cflags[@]}" -c "$pointer_source" -o "$pointer_object"
  gcc -std=c11 -O2 -fPIE -I"$launch" "${wayland_cflags[@]}" \
    -Wno-unused-parameter -c "$pointer_code" -o "$pointer_protocol_object"
  gcc -pie -Wl,-z,relro,-z,now -Wl,--as-needed -o "$pointer_helper" \
    "$pointer_object" "$pointer_protocol_object" "${wayland_libs[@]}"
  chmod 500 -- "$pointer_helper"
