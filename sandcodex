sc_emit_wayland_clipboard_agent_source() {
  cat <<'WAYLAND_CLIPBOARD_AGENT_C'
#define _GNU_SOURCE
#define _POSIX_C_SOURCE 200809L

/*
 * RichPasteSeal/PrimaryPasteSeal request-gated selection escrow for Sandcodex.
 *
 * The controller passes one immutable, read-only, non-executable anonymous
 * memfd containing UTF-8 text, one controller-canonicalized PNG, or one
 * strict launch-private text/uri-list for native file paste.
 * This helper owns one privileged ext-data-control-v1 clipboard or PRIMARY
 * selection for one guarded paste operation.  A compositor data request is retained as a file
 * descriptor and reported to the controller; no byte is released until the
 * controller explicitly authorizes that exact request after revalidating
 * launch/scene custody, focus, and its ordered compositor event barrier.
 * The selection is cleared and round-trip confirmed before success.
 */

#include <ctype.h>
#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <inttypes.h>
#include <limits.h>
#include <poll.h>
#include <signal.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <sys/prctl.h>
#include <sys/resource.h>
#include <sys/stat.h>
#include <time.h>
#include <unistd.h>

#include <wayland-client.h>
#include "ext-data-control-v1-client-protocol.h"

#define AGENT_PROTOCOL "sandcodex.clipboard-agent.v4"
#define MAX_LINE_BYTES 256U
#define MAX_TOKENS 5U
#define MAX_TEXT_PAYLOAD_BYTES (1024U * 1024U)
#define MAX_PNG_PAYLOAD_BYTES (16U * 1024U * 1024U)
#define MAX_PNG_DIMENSION 8192U
#define MAX_PNG_PIXELS (16U * 1024U * 1024U)
#define MAX_PNG_CHUNKS 4096U
#define MAX_URI_LIST_PAYLOAD_BYTES (64U * 1024U)
#define MAX_URI_LIST_ENTRIES 8U
#define MAX_PAYLOAD_BYTES MAX_PNG_PAYLOAD_BYTES
#define MAX_REQUESTS 16U
#define MAX_MIME_BYTES 63U
#define MAX_NEXT_TIMEOUT_MILLISECONDS 10000U
#define MAX_QUIET_MILLISECONDS 1000U
#define TRANSFER_TIMEOUT_MILLISECONDS 3000U
#define TRANSFER_CHUNK_BYTES 16384U

#ifndef F_SEAL_EXEC
#define F_SEAL_EXEC 0x0020
#endif

static const char MIME_UTF8[] = "text/plain;charset=utf-8";
static const char MIME_TEXT[] = "text/plain";
static const char MIME_UTF8_STRING[] = "UTF8_STRING";
static const char MIME_STRING[] = "STRING";
static const char MIME_PNG[] = "image/png";
static const char MIME_URI_LIST[] = "text/uri-list";

enum payload_profile {
    PROFILE_TEXT,
    PROFILE_PNG,
    PROFILE_FILES,
};

enum selection_target {
    SELECTION_CLIPBOARD,
    SELECTION_PRIMARY,
};

enum command_kind {
    COMMAND_NEXT,
    COMMAND_AUTHORIZE,
    COMMAND_CLEAR,
    COMMAND_PING,
    COMMAND_QUIT,
};

struct command {
    uint64_t sequence;
    enum command_kind kind;
    uint32_t timeout_milliseconds;
    uint32_t quiet_milliseconds;
    uint32_t request_id;
};

struct pending_request {
    uint32_t id;
    int descriptor;
    char mime[MAX_MIME_BYTES + 1U];
    bool announced;
};

struct clipboard_state {
    struct wl_display *display;
    struct wl_registry *registry;
    struct wl_seat *seat;
    struct ext_data_control_manager_v1 *manager;
    struct ext_data_control_device_v1 *device;
    struct ext_data_control_source_v1 *source;
    uint32_t manager_count;
    uint32_t seat_count;
    uint32_t manager_version;
    uint32_t manager_name;
    uint32_t seat_name;
    int payload_descriptor;
    size_t payload_size;
    enum payload_profile profile;
    enum selection_target selection;
    bool payload_ascii;
    bool payload_exec_sealed;
    struct pending_request pending[MAX_REQUESTS];
    uint32_t next_request_id;
    uint32_t requests_seen;
    uint32_t transfers_completed;
    uint64_t bytes_transferred;
    uint64_t last_activity_milliseconds;
    uint32_t offers_seen;
    bool topology_valid;
    bool selection_active;
    bool request_gate_open;
    bool clear_in_progress;
    bool clear_confirmed;
    bool unexpected_cancel;
    bool device_finished;
    bool terminal_error;
};

static volatile sig_atomic_t stop_requested = 0;

static void on_signal(int signo) {
    (void)signo;
    stop_requested = 1;
}

static uint64_t monotonic_milliseconds(void) {
    struct timespec value = {0};
    if (clock_gettime(CLOCK_MONOTONIC, &value) < 0) {
        return 0U;
    }
    return (uint64_t)value.tv_sec * UINT64_C(1000) +
        (uint64_t)value.tv_nsec / UINT64_C(1000000);
}

static bool parse_u64(const char *text, uint64_t minimum, uint64_t maximum,
        uint64_t *output) {
    if (text == NULL || *text == '\0' || *text == '-' || *text == '+') {
        return false;
    }
    errno = 0;
    char *end = NULL;
    const uintmax_t value = strtoumax(text, &end, 10);
    if (errno != 0 || end == text || *end != '\0' ||
            value < minimum || value > maximum) {
        return false;
    }
    *output = (uint64_t)value;
    return true;
}

static size_t tokenize(char *line, char **tokens) {
    size_t count = 0U;
    char *save = NULL;
    for (char *token = strtok_r(line, " \t\r\n", &save);
         token != NULL;
         token = strtok_r(NULL, " \t\r\n", &save)) {
        if (count == MAX_TOKENS) {
            return MAX_TOKENS + 1U;
        }
        tokens[count++] = token;
    }
    return count;
}

static bool parse_command(char *line, uint64_t expected_sequence,
        struct command *command) {
    char *tokens[MAX_TOKENS] = {0};
    const size_t count = tokenize(line, tokens);
    uint64_t sequence = 0U;
    if (count < 2U || count > MAX_TOKENS ||
            !parse_u64(tokens[0], 1U, UINT64_MAX, &sequence) ||
            sequence != expected_sequence) {
        return false;
    }
    command->sequence = sequence;
    if (strcmp(tokens[1], "NEXT") == 0) {
        uint64_t timeout = 0U;
        uint64_t quiet = 0U;
        if (count != 4U ||
                !parse_u64(tokens[2], 1U, MAX_NEXT_TIMEOUT_MILLISECONDS, &timeout) ||
                !parse_u64(tokens[3], 1U, MAX_QUIET_MILLISECONDS, &quiet)) {
            return false;
        }
        command->kind = COMMAND_NEXT;
        command->timeout_milliseconds = (uint32_t)timeout;
        command->quiet_milliseconds = (uint32_t)quiet;
        return true;
    }
    if (strcmp(tokens[1], "AUTHORIZE") == 0) {
        uint64_t request_id = 0U;
        if (count != 3U || !parse_u64(tokens[2], 1U, UINT32_MAX, &request_id)) {
            return false;
        }
        command->kind = COMMAND_AUTHORIZE;
        command->request_id = (uint32_t)request_id;
        return true;
    }
    if (strcmp(tokens[1], "CLEAR") == 0 && count == 2U) {
        command->kind = COMMAND_CLEAR;
        return true;
    }
    if (strcmp(tokens[1], "PING") == 0 && count == 2U) {
        command->kind = COMMAND_PING;
        return true;
    }
    if (strcmp(tokens[1], "QUIT") == 0 && count == 2U) {
        command->kind = COMMAND_QUIT;
        return true;
    }
    return false;
}

static const char *profile_name(enum payload_profile profile) {
    switch (profile) {
        case PROFILE_TEXT: return "text";
        case PROFILE_PNG: return "png";
        case PROFILE_FILES: return "files";
    }
    return "invalid";
}

static bool parse_profile(const char *text, enum payload_profile *profile) {
    if (text != NULL && strcmp(text, "text") == 0) {
        *profile = PROFILE_TEXT;
        return true;
    }
    if (text != NULL && strcmp(text, "png") == 0) {
        *profile = PROFILE_PNG;
        return true;
    }
    if (text != NULL && strcmp(text, "files") == 0) {
        *profile = PROFILE_FILES;
        return true;
    }
    return false;
}

static const char *selection_name(enum selection_target selection) {
    switch (selection) {
        case SELECTION_CLIPBOARD: return "clipboard";
        case SELECTION_PRIMARY: return "primary";
    }
    return "invalid";
}

static bool parse_selection(const char *text, enum selection_target *selection) {
    if (text != NULL && strcmp(text, "clipboard") == 0) {
        *selection = SELECTION_CLIPBOARD;
        return true;
    }
    if (text != NULL && strcmp(text, "primary") == 0) {
        *selection = SELECTION_PRIMARY;
        return true;
    }
    return false;
}

static bool allowed_mime(const struct clipboard_state *state, const char *mime) {
    if (mime == NULL) {
        return false;
    }
    if (state->profile == PROFILE_PNG) {
        return strcmp(mime, MIME_PNG) == 0;
    }
    if (state->profile == PROFILE_FILES) {
        return strcmp(mime, MIME_URI_LIST) == 0;
    }
    return strcmp(mime, MIME_UTF8) == 0 || strcmp(mime, MIME_TEXT) == 0 ||
        strcmp(mime, MIME_UTF8_STRING) == 0 ||
        (state->payload_ascii && strcmp(mime, MIME_STRING) == 0);
}

static bool validate_utf8(const unsigned char *bytes, size_t length, bool *ascii) {
    *ascii = true;
    for (size_t index = 0U; index < length;) {
        const unsigned char first = bytes[index];
        if (first <= 0x7fU) {
            index++;
            continue;
        }
        *ascii = false;
        if (first >= 0xc2U && first <= 0xdfU) {
            if (index + 1U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U) {
                return false;
            }
            index += 2U;
            continue;
        }
        if (first >= 0xe0U && first <= 0xefU) {
            if (index + 2U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (first == 0xe0U && bytes[index + 1U] < 0xa0U) ||
                    (first == 0xedU && bytes[index + 1U] >= 0xa0U)) {
                return false;
            }
            index += 3U;
            continue;
        }
        if (first >= 0xf0U && first <= 0xf4U) {
            if (index + 3U >= length || (bytes[index + 1U] & 0xc0U) != 0x80U ||
                    (bytes[index + 2U] & 0xc0U) != 0x80U ||
                    (bytes[index + 3U] & 0xc0U) != 0x80U ||
                    (first == 0xf0U && bytes[index + 1U] < 0x90U) ||
                    (first == 0xf4U && bytes[index + 1U] >= 0x90U)) {
                return false;
            }
            index += 4U;
            continue;
        }
        return false;
    }
    return true;
}

static int hex_nibble(unsigned char value) {
    if (value >= '0' && value <= '9') return (int)(value - '0');
    if (value >= 'A' && value <= 'F') return (int)(value - 'A') + 10;
    return -1;
}

static bool uri_unreserved(unsigned char value) {
    return ((value >= '0' && value <= '9') ||
        (value >= 'A' && value <= 'Z') ||
        (value >= 'a' && value <= 'z')) || value == '-' || value == '.' ||
        value == '_' || value == '~';
}

static bool validate_uri_path_line(const unsigned char *bytes,
        size_t line_start, size_t line_end, uint32_t expected_item,
        char transaction[38]) {
    static const unsigned char prefix[] =
        "file:///run/sandcodex-app/drop/";
    static const unsigned char clip_prefix[] = "clip-";
    static const unsigned char files_marker[] = "/files/";
    static const unsigned char item_marker[] = "item-";
    const size_t prefix_length = sizeof(prefix) - 1U;
    const size_t transaction_prefix_length = sizeof(clip_prefix) - 1U;
    const size_t marker_length = sizeof(files_marker) - 1U;
    const size_t item_marker_length = sizeof(item_marker) - 1U;
    if (line_end <= line_start || line_end - line_start <=
            prefix_length + transaction_prefix_length + 32U + marker_length +
                item_marker_length + 3U ||
            memcmp(bytes + line_start, prefix, prefix_length) != 0) {
        return false;
    }
    size_t input = line_start + prefix_length;
    const size_t transaction_start = input;
    if (input + transaction_prefix_length >= line_end ||
            memcmp(bytes + input, clip_prefix, transaction_prefix_length) != 0) {
        return false;
    }
    input += transaction_prefix_length;
    for (size_t index = 0U; index < 32U; index++) {
        const unsigned char value = bytes[input + index];
        if (!((value >= '0' && value <= '9') ||
                (value >= 'a' && value <= 'f'))) {
            return false;
        }
    }
    input += 32U;
    (void)memcpy(transaction, bytes + transaction_start,
        transaction_prefix_length + 32U);
    transaction[transaction_prefix_length + 32U] = '\0';
    if (input + marker_length >= line_end ||
            memcmp(bytes + input, files_marker, marker_length) != 0) {
        return false;
    }
    input += marker_length;
    if (input + item_marker_length + 3U >= line_end ||
            memcmp(bytes + input, item_marker, item_marker_length) != 0) {
        return false;
    }
    input += item_marker_length;
    if (expected_item < 1U || expected_item > MAX_URI_LIST_ENTRIES ||
            bytes[input] != '0' ||
            bytes[input + 1U] != (unsigned char)('0' + expected_item) ||
            bytes[input + 2U] != '/') {
        return false;
    }
    input += 3U;

    unsigned char decoded[NAME_MAX + 1U];
    size_t output = 0U;
    bool valid = true;
    while (valid && input < line_end) {
        const unsigned char value = bytes[input];
        if (output >= NAME_MAX || value == '/') {
            valid = false;
            break;
        }
        if (uri_unreserved(value)) {
            decoded[output++] = value;
            input++;
            continue;
        }
        if (value != '%' || input + 2U >= line_end) {
            valid = false;
            break;
        }
        const int high = hex_nibble(bytes[input + 1U]);
        const int low = hex_nibble(bytes[input + 2U]);
        if (high < 0 || low < 0) {
            valid = false;
            break;
        }
        const unsigned char decoded_value = (unsigned char)((high << 4) | low);
        if (uri_unreserved(decoded_value) || decoded_value == '/' ||
                decoded_value == '\\' || decoded_value == 0U ||
                decoded_value < 0x20U || decoded_value == 0x7fU) {
            valid = false;
            break;
        }
        decoded[output++] = decoded_value;
        input += 3U;
    }
    if (valid && (output == 0U ||
            (output == 1U && decoded[0] == '.') ||
            (output == 2U && decoded[0] == '.' && decoded[1] == '.'))) {
        valid = false;
    }
    bool ascii = false;
    if (valid && !validate_utf8(decoded, output, &ascii)) {
        valid = false;
    }
    return valid;
}

static bool validate_uri_list(const unsigned char *bytes, size_t length) {
    if (length == 0U || length > MAX_URI_LIST_PAYLOAD_BYTES) {
        return false;
    }
    size_t offset = 0U;
    uint32_t entries = 0U;
    char first_transaction[38] = {0};
    while (offset < length) {
        const size_t line_start = offset;
        while (offset < length && bytes[offset] != '\r' && bytes[offset] != '\n') {
            if (bytes[offset] < 0x21U || bytes[offset] > 0x7eU) {
                return false;
            }
            offset++;
        }
        char transaction[38] = {0};
        if (offset + 1U >= length || bytes[offset] != '\r' ||
                bytes[offset + 1U] != '\n' ||
                ++entries > MAX_URI_LIST_ENTRIES ||
                !validate_uri_path_line(bytes, line_start, offset, entries,
                    transaction) ||
                (entries > 1U && strcmp(first_transaction, transaction) != 0)) {
            return false;
        }
        if (entries == 1U) {
            (void)memcpy(first_transaction, transaction, sizeof(first_transaction));
        }
        offset += 2U;
    }
    return entries >= 1U && entries <= MAX_URI_LIST_ENTRIES;
}

static uint32_t read_be32(const unsigned char *bytes) {
    return ((uint32_t)bytes[0] << 24U) | ((uint32_t)bytes[1] << 16U) |
        ((uint32_t)bytes[2] << 8U) | (uint32_t)bytes[3];
}

static uint32_t png_crc32(const unsigned char *bytes, size_t length) {
    uint32_t value = UINT32_C(0xffffffff);
    for (size_t index = 0U; index < length; index++) {
        value ^= (uint32_t)bytes[index];
        for (unsigned bit = 0U; bit < 8U; bit++) {
            const uint32_t mask = (uint32_t)-(int32_t)(value & 1U);
            value = (value >> 1U) ^ (UINT32_C(0xedb88320) & mask);
        }
    }
    return value ^ UINT32_C(0xffffffff);
}

static bool validate_png(const unsigned char *bytes, size_t length) {
    static const unsigned char signature[8] = {
        0x89U, 0x50U, 0x4eU, 0x47U, 0x0dU, 0x0aU, 0x1aU, 0x0aU,
    };
    if (length < 57U || memcmp(bytes, signature, sizeof(signature)) != 0) {
        return false;
    }
    size_t offset = sizeof(signature);
    uint32_t chunks = 0U;
    bool saw_header = false;
    bool saw_data = false;
    bool saw_end = false;
    while (offset < length) {
        if (++chunks > MAX_PNG_CHUNKS || length - offset < 12U) {
            return false;
        }
        const uint32_t data_length = read_be32(bytes + offset);
        if (data_length > INT32_MAX ||
                (uintmax_t)data_length > (uintmax_t)(length - offset - 12U)) {
            return false;
        }
        const unsigned char *type = bytes + offset + 4U;
        const unsigned char *data = bytes + offset + 8U;
        const size_t crc_offset = offset + 8U + (size_t)data_length;
        if (png_crc32(type, 4U + (size_t)data_length) !=
                read_be32(bytes + crc_offset)) {
            return false;
        }
        if (memcmp(type, "IHDR", 4U) == 0) {
            if (chunks != 1U || saw_header || data_length != 13U) {
                return false;
            }
            const uint32_t width = read_be32(data);
            const uint32_t height = read_be32(data + 4U);
            const uint64_t pixels = (uint64_t)width * (uint64_t)height;
            if (width == 0U || height == 0U || width > MAX_PNG_DIMENSION ||
                    height > MAX_PNG_DIMENSION || pixels > MAX_PNG_PIXELS ||
                    data[8] != 8U || (data[9] != 2U && data[9] != 6U) ||
                    data[10] != 0U || data[11] != 0U || data[12] != 0U) {
                return false;
            }
            saw_header = true;
        } else if (memcmp(type, "IDAT", 4U) == 0) {
            if (!saw_header || saw_end || data_length == 0U) {
                return false;
            }
            saw_data = true;
        } else if (memcmp(type, "IEND", 4U) == 0) {
            if (!saw_header || !saw_data || saw_end || data_length != 0U ||
                    crc_offset + 4U != length) {
                return false;
            }
            saw_end = true;
        } else {
            /* The controller emits metadata-free IHDR+IDAT+IEND only. */
            return false;
        }
        offset = crc_offset + 4U;
        if (saw_end) {
            break;
        }
    }
    return saw_header && saw_data && saw_end && offset == length;
}

static int inspect_pipe_endpoint(int descriptor, int expected_access,
        struct stat *metadata) {
    const int flags = fcntl(descriptor, F_GETFL);
    if (flags < 0 || (flags & O_ACCMODE) != expected_access ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, metadata) < 0 || !S_ISFIFO(metadata->st_mode) ||
            metadata->st_uid != geteuid() || metadata->st_nlink != 1U) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static bool same_pipe_endpoint(const struct stat *left, const struct stat *right) {
    return left->st_dev == right->st_dev && left->st_ino == right->st_ino;
}

static int inspect_descriptor_inventory(int payload_descriptor) {
    DIR *directory = opendir("/proc/self/fd");
    if (directory == NULL) {
        return -1;
    }
    const int inventory_descriptor = dirfd(directory);
    bool seen_standard[3] = {false, false, false};
    bool seen_payload = false;
    bool seen_inventory = false;
    size_t count = 0U;
    errno = 0;
    for (;;) {
        struct dirent *entry = readdir(directory);
        if (entry == NULL) {
            break;
        }
        if (entry->d_name[0] == '.') {
            continue;
        }
        uint64_t value = 0U;
        if (!parse_u64(entry->d_name, 0U, INT_MAX, &value)) {
            errno = EPROTO;
            (void)closedir(directory);
            return -1;
        }
        const int descriptor = (int)value;
        count++;
        if (descriptor >= 0 && descriptor <= 2) {
            seen_standard[descriptor] = true;
        } else if (descriptor == payload_descriptor) {
            if (seen_payload) {
                errno = EPROTO;
                (void)closedir(directory);
                return -1;
            }
            seen_payload = true;
        } else if (descriptor == inventory_descriptor) {
            seen_inventory = true;
        } else {
            errno = EPROTO;
            (void)closedir(directory);
            return -1;
        }
    }
    const int scan_errno = errno;
    const int close_result = closedir(directory);
    if (scan_errno != 0 || close_result < 0 || count != 5U ||
            !seen_standard[0] || !seen_standard[1] || !seen_standard[2] ||
            !seen_payload || !seen_inventory) {
        errno = EPROTO;
        return -1;
    }
    return 0;
}

static int inspect_payload(int descriptor, size_t expected_size,
        enum payload_profile profile, bool *payload_ascii, bool *payload_exec_sealed) {
    struct stat metadata = {0};
    const int flags = fcntl(descriptor, F_GETFL);
    const int descriptor_flags = fcntl(descriptor, F_GETFD);
    const int seals = fcntl(descriptor, F_GET_SEALS);
    const int required_seals = F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE |
        F_SEAL_SEAL | F_SEAL_EXEC;
    const size_t profile_limit = profile == PROFILE_PNG ? MAX_PNG_PAYLOAD_BYTES :
        (profile == PROFILE_FILES ? MAX_URI_LIST_PAYLOAD_BYTES : MAX_TEXT_PAYLOAD_BYTES);
    if (descriptor < 3 || expected_size > profile_limit || flags < 0 ||
            descriptor_flags < 0 || (flags & O_ACCMODE) != O_RDONLY ||
            (flags & (O_APPEND | O_NONBLOCK)) != 0 ||
            fstat(descriptor, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
            metadata.st_uid != geteuid() || metadata.st_nlink != 0U ||
            (metadata.st_mode & 07777U) != 0600U || metadata.st_size < 0 ||
            (uintmax_t)metadata.st_size != (uintmax_t)expected_size ||
            seals != required_seals ||
            fcntl(descriptor, F_SETFD, descriptor_flags | FD_CLOEXEC) < 0) {
        errno = EPROTO;
        return -1;
    }
    *payload_ascii = true;
    *payload_exec_sealed = true;
    if ((profile == PROFILE_PNG && expected_size < 57U) ||
            (profile == PROFILE_FILES && expected_size == 0U)) {
        errno = EILSEQ;
        return -1;
    }
    if (expected_size > 0U) {
        void *mapping = mmap(NULL, expected_size, PROT_READ, MAP_PRIVATE, descriptor, 0);
        if (mapping == MAP_FAILED) {
            return -1;
        }
        const bool valid = profile == PROFILE_PNG ?
            validate_png(mapping, expected_size) :
            (profile == PROFILE_FILES ?
                validate_uri_list(mapping, expected_size) :
                validate_utf8(mapping, expected_size, payload_ascii));
        if (munmap(mapping, expected_size) < 0) {
            return -1;
        }
        if (!valid) {
            errno = EILSEQ;
            return -1;
        }
    } else if (profile == PROFILE_PNG || profile == PROFILE_FILES) {
        errno = EILSEQ;
        return -1;
    }
    return 0;
}

static int harden_process(int payload_descriptor, size_t payload_size,
        enum payload_profile profile, bool *payload_ascii,
        bool *payload_exec_sealed) {
    const pid_t parent = getppid();
    struct stat input = {0};
    struct stat output = {0};
    struct stat diagnostic = {0};
    const struct rlimit no_core = {.rlim_cur = 0, .rlim_max = 0};
    const struct rlimit no_regular_file_output = {.rlim_cur = 0, .rlim_max = 0};
    if (parent <= 1 || inspect_descriptor_inventory(payload_descriptor) < 0 ||
            inspect_pipe_endpoint(STDIN_FILENO, O_RDONLY, &input) < 0 ||
            inspect_pipe_endpoint(STDOUT_FILENO, O_WRONLY, &output) < 0 ||
            inspect_pipe_endpoint(STDERR_FILENO, O_WRONLY, &diagnostic) < 0 ||
            same_pipe_endpoint(&input, &output) || same_pipe_endpoint(&input, &diagnostic) ||
            same_pipe_endpoint(&output, &diagnostic) ||
            inspect_payload(payload_descriptor, payload_size, profile,
                payload_ascii, payload_exec_sealed) < 0 ||
            setrlimit(RLIMIT_CORE, &no_core) < 0 ||
            setrlimit(RLIMIT_FSIZE, &no_regular_file_output) < 0) {
        errno = EPROTO;
        return -1;
    }
    if (prctl(PR_SET_PDEATHSIG, SIGTERM) < 0 || getppid() != parent ||
            prctl(PR_SET_NO_NEW_PRIVS, 1L, 0L, 0L, 0L) < 0 ||
            prctl(PR_SET_DUMPABLE, 0L, 0L, 0L, 0L) < 0) {
        return -1;
    }
    (void)umask(S_IRWXG | S_IRWXO);
    return 0;
}

static void registry_global(void *data, struct wl_registry *registry,
        uint32_t name, const char *interface, uint32_t version) {
    struct clipboard_state *state = data;
    if (strcmp(interface, ext_data_control_manager_v1_interface.name) == 0) {
        state->manager_count++;
        if (state->manager == NULL) {
            state->manager_version = version < 1U ? version : 1U;
            state->manager_name = name;
            state->manager = wl_registry_bind(registry, name,
                &ext_data_control_manager_v1_interface, state->manager_version);
        }
    } else if (strcmp(interface, wl_seat_interface.name) == 0) {
        state->seat_count++;
        if (state->seat == NULL) {
            state->seat_name = name;
            state->seat = wl_registry_bind(registry, name, &wl_seat_interface,
                version < 1U ? version : 1U);
        }
    }
}

static void registry_remove(void *data, struct wl_registry *registry, uint32_t name) {
    (void)registry;
    struct clipboard_state *state = data;
    if (name == state->manager_name || name == state->seat_name) {
        state->topology_valid = false;
        state->terminal_error = true;
    }
}

static const struct wl_registry_listener registry_listener = {
    .global = registry_global,
    .global_remove = registry_remove,
};

