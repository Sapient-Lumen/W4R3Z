+static bool sandcodex_request_operation(json_object *request,
+		const char *expected) {
+	json_object *operation = NULL;
+	return json_object_object_get_ex(request, "op", &operation) &&
+		json_object_is_type(operation, json_type_string) &&
+		strcmp(json_object_get_string(operation), expected) == 0;
+}
