+static void sandcodex_send_touch_stroke_target(struct ipc_client *client,
+		const struct sandcodex_hit_target *target, struct sway_view *view,
+		const char *ticket, int64_t start_x, int64_t start_y,
+		int64_t end_x, int64_t end_y, uint32_t steps,
+		uint32_t duration_msec) {
+	json_object *reply = json_object_new_object();
+	json_object_object_add(reply, "schema",
+		json_object_new_string(SANDCODEX_HIT_TEST_SCHEMA));
+	json_object_object_add(reply, "patch_version",
+		json_object_new_int(SANDCODEX_HIT_TEST_PATCH_VERSION));
+	json_object_object_add(reply, "success", json_object_new_boolean(true));
+	json_object_object_add(reply, "operation",
+		json_object_new_string("arm-touch-stroke"));
+	json_object_object_add(reply, "dispatch_ticket",
+		json_object_new_string(ticket));
+	json_object_object_add(reply, "start_x", json_object_new_int64(start_x));
+	json_object_object_add(reply, "start_y", json_object_new_int64(start_y));
+	json_object_object_add(reply, "end_x", json_object_new_int64(end_x));
+	json_object_object_add(reply, "end_y", json_object_new_int64(end_y));
+	json_object_object_add(reply, "steps", json_object_new_int((int)steps));
+	json_object_object_add(reply, "path_points",
+		json_object_new_int((int)(steps + 1)));
+	json_object_object_add(reply, "duration_milliseconds",
+		json_object_new_int((int)duration_msec));
+	json_object_object_add(reply, "same_surface_path",
+		json_object_new_boolean(true));
+	sandcodex_json_add_target_identity(reply, target, view);
+	const char *json_string = json_object_to_json_string_ext(reply,
+		JSON_C_TO_STRING_PLAIN);
+	ipc_send_reply(client, IPC_SANDCODEX_HIT_TEST, json_string,
+		(uint32_t)strlen(json_string));
+	json_object_put(reply);
+}
