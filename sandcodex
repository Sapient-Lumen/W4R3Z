NAME = {"type": "string", "pattern": r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
INTEGER = {"type": "integer", "minimum": 1}
RELATIVE_PATH = {"type": "string", "minLength": 1, "maxLength": 1024,
                 "pattern": r"^(?!/)(?!\.sandcodex(?:/|$))(?!.*(?:^|/)\.\.?(?:/|$)).+$"}


def definition(name, description, properties=None, required=None):
    return {"name": name, "description": description,
            "inputSchema": schema(properties, required)}


if ROLE == "worker":
    TOOLS = [
        definition("team_reply", "Reply to the interactive foreman or another team worker.", {
            "message": {"type": "string", "minLength": 1, "maxLength": MAX_TEXT},
            "to": {"type": "string", "pattern": r"^(foreman|[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"},
            "reply_to": STRING, "attachment": STRING,
        }, ["message"]),
        definition("team_complete", "Report final evidence and end this worker successfully after the current turn.", {
            "message": {"type": "string", "minLength": 1, "maxLength": MAX_TEXT},
            "attachment": STRING,
        }, ["message"]),
        definition("team_inbox", "Read messages delivered to this worker."),
        definition("team_ack", "Acknowledge a team message.", {"message_id": STRING}, ["message_id"]),
        definition("team_identity", "Read this worker's sealed team identity."),
    ]
else:
    TOOLS = [
        definition("team_start", f"Start an independent concurrent worker; turns defaults to {DEFAULT_TURNS} (0 means unbounded until completion or stop).", {
            "name": NAME, "prompt": {"type": "string", "minLength": 1, "maxLength": MAX_TEXT},
            "turns": {"type": "integer", "minimum": 0},
            "depends": {"type": "array", "items": NAME, "maxItems": 64},
            "provider": {"type": "string", "enum": ["auto", "gpt", "gemini", "remote", "local", "openrouter"]},
            "allowed_providers": {"type": "array", "items": {"type": "string", "enum": ["gpt", "gemini", "remote", "local", "openrouter"]}, "maxItems": 5},
            "effort": {"type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
            "token_budget": INTEGER, "time_budget_seconds": INTEGER,
            "browser": {"type": "string", "enum": ["none", "isolated"]},
            "desktop": {"type": "string", "enum": ["none", "isolated"]},
            "verifier": RELATIVE_PATH,
        }, ["name", "prompt"]),
        definition("team_graph", "Submit a validated dependency graph of team tasks.", {"graph": {"type": "object"}}, ["graph"]),
        definition("team_list", "List all team workers."),
        definition("team_top", "Read live aggregate worker, provider, mailbox, budget, and token telemetry."),
        definition("team_status", "Inspect one worker.", {"name": NAME}, ["name"]),
        definition("team_events", "Read a worker's event ledger from a cursor.", {
            "name": NAME, "cursor": {"type": "integer", "minimum": 0}}, ["name"]),
        definition("team_attach", "Read a worker's status, new events, and recent conversation.", {
            "name": NAME, "cursor": {"type": "integer", "minimum": 0}}, ["name"]),
        definition("team_inspect", "Inspect one worker's status, event ledger, messages, and acknowledgements.", {
            "name": NAME, "cursor": {"type": "integer", "minimum": 0}}, ["name"]),
        definition("team_send", "Send a message or attachment to a running worker.", {
            "name": NAME, "message": {"type": "string", "minLength": 1, "maxLength": MAX_TEXT},
            "attachment": STRING}, ["name", "message"]),
        definition("team_inbox", "Read worker-to-foreman messages.", {"name": NAME}),
        definition("team_ack", "Acknowledge a worker message.", {"message_id": STRING}, ["message_id"]),
        definition("team_wait", "Wait for one worker to reach a terminal state.", {
            "name": NAME, "timeout_seconds": {"type": "integer", "minimum": 0}}, ["name"]),
        definition("team_wait_any", "Wait for any worker to reach a terminal state.", {
