  "$SC_WAYLAND_SCANNER" private-code "$pointer_xml" "$pointer_code"
  chmod 600 -- "$pointer_header" "$pointer_code"
  gcc -std=c11 -O2 -fPIE -fstack-protector-strong -D_FORTIFY_SOURCE=3 \
