def _sealed_open_uri_policy(
    portal_access: str,
    encoded: str,
    expected_sha256: str,
) -> OpenUriPolicy | None:
    """Decode and bind the exact controller-authorized OpenURI policy."""
    enabled = "open-uri" in _portal_features(portal_access)
    if not enabled:
        if encoded or expected_sha256:
            raise PortalError("OpenURI policy was supplied without OpenURI authority")
        return None
    if not encoded:
        raise PortalError("OpenURI access requires one exact launch policy")
    if SHA256_RE.fullmatch(expected_sha256) is None:
        raise PortalError("OpenURI access requires one canonical policy digest")
    policy = OpenUriPolicy.decode(encoded)
    if not hmac.compare_digest(policy.digest, expected_sha256):
        raise PortalError("OpenURI policy digest does not match the decoded authority")
    return policy


