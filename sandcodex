    namespace_alias = next(alias for alias, metadata in rich_bridge.items()
                           if metadata == {"kind": "function", "name": "inspect",
                                           "namespace": "mcp"})
    custom_alias = next(alias for alias, metadata in rich_bridge.items()
                        if metadata == {"kind": "custom", "name": "apply_patch",
