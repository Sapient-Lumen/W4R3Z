def run_native_loop(pi:Path,service:Service,area:Path,out:Path)->list[str]:
    """Drive /loop through actual pinned Pi RPC and synthetic inference.

    This is intentionally part of the full native stage, not the zero-inference
    experience stage. The temporary session is acceptance-owned; the durable
    receipt retains no objective or model output.
    """
    import time
    agent=area/'agent';project=area/'project';project.mkdir(parents=True)
    creds=area/'canonical';atomic_write(creds/'remote/openrouter-keys.txt','\n'.join(KEYS)+'\n')
    data=catalog.normalize({'data':[model_row(CHAT_MODEL)]},include_paid=False)
    helper=area/'sandpi-auth'
    atomic_write(helper,'#!/bin/sh\nexec '+shlex.quote(sys.executable)+' '+shlex.quote(str(ROOT/'src/guest.py'))+' auth "$@"\n',0o700)
    configure_runtime(agent,{'mode':'vm','room_id':'synthetic-native-loop','providers':['openrouter'],
        'pi_runtime':{'catalog':catalog.free_view(data),'all_catalog':{}}},str(helper))
    base=f'http://127.0.0.1:{service.server_port}/v1'
    config=json.loads((agent/'sandpi-runtime.json').read_text())
    for definition in config['modelDefinitions']:definition['baseUrl']=base
    config['syntheticTransportBases']={'openai-completions':base}
    atomic_json(agent/'sandpi-runtime.json',config)
    atomic_json(agent/'settings.json',{'cacheWarming':'off','retry':{'enabled':True},
        'compaction':{'enabled':False},'quietStartup':True})
    command=[str(pi),'--offline','--no-mcp','--no-approve','--no-context-files','--no-skills',
        '--no-prompt-templates','--no-extensions','-e',str(ROOT/'src/pi/index.ts'),
        '--mode','rpc','--provider','openrouter','--model',CHAT_MODEL,'--thinking','off',
        '--tools','read,bash,edit,write','--session-dir',str(agent/'sessions')]
    invocation=prepare_pi_invocation(agent,command[1:],str(pi),project,
        base_runtime=agent/'sandpi-runtime.json',use_launch_policy=True)
    socket=area/'credentials.sock'
    env=native_env(area,SANDPI_RUNTIME_CONFIG=str(invocation),SANDPI_CREDENTIAL_SOCKET=str(socket))
    objective='Exercise the bounded native loop fixture without changing its authority.'
    first_request=len(service.requests)
    service.modes[CHAT_MODEL]='tools';service.rejected.discard(CHAT_MODEL)
    local=out/'native-loop';local.mkdir()
    with credential_server(socket,CredentialStore(creds,environ={})):
        probe=ChoiceProbe(command,project,env,local)
        try:
            before=probe.call('get_state')['data']
            notices=len(probe.notices)
            answer=probe.call('prompt',message='/loop 2 "'+objective+'"')
            if answer.get('data',{}).get('disposition')!='handled':
                raise SandpiError('native Pi did not handle /loop locally')
            deadline=time.monotonic()+90
            started=False
            while True:
                after=probe.call('get_state')['data']
                started = started or bool(after.get('isStreaming')) or len(service.requests)>first_request
                if started and not after.get('isStreaming') and not after.get('isCompacting'):break
                if time.monotonic()>=deadline:raise SandpiError('native Pi loop did not settle')
