        data=call('get_state').get('data',{})
        if data.get('model',{}).get('id')!=model or data.get('thinkingLevel')!=level:
            raise SandpiError('native model/thinking choice did not survive its lifecycle boundary')
        if data.get('isStreaming') or data.get('isCompacting'):
            raise SandpiError('a choice unexpectedly started inference or compaction')
