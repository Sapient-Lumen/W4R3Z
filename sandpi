def ordinary_empty_directory(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        path.mkdir(mode=0o700)
        info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail("project must be an owned ordinary directory")
    if any(path.iterdir()):
        fail("project directory must be empty")
    path.chmod(0o700)


def exclusive_write(path: Path, content: str, mode: int = 0o644) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, mode)
    try:
        raw = content.encode("utf-8")
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def prepare(task_id: str, project: Path) -> dict[str, Any]:
    contract = task_contract(task_id)
    ordinary_empty_directory(project)
    for relative, content in contract["public_files"].items():
        exclusive_write(project / relative, content)
    directory = os.open(project, os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    return {
        "schema": SCHEMA_PREPARE,
        "bench_version": BENCH_VERSION,
