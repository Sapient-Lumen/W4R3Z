                ('paid-chat',lambda:run_protocol(pi,service,root/'paid-chat',out,PAID_CHAT_MODEL)),
                ('paid-messages',lambda:run_protocol(pi,service,root/'paid-messages',out,PAID_MESSAGES_MODEL)),
                # Run last because the shared synthetic server deliberately
                # retains per-model request/rejection history for earlier
                # protocol cardinality checks.
                ('native-loop',lambda:run_native_loop(pi,service,root/'native-loop',out))]
        progress=NativeProgress(out,scope,[name for name,_ in phases])
        checks=[]
        try:
            for name,action in phases:checks+=progress.execute(name,action)
            if service.protocol_errors:raise SandpiError('synthetic server rejected a native request')
