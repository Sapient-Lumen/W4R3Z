import shlex
import sys

ROOT = Path(__file__).resolve().parent.parent
TOP = ('pins.json', 'README.md', 'AGENTS.md', 'CHANGELOG.md', 'LICENSE')
DIRECTORIES = ('src', 'nix', 'tests', 'tools', 'docs', 'examples')
EXCLUDE_DIRS = {'__pycache__', '.git', '.pytest_cache', 'results', 'evidence'}
EXCLUDE_SUFFIXES = {'.pyc', '.pyo', '.zip'}


def assets(root: Path) -> list[tuple[str, bytes, int]]:
    files = [root / name for name in TOP if (root / name).is_file()]
    for directory in DIRECTORIES:
        files += [p for p in (root / directory).rglob('*') if p.is_file() and not p.is_symlink()
                  and not (set(p.relative_to(root).parts) & EXCLUDE_DIRS)
                  and p.suffix not in EXCLUDE_SUFFIXES]
    result = []
    for path in sorted(set(files), key=lambda p: str(p.relative_to(root))):
        name = path.relative_to(root).as_posix()
        data = path.read_bytes()
        if b'\0' in data:
            raise ValueError(f'binary asset is not supported in the readable shell payload: {name}')
        if not data.endswith(b'\n'):
            raise ValueError(f'text asset must end with a newline: {name}')
        mode = 0o700 if os.access(path, os.X_OK) or name.endswith('.sh') else 0o600
        result.append((name, data, mode))
