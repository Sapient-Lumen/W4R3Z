                        forcedEffective?: string): string => {
    if (!PROFILE_REQUESTS.has(request)) request = 'auto';
    profileRequest = request;
    let wanted = forcedEffective && EFFECTIVE_PROFILES.has(forcedEffective)
      ? forcedEffective : resolveProfile(profileRequest, ctx.model);
    if (!supportsTools(ctx.model) && wanted !== 'passthrough') wanted = 'text-only';

    const previous = effectiveProfile;
    const current = pi.getActiveTools();
    if (passthroughTools === undefined) passthroughTools = [...current];
    const currentDirect = current.filter((name: string) => name !== 'codemode');
    if (capableTools === undefined) capableTools = [...currentDirect];

    // Sandpi owns only Codemode presence. Pi owns the ordinary direct/MCP set.
    // Replacing, disabling, or narrowing a Pi tool must survive later model and
    // branch events; do not union an older remembered set back into the loadout.
    // Text-only models temporarily hide every tool, so retain the last capable
    // set across that one transition. Leaving passthrough adopts Pi's current set.
    if (previous === 'passthrough' && wanted !== 'passthrough') {
      capableTools = [...currentDirect];
    } else if (previous !== 'text-only' && previous !== 'passthrough') {
      capableTools = [...currentDirect];
    } else if (previous === 'text-only' && currentDirect.length > 0) {
      capableTools = [...currentDirect];
    }

    if (wanted === 'passthrough') {
      // Entering passthrough restores Pi's launch-time selection exactly once.
      // Thereafter native Pi changes remain Pi-owned across model events.
      if (cfg.toolProfileManaged && previous !== 'passthrough' && !sameList(current, passthroughTools)) {
        pi.setActiveTools([...passthroughTools]);
      }
    } else {
      const configured = new Set(pi.getAllTools()
        .map((tool: any) => typeof tool === 'string' ? tool : tool?.name).filter(Boolean));
      let next: string[];
      if (wanted === 'text-only') {
        next = [];
      } else {
        const baseline = previous === 'text-only' ? capableTools : currentDirect;
        next = baseline.filter((name: string) => configured.has(name));
        capableTools = [...next];
        if (wanted === 'codemode') {
          if (configured.has('codemode')) next.push('codemode');
          else {
            wanted = 'classic';
            notify('Pi codemode is unavailable; retained the classic direct-tool profile.', 'error');
          }
        }
      }
      next = [...new Set(next)];
      if (!sameList(current, next)) pi.setActiveTools(next);
    }

    effectiveProfile = wanted;
    if (persist) {
      const snapshot = profileSnapshot(ctx, profileRequest, effectiveProfile);
      const prior = profileEntry(ctx);
      if (!prior || prior.request !== snapshot.request || prior.effective !== snapshot.effective
          || prior.model?.provider !== snapshot.model?.provider || prior.model?.id !== snapshot.model?.id
          || prior.model?.api !== snapshot.model?.api) {
        pi.appendEntry(PROFILE_ENTRY, snapshot);
      }
    }
    return effectiveProfile;
  };

  const latestTransport = (ctx: any): any | undefined => {
    const entry = reverseCustom(ctx.sessionManager.getBranch(), TRANSPORT_ENTRY);
    const model = entry?.data?.model;
    return model && typeof model.provider === 'string' && typeof model.id === 'string' ? entry.data : undefined;
  };

  const recordTransport = (ctx: any, event: string): void => {
    const current = modelIdentity(ctx.model);
    if (!current) return;
    const prior = latestTransport(ctx);
    if (prior?.model?.provider === current.provider && prior.model.id === current.id
        && prior.model.api && current.api && prior.model.api !== current.api) {
      pi.appendEntry(TRANSPORT_ENTRY, { model: current, from_api: prior.model.api,
        event, policy: 'pinned-pi-openrouter-transport', at: new Date().toISOString(), version: 1 });
      notify(`Pi transport for ${current.provider}/${current.id} changed from ${transportName(prior.model.api)} to ${transportName(current.api)}; the physical model is unchanged and the migration is recorded in this branch.`, 'info');
      return;
    }
    if (!prior || prior.model?.provider !== current.provider || prior.model?.id !== current.id || prior.model?.api !== current.api) {
      pi.appendEntry(TRANSPORT_ENTRY, { model: current, event,
        policy: 'pinned-pi-openrouter-transport', at: new Date().toISOString(), version: 1 });
    }
  };

  const reconcileAffinity = (ctx: any): string | undefined => {
    // Custom entries are inherited by native forks, but are not model messages.
    // A preflight affinity is available before session_start so a native Gemini
    // request cannot accidentally lease a different key while startup settles.
    const prior = reverseCustom(ctx.sessionManager.getBranch(), AFFINITY_ENTRY);
    const branchOrigin = typeof prior?.data?.origin === 'string' && /^[a-zA-Z0-9:._-]{1,200}$/.test(prior.data.origin)
      ? prior.data.origin : undefined;
    const snapshotOrigin = resumeSnapshot?.found && typeof resumeSnapshot.affinity_origin === 'string'
      ? resumeSnapshot.affinity_origin : undefined;
    if (snapshotOrigin && branchOrigin !== snapshotOrigin) {
      return 'the native Pi branch Gemini affinity changed after resume preflight; refusing an ambiguous signed-history continuation';
    }
    affinityOrigin = snapshotOrigin ?? branchOrigin ?? `${cfg.room}:${ctx.sessionManager.getSessionId()}`;
    if (!branchOrigin) pi.appendEntry(AFFINITY_ENTRY, { origin: affinityOrigin });
    return undefined;
  };

  const remember = async (ctx: any, event: string): Promise<void> => {
    const affinityError = reconcileAffinity(ctx);
    if (affinityError) throw new Error(affinityError);

    const value = { schema: 'sandpi.session-hint.v6', room: cfg.room, mode: cfg.mode,
      workdir: ctx.cwd, model: modelIdentity(ctx.model), session: ctx.sessionManager.getSessionId(),
      name: pi.getSessionName() ?? null, event, tool_profile: effectiveProfile,
      thinking_level: currentThinking() ?? null, resume: resumeObservation,
      at: new Date().toISOString() };
    const target = join(agent, 'sandpi-session.json');
    const tmp = `${target}.${process.pid}.${Date.now()}`;
    writeFileSync(tmp, JSON.stringify(value) + '\n', { mode: 0o600 });
    renameSync(tmp, target);
    try {
      await rpc({ op: 'session-update', hint: value });
    } catch {
      if (!observationWarningShown) {
        observationWarningShown = true;
        notify('Host session observation is unavailable; Pi session data remains intact in this room.', 'info');
      }
    }
    if (ctx.mode === 'tui') {
      const identity = value.model ? `${value.model.provider}/${value.model.id}` : 'no model';
      const transport = value.model?.api ? ` · ${transportName(value.model.api)}` : '';
      const thinking = currentThinking();
      const lifetime = cfg.mode === 'bare-metal' ? 'HOST ROOT' : `${entryRole}/${roomLifecycle}`;
      ctx.ui.setStatus('sandpi', `${cfg.mode === 'bare-metal' ? 'HOST ROOT' : 'VM root'} · ${cfg.room} · ${lifetime} · ${invocationMode} · ${identity}${transport} · ${effectiveProfile}${thinking ? ` · ${thinking}` : ''}`);
    }
  };

  const recordResumeAudit = (ctx: any, outcome: string, original: any, startupProjection: any,
                             runtimeBefore: any): void => {
    const data = { outcome, original: modelIdentity(original), startup_projection: modelIdentity(startupProjection),
      runtime_before: modelIdentity(runtimeBefore), final_model: modelIdentity(ctx.model),
      snapshot_sha256: resumeSnapshot?.found ? resumeSnapshot.file.sha256 : null,
      at: new Date().toISOString(), version: 1 };
    resumeObservation = { outcome: data.outcome, original: data.original,
      startup_projection: data.startup_projection, runtime_before: data.runtime_before,
      final_model: data.final_model, snapshot_sha256: data.snapshot_sha256 };
    const prior = reverseCustom(ctx.sessionManager.getBranch(), RESUME_AUDIT_ENTRY)?.data;
    if (!prior || prior.snapshot_sha256 !== data.snapshot_sha256 || prior.outcome !== data.outcome
        || !sameModel(prior.final_model, data.final_model)) {
      pi.appendEntry(RESUME_AUDIT_ENTRY, data);
    }
  };

  const recordHandoff = (from: any, to: any, policy: string) => {
    pi.appendEntry(HANDOFF_ENTRY, {
      from: { provider: from.provider, id: from.modelId ?? from.id,
        ...(typeof from.api === 'string' ? { api: from.api } : {}) },
      to: { provider: to.provider, id: to.id,
        ...(typeof to.api === 'string' ? { api: to.api } : {}) }, policy,
      grade: to.provider === 'openrouter' ? grade(to.id) ?? null : null,
      at: new Date().toISOString(), version: 1,
    });
  };

  const enableExactModelProbe = (saved: any, current: any) => {
    const original = saved && { provider: saved.provider, id: saved.modelId ?? saved.id };
    if (original?.provider === 'openrouter' && current?.provider === 'openrouter'
        && original.id === (current.modelId ?? current.id)) {
      cfg.allowModelCooldownProbe = true;
    }
  };

  const failStart = (ctx: any, message: string, code = 78) => {
    blockedResume = true;
    process.stderr.write(`sandpi: ${message}\n`);
    process.exitCode = code;
    if (ctx.mode === 'tui' && ctx.hasUI) ctx.ui.notify(message, 'error');
    ctx.shutdown();
  };

  const resumeModel = async (ctx: any, saved: any): Promise<'restored' | 'handoff' | 'retired' | null> => {
    // Repair a registry/default mismatch by restoring the exact physical model.
    // This is not a model handoff and therefore creates no handoff entry.
    const exact = ctx.modelRegistry.find(saved.provider, saved.modelId);
    if (exact && await pi.setModel(exact)) return 'restored';
    if (saved.provider !== 'openrouter') return null;

    const models = orderedModels(ctx).filter((model: any) => model.id !== saved.modelId);
    if (!models.length) return null;
    const qualified = models.filter((model: any) => supportsTools(model) && (grade(model.id)?.floor ?? 0) >= 2);
    let selected: any;
    if (cfg.resumeFallback === 'best') {
      selected = qualified[0];
    } else if (cfg.resumeFallback === 'ask' && ctx.mode === 'tui' && ctx.hasUI) {
      // Startup is a lifecycle handler, not a command: no waitForIdle here.
      // Keep the existing one-selection handoff, but do not displace another
      // Sandpi dialog or let a late reply act on a retired startup context.
      const chooser = dialogs.acquire('recovery');
      if (!chooser) { notify(dialogs.refusal(), 'info'); return null; }
      try {
        const manager = ctx.sessionManager;
        const session = manager.getSessionId(), leaf = manager.getLeafId();
        const cwd = ctx.cwd, activeModel = JSON.stringify(modelIdentity(ctx.model));
        const stillHere = () => ctx.mode === 'tui' && ctx.hasUI && ctx.sessionManager === manager
          && manager.getSessionId() === session && manager.getLeafId() === leaf && ctx.cwd === cwd
          && JSON.stringify(modelIdentity(ctx.model)) === activeModel;
        const label = (model: any): string => {
          // A human taking time to choose must not invalidate the menu. Use
          // stable route state here, not routeText's decreasing second count.
          const text = `${model.id}  [${transportName(model.api)}; ${gradeText(model.id)}; ${supportsTools(model) ? 'tools' : 'text-only'}; ${thinkingText(model.id)}; ${lifecycleText(model.id)}; route ${routeState(model.id)}]`;
          const bounded = pickerText(text);
          return text.length > 512 ? `${bounded}… [truncated]` : bounded;
        };
        // Capture displayed strings/identity, not mutable references to old
        // registry objects. Paging itself is not model-selection authority.
        const choices: { id: string; label: string; identity: string }[] = models.map((model: any) => ({ id: model.id, label: label(model),
          identity: JSON.stringify(modelIdentity(model)) }));
        const pages = Math.ceil(choices.length / MODEL_PICKER_PAGE_SIZE);
        let page = 0;
        while (true) {
          const visible = choices.slice(page * MODEL_PICKER_PAGE_SIZE, (page + 1) * MODEL_PICKER_PAGE_SIZE);
          const labels = visible.map(choice => choice.label);
          const previous = page > 0 ? `← Previous page (${page}/${pages})` : undefined;
          const next = page + 1 < pages ? `Next page (${page + 2}/${pages}) →` : undefined;
          const options = [...labels, ...[previous, next].filter((value): value is string => value !== undefined)];
          let answer: string | undefined;
          try {
            answer = await ctx.ui.select(`Saved model ${pickerText(saved.modelId)} is unavailable — choose a visible free handoff`
              + (pages > 1 ? `; page ${page + 1}/${pages}` : ''), options, { signal: chooser.signal });
          } catch {
            if (chooser.signal.aborted) return 'retired';
            // A UI failure is not consent to use Pi's provisional startup
            // model. The caller follows its existing blocked-resume path.
            return null;
          }
          if (chooser.signal.aborted) return 'retired';
          if (answer === undefined || !stillHere()) return null;
          if (previous !== undefined && answer === previous) { page--; continue; }
          if (next !== undefined && answer === next) { page++; continue; }
          // Normalization/truncation must not make two visible rows choose
          // the first registration by accident. An ambiguous answer is not consent.
          const matches = visible.filter(choice => choice.label === answer);
          if (matches.length !== 1) return null;
          const choice = matches[0];
          // Reuse the exact current eligible registration; never substitute a
          // new ID or trust an obsolete object selected on an earlier page.
          const current = orderedModels(ctx).find((model: any) => model.id === choice.id);
          if (!current || JSON.stringify(modelIdentity(current)) !== choice.identity || label(current) !== choice.label) return null;
          const applied = await pi.setModel(current);
          // Already-delegated native work cannot be undone. On retirement do
          // not append old handoff/audit metadata or continue startup work.
          if (chooser.signal.aborted) return 'retired';
          if (!applied) return null;
          recordHandoff(saved, current, cfg.resumeFallback);
          notify(`Resumed with a recorded handoff: ${saved.modelId} → ${current.id} (${gradeText(current.id)}).`);
          return 'handoff';
        }
      } catch (error) {
        if (chooser.signal.aborted) return 'retired';
        throw error;
      } finally { chooser.release(); }
    }
    if (!selected || !(await pi.setModel(selected))) return null;
    recordHandoff(saved, selected, cfg.resumeFallback);
    notify(`Resumed with a recorded handoff: ${saved.modelId} → ${selected.id} (${gradeText(selected.id)}).`);
    return 'handoff';
  };

  pi.on('session_start', async (event, ctx) => {
    costCommand.reset();
    usageContext = ctx;
    notify = (text, level = 'info') => { if (ctx.mode === 'tui') ctx.ui.notify(text, level); };
    if (event.reason === 'startup' && cfg.continueRequested) {
      if (resumeSnapshotError || !resumeSnapshot) {
        failStart(ctx, resumeSnapshotError ?? 'native Pi continuation has no preflight snapshot');
        return;
      }
      if (resumeSnapshot.found && resumeSnapshot.session !== ctx.sessionManager.getSessionId()) {
        failStart(ctx, `Pi selected session ${ctx.sessionManager.getSessionId()} after preflight selected ${resumeSnapshot.session}; refusing ambiguous continuation`);
        return;
      }
      const original = resumeSnapshot.found ? projectedIdentity(resumeSnapshot.projected_model) : null;
      const startupProjection = ctx.sessionManager.buildSessionProjection().model;
      const runtimeBefore = modelIdentity(ctx.model);
      let outcome = resumeSnapshot.found ? 'exact' : 'empty';
      if (original) {
        const changed = !sameModel(original, ctx.model);
        if (cfg.explicitModel) {
          outcome = changed ? 'explicit' : 'exact';
          if (changed) {
            recordHandoff(original, ctx.model, 'explicit-launch');
            notify(`Resumed with the explicit launch model: ${original.provider}/${original.modelId} → ${ctx.model.provider}/${ctx.model.id}.`);
          }
        } else if (changed) {
          const resolution = await resumeModel(ctx, original);
          if (resolution === 'retired') return;
          if (!resolution) {
            recordResumeAudit(ctx, 'blocked', original, startupProjection, runtimeBefore);
            failStart(ctx, `the preflight branch model ${original.provider}/${original.modelId} is unavailable. Use an explicit provider/model, --resume-fallback best with a qualified free model, or retry in the TUI to choose a recorded handoff.`);
            return;
          }
          outcome = resolution;
        }
      } else if (resumeSnapshot.found) {
        outcome = 'no-model';
      }
      enableExactModelProbe(original, ctx.model);
      recordResumeAudit(ctx, outcome, original, startupProjection, runtimeBefore);
    } else if (event.reason === 'startup' && cfg.resumeRequested) {
      // Picker, explicit --session and fork remain native Pi operations. They do
      // not have a deterministic preflight target, so preserve the older
      // extension-time guard rather than pretending the host selected a branch.
      const saved = ctx.sessionManager.buildSessionProjection().model;
      const changed = saved && ctx.model && !sameModel(saved, ctx.model);
      if (cfg.explicitModel) {
        if (changed) {
          recordHandoff(saved, ctx.model, 'explicit-launch');
          notify(`Resumed with the explicit launch model: ${saved.provider}/${saved.modelId} → ${ctx.model.provider}/${ctx.model.id}.`);
        }
      } else if (saved && (!ctx.model || changed)) {
        const resolution = await resumeModel(ctx, saved);
        if (resolution === 'retired') return;
        if (!resolution) {
          failStart(ctx, `the saved session model ${saved.provider}/${saved.modelId} is unavailable. Use an explicit provider/model, --resume-fallback best with a qualified free model, or retry in the TUI to choose a recorded handoff.`);
          return;
        }
      }
      enableExactModelProbe(saved, ctx.model);
    }
    const affinityError = reconcileAffinity(ctx);
    if (affinityError) { failStart(ctx, affinityError); return; }
    // CLI intent describes startup, not a permanent constraint on Pi. Pi's
    // native reason distinguishes initial entry from reload/new/resume/fork.
    // Check only after startup model restoration has finished; provisional
    // model_select events during it are not authoritative.
    if (event.reason === 'startup') {
      const thinkingError = requestedThinkingError(ctx);
      if (thinkingError) { failStart(ctx, thinkingError, 64); return; }
    }
    restoreProfileRequest(ctx);
    // Resolve from Pi's actual physical model. This covers cold auto-selection,
    // exact native resume and later model changes without stale launch guesses.
    applyProfile(ctx, profileRequest, true);
    recordTransport(ctx, 'session-start');
    await remember(ctx, 'session-start');
    sessionStarted = true;
  });
  pi.on('before_agent_start', async (_event, ctx) => { if (blockedResume) { ctx.abort(); ctx.shutdown(); } });
  pi.on('session_tree', async (_event, ctx) => {
    // The selected branch owns its thinking level. Never reapply CLI intent.
    restoreProfileRequest(ctx);
    applyProfile(ctx, profileRequest, true);
    recordTransport(ctx, 'tree');
    await remember(ctx, 'tree');
  });
  pi.on('model_select', async (_event, ctx) => {
    if (sessionStarted && ctx.model?.provider === 'openrouter') {
      // A post-start model choice is deliberate. It may probe an older
      // model-scoped disappearance cooldown, but never provider/account/key or
      // exact route capacity cooldowns.
      cfg.allowModelCooldownProbe = true;
    }
    // A deliberate /model, cycle or restore uses Pi's native thinking rules.
    // Startup validation happens at the final session_start, not here.
    // Explicit classic/codemode choices remain fixed. Auto follows the newly
    // selected physical model and records that branch-local decision.
    applyProfile(ctx, profileRequest, true);
    recordTransport(ctx, 'model-select');
    await remember(ctx, 'model-select');
  });
  pi.on('thinking_level_select', async (_event, ctx) => { await remember(ctx, 'thinking-select'); });
  pi.on('session_info_changed', async (_event, ctx) => { await remember(ctx, 'session-info'); });
  pi.on('agent_settled', async (event, ctx) => {
    costCommand.settled(event, ctx);
    await remember(ctx, event.aborted ? 'settled-aborted' : 'settled');
  });
  pi.on('session_shutdown', async (_event, ctx) => {
    // Retire all Sandpi dialog tickets before existing observer work.
    // Native editors have no abort option; late replies must stop at their ticket.
    dialogs.retire();
    try { if (!blockedResume) await remember(ctx, 'shutdown'); }
    finally { usageContext = undefined; costCommand.reset(); }
  });
  pi.on('cache_warming_decision', async (_event, ctx) => {
    if (ctx.model && ['google', 'openrouter'].includes(ctx.model.provider)) return { action: 'stop' as const };
  });

  pi.registerCommand('sandcost', {
    description: 'OpenRouter charges/cache by session, exact model or since latest switch; optional notice: /sandcost watch AMOUNT',
    getArgumentCompletions: completeCostArgs,
    handler: costCommand.handler,
  });

  pi.registerCommand('keys', {
    description: 'Shared bank leases, cooldowns and content-free request history; use /keys refresh or /keys recent',
    handler: async (args, ctx) => {
      const providers = cfg.providers.filter((p: string) => ['google', 'openrouter'].includes(p));
      const action = String(args).trim().toLowerCase();
      if (action === 'refresh' && providers.includes('openrouter')) {
        await rpc({ op: 'quota-refresh', provider: 'openrouter' });
      }
      const results = await Promise.all(providers.map((provider: string) => rpc({ op: 'pool-status', provider })));
      const lines = results.flatMap(result => {
        const cooldowns = Object.values(result.cooldowns ?? {}) as any[];
        return [result.provider + ': ' + (result.policy ?? 'least-inflight / round-robin'),
          ...result.keys.map((key: any) => {
            const quota = key.quota
              ? `; free remaining ${key.quota.remaining ?? 'unknown'}${key.quota.fresh ? '' : ' (stale/unknown)'}` : '';
            return `  ${key.label}: ${key.active} active, ${key.successes ?? 0} successful; group ${key.quota_group}; last ${key.last_outcome ?? 'unused'}${quota}`;
          }),
          ...cooldowns.map((row: any) => `  cooling ${row.scope}${row.model ? ` model=${row.model}` : ''}${row.quota_group ? ` group=${row.quota_group}` : ''} until ${new Date(row.until * 1000).toISOString()}`),
          `  ${cooldowns.length} active cooldowns`];
      });
      if (action === 'recent' || action === 'history') {
        const history = await rpc({ op: 'request-events', limit: 12 });
        lines.push('recent request attempts (routing facts only):');
        for (const row of history.events ?? []) {
          const status = row.status ? ` HTTP ${row.status}` : '';
          const healing = row.healed_scopes?.length ? ` healed=${row.healed_scopes.join(',')}` : '';
          const bypass = row.model_cooldown_bypassed ? ' exact-model-probe' : '';
          lines.push(`  ${row.provider}/${row.model} request=${String(row.request_scope).slice(0, 8)} attempt=${row.attempt} ${row.event}${row.outcome ? ` ${row.outcome}` : ''}${status}${bypass}${healing}`);
        }
      }
      if (ctx.hasUI) ctx.ui.notify(lines.join('\n'), 'info');
    },
  });

  pi.registerCommand('sandroute', {
    description: 'Show physical model, coding grade, Pi profile, tools and key route state',
    handler: async (_args, ctx) => {
      const identity = ctx.model ? `${ctx.model.provider}/${ctx.model.id}` : 'none';
      const lines = [`model: ${identity}`,
        `transport: ${transportName(ctx.model?.api ?? modelMetadata(ctx.model?.id ?? '').api)}`,
        `profile: ${profileRequest} → ${effectiveProfile}`,
        `thinking: ${currentThinking() ?? 'unknown'}`,
        `declared tools: ${pi.getActiveTools().join(', ') || '(none)'}`,
        `MCP: ${mcpDisabledByFlag ? 'disabled for this process by --no-mcp' : 'native Pi policy'}`,
        `extensions: ${extensionsDisabledByFlag ? 'discovery disabled; @sandpi/core explicitly retained' : 'native Pi discovery/configuration'}`];
      if (ctx.model?.provider === 'openrouter') {
        const fingerprint = cfg.modelFingerprints?.[ctx.model.id];
        let route = routeRecord(ctx.model.id);
        try {
          const observed = await rpc({ op: 'route-status', provider: 'openrouter', model: ctx.model.id,
            ...(fingerprint ? { fingerprint } : {}) });
          if (observed?.routes?.[ctx.model.id]) {
            route = observed.routes[ctx.model.id];
            routeHealth.set(ctx.model.id, route);
          }
        } catch { /* key-bank status below remains independently useful */ }
        lines.push(`billing: ${priceText(ctx.model.id)}`,
          'reported charges and cache observations: /sandcost (separate from Pi estimates)',
          `paid chat permission: ${cfg.freeOnly === false ? 'on for this Pi process' : 'off; /sandpaid on to enable'}`,
          `routing ceiling: ${cfg.maxPrice ? JSON.stringify(cfg.maxPrice) + ' USD/M tokens (not a total budget)' : 'provider/key limits; no Sandpi total budget'}`,
          `defaults: ${currentRecipe(ctx.model.id)?.preset ?? 'native/conservative; no active exact-model recipe'}`,
          `grade: ${isPaidModel(ctx.model.id) ? 'not required for paid chat; recipe is not a coding grade' : gradeText(ctx.model.id)}`,
          `catalog capability: ${supportsTools(ctx.model) ? 'tool-capable' : 'text-only'}`,
          `catalog thinking: ${thinkingText(ctx.model.id)}`,
          `catalog lifecycle: ${lifecycleText(ctx.model.id)}`,
          `route health: ${routeText(ctx.model.id)}`,
          `route observations: ${route.observations ?? 0}; successes: ${route.successes ?? 0}; failures: ${route.route_failures ?? 0}; last: ${route.last_outcome ?? 'none'}`,
          `temporarily suppressed models: ${blockedModels.size}`,
          `exact model recovery probe: ${cfg.allowModelCooldownProbe ? 'enabled' : 'not enabled for this launch'}`);
        const state = await rpc({ op: 'pool-status', provider: 'openrouter' });
        lines.push(`keys: ${state.keys.length}; cooldowns: ${Object.keys(state.cooldowns ?? {}).length}`);
        for (const key of state.keys) {
          lines.push(`  ${key.label}: active ${key.active}; free remaining ${key.quota?.remaining ?? 'unknown'}${key.quota?.fresh ? '' : ' (stale/unknown)'}`);
        }
      }
      if (ctx.hasUI) ctx.ui.notify(lines.join('\n'), 'info');
    },
  });

