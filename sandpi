    records = assets(root)
    manifest = ''.join(f'{hashlib.sha256(data).hexdigest()}  {name}\n' for name, data, _ in records).encode()
    payload_id = hashlib.sha256(manifest).hexdigest()[:32]
    output = ['sp_payload() {\n  local dest=$1\n']
    directories = sorted({str(Path(name).parent) for name, _, _ in records} - {'.'})
