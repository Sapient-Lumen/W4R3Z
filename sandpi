def audit_rate_picker_sequence(probe)->list[str]:
    """Native RPC discovery/cancellation only, not provider prices or TUI layout.

    Existing fixture models have equal rates/windows within each billing group;
    this exercises sort dispatch, not proof of unequal-value ordering. Offline
    pure and actual-extension tests separately exercise tiers and sort values.
    """
    def snapshot():
        data=probe.call('get_state').get('data',{})
        required=('model','thinkingLevel','sessionId','messageCount','pendingMessageCount')
        if (any(key not in data for key in required) or data.get('isStreaming') is not False
                or data.get('isCompacting') is not False or data['pendingMessageCount']!=0):
            raise SandpiError('native rate picker state is incomplete or not idle')
        return {key:data[key] for key in required}
    before=snapshot()
    def inspect(command, models, expected):
        start=len(probe.notices);ui_start=len(probe.ui_methods);seen=[]
        def dialog(row):
            if row.get('method')!='select':raise SandpiError('native rate picker opened a non-selection dialog')
            options=row.get('options',[])
            found=[option.split('  [',1)[0] for option in options if isinstance(option,str)]
            if len(found)!=len(models) or set(found)!=set(models):
                raise SandpiError('native rate filters returned the wrong exact models')
            if models and any('highest configured' not in option for option in options):
                raise SandpiError('native rate picker omitted comparison rates')
            seen.append('select')
            return {'cancelled':True}
        probe.dialog_handler=dialog
        try:answer=probe.call('prompt',message=command)
        finally:probe.dialog_handler=None
        if answer.get('data',{}).get('disposition')!='handled':
            raise SandpiError('native rate query was not handled locally')
        if snapshot()!=before:raise SandpiError('native rate query changed native session state')
        if seen!=(['select'] if models else []):raise SandpiError('native rate query omitted or added a dialog')
        notes=probe.notices[start:]
        if len(notes)!=1 or not all(text in notes[0] for text in expected):
            # These notices are produced by the local /sandmodels command from
            # fixed fixture metadata; they contain no prompt, provider response,
            # credential, or native session text. Retaining the bounded command
            # and notice makes a pinned-Pi compatibility failure diagnosable.
            observed=[str(note)[:2048] for note in notes[:2]]
            raise SandpiError(f'native rate query omitted the expected scope or error: '
                              f'command={command!r}; notices={observed!r}')
        if probe.ui_methods[ui_start:]!=['notify',*seen]:
            raise SandpiError('native rate query wrote to other UI state')
    inspect('/sandmodels all --max-input 0 --max-output=0 --sort=input',
        (CHAT_MODEL,MESSAGES_MODEL),('NOT endpoint price limits','highest base'))
    inspect('/sandmodels paid --max-input 3 --max-output 12 --sort context',
        PAID_MODELS,('not available headroom','Paid access and routing preferences are unchanged'))
    inspect('/sandmodels paid --max-output 0',(),('No models match','Rate filters exclude unknown'))
    inspect('/sandmodels paid --sort price',(),('--sort must be default, input, output, context, or newest.',))
    return list(NATIVE_RATE_PICKER_CASES)


