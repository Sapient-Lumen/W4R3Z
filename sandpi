            if len(calls) >= 2:
                refreshed.set()
            return {'schema':'synthetic'}
        with patch('credentials.OPENROUTER_QUOTA_WARM_SECONDS', 0.01), \
             patch.object(self.store.quota, 'stale', return_value=True) as stale, \
             patch.object(self.store.quota, 'refresh', side_effect=refresh):
