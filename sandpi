        if current in seen:raise SandpiError('cycle in Sandpi upstream-pi layout')
        seen.add(current)
        if not current.is_file() or not os.access(current,os.X_OK):
            raise SandpiError('Pi launcher is not an executable file')
        prefix=current.parent.parent
        link=prefix/'upstream-pi'
        module=prefix/'lib/pi/node_modules/@earendil-works/pi-coding-agent/dist/index.js'
        if link.is_symlink():
            if module.exists():raise SandpiError('ambiguous runtime and upstream Pi layout')
            current=(link.resolve(strict=True)/'bin/pi').resolve(strict=True)
            continue
        if link.exists():raise SandpiError('Sandpi upstream-pi must be a declared symlink')
        if not module.is_file():
            raise SandpiError('Pi package lacks the expected Nix module layout; no PATH/latest fallback')
        return current
    raise SandpiError('Sandpi upstream-pi link depth exceeded')


