sessions, guest packages and guest-local Nix state) plus the exact lower Nix
store lease last used by that room.  It never copies the live host workspace,
canonical Sandcodex credentials, launcher logs, checkpoints, host session
observations, active-entry state, or process metadata.

Two Nix payload policies exist:

``manifest``
    Record the exact lower-store path set.  Import asks the target host's normal
    substituters for every non-derivation path, never realizes a ``.drv`` merely
    because it appears in the lease, and proves that the complete exact path set
    exists before publishing the room.

``full``
    Also export that path set as a local Nix binary cache.  Import copies from
    the cache first and still proves the exact set before publishing.

The bundle is a directory rather than a tarball so a sparse guest disk stays
sparse when the destination filesystem supports it and a large Nix cache can be
resumed/copied with ordinary filesystem tools.  Publication is staged beside
its destination and uses Linux renameat2(RENAME_NOREPLACE).
"""
from __future__ import annotations

import contextlib
import os
from pathlib import Path
import re
import shutil
import stat
import tempfile
from typing import Any

from core import (REVISION, SandpiError, atomic_json, atomic_write, canonical,
                  checked_name, file_lock, private_dir, read_json, room_id, sha256,
                  timestamp, under)

BACKUP_SCHEMA = 'sandpi.room-backup.v2'
LEGACY_BACKUP_SCHEMA = 'sandpi.room-backup.v1'
IMPORT_SCHEMA = 'sandpi.room-import.v2'
LINEAGE_SCHEMA = 'sandpi.room-import-lineage.v2'
LEGACY_LINEAGE_SCHEMA = 'sandpi.room-import-lineage.v1'
DIGEST_SCHEMA = 'sandpi.sparse-digest.v1'
MANIFEST_NAME = 'backup.json'
DISK_NAME = 'root.raw'
STORE_PATHS_NAME = 'store-paths'
STORE_CACHE_NAME = 'nix-cache'
MAX_MANIFEST = 1024 * 1024
MAX_CACHE_ENTRIES = 2_000_000
MAX_CACHE_DEPTH = 96
HEX64 = re.compile(r'^[a-f0-9]{64}$')
ROOM_ID = re.compile(r'^[a-f0-9]{24}$')
STORE_MODES = {'manifest', 'full'}


def _sync_dir(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _owned_directory(path: Path, *, label: str, private: bool = False) -> Path:
    try:
        info = path.lstat()
    except FileNotFoundError:
        raise SandpiError(f'{label} does not exist: {path}', 66) from None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise SandpiError(f'{label} must be a user-owned real directory', 78)
    if private and stat.S_IMODE(info.st_mode) & 0o077:
        raise SandpiError(f'{label} permissions must be private', 78)
    return path


def _existing_bundle(path: Path) -> Path:
    raw = path.expanduser()
    try:
        info = raw.lstat()
    except FileNotFoundError:
        raise SandpiError(f'room backup does not exist: {raw}', 66) from None
    if stat.S_ISLNK(info.st_mode):
        raise SandpiError('room backup must be a user-owned real directory', 78)
    return canonical(raw, must_exist=True)


def _owned_regular(path: Path, *, label: str, limit: int | None = None) -> os.stat_result:
    try:
        info = path.lstat()
    except FileNotFoundError:
        raise SandpiError(f'{label} is missing: {path.name}', 66) from None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
        raise SandpiError(f'{label} must be a user-owned single-link regular file', 78)
    if limit is not None and info.st_size > limit:
        raise SandpiError(f'{label} exceeds its fixed size bound', 78)
    return info


def _validate_cache_tree(root: Path, *, sync: bool = False) -> dict[str, int]:
    """Reject links/special files and bound local binary-cache traversal.

    A `file://` Nix cache is trusted as operator-supplied input by Nix.  Sandpi
    therefore proves that every path resolves inside the private bundle rather
    than allowing a transported cache symlink to redirect Nix to host files.
    `sync=True` is used before publication so full-cache bytes, not just their
    directory entries, have crossed the durability boundary.
    """
    _owned_directory(root, label='room backup Nix cache')
    stack: list[tuple[Path, int]] = [(root, 0)]
    directories: list[Path] = []
    files = 0
    entries = 0
    total_bytes = 0
    while stack:
        directory, depth = stack.pop()
        if depth > MAX_CACHE_DEPTH:
            raise SandpiError('room backup Nix cache exceeds the directory-depth bound', 78)
        directories.append(directory)
        try:
            children = list(os.scandir(directory))
        except OSError as error:
            raise SandpiError(f'cannot inspect room backup Nix cache: {error}', 74) from error
        for child in children:
            entries += 1
            if entries > MAX_CACHE_ENTRIES:
                raise SandpiError('room backup Nix cache exceeds the entry-count bound', 78)
            if len(os.fsencode(child.name)) > 255 or child.name in ('.', '..'):
                raise SandpiError('room backup Nix cache contains an invalid path component', 78)
            path = Path(child.path)
            try:
                info = child.stat(follow_symlinks=False)
            except OSError as error:
                raise SandpiError(f'cannot inspect room backup Nix cache entry: {error}', 74) from error
            if info.st_uid != os.geteuid():
                raise SandpiError('room backup Nix cache contains a foreign-owned entry', 78)
            if stat.S_ISDIR(info.st_mode):
                stack.append((path, depth + 1))
            elif stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                files += 1
                total_bytes += info.st_size
                if sync:
                    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
                    try:
                        os.fsync(descriptor)
                    finally:
                        os.close(descriptor)
            else:
                raise SandpiError('room backup Nix cache may contain only real directories and single-link regular files', 78)
    if sync:
        for directory in reversed(directories):
            _sync_dir(directory)
    return {'entries': entries, 'files': files, 'bytes': total_bytes}


def _validate_bundle_entries(bundle: Path, *, store_mode: str) -> None:
    expected = {MANIFEST_NAME, DISK_NAME, STORE_PATHS_NAME}
    if store_mode == 'full':
        expected.add(STORE_CACHE_NAME)
    try:
        actual = {entry.name for entry in os.scandir(bundle)}
    except OSError as error:
        raise SandpiError(f'cannot enumerate room backup: {error}', 74) from error
    if actual != expected:
        raise SandpiError('room backup contains unexpected or missing top-level entries', 78)


def _new_target(destination: Path, *, root: Path | None = None) -> tuple[Path, Path]:
    raw = destination.expanduser()
    if any(character in os.fspath(raw) for character in ('\0', '\n', '\r')):
        raise SandpiError('backup destination paths cannot contain NUL or line breaks', 64)
    if raw.name in ('', '.', '..') or len(raw.name.encode()) > 240:
        raise SandpiError('backup destination needs a normal directory name', 64)
    parent = canonical(raw.parent, must_exist=True)
    _owned_directory(parent, label='backup destination parent')
    target = parent / raw.name
    if target.exists() or target.is_symlink():
        raise SandpiError('backup destination already exists; choose a new directory', 73)
    if root is not None and under(target, canonical(root)):
        raise SandpiError('portable backups must live outside the Sandpi state root', 64)
    return parent, target


def _digest(value: Any) -> dict[str, Any]:
    allowed = {
        'schema', 'sha256', 'logical_bytes', 'allocated_bytes',
        'nonzero_bytes', 'nonzero_chunks', 'scanned_bytes', 'method',
    }
    if not isinstance(value, dict) or set(value) != allowed or value.get('schema') != DIGEST_SCHEMA:
        raise SandpiError('backup disk digest has an invalid schema', 78)
    if not isinstance(value.get('sha256'), str) or not HEX64.fullmatch(value['sha256']):
        raise SandpiError('backup disk digest has an invalid hash', 78)
    for field in ('logical_bytes', 'allocated_bytes', 'nonzero_bytes',
                  'nonzero_chunks', 'scanned_bytes'):
        item = value.get(field)
        if type(item) is not int or item < 0:
            raise SandpiError('backup disk digest has invalid counters', 78)
    if value.get('method') not in {'sparse-extents', 'logical-scan'}:
        raise SandpiError('backup disk digest has an invalid method', 78)
    if value['nonzero_bytes'] > value['logical_bytes'] or value['allocated_bytes'] < 0:
        raise SandpiError('backup disk digest counters are inconsistent', 78)
    return {field: value[field] for field in allowed}


def _profile(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    import machine
    return machine.validate_profile(value)


def _source(value: Any) -> dict[str, Any]:
    allowed = {'room_id', 'name', 'checkpoint', 'namespace_sha256'}
    if not isinstance(value, dict) or set(value) != allowed:
        raise SandpiError('backup source identity has an invalid schema', 78)
    if not isinstance(value.get('room_id'), str) or not ROOM_ID.fullmatch(value['room_id']):
        raise SandpiError('backup source has an invalid room ID', 78)
    if not isinstance(value.get('name'), str):
        raise SandpiError('backup source has an invalid room name', 78)
    checked_name(value['name'])
    checkpoint = value.get('checkpoint')
    if checkpoint is not None:
        if not isinstance(checkpoint, str):
            raise SandpiError('backup source has an invalid checkpoint', 78)
        checked_name(checkpoint)
    if not isinstance(value.get('namespace_sha256'), str) or not HEX64.fullmatch(value['namespace_sha256']):
        raise SandpiError('backup source has an invalid namespace digest', 78)
    return dict(value)


def _copy_info(value: Any) -> dict[str, Any]:
    allowed = {'method', 'logical_bytes', 'allocated_bytes', 'copied_bytes', 'source_mtime_ns'}
    if not isinstance(value, dict) or set(value) != allowed:
        raise SandpiError('backup disk copy receipt has an invalid schema', 78)
    if value.get('method') not in {'reflink', 'sparse-extents', 'zero-scan'}:
        raise SandpiError('backup disk copy receipt has an invalid method', 78)
    for field in ('logical_bytes', 'allocated_bytes', 'copied_bytes', 'source_mtime_ns'):
        item = value.get(field)
        if type(item) is not int or item < 0:
            raise SandpiError('backup disk copy receipt has invalid counters', 78)
    return dict(value)


def _nix(value: Any) -> dict[str, Any]:
    allowed = {
        'store_mode', 'path_count', 'paths_sha256', 'lease_mode',
        'lease_source', 'cache_included', 'scope',
    }
    if not isinstance(value, dict) or set(value) != allowed:
        raise SandpiError('backup Nix metadata has an invalid schema', 78)
    if value.get('store_mode') not in STORE_MODES:
        raise SandpiError('backup Nix metadata has an invalid payload mode', 78)
    if type(value.get('path_count')) is not int or value['path_count'] <= 0:
        raise SandpiError('backup Nix metadata has an invalid path count', 78)
    if not isinstance(value.get('paths_sha256'), str) or not HEX64.fullmatch(value['paths_sha256']):
        raise SandpiError('backup Nix metadata has an invalid path digest', 78)
    if value.get('lease_mode') not in {'host', 'base'}:
        raise SandpiError('backup Nix metadata has an invalid room lease mode', 78)
    if value.get('lease_source') not in {'room-snapshot', 'global-fallback'}:
        raise SandpiError('backup Nix metadata has an invalid lease source', 78)
    if type(value.get('cache_included')) is not bool or value['cache_included'] != (value['store_mode'] == 'full'):
        raise SandpiError('backup Nix metadata has inconsistent cache policy', 78)
    if value.get('scope') != 'exact-cumulative-lower-view-last-used-by-source-room':
        raise SandpiError('backup Nix metadata has an invalid scope', 78)
    return dict(value)


def _scope(value: Any) -> dict[str, bool]:
    fields = {
        'native_pi_state', 'guest_packages', 'guest_local_nix_state',
        'host_workspace', 'canonical_credentials', 'launcher_logs',
        'checkpoints', 'host_session_observations', 'active_entries',
    }
    if not isinstance(value, dict) or set(value) != fields or any(type(value[field]) is not bool for field in fields):
        raise SandpiError('backup scope metadata has an invalid schema', 78)
    required_true = {'native_pi_state', 'guest_packages', 'guest_local_nix_state'}
    if any(value[field] is not True for field in required_true) or \
            any(value[field] is not False for field in fields - required_true):
        raise SandpiError('backup scope metadata contradicts the portable-room contract', 78)
    return dict(value)


def _portability(value: Any, *, store_mode: str) -> dict[str, Any]:
    allowed = {'self_contained_store_closure', 'requires_target_substituters', 'format'}
    if not isinstance(value, dict) or set(value) != allowed:
        raise SandpiError('backup portability metadata has an invalid schema', 78)
    full = store_mode == 'full'
    if value.get('self_contained_store_closure') is not full or \
            value.get('requires_target_substituters') is not (not full) or \
            value.get('format') != 'directory-with-sparse-disk':
        raise SandpiError('backup portability metadata contradicts its payload mode', 78)
    return dict(value)


def _runtime_contract(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    import upgrades
    return upgrades.validate_contract(value)


def validate_manifest(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise SandpiError('room backup manifest has an invalid schema', 78)
    schema = value.get('schema')
    legacy_fields = {
        'schema', 'created_at', 'created_revision', 'source', 'disk', 'nix',
        'machine_profile', 'scope', 'portability',
    }
    current_fields = legacy_fields | {'runtime_contract', 'runtime_upgrade_slot_included'}
    expected = legacy_fields if schema == LEGACY_BACKUP_SCHEMA else current_fields
    if schema not in {LEGACY_BACKUP_SCHEMA, BACKUP_SCHEMA} or set(value) != expected:
        raise SandpiError('room backup manifest has an invalid schema', 78)
    if not isinstance(value.get('created_at'), str) or not value['created_at'] or len(value['created_at']) > 96:
        raise SandpiError('room backup manifest has an invalid timestamp', 78)
    if type(value.get('created_revision')) is not int or value['created_revision'] < 1:
        raise SandpiError('room backup manifest has an invalid Sandpi revision', 78)
    disk = value.get('disk')
    if not isinstance(disk, dict) or set(disk) != {'filename', 'copy', 'digest'} or disk.get('filename') != DISK_NAME:
        raise SandpiError('room backup manifest has invalid disk metadata', 78)
    nix = _nix(value.get('nix'))
    runtime = None
    slot_included = False
    if schema == BACKUP_SCHEMA:
        runtime = _runtime_contract(value.get('runtime_contract'))
        if value.get('runtime_upgrade_slot_included') is not False:
            raise SandpiError('portable room backups never include runtime-upgrade rollback slots', 78)
    clean = {
        'schema': schema,
        'created_at': value['created_at'],
        'created_revision': value['created_revision'],
        'source': _source(value.get('source')),
        'disk': {'filename': DISK_NAME, 'copy': _copy_info(disk.get('copy')),
                 'digest': _digest(disk.get('digest'))},
        'nix': nix,
        'machine_profile': _profile(value.get('machine_profile')),
        'scope': _scope(value.get('scope')),
        'portability': _portability(value.get('portability'), store_mode=nix['store_mode']),
        'runtime_contract': runtime,
        'runtime_upgrade_slot_included': slot_included,
    }
    if clean['disk']['copy']['logical_bytes'] != clean['disk']['digest']['logical_bytes']:
        raise SandpiError('backup disk copy and digest capacities differ', 78)
    return clean


def _read_manifest(bundle: Path) -> tuple[dict[str, Any], bytes]:
    _owned_directory(bundle, label='room backup', private=True)
    path = bundle / MANIFEST_NAME
    _owned_regular(path, label='room backup manifest', limit=MAX_MANIFEST)
    raw = path.read_bytes()
    try:
        value = __import__('json').loads(raw)
    except (ValueError, UnicodeError):
        raise SandpiError('room backup manifest is invalid JSON', 65) from None
    return validate_manifest(value), raw


def inspect(source: Path, *, verify: bool = False) -> dict[str, Any]:
    """Validate a backup without importing it.

    The default check is metadata-only and cheap. ``verify`` streams the sparse
    disk's logical content through the extent-independent digest.
    """
    import checkpoints
    import nixhost

    bundle = _existing_bundle(source)
    manifest, raw = _read_manifest(bundle)
    _validate_bundle_entries(bundle, store_mode=manifest['nix']['store_mode'])
    disk = bundle / DISK_NAME
    disk_info = checkpoints.regular(disk, readonly=True)
    declared = manifest['disk']['digest']
    if disk_info.st_size != declared['logical_bytes']:
        raise SandpiError('room backup disk capacity does not match its manifest', 78)
    paths = nixhost.read_store_paths(bundle / STORE_PATHS_NAME)
    path_bytes = nixhost.store_paths_text(paths)
    if len(paths) != manifest['nix']['path_count'] or sha256(path_bytes) != manifest['nix']['paths_sha256']:
        raise SandpiError('room backup Nix path set does not match its manifest', 78)
    cache = bundle / STORE_CACHE_NAME
    if manifest['nix']['store_mode'] == 'full':
        _validate_cache_tree(cache)
    elif cache.exists() or cache.is_symlink():
        raise SandpiError('manifest-only backup unexpectedly contains a Nix cache directory', 78)
    verification = {'requested': verify, 'verified': False}
    if verify:
        actual = checkpoints.sparse_digest(disk)
        if actual['sha256'] != declared['sha256'] or actual['logical_bytes'] != declared['logical_bytes']:
            raise SandpiError('room backup disk digest does not match its manifest', 74)
        verification = {'requested': True, 'verified': True, 'digest': actual}
    return {
        'schema': 'sandpi.room-backup-inspection.v1',
        'path': str(bundle),
        'manifest_sha256': sha256(raw),
        'manifest': manifest,
        'disk': {'logical_bytes': disk_info.st_size,
                 'allocated_bytes': disk_info.st_blocks * 512},
        'nix': {'path_count': len(paths), 'store_mode': manifest['nix']['store_mode'],
                'cache_included': manifest['nix']['cache_included']},
        'verification': verification,
    }


def create(root: Path, project: Path, namespace: str, *, source_name: str,
           destination: Path, checkpoint: str | None = None,
           store_mode: str = 'manifest') -> dict[str, Any]:
    """Publish a portable stopped-room backup directory."""
    import checkpoints
    import lifecycle
    import machine
    import nixhost
    import rooms
    import upgrades

    if store_mode not in STORE_MODES:
        raise SandpiError('backup store mode must be manifest or full', 64)
    root = private_dir(canonical(root))
    project = canonical(project, must_exist=True)
    source_name = checked_name(source_name)
    checkpoint = checked_name(checkpoint) if checkpoint is not None else None
    source_room = rooms.room_path(root, namespace, source_name)
    parent, target = _new_target(destination, root=root)
    if under(target, source_room):
        raise SandpiError('backup destination cannot be inside its source room', 64)

    with lifecycle.stopped_room(root, source_room, require_disk=True):
        upgrades.assert_backup_allowed(source_room)
        source_meta = rooms._source_metadata(source_room, expected_name=source_name,
                                             namespace=namespace, project=project)
        disk_source = source_room / DISK_NAME
        checkpoint_meta = None
        if checkpoint is not None:
            checkpoint_dir, checkpoint_meta = checkpoints.checkpoint_manifest(source_room, checkpoint)
            disk_source = checkpoint_dir / DISK_NAME
        staging = Path(tempfile.mkdtemp(prefix=f'.{target.name}.sandpi-backup-', dir=parent))
        os.chmod(staging, 0o700)
        published = False
        try:
            copied = checkpoints.sparse_copy(disk_source, staging / DISK_NAME)
            digest = checkpoints.sparse_digest(staging / DISK_NAME)
            lease = nixhost.room_lease(root, source_room)
            path_bytes = nixhost.store_paths_text(lease['paths'])
            atomic_write(staging / STORE_PATHS_NAME, path_bytes)
            if store_mode == 'full':
                nixhost.export_binary_cache(lease['paths'], staging / STORE_CACHE_NAME)
                _validate_cache_tree(staging / STORE_CACHE_NAME, sync=True)
            # Older checkpoints may predate the machine-profile field.  In
            # that case the checkpoint still names a disk snapshot, while the
            # room's current machine envelope remains the best bounded default
            # for an optional import.  A checkpoint-local profile, when present,
            # takes precedence because it describes that disk generation.
            profile_holder: dict[str, Any] = source_meta
            runtime_holder: dict[str, Any] = source_meta
            if isinstance(checkpoint_meta, dict):
                checkpoint_room = checkpoint_meta.get('room')
                if isinstance(checkpoint_room, dict):
                    if checkpoint_room.get('machine_profile') is not None:
                        profile_holder = checkpoint_room
                    if checkpoint_room.get('runtime_contract') is not None:
                        runtime_holder = checkpoint_room
            profile = _profile(profile_holder.get('machine_profile'))
            runtime = _runtime_contract(runtime_holder.get('runtime_contract'))
            at = timestamp()
            manifest = {
                'schema': BACKUP_SCHEMA,
                'created_at': at,
                'created_revision': REVISION,
                'source': {
                    'room_id': source_room.name,
                    'name': source_name,
                    'checkpoint': checkpoint,
                    'namespace_sha256': sha256(namespace.encode()),
                },
                'disk': {'filename': DISK_NAME, 'copy': copied, 'digest': digest},
                'nix': {
                    'store_mode': store_mode,
                    'path_count': len(lease['paths']),
                    'paths_sha256': sha256(path_bytes),
                    'lease_mode': lease['mode'],
                    'lease_source': lease['source'],
                    'cache_included': store_mode == 'full',
                    'scope': 'exact-cumulative-lower-view-last-used-by-source-room',
                },
                'machine_profile': profile,
                'runtime_contract': runtime,
                'runtime_upgrade_slot_included': False,
                'scope': {
                    'native_pi_state': True,
                    'guest_packages': True,
                    'guest_local_nix_state': True,
                    'host_workspace': False,
                    'canonical_credentials': False,
                    'launcher_logs': False,
                    'checkpoints': False,
                    'host_session_observations': False,
                    'active_entries': False,
                },
                'portability': {
                    'self_contained_store_closure': store_mode == 'full',
                    'requires_target_substituters': store_mode == 'manifest',
                    'format': 'directory-with-sparse-disk',
                },
            }
            clean = validate_manifest(manifest)
            atomic_json(staging / MANIFEST_NAME, clean)
            _sync_dir(staging)
            rooms._rename_noreplace(staging, target)
            published = True
            _sync_dir(parent)
            return {
                'schema': 'sandpi.room-backup-created.v1',
                'path': str(target),
                'manifest_sha256': sha256((target / MANIFEST_NAME).read_bytes()),
                'manifest_schema': clean['schema'],
                'runtime_contract_preserved': clean['runtime_contract'] is not None,
                'runtime_upgrade_slot_included': clean['runtime_upgrade_slot_included'],
                'source': clean['source'],
                'disk': clean['disk'],
                'nix': clean['nix'],
                'scope': clean['scope'],
            }
        finally:
            if not published and staging.exists():
                with contextlib.suppress(BaseException):
                    shutil.rmtree(staging)
                    _sync_dir(parent)


def _import_profile(manifest: dict[str, Any], *, disk_bytes: int,
                    keep: bool, at: str) -> dict[str, Any] | None:
    if not keep or manifest.get('machine_profile') is None:
        return None
    import machine
    profile = machine.validate_profile(manifest['machine_profile'])
    profile.update({
        'disk_bytes': disk_bytes,
        'publish': [],
        'publish_udp': [],
        'saved_at': at,
        'saved_revision': REVISION,
    })
    return machine.validate_profile(profile)


def validate_lineage(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise SandpiError('room import lineage has an invalid schema', 78)
    schema = value.get('schema')
    legacy_allowed = {
        'schema', 'backup_manifest_sha256', 'source_room_id', 'source_name',
        'source_checkpoint', 'imported_at', 'imported_revision', 'store_mode',
        'disk_sha256', 'machine_profile_copied', 'port_forwards_cleared',
    }
    current_allowed = legacy_allowed | {'backup_schema', 'runtime_contract_copied'}
    expected = legacy_allowed if schema == LEGACY_LINEAGE_SCHEMA else current_allowed
    if schema not in {LEGACY_LINEAGE_SCHEMA, LINEAGE_SCHEMA} or set(value) != expected:
        raise SandpiError('room import lineage has an invalid schema', 78)
    for field in ('backup_manifest_sha256', 'disk_sha256'):
        if not isinstance(value.get(field), str) or not HEX64.fullmatch(value[field]):
            raise SandpiError('room import lineage has an invalid digest', 78)
    if not isinstance(value.get('source_room_id'), str) or not ROOM_ID.fullmatch(value['source_room_id']):
        raise SandpiError('room import lineage has an invalid source room', 78)
    if not isinstance(value.get('source_name'), str):
        raise SandpiError('room import lineage has an invalid source name', 78)
    checked_name(value['source_name'])
    checkpoint = value.get('source_checkpoint')
    if checkpoint is not None:
        if not isinstance(checkpoint, str):
