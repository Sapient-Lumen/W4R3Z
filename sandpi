def store_memory_resources(resources: dict[str, Any], path_count: int) -> dict[str, Any]:
    """Reserve host-side memory for a large virtiofs/Nix registration graph."""
    if type(path_count) is not int or path_count < 0:
        raise SandpiError('Nix store lease path count is invalid', 78)
    result = dict(resources)
    quantum = 128 * MIB
    needed = max(result['overhead'], 768 * MIB + path_count * 8192)
    overhead = ((needed + quantum - 1) // quantum) * quantum
    guest = ((result['memory_budget'] - overhead) // quantum) * quantum
    if guest < 768 * MIB:
        raise SandpiError(
            'room memory is too small for this host Nix-store lease; increase --memory', 75)
    result['guest_memory'] = guest
    result['overhead'] = result['memory_budget'] - guest
    return result


def passt_command(runtime: Path, publish: list[str], udp: list[str]) -> list[str]:
    command = ['passt', '--foreground', '--vhost-user', '--socket', str(runtime / 'net.sock')]
    for mapping in publish:
        command += ['--tcp-ports', mapping]
    for mapping in udp:
        command += ['--udp-ports', mapping]
    return command


def ch_command(config: dict[str, Any], runtime: Path, bundle: Path, logs: Path) -> list[str]:
    r = config['resources']
    room = config['room_id']
    mac = '02:' + ':'.join(room[i:i + 2] for i in range(0, 10, 2))
    # CH's key=value option parser does not escape embedded commas.
    for path in (runtime, bundle, logs, Path(config['disk_path'])):
        if ',' in str(path):
            raise SandpiError('Cloud Hypervisor state paths cannot contain commas; choose another SANDPI_HOME', 64)
    toplevel = str((bundle / 'toplevel').resolve())
    serial = 'ttyAMA0' if platform.machine() == 'aarch64' else 'ttyS0'
    return ['cloud-hypervisor', '--cpus', f'boot={r["cpus"]}',
            '--memory', f'size={r["guest_memory"] // MIB}M,shared=on',
            '--kernel', str(bundle / 'kernel'), '--initramfs', str(bundle / 'initrd'),
            # A new room disk has no pre-created /nix hierarchy. The systemd
            # initrd must mount it writable so it can create the virtiofs and
            # overlay mountpoints before resolving the NixOS closure.
            # Serial remains available for warnings and failures, but printing
            # every successful kernel/systemd transition materially delays a
            # tiny direct-boot VM. `auto` restores status output on failure.
            '--cmdline', (f'init={toplevel}/init root=/dev/vda rw console={serial},115200n8 '
                          'panic=1 quiet loglevel=3 systemd.show_status=auto '
                          'rd.systemd.show_status=auto'),
            # Cloud Hypervisor 53 makes autodetected raw media sector zero
            # read-only. ext4/fsck legitimately updates that sector, so bind
            # the persistent disk's format explicitly.
            '--disk', f'path={config["disk_path"]},direct=off,image_type=raw',
            '--fs', f'tag=store,socket={runtime}/store.sock',
            f'tag=workspace,socket={runtime}/workspace.sock', f'tag=seed,socket={runtime}/seed.sock',
            '--net', f'mac={mac},vhost_user=true,socket={runtime}/net.sock,vhost_mode=client,num_queues=2',
            '--vsock', f'cid={3 + int(room[:6], 16)},socket={runtime}/v.sock',
            '--api-socket', str(runtime / 'api.sock'),
            '--serial', f'file={logs}/serial.log', '--console', 'off']


def ssh_command(source: Path, runtime: Path, key: Path, command: str,
                *, tty: bool = False) -> list[str]:
    # OpenSSH parses ProxyCommand through a shell; quote EVERY generated word and
    # escape its %-expansion. No user-provided shell fragment enters this command.
    proxy = shlex.join([sys.executable, str(source / 'src/transport.py'),
                       str(runtime / 'v.sock'), str(SSH_PORT)]).replace('%', '%%')
    args = ['ssh', '-F', '/dev/null', '-i', str(key), '-o', 'IdentitiesOnly=yes',
            '-o', 'StrictHostKeyChecking=no', '-o', 'UserKnownHostsFile=/dev/null',
            '-o', 'GlobalKnownHostsFile=/dev/null', '-o', 'LogLevel=ERROR',
            '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', '-o', 'ConnectionAttempts=1',
            '-o', 'ServerAliveInterval=5', '-o', 'ServerAliveCountMax=3',
            '-o', 'ProxyCommand=' + proxy]
    args += ['-tt'] if tty else ['-T']
    # OpenSSH does not forward arbitrary environment by default. Set only these
    # native enum values in this entry's shell, after login startup. Never use
    # wildcard SendEnv/AcceptEnv or store a terminal's choices on the room disk.
    preferences = terminal_preferences() if tty else {}
    if preferences:
        command = 'export ' + shlex.join([f'{key}={value}' for key, value in preferences.items()]) + '; ' + command
    remote = 'exec /run/current-system/sw/bin/bash -lc ' + shlex.quote(command)
    args += ['root@sandpi', remote]
    return args


class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path: Path, timeout: float = 3):
        super().__init__('localhost', timeout=timeout)
        self.path = path

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(str(self.path))


def api(runtime: Path, endpoint: str, method: str = 'GET') -> dict[str, Any] | None:
    conn = UnixHTTP(runtime / 'api.sock')
    try:
        conn.request(method, '/api/v1/' + endpoint, body=b'' if method == 'PUT' else None)
        response = conn.getresponse()
        body = response.read(1024 * 1024)
        if not 200 <= response.status < 300:
            raise SandpiError(f'Cloud Hypervisor management returned HTTP {response.status}', 70)
        return json.loads(body) if body else None
    finally:
        conn.close()


class Children:
    def __init__(self, env: dict[str, str], logs: Path, events: EventLog):
        self.env, self.logs, self.events = env, logs, events
        self.items: list[tuple[str, subprocess.Popen]] = []

    def start(self, name: str, command: list[str]) -> subprocess.Popen:
        out = (self.logs / (name + '.log')).open('ab', buffering=0)
        try:
            child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=out,
                                     stderr=subprocess.STDOUT, env=self.env, start_new_session=True)
        finally:
            out.close()
        self.items.append((name, child))
        self.events.emit('child_started', role=name, pid=child.pid)
        return child

    def check(self) -> None:
        for name, child in self.items:
            if child.poll() is not None:
                raise SandpiError(f'{name} exited with status {child.returncode}; see {self.logs / (name + ".log")}', 70)

    def stop(self) -> None:
        # Stop CH before its storage/network backends, then reap everything.
        for name, child in reversed(self.items):
            if child.poll() is None:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(child.pid, signal.SIGTERM)
        deadline = time.monotonic() + 5
        for _, child in reversed(self.items):
            try:
                child.wait(timeout=max(0.05, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(child.pid, signal.SIGKILL)
                child.wait()


def wait_socket(path: Path, children: Children, stop: threading.Event, timeout: float = 20) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        children.check()
        if stop.is_set():
            raise SandpiError('launch interrupted', 130)
        if path.exists():
            return
        time.sleep(0.05)
    raise SandpiError(f'timed out waiting for {path.name}; see backend logs', 124)


def wait_guest_ssh(runtime: Path, source: Path, key: Path, room_id: str,
                   children: Children, stop: threading.Event, *, timeout: float,
                   env: dict[str, str], owner_alive: Any,
                   serial_log: Path | None = None) -> None:
    """Wait for the guest SSH service without one long speculative SSH call.

    The Cloud Hypervisor vsock control socket exists before the guest listener.
    Starting OpenSSH immediately made its ProxyCommand consume the entire
    transport timeout even when sshd became ready meanwhile.  Short, disposable
    vsock connection attempts make readiness follow the guest instead of that
    timeout; one authenticated command remains the actual commit criterion.
    """
    deadline = time.monotonic() + timeout
    deadline_error = ('guest boot deadline reached' +
                      (f'; see {serial_log}' if serial_log is not None else ''))
    command = 'test "$(cat /etc/sandpi-room)" = ' + shlex.quote(room_id)
    while True:
        children.check()
        if stop.is_set() or not owner_alive():
            raise SandpiError('launch owner exited or stop requested', 130)
        try:
            with connect_guest(runtime / 'v.sock', SSH_PORT, timeout=0.25) as peer:
                # Cloud Hypervisor acknowledges a routed connection before a
                # guest listener necessarily produces bytes.  The SSH banner,
                # not merely CH's `OK`, proves sshd is accepting connections.
                peer.settimeout(0.25)
                if not recv_line(peer, 256).startswith(b'SSH-'):
                    raise SandpiError('guest SSH listener returned an invalid banner', 74)
        except (OSError, SandpiError):
            if time.monotonic() >= deadline:
                raise SandpiError(deadline_error, 124)
            time.sleep(0.1)
            continue
        try:
            probe = run(ssh_command(source, runtime, key, command), capture=True,
                        check=False, timeout=10, env=env, stdin=subprocess.DEVNULL)
        except SandpiError as exc:
            if exc.code != 124:
                raise
            probe = None
        if probe is not None and probe.returncode == 0:
            return
        if time.monotonic() >= deadline:
            raise SandpiError(deadline_error, 124)
        time.sleep(0.1)


def graceful_shutdown(runtime: Path, vmm: subprocess.Popen, events: EventLog, timeout: float = 20) -> None:
    if vmm.poll() is not None:
        return
    events.emit('power_button_requested')
    try:
        api(runtime, 'vm.power-button', 'PUT')
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and vmm.poll() is None:
            time.sleep(0.25)
            try:
                info = api(runtime, 'vm.info')
                if info and info.get('state', '').lower() == 'shutdown':
                    break
            except (OSError, SandpiError, ValueError):
                if vmm.poll() is not None:
                    break
        if vmm.poll() is None:
            api(runtime, 'vmm.shutdown', 'PUT')
        events.emit('shutdown_requested')
    except (OSError, SandpiError, ValueError, http.client.HTTPException):
        events.emit('shutdown_fallback', reason='management channel unavailable')


