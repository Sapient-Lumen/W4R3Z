    def test_inherited_writer_does_not_delay_finished_unittest_module(self):
        # Other offline modules enumerate immutable package assets concurrently.
        # Never create/delete a fixture in the shared source tree while they read.
        fixture=self.base/'tests/_sandpi_inherited_writer_fixture.py'
        fixture.parent.mkdir()
        pidfile=self.base/'child.pid'
        fixture.write_text('''import os,subprocess,sys,unittest\nfrom pathlib import Path\nclass InheritedWriterFixture(unittest.TestCase):\n def test_parent_exits_before_child(self):\n  child=subprocess.Popen([sys.executable,"-c","import time;time.sleep(30)"])\n  Path(os.environ["SANDPI_INHERITED_WRITER_PID"]).write_text(str(child.pid))\n''')
        old=os.environ.get('SANDPI_INHERITED_WRITER_PID')
        os.environ['SANDPI_INHERITED_WRITER_PID']=str(pidfile)
        started=time.monotonic()
        try:
            with patch.object(runner, 'ROOT', self.base):
                result=runner.run_one(fixture,10)
        finally:
            if old is None:os.environ.pop('SANDPI_INHERITED_WRITER_PID',None)
            else:os.environ['SANDPI_INHERITED_WRITER_PID']=old
            fixture.unlink(missing_ok=True)
        elapsed=time.monotonic()-started
        try:
            if pidfile.exists():os.kill(int(pidfile.read_text()),signal.SIGKILL)
        except (ProcessLookupError,ValueError):pass
        self.assertEqual(fixture.parent, self.base/'tests')
        self.assertEqual(runner.ROOT, ROOT)
        self.assertEqual(result.returncode,0,result.output)
        self.assertFalse(result.timed_out)
        self.assertLess(elapsed,5,'runner waited for descendant-owned stdout EOF')
