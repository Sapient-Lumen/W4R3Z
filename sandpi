def audit_picker_sequence(probe)->list[str]:
    """Drive actual native select/confirm dialogs without an inference prompt.

    The offline stand-in tests only this driver's assertions and RPC wiring. They
    are not evidence that the installed Pi extension or UI executed successfully.
    """
    checks=[]
    def slash(message):
        answer=probe.call('prompt',message=message)
        if answer.get('data',{}).get('disposition')!='handled':
            raise SandpiError('model picker command was not handled locally')
    def state(model,api):
        value=probe.call('get_state').get('data',{})
        if value.get('model',{}).get('id')!=model or value.get('model',{}).get('api')!=api:
            raise SandpiError('model picker did not preserve the exact native model/transport')
        if value.get('isStreaming') or value.get('isCompacting'):
            raise SandpiError('model picker unexpectedly started inference or compaction')
    def choose(query,ident,confirmed,*,cancel_selection=False):
        seen=[]
        def dialog(row):
            method=row.get('method');seen.append(method)
            if method=='select':
                options=row.get('options',[])
                if len(options)!=1 or not isinstance(options[0],str) or not options[0].startswith(ident+'  ['):
                    raise SandpiError('native model picker search did not find one exact fixture')
                return {'cancelled':True} if cancel_selection else {'value':options[0]}
            if method=='confirm':
                message=row.get('message','')
                if 'Selected: openrouter/'+ident not in message or 'No compaction' not in message:
                    raise SandpiError('native model preview omitted exact identity or no-compaction disclosure')
                if ident in PAID_MODELS and ('paid access OFF' not in message or 'does NOT enable payment' not in message):
                    raise SandpiError('native paid preview omitted disabled payment policy')
                return {'confirmed':confirmed}
            raise SandpiError('unexpected dialog method in model picker fixture')
        probe.dialog_handler=dialog
        try:slash('/sandmodels '+query)
        finally:probe.dialog_handler=None
        expected=['select'] if cancel_selection else ['select','confirm']
        if seen!=expected:raise SandpiError('native model picker did not execute the required dialog sequence')
    slash('/sandpaid off');state(PAID_CHAT_MODEL,'openai-completions')
    checks.append('native-picker-explicit-paid-off')
    choose('paid '+PAID_MESSAGES_MODEL+' --tools',PAID_MESSAGES_MODEL,False)
    state(PAID_CHAT_MODEL,'openai-completions');checks.append('native-picker-cancel-preserves-model')
    choose('paid '+PAID_MESSAGES_MODEL+' --tools',PAID_MESSAGES_MODEL,True)
    state(PAID_MESSAGES_MODEL,'anthropic-messages');checks.append('native-picker-exact-messages-switch')
    choose('free '+CHAT_MODEL+' --tools',CHAT_MODEL,True)
    state(CHAT_MODEL,'openai-completions');checks.append('native-picker-exact-free-chat-switch')
    choose('paid '+PAID_CHAT_MODEL,PAID_CHAT_MODEL,True,cancel_selection=True)
    state(CHAT_MODEL,'openai-completions');checks.append('native-picker-escape-preserves-model')
    slash('/sandmodels paid fixture-no-such-model');state(CHAT_MODEL,'openai-completions')
    checks.append('native-picker-empty-search-no-substitution')
    slash('/sandmodels --help');state(CHAT_MODEL,'openai-completions')
    checks.append('native-picker-help-no-inference')
    return checks



