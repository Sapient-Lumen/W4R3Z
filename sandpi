    'prompt', 'completion', 'request', 'image', 'web_search',
    'internal_reasoning', 'input_cache_read', 'input_cache_write',
)


def arch_is_router(row: dict) -> bool:
    arch = row.get('architecture')
    return isinstance(arch, dict) and arch.get('tokenizer') == 'Router'


def priced_price(price: Any) -> bool:
    """Accept known nonnegative price metadata, including scheduled/tiered rates.

    This admits a catalog entry; it never claims these are the serving endpoint's
    final charges. The gateway's max_price control is independent.
    """
    if not isinstance(price, dict) or len(price) > 64:
        return False
    def amount(value: Any) -> bool:
        if isinstance(value, bool) or not isinstance(value, (str, int, float)):
            return False
        try:
            n = Decimal(str(value))
            return n.is_finite() and 0 <= n <= 1000000
        except InvalidOperation:
            return False
    if not amount(price.get('prompt')) or not amount(price.get('completion')):
        return False
    for key, value in price.items():
        if key != 'overrides':
            if not amount(value):
                return False
            continue
        if not isinstance(value, list) or len(value) > 128:
            return False
        for row in value:
            if not isinstance(row, dict) or len(row) > 64:
                return False
            for name, item in row.items():
                if name == 'utc_days':
                    if not isinstance(item, list) or len(item) > 7 or any(day not in
                            ('monday','tuesday','wednesday','thursday','friday','saturday','sunday') for day in item):
                        return False
                elif not amount(item):
                    return False
    return True


def _per_million(value: Any) -> float:
    """Convert one already-validated USD/token rate into Pi's USD/M units."""
    return float(Decimal(str(value)) * 1000000)


def _prompt_tier_threshold(value: Any) -> int | None:
    """Return an exact bounded prompt-token threshold, never a rounded guess."""
    if isinstance(value, bool) or not isinstance(value, (str, int, float)):
        return None
    try:
        number = Decimal(str(value))
    except InvalidOperation:
        return None
    if not number.is_finite() or number != number.to_integral_value() or not 0 <= number <= 100_000_000:
        return None
    return int(number)


def price_estimate(price: dict) -> dict[str, Any]:
    """Build Pi 1.1 cost metadata in USD/M, including expressible prompt tiers.

    OpenRouter also publishes scheduled/time-of-day overrides. Pi's ModelCost
    cannot represent those, so they remain in Sandpi's raw catalog evidence and
    are intentionally absent from the estimate. Reported provider charges remain
    authoritative in `/sandcost` when the response supplies them.
    """
    if not priced_price(price):
        raise SandpiError('invalid OpenRouter price metadata', 78)
    source = {'input': 'prompt', 'output': 'completion',
              'cacheRead': 'input_cache_read', 'cacheWrite': 'input_cache_write'}
    # An unknown cache rate is not a free cache. Retain Sandpi's conservative
    # estimate by falling back to the input rate; explicit rates always win.
    base = {name: _per_million(price.get(field, price['prompt']))
            for name, field in source.items()}
    tiers: list[dict[str, Any]] = []
    for override in price.get('overrides', []):
        if not isinstance(override, dict):
            continue
        threshold = _prompt_tier_threshold(override.get('min_prompt_tokens'))
        if threshold is None or any(name in override for name in ('utc_start', 'utc_end', 'utc_days')):
            continue
        tier = {'inputTokensAbove': threshold}
        tier.update({name: _per_million(override.get(field, price.get(field, price['prompt'])))
                     for name, field in source.items()})
        tiers.append(tier)
    return {**base, **({'tiers': tiers} if tiers else {})}


def free_view(snapshot: dict) -> dict:
    models = [m for m in snapshot.get('models', []) if free_price(m.get('pricing'))]
    # A predecessor link is specific to the catalog being published. A full
    # snapshot's predecessor fingerprint cannot be reused for its projected free
    # view; load_all attaches the correct free predecessor after projection.
    base = {key: value for key, value in snapshot.items() if key != PREVIOUS_SNAPSHOT_FINGERPRINT}
    return {**base, 'schema': SCHEMA, 'models': models, 'fingerprint': digest(models)}


def fetch_all() -> dict:
    request = urllib.request.Request(URL, headers={'Accept': 'application/json', 'User-Agent': f'sandpi/{VERSION}'})
    try:
        with urllib.request.urlopen(request, timeout=12) as response:
            raw = response.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raise SandpiError('OpenRouter model catalog exceeds the size limit', 78)
        return normalize(json.loads(raw), include_paid=True)
    except (OSError, ValueError, urllib.error.URLError):
        raise SandpiError('OpenRouter paid catalog refresh failed; run sandpi models --paid --refresh', 69) from None


def cached_all(root: Path) -> dict | None:
    return _cached_all_path(root / FULL_CACHE)


def cached_all_previous(root: Path) -> dict | None:
    """Return the immediately preceding successful normalized full snapshot."""
    return _cached_all_path(root / FULL_PREVIOUS_CACHE)


def _cached_all_path(path: Path) -> dict | None:
    if not path.exists():
        return None
    if path.stat().st_size > MAX_BYTES:
        raise SandpiError('cached OpenRouter full catalog exceeds size limit', 78)
    value = read_json(path)
    if not isinstance(value, dict) or value.get('schema') != FULL_SCHEMA or not isinstance(value.get('models'), list) or len(value['models']) > 50000:
        raise SandpiError('invalid cached OpenRouter full catalog', 78)
    if type(value.get('fetched_at')) not in (int, float) or not math.isfinite(value['fetched_at']):
        raise SandpiError('invalid OpenRouter full catalog timestamp', 78)
    _validate_previous_link(value)
    if digest(value['models']) != value.get('fingerprint'):
        raise SandpiError('cached OpenRouter full catalog digest mismatch', 78)
    seen = set()
    for model in value['models']:
        if not isinstance(model, dict) or not isinstance(model.get('id'), str) or not MODEL_ID.fullmatch(model['id']) or not priced_price(model.get('pricing')):
            raise SandpiError('invalid model in cached OpenRouter full catalog', 78)
        if model['id'] in seen or model['id'].startswith('openrouter/') or model['id'].endswith(':batch'):
            raise SandpiError('ambiguous/noninteractive model in OpenRouter full catalog', 78)
        seen.add(model['id'])
        if type(model.get('contextWindow')) is not int or not 256 <= model['contextWindow'] <= 100_000_000 or \
                type(model.get('maxTokens')) is not int or not 1 <= model['maxTokens'] <= model['contextWindow'] or \
                type(model.get('tools')) is not bool or not isinstance(model.get('name'), str) or \
                not isinstance(model.get('input'), list) or 'text' not in model['input'] or \
                any(x not in ('text', 'image') for x in model['input']) or \
                not isinstance(model.get('reasoning_config'), dict) or \
                not isinstance(model.get('fingerprint'), str) or not re.fullmatch(r'[a-f0-9]{64}', model['fingerprint']):
            raise SandpiError('cached OpenRouter model capabilities are invalid', 78)
        created = model.get('created_at')
        if created is not None and (type(created) is not int or not CREATED_MIN <= created <= CREATED_MAX):
            raise SandpiError('cached OpenRouter model catalog-added timestamp is invalid', 78)
        transport = pi_transport(model['id'])
        if model.get('pi_api') != transport['api'] or model.get('pi_base_url') != transport['base_url'] or model.get('transport_policy') != transport['policy']:
            raise SandpiError('cached OpenRouter full model transport mismatch', 78)
        if not free_price(model['pricing']) and model.get('price_class') != 'paid':
            raise SandpiError('cached OpenRouter billing classification mismatch', 78)
    return value


def load_all(root: Path, *, refresh: bool = False, offline: bool = False,
             fetcher: Callable[[], dict] = fetch_all, now: float | None = None) -> dict:
    now = time.time() if now is None else now
    prior = cached_all(root)
    age = now - prior['fetched_at'] if prior else float('inf')
    if offline:
        if not prior:
            raise SandpiError('no paid catalog cached; run sandpi models --paid --refresh', 66)
        return runtime_snapshot({**prior, 'stale': age > TTL, 'offline': True}, now=now)
    if prior and not refresh and 0 <= age <= TTL:
        return runtime_snapshot({**prior, 'stale': False}, now=now)
    try:
        with file_lock(root / 'models/catalog-all.lock', timeout=15):
            latest = cached_all(root)
            if latest and not refresh and 0 <= now - latest['fetched_at'] <= TTL:
                return runtime_snapshot({**latest, 'stale': False}, now=now)
            new = fetcher()
            if new.get('schema') != FULL_SCHEMA or digest(new['models']) != new.get('fingerprint'):
                raise SandpiError('invalid OpenRouter full catalog refresh result', 78)
            new_free = free_view(new)
            # Full refresh also publishes the free view. Coordinate with the free
            # refresh lock so neither path can rotate or replace those two slots
            # underneath the other. The full lock is always acquired first here;
            # free-only refresh never acquires the full lock, so there is no cycle.
            with file_lock(root / 'models/catalog.lock', timeout=15):
                latest_free = cached(root)
                if latest is not None:
                    atomic_json(root / FULL_PREVIOUS_CACHE, latest)
                if latest_free is not None:
                    atomic_json(root / FREE_PREVIOUS_CACHE, latest_free)
                published = _published_snapshot(new, latest)
                published_free = _published_snapshot(new_free, latest_free)
                atomic_json(root / FULL_CACHE, published)
                # One HTTP listing feeds both surfaces. Never populate free discovery
                # with paid rows or invalidate an unchanged free model fingerprint.
                atomic_json(root / FREE_CACHE, published_free)
            return runtime_snapshot({**published, 'stale': False}, now=now)
    except SandpiError:
        if prior and not refresh and 0 <= age <= MAX_STALE:
            return runtime_snapshot({**prior, 'stale': True, 'refresh_failed': True}, now=now)
        raise


def snapshot_pair(root: Path, *, paid: bool) -> tuple[dict | None, dict | None]:
    """Read one coherent current/previous pair without creating a lock file.

    Refresh publishes each JSON document by atomic replacement. Reading current,
    then previous, then current again detects a concurrent publication without
    turning local inspection into a filesystem-writing operation. The exact
    predecessor link handles the interruption window between the two writes.
    """
    read_current = cached_all if paid else cached
    read_previous = cached_all_previous if paid else cached_previous
    for _ in range(SNAPSHOT_READ_ATTEMPTS):
        first = read_current(root)
        previous = read_previous(root)
        second = read_current(root)
        first_identity = snapshot_fingerprint(first) if first is not None else None
        second_identity = snapshot_fingerprint(second) if second is not None else None
        if first_identity != second_identity:
            continue
        if second is None or previous is None:
            return second, None
        linked = second.get(PREVIOUS_SNAPSHOT_FINGERPRINT)
        return second, previous if linked == snapshot_fingerprint(previous) else None
    raise SandpiError('catalog snapshots changed during local inspection; retry the command', 75)


def snapshot_slot(root: Path, *, paid: bool, selector: str) -> dict | None:
    """Read one explicit normalized cache slot without refreshing anything."""
    if selector not in {'current', 'previous'}:
        raise SandpiError('catalog snapshot selector must be current or previous', 64)
    current, previous = snapshot_pair(root, paid=paid)
    return current if selector == 'current' else previous


def snapshot_summary(snapshot: dict | None, *, selector: str, paid: bool) -> dict[str, Any]:
    """Return bounded public metadata for one local normalized snapshot slot."""
    if snapshot is None:
        return {'selector': selector, 'available': False, 'catalog': 'full' if paid else 'free'}
    models = snapshot.get('models') if isinstance(snapshot.get('models'), list) else []
    return {
        'selector': selector,
        'available': True,
        'catalog': 'full' if paid else 'free',
        'schema': snapshot.get('schema'),
        'fetched_at': snapshot.get('fetched_at'),
        'fingerprint': snapshot.get('fingerprint'),
        'previous_snapshot_fingerprint': snapshot.get(PREVIOUS_SNAPSHOT_FINGERPRINT),
        'models': len(models),
        'omitted': snapshot.get('omitted') if isinstance(snapshot.get('omitted'), dict) else {},
    }


def snapshot_inventory(root: Path, *, paid: bool) -> dict[str, Any]:
    """Describe the two bounded local catalog slots; no network or Pi access."""
    current, previous = snapshot_pair(root, paid=paid)
    return {
        'schema': 'sandpi.openrouter-catalog-snapshots.v1',
        'catalog': 'full' if paid else 'free',
        'slots': [
            snapshot_summary(current, selector='current', paid=paid),
            snapshot_summary(previous, selector='previous', paid=paid),
        ],
    }


def _model_delta_summary(model: dict) -> dict[str, Any]:
    """Bound an added/removed row without copying arbitrary catalog payloads."""
    return {
        'id': model['id'],
        'name': str(model.get('name') or model['id'])[:256],
        'billing_class': 'free' if free_price(model.get('pricing')) else 'paid',
        'catalog_added': model.get('created_at') if type(model.get('created_at')) is int else None,
        'context_window': model.get('contextWindow') if type(model.get('contextWindow')) is int else None,
        'max_output': model.get('maxTokens') if type(model.get('maxTokens')) is int else None,
        'tools': model.get('tools') if type(model.get('tools')) is bool else None,
        'input_modalities': list(model.get('input', [])) if isinstance(model.get('input'), list) else [],
        'pi_transport': model.get('pi_api') if isinstance(model.get('pi_api'), str) else None,
        'expiration_date': model.get('expiration_date') if isinstance(model.get('expiration_date'), str) else None,
    }


def normalize_delta_focus_ids(values: Any) -> list[str]:
    """Validate a bounded, invocation-local exact-ID focus list.

    This is deliberately not a saved watchlist. Duplicates are removed while
    preserving the caller's order so a shell can supply the same ID through
    multiple composed arguments without producing multiple rows.
    """
    if values is None:
        return []
    if not isinstance(values, (list, tuple)):
        raise SandpiError('catalog diff focus must be a list of exact model IDs', 64)
    result: list[str] = []
    seen: set[str] = set()
    for value in values:
        if not isinstance(value, str) or not MODEL_ID.fullmatch(value):
            raise SandpiError('catalog diff focus contains an invalid exact model ID', 64)
        if value in seen:
            continue
        seen.add(value)
        result.append(value)
        if len(result) > DELTA_FOCUS_LIMIT:
            raise SandpiError(f'catalog diff focus accepts at most {DELTA_FOCUS_LIMIT} exact model IDs', 64)
    return result


def _delta_changed_fields(old: dict, new: dict) -> list[str]:
    return [label for key, label in DELTA_FIELDS if old.get(key) != new.get(key)]


def _bounded_string_list(value: Any, *, limit: int = 64, text_limit: int = 128) -> dict[str, Any]:
    if not isinstance(value, list):
        return {'values': [], 'omitted': 0, 'truncated': 0, 'valid': False}
    strings = sorted({item for item in value if isinstance(item, str)})
    visible = strings[:limit]
    return {'values': [item if len(item) <= text_limit else item[:text_limit] + '… [truncated]'
                       for item in visible],
            'omitted': max(0, len(strings) - limit),
            'truncated': sum(len(item) > text_limit for item in visible),
            'valid': len(strings) == len(value)}


def _focus_reasoning(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    efforts = value.get('supported_efforts')
    safe_efforts = ([item for item in efforts if item in OPENROUTER_EFFORTS]
                    if isinstance(efforts, list) else [])
    return {
        'advertised': value.get('advertised') if type(value.get('advertised')) is bool else None,
        'mandatory': value.get('mandatory') if type(value.get('mandatory')) is bool else None,
        'default_enabled': value.get('default_enabled') if type(value.get('default_enabled')) is bool else None,
        'supported_efforts': safe_efforts[:len(OPENROUTER_EFFORTS)],
        'default_effort': value.get('default_effort') if value.get('default_effort') in OPENROUTER_EFFORTS else None,
        'supports_max_tokens': value.get('supports_max_tokens') if type(value.get('supports_max_tokens')) is bool else None,
        'effort_selector': value.get('effort_selector') if value.get('effort_selector') in
                           {'all', 'explicit', 'invalid', 'unavailable'} else None,
        'effort_selectable': value.get('effort_selectable') if type(value.get('effort_selectable')) is bool else None,
    }


def _focus_pricing(value: Any) -> dict[str, Any] | None:
    """Project bounded recognized rates without copying arbitrary pricing keys."""
    if not priced_price(value):
        return None
    def amount(item: Any) -> str:
        number = Decimal(str(item))
        return '0' if number == 0 else str(number.normalize())
    base = {key: amount(value[key]) for key in DELTA_PRICE_DIMENSIONS if key in value}
    overrides = value.get('overrides') if isinstance(value.get('overrides'), list) else []
    prompt_tiers = scheduled = other = 0
    price_keys = set(DELTA_PRICE_DIMENSIONS)
    for row in overrides:
        if not isinstance(row, dict):
            other += 1
            continue
        conditions = set(row) - price_keys
        has_schedule = bool(conditions & {'utc_start', 'utc_end', 'utc_days'})
        if conditions and conditions <= {'min_prompt_tokens'}:
            prompt_tiers += 1
        elif has_schedule and conditions <= {'utc_start', 'utc_end', 'utc_days'}:
            scheduled += 1
        else:
            other += 1
    return {
        'base_per_unit': base,
        'pi_estimate_usd_per_million': price_estimate(value),
        'override_counts': {
            'total': len(overrides),
            'prompt_token_tiers': prompt_tiers,
            'scheduled': scheduled,
            'other_or_combined': other,
        },
    }


def _model_focus_summary(model: dict | None) -> dict[str, Any] | None:
    """Return a fixed-schema, bounded view for one explicitly requested ID."""
    if not isinstance(model, dict):
        return None
    parameters = _bounded_string_list(model.get('supported_parameters'))
    canonical = model.get('canonical_slug')
    fingerprint = model.get('fingerprint')
    expiration_invalid = model.get('expiration_invalid')
    modalities = model.get('input')
    return {
        **_model_delta_summary(model),
        'canonical_slug': canonical[:256] if isinstance(canonical, str) else None,
        'input_modalities': ([item for item in modalities if item in ('text', 'image')][:2]
                             if isinstance(modalities, list) else []),
        'reasoning': model.get('reasoning') if type(model.get('reasoning')) is bool else None,
        'reasoning_configuration': _focus_reasoning(model.get('reasoning_config')),
        'supported_parameters': parameters['values'],
        'supported_parameters_omitted': parameters['omitted'],
        'supported_parameters_truncated': parameters['truncated'],
        'supported_parameters_valid': parameters['valid'],
        'pricing': _focus_pricing(model.get('pricing')),
        'pi_endpoint': model.get('pi_base_url') if isinstance(model.get('pi_base_url'), str) else None,
        'expiration_validity': (not expiration_invalid if type(expiration_invalid) is bool else None),
        'automatic_coding_eligibility': model.get('auto_eligible') if type(model.get('auto_eligible')) is bool else None,
        'fingerprint': fingerprint if isinstance(fingerprint, str) and re.fullmatch(r'[a-f0-9]{64}', fingerprint) else None,
    }


def _focused_delta(before_models: dict[str, dict], after_models: dict[str, dict],
                   focus_ids: list[str]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for ident in focus_ids:
        old = before_models.get(ident)
        new = after_models.get(ident)
        fields = _delta_changed_fields(old, new) if old is not None and new is not None else []
        status = ('absent' if old is None and new is None else
                  'added' if old is None else
                  'removed' if new is None else
                  'changed' if fields else 'unchanged')
        rows.append({
            'id': ident,
            'status': status,
            'fields': fields,
            'before': _model_focus_summary(old),
            'after': _model_focus_summary(new),
        })
    return rows


def catalog_delta(before: dict, after: dict, *, before_selector: str = 'previous',
                  after_selector: str = 'current', paid: bool,
                  focus_ids: Any = None) -> dict[str, Any]:
    """Compare exact normalized model IDs without guessing aliases/successors.

    Changed rows disclose bounded field names rather than copying raw pricing or
    provider payloads into another state format. The two source snapshots remain
    the authority and retain their own integrity digests.
    """
    if before_selector == after_selector:
        raise SandpiError('catalog diff requires two different snapshot selectors', 64)
    expected = FULL_SCHEMA if paid else SCHEMA
    for name, value in ((before_selector, before), (after_selector, after)):
        if not isinstance(value, dict) or value.get('schema') != expected or not isinstance(value.get('models'), list):
            raise SandpiError(f'invalid {name} catalog snapshot for diff', 78)
    before_models = {model['id']: model for model in before['models']}
    after_models = {model['id']: model for model in after['models']}
    added_ids = sorted(after_models.keys() - before_models.keys())
    removed_ids = sorted(before_models.keys() - after_models.keys())
    changed = []
    for ident in sorted(before_models.keys() & after_models.keys()):
        old = before_models[ident]
        new = after_models[ident]
        fields = _delta_changed_fields(old, new)
        if fields:
            changed.append({'id': ident, 'fields': fields,
                            'before_fingerprint': old.get('fingerprint'),
                            'after_fingerprint': new.get('fingerprint')})
    before_omitted = before.get('omitted') if isinstance(before.get('omitted'), dict) else {}
    after_omitted = after.get('omitted') if isinstance(after.get('omitted'), dict) else {}
    omission_changes = [
        {'reason': key, 'before': before_omitted.get(key, 0), 'after': after_omitted.get(key, 0)}
        for key in sorted(set(before_omitted) | set(after_omitted))
        if before_omitted.get(key, 0) != after_omitted.get(key, 0)
    ]
    focus = normalize_delta_focus_ids(focus_ids)
    result = {
        'schema': DELTA_SCHEMA,
        'catalog': 'full' if paid else 'free',
        'before': snapshot_summary(before, selector=before_selector, paid=paid),
        'after': snapshot_summary(after, selector=after_selector, paid=paid),
        'counts': {'added': len(added_ids), 'removed': len(removed_ids),
                   'changed': len(changed), 'omission_reasons_changed': len(omission_changes)},
        'added': [_model_delta_summary(after_models[ident]) for ident in added_ids],
        'removed': [_model_delta_summary(before_models[ident]) for ident in removed_ids],
        'changed': changed,
        'omission_changes': omission_changes,
        'limitations': [
            'Exact normalized catalog IDs only; aliases and successor relationships are not inferred.',
            'Removed means absent from the later normalized local snapshot, not proven provider retirement.',
            'Changed field names describe local metadata differences, not endpoint readiness or model quality.',
        ],
    }
    if focus:
        result['focus'] = _focused_delta(before_models, after_models, focus)
        result['focus_limit'] = DELTA_FOCUS_LIMIT
    return result


DELTA_DISPLAY_LIMIT = 20


def _utc_timestamp(value: Any) -> str:
    if type(value) not in (int, float) or not math.isfinite(value):
        return 'unknown'
    try:
        return datetime.fromtimestamp(value, timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')
    except (OverflowError, OSError, ValueError):
        return 'unknown'


def render_snapshot_inventory(value: dict[str, Any]) -> str:
    """Render the two local slots without implying a refresh or provider check."""
    lines = [f'OpenRouter {value.get("catalog", "unknown")} catalog snapshots — local normalized cache slots.']
    for slot in value.get('slots', []):
        selector = slot.get('selector', 'unknown')
        if slot.get('available') is not True:
            lines.append(f'  {selector}: unavailable.')
            continue
        fingerprint = slot.get('fingerprint')
        short = fingerprint[:12] if isinstance(fingerprint, str) else 'unknown'
        lines.append(f'  {selector}: fetched {_utc_timestamp(slot.get("fetched_at"))}; '
                     f'{slot.get("models", 0)} models; fingerprint {short}.')
    lines.extend([
        'Only one preceding successful normalized snapshot is retained per catalog.',
        'Listing snapshots makes no network, credential, credit, Pi, or inference request.',
    ])
    return '\n'.join(lines)


def _render_delta_model(row: dict[str, Any]) -> str:
    added = row.get('catalog_added')
    added_text = (datetime.fromtimestamp(added, timezone.utc).strftime('%Y-%m-%d')
                  if type(added) is int and CREATED_MIN <= added <= CREATED_MAX else 'unknown')
    modalities = ','.join(row.get('input_modalities', [])) or 'unknown'
    tools = 'yes' if row.get('tools') is True else 'no' if row.get('tools') is False else 'unknown'
    return (f'{row.get("id", "unknown")}  {row.get("billing_class", "unknown")}  '
            f'context={row.get("context_window") if row.get("context_window") is not None else "unknown"}  '
            f'output={row.get("max_output") if row.get("max_output") is not None else "unknown"}  '
            f'tools={tools}  input={modalities}  added={added_text}')


def _render_focus_evidence(row: Any) -> str:
    if not isinstance(row, dict):
        return 'unavailable'
    modalities = ','.join(row.get('input_modalities', [])) or 'unknown'
    tools = 'yes' if row.get('tools') is True else 'no' if row.get('tools') is False else 'unknown'
    reasoning = ('yes' if row.get('reasoning') is True else
                 'no' if row.get('reasoning') is False else 'unknown')
    added = row.get('catalog_added')
    added_text = (datetime.fromtimestamp(added, timezone.utc).strftime('%Y-%m-%d')
                  if type(added) is int and CREATED_MIN <= added <= CREATED_MAX else 'unknown')
    return (f'{row.get("billing_class", "unknown")}; '
            f'context={row.get("context_window") if row.get("context_window") is not None else "unknown"}; '
            f'output={row.get("max_output") if row.get("max_output") is not None else "unknown"}; '
            f'tools={tools}; reasoning={reasoning}; input={modalities}; '
            f'transport={row.get("pi_transport") or "unknown"}; added={added_text}')


def _render_focused_delta(rows: list[dict[str, Any]]) -> list[str]:
    lines = [f'Focused exact IDs ({len(rows)}; invocation-local, not saved or monitored):']
    for row in rows:
        ident = row.get('id', 'unknown')
        status = row.get('status')
        if status == 'absent':
            lines.append(f'  ? {ident}: absent from both snapshots.')
        elif status == 'added':
            lines.append(f'  + {ident}: added to the later snapshot.')
            lines.append(f'    after: {_render_focus_evidence(row.get("after"))}')
        elif status == 'removed':
            lines.append(f'  - {ident}: absent from the later snapshot.')
            lines.append(f'    before: {_render_focus_evidence(row.get("before"))}')
        elif status == 'changed':
            fields = ', '.join(row.get('fields', [])) or 'unknown fields'
            lines.append(f'  ~ {ident}: {fields}.')
            lines.append(f'    before: {_render_focus_evidence(row.get("before"))}')
            lines.append(f'    after:  {_render_focus_evidence(row.get("after"))}')
        elif status == 'unchanged':
            lines.append(f'  = {ident}: unchanged in the compared normalized fields.')
            lines.append(f'    both: {_render_focus_evidence(row.get("after"))}')
        else:
            lines.append(f'  ? {ident}: invalid focus result.')
    lines.append('Use --json for the bounded before/after evidence attached to every focused ID.')
    return lines


def render_catalog_delta(value: dict[str, Any], *, limit: int = DELTA_DISPLAY_LIMIT) -> str:
    """Render a bounded exact-ID delta; JSON callers retain the complete result."""
    if type(limit) is not int or not 1 <= limit <= 200:
        raise SandpiError('catalog delta display limit must be between 1 and 200', 64)
    before = value.get('before') if isinstance(value.get('before'), dict) else {}
    after = value.get('after') if isinstance(value.get('after'), dict) else {}
    counts = value.get('counts') if isinstance(value.get('counts'), dict) else {}
    lines = [
        f'OpenRouter {value.get("catalog", "unknown")} catalog delta — '
        f'{before.get("selector", "before")} → {after.get("selector", "after")}.',
        f'  {before.get("selector", "before")}: fetched {_utc_timestamp(before.get("fetched_at"))}; '
        f'{before.get("models", 0)} normalized models.',
        f'  {after.get("selector", "after")}: fetched {_utc_timestamp(after.get("fetched_at"))}; '
        f'{after.get("models", 0)} normalized models.',
        f'Model changes: +{counts.get("added", 0)} added, -{counts.get("removed", 0)} removed, '
        f'~{counts.get("changed", 0)} metadata-changed.',
