from __future__ import annotations
from support import *
from credentials import BankEntry
from core import SandpiError, atomic_json
from keypool import KeyPool, ROUTE_FAILURE_WINDOW, ROUTE_STALE_SECONDS, blocked_models


class RouteHealthTests(TempCase):
    def setUp(self):
        super().setUp()
        self.now = 1_700_000_000.0
        self.pool = KeyPool(self.creds, clock=lambda: self.now)
        self.entries = [BankEntry('one', OR1), BankEntry('two', OR2)]
        self.model = 'vendor/route:free'
        self.fingerprint = 'a' * 64

    def acquire(self, *, model=None, fingerprint=None):
        return self.pool.acquire(
            'openrouter', self.entries, model=model or self.model,
            model_fingerprint=self.fingerprint if fingerprint is None else fingerprint,
        )

    def finish(self, lease, outcome='success', **kwargs):
        return self.pool.finish(lease['lease_id'], outcome=outcome, **kwargs)

    def row(self, *, model=None, fingerprint=None):
        model = model or self.model
        fingerprints = {model: self.fingerprint if fingerprint is None else fingerprint}
        return self.pool.route_status('openrouter', fingerprints=fingerprints, model=model)['routes'][model]

    def route_failure(self, *, committed=False):
        lease = self.acquire()
        result = self.finish(lease, 'server', status=503, scope='route', committed=committed)
        self.now += 6  # expire the request-level route cooldown, not passive health
        return result

    def test_first_route_failure_is_observed_not_degraded(self):
        result = self.route_failure()
        self.assertEqual('observed', result['route_health']['state'])
        self.assertFalse(result['route_health']['degraded'])
        self.assertEqual(1, self.row()['route_failures'])

    def test_repeated_route_failure_temporarily_degrades(self):
        self.route_failure(); result = self.route_failure()
        self.assertEqual('degraded', result['route_health']['state'])
        self.assertTrue(result['route_health']['degraded'])
        self.assertGreater(result['route_health']['degraded_until'], self.now)
        self.assertEqual(2, self.row()['consecutive_failures'])

    def test_success_heals_degradation_immediately(self):
        self.route_failure(); self.route_failure()
        result = self.finish(self.acquire(), 'success')
        self.assertEqual('healthy', result['route_health']['state'])
        self.assertFalse(result['route_health']['degraded'])
        self.assertEqual(0, result['route_health']['consecutive_failures'])

    def test_failures_outside_window_do_not_accumulate(self):
        self.route_failure()
