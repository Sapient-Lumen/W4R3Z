        body={'model':facility.CHAT_MODEL,'messages':[{'role':'user','content':'work'}],
              'tools':[{'type':'function','function':{'name':'write'}}],
              'provider':self.free_provider()}
        self.assertEqual(401,self.post('/v1/chat/completions',body,facility.KEYS[0])[0])
        status,data=self.post('/v1/chat/completions',body,facility.KEYS[1])
