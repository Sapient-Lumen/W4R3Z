    if found:
        return found
    for path in [Path.home() / '.nix-profile/bin/nix', Path('/nix/var/nix/profiles/default/bin/nix'),
                 Path('/run/current-system/sw/bin/nix')]:
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    raise SandpiError('Nix is required on the host. Its executable was not found in PATH or the standard Nix profiles.', 69)


def nix_command(*args: str) -> list[str]:
    return [find_nix(), *NIX_FLAGS, *args]


def system_name() -> str:
    if platform.system() != 'Linux':
        raise SandpiError('Cloud Hypervisor mode requires a Linux Nix host', 69)
    machine = platform.machine()
    if machine not in ('x86_64', 'aarch64'):
        raise SandpiError('this revision supports x86_64-linux and aarch64-linux hosts', 69)
    return machine + '-linux'


def source_fingerprint(root: Path) -> str:
    h = hashlib.sha256()
    for part in ('pins.json', 'nix/flake.nix', 'nix/guest.nix', 'src'):
        path = root / part
        entries = sorted(p for p in path.rglob('*') if p.is_file() and '__pycache__' not in p.parts) if path.is_dir() else [path]
        for item in entries:
            h.update(str(item.relative_to(root)).encode() + b'\0' + item.read_bytes() + b'\0')
    return h.hexdigest()[:24]


def render_flake(source: Path, target: Path) -> Path:
    """Only immutable program sources enter /nix/store, never project/launch data."""
    private_dir(target)
    for name in ('flake.nix', 'guest.nix'):
        atomic_write(target / name, (source / 'nix' / name).read_bytes(), 0o644)
    dst = target / 'src'
    private_dir(dst)
    # Pi package resources can be nested (prompts, skills and their references).
    # Stage the complete immutable package, not just its top-level extension files.
    for item in sorted((source / 'src').rglob('*')):
        if item.is_file() and '__pycache__' not in item.parts and (item.name in ('core.py', 'guest.py', 'transport.py', 'catalog.py', 'model_defaults.py', 'settings_defaults.py', 'benchmark.py', 'benchmark_course.py', 'benchmark_course_reference.py') or item.is_relative_to(source / 'src' / 'pi')):
            atomic_write(dst / item.relative_to(source / 'src'), item.read_bytes(), 0o644)
    return target


def build(source: Path, root: Path, *, bare: bool = False) -> Path:
    system_name()
    builds = private_dir(root / 'builds')
    fingerprint = source_fingerprint(source)
    directory = private_dir(builds / fingerprint)
    with file_lock(directory / 'build.lock'):
        flake = render_flake(source, directory / 'flake')
        name = 'pi' if bare else 'guest-bundle'
        link = directory / name
        if not (link.is_symlink() and link.exists()):
            log(f'building pinned {name}; Nix reuses existing store paths and substitutes')
            run(nix_command('build', '--accept-flake-config', '--out-link', str(link),
                            f'path:{flake}#{name}'))
        if bare:
            tools = directory / 'host-tools'
            if not tools.exists():
                run(nix_command('build', '--out-link', str(tools), f'path:{flake}#host-tools'))
        atomic_json(directory / 'build.json', {'schema': 'sandpi.build.v1', 'at': timestamp(),
                    'fingerprint': fingerprint, 'system': system_name(), 'pins': read_json(source / 'pins.json')})
        return link.resolve()


def tools_environment(bundle: Path, *, bare: bool = False, source: Path | None = None,
                      root: Path | None = None) -> dict[str, str]:
    env = dict(os.environ)
    if bare:
        assert source and root
        tools = root / 'builds' / source_fingerprint(source) / 'host-tools'
    else:
        tools = bundle / 'host-tools'
    env['PATH'] = str(tools / 'bin') + ':' + env.get('PATH', '')
    certificate = tools / 'etc/ssl/certs/ca-bundle.crt'
    if certificate.exists():
        env.setdefault('SSL_CERT_FILE', str(certificate))
        env.setdefault('NIX_SSL_CERT_FILE', str(certificate))
    return env


def nix_store() -> str:
    binary = shutil.which('nix-store')
    if binary:
        return binary
    sibling = Path(find_nix()).parent / 'nix-store'
    if sibling.exists():
        return str(sibling)
    raise SandpiError('nix-store was not found alongside nix', 69)


def validate_store_paths(paths: list[str]) -> list[str]:
    unique = sorted(set(paths))
    if any(not STORE_RE.fullmatch(x) for x in unique):
        raise SandpiError('Nix returned a path outside the supported /nix/store layout', 78)
    return unique


def chunks(values: list[str], size: int = 128):
    for i in range(0, len(values), size):
        yield values[i:i + size]


def _cache_artifact(path: str) -> bool:
    name = path.rsplit('/', 1)[-1]
    return '-sandpi-host-cache-root-' in name or '-sandpi-host-cache-manifest-' in name


def _file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def _owned_regular(path: Path) -> bool:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return False
    return stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and info.st_nlink == 1


def _aggregate_is_rooted(roots: Path, aggregate: str) -> bool:
    """Confirm that an existing aggregate remains protected by one owned root."""
    for link in roots.iterdir():
        if not link.name.startswith('aggregate-') or not link.is_symlink():
            continue
        try:
            if os.readlink(link) == aggregate:
                return True
        except OSError:
            continue
    return False


def _registration_segments(cache: Path, manifest: dict[str, Any],
                           digest: str) -> tuple[list[dict[str, str]], bool]:
    """Validate the append-only DB streams, migrating the original monolith."""
    raw = manifest.get('registration_segments')
    migrated = False
    if raw is None:
        registration = cache / f'registration-{digest}.txt'
        if not _owned_regular(registration):
            return [], False
        checksum = manifest.get('registration_sha256')
        if not isinstance(checksum, str) or not re.fullmatch(r'[a-f0-9]{64}', checksum):
            checksum = _file_sha256(registration)
            manifest['registration_sha256'] = checksum
        raw = [{'name': registration.name, 'sha256': checksum}]
        manifest['registration_segments'] = raw
        migrated = True
    if not isinstance(raw, list) or not 1 <= len(raw) <= 4096:
        raise SandpiError('Nix registration segment index is malformed', 78)
    result: list[dict[str, str]] = []
    seen: set[str] = set()
    for item in raw:
        if not isinstance(item, dict) or set(item) != {'name', 'sha256'}:
            raise SandpiError('Nix registration segment entry is malformed', 78)
        name, checksum = item.get('name'), item.get('sha256')
        if (not isinstance(name, str) or
                not re.fullmatch(r'registration-[a-f0-9]{64}\.txt', name) or
                not isinstance(checksum, str) or not re.fullmatch(r'[a-f0-9]{64}', checksum) or
                name in seen or not _owned_regular(cache / name) or
                _file_sha256(cache / name) != checksum):
            raise SandpiError('Nix registration segment is missing or malformed', 78)
        seen.add(name)
        result.append({'name': name, 'sha256': checksum})
    return result, migrated


def _seed_cache(seed: Path, retained: list[str], aggregate: str,
                cache: Path, segments: list[dict[str, str]], generation: str) -> None:
    atomic_write(seed / 'store-paths', '\n'.join(retained) + '\n')
    atomic_write(seed / 'store-roots', aggregate + '\n')
    target = private_dir(seed / 'registrations')
    rows: list[str] = []
    for segment in segments:
        shutil.copyfile(cache / segment['name'], target / segment['name'])
        os.chmod(target / segment['name'], 0o600)
        rows.append(f"{segment['sha256']} {segment['name']}")
    atomic_write(target / 'index', '\n'.join(rows) + '\n')
    atomic_write(target / 'generation', generation + '\n')


def _aggregate_cache_root(cache: Path, roots: Path, paths: list[str]) -> tuple[str, bool]:
    """Create one Nix object whose reference graph retains every leased path."""
    clean = validate_store_paths(paths)
    digest = sha256('\n'.join(clean).encode())
    path_file = cache / f'lease-input-{digest}.json'
    expression = cache / f'lease-root-{digest}.nix'
    atomic_json(path_file, clean)
    shell_binary = shutil.which('bash')
    if not shell_binary:
        raise SandpiError('bash is required to construct the aggregate Nix cache root', 69)
    shell_root = str(Path(shell_binary).resolve().parents[1])
    if not STORE_RE.fullmatch(shell_root) or not (Path(shell_root) / 'bin/bash').is_file():
        raise SandpiError('bash did not resolve to a Nix store object', 69)
    tag = digest[:24]
    builder_command = "printf '%s\\n' \"$(<\"$1\")\" > \"$out\""
    source = f'''let
  paths = builtins.fromJSON (builtins.readFile {json.dumps(str(path_file))});
  refs = map builtins.storePath paths;
  text = builtins.concatStringsSep "\\n" refs + "\\n";
  manifest = builtins.toFile "sandpi-host-cache-manifest-{tag}" text;
  shell = builtins.storePath {json.dumps(shell_root)};
in builtins.derivation {{
  name = "sandpi-host-cache-root-{tag}";
  system = builtins.currentSystem;
  builder = "${{shell}}/bin/bash";
  args = [ "-euc" {json.dumps(builder_command)}
           "sandpi-root-builder" manifest ];
}}
'''
    atomic_write(expression, source)
    # Stay on the already-required modern Nix CLI. Requiring the legacy
    # sibling `nix-build` binary made otherwise valid minimal Nix installations
    # (and portable import boundaries) fail for no semantic reason.
    result = run(nix_command('build', '--no-link', '--print-out-paths',
                             '--file', str(expression)), capture=True)
    lines = result.stdout.decode().splitlines()
    if len(lines) != 1:
        raise SandpiError('aggregate Nix cache root build returned an invalid path', 70)
    aggregate = validate_store_paths(lines)[0]
    link = roots / f'aggregate-{digest}'
    if link.is_symlink():
        if os.readlink(link) != aggregate:
            raise SandpiError('aggregate Nix cache root link changed unexpectedly', 78)
        return aggregate, False
    if link.exists():
        raise SandpiError('aggregate Nix cache root is not a symlink', 78)
    run([nix_store(), '--add-root', str(link), '--realise', aggregate], capture=True)
    return aggregate, True


def register_cache(bundle: Path, root: Path, seed: Path, *, mode: str = 'host') -> dict[str, Any]:
    """Root and register lower-store paths without copying package data.

    Leases deliberately outlive a VM process: its persistent upper layer can
    reference lower paths. Removing host GC roots behind it would break resumes.
    The cumulative cache retains realized objects and their reference closure.
    ``base`` remains accepted as a compatibility spelling, but the single
    read-only host-store transport makes a smaller registration set unsafe:
    guest GC can see every host object and would otherwise try to delete the
    unregistered remainder through virtiofs.  Both spellings therefore retain
    and register the complete store snapshot visible at launch.
    """
    if mode not in ('host', 'base'):
        raise SandpiError('store cache must be host or base', 64)
    cache = private_dir(root / 'cache')
    with file_lock(cache / 'lease.lock'):
        roots = private_dir(cache / 'roots')
        manifest_path = cache / 'lease.json'
        previous = read_json(manifest_path, {'paths': []})
        if not isinstance(previous, dict):
            raise SandpiError('Nix store lease metadata is malformed', 78)
        prior_paths = validate_store_paths(previous.get('paths', []))
        prior = set(prior_paths)
        bundle_paths = validate_store_paths((bundle / 'store-paths').read_text().splitlines())
        if prior:
            # The overwhelmingly common stopped-room path is immutable: the
            # pinned bundle is already included in the retained lease. Verify
            # its bounded metadata/registration artifacts, but avoid a fresh
            # Nix evaluation of tens of thousands of builtins.storePath
            # references merely to rediscover the same aggregate object.
            aggregate = previous.get('aggregate_root')
            digest = sha256('\n'.join(prior_paths).encode())
            segments, migrated = _registration_segments(cache, previous, digest)
            if (set(bundle_paths).issubset(prior) and
                    previous.get('schema') == 'sandpi.host-cache.v1' and
                    previous.get('path_count') == len(prior_paths) and
                    isinstance(aggregate, str) and STORE_RE.fullmatch(aggregate) and
                    previous.get('root_paths') == [aggregate] and
                    _aggregate_is_rooted(roots, aggregate) and
                    segments):
                if migrated:
                    atomic_json(manifest_path, previous)
                _seed_cache(seed, prior_paths, aggregate, cache, segments, digest)
                return {
                    'mode': 'host',
                    'requested_mode': mode,
                    'compatibility_promotion': mode == 'base',
                    'retained_paths': len(prior_paths),
                    'new_paths': 0,
                    'new_roots': 0,
                    'digest': digest,
                    'fast_path': True,
                }
        if prior:
            # A room lease is a durable snapshot, not a continuously changing
            # mirror of an active workstation's Nix database. Add only the
            # current Sandpi runtime closure on later starts.
            requested = prior_paths
        else:
            result = run(nix_command('path-info', '--all'), capture=True)
            requested = validate_store_paths(result.stdout.decode().splitlines())
        requested = validate_store_paths(requested + bundle_paths)
        # The aggregate object has explicit Nix references to the complete
        # lease. One GC root therefore replaces tens of thousands of symlinks.
        # Excluding earlier aggregate artifacts makes repeat starts converge.
        base_retained = validate_store_paths(sorted(
            {path for path in prior | set(requested) if not _cache_artifact(path)}))
        aggregate, new_root = _aggregate_cache_root(cache, roots, base_retained)
        retained = validate_store_paths(base_retained + [aggregate])
        # A registration stream is concatenable records, not a JSON array. Dump
        # the exact retained closure instead of copying a live SQLite database.
        manifest = {'schema': 'sandpi.host-cache.v1', 'updated_at': timestamp(),
                    'paths': retained, 'path_count': len(retained),
                    'root_paths': [aggregate], 'aggregate_root': aggregate,
                    'retention': 'until-explicit-reset-after-all-dependent-rooms-are-deleted'}
        digest = sha256('\n'.join(retained).encode())
        prior_digest = sha256('\n'.join(prior_paths).encode()) if prior_paths else ''
        segments, _migrated = (_registration_segments(cache, previous, prior_digest)
                               if prior_paths else ([], False))
        registration = cache / f'registration-{digest}.txt'
        new_records = retained if not prior_paths else sorted(set(retained) - prior)
        if new_records and not registration.exists():
            fd, temporary = tempfile.mkstemp(prefix='.registration-', dir=cache)
            try:
                with os.fdopen(fd, 'wb') as out:
                    for batch in chunks(new_records, 2048):
                        result = subprocess.run([nix_store(), '--dump-db', *batch], stdout=out,
                                                check=False)
                        if result.returncode:
                            raise SandpiError('Nix store registration export failed', 70)
                    out.flush()
                    os.fsync(out.fileno())
                os.replace(temporary, registration)
            finally:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(temporary)
        if new_records:
            if not _owned_regular(registration):
                raise SandpiError('Nix registration segment was not created safely', 70)
            registration_sha256 = _file_sha256(registration)
            if all(item['name'] != registration.name for item in segments):
                segments.append({'name': registration.name, 'sha256': registration_sha256})
        if not segments:
            raise SandpiError('Nix registration segment index is empty', 70)
        manifest['registration_segments'] = segments
        atomic_json(manifest_path, manifest)
        _seed_cache(seed, retained, aggregate, cache, segments, digest)
        return {
            'mode': 'host',
            'requested_mode': mode,
            'compatibility_promotion': mode == 'base',
            'retained_paths': len(retained),
            'new_paths': len(set(retained) - prior),
            'new_roots': int(new_root),
            'digest': digest,
            'fast_path': False,
        }


ROOM_STORE_SCHEMA = 'sandpi.room-store-lease.v1'
MAX_ROOM_STORE_PATHS = 200_000
MAX_ROOM_STORE_BYTES = 64 * 1024 * 1024


def store_paths_text(paths: list[str]) -> bytes:
    clean = validate_store_paths(paths)
    if len(clean) > MAX_ROOM_STORE_PATHS:
        raise SandpiError('Nix store lease exceeds the fixed path-count bound', 78)
    data = ('\n'.join(clean) + ('\n' if clean else '')).encode()
    if len(data) > MAX_ROOM_STORE_BYTES:
        raise SandpiError('Nix store lease exceeds the fixed byte bound', 78)
    return data


def read_store_paths(path: Path) -> list[str]:
    try:
        info = path.lstat()
    except FileNotFoundError:
        raise SandpiError(f'Nix store path manifest is missing: {path}', 66) from None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
        raise SandpiError('Nix store path manifest must be a user-owned single-link regular file', 78)
    if info.st_size > MAX_ROOM_STORE_BYTES:
        raise SandpiError('Nix store path manifest exceeds the fixed byte bound', 78)
    try:
        rows = path.read_text(errors='strict').splitlines()
    except UnicodeError:
        raise SandpiError('Nix store path manifest is not valid UTF-8', 78) from None
    if len(rows) > MAX_ROOM_STORE_PATHS:
        raise SandpiError('Nix store path manifest exceeds the fixed path-count bound', 78)
    if any(not row or row != row.strip() for row in rows):
        raise SandpiError('Nix store path manifest contains malformed lines', 78)
    return validate_store_paths(rows)


def snapshot_room_lease(root: Path, room: Path, *, mode: str, digest: str | None = None) -> dict[str, Any]:
    """Persist the cumulative lower-store view last used by this room.

    The global lease remains authoritative for retention.  This room-local copy
    exists so clones and portable backups can identify a sufficient lower view
    without assuming every future host-cache addition belongs to this room.
    """
    lease = read_json(root / 'cache/lease.json', {})
    paths = validate_store_paths(lease.get('paths', [])) if isinstance(lease, dict) else []
    if not paths:
        raise SandpiError('global Nix store lease is empty after cache preparation', 70)
    data = store_paths_text(paths)
    actual_digest = sha256(data)
    if digest is not None and digest != sha256(('\n'.join(paths)).encode()):
        # register_cache historically hashes the newline-joined list without a
        # trailing newline.  A mismatch signals a concurrent/corrupt snapshot.
        raise SandpiError('global Nix store lease changed during room snapshot', 75)
    atomic_write(room / 'store-paths', data)
    payload = {
        'schema': ROOM_STORE_SCHEMA,
        'recorded_at': timestamp(),
        'mode': mode,
        'path_count': len(paths),
        'paths_sha256': actual_digest,
        'global_lease_digest': sha256(('\n'.join(paths)).encode()),
        'scope': 'cumulative-lower-view-last-used-by-room',
    }
    atomic_json(room / 'store-lease.json', payload)
    return payload


def room_lease(root: Path, room: Path) -> dict[str, Any]:
    """Return a validated room-local lease, or a conservative global fallback."""
    manifest_path = room / 'store-lease.json'
    paths_path = room / 'store-paths'
    if manifest_path.exists() or manifest_path.is_symlink() or paths_path.exists() or paths_path.is_symlink():
        if not manifest_path.exists() or not paths_path.exists():
            raise SandpiError('room Nix lease snapshot is incomplete', 78)
        info = manifest_path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1 or info.st_size > 1024 * 1024:
            raise SandpiError('room Nix lease metadata must be a bounded user-owned regular file', 78)
        value = read_json(manifest_path)
        allowed = {'schema', 'recorded_at', 'mode', 'path_count', 'paths_sha256',
                   'global_lease_digest', 'scope'}
        if not isinstance(value, dict) or set(value) != allowed or value.get('schema') != ROOM_STORE_SCHEMA:
            raise SandpiError('room Nix lease metadata has an invalid schema', 78)
        if value.get('mode') not in {'host', 'base'} or value.get('scope') != 'cumulative-lower-view-last-used-by-room':
            raise SandpiError('room Nix lease metadata has invalid policy fields', 78)
        if not isinstance(value.get('recorded_at'), str) or not value['recorded_at'] or len(value['recorded_at']) > 96:
            raise SandpiError('room Nix lease metadata has an invalid timestamp', 78)
        for field in ('paths_sha256', 'global_lease_digest'):
            if not isinstance(value.get(field), str) or not re.fullmatch(r'[a-f0-9]{64}', value[field]):
                raise SandpiError('room Nix lease metadata has an invalid digest', 78)
        paths = read_store_paths(paths_path)
        data = store_paths_text(paths)
        if value.get('path_count') != len(paths) or value.get('paths_sha256') != sha256(data):
            raise SandpiError('room Nix lease snapshot does not match its metadata', 78)
        return {**value, 'paths': paths, 'source': 'room-snapshot'}

    lease = read_json(root / 'cache/lease.json', {})
    paths = validate_store_paths(lease.get('paths', [])) if isinstance(lease, dict) else []
    if not paths:
        raise SandpiError('no retained Nix lower-store lease is available for this room', 66)
    data = store_paths_text(paths)
    return {
        'schema': ROOM_STORE_SCHEMA,
        'recorded_at': lease.get('updated_at', timestamp()),
        'mode': 'host',
        'path_count': len(paths),
        'paths_sha256': sha256(data),
        'global_lease_digest': sha256(('\n'.join(paths)).encode()),
        'scope': 'cumulative-lower-view-last-used-by-room',
        'paths': paths,
        'source': 'global-fallback',
    }


def _write_registration(cache: Path, retained: list[str]) -> tuple[str, Path]:
    digest = sha256('\n'.join(retained).encode())
    registration = cache / f'registration-{digest}.txt'
    if not registration.exists():
        fd, temporary = tempfile.mkstemp(prefix='.registration-', dir=cache)
        try:
            with os.fdopen(fd, 'wb') as out:
                for batch in chunks(retained, 2048):
                    result = subprocess.run([nix_store(), '--dump-db', *batch], stdout=out, check=False)
                    if result.returncode:
                        raise SandpiError('Nix store registration export failed', 70)
                out.flush()
                os.fsync(out.fileno())
            os.replace(temporary, registration)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(temporary)
    return digest, registration


def retain_paths(root: Path, paths: list[str], *, reason: str) -> dict[str, Any]:
    """Root existing imported store paths and merge them into Sandpi's lease."""
    requested = validate_store_paths(paths)
    if not requested:
        raise SandpiError('cannot retain an empty Nix store path set', 64)
    cache = private_dir(root / 'cache')
    with file_lock(cache / 'lease.lock'):
        roots = private_dir(cache / 'roots')
        previous = read_json(cache / 'lease.json', {'paths': []})
        prior = set(validate_store_paths(previous.get('paths', [])))
        objects = [path for path in requested if not path.endswith('.drv')]
        # Querying verifies that every requested object and reference is valid.
        closure = {path for path in prior if not _cache_artifact(path)}
        for batch in chunks(objects):
            result = run([nix_store(), '--query', '--requisites', *batch], capture=True)
            closure.update(validate_store_paths(result.stdout.decode().splitlines()))
        closure.update(requested)
        base_retained = validate_store_paths(sorted(closure))
        aggregate, new_root = _aggregate_cache_root(cache, roots, base_retained)
        retained = validate_store_paths(base_retained + [aggregate])
        digest, registration = _write_registration(cache, retained)
        manifest = {
            'schema': 'sandpi.host-cache.v1',
            'updated_at': timestamp(),
            'paths': retained,
            'path_count': len(retained),
            'root_paths': [aggregate],
            'aggregate_root': aggregate,
            'retention': 'until-explicit-reset-after-all-dependent-rooms-are-deleted',
            'last_import_reason': reason[:128],
        }
        atomic_json(cache / 'lease.json', manifest)
        return {'schema': 'sandpi.store-retain.v1', 'digest': digest,
                'registration': str(registration), 'retained_paths': len(retained),
                'new_roots': int(new_root)}


def realise_manifest_paths(paths: list[str]) -> None:
    """Fetch non-derivation paths through configured substituters, never build .drv files."""
    requested = validate_store_paths(paths)
    objects = [path for path in requested if not path.endswith('.drv')]
    for batch in chunks(objects, 64):
        run([nix_store(), '--realise', *batch], capture=True)
    # path-info does not substitute; after the safe fetch pass it proves every
    # exact path, including derivation files, is present.
    data = store_paths_text(requested)
    try:
        result = run(nix_command('path-info', '--stdin'), capture=True, input=data)
    except SandpiError as error:
        raise SandpiError(
            'target host did not materialize the exact backup Nix path set; use a full backup',
            69) from error
    present = validate_store_paths(result.stdout.decode().splitlines())
