#!/usr/bin/env python3
"""Real detached-room and secondary-entry acceptance, with no inference call."""
from __future__ import annotations
import datetime as dt
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(command, check=True, timeout=kwargs.pop('timeout', 900), **kwargs)


def main() -> int:
    out = Path(os.environ.get('SANDPI_TEST_RESULTS', ROOT / 'evidence' / ('room-' + dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%SZ')))).resolve()
    out.mkdir(parents=True, exist_ok=True)
    (out / 'result.json').unlink(missing_ok=True)
    launcher = str(Path(os.environ.get('SANDPI_TEST_LAUNCHER', ROOT / 'sandpi')).resolve())
    project = out / 'workspace'; project.mkdir(exist_ok=True)
    home = out / 'state'; credentials = out / 'credentials'; credentials.mkdir(mode=0o700, exist_ok=True)
    identity = ['--home', str(home), '--credentials-root', str(credentials),
                '--project', str(project), '--name', 'detached']
    launch = [*identity, '--cpus', '1', '--memory', os.environ.get('SANDPI_TEST_MEMORY', '4G'),
              '--disk-size', '16G']
    transcript = out / 'transcript.log'
    try:
        with transcript.open('wb') as log:
            run([launcher, 'up', *launch], stdout=log, stderr=subprocess.STDOUT, timeout=1200)
            # Starting an already-running room is intentionally idempotent.
            run([launcher, 'up', *launch], stdout=log, stderr=subprocess.STDOUT, timeout=120)
            state = json.loads(run([launcher, 'status', *identity], capture_output=True, text=True, timeout=30).stdout)[0]
            assert state['state'] == 'running' and state['process_alive'], state
            assert state['lifecycle'] == 'detached', state
            version = run([launcher, *identity, '--pi-only', '--', '--version'],
                          capture_output=True, text=True, timeout=180)
            (out / 'pi-version.txt').write_text(version.stdout + version.stderr)
            assert '1.1.0' in version.stdout + version.stderr, version
            run([launcher, 'exec', *identity, "test \"$(cat /etc/sandpi-room)\" = '%s' && printf 'REENTRY-OK\\n'" % state['room_id']],
                stdout=log, stderr=subprocess.STDOUT, timeout=120)
            still = json.loads(run([launcher, 'status', *identity], capture_output=True, text=True, timeout=30).stdout)[0]
            assert still['state'] == 'running' and still['process_alive'], still

            # A live secondary command publishes a host-authoritative lease. A
            # plain down refuses it, then --wait closes admission and drains it.
            active = subprocess.Popen([launcher, 'exec', *identity, 'sleep 2'],
                                      stdout=log, stderr=subprocess.STDOUT)
            entries_state = None
            for _ in range(50):
                entries_state = json.loads(run([launcher, 'entries', '--json', *identity],
                                               capture_output=True, text=True, timeout=30).stdout)
                if entries_state['rooms'][0]['occupancy']['active_count']:
                    break
                import time
                time.sleep(0.1)
            assert entries_state and entries_state['rooms'][0]['occupancy']['active_count'] == 1, entries_state
            refused = subprocess.run([launcher, 'down', *identity], stdout=log,
                                     stderr=subprocess.STDOUT, timeout=30)
            assert refused.returncode != 0, refused.returncode
            still = json.loads(run([launcher, 'status', *identity], capture_output=True, text=True, timeout=30).stdout)[0]
            assert still['state'] == 'running' and still['process_alive'], still
            run([launcher, 'down', '--wait', '10', *identity],
                stdout=log, stderr=subprocess.STDOUT, timeout=120)
            assert active.wait(timeout=30) == 0
        stopped = json.loads(run([launcher, 'status', *identity], capture_output=True, text=True, timeout=30).stdout)[0]
        assert stopped['state'] == 'stopped' and not stopped['process_alive'], stopped
        receipt = {'suite': 'room-reentry', 'status': 'passed',
                   'at': dt.datetime.now(dt.timezone.utc).isoformat(),
                   'room_id': state['room_id'],
                   'checks': ['detached-boot', 'idempotent-up', 'native-pi-reentry',
                              'secondary-exec', 'entry-lease-visible', 'plain-down-refusal',
                              'drain-wait', 'secondary-exit-keeps-room', 'explicit-down']}
        (out / 'status-running.json').write_text(json.dumps(state, indent=2) + '\n')
        (out / 'status-stopped.json').write_text(json.dumps(stopped, indent=2) + '\n')
        (out / 'result.json').write_text(json.dumps(receipt, indent=2) + '\n')
        print(json.dumps(receipt, indent=2))
        return 0
    except (OSError, ValueError, AssertionError, subprocess.SubprocessError) as error:
        print(f'sandpi room-reentry test: {error}', file=sys.stderr)
