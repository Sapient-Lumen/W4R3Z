\"\"\"Small failure-injectable store used by the publication contract.\"\"\"


class MemoryStore:
    def __init__(self, values=None, fail=()):
        self.values = dict(values or {})
        self.fail = set(fail)
        self.calls = []

    def _step(self, operation, key):
        self.calls.append((operation, key))
        if (operation, key) in self.fail:
            raise OSError(f"injected {operation} failure for {key}")

    def read(self, key):
        self._step("read", key)
        return self.values[key]

    def write(self, key, value):
        self._step("write", key)
        self.values[key] = bytes(value)

    def replace(self, source, destination):
        self._step("replace", destination)
        self.values[destination] = self.values.pop(source)

    def delete(self, key):
        self._step("delete", key)
        self.values.pop(key, None)
