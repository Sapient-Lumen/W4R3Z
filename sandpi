    """
    if not isinstance(model_id, str) or not MODEL_ID.fullmatch(model_id):
        raise SandpiError('invalid OpenRouter model identity for Pi transport', 78)
    anthropic = model_id.startswith('anthropic/') and not model_id.endswith(':batch')
    return {
        'api': 'anthropic-messages' if anthropic else 'openai-completions',
        'base_url': OPENROUTER_ANTHROPIC_BASE if anthropic else OPENROUTER_CHAT_BASE,
        'policy': TRANSPORT_POLICY,
    }


def transport_label(model: dict) -> str:
    api = model.get('pi_api')
    return 'messages' if api == 'anthropic-messages' else 'chat' if api == 'openai-completions' else 'unknown'


def _expiration(value: Any) -> tuple[str | None, bool]:
    if value is None:
        return None, False
    if not isinstance(value, str) or not re.fullmatch(r'\d{4}-\d{2}-\d{2}', value):
        return None, True
    try:
        datetime.strptime(value, '%Y-%m-%d')
    except ValueError:
        return None, True
    return value, False


def _created(value: Any) -> int | None:
    """Project OpenRouter's catalog-added timestamp without model rejection.

    The field is discovery metadata, not a release date or an eligibility fact.
    Missing/malformed values stay unknown so a catalog row remains usable.
    """
    return value if type(value) is int and CREATED_MIN <= value <= CREATED_MAX else None


def model_lifecycle(model: dict, *, now: float | None = None) -> dict[str, Any]:
    """Return date-relative lifecycle metadata without mutating catalog evidence."""
    if model.get('expiration_invalid'):
        return {'state': 'unknown', 'expiration_date': None, 'days_remaining': None}
    value = model.get('expiration_date')
    if value is None:
        return {'state': 'active', 'expiration_date': None, 'days_remaining': None}
    if not isinstance(value, str):
        return {'state': 'unknown', 'expiration_date': None, 'days_remaining': None}
    try:
        expires = datetime.strptime(value, '%Y-%m-%d').date()
    except ValueError:
        return {'state': 'unknown', 'expiration_date': None, 'days_remaining': None}
    stamp = time.time() if now is None else now
    if type(stamp) not in (int, float) or not math.isfinite(stamp):
        raise SandpiError('invalid catalog lifecycle clock', 70)
    today = datetime.fromtimestamp(stamp, timezone.utc).date()
    days = (expires - today).days
    state = 'expired' if days < 0 else 'expiring' if days <= EXPIRING_DAYS else 'active'
    return {'state': state, 'expiration_date': value, 'days_remaining': days}


def runtime_model(model: dict, *, now: float | None = None) -> dict:
    lifecycle = model_lifecycle(model, now=now)
    return {**model, 'lifecycle': lifecycle,
            'auto_eligible': bool(model.get('auto_eligible')) and lifecycle['state'] == 'active'}


def runtime_snapshot(value: dict, *, now: float | None = None) -> dict:
    return {**value, 'models': [runtime_model(model, now=now) for model in value.get('models', [])]}


def snapshot_fingerprint(value: dict) -> str:
    """Digest one complete normalized snapshot, excluding only its ancestry link.

    The existing ``fingerprint`` field intentionally covers model rows only. It
    can therefore be identical across consecutive refreshes. Publication safety
    needs a stronger identity that also covers timestamp, omissions, schema and
    all other normalized snapshot metadata.
    """
    if not isinstance(value, dict):
        raise SandpiError('invalid catalog snapshot for fingerprinting', 78)
    body = {key: item for key, item in value.items() if key != PREVIOUS_SNAPSHOT_FINGERPRINT}
    return digest(body)


def _published_snapshot(value: dict, previous: dict | None) -> dict:
    """Link a current cache to the exact predecessor published beside it.

    The predecessor is written first. If the later current-cache replacement is
    interrupted, the old current's complete-snapshot link will not match the new
    predecessor file and local diff readers fail closed. A models-only digest is
    deliberately insufficient because unchanged consecutive catalogs can share it.
    """
    result = {key: item for key, item in value.items() if key != PREVIOUS_SNAPSHOT_FINGERPRINT}
    if previous is not None:
        result[PREVIOUS_SNAPSHOT_FINGERPRINT] = snapshot_fingerprint(previous)
    return result


def _validate_previous_link(value: dict) -> None:
    linked = value.get(PREVIOUS_SNAPSHOT_FINGERPRINT)
    if linked is not None and (not isinstance(linked, str) or not re.fullmatch(r'[a-f0-9]{64}', linked)):
        raise SandpiError('cached catalog predecessor link is invalid', 78)


def pi_reasoning_selectable(model: dict) -> bool:
    info = model.get('reasoning_config') if isinstance(model.get('reasoning_config'), dict) else {}
    return bool(model.get('reasoning')) and info.get('effort_selectable') is True


def supports_thinking_level(model: dict, level: str | None) -> bool:
    """Whether an exact OpenRouter effort can be requested without Pi clamping.

    OpenRouter catalog metadata is the authority for managed free routes. A
    model whose selector is omitted remains provider-managed; Sandpi refuses an
    explicit level instead of pretending the request can be enforced.
    """
    if level is None:
        return True
    if level not in PI_THINKING_LEVELS:
        return False
    if not model.get('reasoning'):
        return level == 'off'
    info = model.get('reasoning_config') if isinstance(model.get('reasoning_config'), dict) else {}
    if info.get('effort_selector') not in {'all', 'explicit'}:
        return False
    if level == 'off':
        return info.get('mandatory') is not True
    efforts = info.get('supported_efforts') if isinstance(info.get('supported_efforts'), list) else []
    return level in efforts


def models_supporting_thinking(models: list[dict], level: str | None) -> list[dict]:
    return [model for model in models if supports_thinking_level(model, level)]


def thinking_level_map(model: dict) -> dict[str, str | None] | None:
    """Translate only catalog-declared OpenRouter effort controls into Pi.

    A non-mandatory reasoning model can always be switched off through the
    gateway even when `none` is not listed among its positive effort choices.
    Models whose catalog omits effort selection remain provider-managed: Pi
    does not synthesize medium/high controls for them.
    """
    if not pi_reasoning_selectable(model):
        return None
    info = model.get('reasoning_config') if isinstance(model.get('reasoning_config'), dict) else {}
    efforts = info.get('supported_efforts') if isinstance(info.get('supported_efforts'), list) else []
    available = set(item for item in efforts if item in OPENROUTER_EFFORTS)
    mandatory = info.get('mandatory') is True
    mapping: dict[str, str | None] = {}
    for level in PI_THINKING_LEVELS:
        upstream = 'none' if level == 'off' else level
        if level == 'off':
            mapping[level] = None if mandatory else 'none'
        else:
            mapping[level] = upstream if upstream in available else None
    return mapping


def default_thinking_level(model: dict) -> str | None:
    if not model.get('reasoning'):
        return 'off'
    if not pi_reasoning_selectable(model):
        return None
    info = model.get('reasoning_config') if isinstance(model.get('reasoning_config'), dict) else {}
    mandatory = info.get('mandatory') is True
    enabled = info.get('default_enabled')
    effort = info.get('default_effort')
    efforts = info.get('supported_efforts') if isinstance(info.get('supported_efforts'), list) else []
    if not mandatory and (enabled is False or effort == 'none'):
        return 'off'
    if enabled is True or mandatory:
        if effort in OPENROUTER_EFFORTS and effort != 'none':
            return effort
        # A catalog that says reasoning is on but omits a default gets the
        # weakest selectable positive effort, never an invented stronger one.
        for candidate in ('minimal', 'low', 'medium', 'high', 'xhigh', 'max'):
            if candidate in efforts:
                return candidate
    return None


def reasoning_label(model: dict) -> str:
    """Human-readable catalog policy, distinct from Pi's live selection."""
    if not model.get('reasoning'):
        return 'off'
    info = model.get('reasoning_config') if isinstance(model.get('reasoning_config'), dict) else {}
    if pi_reasoning_selectable(model):
        mapping = thinking_level_map(model) or {}
        levels = [level for level in PI_THINKING_LEVELS if mapping.get(level) is not None]
        selected = default_thinking_level(model) or 'provider-default'
        return f'{selected}; levels={"/".join(levels) or "none"}'
    enabled = info.get('default_enabled')
    selected = info.get('default_effort')
    if not selected:
        selected = 'on' if enabled is True or info.get('mandatory') is True else 'off' if enabled is False else 'provider-default'
    suffix = 'invalid-selector' if info.get('effort_selector') == 'invalid' else 'provider-managed'
    return f'{selected}; {suffix}'


def normalize(raw: Any, *, now: float | None = None, include_paid: bool = False) -> dict:
    if not isinstance(raw, dict) or not isinstance(raw.get('data'), list) or len(raw['data']) > 50000:
        raise SandpiError('OpenRouter catalog must contain a bounded data array', 78)
    models = {}
    duplicates = set()
    seen = set()
    omitted = {'paid_or_unknown_price': 0, 'not_text_chat': 0, 'invalid': 0, 'ambiguous_router': 0, 'duplicate': 0}
    for row in raw['data']:
        if not isinstance(row, dict) or not isinstance(row.get('id'), str) or not MODEL_ID.fullmatch(row['id']):
            omitted['invalid'] += 1; continue
        ident = row['id']
        if ident in seen:
            duplicates.add(ident)
        seen.add(ident)
        if ident in ('openrouter/free', 'openrouter/auto', 'openrouter/bodybuilder') or (include_paid and (
                row.get('alias_target') is not None or arch_is_router(row) or ident.endswith(':batch')
                or ident.startswith('openrouter/'))):
            omitted['ambiguous_router'] += 1; continue
        if not free_price(row.get('pricing')) and not (include_paid and priced_price(row.get('pricing'))):
            omitted['paid_or_unknown_price'] += 1; continue
        arch = row.get('architecture') or {}
        if not isinstance(arch, dict) or any(not isinstance(arch.get(k), list) for k in ('input_modalities', 'output_modalities')) or 'text' not in arch.get('input_modalities', []) or 'text' not in arch.get('output_modalities', []):
            omitted['not_text_chat'] += 1; continue
        context = row.get('context_length')
        top = row.get('top_provider') or {}
        params = row.get('supported_parameters', [])
        if type(context) is not int or not 256 <= context <= 100_000_000 or not isinstance(top, dict) or not isinstance(params, list) or any(not isinstance(p, str) for p in params):
            omitted['invalid'] += 1; continue
        max_tokens = top.get('max_completion_tokens')
        if type(max_tokens) is not int or max_tokens < 1:
            max_tokens = min(8192, context // 4)
        parameters = set(params)
        reasoning = _reasoning_metadata(row.get('reasoning'), parameters)
        expiration_date, expiration_invalid = _expiration(row.get('expiration_date'))
        transport = pi_transport(ident)
        record = {'id': ident, 'name': str(row.get('name') or ident)[:256],
                  'canonical_slug': str(row.get('canonical_slug') or ident)[:256],
                  'created_at': _created(row.get('created')),
                  'contextWindow': context, 'maxTokens': min(max_tokens, context),
                  'input': [x for x in ('text', 'image') if x in arch['input_modalities']],
                  'reasoning': reasoning['advertised'], 'reasoning_config': reasoning,
                  'tools': 'tools' in params, 'supported_parameters': sorted(set(params)),
                  'pricing': row['pricing'], 'profile': PROFILE,
                  'pi_api': transport['api'], 'pi_base_url': transport['base_url'],
                  'transport_policy': transport['policy'],
                  'expiration_date': expiration_date, 'expiration_invalid': expiration_invalid}
        if not free_price(record['pricing']):
            record['price_class'] = 'paid'
        # Catalog-added time is discovery presentation, not a capability or route
        # identity. Preserve grades/route observations when only this field appears.
        record['fingerprint'] = digest({key: value for key, value in record.items()
                                        if key != 'created_at'})
        record['auto_eligible'] = record['tools'] and context >= 8192
        if ident in models:
            duplicates.add(ident)
        models[ident] = record
    for ident in duplicates:
        models.pop(ident, None); omitted['duplicate'] += 1
    result = {'schema': FULL_SCHEMA if include_paid else SCHEMA, 'url': URL, 'fetched_at': now if now is not None else time.time(),
              'models': sorted(models.values(), key=lambda x: x['id']), 'omitted': omitted}
    result['fingerprint'] = digest(result['models'])
    return result


def fetch() -> dict:
    request = urllib.request.Request(URL, headers={'Accept': 'application/json', 'User-Agent': f'sandpi/{VERSION}'})
    try:
        with urllib.request.urlopen(request, timeout=12) as response:
            raw = response.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raise SandpiError('OpenRouter model catalog exceeds the size limit', 78)
        return normalize(json.loads(raw))
    except (OSError, ValueError, urllib.error.URLError):
        raise SandpiError('OpenRouter catalog refresh failed; use cached models or retry models --refresh', 69) from None


def cached(root: Path) -> dict | None:
    return _cached_free_path(root / FREE_CACHE)


def cached_previous(root: Path) -> dict | None:
    """Return the immediately preceding successful normalized free snapshot.

    Refresh is the only writer. Absence means no prior successful cache was
    available when the current snapshot was published; it never means an empty
    OpenRouter catalog.
    """
    return _cached_free_path(root / FREE_PREVIOUS_CACHE)


def _cached_free_path(path: Path) -> dict | None:
    if not path.exists():
        return None
    value = read_json(path)
    if isinstance(value, dict) and value.get('schema') in LEGACY_SCHEMAS:
        # Older caches lack transport, reasoning or expiry evidence. Refresh
        # rather than silently synthesizing a protocol for a saved model.
        return None
    if not isinstance(value, dict) or value.get('schema') != SCHEMA or not isinstance(value.get('models'), list):
        raise SandpiError('invalid cached free-model catalog', 78)
    if type(value.get('fetched_at')) not in (int, float) or not math.isfinite(value['fetched_at']):
        raise SandpiError('invalid catalog timestamp', 78)
    _validate_previous_link(value)
    if digest(value['models']) != value.get('fingerprint'):
        raise SandpiError('cached free-model catalog digest mismatch', 78)
    for model in value['models']:
        if not isinstance(model, dict) or not isinstance(model.get('id'), str) or not MODEL_ID.fullmatch(model.get('id', '')) or not free_price(model.get('pricing')):
            raise SandpiError('invalid model in cached free catalog', 78)
        expected = pi_transport(model['id'])
        if model.get('pi_api') not in PI_APIS or model.get('pi_api') != expected['api'] or \
                model.get('pi_base_url') != expected['base_url'] or model.get('transport_policy') != expected['policy']:
            raise SandpiError('cached free-model transport evidence mismatch', 78)
        created = model.get('created_at')
        if created is not None and (type(created) is not int or not CREATED_MIN <= created <= CREATED_MAX):
            raise SandpiError('cached free-model catalog-added timestamp is invalid', 78)
    return value


def load(root: Path, *, refresh: bool = False, offline: bool = False,
         fetcher: Callable[[], dict] = fetch, now: float | None = None) -> dict:
    now = time.time() if now is None else now
    prior = cached(root)
    age = now - prior.get('fetched_at', 0) if prior else float('inf')
    if offline:
        if not prior:
            raise SandpiError('no cached free catalog; run sandpi models --refresh', 66)
        return runtime_snapshot({**prior, 'stale': age > TTL, 'offline': True}, now=now)
    if prior and not refresh and 0 <= age <= TTL:
        return runtime_snapshot({**prior, 'stale': False}, now=now)
    try:
        with file_lock(root / 'models/catalog.lock', timeout=15):
            latest = cached(root)
            if latest and not refresh and 0 <= now - latest['fetched_at'] <= TTL:
                return runtime_snapshot({**latest, 'stale': False}, now=now)
            new = fetcher()
            if new.get('schema') != SCHEMA or digest(new['models']) != new.get('fingerprint'):
                raise SandpiError('invalid catalog refresh result', 78)
            if latest is not None:
                # Preserve the exact last successfully published snapshot before
                # replacing it. One bounded predecessor is enough for an explicit
                # local delta without creating a watcher or catalog-history store.
                atomic_json(root / FREE_PREVIOUS_CACHE, latest)
            published = _published_snapshot(new, latest)
            atomic_json(root / FREE_CACHE, published)
            return runtime_snapshot({**published, 'stale': False}, now=now)
    except SandpiError:
        if prior and not refresh and 0 <= age <= MAX_STALE:
            return runtime_snapshot({**prior, 'stale': True, 'refresh_failed': True}, now=now)
        raise


def pi_definition(model: dict, *, recipe: dict | None = None) -> dict:
    # Match Pi's native OpenRouter transport policy before applying the
    # smallest safe request-shape overrides for zero-price exact routes.
    expected = pi_transport(model.get('id'))
    api = model.get('pi_api', expected['api'])
    base_url = model.get('pi_base_url', expected['base_url'])
    if api != expected['api'] or base_url != expected['base_url']:
        raise SandpiError('OpenRouter catalog transport does not match the pinned Pi policy', 78)

    parameters = set(model.get('supported_parameters', []))
    level_map = thinking_level_map(model)
    selectable_reasoning = pi_reasoning_selectable(model)
    paid = not free_price(model.get('pricing'))
    if paid and not priced_price(model.get('pricing')):
        raise SandpiError('paid OpenRouter model has no usable price metadata', 78)
    limit = (recipe or {}).get('max_output_tokens', 32768) if paid else 8192
    definition = {'id': model['id'], 'name': model['name'], 'api': api,
            'baseUrl': base_url, 'reasoning': selectable_reasoning,
            'input': model['input'], 'contextWindow': model['contextWindow'],
            'maxTokens': min(model['maxTokens'], max(256, model['contextWindow'] // 3), limit),
            'cost': price_estimate(model['pricing']) if paid else {'input': 0, 'output': 0, 'cacheRead': 0, 'cacheWrite': 0}}
    if api == 'openai-completions':
        # Optional SDK fields can eliminate every free endpoint under strict
        # parameter routing. Keep the generic adapter's request minimal.
        max_field = ('max_completion_tokens'
                     if 'max_completion_tokens' in parameters and 'max_tokens' not in parameters
                     else 'max_tokens')
        definition['compat'] = {
            # Usage is automatic on OpenRouter; deprecated opt-ins add no capability.
            'supportsUsageInStreaming': False,
            'supportsStore': False,
            **({} if paid else {'supportsLongCacheRetention': False}),
            'supportsReasoningEffort': selectable_reasoning,
            'thinkingFormat': 'openrouter',
            'maxTokensField': max_field,
        }
    else:
        # Pi's Anthropic adapter already knows OpenRouter's native Messages
        # dialect, including signed thinking and tool blocks. Only decline the
        # optional long-cache TTL for free routes. Paid routes retain Pi's
        # native capabilities and explicit user cache-retention choice.
        definition['compat'] = {} if paid else {'supportsLongCacheRetention': False}
    if level_map:
        definition['thinkingLevelMap'] = level_map
    if paid:
        # Paid calls retain normal short-cache behavior and usage accounting.
        # Long-TTL writes are deliberately opt-in through native Pi configuration.
        definition['compat']['sendSessionAffinityHeaders'] = True
        definition['compat']['sessionAffinityFormat'] = 'openrouter'
    return definition


def compaction_profile(model: dict) -> dict:
    window = model['contextWindow']
    paid = not free_price(model.get('pricing', {'prompt': '0', 'completion': '0'}))
    reserve = min(32768 if paid else 8192, max(256, window // 5), model['maxTokens'])
    recent = min(20000 if paid else 12000, max(256, window // 3))
    return {'reserveTokens': reserve, 'keepRecentTokens': recent}


def rank(models: list[dict], grades: dict | None = None, *, blocked: set[str] | None = None,
         health: dict[str, dict[str, Any]] | None = None, now: float | None = None) -> list[dict]:
    """Rank tool-capable free routes using coding evidence plus passive health.

    A hard model cooldown excludes a route. Passive health never does: an
    actively degraded model moves behind every nondegraded candidate, while a
    recent success is only a tie-breaker among equally capable routes. Exact
    selection and native resume do not call this function.
    """
    grades = grades or {}
    blocked = blocked or set()
    health = health or {}
    now = time.time() if now is None else now

    def key(model: dict) -> tuple[Any, ...]:
        route = health.get(model['id'], {})
        until = route.get('degraded_until')
        degraded = (until > now if type(until) in (int, float) and math.isfinite(until)
                    else bool(route.get('degraded')))
        recent_success = route.get('state') == 'healthy' and not route.get('stale', False)
        return (int(degraded), -grades.get(model['id'], {}).get('floor', 0),
                -int(recent_success), -int(model['reasoning']),
                -min(model['contextWindow'], 131072), model['id'])

    return sorted((m for m in models if m.get('auto_eligible') and
                   model_lifecycle(m, now=now)['state'] == 'active' and m['id'] not in blocked), key=key)


# Paid discovery is a separate cache, not a relaxation of the free catalog.
