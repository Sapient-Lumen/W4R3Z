            if manifest['source']['checkpoint']:
                print(f'  checkpoint    {manifest["source"]["checkpoint"]}')
            print(f'  disk          {result["disk"]["logical_bytes"] / GIB:.1f} GiB sparse capacity')
            print(f'  Nix closure   {result["nix"]["path_count"]} paths; {result["nix"]["store_mode"]}')
