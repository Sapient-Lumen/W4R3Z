                ('cli',lambda:run_cli_contracts(pi,root/'cli',out)),
                ('handoff-projection',lambda:run_native_handoff(pi,root/'native-handoff',out)),
                ('verification-resources',lambda:run_native_verification(pi,root/'native-verification',out)),
                ('native-choices',lambda:run_native_choices(pi,service,root/'native-choices',out))]
        if scope=='loop':
