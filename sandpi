    data['room_selection'] = active
    data['command_choice'] = {
        'selected_name': selected,
        'source': 'explicit-name' if args.name is not None else active['source'],
        'override': args.name is not None,
    }
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    elif not data['rooms']:
        print('No persistent Sandpi rooms for this project.')
        print(f'Plain sandpi currently resolves to {active["selected_name"]!r} ({active["source"]}).')
    else:
        for row in data['rooms']:
            marker = '*' if row['active'] else '>' if row['selected'] else ' '
            if row['active'] and row['selected'] and args.name is not None:
                marker = '#'
            disk = row['disk']
            gib = disk['logical_bytes'] / GIB if disk['exists'] else 0
            lineage = row.get('clone_lineage') or {}
            cloned = ''
            if lineage:
                source = lineage['source_name']
                checkpoint = lineage.get('source_checkpoint')
                cloned = f'  clone={source}' + (f'@{checkpoint}' if checkpoint else '')
            imported = ''
            import_lineage = row.get('import_lineage') or {}
            if import_lineage:
                source = import_lineage['source_name']
                checkpoint = import_lineage.get('source_checkpoint')
                imported = f'  imported={source}' + (f'@{checkpoint}' if checkpoint else '')
            renamed = ''
            last_rename = row.get('last_rename') or {}
            if last_rename:
                renamed = f'  renamed={last_rename["source_name"]}'
            print(f'{marker} {row["name"]:<20s} {row["room_id"]}  {row["state"]:<8s}  disk={gib:.1f}GiB  checkpoints={row["checkpoint_count"]}{cloned}{imported}{renamed}')
        if not data['active_exists']:
            print(f'! saved room selection {active["selected_name"]!r} is missing; choose an existing room with `sandpi use NAME` or reset with `sandpi use --reset`.')
        if data['issues']:
            print(f'Ignored {len(data["issues"])} unrelated or invalid room entr' +
                  ('y.' if len(data['issues']) == 1 else 'ies.'))
        print('* active plain-entry room; > one-command --name override; # both. Rooms share the live host project but keep separate guest disks and Pi state.')
    return 0


def use_settings(args: argparse.Namespace) -> int:
    """Inspect or change the host-only default named room for plain entry."""
    import project as project_state
    import rooms as room_state
    import roomselect

    if args.name is not None:
        raise SandpiError('`sandpi use` changes the persistent selection; do not combine it with the one-command --name override', 64)
    if args.target is not None and args.reset:
        raise SandpiError('choose either a room name or --reset', 64)
    root, _cred, project, _preview = base_locations(args)
    identity = project_state.resolve(root, project)
    project_state.assert_usable(root, project, identity['room_namespace'])
    action: dict[str, Any] | None = None
    room_view: dict[str, Any] | None = None

    if args.target is not None:
        target = checked_name(args.target)
        plan = {'root': str(root), 'project': str(project),
                'project_anchor': identity['room_namespace'], 'project_identity': {}}
        prepare_project_identity(args, plan)
        identity = project_state.load(project)
        room_view = room_state.project_room(root, project, identity['room_namespace'], target)
        selected = roomselect.save(project, identity['room_namespace'], target, revision=REVISION)
        action = {'schema': 'sandpi.room-use.v1', 'action': 'select',
                  'room': {'name': target, 'room_id': room_view['room_id']},
                  'selection': selected}
    elif args.reset:
        if identity.get('persisted'):
            action = roomselect.reset(project, identity['room_namespace'], revision=REVISION)
        else:
            action = {'schema': 'sandpi.project-room-selection-reset.v1',
                      'selected_name': roomselect.DEFAULT_ROOM, 'persisted': False,
                      'removed': False, 'at': timestamp(), 'revision': REVISION}

    current = roomselect.load(project, identity['room_namespace'])
    data = room_state.list_project(root, project, identity['room_namespace'],
                                   selected_name=current['selected_name'],
                                   active_name=current['selected_name'])
    result = {'schema': 'sandpi.room-use-view.v1', 'project': str(project),
              'selection': current, 'active_exists': data['active_exists'],
              'rooms': [{'name': row['name'], 'room_id': row['room_id'],
                         'state': row['state']} for row in data['rooms']]}
    if action is not None:
        result['action'] = action
    if room_view is not None:
        result['room'] = {key: room_view[key] for key in
                          ('name', 'room_id', 'state', 'process_alive', 'disk')}
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        state = 'saved preference' if current['persisted'] else 'implicit default'
        print(f'Plain sandpi room: {current["selected_name"]} ({state})')
        if current['persisted'] and not data['active_exists']:
            print('The selected room is missing. Choose an existing room or run `sandpi use --reset`.')
        elif data['active_exists']:
            row = next(item for item in data['rooms'] if item['name'] == current['selected_name'])
            print(f'  room_id  {row["room_id"]}')
            print(f'  state    {row["state"]}')
        print('An explicit --name overrides this for one command and never changes the saved preference.')
    return 0


def clone_room(args: argparse.Namespace) -> int:
    """Clone the stopped selected room into a new named room."""
    import project as project_state
    import rooms as room_state
    import roomselect

    root, _cred, project, _preview = base_locations(args)
    identity = project_state.resolve(root, project)
    project_state.assert_usable(root, project, identity['room_namespace'])
    source_name = _resolve_room_choice(args, root, project, identity['room_namespace'])
    # A mutating room operation must publish/revalidate the same stable anchor
    # and central binding used by launch. Reuse the existing transactional path.
    plan = {'root': str(root), 'project': str(project),
            'project_anchor': identity['room_namespace'], 'project_identity': {}}
    prepare_project_identity(args, plan)
    receipt = room_state.clone(root, project, plan['project_anchor'],
                               source_name=source_name, target_name=args.target,
                               checkpoint=args.checkpoint)
    receipt['activated'] = False
    if args.activate:
        try:
            receipt['selection'] = roomselect.save(
                project, plan['project_anchor'], receipt['target']['name'], revision=REVISION)
            receipt['activated'] = True
        except BaseException as error:
            raise SandpiError(
                f'room clone {receipt["target"]["name"]!r} was published, but selecting it failed: {error}. '
                f'Use `sandpi use {receipt["target"]["name"]}` after inspecting the room.', 74) from error
    if args.json:
        print(json.dumps(receipt, indent=2, sort_keys=True))
    else:
        source = receipt['source']
        checkpoint = f' checkpoint={source["checkpoint"]}' if source.get('checkpoint') else ''
        disk = receipt['disk']
        print(f'Cloned room {source["name"]}{checkpoint} -> {receipt["target"]["name"]}')
        print(f'  disk          {disk["logical_bytes"] / GIB:.1f} GiB via {disk["method"]}')
        print('  copied        guest Pi sessions, packages, guest-local Nix state')
        print('  shared        the same live host project and canonical credentials')
        print('  not copied    host session observations, checkpoints, logs, active entries, TCP/UDP forwards')
        if receipt['activated']:
            print('  selected      plain sandpi now enters this clone')
        else:
            print(f'Enter it once with `sandpi --name {receipt["target"]["name"]}` or make it the default with `sandpi use {receipt["target"]["name"]}`.')
    return 0


def rename_room(args: argparse.Namespace) -> int:
