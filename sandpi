            # a separate suite, never a replacement full-pass receipt.
            phases += [
                ('runtime-retention',lambda:run_native_retention(pi,service,root/'runtime-retention',out)),
                ('credential-recovery',lambda:run_native_credential_recovery(pi,root/'native-credentials',out)),
                ('settings',lambda:run_native_settings(pi,root/'native-settings',out)),
                ('models',lambda:run_native_models(pi,root/'native-models',out)),
