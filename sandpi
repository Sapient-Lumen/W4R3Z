#!/usr/bin/env python3
"""Validate native Pi JSONL completion, never count an echoed prompt as an answer.

Pinned protocol: Pi 1.1.0 docs/json.md. Split bytes on LF only. Receipts contain
model identities, counts and numeric usage, not prompts, tool arguments or keys.
"""
from __future__ import annotations
import argparse
import hashlib
import json
from pathlib import Path
from typing import Any, BinaryIO, Iterator


class ReceiptError(ValueError):
    pass


def records(stream: BinaryIO) -> Iterator[dict[str, Any]]:
    # Binary iteration/readline recognizes LF only (not Unicode U+2028/U+2029).
    for number, line in enumerate(stream, 1):
        if not line.endswith(b'\n'):
            raise ReceiptError(f'unterminated JSONL record {number}')
        if len(line) > 32 * 1024 * 1024:
            raise ReceiptError(f'oversized JSONL record {number}')
        try:
            value = json.loads(line)
        except (ValueError, UnicodeError) as exc:
            raise ReceiptError(f'invalid JSONL record {number}') from exc
        if not isinstance(value, dict) or not isinstance(value.get('type'), str):
            raise ReceiptError(f'not a typed JSON object at record {number}')
        yield value


def text_of(message: dict[str, Any]) -> str:
    content = message.get('content', [])
    if not isinstance(content, list):
        raise ReceiptError('assistant content is not a block array')
    return ''.join(item.get('text', '') for item in content
                   if isinstance(item, dict) and item.get('type') == 'text'
                   and isinstance(item.get('text'), str))


def validate(stream: BinaryIO, *, marker: str, require_tools: tuple[str, ...] = (),
             require_header: bool = True) -> dict[str, Any]:
    last: dict[str, Any] | None = None
    settled = False
    settled_aborted: bool | None = None
    seen_header = False
    starts: dict[str, str] = {}
    ended: set[str] = set()
    tools: dict[str, int] = {}
    messages = count = 0
    models: set[tuple[str, str]] = set()
    usage: dict[str, float] = {}
    for event in records(stream):
        kind = event['type']
        count += 1
        if count == 1 and require_header and kind != 'session':
            raise ReceiptError('JSON mode must begin with a session header')
        if kind == 'session':
            if seen_header or count != 1:
                raise ReceiptError('unexpected duplicate/noninitial session header')
            seen_header = True
        if kind in ('agent_start', 'auto_retry_start', 'compaction_start', 'turn_start'):
            settled = False
        if kind == 'agent_settled':
            if type(event.get('aborted')) is not bool:
                raise ReceiptError('agent_settled omitted its native aborted outcome')
            settled = True
            settled_aborted = event['aborted']
        if kind == 'tool_execution_start':
            call, tool = event.get('toolCallId'), event.get('toolName')
            if not isinstance(call, str) or not isinstance(tool, str) or call in starts:
                raise ReceiptError('missing or duplicate tool execution identity')
            starts[call] = tool
            settled = False
        if kind == 'tool_execution_end':
            call, tool = event.get('toolCallId'), event.get('toolName')
            if not isinstance(call, str) or starts.get(call) != tool or call in ended:
                raise ReceiptError('tool completion does not match its start')
            if event.get('isError') is not False:
                raise ReceiptError('tool execution reported failure or omitted outcome')
            ended.add(call)
            tools[tool] = tools.get(tool, 0) + 1
        if kind == 'message_end':
            message = event.get('message', {})
            if not isinstance(message, dict):
                raise ReceiptError('invalid completed message')
            if message.get('role') == 'assistant':
                messages += 1
                last = message
                settled = False
                model, provider = message.get('model'), message.get('provider')
                if isinstance(model, str) and isinstance(provider, str):
                    models.add((provider, model))
                for key, value in message.get('usage', {}).items():
                    if key in ('input', 'output', 'cacheRead', 'cacheWrite', 'totalTokens') and type(value) in (int, float):
                        usage[key] = usage.get(key, 0) + value
        if kind == 'response' and event.get('success') is False:
            raise ReceiptError('RPC command failed')
    if require_header and not seen_header:
        raise ReceiptError('missing JSON session header')
    if last is None:
        raise ReceiptError('no authoritative completed assistant message')
    if not settled:
        raise ReceiptError('agent_settled missing after the final work')
    if settled_aborted:
        raise ReceiptError('agent settled because the run was aborted')
    if set(starts) != ended:
        raise ReceiptError('one or more tool executions did not complete')
    # A toolUse response is not the final answer, even if it contains the marker.
    if last.get('stopReason') not in ('stop', 'length'):
        raise ReceiptError('final assistant message is not a successful completion')
    answer = text_of(last).strip()
    if answer != marker:
        raise ReceiptError('final assistant text does not exactly match expected marker')
    if not models:
        raise ReceiptError('stream does not identify an actual provider/model')
    missing = set(require_tools) - set(tools)
    if missing:
        raise ReceiptError('required tools did not complete: ' + ', '.join(sorted(missing)))
    return {'schema': 'sandpi.pi-receipt.v1', 'status': 'passed', 'record_count': count,
            'assistant_messages': messages, 'settled': settled, 'aborted': False, 'completed_tools': tools,
            'models': [{'provider': p, 'model': m} for p, m in sorted(models)], 'usage': usage,
            'final_text_sha256': hashlib.sha256(answer.encode()).hexdigest()}


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('stream', type=Path)
    p.add_argument('--marker', required=True)
    p.add_argument('--require-tool', action='append', default=[])
    p.add_argument('--output', type=Path)
    a = p.parse_args()
    try:
