        info = regular(path)
        result[label] = {'exists': True, 'logical_bytes': info.st_size,
                         'allocated_bytes': info.st_blocks * 512}
    if manifest is not None:
        expected = manifest['rollback_disk']['logical_bytes']
        for label in ('current', 'rollback', 'forward'):
            if result[label]['exists'] and result[label]['logical_bytes'] != expected:
                result[label]['capacity_mismatch'] = True
    return result


def _public_manifest(manifest: dict[str, Any] | None) -> dict[str, Any] | None:
    if manifest is None:
        return None
    fields = ('schema', 'id', 'room_id', 'stage', 'source_contract', 'target_contract',
              'source_revision', 'prepared_at', 'prepared_revision', 'rollback_disk',
              'scope', 'first_boot_run_id', 'boot_started_at', 'last_boot_run_id',
              'last_boot_started_at', 'ready_at', 'ready_run_id', 'failed_at',
              'failure', 'rollback_started_at', 'rolled_back_at', 'rollback_from_stage',
              'forward_started_at', 'forwarded_at', 'superseded_by')
    result = {key: manifest[key] for key in fields if key in manifest and manifest[key] is not None}
    if manifest.get('_disk_state') is not None:
        result['disk_state'] = manifest['_disk_state']
        result['rollback_recovery_required'] = manifest['_disk_state'] != 'normal'
    return result


def preview(room: Path, target_contract: dict[str, Any]) -> dict[str, Any]:
    """Read-only launch preview; never creates state or snapshots."""
    target = validate_contract(target_contract)
    target_id = contract_digest(target)
    disk = room / 'root.raw'
    if disk.is_symlink():
        raise SandpiError('guest disk cannot be a symlink', 78)
    active = read_active(room) if (_active_path(room).exists() or _active_path(room).is_symlink()) else None
    current = _runtime_from_room(room) if room.exists() and not room.is_symlink() else None
    if active is not None:
        same = contract_digest(active['target_contract']) == target_id
        if active['stage'] == 'ready-committing':
            action = 'finish-ready-commit'
        elif active['stage'] == 'rolled-back':
            action = ('restore-forward-or-accept-rollback'
                      if active.get('rollback_from_stage') == 'ready'
                      else 'accept-rollback-or-retry')
        elif active.get('_disk_state') != 'normal':
            action = ('complete-interrupted-forward' if active['stage'].startswith('forward-')
                      else 'complete-interrupted-rollback')
        elif same and active['stage'] == 'ready':
            action = 'ready-rollback-retained'
        elif same and active['stage'] == 'prepared':
            action = 'resume-prepared-upgrade'
        elif same:
            action = 'blocked-active-upgrade'
        elif active['stage'] == 'ready':
            action = 'supersede-ready-upgrade'
        else:
            action = 'blocked-active-upgrade'
    elif not disk.exists():
        action = 'initialize-on-first-ready-boot'
    elif current is not None and contract_digest(current) == target_id:
        action = 'current'
    else:
        action = 'create-cold-rollback-before-boot'
    return {
        'schema': STATUS_SCHEMA,
        'room_id': room.name,
        'target_contract': target,
        'target_contract_sha256': target_id,
        'stored_contract': current,
        'stored_contract_sha256': contract_digest(current) if current is not None else None,
        'disk_exists': disk.is_file(),
        'action': action,
        'active': _public_manifest(active),
        'disks': _disk_layout(room, active) if active is not None else None,
    }


def _remove_tree(path: Path) -> None:
    if path.is_symlink() or not path.is_dir():
        raise SandpiError('room upgrade cleanup target is unsafe', 78)
    _active_entries(path)
    shutil.rmtree(path)
    sync_dir(path.parent)


def _retired_slots(area: Path) -> list[Path]:
    if not area.exists() and not area.is_symlink():
        return []
    _owned_directory(area, label='room upgrade area')
    result: list[Path] = []
    for child in area.iterdir():
        if RETIRED_SLOT.fullmatch(child.name):
            _owned_directory(child, label='retired room upgrade slot')
            _active_entries(child)
            result.append(child)
    return sorted(result, key=lambda item: item.name)


def _cleanup_retired(area: Path) -> int:
    retired = _retired_slots(area)
    for path in retired:
        _remove_tree(path)
    return len(retired)


def _preparing_slots(area: Path) -> list[Path]:
    """Return interrupted private staging directories.

    ``prepare_for_launch()`` publishes by one directory rename.  A hard process
    death before that rename may leave a private ``.preparing-*`` directory,
    but it can never be authoritative because ``active/upgrade.json`` was not
    published.  The next stopped-room preparation may remove such bounded
    staging state while holding ``upgrade.lock``.
    """
    if not area.exists() and not area.is_symlink():
        return []
    _owned_directory(area, label='room upgrade area')
    result: list[Path] = []
    for child in area.iterdir():
        if PREPARING_SLOT.fullmatch(child.name):
            _owned_directory(child, label='interrupted room upgrade staging slot')
            _active_entries(child)
            result.append(child)
    return sorted(result, key=lambda item: item.name)


def _cleanup_preparing(area: Path) -> int:
    preparing = _preparing_slots(area)
    for path in preparing:
        _remove_tree(path)
    return len(preparing)


def _receipt_path(area: Path, txid: str, action: str) -> Path:
    receipts = _owned_directory(area / 'receipts', label='room upgrade receipts', create=True)
    path = receipts / f'{txid}-{action}.json'
    if path.exists() or path.is_symlink():
        # Same action is idempotent. The existing bounded receipt is returned by
        # its caller; never overwrite a different writer's evidence.
        _owned_regular(path, label='room upgrade receipt')
        return path
    return path


def _write_receipt(area: Path, txid: str, filename_action: str,
                   receipt: dict[str, Any]) -> dict[str, Any]:
    """Publish one idempotent receipt and return its authoritative value.

    A process may die after publishing a receipt but before renaming/removing
    the active slot.  Repeating the operator action must continue from that
    point without rewriting the earlier evidence or accepting a colliding file.
    """
    path = _receipt_path(area, txid, filename_action)
    if path.exists() or path.is_symlink():
        _owned_regular(path, label='room upgrade receipt')
        existing = read_json(path)
        if not isinstance(existing, dict) or existing.get('schema') != RECEIPT_SCHEMA or \
                existing.get('room_id') != receipt.get('room_id') or \
                existing.get('transaction_id') != txid or \
                existing.get('action') != receipt.get('action'):
            raise SandpiError('existing room upgrade receipt conflicts with the requested action', 78)
        return existing
    atomic_json(path, receipt)
    return receipt


def _prune_receipts(area: Path) -> None:
    receipts = area / 'receipts'
    if not receipts.exists() and not receipts.is_symlink():
        return
    _owned_directory(receipts, label='room upgrade receipts')
    files: list[tuple[int, str, Path]] = []
    for child in receipts.iterdir():
        info = _owned_regular(child, label='room upgrade receipt')
        files.append((info.st_mtime_ns, child.name, child))
    for _mtime, _name, child in sorted(files)[:-MAX_RECEIPTS]:
        child.unlink()
    sync_dir(receipts)


def _accept_locked(room: Path, manifest: dict[str, Any], *, reason: str,
                   superseded_by: str | None = None) -> dict[str, Any]:
    stage = manifest['stage']
    disk_state = manifest.get('_disk_state')
    if stage == 'ready' and disk_state == 'normal':
        accepted_state = 'target'
        rollback_removed = True
        forward_removed = False
    elif stage == 'rolled-back' and disk_state == 'rollback-restored':
        accepted_state = 'source'
        rollback_removed = False
        forward_removed = True
    else:
        raise SandpiError(
            'only a ready target or a completed rollback can be accepted; '
            'resolve incomplete upgrade state first', 75)
    area = _area(room)
    active = _active_path(room)
    at = timestamp()
    receipt = {
        'schema': RECEIPT_SCHEMA, 'action': 'accept', 'reason': reason,
        'accepted_state': accepted_state,
        'room_id': room.name, 'transaction_id': manifest['id'], 'at': at,
        'source_contract': manifest.get('source_contract'),
        'target_contract': manifest['target_contract'],
        'rollback_disk_removed': rollback_removed,
        'forward_disk_removed': forward_removed,
        'current_guest_disk_kept': True,
        'newer_guest_state_discarded': accepted_state == 'source',
        'workspace_changed': False, 'credentials_changed': False,
        'superseded_by': superseded_by,
    }
    receipt_path = _receipt_path(area, manifest['id'], 'accepted')
    receipt_preexisted = receipt_path.exists() or receipt_path.is_symlink()
    receipt = _write_receipt(area, manifest['id'], 'accepted', receipt)
    retired = area / f'.accepted-{manifest["id"]}-{time.time_ns()}'
    os.rename(active, retired)
    sync_dir(area)
    try:
        _remove_tree(retired)
    except BaseException:
        if not active.exists() and retired.exists():
            os.rename(retired, active)
            sync_dir(area)
        if not receipt_preexisted:
            with contextlib.suppress(FileNotFoundError):
                receipt_path.unlink()
        raise
    _prune_receipts(area)
    return receipt


def prepare_for_launch(room: Path, target_contract: dict[str, Any]) -> dict[str, Any]:
    """Prepare or reuse one cold upgrade rollback slot.

    The caller must already hold the room preparation lock and have established
    that no supervisor is alive.  This function adds its own short upgrade lock
    so supervisor readiness/failure publication cannot race the manifest.
    """
    target = validate_contract(target_contract)
    target_id = contract_digest(target)
    if room.is_symlink() or not room.is_dir() or room.name == '' or not ROOM_ID.fullmatch(room.name):
        raise SandpiError('runtime upgrade target is not a canonical room directory', 78)
    with file_lock(room / 'upgrade.lock'):
        area_existing = room / AREA_NAME
        if area_existing.exists() and not area_existing.is_symlink():
            _cleanup_retired(area_existing)
            _cleanup_preparing(area_existing)
        active = read_active(room)
        if active is not None:
            # Guest readiness was already proven before this durable stage was
            # published. A hard process death may leave the exact room metadata
            # commit unfinished; complete it idempotently before deciding
            # whether this or a newer runtime should launch.
            if active['stage'] == 'ready-committing':
                run_id = active.get('ready_run_id') or active.get('last_boot_run_id')
                if not run_id:
                    raise SandpiError('ready runtime upgrade lacks its guest-readiness run ID', 78)
                _finish_ready_commit_locked(room, active, active['target_contract'], run_id)
                active = read_active(room)
                assert active is not None
            if active['stage'] == 'rolled-back':
                next_action = ('`sandpi upgrade forward --yes` or `sandpi upgrade accept --yes`'
                               if active.get('rollback_from_stage') == 'ready'
                               else '`sandpi upgrade accept --yes` or `sandpi upgrade retry --yes`')
                raise SandpiError(
                    f'the room is on its rolled-back source disk; choose {next_action} before '
                    'launching this runtime', 75)
            if active.get('_disk_state') != 'normal':
                command = 'forward' if active['stage'].startswith('forward-') else 'rollback'
                raise SandpiError(
                    'an interrupted runtime disk switch must be completed with '
                    f'`sandpi upgrade {command} --yes` before launching', 75)
            active_target = contract_digest(active['target_contract'])
            if active_target == target_id:
                if active['stage'] in {'prepared', 'ready'}:
                    return {'schema': 'sandpi.room-upgrade-prepare.v1', 'action': 'reuse',
                            'transaction': _public_manifest(active)}
                raise SandpiError(
                    f'room runtime upgrade is {active["stage"]}; inspect `sandpi upgrade` and choose '
                    '`sandpi upgrade rollback --yes` or `sandpi upgrade retry --yes` before launching', 75)
            if active['stage'] == 'ready':
                _accept_locked(room, active, reason='superseded-by-newer-runtime', superseded_by=target_id)
                active = None
            else:
                raise SandpiError(
                    f'room has an unresolved {active["stage"]} runtime upgrade for another revision; '
                    'resolve it with `sandpi upgrade` before launching this runtime', 75)

        disk = room / 'root.raw'
        if not disk.exists() and not disk.is_symlink():
            return {'schema': 'sandpi.room-upgrade-prepare.v1', 'action': 'new-room',
                    'transaction': None}
        regular(disk)
        current = _runtime_from_room(room)
        if current is not None and contract_digest(current) == target_id:
            return {'schema': 'sandpi.room-upgrade-prepare.v1', 'action': 'current',
                    'transaction': None}

        area = _area(room, create=True)
        active_path = area / ACTIVE_NAME
        if active_path.exists() or active_path.is_symlink():
            raise SandpiError('room upgrade slot appeared during preparation', 75)
        present, metadata = _room_metadata_bytes(room)
        txid = sha256((room.name + '\0' + (contract_digest(current) if current else 'legacy') +
                       '\0' + target_id + '\0' + str(time.time_ns()) + '\0' + str(os.getpid())).encode())[:32]
        staging = Path(tempfile.mkdtemp(prefix='.preparing-', dir=area))
        staging.chmod(0o700)
        published = False
        try:
            copied = sparse_copy(disk, staging / 'rollback.raw')
            if present:
                atomic_write(staging / 'room-before.json', metadata, 0o600)
            source_meta = json.loads(metadata) if present else {}
            source_revision = source_meta.get('last_revision') if isinstance(source_meta, dict) else None
            if type(source_revision) is not int or source_revision < 0:
                source_revision = None
            manifest = validate_manifest({
                'schema': TRANSACTION_SCHEMA,
                'id': txid,
                'room_id': room.name,
                'stage': 'prepared',
                'source_contract': current,
                'target_contract': target,
                'source_room_present': present,
                'source_room_sha256': sha256(metadata),
                'source_revision': source_revision,
                'prepared_at': timestamp(),
                'prepared_revision': REVISION,
                'rollback_disk': copied,
                'scope': {
                    'guest_disk': True, 'room_metadata': True,
                    'cloud_hypervisor_ram': False, 'workspace': False,
                    'credentials': False, 'pi_sessions_outside_guest': False,
                    'guest_local_pi_state': True, 'guest_packages_and_config': True,
                    'portable': False,
                },
            })
            atomic_json(staging / 'upgrade.json', manifest)
            sync_dir(staging)
            os.rename(staging, active_path)
            sync_dir(area)
            published = True
            manifest['_path'] = str(active_path)
            manifest['_entries'] = sorted(_active_entries(active_path))
            return {'schema': 'sandpi.room-upgrade-prepare.v1', 'action': 'prepared',
                    'transaction': _public_manifest(manifest)}
        finally:
            if not published and staging.exists():
                shutil.rmtree(staging)
                sync_dir(area)


def mark_booting(room: Path, transaction_id: str | None, run_id: str) -> dict[str, Any] | None:
    if transaction_id is None:
        return None
    if not isinstance(transaction_id, str) or not TX_ID.fullmatch(transaction_id):
        raise SandpiError('launch has an invalid runtime-upgrade transaction ID', 78)
    run_id = _short_string(run_id, 'boot run ID', maximum=128)
    with file_lock(room / 'upgrade.lock'):
        manifest = read_active(room)
        if manifest is None or manifest['id'] != transaction_id:
            raise SandpiError('runtime-upgrade transaction changed before boot', 75)
        if manifest.get('_disk_state') != 'normal':
            raise SandpiError('runtime-upgrade disk swap is incomplete; complete rollback before boot', 75)
        active = _active_path(room)
        now = timestamp()
        if manifest['stage'] == 'prepared':
            manifest = _write_manifest(active, manifest, stage='booting',
                                       first_boot_run_id=manifest.get('first_boot_run_id') or run_id,
                                       boot_started_at=manifest.get('boot_started_at') or now,
                                       last_boot_run_id=run_id, last_boot_started_at=now)
        elif manifest['stage'] == 'ready':
            # Once one boot reached guest readiness, later ordinary boots do not
            # revoke the qualified rollback point.
            manifest = _write_manifest(active, manifest,
                                       last_boot_run_id=run_id, last_boot_started_at=now)
        else:
            raise SandpiError(f'runtime-upgrade transaction cannot boot from stage {manifest["stage"]}', 75)
        return _public_manifest(manifest)


def _commit_runtime_metadata(room: Path, target: dict[str, Any], *, ready_at: str) -> dict[str, Any]:
    """Atomically publish the target contract after guest command readiness.

    This write deliberately precedes the final ``ready`` manifest stage. If a
    process dies after either atomic publication, ``ready-committing`` remains
    sufficient evidence to finish the host metadata commit on the next stopped
    launch without booting or guessing.
    """
    import machine

    metadata = machine.read_metadata(room)
    metadata.update({
        'runtime_contract': target,
        'last_revision': target['sandpi_revision'],
        'last_attempted_revision': target['sandpi_revision'],
        'last_successful_boot_at': ready_at,
    })
    atomic_json(room / 'room.json', metadata)
    return metadata


def _finish_ready_commit_locked(room: Path, manifest: dict[str, Any],
                                target: dict[str, Any], run_id: str) -> tuple[dict[str, Any], str]:
    """Finish the two-publication readiness commit while ``upgrade.lock`` is held."""
    target = validate_contract(target)
    if contract_digest(manifest['target_contract']) != contract_digest(target):
        raise SandpiError('runtime-upgrade target changed before guest readiness commit', 75)
    active = _active_path(room)
    stage = manifest['stage']
    if stage == 'booting':
        ready_at = timestamp()
        manifest = _write_manifest(
            active, manifest, stage='ready-committing',
            ready_at=manifest.get('ready_at') or ready_at,
            ready_run_id=manifest.get('ready_run_id') or run_id,
            last_boot_run_id=run_id,
        )
    elif stage == 'ready-committing':
        ready_at = manifest.get('ready_at')
        if not ready_at:
            raise SandpiError('ready runtime upgrade lacks its readiness timestamp', 78)
    elif stage == 'ready':
        # The retained rollback may span many ordinary room boots. Record the
        # latest successful readiness without rewriting the original upgrade
        # qualification timestamp stored in the transaction itself.
        ready_at = timestamp()
    else:
        raise SandpiError(
            f'runtime-upgrade transaction reached readiness from invalid stage {stage}', 78)

    ready_at = manifest.get('ready_at') or ready_at
    _commit_runtime_metadata(room, target, ready_at=ready_at)
    if manifest['stage'] != 'ready':
        manifest = _write_manifest(active, manifest, stage='ready')
    return manifest, ready_at


def mark_ready(room: Path, target_contract: dict[str, Any], transaction_id: str | None,
               run_id: str) -> dict[str, Any]:
    target = validate_contract(target_contract)
    target_id = contract_digest(target)
    run_id = _short_string(run_id, 'ready run ID', maximum=128)
    with file_lock(room / 'upgrade.lock'):
        manifest = read_active(room)
        if transaction_id is not None:
            if manifest is None or manifest['id'] != transaction_id:
                raise SandpiError('runtime-upgrade transaction changed before guest readiness', 75)
            if contract_digest(manifest['target_contract']) != target_id:
                raise SandpiError('runtime-upgrade target changed before guest readiness', 75)
            manifest, now = _finish_ready_commit_locked(room, manifest, target, run_id)
        else:
            # Any active slot, including one for another target, must be named by
            # the launch configuration. Otherwise a stale or corrupted config
            # could commit one runtime while retaining another runtime's
            # rollback evidence.
            if manifest is not None:
                raise SandpiError('runtime-upgrade readiness omitted an active transaction ID', 78)
            now = timestamp()
            _commit_runtime_metadata(room, target, ready_at=now)
        return {'schema': 'sandpi.room-upgrade-ready.v1', 'room_id': room.name,
                'transaction_id': transaction_id, 'runtime_contract': target,
                'at': now, 'rollback_retained': manifest is not None}


def mark_failed(room: Path, transaction_id: str | None, run_id: str, *,
                phase: str, code: int, error_type: str) -> dict[str, Any] | None:
    if transaction_id is None:
        return None
    if not isinstance(transaction_id, str) or not TX_ID.fullmatch(transaction_id):
        return None
    phase = _short_string(phase, 'failure phase', maximum=64)
    error_type = _short_string(error_type, 'failure type', maximum=96)
    code = code if type(code) is int and 0 <= code <= 255 else 1
    with file_lock(room / 'upgrade.lock'):
        manifest = read_active(room)
        if manifest is None or manifest['id'] != transaction_id:
            return None
        if manifest['stage'] == 'ready':
            return _public_manifest(manifest)
        if manifest['stage'] == 'failed':
            # Preserve the first classified failure.  A later systemd wrapper
            # exit is consequence, not a better explanation than the guest or
            # backend failure already recorded by the supervisor.
            return _public_manifest(manifest)
        if manifest['stage'] not in {'prepared', 'booting', 'failed'}:
            return _public_manifest(manifest)
        failed = _write_manifest(_active_path(room), manifest, stage='failed',
                                 failed_at=manifest.get('failed_at') or timestamp(),
                                 last_boot_run_id=run_id,
                                 failure={'phase': phase, 'code': code, 'error_type': error_type})
        return _public_manifest(failed)


def _restore_room_preimage(room: Path, active: Path, manifest: dict[str, Any]) -> None:
    target = room / 'room.json'
    if manifest['source_room_present']:
        raw = (active / 'room-before.json').read_bytes()
        if sha256(raw) != manifest['source_room_sha256']:
            raise SandpiError('room metadata preimage changed before rollback', 78)
        atomic_write(target, raw, 0o600)
    else:
        if target.exists() or target.is_symlink():
            _owned_regular(target, label='room metadata')
            target.unlink()
            sync_dir(room)


def _capture_forward_room_preimage(room: Path, active: Path,
                                    manifest: dict[str, Any]) -> dict[str, Any]:
    """Commit the exact target-side metadata needed to undo a ready rollback."""
    if manifest['stage'] not in {'prepared', 'booting', 'ready-committing', 'ready', 'failed'}:
        raise SandpiError('runtime rollback cannot capture forward metadata from this stage', 75)
    rollback_origin = 'ready' if manifest['stage'] == 'ready-committing' else manifest['stage']
    present, raw = _room_metadata_bytes(room)
    path = active / 'room-forward.json'
    if present:
        atomic_write(path, raw, 0o600)
    elif path.exists() or path.is_symlink():
        _owned_regular(path, label='stale forward room metadata preimage')
        path.unlink()
        sync_dir(active)
    return _write_manifest(
        active, manifest, stage='rollback-moving-current',
        rollback_started_at=manifest.get('rollback_started_at') or timestamp(),
        rollback_from_stage=rollback_origin,
        forward_room_present=present,
        forward_room_sha256=sha256(raw),
        forward_started_at=None,
        forwarded_at=None,
    )


def _restore_forward_room_preimage(room: Path, active: Path, manifest: dict[str, Any]) -> None:
    target = room / 'room.json'
    if manifest.get('forward_room_present') is True:
        path = active / 'room-forward.json'
        raw = path.read_bytes()
        if sha256(raw) != manifest.get('forward_room_sha256'):
            raise SandpiError('forward room metadata preimage changed before restoration', 78)
        atomic_write(target, raw, 0o600)
    elif manifest.get('forward_room_present') is False:
        if target.exists() or target.is_symlink():
            _owned_regular(target, label='room metadata')
            target.unlink()
            sync_dir(room)
    else:
        raise SandpiError('runtime upgrade lacks committed forward metadata', 78)


def _remove_forward_room_preimage(active: Path) -> None:
    path = active / 'room-forward.json'
    if path.exists() or path.is_symlink():
        _owned_regular(path, label='forward room metadata preimage')
        path.unlink()
        sync_dir(active)


def _rollback_locked(room: Path, manifest: dict[str, Any]) -> dict[str, Any]:
    active = _active_path(room)
    if manifest['stage'] == 'rolled-back':
        current = room / 'root.raw'
        rollback = active / 'rollback.raw'
        forward = active / 'forward.raw'
        if not current.exists() or current.is_symlink() or rollback.exists() or rollback.is_symlink() or \
                not forward.exists() or forward.is_symlink():
            raise SandpiError('completed runtime rollback has an inconsistent disk layout', 78)
        if regular(current).st_size != manifest['rollback_disk']['logical_bytes']:
            raise SandpiError('completed runtime rollback disk capacity differs from its manifest', 78)
        regular(forward)
        _restore_room_preimage(room, active, manifest)
        receipt = {
            'schema': RECEIPT_SCHEMA, 'action': 'rollback', 'room_id': room.name,
            'transaction_id': manifest['id'], 'at': manifest.get('rolled_back_at'),
            'already_complete': True, 'forward_disk_retained': True,
            'guest_local_pi_state_reverted_with_disk': True,
            'workspace_changed': False, 'credentials_changed': False,
        }
        published = _write_receipt(_area(room), manifest['id'], 'rolled-back', receipt)
        return {**published, 'already_complete': True}
