sp_main() {
  (( BASH_VERSINFO[0] >= 4 )) || sp_die 'Bash 4 or newer is required'
  sp_bootstrap "$@"
  local base runtime tmp lock_fd destination chosen_home='' word take_home=0
  for word in "$@"; do
    if (( take_home )); then chosen_home=$word; take_home=0; continue; fi
    case "$word" in
      --) break ;;
      --home) take_home=1 ;;
      --home=*) chosen_home=${word#--home=} ;;
    esac
  done
  (( ! take_home )) || sp_die '--home requires a directory'
  base=${chosen_home:-${SANDPI_HOME:-$HOME/.sandstuff/sandpi}}/runtime
  [[ ! -L $base ]] || sp_die 'runtime cache must not be a symlink'
  mkdir -p -- "$base"
  chmod 700 -- "$base"
  runtime=$base/$SP_PAYLOAD_ID
  exec {lock_fd}>"$base/.extract.lock"
  flock "$lock_fd"
  if ! sp_verify "$runtime"; then
    tmp=$(mktemp -d "$base/.extract.XXXXXXXX")
    if ! sp_payload "$tmp" || ! sp_verify "$tmp"; then
      rm -rf -- "$tmp"
      sp_die 'embedded source verification failed'
    fi
    if [[ -e $runtime || -L $runtime ]]; then
      mv -- "$runtime" "$base/.corrupt-$SP_PAYLOAD_ID-$$"
    fi
    mv -- "$tmp" "$runtime"
  fi
  flock -u "$lock_fd"
  exec {lock_fd}>&-
  export PYTHONDONTWRITEBYTECODE=1
  if [[ ${1:-} == unpack ]]; then
    [[ $# == 2 ]] || sp_die 'usage: sandpi unpack NEW_DIRECTORY'
    destination=$2
    [[ ! -e $destination && ! -L $destination ]] || sp_die 'unpack destination must not exist'
    mkdir -p -- "$destination"
    cp -a -- "$runtime/." "$destination/"
    printf '%s\n' "$destination"
    return
  fi
  # Isolated Python ignores ambient PYTHONPATH and site customization. Its only
  # added import directory is the payload that was verified immediately above.
  exec python3 -I -c 'import runpy,sys; root=sys.argv.pop(1); sys.path.insert(0, root+"/src"); sys.argv[0]=root+"/src/host.py"; runpy.run_path(sys.argv[0], run_name="__main__")' "$runtime" "$@"
}
sp_main "$@"
