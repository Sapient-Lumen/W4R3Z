#!/usr/bin/env python3
"""Run Sandpi's offline unittest modules in isolated bounded subprocesses.

A single unittest-discovery process lets module globals, imported extension state,
open descriptors and signal handlers accumulate across hundreds of contracts.
Each test file therefore gets a fresh interpreter. A small worker pool keeps the
standalone selftest practical without changing any test's assertions.
"""
from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from typing import NamedTuple

ROOT = Path(__file__).resolve().parent.parent


class Result(NamedTuple):
    path: Path
    returncode: int
    output: str
    timed_out: bool


def run_one(path: Path, timeout: float) -> Result:
    env = dict(os.environ)
    env['PYTHONPATH'] = os.pathsep.join((str(ROOT / 'src'), str(ROOT / 'tests')))
    env['PYTHONDONTWRITEBYTECODE'] = '1'
    command = [sys.executable, '-m', 'unittest', 'discover', '-s', 'tests',
               '-p', path.name, '-v']
    # Capture into a real file rather than a pipe. Some lifecycle tests
    # intentionally kill a process while a short-lived descendant still owns
    # inherited descriptors. PIPE-based communicate() then waits for that
    # descendant's EOF even though unittest itself has exited. A seekable file
    # preserves complete output without coupling test completion to inherited
    # writer lifetime.
    with tempfile.TemporaryFile() as output_file:
        timed_out = False
        try:
            completed = subprocess.run(
                command,
                cwd=ROOT,
                env=env,
                stdout=output_file,
                stderr=subprocess.STDOUT,
                timeout=timeout,
                check=False,
            )
            returncode = completed.returncode
        except subprocess.TimeoutExpired:
            returncode = 124
            timed_out = True
        output_file.flush()
        output_file.seek(0)
        output = output_file.read().decode(errors='replace')
        if timed_out:
            output += f'\nTIMEOUT after {timeout:.0f}s\n'
        return Result(path, returncode, output, timed_out)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--pattern', default='test_*.py')
    parser.add_argument('--jobs', type=int,
                        default=max(1, min(4, os.cpu_count() or 1)))
    parser.add_argument('--module-timeout', type=float, default=240.0)
    args = parser.parse_args()
    if not 1 <= args.jobs <= 32:
        parser.error('--jobs must be 1..32')
    if not 1 <= args.module_timeout <= 3600:
        parser.error('--module-timeout must be 1..3600 seconds')

    files = sorted((ROOT / 'tests').glob(args.pattern))
    files = [path for path in files if path.is_file() and not path.is_symlink()]
    if not files:
        print(f'sandpi: no tests match {args.pattern!r}', file=sys.stderr)
        return 2

    results: dict[Path, Result] = {}
    with ThreadPoolExecutor(max_workers=args.jobs, thread_name_prefix='sandpi-test') as pool:
        futures = {pool.submit(run_one, path, args.module_timeout): path for path in files}
        for future in as_completed(futures):
            result = future.result()
            results[result.path] = result

    failures = 0
    for path in files:
        result = results[path]
        print(f'\n===== {path.relative_to(ROOT)} =====')
        print(result.output, end='' if result.output.endswith('\n') or not result.output else '\n')
        if result.returncode:
            failures += 1
            print(f'sandpi: {path.name} failed with status {result.returncode}', file=sys.stderr)

    if failures:
        print(f'sandpi: {failures} of {len(files)} offline test modules failed', file=sys.stderr)
