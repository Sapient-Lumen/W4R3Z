from __future__ import annotations
import datetime as dt
import json
import os
from pathlib import Path
import selectors
import shlex
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent


def exercise(command: list[str], directory: Path, *, timeout: float = 900) -> dict:
    transcript = bytearray()
    pending = bytearray()
    response = None
    request_id = 'sandpi-state-before-boot'
    with (directory / 'stderr.log').open('wb') as stderr:
        child = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=stderr, start_new_session=True)
        assert child.stdin is not None and child.stdout is not None
        selector = selectors.DefaultSelector()
        selector.register(child.stdout, selectors.EVENT_READ)
        try:
            child.stdin.write(json.dumps({'type':'get_state','id':request_id}).encode() + b'\n')
            child.stdin.flush()
            deadline = time.monotonic() + timeout
            while selector.get_map():
                if time.monotonic() >= deadline:
                    raise TimeoutError('RPC acceptance deadline exceeded')
                for key, _ in selector.select(.2):
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    transcript.extend(chunk)
                    pending.extend(chunk)
                    if len(transcript) > 32 * 1024 * 1024:
                        raise ValueError('RPC state test emitted excessive output')
                    while b'\n' in pending:
                        line, _, rest = pending.partition(b'\n')
                        pending[:] = rest
                        record = json.loads(line)
                        if not isinstance(record, dict):
                            raise ValueError('RPC emitted a non-object record')
                        if record.get('id') == request_id:
                            if response is not None or record.get('type') != 'response' or record.get('command') != 'get_state' or record.get('success') is not True:
                                raise ValueError('invalid correlated get_state response')
                            if not isinstance(record.get('data'), dict):
                                raise ValueError('get_state omitted state data')
                            response = record
                            # Do not close before the correlated reply: RPC commands
                            # are asynchronous. No prompt is sent anywhere.
                            child.stdin.close()
                if child.poll() is not None and not selector.get_map():
                    break
            code = child.wait(timeout=max(1, deadline - time.monotonic()))
            if pending or response is None or code != 0:
                raise ValueError('incomplete RPC stream, absent state response, or nonzero exit')
            return {'suite':'headless-smoke','status':'passed','exit_code':code,
                    'checks':['preboot-stdin-preserved','LF-jsonl-only','correlated-state',
                              'stdin-eof-shutdown','no-inference-request'],
                    'state_keys':sorted(response['data']),
                    'at':dt.datetime.now(dt.timezone.utc).isoformat()}
        finally:
            selector.close()
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=45)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
            if not child.stdin.closed:
                child.stdin.close()
            child.stdout.close()
            (directory / 'events.jsonl').write_bytes(transcript)


