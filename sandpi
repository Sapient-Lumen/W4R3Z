    if area.is_symlink():
        raise SandpiError('checkpoint directory cannot be a symlink during room rename', 78)
    if not area.exists():
        return 0
    if not area.is_dir():
        raise SandpiError('checkpoint path is not a directory during room rename', 78)
    children: list[Path] = []
    with os.scandir(area) as scan:
        for entry in scan:
            if len(children) >= MAX_CHECKPOINTS:
                raise SandpiError(
                    f'room has more than the fixed {MAX_CHECKPOINTS} checkpoints; refusing rename', 78)
            if not entry.name.startswith('.'):
                children.append(Path(entry.path))
    updated = 0
    for directory in sorted(children, key=lambda item: item.name):
        checked_name(directory.name)
        info = directory.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
            raise SandpiError('checkpoint entry is not a user-owned local directory', 78)
        manifest_path = directory / 'checkpoint.json'
        manifest = _owned_json(manifest_path, label='checkpoint metadata', limit=1024 * 1024)
        if manifest.get('schema') != 'sandpi.checkpoint.v1' or manifest.get('label') != directory.name or \
                manifest.get('room_id') not in {transaction['source_room_id'], transaction['target_room_id']}:
            raise SandpiError('checkpoint metadata does not match the pending room rename', 78)
        disk = directory / 'root.raw'
        disk_info = disk.lstat()
        if not stat.S_ISREG(disk_info.st_mode) or disk_info.st_uid != os.geteuid() or disk_info.st_nlink != 1:
            raise SandpiError('checkpoint disk is not a user-owned single-link regular file', 78)
        if manifest.get('disk', {}).get('logical_bytes') != disk_info.st_size:
            raise SandpiError('checkpoint disk capacity does not match its manifest during rename', 78)
        changed = manifest.get('room_id') != transaction['target_room_id']
        manifest['room_id'] = transaction['target_room_id']
        embedded = manifest.get('room')
        if isinstance(embedded, dict):
            embedded = dict(embedded)
            embedded['room_id'] = transaction['target_room_id']
            embedded['name'] = transaction['target_name']
            embedded['project'] = transaction['project']
            manifest['room'] = embedded
        atomic_json(manifest_path, manifest)
        updated += int(changed)
    _sync_dir(area)
    return updated


def _rewrite_optional_launch_identity(room: Path, transaction: dict[str, Any]) -> int:
    updated = 0
    for name in ('status.json', 'launch-host.json'):
        path = room / name
        if not path.exists() and not path.is_symlink():
            continue
        value = _owned_json(path, label=f'room {name}', limit=8 * 1024 * 1024)
        current_id = value.get('room_id')
        if current_id is not None and current_id not in {
                transaction['source_room_id'], transaction['target_room_id']}:
            raise SandpiError(f'room {name} belongs to a different room identity', 78)
        changed = current_id != transaction['target_room_id'] or value.get('name') != transaction['target_name']
        value['room_id'] = transaction['target_room_id']
        if 'name' in value or name == 'status.json':
            value['name'] = transaction['target_name']
        guest = value.get('guest_launch')
        if isinstance(guest, dict) and guest.get('room_id') in {
                transaction['source_room_id'], transaction['target_room_id']}:
            guest = dict(guest); guest['room_id'] = transaction['target_room_id']; value['guest_launch'] = guest
        atomic_json(path, value)
        updated += int(changed)
    return updated


def _remove_stale_reservation(root: Path, room_id_value: str) -> bool:
    path = root / 'reservations' / f'{room_id_value}.json'
    if not path.exists() and not path.is_symlink():
        return False
    value = _owned_json(path, label='room resource reservation', limit=64 * 1024)
    pid = value.get('pid')
    if type(pid) is int and pid > 0 and alive(pid, value.get('identity')):
        raise SandpiError('an active host resource reservation still owns the source room', 75)
    path.unlink()
    _sync_dir(path.parent)
    return True

def _status_state(room: Path) -> dict[str, Any]:
    path = room / 'status.json'
    if not path.exists() and not path.is_symlink():
        return {'state': 'stopped', 'process_alive': False}
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
        raise SandpiError(f'room status must be a user-owned regular file: {room.name}', 78)
    value = read_json(path, {})
    if not isinstance(value, dict):
        raise SandpiError(f'room status must be a JSON object: {room.name}', 78)
    pid = value.get('pid')
    running = type(pid) is int and pid > 0 and alive(pid, value.get('identity'))
    state = value.get('state') if isinstance(value.get('state'), str) else ('running' if running else 'stopped')
    return {'state': state if running else 'stopped', 'process_alive': running}


def project_room(root: Path, project: Path, namespace: str, name: str, *, require_disk: bool = False) -> dict[str, Any]:
    """Validate and describe one existing named room for this stable project.

    This opens only host room metadata. Native Pi sessions and workspace content
    remain opaque. The exact project path is required because mutating callers
    first publish any moved-project rebind through ``prepare_project_identity``.
    """
    import checkpoints
    import machine

    root = canonical(root)
    project = canonical(project, must_exist=True)
    name = checked_name(name)
    room = room_path(root, namespace, name)
    try:
        info = room.lstat()
    except FileNotFoundError:
        raise SandpiError(f'room {name!r} does not exist for this project', 66) from None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
        raise SandpiError('selected room must be a user-owned real directory', 78)
    if stat.S_IMODE(info.st_mode) & 0o022:
        raise SandpiError('selected room directory must not be writable by group or other users', 78)
    pending = _transaction_at(room, project=project, namespace=namespace)
    if pending is not None:
        raise SandpiError(
            f'room rename {pending["source_name"]!r} -> {pending["target_name"]!r} is incomplete '
            f'(stage {pending["stage"]}); rerun `sandpi rename {pending["target_name"]} --name {pending["source_name"]}`',
            75)
    metadata = _source_metadata(room, expected_name=name, namespace=namespace, project=project)
    disk = room / 'root.raw'
    disk_view = {'exists': False, 'logical_bytes': 0, 'allocated_bytes': 0}
    if disk.exists() or disk.is_symlink():
        disk_info = checkpoints.regular(disk)
        disk_view = {'exists': True, 'logical_bytes': disk_info.st_size,
                     'allocated_bytes': disk_info.st_blocks * 512}
    elif require_disk:
        raise SandpiError('selected room has no persistent guest disk', 66)
    status = _status_state(room)
    return {'schema': 'sandpi.project-room.v1', 'name': name,
            'room_id': room.name, 'path': str(room), 'metadata': metadata,
            'disk': disk_view, 'state': status['state'],
            'process_alive': status['process_alive']}


def list_project(root: Path, project: Path, namespace: str, *, selected_name: str = 'default',
                 active_name: str | None = None) -> dict[str, Any]:
    """Return bounded project room metadata without reading native Pi sessions."""
    import checkpoints
    import machine

    root = canonical(root)
    project = canonical(project, must_exist=True)
    selected_name = checked_name(selected_name)
    active_name = checked_name(active_name if active_name is not None else selected_name)
    area = _rooms_root(root, create=False)
    rows: list[dict[str, Any]] = []
    issues: list[dict[str, str]] = []
    if area.exists():
        children: list[Path] = []
        with os.scandir(area) as scan:
            for entry in scan:
                if len(children) >= MAX_ROOMS:
                    raise SandpiError(
                        f'Sandpi room root exceeds the fixed {MAX_ROOMS}-entry inspection bound', 78)
                children.append(Path(entry.path))
        for candidate in sorted(children, key=lambda child: child.name):
            if candidate.name.startswith('.'):
                continue
            try:
                info = candidate.lstat()
            except FileNotFoundError:
                continue
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
                issues.append({'room_id': candidate.name, 'reason': 'not-a-user-owned-local-directory'})
                continue
            if stat.S_IMODE(info.st_mode) & 0o022:
                issues.append({'room_id': candidate.name, 'reason': 'room-directory-is-not-private'})
                continue
            try:
                pending = _transaction_at(candidate, project=project, namespace=namespace)
            except SandpiError as error:
                issues.append({'room_id': candidate.name, 'reason': str(error)})
                continue
            if pending is not None:
                issues.append({'room_id': candidate.name,
                               'reason': f'incomplete-room-rename:{pending["source_name"]}->{pending["target_name"]}:{pending["stage"]}'})
                continue
            try:
                metadata = machine.read_metadata(candidate)
            except SandpiError as error:
                issues.append({'room_id': candidate.name, 'reason': str(error)})
                continue
            name = metadata.get('name')
            try:
                valid_name = checked_name(name) if isinstance(name, str) else None
            except SandpiError:
                valid_name = None
            if valid_name is None or candidate.name != room_id(Path(namespace), valid_name):
                continue
            if metadata.get('project_anchor') != namespace or metadata.get('project') != str(project):
                issues.append({'room_id': candidate.name, 'reason': 'stale-project-binding'})
                continue
            disk = candidate / 'root.raw'
            disk_view: dict[str, Any]
            if disk.exists() or disk.is_symlink():
                info = checkpoints.regular(disk)
                disk_view = {'exists': True, 'logical_bytes': info.st_size,
                             'allocated_bytes': info.st_blocks * 512}
            else:
                disk_view = {'exists': False, 'logical_bytes': 0, 'allocated_bytes': 0}
            checkpoint_count = len(checkpoints.list_checkpoints(candidate))
            profile = machine.saved_profile(candidate)
            lineage = _clean_lineage(metadata.get('clone_lineage'))
            import_lineage = None
            if metadata.get('import_lineage') is not None:
                import roomarchive
                import_lineage = roomarchive.validate_lineage(metadata.get('import_lineage'))
            rename_history = _clean_rename_history(metadata.get('rename_history'))
            status = _status_state(candidate)
            rows.append({
                'name': valid_name,
                'room_id': candidate.name,
                'selected': valid_name == selected_name,
                'active': valid_name == active_name,
                'state': status['state'],
                'process_alive': status['process_alive'],
                'disk': disk_view,
                'checkpoint_count': checkpoint_count,
                'machine_profile': profile,
                'clone_lineage': lineage,
                'import_lineage': import_lineage,
                'last_rename': rename_history[-1] if rename_history else None,
                'created_at': metadata.get('created_at'),
                'last_used_at': metadata.get('last_used_at'),
            })
    return {
        'schema': LIST_SCHEMA,
        'project': str(project),
        'namespace_sha256': sha256(namespace.encode()),
        'selected_name': selected_name,
        'selected_room_id': room_id(Path(namespace), selected_name),
        'active_name': active_name,
        'active_room_id': room_id(Path(namespace), active_name),
        'active_exists': any(row['name'] == active_name for row in rows),
        'rooms': sorted(rows, key=lambda row: row['name']),
        'issues': issues,
    }


def _rename_noreplace(source: Path, target: Path) -> None:
    """Atomically publish a directory without replacing any existing target."""
    try:
        libc = ctypes.CDLL(None, use_errno=True)
    except OSError as error:
        raise SandpiError(
            f'atomic no-replace room publication is unavailable on this host: {error}', 69) from error
    renameat2 = getattr(libc, 'renameat2', None)
    if renameat2 is not None:
        renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
        renameat2.restype = ctypes.c_int
        result = renameat2(AT_FDCWD, os.fsencode(source), AT_FDCWD, os.fsencode(target), RENAME_NOREPLACE)
        if result == 0:
            return
        number = ctypes.get_errno()
        if number == errno.EEXIST:
            raise SandpiError('target room already exists; choose another room name', 73)
        if number not in (errno.ENOSYS, errno.EINVAL, errno.EOPNOTSUPP):
            raise OSError(number, os.strerror(number), os.fspath(target))
    # Sandpi targets Linux/KVM. Fail closed instead of weakening no-replace
    # publication on a kernel or libc without renameat2(RENAME_NOREPLACE).
    raise SandpiError('atomic no-replace room publication is unavailable on this host', 69)


def _source_metadata(room: Path, *, expected_name: str, namespace: str, project: Path) -> dict[str, Any]:
    import machine

    value = machine.read_metadata(room)
    if value.get('schema') != machine.ROOM_SCHEMA or value.get('room_id') != room.name or value.get('name') != expected_name:
        raise SandpiError('source room metadata does not match the selected room identity', 78)
    if value.get('project_anchor') != namespace or value.get('project') != str(project):
        raise SandpiError('source room metadata is not bound to this project; stop and launch it once before cloning', 78)
    return value


def _clone_profile(source: dict[str, Any], *, disk_bytes: int, at: str) -> dict[str, Any] | None:
    import machine

    raw = source.get('machine_profile')
    if raw is None:
        return None
    profile = machine.validate_profile(raw)
    profile.update({
        'disk_bytes': disk_bytes,
        'publish': [],
        'publish_udp': [],
        'saved_at': at,
        'saved_revision': REVISION,
    })
    return machine.validate_profile(profile)


def clone(root: Path, project: Path, namespace: str, *, source_name: str,
          target_name: str, checkpoint: str | None = None) -> dict[str, Any]:
    """Clone an offline room disk into a new named room for the same project.

    Port forwards are intentionally cleared because source and target may run at
    the same time. The target starts without source logs, checkpoints, status,
    active-entry leases or host session observations.
    """
    import checkpoints
    import lifecycle
    import machine
    import nixhost

    root = private_dir(canonical(root))
    project = canonical(project, must_exist=True)
    source_name = checked_name(source_name)
    target_name = checked_name(target_name)
    if source_name == target_name:
        raise SandpiError('source and target room names must differ', 64)
    checkpoint = checked_name(checkpoint) if checkpoint is not None else None
    area = _rooms_root(root, create=True)
    source = room_path(root, namespace, source_name)
    target = room_path(root, namespace, target_name)
    if source == target:
        raise SandpiError('source and target room identities must differ', 64)

    with lifecycle.stopped_room(root, source, require_disk=True):
        import upgrades
        upgrades.assert_clone_allowed(source)
        if target.exists() or target.is_symlink():
            raise SandpiError('target room already exists; choose another room name', 73)
        source_meta = _source_metadata(source, expected_name=source_name,
                                       namespace=namespace, project=project)
        disk_source = source / 'root.raw'
        checkpoint_meta = None
        if checkpoint is not None:
            checkpoint_dir, checkpoint_meta = checkpoints.checkpoint_manifest(source, checkpoint)
            disk_source = checkpoint_dir / 'root.raw'

        trash = private_dir(root / 'trash')
        staging = Path(tempfile.mkdtemp(prefix=f'.clone-{target.name}-', dir=trash))
        published = False
        try:
            copied = checkpoints.sparse_copy(disk_source, staging / 'root.raw')
            at = timestamp()
            store_lease = nixhost.room_lease(root, source)
            store_data = nixhost.store_paths_text(store_lease['paths'])
            atomic_write(staging / 'store-paths', store_data)
            atomic_json(staging / 'store-lease.json', {
                'schema': nixhost.ROOM_STORE_SCHEMA,
                'recorded_at': at,
                'mode': store_lease['mode'],
                'path_count': len(store_lease['paths']),
                'paths_sha256': sha256(store_data),
                'global_lease_digest': store_lease['global_lease_digest'],
                'scope': 'cumulative-lower-view-last-used-by-room',
            })
            profile_source = (checkpoint_meta or {}).get('room')
            if not isinstance(profile_source, dict) or profile_source.get('machine_profile') is None:
                profile_source = source_meta
            profile = _clone_profile(profile_source, disk_bytes=copied['logical_bytes'], at=at)
            lineage = _clean_lineage({
                'schema': LINEAGE_SCHEMA,
                'source_room_id': source.name,
                'source_name': source_name,
                'source_checkpoint': checkpoint,
                'source_disk_mtime_ns': copied['source_mtime_ns'],
                'copied_at': at,
                'copied_revision': REVISION,
                'copy_method': copied['method'],
                'workspace_copied': False,
                'host_observations_copied': False,
                'checkpoints_copied': False,
                'port_forwards_copied': False,
            })
            runtime_source = profile_source if isinstance(profile_source, dict) else source_meta
            metadata: dict[str, Any] = {
                'schema': machine.ROOM_SCHEMA,
                'room_id': target.name,
                'name': target_name,
                'project': str(project),
                'project_anchor': namespace,
                'disk_bytes': copied['logical_bytes'],
                'created_at': at,
                'created_or_used_at': at,
                'clone_lineage': lineage,
            }
            if profile is not None:
                metadata['machine_profile'] = profile
            if isinstance(runtime_source, dict):
                source_revision = runtime_source.get('last_revision')
                if type(source_revision) is int and source_revision >= 0:
                    metadata['last_revision'] = source_revision
            if isinstance(runtime_source, dict) and runtime_source.get('runtime_contract') is not None:
                metadata['runtime_contract'] = upgrades.validate_contract(runtime_source['runtime_contract'])
                metadata['last_revision'] = metadata['runtime_contract']['sandpi_revision']
                if isinstance(runtime_source.get('last_successful_boot_at'), str):
                    metadata['last_successful_boot_at'] = runtime_source['last_successful_boot_at']
            atomic_json(staging / 'room.json', metadata)
            receipt = {
                'schema': CLONE_SCHEMA,
                'at': at,
                'source': {'room_id': source.name, 'name': source_name,
                           'checkpoint': checkpoint},
                'target': {'room_id': target.name, 'name': target_name},
                'disk': copied,
                'machine_profile_copied': profile is not None,
                'port_forwards_cleared': True,
                'workspace_copied': False,
                'host_observations_copied': False,
                'checkpoints_copied': False,
                'native_pi_state_copied': True,
                'runtime_contract_copied': 'runtime_contract' in metadata,
                'requires_retained_host_store': True,
                'store_lease_copied': True,
                'store_lease_paths': len(store_lease['paths']),
            }
            atomic_json(staging / 'clone.json', receipt)
            _sync_dir(staging)
            _rename_noreplace(staging, target)
            published = True
            _sync_dir(area)
            _sync_dir(trash)
            return receipt
        finally:
            if not published and staging.exists():
                # This directory was created by this operation under quarantine.
                # If cleanup itself is interrupted, clean --trash remains the
                # explicit recovery path and no target room was published.
                with contextlib.suppress(BaseException):
                    shutil.rmtree(staging)
                    _sync_dir(trash)



def rename(root: Path, project: Path, namespace: str, *, source_name: str,
           target_name: str) -> dict[str, Any]:
    """Rename one stopped project room without copying its guest disk.

    The room directory itself is moved with Linux ``RENAME_NOREPLACE``.  A
    bounded transaction record follows the directory, so rerunning the same
    command completes a process crash that happened after the move but before
    checkpoint/session/selection metadata finished migrating.  Native Pi
    session bytes remain untouched on the same disk inode.
    """
    import lifecycle
    import project as project_state
    import roomselect
    import sessions

    root = private_dir(canonical(root))
    project = canonical(project, must_exist=True)
    source_name = checked_name(source_name)
    target_name = checked_name(target_name)
    area = _rooms_root(root, create=True)
    source = room_path(root, namespace, source_name)
    target = room_path(root, namespace, target_name)

    source_present = _real_room_directory(source)
    target_present = _real_room_directory(target)
    # After the selector has followed a moved room, a plain retry can resolve
    # both the selected source and requested target to the same directory. Treat
    # its one transaction as the recovery source rather than counting it twice.
    same_path = source == target
    source_tx = None if same_path else (
        _transaction_at(source, project=project, namespace=namespace,
                        target_name=target_name) if source_present else None)
    target_tx = _transaction_at(target, project=project, namespace=namespace,
                                target_name=target_name) if target_present else None
    if source_tx is not None and target_tx is not None:
        raise SandpiError('both source and target contain room rename transactions; inspect state before retrying', 78)
    transaction = target_tx or source_tx
    if transaction is None and target_present and (not source_present or same_path):
        completed_source = source_name
        receipt_path = target / 'rename.json'
        if same_path and (receipt_path.exists() or receipt_path.is_symlink()):
            raw_receipt = _owned_json(
                receipt_path, label='room rename receipt', limit=1024 * 1024)
            raw_source = raw_receipt.get('source')
            if isinstance(raw_source, dict) and isinstance(raw_source.get('name'), str):
                completed_source = raw_source['name']
        completed = None
        if not same_path or receipt_path.exists() or receipt_path.is_symlink():
            completed = _completed_rename_at(
                target, project=project, namespace=namespace,
                source_name=completed_source, target_name=target_name)
        if completed is not None:
            return completed
    if transaction is not None:
        if transaction['source_name'] != source_name and source_name != target_name:
            raise SandpiError(
                f'the pending rename started from {transaction["source_name"]!r}; retry with '
                f'`sandpi rename {target_name} --name {transaction["source_name"]}`', 73)
        source_name = transaction['source_name']
        source = room_path(root, namespace, source_name)
    elif source_name == target_name:
        raise SandpiError('source and target room names must differ', 64)

    # The project lock comes first so selection cannot change between the
    # transaction snapshot and publication. The room/lifecycle locks then keep
    # every VMM, checkpoint, clone, cleanup and entry operation out.
    project_dir = project / '.sandpi'
    if project_dir.is_symlink() or not project_dir.is_dir():
        raise SandpiError('room rename requires a persisted host-only project anchor', 66)
    with file_lock(project_dir / 'project.lock', timeout=3):
        identity = project_state.load(project)
        if not identity.get('persisted') or identity.get('room_namespace') != namespace:
            raise SandpiError('project identity changed while room rename was starting; retry', 75)
        selection = roomselect.load(project, namespace)

        # Re-evaluate transaction placement after obtaining the project lock.
        source_exists = _real_room_directory(source)
        target_exists = _real_room_directory(target)
        if transaction is None:
            if not source_exists:
                raise SandpiError(f'room {source_name!r} does not exist for this project', 66)
            if target_exists:
                raise SandpiError('target room already exists; choose another room name', 73)
            work = source
        else:
            source_tx = _transaction_at(source, project=project, namespace=namespace,
                                        target_name=target_name) if source_exists else None
            target_tx = _transaction_at(target, project=project, namespace=namespace,
                                        target_name=target_name) if target_exists else None
            if source_tx is not None and not target_exists:
                transaction = source_tx; work = source
            elif target_tx is not None and not source_exists:
                transaction = target_tx; work = target
            else:
                raise SandpiError(
                    'pending room rename has an ambiguous source/target layout; inspect both room IDs before repair', 78)

        with lifecycle.stopped_room(root, work, require_disk=True):
            import upgrades
            upgrades.assert_rename_allowed(work)
            # Refuse known host-observation identity conflicts before moving the
            # guest disk. A second validation occurs when the rekey publishes,
            # so a concurrent stale writer still fails closed after the move and
            # can be repaired by rerunning the same transaction.
            session_preflight = sessions.validate_room_rename(
                root, source.name, target.name)
            if transaction is None:
                _source_metadata(source, expected_name=source_name,
                                 namespace=namespace, project=project)
                # A target reservation can survive an earlier deleted room. It
                # cannot authorize reuse and must be stale before the name can be
                # republished. The source reservation likewise cannot outlive a
                # genuinely stopped room.
                _remove_stale_reservation(root, target.name)
                _remove_stale_reservation(root, source.name)
                transaction = {
                    'schema': RENAME_TRANSACTION_SCHEMA,
                    'project': str(project),
                    'namespace_sha256': sha256(namespace.encode()),
                    'source_name': source_name,
                    'source_room_id': source.name,
                    'target_name': target_name,
                    'target_room_id': target.name,
