        delimiter = 'SANDPI_ASSET_' + hashlib.sha256(name.encode() + data).hexdigest()
        if delimiter.encode() in data.splitlines():
            raise ValueError('heredoc delimiter collision')
        output.append('\n  # --- embedded source: ' + name + ' ---\n')
        output.append('  cat > "$dest"/' + shlex.quote(name) + " <<'" + delimiter + "'\n")
        output.append(data.decode('utf-8'))
