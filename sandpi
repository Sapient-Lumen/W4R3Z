def audit_picker_lifetime_sequence(probe)->list[str]:
    """Hold a real native RPC dialog while issuing nested local commands.

    Normal ChoiceProbe calls remain serial. Here the outer command cannot finish
    until the handler returns its UI answer, so nested replies remain correlated.
    This does not test terminal layout, shutdown cancellation or provider inference.
    """
    def snapshot():
        value=probe.call('get_state').get('data',{})
        required=('model','thinkingLevel','sessionId','messageCount','pendingMessageCount')
        if (any(key not in value for key in required) or value.get('isStreaming') is not False
                or value.get('isCompacting') is not False or value['pendingMessageCount']!=0):
            raise SandpiError('native picker overlap state is incomplete or not idle')
        return {key:value[key] for key in required}
    before=snapshot()
    query='/sandmodels free '+CHAT_MODEL
    def slash(command):
        answer=probe.call('prompt',message=command)
        if answer.get('data',{}).get('disposition')!='handled':
            raise SandpiError('native picker overlap command was not handled locally')
    def no_dialog(_row):
        raise SandpiError('a second native picker dialog displaced the held dialog')
    for held_phase in ('select','confirm'):
        seen=[]
        def dialog(row):
            method=row.get('method');seen.append(method)
            if method not in ('select','confirm'):
                raise SandpiError('unexpected native picker overlap dialog')
            options=row.get('options',[])
            if method=='select' and (len(options)!=1 or not isinstance(options[0],str)
                    or not options[0].startswith(CHAT_MODEL+'  [')):
                raise SandpiError('native picker overlap did not select the exact fixture')
            if method==held_phase:
                probe.dialog_handler=no_dialog
                try:
                    for command,expected in (
                        (query, 'no second selection was queued'),
                        ('/sandmodels --help', 'Usage: /sandmodels'),
                        ('/sandmodels --explain', 'Model discovery — read-only snapshot'),
                        (query+' --details', 'no second selection was queued'),
                    ):
                        n=len(probe.notices);u=len(probe.ui_methods);slash(command)
                        if (probe.ui_methods[u:]!=['notify'] or len(probe.notices[n:])!=1
                                or expected not in probe.notices[n]):
                            raise SandpiError('native picker overlap omitted its local notice or changed UI')
                finally:probe.dialog_handler=dialog
                return {'cancelled':True} if method=='select' else {'confirmed':False}
            return {'value':options[0]}
        probe.dialog_handler=dialog
        try:slash(query)
        finally:probe.dialog_handler=None
        if seen!=(['select'] if held_phase=='select' else ['select','confirm']):
            raise SandpiError('native picker overlap missed the held dialog sequence')
        if snapshot()!=before:raise SandpiError('native picker overlap changed session or model state')
    # A subsequent ordinary picker must reopen rather than inherit stale ownership.
    seen=[]
    def cancel(row):
        seen.append(row.get('method'))
        if row.get('method')!='select':raise SandpiError('native picker reopen did not stop at selection')
        return {'cancelled':True}
    probe.dialog_handler=cancel
    try:slash(query)
    finally:probe.dialog_handler=None
    if seen!=['select'] or snapshot()!=before:
        raise SandpiError('native picker did not reopen after cancellation unchanged')
    return list(NATIVE_PICKER_LIFETIME_CASES)


