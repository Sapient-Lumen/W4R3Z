import { createHash, randomUUID } from 'node:crypto';

export const LOOP_ENTRY = 'sandpi.loop.v1';
export const LOOP_MESSAGE = 'sandpi.loop-continuation.v1';
export const LOOP_DEFAULT_PASSES = 5;
export const LOOP_MAX_PASSES = 100;
export const LOOP_MAX_OBJECTIVE = 8192;
const LOOP_ID = /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;
const UNSAFE_OBJECTIVE = /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f-\u009f\u061c\u200e\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069]/;

export const LOOP_HELP = `Sandpi native work loop

  /loop "objective"       run 5 settled work passes
  /loop PASSES "objective" run 1-${LOOP_MAX_PASSES} settled work passes
  /loop status            inspect this branch without inference
  /loop stop              prevent another pass; the current pass may finish
  /loop help              show this text

Each pass stays in this Pi conversation and preserves its exact model, thinking,
tools, billing permission, compaction, retry, and provider behavior. Escape aborts
the current work and ends the loop. A provider error also ends it. Passes are
bounded agent settlements, not exact provider-request counts.`;

function unquote(value) {
  if (value.length < 2) return value;
  const quote = value[0];
  return (quote === '"' || quote === "'") && value.at(-1) === quote
    ? value.slice(1, -1).trim() : value;
}

export function parseLoopArgs(input) {
  const raw = String(input ?? '').trim();
  if (!raw || raw === 'help' || raw === '--help' || raw === '-h') return { action: 'help' };
  if (raw === 'status') return { action: 'status' };
  if (raw === 'stop') return { action: 'stop' };
  let passes = LOOP_DEFAULT_PASSES;
  let objective = raw;
  const counted = /^(\d+)(?:\s+([\s\S]*))?$/.exec(raw);
  if (counted) {
    passes = Number(counted[1]);
    objective = counted[2]?.trim() ?? '';
    if (!Number.isSafeInteger(passes) || passes < 1 || passes > LOOP_MAX_PASSES) {
      return { action: 'error', message: `Passes must be an integer from 1 to ${LOOP_MAX_PASSES}.` };
    }
  }
  objective = unquote(objective);
  if (!objective) return { action: 'error', message: 'Give /loop an objective after the optional pass count.' };
  if (UNSAFE_OBJECTIVE.test(objective)) {
    return { action: 'error', message: 'The loop objective contains unsupported control or direction-formatting characters.' };
  }
  if (objective.length > LOOP_MAX_OBJECTIVE) {
    return { action: 'error', message: `The loop objective exceeds ${LOOP_MAX_OBJECTIVE} characters.` };
  }
  return { action: 'start', passes, objective };
}

export function completeLoopArgs(prefix) {
  if (typeof prefix !== 'string' || prefix.length > 32 || /\s/.test(prefix)) return [];
  return ['status', 'stop', 'help'].filter(value => value.startsWith(prefix))
    .map(value => ({ value, label: value }));
}

function digest(value) {
  return createHash('sha256').update(value, 'utf8').digest('hex');
}

function stateData(loop, status, completed, extra = {}) {
  return {
    schema: LOOP_ENTRY,
    id: loop.id,
    status,
    pass: loop.pass,
    passes: loop.passes,
    completed,
    objective_sha256: loop.objectiveSha256,
    ...extra,
  };
}

function latestState(ctx) {
  const branch = ctx.sessionManager.getBranch();
  for (let index = branch.length - 1; index >= 0; index--) {
    const entry = branch[index];
    const data = entry?.type === 'custom' && entry.customType === LOOP_ENTRY ? entry.data : undefined;
    if (entry?.type === 'custom' && entry.customType === LOOP_ENTRY) {
      if (data?.schema === LOOP_ENTRY && typeof data.id === 'string' && LOOP_ID.test(data.id)
        && Number.isSafeInteger(data.pass) && data.pass >= 1
        && Number.isSafeInteger(data.passes) && data.passes >= 1 && data.passes <= LOOP_MAX_PASSES
        && data.pass <= data.passes
        && Number.isSafeInteger(data.completed) && data.completed >= 0 && data.completed <= data.pass
        && ['running', 'stopping', 'completed', 'aborted', 'failed', 'stopped'].includes(data.status)
        && typeof data.objective_sha256 === 'string'
        && /^[a-f0-9]{64}$/.test(data.objective_sha256)) return data;
      return null;
    }
  }
  return null;
}

function initialPrompt(loop) {
  return `[Sandpi loop pass 1 of ${loop.passes}]\n\nUser objective:\n${loop.objective}\n\n`
    + 'Work autonomously on this objective using the live conversation and workspace. '
    + 'Inspect what is actually true before changing it, preserve unrelated user work, '
    + 'and verify changes in proportion to risk. Do not change model, provider, billing '
    + 'permission, tool policy, or authority merely because this is a loop.';
}

function continuationPrompt(loop, nextPass) {
  return `[Sandpi loop continuation: pass ${nextPass} of ${loop.passes}]\n\nUser objective:\n${loop.objective}\n\n`
    + 'Continue from the live conversation and workspace. Reconcile prior claims with '
    + 'durable state, do not repeat completed work, and make the next useful increment. '
    + 'If the objective is already satisfied, use this pass to review, test, simplify, '
    + 'or red-team it rather than creating needless changes. This continuation does not '
    + 'expand the user\'s authority.';
}

function report(ctx, message, level = 'info') {
  if (ctx.hasUI) ctx.ui.notify(message, level);
}

export function registerLoop(pi) {
  let active = null;

  const retire = () => { active = null; };
  for (const event of ['session_before_switch', 'session_before_fork', 'session_before_tree', 'session_shutdown']) {
    pi.on(event, retire);
  }

  pi.on('agent_before_settle', async (event, ctx) => {
    const loop = active;
    if (!loop || ctx.sessionManager.getSessionId() !== loop.sessionId) return;
    if (event.outcome !== 'completed') {
      active = null;
      const status = event.outcome === 'aborted' ? 'aborted' : 'failed';
      report(ctx, `Loop ${status} during pass ${loop.pass}/${loop.passes}; no next pass was scheduled.`,
        status === 'failed' ? 'error' : 'info');
      return { entries: [...event.entries, {
        type: 'custom', customType: LOOP_ENTRY,
        data: stateData(loop, status, Math.max(0, loop.pass - 1), { failed_pass: loop.pass }),
      }], continue: event.continue };
    }
    if (loop.stopRequested) {
      active = null;
      report(ctx, `Loop stopped after completing pass ${loop.pass}/${loop.passes}.`);
      return { entries: [...event.entries, {
        type: 'custom', customType: LOOP_ENTRY,
        data: stateData(loop, 'stopped', loop.pass),
      }], continue: event.continue };
    }
    if (loop.pass >= loop.passes) {
      active = null;
      report(ctx, `Loop completed ${loop.passes}/${loop.passes} passes.`);
      return { entries: [...event.entries, {
        type: 'custom', customType: LOOP_ENTRY,
        data: stateData(loop, 'completed', loop.passes),
      }], continue: event.continue };
    }
    const completed = loop.pass;
    const nextPass = completed + 1;
    loop.pass = nextPass;
    report(ctx, `Loop completed pass ${completed}/${loop.passes}; continuing with pass ${nextPass}.`);
    return { entries: [...event.entries,
      { type: 'custom', customType: LOOP_ENTRY,
        data: stateData(loop, 'running', completed) },
      { type: 'custom_message', customType: LOOP_MESSAGE,
        content: continuationPrompt(loop, nextPass), display: true,
        details: { schema: LOOP_MESSAGE, id: loop.id, pass: nextPass,
          passes: loop.passes, objective_sha256: loop.objectiveSha256 } },
    ], continue: true };
  });

  // If another extension or a context boundary prevents our requested
  // continuation, do not leave process-local state pretending work continues.
  pi.on('agent_settled', async (_event, ctx) => {
    if (!active) return;
    const loop = active;
    active = null;
    pi.appendEntry(LOOP_ENTRY, stateData(loop, 'failed', Math.max(0, loop.pass - 1), { failed_pass: loop.pass }));
    report(ctx, `Loop settled early after ${Math.max(0, loop.pass - 1)}/${loop.passes} completed passes. Run /loop status before starting again.`, 'error');
  });

  pi.registerCommand('loop', {
    description: 'Run bounded native Pi work passes; /loop [passes] "objective" | status | stop',
    getArgumentCompletions: completeLoopArgs,
    handler: async (args, ctx) => {
      const parsed = parseLoopArgs(args);
      if (parsed.action === 'help') { report(ctx, LOOP_HELP); return; }
      if (parsed.action === 'error') { report(ctx, `${parsed.message}\n\n${LOOP_HELP}`, 'error'); return; }
      if (parsed.action === 'status') {
        if (active && active.sessionId === ctx.sessionManager.getSessionId()) {
          const status = active.stopRequested ? 'stopping after' : 'active on';
          report(ctx, `Loop ${status} pass ${active.pass}/${active.passes} · objective ${active.objectiveSha256.slice(0, 12)}…\n/loop stop prevents another pass without aborting the current one.`);
          return;
        }
        const state = latestState(ctx);
        if (!state) { report(ctx, 'No loop state exists on this branch.'); return; }
        const status = state.status === 'running' ? 'interrupted' : state.status;
        report(ctx, `Latest branch loop: ${status} · completed ${state.completed}/${state.passes} · objective ${state.objective_sha256.slice(0, 12)}…`);
        return;
      }
      if (parsed.action === 'stop') {
        if (active && active.sessionId === ctx.sessionManager.getSessionId()) {
          const loop = active;
          if (loop.stopRequested) { report(ctx, 'This loop is already stopping after the current pass.'); return; }
          loop.stopRequested = true;
          pi.appendEntry(LOOP_ENTRY, stateData(loop, 'stopping', Math.max(0, loop.pass - 1)));
          report(ctx, `Loop will stop after the current pass; no pass after ${loop.pass}/${loop.passes} will be scheduled.`);
          return;
        }
        const state = latestState(ctx);
        if (state?.status === 'running') {
          pi.appendEntry(LOOP_ENTRY, { ...state, status: 'stopped' });
          report(ctx, 'Marked the interrupted branch loop stopped; no inference was requested.');
        } else report(ctx, 'No active or interrupted loop needs stopping.');
        return;
      }
      if (active) { report(ctx, 'A loop is already active in this Pi process. Use /loop status or /loop stop.', 'error'); return; }
      if (!ctx.isIdle() || ctx.hasPendingMessages()) {
        report(ctx, 'Finish or cancel active/queued work before starting a loop. Nothing was queued.', 'error'); return;
      }
      if (!ctx.model) {
        report(ctx, 'Select a model before starting a loop. Nothing was queued.', 'error'); return;
      }
      const loop = {
        id: randomUUID(), objective: parsed.objective,
        objectiveSha256: digest(parsed.objective), pass: 1, passes: parsed.passes,
        sessionId: ctx.sessionManager.getSessionId(), stopRequested: false,
      };
      active = loop;
      pi.appendEntry(LOOP_ENTRY, stateData(loop, 'running', 0));
      report(ctx, `Loop started: pass 1/${loop.passes}. Escape aborts current work; /loop stop prevents the next pass.`);
      try { pi.sendUserMessage(initialPrompt(loop)); }
      catch {
        active = null;
        pi.appendEntry(LOOP_ENTRY, stateData(loop, 'failed', 0, { failed_pass: 1 }));
        report(ctx, 'Pi refused the initial loop turn; the loop was closed without retry.', 'error');
      }
    },
  });
}
