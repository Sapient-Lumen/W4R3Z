class NativeProgress:
    """Fresh per-phase evidence. Earlier passes survive a later failure as scoped passes."""
    def __init__(self,out:Path,scope:str,names:list[str]):
        if len(names)!=len(set(names)) or not names:raise SandpiError('invalid native phase plan')
        self.path=out/'phase-progress.json'
        self.value={'schema':'sandpi.native-progress.v1','scope':scope,'status':'running',
            'phases':[{'name':name,'status':'not-run','checks':[]} for name in names]}
        self.save()
    def save(self):
        atomic_json(self.path,self.value)
    def execute(self,name,action):
        row=next(row for row in self.value['phases'] if row['name']==name)
        if row['status']!='not-run':raise SandpiError('native phase already attempted')
        row.update(status='running',started_at=dt.datetime.now(dt.timezone.utc).isoformat());self.save()
        try:
            checks=action()
            if (not isinstance(checks,list) or not checks or any(not isinstance(c,str) or not c for c in checks)
                    or len(checks)!=len(set(checks))):
                raise SandpiError('native phase returned empty, duplicate or malformed checks')
        except BaseException as error:
            # Record exception class, not potential fixture/credential bodies.
            row.update(status='failed',error_type=type(error).__name__)
            self.value['status']='failed';self.save();raise
        row.update(status='passed',checks=list(checks),finished_at=dt.datetime.now(dt.timezone.utc).isoformat())
        self.save();return checks
    def finish(self):
        if any(row['status']!='passed' for row in self.value['phases']):
            raise SandpiError('not every requested native phase passed')
        self.value['status']='passed';self.save()


def run(pi:Path,out:Path,*,scope:str='all')->dict:
