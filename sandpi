  const costs = inspectCost(model);
  if (costs.status === 'known') {
    const rate = row => `$${row.input}/M input; $${row.output}/M output; $${row.cacheRead}/M cache read; $${row.cacheWrite}/M cache write`;
    lines.push(`catalog cost estimate: ${rate(costs.base)}`);
    for (const tier of costs.tiers) lines.push(`catalog prompt tier above ${tier.inputTokensAbove} input tokens: ${rate(tier)}`);
    lines.push('Catalog rates are estimates, not a bill or wire capture. /sandcost keeps provider-reported charges separate; endpoint and scheduled pricing can differ.');
