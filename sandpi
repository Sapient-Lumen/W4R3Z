def service_projection(args, inherited):
    """Explicit model of the documented environment precedence; not systemd."""
    result = dict(inherited)
    for argument in args:
        if argument.startswith('--setenv='):
            key, value = argument.removeprefix('--setenv=').split('=', 1)
            result[key] = value
    for argument in args:
        if argument.startswith('--property=UnsetEnvironment='):
            for key in argument.removeprefix('--property=UnsetEnvironment=').split():
                result.pop(key, None)
    return result


