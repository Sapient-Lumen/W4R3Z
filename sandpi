    import entries
    import sessions

    candidates = _project_rooms(root, namespace)
    locks = contextlib.ExitStack()
    originals: list[tuple[Path, dict[str, Any]]] = []
    status_originals: list[tuple[Path, dict[str, Any] | None]] = []
    session_rebound = False
    room_ids: list[str] = []

    def rollback(original_error: BaseException) -> None:
        rollback_errors: list[str] = []
        if session_rebound:
            try:
                sessions.rebind_project(root, room_ids=room_ids,
                                        old_project=Path(new_project), new_project=Path(old_project))
            except BaseException as error:
                rollback_errors.append(f'session observations: {error}')
        for path, value in reversed(status_originals):
            try:
                if value is None:
                    with contextlib.suppress(FileNotFoundError):
                        path.unlink()
                else:
                    atomic_json(path, value)
            except BaseException as error:
                rollback_errors.append(f'{path}: {error}')
        for path, value in reversed(originals):
            try:
                atomic_json(path, value)
            except BaseException as error:
                rollback_errors.append(f'{path}: {error}')
        if rollback_errors:
            raise SandpiError(
                'project binding failed and rollback was incomplete: ' +
                '; '.join(rollback_errors), 74) from original_error

    try:
        for room, _metadata in candidates:
            locks.enter_context(file_lock(room / 'prepare.lock', wait=False))
            locks.enter_context(file_lock(room / 'run.lock', wait=False))
        for room, _metadata in candidates:
            status = read_json(room / 'status.json', {})
            config = read_json(room / 'launch-host.json', {})
            runtime_value = status.get('runtime')
            runtime = Path(runtime_value) if isinstance(runtime_value, str) else None
            occupancy = entries.state(room, status=status, config=config, runtime=runtime)
            if alive(status.get('pid', -1), status.get('identity')) or \
                    occupancy['active_count'] or occupancy['draining']:
                raise SandpiError(
                    'the project moved while one of its rooms or host entries is still active; '
                    'stop it from either path with `sandpi down` and retry', 75)
            import upgrades
            upgrades.assert_structural_mutation_allowed(room, 'rebind the project identity')

        try:
            rebound_at = timestamp()
            for room, metadata in candidates:
                room_ids.append(room.name)
                room_path = room / 'room.json'
                original_room = dict(metadata)
                changed = dict(metadata)
                changed.update(project=new_project, project_anchor=namespace,
                               project_rebound_at=rebound_at, project_rebound_revision=REVISION)
                try:
                    atomic_json(room_path, changed)
                except BaseException:
                    # atomic_write may fail either before or after os.replace().
                    # Enlist this path for rollback only when publication became
                    # externally visible; an unchanged failed target should not
                    # turn a recoverable earlier-room rollback into a false
                    # incomplete-rollback error.
                    with contextlib.suppress(BaseException):
                        if read_json(room_path, {}) != original_room:
                            originals.append((room_path, original_room))
                    raise
                else:
                    originals.append((room_path, original_room))
                status_path = room / 'status.json'
                if status_path.exists() and not status_path.is_symlink():
                    status = read_json(status_path, {})
                    original_status = dict(status) if isinstance(status, dict) else None
                    if isinstance(status, dict):
                        changed_status = dict(status)
                        changed_status['project'] = new_project
                        changed_status['project_rebound_at'] = rebound_at
                        try:
                            atomic_json(status_path, changed_status)
                        except BaseException:
                            with contextlib.suppress(BaseException):
                                if read_json(status_path, {}) != original_status:
                                    status_originals.append((status_path, original_status))
                            raise
                        else:
                            status_originals.append((status_path, original_status))
                else:
                    status_originals.append((status_path, None))
            if room_ids:
                result = sessions.rebind_project(root, room_ids=room_ids,
                                                 old_project=Path(old_project), new_project=Path(new_project))
                session_rebound = bool(result.get('updated'))
            yield
        except BaseException as original_error:
            rollback(original_error)
            raise
    finally:
        locks.close()


def prepare_project_identity(args: argparse.Namespace, plan: dict[str, Any], *, force: bool = False) -> dict[str, Any]:
    """Persist/bind the host-only project anchor before a room is launched."""
    import project as project_state

    root = private_dir(Path(plan['root']))
    project = Path(plan['project'])
    resolved = project_state.resolve(root, project)
    expected = plan.get('project_anchor')
    if resolved['room_namespace'] != expected:
        raise SandpiError('project identity changed while the launch was being prepared; retry the command', 75)
    with project_state.materialize(
            root, project, expected_namespace=resolved['room_namespace'], revision=REVISION) as staged:
        identity, candidate = staged
        result = project_state.bind(
            root, project, identity, revision=REVISION, force=force,
            migrate=lambda old, new, namespace: _migrate_project_binding(root, old, new, namespace),
        )
    plan['project_anchor'] = identity['room_namespace']
    plan['project_identity'] = {
        'schema': 'sandpi.project-runtime.v2',
        'persisted': True,
        'room_namespace_sha256': sha256(identity['room_namespace'].encode()),
        'binding_state': 'bound',
        'binding_moved': bool(result.get('moved')),
        'binding_replaced': bool(result.get('replaced')),
        'anchor_recovered': candidate is not None,
    }
    return result


def credential_store(args: argparse.Namespace, root: Path) -> CredentialStore:
    labels = {}
    for provider, attr in [('google', 'gemini_key'), ('openrouter', 'openrouter_key')]:
        value = getattr(args, attr, None)
        if value:
            labels[provider] = value
    # Canonical files only in the launcher. Environment-key support in the library
    # remains available to tests/integrators, but no secrets are copied into systemd.
    return CredentialStore(root, labels=labels, environ={})


def choose_provider(args: argparse.Namespace, store: CredentialStore) -> str | None:
    if args.provider and args.provider_pos and args.provider != args.provider_pos:
        raise SandpiError('provide one provider selector, not two different ones', 64)
    selected = args.provider or args.provider_pos
    if not selected and args.model and '/' in args.model:
        prefix, rest = args.model.split('/', 1)
        if prefix in ('openai-codex', 'openai', 'google', 'openrouter'):
            args.model = rest
            return prefix
    if not selected and not args.model and not args.models and (args.resume or args.continue_session):
        return None  # Pi restores the recorded provider/model from its own session.
    if selected == 'gpt':
        status = store.status()['providers']
        if status['openai-codex']['ready']:
            return 'openai-codex'
        # An explicitly selected GPT subscription must not turn into API billing
        # just because its token has become invalid or the account logged out.
        from credentials import parse_codex, read_secret
        if store.auth_path.exists():
            auth = parse_codex(read_secret(store.auth_path))
            if auth.get('auth_mode') == 'chatgpt' or auth.get('tokens'):
                return 'openai-codex'
        return 'openai'
    # Plain `sandpi` enters the room without choosing Pi's conversation or
    # model. Pi restores native session state, applies its configured default,
    # or offers its authenticated model picker. Host selectors are shortcuts.
    return PROVIDERS[selected] if selected else None


def port_mapping(value: str) -> str:
    if value == 'all':
        return value
    if not re.fullmatch(r'\d{1,5}(?::\d{1,5})?', value):
        raise SandpiError('--publish expects HOSTPORT:GUESTPORT, one port, or all', 64)
    if any(not 1 <= int(x) <= 65535 for x in value.split(':')):
        raise SandpiError('forwarded ports must be between 1 and 65535', 64)
    return value


def port_mappings(values: list[str], *, label: str) -> list[str]:
    mapped = [port_mapping(value) for value in values]
    if len(mapped) != len(set(mapped)):
        raise SandpiError(f'duplicate {label} port forwarding entry', 64)
    if 'all' in mapped and len(mapped) != 1:
        raise SandpiError(f'{label} port forwarding `all` cannot be combined with individual ports', 64)
    return mapped


def prepare_detached_start(args: argparse.Namespace) -> None:
    """Turn the ordinary launch parser into a room-only background start.

    `up` deliberately owns machine lifecycle, not Pi's initial conversation.
    Provider/model/history/profile choices belong to the later process that
    enters the room, where they receive a fresh invocation runtime.
    """
    disallowed = []
    for label, value in (
        ('provider', args.provider or args.provider_pos), ('--model', args.model),
        ('--models', args.models), ('--thinking', args.thinking),
        ('--resume/--RESUME', args.resume or args.continue_session),
        ('--skip-ladder', args.skip_ladder), ('--tool-profile', args.tool_profile != 'auto'),
        ('--full-pi', args.full_pi), ('--resume-fallback', args.resume_fallback != 'ask'),
        ('--gemini-key', args.gemini_key), ('--openrouter-key', args.openrouter_key),
        ('--shell', args.shell), ('--pi-only', args.pi_only), ('--exec', args.exec_command),
        ('--BARE-METAL', args.bare_metal),
        ('--paid', getattr(args, 'paid', False)), ('--preset', getattr(args, 'preset', None)),
        ('--max-price', getattr(args, 'max_price', None)),
    ):
        if value:
            disallowed.append(label)
    if disallowed:
        raise SandpiError('sandpi up boots only the room; choose Pi state when entering it. Remove: ' + ', '.join(disallowed), 64)
    args.detached = True




def launch_plan(args: argparse.Namespace, extra: list[str]) -> dict[str, Any]:
    import profiles
    import project as project_state
    import sessions

    import model_defaults
    paid = bool(getattr(args, 'paid', False))
    price_limit = model_defaults.max_price(getattr(args, 'max_price', None))
    if (getattr(args, 'preset', None) or price_limit is not None) and not paid:
        raise SandpiError('--preset and --max-price require explicit --paid for this process', 64)
    if getattr(args, 'preset', None):
        recipe = model_defaults.preset(args.preset)
        if args.models or (args.model and args.model.removeprefix('openrouter/') != recipe['model']):
            raise SandpiError('--preset selects one exact model; do not combine it with a different --model or --models', 64)
        if any(value and value != 'openrouter' for value in (args.provider, args.provider_pos)):
            raise SandpiError('--preset requires OpenRouter, not a different provider shortcut', 64)
        args.provider, args.model = 'openrouter', recipe['model']
    native_flags = {extra[i] for i in pi_option_indices(extra)}
    root, cred, project, rid, room = locations(args)
    project_identity = project_state.resolve(root, project)
    project_binding = project_state.binding_state(root, project, project_identity['room_namespace'])
    detached = bool(getattr(args, 'detached', False))
    store = credential_store(args, cred)
    provider = choose_provider(args, store)
    if not (args.provider or args.provider_pos or args.model or args.models) and native_flags & {
            '--session', '--session-id', '--continue', '--resume', '-c', '-r', '--fork'}:
        provider = None
    status = store.status()
    available = [p for p, entry in status['providers'].items() if entry['ready']]
    import machine
    flags = getattr(args, '_explicit_flags', set())
    machine_flags = {'--cpus', '--memory', '--disk-size', '--store-cache', '--publish', '--no-publish',
                     '--publish-udp', '--no-publish-udp'}
    if args.bare_metal and machine_flags & flags:
        names = ', '.join(sorted(machine_flags & flags))
        raise SandpiError(f'{names} configure the Cloud Hypervisor room and cannot be used with --BARE-METAL', 64)
    prior = {} if args.bare_metal else machine.read_metadata(room)
    saved = prior.get('machine_profile')
    disk = room / 'root.raw'
    if not args.bare_metal and disk.is_symlink():
        raise SandpiError('guest disk cannot be a symlink', 78)
    existing_bytes = (disk.stat().st_size if disk.is_file() and not args.bare_metal else
                      (saved or {}).get('disk_bytes', prior.get('disk_bytes', 100 * GIB)))
    selected_cpus = args.cpus if '--cpus' in flags or not saved else saved['cpus']
    selected_memory = args.memory if '--memory' in flags or not saved else str(saved['memory_budget'])
    selected_disk = args.disk_size if '--disk-size' in flags else str(existing_bytes)
    selected_cache = ('host' if args.bare_metal else args.store_cache if '--store-cache' in flags
                      else (saved or {}).get('store_cache', 'host'))
    selected_publish = ([] if args.bare_metal or '--no-publish' in flags else args.publish
                        if '--publish' in flags else (saved or {}).get('publish', []))
    selected_publish_udp = ([] if args.bare_metal or '--no-publish-udp' in flags else args.publish_udp
                            if '--publish-udp' in flags else (saved or {}).get('publish_udp', []))
    selected_publish = [] if selected_publish is None else selected_publish
    selected_publish_udp = [] if selected_publish_udp is None else selected_publish_udp
    try:
        resource = None if args.bare_metal else Resources.calculate(
            selected_cpus, selected_memory, selected_disk).as_json()
    except SandpiError as error:
        if saved and not ({'--cpus', '--memory'} & flags):
            raise SandpiError(f'saved room CPU/memory profile no longer fits this host ({error}); '
                              'start the stopped room once with explicit --cpus/--memory or reset `sandpi machine --reset --yes`',
                              error.code) from None
        raise
    if resource and disk.is_file() and disk.stat().st_size != resource['disk_bytes']:
        raise SandpiError('existing disk size differs; use disk-grow while the room is stopped', 64)
    if args.boot_timeout < 5:
        raise SandpiError('--boot-timeout must be at least 5 seconds', 64)

    requested_profile = 'passthrough' if args.full_pi else args.tool_profile
    if args.full_pi and args.tool_profile != 'auto':
        raise SandpiError('--full-pi is an alias for --tool-profile passthrough; do not combine both', 64)
    pi_override = profiles.raw_tool_override(extra)
    if pi_override and requested_profile in ('classic', 'codemode'):
        raise SandpiError('--tool-profile classic/codemode cannot be combined with Pi tool flags; choose passthrough or one owner', 64)

    pi_args = [] if detached else make_pi_args(provider, args.model, args.models, args.thinking,
                                                args.resume, args.continue_session, extra)
    resume_mode = 'bare-metal' if args.bare_metal else 'vm'
    resume_workdir = (args._project_selection['host_workdir'] if args.bare_metal
                      else args._project_selection['guest_workdir'])
    resume_hint = (sessions.latest(root, room=rid, project=project,
                                   mode=resume_mode, workdir=resume_workdir)
                   if args.continue_session else None)
    masks = [] if args.bare_metal else vm.mask_paths(project, root, cred)
    if args.shell and (args.pi_only or args.exec_command is not None):
        raise SandpiError('--shell cannot be combined with --pi-only or --exec', 64)
    terminal = sys.stdin.isatty() and sys.stdout.isatty()
    io = pi_interface(pi_args, terminal=terminal)
    if detached:
        io = {'interface': 'daemon', 'pty': False, 'headless': True}
    elif args.exec_command is not None:
        io = {'interface': 'exec', 'pty': False, 'headless': True}
    elif getattr(args, 'benchmark_spec', None):
        io = {'interface': 'benchmark', 'pty': False, 'headless': True}
    elif args.shell:
        io = {'interface': 'shell', 'pty': True, 'headless': False}
    # SSH -T turns even a host terminal into guest pipe input. Pi reads that
    # pipe to EOF before one-shot work; close unused terminal input explicitly.
    # Genuine piped data and long-lived RPC input must remain untouched.
    io['stdin'] = 'eof' if io['interface'] in ('print', 'json', 'benchmark') and sys.stdin.isatty() else 'inherit'
    import upgrades
    runtime_contract = upgrades.current_contract(SOURCE)
    runtime_upgrade = ({'schema': upgrades.STATUS_SCHEMA, 'action': 'not-applicable-bare-metal',
                        'target_contract': runtime_contract}
                       if args.bare_metal else upgrades.preview(room, runtime_contract))
    return {'schema': 'sandpi.plan.v1', 'version': VERSION, 'revision': REVISION,
            'mode': 'bare-metal' if args.bare_metal else 'vm', 'root': str(root),
            'room_lifecycle': 'detached' if detached else 'owner-terminal',
            'credential_root': str(cred), 'room_id': rid, 'name': args._resolved_name,
            'project': str(project), 'host_workdir': args._project_selection['host_workdir'],
            'guest_workdir': args._project_selection['guest_workdir'],
            'project_selection': {k: args._project_selection[k] for k in
                                  ('schema', 'source', 'relative_workdir', 'boundary', 'explicit')},
            'room_selection': {key: args._room_selection[key] for key in
                               ('selected_name', 'persisted', 'source')},
            'room_dir': str(room), 'disk_path': str(room / 'root.raw'),
            'project_anchor': project_identity['room_namespace'],
            'project_identity': {
                'schema': 'sandpi.project-runtime.v2',
                'persisted': bool(project_identity['persisted']),
                'source': project_identity['source'],
                'room_namespace_sha256': sha256(project_identity['room_namespace'].encode()),
                'binding_state': project_binding['state'],
                'binding_moved': False,
                'binding_replaced': project_binding['state'] == 'replaced-at-same-path',
                'anchor_recovered': False,
                'recovery_match': (project_identity.get('recovery_candidate') or {}).get('match'),
            },
            'resources': resource, 'provider': provider, 'providers': available,
            'runtime_contract': runtime_contract, 'runtime_upgrade': runtime_upgrade,
            'pi_args': pi_args, 'masks': masks, 'store_cache': selected_cache,
            'machine_profile': None if args.bare_metal else {
                'persisted': bool(saved),
                'source': ('saved-with-cli-overrides' if saved and ({'--cpus', '--memory', '--disk-size', '--store-cache', '--publish', '--no-publish',
                                                                         '--publish-udp', '--no-publish-udp'} & flags)
                           else 'saved' if saved else 'new-defaults'),
            },
            'resume_hint': resume_hint, 'tool_profile_request': requested_profile,
            'network': {'backend': 'host' if args.bare_metal else 'passt-vhost-user',
                        'firewall': False, 'egress_allowlist': None,
                        'publish': port_mappings(selected_publish, label='TCP'),
                        'publish_udp': port_mappings(selected_publish_udp, label='UDP')},
            'io': io,
            'terminal_flow': ['room-running', 'caller-shell'] if detached else
                ['command' if args.exec_command is not None else 'pi', 'caller-shell']
                if io['headless'] or args.pi_only else
                ['guest-root-shell' if not args.bare_metal else 'host-root-shell', 'caller-shell']
                if args.shell else ['pi', 'host-root-shell' if args.bare_metal else 'guest-root-shell', 'caller-shell'],
            'credential_mode': 'canonical-files/request-time-resolver',
            'openrouter_access': {'paid': paid, 'max_price': price_limit,
                                 'preset': getattr(args, 'preset', None), 'scope': 'current-Pi-process'},
            'history': 'latest' if args.continue_session else 'picker' if args.resume else 'new-or-native-arguments',
            'tool_profile': {'request': requested_profile, 'pi_cli_override': pi_override,
                             'policy': 'frontier-codemode/stable-ladder-codemode/otherwise-classic'},
            'ladder_policy': 'bypass' if paid or provider != 'openrouter' or args.model or args.models or args.resume or args.continue_session or args.skip_ladder or native_flags & {
                '--model', '--models', '--provider', '--session', '--session-id', '--continue', '--resume', '-c', '-r', '--fork'}
                else 'cached-pass-or-two-rung-guest-check',
            'sandcodex_refresh_lock_compatible': False}


def prepare_pi_runtime(args: argparse.Namespace, plan: dict, extra: list[str]) -> None:
    """Resolve catalogs, grades, quota observations and Pi profile policy.

    Network work belongs to execution, never the read-only plan command. Native
    Pi remains the owner of sessions and provider conversation semantics.
    """
    import benchmark
    import catalog
    import profiles
    import model_defaults
    from keypool import blocked_models

    root = Path(plan['root'])
    bank_ready = 'openrouter' in plan['providers']
    # Only actual native option positions claim model/history ownership. Literal
    # prompt text and values belonging to other options must not change policy.
    # Presence conservatively suppresses auto-selection even for a missing value;
    # Pi still owns native validation, patterns, IDs and the selected conversation.
    native_flags = {extra[i] for i in pi_option_indices(extra)}
    supplied_model = bool(args.model or args.models or native_flags & {'--model', '--models', '--provider'})
    history = bool(args.resume or args.continue_session or native_flags & {
        '--session', '--session-id', '--continue', '--resume', '-c', '-r', '--fork'})
    # Only an exact launch-time model may receive the probe marker before Pi
    # starts. Native resume/picker/fork targets are proven inside the extension
    # after Pi projects/restores the selected branch; an empty --RESUME must not
    # turn a later automatic choice into an exact-model bypass.
    exact_model_intent = bool(args.model or '--model' in native_flags)
    using_openrouter = plan['provider'] == 'openrouter'
    try:
        snapshot = catalog.cached(root) if bank_ready else None
    except SandpiError:
        if using_openrouter:
            raise
        snapshot = None
        log('OpenRouter catalog cache is invalid; continuing without it. Use sandpi models --refresh to rebuild discovery.')
    plain_native_entry = plan['provider'] is None and not supplied_model and not history
    if bank_ready and using_openrouter and not getattr(args, 'paid', False) and not args.shell and args.exec_command is None:
        snapshot = catalog.load(root)
    elif bank_ready and not getattr(args, 'paid', False) and plain_native_entry and snapshot is None and not args.shell and args.exec_command is None:
        # Materialize the free catalog opportunistically for Pi's native model
        # picker. Failure must not stop a plain room entry when GPT or Gemini is
        # already usable; exact `sandpi openrouter` remains strict above.
        try:
            snapshot = catalog.load(root)
        except SandpiError as error:
            snapshot = None
            log(f'OpenRouter discovery unavailable during plain entry ({error}); GPT/Gemini and Pi-native cached models remain usable.')
    paid = bool(getattr(args, 'paid', False))
    full_snapshot = None
    if bank_ready:
        try:
            full_snapshot = catalog.load_all(root) if paid and not args.shell and args.exec_command is None else catalog.cached_all(root)
        except SandpiError:
            if paid:
                raise
            log('Priced OpenRouter discovery unavailable; continuing with the free catalog.')
    if full_snapshot is not None:
        snapshot = catalog.free_view(full_snapshot)
    models = (snapshot or {}).get('models', [])
    all_models = (full_snapshot or snapshot or {}).get('models', [])
    policy = model_defaults.load()
    recipes = {model['id']: row for model in all_models
               if (row := model_defaults.recipe_for(model, policy)) is not None}
    grades = benchmark.summaries(root, models) if models else {}

    blocked: set[str] = set()
    route_health: dict[str, dict[str, Any]] = {}
    model_fingerprints = {model['id']: model['fingerprint'] for model in all_models
                          if isinstance(model.get('fingerprint'), str)}
    if bank_ready:
        try:
            store = credential_store(args, Path(plan['credential_root']))
            entries = store.bank('openrouter')
            blocked = blocked_models(store.pool.status('openrouter', entries, quota=store.quota_hints('openrouter', entries)))
            route_health = store.pool.route_status('openrouter', fingerprints=model_fingerprints)['routes']
        except SandpiError:
            # Cooldowns and passive health are advisory at startup. Request-time
            # leasing remains authoritative and available for diagnostics.
            blocked = set()
            route_health = {}

    selected_model: dict[str, Any] | None = None
    if using_openrouter and args.model and not args.shell and args.exec_command is None:
        selected = args.model.removeprefix('openrouter/')
        selected_model = next((m for m in (all_models if paid else models) if m['id'] == selected), None)
        if getattr(args, 'preset', None):
            model_defaults.require_ready(model_defaults.preset(args.preset, policy), selected_model, policy)
        if selected_model is None:
            raise SandpiError('OpenRouter needs an exact current text model ID admitted by this process. Use --paid for priced models; see sandpi models --paid. Router/fuzzy IDs are not silently substituted.', 64)
        if catalog.model_lifecycle(selected_model).get('state') == 'expired':
            raise SandpiError('that exact model is past its catalog expiration date; refresh models or choose another exact ID', 64)
        if args.thinking is not None and not catalog.supports_thinking_level(selected_model, args.thinking):
            raise SandpiError(f'that model cannot honor --thinking {args.thinking} exactly; omit --thinking or choose one of its catalog-declared efforts', 64)
        if selected != args.model:
            args.model = selected
            plan['pi_args'] = make_pi_args('openrouter', selected, args.models, args.thinking,
                                           args.resume, args.continue_session, extra)

    automatic_models = catalog.models_supporting_thinking(models, args.thinking) if using_openrouter else models
    auto = using_openrouter and not paid and not supplied_model and not history and not args.shell and \
        args.exec_command is None and not getattr(args, 'benchmark_spec', None)
    if auto and args.thinking is not None and not catalog.rank(automatic_models, grades, blocked=blocked, health=route_health):
        raise SandpiError(f'no automatic free coding model can honor --thinking {args.thinking} exactly; choose an exact compatible model or omit --thinking', 78)
    if auto and args.skip_ladder:
        choices = catalog.rank(automatic_models, grades, blocked=blocked, health=route_health)
        if not choices:
            raise SandpiError('no advertised tool-capable free model is available; choose an exact text model explicitly', 78)
        plan['pi_args'] = benchmark.select_exact(plan['pi_args'], choices[0]['id'])
        selected_model = next((m for m in models if m['id'] == choices[0]['id']), None)
        log('OpenRouter automatic coding check explicitly skipped; catalog metadata is not a coding grade.')
        auto = False

    explicit_model = None
    for index in pi_option_indices(plan['pi_args']):
        if plan['pi_args'][index] == '--model' and index + 1 < len(plan['pi_args']):
            explicit_model = plan['pi_args'][index + 1]
    request = plan.get('tool_profile_request', 'auto')
    benchmark_profile = bool(getattr(args, 'benchmark_spec', None))
    runtime_request = 'classic' if benchmark_profile else request
    pi_tool_override = profiles.raw_tool_override(extra)
    managed = not pi_tool_override and request != 'passthrough'
    effective = profiles.resolve(request, plan['provider'], explicit_model, grades,
                                 resume_hint=plan.get('resume_hint'),
                                 continuing=args.continue_session,
                                 pi_tool_override=pi_tool_override,
                                 benchmark=benchmark_profile)
    # A text-only exact catalog model cannot execute repository tools. This is a
    # capability fact, not a low ladder score. Explicit passthrough remains Pi's.
    catalog_text_only = bool(selected_model and not selected_model.get('tools'))
    if catalog_text_only and managed:
        effective = 'text-only'
    elif selected_model and managed and request == 'auto' and selected_model['id'] in recipes:
        effective = recipes[selected_model['id']]['tool_profile']

    quota_summary = None
    if using_openrouter and bank_ready and not history and not args.shell and args.exec_command is None:
        try:
            quota = credential_store(args, Path(plan['credential_root'])).cached_openrouter_quota()
            quota_summary = {'checked_at': quota.get('checked_at'), 'stale': quota.get('stale', False),
                             'ok': sum(row.get('status') == 'ok' for row in quota.get('keys', [])),
                             'keys': len(quota.get('keys', []))}
        except SandpiError as error:
            quota_summary = {'available': False, 'reason': str(error)}
            log('OpenRouter quota observation unavailable; key leasing will continue without it.')

    ranked_models = catalog.rank(models, grades, blocked=blocked, health=route_health)
    automatic_ranked = catalog.rank(automatic_models, grades, blocked=blocked, health=route_health)
    ranked_ids = [model['id'] for model in ranked_models]
    ranked_ids.extend(model['id'] for model in models
                      if catalog.model_lifecycle(model).get('state') != 'expired'
                      and model['id'] not in set(ranked_ids))
    plan['pi_runtime'] = {'schema': 'sandpi.launch-runtime.v6', 'catalog': snapshot or {},
                          'all_catalog': full_snapshot or {},
                          'paid_enabled': paid,
                          'max_price': model_defaults.max_price(getattr(args, 'max_price', None)),
                          'model_recipes': recipes,
                          'recipe_policy': {key: policy[key] for key in ('schema', 'revision', 'reviewed_at', 'review_after', 'pi_versions')},
                          'grades': grades, 'auto_select': auto, 'pi': benchmark.PI_PIN,
                          'resume_requested': bool(history),
                          'continue_requested': bool(args.continue_session or native_flags & {'--continue', '-c'}),
                          'resume_fallback': args.resume_fallback,
                          'explicit_model': bool(supplied_model or args.provider or args.provider_pos),
                          'allow_model_cooldown_probe': exact_model_intent,
                          'resume_hint': plan.get('resume_hint'),
                          'tool_profile_request': runtime_request,
                          'benchmark_profile': benchmark_profile,
                          'tool_profile_managed': managed,
                          'initial_tool_profile': effective,
                          'tool_profiles': {**profiles.profile_map(models, grades),
                                            **{ident: row['tool_profile'] for ident, row in recipes.items()}},
                          'frontier_providers': list(profiles.FRONTIER_PROVIDERS),
                          'codemode_floor': profiles.CODEMODE_FLOOR,
                          'catalog_text_only': catalog_text_only,
                          'requested_thinking': args.thinking,
                          'automatic_model_ids': [model['id'] for model in automatic_ranked],
                          'ranked_free_models': ranked_ids,
                          'blocked_models': sorted(blocked),
                          'route_health': route_health,
                          'model_fingerprints': model_fingerprints,
                          'quota_summary': quota_summary}
    if getattr(args, 'benchmark_spec', None):
        if paid:
            raise SandpiError('the automatic coding ladder is free-only; paid models use native Pi, not hidden grading requests', 64)
        if args.bare_metal:
            raise SandpiError('benchmark execution requires a VM; --BARE-METAL is not used for coding probes', 64)
        if not args.model or not using_openrouter:
            raise SandpiError('benchmark run requires an exact OpenRouter --model', 64)
        plan['benchmark'] = args.benchmark_spec


def attach_report_store(store: CredentialStore, root: Path, runtime: dict,
                        *, room_id: str, project: Path) -> CredentialStore:
    store.report_root = root
    store.ladder_models = runtime.get('catalog', {}).get('models', [])
    store.session_room = room_id
    store.session_project = project
    return store


def ensure_kvm(env: dict[str, str], *, repair: bool = True) -> None:
    if os.access('/dev/kvm', os.R_OK | os.W_OK):
        return
    if not repair:
        raise SandpiError('/dev/kvm is absent or not accessible; sandpi doctor --fix can repair module/ACL prerequisites', 69)
    log('KVM needs host permission setup; sudo is used only for the module/ACL repair')
    sudo = shutil.which('sudo')
    if not sudo:
        raise SandpiError('sudo is needed to repair /dev/kvm; grant your user access through the host NixOS configuration', 69)
    if not Path('/dev/kvm').exists():
        cpu = Path('/proc/cpuinfo').read_text(errors='replace')
        module = 'kvm_intel' if 'GenuineIntel' in cpu else 'kvm_amd' if 'AuthenticAMD' in cpu else 'kvm'
        modprobe = shutil.which('modprobe', path=env['PATH'])
        if not modprobe:
            raise SandpiError('host modprobe is unavailable; load the KVM module from your NixOS configuration', 69)
        run([sudo, modprobe, module])
    if not Path('/dev/kvm').exists():
        raise SandpiError('KVM module loaded but /dev/kvm is still absent; hardware/nested virtualization must be enabled', 69)
    setfacl = shutil.which('setfacl', path=env['PATH'])
    assert setfacl
    run([sudo, setfacl, '-m', f'u:{os.getuid()}:rw', '/dev/kvm'])
    if not os.access('/dev/kvm', os.R_OK | os.W_OK):
        raise SandpiError('KVM permission repair did not make /dev/kvm accessible', 69)


def namespace_check(env: dict[str, str]) -> None:
    result = run(['unshare', '--user', '--map-root-user', '--mount', 'true'],
                 env=env, capture=True, check=False)
    if result.returncode:
        raise SandpiError('unprivileged user/mount namespaces are unavailable; see examples/host.nix and sandpi doctor', 69)


def require_credentials(args: argparse.Namespace, plan: dict[str, Any]) -> None:
    if args.exec_command is not None or args.shell or args.allow_no_credentials:
        return
    # Plain room entry is deliberately provider-neutral. Native Pi may have a
    # guest-local/custom provider, and entering the useful Nix machine must not
    # depend on a Sandcodex bank. Explicit managed shortcuts remain strict.
    if plan['provider'] is None:
        return
    if plan['provider'] not in plan['providers']:
        raise SandpiError(f'shared credentials are not ready for {plan["provider"]}; see sandpi creds', 78)


def _live_status(room: Path) -> dict[str, Any] | None:
    status = read_json(room / 'status.json', {})
    return status if alive(status.get('pid', -1), status.get('identity')) else None


def _wait_room_ready(room: Path, *, timeout: int, expected_run_id: str | None = None) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = read_json(room / 'status.json', {})
        # A stopped status from an earlier boot can remain until the new
        # supervisor wins the lifetime lock and publishes its own boot record.
        # Never mistake that stale record for failure of this launch.
        if expected_run_id is not None and last.get('run_id') != expected_run_id:
            time.sleep(0.2)
            continue
        if not alive(last.get('pid', -1), last.get('identity')):
            if last.get('state') == 'stopped':
                raise SandpiError(f'room stopped during startup with exit {last.get("exit_code", "unknown")}; see sandpi logs', 70)
        elif last.get('state') == 'running':
            return last
        time.sleep(0.2)
    raise SandpiError('room did not become ready before the launch deadline; inspect sandpi status and logs', 124)


def linger_enabled() -> bool | None:
    """Return user-manager linger state without changing host policy."""
    loginctl = shutil.which('loginctl')
    if not loginctl:
        return None
    result = run([loginctl, 'show-user', str(os.getuid()), '--property=Linger', '--value'],
                 capture=True, check=False)
    if result.returncode:
        return None
    value = result.stdout.decode(errors='replace').strip().lower()
    return True if value == 'yes' else False if value == 'no' else None


def _validate_reentry_options(args: argparse.Namespace, config: dict[str, Any], plan: dict[str, Any]) -> None:
    if config.get('revision') != REVISION:
        raise SandpiError(
            f'this running room was started by revision {config.get("revision", "unknown")}; '
            'stop it once with `sandpi down` so the current guest runtime can boot', 75)

    flags = getattr(args, '_explicit_flags', set())
    current_resources = config.get('resources', {})
    requested_resources = plan.get('resources') or {}
    changes: list[str] = []
    for flag, key, label in (('--cpus', 'cpus', 'CPU'),
                             ('--memory', 'memory_budget', 'memory'),
                             ('--disk-size', 'disk_bytes', 'disk')):
        if flag in flags and requested_resources.get(key) != current_resources.get(key):
            changes.append(label)
    for flag_set, key, label in (({'--publish', '--no-publish'}, 'publish', 'TCP port forwards'),
                                  ({'--publish-udp', '--no-publish-udp'}, 'publish_udp', 'UDP port forwards')):
        if flag_set & flags and sorted(plan.get('network', {}).get(key, [])) != sorted(config.get(key, [])):
            changes.append(label)
    if '--store-cache' in flags and plan.get('store_cache') != config.get('store_cache'):
        changes.append('Nix store-cache mode')
    if changes:
        raise SandpiError(', '.join(changes) + ' change requires a stopped room; use sandpi down first', 75)
    labels = config.get('labels', {})
    pin_changes = ((args.gemini_key is not None and labels.get('google') != args.gemini_key) or
                   (args.openrouter_key is not None and labels.get('openrouter') != args.openrouter_key))
    if pin_changes:
        raise SandpiError('a different key pin changes the host credential broker and requires a room restart; use sandpi down first', 75)


def _secondary_launch(plan: dict[str, Any], status: dict[str, Any], entry_id: str) -> dict[str, Any]:
    runtime = f'/run/sandpi/entries/entry-{entry_id}.json'
    return {
        'schema': 'sandpi.launch.v1', 'mode': 'vm', 'room_id': plan['room_id'],
        'workspace': '/workspace', 'workdir': plan.get('guest_workdir', '/workspace'),
        'providers': plan['providers'],
        'pi_args': plan['pi_args'], 'pi_runtime': plan.get('pi_runtime', {}),
        'benchmark': plan.get('benchmark'), 'runtime_config': runtime,
        'core_package': '/etc/sandpi/pi-package', 'reentry': True,
        'entry_id': entry_id, 'entry_role': 'secondary',
        'room_lifecycle': status.get('lifecycle', 'owner-terminal'),
    }


def _room_entry_state(room: Path, status: dict[str, Any]) -> dict[str, Any]:
    import entries
    config = read_json(room / 'launch-host.json', {})
    runtime_value = status.get('runtime')
    runtime = Path(runtime_value) if isinstance(runtime_value, str) else None
    return entries.state(room, status=status, config=config, runtime=runtime)


def _entry_label(row: dict[str, Any]) -> str:
    return f'{row.get("entry_id", "?")}:{row.get("role", "?")}:{row.get("interface", "?")}'


def _tracked_running_command(room: Path, plan: dict[str, Any], status: dict[str, Any],
                             command: str, *, interface: str, tty: bool,
                             env: dict[str, str], stdin: Any = None) -> int:
    import entries
    entry_id = secrets.token_hex(12)
    runtime = Path(status['runtime'])
    with entries.lease(room, room_id=plan['room_id'], entry_id=entry_id,
                       interface=interface, interactive=tty,
                       lifecycle=status.get('lifecycle', 'owner-terminal'), runtime=runtime):
        return run(vm.ssh_command(SOURCE, runtime, runtime / 'ssh-key', command, tty=tty),
                   check=False, env=env, stdin=stdin).returncode


def stop_room(args: argparse.Namespace, room: Path) -> int:
    """Drain host entries, then stop the room supervisor with bounded identity checks."""
    import entries

    if not (0 <= args.wait <= 86400):
        raise SandpiError('--wait must be between 0 and 86400 seconds', 64)
    status = room_status(room, live=True)
    config = read_json(room / 'launch-host.json', {})
    runtime_value = status.get('runtime')
    runtime = Path(runtime_value) if isinstance(runtime_value, str) else None
    token = secrets.token_hex(16)
    entries.begin_drain(room, token=token, reason='down' if args.command == 'down' else 'stop', runtime=runtime)
    stopped = False
    started = time.monotonic()
    try:
        occupancy = entries.state(room, status=status, config=config, runtime=runtime)
        active = occupancy['entries']
        active_at_request = len(active)
        if active and args.wait > 0:
            log(f'room drain started; waiting for {len(active)} active entr{"y" if len(active) == 1 else "ies"}')
            deadline = time.monotonic() + args.wait
            while active and time.monotonic() < deadline:
                if not alive(status['pid'], status['identity']):
                    stopped = True
                    break
                time.sleep(0.1)
                current = room_status(room)
                occupancy = entries.state(room, status=current, config=config, runtime=runtime)
                active = occupancy['entries']
        if stopped or not alive(status['pid'], status['identity']):
            entries.clear_stopped(room, runtime)
            stopped = True
        else:
            if active and not args.force:
                names = ', '.join(_entry_label(row) for row in active[:8])
                more = f' (+{len(active) - 8} more)' if len(active) > 8 else ''
                raise SandpiError(
                    f'room has {len(active)} active entr{"y" if len(active) == 1 else "ies"}: {names}{more}; '
                    'close them, use --wait SECONDS, or explicitly use --force', 75)
            if active:
                log(f'forcing room shutdown with {len(active)} active entr{"y" if len(active) == 1 else "ies"}')
            if not alive(status['pid'], status['identity']):
                stopped = True
            else:
                if not signal_tracked(status['pid'], status['identity'], signal.SIGTERM):
                    stopped = True
                deadline = time.monotonic() + 40
                while time.monotonic() < deadline:
                    if not alive(status['pid'], status['identity']):
                        stopped = True
                        break
                    time.sleep(0.25)
                if not stopped:
                    raise SandpiError('stop deadline reached; inspect the recorded systemd unit and logs', 124)
            entries.clear_stopped(room, runtime)
        result = {
            'schema': 'sandpi.room-stop.v1',
            'room_id': status.get('room_id') or config.get('room_id'),
            'stopped': True,
            'forced': bool(args.force and active),
            'wait_requested_seconds': args.wait,
            'drain_wait_seconds': round(time.monotonic() - started, 3),
            'active_entries_at_request': active_at_request,
            'active_entries_at_stop': len(active),
            'forced_entries': len(active) if args.force else 0,
        }
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            log('room stopped; disk and Pi sessions retained')
        return 0
    finally:
        if stopped or not alive(status.get('pid', -1), status.get('identity')):
            with contextlib.suppress(SandpiError, OSError):
                entries.clear_stopped(room, runtime)
        else:
            with contextlib.suppress(SandpiError, OSError):
                entries.end_drain(room, token)


def reenter_running(args: argparse.Namespace, plan: dict[str, Any], status: dict[str, Any], *, fresh: bool = False) -> int:
    """Enter a live room with fresh, process-local Pi launch intent.

    The room owns the machine lifetime. This SSH process owns only its terminal.
    Provider/model/session flags are therefore regenerated for every entry rather
    than inherited from whichever process originally booted the VM.
    """
    room = Path(plan['room_dir'])
    config = read_json(room / 'launch-host.json')
    _validate_reentry_options(args, config, plan)
    env = tools_environment(Path(config['bundle']))
    runtime = Path(status['runtime'])
    key = runtime / 'ssh-key'
    if args.exec_command is not None:
        command = 'cd /workspace && ' + args.exec_command
        return _tracked_running_command(room, plan, status, command, interface='exec',
                                        tty=False, env=env)

    import entries as room_entries
    entry_id = secrets.token_hex(12)
    launch_entries = private_dir(runtime / 'seed' / 'entries')
    host_launch = launch_entries / f'entry-{entry_id}.json'
    guest_launch = f'/run/sandpi-share/entries/entry-{entry_id}.json'
    guest_runtime = f'/run/sandpi/entries/entry-{entry_id}.json'
    with room_entries.lease(room, room_id=plan['room_id'], entry_id=entry_id,
                            interface=plan['io']['interface'], interactive=plan['io']['pty'],
                            lifecycle=status.get('lifecycle', 'owner-terminal'), runtime=runtime):
        atomic_json(host_launch, _secondary_launch(plan, status, entry_id))
        host_launch.chmod(0o600)
        # The remote shell owns cleanup of its process-local runtime even if the
        # host terminal disappears. Host stale-lease pruning removes an orphaned
        # read-only launch manifest on the next entry or occupancy inspection.
        command = (
            'mkdir -p /run/sandpi/entries; '
            f'cleanup_sandpi_entry() {{ rm -f -- {shlex.quote(guest_runtime)}; }}; '
            'trap cleanup_sandpi_entry EXIT; '
            "trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; "
            f'/run/current-system/sw/bin/sandpi-enter --launch {shlex.quote(guest_launch)}'
            + (' --fresh' if fresh else '')
            + (' --shell' if args.shell else '')
            + (' --pi-only' if args.pi_only or plan['io']['headless'] else '')
        )
        try:
            return run(vm.ssh_command(SOURCE, runtime, key, command, tty=plan['io']['pty']),
                       check=False, env=env,
                       stdin=subprocess.DEVNULL if plan['io']['stdin'] == 'eof' else None).returncode
        finally:
            with contextlib.suppress(FileNotFoundError):
                host_launch.unlink()


def _validate_live_project_attachment(plan: dict[str, Any]) -> None:
    """Refuse a live room whose writable share still refers to a replaced directory.

    A same-filesystem rename keeps the directory inode and the already-mounted
    share valid. A copy/delete or cross-filesystem move does not: the live VM is
    still attached to the old directory object, so entering it from the new path
    would present a different workspace than the host command selected.
    """
    binding_state = plan.get('project_identity', {}).get('binding_state')
    if binding_state == 'moved-prior-path-missing':
        raise SandpiError(
            'this project identity moved to a different filesystem while the room was running; '
            'the live VM is still attached to the old directory object. Stop it with `sandpi down` '
            'and relaunch from the new path before entering Pi.', 75)


def launch(args: argparse.Namespace, extra: list[str]) -> int:
    plan = launch_plan(args, extra)
    require_credentials(args, plan)
    if args.bare_metal:
        prepare_project_identity(args, plan)
        prepare_pi_runtime(args, plan, extra)
        return launch_bare(args, plan)
    if effective_uid() == 0:
        raise SandpiError('run VM mode as your normal Nix user, not through sudo. --BARE-METAL is the explicit host-root mode.', 64)
    root, room = private_dir(Path(plan['root'])), private_dir(Path(plan['room_dir']))
    vm.ensure_user_manager()
    previous = _live_status(room)
    if previous is not None:
        _validate_live_project_attachment(plan)
        config = read_json(room / 'launch-host.json')
        _validate_reentry_options(args, config, plan)
        if bool(getattr(args, 'detached', False)):
            ready = _wait_room_ready(room, timeout=args.boot_timeout)
            log(f'room {plan["name"]} is already running ({ready.get("lifecycle", "unknown")})')
            return 0
        prepare_pi_runtime(args, plan, extra)
        return reenter_running(args, plan, _wait_room_ready(room, timeout=args.boot_timeout))

    # Project binding changes are stopped-room metadata migrations. A running
    # machine is entered without rewriting its host identity; the next stopped
    # launch performs any pending path rebind.
    prepare_project_identity(args, plan)
    prepare_pi_runtime(args, plan, extra)
    # Serialize preparation separately from the whole VM lifetime. Never change a
    # disk/config while another launcher is already running this room.
    with file_lock(room / 'prepare.lock', wait=False):
        previous = read_json(room / 'status.json', {})
        if alive(previous.get('pid', -1), previous.get('identity')):
            if bool(getattr(args, 'detached', False)):
                return 0
            raise SandpiError('room began running during preparation; rerun the command to enter it', 75)
        bundle = build(SOURCE, root)
        env = tools_environment(bundle)
        ensure_kvm(env, repair=not args.no_host_fix)
        namespace_check(env)
        runtime = vm.runtime_directory(plan['room_id'])
        run_id = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S') + f'-{os.getpid()}'
        import upgrades
        upgrade_prepare = upgrades.prepare_for_launch(room, plan['runtime_contract'])
        upgrade_transaction = upgrade_prepare.get('transaction')
        upgrade_transaction_id = (upgrade_transaction or {}).get('id')
        config = {**plan, 'source_dir': str(SOURCE), 'bundle': str(bundle), 'runtime': str(runtime),
                  'run_id': run_id, 'unit': f'sandpi-{plan["room_id"][:16]}-{os.getpid()}.service',
                  'labels': credential_store(args, Path(plan['credential_root'])).labels,
                  'publish': plan['network']['publish'], 'publish_udp': plan['network']['publish_udp'],
                  'boot_timeout': args.boot_timeout, 'owner_pid': os.getpid(),
                  'owner_identity': process_identity(os.getpid()),
                  'detached': bool(getattr(args, 'detached', False)),
                  'exec_command': args.exec_command, 'shell_only': args.shell,
                  'pi_only': args.pi_only or plan['io']['headless'],
                  'interactive': plan['io']['pty'],
                  'upgrade_transaction_id': upgrade_transaction_id,
                  'upgrade_prepare_action': upgrade_prepare['action'],
                  'guest_launch': {'schema': 'sandpi.launch.v1', 'mode': 'vm', 'room_id': plan['room_id'],
                                   'workspace': '/workspace', 'workdir': plan['guest_workdir'],
                                   'providers': plan['providers'], 'pi_args': plan['pi_args'],
                                   'pi_runtime': plan.get('pi_runtime', {}), 'benchmark': plan.get('benchmark'),
                                   'entry_role': 'owner', 'room_lifecycle': plan['room_lifecycle']}}
        vm.configure_pool(root, plan['resources'])
        vm.reserve(root, plan['room_id'], plan['resources'], os.getpid())
        try:
            import machine
            profile = machine.make_profile(
                plan['resources'], store_cache=plan['store_cache'],
                publish=plan['network']['publish'], publish_udp=plan['network']['publish_udp'],
                revision=REVISION)
            machine.write_metadata(room, room_id=plan['room_id'], name=plan['name'],
                                   project=plan['project'], project_anchor=plan['project_anchor'],
                                   profile=profile, revision=REVISION)
            config_path = room / 'launch-host.json'
            atomic_json(config_path, config)
            upgrades.mark_booting(room, upgrade_transaction_id, run_id)
            # No actual credential content is in this manifest or its guest subset.
            try:
                started = run(vm.systemd_command(SOURCE, config_path, config), check=False,
                              stdin=subprocess.DEVNULL if plan['io']['stdin'] == 'eof' else None)
            except (SandpiError, OSError, ValueError) as error:
                upgrades.mark_failed(
                    room, upgrade_transaction_id, run_id,
                    phase='systemd-service-start',
                    code=getattr(error, 'code', 1) if type(getattr(error, 'code', 1)) is int else 1,
                    error_type=type(error).__name__)
                raise
            if started.returncode:
                upgrades.mark_failed(room, upgrade_transaction_id, run_id,
                                     phase='systemd-service-exit', code=started.returncode,
                                     error_type='SystemdServiceExit')
                return started.returncode
            if config['detached']:
                ready = _wait_room_ready(room, timeout=args.boot_timeout, expected_run_id=config['run_id'])
                log(f'room {plan["name"]} is running in the background; enter it with `sandpi` and stop it with `sandpi down`')
                linger = linger_enabled()
                if linger is False:
                    log('systemd user linger is disabled: the room survives this terminal, but the user manager may stop at final logout. Enable linger separately only if desired.')
                elif linger is True:
                    log('systemd user linger is enabled: the detached room may remain running after logout.')
                return 0
            return started.returncode
        finally:
            # The supervisor releases after teardown. On systemd startup failure
            # only the original parent still owns this reservation.
            vm.release(root, plan['room_id'], owner=os.getpid())


def launch_bare(args: argparse.Namespace, plan: dict[str, Any]) -> int:
    root = private_dir(Path(plan['root']))
    project = Path(plan['project'])
    bundle = build(SOURCE, root, bare=True)
    env = tools_environment(bundle, bare=True, source=SOURCE, root=root)
    area = private_dir(root / 'bare' / plan['room_id'])
    with file_lock(area / 'run.lock', wait=False):
        # A short socket path avoids AF_UNIX's hard limit for long home directories.
        import tempfile
        temporary = Path(tempfile.mkdtemp(prefix=f'sandpi-bare-{os.getuid()}-'))
        try:
            socket_path = temporary / 'auth.sock'
            config_path = area / 'launch.json'
            atomic_json(config_path, {'schema': 'sandpi.launch.v1', 'mode': 'bare-metal',
                        'room_id': plan['room_id'], 'workspace': str(project),
                        'workdir': plan.get('host_workdir', str(project)),
                        'providers': plan['providers'], 'pi_args': plan['pi_args'],
                        'pi_runtime': plan.get('pi_runtime', {}),
                        'pi_binary': str(bundle / 'bin/pi'),
                        'upstream_pi': str(bundle / 'upstream-pi/bin/pi'),
                        'core_package': str(bundle / 'share/sandpi/pi-package'),
                        'runtime_config': str(area / 'runtime.json'),
                        'agent_dir': str(area / 'agent'),
                        'credential_socket': str(socket_path), 'tools_path': env['PATH'],
                        'shell_only': args.shell, 'pi_only': args.pi_only or plan['io']['headless'],
                        'exec_command': args.exec_command, 'io': plan['io']})
            store = attach_report_store(credential_store(args, Path(plan['credential_root'])), root,
                                        plan.get('pi_runtime', {}), room_id=plan['room_id'], project=project)
            log('BARE METAL: Pi and the following shell run as REAL HOST ROOT. No VM, cgroup budget, or host filesystem isolation.')
            command = [sys.executable, str(SOURCE / 'src/host.py'), '_bare', str(config_path)]
            if effective_uid() != 0:
                command = ['sudo', '-H', '--', *command]
            with credential_server(socket_path, store, warm_openrouter='openrouter' in plan['providers']):
                # Keep the broker alive when Ctrl-C interrupts Pi in the shared
                # terminal. A caught (rather than ignored) handler resets at exec.
                previous_int = signal.signal(signal.SIGINT, lambda _s, _f: None)
                try:
                    return run(command, check=False, env=env,
                               stdin=subprocess.DEVNULL if plan['io']['stdin'] == 'eof' else None).returncode
                finally:
                    signal.signal(signal.SIGINT, previous_int)
        finally:
            shutil.rmtree(temporary)


def bare_inner(path: Path) -> int:
    if effective_uid() != 0:
        raise SandpiError('internal bare-metal entry requires real root', 77)
    from guest import configure_runtime, enter, load_launch
    cfg = load_launch(path)
    if cfg.get('mode') != 'bare-metal':
        raise SandpiError('not an explicit bare-metal launch record', 77)
    os.environ['PATH'] = cfg['tools_path']
    os.environ['SANDPI_CREDENTIAL_SOCKET'] = cfg['credential_socket']
    os.environ['PI_CODING_AGENT_DIR'] = cfg['agent_dir']
    # Preserve any session-directory choice that reached this explicit root
    # entry. Otherwise Pi owns settings and project-specific session storage.
    os.environ['SANDPI_MODE'] = 'bare-metal'
    os.environ['SANDPI_ROOM'] = cfg['room_id']
    os.environ['SANDPI_RUNTIME_CONFIG'] = cfg['runtime_config']
    os.environ['SANDPI_CORE_PACKAGE'] = cfg['core_package']
    os.environ['SANDPI_UPSTREAM_PI'] = cfg['upstream_pi']
    helper_dir = Path(cfg['agent_dir']) / 'sandpi-bin'
    helper_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Root has elected to trust this extracted runtime by using --BARE-METAL.
    import shlex
    helper = helper_dir / 'sandpi-auth'
    atomic_write(helper, '#!' + (shutil.which('bash') or '/bin/bash') + '\nexec ' +
                 shlex.join([sys.executable, str(SOURCE / 'src/guest.py'), 'auth']) + ' "$@"\n', 0o700)
    configure_runtime(Path(cfg['agent_dir']), cfg, str(helper),
                      package_source=cfg['core_package'], runtime_path=cfg['runtime_config'])
    os.environ['PATH'] = str(helper_dir) + ':' + str(Path(cfg['pi_binary']).parent) + ':' + os.environ['PATH']
    os.chdir(cfg.get('workdir', cfg['workspace']))
    if cfg.get('exec_command') is not None:
        return subprocess.run(['bash', '-lc', cfg['exec_command']], check=False).returncode
    return enter(cfg, shell_only=cfg.get('shell_only', False), pi_only=cfg.get('pi_only', False))


def room_status(room: Path, *, live: bool = False) -> dict[str, Any]:
    status = read_json(room / 'status.json', {})
    status['process_alive'] = alive(status.get('pid', -1), status.get('identity'))
    if live and not status['process_alive']:
        raise SandpiError('this room is not running', 69)
    return status


def running_command(args: argparse.Namespace, *, attach: bool) -> int:
    root, _cred, project, rid, room = locations(args)
    status = room_status(room, live=True)
    cfg = read_json(room / 'launch-host.json')
    if attach and args.pi:
        # Keep the legacy spelling, but use the same unique secondary-entry path
        # as plain `sandpi`. `--fresh` is applied inside the guest before the
        # process-local runtime is materialized.
        for name, value in (('shell', False), ('pi_only', False), ('exec_command', None),
                            ('cpus', None), ('memory', None), ('disk_size', None),
                            ('publish', []), ('publish_udp', []), ('gemini_key', None),
                            ('openrouter_key', None)):
            setattr(args, name, value)
        args._explicit_flags = set()
        guest_launch = cfg.get('guest_launch', {})
        plan = {'root': str(root), 'project': str(project), 'room_id': rid,
                'room_dir': str(room), 'guest_workdir': args._project_selection['guest_workdir'],
                'providers': guest_launch.get('providers', []),
                'pi_args': [], 'pi_runtime': guest_launch.get('pi_runtime', {}),
                'benchmark': None, 'resources': cfg.get('resources'),
                'store_cache': cfg.get('store_cache'),
                'network': {'publish': cfg.get('publish', []),
                            'publish_udp': cfg.get('publish_udp', [])},
                'io': {'interface': 'text', 'pty': True, 'headless': False, 'stdin': 'inherit'}}
        return reenter_running(args, plan, status, fresh=True)

    env = tools_environment(Path(cfg['bundle']))
    guest_workdir = args._project_selection['guest_workdir']
    if attach:
        command = ('/run/current-system/sw/bin/sandpi-enter --shell --workdir ' +
                   shlex.quote(guest_workdir))
    else:
        command = 'cd ' + shlex.quote(guest_workdir) + ' && ' + args.shell_command
    # A secondary SSH session never owns or shuts down the room, but it does
    # publish a host-side occupancy lease so shutdown cannot kill it silently.
    plan = {'room_id': rid}
    return _tracked_running_command(room, plan, status, command,
                                    interface='shell' if attach else 'exec',
                                    tty=attach, env=env)


def doctor(args: argparse.Namespace) -> int:
    root, cred, project, rid, room = locations(args)
    env = dict(os.environ)
    if args.fix:
        private_dir(root)
        bundle = build(SOURCE, root)
        env = tools_environment(bundle)
        ensure_kvm(env, repair=True)
    checks: dict[str, dict[str, Any]] = {}
    def record(name: str, okay: bool, detail: str) -> None:
        checks[name] = {'ok': bool(okay), 'detail': detail}
    record('linux', platform.system() == 'Linux', platform.platform())
    record('architecture', platform.machine() in ('x86_64', 'aarch64'), platform.machine())
    try:
        nix = find_nix()
        check = run([nix, '--version'], capture=True, check=False)
        record('nix', check.returncode == 0, check.stdout.decode().strip())
    except SandpiError as exc:
        record('nix', False, str(exc))
    record('kvm', os.access('/dev/kvm', os.R_OK | os.W_OK), '/dev/kvm must be readable and writable by the current user')
    record('cgroup_v2', Path('/sys/fs/cgroup/cgroup.controllers').exists(), 'aggregate and per-room accounting use systemd/cgroup v2')
    try:
        vm.ensure_user_manager()
        record('systemd_user', True, 'user manager reachable')
    except SandpiError as exc:
        record('systemd_user', False, str(exc))
    try:
        namespace_check(env)
        record('user_mount_namespaces', True, 'unshare root mapping and private mount namespace available')
    except SandpiError as exc:
        record('user_mount_namespaces', False, str(exc))
    try:
        resources = Resources.calculate().as_json()
        record('resources', True, f'{resources["cpus"]} vCPUs; {resources["guest_memory"] // MIB} MiB guest RAM plus overhead')
    except SandpiError as exc:
        resources = None
        record('resources', False, str(exc))
    record('normal_host_user', effective_uid() != 0, 'VM mode is unprivileged; host root is an explicit separate mode')
    linger = linger_enabled()
    data = {'schema': 'sandpi.doctor.v1', 'checks': checks, 'resources': resources,
            'detached_rooms': {'user_linger': linger,
                               'meaning': 'disabled linger may stop user services at final logout; Sandpi never changes it'},
            'shared_credentials': credential_store(args, cred).status(), 'project': str(project),
            'project_selection': args._project_selection,
            'state_root': str(root), 'pins': read_json(SOURCE / 'pins.json')}
    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        for name, item in checks.items():
            print(f'{"OK" if item["ok"] else "CHECK":5s} {name}: {item["detail"]}')
        print('INFO  detached linger: ' + ('enabled' if linger is True else 'disabled' if linger is False else 'unknown'))
        print('Credential metadata: sandpi creds --json')
    return 0 if all(x['ok'] for x in checks.values()) else 1


def machine_settings(args: argparse.Namespace) -> int:
    """Inspect or forget the persistent VM-only profile for one room.

    Resetting never removes the disk, Pi sessions, guest packages, checkpoints,
    project files, credentials, grades or key-bank state.  It merely causes the
    next stopped-room launch to derive fresh half-host CPU/RAM defaults, host
    store-cache mode and no port forwards unless explicit flags are supplied.
    """
    import machine

    root, _cred, project, rid, room = locations(args)
    if args.reset:
        if not args.yes:
            raise SandpiError('resetting persistent machine defaults requires --yes; the room disk and Pi state are preserved', 64)
        if not room.exists() or room.is_symlink():
            raise SandpiError('this room has no saved machine settings', 66)
        import lifecycle
        with lifecycle.stopped_room(root, room):
            import upgrades
            upgrades.assert_structural_mutation_allowed(room, 'reset the machine profile')
            receipt = machine.reset_profile(room, revision=REVISION)
        if args.json:
            print(json.dumps(receipt, indent=2, sort_keys=True))
        else:
            print('Machine defaults reset. The disk and Pi state remain; the next launch uses current host defaults unless flags override them.')
        return 0

    metadata = machine.read_metadata(room)
    profile = metadata.get('machine_profile')
    persisted = profile is not None
    if profile is None:
        disk = room / 'root.raw'
        if disk.is_symlink():
            raise SandpiError('guest disk cannot be a symlink', 78)
        disk_bytes = disk.stat().st_size if disk.is_file() else metadata.get('disk_bytes', 100 * GIB)
        resources = Resources.calculate(disk=str(disk_bytes)).as_json()
        profile = machine.make_profile(resources, store_cache='host', publish=[], publish_udp=[], revision=REVISION)
    view = machine.public_view(profile, persisted=persisted,
                               source='saved-room-profile' if persisted else 'current-host-default-preview')
    view.update(room_id=rid, name=args._resolved_name, project=str(project), disk_exists=(room / 'root.raw').is_file(),
                room_selection=dict(args._room_selection))
    try:
        Resources.calculate(profile['cpus'], str(profile['memory_budget']), str(profile['disk_bytes']))
        view['fits_current_host'] = True
    except SandpiError as error:
        view['fits_current_host'] = False
        view['fit_issue'] = str(error)
    if args.json:
        print(json.dumps(view, indent=2, sort_keys=True))
    else:
        p = view['profile']
        state = 'saved' if persisted else 'preview (not saved yet)'
        print(f'Room machine settings: {state}')
        print(f'  CPUs          {p["cpus"]}')
        print(f'  memory        {p["memory_budget"] // MIB} MiB total room budget')
        print(f'  disk          {p["disk_bytes"] // GIB} GiB sparse capacity')
        print(f'  Nix cache     {p["store_cache"]}')
        print(f'  TCP forwards  {", ".join(p["publish"]) or "none"}')
        print(f'  UDP forwards  {", ".join(p["publish_udp"]) or "none"}')
        print(f'  current host  {"fits" if view["fits_current_host"] else "does not fit: " + view["fit_issue"]}')
        print('Machine settings persist across normal stops. Provider/model/session/tool choices do not.')
    return 0



def upgrade_settings(args: argparse.Namespace) -> int:
    """Inspect or resolve the single cold runtime-upgrade rollback slot."""
    import lifecycle
    import upgrades

    root, _cred, project, rid, room = locations(args)
    target = upgrades.current_contract(SOURCE)
    if args.action == 'status':
        view = upgrades.status(room, target)
        view.update(project=str(project), name=args._resolved_name,
                    room_selection=dict(args._room_selection))
        if args.json:
            print(json.dumps(view, indent=2, sort_keys=True))
            return 0
        print(f'Runtime upgrade: {view["action"]}')
        print(f'  room          {args._resolved_name} ({rid})')
        target_contract = view['target_contract']
        print(f'  target        sandpi {target_contract["sandpi_version"]} rev{target_contract["sandpi_revision"]:04d}  pi {target_contract["pi_version"]}')
        stored = view.get('stored_contract')
        if stored:
            print(f'  last ready    sandpi {stored["sandpi_version"]} rev{stored["sandpi_revision"]:04d}  pi {stored["pi_version"]}')
        else:
            print('  last ready    legacy/unknown (first successful current boot will publish the exact contract)')
        active = view.get('active')
        if active:
            print(f'  transaction   {active["id"]}  stage={active["stage"]}')
            disks = view.get('disks') or {}
            for label in ('rollback', 'forward'):
                disk = disks.get(label) or {}
                if disk.get('exists'):
                    print(f'  {label:12s} {disk["logical_bytes"] / GIB:.1f} GiB logical; {disk["allocated_bytes"] / MIB:.1f} MiB allocated')
            if active['stage'] == 'ready':
                print('  next          `sandpi upgrade accept --yes` or keep the rollback until a later revision supersedes it')
            elif active['stage'] == 'ready-committing':
                print('  next          plain `sandpi` completes the already-proven readiness commit; rollback/retry remain available')
            elif active['stage'] == 'rolled-back' and active.get('rollback_from_stage') == 'ready':
                print('  next          `sandpi upgrade forward --yes` restores the newer guest disk; accept keeps the older disk')
            elif active['stage'] == 'rolled-back':
                print('  next          `sandpi upgrade accept --yes` keeps the source disk; retry prepares a clean new attempt')
            elif str(active['stage']).startswith('forward-'):
                print('  next          `sandpi upgrade forward --yes` completes the interrupted forward switch')
            else:
                print('  next          `sandpi upgrade rollback --yes` or `sandpi upgrade retry --yes`')
        else:
            print('  rollback      none retained')
        print('The rollback is the whole cold guest disk: guest-local Pi sessions, packages, and config move with it. The live host workspace, canonical credentials, and VMM RAM do not.')
        return 0

    if not args.yes:
        raise SandpiError(f'`sandpi upgrade {args.action}` requires --yes; the operation switches or discards whole-guest-disk state', 64)
    if not room.exists() or room.is_symlink():
        raise SandpiError('this project room does not exist', 66)
    with lifecycle.stopped_room(root, room, require_disk=True):
        if args.action == 'accept':
            result = upgrades.accept(room)
        elif args.action == 'rollback':
            result = upgrades.rollback(room)
        elif args.action == 'forward':
            result = upgrades.forward(room)
        elif args.action == 'retry':
            result = upgrades.retry(room)
        else:  # argparse constrains this, keep the dispatch closed.
            raise SandpiError('unknown runtime-upgrade action', 64)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif args.action == 'accept':
        if result.get('accepted_state') == 'source':
            print('Accepted the rolled-back source disk and removed the retained newer disk. Guest-local Pi state from the newer disk was discarded; the host workspace and credentials were untouched.')
        else:
            print('Accepted the guest-ready Sandpi runtime and removed its older rollback disk. Current guest-local Pi state, workspace, and credentials were unchanged.')
    elif args.action == 'rollback':
        print('Restored the pre-upgrade whole guest disk and exact room metadata. Guest-local Pi sessions/packages reverted with it; the newer disk is retained for `sandpi upgrade forward --yes`.')
    elif args.action == 'forward':
        print('Restored the retained newer whole guest disk and exact metadata. Its guest-local Pi sessions/packages are current again; the older rollback remains available.')
    else:
        print('Restored the pre-upgrade source state and cleared the slot. Any retained newer guest-local state was discarded; the next launch prepares a fresh rollback.')
    return 0


def project_settings(args: argparse.Namespace) -> int:
    """Inspect, initialize, recover, move, or split the host-only project anchor."""
    import project as project_state
    import roomselect

    root, _cred, project, name = base_locations(args)
    identity = project_state.load(project)
    action: dict[str, Any] | None = None

    if args.new:
        if not args.yes:
            raise SandpiError('creating a new project identity requires --yes; existing room disks are not deleted', 64)
        state = project_state.binding_state(root, project, identity['room_namespace'])
        existing = _project_rooms(root, identity['room_namespace'])
        # ``--new`` is primarily the safe answer for a copied .sandpi directory.
        # Refuse to orphan rooms from the path that currently owns them.
        if state['state'] in {'bound', 'moved-same-directory', 'moved-prior-path-missing'} and existing:
            raise SandpiError(
                'this path currently owns persistent rooms; --new would orphan their normal project lookup. '
                'Use --new only on a copied project, or remove/migrate those rooms deliberately first.', 75)
        selection_before = roomselect.snapshot(project, identity['room_namespace'])
        old, identity = project_state.rotate(project, revision=REVISION)
        try:
            # A copied project must not inherit the original project's preferred
            # machine name. The old value is restored if publishing the new
            # identity fails.
            roomselect.remove_unchecked_for_rotation(project)
            bound = project_state.bind(root, project, identity, revision=REVISION)
        except BaseException:
            project_state.restore_rotated_anchor(project, old)
            roomselect.restore(project, old['room_namespace'], selection_before)
            raise
        action = {'schema': 'sandpi.project-new.v1',
                  'old_namespace_sha256': sha256(old['room_namespace'].encode()),
                  'new_namespace_sha256': sha256(identity['room_namespace'].encode()),
                  'binding': bound}
    elif args.recover:
        if not args.yes:
            raise SandpiError('restoring a missing project anchor requires --yes', 64)
        if identity['persisted']:
            raise SandpiError(
                'this project already has a Sandpi anchor; use --rebind --yes when its directory object changed', 64)
        candidate, discovery = project_state.select_recovery_candidate(
            root, project, selector=None if args.recover == 'auto' else args.recover)
        with project_state.materialize(
                private_dir(root), project, expected_namespace=candidate['room_namespace'],
                revision=REVISION, explicit_recovery=True) as staged:
            identity, staged_candidate = staged
            bound = project_state.bind(
                root, project, identity, revision=REVISION, force=True,
                migrate=lambda old, new, namespace: _migrate_project_binding(root, old, new, namespace),
            )
        action = {'schema': 'sandpi.project-recover.v1',
                  'namespace_sha256': candidate['namespace_sha256'],
                  'match': candidate['match'], 'source': candidate['source'],
                  'rooms': candidate['rooms'], 'issues': discovery['issues'],
                  'binding': bound,
                  'anchor_recovered': staged_candidate is not None}
    elif args.rebind:
        if not args.yes:
            raise SandpiError('taking over an existing project identity requires --yes', 64)
        if not identity['persisted']:
            raise SandpiError(
                'the project anchor is missing; inspect `sandpi project --json` and use '
                '`sandpi project --recover --yes` or `sandpi project --new --yes`', 75)
        action = project_state.bind(
            private_dir(root), project, identity, revision=REVISION, force=True,
            migrate=lambda old, new, namespace: _migrate_project_binding(root, old, new, namespace),
        )
    elif args.init:
        resolved = project_state.resolve(root, project)
        with project_state.materialize(
                private_dir(root), project, expected_namespace=resolved['room_namespace'],
                revision=REVISION) as staged:
            identity, candidate = staged
            bound = project_state.bind(
                root, project, identity, revision=REVISION,
                migrate=lambda old, new, namespace: _migrate_project_binding(root, old, new, namespace),
            )
        action = {'schema': 'sandpi.project-init.v2', 'binding': bound,
                  'anchor_recovered': candidate is not None}

    identity = project_state.load(project)
    if identity.get('persisted'):
        room_choice = roomselect.load(project, identity['room_namespace'])
    else:
        room_choice = {'schema': roomselect.SCHEMA, 'selected_name': 'default',
                       'selected_at': None, 'selected_revision': None,
                       'persisted': False, 'source': 'implicit-default',
                       'path': str(project / roomselect.FILE)}
    if args.name is None:
        name = room_choice['selected_name']
    view = project_state.view(root, project, name=name)
    view['selection'] = args._project_selection
    view['room_selection'] = room_choice
    if action is not None:
        view['action'] = action
    rooms = {room.name for room, _metadata in _project_rooms(root, identity['room_namespace'])}
    for candidate in view.get('recovery', {}).get('candidates', []):
        rooms.update(candidate.get('rooms', []))
    view['rooms'] = sorted(rooms)
    if args.json:
        print(json.dumps(view, indent=2, sort_keys=True))
    else:
        anchor = view['anchor']
        binding = view['binding']
        print(f'Project: {view["project"]}')
        selection = view['selection']
        print(f'  Pi cwd       {selection["host_workdir"]} → {selection["guest_workdir"]}')
        print(f'  selected by  {selection["source"]}')
        print(f'  anchor       {"saved" if anchor["persisted"] else "missing / preview"}')
        print(f'  namespace    {anchor["namespace_sha256"][:16]}…')
        print(f'  binding      {binding.get("state", "unknown")}' +
              (f' → {binding.get("project")}' if binding.get('project') else ''))
        print(f'  room         {view["room_id"]}  name={name}')
        print(f'  plain entry  {room_choice["selected_name"]} ({room_choice["source"]})')
        print(f'  known rooms  {", ".join(view["rooms"]) or "none"}')
        recovery = view.get('recovery')
        if recovery and recovery.get('candidates'):
            print('  recovery     ' + str(len(recovery['candidates'])) + ' candidate(s)')
            for candidate in recovery['candidates']:
                suffix = ','.join(candidate.get('rooms', [])) or 'no-room-receipt'
                print(f'    {candidate["match"]:<20} {candidate["namespace_sha256"][:16]}…  {suffix}')
            if len({candidate['room_namespace'] for candidate in recovery['candidates']}) == 1:
                print('Run `sandpi project --recover --yes` to restore this identity.')
            else:
                print('Choose one digest prefix with `sandpi project --recover SHA256_PREFIX --yes`.')
        print('The .sandpi directory is host-only and masked from the VM workspace.')
    return 0


def rooms_settings(args: argparse.Namespace) -> int:
