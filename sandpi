        if command == 'version':
            print(json.dumps({'sandpi': VERSION, 'revision': REVISION, 'pins': read_json(SOURCE / 'pins.json')}, indent=2))
            return 0
        if command == 'selftest':
            runner = SOURCE / 'tools/offline-tests.py'
            return subprocess.run([sys.executable, os.fspath(runner), '--pattern', args.pattern],
                                  cwd=SOURCE, check=False).returncode
        if command == 'render':
            result = render_flake(SOURCE, canonical(args.directory))
            print(result)
            return 0
        if command == 'presets':
            import catalog
            import model_defaults
            policy = model_defaults.load()
            root = private_dir(canonical(args.home or os.environ.get('SANDPI_HOME', Path.home() / '.sandstuff/sandpi')))
            snapshot = (catalog.load_all(root, refresh=True) if args.refresh else
                        catalog.load_all(root, offline=True) if args.offline else
                        catalog.cached_all(root))
            audited = (model_defaults.audit(policy, snapshot.get('models', [])) if snapshot is not None else
                       [{**row, 'status': 'unverified', 'detail': 'no cached catalog; use --refresh'}
                        for row in policy['recipes']])
            payload = {
                'schema': 'sandpi.model-recipe-audit.v1',
                'policy': policy,
                'policy_current': model_defaults.current(policy),
                'catalog': None if snapshot is None else {
                    'schema': snapshot.get('schema'), 'fetched_at': snapshot.get('fetched_at'),
                    'fingerprint': snapshot.get('fingerprint'), 'stale': bool(snapshot.get('stale', False)),
                },
                'recipes': audited,
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                source = 'no cached catalog; use --refresh' if snapshot is None else (
                    'cached catalog (stale)' if snapshot.get('stale') else 'cached/live catalog')
                print(f'Exact OpenRouter presets (review {policy["reviewed_at"]} through {policy["review_after"]}; {source})')
                for row in audited:
                    status = row['status']
                    print(f'{row["preset"]:16} {row["role"]:22} {row["model"]:44} {status:20} '
                          f'{row["tool_profile"]} thinking={row["thinking"]}')
                print('Use sandpi --paid --preset NAME. A changed canonical revision withdraws the recipe; '
                      'the exact model remains available through --model with native/conservative behavior.')
            return 0
        if command == 'plan':
            print(json.dumps(launch_plan(args, extra), indent=2, sort_keys=True))
            return 0
        if command == 'run':
            return launch(args, extra)
        if command == 'up':
            prepare_detached_start(args)
            return launch(args, [])
        if command == 'doctor':
            return doctor(args)
        if command == 'project':
            return project_settings(args)
        if command == 'machine':
            return machine_settings(args)
        if command == 'upgrade':
            return upgrade_settings(args)
        if command == 'rooms':
            return rooms_settings(args)
        if command == 'use':
            return use_settings(args)
        if command == 'clone':
            return clone_room(args)
        if command == 'rename':
            return rename_room(args)
        if command == 'backup':
            return backup_settings(args)
        root, cred, project, rid, room = locations(args)
        if command == 'storage':
            import lifecycle
            data = lifecycle.inventory(root, selected_room=None if args.all else room)
            if args.json:
                print(json.dumps(data, indent=2, sort_keys=True))
            else:
                def size(value: int) -> str:
                    units = ('B', 'KiB', 'MiB', 'GiB', 'TiB')
                    amount = float(value)
                    unit = units[0]
                    for unit in units:
                        if amount < 1024 or unit == units[-1]:
                            break
                        amount /= 1024
                    return f'{amount:.1f}{unit}'
                if not data['rooms']:
                    print('No persistent Sandpi room for this selection.')
                for row in data['rooms']:
                    disk = row['disk']
                    print(f'{row["room_id"]}  name={row.get("name") or "-"}  state={row["state"]}')
                    print(f'  disk         capacity={size(disk["logical_bytes"])}  allocated={size(disk["allocated_bytes"])}')
                    profile = row.get('machine_profile') or {}
                    if profile:
                        print(f'  machine      cpus={profile.get("cpus", "-")}  memory={size(profile.get("memory_budget", 0))}  cache={profile.get("store_cache", "-")}')
                    print(f'  checkpoints  count={row["checkpoints"]["count"]}  allocated={size(row["checkpoints"]["allocated_bytes"])}')
                    upgrade = row.get('upgrade') or {}
                    active_upgrade = upgrade.get('active') or {}
                    if active_upgrade:
                        print(f'  upgrade      stage={active_upgrade.get("stage", "unknown")}  allocated={size(upgrade.get("allocated_bytes", 0))}')
                    elif upgrade.get('allocated_bytes'):
                        print(f'  upgrade      receipts-only allocated={size(upgrade.get("allocated_bytes", 0))}')
                    print(f'  logs         runs={row["logs"]["runs"]}  allocated={size(row["logs"]["allocated_bytes"])}')
                print(f'shared Nix lease: {data["cache"]["path_count"]} retained paths; metadata allocated={size(data["cache"]["allocated_bytes"])}')
                if data['trash']['allocated_bytes']:
                    print(f'quarantined state requiring inspection: {size(data["trash"]["allocated_bytes"])}')
                print('Sparse capacity is not host allocation; shared /nix/store bytes are not double-counted here.')
            return 0
        if command == 'clean':
            import lifecycle
            if args.cache:
                result = lifecycle.reset_cache(root, confirmed=args.yes)
            elif args.trash:
                result = lifecycle.clean_trash(root, confirmed=args.yes)
            elif args.room:
                import project as project_state
                import roomselect
                identity = project_state.load(project)
                prior_selection = None
                selection_was_reset = False
                if identity.get('persisted'):
                    current_selection = roomselect.load(project, identity['room_namespace'])
                    if current_selection['persisted'] and current_selection['selected_name'] == args._resolved_name:
                        prior_selection = roomselect.snapshot(project, identity['room_namespace'])
                        roomselect.reset(project, identity['room_namespace'], revision=REVISION)
                        selection_was_reset = True
                try:
                    result = lifecycle.remove_room(root, room, confirmed=args.yes)
                except BaseException:
                    if selection_was_reset:
                        roomselect.restore(project, identity['room_namespace'], prior_selection)
                    raise
                result['room_selection_reset'] = selection_was_reset
            elif args.checkpoints:
                result = lifecycle.clean_checkpoints(root, room, confirmed=args.yes)
            else:
                result = lifecycle.clean_logs(root, room, all_logs=args.logs, confirmed=args.yes)
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(f'{result["scope"]}: removed={result["removed"]} allocated-bytes={result["allocated_bytes"]}')
                if result['scope'] == 'room':
                    print('Host workspace and canonical Sandcodex credentials were preserved.')
                    if result.get('room_selection_reset'):
                        print('The deleted active room was reset to the implicit default selection.')
                if result['scope'] == 'host-nix-cache':
                    print('Sandpi GC roots were released; host Nix garbage collection was not run.')
            return 0
        if command == 'sessions':
            import sessions
            rows = sessions.list_sessions(root, room=None if args.all else rid,
                                          project=None if args.all else project, limit=args.limit)
            if args.json:
                print(json.dumps({'schema': sessions.SCHEMA, 'sessions': rows}, indent=2, sort_keys=True))
            elif not rows:
                print('No observed native Pi sessions for this room.')
            else:
                for row in rows:
                    model = row.get('model') or {}
                    identity = f'{model.get("provider", "-")}/{model.get("id", "-")}' if model else '-'
                    name = f'  name={row["name"]}' if row.get('name') else ''
                    thinking = f'  thinking={row["thinking_level"]}' if row.get('thinking_level') else ''
                    transport = f'  api={model["api"]}' if model.get('api') else ''
                    resume = f'  resume={row["resume"]["outcome"]}' if row.get('resume') else ''
                    location = ''
                    if row.get('mode') or row.get('workdir'):
                        location = f'  mode={row.get("mode", "-")}  cwd={row.get("workdir", "-")}'
                    print(f'{row["session"]}  room={row["room"]}{location}  model={identity}{transport}  profile={row["tool_profile"]}{thinking}{resume}  last={row["event"]}{name}')
            return 0
        if command == 'models':
            import catalog, benchmark
            if args.refresh and args.offline:
                raise SandpiError('--refresh and --offline are mutually exclusive', 64)
            if args.focus and not args.diff:
                raise SandpiError('--focus requires --diff previous current', 64)
            focus_ids = catalog.normalize_delta_focus_ids(args.focus) if args.focus else []
            loader = catalog.load_all if args.paid else catalog.load
            if args.snapshots or args.diff:
                # Snapshot inspection is local unless the user explicitly asks
                # for a refresh. The refresh itself publishes the predecessor
                # before these readers compare it with the new current slot.
                if args.refresh:
                    loader(root, refresh=True)
                if args.snapshots:
                    value = catalog.snapshot_inventory(root, paid=args.paid)
                    print(json.dumps(value, indent=2, sort_keys=True) if args.json else
                          catalog.render_snapshot_inventory(value))
                    return 0
                before_name, after_name = args.diff
                if before_name == after_name:
                    raise SandpiError('--diff requires two different selectors: previous and current', 64)
