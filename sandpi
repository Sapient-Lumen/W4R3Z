    first=subprocess.run([str(node),'--input-type=module','-e',creator],env={**env,'SANDPI_PROJECT':str(project)},
                         capture_output=True,text=True,timeout=30,check=True)
    selected=Path(first.stdout)
    if not selected.is_file():raise SandpiError('native Pi session fixture was not persisted')
    # A newer session for another cwd proves that Pi's own custom-directory cwd
    # filter, rather than global mtime alone, determines deterministic continue.
    subprocess.run([str(node),'--input-type=module','-e',creator],env={**env,'SANDPI_PROJECT':str(other)},
                   capture_output=True,text=True,timeout=30,check=True)
    command=[str(node),str(ROOT/'src/pi/session-preflight.mjs'),'--module',str(module),
             '--cwd',str(project),'--session-dir',str(sessions)]
    result=subprocess.run(command,env=env,capture_output=True,text=True,timeout=30,check=True)
    if TRANSCRIPT_SENTINEL in result.stdout+result.stderr:
        raise SandpiError('native resume preflight exposed transcript content')
    snapshot=json.loads(result.stdout)
    expected={'schema','found','session','file','projected_model','thinking_level','tool_profile',
              'transport','affinity_origin','last_handoff'}
    if set(snapshot)!=expected or snapshot.get('schema')!='sandpi.native-resume-snapshot.v1' or not snapshot.get('found'):
        raise SandpiError('native resume preflight returned the wrong fixed schema')
    if snapshot.get('projected_model')!={'provider':'openrouter','id':CHAT_MODEL}:
        raise SandpiError('native resume preflight did not preserve the exact branch model')
    if snapshot.get('thinking_level')!='high' or snapshot.get('tool_profile',{}).get('effective')!='classic':
        raise SandpiError('native resume preflight lost branch-local settings')
    if snapshot.get('affinity_origin')!='google:fixture-affinity':
        raise SandpiError('native resume preflight lost Gemini affinity')
    if snapshot.get('file',{}).get('name')!=selected.name or len(snapshot.get('file',{}).get('sha256',''))!=64:
        raise SandpiError('native resume preflight selected the wrong cwd-bound session or omitted its digest')
    atomic_json(out/'resume-preflight.json',snapshot)
    checks=['native-sessionmanager-preflight','native-continue-cwd-filter','resume-snapshot-fixed-schema',
            'resume-snapshot-content-free','resume-snapshot-model-continuity','resume-snapshot-affinity-continuity',
            'resume-snapshot-stable-digest']
    # Exercise the actual installed SettingsManager and default directory too;
    # the historical explicit-directory case cannot establish these properties.
    directory_rows=[]
    base_command=command[:-2]
    def create_in(directory):
        local={**env,'SANDPI_PROJECT':str(project)}
        if directory is None:local.pop('SANDPI_SESSIONS',None)
        else:local['SANDPI_SESSIONS']=str(directory)
        made=subprocess.run([str(node),'--input-type=module','-e',creator],env=local,
                            cwd=project,capture_output=True,text=True,timeout=30,check=True)
        path=Path(made.stdout)
        if not path.is_file():raise SandpiError('native directory fixture was not persisted')
        return path
    def directory_check(name,expected_file,args=(),env_dir=None):
        local=dict(env)
        if env_dir is not None:local['PI_CODING_AGENT_SESSION_DIR']=env_dir
        response=subprocess.run([*base_command,*args],env=local,capture_output=True,text=True,
                                timeout=30,check=True)
        if TRANSCRIPT_SENTINEL in response.stdout+response.stderr:
            raise SandpiError('native directory preflight exposed transcript content')
        value=json.loads(response.stdout)
        if set(value)!=expected or value.get('schema')!='sandpi.native-resume-snapshot.v1' or not value.get('found'):
            raise SandpiError('native directory preflight returned the wrong fixed schema')
        if value.get('file',{}).get('name')!=expected_file.name:
            raise SandpiError('native directory preflight selected the wrong session: '+name)
        if value.get('projected_model')!={'provider':'openrouter','id':CHAT_MODEL}:
            raise SandpiError('native directory preflight lost model continuity: '+name)
        checks.append(name);directory_rows.append({'check':name,'snapshot':value})
    default_file=create_in(None)
    directory_check('resume-native-default-project-directory',default_file)
    atomic_json(agent/'settings.json',{'sessionDir':str(sessions)})
    directory_check('resume-native-global-sessiondir-setting',selected)
    project_sessions=area/'project sessions';project_file=create_in(project_sessions)
    atomic_json(project/'.pi/settings.json',{'sessionDir':str(project_sessions)})
    directory_check('resume-native-project-sessiondir-precedence',project_file)
    directory_check('resume-native-environment-over-settings',selected,env_dir=str(sessions))
    directory_check('resume-native-cli-file-uri-over-environment',project_file,
                    ('--session-dir',project_sessions.as_uri()),str(sessions))
    directory_check('resume-native-cli-relative-directory',selected,
                    ('--session-dir',os.path.relpath(sessions,project)),str(project_sessions))
    directory_check('resume-native-empty-overrides-use-settings',project_file,('--session-dir',''),'')
    atomic_json(out/'resume-directory.json',{'checks':directory_rows,'native':True,
                'scope':'Installed Pi module/settings resolution, not terminal or VM execution.'})
    return checks


def run_protocol(pi:Path,service:Service,area:Path,out:Path,model:str)->list[str]:
    protocol=protocol_for(model)
    paid=model in PAID_MODELS
    case_name=('paid-' if paid else '')+protocol
    creds=area/'canonical';agent=area/'agent';project=area/'project';project.mkdir(parents=True)
    atomic_write(creds/'remote/openrouter-keys.txt','\n'.join(KEYS)+'\n')
    data=catalog.normalize({'data':[model_row(model)]},include_paid=paid)
    helper=area/'sandpi-auth'
    atomic_write(helper,'#!/bin/sh\nexec '+shlex.quote(sys.executable)+' '+shlex.quote(str(ROOT/'src/guest.py'))+' auth "$@"\n',0o700)
    launch={'mode':'vm','room_id':'synthetic-'+case_name,'providers':['openrouter'],'pi_runtime':{
        'catalog':catalog.free_view(data),'all_catalog':data if paid else {},
        'paid_enabled':paid,'max_price':{'prompt':3.0,'completion':12.0} if paid else None}}
    configure_runtime(agent,launch,str(helper))
    chat_base=f'http://127.0.0.1:{service.server_port}/v1'
    messages_base=f'http://127.0.0.1:{service.server_port}'
    bases={'openai-completions':chat_base,'anthropic-messages':messages_base}
    config=json.loads((agent/'sandpi-runtime.json').read_text())
    for definition in config['modelDefinitions']:
        definition['baseUrl']=bases[definition['api']]
    config['syntheticTransportBases']=bases
    atomic_json(agent/'sandpi-runtime.json',config)
    models=json.loads((agent/'models.json').read_text())
    provider=models['providers']['openrouter']
    provider['baseUrl']=bases[config['modelDefinitions'][0]['api']]
    provider.setdefault('modelOverrides',{})[model]={'headers':{**STALE_AUTH_HEADERS,
        'X-Sandpi-Header-Canary':HEADER_CANARY}}
    atomic_json(agent/'models.json',models)
    atomic_json(agent/'settings.json',{'cacheWarming':'off','retry':{'enabled':True},
        'compaction':{'enabled':False},'quietStartup':True})
    socket=area/'credentials.sock'
    env={k:v for k,v in os.environ.items() if not (k.endswith('_API_KEY') or k.startswith('PI_'))}
    env.update(HOME=str(area),PI_CODING_AGENT_DIR=str(agent),PI_OFFLINE='1',SANDPI_CREDENTIAL_SOCKET=str(socket))
    cmd=command(pi,agent,model)
    # Exercise the installed package under the same invocation contract as the
    # guest wrapper, not the obsolete writable-extension/base-runtime layout.
    invocation=prepare_pi_invocation(agent,cmd[1:],str(pi),project,
        base_runtime=agent/'sandpi-runtime.json',use_launch_policy=True)
    env['SANDPI_RUNTIME_CONFIG']=str(invocation)
    checks=[]
    with credential_server(socket,CredentialStore(creds,environ={})):
        first=subprocess.run([*cmd,'Create marker.txt using the write tool, then report the marker.'],cwd=project,env=env,
            stdin=subprocess.DEVNULL,capture_output=True,timeout=90)
        (out/f'{case_name}-tool-stream.jsonl').write_bytes(first.stdout)
        (out/f'{case_name}-tool-stderr.log').write_bytes(first.stderr)
        if first.returncode!=0:raise SandpiError(f'native Pi {protocol} tool fixture exited unsuccessfully; inspect synthetic trace')
        receipt=benchmark.receipt(first.stdout,model)
        if receipt['failure']!='none' or not receipt['completed_tools'].get('write'):
            raise SandpiError(f'native {protocol} tool did not complete and settle')
        if (project/'marker.txt').read_text()!=MARKER+'\n':raise SandpiError(f'native {protocol} write effect missing')
        requests=[row for row in service.requests if row['model']==model]
        if len(requests)!=3 or requests[0]['key_slot']==requests[1]['key_slot']:
            raise SandpiError(f'pre-response key failover or native {protocol} continuation contract changed')
        if not requests[-1]['tool_result']:raise SandpiError(f'native {protocol} tool result was not continued')
        if any(row.get('header_canary')!=HEADER_CANARY for row in requests):
            raise SandpiError(f'native {protocol} non-credential model header was lost')
        if any(key.encode() in first.stdout+first.stderr for key in KEYS):raise SandpiError('credential leaked to protocol output')
        if paid:
            identities={row['cache_affinity'] for row in requests}
            if len(identities)!=1:raise SandpiError('paid tool loop lost native session cache affinity')
            events=[json.loads(line) for line in first.stdout.splitlines() if line.strip()]
            costs=[event.get('message',{}).get('usage',{}).get('cost',{}).get('total',0) for event in events
                   if event.get('type')=='message_end' and event.get('message',{}).get('role')=='assistant']
            if not any(value>0 for value in costs):raise SandpiError('paid Pi usage was reported as free')
            checks += [f'{case_name}-nonzero-cost-accounting',f'{case_name}-stable-session-cache-affinity']
        checks += [f'{protocol}-native-adapter',f'{protocol}-endpoint',f'{protocol}-request-local-auth',
            f'{case_name}-payload-constraints',f'{protocol}-pre-content-401-failover',
            f'{protocol}-native-write-tool',f'{protocol}-tool-result-continuation',f'{protocol}-agent-settled',
            f'{protocol}-no-key-in-output',f'{protocol}-leased-header-final',
            f'{protocol}-noncredential-model-header-preserved']
        observed=usage_receipts(agent,model)
        audit_usage_receipts(observed,paid=paid)
        atomic_json(out/f'{case_name}-usage-receipts.json',observed)
        checks += [f'{case_name}-reported-charge-separate-from-estimate',f'{case_name}-native-cache-read-count',
            f'{case_name}-accounting-excluded-from-model-context',f'{case_name}-usage-opt-in-absent']
        service.modes[model]='partial';before=len(requests)
        # A second Pi process must receive its own invocation, not the first one's.
        invocation=prepare_pi_invocation(agent,cmd[1:],str(pi),project,
            base_runtime=agent/'sandpi-runtime.json',use_launch_policy=True)
        env['SANDPI_RUNTIME_CONFIG']=str(invocation)
        second=subprocess.run([*cmd,'Emit the partial-stream fixture.'],cwd=project,env=env,stdin=subprocess.DEVNULL,
            capture_output=True,timeout=45)
        (out/f'{case_name}-partial-stream.jsonl').write_bytes(second.stdout)
        (out/f'{case_name}-partial-stderr.log').write_bytes(second.stderr)
        receipt=benchmark.receipt(second.stdout,model)
        after=len([row for row in service.requests if row['model']==model])
        if receipt['failure']!='provider' or after!=before+1:
            raise SandpiError(f'{protocol} partial response was replayed or treated as success')
        audit_usage_receipts(usage_receipts(agent,model),paid=paid,partial=True)
        atomic_json(out/f'{case_name}-usage-receipts.json',usage_receipts(agent,model))
        checks += [f'{case_name}-interrupted-charge-unknown']
        checks += [f'{protocol}-no-post-content-replay',f'{protocol}-no-outer-retry-amplification']
    return [name.replace(protocol+'-',case_name+'-',1) if not name.startswith(case_name+'-') else name for name in checks]


def usage_receipts(agent:Path,model:str)->list[dict]:
    """Read only acceptance-owned synthetic session files, never user sessions."""
    rows=[]
    for path in sorted((agent/'sessions').glob('*.jsonl')):
        for line in path.read_text().splitlines():
            if not line.strip():continue
            entry=json.loads(line)
            if entry.get('type')=='custom' and entry.get('customType')=='sandpi.openrouter-usage.v1':
                row=entry.get('data',{})
                if row.get('model')==model:rows.append(row)
    return rows


def audit_usage_receipts(rows:list[dict],*,paid:bool,partial:bool=False)->None:
    expected=4 if partial else 3
    if len(rows)!=expected or len({(row['request'],row['attempt']) for row in rows})!=expected:
        raise SandpiError('native accounting receipt cardinality changed or attempt was counted twice')
    reported=[row for row in rows if row.get('charge_status')=='reported']
    unknown=[row for row in rows if row.get('charge_status')=='missing']
    if len(reported)!=2 or any(row.get('charge')!=(0.000137 if paid else 0) for row in reported):
        raise SandpiError('native OpenRouter reported charge was dropped or overwritten by a catalog estimate')
    if len(unknown)!=(2 if partial else 1) or any(row.get('charge') is not None for row in unknown):
        raise SandpiError('missing usage was invented as zero')
    if sum(row['tokens']['cache_read'] for row in reported)!=10:
        raise SandpiError('native cache-read accounting was lost or counted twice')
    if any(not row['complete'] or row['outcome']!='success' for row in reported):
        raise SandpiError('completed native request accounting did not settle')
    if paid and any(row['estimate'] is None or row['estimate']<=0 or row['estimate']==row['charge'] for row in reported):
        raise SandpiError('native estimate and reported charge were conflated')
    if partial and not any(not row['complete'] and row['charge'] is None and row['outcome']!='auth' for row in rows):
        raise SandpiError('truncated accounting fixture was not represented as incomplete')


