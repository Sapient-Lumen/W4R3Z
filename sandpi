def effective_uid() -> int:
    """Return the current host effective UID through a narrow test seam.

    Patching ``os.geteuid`` mutates the shared ``os`` module and can make
    independently loaded state validators believe user-owned files changed
    ownership.  Keep host-root dispatch testable without weakening those checks.
    """
    return os.geteuid()


