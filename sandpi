  const fetched = snapshot?.fetched_at;
  if (typeof fetched !== 'number' || !Number.isFinite(fetched)
      || fetched < CATALOG_CREATED_MIN || fetched > CATALOG_CREATED_MAX) return 'catalog snapshot time unknown';
  const date = new Date(fetched * 1000).toISOString().slice(0, 10);
  const state = snapshot?.stale === true ? 'stale' : 'loaded';
  return `${state} ${snapshot?.source === 'full' ? 'full' : 'free'} snapshot from ${date} UTC${snapshot?.refresh_failed === true ? '; last refresh failed' : ''}`;
}

/** UI-only disclosure for the user's optional query; empty for legacy queries. */
export function renderModelQueryScope(query, snapshot) {
  const lines = [];
  if (query?.maxInput != null) lines.push(`Input estimate filter: <= $${query.maxInput}/M tokens.`);
  if (query?.maxOutput != null) lines.push(`Output estimate filter: <= $${query.maxOutput}/M tokens.`);
  if (query?.recent != null) lines.push(`Catalog recency filter: added to OpenRouter within ${query.recent} days of the loaded snapshot, inclusive; unknown timestamps fail.`);
  if (query?.sort && query.sort !== 'default') lines.push(`${modelQueryOrderText(query)}; unknowns last, ties retain existing order.`);
  if (hasRateQuery(query)) lines.push('Rate comparisons use the highest base or configured prompt-tier rate in the effective Pi model; unknowns fail rate filters.',
    'Discovery only, NOT endpoint price limits or a spending cap. Cache, scheduled, endpoint and non-token charges may differ. Paid access and routing preferences are unchanged.');
  if (query?.sort === 'context') lines.push('Configured window, not available headroom or a quality ranking. Use --fits for the separate current-context estimate. Paid access and routing preferences are unchanged.');
  if (query?.recent != null || query?.sort === 'newest') lines.push(`Catalog reference: ${snapshotText(snapshot)}.`,
    'OpenRouter catalog-added time is not model release/training chronology, current provider readiness, quality, or a recommendation. Refresh is a separate host action.');
  return lines.join('\n');
}

/** Only use Pi's estimate for its current active window. Null/missing/stale is
 * unknown, never zero. Candidate comparisons remain approximate across models. */
export function inspectPickerContext(currentModel, usage) {
  if (!positive(currentModel?.contextWindow) || !count(usage?.tokens)
      || usage.contextWindow !== currentModel.contextWindow) return { status: 'unknown' };
  return { status: 'known', tokens: usage.tokens, sourceWindow: usage.contextWindow };
}

export function inspectModelFit(model, settings, context) {
  const window = positive(model?.contextWindow) ? model.contextWindow : null;
  const compaction = inspectCompaction(model, settings);
  if (window === null || context?.status !== 'known' || !count(context.tokens)) return { status: 'unknown', window };
  const used = context.tokens;
  if (used >= window) return { status: 'over', window, used, headroom: window - used };
  if (compaction.status !== 'known') return { status: 'unknown', window, used };
  const headroom = window - compaction.reserveTokens - used;
  return { status: headroom > 0 ? 'room' : 'tight', window, used, headroom,
    reserve: compaction.reserveTokens, compactionEnabled: compaction.enabled };
}

export function fitText(fit) {
  if (fit.status === 'room') return `estimated room ${fit.headroom} tokens after reserve`;
  if (fit.status === 'tight') return 'near/above compaction threshold';
  if (fit.status === 'over') return 'estimate reaches/exceeds context window';
  return 'context fit unknown';
}

/** Keep the same AND/substr search as the picker; never resolve aliases or
 * substitute catalog display names for native overrides. Missing native models
 * can be searched by their exact catalog ID and a currently applicable recipe. */
export function matchesModelTerms(row, query) {
  if (query.inspect != null && row.model?.id !== query.inspect) return false;
  const text = [row.model?.id, row.model?.name, row.recipe?.preset, row.recipe?.role]
    .map(pickerText).join(' ').toLowerCase();
  return query.terms.every(term => text.includes(term));
}

/** All reasons, not a short-circuit story about one arbitrary first filter.
 * The matching predicate delegates here so diagnostics cannot drift from it. */
export function modelQueryExclusions(row, query) {
  const reasons = [];
  if (query.tools && row.tools !== true) reasons.push(row.tools === false ? 'tools-no' : 'tools-unknown');
  if (query.vision && !acceptsImages(row.model)) reasons.push(declaredImages(row.model) === false ? 'vision-no' : 'vision-unknown');
  if (query.fits && row.fit?.status !== 'room') reasons.push(row.fit?.status === 'tight' ? 'fit-tight'
    : row.fit?.status === 'over' ? 'fit-over' : 'fit-unknown');
  if (query.reviewed && !row.recipe) reasons.push('recipe');
  if (query.recent != null && (!recencyKnown(row.added) || row.added.ageSeconds > query.recent * DAY_SECONDS)) {
    reasons.push(recencyKnown(row.added) ? 'recent-old' : 'recent-unknown');
  }
  if (query.maxInput != null || query.maxOutput != null) {
    const rates = inspectPickerRates(row.model);
    if (query.maxInput != null && (rates.status !== 'known' || rates.input > query.maxInput))
      reasons.push(rates.status === 'known' ? 'input-high' : 'input-unknown');
    if (query.maxOutput != null && (rates.status !== 'known' || rates.output > query.maxOutput))
      reasons.push(rates.status === 'known' ? 'output-high' : 'output-unknown');
  }
  if (!matchesModelTerms(row, query)) reasons.push('search');
  return reasons;
}

export function matchesModelQuery(row, query) {
  return modelQueryExclusions(row, query).length === 0;
}

const exclusionText = (reason, query) => ({
  'tools-no': '--tools: tools not advertised', 'tools-unknown': '--tools: capability unknown',
  'vision-no': '--vision: images not declared', 'vision-unknown': '--vision: input metadata unknown',
  'fit-tight': '--fits: near/above compaction threshold', 'fit-over': '--fits: at/over context window',
  'fit-unknown': '--fits: context, window or reserve unknown', 'recipe': '--reviewed: no applicable recipe',
  'input-high': `--max-input: highest configured rate > $${query.maxInput}/M`,
  'output-high': `--max-output: highest configured rate > $${query.maxOutput}/M`,
  'input-unknown': '--max-input: rate estimate unknown', 'output-unknown': '--max-output: rate estimate unknown',
  'recent-old': `--recent: added more than ${query.recent} days before the loaded snapshot`,
  'recent-unknown': '--recent: catalog-added timestamp or snapshot time unknown',
  'search': query.inspect != null ? 'exact ID or search words do not match' : 'search words do not all match',
})[reason];

/** Entries come from this invocation's managed IDs and actual picker membership,
 * not registry.getAvailable(): credentials are not evidence of discovery scope.
 * Stages partition search-matching IDs; filter reason counts can overlap. */
export function inspectModelDiscovery(entries, query) {
  const counts = { free: 0, paid: 0, inSection: 0, search: 0, outside: 0,
    matched: 0, unregistered: 0, blocked: 0, unlisted: 0, filtered: 0 };
  const reasons = {}, records = [], seen = new Set();
  for (const entry of entries) {
    if (seen.has(entry.id)) continue;
    seen.add(entry.id);
    if (entry.free) counts.free++;
    if (entry.paid) counts.paid++;
    const inSection = query.section === 'all' || (query.section === 'free' ? entry.free : entry.paid);
    if (inSection) counts.inSection++;
    if (!matchesModelTerms(entry.row ?? { model: { id: entry.id }, recipe: entry.recipe }, query)) continue;
    if (!inSection) {
      counts.outside++;
      records.push({ id: entry.id, status: 'outside', reasons: [] });
      continue;
    }
    counts.search++;
    // Missing registration is not a catalog omission, and local suppression is
    // not a newly verified provider outage. Do not evaluate filters on fake rows.
    const failures = entry.row && entry.offered ? modelQueryExclusions(entry.row, query) : [];
    const status = !entry.row ? 'unregistered' : !entry.offered ? (entry.blocked ? 'blocked' : 'unlisted')
      : failures.length ? 'filtered' : 'matched';
    counts[status]++;
    for (const reason of failures) reasons[reason] = (reasons[reason] ?? 0) + 1;
    records.push({ id: entry.id, status, reasons: failures });
  }
  return { counts, reasons, records };
}

/** Bounded UI text, no credential/header/endpoint dumps or conversation writes.
 * At most five IDs; all aggregate reasons are retained. A report is a snapshot,
 * not a live subscription, fit certificate, catalog refresh or request diagnosis. */
export function renderModelDiscovery(discovery, query, context, paidEnabled, snapshot) {
  const { counts: c, reasons, records } = discovery;
  const flags = ['tools', 'vision', 'fits', 'reviewed'].filter(key => query[key]).map(key => '--' + key);
  if (query.maxInput != null) flags.push('--max-input ' + query.maxInput);
  if (query.maxOutput != null) flags.push('--max-output ' + query.maxOutput);
  if (query.recent != null) flags.push('--recent ' + query.recent);
  const lines = ['Model discovery — read-only snapshot',
    `Section: ${query.section}; search: ${query.terms.length ? pickerText(query.terms.join(' ')) : '(none)'}; filters: ${flags.join(' ') || '(none)'}; ${modelQueryOrderText(query)}.`,
    `Managed IDs in this invocation: ${c.free} free, ${c.paid} paid. Not the live OpenRouter catalog.`,
    `In section: ${c.inSection}; search matches: ${c.search}; picker matches: ${c.matched}.`,
    `Search-match stages: ${c.matched} eligible, ${c.unregistered} missing native registration, ${c.blocked} locally route-excluded, ${c.unlisted} absent from picker list, ${c.filtered} filtered.`];
  if (query.inspect != null) lines.push(`Exact inspection ID: ${pickerText(query.inspect)} (case-sensitive; no alias resolution).`);
  if (!c.matched) lines.push('No models match this local view. No filters were relaxed.');
  if (Object.keys(reasons).length) {
    lines.push('Filter exclusions among offered search matches (counts overlap; one model can fail several):');
    for (const [reason, total] of Object.entries(reasons)) lines.push(`  ${exclusionText(reason, query)}: ${total}.`);
  }
  if ((query.terms.length || query.inspect != null) && c.outside) lines.push(`${c.outside} search-matching managed IDs in the other section (before other filters); rerun with all to inspect. This query stays unchanged.`);
  if (!c.paid && query.section !== 'free') lines.push('No priced models in this invocation: the catalog may be unloaded or empty. Enter with sandpi --paid for priced discovery; this report does not enable payment.');
  if (!c.free && query.section !== 'paid') lines.push('No free model IDs in this invocation. Host discovery: sandpi models --refresh, then a new Pi invocation to load the result.');
  if (c.unregistered || c.unlisted) lines.push('Registration/list gaps are local, not proof of removal by OpenRouter. Native /model inspects Pi registration; sandpi models --refresh is a separate host action.');
  if (c.blocked) lines.push('Locally route-excluded models are temporarily unavailable in this picker snapshot, not a live outage diagnosis. Native /model remains a separate explicit choice; no automatic probe is made.');
  if (query.fits && context.status === 'unknown') lines.push('The current context estimate is unknown, not zero; --fits excludes unknowns. Removing it is a separate choice, not a fit guarantee.');
  if (query.maxInput != null || query.maxOutput != null) lines.push('Rate filters exclude unknown estimates and compare all configured prompt tiers, not only base rates; these are NOT endpoint price limits or a spending cap.');
  if (query.recent != null) lines.push(`Catalog recency filter: added to OpenRouter within ${query.recent} days of the loaded snapshot, inclusive; unknown timestamps fail.`);
  if (query.recent != null || query.sort === 'newest') lines.push(`Catalog reference: ${snapshotText(snapshot)}.`,
    'Recency means added to OpenRouter, not model release/training date, live provider readiness, quality, or a recommendation. A stale snapshot cannot include models added after it; no refresh was attempted.');
  // Show in-section examples first. Exact ID terms get display priority only;
  // neither the actual picker ordering nor its filter membership changes.
  const examples = [...records].sort((a, b) => Number(a.status === 'outside') - Number(b.status === 'outside')
    || Number(query.terms.includes(b.id.toLowerCase())) - Number(query.terms.includes(a.id.toLowerCase())));
  const shown = examples.slice(0, MODEL_PICKER_PAGE_SIZE);
  if (shown.length) {
    lines.push(`Examples: ${shown.length}/${records.length} search-matching managed IDs (in-section/exact-ID first; not a ranking).`);
    const statusText = { matched: 'eligible for this picker (not provider readiness)', unregistered: 'missing native registration; other filters not evaluated',
      blocked: 'locally route-excluded; other filters not evaluated', unlisted: 'absent from picker list; other filters not evaluated',
      outside: 'outside selected section; other filters not evaluated' };
    for (const record of shown) {
      const id = pickerText(record.id);
      lines.push(`  ${id}${record.id.length > 512 ? '… [ID truncated]' : ''}: ${record.status === 'filtered'
        ? record.reasons.map(reason => exclusionText(reason, query)).join('; ') : statusText[record.status]}.`);
    }
    if (shown.length < records.length) lines.push(`${records.length - shown.length} more IDs not shown; narrow the search for individual explanations.`);
  }
  lines.push('Absent IDs are not explained by this snapshot: unloaded, stale, upstream-omitted or unknown models cannot be distinguished here. No alias guessing. Missing native names are searched by ID/current recipe only.',
    `Paid access ${paidEnabled ? 'ON' : 'OFF'} is separate from discovery; it does not hide priced entries. No selection, inference, catalog/credit/key request, settings change or automatic retry.`,
    'In an interactive or RPC UI, run /sandmodels without --explain or --inspect to browse; /sandmodels --help explains filters.');
  return lines.join('\n');
}

function priceLabel(model, highest = false) {
  if (highest) {
    const rates = inspectPickerRates(model);
    return rates.status === 'known'
      ? `$${rates.input}/M input, $${rates.output}/M output; highest configured` : 'rate estimate unknown';
  }
  const cost = inspectCost(model);
  return cost.status === 'known'
    ? `$${cost.base.input}/M input, $${cost.base.output}/M output${cost.tiers.length ? '; tiered' : ''}`
    : 'rate estimate unknown';
}

export function renderCatalogAdded(added) {
  if (!recencyKnown(added)) {
    const reason = added?.reason === 'snapshot' ? 'loaded snapshot time unavailable'
      : added?.reason === 'future' ? 'timestamp is later than loaded snapshot'
      : 'catalog-added timestamp unavailable or invalid';
    return `OpenRouter catalog-added metadata: unknown (${reason}); unknown is not old or new.`;
  }
  const state = added.stale ? 'stale snapshot' : 'loaded snapshot';
  const refresh = added.refreshFailed ? '; last refresh failed' : '';
  return `OpenRouter catalog-added metadata: ${added.date} UTC; ${added.ageDays} whole days before ${state} ${added.snapshotDate} UTC${refresh}.`;
}

export function renderPickerRow(row, query) {
  const capability = row.tools === false ? 'text-only' : row.tools === true ? pickerText(row.profile) : 'tools unknown';
  let billing = row.paid ? `paid; ${priceLabel(row.model)}` : 'free';
  if (hasRateQuery(query)) {
    const rates = inspectPickerRates(row.model);
    billing = `${row.paid ? 'paid' : 'free'}; ${rates.status === 'known'
      ? `highest configured $${rates.input}/M input, $${rates.output}/M output` : 'rate estimate unknown'}`;
  }
  const window = query?.sort === 'context'
    ? `; context ${positive(row.model.contextWindow) ? row.model.contextWindow : 'unknown'}` : '';
  const added = query?.sort === 'newest' || query?.recent != null
    ? `; added ${recencyKnown(row.added) ? row.added.date : 'unknown'}` : '';
  // The full context, review and capability detail belongs in the preview, not
  // on every wrapped selector row. Retain explicit degraded-route evidence.
  const route = row.route === 'route degraded' ? '; route degraded' : '';
  return `${pickerText(row.model.id)}  [${billing}; ${pickerText(row.transport)}; ${capability}${route}${window}${added}]`;
}

/** A declared absence is different from missing or malformed metadata. This is
 * stricter than mere membership because the comparison must not invent a loss.
 * No history scan: an image-input change says nothing about existing attachments.
 */
function declaredImages(model) {
  const input = model?.input;
  if (!Array.isArray(input) || input.length < 1 || input.length > 2
      || !input.every(item => item === 'text' || item === 'image')
      || new Set(input).size !== input.length) return undefined;
  return input.includes('image');
}
const declaration = value => value === true ? 'yes' : value === false ? 'no' : 'unknown';
const deltaTokens = (from, to) => !positive(from) || !positive(to) ? 'delta unknown'
  : from === to ? 'unchanged' : `${to > from ? '+' : ''}${to - from}`;
const tokenPair = (from, to) => `${positive(from) ? from : '?'} -> ${positive(to) ? to : '?'} (${deltaTokens(from, to)})`;

function compareRate(current, selected, field) {
  const value = rate => rate.status === 'known' ? `$${rate[field]}/M`
    : rate.status === 'not-openrouter' ? 'not compared (other provider)' : 'unknown';
  const direction = current.status !== 'known' || selected.status !== 'known' ? 'not comparable'
    : current[field] === selected[field] ? 'unchanged'
      : selected[field] > current[field] ? 'higher estimate' : 'lower estimate';
  return `${value(current)} -> ${value(selected)} (${direction})`;
}

/** Deliberately reuse the OpenRouter-only cost reader. Native OAuth/subscription
 * or local-provider zero estimates must not become an account-price comparison.
 */
function comparisonRates(model) {
  if (model && model.provider !== 'openrouter') return { status: 'not-openrouter' };
  return inspectPickerRates(model);
}

/** A same-token-count scenario for the input-token component only. Pi's context
 * estimate belongs to the active model, so applying it to another tokenizer is
 * deliberately labeled as a scenario rather than a request or bill prediction.
 * Prompt tiers are strict "above" thresholds, matching OpenRouter's metadata.
 */
export function inspectContextInputCost(model, context) {
  if (!model) return { status: 'unknown' };
  if (model.provider !== 'openrouter') return { status: 'not-openrouter' };
  if (context?.status !== 'known' || !count(context.tokens)) return { status: 'unknown' };
  const cost = inspectCost(model);
  if (cost.status !== 'known') return { status: 'unknown' };
  let rate = cost.base, tierAbove = null;
  for (const tier of cost.tiers) {
    if (context.tokens > tier.inputTokensAbove) { rate = tier; tierAbove = tier.inputTokensAbove; }
  }
  const ordinary = context.tokens * rate.input / 1_000_000;
  const cacheRead = context.tokens * rate.cacheRead / 1_000_000;
  if (![ordinary, cacheRead].every(value => Number.isFinite(value) && value >= 0)) return { status: 'unknown' };
  return { status: 'known', tokens: context.tokens, ordinary, cacheRead,
    inputRate: rate.input, cacheReadRate: rate.cacheRead, tierAbove };
}

/** Keep tiny positive values visibly positive. This is display-only and never
 * rounds a provider charge, updates accounting, or decides model eligibility.
 */
export function formatContextCharge(value) {
  if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) return 'unknown';
  if (value === 0) return '$0';
  if (value < 0.000001) return '<$0.000001';
  if (value >= 1e9) return '$' + value.toExponential(3);
  const digits = value < 0.01 ? 6 : value < 1 ? 4 : 2;
  return '$' + value.toFixed(digits).replace(/(\.\d*?[1-9])0+$/, '$1').replace(/\.0+$/, '');
}

const contextCharge = (info, field) => info.status === 'known' ? formatContextCharge(info[field])
  : info.status === 'not-openrouter' ? 'not compared (other provider)' : 'unknown';
const contextTier = info => info.status === 'not-openrouter' ? 'not compared'
  : info.status !== 'known' ? 'unknown'
    : info.tierAbove === null ? 'base rate' : `tier above ${info.tierAbove} tokens`;

/** Compare two configured input-token scenarios at Pi's current estimate. The
 * ordinary and all-cache-read components are shown separately; neither assumes
 * that a cache exists, survives a model switch, or covers output/other charges.
 */
export function renderContextInputCostComparison(currentModel, selectedModel, context) {
  if (context?.status !== 'known' || !count(context.tokens)) {
    return 'Current-context input scenario: unknown because Pi context usage is unavailable; unknown is not zero.';
  }
  const current = inspectContextInputCost(currentModel, context);
  const selected = inspectContextInputCost(selectedModel, context);
  return `Current-context input scenario (~${context.tokens} current Pi-estimated tokens; same token count; candidate tokenization is not estimated): `
    + `ordinary-input component ${contextCharge(current, 'ordinary')} -> ${contextCharge(selected, 'ordinary')}; `
    + `all-cache-read component ${contextCharge(current, 'cacheRead')} -> ${contextCharge(selected, 'cacheRead')}. `
    + `Tier basis: current ${contextTier(current)}; selected ${contextTier(selected)}. `
    + 'Cache reuse/mix, output, reasoning and other charges are not predicted.';
}

// Read the same bounded diagnostic projection as /sanddefaults. Never inspect
// model headers/baseUrl or arbitrary sampling payloads to guess effective policy.
const ROUTING_FIELDS = ['zdr', 'data_collection', 'only', 'ignore', 'allow_fallbacks',
  'max_price', 'order', 'require_parameters', 'enforce_distillable_text',
  'quantizations', 'sort', 'preferred_min_throughput', 'preferred_max_latency'];
const ownRouting = (info, key) => Object.hasOwn(info.fields ?? {}, key);
const completeRouting = info => ['default', 'configured'].includes(info.status) && !info.omitted;
// Canonicalize only the already-projected bounded values, not arbitrary model
// objects. Object key insertion order is immaterial; array order is retained.
const canonicalRouting = value => Array.isArray(value) ? value.map(canonicalRouting)
  : value !== null && typeof value === 'object'
    ? Object.fromEntries(Object.keys(value).sort().map(key => [key, canonicalRouting(value[key])])) : value;
const routingValueKey = value => JSON.stringify(canonicalRouting(value));

/** Separate from visible text: long lists/prices can be truncated in the UI.
 * This key retains every allowed value in both models, never raw omitted data.
 * It is a stale-dialog check, NOT a request guard, secret hash or policy ledger.
 */
export function modelRoutingSignature(currentModel, selectedModel) {
  return routingValueKey([currentModel, selectedModel].map(model => {
    const info = inspectRoutingPreferences(model);
    // Unset and explicit {} carry the same displayed model preferences.
    return { status: completeRouting(info) ? 'known' : info.status,
      fields: info.fields ?? {}, omitted: info.omitted === true };
  }));
}

function routingFieldText(info, key) {
  if (info.status === 'not-managed') return 'not compared (provider/API)';
  if (ownRouting(info, key)) {
    const value = routingValueKey(info.fields[key]);
    return value.length > 120 ? value.slice(0, 120) + '... [truncated]' : value;
  }
  return completeRouting(info) ? 'not set on model' : 'unknown/omitted';
}
function routingFieldChanged(current, selected, key) {
  // An omitted field is not a known absence; do not call uncertainty a loss.
  if (!(ownRouting(current, key) || completeRouting(current))
      || !(ownRouting(selected, key) || completeRouting(selected))) return false;
  return routingValueKey(current.fields?.[key]) !== routingValueKey(selected.fields?.[key]);
}

export function routingSwitchCautions(currentModel, selectedModel) {
  const current = inspectRoutingPreferences(currentModel), selected = inspectRoutingPreferences(selectedModel);
  const cautions = [];
  if (current.status !== 'not-managed' && selected.status !== 'not-managed') {
    if (routingFieldChanged(current, selected, 'zdr')) cautions.push('model ZDR preference differs');
    if (routingFieldChanged(current, selected, 'data_collection')) cautions.push('model data_collection differs');
    if (ROUTING_FIELDS.slice(2).some(key => routingFieldChanged(current, selected, key))) cautions.push('other endpoint preferences differ');
  }
  if ((current.status !== 'not-managed' && !completeRouting(current)) || !completeRouting(selected)) {
    cautions.push('routing comparison incomplete');
  }
  return cautions;
}

/** Sparse, bounded configured-value comparison, not endpoint/policy discovery.
 * Every displayed field is allowlisted; long values are explicitly truncated.
 * Absence on a model never means absence of account/guardrail/hook restrictions.
 */
export function renderRoutingComparison(currentModel, selectedModel) {
  const current = inspectRoutingPreferences(currentModel), selected = inspectRoutingPreferences(selectedModel);
  const keys = ROUTING_FIELDS.filter(key => ownRouting(current, key) || ownRouting(selected, key));
  const lines = ['OpenRouter routing: current -> selected model preferences (not effective policy):'];
  if (keys.length) {
    for (const key of keys) {
      lines.push(`  ${key}: ${routingFieldText(current, key)} -> ${routingFieldText(selected, key)}.`);
    }
  } else if (completeRouting(current) && completeRouting(selected)) {
    lines.push('  No explicit endpoint preferences on either model; account/provider policy is not inspected.');
  } else if (current.status === 'not-managed' && completeRouting(selected)) {
    lines.push('  Current provider/API not compared; selected model has no explicit endpoint preferences.');
  }
  if ((current.status !== 'not-managed' && !completeRouting(current)) || !completeRouting(selected)) {
    lines.push('  Some routing values are unavailable or omitted; this is not a complete policy comparison.');
  }
  if (keys.length || !completeRouting(selected) || (current.status !== 'not-managed' && !completeRouting(current))) {
    lines.push('  Missing/false model ZDR is not proof that retention is allowed. Account/guardrail policy, sampling overrides and request hooks are not inspected; hooks may replace these preferences.',
      '  No preferences are copied or enforced by this picker. Sandpi request guards still apply; max_price is an endpoint rate constraint, not a session budget.');
  }
  return lines.join('\n');
}

const THINKING_LEVELS = new Set(['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']);
const thinkingRecord = value => value !== null && typeof value === 'object' && !Array.isArray(value);
const thinkingUnknown = () => ({ status: 'unknown' });
const thinkingAbsent = () => ({ status: 'absent' });

function thinkingSetting(value, key) {
  try {
    if (!thinkingRecord(value)) return thinkingUnknown();
    if (!Object.hasOwn(value, key) || value[key] === undefined) return thinkingAbsent();
    return THINKING_LEVELS.has(value[key]) ? { status: 'known', level: value[key] } : thinkingUnknown();
  } catch { return thinkingUnknown(); }
}

/** Read only the active level, two native setting inputs and Boolean model
 * declarations. No map enumeration, settings merge, level selection or clamp.
 * Unknown is not off; a missing exact key is not a request to maximize effort.
 * Native Pi remains the sole owner of the actual post-switch thinking level.
 */
export function inspectPickerThinking(currentModel, selectedModel, settings, activeLevel) {
  const active = THINKING_LEVELS.has(activeLevel)
    ? { status: 'known', level: activeLevel } : thinkingUnknown();
  const global = thinkingSetting(settings, 'defaultThinkingLevel');
  let perModel = thinkingUnknown();
  try {
    const provider = selectedModel?.provider, id = selectedModel?.id;
    if (thinkingRecord(settings) && typeof provider === 'string' && provider.length > 0 && provider.length <= 512
        && typeof id === 'string' && id.length > 0 && id.length <= 512) {
      if (!Object.hasOwn(settings, 'modelThinkingLevels') || settings.modelThinkingLevels === undefined) {
        perModel = thinkingAbsent();
      } else {
        perModel = thinkingSetting(settings.modelThinkingLevels, `${provider}/${id}`);
      }
    }
  } catch { /* unavailable is not a missing per-model setting */ }
  const reasoning = model => {
    try { return typeof model?.reasoning === 'boolean' ? model.reasoning : null; }
    catch { return null; }
  };
  return { active, perModel, global, currentReasoning: reasoning(currentModel), selectedReasoning: reasoning(selectedModel) };
}

const thinkingLabel = field => field?.status === 'known' && THINKING_LEVELS.has(field.level)
  ? field.level : field?.status === 'absent' ? 'not configured' : 'unknown';

export function thinkingSwitchCautions(thinking) {
  if (!thinking) return [];
  const cautions = [];
  if (thinking.selectedReasoning === false && (thinking.currentReasoning === true
      || (thinking.active?.status === 'known' && thinking.active.level !== 'off'))) {
    cautions.push('no declared reasoning support');
  }
  if (thinking.active?.status === 'known') {
    if (thinking.perModel?.status === 'known' && thinking.perModel.level !== thinking.active.level) {
      cautions.push('different exact-model thinking default');
    } else if (thinking.perModel?.status === 'absent' && thinking.global?.status === 'known'
        && thinking.global.level !== thinking.active.level) {
      cautions.push('different merged thinking default');
    }
  }
  return cautions;
}

export function renderPickerThinking(thinking) {
  return [
    'Thinking inputs (not a post-switch prediction):',
    `  Active level: ${thinkingLabel(thinking?.active)}; selected exact-model default: ${thinkingLabel(thinking?.perModel)}; merged default: ${thinkingLabel(thinking?.global)}.`,
    `  Declared reasoning: ${declaration(thinking?.currentReasoning)} -> ${declaration(thinking?.selectedReasoning)}.`,
    '  Pi checks the exact-model default, then the merged default, then the active level (or its built-in fallback), and clamps to model support. Unknown/invalid values above are not defaults.',
    '  These are merged settings, not proof of who configured them. No thinking level is selected here; native hooks can change it later.',
    '  Equal level names are not equal token budgets, latency or cost across models. Provider-default or mandatory reasoning can differ; this is not a request payload.',
  ].join('\n');
}

/** Short cautions, not a veto or a claim that unchanged fields imply safety.
 * Comparing rate values directly avoids zero denominators, assumed token mixes,
 * rounded percentages, and floating-point subtraction presented as savings.
 */
export function modelSwitchCautions(row, currentModel, currentTools, images, thinking) {
  const model = row.model, cautions = [...imageSwitchCautions(images, model), ...routingSwitchCautions(currentModel, model), ...thinkingSwitchCautions(thinking)];
  if (positive(currentModel?.contextWindow) && positive(model?.contextWindow)
      && model.contextWindow < currentModel.contextWindow) cautions.push('smaller context');
  if (positive(currentModel?.maxTokens) && positive(model?.maxTokens)
      && model.maxTokens < currentModel.maxTokens) cautions.push('lower output ceiling');
  const current = comparisonRates(currentModel), selected = comparisonRates(model);
  if (current.status === 'known' && selected.status === 'known') {
    if (selected.input > current.input) cautions.push('higher input estimate');
    if (selected.output > current.output) cautions.push('higher output estimate');
  }
  if (declaredImages(currentModel) === true && declaredImages(model) === false
      && !(knownImages(images) && images.total > 0)) cautions.push('no image input');
  if (currentModel?.provider === 'openrouter' && currentTools === true && row.tools === false) cautions.push('no catalog tools');
  return cautions;
}

/** Current is ctx.model, not another catalog lookup. Comparison data is bounded
 * and allowlisted. All configured tiers participate even for an unfiltered query.
 * The caller rerenders this after confirmation, including current-only changes.
 */
export function renderModelComparison(row, currentModel, settings, context, currentTools, images, thinking) {
  const model = row.model;
  const current = comparisonRates(currentModel), selected = comparisonRates(model);
  const currentFit = inspectModelFit(currentModel, settings, context);
  const selectedFit = inspectModelFit(model, settings, context);
  const cautions = modelSwitchCautions(row, currentModel, currentTools, images, thinking);
  const lines = [
    'Compare current -> selected (configured metadata):',
    `Context ceiling: ${tokenPair(currentModel?.contextWindow, model?.contextWindow)} tokens.`,
    `Output ceiling: ${tokenPair(currentModel?.maxTokens, model?.maxTokens)} tokens; not a target.`,
    `Estimated fit: ${fitText(currentFit)} -> ${fitText(selectedFit)}.`,
    `Highest configured input: ${compareRate(current, selected, 'input')}.`,
    `Highest configured output: ${compareRate(current, selected, 'output')}.`,
    renderContextInputCostComparison(currentModel, model, context),
    `Declared image input: ${declaration(declaredImages(currentModel))} -> ${declaration(declaredImages(model))}; catalog tools: ${declaration(currentModel?.provider === 'openrouter' ? currentTools : undefined)} -> ${declaration(row.tools)}.`,
    `API transport: ${pickerText(currentModel?.api) || 'unknown'} -> ${pickerText(model?.api) || 'unknown'}.`,
    renderRoutingComparison(currentModel, model),
  ];
  if (images !== undefined) lines.push(renderPickerImages(images, model));
  if (thinking !== undefined) lines.push(renderPickerThinking(thinking));
  if (cautions.length) lines.push(`Review tradeoffs: ${cautions.join('; ')}.`);
  lines.push('Rates compare the highest base/configured prompt-tier estimates, not a workload bill. Capabilities are declarations, not live checks or active-tool permissions.',
    'This is not a quality verdict. Switching does not start a new conversation or guarantee cache reuse; the next turn uses native session context.');
  return lines.join('\n');
}

/** Bounded allowlisted presentation. In particular, never serialize model
