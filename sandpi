// Rev0074: startup recovery uses the same local UI ownership and bounded pages.
// The actual lifecycle handler runs; native session/UI/model APIs are stand-ins.
async function recoveryFixture(t, config = {}) {
  const f = await fixture(t, { resumeRequested: true, ...config });
  f.setSaved({ provider: 'openrouter', modelId: 'vendor/removed' });
  f.select((_title, labels) => labels[0]);
  f.ctx.waitForIdle = () => { throw Error('startup must not use command-only idle waits'); };
  return f;
}
async function holdRecovery(f, phase = 'select') {
  const entered = pickerDeferred(), release = pickerDeferred(); let signal;
  f.select((_title, labels, options) => {
    signal = options?.signal;
    if (phase === 'select') { entered.resolve(); return release.promise; }
    return labels[0];
  });
  if (phase === 'commit') f.pi.setModel = async m => {
    f.modelCalls.push(m); f.setModel(m); entered.resolve(); await release.promise; return true;
  };
  const done = f.hooks.session_start({ reason: 'startup' }, f.ctx);
  await entered.promise;
  return { done, release, get signal() { return signal; } };
}
