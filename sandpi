                routes.append((identity, row))
        routes.sort(key=lambda item: (item[1].get('last_at', 0), item[0]), reverse=True)
        data['routes'] = dict(routes[:MAX_ROUTES])

        data.setdefault('events', [])
        if not isinstance(data['events'], list):
            raise SandpiError('invalid request journal', 78)
        events: list[dict[str, Any]] = []
        event_sequences: list[int] = []
        for event in data['events']:
            if not isinstance(event, dict):
                raise SandpiError('invalid request journal entry', 78)
            if event.get('event') == 'attempt-start':
                allowed = EVENT_COMMON_FIELDS
            elif event.get('event') == 'attempt-finish':
                allowed = EVENT_FINISH_FIELDS
            else:
                allowed = set()
            valid = (allowed and set(event).issubset(allowed)
                     and _finite(event.get('at'))
                     and type(event.get('sequence')) is int and event['sequence'] > 0
                     and event.get('provider') in PROVIDERS
                     and isinstance(event.get('request_scope'), str)
                          and REQUEST_SCOPE.fullmatch(event['request_scope'])
                     and type(event.get('attempt')) is int and 1 <= event['attempt'] <= 8
                     and isinstance(event.get('key_id'), str) and ID.fullmatch(event['key_id'])
                     and isinstance(event.get('quota_group'), str) and GROUP.fullmatch(event['quota_group'])
                     and isinstance(event.get('model'), str) and len(event['model']) <= 512
                     and (event.get('model_fingerprint') in (None, '')
                          or isinstance(event.get('model_fingerprint'), str)
                          and FINGERPRINT.fullmatch(event['model_fingerprint']))
                     and _finite(event.get('started_at'))
                     and type(event.get('model_cooldown_bypassed')) is bool)
            if event.get('event') == 'attempt-finish':
                valid = valid and (event.get('outcome') in OUTCOMES
                    and (event.get('status') is None or type(event.get('status')) is int
                         and 100 <= event['status'] <= 599)
                    and type(event.get('committed')) is bool
                    and event.get('scope') in (None, *COOLDOWN_SCOPES)
                    and _finite(event.get('latency_ms')) and event['latency_ms'] >= 0
                    and event.get('cooldown_scope') in (None, *COOLDOWN_SCOPES)
                    and isinstance(event.get('healed_scopes'), list)
                    and isinstance(event.get('retained_scopes'), list)
                    and all(scope in COOLDOWN_SCOPES for scope in event['healed_scopes'])
                    and all(scope in COOLDOWN_SCOPES for scope in event['retained_scopes']))
            if not valid:
                raise SandpiError('invalid request journal entry', 78)
            event_sequences.append(event['sequence'])
            if now - event['at'] <= EVENT_RETENTION_SECONDS:
                events.append(event)
        if len(event_sequences) != len(set(event_sequences)):
            raise SandpiError('duplicate request journal sequence', 78)
        if event_sequences and data['event_sequence'] < max(event_sequences):
            raise SandpiError('request journal sequence is behind retained entries', 78)
        events.sort(key=lambda row: row['sequence'])
        data['events'] = events[-MAX_EVENTS:]
        return data

    def groups(self) -> dict:
        data = read_json(self.groups_path, {'schema': 'sandpi.quota-groups.v1', 'providers': {}})
        if not isinstance(data, dict) or data.get('schema') != 'sandpi.quota-groups.v1' or not isinstance(data.get('providers'), dict):
            raise SandpiError('invalid quota-group annotations', 78)
        if any(not isinstance(rows, dict) for rows in data['providers'].values()):
            raise SandpiError('invalid quota-group table', 78)
        return data

    def group_for(self, provider: str, key_id: str) -> str:
        value = self.groups()['providers'].get(provider, {}).get(key_id, key_id)
        if not isinstance(value, str) or not GROUP.fullmatch(value):
            raise SandpiError('invalid quota group', 78)
        return value

    def set_group(self, provider: str, key_id: str, group: str) -> dict:
        if provider not in PROVIDERS or not ID.fullmatch(key_id) or not GROUP.fullmatch(group):
            raise SandpiError('invalid provider, key ID or quota group', 64)
        with file_lock(self.lock, timeout=2):
            data = self.groups()
            data['providers'].setdefault(provider, {})[key_id] = group
            atomic_json(self.groups_path, data)
        return {'provider': provider, 'key_id': key_id, 'quota_group': group}

    @staticmethod
    def _scope(provider: str, group: str = '', model: str = '') -> str:
        # Model IDs may contain arbitrary slashes; hash rather than path-concatenate.
        return ':'.join((provider, group, sha256(model.encode())[:24] if model else ''))

    @staticmethod
    def _route_key(provider: str, model: str) -> str:
        return provider + ':' + sha256(model.encode())[:32]

    @staticmethod
    def _route_relevant(outcome: str, scope: str | None) -> bool:
        # Credential/account pressure and prompt/content failures are not model
        # health. Route-scoped capacity/transport failures and disappearance are.
        return outcome in {'model', 'server', 'transport', 'timeout'} or \
            (outcome == 'throttled' and scope in {'route', 'model'})

    def _append_event(self, data: dict[str, Any], event: dict[str, Any]) -> None:
        """Append one fixed-schema, content-free routing event."""
        now = self.clock()
        data['event_sequence'] += 1
        event = {'at': now, 'sequence': data['event_sequence'], **event}
        data['events'].append(event)
        cutoff = now - EVENT_RETENTION_SECONDS
        data['events'] = [row for row in data['events'] if row.get('at', 0) >= cutoff][-MAX_EVENTS:]

    def _cooldown_identities(self, record: dict[str, Any]) -> dict[str, str]:
        provider, group, model, key_id = (
            record['provider'], record['group'], record['model'], record['key_id'])
        return {
            'provider': self._scope(provider),
            'group': self._scope(provider, group),
            'model': self._scope(provider, 'model', model),
            'route': self._scope(provider, group, model),
            'key': self._scope(provider, 'key-' + key_id),
        }

    def _heal_cooldowns(self, data: dict[str, Any], record: dict[str, Any]) -> dict[str, Any]:
        """Clear only failures proven older than this successful request start.

        Completion order is not evidence order. A request that started before a
        concurrently recorded failure cannot erase that newer observation merely
        because it happened to finish later.
        """
        started = record.get('started')
        cleared: list[str] = []
        retained: list[str] = []
        if not _finite(started):
            return {'cleared': 0, 'retained': 0, 'cleared_scopes': [], 'retained_scopes': []}
        for scope, identity in self._cooldown_identities(record).items():
            row = data['cooldowns'].get(identity)
            if not isinstance(row, dict) or row.get('scope') != scope:
                continue
            recorded_at = row.get('recorded_at')
            if _finite(recorded_at) and recorded_at < started:
                data['cooldowns'].pop(identity, None)
                cleared.append(scope)
            else:
                # Legacy rows without a timestamp, equal timestamps and newer
                # failures stay active: none is disproven by this success.
                retained.append(scope)
        return {'cleared': len(cleared), 'retained': len(retained),
                'cleared_scopes': cleared, 'retained_scopes': retained}

    def acquire(self, provider: str, entries: list, *, selector: str | None = None,
                model: str = '', model_fingerprint: str | None = None,
                exclude: list[str] | None = None, lease: bool = True,
                affinity: str | None = None,
                quota: dict[str, dict[str, Any]] | None = None,
                request_scope: str | None = None, attempt: int = 1,
                allow_model_cooldown: bool = False,
                billing_class: str = 'free', cache_affinity: str | None = None) -> dict[str, Any]:
        if provider not in PROVIDERS or not isinstance(model, str) or len(model) > 512:
            raise SandpiError('invalid key lease provider/model', 64)
        if billing_class not in ('free', 'paid') or (billing_class == 'paid' and provider != 'openrouter'):
            raise SandpiError('invalid key lease billing class', 64)
        if cache_affinity is not None and (provider != 'openrouter' or billing_class != 'paid'
                or not isinstance(cache_affinity, str) or not FINGERPRINT.fullmatch(cache_affinity)):
            raise SandpiError('invalid paid conversation cache affinity', 64)
        if model_fingerprint not in (None, '') and (not isinstance(model_fingerprint, str)
                                                    or not FINGERPRINT.fullmatch(model_fingerprint)):
            raise SandpiError('invalid model fingerprint', 64)
        if exclude is not None and not isinstance(exclude, list):
            raise SandpiError('excluded key IDs must be a list', 64)
        if len(exclude or []) > 1024 or any(not isinstance(k, str) or not ID.fullmatch(k) for k in exclude or []):
            raise SandpiError('invalid excluded key IDs', 64)
        if affinity is not None and (provider != 'google' or not isinstance(affinity, str) or not 1 <= len(affinity) <= 512):
            raise SandpiError('invalid Gemini conversation affinity', 64)
        if quota is not None and (not isinstance(quota, dict) or any(not ID.fullmatch(k) or not isinstance(v, dict) for k, v in quota.items())):
            raise SandpiError('invalid quota scheduling hints', 64)
        if request_scope is None:
            request_scope = secrets.token_hex(16)
        if not isinstance(request_scope, str) or not REQUEST_SCOPE.fullmatch(request_scope):
            raise SandpiError('invalid request scope', 64)
        if type(attempt) is not int or not 1 <= attempt <= 8:
            raise SandpiError('request attempt must be 1..8', 64)
        if type(allow_model_cooldown) is not bool:
            raise SandpiError('invalid model cooldown probe marker', 64)
        affinity_id = sha256((provider + ':' + affinity).encode()) if affinity else None
        candidates = entries
        if selector:
            candidates = [e for e in entries if selector in (e.label, e.key_id)]
            if len(candidates) != 1:
                raise SandpiError(f'no unique {provider} key matches the selected label/key ID', 78)
        self.area.mkdir(parents=True, exist_ok=True, mode=0o700)
        with file_lock(self.lock, timeout=2):
            data = self._read()
            if lease and len(data['leases']) >= MAX_LEASES:
                raise SandpiError('too many live credential leases; wait for requests to finish', 75)
            sticky = data['affinities'].get(affinity_id, {}) if affinity_id else {}
            if sticky and (sticky.get('locked') or sticky.get('key_id') not in (exclude or [])):
                candidates = [e for e in candidates if e.key_id == sticky.get('key_id')]
                if not candidates:
                    raise SandpiError('Gemini conversation key is no longer in the bank; start a new conversation or restore its key', 78)
            usable: list[tuple[tuple[Any, ...], Any, str, dict[str, Any]]] = []
            advisory_zero: list[tuple[tuple[Any, ...], Any, str, dict[str, Any]]] = []
            waits: list[float] = []
            for entry in candidates:
                if entry.key_id in (exclude or []):
                    continue
                group = self.group_for(provider, entry.key_id)
                scopes = {
                    'provider': self._scope(provider),
                    'group': self._scope(provider, group),
                    'model': self._scope(provider, 'model', model),
                    'route': self._scope(provider, group, model),
                    'key': self._scope(provider, 'key-' + entry.key_id),
                }
                active = {name: data['cooldowns'].get(identity, {})
                          for name, identity in scopes.items()
                          if data['cooldowns'].get(identity, {}).get('until', 0) > self.clock()}
                considered = {name: row for name, row in active.items()
                              if not (allow_model_cooldown and name == 'model')}
                until = max((row.get('until', 0) for row in considered.values()), default=0)
                hint = (quota or {}).get(entry.key_id, {}) if provider == 'openrouter' else {}
                exhausted = hint.get('exhausted_until') if billing_class == 'free' else None
                if until > self.clock():
                    waits.append(until)
                    continue
                ident = provider + ':' + entry.key_id
                current = data['keys'].get(ident, {})
                key_active = sum(v.get('provider') == provider and v.get('key_id') == entry.key_id
                                 for v in data['leases'].values())
                group_active = sum(v.get('provider') == provider and v.get('group') == group
                                   for v in data['leases'].values())
                remaining = (hint.get('remaining') if billing_class == 'free' and hint.get('fresh')
                             and type(hint.get('remaining')) is int else None)
                # Prefer independent groups with less in-flight work. Within a
                # group, prefer a known non-exhausted allowance, then rotate keys.
                quota_class = 0 if remaining is not None else 1
                quota_rank = -remaining if remaining is not None else 0
                # Paid chat uses soft rendezvous affinity to an account/quota
                # group. Cooldowns/pins/exclusions were applied first. Within
                # that group, least-loaded keys still rotate; unrelated sessions
                # distribute across groups without another mutable affinity table.
                affinity_rank = -int(sha256((cache_affinity + ':' + group).encode()), 16) if cache_affinity else 0
                paid_eligible = hint.get('paid_eligible') if type(hint.get('paid_eligible')) is bool else None
                # Prefer current paid evidence, then retained last-known paid
                # evidence, then unknowns.  Stale/current negative evidence is
                # only ordering: every otherwise healthy key remains fallback
                # eligible and explicit pins still win above this ranking.
                account_current = bool(hint.get('account_class_current'))
                if billing_class == 'paid':
                    paid_rank = ({(True, True): 0, (True, False): 1,
                                  (None, False): 2, (False, False): 3,
                                  (False, True): 4}.get((paid_eligible, account_current), 2))
                else:
                    paid_rank = 0
                rank = (paid_rank, affinity_rank, group_active, key_active, quota_class, quota_rank,
                        current.get('last_sequence', 0), entry.key_id)
                record = (rank, entry, group, hint)
                # GET /api/v1/key is authoritative account telemetry, but its
                # free counter is not necessarily enforced for exempt/BYOK routes.
                # Prefer a nonzero/unknown key; never make an observation the only
                # reason every otherwise healthy route is refused.
                if _finite(exhausted) and exhausted > self.clock():
                    advisory_zero.append(record)
                else:
                    usable.append(record)
            quota_advisory_fallback = False
            if not usable and advisory_zero:
                usable = advisory_zero
                quota_advisory_fallback = True
            if not usable:
                if waits:
                    delay = max(1, math.ceil(min(waits) - self.clock()))
                    raise SandpiError(f'{provider} key bank is cooling; next eligible route in {delay}s', 75)
                raise SandpiError(f'no untried {provider} key remains for this request', 75)
            _, entry, group, hint = min(usable, key=lambda x: x[0])
            if affinity_id:
                if affinity_id not in data['affinities'] and len(data['affinities']) >= MAX_LEASES:
                    raise SandpiError('conversation affinity table is full; inspect shared key metadata', 75)
                data['affinities'][affinity_id] = {
                    'key_id': entry.key_id, 'locked': bool(sticky.get('locked')), 'at': self.clock(),
                }
            data['sequence'] += 1
            ident = provider + ':' + entry.key_id
            row = data['keys'].setdefault(ident, {'selected': 0, 'successes': 0, 'failures': 0})
            row.update(last_sequence=data['sequence'], last_selected=self.clock())
            row['selected'] += 1
            token = secrets.token_hex(16) if lease else None
            started = self.clock()
            bypassed_model = bool(allow_model_cooldown and
                                   data['cooldowns'].get(self._scope(provider, 'model', model), {}).get('until', 0) > started)
            if token:
                data['leases'][token] = {
                    'provider': provider, 'key_id': entry.key_id, 'group': group,
                    'model': model, 'model_fingerprint': model_fingerprint or None,
                    'affinity': affinity_id, 'started': started,
                    'expires': started + LEASE_SECONDS,
                    'request_scope': request_scope, 'attempt': attempt,
                    'model_cooldown_bypassed': bypassed_model,
                }
                self._append_event(data, {
                    'event': 'attempt-start', 'provider': provider,
                    'request_scope': request_scope, 'attempt': attempt,
                    'key_id': entry.key_id, 'quota_group': group, 'model': model,
                    'model_fingerprint': model_fingerprint or None,
                    'started_at': started,
                    'model_cooldown_bypassed': bypassed_model,
                })
            atomic_json(self.path, data)
        return {'key': entry.key, 'key_id': entry.key_id, 'label': entry.label,
                'lease_id': token, 'quota_group': group, 'bank_size': len(candidates),
                'quota_remaining': (hint.get('remaining') if billing_class == 'free'
                                    and hint.get('fresh') else None),
                'quota_checked_at': hint.get('checked_at') if hint.get('fresh') else None,
                'quota_advisory_fallback': quota_advisory_fallback,
                'paid_key_observation': ('paid' if hint.get('paid_eligible') is True else
                                         'not-paid' if hint.get('paid_eligible') is False else 'unknown'),
                'paid_key_observation_current': bool(hint.get('account_class_current')),
                'selection_policy': 'paid-session-group' if cache_affinity else 'least-loaded',
                'request_scope': request_scope, 'attempt': attempt,
                'model_cooldown_bypassed': bypassed_model if lease else False,
                'expires_at': started + LEASE_SECONDS if lease else None}

    def _record_route(self, data: dict[str, Any], record: dict[str, Any], *,
                      outcome: str, status: int | None, scope: str | None,
                      committed: bool) -> dict[str, Any] | None:
        model = record.get('model')
        provider = record.get('provider')
        if not isinstance(model, str) or not model or provider not in PROVIDERS:
            return None
        now = self.clock()
        fingerprint = record.get('model_fingerprint') or None
        key = self._route_key(provider, model)
        prior = data['routes'].get(key)
        if not isinstance(prior, dict) or (fingerprint and prior.get('fingerprint') not in (None, fingerprint)):
            prior = {
                'provider': provider, 'model': model, 'fingerprint': fingerprint,
                'observations': 0, 'successes': 0, 'route_failures': 0,
                'neutral': 0, 'consecutive_failures': 0, 'committed_failures': 0,
                'last_at': 0, 'degraded_until': 0,
            }
        elif fingerprint and not prior.get('fingerprint'):
            prior['fingerprint'] = fingerprint
        prior['observations'] += 1
        prior['last_at'] = now
        prior['last_outcome'] = outcome
        prior['last_status'] = status
        prior['last_committed'] = committed
        started = record.get('started')
        if _finite(started) and now >= started:
            duration = min(7 * 86400 * 1000, max(0.0, (now - started) * 1000))
            old = prior.get('latency_ewma_ms')
            prior['latency_ewma_ms'] = round(duration if not _finite(old) else old * 0.8 + duration * 0.2, 3)
        relevant = self._route_relevant(outcome, scope)
        if outcome == 'success':
            prior['successes'] += 1
            prior['consecutive_failures'] = 0
            prior['last_success_at'] = now
            prior['degraded_until'] = 0
        elif relevant:
            prior['route_failures'] += 1
            if committed:
                prior['committed_failures'] += 1
            previous = prior.get('last_failure_at')
            prior['consecutive_failures'] = (prior.get('consecutive_failures', 0) + 1
                                             if _finite(previous) and now - previous <= ROUTE_FAILURE_WINDOW else 1)
            prior['last_failure_at'] = now
            # One transient event is observation, not condemnation. Repeated
            # route failures temporarily move this model behind healthy/unknown
            # candidates. Exact selection and native resume remain untouched.
            if prior['consecutive_failures'] >= 2:
                delay = min(1800, 30 * (2 ** min(6, prior['consecutive_failures'] - 2)))
                prior['degraded_until'] = max(prior.get('degraded_until', 0), now + delay)
        else:
            prior['neutral'] += 1
        data['routes'][key] = prior
        return self._public_route(prior, fingerprint=fingerprint)

    def finish(self, token: str, *, outcome: str, status: int | None = None,
               retry_after: float | None = None, scope: str | None = None,
               committed: bool = False) -> dict:
        if type(committed) is not bool:
            raise SandpiError('invalid response commit marker', 64)
        if not isinstance(outcome, str):
            raise SandpiError('invalid credential outcome', 64)
        if not isinstance(token, str) or not re.fullmatch('[a-f0-9]{32}', token) or outcome not in OUTCOMES:
            raise SandpiError('invalid credential outcome', 64)
        if status is not None and (type(status) is not int or not 100 <= status <= 599):
            raise SandpiError('invalid HTTP outcome status', 64)
        if retry_after is not None and (not _finite(retry_after) or retry_after < 0):
            raise SandpiError('invalid retry delay', 64)
        if scope not in (None, *COOLDOWN_SCOPES):
            raise SandpiError('invalid cooldown scope', 64)
        with file_lock(self.lock, timeout=2):
            data = self._read()
            record = data['leases'].pop(token, None)
            if not record:
                return {'released': False, 'reason': 'already-released-or-expired'}
            now = self.clock()
            provider, group = record['provider'], record['group']
            affinity = data['affinities'].get(record.get('affinity'))
            if affinity and (outcome == 'success' or committed):
                affinity['locked'] = True
                affinity['at'] = now
            key_row = data['keys'].setdefault(provider + ':' + record['key_id'],
                                               {'selected': 0, 'successes': 0, 'failures': 0})
            key_row['last_outcome'] = outcome
            key_row['last_status'] = status
            if outcome == 'success':
                key_row['successes'] += 1
            elif outcome in {'auth', 'quota'} or (outcome == 'throttled' and scope in {'key', 'group'}):
                key_row['failures'] += 1
            # Prompt/content/route failures are not evidence that a credential
            # is bad. Keep them in route observations, not per-key failure counts.
            defaults = {
                'auth': (3600, 'key'), 'model': (21600, 'model'),
                'quota': (300, 'group'),
                'throttled': (60, 'provider' if provider == 'openrouter' else 'route'),
                'server': (5, 'route'), 'transport': (3, 'route'),
                'timeout': (5, 'route'),
            }
            cooldown = None
            healing = {'cleared': 0, 'retained': 0,
                       'cleared_scopes': [], 'retained_scopes': []}
            if outcome == 'success':
                healing = self._heal_cooldowns(data, record)
            elif outcome in defaults:
                default_delay, default_scope = defaults[outcome]
                chosen = scope or default_scope
                delay = max(1, min(86400, retry_after if retry_after is not None else default_delay))
                scope_group = '' if chosen == 'provider' else \
                    'key-' + record['key_id'] if chosen == 'key' else \
                    'model' if chosen == 'model' else group
                scope_model = record['model'] if chosen in ('model', 'route') else ''
                scope_key = self._scope(provider, scope_group, scope_model)
                until = max(data['cooldowns'].get(scope_key, {}).get('until', 0), now + delay)
                cooldown_row = {
                    'until': until, 'outcome': outcome, 'scope': chosen,
                    'status': status, 'recorded_at': now,
                    'request_scope': record['request_scope'], 'attempt': record['attempt'],
                }
                if chosen in ('model', 'route'):
                    cooldown_row['model'] = record['model']
                if chosen in ('group', 'route'):
                    cooldown_row['quota_group'] = group
                data['cooldowns'][scope_key] = cooldown_row
                cooldown = {'until': until, 'scope': chosen, 'recorded_at': now}
            route = self._record_route(data, record, outcome=outcome, status=status,
                                       scope=scope, committed=committed)
            started = record.get('started')
            latency_ms = round(max(0.0, (now - started) * 1000), 3) if _finite(started) else 0.0
            self._append_event(data, {
                'event': 'attempt-finish', 'provider': provider,
                'request_scope': record['request_scope'], 'attempt': record['attempt'],
                'key_id': record['key_id'], 'quota_group': group,
                'model': record['model'],
                'model_fingerprint': record.get('model_fingerprint') or None,
                'started_at': started if _finite(started) else now,
                'model_cooldown_bypassed': record.get('model_cooldown_bypassed') is True,
                'outcome': outcome, 'status': status, 'committed': committed,
                'scope': scope, 'latency_ms': latency_ms,
                'cooldown_scope': cooldown.get('scope') if cooldown else None,
                'healed_scopes': healing['cleared_scopes'],
                'retained_scopes': healing['retained_scopes'],
            })
            atomic_json(self.path, data)
        return {'released': True, 'outcome': outcome, 'cooldown': cooldown,
                'healing': healing, 'route_health': route,
                'request_scope': record['request_scope'], 'attempt': record['attempt']}

    def status(self, provider: str, entries: list,
               quota: dict[str, dict[str, Any]] | None = None) -> dict:
        # Read-only status must never rotate keys or erase a cooldown.
        data = self._read()
        rows = []
        for entry in entries:
            ident = provider + ':' + entry.key_id
            row = {**entry.public(), **data['keys'].get(ident, {}),
                   'quota_group': self.group_for(provider, entry.key_id)}
            row['active'] = sum(v.get('provider') == provider and v.get('key_id') == entry.key_id
                                for v in data['leases'].values())
            if provider == 'openrouter':
                hint = (quota or {}).get(entry.key_id, {})
                row['quota'] = {'status': hint.get('status', 'unknown'),
                                'fresh': hint.get('fresh', False),
                                'observed_fresh': hint.get('observed_fresh', False),
                                'account_class_fresh': hint.get('account_class_fresh', False),
