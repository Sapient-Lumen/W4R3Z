class ChoiceProbe:
    """Small bounded LF-only RPC driver for synthetic acceptance, never production.

    Commands are ID-correlated; the overlap audit nests calls only while an outer
    dialog is held without a response. An accepted prompt is not evidence of
    inference completion. This probe sends slash commands only and asserts that
    the synthetic HTTP server receives zero requests.
    """
    def __init__(self, command:list[str], cwd:Path, env:dict, out:Path):
        import queue
        self.queue=queue.Queue();self.sequence=0;self.out=out;self.notices=[];self.ui_methods=[];self.dialog_handler=None
        self.errors=(out/'native-choices.stderr').open('wb')
        try:
            self.process=subprocess.Popen(command,cwd=cwd,env=env,stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,stderr=self.errors,start_new_session=True)
        except OSError:
            self.errors.close();raise
        self.thread=threading.Thread(target=self._read,daemon=True);self.thread.start()

    def _read(self):
        try:
            # read bytes using LF, not str.splitlines() (which splits valid
            # Unicode separators inside JSON strings). Bound record and count.
            for _ in range(4096):
                line=self.process.stdout.readline(1024*1024+1)
                if not line:break
                if len(line)>1024*1024 or not line.endswith(b'\n'):
                    raise ValueError('oversized or incomplete native RPC record')
                row=json.loads(line)
                if not isinstance(row,dict):raise ValueError('native RPC record is not an object')
                self.queue.put(row)
            else:raise ValueError('native RPC fixture record bound exceeded')
        except (OSError,ValueError) as error:self.queue.put(error)
        finally:self.queue.put(None)

    def call(self, command:str, **args)->dict:
        import queue,time
        self.sequence+=1;ident=f'choice-{self.sequence}'
        payload={'id':ident,'type':command,**args}
        self.process.stdin.write(json.dumps(payload).encode()+b'\n');self.process.stdin.flush()
        deadline=time.monotonic()+30
        while True:
            remaining=deadline-time.monotonic()
            if remaining<=0:raise SandpiError('native RPC choice check timed out')
            try:row=self.queue.get(timeout=remaining)
            except queue.Empty:raise SandpiError('native RPC choice check timed out') from None
            if row is None:raise SandpiError('Pi exited during native choice check; inspect fixture stderr')
            if isinstance(row,Exception):raise SandpiError(str(row))
            if row.get('type')=='extension_error':
                raise SandpiError('native Pi extension lifecycle error: '+str(row.get('error')))
            if row.get('type')=='extension_ui_request':self.ui_methods.append(row.get('method'))
            if row.get('type')=='extension_ui_request' and row.get('method')=='notify':
                self.notices.append(str(row.get('message',''))[:65536])
            if row.get('type')=='extension_ui_request' and row.get('method') in ('select','confirm','input','editor'):
                if self.dialog_handler is None:
                    raise SandpiError('unexpected native UI dialog in choice fixture')
                answer=self.dialog_handler(row)
                if not isinstance(answer,dict) or set(answer)-{'value','confirmed','cancelled'}:
                    raise SandpiError('invalid synthetic UI dialog response')
                reply={'type':'extension_ui_response','id':row.get('id'),**answer}
                self.process.stdin.write(json.dumps(reply).encode()+b'\n');self.process.stdin.flush()
            if row.get('type')!='response':continue
            if row.get('id')!=ident or row.get('command')!=command:
                raise SandpiError('native RPC response did not match the requested command')
            if row.get('success') is not True:
                raise SandpiError('native RPC rejected '+command+': '+str(row.get('error')))
            return row

    def close(self):
        import signal
        try:
            if self.process.stdin and not self.process.stdin.closed:self.process.stdin.close()
            try:self.process.wait(timeout=10)
            except subprocess.TimeoutExpired:
                with contextlib.suppress(ProcessLookupError):os.killpg(self.process.pid,signal.SIGTERM)
                try:self.process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    with contextlib.suppress(ProcessLookupError):os.killpg(self.process.pid,signal.SIGKILL)
                    self.process.wait(timeout=5)
        finally:
            self.thread.join(timeout=2)
            if self.process.stdout:self.process.stdout.close()
            self.errors.close()


