"""Model-aware Pi tool profiles.

Sandpi does not replace Pi's tools. It decides whether Pi's built-in codemode
should be declared alongside the user's current tool set. Frontier providers use
codemode by default. OpenRouter models earn it through repeated ladder evidence;
small or ungraded models keep the conventional direct tool interface.
"""
from __future__ import annotations
from typing import Any

from core import pi_option_indices

PROFILES = ('auto', 'classic', 'codemode', 'passthrough')
EFFECTIVE = ('classic', 'codemode', 'passthrough', 'text-only')
FRONTIER_PROVIDERS = ('openai-codex', 'openai', 'google')
CODEMODE_FLOOR = 3
TOOL_FLAGS = ('--tools', '-t', '--exclude-tools', '-xt', '--no-tools', '-nt',
              '--no-builtin-tools', '-nbt')


def raw_tool_override(argv: list[str]) -> bool:
    """Whether actual native tool-option positions claim tool-selection ownership.

    Literal prompts, option values and text after Pi's terminator do not opt out
    of Sandpi defaults. Equals spellings are not native built-ins in pinned Pi;
    leave them untouched for its diagnostics/extension-flag resolution.
    """
    return any(argv[index] in TOOL_FLAGS for index in pi_option_indices(argv))


def qualified_grade(grade: Any) -> bool:
    return isinstance(grade, dict) and type(grade.get('floor')) is int and \
        grade['floor'] >= CODEMODE_FLOOR and grade.get('provisional') is False


def model_profile(provider: str | None, model: str | None, grades: dict | None = None) -> str:
    if provider in FRONTIER_PROVIDERS:
        return 'codemode'
    if provider == 'openrouter' and model and qualified_grade((grades or {}).get(model)):
        return 'codemode'
    return 'classic'


def resolve(request: str, provider: str | None, model: str | None, grades: dict | None = None,
            *, resume_hint: dict | None = None, continuing: bool = False,
            pi_tool_override: bool = False, benchmark: bool = False) -> str:
    if request not in PROFILES:
        raise ValueError('unknown tool profile')
    if benchmark:
        return 'classic'
    if pi_tool_override:
        return 'passthrough'
    if request != 'auto':
        return request
    if continuing and isinstance(resume_hint, dict):
        prior = resume_hint.get('tool_profile')
        if prior in EFFECTIVE:
            return prior
        hinted_model = resume_hint.get('model') if isinstance(resume_hint.get('model'), dict) else {}
        provider = provider or hinted_model.get('provider')
        model = model or hinted_model.get('id')
    return model_profile(provider, model, grades)


def profile_map(models: list[dict], grades: dict | None = None) -> dict[str, str]:
    grades = grades or {}
    return {model['id']: ('text-only' if model.get('tools') is False else
                          model_profile('openrouter', model['id'], grades))
            for model in models if isinstance(model, dict) and isinstance(model.get('id'), str)}
