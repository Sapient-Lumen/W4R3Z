                ('limits',lambda:run_native_limits(pi,root/'native-limits',out)),
                ('cancellation',lambda:run_native_cancellation(pi,root/'native-cancellation',out)),
                ('error-evidence',lambda:run_native_error_evidence(pi,root/'native-error-evidence',out)),
                ('observers',lambda:run_native_observers(pi,root/'native-observers',out)),
                ('hooks',lambda:run_native_hooks(pi,root/'native-hooks',out)),
                ('origin',lambda:run_native_origin(pi,root/'native-origin',out)),
                ('resume-preflight',lambda:run_resume_preflight(pi,root/'resume',out)),
