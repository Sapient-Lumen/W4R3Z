def validate_native_settings_result(value:dict,cases:list[dict])->list[str]:
    expected=['native-settings-'+case['name'] for case in cases]
    if not isinstance(value,dict) or set(value)!={'suite','checks','real_provider_requests'} or \
            value.get('suite')!='native-settings-precedence' or value.get('checks')!=expected or \
            type(value.get('real_provider_requests')) is not int or value['real_provider_requests']!=0:
        raise SandpiError('native Pi settings fixture did not return the complete expected receipt')
    return expected


