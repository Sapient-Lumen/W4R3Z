class HandoffRPCStandIn:
    """Only tests the driver's negative assertions, not Pi execution."""
    def __init__(self, defect=None):
        self.defect=defect;self.notices=[];self.ui_methods=[];self.calls=[]
    def call(self,command,**args):
        if command=='get_state':
            value={'model':{'id':'fixture'},'thinkingLevel':'off','sessionId':'original',
                'messageCount':0,'pendingMessageCount':0,'isStreaming':False,'isCompacting':False}
            if self.defect=='missing':value.pop('pendingMessageCount')
            if self.defect=='busy':value['isStreaming']=True
            if self.defect=='pending':value['pendingMessageCount']=1
            if self.defect=='changed' and self.calls:value['sessionId']='replacement'
            return {'data':value}
        self.calls.append(args['message'])
        if self.defect=='editor-write':self.ui_methods.append('set_editor_text')
        if self.defect!='silent':
            self.ui_methods.append('notify')
            self.notices.append('wrong' if self.defect=='wrong-notice' else 'Handoff requires the Pi terminal UI. /sandhandoff')
        return {'data':{'disposition':'started' if self.defect=='inference' else 'handled'}}


