from core import (SandpiError, atomic_json, canonical, file_lock, private_dir, read_json,
                  sha256, timestamp, under)

ANCHOR_SCHEMA = 'sandpi.project-anchor.v1'
BINDING_SCHEMA = 'sandpi.project-binding.v1'
VIEW_SCHEMA = 'sandpi.project-view.v1'
RECOVERY_SCHEMA = 'sandpi.project-recovery.v1'
SELECTION_SCHEMA = 'sandpi.project-selection.v1'
ANCHOR_FILE = Path('.sandpi/project.json')
PREVIOUS_FILE = Path('.sandpi/project.previous.json')
MAX_FILE = 64 * 1024
MAX_RECOVERY_ENTRIES = 4096
OPAQUE = re.compile(r'^sandpi:[a-f0-9]{64}$')
DIGEST = re.compile(r'^[a-f0-9]{64}$')


UNSAFE_PROJECT_ROOTS = frozenset({
    '/', '/bin', '/boot', '/dev', '/etc', '/home', '/lib', '/lib64', '/mnt',
    '/nix', '/proc', '/root', '/run', '/sbin', '/sys', '/tmp', '/usr', '/var',
})


def _nearest_sandpi_boundary(start: Path) -> Path | None:
    """Return the closest ancestor that already carries Sandpi-local state.

    This is deliberately not a Git-root heuristic. A project becomes a Sandpi
    project only after Sandpi has created (or an operator has copied) its
    ``.sandpi`` directory. That keeps first use compatible with the long-standing
    "current directory is the project" rule while making later entry from a
    subdirectory reuse the same persistent room. A broken/symlinked boundary is
    returned too so the ordinary strict validators fail closed rather than
    silently skipping to a more distant project.
    """
    current = canonical(start, must_exist=True)
    while True:
        marker = current / '.sandpi'
        if marker.exists() or marker.is_symlink():
            return current
        if current.parent == current:
            return None
        current = current.parent


def _validate_project_scope(project: Path, *, state_root: Path, credential_root: Path) -> None:
    text = str(project)
    if text in UNSAFE_PROJECT_ROOTS:
        raise SandpiError(f'refusing unsafe project root: {project}', 64)
    home = canonical(Path.home())
    if project == home:
        raise SandpiError('refusing the entire home directory as a project; enter a smaller directory or pass --project', 64)
    for label, protected in (('Sandpi state', state_root), ('canonical Sandcodex credentials', credential_root)):
        if under(project, protected) or under(protected, project):
            raise SandpiError(f'project and {label} must not contain one another', 64)


def select(start: Path, *, explicit: Path | None, state_root: Path, credential_root: Path) -> dict[str, Any]:
    """Select the persistent project root and native Pi working directory.

    The host project root determines the VM and live writable share. The caller's
    directory determines Pi's cwd, resource discovery, and native session group.
    Existing ``.sandpi`` state is the only automatic ancestor marker; first use
    still selects exactly the current directory.
    """
    caller = canonical(start, must_exist=True)
    if not caller.is_dir():
        raise SandpiError('current working directory must be a directory', 64)
    if explicit is not None:
        project = canonical(explicit, must_exist=True)
        source = 'explicit-project'
        boundary = None
    else:
        boundary = _nearest_sandpi_boundary(caller)
        project = boundary or caller
        source = 'nearest-sandpi-ancestor' if boundary is not None and boundary != caller else 'current-directory'
    if not project.is_dir():
        raise SandpiError('--project must be a directory', 64)
    project = canonical(project, must_exist=True)
    state_root = canonical(state_root)
    credential_root = canonical(credential_root)
    _validate_project_scope(project, state_root=state_root, credential_root=credential_root)

    workdir = caller if under(caller, project) else project
    control = project / '.sandpi'
    if under(workdir, control):
        raise SandpiError('the Pi working directory cannot be inside host-only .sandpi state', 64)
    relative = workdir.relative_to(project)
    relative_text = '' if relative == Path('.') else relative.as_posix()
    guest = Path('/workspace') if not relative_text else Path('/workspace') / relative_text
    return {
        'schema': SELECTION_SCHEMA,
        'project': str(project),
        'host_workdir': str(workdir),
        'guest_workdir': str(guest),
        'relative_workdir': relative_text,
        'source': source,
        'boundary': str(boundary) if boundary is not None else None,
        'explicit': explicit is not None,
    }


def _safe_text(value: Any, *, label: str, limit: int = 4096) -> str:
    if not isinstance(value, str) or not value or len(value) > limit or any(c in value for c in '\0\r\n'):
        raise SandpiError(f'invalid {label}', 78)
    return value


def _namespace(value: Any) -> str:
    text = _safe_text(value, label='Sandpi project room namespace')
    if text.startswith('/') or OPAQUE.fullmatch(text):
        return text
    raise SandpiError('Sandpi project room namespace must be an absolute path or a Sandpi opaque identity', 78)


def _regular_owned(path: Path, *, label: str, optional: bool = False) -> os.stat_result | None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        if optional:
            return None
        raise SandpiError(f'{label} is missing: {path}', 66) from None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
        raise SandpiError(f'{label} must be a single-link regular file owned by this user: {path}', 78)
    if info.st_size > MAX_FILE:
        raise SandpiError(f'{label} exceeds the fixed {MAX_FILE}-byte bound: {path}', 78)
    return info


def _project_dir(project: Path, *, create: bool = False) -> Path:
    directory = project / '.sandpi'
    if directory.is_symlink():
        raise SandpiError('project .sandpi cannot be a symlink', 78)
    if not directory.exists() and create:
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            # Another Sandpi process may have won the initialization race.
            pass
    if directory.exists():
        info = directory.stat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
            raise SandpiError('project .sandpi must be a directory owned by the current user', 78)
        if stat.S_IMODE(info.st_mode) & 0o022:
            raise SandpiError('project .sandpi must not be writable by group or other users', 78)
    return directory


def _clean_anchor(value: Any) -> dict[str, Any]:
    allowed = {'schema', 'room_namespace', 'created_at', 'created_revision'}
    if not isinstance(value, dict) or set(value) != allowed or value.get('schema') != ANCHOR_SCHEMA:
        raise SandpiError('invalid Sandpi project anchor', 78)
    created_at = _safe_text(value.get('created_at'), label='Sandpi project anchor timestamp', limit=96)
    revision = value.get('created_revision')
    if type(revision) is not int or revision < 1:
        raise SandpiError('invalid Sandpi project anchor revision', 78)
    return {'schema': ANCHOR_SCHEMA,
            'room_namespace': _namespace(value.get('room_namespace')),
            'created_at': created_at,
            'created_revision': revision}


def load(project: Path) -> dict[str, Any]:
    """Read the immutable project anchor, or return the legacy-path preview.

    Missing state is not created here.  This keeps ``sandpi plan`` and read-only
    diagnostics side-effect free while making their room ID match the first real
    launch.
    """
    project = project.resolve()
    directory = _project_dir(project)
    path = directory / 'project.json'
    if not path.exists() and not path.is_symlink():
        return {'schema': ANCHOR_SCHEMA, 'room_namespace': str(project),
                'created_at': None, 'created_revision': None,
                'persisted': False, 'source': 'canonical-path-preview',
                'path': str(path)}
    _regular_owned(path, label='Sandpi project anchor')
    clean = _clean_anchor(read_json(path, limit=MAX_FILE))
    return {**clean, 'persisted': True, 'source': 'project-anchor', 'path': str(path)}


def ensure(project: Path, *, revision: int) -> dict[str, Any]:
    """Create the legacy-compatible anchor once, then return it."""
    project = project.resolve()
    directory = _project_dir(project, create=True)
    lock = directory / 'project.lock'
    with file_lock(lock, timeout=3):
        current = load(project)
        if current['persisted']:
            return current
        value = {'schema': ANCHOR_SCHEMA, 'room_namespace': str(project),
                 'created_at': timestamp(), 'created_revision': revision}
        atomic_json(directory / 'project.json', value)
        return {**value, 'persisted': True, 'source': 'project-anchor',
                'path': str(directory / 'project.json')}


def _binding_area(root: Path) -> Path:
    return root / 'projects'


def _binding_key(namespace: str) -> str:
    return sha256(namespace.encode())


def binding_path(root: Path, namespace: str) -> Path:
    return _binding_area(root) / (_binding_key(_namespace(namespace)) + '.json')


def _clean_binding(value: Any, namespace: str) -> dict[str, Any]:
    allowed = {'schema', 'namespace_sha256', 'room_namespace', 'project', 'device', 'inode',
               'bound_at', 'updated_at', 'revision'}
    if not isinstance(value, dict) or set(value) != allowed or value.get('schema') != BINDING_SCHEMA:
        raise SandpiError('invalid Sandpi project binding', 78)
    clean_namespace = _namespace(value.get('room_namespace'))
    digest = value.get('namespace_sha256')
    if clean_namespace != namespace or not isinstance(digest, str) or not DIGEST.fullmatch(digest) or \
            digest != sha256(clean_namespace.encode()):
        raise SandpiError('Sandpi project binding identity does not match its namespace', 78)
    project = _safe_text(value.get('project'), label='Sandpi bound project path')
    if not project.startswith('/'):
        raise SandpiError('Sandpi bound project path must be absolute', 78)
    device, inode, revision = value.get('device'), value.get('inode'), value.get('revision')
    if type(device) is not int or device < 0 or type(inode) is not int or inode <= 0 or \
            type(revision) is not int or revision < 1:
        raise SandpiError('invalid Sandpi project binding filesystem identity', 78)
    bound_at = _safe_text(value.get('bound_at'), label='Sandpi project binding timestamp', limit=96)
    updated_at = _safe_text(value.get('updated_at'), label='Sandpi project binding timestamp', limit=96)
    return {'schema': BINDING_SCHEMA, 'namespace_sha256': digest,
            'room_namespace': clean_namespace, 'project': project,
            'device': device, 'inode': inode, 'bound_at': bound_at,
            'updated_at': updated_at, 'revision': revision}


def read_binding(root: Path, namespace: str) -> dict[str, Any] | None:
    path = binding_path(root, namespace)
    if not path.exists() and not path.is_symlink():
        return None
    _regular_owned(path, label='Sandpi project binding')
    return _clean_binding(read_json(path, limit=MAX_FILE), _namespace(namespace))



def _bounded_entries(directory: Path, *, label: str) -> list[Path]:
    """List at most MAX_RECOVERY_ENTRIES without first materializing a huge directory."""
    entries: list[Path] = []
    try:
        with os.scandir(directory) as scan:
            for entry in scan:
                if len(entries) >= MAX_RECOVERY_ENTRIES:
                    raise SandpiError(
                        f'{label} exceeds the {MAX_RECOVERY_ENTRIES}-entry recovery bound', 75)
                entries.append(Path(entry.path))
    except OSError as exc:
        raise SandpiError(f'cannot scan {label}: {exc}', 74) from exc
    return sorted(entries, key=lambda path: path.name)


def _binding_documents(root: Path) -> tuple[list[dict[str, Any]], list[str]]:
    """Read bounded central bindings without creating state.

    Recovery is an operator convenience, not permission to trust arbitrary files
    under SANDPI_HOME.  Every usable binding still passes the ordinary fixed-schema,
    ownership, link-count and filename/digest checks.  Invalid unrelated entries are
    reported to ``project --json`` but cannot become candidates.
    """
    area = _binding_area(root)
    if not area.exists() and not area.is_symlink():
        return [], []
    if area.is_symlink() or not area.is_dir():
        raise SandpiError('Sandpi project binding root must be a real directory', 78)
    info = area.stat()
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o022:
        raise SandpiError('Sandpi project binding root must be private and owned by this user', 78)
    entries = _bounded_entries(area, label='Sandpi project binding root')
    documents: list[dict[str, Any]] = []
    issues: list[str] = []
    for path in entries:
        if path.name.endswith('.lock'):
            continue
        if not re.fullmatch(r'[a-f0-9]{64}\.json', path.name):
            issues.append(f'ignored unexpected project-binding entry: {path.name}')
            continue
        try:
            _regular_owned(path, label='Sandpi project binding')
            raw = read_json(path, limit=MAX_FILE)
            if not isinstance(raw, dict):
                raise SandpiError('invalid Sandpi project binding', 78)
            namespace = _namespace(raw.get('room_namespace'))
            clean = _clean_binding(raw, namespace)
            expected = _binding_key(namespace) + '.json'
            if path.name != expected:
                raise SandpiError('Sandpi project binding filename does not match its namespace', 78)
            documents.append(clean)
        except (SandpiError, OSError) as exc:
            issues.append(f'{path.name}: {exc}')
    return documents, issues


def _room_recovery_evidence(root: Path, project: Path) -> tuple[dict[str, list[str]], list[str]]:
    """Return namespace -> room IDs whose strict metadata names this path.

    Room metadata is weaker evidence than the central device/inode binding, but it
    is enough for an explicit recovery when the binding document itself was lost.
    Native Pi session files are never opened or parsed here.
    """
    area = root / 'rooms'
    if not area.exists() and not area.is_symlink():
        return {}, []
    if area.is_symlink() or not area.is_dir():
        raise SandpiError('Sandpi room root must be a real directory', 78)
    info = area.stat()
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o022:
        raise SandpiError('Sandpi room root must be owned by this user and not group/other writable', 78)
    entries = _bounded_entries(area, label='Sandpi room root')
    expected_project = str(project.resolve())
    evidence: dict[str, list[str]] = {}
    issues: list[str] = []
    import machine
    for room in entries:
        if room.is_symlink() or not room.is_dir():
            continue
        try:
            metadata = machine.read_metadata(room)
            if metadata.get('project') != expected_project:
                continue
            namespace = _namespace(metadata.get('project_anchor'))
            name = metadata.get('name')
            from core import room_id as derive_room_id
            if not isinstance(name, str) or room.name != derive_room_id(namespace, name):
                raise SandpiError('room metadata does not match its stable project identity', 78)
            evidence.setdefault(namespace, []).append(room.name)
        except (SandpiError, OSError) as exc:
            issues.append(f'{room.name}: {exc}')
    return evidence, issues


def recovery_candidates(root: Path, project: Path) -> dict[str, Any]:
    """Discover bounded, content-free evidence for a missing project anchor."""
    project = project.resolve()
    device, inode = _path_identity(project)
    documents, issues = _binding_documents(root)
    room_evidence, room_issues = _room_recovery_evidence(root, project)
    issues.extend(room_issues)
    rows: dict[str, dict[str, Any]] = {}
    current_path = str(project)
    priority = {'exact-object': 0, 'same-object-moved': 1,
                'path-replaced': 2, 'room-path': 3}

    for binding in documents:
        same_path = binding['project'] == current_path
        same_object = (binding['device'], binding['inode']) == (device, inode)
        if same_path and same_object:
            match = 'exact-object'
        elif same_object:
            match = 'same-object-moved'
        elif same_path:
            match = 'path-replaced'
        else:
            continue
        namespace = binding['room_namespace']
        rows[namespace] = {
            'room_namespace': namespace,
            'namespace_sha256': sha256(namespace.encode()),
            'match': match,
            'source': 'binding',
            'bound_project': binding['project'],
            'bound_device': binding['device'],
            'bound_inode': binding['inode'],
            'bound_at': binding['bound_at'],
            'binding_revision': binding['revision'],
            'rooms': sorted(room_evidence.get(namespace, [])),
            'automatic': match in {'exact-object', 'same-object-moved'},
        }

    for namespace, rooms in room_evidence.items():
        if namespace in rows:
            rows[namespace]['rooms'] = sorted(set(rows[namespace]['rooms']) | set(rooms))
            continue
        rows[namespace] = {
            'room_namespace': namespace,
            'namespace_sha256': sha256(namespace.encode()),
            'match': 'room-path',
            'source': 'room-metadata',
            'bound_project': None,
            'bound_device': None,
            'bound_inode': None,
            'bound_at': None,
            'binding_revision': None,
            'rooms': sorted(rooms),
            'automatic': False,
        }

    candidates = sorted(rows.values(), key=lambda row: (
        priority[row['match']], row['namespace_sha256']))
    return {
        'schema': RECOVERY_SCHEMA,
        'project': current_path,
        'device': device,
        'inode': inode,
        'candidates': candidates,
        'issues': issues[:64],
        'issues_truncated': len(issues) > 64,
    }


def _select_candidate(discovery: dict[str, Any], *, automatic: bool) -> dict[str, Any] | None:
    candidates = [row for row in discovery['candidates'] if row.get('automatic') or not automatic]
    namespaces = {row['room_namespace'] for row in candidates}
    if not candidates:
        return None
    if len(namespaces) != 1:
        mode = 'automatic' if automatic else 'explicit'
        raise SandpiError(
            f'ambiguous {mode} project recovery: {len(namespaces)} persistent identities match this path; '
            'inspect `sandpi project --json` before changing state', 75)
    return candidates[0]


def select_recovery_candidate(root: Path, project: Path, *,
                              selector: str | None = None) -> tuple[dict[str, Any], dict[str, Any]]:
    """Return one explicit recovery candidate and its discovery receipt.

    Without a selector recovery remains conservative and requires one namespace.
    A selector is an 8-or-more-character SHA-256 prefix printed by
    ``sandpi project``; raw namespaces never need to be copied into a shell.
    """
    discovery = recovery_candidates(root, project)
    if selector is None:
        candidate = _select_candidate(discovery, automatic=False)
    else:
        if not isinstance(selector, str) or not re.fullmatch(r'[a-fA-F0-9]{8,64}', selector):
            raise SandpiError('project recovery selector must be an 8-to-64-character SHA-256 prefix', 64)
        prefix = selector.lower()
        matches = [row for row in discovery['candidates']
                   if row['namespace_sha256'].startswith(prefix)]
        if not matches:
            raise SandpiError('no project recovery identity matches that SHA-256 prefix', 66)
        namespaces = {row['room_namespace'] for row in matches}
        if len(namespaces) != 1:
            raise SandpiError('project recovery SHA-256 prefix is ambiguous; provide more characters', 75)
        candidate = matches[0]
    if candidate is None:
        raise SandpiError('no persistent Sandpi project identity matches this path', 66)
    return candidate, discovery


def resolve(root: Path, project: Path) -> dict[str, Any]:
    """Resolve a stable namespace without mutating the project.

    A missing anchor is recovered automatically only from a unique central binding
    that proves the exact same directory object (possibly after rename).  Path-only
    or room-only evidence is surfaced but requires ``project --recover --yes``.
    """
    current = load(project)
    if current['persisted']:
        return current
    discovery = recovery_candidates(root, project)
    candidate = _select_candidate(discovery, automatic=True)
    if candidate is not None:
        return {
            **current,
            'room_namespace': candidate['room_namespace'],
            'created_at': candidate.get('bound_at'),
            'created_revision': candidate.get('binding_revision'),
            'source': 'binding-recovery-preview',
            'recovery_candidate': candidate,
            'recovery': discovery,
        }
    if discovery['candidates']:
        raise SandpiError(
            'the project anchor is missing but persistent Sandpi identity evidence exists. '
            'Run `sandpi project --json`, then choose `sandpi project --recover --yes` '
            'to keep that machine or `sandpi project --new --yes` for a separate lineage.', 75)
    return {**current, 'recovery': discovery}


def _anchor_value(namespace: str, *, revision: int,
                  candidate: dict[str, Any] | None = None) -> dict[str, Any]:
    created_at = candidate.get('bound_at') if candidate else None
    created_revision = candidate.get('binding_revision') if candidate else None
    return {
        'schema': ANCHOR_SCHEMA,
        'room_namespace': _namespace(namespace),
        'created_at': created_at if isinstance(created_at, str) and created_at else timestamp(),
        'created_revision': created_revision if type(created_revision) is int and created_revision > 0 else revision,
    }


@contextlib.contextmanager
def materialize(root: Path, project: Path, *, expected_namespace: str,
                revision: int, explicit_recovery: bool = False):
    """Create a canonical or recovered anchor transactionally.

    The project lock remains held while the caller publishes the central binding.
    If that publication or a stopped-room metadata migration fails, a newly written
    anchor is removed again so the previous recovery evidence remains authoritative.
    """
