def main(argv:list[str]|None=None)->int:
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--pi',type=Path,help='existing Nix upstream Pi or Sandpi runtime launcher; no build')
    p.add_argument('--scope',choices=('all','experience','loop'),default='all',
        help='experience: inference-free local RPC workflows; loop: only the synthetic two-pass /loop contract')
    p.add_argument('--output',type=Path)
    args=p.parse_args(argv)
    out=(args.output or Path(os.environ.get('SANDPI_TEST_RESULTS',ROOT/'evidence/pi-native-contract'))).resolve()
    suite={'all':'pi-native-contract','experience':'pi-native-experience','loop':'pi-native-loop'}[args.scope]
    # The parent acceptance runner may have opened runner.log in its fresh stage
    # directory. No other artifact can be reused, including an old passing result.
    try:
        out.mkdir(parents=True,exist_ok=True)
        if any(path.name!='runner.log' for path in out.iterdir()):
            raise SandpiError('native output directory has prior artifacts; choose a fresh path')
    except (SandpiError,OSError) as error:
        print('sandpi native contract: '+str(error),file=sys.stderr);return 1
    result={'suite':suite,'scope':args.scope,'status':'running'}
    atomic_json(out/'result.json',result)
    try:
        pi=args.pi
        if pi is None:
            import nixhost
            flake=nixhost.render_flake(ROOT,out/'flake')
            subprocess.run(nixhost.nix_command('build','--out-link',str(out/'pi'),f'path:{flake}#pi'),check=True)
            pi=out/'pi/bin/pi'
        result=run(pi,out,scope=args.scope)
        atomic_json(out/'result.json',result);print(json.dumps(result,indent=2));return 0
    except (SandpiError,OSError,subprocess.SubprocessError,ValueError,RuntimeError) as error:
        # No unconditional zero-inference claim on failed/incomplete execution.
        atomic_json(out/'result.json',{'suite':suite,'scope':args.scope,'status':'failed',
            'error_type':type(error).__name__,'error':str(error),
            'phase_receipt':'phase-progress.json' if (out/'phase-progress.json').is_file() else None,
            'real_provider_requests':None,'real_credentials_used':None})
        print('sandpi native contract: '+str(error),file=sys.stderr);return 1
