        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            source = result['source']
            suffix = f' checkpoint={source["checkpoint"]}' if source['checkpoint'] else ''
            print(f'Backed up room {source["name"]}{suffix} -> {result["path"]}')
            print(f'  disk          {result["disk"]["digest"]["logical_bytes"] / GIB:.1f} GiB; sha256={result["disk"]["digest"]["sha256"][:16]}…')
            print(f'  Nix closure   {result["nix"]["path_count"]} paths; {result["nix"]["store_mode"]}')
            if result['nix']['store_mode'] == 'manifest':
                print('  import needs  target-host substituters able to reproduce the exact lower-store path set')
            else:
                print('  import needs  no target substituter for the included lower-store closure')
            print('  excludes      live workspace, credentials, logs, checkpoints, host observations, upgrade rollback slots')
        return 0

    if args.backup_action == 'import':
        result = roomarchive.import_backup(
            root, project, plan['project_anchor'], source=args.source,
            target_name=args.target,
            keep_machine_profile=args.keep_machine_profile)
        result['activated'] = False
        if args.activate:
            try:
                result['selection'] = roomselect.save(
                    project, plan['project_anchor'], result['target']['name'], revision=REVISION)
                result['activated'] = True
            except BaseException as error:
                raise SandpiError(
                    f'room import {result["target"]["name"]!r} was published, but selecting it failed: {error}. '
                    f'Use `sandpi use {result["target"]["name"]}` after inspecting the room.', 74) from error
        if args.json:
            print(json.dumps(result, indent=2, sort_keys=True))
        else:
            print(f'Imported backup {result["source"]["name"]} -> room {result["target"]["name"]}')
            print(f'  disk          {result["disk"]["digest"]["logical_bytes"] / GIB:.1f} GiB; verified')
            print(f'  Nix closure   {result["nix"]["path_count"]} retained paths from {result["nix"]["store_mode"]} backup')
            print('  copied        guest Pi sessions, packages, guest-local Nix state, and source runtime identity')
            print("  attached      this project's live workspace and canonical Sandcodex credentials at launch")
            print('  not copied    source workspace, credentials, logs, checkpoints, host observations, port forwards, rollback slots')
            if result['activated']:
                print('  selected      plain sandpi now enters this imported room')
            else:
                print(f'Enter it once with `sandpi --name {result["target"]["name"]}` or select it with `sandpi use {result["target"]["name"]}`.')
        return 0

    raise SandpiError('unknown backup action', 64)


def disk_grow(args: argparse.Namespace) -> int:
    root, _, _, _, room = locations(args)
    desired = parse_bytes(args.size)
    with file_lock(room / 'prepare.lock', wait=False), file_lock(room / 'run.lock', wait=False):
        if room_status(room).get('process_alive'):
            raise SandpiError('stop the room before growing its disk', 75)
        import upgrades
        upgrades.assert_structural_mutation_allowed(room, 'grow the guest disk')
        path = room / 'root.raw'
        if path.is_symlink() or not path.is_file():
            raise SandpiError('this room has no regular disk image', 66)
        current = path.stat().st_size
        if desired < current:
            raise SandpiError('disk shrinking is not supported', 64)
        if desired > current:
            with path.open('r+b') as stream:
                stream.truncate(desired)
                stream.flush()
                os.fsync(stream.fileno())
        import machine
        meta = machine.read_metadata(room)
        meta['disk_bytes'] = desired
        if isinstance(meta.get('machine_profile'), dict):
            profile = dict(meta['machine_profile'])
            profile['disk_bytes'] = desired
            profile['saved_at'] = timestamp()
            profile['saved_revision'] = REVISION
            meta['machine_profile'] = machine.validate_profile(profile)
        atomic_json(room / 'room.json', meta)
    log(f'disk capacity is now {desired // GIB} GiB; NixOS expands ext4 at the next boot')
    return 0


def main(argv: list[str] | None = None) -> int:
    try:
        args, extra = parse(list(sys.argv[1:] if argv is None else argv))
        command = args.command
