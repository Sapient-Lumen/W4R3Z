                  'fetched_at': fetched_at,
                  'stale': bool(catalog_evidence.get('stale', False)) if isinstance(catalog_evidence, dict) else False,
                  'refresh_failed': bool(catalog_evidence.get('refresh_failed', False)) if isinstance(catalog_evidence, dict) else False,
                  'source': 'full' if all_catalog else 'free',
              },
              'grades': grades, 'maxKeyAttempts': 8,
              'requestTimeoutMs': 600000,
              'resumeRequested': runtime.get('resume_requested', False),
              'continueRequested': runtime.get('continue_requested', False),
              'resumeSnapshot': runtime.get('resume_snapshot'),
              'resumeFallback': runtime.get('resume_fallback', 'ask'),
              'explicitModel': runtime.get('explicit_model', False),
              'allowModelCooldownProbe': runtime.get('allow_model_cooldown_probe', False),
              'resumeHint': runtime.get('resume_hint'),
              'toolProfileRequest': runtime.get('tool_profile_request', 'auto'),
              'benchmarkProfile': runtime.get('benchmark_profile', False),
              'toolProfileManaged': runtime.get('tool_profile_managed', True),
              'initialToolProfile': runtime.get('initial_tool_profile', 'classic'),
              'toolProfiles': {**runtime.get('tool_profiles', {}), **{ident: row['tool_profile'] for ident, row in recipes.items()}},
              'frontierProviders': runtime.get('frontier_providers', ['openai-codex', 'openai', 'google']),
              'codemodeFloor': runtime.get('codemode_floor', 3),
              'blockedModels': runtime.get('blocked_models', []),
              'routeHealth': runtime.get('route_health', {}),
              'modelFingerprints': runtime.get('model_fingerprints', {}),
              'quotaSummary': runtime.get('quota_summary'),
              'requestedThinking': runtime.get('requested_thinking'),
              'invocation': {'schema': INVOCATION_RUNTIME_SCHEMA, 'mode': 'launch-base'}}
    atomic_json(target, config)
    settings = read_json(agent_dir / 'settings.json', {})
    if not isinstance(settings, dict):
        raise SandpiError('Pi settings.json must be an object')
    _configure_managed_package(agent_dir, settings, package)
    settings.setdefault('quietStartup', 'header')
    # Sandpi traverses an SSH/vsock boundary. Regular mode leaves scrollback and
    # text selection with the caller's terminal, so ordinary highlight/copy works
    # without depending on nested mouse protocols. A saved user choice or an
    # explicit `--tui-mode fullscreen` still wins through Pi's native precedence.
    settings.setdefault('tuiMode', 'regular')
    codemode = settings.setdefault('codemode', {})
    if not isinstance(codemode, dict):
        raise SandpiError('Pi codemode settings must be an object')
    codemode.setdefault('mode', 'on')
    settings_overlay = _reconcile_model_defaults(agent_dir, settings, all_models)
    atomic_json(agent_dir / 'settings.json', settings)
    atomic_json(agent_dir / 'sandpi-settings-overlay.json', settings_overlay)
    return target


_RESUME_SNAPSHOT_SCHEMA = 'sandpi.native-resume-snapshot.v1'
_RESUME_ID = re.compile(r'^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,198}[A-Za-z0-9])?$')
_RESUME_PROVIDER = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$')
_RESUME_MODEL = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,511}$')
_RESUME_API = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$')
_RESUME_ORIGIN = re.compile(r'^[A-Za-z0-9:._-]{1,200}$')
_RESUME_THINKING = {'off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'}
_RESUME_REQUESTS = {'auto', 'classic', 'codemode', 'passthrough'}
_RESUME_EFFECTIVE = {'classic', 'codemode', 'passthrough', 'text-only'}


def _resume_model(value: Any, *, optional: bool = True) -> dict | None:
    if value is None and optional:
        return None
    if not isinstance(value, dict) or set(value) - {'provider', 'id', 'api'}:
        raise SandpiError('native Pi resume preflight returned an invalid model identity', 78)
    provider, model, api = value.get('provider'), value.get('id'), value.get('api')
    if not isinstance(provider, str) or not _RESUME_PROVIDER.fullmatch(provider) or \
            not isinstance(model, str) or not _RESUME_MODEL.fullmatch(model):
        raise SandpiError('native Pi resume preflight returned an invalid model identity', 78)
    clean = {'provider': provider, 'id': model}
    if api is not None:
        if not isinstance(api, str) or not _RESUME_API.fullmatch(api):
            raise SandpiError('native Pi resume preflight returned an invalid model API', 78)
        clean['api'] = api
    return clean


def validate_resume_snapshot(value: Any) -> dict:
    """Accept only Pi branch state needed to guard native continuation.

    Prompt text, messages, summaries, tool calls/results, usage and arbitrary
    extension data are not fields in this schema and cannot cross this step.
    """
    if not isinstance(value, dict) or value.get('schema') != _RESUME_SNAPSHOT_SCHEMA or type(value.get('found')) is not bool:
        raise SandpiError('native Pi resume preflight returned an invalid snapshot', 78)
    if not value['found']:
        if set(value) != {'schema', 'found'}:
            raise SandpiError('empty native Pi resume snapshot contains unexpected data', 78)
        return {'schema': _RESUME_SNAPSHOT_SCHEMA, 'found': False}
    allowed = {'schema', 'found', 'session', 'file', 'projected_model', 'thinking_level',
               'tool_profile', 'transport', 'affinity_origin', 'last_handoff'}
    if set(value) != allowed:
        raise SandpiError('native Pi resume snapshot contains unexpected data', 78)
    session = value.get('session')
    if not isinstance(session, str) or not _RESUME_ID.fullmatch(session):
        raise SandpiError('native Pi resume preflight returned an invalid session identity', 78)
    file = value.get('file')
    if not isinstance(file, dict) or set(file) != {'name', 'bytes', 'mtime_ns', 'sha256'}:
        raise SandpiError('native Pi resume preflight returned invalid file evidence', 78)
    name, size, mtime_ns, digest = file.get('name'), file.get('bytes'), file.get('mtime_ns'), file.get('sha256')
    if not isinstance(name, str) or Path(name).name != name or not name or any(c in name for c in '\0\r\n') or \
            type(size) is not int or not 0 <= size <= 2**63 - 1 or not isinstance(mtime_ns, str) or \
            not mtime_ns.isdigit() or not re.fullmatch(r'[a-f0-9]{64}', digest or ''):
        raise SandpiError('native Pi resume preflight returned invalid file evidence', 78)
    thinking = value.get('thinking_level')
    if thinking is not None and thinking not in _RESUME_THINKING:
        raise SandpiError('native Pi resume preflight returned an invalid thinking level', 78)
    profile = value.get('tool_profile')
    clean_profile = None
    if profile is not None:
        if not isinstance(profile, dict) or set(profile) != {'request', 'effective', 'model', 'version'} or \
                profile.get('request') not in _RESUME_REQUESTS or profile.get('effective') not in _RESUME_EFFECTIVE or \
                profile.get('version') != 1:
            raise SandpiError('native Pi resume preflight returned an invalid tool profile', 78)
        clean_profile = {'request': profile['request'], 'effective': profile['effective'],
                         'model': _resume_model(profile.get('model')), 'version': 1}
    transport = value.get('transport')
    clean_transport = None
    if transport is not None:
        if not isinstance(transport, dict) or set(transport) != {'model', 'version'} or transport.get('version') != 1:
            raise SandpiError('native Pi resume preflight returned invalid transport evidence', 78)
        clean_transport = {'model': _resume_model(transport.get('model'), optional=False), 'version': 1}
    origin = value.get('affinity_origin')
    if origin is not None and (not isinstance(origin, str) or not _RESUME_ORIGIN.fullmatch(origin)):
        raise SandpiError('native Pi resume preflight returned an invalid Gemini affinity origin', 78)
    handoff = value.get('last_handoff')
    clean_handoff = None
    if handoff is not None:
        if not isinstance(handoff, dict) or set(handoff) != {'from', 'to', 'policy', 'version'} or handoff.get('version') != 1 or \
                not isinstance(handoff.get('policy'), str) or not 1 <= len(handoff['policy']) <= 64 or \
                any(c in handoff['policy'] for c in '\0\r\n'):
            raise SandpiError('native Pi resume preflight returned invalid handoff evidence', 78)
        clean_handoff = {'from': _resume_model(handoff.get('from'), optional=False),
                         'to': _resume_model(handoff.get('to'), optional=False),
                         'policy': handoff['policy'], 'version': 1}
    return {'schema': _RESUME_SNAPSHOT_SCHEMA, 'found': True, 'session': session,
            'file': {'name': name, 'bytes': size, 'mtime_ns': mtime_ns, 'sha256': digest},
            'projected_model': _resume_model(value.get('projected_model')),
            'thinking_level': thinking, 'tool_profile': clean_profile,
            'transport': clean_transport, 'affinity_origin': origin,
            'last_handoff': clean_handoff}


def _pi_module(pi_binary: str) -> Path:
    executable = shutil.which(pi_binary) if not os.path.isabs(pi_binary) else pi_binary
    if not executable:
        raise SandpiError('Pi executable is unavailable for native resume preflight', 69)
    resolved = Path(executable).resolve()
    candidates = [resolved.parent.parent / 'lib/pi/node_modules/@earendil-works/pi-coding-agent/dist/index.js']
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise SandpiError('the pinned Pi package does not expose its native SessionManager at the expected Nix path', 70)


def inspect_pi_invocation(argv: list[str], *, free_models: list[str] | None = None) -> dict[str, Any]:
    """Extract only lifecycle/policy flags from a Pi argv.

    Prompts, @files, system prompts, extension flag values and other user data are
    deliberately absent from the returned record. This is not a second Pi parser;
    it mirrors the small set of built-in flags Sandpi must know before extensions
    load, while Pi remains authoritative for validation and actual selection.
    """
    if any(not isinstance(value, str) or '\0' in value for value in argv):
        raise SandpiError('invalid Pi invocation arguments', 64)
    command = argv[0] if argv and argv[0] in PI_SUBCOMMANDS else None
    result: dict[str, Any] = {
        'schema': INVOCATION_RUNTIME_SCHEMA,
        'mode': 'command' if command else 'new',
        'command': command,
        'continue': False,
        'resume': False,
        'explicit_model': False,
        'requested_thinking': None,
        'raw_tool_override': False,
        'mcp_disabled': False,
        'extensions_disabled': False,
        'session_dir': None,
        'allow_model_cooldown_probe': False,
        'paid_enabled': False,
        'max_price': None,
    }
    # Presence is not session-selection precedence. Native Pi chooses explicit
    # sessions/picker before --continue and uses no history for in-memory and
    # metadata work. Collect selectors, then resolve only our preflight scope.
    continuing = False
    picker = False
    session = False
    session_id = False
    fork = False
    no_session = False
    metadata = False
    export = False
    provider = None
    model = None
    models_scope = None
    value_flags = {
        '--provider', '--model', '--models', '--thinking', '--session', '--session-id', '--fork',
        '--session-dir', '--tools', '-t', '--exclude-tools', '-xt', '--mode', '--name', '-n',
        '--api-key', '--system-prompt', '--append-system-prompt', '--extension', '-e', '--skill',
        '--prompt-template', '--theme', '--use-theme', '--tui-mode', '--export', '--sandpi-max-price',
    }
    index = 1 if command else 0
    while index < len(argv):
        value = argv[index]
        if value == '--':
            break
        following = argv[index + 1] if index + 1 < len(argv) else None
        if value == '--sandpi-paid':
            result['paid_enabled'] = True
        elif value == '--sandpi-max-price':
            import model_defaults
            if following is None:
                raise SandpiError('--sandpi-max-price requires INPUT,OUTPUT', 64)
            result['max_price'] = model_defaults.max_price(following)
        elif value in ('--continue', '-c'):
            continuing = True
        elif value in ('--resume', '-r'):
            picker = True
        elif value == '--session':
            # Empty final values replace earlier values, as in native Pi. A
            # missing value remains an unresolved request, not permission to
            # read the latest session before Pi diagnoses it.
            session = following is None or bool(following)
        elif value == '--session-id' and following is not None:
            # Even an empty ID needs native validation. With --fork this is a
            # target ID, not a different source; never resolve it in Python.
            session_id = True
        elif value == '--fork':
            fork = following is None or bool(following)
        elif value == '--no-session':
            no_session = True
        elif value in ('--help', '-h', '--version', '-v', '--list-models'):
            metadata = True
        elif value == '--export' and following is not None:
            export = bool(following)
        elif value == '--provider' and following is not None:
            provider = following
            result['explicit_model'] = True
        elif value == '--model' and following is not None:
            model = following
            result['explicit_model'] = True
        elif value == '--models' and following is not None:
            models_scope = following
        elif value == '--thinking' and following in THINKING_LEVELS:
            result['requested_thinking'] = following
        elif value == '--session-dir' and following is not None:
            result['session_dir'] = following
        elif value in ('--tools', '-t', '--exclude-tools', '-xt', '--no-tools', '-nt',
                       '--no-builtin-tools', '-nbt'):
            result['raw_tool_override'] = True
        elif value == '--no-mcp':
            result['mcp_disabled'] = True
        elif value in ('--no-extensions', '-ne'):
            result['extensions_disabled'] = True
        if value in value_flags and following is not None:
            index += 2
        else:
            index += 1

    # Match the native session-manager precedence for supported agent flags,
    # independent of argument order. No path/ID lookup or conflict validator is
    # added: invalid fork/ID combinations still reach Pi unchanged. Known native
    # subcommands and metadata paths must not acquire an agent-history snapshot.
    if command or metadata or export:
        mode = 'command'
    elif no_session:
        mode = 'new'
    elif fork:
        mode = 'fork'
    elif session or session_id:
        mode = 'session'
    elif picker:
        mode = 'picker'
    elif continuing:
        mode = 'continue'
    else:
        mode = 'new'
    result['mode'] = mode
    result['continue'] = mode == 'continue'
    result['resume'] = mode in ('continue', 'picker', 'session', 'fork')

    exact_openrouter = provider == 'openrouter' and isinstance(model, str)
    if isinstance(model, str) and model.startswith('openrouter/'):
        exact_openrouter = True
        model = model.removeprefix('openrouter/')
    if isinstance(model, str) and free_models and model in set(free_models):
        exact_openrouter = exact_openrouter or provider in (None, 'openrouter')
    result['allow_model_cooldown_probe'] = bool(exact_openrouter)
    # Keep only structural scope facts, never the scope text itself.
    result['has_provider'] = provider is not None
    result['has_model'] = model is not None
    result['has_models_scope'] = models_scope is not None
    return result


# Pi reloads its extension factory in the same process. A runtime document is
# not a disposable "recent command" while that process can still reload it.
_INVOCATION_HISTORY = 31  # plus the newly reserved document
_INVOCATION_SCAN_LIMIT = 4096
_INVOCATION_NAME = re.compile(r"pi-([1-9][0-9]{0,9})-([0-9]{1,20})-([a-f0-9]{32})-([a-f0-9]{16})\.json")
_LEGACY_INVOCATION_NAME = re.compile(r"([1-9][0-9]{0,9})-[0-9]{1,24}\.json")


def _invocation_boot() -> str | None:
    """Linux boot identity prevents retaining a different boot's reused PID."""
    try:
        value = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    except OSError:
        return None
    if re.fullmatch(r'[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}', value):
        return value.replace('-', '')
    return None


def _invocation_process(pid: int) -> tuple[str, str | None]:
    """Read only process identity, never argv/env or Pi session contents.

    Unknown/inaccessible proc data is NOT evidence that a process exited.
    Linux start ticks survive exec (Python wrapper -> Nix wrapper -> Pi).
    """
    try:
        text = Path(f'/proc/{pid}/stat').read_text()
    except FileNotFoundError:
        return 'gone', None
    except OSError:
        return 'unknown', None
    prefix, separator, tail = text.rpartition(') ')
    fields = tail.split()
    if (not separator or not prefix.startswith(f'{pid} (') or len(fields) < 20
            or not re.fullmatch(r'[0-9]{1,20}', fields[19])):
        return 'unknown', None
    if fields[0] in ('Z', 'X', 'x'):
        return 'gone', None
    if fields[0] not in ('R', 'S', 'D', 'T', 't', 'W', 'K', 'P', 'I'):
        return 'unknown', None
    return 'live', fields[19]


def _invocation_finished(name: str, boot: str) -> bool:
    """Only positively finished, recognized invocations are collectible.

    Old names record only PID: preserve them while that PID exists or cannot be
    inspected. They cannot acquire exact identity by guessing from file mtime.
    Foreign/unrecognized names are never interpreted as stale runtime files.
    """
    match = _INVOCATION_NAME.fullmatch(name)
    if match:
        pid, ticks, saved_boot, _nonce = match.groups()
        if saved_boot != boot:
            return True
        state, actual = _invocation_process(int(pid))
        return state == 'gone' or (state == 'live' and actual != ticks)
    match = _LEGACY_INVOCATION_NAME.fullmatch(name)
    return bool(match and _invocation_process(int(match.group(1)))[0] == 'gone')


def _prune_invocations(directory: Path, boot: str) -> int:
    """Called under the allocation lock. Bound scanning before sorting.

    Keep all live/uncertain files and the newest completed-command history. No
    count/mtime pressure is allowed to evict a living Pi's runtime document.
    """
    entries = []
    with os.scandir(directory) as scan:
        for entry in scan:
            if len(entries) >= _INVOCATION_SCAN_LIMIT:
                raise SandpiError('Pi invocation directory exceeds its inspection bound; '
                                  'existing processes were left untouched', 75)
            entries.append(entry)
    completed = []
    for entry in entries:
        try:
            info = entry.stat(follow_symlinks=False)
        except FileNotFoundError:
            continue
        if (stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid()
                and _invocation_finished(entry.name, boot)):
            completed.append((info.st_mtime_ns, entry.name, info))
    removed = 0
    for _mtime, name, original in sorted(completed, reverse=True)[_INVOCATION_HISTORY:]:
        path = directory / name
        try:
            current = path.lstat()
            before = (original.st_dev, original.st_ino, original.st_size, original.st_mtime_ns)
            after = (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns)
            if (before != after or not stat.S_ISREG(current.st_mode)
                    or not _invocation_finished(name, boot)):
                continue
            path.unlink()
            removed += 1
        except FileNotFoundError:
            continue
    # Includes unknown names and the lock: a full directory refuses *new* work
    # rather than sacrificing an existing session to make a slot.
    return len(entries) - removed


def _invocation_runtime_path(agent_dir: Path, base: Path) -> Path:
    directory = base.parent / 'invocations'
    if directory.is_symlink():
        raise SandpiError('Pi invocation runtime directory cannot be a symlink', 78)
    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
    directory.chmod(0o700)
    boot = _invocation_boot()
    state, ticks = _invocation_process(os.getpid())
    if boot is None or state != 'live' or ticks is None:
        raise SandpiError('Linux process identity is unavailable for Pi runtime retention; '
                          'existing runtime files were left untouched', 75)
    with file_lock(directory / '.allocation.lock', timeout=10):
        count = _prune_invocations(directory, boot)
        if count >= _INVOCATION_SCAN_LIMIT:
            raise SandpiError('Pi invocation directory is full; existing processes were '
                              'left untouched. Close unused Pi processes before retrying', 75)
        for _ in range(8):
            target = directory / f'pi-{os.getpid()}-{ticks}-{boot}-{secrets.token_hex(8)}.json'
            try:
                # Reserve under the lock, then publish with atomic_json below.
                # Even an in-flight/empty reservation is protected by its live
                # owner; another allocator cannot collect it before publication.
                fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            except FileExistsError:
                continue
            os.close(fd)
            return target
    raise SandpiError('Could not allocate a unique Pi invocation runtime', 75)


def prepare_pi_invocation(agent_dir: Path, argv: list[str], pi_binary: str, workspace: Path, *,
                          base_runtime: str | Path | None = None,
                          use_launch_policy: bool = False) -> Path:
    """Materialize process-local Pi policy from the actual invocation.

    A room can launch Pi repeatedly. Session/model/tool flags from the cold host
    launch must not leak into later `pi`, `pi -c`, or `pi -r` commands. The base
    runtime carries room-global catalog and credential facts; this function adds
    only the current process's lifecycle flags and runs native `--continue`
    preflight when that exact invocation asks for it.
    """
    base = Path(base_runtime) if base_runtime is not None else runtime_config_path(agent_dir)
    value = read_json(base)
    if not isinstance(value, dict) or value.get('schema') != RUNTIME_SCHEMA:
        raise SandpiError('Pi base runtime has an unsupported schema', 78)
    info = inspect_pi_invocation(argv, free_models=value.get('freeModels', []))
    runtime = copy.deepcopy(value)
    target = _invocation_runtime_path(agent_dir, base)
    benchmark = bool(value.get('benchmarkProfile')) if use_launch_policy else False
    raw_tools = bool(info['raw_tool_override'])
    if use_launch_policy:
        profile_request = value.get('toolProfileRequest', 'auto')
        profile_managed = bool(value.get('toolProfileManaged', True))
        resume_fallback = value.get('resumeFallback', 'ask')
    else:
        profile_request = 'auto'
        profile_managed = True
        resume_fallback = 'ask'
    # Actual Pi tool flags own ordinary invocations. The benchmark is the sole
    # exception: its fixed four-tool contract is part of the measured profile.
    if raw_tools and not benchmark:
        profile_request = 'passthrough'
        profile_managed = False
    paid = bool(info['paid_enabled'] or (use_launch_policy and value.get('freeOnly') is False))
    price_limit = info['max_price'] if info['max_price'] is not None else value.get('maxPrice') if use_launch_policy else None
    if price_limit is not None and not paid:
        raise SandpiError('--sandpi-max-price requires --sandpi-paid for this process', 64)
    runtime.update({
        'freeOnly': not paid, 'maxPrice': price_limit,
        'kind': 'invocation',
        'runtimeConfig': str(target),
        'baseRuntime': str(base),
        'resumeRequested': bool(info['resume']),
        'continueRequested': bool(info['continue']),
        'resumeSnapshot': None,
        'resumeHint': value.get('resumeHint') if use_launch_policy else None,
        'resumeFallback': resume_fallback,
        'explicitModel': bool(info['explicit_model'] or
                              (use_launch_policy and value.get('explicitModel', False))),
        'allowModelCooldownProbe': bool(info['allow_model_cooldown_probe']),
        'requestedThinking': info['requested_thinking'],
        'benchmarkProfile': benchmark,
        'toolProfileManaged': profile_managed,
        'toolProfileRequest': profile_request,
        'mcpDisabledByFlag': bool(info['mcp_disabled']),
        'extensionsDisabledByFlag': bool(info['extensions_disabled']),
        'invocation': {key: val for key, val in info.items() if key != 'session_dir'},
    })
    atomic_json(target, runtime)
    if info['continue']:
        # A missing override is not the sessions root. Let pinned Pi select
        # its project-specific default and read native sessionDir settings.
        # Preserve raw CLI paths (including file: URLs and literal ~user names)
        # for Pi's normalizer, not pathlib's different expansion rules.
        prepare_resume_snapshot(agent_dir, {}, pi_binary, workspace,
                                runtime_path=target, session_dir=info.get('session_dir'))
    return target


def prepare_resume_snapshot(agent_dir: Path, launch: dict, pi_binary: str, workspace: Path, *,
                            runtime_path: str | Path | None = None,
                            session_dir: str | Path | None = None) -> dict | None:
    """Capture the branch Pi's own `--continue` resolver will select.

    This is intentionally a narrow continuity check, not a second session
    implementation. Pi's exported SessionManager selects and projects the
    branch; Sandpi only binds model/profile/key-affinity policy before Pi can
    perform a startup fallback.
    """
    target = Path(runtime_path) if runtime_path is not None else runtime_config_path(agent_dir)
    runtime = read_json(target, {})
    if not runtime.get('continueRequested'):
        return None
    package = _package_source(runtime.get('corePackage'))
    script = package / 'session-preflight.mjs'
    module = _pi_module(pi_binary)
    node = shutil.which('node')
    if not node:
        raise SandpiError('Node.js is unavailable for native Pi resume preflight', 69)
    command = [node, str(script), '--module', str(module), '--cwd', str(workspace)]
    if session_dir is not None:
        command.extend(['--session-dir', str(session_dir)])
    # The native settings/default resolver must see the same agent directory
    # and cwd as this invocation. Only the short-lived preflight child changes.
    environment = {**os.environ, 'PI_CODING_AGENT_DIR': str(agent_dir)}
    try:
        completed = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   cwd=workspace, env=environment, timeout=20, check=False)
    except subprocess.TimeoutExpired:
        raise SandpiError('native Pi resume preflight timed out', 124) from None
    if completed.returncode:
        detail = completed.stderr.decode(errors='replace').strip().splitlines()
        suffix = f': {detail[-1][:300]}' if detail else ''
        raise SandpiError(f'native Pi resume preflight exited with status {completed.returncode}{suffix}',
                          completed.returncode if completed.returncode > 0 else 70)
    if len(completed.stdout) > 1024 * 1024:
        raise SandpiError('native Pi resume preflight output is oversized', 78)
    try:
        snapshot = validate_resume_snapshot(json.loads(completed.stdout))
    except (ValueError, UnicodeError) as error:
        raise SandpiError('native Pi resume preflight returned invalid JSON', 78) from error
    runtime['resumeSnapshot'] = snapshot
    atomic_json(target, runtime)
    return snapshot


def _pi_tool_pattern_matches(pattern: str, name: str) -> bool:
    """Mirror Pi's v1.1.0 tool matcher: only ``*`` is special."""
    source = '.*'.join(re.escape(part) for part in pattern.split('*'))
    return re.fullmatch(source, name) is not None


def _pi_tool_enabled_by_cli(patterns: list[str], name: str) -> bool:
    """Evaluate Pi 1.1 ``--tools`` replacement plus ``+``/``-`` deltas.

    This narrow mirror is used only to retain the built-in Codemode extension
    under ``--no-extensions`` when the user explicitly requests that tool. Pi
    remains the authoritative owner of the actual loadout.
    """
    plain = [item for item in patterns if not (len(item) > 1 and item[0] in '+-')]
    selected = any(_pi_tool_pattern_matches(item, name) for item in plain)
    for item in patterns:
        if len(item) > 1 and item[0] in '+-' and _pi_tool_pattern_matches(item[1:], name):
            selected = item[0] == '+'
    return selected


def _pi_bootstrap_option_indices(argv: list[str]) -> list[int]:
    """Use the shared native-agent token boundary, excluding native subcommands."""
    if argv and argv[0] in PI_SUBCOMMANDS:
        return []
    return pi_option_indices(argv)


def _pi_selected_tool_patterns(argv: list[str]) -> list[str]:
    """Return the final explicit ``--tools`` list, not a union of old choices.

    Only option-position tokens participate. Pi remains the syntax validator:
    malformed lists are forwarded unchanged, not repaired by this helper.
    """
    patterns: list[str] = []
    for index in _pi_bootstrap_option_indices(argv):
        if argv[index] in ('--tools', '-t') and index + 1 < len(argv):
            patterns = [item.strip() for item in argv[index + 1].split(',') if item.strip()]
    return patterns


def managed_pi_args(argv: list[str], agent_dir: Path, *,
                    package_source: str | Path | None = None,
                    runtime_path: str | Path | None = None) -> list[str]:
    """Keep Sandpi's credential-bank adapter under Pi ``--no-extensions``.

    The switch still disables every optional/user/package extension. Pi honors
    explicit ``-e`` resources after that switch, so the immutable Sandpi core
    package remains present without reopening extension discovery generally.
    """
    selected = list(argv)
    indices = _pi_bootstrap_option_indices(selected)
    if not any(selected[index] in ('--no-extensions', '-ne') for index in indices):
        return selected
    package = _package_source(package_source)
    managed = str(package / 'index.ts')
    explicit = [selected[index + 1] for index in indices
                if selected[index] in ('--extension', '-e') and index + 1 < len(selected)]
    additions: list[str] = []
    if managed not in explicit:
        additions.extend(['--extension', managed])
    target = Path(runtime_path) if runtime_path is not None else runtime_config_path(agent_dir)
    runtime = read_json(target, {})
    raw_codemode = _pi_tool_enabled_by_cli(_pi_selected_tool_patterns(selected), 'codemode')
    needs_codemode = bool(runtime.get('toolProfileManaged', False)) or raw_codemode
    if needs_codemode and 'builtin:codemode' not in explicit:
        additions.extend(['--extension', 'builtin:codemode'])
    return [*additions, *selected]


def strip_sandpi_flags(argv: list[str]) -> list[str]:
    """Consume only the guest wrapper's opt-in flags, never prompt/file values."""
    result: list[str] = []
    value_flags = {
        '--provider', '--model', '--models', '--thinking', '--session', '--session-id', '--fork',
        '--session-dir', '--tools', '-t', '--exclude-tools', '-xt', '--mode', '--name', '-n',
        '--api-key', '--system-prompt', '--append-system-prompt', '--extension', '-e', '--skill',
        '--prompt-template', '--theme', '--use-theme', '--tui-mode', '--export',
    }
    i = 0
    while i < len(argv):
        value = argv[i]
        if value == '--':
            result.extend(argv[i:]); break
        if value == '--sandpi-paid':
            i += 1; continue
        if value == '--sandpi-max-price':
            if i + 1 >= len(argv):
                raise SandpiError('--sandpi-max-price requires INPUT,OUTPUT', 64)
            i += 2; continue
        result.append(value)
        if value in value_flags and i + 1 < len(argv):
            result.append(argv[i + 1]); i += 1
        i += 1
    return result


def pi_update_rejection(argv: list[str]) -> str | None:
    """Return a message when a Pi command would replace Sandpi's pinned Pi.

    Pi packages and the remote model catalog remain user-managed. The executable
    itself is part of the tested Nix closure and advances only with Sandpi.
    """
    if not argv or argv[0] != 'update':
        return None
    rest = argv[1:]
    positional = [value for value in rest if value != '--' and not value.startswith('-')]
    if '--all' in rest or '--self' in rest or any(value in {'self', 'pi'} for value in positional):
        return ('Pi itself is pinned by Sandpi/Nix. Use `pi update --extensions`, '
                '`pi update --models`, or update an explicit package; upgrade Sandpi to change Pi.')
    if '--extensions' in rest or '--models' in rest:
        return None
    if positional:
        return None
    return ('Pi itself is pinned by Sandpi/Nix. Use `pi update --extensions`, '
            '`pi update --models`, or update an explicit package; upgrade Sandpi to change Pi.')


def pi_wrapper(argv: list[str]) -> int:
    """Execute immutable upstream Pi with process-local Sandpi policy.

    The persistent room may run Pi many times. Reconcile only Sandpi-owned
    composition, derive a fresh invocation runtime from this exact argv, and
    leave Pi's sessions/packages/settings as native writable guest state.
    """
    if argv and argv[0] == '--':
        argv = argv[1:]
    rejection = pi_update_rejection(argv)
    if rejection:
        raise SandpiError(rejection, 64)
    if os.environ.get('SANDPI_PI_WRAPPER_ACTIVE') == '1':
        raise SandpiError('Sandpi Pi wrapper recursion detected; SANDPI_UPSTREAM_PI is invalid', 78)
    upstream = os.environ.get('SANDPI_UPSTREAM_PI')
    if not upstream:
        raise SandpiError('SANDPI_UPSTREAM_PI is not configured', 78)
    executable = shutil.which(upstream) if not os.path.isabs(upstream) else upstream
    if not executable or not Path(executable).exists():
        raise SandpiError('the pinned upstream Pi executable is unavailable', 69)
    agent_dir = Path(os.environ.get('PI_CODING_AGENT_DIR', Path.home() / '.pi/agent'))
    package = _package_source()
    target = runtime_config_path(agent_dir)
    active = read_json(target)
    if isinstance(active, dict) and active.get('schema') == RUNTIME_SCHEMA and active.get('kind') == 'invocation':
        base_path = active.get('baseRuntime')
        if not isinstance(base_path, str) or not base_path or '\0' in base_path:
            raise SandpiError('Pi invocation runtime has no valid base runtime', 78)
        target = Path(base_path)
    base = read_json(target)
    if not isinstance(base, dict) or base.get('schema') != RUNTIME_SCHEMA or base.get('kind') != 'base':
        raise SandpiError('Pi wrapper requires the Sandpi room base runtime', 78)
    # The guest is mutable by design, but every invocation begins from a coherent
    # Sandpi composition. Shared credentials displace rather than destroy native
    # Pi credentials, and the managed package declaration is the only package
    # entry repaired here. User packages/project resources/sessions remain Pi-owned.
    with file_lock(agent_dir / '.sandpi-compose.lock', timeout=10):
        configure_agent(agent_dir, base.get('providers', []), base.get('authHelper', 'sandpi-auth'))
        settings = read_json(agent_dir / 'settings.json', {})
        if not isinstance(settings, dict):
            raise SandpiError('Pi settings.json must be an object')
        _configure_managed_package(agent_dir, settings, package)
        atomic_json(agent_dir / 'settings.json', settings)
    use_launch_policy = os.environ.get('SANDPI_INITIAL_INVOCATION') == '1'
    invocation = prepare_pi_invocation(agent_dir, argv, str(executable), Path.cwd(),
                                       base_runtime=target, use_launch_policy=use_launch_policy)
    selected = managed_pi_args(strip_sandpi_flags(argv), agent_dir, package_source=package, runtime_path=invocation)
    environment = dict(os.environ)
    environment['SANDPI_PI_WRAPPER_ACTIVE'] = '1'
    environment['SANDPI_RUNTIME_CONFIG'] = str(invocation)
    environment.pop('SANDPI_INITIAL_INVOCATION', None)
    os.execvpe(str(executable), [str(executable), *selected], environment)
    return 127

def _clean_launch_path(value: Any, *, label: str) -> Path:
    if not isinstance(value, str) or not value.startswith('/') or len(value) > 4096 or any(c in value for c in '\0\r\n'):
        raise SandpiError(f'invalid {label}')
    path = Path(value)
    if '..' in path.parts:
        raise SandpiError(f'invalid {label}')
    return path


def _entry_workdir(launch: dict[str, Any]) -> Path:
    workspace = _clean_launch_path(launch.get('workspace', '/workspace'), label='workspace path')
    workdir = _clean_launch_path(launch.get('workdir', str(workspace)), label='Pi working directory')
    try:
        resolved_workspace = workspace.resolve(strict=True)
        resolved_workdir = workdir.resolve(strict=True)
    except FileNotFoundError as exc:
        raise SandpiError(f'Pi working directory is unavailable: {exc.filename}', 66) from None
    if not resolved_workdir.is_dir() or not under(resolved_workdir, resolved_workspace):
        raise SandpiError('Pi working directory must be a directory inside the selected workspace', 78)
    return resolved_workdir


def load_launch(path: Path = LAUNCH) -> dict[str, Any]:
    launch = read_json(path)
    if launch.get('schema') != 'sandpi.launch.v1':
        raise SandpiError('unsupported launch schema')
    workspace = _clean_launch_path(launch.get('workspace', '/workspace'), label='workspace path')
    workdir = _clean_launch_path(launch.get('workdir', str(workspace)), label='Pi working directory')
    if launch.get('mode') == 'vm' and (str(workspace) != '/workspace' or
            not (str(workdir) == '/workspace' or str(workdir).startswith('/workspace/'))):
        raise SandpiError('VM working directory must stay inside /workspace')
    argv = launch.get('pi_args', [])
    if not isinstance(argv, list) or any(not isinstance(x, str) or '\0' in x for x in argv):
        raise SandpiError('invalid Pi argument vector')
    providers = launch.get('providers', [])
    if not isinstance(providers, list) or any(provider not in PROVIDERS for provider in providers):
        raise SandpiError('invalid managed provider list')
    if type(launch.get('reentry', False)) is not bool:
        raise SandpiError('invalid room-entry marker')
    if launch.get('reentry'):
        entry = launch.get('entry_id')
        runtime = launch.get('runtime_config')
        if not isinstance(entry, str) or not re.fullmatch(r'[a-f0-9]{24}', entry):
            raise SandpiError('invalid secondary room-entry identity')
        if runtime != f'/run/sandpi/entries/entry-{entry}.json':
            raise SandpiError('secondary room-entry runtime path is invalid')
        if launch.get('mode') != 'vm' or launch.get('workspace') != '/workspace' or \
                launch.get('entry_role') != 'secondary':
            raise SandpiError('secondary room-entry boundary is invalid')
        if launch.get('room_lifecycle') not in ('detached', 'owner-terminal'):
            raise SandpiError('secondary room-entry lifecycle is invalid')
        room_file = Path('/etc/sandpi-room')
        if room_file.exists() and room_file.read_text(errors='replace').strip() != launch.get('room_id'):
            raise SandpiError('secondary room entry names a different VM')
    return launch


def boot_prepare() -> int:
    launch = load_launch()
    Path('/run/sandpi').mkdir(parents=True, exist_ok=True, mode=0o700)
    key = Path('/run/sandpi-share/ssh.pub').read_text().strip()
    if not key.startswith('ssh-ed25519 ') or '\n' in key:
        raise SandpiError('invalid per-room SSH public key')
    ssh = Path('/root/.ssh')
    ssh.mkdir(mode=0o700, exist_ok=True)
    ssh.chmod(0o700)
    # This guest is private to one room. Keys are rotated per launch.
    atomic_write(ssh / 'authorized_keys', key + '\n', 0o600)
    agent = Path('/root/.pi/agent')
    os.environ['SANDPI_CORE_PACKAGE'] = '/etc/sandpi/pi-package'
    os.environ['SANDPI_RUNTIME_CONFIG'] = '/run/sandpi/runtime.json'
    configure_runtime(agent, launch, '/run/current-system/sw/bin/sandpi-auth',
                      package_source='/etc/sandpi/pi-package',
                      runtime_path='/run/sandpi/runtime.json')
    # Preserve normal profile-driven Nix installation. Pi sessions live on the
    # persistent root disk, never in the live host workspace.
    (agent / 'sessions').mkdir(parents=True, exist_ok=True, mode=0o700)
    atomic_write(Path('/etc/sandpi-room'), launch.get('room_id', 'unknown') + '\n', 0o644)
    return 0


def _apply_runtime_environment(launch: dict[str, Any], agent_dir: Path) -> None:
    os.environ['PI_CODING_AGENT_DIR'] = str(agent_dir)
    # Do not invent or overwrite a native session-directory override. An unset
    # or empty caller value must still reach native settings/project defaults.
    os.environ['SANDPI_ROOM'] = launch.get('room_id', 'unknown')
    os.environ['SANDPI_MODE'] = launch.get('mode', 'vm')
    if launch.get('runtime_config'):
        os.environ['SANDPI_RUNTIME_CONFIG'] = str(launch['runtime_config'])
    else:
        os.environ.setdefault('SANDPI_RUNTIME_CONFIG', str(agent_dir / 'sandpi-runtime.json'))
    if launch.get('core_package'):
        os.environ['SANDPI_CORE_PACKAGE'] = str(launch['core_package'])
    if launch.get('upstream_pi'):
        os.environ['SANDPI_UPSTREAM_PI'] = str(launch['upstream_pi'])
    if launch.get('credential_socket'):
        os.environ['SANDPI_CREDENTIAL_SOCKET'] = launch['credential_socket']
    os.environ.setdefault('TERM', 'xterm-256color')
    os.environ.setdefault('COLORTERM', 'truecolor')


def _shell_banner(launch: dict[str, Any]) -> str:
    if launch.get('mode') == 'bare-metal':
        heading = 'HOST ROOT / BARE METAL'
        place = 'This is your host machine with real root authority.'
    else:
        heading = 'NixOS guest / root'
        place = 'This persistent machine is the Sandpi room for the current project.'
    role = launch.get('entry_role', 'owner')
    lifecycle = launch.get('room_lifecycle', 'owner-terminal')
    if launch.get('mode') == 'bare-metal':
        departure = 'Exiting this shell returns to the invoking host-root launcher.'
    elif role == 'secondary' and lifecycle == 'detached':
        departure = 'Exiting this shell returns to the host; the detached room keeps running.'
    elif role == 'secondary':
        departure = "Exiting this secondary shell returns to the host; the owner's room keeps running."
    else:
        departure = 'Exiting this owner shell stops the room and returns to the host.'
    return (f'\n[sandpi: {heading}]\n'
            f'{place}\n'
            f'Working directory: {os.getcwd()}\n'
            f'{departure}\n'
            "  pi       start a new native Pi session\n"
            "  pi -c    continue Pi's latest session for this workspace\n"
            "  pi -r    choose a native Pi session\n"
            "  pi list / pi config / pi install ... manage guest-local Pi packages\n"
            "  exit     leave this shell and return to the caller\n")


def prune_entry_runtimes(runtime_dir: Path = Path('/run/sandpi/entries'),
                         launch_dir: Path = Path('/run/sandpi-share/entries')) -> int:
    """Remove process-local runtimes whose host-authored entry manifest is gone.

    The host lease is authoritative for terminal lifetime.  Runtime files are
    guest-local derivatives and may survive a terminal hangup if its shell never
    runs EXIT cleanup.  A later entry can safely remove only fixed-name regular
    files with no matching read-only host manifest.
    """
    if not runtime_dir.exists():
        return 0
    if runtime_dir.is_symlink() or not runtime_dir.is_dir():
        raise SandpiError('Pi entry runtime directory has an invalid type', 78)
    if launch_dir.is_symlink():
        raise SandpiError('Pi entry launch directory is a symlink', 78)
    files = sorted(runtime_dir.iterdir())
    if len(files) > 1024:
        raise SandpiError('Pi entry runtime directory exceeds its bounded size', 78)
    removed = 0
    for path in files:
        match = re.fullmatch(r'entry-([a-f0-9]{24})\.json', path.name)
        if not match:
            continue
        if path.is_symlink() or not path.is_file():
            raise SandpiError('Pi entry runtime must be a regular file', 78)
        source = launch_dir / path.name
        if source.exists() or source.is_symlink():
            continue
        path.unlink()
        removed += 1
    return removed


def prepare_entry_runtime(launch: dict[str, Any], agent_dir: Path) -> None:
    """Materialize one secondary entry's immutable launch intent.

    The shared seed manifest is host-authored and read-only in the guest. Its
    resulting runtime is process-local, so concurrent terminals do not overwrite
    one another's provider/model/session choices.
    """
    if not launch.get('reentry'):
        return
    target = Path(launch['runtime_config'])
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    prune_entry_runtimes(target.parent, Path('/run/sandpi-share/entries'))
    with file_lock(agent_dir / '.sandpi-compose.lock', timeout=10):
        configure_runtime(agent_dir, launch, '/run/current-system/sw/bin/sandpi-auth',
                          package_source='/etc/sandpi/pi-package', runtime_path=target)


def fresh_secondary_launch(launch: dict[str, Any]) -> dict[str, Any]:
    """Return a new native Pi entry with no inherited model/history intent."""
    result = copy.deepcopy(launch)
    result['pi_args'] = []
    runtime = dict(result.get('pi_runtime', {}))
    runtime.update(auto_select=False, resume_requested=False, continue_requested=False,
                   resume_snapshot=None, resume_hint=None, explicit_model=False,
                   allow_model_cooldown_probe=False, requested_thinking=None,
                   tool_profile_request='auto')
    result['pi_runtime'] = runtime
    result['entry_role'] = 'secondary'
    return result


def enter(launch: dict[str, Any], *, shell_only: bool = False, pi_only: bool = False) -> int:
    if shell_only and not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise SandpiError('--shell requires a terminal; use --exec for shell automation', 64)
    workdir = _entry_workdir(launch)
    os.chdir(workdir)
    agent_dir = Path(launch.get('agent_dir', '/root/.pi/agent'))
    prepare_entry_runtime(launch, agent_dir)
    _apply_runtime_environment(launch, agent_dir)
    if not shell_only:
        from benchmark import auto_select, run_course
        rpc = lambda request: credential_request(request, unix=os.environ.get('SANDPI_CREDENTIAL_SOCKET'), timeout=9)
        if launch.get('benchmark'):
            spec = launch['benchmark']
            argv = launch['pi_args']
            model_id = argv[argv.index('--model') + 1] if '--model' in argv else ''
            model = next((m for m in launch.get('pi_runtime', {}).get('catalog', {}).get('models', []) if m['id'] == model_id), None)
            if model is None:
                raise SandpiError('benchmark exact model missing from the room catalog', 78)
            result = 0
            for _trial in range(spec['trials']):
                report = run_course(launch, model, spec['course'], timeout=spec['timeout'], requests=spec['requests'])
                rpc({'op': 'ladder-record', 'report': report})
                print(json.dumps(report, sort_keys=True), flush=True)
                if any(row['status'] == 'unscored' for row in report['cases']):
                    return 75
                if not all(row['accepted'] for row in report['cases']):
                    result = 1
            return result
        try:
            before_runtime = launch.get('pi_runtime', {})
            launch = auto_select(launch, rpc=rpc)
            if launch.get('pi_runtime', {}) != before_runtime:
                target = runtime_config_path(agent_dir)
                current = read_json(target, {})
                with file_lock(agent_dir / '.sandpi-compose.lock', timeout=10):
                    configure_runtime(agent_dir, launch, current.get('authHelper', 'sandpi-auth'),
                                      package_source=os.environ.get('SANDPI_CORE_PACKAGE'),
                                      runtime_path=target)
            pi = launch.get('pi_binary', 'pi')
            upstream = launch.get('upstream_pi') or os.environ.get('SANDPI_UPSTREAM_PI') or pi
        except SandpiError as error:
            log(str(error))
            if pi_only:
                return error.code
            # Stay in the useful machine after a failed cold-start selection or
            # continuity check. The user can inspect it and start Pi explicitly.
            return enter(launch, shell_only=True)
        pi = launch.get('pi_binary', 'pi')
        # Ctrl-C belongs to Pi's TUI (cancel/clear), not to this waiting parent.
        # A caught handler resets on child exec; SIG_IGN would be inherited.
        previous_int = signal.signal(signal.SIGINT, lambda _s, _f: None)
        try:
            selected = managed_pi_args(launch['pi_args'], agent_dir,
                                       package_source=os.environ.get('SANDPI_CORE_PACKAGE'),
                                       runtime_path=runtime_config_path(agent_dir))
            environment = dict(os.environ)
            environment['SANDPI_INITIAL_INVOCATION'] = '1'
            completed = subprocess.run([pi, *selected], check=False, env=environment)
            result = completed.returncode
        except KeyboardInterrupt:
            result = 130
        except OSError as exc:
            log(f'Pi could not start ({exc.strerror}); entering the room shell')
            result = 127
        finally:
            signal.signal(signal.SIGINT, previous_int)
        if pi_only:
            return result if result >= 0 else 128 - result
    print(_shell_banner(launch), file=sys.stderr, flush=True)
    # exec is intentional: the SSH owner exits exactly when this shell exits.
    os.execvpe('bash', ['bash', '-i'], os.environ)
    return 0

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('prepare')
    wp = sub.add_parser('pi-wrapper')
    wp.add_argument('pi_args', nargs=argparse.REMAINDER)
    ep = sub.add_parser('enter')
    ep.add_argument('--launch', type=Path, default=LAUNCH)
    ep.add_argument('--shell', action='store_true')
    ep.add_argument('--pi-only', action='store_true')
    ep.add_argument('--workdir', help='override this entry cwd inside the selected workspace')
    ep.add_argument('--fresh', action='store_true', help='secondary Pi session without primary history or one-shot flags')
    ap = sub.add_parser('auth')
    ap.add_argument('operation', choices=['key', 'status', 'ping', 'rpc'])
    ap.add_argument('provider', nargs='?')
    args = parser.parse_args(argv)
    try:
        if args.action == 'prepare':
            return boot_prepare()
        if args.action == 'pi-wrapper':
            return pi_wrapper(args.pi_args)
        if args.action == 'enter':
            launch = load_launch(args.launch)
            if args.fresh:
                launch = fresh_secondary_launch(launch)
            if args.workdir is not None:
                launch = copy.deepcopy(launch)
                launch['workdir'] = str(_clean_launch_path(args.workdir, label='Pi working directory'))
            return enter(launch, shell_only=args.shell, pi_only=args.pi_only)
        request = json.loads(sys.stdin.buffer.readline(65537)) if args.operation == 'rpc' else {'op': args.operation, 'provider': args.provider}
        result = credential_request(request,
                                    unix=os.environ.get('SANDPI_CREDENTIAL_SOCKET'), timeout=9)
        if args.operation == 'key':
            result = result.get('key')
            if not isinstance(result, str) or not result or any(c in result for c in '\r\n\0'):
                raise SandpiError('invalid credential response')
            # stdout is deliberately a secret pipe for Pi. Do not use this in logs.
            print(result)
        else:
            print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    except (SandpiError, OSError, ValueError) as exc:
        log(str(exc))
        return getattr(exc, 'code', 1)


