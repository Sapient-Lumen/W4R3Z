def parse(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    extra: list[str] = []
    if '--' in argv:
        idx = argv.index('--')
        argv, extra = argv[:idx], argv[idx + 1:]
    # Keep only option names, never values. Re-entry uses this to distinguish an
    # explicitly requested machine change from an argparse default that merely
    # describes how a new room would be created.
    explicit_flags = {item.split('=', 1)[0] for item in argv if item.startswith('--')}
    if not argv:
        argv = ['run']
    elif argv[0] not in COMMANDS and argv[0] not in ('--help', '-h', '--version'):
        argv = ['run', *argv]
    args = parser().parse_args(argv)
    args._explicit_flags = explicit_flags
    if extra and args.command not in ('run', 'plan'):
        raise SandpiError('arguments after -- are Pi arguments and only valid for run/plan', 64)
    return args, extra


def base_locations(args: argparse.Namespace) -> tuple[Path, Path, Path, str]:
    import project as project_state

    root = canonical(args.home or os.environ.get('SANDPI_HOME', Path.home() / '.sandstuff/sandpi'))
    cred = canonical(args.credentials_root or os.environ.get('SANDCODEX_GLOBAL_ROOT', Path.home() / '.sandstuff/sandcodex'))
    selection = project_state.select(Path.cwd(), explicit=args.project,
                                     state_root=root, credential_root=cred)
    args._project_selection = selection
    project = Path(selection['project'])
    name = checked_name(args.name if args.name is not None else 'default')
    args._resolved_name = name
    args._room_selection = {
        'schema': 'sandpi.room-choice.v1', 'selected_name': name,
        'persisted': False,
        'source': 'explicit-name' if args.name is not None else 'implicit-default',
    }
    return root, cred, project, name


def _resolve_room_choice(args: argparse.Namespace, root: Path, project: Path,
                         namespace: str, *, allow_missing: bool = False) -> str:
    """Resolve an explicit one-shot name or the host-only project preference."""
    import roomselect
    import rooms as room_state

    if args.name is not None:
        name = checked_name(args.name)
        choice = {'schema': 'sandpi.room-choice.v1', 'selected_name': name,
                  'persisted': False, 'source': 'explicit-name'}
    elif getattr(args, 'bare_metal', False):
        # A VM machine preference must not silently partition explicit host-root
        # sessions. --name remains available when that grouping is intentional.
        name = roomselect.DEFAULT_ROOM
        choice = {'schema': 'sandpi.room-choice.v1', 'selected_name': name,
                  'persisted': False, 'source': 'bare-metal-default'}
    else:
        stored = roomselect.load(project, namespace)
        name = stored['selected_name']
        choice = {key: stored[key] for key in
                  ('schema', 'selected_name', 'selected_at', 'selected_revision',
                   'persisted', 'source', 'path')}
        if stored['persisted'] and not allow_missing:
            room = room_state.room_path(root, namespace, name)
            if not room.exists() and not room.is_symlink():
                raise SandpiError(
                    f'the project-selected room {name!r} is missing. Run `sandpi rooms` and '
                    '`sandpi use default`, choose another existing room with `sandpi use NAME`, '
                    'or override one command with `--name NAME`.', 66)
    args._resolved_name = name
    args._room_selection = choice
    return name


def locations(args: argparse.Namespace) -> tuple[Path, Path, Path, str, Path]:
    import project as project_state

    root, cred, project, _preview = base_locations(args)
    identity = project_state.resolve(root, project)
    project_state.assert_usable(root, project, identity['room_namespace'])
    name = _resolve_room_choice(args, root, project, identity['room_namespace'])
    rid = room_id(identity['room_namespace'], name)
    return root, cred, project, rid, root / 'rooms' / rid


def _project_rooms(root: Path, namespace: str) -> list[tuple[Path, dict[str, Any]]]:
    """Return room directories whose names derive from this stable namespace."""
    import machine

    area = root / 'rooms'
    if not area.exists():
        return []
    if area.is_symlink() or not area.is_dir():
        raise SandpiError('Sandpi room root must be a real directory', 78)
    rows: list[tuple[Path, dict[str, Any]]] = []
    for candidate in sorted(area.iterdir()):
        if candidate.is_symlink() or not candidate.is_dir():
            continue
        metadata = machine.read_metadata(candidate)
        name = metadata.get('name')
        try:
            valid_name = checked_name(name) if isinstance(name, str) else None
        except SandpiError:
            continue
        if valid_name is not None and candidate.name == room_id(namespace, valid_name):
            rows.append((candidate, metadata))
    return rows


