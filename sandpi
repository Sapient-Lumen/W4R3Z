    if args.backup_action == 'create':
        source_name = _resolve_room_choice(args, root, project, plan['project_anchor'])
        result = roomarchive.create(
            root, project, plan['project_anchor'], source_name=source_name,
            destination=args.destination, checkpoint=args.checkpoint,
