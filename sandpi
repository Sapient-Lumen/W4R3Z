#!/usr/bin/env python3
"""Run explicit sandpi acceptance stages and collect fresh, auditable receipts.

Default is offline contracts only. Nix/VM stages are explicit. Provider stages
also require --authorize-provider-tests AND an exact provider/model selection.
No stage accepts a successful spawn as proof of a successful test.
"""
from __future__ import annotations
import argparse
import datetime as dt
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
STAGES = {
    'offline': ('tests/run', 'offline-contracts', 180),
    'storage': ('tests/storage-smoke.py', 'storage-lifecycle', 120),
    'pi': ('tools/pi-contract-acceptance.py', 'pi-native-contract', 3600),
    'experience': ('tools/pi-contract-acceptance.py', 'pi-native-experience', 3600),
    'loop': ('tools/pi-contract-acceptance.py', 'pi-native-loop', 600),
    'nix': ('tests/nix-contract.sh', 'nix-contract', 3600),
    'store': ('tests/store-view-smoke.sh', 'store-view-smoke', 180),
    'vm': ('tests/vm-smoke.sh', 'vm-smoke', 1800),
    'room': ('tests/room-reentry.py', 'room-reentry', 1800),
    'terminal': ('tests/terminal-flow.py', 'terminal-flow', 1000),
    'headless': ('tests/headless-smoke.py', 'headless-smoke', 1200),
    'checkpoint': ('tests/checkpoint-smoke.sh', 'checkpoint-smoke', 2400),
    'provider': ('tests/provider-smoke.sh', 'provider-smoke', 1800),
    'provider-tools': ('tests/provider-tools.sh', 'provider-tools', 1800),
}


def utc() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def write_json(path: Path, value: Any) -> None:
    temporary = path.with_name('.' + path.name + '.tmp')
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')
    temporary.chmod(0o600)
    os.replace(temporary, path)


def stop_group(child: subprocess.Popen) -> None:
    if child.poll() is not None:
        return
    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        child.wait(timeout=45)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        child.wait()


def run_stage(name: str, command: list[str], directory: Path, *, env: dict[str, str],
              expected_suite: str, timeout: float, offline: bool = False) -> dict[str, Any]:
    directory.mkdir(mode=0o700, parents=True, exist_ok=False)
    started = utc()
    clock = time.monotonic()
    receipt: dict[str, Any] = {'stage': name, 'started_at': started, 'status': 'failed'}
    child = None
    with (directory / 'runner.log').open('wb') as log:
        try:
            child = subprocess.Popen(command, cwd=ROOT, stdin=subprocess.DEVNULL,
                                     stdout=log, stderr=subprocess.STDOUT, env=env,
                                     start_new_session=True)
            try:
                code = child.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                receipt['reason'] = 'deadline-exceeded'
                stop_group(child)
                code = 124
            except KeyboardInterrupt:
                receipt['reason'] = 'interrupted'
                stop_group(child)
                code = 130
            receipt['exit_code'] = code
            if code == 0:
                if offline:
                    inner = {'suite':expected_suite,'status':'passed','at':utc(),
                             'checks':['unittest','bash-syntax','reproducible-builder']}
                    write_json(directory / 'result.json', inner)
                else:
                    inner = json.loads((directory / 'result.json').read_text())
                if not isinstance(inner, dict) or inner.get('suite') != expected_suite or inner.get('status') != 'passed':
                    receipt['reason'] = 'receipt-not-passed-or-wrong-suite'
                else:
                    receipt['status'] = 'passed'
                    receipt['test_receipt'] = inner
            else:
                receipt.setdefault('reason', 'test-process-failed')
        except (OSError, ValueError) as exc:
            receipt['reason'] = type(exc).__name__
            receipt['detail'] = str(exc)
        finally:
            if child is not None:
                stop_group(child)
            receipt['finished_at'] = utc()
            receipt['seconds'] = round(time.monotonic() - clock, 3)
            write_json(directory / 'runner-result.json', receipt)
    return receipt


def stage_command(stage: str, out: Path, launcher: Path, provider: str | None,
                  model: str | None) -> list[str]:
    relative, _, _ = STAGES[stage]
    path = ROOT / relative
    command = [sys.executable, str(path)] if path.suffix == '.py' else ['bash', str(path)]
    if stage in ('experience','loop'):
        command += ['--scope', stage]
    if stage == 'terminal':
        command += ['--launcher', str(launcher), '--output', str(out)]
    if stage in ('provider', 'provider-tools'):
        if not provider or not model:
            raise ValueError('provider stages require --provider and --model')
        command += [provider, model]
    return command


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--stage', action='append', choices=list(STAGES))
    p.add_argument('--launcher', type=Path, default=ROOT / 'sandpi')
    p.add_argument('--output', type=Path)
    p.add_argument('--provider', choices=['gpt','openai','gemini','openrouter'])
    p.add_argument('--model', help='exact provider-specific model ID for live stages')
    p.add_argument('--authorize-provider-tests', action='store_true', help='explicit consent to actual provider usage')
    p.add_argument('--paid', action='store_true', help='allow paid OpenRouter models in explicitly authorized live stages')
    p.add_argument('--max-price', help='paid OpenRouter routing ceiling INPUT,OUTPUT in USD per million tokens')
    p.add_argument('--timeout', type=float, help='override deadline per stage, in seconds')
    p.add_argument('--dry-run', action='store_true')
    args = p.parse_args(argv)
    stages = list(dict.fromkeys(args.stage or ['offline']))
    if any(x in stages for x in ('provider','provider-tools')) and not args.authorize_provider_tests:
        p.error('provider stages require --authorize-provider-tests (real inference usage)')
    if args.paid and (args.provider != 'openrouter' or not args.authorize_provider_tests or not any(x in stages for x in ('provider','provider-tools'))):
        p.error('--paid requires an authorized OpenRouter live provider stage')
    if args.max_price and not args.paid:
        p.error('--max-price requires --paid')
    if args.max_price:
        sys.path.insert(0, str(ROOT / 'src'))
        from model_defaults import max_price
        from core import SandpiError
        try:
            max_price(args.max_price)
        except SandpiError as exc:
            p.error(str(exc))
    if args.timeout is not None and not (0 < args.timeout < 86400):
        p.error('--timeout must be positive and below one day')
    out = (args.output or ROOT / 'evidence' / ('acceptance-' + dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S') + f'-{os.getpid()}')).resolve()
    launcher = args.launcher.resolve()
    try:
        planned = [{'stage': stage, 'command':stage_command(stage,out/stage,launcher,args.provider,args.model),
                    'timeout':args.timeout or STAGES[stage][2]} for stage in stages]
    except ValueError as exc:
        p.error(str(exc))
    if args.dry_run:
        print(json.dumps({'output':str(out),'stages':planned,'paid_openrouter':args.paid,'max_price':args.max_price},indent=2))
        return 0
    try:
        out.mkdir(mode=0o700,parents=True,exist_ok=False)
    except FileExistsError:
        p.error('output directory already exists; choose a fresh path to avoid stale receipts')
    os.umask(0o077)
    summary: dict[str, Any] = {'schema':'sandpi.acceptance.v1','started_at':utc(),
                              'launcher':str(launcher),'stages':[],'status':'running',
                              'paid_openrouter':args.paid,'max_price':args.max_price}
    write_json(out/'summary.json',summary)
    for plan in planned:
        stage = plan['stage']
        env = dict(os.environ, SANDPI_TEST_RESULTS=str(out/stage), SANDPI_TEST_LAUNCHER=str(launcher))
        # No implicit live-call permission merely because the parent set it.
        env.pop('SANDPI_LIVE_PROVIDER_TESTS', None)
        env.pop('SANDPI_TEST_PAID', None)
        env.pop('SANDPI_TEST_MAX_PRICE', None)
        if args.authorize_provider_tests:
