/** Read-only presentation of Pi's effective model and merged settings.
 * No filesystem access, provider request, transcript parsing or policy mutation.
 * Keep this replaceable: prefer upstream inspection when it exposes these facts.
 */
import { renderRoutingPreferences } from './routing.mjs';

const SAMPLING_APIS = new Set(['openai-completions', 'openai-responses', 'azure-openai-responses']);
const LEVELS = new Set(['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max']);
// Never dump arbitrary sampling payloads: they can contain headers, messages or
// vendor configuration. Only these well-known numeric knobs are displayed.
const SAMPLING_FIELDS = ['temperature', 'top_p', 'top_k', 'min_p', 'typical_p',
  'presence_penalty', 'frequency_penalty', 'repetition_penalty', 'seed'];
const DEFAULT_COMPACTION = { reserveTokens: 16384, keepRecentTokens: 20000 };
const record = value => value !== null && typeof value === 'object' && !Array.isArray(value);
const tokens = value => Number.isSafeInteger(value) && value >= 0;
const positiveTokens = value => tokens(value) && value > 0;
const finiteNumber = value => typeof value === 'number' && Number.isFinite(value)
  && Math.abs(value) <= Number.MAX_SAFE_INTEGER;
const own = (value, key) => record(value) && Object.hasOwn(value, key);

/** Match the pinned Pi per-field override order; never return a fallback for an
 * explicitly invalid native setting. Native Pi itself owns validation/use. */
export function inspectCompaction(model, settings) {
  if (!record(settings)) return { status: 'unknown' };
  const compaction = settings.compaction ?? {};
  if (!record(compaction)) return { status: 'invalid' };
  if (compaction.enabled !== undefined && typeof compaction.enabled !== 'boolean') return { status: 'invalid' };
  for (const field of Object.keys(DEFAULT_COMPACTION)) {
    if (compaction[field] !== undefined && !tokens(compaction[field])) return { status: 'invalid' };
  }
  const overrides = compaction.modelOverrides ?? {};
  if (!record(overrides)) return { status: 'invalid' };
  const key = typeof model?.provider === 'string' && typeof model?.id === 'string'
    ? model.provider + '/' + model.id : undefined;
  const selected = key && own(overrides, key) ? overrides[key] : {};
  if (!record(selected)) return { status: 'invalid' };
  const resolved = {}, source = {};
  for (const field of Object.keys(DEFAULT_COMPACTION)) {
    if (selected[field] !== undefined && !tokens(selected[field])) return { status: 'invalid' };
    resolved[field] = selected[field] ?? compaction[field] ?? DEFAULT_COMPACTION[field];
    source[field] = selected[field] !== undefined ? 'exact-model override'
      : compaction[field] !== undefined ? 'ordinary setting' : 'Pi default';
  }
  return { status: 'known', enabled: compaction.enabled !== false, ...resolved, source,
    threshold: positiveTokens(model?.contextWindow) ? model.contextWindow - resolved.reserveTokens : null };
}

/** Describe configured numeric model sampling, not a captured provider payload.
 * Request hooks and explicit per-request values can still supersede it. */
export function inspectSampling(model, level) {
  const defaults = record(model?.samplingParams) ? model.samplingParams : {};
  const byLevel = record(model?.samplingParamsByThinkingLevel) ? model.samplingParamsByThinkingLevel : {};
  const selected = LEVELS.has(level) && own(byLevel, level) && record(byLevel[level]) ? byLevel[level] : {};
  const fields = {};
  let omitted = false;
  for (const name of SAMPLING_FIELDS) {
    const overridden = own(selected, name);
    const value = overridden ? selected[name] : defaults[name];
    if (finiteNumber(value)) fields[name] = { value, source: overridden ? 'thinking-level override' : 'model default' };
    else if (overridden || own(defaults, name)) omitted = true;
  }
  const hasOther = value => Object.keys(value).some(name => !SAMPLING_FIELDS.includes(name));
  omitted ||= hasOther(defaults) || hasOther(selected);
  const configured = Object.keys(defaults).length > 0 || Object.keys(selected).length > 0;
  return { supported: SAMPLING_APIS.has(model?.api), configured, fields, omitted,
    levelKnown: LEVELS.has(level) };
}

/** Compare only bounded metadata, not settings files or request payloads. A
 * difference identifies a composed value, not who wrote it: native user config
 * and other Pi extensions can both be responsible. Never infer provenance. */
const COST_FIELDS = ['input', 'output', 'cacheRead', 'cacheWrite'];
const costRate = value => typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 1e12;

/** Inspect Pi's configured catalog estimate. Provider-reported charges remain
 * separate and authoritative when available; this never reads request data. */
export function inspectCost(model) {
  if (model?.provider !== 'openrouter') return { status: 'not-openrouter' };
  const cost = model?.cost;
  if (!record(cost) || COST_FIELDS.some(field => !costRate(cost[field]))) return { status: 'unknown' };
  if (cost.tiers !== undefined && (!Array.isArray(cost.tiers) || cost.tiers.length > 128)) return { status: 'unknown' };
  const tiers = [];
  for (const tier of cost.tiers ?? []) {
    if (!record(tier) || !Number.isSafeInteger(tier.inputTokensAbove) || tier.inputTokensAbove < 0
        || tier.inputTokensAbove > 100000000 || COST_FIELDS.some(field => !costRate(tier[field]))) {
      return { status: 'unknown' };
    }
    tiers.push({ inputTokensAbove: tier.inputTokensAbove,
      ...Object.fromEntries(COST_FIELDS.map(field => [field, tier[field]])) });
  }
  return { status: 'known', base: Object.fromEntries(COST_FIELDS.map(field => [field, cost[field]])),
    tiers: tiers.sort((a, b) => a.inputTokensAbove - b.inputTokensAbove) };
}

export function inspectModelBaseline(model, definition) {
  if (model?.provider !== 'openrouter') return { status: 'not-managed' };
  if (!record(definition) || definition.id !== model.id || definition.api !== model.api
      || !positiveTokens(definition.contextWindow) || !positiveTokens(definition.maxTokens)
      || definition.maxTokens > definition.contextWindow) return { status: 'unknown' };
  const inputs = value => Array.isArray(value) && value.length > 0 && value.length <= 2
    && value.includes('text') && Array.from(value).every(item => item === 'text' || item === 'image')
    && new Set(value).size === value.length ? [...value].sort() : null;
  const baselineInput = inputs(definition.input), effectiveInput = inputs(model.input);
  const fields = ['contextWindow', 'maxTokens'];
  const changes = fields.filter(field => positiveTokens(model[field]) && model[field] !== definition[field]);
  if (baselineInput && effectiveInput && baselineInput.join(',') !== effectiveInput.join(',')) changes.push('input');
  return { status: 'known', contextWindow: definition.contextWindow, maxTokens: definition.maxTokens,
    input: baselineInput, effectiveInput, changes,
    unknownFields: [...fields.filter(field => !positiveTokens(model[field])),
      ...(!baselineInput || !effectiveInput ? ['input'] : [])] };
}

export function renderModelSettings(model, settings, usage, thinkingLevel, managedDefinition) {
  const lines = [];
  const window = positiveTokens(model?.contextWindow) ? model.contextWindow : null;
  lines.push(`context ceiling: ${window ?? 'unknown'} tokens (configured in Pi, not a measured quality limit)`);
  const compatibleEstimate = record(usage) && tokens(usage.tokens)
    && (!window || usage.contextWindow === window);
  if (compatibleEstimate) {
    lines.push(`current context: approximately ${usage.tokens} tokens${window ? ` (${(100 * usage.tokens / window).toFixed(1)}% of this model's window)` : ''}`);
