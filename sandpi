def validate_native_model_result(value:dict,cases:list[dict])->list[str]:
    expected=['native-model-'+api+'-'+case['name']
              for api in ('openai-completions','anthropic-messages') for case in cases]
    fields={'suite','checks','network_attempts','inference_attempts','real_provider_requests'}
