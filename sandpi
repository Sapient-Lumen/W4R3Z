    receipt = room_state.rename(
        root, project, plan['project_anchor'], source_name=source_name,
        target_name=args.target)
    if args.json:
        print(json.dumps(receipt, indent=2, sort_keys=True))
    else:
        print(f'Renamed room {receipt["source"]["name"]} -> {receipt["target"]["name"]}')
        print('  disk          moved atomically; not copied')
        print('  Pi state      native sessions/packages stayed on the same guest disk')
        print(f'  checkpoints   {receipt["checkpoint_manifests_updated"]} manifest(s) migrated')
